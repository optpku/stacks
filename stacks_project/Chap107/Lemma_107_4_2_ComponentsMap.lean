module

public import Mathlib.Topology.Sober
public import ReasLib.Topology.IrreducibleComponents.AtPoint
public import stacks_project.Chap100.Lemma_100_7_4_Points
public import stacks_project.Chap101.Definition_101_13_2_Closed
public import stacks_project.Chap107.Definition_107_4_1_FormalBranches
public import stacks_project.Chap98.Definition_98_9_4_Effective

/-!
# Canonical map from formal branches to irreducible components of `|X|`

In the situation of Definition 107.4.1, a formal branch of `X` through `x0` is
sent to the irreducible component of `|X|` generated by the image of the generic
point of a representing component of `Spec(A)` along an algebraization
`Spec(A) ⟶ X` of that same versal formal object.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry TopologicalSpace
open FiberedCategoryOver.Groupoids
open GroupoidsOver
open scoped Bicategory

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicStack

variable {S : Scheme.{u}} [IsLocallyNoetherian S]
variable {X : GroupoidsOver S} [AlgebraicStack X] [IsLocallyOfFiniteType X]

namespace FormalBranches

/-- The ring homomorphism `ξ.base.carrier →+* x.base.carrier` underlying an
algebraization isomorphism `e : (approximation X).obj x ≅ ξ`. -/
def algebraizationRingHom {ξ : GroupoidsOver.FormalObject X}
    {x : CompleteLocalObject X} (e : (GroupoidsOver.approximation X).obj x ≅ ξ) :
    ξ.base.carrier →+* x.base.carrier :=
  (e.hom : GroupoidsOver.FormalObject.Hom ((GroupoidsOver.approximation X).obj x) ξ).base.hom

/-- `algebraizationRingHom` is the base ring map of the algebraization
isomorphism. -/
theorem algebraizationRingHom_eq {ξ : GroupoidsOver.FormalObject X}
    {x : CompleteLocalObject X} (e : (GroupoidsOver.approximation X).obj x ≅ ξ) :
    algebraizationRingHom e =
      (e.hom : GroupoidsOver.FormalObject.Hom
          ((GroupoidsOver.approximation X).obj x) ξ).base.hom :=
  sorry

/-- The preimage of an irreducible component of `Spec(ξ.base)` along
`algebraizationRingHom e` is an irreducible component of `Spec(x.base)`. -/
theorem correspondingComponent_mem {ξ : GroupoidsOver.FormalObject X}
    {x : CompleteLocalObject X} (e : (GroupoidsOver.approximation X).obj x ≅ ξ)
    (Z : irreducibleComponents (PrimeSpectrum ξ.base.carrier)) :
    (PrimeSpectrum.comap (algebraizationRingHom e) ⁻¹' (Z : Set _)) ∈
      irreducibleComponents (PrimeSpectrum x.base.carrier) :=
  sorry

/-- The irreducible component of `Spec(x.base)` corresponding to `Z` along the
base morphism of an algebraization isomorphism `e`. -/
def correspondingComponent {ξ : GroupoidsOver.FormalObject X}
    {x : CompleteLocalObject X} (e : (GroupoidsOver.approximation X).obj x ≅ ξ)
    (Z : irreducibleComponents (PrimeSpectrum ξ.base.carrier)) :
    irreducibleComponents (PrimeSpectrum x.base.carrier) :=
  ⟨PrimeSpectrum.comap (algebraizationRingHom e) ⁻¹' (Z : Set _),
    correspondingComponent_mem e Z⟩

/-- The underlying set of `correspondingComponent e Z` is the preimage of `Z`
along `PrimeSpectrum.comap (algebraizationRingHom e)`. -/
theorem coe_correspondingComponent {ξ : GroupoidsOver.FormalObject X}
    {x : CompleteLocalObject X} (e : (GroupoidsOver.approximation X).obj x ≅ ξ)
    (Z : irreducibleComponents (PrimeSpectrum ξ.base.carrier)) :
    (correspondingComponent e Z : Set (PrimeSpectrum x.base.carrier)) =
      PrimeSpectrum.comap (algebraizationRingHom e) ⁻¹' (Z : Set _) :=
  sorry

end FormalBranches

variable (x0 : FieldValuedPoint X) [AlgebraicGeometry.LocallyOfFiniteType x0.structureHom]

namespace FormalBranches

/-- Packed representatives of `FormalBranches x0`: a versal formal object at
`x0` together with an irreducible component of `Spec(ξ.base)`. -/
abbrev BranchRep : Type (u + 1) :=
  (ξ : GroupoidsOver.FormalObject X) ×
    PSigma fun _ : GroupoidsOver.FormalObject.IsVersal ξ =>
      PSigma fun _ : StageOneCompatible x0 ξ =>
        irreducibleComponents (PrimeSpectrum ξ.base.carrier)

/-- The packed representative of a versal component of `Spec(ξ.base)`. -/
def BranchRep.mk (ξ : GroupoidsOver.FormalObject X) [hversal : GroupoidsOver.FormalObject.IsVersal ξ]
    (hξ : StageOneCompatible x0 ξ)
    (Z : irreducibleComponents (PrimeSpectrum ξ.base.carrier)) :
    BranchRep x0 :=
  ⟨ξ, ⟨hversal, ⟨hξ, Z⟩⟩⟩

/-- `BranchRep.mk` stores the given versal formal object. -/
theorem BranchRep.mk_fst (ξ : GroupoidsOver.FormalObject X) [GroupoidsOver.FormalObject.IsVersal ξ]
    (hξ : StageOneCompatible x0 ξ)
    (Z : irreducibleComponents (PrimeSpectrum ξ.base.carrier)) :
    (BranchRep.mk x0 ξ hξ Z).1 = ξ :=
  sorry

/-- The image in `|X|` of the generic point of the component of `Spec(x.base)`
corresponding to `Z` along an algebraization of `ξ`. -/
def genericPointImage (ξ : GroupoidsOver.FormalObject X) (x : CompleteLocalObject X)
    (e : (GroupoidsOver.approximation X).obj x ≅ ξ)
    (Z : irreducibleComponents (PrimeSpectrum ξ.base.carrier)) :
    Points X :=
  Points.mapSlice (yonedaOfObject x.base.toS x.object x.over_obj)
    (genericPoints.ofComponent (correspondingComponent e Z)).1

/-- `genericPointImage` is `Points.mapSlice` of the generic point of the
corresponding component of `Spec(x.base)` along `yonedaOfObject`. -/
theorem genericPointImage_eq (ξ : GroupoidsOver.FormalObject X) (x : CompleteLocalObject X)
    (e : (GroupoidsOver.approximation X).obj x ≅ ξ)
    (Z : irreducibleComponents (PrimeSpectrum ξ.base.carrier)) :
    genericPointImage ξ x e Z =
      Points.mapSlice (yonedaOfObject x.base.toS x.object x.over_obj)
        (genericPoints.ofComponent (correspondingComponent e Z)).1 :=
  sorry

/-- The closure in `|X|` of the image of the generic point of the component of
`Spec(x.base)` corresponding to `Z` along an algebraization of `ξ`. -/
def closureImage (τ : TopologicalSpace (Points X)) (ξ : GroupoidsOver.FormalObject X)
    (x : CompleteLocalObject X) (e : (GroupoidsOver.approximation X).obj x ≅ ξ)
    (Z : irreducibleComponents (PrimeSpectrum ξ.base.carrier)) :
    Set (Points X) :=
  @closure (Points X) τ {genericPointImage ξ x e Z}

/-- `closureImage` is the closure of the singleton `{genericPointImage ...}`. -/
theorem closureImage_eq (τ : TopologicalSpace (Points X)) (ξ : GroupoidsOver.FormalObject X)
    (x : CompleteLocalObject X) (e : (GroupoidsOver.approximation X).obj x ≅ ξ)
    (Z : irreducibleComponents (PrimeSpectrum ξ.base.carrier)) :
    closureImage τ ξ x e Z = @closure (Points X) τ {genericPointImage ξ x e Z} :=
  sorry

/-- The closure of the image of the generic point of the corresponding component
is an irreducible component of `|X|`. -/
theorem closureImage_mem {τ : TopologicalSpace (Points X)}
    (hτ : IsPointsTopology X τ) (ξ : GroupoidsOver.FormalObject X)
    [GroupoidsOver.FormalObject.IsVersal ξ] (hξ : StageOneCompatible x0 ξ)
    (x : CompleteLocalObject X) (e : (GroupoidsOver.approximation X).obj x ≅ ξ)
    (Z : irreducibleComponents (PrimeSpectrum ξ.base.carrier)) :
    closureImage τ ξ x e Z ∈ @irreducibleComponents (Points X) τ :=
  sorry

/-- The closure of the generic-point image is independent of the algebraization
of the same formal object `ξ`. -/
theorem closureImage_independent {τ : TopologicalSpace (Points X)}
    (ξ : GroupoidsOver.FormalObject X) [GroupoidsOver.FormalObject.IsVersal ξ]
    (hξ : StageOneCompatible x0 ξ) (x x' : CompleteLocalObject X)
    (e : (GroupoidsOver.approximation X).obj x ≅ ξ)
    (e' : (GroupoidsOver.approximation X).obj x' ≅ ξ)
    (Z : irreducibleComponents (PrimeSpectrum ξ.base.carrier)) :
    closureImage τ ξ x e Z = closureImage τ ξ x' e' Z :=
  sorry

/-- The set-theoretic image of a packed formal-branch representative, as the
common closure of generic-point images along algebraizations of that same
versal formal object. -/
def representativeClosure (τ : TopologicalSpace (Points X)) (r : BranchRep x0) :
    Set (Points X) :=
  Set.iUnion fun (x : CompleteLocalObject X) ↦
    Set.iUnion fun (e : (GroupoidsOver.approximation X).obj x ≅ r.1) ↦
      closureImage τ r.1 x e r.2.2.2

/-- `representativeClosure` is the union of `closureImage` over algebraizations
of the packed representative. -/
theorem representativeClosure_eq (τ : TopologicalSpace (Points X)) (r : BranchRep x0) :
    representativeClosure x0 τ r =
      Set.iUnion fun (x : CompleteLocalObject X) ↦
        Set.iUnion fun (e : (GroupoidsOver.approximation X).obj x ≅ r.1) ↦
          closureImage τ r.1 x e r.2.2.2 :=
  sorry

/-- The representative closure is an irreducible component of `|X|`. -/
theorem representativeClosure_mem {τ : TopologicalSpace (Points X)}
    (hτ : IsPointsTopology X τ) (r : BranchRep x0) :
    representativeClosure x0 τ r ∈ @irreducibleComponents (Points X) τ :=
  sorry

/-- The irreducible component of `|X|` associated to a packed formal-branch
representative. -/
def toComponentAux {τ : TopologicalSpace (Points X)}
    (hτ : IsPointsTopology X τ) (r : BranchRep x0) :
    @irreducibleComponents (Points X) τ :=
  ⟨representativeClosure x0 τ r, representativeClosure_mem x0 hτ r⟩

/-- The underlying set of `toComponentAux` is `representativeClosure`. -/
theorem coe_toComponentAux {τ : TopologicalSpace (Points X)}
    (hτ : IsPointsTopology X τ) (r : BranchRep x0) :
    (toComponentAux x0 hτ r : Set (Points X)) =
      representativeClosure x0 τ r :=
  sorry

/-- Identified packed representatives determine the same component of `|X|`. -/
theorem toComponentAux_lift {τ : TopologicalSpace (Points X)}
    (hτ : IsPointsTopology X τ) {r r' : BranchRep x0}
    (h : Identified r.1 r'.1 r.2.2.2 r'.2.2.2) :
    toComponentAux x0 hτ r = toComponentAux x0 hτ r' :=
  sorry

/-- The canonical map sending a formal branch of `X` through `x0` to an
irreducible component of `|X|`. -/
def toComponent {τ : TopologicalSpace (Points X)} (hτ : IsPointsTopology X τ) :
    FormalBranches x0 → @irreducibleComponents (Points X) τ :=
  Quot.lift (toComponentAux x0 hτ) fun _ _ h ↦ toComponentAux_lift x0 hτ h

/-- `toComponent` sends the class of a packed representative to
`toComponentAux`. -/
theorem toComponent_quotMk {τ : TopologicalSpace (Points X)}
    (hτ : IsPointsTopology X τ) (r : BranchRep x0) :
    toComponent x0 hτ (Quot.mk _ r) = toComponentAux x0 hτ r :=
  sorry

/-- On a `FormalBranches.mk` representative, `toComponent` recovers the
component whose underlying set is `closureImage` of any algebraization of
that same `ξ`. -/
theorem toComponent_mk {τ : TopologicalSpace (Points X)}
    (hτ : IsPointsTopology X τ) (ξ : GroupoidsOver.FormalObject X)
    [GroupoidsOver.FormalObject.IsVersal ξ] (hξ : StageOneCompatible x0 ξ)
    (x : CompleteLocalObject X) (e : (GroupoidsOver.approximation X).obj x ≅ ξ)
    (Z : irreducibleComponents (PrimeSpectrum ξ.base.carrier)) :
    toComponent x0 hτ (mk x0 ξ hξ Z) =
      ⟨closureImage τ ξ x e Z, closureImage_mem x0 hτ ξ hξ x e Z⟩ :=
  sorry

/-- The underlying set of `toComponent (mk x0 ξ hξ Z)` is `closureImage` of any
algebraization of that same `ξ`. -/
theorem toComponent_eq_closureImage {τ : TopologicalSpace (Points X)}
    (hτ : IsPointsTopology X τ) (ξ : GroupoidsOver.FormalObject X)
    [GroupoidsOver.FormalObject.IsVersal ξ] (hξ : StageOneCompatible x0 ξ)
    (x : CompleteLocalObject X) (e : (GroupoidsOver.approximation X).obj x ≅ ξ)
    (Z : irreducibleComponents (PrimeSpectrum ξ.base.carrier)) :
    (toComponent x0 hτ (mk x0 ξ hξ Z) : Set (Points X)) =
      closureImage τ ξ x e Z :=
  sorry

/-- Every formal branch through `x0` is sent to a component of `|X|` that
contains the image of `x0`. -/
theorem mem_toComponent {τ : TopologicalSpace (Points X)}
    (hτ : IsPointsTopology X τ) (b : FormalBranches x0) :
    Points.mk x0 ∈ (toComponent x0 hτ b : Set (Points X)) :=
  sorry

/-- The image of `toComponent` lands in the irreducible components of `|X|`
through `Points.mk x0`. -/
theorem toComponent_mem_irreducibleComponentsAt {τ : TopologicalSpace (Points X)}
    (hτ : IsPointsTopology X τ) (b : FormalBranches x0) :
    toComponent x0 hτ b ∈
      @irreducibleComponentsAt (Points X) τ (Points.mk x0) :=
  sorry

/-- The image of `toComponent` is exactly the set of irreducible components of
`|X|` containing `Points.mk x0`. -/
theorem range_toComponent {τ : TopologicalSpace (Points X)}
    (hτ : IsPointsTopology X τ) :
    Set.range (toComponent x0 hτ) =
      @irreducibleComponentsAt (Points X) τ (Points.mk x0) :=
  sorry

end FormalBranches

end AlgebraicGeometry.AlgebraicStack
