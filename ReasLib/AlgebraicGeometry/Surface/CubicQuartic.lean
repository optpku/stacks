module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Data.Complex.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.RingTheory.KrullDimension.Basic
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.LocalRing.Defs
public import Mathlib.RingTheory.Noetherian.Defs
public import ReasLib.RingTheory.Excellent

@[expose] public section

noncomputable section

universe u

open MvPolynomial

namespace AlgebraicGeometry.CubicQuarticSurface

/-- The cubic-quartic polynomial `X 0 ^ 3 + X 1 ^ 3 + X 2 ^ 3 + X 0 ^ 4 + X 1 ^ 4 + X 2 ^ 4`
in `ℂ[x, y, z]`. -/
def equation : MvPolynomial (Fin 3) ℂ :=
  X 0 ^ 3 + X 1 ^ 3 + X 2 ^ 3 + X 0 ^ 4 + X 1 ^ 4 + X 2 ^ 4

/-- The principal ideal generated by `equation`. -/
def ideal : Ideal (MvPolynomial (Fin 3) ℂ) :=
  Ideal.span {equation}

/-- The affine coordinate ring `ℂ[x, y, z] ⧸ (x ^ 3 + y ^ 3 + z ^ 3 + x ^ 4 + y ^ 4 + z ^ 4)`. -/
abbrev CoordinateRing : Type :=
  MvPolynomial (Fin 3) ℂ ⧸ ideal

/-- The class of the coordinate `x` in `CoordinateRing`. -/
def x : CoordinateRing :=
  Ideal.Quotient.mk ideal (X 0)

/-- The class of the coordinate `y` in `CoordinateRing`. -/
def y : CoordinateRing :=
  Ideal.Quotient.mk ideal (X 1)

/-- The class of the coordinate `z` in `CoordinateRing`. -/
def z : CoordinateRing :=
  Ideal.Quotient.mk ideal (X 2)

/-- The coordinate equation `x ^ 3 + y ^ 3 + z ^ 3 + x ^ 4 + y ^ 4 + z ^ 4 = 0`
in `CoordinateRing`. -/
theorem x_pow_add_y_pow_add_z_pow :
    x ^ 3 + y ^ 3 + z ^ 3 + x ^ 4 + y ^ 4 + z ^ 4 = 0 := sorry

/-- The origin ideal `(x, y, z)` of the unique singular point `(0, 0, 0)`. -/
def originIdeal : Ideal CoordinateRing :=
  Ideal.span {x, y, z}

/-- The origin ideal is a maximal ideal. -/
instance instIsMaximal_originIdeal : originIdeal.IsMaximal := sorry

/-- The local ring `A = O_{X,(0,0,0)}` of the cubic-quartic surface at the origin. -/
abbrev localRing : Type :=
  Localization.AtPrime originIdeal

/-- `localRing` is excellent. -/
instance instIsExcellentRing_localRing : IsExcellentRing localRing := sorry

/-- `localRing` is a domain. -/
instance instIsDomain_localRing : IsDomain localRing := sorry

/-- `localRing` has Krull dimension `2`. -/
theorem localRing_ringKrullDim : ringKrullDim localRing = 2 := sorry

/-- `localRing` is an excellent 2-dimensional Noetherian local ring. -/
theorem localRing_spec :
    IsExcellentRing localRing ∧ IsNoetherianRing localRing ∧ IsLocalRing localRing ∧
      ringKrullDim localRing = 2 := sorry

end AlgebraicGeometry.CubicQuarticSurface
