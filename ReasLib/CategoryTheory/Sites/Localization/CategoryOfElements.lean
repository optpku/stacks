/-!
# Category-of-elements localization

This leaf owns the site presented by the opposite category of elements of a
set-valued sheaf, together with its comparison with the slice topos. The
construction is independent of the Stacks Project presentation and is intended
to be imported directly by downstream developments.
-/

@[expose] public section

open CategoryTheory Limits Opposite CategoryOfElements
open CategoryTheory.OverPresheafAux

universe v u

namespace CategoryTheory

namespace Presheaf

variable {C : Type u} [Category.{v} C]

/-- The projection from the opposite category of elements of a presheaf to its base category. -/
abbrev elementsOpProjection (P : Cᵒᵖ ⥤ Type v) : P.Elementsᵒᵖ ⥤ C :=
  (CategoryOfElements.π P).leftOp

/-- The restricted topology on the opposite category of elements of a presheaf. -/
abbrev elementsOpRestrictedTopology (J : GrothendieckTopology C) (P : Cᵒᵖ ⥤ Type v) :
    GrothendieckTopology P.Elementsᵒᵖ :=
  (elementsOpProjection P).restrictedTopology J

/-- A sieve is covering for `elementsOpRestrictedTopology J P` exactly when its projection is a
`J`-cover. -/
theorem mem_elementsOpRestrictedTopology_iff
    (J : GrothendieckTopology C) (P : Cᵒᵖ ⥤ Type v)
    {X : P.Elementsᵒᵖ} {S : Sieve X} :
    S ∈ elementsOpRestrictedTopology J P X ↔
      S.functorPushforward (elementsOpProjection P) ∈ J ((elementsOpProjection P).obj X) := sorry

/-- The elements projection is continuous for its restricted topology. -/
instance elementsOpProjection_isContinuous
    (J : GrothendieckTopology C) (P : Cᵒᵖ ⥤ Type v) :
    Functor.IsContinuous (elementsOpProjection P) (elementsOpRestrictedTopology J P) J := sorry

/-- The elements projection is cocontinuous for its restricted topology. -/
instance elementsOpProjection_isCocontinuous
    (J : GrothendieckTopology C) (P : Cᵒᵖ ⥤ Type v) :
    Functor.IsCocontinuous (elementsOpProjection P) (elementsOpRestrictedTopology J P) J := sorry

/-- The canonical presheaf-level equivalence from the opposite category of elements of `P` to
presheaves over `P`. -/
noncomputable abbrev elementsOpEquivOver (P : Cᵒᵖ ⥤ Type v) :
    P.Elementsᵒᵖᵒᵖ ⥤ Type v ≌ Over P :=
  ((costructuredArrowYonedaEquivalence P).op.congrLeft).trans
    (overEquivPresheafCostructuredArrow P).symm

end Presheaf

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable (F : Sheaf J (Type v))

noncomputable section

/-- The projection from the opposite category of elements of a sheaf to its base site. -/
abbrev localizationProjection (F : Sheaf J (Type v)) : F.obj.Elementsᵒᵖ ⥤ C :=
  Presheaf.elementsOpProjection F.obj

/-- The topology on the category of elements generated by image sieves under
`localizationProjection F`. -/
abbrev localizationTopology (F : Sheaf J (Type v)) : GrothendieckTopology F.obj.Elementsᵒᵖ :=
  Presheaf.elementsOpRestrictedTopology J F.obj

/-- A sieve on the category of elements is a localization cover exactly when its image in the
base site is a `J`-cover. -/
theorem localizationTopology_mem_iff {X : F.obj.Elementsᵒᵖ} {S : Sieve X} :
    S ∈ localizationTopology F X ↔
      S.functorPushforward (localizationProjection F) ∈ J ((localizationProjection F).obj X) := sorry

/-- The category-of-elements projection is continuous for its localization topology. -/
instance localizationProjection_isContinuous :
    Functor.IsContinuous (localizationProjection F) (localizationTopology F) J := sorry

/-- The category-of-elements projection is cocontinuous for its localization topology. -/
instance localizationProjection_isCocontinuous :
    Functor.IsCocontinuous (localizationProjection F) (localizationTopology F) J := sorry

/-- The canonical presheaf-level equivalence between the category of elements of `F` and
presheaves over its underlying presheaf. -/
noncomputable abbrev sheafCategoryOfElementsPresheafEquivOverPresheaf :
    F.obj.Elementsᵒᵖᵒᵖ ⥤ Type v ≌ Over F.obj :=
  Presheaf.elementsOpEquivOver F.obj

/-- Sheaf presheaves are stable under isomorphism of presheaves. -/
instance presheafIsSheaf_isClosedUnderIsomorphisms :
    ObjectProperty.IsClosedUnderIsomorphisms (Presheaf.IsSheaf J : ObjectProperty (Cᵒᵖ ⥤ Type v)) where
  of_iso := sorry

/-- The property on presheaves over `F.obj` requiring the domain presheaf to be a sheaf. -/
abbrev overPresheafHasSheafDomain : ObjectProperty (Over F.obj) :=
  ObjectProperty.inverseImage (Presheaf.IsSheaf J) (Over.forget F.obj)

/-- Rebundle a presheaf over `F.obj` with sheaf domain as an object over the sheaf `F`. -/
noncomputable def overPresheafHasSheafDomainEquivOver :
    (overPresheafHasSheafDomain F).FullSubcategory ≌ Over F where
  functor :=
    { obj := fun T ↦ Over.mk (⟨T.obj.hom⟩ : ⟨T.obj.left, T.property⟩ ⟶ F)
      map := fun f ↦ Over.homMk ⟨f.hom.left⟩ sorry
      map_id := sorry
      map_comp := sorry }
  inverse :=
    { obj := fun η ↦ ⟨Over.mk η.hom.hom, η.left.property⟩
      map := fun f ↦ ObjectProperty.homMk (Over.homMk f.left.hom sorry)
      map_id := sorry
      map_comp := sorry }
  unitIso := NatIso.ofComponents
    (fun T ↦ ObjectProperty.isoMk (overPresheafHasSheafDomain F) (Over.isoMk (Iso.refl _) sorry)) sorry
  counitIso := NatIso.ofComponents (fun η ↦ Over.isoMk (Iso.refl _) sorry) sorry
  functor_unitIso_comp := sorry

/-- The presheaf-over equivalence transports the sheaf condition exactly to the localization
topology on the category of elements. -/
theorem sheafCategoryOfElementsPresheafEquivOverPresheaf_inverseImage :
    (overPresheafHasSheafDomain F).inverseImage
        (sheafCategoryOfElementsPresheafEquivOverPresheaf F).functor =
      Presheaf.IsSheaf (localizationTopology F) := sorry

/-- Sheaves on the category-of-elements localization are equivalent to objects of `Sh(C, J)`
over `F`. -/
noncomputable def sheafCategoryOfElementsEquivOver :
    Sheaf (localizationTopology F) (Type v) ≌ Over F :=
  (Equivalence.congrFullSubcategory
      (sheafCategoryOfElementsPresheafEquivOverPresheaf F)
      (sheafCategoryOfElementsPresheafEquivOverPresheaf_inverseImage F)).trans
    (overPresheafHasSheafDomainEquivOver F)

/-- The presheaf obtained by collecting sections over the category of elements of `P` is
canonically the product presheaf underlying the slice object `G × P ⟶ P`. -/
noncomputable def yonedaCollectionProjIsoToOverLeft
    (P G : Cᵒᵖ ⥤ Type v) :
    yonedaCollectionPresheaf P ((CostructuredArrow.proj yoneda P).op ⋙ G) ≅
      ((toOver P).obj G).left :=
  NatIso.ofComponents
    (fun X ↦
      eqToIso
          (rfl :
            (yonedaCollectionPresheaf P
              ((CostructuredArrow.proj yoneda P).op ⋙ G)).obj X =
              YonedaCollection ((CostructuredArrow.proj yoneda P).op ⋙ G) X.unop) ≪≫
        Equiv.toIso
          { toFun := fun
              (p : YonedaCollection
                ((CostructuredArrow.proj yoneda P).op ⋙ G) X.unop) ↦
                ((p.snd : G.obj X), p.yonedaEquivFst)
            invFun := fun (p : G.obj X × P.obj X) ↦
              YonedaCollection.mk
                (F := (CostructuredArrow.proj yoneda P).op ⋙ G)
                (yonedaEquiv.symm p.2) p.1
            left_inv := sorry
            right_inv := sorry } ≪≫
        eqToIso
          (rfl :
            (G.obj X × P.obj X) = ((toOver P).obj G).left.obj X))
    sorry

/-- Objectwise comparison between restriction along the category-of-elements projection,
transported through `sheafCategoryOfElementsEquivOver`, and the canonical slice object over
`F`.  Its maps are the explicit section/tautological-section pairing; only functoriality laws are
deferred. -/
noncomputable def sheafCategoryOfElementsInverseImageObjIsoToOver
    (G : Sheaf J (Type v)) :
    (sheafCategoryOfElementsEquivOver F).functor.obj
        (((localizationProjection F).sheafPushforwardContinuous (Type v)
          (localizationTopology F) J).obj G) ≅
      (toOver F).obj G :=
  Over.isoMk
    (ObjectProperty.isoMk (Presheaf.IsSheaf J)
      (((yonedaCollectionFunctor F.obj).mapIso
          (Functor.isoWhiskerRight
            (Iso.refl ((CostructuredArrow.proj yoneda F.obj).op)) G.obj)) ≪≫
        yonedaCollectionProjIsoToOverLeft F.obj G.obj))
    sorry

/-- Under the category-of-elements equivalence, inverse image along the localization projection
is the canonical functor `toOver F` into the slice over `F`. -/
noncomputable def sheafCategoryOfElementsInverseImageIsoToOver :
    (localizationProjection F).sheafPushforwardContinuous (Type v)
        (localizationTopology F) J ⋙
      (sheafCategoryOfElementsEquivOver F).functor ≅
        toOver F :=
  NatIso.ofComponents (sheafCategoryOfElementsInverseImageObjIsoToOver F) sorry

/-- Lemma 7.30.3 (0791), compatibility form: the category-of-elements equivalence identifies
inverse image along the projection with the right adjoint `Over.star F` to the slice forgetful
functor. -/
@[stacks 0791 "localization inverse image"]
noncomputable def sheafCategoryOfElementsInverseImageIsoStar :
    (localizationProjection F).sheafPushforwardContinuous (Type v)
        (localizationTopology F) J ⋙
      (sheafCategoryOfElementsEquivOver F).functor ≅
        Over.star F :=
  sheafCategoryOfElementsInverseImageIsoToOver F ≪≫
    ((Over.forgetAdjStar F).rightAdjointUniq (forgetAdjToOver F)).symm

/-- Under the category-of-elements equivalence, the terminal sheaf corresponds to the terminal
slice object `𝟙 F : F ⟶ F`. -/
noncomputable def localizationTerminalIsoOverId :
    (sheafCategoryOfElementsEquivOver F).functor.obj
        (Sheaf.terminal (localizationTopology F) Limits.Types.isTerminalPUnit) ≅
      Over.mk (𝟙 F) :=
  (sheafCategoryOfElementsEquivOver F).functor.mapIso
      (Limits.IsTerminal.uniqueUpToIso
        (Sheaf.isTerminalTerminal (localizationTopology F) Limits.Types.isTerminalPUnit)
        Limits.terminalIsTerminal) ≪≫
    PreservesTerminal.iso (sheafCategoryOfElementsEquivOver F).functor ≪≫
    Limits.IsTerminal.uniqueUpToIso Limits.terminalIsTerminal Over.mkIdTerminal

/-- Morphisms from the terminal sheaf of the category-of-elements localization to the inverse
image of `G` identify canonically with morphisms `F ⟶ G` on the original site. -/
noncomputable def localizationTerminalHomEquiv (G : Sheaf J (Type v)) :
    (Sheaf.terminal (localizationTopology F) Limits.Types.isTerminalPUnit ⟶
        ((localizationProjection F).sheafPushforwardContinuous
          (Type v) (localizationTopology F) J).obj G) ≃
      (F ⟶ G) :=
  (Functor.FullyFaithful.homEquiv
      (Functor.FullyFaithful.ofFullyFaithful
        (sheafCategoryOfElementsEquivOver F).functor)).trans
    (((localizationTerminalIsoOverId F).homCongr
      ((sheafCategoryOfElementsInverseImageIsoStar F).app G)).trans
        ((Over.forgetAdjStar F).homEquiv (Over.mk (𝟙 F)) G).symm)

/-- The terminal-sheaf Hom equivalence for a category-of-elements localization is natural in
the target sheaf. -/
theorem localizationTerminalHomEquiv_naturality
    {G H : Sheaf J (Type v)} (g : G ⟶ H)
    (f : Sheaf.terminal (localizationTopology F) Limits.Types.isTerminalPUnit ⟶
      ((localizationProjection F).sheafPushforwardContinuous
        (Type v) (localizationTopology F) J).obj G) :
    localizationTerminalHomEquiv F H
        (f ≫ ((localizationProjection F).sheafPushforwardContinuous
          (Type v) (localizationTopology F) J).map g) =
      localizationTerminalHomEquiv F G f ≫ g := sorry

/-- The morphism of topoi presented by the category-of-elements projection. -/
noncomputable def localizationMorphismOfTopoiIn
    [∀ G : F.obj.Elementsᵒᵖᵒᵖ ⥤ Type (max u v),
      (localizationProjection F).op.HasPointwiseRightKanExtension G] :
    MorphismOfTopoiIn J (localizationTopology F) :=
  (localizationProjection F).morphismOfTopoiInOfCocontinuous (localizationTopology F) J

end

end CategoryTheory
