module

public import ReasLib.RingTheory.Algebra.TensorProduct.RingHom
public import ReasLib.RingTheory.DividedPowers.Category.Colimits
public import ReasLib.RingTheory.DividedPowers.Category.Quotient
public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.IsPullback.Defs
public import Mathlib.RingTheory.TensorProduct.Maps
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Pushouts of Divided Power Rings

This module records the quotient and tensor-product descriptions attached to a pushout of
divided power rings.  Algebra structures depending on the two legs of the span are confined to
the concrete data definitions below.
-/

open CategoryTheory CategoryTheory.Limits
open DividedPowers

universe u

noncomputable section

namespace DividedPowerRing.Pushout

/-- The span of underlying ring homomorphisms selected by two divided-power
ring morphisms with common source. -/
def span {A B B' : DividedPowerRing.{u}} (f : A ⟶ B) (g : A ⟶ B') :
    Algebra.TensorProduct.RingHom.Span (X := A) (Y := B) (Z := B') where
  left := f.toRingHom
  right := g.toRingHom

/-- The left inclusion into `B ⊗_A B'` for the algebra structures selected by a span of
divided power rings. -/
def includeLeft {A B B' : DividedPowerRing.{u}} (f : A ⟶ B) (g : A ⟶ B') :=
  (span f g).includeLeft

/-- The right inclusion into `B ⊗_A B'` for the algebra structures selected by a span of
divided power rings. -/
def includeRight {A B B' : DividedPowerRing.{u}} (f : A ⟶ B) (g : A ⟶ B') :=
  (span f g).includeRight

/-- Infrastructure for Remark 23.3.5 (Tag 0H86): the ideal of `B ⊗_A B'` generated by the
images of the two divided-power ideals. -/
@[stacks 0H86 "tensor ideal"]
def tensorIdeal {A B B' : DividedPowerRing.{u}} (f : A ⟶ B) (g : A ⟶ B') :=
  Ideal.map (includeLeft f g) B.ideal ⊔ Ideal.map (includeRight f g) B'.ideal

namespace tensorIdeal

/-- The image of the left divided-power ideal is contained in the tensor ideal. -/
theorem map_left_le {A B B' : DividedPowerRing.{u}} (f : A ⟶ B) (g : A ⟶ B') :
    Ideal.map (includeLeft f g) B.ideal ≤ tensorIdeal f g := sorry

/-- The image of the right divided-power ideal is contained in the tensor ideal. -/
theorem map_right_le {A B B' : DividedPowerRing.{u}} (f : A ⟶ B) (g : A ⟶ B') :
    Ideal.map (includeRight f g) B'.ideal ≤ tensorIdeal f g := sorry

end tensorIdeal

/-- The pure tensor in `B ⊗_A B'` for the algebra structures selected by a span of divided
power rings. -/
def tmul {A B B' : DividedPowerRing.{u}} (f : A ⟶ B) (g : A ⟶ B') (b : B) (b' : B') :=
  (span f g).tmul b b'

/-- The left tensor inclusion sends `b` to `b ⊗ₜ 1`. -/
@[simp]
theorem includeLeft_apply {A B B' : DividedPowerRing.{u}} (f : A ⟶ B) (g : A ⟶ B')
    (b : B) : includeLeft f g b = tmul f g b 1 := sorry

/-- The right tensor inclusion sends `b'` to `1 ⊗ₜ b'`. -/
@[simp]
theorem includeRight_apply {A B B' : DividedPowerRing.{u}} (f : A ⟶ B) (g : A ⟶ B')
    (b' : B') : includeRight f g b' = tmul f g 1 b' := sorry

/-- The square of underlying ring homomorphisms selected by a commutative
square of divided-power rings. -/
def square {A B B' B'' : DividedPowerRing.{u}} (f : A ⟶ B) (g : A ⟶ B')
    (i : B ⟶ B'') (j : B' ⟶ B'') (hcomm : f ≫ i = g ≫ j) :
    Algebra.TensorProduct.RingHom.Square (X := A) (Y := B) (Z := B') (W := B'') where
  sourceLeft := f.toRingHom
  sourceRight := g.toRingHom
  leftTarget := i.toRingHom
  rightTarget := j.toRingHom
  comm := congrArg (fun k : A ⟶ B'' ↦ k.toRingHom) hcomm

/-- Infrastructure for Remark 23.3.5 (Tag 0H86): the canonical ring map `B ⊗_A B' → B''`
induced by a commutative square of divided power rings. -/
@[stacks 0H86 "canonical tensor map"]
def tensorProductTo {A B B' B'' : DividedPowerRing.{u}} (f : A ⟶ B) (g : A ⟶ B')
    (i : B ⟶ B'') (j : B' ⟶ B'') (hcomm : f ≫ i = g ≫ j) :=
  (square f g i j hcomm).map

namespace tensorProductTo

/-- The canonical map associated to a commutative square sends a pure tensor to the product of
the images of its factors. -/
@[simp]
theorem tmul {A B B' B'' : DividedPowerRing.{u}} (f : A ⟶ B)
    (g : A ⟶ B') (i : B ⟶ B'') (j : B' ⟶ B'') (hcomm : f ≫ i = g ≫ j)
    (b : B) (b' : B') :
    tensorProductTo f g i j hcomm (DividedPowerRing.Pushout.tmul f g b b') =
      i.toRingHom b * j.toRingHom b' := sorry

/-- The canonical tensor-product map restricts to the left leg of the commutative square. -/
@[simp]
theorem comp_includeLeft {A B B' B'' : DividedPowerRing.{u}} (f : A ⟶ B)
    (g : A ⟶ B') (i : B ⟶ B'') (j : B' ⟶ B'') (hcomm : f ≫ i = g ≫ j) :
    (tensorProductTo f g i j hcomm).comp (includeLeft f g) = i.toRingHom := sorry

/-- The canonical tensor-product map restricts to the right leg of the commutative square. -/
@[simp]
theorem comp_includeRight {A B B' B'' : DividedPowerRing.{u}} (f : A ⟶ B)
    (g : A ⟶ B') (i : B ⟶ B'') (j : B' ⟶ B'') (hcomm : f ≫ i = g ≫ j) :
    (tensorProductTo f g i j hcomm).comp (includeRight f g) = j.toRingHom := sorry

end tensorProductTo

/-- Remark 23.3.5 (Tag 0H86), part (1): quotienting a pushout square of divided power rings by the
distinguished ideals yields a pushout square of commutative rings. -/
@[stacks 0H86 "(1)"]
theorem quotient_isPushout {A B B' B'' : DividedPowerRing.{u}} (f : A ⟶ B) (g : A ⟶ B')
    (i : B ⟶ B'') (j : B' ⟶ B'') (hpush : IsPushout f g i j) :
    IsPushout (DividedPowerRing.quotient.map f) (DividedPowerRing.quotient.map g)
      (DividedPowerRing.quotient.map i) (DividedPowerRing.quotient.map j) := sorry

/-- Remark 23.3.5 (Tag 0H86), part (2): the canonical map `B ⊗_A B' → B''` associated to a
pushout of divided power rings is surjective. -/
@[stacks 0H86 "(2)"]
theorem tensorProductTo_surjective {A B B' B'' : DividedPowerRing.{u}} (f : A ⟶ B)
    (g : A ⟶ B') (i : B ⟶ B'') (j : B' ⟶ B'') (hpush : IsPushout f g i j) :
    Function.Surjective (tensorProductTo f g i j hpush.w) := sorry

/-- Remark 23.3.5 (Tag 0H86), part (3): under the canonical map attached to a pushout, the ideal
generated by the two source divided-power ideals maps onto the target divided-power ideal. -/
@[stacks 0H86 "(3)"]
theorem map_tensorIdeal_eq {A B B' B'' : DividedPowerRing.{u}} (f : A ⟶ B)
    (g : A ⟶ B') (i : B ⟶ B'') (j : B' ⟶ B'') (hpush : IsPushout f g i j) :
    Ideal.map (tensorProductTo f g i j hpush.w) (tensorIdeal f g) = B''.ideal := sorry

end DividedPowerRing.Pushout
