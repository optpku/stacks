module

public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Ideal.Quotient.Head
public import ReasLib.RingTheory.LocalRing.Quotient
public import ReasLib.RingTheory.RegularLocalRing.Parameters

@[expose] public section

/-!
# Head Quotients of Local Parameter Families

The underlying ideal and unbundled quotient tail are owned by
`Ideal.Quotient.Head`.  This leaf only records the local refinement that
packages the tail in the maximal ideal of the quotient ring, together with
the parameter-ideal consequences needed by regular-local applications.
-/

universe u

namespace IsLocalRing

variable {R : Type u} [CommRing R] [IsLocalRing R]

namespace HeadQuotient

/-- Every member of the generic head-quotient tail of a maximal-ideal family
lies in the maximal ideal of the quotient local ring. -/
@[stacks 02IE "head quotient parameter tail is maximal-ideal valued"]
theorem tail_mem_maximalIdeal {d : ℕ}
    (x : Fin (d + 1) → maximalIdeal R) (i : Fin d) :
    Ideal.headQuotientTail (fun j ↦ (x j : R)) i ∈
      maximalIdeal (R ⧸ Ideal.headIdeal (fun j ↦ (x j : R))) := sorry

/-- The head-quotient tail of a finite maximal-ideal family, packaged in the
maximal ideal of the quotient local ring. -/
@[stacks 02IE "head quotient maximal-ideal parameter tail"]
def tail {d : ℕ} (x : Fin (d + 1) → maximalIdeal R) :
    Fin d → maximalIdeal (R ⧸ Ideal.headIdeal (fun j ↦ (x j : R))) :=
  fun i ↦ ⟨Ideal.headQuotientTail (fun j ↦ (x j : R)) i,
    tail_mem_maximalIdeal x i⟩

/-- Coercing the bundled head-quotient tail recovers its unbundled quotient
image. -/
@[simp, stacks 02IE "head quotient tail coercion"]
theorem coe_tail {d : ℕ}
    (x : Fin (d + 1) → maximalIdeal R) (i : Fin d) :
    (tail x i : R ⧸ Ideal.headIdeal (fun j ↦ (x j : R))) =
      Ideal.headQuotientTail (fun j ↦ (x j : R)) i := sorry

/-- Mapping the parameter ideal through the head quotient yields the span of
the quotient tail. -/
@[stacks 02IE "parameter ideal under head quotient"]
theorem map_parameterIdeal_eq_span_tail {d : ℕ}
    (x : Fin (d + 1) → maximalIdeal R) :
    Ideal.map (Ideal.Quotient.mk (Ideal.headIdeal (fun j ↦ (x j : R))))
        (parameterIdeal x) =
      Ideal.span (Set.range (Ideal.headQuotientTail (fun j ↦ (x j : R)))) := sorry

/-- Mapping the parameter ideal through the head quotient yields the parameter
ideal generated by the bundled quotient tail. -/
@[stacks 02IE "parameter ideal under head quotient"]
theorem map_parameterIdeal_eq_parameterIdeal_tail {d : ℕ}
    (x : Fin (d + 1) → maximalIdeal R) :
    Ideal.map (Ideal.Quotient.mk (Ideal.headIdeal (fun j ↦ (x j : R))))
        (parameterIdeal x) =
      parameterIdeal (tail x) := sorry

/-- If a finite family generates the maximal ideal, its tail generates the
maximal ideal after quotienting by the head. -/
@[stacks 02IE "head quotient tail generates maximal ideal"]
theorem tail_generates_maximalIdeal {d : ℕ}
    (x : Fin (d + 1) → maximalIdeal R) (hx : parameterIdeal x = maximalIdeal R) :
    parameterIdeal (tail x) =
      maximalIdeal (R ⧸ Ideal.headIdeal (fun j ↦ (x j : R))) := sorry

end HeadQuotient

end IsLocalRing
