module

public import ReasLib.Algebra.Module.DifferentialOperator.DeRham
public import Mathlib.RingTheory.Kaehler.Basic
public import Mathlib.RingTheory.DividedPowers.Basic
import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

noncomputable section

universe u v

namespace KaehlerDifferential.DeRham

/-- The `B`-submodule of `Ω[B⁄A]` generated by the divided-power relations
`D (δ.dpow n x) - δ.dpow (n - 1) x • D x` for positive `n` and `x ∈ J`. -/
def dividedPowerRelations
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (instance diamond): f.toAlgebra is scoped locally to avoid competing Algebra A B instances derived from unrelated ring-hom choices.
    letI : Algebra A B := f.toAlgebra
    Submodule B (KaehlerDifferential A B) :=
  -- Local instance justification (instance diamond): f.toAlgebra is scoped locally to avoid competing Algebra A B instances derived from unrelated ring-hom choices.
  letI : Algebra A B := f.toAlgebra
  Submodule.span B {ω | ∃ (n : ℕ) (x : B), x ∈ J ∧ 1 ≤ n ∧
    ω = KaehlerDifferential.D A B (δ.dpow n x) -
      δ.dpow (n - 1) x • KaehlerDifferential.D A B x}

/-- The divided-power module of relative differentials is the quotient of
`Ω[B⁄A]` by `dividedPowerRelations f δ`. -/
abbrev dividedPowerDifferential
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (instance diamond): f.toAlgebra is scoped locally to avoid competing Algebra A B instances derived from unrelated ring-hom choices.
    letI : Algebra A B := f.toAlgebra
    Type v :=
  -- Local instance justification (instance diamond): f.toAlgebra is scoped locally to avoid competing Algebra A B instances derived from unrelated ring-hom choices.
  letI : Algebra A B := f.toAlgebra
  KaehlerDifferential A B ⧸ dividedPowerRelations f δ

/-- The degree-`i` divided-power differential forms are exterior powers over `B`
of the divided-power module of relative differentials. -/
abbrev dividedPowerDifferentialForm
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) (i : ℕ) :
    -- Local instance justification (instance diamond): f.toAlgebra is scoped locally to avoid competing Algebra A B instances derived from unrelated ring-hom choices.
    letI : Algebra A B := f.toAlgebra
    Type v :=
  -- Local instance justification (instance diamond): f.toAlgebra is scoped locally to avoid competing Algebra A B instances derived from unrelated ring-hom choices.
  letI : Algebra A B := f.toAlgebra
  exteriorPower.form B (dividedPowerDifferential f δ) i

/-- The universal divided-power differential derivation is induced by the quotient map
from the universal Kähler derivation. -/
def dividedPowerDifferentialDerivation
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (instance diamond): f.toAlgebra is scoped locally to avoid competing Algebra A B instances derived from unrelated ring-hom choices.
    letI : Algebra A B := f.toAlgebra
    Derivation A B (dividedPowerDifferential f δ) :=
  -- Local instance justification (instance diamond): f.toAlgebra is scoped locally to avoid competing Algebra A B instances derived from unrelated ring-hom choices.
  letI : Algebra A B := f.toAlgebra
  (dividedPowerRelations f δ).mkQ.compDer (KaehlerDifferential.D A B)

/-- The submodule of ambient Kähler differentials generated by the positive
divided-power differentiation relations. -/
def ambientDividedPowerRelations
    {A : Type u} [CommRing A] {B : Type v} [CommRing B] [Algebra A B]
    {J : Ideal B} (δ : DividedPowers J) : Submodule B (KaehlerDifferential A B) :=
  Submodule.span B {ω | ∃ (n : ℕ) (x : B), x ∈ J ∧ 1 ≤ n ∧
    ω = KaehlerDifferential.D A B (δ.dpow n x) -
      δ.dpow (n - 1) x • KaehlerDifferential.D A B x}

/-- The divided-power differential module for the supplied algebra `A → B`. -/
abbrev ambientDividedPowerDifferential
    {A : Type u} [CommRing A] {B : Type v} [CommRing B] [Algebra A B]
    {J : Ideal B} (δ : DividedPowers J) : Type v :=
  KaehlerDifferential A B ⧸ ambientDividedPowerRelations (A := A) δ

/-- The universal divided-power derivation for the canonical algebra map `A → B`. -/
def ambientDividedPowerDifferentialDerivation
    {A : Type u} [CommRing A] {B : Type v} [CommRing B] [Algebra A B]
    {J : Ideal B} (δ : DividedPowers J) :
    Derivation A B (ambientDividedPowerDifferential (A := A) (B := B) δ) :=
  (ambientDividedPowerRelations (A := A) δ).mkQ.compDer (KaehlerDifferential.D A B)

/-- Every positive-degree divided-power relation belongs to the relation submodule. -/
theorem mem_dividedPowerRelations
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J)
    (n : ℕ) (x : B) (hx : x ∈ J) (hn : 1 ≤ n) :
    -- Local instance justification (instance diamond): f.toAlgebra is scoped locally to avoid competing Algebra A B instances derived from unrelated ring-hom choices.
    letI : Algebra A B := f.toAlgebra
    KaehlerDifferential.D A B (δ.dpow n x) -
        δ.dpow (n - 1) x • KaehlerDifferential.D A B x ∈
      dividedPowerRelations f δ := sorry

/-- The quotient derivation is the Kähler derivation followed by the quotient map. -/
theorem dividedPowerDifferentialDerivation_apply
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) (b : B) :
    -- Local instance justification (instance diamond): f.toAlgebra is scoped locally to avoid competing Algebra A B instances derived from unrelated ring-hom choices.
    letI : Algebra A B := f.toAlgebra
    dividedPowerDifferentialDerivation f δ b =
      (dividedPowerRelations f δ).mkQ (KaehlerDifferential.D A B b) := sorry

/-- Degree-zero divided-power forms are the coefficient ring `B`. -/
theorem dividedPowerDifferentialForm_zero
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (instance diamond): f.toAlgebra is scoped locally to avoid competing Algebra A B instances derived from unrelated ring-hom choices.
    letI : Algebra A B := f.toAlgebra
    dividedPowerDifferentialForm f δ 0 = B := sorry

/-- The quotient module of divided-power relative differentials admits a de Rham
differential family extending its universal derivation. -/
theorem existsDividedPowerFamily
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (instance diamond): f.toAlgebra is scoped locally to avoid competing Algebra A B instances derived from unrelated ring-hom choices.
    letI : Algebra A B := f.toAlgebra
    ∃ dδ : DifferentialOperator.DeRham.Family A B (dividedPowerDifferential f δ),
      DifferentialOperator.DeRham.IsDifferential
        (dividedPowerDifferentialDerivation f δ) dδ := sorry

end KaehlerDifferential.DeRham

end

namespace CrystallinePDDeRham

variable (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
variable {J : Ideal B} (δ : DividedPowers J)

/-- PD relations with the ambient algebra instance retained, avoiding a
second definitionally different algebra structure from a ring-hom wrapper. -/
noncomputable def relations : Submodule B Ω[B⁄A] :=
  by
    have h : (algebraMap A B).toAlgebra = (inferInstance : Algebra A B) := toAlgebra_algebraMap
    let carrier := fun a : Algebra A B ↦
      -- Local instance justification (defeq pin): dependent transport indexes the algebra structure a.
      letI : Algebra A B := a
      Submodule B (KaehlerDifferential A B)
    exact cast (congrArg carrier h) (KaehlerDifferential.DeRham.dividedPowerRelations (algebraMap A B) δ)

/-- The Kähler derivation followed by the quotient by the transported PD relations. -/
noncomputable def derivation : Derivation A B (Ω[B⁄A] ⧸ relations A B δ) :=
  (relations A B δ).mkQ.compDer (KaehlerDifferential.D A B)

end CrystallinePDDeRham
