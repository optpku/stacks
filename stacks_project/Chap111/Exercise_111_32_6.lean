module

import StacksCheckRecall
import ReasLib.AlgebraicGeometry.RingedSpace.ConstantModTwo

open CategoryTheory CategoryTheory.Limits Opposite TopCat TopologicalSpace
open AlgebraicGeometry AlgebraicGeometry.RingedSpace
open SheafOfModules.RingedSite

namespace AlgebraicGeometry.RingedSpace.ConstantModTwo

/- Exercise 111.32.6 (1): the pushforward of the constant `ZMod 2` sheaf along the singleton
inclusion is a skyscraper sheaf. -/
@[stacks 028M] #check (AlgebraicGeometry.RingedSpace.ConstantModTwo.pushforward_isSkyscraper :
  TopCat.Sheaf.IsSkyscraper
    ((TopCat.Sheaf.pushforward CommRingCat originInclusion).obj
      (constantModTwo (TopCat.subsetSpace origin))))

/- Exercise 111.32.6 (2): there is a canonical locally surjective map from the ambient constant
sheaf to the pushforward of the constant sheaf on the singleton. -/
@[stacks 028M] #check (AlgebraicGeometry.RingedSpace.ConstantModTwo.canonicalMap_isLocallySurjective :
  CategoryTheory.Sheaf.IsLocallySurjective canonicalMap)

/- Exercise 111.32.6 (3): the kernel of the canonical map is an ideal sheaf of the ambient
constant sheaf. -/
@[stacks 028M] #check
  (AlgebraicGeometry.RingedSpace.Hom.kernelIdealSubobject
    AlgebraicGeometry.RingedSpace.ConstantModTwo.inclusion :
    IdealSubobject AlgebraicGeometry.RingedSpace.ConstantModTwo.realRingedSpace)

/- Exercise 111.32.6 (4): the kernel ideal sheaf is not locally generated by sections in the sense
of Modules, Definition 17.8.1. -/
@[stacks 028M] #check
  (AlgebraicGeometry.RingedSpace.ConstantModTwo.not_isLocallyGeneratedBySections :
  ¬ SheafOfModules.IsLocallyGeneratedBySections (Hom.kernelIdealSheaf inclusion))

#check (SheafOfModules.RingedSite.KernelIdeal.ι_comp_map canonicalMap :
  KernelIdeal.ι canonicalMap ≫ KernelIdeal.map canonicalMap = 0)

#check (SheafOfModules.RingedSite.KernelIdeal.mem_sectionIdeal_iff canonicalMap :
  ∀ (U : (Opens realSpace)ᵒᵖ) (x : (constantModTwo realSpace).obj.obj U),
    x ∈ KernelIdeal.sectionIdeal canonicalMap U ↔
      ∃ y, KernelIdeal.ιApp canonicalMap U y = x)

#check (SheafOfModules.RingedSite.KernelIdeal.sections_eq_sectionIdeal canonicalMap :
  ∀ (U : (Opens realSpace)ᵒᵖ),
    IdealSheaf.sections (KernelIdeal.subobject canonicalMap) U =
      KernelIdeal.sectionIdeal canonicalMap U)

end AlgebraicGeometry.RingedSpace.ConstantModTwo
