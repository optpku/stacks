module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import ReasLib.AlgebraicGeometry.Scheme.Morphism.TangentSpace.EmbeddingDimension

/-!
# The affine plane cusp

The affine hypersurface `Spec (k[x, y] / (x ^ 2 - y ^ 3))` over a field `k`,
its structure morphism to `Spec k`, and the tangent dimension at its
`k`-rational origin `(0, 0)`.
-/

@[expose] public section

noncomputable section

open AlgebraicGeometry CategoryTheory MvPolynomial
open scoped AlgebraicGeometry

universe u

namespace AlgebraicGeometry.AffineCusp

/-- The plane-cusp equation `X 0 ^ 2 - X 1 ^ 3` in `k[x, y]`. -/
def relation (k : Type u) [Field k] : MvPolynomial (Fin 2) k :=
  X 0 ^ 2 - X 1 ^ 3

/-- The defining equation is `X 0 ^ 2 - X 1 ^ 3`. -/
theorem relation_def (k : Type u) [Field k] :
    relation k = X 0 ^ 2 - X 1 ^ 3 := sorry

/-- The coordinate ring `k[x, y] / (x ^ 2 - y ^ 3)` of the affine plane cusp. -/
abbrev CoordinateRing (k : Type u) [Field k] : Type u :=
  MvPolynomial (Fin 2) k ⧸ Ideal.span {relation k}

/-- The coordinate ring is the displayed principal quotient. -/
theorem coordinateRing_eq (k : Type u) [Field k] :
    CoordinateRing k = (MvPolynomial (Fin 2) k ⧸ Ideal.span {relation k}) := sorry

/-- The class of the first polynomial coordinate `x` in the cusp coordinate ring. -/
def coordX (k : Type u) [Field k] : CoordinateRing k :=
  Ideal.Quotient.mk (Ideal.span {relation k}) (X 0)

/-- The class of the second polynomial coordinate `y` in the cusp coordinate ring. -/
def coordY (k : Type u) [Field k] : CoordinateRing k :=
  Ideal.Quotient.mk (Ideal.span {relation k}) (X 1)

/-- The two coordinates satisfy the cusp equation `coordX ^ 2 = coordY ^ 3`. -/
theorem coordX_pow_two_eq_coordY_pow_three (k : Type u) [Field k] :
    coordX k ^ 2 = coordY k ^ 3 := sorry

/-- The affine plane cusp `X = Spec (k[x, y] / (x ^ 2 - y ^ 3))`. -/
def scheme (k : Type u) [Field k] : Scheme.{u} :=
  Spec (.of (CoordinateRing k))

/-- The affine plane cusp is the spectrum of its coordinate ring. -/
theorem scheme_eq_spec (k : Type u) [Field k] :
    scheme k = Spec (.of (CoordinateRing k)) := sorry

/-- The structure morphism `X ⟶ Spec k` induced by `algebraMap k (CoordinateRing k)`. -/
def toBase (k : Type u) [Field k] : scheme k ⟶ Spec (.of k) :=
  Spec.map (CommRingCat.ofHom (algebraMap k (CoordinateRing k)))

/-- The structure morphism is the spectrum of the quotient algebra map. -/
theorem toBase_def (k : Type u) [Field k] :
    toBase k = Spec.map (CommRingCat.ofHom (algebraMap k (CoordinateRing k))) := sorry

/-- The ideal of the `k`-rational origin `(0, 0)`, generated by the two coordinates. -/
def originIdeal (k : Type u) [Field k] : Ideal (CoordinateRing k) :=
  Ideal.span {coordX k, coordY k}

/-- The origin ideal is generated by `coordX` and `coordY`. -/
theorem originIdeal_eq_span (k : Type u) [Field k] :
    originIdeal k = Ideal.span {coordX k, coordY k} := sorry

/-- The origin ideal is a prime ideal of the coordinate ring. -/
instance originIdeal_isPrime (k : Type u) [Field k] : (originIdeal k).IsPrime := sorry

/-- The `k`-rational origin `(0, 0)` on the affine plane cusp. -/
def origin (k : Type u) [Field k] : scheme k :=
  ⟨originIdeal k, originIdeal_isPrime k⟩

/-- The prime ideal underlying the origin is generated by the two coordinates. -/
theorem origin_asIdeal (k : Type u) [Field k] :
    (origin k).asIdeal = Ideal.span {coordX k, coordY k} := sorry

/-- The relative tangent space of the affine plane cusp at the origin is
finite-dimensional over the residue field. -/
instance instFiniteDimensionalTangentSpaceAtOrigin (k : Type u) [Field k] :
    FiniteDimensional ((scheme k).residueField (origin k))
      (Scheme.Hom.tangentSpaceAt (toBase k) (origin k)) := sorry

/-- For every field `k`, the relative tangent space of the affine plane cusp
over `Spec k` at its `k`-rational origin has residue-field dimension `2`. -/
@[stacks 029K]
theorem tangentDimensionAt_origin (k : Type u) [Field k] :
    Scheme.Hom.tangentDimensionAt (toBase k) (origin k) = 2 := sorry

end AlgebraicGeometry.AffineCusp
