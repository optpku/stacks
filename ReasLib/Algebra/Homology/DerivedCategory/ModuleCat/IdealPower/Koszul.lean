module

public import ReasLib.Algebra.Homology.DerivedCategory.ModuleCat.IdealPower.Submodule
public import ReasLib.Algebra.Homology.Koszul.PowerTower
public import ReasLib.CategoryTheory.Pro.Sequential.Isomorphism
import Mathlib.Tactic.CrossRefAttribute

/-!
# Ideal powers and powered Koszul ideal complexes

The adic tower `(I ^ (n + 1))[0]` and the powered Koszul ideal-complex tower
`Q(σ≤-1 Kₙ[-1])` are independent reusable owners.  This leaf records their comparison when
`I` is generated by the finite family defining `Kₙ`.
@stack 0G3M
-/

@[expose] public section

open CategoryTheory

noncomputable section

universe u

namespace CategoryTheory.DerivedCategory.IdealPower.Koszul

variable {A : Type u} [CommRing A]
variable {ι : Type u} [Finite ι]

/-- Over a Noetherian ring, the positive adic tower generated by a finite family in the
ambient module universe is pro-isomorphic to its powered Koszul ideal-complex tower
`(Q(σ≤-1 Kₙ[-1]))ₙ`. -/
@[stacks 0G3M "finite-family ideal-power/Koszul pro-isomorphism"]
theorem existsProIsomorphism [IsNoetherianRing A] (f : ι → A) :
    ∃ comparison :
        Pro.SequentialHom
          (Submodule.Positive.regularSystem (Ideal.span (Set.range f)))
          (KoszulComplex.PowerTower.derivedIdealSystem f),
      IsIso comparison.toHom := sorry

namespace Fin

/-- Lemma 15.102.5 (0G3M): for a finite tuple over an arbitrary-universe Noetherian ring,
the positive adic tower it generates is pro-isomorphic to the powered Koszul ideal-complex
tower `(Q(σ≤-1 Kₙ[-1]))ₙ`.  This declaration avoids imposing the ring universe on `Fin r`. -/
@[stacks 0G3M "Lemma 15.102.5"]
theorem existsProIsomorphism [IsNoetherianRing A] {r : ℕ} (f : Fin r → A) :
    ∃ comparison :
        Pro.SequentialHom
          (Submodule.Positive.regularSystem (Ideal.span (Set.range f)))
          (KoszulComplex.PowerTower.derivedIdealSystem f),
      IsIso comparison.toHom := sorry

end Fin

end CategoryTheory.DerivedCategory.IdealPower.Koszul
