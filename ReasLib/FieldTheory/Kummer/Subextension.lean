module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
public import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
public import Mathlib.FieldTheory.Minpoly.Field
public import Mathlib.Tactic.CrossRefAttribute

/-!
@stack 0EXP
-/

@[expose] public section

open Polynomial IntermediateField Module

namespace FieldExtension

variable {K L : Type*} [Field K] [Field L] [Algebra K L] [FiniteDimensional K L]

/-- Lemma 9.24.3 (Tag 0EXP): if a finite extension `L/K` is generated by `α`, the power
`α ^ [L : K]` lies in `K`, and every `[L : K]`th root of unity in `L` lies in `K`, then every
intermediate field is generated by a power `α ^ d` for a divisor `d` of `[L : K]`. -/
theorem exists_dvd_subextension_eq_adjoin_pow
    (α : L) (htop : K⟮α⟯ = ⊤)
    (ha : α ^ finrank K L ∈ (⊥ : IntermediateField K L))
    (hζ : ∀ ζ : L, ζ ^ finrank K L = 1 → ζ ∈ (⊥ : IntermediateField K L))
    (L' : IntermediateField K L) :
    ∃ d : ℕ, d ∣ finrank K L ∧ L' = K⟮α ^ d⟯ := by
  classical
  set e := finrank K L with he
  have hepos : 0 < e := by rw [he]; exact Module.finrank_pos
  have hInt : IsIntegral K α := IsIntegral.of_finite K α
  by_cases hα0 : α = 0
  · subst hα0
    refine ⟨1, one_dvd _, ?_⟩
    have h0 : K⟮(0 : L)⟯ = ⊥ :=
      (IntermediateField.adjoin_simple_eq_bot_iff).mpr (IntermediateField.zero_mem _)
    have htb : (⊤ : IntermediateField K L) = ⊥ := htop.symm.trans h0
    have hL'bot : L' = ⊥ := le_antisymm (htb ▸ le_top) bot_le
    rw [hL'bot, pow_one, h0]
  set d := finrank L' L with hd
  have hdvd : d ∣ e := ⟨finrank K L', by rw [mul_comm]; exact (Module.finrank_mul_finrank K L' L).symm⟩
  refine ⟨d, hdvd, ?_⟩
  have hIntL' : IsIntegral L' α := hInt.tower_top
  have htopL' : L'⟮α⟯ = ⊤ := by
    have hle : K⟮α⟯ ≤ (L'⟮α⟯).restrictScalars K := by
      rw [IntermediateField.adjoin_le_iff]
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst x
      exact IntermediateField.mem_adjoin_simple_self L' α
    rw [htop, top_le_iff] at hle
    exact (IntermediateField.restrictScalars_injective K)
      (hle.trans (IntermediateField.restrictScalars_top).symm)
  have hdeg : d = (minpoly L' α).natDegree := by
    rw [hd, ← IntermediateField.adjoin.finrank hIntL', htopL', IntermediateField.finrank_top']
  set P := minpoly L' α with hPdef
  have hPmonic : P.Monic := minpoly.monic hIntL'
  obtain ⟨a₀, ha₀⟩ := IntermediateField.mem_bot.mp ha
  have haL' : α ^ e ∈ L' := ha₀ ▸ L'.algebraMap_mem a₀
  have hPdvd : P ∣ (X ^ e - C (⟨α ^ e, haL'⟩ : L')) := by
    apply minpoly.dvd
    rw [map_sub, map_pow, aeval_X, aeval_C]
    simp
  have hmem : α ^ d ∈ L' := by
    let M := AlgebraicClosure L
    let ιLM : L →+* M := algebraMap L M
    let f : L' →+* M := ιLM.comp (algebraMap L' L)
    have hιinj : Function.Injective ιLM := (algebraMap L M).injective
    have hfinj : Function.Injective f := hιinj.comp (algebraMap L' L).injective
    set PM := P.map f with hPM
    have hPMmonic : PM.Monic := hPmonic.map f
    have hPMsplits : Polynomial.Splits PM := IsAlgClosed.splits PM
    have hdegPM : PM.natDegree = d := by rw [hPM, hPmonic.natDegree_map, ← hdeg]
    have hc0 : PM.coeff 0 = (-1) ^ d * PM.roots.prod := by
      rw [← hdegPM]
      exact hPMsplits.coeff_zero_eq_prod_roots_of_monic hPMmonic
    have hβpow : ∀ β ∈ PM.roots, β ^ e = (ιLM α) ^ e := by
      intro β hβ
      have hdvdM : PM ∣ (X ^ e - C (ιLM (α ^ e))) := by
        have hmap := Polynomial.map_dvd f hPdvd
        rwa [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C,
          show f (⟨α ^ e, haL'⟩ : L') = ιLM (α ^ e) from rfl] at hmap
      have hPMroot : PM.eval β = 0 := Polynomial.isRoot_of_mem_roots hβ
      have hQMroot : (X ^ e - C (ιLM (α ^ e))).eval β = 0 :=
        Polynomial.eval_eq_zero_of_dvd_of_eval_eq_zero hdvdM hPMroot
      have hbe : β ^ e - ιLM (α ^ e) = 0 := by
        simpa using hQMroot
      rw [sub_eq_zero] at hbe
      rw [hbe, map_pow]
    have hια : ιLM α ≠ 0 := by
      simp only [ne_eq, ιLM, map_eq_zero]
      exact hα0
    have hαd_ne : (α : L) ^ d ≠ 0 := pow_ne_zero _ hα0
    have hcardPM : Multiset.card PM.roots = d := by
      rw [← hdegPM]
      exact Polynomial.splits_iff_card_roots.mp hPMsplits
    have hprodpow : PM.roots.prod ^ e = (ιLM α) ^ (e * d) := by
      have h1 : PM.roots.prod ^ e = (PM.roots.map fun β => β ^ e).prod :=
        (Multiset.prod_hom PM.roots (powMonoidHom e)).symm
      rw [h1, Multiset.map_congr rfl hβpow, Multiset.map_const', Multiset.prod_replicate,
        hcardPM, ← pow_mul]
    have hcoeff : ιLM (algebraMap L' L (P.coeff 0)) = PM.coeff 0 := by
      rw [hPM, Polynomial.coeff_map]
      rfl
    set w : L := (-1) ^ d * algebraMap L' L (P.coeff 0) * (α ^ d)⁻¹ with hwdef
    have hιw : ιLM w = PM.roots.prod * ((ιLM α) ^ d)⁻¹ := by
      have hsign : ((-1 : M)) ^ d * ((-1 : M)) ^ d = 1 := by
        rw [← pow_add, ← two_mul, pow_mul, neg_one_sq, one_pow]
      rw [hwdef, map_mul, map_mul, map_pow, map_inv₀, map_pow, hcoeff, hc0,
        show ιLM (-1) = (-1 : M) from by rw [map_neg, map_one]]
      rw [show (-1 : M) ^ d * ((-1) ^ d * PM.roots.prod) * ((ιLM α) ^ d)⁻¹
            = ((-1 : M) ^ d * (-1) ^ d) * PM.roots.prod * ((ιLM α) ^ d)⁻¹ from by ring,
        hsign, one_mul]
    have hw : w ^ e = 1 := by
      apply hιinj
      rw [map_one, map_pow, hιw, mul_pow, hprodpow, inv_pow, ← pow_mul, mul_comm d e]
      exact mul_inv_cancel₀ (pow_ne_zero _ hια)
    have hwmem : w ∈ (⊥ : IntermediateField K L) := hζ _ hw
    have hwL' : w ∈ L' := (bot_le : (⊥ : IntermediateField K L) ≤ L') hwmem
    have hwne : w ≠ 0 := by
      intro h
      rw [h, zero_pow hepos.ne'] at hw
      exact zero_ne_one hw
    have hcL' : algebraMap L' L (P.coeff 0) ∈ L' := (P.coeff 0).2
    have hsignL' : (-1 : L) ^ d ∈ L' := pow_mem (neg_mem (one_mem L')) d
    have hwad : w * α ^ d = (-1) ^ d * algebraMap L' L (P.coeff 0) := by
      rw [hwdef, mul_assoc, inv_mul_cancel₀ hαd_ne, mul_one]
    have hαdeq : α ^ d = w⁻¹ * ((-1) ^ d * algebraMap L' L (P.coeff 0)) := by
      rw [← hwad, ← mul_assoc, inv_mul_cancel₀ hwne, one_mul]
    rw [hαdeq]
    exact mul_mem (inv_mem hwL') (mul_mem hsignL' hcL')
  have hle : K⟮α ^ d⟯ ≤ L' := (IntermediateField.adjoin_simple_le_iff).mpr hmem
  refine (IntermediateField.eq_of_le_of_finrank_le hle ?_).symm
  set F := K⟮α ^ d⟯ with hFdef
  have hαdF : α ^ d ∈ F := IntermediateField.mem_adjoin_simple_self K (α ^ d)
  have hIntF : IsIntegral F α := hInt.tower_top
  have htopF : F⟮α⟯ = ⊤ := by
    have hsub : K⟮α⟯ ≤ (F⟮α⟯).restrictScalars K := by
      rw [IntermediateField.adjoin_le_iff]
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst x
      exact IntermediateField.mem_adjoin_simple_self F α
    rw [htop, top_le_iff] at hsub
    exact (IntermediateField.restrictScalars_injective K)
      (hsub.trans (IntermediateField.restrictScalars_top).symm)
  have hmle : finrank F L ≤ d := by
    have hdegF : finrank F L = (minpoly F α).natDegree := by
      rw [← IntermediateField.adjoin.finrank hIntF, htopF, IntermediateField.finrank_top']
    rw [hdegF]
    have hdvdF : minpoly F α ∣ (X ^ d - C (⟨α ^ d, hαdF⟩ : F)) := by
      apply minpoly.dvd
      rw [map_sub, map_pow, aeval_X, aeval_C]
      simp
    have hdpos : 0 < d := by rw [hd]; exact Module.finrank_pos
    have hne : (X ^ d - C (⟨α ^ d, hαdF⟩ : F)) ≠ 0 := Polynomial.X_pow_sub_C_ne_zero hdpos _
    calc
      (minpoly F α).natDegree ≤ (X ^ d - C (⟨α ^ d, hαdF⟩ : F)).natDegree :=
        Polynomial.natDegree_le_of_dvd hdvdF hne
      _ = d := Polynomial.natDegree_X_pow_sub_C
  have hFL : finrank K F * finrank F L = e := Module.finrank_mul_finrank K F L
  have hL'L : finrank K L' * d = e := Module.finrank_mul_finrank K L' L
  have hmpos : 0 < finrank F L := Module.finrank_pos
  have hkey : finrank K L' * finrank F L ≤ finrank K F * finrank F L := by
    calc
      finrank K L' * finrank F L ≤ finrank K L' * d := Nat.mul_le_mul_left _ hmle
      _ = e := hL'L
      _ = finrank K F * finrank F L := hFL.symm
  exact Nat.le_of_mul_le_mul_right hkey hmpos

end FieldExtension
