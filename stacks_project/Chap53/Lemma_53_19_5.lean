module

import StacksCheckRecall
public import ReasLib.RingTheory.MvPowerSeries.Jacobian

@[expose] public section

universe u

namespace MvPowerSeries.Jacobian

/- Lemma 53.19.5: for a quotient of a finite-variable formal power series ring over a field,
the ideal generated by the `r × r` minors of the Jacobian matrix is independent of both the
finite generating family of the defining ideal and the regular power-series coordinates. -/
@[stacks 0C4B] #check (MvPowerSeries.Jacobian.minorIdeal_independent :
  ∀ {k : Type u} [Field k] {n m l : ℕ},
    (I : Ideal (MvPowerSeries (Fin n) k)) →
    (f : Fin m → MvPowerSeries (Fin n) k) → (g : Fin l → MvPowerSeries (Fin n) k) →
    Ideal.span (Set.range f) = I → Ideal.span (Set.range g) = I →
    (e e' : MvPowerSeries (Fin n) k ≃ₐ[k] MvPowerSeries (Fin n) k) →
    (r : ℕ) → minorIdeal I e f r = minorIdeal I e' g r)

end MvPowerSeries.Jacobian
