module

public import ReasLib.RingTheory.ReesAlgebra.BlowupChart.Map
public import ReasLib.RingTheory.ReesAlgebra.BlowupChart.Principal
public import ReasLib.RingTheory.Ideal.Principal

/-!
# Compatible maps from affine blowup centers

This leaf owns the ring-theoretic datum required to map an affine blowup chart
to the principal chart generated by the image of its distinguished center
element.  Regularity and valuation hypotheses belong to later consumer leaves.
-/

@[expose] public section

noncomputable section

open scoped AffineBlowupChart

universe u v

namespace AffineBlowupChart

variable {R : Type u} [CommRing R]
variable {B : Type v} [CommRing B]

/-- A map of a blowup center into the principal ideal generated by the image of its distinguished
parameter. -/
@[stacks 052Q "affine blowup chart compatible center map"]
structure ChartMap (I : Ideal R) (a : I) where
  /-- The underlying map from the base ring to the target ring. -/
  toRingHom : R →+* B
  /-- The image of the center lies in the principal ideal generated by the parameter image. -/
  map_center_le : Ideal.map toRingHom I ≤ Ideal.span {toRingHom a.1}

namespace ChartMap

/-- Construct compatible center data from its ideal-theoretic containment. -/
@[stacks 052Q "affine blowup chart compatible center map constructor"]
def ofMapCenterLe {I : Ideal R} {a : I} (f : R →+* B)
    (map_center_le : Ideal.map f I ≤ Ideal.span {f a.1}) : ChartMap (B := B) I a where
  toRingHom := f
  map_center_le := map_center_le

/-- Construct compatible center data from the pointwise divisibility condition on center
elements, using the canonical principal-ideal image criterion. -/
@[stacks 052Q "affine blowup chart compatible center map from divisibility"]
def ofDvd {I : Ideal R} {a : I} (f : R →+* B)
    (h_dvd : ∀ x : I, f a.1 ∣ f x.1) : ChartMap (B := B) I a :=
  ofMapCenterLe f
    ((Ideal.map_le_span_singleton_iff f I (f a.1)).mpr fun x hx ↦ h_dvd ⟨x, hx⟩)

/-- Every mapped center element is divisible by the image of the distinguished parameter. -/
@[stacks 052Q "affine blowup chart center parameter divisibility"]
theorem dvd {I : Ideal R} {a : I} (g : ChartMap (B := B) I a) (x : I) :
    g.toRingHom a.1 ∣ g.toRingHom x.1 := sorry

/-- The image of a center under compatible chart data is exactly the principal ideal generated by
the parameter image. -/
@[stacks 052Q "affine blowup chart mapped center is principal"]
theorem map_center_eq_span {I : Ideal R} {a : I} (g : ChartMap (B := B) I a) :
    Ideal.map g.toRingHom I = Ideal.span {g.toRingHom a.1} := sorry

/-- The canonical map from a source affine blowup chart to the principal target chart determined
by compatible center data. -/
@[stacks 052Q "affine blowup chart map to principal target chart"]
noncomputable def toPrincipal {I : Ideal R} {a : I} (g : ChartMap (B := B) I a) :
    R[I / a] →+* Principal.chart (g.toRingHom a.1) :=
  AffineBlowupChart.map g.toRingHom I (Ideal.span {g.toRingHom a.1})
    (hIJ := Ideal.le_comap_of_map_le g.map_center_le)
    a (Principal.element (g.toRingHom a.1)) (hab := rfl)

end ChartMap

end AffineBlowupChart
