module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Data.Fin.VecNotation
public import Mathlib.FieldTheory.IsAlgClosed.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import Mathlib.RingTheory.KrullDimension.Basic
public import Mathlib.RingTheory.Nullstellensatz
public import ReasLib.RingTheory.MvPolynomial.ZeroLocus

@[expose] public section

universe u

noncomputable section

namespace MvPolynomial.GraphSurface

/-- The graph relation `X 0 ^ 2 - X 3` in five variables. -/
def graphSqPoly (k : Type u) [CommRing k] : MvPolynomial (Fin 5) k :=
  X (0 : Fin 5) ^ 2 - X 3

/-- The graph relation `X 1 ^ 5 - X 4` in five variables. -/
def graphPow5Poly (k : Type u) [CommRing k] : MvPolynomial (Fin 5) k :=
  X (1 : Fin 5) ^ 5 - X 4

/-- The quadratic relation `X 2 ^ 2 + X 2 + X 3 + X 4` in five variables. -/
def quadraticPoly (k : Type u) [CommRing k] : MvPolynomial (Fin 5) k :=
  X (2 : Fin 5) ^ 2 + X 2 + X 3 + X 4

/-- The ideal generated by the two graph relations and the quadratic relation. -/
def ideal (k : Type u) [CommRing k] : Ideal (MvPolynomial (Fin 5) k) :=
  Ideal.span {graphSqPoly k, graphPow5Poly k, quadraticPoly k}

/-- The closed locus of the graph-surface ideal in the prime spectrum of the
five-variable polynomial ring. -/
def zeroLocus (k : Type u) [CommRing k] :
    Set (PrimeSpectrum (MvPolynomial (Fin 5) k)) :=
  PrimeSpectrum.zeroLocus (ideal k : Set (MvPolynomial (Fin 5) k))

/-- The coordinate ring of the closed locus defined by the graph-surface ideal. -/
abbrev CoordinateRing (k : Type u) [CommRing k] : Type u :=
  MvPolynomial (Fin 5) k ⧸ ideal k

/-- The three-variable polynomial `X 2 ^ 2 + X 2 + X 0 ^ 2 + X 1 ^ 5`
obtained by substituting the two graph relations into the quadratic relation. -/
def planePoly (k : Type u) [CommRing k] : MvPolynomial (Fin 3) k :=
  X (2 : Fin 3) ^ 2 + X 2 + X 0 ^ 2 + X 1 ^ 5

/-- The principal ideal defining the eliminated hypersurface in three variables. -/
def planeIdeal (k : Type u) [CommRing k] : Ideal (MvPolynomial (Fin 3) k) :=
  Ideal.span {planePoly k}

/-- The coordinate ring of the eliminated hypersurface in three variables. -/
abbrev PlaneCoordinateRing (k : Type u) [CommRing k] : Type u :=
  MvPolynomial (Fin 3) k ⧸ planeIdeal k

/-- The algebra map sending the five variables to the classes of
`X 0`, `X 1`, `X 2`, `X 0 ^ 2`, and `X 1 ^ 5` in the eliminated coordinate ring. -/
def reducedEval (k : Type u) [CommRing k] :
    MvPolynomial (Fin 5) k →ₐ[k] PlaneCoordinateRing k :=
  aeval ![Ideal.Quotient.mk (planeIdeal k) (X (0 : Fin 3)),
    Ideal.Quotient.mk (planeIdeal k) (X 1),
    Ideal.Quotient.mk (planeIdeal k) (X 2),
    Ideal.Quotient.mk (planeIdeal k) (X 0 ^ 2),
    Ideal.Quotient.mk (planeIdeal k) (X 1 ^ 5)]

/-- Evaluation of a variable under `reducedEval` is its corresponding graph coordinate. -/
theorem reducedEval_X (k : Type u) [CommRing k] (i : Fin 5) :
    reducedEval k (X i) =
      Ideal.Quotient.mk (planeIdeal k) (![X (0 : Fin 3), X 1, X 2, X 0 ^ 2, X 1 ^ 5] i) := sorry

/-- The graph-surface ideal is contained in the kernel of the elimination map. -/
theorem ideal_le_ker_reducedEval (k : Type u) [CommRing k] :
    ideal k ≤ RingHom.ker (reducedEval k).toRingHom := sorry

/-- Classical points of the graph-surface ideal are exactly the solutions of
`x 0 ^ 2 = x 3`, `x 1 ^ 5 = x 4`, and `x 2 ^ 2 + x 2 + x 3 + x 4 = 0`. -/
theorem mem_classicalZeroLocus_iff {k : Type u} [Field k] (x : Fin 5 → k) :
    x ∈ MvPolynomial.zeroLocus k (ideal k) ↔
      x 0 ^ 2 = x 3 ∧ x 1 ^ 5 = x 4 ∧ x 2 ^ 2 + x 2 + x 3 + x 4 = 0 := sorry

/-- Over an algebraically closed field, projection of the classical graph surface
onto its first two coordinates is surjective. -/
theorem exists_classicalPoint_of_plane {k : Type u} [Field k] [IsAlgClosed k] (a b : k) :
    ∃ x : Fin 5 → k, x ∈ MvPolynomial.zeroLocus k (ideal k) ∧ x 0 = a ∧ x 1 = b := sorry

/-- The coordinate ring of the eliminated hypersurface over a field has Krull dimension `2`. -/
theorem ringKrullDim_planeCoordinateRing (k : Type u) [Field k] :
    ringKrullDim (PlaneCoordinateRing k) = 2 := sorry

/-- The coordinate ring of the graph surface over a field has Krull dimension `2`. -/
theorem ringKrullDim_coordinateRing (k : Type u) [Field k] :
    ringKrullDim (CoordinateRing k) = 2 := sorry

/-- Over an algebraically closed field, the classical solution space defined by
`X 0 ^ 2 - X 3`, `X 1 ^ 5 - X 4`, and `X 2 ^ 2 + X 2 + X 3 + X 4`
has topological Krull dimension `2`. -/
@[stacks 0EEM]
theorem topologicalKrullDim_zeroLocus (k : Type u) [Field k] [IsAlgClosed k] :
    topologicalKrullDim (MvPolynomial.ClassicalZeroLocus (ideal k)) = 2 := sorry

end MvPolynomial.GraphSurface
