public import stacks_project.Chap72.Example_72_6_11_Space

/-!
# Class group and henselization of the coordinate-axes quotient

This module records the Weil divisor class group of the coordinate-axes quotient
space, computed on `𝔸¹_k` after the universal homeomorphism `X ⟶ 𝔸¹_k`, together
with the identification of the henselian local ring of `X` at the unique closed
point over `0` with a henselization of `originStalk k`.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Limits Opposite
open AlgebraicGeometry.Scheme
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient

/-- The affine line over `k` is an integral scheme. -/
instance instIsIntegral_affineLine (k : Type u) [Field k] :
    AlgebraicGeometry.IsIntegral (affineLine k).left := sorry

/-- The affine line over `k` is a locally Noetherian scheme. -/
instance instIsLocallyNoetherian_affineLine (k : Type u) [Field k] :
    AlgebraicGeometry.IsLocallyNoetherian (affineLine k).left := sorry

/-- The affine line over `k` is a Noetherian scheme. -/
instance instIsNoetherian_affineLine (k : Type u) [Field k] :
    AlgebraicGeometry.IsNoetherian (affineLine k).left := sorry

/-- The top open of the affine line is nonempty. -/
instance instNonempty_top_affineLine (k : Type u) [Field k] :
    Nonempty (⊤ : (affineLine k).left.Opens) :=
  ⟨⟨genericPoint (affineLine k).left, Set.mem_univ _⟩⟩

/-- The principal ideal generated by the standard coordinate of `𝔸¹_k`. -/
def originIdeal (k : Type u) [Field k] : Ideal Γ((affineLine k).left, ⊤) :=
  Ideal.span {affineLineCoord k}

/-- `originIdeal` is the principal ideal generated by the affine-line coordinate. -/
theorem originIdeal_eq_span (k : Type u) [Field k] :
    originIdeal k = Ideal.span {affineLineCoord k} := sorry

/-- The ideal sheaf on `𝔸¹_k` cut out by the coordinate `t`. -/
def originIdealSheaf (k : Type u) [Field k] : (affineLine k).left.IdealSheafData :=
  IdealSheafData.ofIdealTop (originIdeal k)

/-- The closed subscheme cut out by the origin ideal is integral. -/
theorem isIntegral_originIdealSheaf_subscheme (k : Type u) [Field k] :
    AlgebraicGeometry.IsIntegral (originIdealSheaf k).subscheme := sorry

/-- The support of the origin ideal sheaf is irreducible. -/
theorem isIrreducible_originIdealSheaf_support (k : Type u) [Field k] :
    IsIrreducible ((originIdealSheaf k).support : Set (affineLine k).left) := sorry

/-- The support of the origin ideal sheaf has coheight one. -/
theorem coheight_originIdealSheaf_support (k : Type u) [Field k] :
    Order.coheight
      (⟨((originIdealSheaf k).support : Set (affineLine k).left),
          isIrreducible_originIdealSheaf_support k,
          (originIdealSheaf k).support.isClosed⟩ :
        TopologicalSpace.IrreducibleCloseds (affineLine k).left) = 1 := sorry

/-- The prime divisor of `𝔸¹_k` cut out by the origin, identified with the unique
closed point of `X` lying over `0`. -/
def originPrimeDivisor (k : Type u) [Field k] :
    AlgebraicGeometry.PrimeDivisor (affineLine k).left :=
  AlgebraicGeometry.PrimeDivisor.ofIdeal (affineLine k).left (originIdealSheaf k)
    (isIntegral_originIdealSheaf_subscheme k)
    (isIrreducible_originIdealSheaf_support k)
    (coheight_originIdealSheaf_support k)

/-- The ideal sheaf of the origin prime divisor is the coordinate ideal sheaf. -/
theorem originPrimeDivisor_ideal (k : Type u) [Field k] :
    (originPrimeDivisor k).ideal = originIdealSheaf k := sorry

/-- There is a unique point of `X` lying above the origin of `𝔸¹_k`. -/
theorem unique_point_over_origin (k : Type u) [Field k] :
    Nonempty
        ((pullback (toAffineLine k)
            ((Scheme.fppfTopology.over (base k)).uliftYoneda.{u + 1}.map
              (affineLineOriginToAffineLine k))).obj.obj
          (op (affineLineOriginOver k))) ∧
      Subsingleton
        ((pullback (toAffineLine k)
            ((Scheme.fppfTopology.over (base k)).uliftYoneda.{u + 1}.map
              (affineLineOriginToAffineLine k))).obj.obj
          (op (affineLineOriginOver k))) :=
  sorry

/-- The coefficient function with value `1` on a given prime divisor and `0` elsewhere. -/
def primeWeilDivisorCoeff (k : Type u) [Field k]
    (Z W : AlgebraicGeometry.PrimeDivisor (affineLine k).left) : ℤ :=
  @ite ℤ (W = Z) (Classical.propDecidable (W = Z)) 1 0

/-- The characteristic function of a prime divisor of `𝔸¹_k` is locally finite. -/
theorem locallyFinite_primeWeilDivisorCoeff (k : Type u) [Field k]
    (Z : AlgebraicGeometry.PrimeDivisor (affineLine k).left) :
    LocallyFinite fun W : AlgebraicGeometry.PrimeDivisor (affineLine k).left ↦
      if primeWeilDivisorCoeff k Z W = 0 then (∅ : Set (affineLine k).left)
      else (W.support : Set (affineLine k).left) := sorry

/-- The Weil divisor with coefficient `1` along a given prime divisor of `𝔸¹_k`. -/
def primeWeilDivisor (k : Type u) [Field k]
    (Z : AlgebraicGeometry.PrimeDivisor (affineLine k).left) :
    AlgebraicGeometry.WeilDivisor (affineLine k).left :=
  AlgebraicGeometry.WeilDivisor.ofCoeff (affineLine k).left (primeWeilDivisorCoeff k Z)
    (locallyFinite_primeWeilDivisorCoeff k Z)

/-- Coefficients of `primeWeilDivisor` recover `primeWeilDivisorCoeff`. -/
theorem primeWeilDivisor_coeff (k : Type u) [Field k]
    (Z W : AlgebraicGeometry.PrimeDivisor (affineLine k).left) :
    (primeWeilDivisor k Z).coeff W = primeWeilDivisorCoeff k Z W := sorry

/-- The Weil divisor `[x]` of the unique closed point of `X` over `0`. -/
abbrev originWeilDivisor (k : Type u) [Field k] :
    AlgebraicGeometry.WeilDivisor (affineLine k).left :=
  primeWeilDivisor k (originPrimeDivisor k)

/-- The origin Weil divisor has coefficient `1` along the origin prime divisor. -/
theorem originWeilDivisor_coeff_self (k : Type u) [Field k] :
    (originWeilDivisor k).coeff (originPrimeDivisor k) = 1 := sorry

/-- Coefficients of a Weil divisor after doubling the origin coefficient. -/
def doubleOriginCoeff (k : Type u) [Field k]
    (D : AlgebraicGeometry.WeilDivisor (affineLine k).left)
    (Z : AlgebraicGeometry.PrimeDivisor (affineLine k).left) : ℤ :=
  @ite ℤ (Z = originPrimeDivisor k)
    (Classical.propDecidable (Z = originPrimeDivisor k))
    (2 * D.coeff Z) (D.coeff Z)

/-- Doubling the origin coefficient preserves local finiteness. -/
theorem locallyFinite_doubleOriginCoeff (k : Type u) [Field k]
    (D : AlgebraicGeometry.WeilDivisor (affineLine k).left) :
    LocallyFinite fun Z : AlgebraicGeometry.PrimeDivisor (affineLine k).left ↦
      if doubleOriginCoeff k D Z = 0 then (∅ : Set (affineLine k).left)
      else (Z.support : Set (affineLine k).left) := sorry

/-- The ramification map on `Div(𝔸¹_k)` which doubles the coefficient of the origin. -/
def doubleOrigin (k : Type u) [Field k]
    (D : AlgebraicGeometry.WeilDivisor (affineLine k).left) :
    AlgebraicGeometry.WeilDivisor (affineLine k).left :=
  AlgebraicGeometry.WeilDivisor.ofCoeff (affineLine k).left (doubleOriginCoeff k D)
    (locallyFinite_doubleOriginCoeff k D)

/-- Coefficients of `doubleOrigin` recover `doubleOriginCoeff`. -/
theorem doubleOrigin_coeff (k : Type u) [Field k]
    (D : AlgebraicGeometry.WeilDivisor (affineLine k).left)
    (Z : AlgebraicGeometry.PrimeDivisor (affineLine k).left) :
    (doubleOrigin k D).coeff Z = doubleOriginCoeff k D Z := sorry

/-- The additive homomorphism which doubles the origin coefficient. -/
def doubleOriginHom (k : Type u) [Field k] :
    AlgebraicGeometry.WeilDivisor (affineLine k).left →+
      AlgebraicGeometry.WeilDivisor (affineLine k).left where
  toFun := doubleOrigin k
  map_zero' := sorry
  map_add' := sorry

/-- The image of the affine-line coordinate in the function field is nonzero. -/
theorem affineLineCoord_ne_zero (k : Type u) [Field k] :
    (affineLine k).left.germToFunctionField ⊤ (affineLineCoord k) ≠ 0 := sorry

/-- The rational function `t` on `𝔸¹_k`. -/
def coordinate (k : Type u) [Field k] : (affineLine k).left.functionFieldˣ :=
  Units.mk0 ((affineLine k).left.germToFunctionField ⊤ (affineLineCoord k))
    (affineLineCoord_ne_zero k)

/-- `coordinate` is the image of the affine-line coordinate in the function field. -/
theorem coordinate_spec (k : Type u) [Field k] :
    (coordinate k).val = (affineLine k).left.germToFunctionField ⊤ (affineLineCoord k) := sorry

/-- The principal divisor map of `X`, obtained by doubling the origin coefficient of the
principal divisor on `𝔸¹_k`. -/
def principalWeilDivisor (k : Type u) [Field k] (f : (affineLine k).left.functionFieldˣ) :
    AlgebraicGeometry.WeilDivisor (affineLine k).left :=
  doubleOrigin k (Scheme.principalWeilDivisor (affineLine k).left f)

/-- The subgroup of principal Weil divisors on `X`, as the image of `Prin(𝔸¹_k)` under
doubling at the origin. -/
def principalDivisors (k : Type u) [Field k] :
    AddSubgroup (AlgebraicGeometry.WeilDivisor (affineLine k).left) :=
  AddSubgroup.map (doubleOriginHom k) (principalWeilDivisors (affineLine k).left)

/-- Membership in `principalDivisors` is the image of a principal divisor under `doubleOrigin`. -/
theorem mem_principalDivisors_iff (k : Type u) [Field k]
    (D : AlgebraicGeometry.WeilDivisor (affineLine k).left) :
    D ∈ principalDivisors k ↔
      ∃ E ∈ principalWeilDivisors (affineLine k).left, doubleOrigin k E = D :=
  sorry

/-- The Weil divisor class group of the coordinate-axes quotient space. -/
abbrev classGroup (k : Type u) [Field k] : Type u :=
  AlgebraicGeometry.WeilDivisor (affineLine k).left ⧸ principalDivisors k

/-- The canonical quotient map from Weil divisors to the class group of `X`. -/
abbrev classGroupMk (k : Type u) [Field k] :
    AlgebraicGeometry.WeilDivisor (affineLine k).left →+ classGroup k :=
  QuotientAddGroup.mk' (principalDivisors k)

/-- The homomorphism recording the origin coefficient of a Weil divisor. -/
def originCoeffHom (k : Type u) [Field k] :
    AlgebraicGeometry.WeilDivisor (affineLine k).left →+ ℤ where
  toFun D := D.coeff (originPrimeDivisor k)
  map_zero' := sorry
  map_add' := sorry

/-- The origin coefficient, reduced modulo `2`. -/
def originCoeffModTwoHom (k : Type u) [Field k] :
    AlgebraicGeometry.WeilDivisor (affineLine k).left →+ ZMod 2 :=
  (Int.castAddHom (ZMod 2)).comp (originCoeffHom k)

/-- Principal divisors of `X` lie in the kernel of the origin-coefficient map modulo `2`. -/
theorem originCoeffModTwoHom_ker (k : Type u) [Field k] :
    principalDivisors k ≤ (originCoeffModTwoHom k).ker := sorry

/-- The descended origin-coefficient map on the class group of `X`. -/
def classGroupHomZMod (k : Type u) [Field k] : classGroup k →+ ZMod 2 :=
  QuotientAddGroup.lift (principalDivisors k) (originCoeffModTwoHom k)
    (originCoeffModTwoHom_ker k)

/-- The identification `Cl(X) ≃ ℤ/2ℤ` sending the class of `[x]` to `1`. -/
def classGroupEquivZMod (k : Type u) [Field k] :
    classGroup k ≃+ ZMod 2 where
  toFun := classGroupHomZMod k
  invFun n := classGroupMk k (n.val • originWeilDivisor k)
  left_inv := sorry
  right_inv := sorry
  map_add' := sorry

/-- The class-group equivalence evaluates by the origin coefficient modulo `2`. -/
theorem classGroupEquivZMod_apply (k : Type u) [Field k]
    (D : AlgebraicGeometry.WeilDivisor (affineLine k).left) :
    classGroupEquivZMod k (classGroupMk k D) = originCoeffModTwoHom k D := sorry

/-- The class of the origin prime divisor is the generator `1` of `ℤ/2ℤ`. -/
theorem classGroupEquivZMod_origin (k : Type u) [Field k] :
    classGroupEquivZMod k (classGroupMk k (originWeilDivisor k)) = 1 := sorry

/-- The stalk of `U` at the origin `0_U`. -/
abbrev originStalk (k : Type u) [Field k] : Type u :=
  (cover k).left.presheaf.stalk (originPoint k)

/-- `originStalk` is the stalk of the structure sheaf of `U` at the origin. -/
theorem originStalk_eq (k : Type u) [Field k] :
    originStalk k = (cover k).left.presheaf.stalk (originPoint k) := sorry

/-- The stalk of `U` at the origin is a local ring. -/
instance instIsLocalRing_originStalk (k : Type u) [Field k] : IsLocalRing (originStalk k) :=
  inferInstance

/-- The residue-field scheme `Spec(κ(u))` of a point of a scheme over `Spec k`. -/
def residueOver {k : Type u} [Field k] (U : Over (base k)) (u : U.left) : Over (base k) :=
  Over.mk (U.left.fromSpecResidueField u ≫ U.hom)

/-- The structure morphism of `residueOver U u` is `fromSpecResidueField` followed by `U.hom`. -/
theorem residueOver_hom {k : Type u} [Field k] (U : Over (base k)) (u : U.left) :
    (residueOver U u).hom = U.left.fromSpecResidueField u ≫ U.hom := sorry

/-- `fromSpecResidueField` commutes with the structure morphism of `U`. -/
theorem residueι_w {k : Type u} [Field k] (U : Over (base k)) (u : U.left) :
    U.left.fromSpecResidueField u ≫ U.hom = (residueOver U u).hom := sorry

/-- The residue-field morphism `Spec(κ(u)) ⟶ U` over `Spec k`. -/
def residueι {k : Type u} [Field k] (U : Over (base k)) (u : U.left) :
    residueOver U u ⟶ U :=
  Over.homMk (U.left.fromSpecResidueField u) (residueι_w U u)

/-- The underlying scheme morphism of `residueι` is `fromSpecResidueField`. -/
theorem residueι_left {k : Type u} [Field k] (U : Over (base k)) (u : U.left) :
    (residueι U u).left = U.left.fromSpecResidueField u := sorry

/-- The origin of `𝔸¹_k` is irreducible, as it is `Spec k`. -/
instance instIrreducibleSpace_affineLineOriginOver (k : Type u) [Field k] :
    IrreducibleSpace (affineLineOriginOver k).left := sorry

/-- An elementary étale neighbourhood of the unique point of `sheafOfPoints k`
lying over `0 ∈ 𝔸¹_k`. This is the sheaf-level stand-in for
`AlgebraicSpace.EtaleNeighborhood.Elementary` at that point. -/
structure ElementaryEtaleNeighborhoodAtOrigin (k : Type u) [Field k] where
  /-- The source scheme of the neighbourhood, as an object over `Spec k`. -/
  obj : Over (base k)
  /-- The étale chart morphism into `sheafOfPoints k`. -/
  hom : (Scheme.fppfTopology.over (base k)).uliftYoneda.{u + 1}.obj obj ⟶ sheafOfPoints k
  /-- The chart is étale relative to `uliftYoneda`. -/
  isEtale : (MorphismProperty.over (@Etale)).relative uliftYoneda.{u + 1} hom.hom
  /-- The composite of the chart with `toAffineLine`. -/
  toAffine : obj ⟶ affineLine k
  /-- `toAffine` is the chart composed with `X ⟶ 𝔸¹_k`. -/
  toAffine_fac :
    (Scheme.fppfTopology.over (base k)).uliftYoneda.{u + 1}.map toAffine = hom ≫ toAffineLine k
  /-- The selected point of the neighbourhood. -/
  point : obj.left
  /-- The selected point lies over the origin of `𝔸¹_k`. -/
  mapsToOrigin :
    toAffine.left point =
      (affineLineOriginToAffineLine k).left.base
        (genericPoint (affineLineOriginOver k).left)
  /-- The neighbourhood is elementary: `Spec(κ(point)) ⟶ X` is a monomorphism. -/
  isElementary :
    Mono
      ((Scheme.fppfTopology.over (base k)).uliftYoneda.{u + 1}.map (residueι obj point) ≫ hom)

/-- The atlas `U ⟶ X` with the origin `0_U` is an elementary étale neighbourhood of
the unique point of `X` over `0`. -/
def ElementaryEtaleNeighborhoodAtOrigin.ofAtlas (k : Type u) [Field k] :
    ElementaryEtaleNeighborhoodAtOrigin k where
  obj := cover k
  hom := atlas k
  isEtale := sorry
  toAffine := sumOver k
  toAffine_fac := sorry
  point := originPoint k
  mapsToOrigin := sorry
  isElementary := sorry

/-- `ofAtlas` is the atlas chart `U ⟶ X` based at `0_U`. -/
theorem ElementaryEtaleNeighborhoodAtOrigin.ofAtlas_spec (k : Type u) [Field k] :
    (ofAtlas k).obj = cover k ∧
      (ofAtlas k).hom = atlas k ∧
        (ofAtlas k).toAffine = sumOver k ∧
          (ofAtlas k).point = originPoint k :=
  sorry

/-- Compatibility of a family of global-section maps with morphisms of elementary
étale neighbourhoods of the unique point over `0`. Transitions must commute with
the charts and send the selected point to the selected point. -/
def ElementaryEtaleNeighborhoodAtOrigin.IsCompatible {k : Type u} [Field k]
    {Ah : Type u} [CommRing Ah]
    (ι : ∀ U : ElementaryEtaleNeighborhoodAtOrigin k, Γ(U.obj.left, ⊤) →+* Ah) : Prop :=
  ∀ {U V : ElementaryEtaleNeighborhoodAtOrigin k} (f : U.obj ⟶ V.obj),
    (Scheme.fppfTopology.over (base k)).uliftYoneda.{u + 1}.map f ≫ V.hom = U.hom →
      f.left.base U.point = V.point →
        (ι U).comp (Scheme.Γ.map f.left.op).hom = ι V

/-- `IsCompatible` is restriction-compatibility for pointed neighbourhood maps. -/
theorem ElementaryEtaleNeighborhoodAtOrigin.isCompatible_iff {k : Type u} [Field k]
    {Ah : Type u} [CommRing Ah]
    (ι : ∀ U : ElementaryEtaleNeighborhoodAtOrigin k, Γ(U.obj.left, ⊤) →+* Ah) :
    IsCompatible ι ↔
      ∀ {U V : ElementaryEtaleNeighborhoodAtOrigin k} (f : U.obj ⟶ V.obj),
        (Scheme.fppfTopology.over (base k)).uliftYoneda.{u + 1}.map f ≫ V.hom = U.hom →
          f.left.base U.point = V.point →
            (ι U).comp (Scheme.Γ.map f.left.op).hom = ι V :=
  sorry

/-- `Ah` is the henselian local ring of `sheafOfPoints k` at the unique closed point
over `0`, as the colimit of global-section rings of elementary étale neighbourhoods
of that point. This is the sheaf stand-in for `AlgebraicSpace.henselianLocalRing`,
without `AlgebraicSpace.ofFunctor`. -/
@[mk_iff]
class IsHenselianLocalRingAtOrigin (k : Type u) [Field k] (Ah : Type u) [CommRing Ah] :
    Prop where
  /-- `Ah` is the colimit of `Γ(U, 𝒪_U)` over elementary étale neighbourhoods of
  the unique point of `X` over `0`. -/
  isColimitOfElementaryEtaleNeighborhoods :
    ∃ ι : ∀ U : ElementaryEtaleNeighborhoodAtOrigin k, Γ(U.obj.left, ⊤) →+* Ah,
      ElementaryEtaleNeighborhoodAtOrigin.IsCompatible ι ∧
        ∀ (Bh : Type u) [CommRing Bh]
          (τ : ∀ U : ElementaryEtaleNeighborhoodAtOrigin k, Γ(U.obj.left, ⊤) →+* Bh),
          ElementaryEtaleNeighborhoodAtOrigin.IsCompatible τ →
            ∃! Φ : Ah →+* Bh, ∀ U, Φ.comp (ι U) = τ U

/-- The defining colimit property of `IsHenselianLocalRingAtOrigin`. -/
theorem IsHenselianLocalRingAtOrigin.spec (k : Type u) [Field k]
    (Ah : Type u) [CommRing Ah] [IsHenselianLocalRingAtOrigin k Ah] :
    ∃ ι : ∀ U : ElementaryEtaleNeighborhoodAtOrigin k, Γ(U.obj.left, ⊤) →+* Ah,
      ElementaryEtaleNeighborhoodAtOrigin.IsCompatible ι ∧
        ∀ (Bh : Type u) [CommRing Bh]
          (τ : ∀ U : ElementaryEtaleNeighborhoodAtOrigin k, Γ(U.obj.left, ⊤) →+* Bh),
          ElementaryEtaleNeighborhoodAtOrigin.IsCompatible τ →
            ∃! Φ : Ah →+* Bh, ∀ U, Φ.comp (ι U) = τ U :=
  sorry

/-- A henselization of `originStalk k` is the henselian local ring of `X` at the
unique closed point over `0`. -/
theorem isHenselianLocalRingAtOrigin_of_isHenselizationOf
    (k : Type u) [Field k]
    (Ah : Type u) [CommRing Ah] [Algebra (originStalk k) Ah]
    [IsHenselizationOf (originStalk k) Ah] :
    IsHenselianLocalRingAtOrigin k Ah := sorry

/-- A henselization of `originStalk k` realises `IsHenselianLocalRingAtOrigin`. -/
instance instIsHenselianLocalRingAtOrigin_of_isHenselizationOf
    (k : Type u) [Field k]
    (Ah : Type u) [CommRing Ah] [Algebra (originStalk k) Ah]
    [IsHenselizationOf (originStalk k) Ah] :
    IsHenselianLocalRingAtOrigin k Ah := sorry

/-- Given a henselization of `originStalk k`, there is a compatible elementary-étale
colimit cocone whose atlas coprojection is the henselization algebra map after
the germ `Γ(U, ⊤) → originStalk k`. The equality is not claimed for every colimit
cocone: the axis-swap of `originStalk k` extends to a ring automorphism of `Ah`
sending any witnessing cocone to another. -/
theorem IsHenselianLocalRingAtOrigin.exists_ofAtlas_eq_algebraMap_comp_germ
    (k : Type u) [Field k]
    (Ah : Type u) [CommRing Ah] [Algebra (originStalk k) Ah]
    [IsHenselizationOf (originStalk k) Ah] :
    ∃ ι : ∀ U : ElementaryEtaleNeighborhoodAtOrigin k, Γ(U.obj.left, ⊤) →+* Ah,
      ElementaryEtaleNeighborhoodAtOrigin.IsCompatible ι ∧
        (∀ (Bh : Type u) [CommRing Bh]
          (τ : ∀ U : ElementaryEtaleNeighborhoodAtOrigin k, Γ(U.obj.left, ⊤) →+* Bh),
          ElementaryEtaleNeighborhoodAtOrigin.IsCompatible τ →
            ∃! Φ : Ah →+* Bh, ∀ U, Φ.comp (ι U) = τ U) ∧
        ι (ElementaryEtaleNeighborhoodAtOrigin.ofAtlas k) =
          (algebraMap (originStalk k) Ah).comp
            ((cover k).left.presheaf.germ ⊤ (originPoint k)
              (Set.mem_univ (originPoint k))).hom :=
  sorry

/-- Algebra-compatible elementary-étale colimit cocones for a henselization of
`originStalk k` agree: if two compatible colimit families both send `ofAtlas` to
`algebraMap ∘ germ`, then they are equal. -/
theorem IsHenselianLocalRingAtOrigin.eq_of_ofAtlas_eq_algebraMap_comp_germ
    (k : Type u) [Field k]
    (Ah : Type u) [CommRing Ah] [Algebra (originStalk k) Ah]
    [IsHenselizationOf (originStalk k) Ah]
    {ι τ : ∀ U : ElementaryEtaleNeighborhoodAtOrigin k, Γ(U.obj.left, ⊤) →+* Ah}
    (hι : ElementaryEtaleNeighborhoodAtOrigin.IsCompatible ι)
    (hτ : ElementaryEtaleNeighborhoodAtOrigin.IsCompatible τ)
    (hι_colimit :
      ∀ (Bh : Type u) [CommRing Bh]
        (σ : ∀ U : ElementaryEtaleNeighborhoodAtOrigin k, Γ(U.obj.left, ⊤) →+* Bh),
        ElementaryEtaleNeighborhoodAtOrigin.IsCompatible σ →
          ∃! Φ : Ah →+* Bh, ∀ U, Φ.comp (ι U) = σ U)
    (hτ_colimit :
      ∀ (Bh : Type u) [CommRing Bh]
        (σ : ∀ U : ElementaryEtaleNeighborhoodAtOrigin k, Γ(U.obj.left, ⊤) →+* Bh),
        ElementaryEtaleNeighborhoodAtOrigin.IsCompatible σ →
          ∃! Φ : Ah →+* Bh, ∀ U, Φ.comp (τ U) = σ U)
    (hι_ofAtlas :
      ι (ElementaryEtaleNeighborhoodAtOrigin.ofAtlas k) =
        (algebraMap (originStalk k) Ah).comp
          ((cover k).left.presheaf.germ ⊤ (originPoint k)
            (Set.mem_univ (originPoint k))).hom)
    (hτ_ofAtlas :
      τ (ElementaryEtaleNeighborhoodAtOrigin.ofAtlas k) =
        (algebraMap (originStalk k) Ah).comp
          ((cover k).left.presheaf.germ ⊤ (originPoint k)
            (Set.mem_univ (originPoint k))).hom) :
    ι = τ :=
  sorry

