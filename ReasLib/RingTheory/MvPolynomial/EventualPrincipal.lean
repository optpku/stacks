module

public import Mathlib.RingTheory.MvPolynomial.Homogeneous

/-!
# Eventual homogeneous principality in multivariate polynomial rings

This file defines the condition that a homogeneous ideal is eventually generated
by one homogeneous polynomial.
-/

@[expose] public section

universe u

namespace MvPolynomial

/-- An ideal in a two-variable polynomial ring is eventually generated by a
nonzero homogeneous polynomial when it is contained in the corresponding
principal ideal and their homogeneous pieces agree in all sufficiently large
degrees. -/
def IsHomogeneousEventuallySpan {k : Type u} [Field k]
    (I : Ideal (MvPolynomial (Fin 2) k)) (F : MvPolynomial (Fin 2) k) : Prop :=
  F ≠ 0 ∧ (∃ d, F.IsHomogeneous d) ∧ I ≤ Ideal.span {F} ∧
    ∃ N, ∀ n ≥ N, ∀ p, p.IsHomogeneous n → (p ∈ I ↔ p ∈ Ideal.span {F})

/-- The eventual homogeneous principality condition consists of nonvanishing,
homogeneity, containment, and eventual equality of homogeneous membership. -/
theorem isHomogeneousEventuallySpan_iff {k : Type u} [Field k]
    (I : Ideal (MvPolynomial (Fin 2) k)) (F : MvPolynomial (Fin 2) k) :
    IsHomogeneousEventuallySpan I F ↔
      F ≠ 0 ∧ (∃ d, F.IsHomogeneous d) ∧ I ≤ Ideal.span {F} ∧
        ∃ N, ∀ n ≥ N, ∀ p, p.IsHomogeneous n → (p ∈ I ↔ p ∈ Ideal.span {F}) := sorry

end MvPolynomial
