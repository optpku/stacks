module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.DifferentialGraded.Module.Flat
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.DifferentialGraded.Module.Free
public import ReasLib.Algebra.Homology.CochainComplex.KFlat
public import ReasLib.Algebra.Homology.HomologicalComplex.Flat
import Mathlib.Tactic.CrossRefAttribute

/-!
# Flatness of free differential graded modules

The free-DG-module construction preserves the two flatness inputs separately.  Its specialization
to an integer-graded sheaf of generators is therefore exposed through graded-flat, K-flat, and
combined fixed-base-good APIs.  Universal stability under change of ringed topos is intentionally
left to the geometric base-change layer.
-/

@[expose] public section

open CategoryTheory
open scoped SheafOfModules.RingedSite.DifferentialGradedAlgebra
open scoped SheafOfModules.RingedSite.DifferentialGradedModule

noncomputable section

universe u v w

namespace SheafOfModules.RingedSite.DifferentialGradedModule

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
variable [HasWeakSheafify J AddCommGrpCat.{w}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
variable [UnivLE.{max u v, w}]
variable {O : Sheaf J CommRingCat.{w}}

namespace IsGradedFlat

/-- A free right DG module on a termwise-flat coefficient complex is graded-flat. -/
@[stacks 0FSG "graded-flat free DG modules"]
theorem freeFunctor (A : DGA(O))
    (K : CochainComplex
      (DifferentialGradedAlgebra.moduleCategory (J := J) (𝒪 := O)) ℤ)
    (hK : HomologicalComplex.IsTermwiseFlat K) :
    IsGradedFlat ((DifferentialGradedModule.freeFunctor A).obj K) := sorry

/-- The free right DG module on an integer-graded sheaf is graded-flat at the current base. -/
@[stacks 0FSG "graded-flat free DG modules on graded sheaves"]
theorem freeOnGradedSheaf [HasWeakSheafify J (Type w)]
    (A : DGA(O)) (S : IntGradedSheaf.{u, v, w} J) :
    IsGradedFlat ((DifferentialGradedModule.freeOnGradedSheaf A).obj S) := sorry

end IsGradedFlat

namespace IsKFlat

/-- A free right DG module on a K-flat coefficient complex is relatively K-flat. -/
@[stacks 0FSG "K-flat free DG modules"]
theorem freeFunctor (A : DGA(O))
    (K : CochainComplex
      (DifferentialGradedAlgebra.moduleCategory (J := J) (𝒪 := O)) ℤ)
    (hK : HomologicalComplex.IsKFlat K) :
    IsKFlat ((DifferentialGradedModule.freeFunctor A).obj K) := sorry

/-- The free right DG module on an integer-graded sheaf is relatively K-flat at the current base. -/
@[stacks 0FSG "K-flat free DG modules on graded sheaves"]
theorem freeOnGradedSheaf [HasWeakSheafify J (Type w)]
    (A : DGA(O)) (S : IntGradedSheaf.{u, v, w} J) :
    IsKFlat ((DifferentialGradedModule.freeOnGradedSheaf A).obj S) := sorry

end IsKFlat

namespace IsGoodAtBase

/-- A free right DG module on a termwise-flat K-flat complex is good at the current base. -/
@[stacks 0FSG "fixed-base good free DG modules"]
theorem freeFunctor (A : DGA(O))
    (K : CochainComplex
      (DifferentialGradedAlgebra.moduleCategory (J := J) (𝒪 := O)) ℤ)
    (hFlat : HomologicalComplex.IsTermwiseFlat K)
    (hKFlat : HomologicalComplex.IsKFlat K) :
    IsGoodAtBase ((DifferentialGradedModule.freeFunctor A).obj K) := sorry

/-- Lemma 24.23.6 (0FSG), fixed-base component: the free right DG module generated by an
integer-graded sheaf is good at the current ringed site and differential graded algebra. -/
@[stacks 0FSG "fixed-base good free DG modules on graded sheaves"]
theorem freeOnGradedSheaf [HasWeakSheafify J (Type w)]
    (A : DGA(O)) (S : IntGradedSheaf.{u, v, w} J) :
    IsGoodAtBase ((DifferentialGradedModule.freeOnGradedSheaf A).obj S) := sorry

end IsGoodAtBase

end SheafOfModules.RingedSite.DifferentialGradedModule

end
