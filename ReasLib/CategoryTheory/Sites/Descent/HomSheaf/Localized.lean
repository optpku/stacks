module

public import Mathlib.CategoryTheory.Sites.SheafHom
public import Mathlib.Combinatorics.Quiver.ReflQuiver
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Localized sheaf-Hom descent

This leaf gives the reusable Hom-sheaf interface for sheaves on slice sites.
It separates evaluation at an arbitrary slice object from the additional data
of a selected covering family, so applications can use the objectwise API
without manufacturing an irrelevant cover.
-/

@[expose] public section

open CategoryTheory Opposite

universe u v w

noncomputable section

namespace CategoryTheory.GrothendieckTopology.LocalizedHom

variable {C : Type u} [Category.{v} C]
variable {J : GrothendieckTopology C} {U : C}
variable {M N : Sheaf J (Type w)}

/-- The ordinary sheaf-Hom presheaf on the localized site over `U`. -/
@[stacks 04TQ "localized Hom"]
abbrev presheaf (J : GrothendieckTopology C) (U : C)
    (M N : Sheaf J (Type w)) :
    (Over U)ᵒᵖ ⥤ Type (max u v w) :=
  (CategoryTheory.sheafHom (J := J.over U) (M.over U) (N.over U)).1

/-- The comparison from iterated slice pullback to direct pullback along the
underlying arrow of a slice object. -/
@[stacks 04TQ "localized Hom"]
noncomputable def iteratedPullbackIso
    (T : Over U) (M : Sheaf J (Type w)) :
    (T.iteratedSliceEquiv.sheafCongr ((J.over U).over T) (J.over T.left) (Type w)).functor.obj
      (((J.over U).overPullback (Type w) T).obj (M.over U)) ≅
    (J.overMapPullback (Type w) T.hom).obj (M.over U) :=
  (Functor.sheafPushforwardContinuousComp'
    (eqToIso (Over.iteratedSliceBackward_forget T)) (Type w) (J.over T.left)
    ((J.over U).over T) (J.over U)).app (M.over U)

/-- Transporting Hom through the canonical equivalence from an iterated slice
to the direct slice over `T.left`. -/
@[stacks 04TQ "localized Hom"]
def iteratedHomEquiv (T : Over U) :
    (((J.over U).overPullback (Type w) T).obj (M.over U) ⟶
      ((J.over U).overPullback (Type w) T).obj (N.over U)) ≃
    ((T.iteratedSliceEquiv.sheafCongr ((J.over U).over T) (J.over T.left) (Type w)).functor.obj
        (((J.over U).overPullback (Type w) T).obj (M.over U)) ⟶
      (T.iteratedSliceEquiv.sheafCongr ((J.over U).over T) (J.over T.left) (Type w)).functor.obj
        (((J.over U).overPullback (Type w) T).obj (N.over U))) :=
  (Functor.FullyFaithful.ofFullyFaithful
    ((T.iteratedSliceEquiv.sheafCongr ((J.over U).over T) (J.over T.left) (Type w)).functor)).homEquiv

/-- Evaluation of the localized Hom presheaf at an arbitrary slice object is
the Hom set between the corresponding localized sheaves. -/
@[stacks 04TQ "localized Hom"]
noncomputable def evalEquiv (T : Over U) :
    (presheaf J U M N).obj (op T) ≃ (M.over T.left ⟶ N.over T.left) :=
  (iteratedHomEquiv (J := J) (M := M) (N := N) T).trans
    (Iso.homCongr (iteratedPullbackIso (J := J) T M)
      (iteratedPullbackIso (J := J) T N))

/-- The canonical arrow from a slice object to the terminal object of its
slice category. -/
@[stacks 04TQ "localized Hom"]
def terminalArrow (T : Over U) : T ⟶ Over.mk (𝟙 U) :=
  Over.homMk T.hom (Category.comp_id T.hom)

/-- Evaluation of localized Hom at the terminal slice object. -/
@[stacks 04TQ "localized Hom"]
noncomputable abbrev terminalEquiv :
    (presheaf J U M N).obj (op (Over.mk (𝟙 U))) ≃ (M.over U ⟶ N.over U) :=
  evalEquiv (J := J) (M := M) (N := N) (Over.mk (𝟙 U))

/-- Restrict a morphism on the localized site over `U` to an arbitrary slice
object `T`. -/
@[stacks 04TQ "localized Hom"]
noncomputable def restrict (T : Over U) (φ : M.over U ⟶ N.over U) :
    M.over T.left ⟶ N.over T.left :=
  evalEquiv (J := J) (M := M) (N := N) T
    ((presheaf J U M N).map (terminalArrow T).op
      ((terminalEquiv (J := J) (M := M) (N := N)).symm φ))

/-- The arrow in `Over U` associated to one member of a chosen cover. -/
@[stacks 04TQ "localized Hom"]
def coverArrow (T : J.Cover U) (I : T.Arrow) :
    Over.mk I.f ⟶ Over.mk (𝟙 U) :=
  Over.homMk I.f (Category.comp_id I.f)

/-- The presieve on the terminal slice object generated by a chosen cover. -/
@[stacks 04TQ "localized Hom"]
abbrev coverPresieve (T : J.Cover U) : Presieve (Over.mk (𝟙 U)) :=
  Presieve.ofArrows (fun I : T.Arrow ↦ Over.mk I.f) (coverArrow T)

/-- The sieve on the terminal slice object generated by a chosen cover. -/
@[stacks 04TQ "localized Hom"]
abbrev coverSieve (T : J.Cover U) : Sieve (Over.mk (𝟙 U)) :=
  Sieve.ofArrows (fun I : T.Arrow ↦ Over.mk I.f) (coverArrow T)

/-- The cover-generated sieve on the terminal slice object corresponds to
the original covering sieve under `Sieve.overEquiv`. -/
@[stacks 04TQ "localized Hom"]
theorem coverSieve_overEquiv (T : J.Cover U) :
    Sieve.overEquiv (Over.mk (𝟙 U)) (coverSieve T) = (T : Sieve U) := sorry

/-- Compatibility of local Hom morphisms on the members of a chosen cover. -/
@[stacks 04TQ "localized Hom"]
def Compatible (T : J.Cover U) (φ : ∀ I : T.Arrow, M.over I.Y ⟶ N.over I.Y) : Prop :=
  Presieve.Arrows.Compatible (presheaf J U M N) (coverArrow T)
    (fun I ↦ (evalEquiv (J := J) (M := M) (N := N) (Over.mk I.f)).symm (φ I))

/-- The localized Hom presheaf satisfies the sheaf condition for the
presieve generated by every cover. -/
@[stacks 04TQ "localized Hom"]
theorem isSheafFor_cover (T : J.Cover U) :
    Presieve.IsSheafFor (presheaf J U M N) (coverPresieve T) := sorry

/-- A compatible family of local morphisms on a cover glues uniquely to a
morphism on the localized site. -/
@[stacks 04TQ "localized Hom"]
theorem existsUnique_of_compatible (T : J.Cover U)
    (φ : ∀ I : T.Arrow, M.over I.Y ⟶ N.over I.Y)
    (hφ : Compatible (J := J) (M := M) (N := N) T φ) :
    ∃! ψ : M.over U ⟶ N.over U, ∀ I : T.Arrow,
      restrict (J := J) (M := M) (N := N) (Over.mk I.f) ψ = φ I := sorry

end CategoryTheory.GrothendieckTopology.LocalizedHom
