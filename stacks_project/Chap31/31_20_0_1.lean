module

public import ReasLib.AlgebraicGeometry.RingedSpace.SectionSequence.Quotient
import StacksCheckRecall

@[expose] public section

universe u

/- 31.20.0.1: multiplication by `f i` is an endomorphism of the structure module modulo the
subsheaf generated by the preceding sections. -/
@[stacks 0639] #check
  (AlgebraicGeometry.RingedSpace.SectionSequence.quotientMulByPrev :
    {X : AlgebraicGeometry.RingedSpace.{u}} → {r : ℕ} →
      (f : Fin r → (SheafOfModules.unit X.ringCatSheaf : X.Modules).sections) →
      (i : Fin r) →
        AlgebraicGeometry.RingedSpace.SectionSequence.quotientByPrev f i ⟶
          AlgebraicGeometry.RingedSpace.SectionSequence.quotientByPrev f i)
