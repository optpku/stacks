module

public import Mathlib.Algebra.Module.SpanRank
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Span rank and kernels of linear maps

@stack 05WI
-/

@[expose] public section

universe u v

namespace LinearMap

variable {R : Type u} [CommRing R] [Nontrivial R]
variable {M : Type v} [AddCommGroup M] [Module R M]

/-- Lemma 10.15.7: a map from `R^n` to a module generated by fewer than `n`
elements has nontrivial kernel. -/
@[stacks 05WI]
theorem ker_ne_bot_of_spanRank_lt {n : ℕ} (f : (Fin n → R) →ₗ[R] M)
    (hgen : (⊤ : Submodule R M).spanRank < n) :
    LinearMap.ker f ≠ ⊥ := sorry

end LinearMap
