module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs

@[expose] public section

universe u v

open scoped IntermediateField

namespace FieldExtension

variable {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]

/-- The entries of a finite family occurring strictly before a specified stage. -/
def adjoinStage.set {n : ℕ} (α : Fin n → E) (i : Fin (n + 1)) : Set E :=
  {x | ∃ j : Fin n, j.1 < i.1 ∧ α j = x}

/-- The intermediate field generated by the prefix of a finite family. -/
def adjoinStage (F : Type u) {E : Type v} [Field F] [Field E] [Algebra F E]
    {n : ℕ} (α : Fin n → E) (i : Fin (n + 1)) : IntermediateField F E :=
  IntermediateField.adjoin F (adjoinStage.set α i)

/-- The initial stage of a finite generator tower is the base intermediate field. -/
theorem adjoinStage_zero {n : ℕ} (α : Fin n → E) :
    adjoinStage F α (0 : Fin (n + 1)) = ⊥ := by
  ext x
  simp [adjoinStage, adjoinStage.set]

/-- Finite generator stages are monotone in their stage index. -/
theorem adjoinStage_mono {n : ℕ} (α : Fin n → E) {i j : Fin (n + 1)} (hij : i ≤ j) :
    adjoinStage F α i ≤ adjoinStage F α j := by
  rw [adjoinStage, adjoinStage]
  exact IntermediateField.adjoin.mono F _ _ fun x ⟨k, hk, hx⟩ ↦
    ⟨k, lt_of_lt_of_le hk hij, hx⟩

omit [Field E] in
/-- The successor prefix consists of the preceding prefix together with the next generator. -/
theorem adjoinStage.set_succ {n : ℕ} (α : Fin n → E) (i : Fin n) :
    adjoinStage.set α (Fin.succ i) =
      Set.insert (α i) (adjoinStage.set α (Fin.castSucc i)) := by
  ext x
  constructor
  · rintro ⟨j, hj, rfl⟩
    rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hjlt | hjeq
    · exact Or.inr ⟨j, hjlt, rfl⟩
    · left
      exact congrArg α (Fin.ext hjeq)
  · intro hx
    rcases hx with rfl | hx
    · exact ⟨i, Nat.lt_succ_self i.1, rfl⟩
    · rcases hx with ⟨j, hj, rfl⟩
      exact ⟨j, Nat.lt_succ_of_lt hj, rfl⟩

/-- A successor stage is obtained by adjoining its next generator to the preceding stage. -/
theorem adjoinStage_succ {n : ℕ} (α : Fin n → E) (i : Fin n) :
    adjoinStage F α (Fin.succ i) =
      (IntermediateField.adjoin (adjoinStage F α (Fin.castSucc i))
        ({α i} : Set E)).restrictScalars F := by
  rw [show adjoinStage F α (Fin.succ i) =
      IntermediateField.adjoin F
        {x : E | ∃ j : Fin n, j.1 < (Fin.succ i).1 ∧ α j = x} by
      rfl]
  rw [IntermediateField.restrictScalars_adjoin]
  apply le_antisymm
  · rw [IntermediateField.adjoin_le_iff]
    intro x hx
    rcases hx with ⟨j, hj, rfl⟩
    rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hj | hji
    · have hmem : α j ∈ adjoinStage F α (Fin.castSucc i) := by
        change α j ∈ IntermediateField.adjoin F
          {x : E | ∃ k : Fin n, k.1 < (Fin.castSucc i).1 ∧ α k = x}
        exact IntermediateField.mem_adjoin_of_mem F ⟨j, hj, rfl⟩
      exact IntermediateField.mem_adjoin_of_mem F (Or.inl hmem)
    · have hji' : j = i := Fin.ext hji
      subst hji'
      exact IntermediateField.mem_adjoin_of_mem F (Or.inr (by simp))
  · rw [IntermediateField.adjoin_le_iff]
    intro x hx
    rcases hx with hx | hx
    · have hle :
        adjoinStage F α (Fin.castSucc i) ≤
          IntermediateField.adjoin F
            {x : E | ∃ j : Fin n, j.1 < (Fin.succ i).1 ∧ α j = x} := by
        rw [show adjoinStage F α (Fin.castSucc i) =
            IntermediateField.adjoin F
              {x : E | ∃ j : Fin n, j.1 < (Fin.castSucc i).1 ∧ α j = x} by
            rfl]
        rw [IntermediateField.adjoin_le_iff]
        intro y hy
        rcases hy with ⟨j, hj, rfl⟩
        exact IntermediateField.mem_adjoin_of_mem F ⟨j, Nat.lt_succ_of_lt hj, rfl⟩
      exact hle hx
    · rcases Set.mem_singleton_iff.mp hx with rfl
      exact IntermediateField.mem_adjoin_of_mem F ⟨i, Nat.lt_succ_self i.1, rfl⟩

omit [Field E] in
/-- After prepending a generator, every noninitial prefix consists of that generator and an old
prefix. -/
theorem adjoinStage.set_cons_succ {n : ℕ} (β : E) (γ : Fin n → E)
    (j : Fin (n + 1)) :
    adjoinStage.set (Fin.cons β γ) (Fin.succ j) =
      Set.insert β (adjoinStage.set γ j) := by
  ext x
  constructor
  · rintro ⟨i, hi, rfl⟩
    obtain rfl | ⟨k, rfl⟩ := Fin.eq_zero_or_eq_succ i
    · exact Set.mem_insert _ _
    · right
      refine ⟨k, ?_, by simp [Fin.cons_succ]⟩
      simpa using hi
  · intro hx
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · exact ⟨0, by simp, by simp [Fin.cons_zero]⟩
    · rcases hx with ⟨k, hk, rfl⟩
      refine ⟨Fin.succ k, ?_, by simp [Fin.cons_succ]⟩
      simpa using hk

/-- A noninitial stage after prepending a generator is the corresponding old stage over the
simple extension generated by that head, restricted back to the original base field. -/
theorem adjoinStage_cons_succ {n : ℕ} (β : E) (γ : Fin n → E)
    (j : Fin (n + 1)) :
    adjoinStage F (Fin.cons β γ) (Fin.succ j) =
      (adjoinStage F⟮β⟯ γ j).restrictScalars F := by
  rw [adjoinStage, adjoinStage.set_cons_succ]
  rw [show Set.insert β (adjoinStage.set γ j) =
      ({β} : Set E) ∪ adjoinStage.set γ j by
    exact Set.singleton_union.symm]
  rw [IntermediateField.adjoin_union]
  simpa [adjoinStage] using
    (IntermediateField.restrictScalars_adjoin_eq_sup (F := F) (K := F⟮β⟯)
      (S := adjoinStage.set γ j)).symm

/-- The first noninitial stage after prepending a generator is its simple generated extension. -/
theorem adjoinStage_cons_one {n : ℕ} (β : E) (γ : Fin n → E) :
    adjoinStage F (Fin.cons β γ) (Fin.succ (0 : Fin (n + 1))) = F⟮β⟯ := by
  rw [adjoinStage, adjoinStage.set_cons_succ (β := β) (γ := γ)
    (j := (0 : Fin (n + 1)))]
  have hprefix_zero : adjoinStage.set γ (0 : Fin (n + 1)) = ∅ := by
    ext x
    simp [adjoinStage.set]
  rw [hprefix_zero]
  change IntermediateField.adjoin F (Set.insert β ∅) = IntermediateField.adjoin F ({β} : Set E)
  exact congrArg (IntermediateField.adjoin F) (Set.singleton_def β).symm

end FieldExtension
