module

public import ReasLib.AlgebraicGeometry.Scheme.Cover.H.Stability

/-!
# Stability of h covering families

This compatibility module re-exports the singleton-isomorphism,
dependent-composition, and base-change closure properties of h covering
families of schemes.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u v w

/- A singleton family generated by an isomorphism is an h covering. -/
#check
  (AlgebraicGeometry.Scheme.hCoveringSingletonOfIsIso :
    ∀ {T T' : AlgebraicGeometry.Scheme.{u}} (f : T' ⟶ T) [IsIso f],
      AlgebraicGeometry.Scheme.HCovering (fun _ : Unit ↦ Over.mk f))

/- Dependent composition of h covering families is an h covering. -/
#check
  (AlgebraicGeometry.Scheme.hCoveringComp :
    ∀ {T : AlgebraicGeometry.Scheme.{u}} {ι : Type v} {κ : ι → Type w}
      (X : ι → Over T) (Y : (i : ι) → κ i → Over (X i).left)
      [AlgebraicGeometry.Scheme.HCovering X]
      [∀ i, AlgebraicGeometry.Scheme.HCovering (Y i)],
      AlgebraicGeometry.Scheme.HCovering (fun p : Sigma κ ↦
        Over.mk ((Y p.1 p.2).hom ≫ (X p.1).hom)))

/- Pullback of an h covering family along a scheme morphism is an h covering. -/
#check
  (AlgebraicGeometry.Scheme.hCoveringPullback :
    ∀ {T T' : AlgebraicGeometry.Scheme.{u}} {ι : Type v}
      (X : ι → Over T) [AlgebraicGeometry.Scheme.HCovering X] (f : T' ⟶ T),
      AlgebraicGeometry.Scheme.HCovering
        (fun i : ι ↦ Over.mk (pullback.snd (X i).hom f)))

/- Explicit-hypothesis view of dependent composition for h covering families. -/
#check
  (AlgebraicGeometry.Scheme.HCovering.comp :
    ∀ {T : AlgebraicGeometry.Scheme.{u}} {ι : Type v} {κ : ι → Type w}
      (X : ι → Over T) (Y : (i : ι) → κ i → Over (X i).left)
      (_ : AlgebraicGeometry.Scheme.HCovering X),
      (∀ i, AlgebraicGeometry.Scheme.HCovering (Y i)) →
        AlgebraicGeometry.Scheme.HCovering (fun p : Sigma κ ↦
          Over.mk ((Y p.1 p.2).hom ≫ (X p.1).hom)))

/- Explicit-hypothesis view of base change for an h covering family. -/
#check
  (AlgebraicGeometry.Scheme.HCovering.pullback :
    ∀ {T T' : AlgebraicGeometry.Scheme.{u}} {ι : Type v}
      (X : ι → Over T) (_ : AlgebraicGeometry.Scheme.HCovering X)
      (f : T' ⟶ T), AlgebraicGeometry.Scheme.HCovering
        (fun i : ι ↦ Over.mk (pullback.snd (X i).hom f)))
