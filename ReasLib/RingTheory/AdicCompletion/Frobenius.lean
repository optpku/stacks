module

public import Mathlib.Algebra.Algebra.Tower
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Polynomial.Basic
public import ReasLib.FieldTheory.MvRatFunc.Frobenius
public import ReasLib.RingTheory.AdicCompletion.Noetherian
public import ReasLib.RingTheory.Completion.LocalRing

/-!
# Completion at Frobenius coordinate relations

The polynomial relations identifying base coordinates with powers of ambient
coordinates define a maximal ideal. Its adic completion has the ambient rational
function field as its residue field via polynomial evaluation.
-/

@[expose] public section

open MvPolynomial

noncomputable section

namespace MvRatFunc.Frobenius

/-- The polynomial relation identifying a variable's `p`th power with its base coordinate. -/
def pthPowerGen (n p : ℕ) [Fact p.Prime] (index : Fin n) :
    MvPolynomial (Fin n) (baseField n p) :=
  X index ^ p - C (baseCoordinate n p index)

/-- The ideal generated by all Frobenius coordinate relations. -/
def pthPowerIdeal (n p : ℕ) [Fact p.Prime] :
    Ideal (MvPolynomial (Fin n) (baseField n p)) :=
  Ideal.span (Set.range (pthPowerGen n p))

/-- The Frobenius relation ideal is the span of its coordinate relations. -/
theorem pthPowerIdeal_eq_span (n p : ℕ) [Fact p.Prime] :
    pthPowerIdeal n p = Ideal.span (Set.range (pthPowerGen n p)) :=
  rfl

/-- Each Frobenius coordinate relation belongs to the defining ideal. -/
theorem pthPowerGen_mem (n p : ℕ) [Fact p.Prime] (index : Fin n) :
    pthPowerGen n p index ∈ pthPowerIdeal n p :=
  sorry

/-- Evaluation at the ambient coordinates annihilates each Frobenius relation. -/
theorem aeval_x_pthPowerGen (n p : ℕ) [Fact p.Prime] (index : Fin n) :
    aeval (coordinate n p) (pthPowerGen n p index) = 0 :=
  sorry

/-- Evaluation at the ambient coordinates annihilates the Frobenius relation ideal. -/
theorem aeval_eq_zero_of_mem_pthPowerIdeal (n p : ℕ) [Fact p.Prime]
    {polynomial : MvPolynomial (Fin n) (baseField n p)}
    (h_mem : polynomial ∈ pthPowerIdeal n p) :
    aeval (coordinate n p) polynomial = 0 :=
  sorry

/-- The Frobenius coordinate relation ideal is maximal. -/
instance instIsMaximal_pthPowerIdeal (n p : ℕ) [Fact p.Prime] :
    (pthPowerIdeal n p).IsMaximal :=
  sorry

/-- The adic completion of the polynomial ring along the Frobenius relation ideal. -/
abbrev adicCompletion (n p : ℕ) [Fact p.Prime] : Type :=
  AdicCompletion (pthPowerIdeal n p) (MvPolynomial (Fin n) (baseField n p))

/-- The completion along the Frobenius relation ideal is a local ring. -/
instance instIsLocalRing_adicCompletion (n p : ℕ) [Fact p.Prime] :
    IsLocalRing (adicCompletion n p) :=
  sorry

/-- The completion along the Frobenius relation ideal is complete local. -/
instance instIsCompleteLocalRing_adicCompletion (n p : ℕ) [Fact p.Prime] :
    IsCompleteLocalRing (adicCompletion n p) :=
  sorry

/-- Polynomial evaluation after the first adic projection maps the completion
to the ambient rational function field. -/
def residueHom (n p : ℕ) [Fact p.Prime] :
    adicCompletion n p →ₐ[baseField n p] functionField n p :=
  (Ideal.Quotient.liftₐ (pthPowerIdeal n p) (aeval (coordinate n p))
      fun _ h_mem ↦ aeval_eq_zero_of_mem_pthPowerIdeal n p h_mem).comp
    ((AdicCompletion.evalOneₐ (pthPowerIdeal n p)).restrictScalars (baseField n p))

/-- The residue map evaluates polynomials at the ambient coordinates. -/
theorem residueHom_of (n p : ℕ) [Fact p.Prime]
    (polynomial : MvPolynomial (Fin n) (baseField n p)) :
    residueHom n p
        (algebraMap (MvPolynomial (Fin n) (baseField n p)) (adicCompletion n p) polynomial) =
      aeval (coordinate n p) polynomial :=
  sorry

/-- A set-theoretic section of the residue map, obtained from a polynomial fraction
`a / b` by the identity `a / b = a * b ^ (p - 1) / b ^ p`. The denominator's
`p`th power belongs to the Frobenius-image coefficient field. Fraction representatives
come from the proved fraction-ring presentation; no inverse is selected from an
admitted surjectivity assertion. -/
def residueHomSection (n p : ℕ) [Fact p.Prime] (z : functionField n p) :
    adicCompletion n p :=
  let a := (IsFractionRing.div_surjective (MvPolynomial (Fin n) (ZMod p)) z).choose
  let b := (IsFractionRing.div_surjective (MvPolynomial (Fin n) (ZMod p)) z).choose_spec.choose
  let coefficients : ZMod p →+* baseField n p :=
    (expandFraction n p).rangeRestrictField.comp
      ((algebraMap (MvPolynomial (Fin n) (ZMod p)) (functionField n p)).comp MvPolynomial.C)
  let denominator : baseField n p :=
    (expandFraction n p).rangeRestrictField
      (algebraMap (MvPolynomial (Fin n) (ZMod p)) (functionField n p) b)
  algebraMap (MvPolynomial (Fin n) (baseField n p)) (adicCompletion n p)
    (MvPolynomial.map coefficients a * MvPolynomial.map coefficients b ^ (p - 1) *
      C denominator⁻¹)

/-- The explicit fraction lift is a right inverse of the residue map. -/
theorem residueHomSection_rightInverse (n p : ℕ) [Fact p.Prime] :
    Function.RightInverse (residueHomSection n p) (residueHom n p) :=
  sorry

/-- The residue map is surjective onto the ambient rational function field. -/
theorem surjective_residueHom (n p : ℕ) [Fact p.Prime] :
    Function.Surjective (residueHom n p) :=
  fun z ↦ ⟨residueHomSection n p z, residueHomSection_rightInverse n p z⟩

/-- The maximal ideal of the completion is the kernel of its evaluation residue map. -/
theorem maximalIdeal_adicCompletion_eq_ker (n p : ℕ) [Fact p.Prime] :
    IsLocalRing.maximalIdeal (adicCompletion n p) = RingHom.ker (residueHom n p).toRingHom :=
  sorry

/-- The quotient-induced identification of the completion's residue field with
the ambient rational function field over the Frobenius-image base field. -/
def residueFieldIso (n p : ℕ) [Fact p.Prime] :
    IsLocalRing.ResidueField (adicCompletion n p) ≃ₐ[baseField n p] functionField n p :=
  (Ideal.quotientEquivAlgOfEq (baseField n p)
      (maximalIdeal_adicCompletion_eq_ker n p)).trans
    (Ideal.quotientKerAlgEquivOfRightInverse (residueHomSection_rightInverse n p))

/-- The residue identification sends a residue class to its evaluation residue. -/
theorem residueFieldIso_apply (n p : ℕ) [Fact p.Prime] (value : adicCompletion n p) :
    residueFieldIso n p (IsLocalRing.residue (adicCompletion n p) value) =
      residueHom n p value :=
  sorry

end MvRatFunc.Frobenius
