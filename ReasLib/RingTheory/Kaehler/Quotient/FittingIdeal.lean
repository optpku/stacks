module

public import Mathlib.RingTheory.Kaehler.Polynomial
public import ReasLib.RingTheory.FittingIdeal.Basic
public import ReasLib.RingTheory.Kaehler.Quotient
public import ReasLib.RingTheory.Ideal.Cotangent.Generation

@[expose] public section

universe u

namespace KaehlerDifferential.Quotient

/-- For a square family of polynomial relations, the zeroth Fitting ideal of
the Kähler differentials of the quotient is generated by the image of the
Jacobian determinant. -/
theorem fittingIdeal_eq_span_jacobianDet
    {A : Type u} [CommRing A] {n : ℕ} (hn : 1 ≤ n)
    (f : Fin n → MvPolynomial (Fin n) A) :
    let I := Ideal.span (Set.range f)
    let B := MvPolynomial (Fin n) A ⧸ I
    fittingIdeal B (KaehlerDifferential A B) 0 =
      Ideal.span
        {Ideal.Quotient.mk I
          (Matrix.det (fun i j ↦ MvPolynomial.pderiv j (f i)))} := sorry

end KaehlerDifferential.Quotient
