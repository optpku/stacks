module

public import Mathlib.Algebra.CharZero.Defs
public import Mathlib.Algebra.Field.Basic
public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Algebra.Polynomial.Basic
public import Mathlib.RingTheory.Ideal.Maximal
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Kaehler.Basic
public import Mathlib.RingTheory.Spectrum.Prime.Basic
public import ReasLib.RingTheory.FittingIdeal.Basic

/-!
# The crossing family `k[x, y, t] / (x(y - t)(y - 1), x(x - t))`

Coordinate ring of the family `k[t] → k[x, y, t] / (x(y - t)(y - 1),
x(x - t))`, its two closed-point ideals, and its relative Kähler differential
Fitting ideals.
-/

@[expose] public section

noncomputable section

open MvPolynomial
open scoped FittingIdeal

universe u

namespace CrossingFamily

/-- The coordinate `x` as the first indeterminate of `(Polynomial k)[x, y]`. -/
abbrev x (k : Type u) [CommRing k] : MvPolynomial (Fin 2) (Polynomial k) :=
  X 0

/-- The coordinate `y` as the second indeterminate of `(Polynomial k)[x, y]`. -/
abbrev y (k : Type u) [CommRing k] : MvPolynomial (Fin 2) (Polynomial k) :=
  X 1

/-- The indeterminate `t` in `Polynomial k`. -/
abbrev t (k : Type u) [CommRing k] : Polynomial k :=
  Polynomial.X

/-- The relation `x(y - t)(y - 1)` in `(Polynomial k)[x, y]`. -/
def rel0 (k : Type u) [CommRing k] : MvPolynomial (Fin 2) (Polynomial k) :=
  x k * (y k - C (t k)) * (y k - 1)

/-- The relation `x(x - t)` in `(Polynomial k)[x, y]`. -/
def rel1 (k : Type u) [CommRing k] : MvPolynomial (Fin 2) (Polynomial k) :=
  x k * (x k - C (t k))

/-- The ideal generated by the two defining relations of the crossing family. -/
def relationIdeal (k : Type u) [CommRing k] :
    Ideal (MvPolynomial (Fin 2) (Polynomial k)) :=
  Ideal.span {rel0 k, rel1 k}

/-- The coordinate ring `k[x, y, t] / (x(y - t)(y - 1), x(x - t))`. -/
abbrev coordRing (k : Type u) [CommRing k] : Type u :=
  MvPolynomial (Fin 2) (Polynomial k) ⧸ relationIdeal k

/-- The first defining relation vanishes in `CrossingFamily.coordRing k`. -/
theorem mk_rel0 (k : Type u) [CommRing k] :
    Ideal.Quotient.mk (relationIdeal k) (rel0 k) = 0 := sorry

/-- The second defining relation vanishes in `CrossingFamily.coordRing k`. -/
theorem mk_rel1 (k : Type u) [CommRing k] :
    Ideal.Quotient.mk (relationIdeal k) (rel1 k) = 0 := sorry

/-- The element `x(2x - t)(2y - t - 1)` in `CrossingFamily.coordRing k`. -/
def fittingZeroGenerator (k : Type u) [CommRing k] : coordRing k :=
  Ideal.Quotient.mk (relationIdeal k)
    (x k * (2 * x k - C (t k)) * (2 * y k - C (t k) - 1))

/-- The closed-point ideal `(x, y, t)` in `CrossingFamily.coordRing k`. -/
def originIdeal (k : Type u) [CommRing k] : Ideal (coordRing k) :=
  (Ideal.span {x k, y k, C (t k)}).map (Ideal.Quotient.mk (relationIdeal k))

/-- The closed-point ideal `(x, y - 1, t)` in `CrossingFamily.coordRing k`. -/
def otherPointIdeal (k : Type u) [CommRing k] : Ideal (coordRing k) :=
  (Ideal.span {x k, y k - 1, C (t k)}).map (Ideal.Quotient.mk (relationIdeal k))

/-- The origin ideal of the crossing family is maximal over a field. -/
instance originIdeal.instIsMaximal (k : Type u) [Field k] :
    (originIdeal k).IsMaximal := sorry

/-- The second closed-point ideal of the crossing family is maximal over a
field. -/
instance otherPointIdeal.instIsMaximal (k : Type u) [Field k] :
    (otherPointIdeal k).IsMaximal := sorry

/-- In characteristic zero, the relative differential Fitting ideals of the
crossing family are the specified principal, two-point, and unit ideals. -/
theorem fittingIdeal (k : Type u) [Field k] [CharZero k] (n : ℕ) :
    Fit[coordRing k]_(n)(Ω[coordRing k⁄ Polynomial k]) =
      if n = 0 then Ideal.span {fittingZeroGenerator k}
      else if n = 1 then originIdeal k ⊓ otherPointIdeal k
      else ⊤ := sorry

/-- The zeroth relative differential Fitting ideal of the crossing family is
generated by `fittingZeroGenerator k`. -/
theorem fittingIdeal_zero (k : Type u) [Field k] [CharZero k] :
    Fit[coordRing k]_(0)(Ω[coordRing k⁄ Polynomial k]) =
      Ideal.span {fittingZeroGenerator k} := sorry

/-- The first relative differential Fitting ideal of the crossing family is
the intersection of its two closed-point ideals. -/
theorem fittingIdeal_one (k : Type u) [Field k] [CharZero k] :
    Fit[coordRing k]_(1)(Ω[coordRing k⁄ Polynomial k]) =
      originIdeal k ⊓ otherPointIdeal k := sorry

/-- Every relative differential Fitting ideal of the crossing family at index
at least two is the unit ideal. -/
theorem fittingIdeal_of_two_le (k : Type u) [Field k] [CharZero k]
    {n : ℕ} (hn : 2 ≤ n) :
    Fit[coordRing k]_(n)(Ω[coordRing k⁄ Polynomial k]) = ⊤ := sorry

/-- A prime belongs to the zero locus of the first crossing-family Fitting ideal
exactly when it is one of the two specified closed points. -/
theorem fittingIdeal_one_mem_zeroLocus_iff (k : Type u) [Field k] [CharZero k]
    {p : PrimeSpectrum (coordRing k)} :
    p ∈ PrimeSpectrum.zeroLocus
        (Fit[coordRing k]_(1)(Ω[coordRing k⁄ Polynomial k])) ↔
      p.asIdeal = originIdeal k ∨ p.asIdeal = otherPointIdeal k := sorry

end CrossingFamily
