module

public import ReasLib.AlgebraicGeometry.Scheme.Module.Coherent.SupportDimensionZero
import StacksCheckRecall

universe u

/- Lemma 30.9.10: let `X` be a locally Noetherian scheme and let `ℱ` be a coherent
module whose support has dimension at most zero. Then `ℱ` is generated by global sections
and its positive-degree cohomology vanishes. -/
@[stacks 0B3J] #check
  (AlgebraicGeometry.Scheme.Modules.SupportDimensionZero.isGloballyGenerated :
    ∀ {X : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsLocallyNoetherian X]
      (ℱ : X.Modules) [ℱ.IsCoherent],
      topologicalKrullDim (AlgebraicGeometry.Scheme.Modules.moduleSupport ℱ) ≤ 0 →
        SheafOfModules.IsGloballyGenerated ℱ)

#check
  (AlgebraicGeometry.Scheme.Modules.SupportDimensionZero.higherCohomology_isZero :
    ∀ {X : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsLocallyNoetherian X]
      (ℱ : X.Modules) [ℱ.IsCoherent],
      topologicalKrullDim (AlgebraicGeometry.Scheme.Modules.moduleSupport ℱ) ≤ 0 →
        ∀ (i : ℕ), 0 < i →
          CategoryTheory.Limits.IsZero
            (((SheafOfModules.toSheaf X.ringCatSheaf).obj ℱ).H' i
              (⊤ : TopologicalSpace.Opens X)))
