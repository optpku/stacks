module

import StacksCheckRecall
public import ReasLib.AlgebraicGeometry.Scheme.Module.Cohomology.SupportDimensionZero

@[expose] public section

open AlgebraicGeometry
open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.MonoidalCategory
open scoped DirectSum

noncomputable section

universe u

/- Lemma 33.33.3 (1): a coherent module with support of dimension at most zero on a scheme proper
over a field is generated by global sections. -/
@[stacks 0AYT] #check
  (AlgebraicGeometry.Scheme.Modules.SupportDimensionZero.isGloballyGenerated_of_isProper :
    ∀ {k : Type u} [Field k] {X : Scheme.{u}}
      (f : X ⟶ Spec (CommRingCat.of k)) [IsProper f]
      (ℱ : X.Modules) [ℱ.IsCoherent]
      (hSuppDim : topologicalKrullDim (Scheme.Modules.moduleSupport ℱ) ≤ 0),
      SheafOfModules.IsGloballyGenerated ℱ)

/- Lemma 33.33.3 (2): degree-zero cohomology is the direct sum, as a module over the base field,
of the stalks at points in the support. -/
@[stacks 0AYT] #check
  (AlgebraicGeometry.Scheme.Modules.SupportDimensionZero.zeroCohomology_isomorphic_directSum_stalks :
    ∀ {k : Type u} [Field k] {X : Scheme.{u}}
      (f : X ⟶ Spec (CommRingCat.of k)) [IsProper f]
      (ℱ : X.Modules) [ℱ.IsCoherent]
      (hSuppDim : topologicalKrullDim (Scheme.Modules.moduleSupport ℱ) ≤ 0),
      IsIsomorphic (Scheme.Hom.cohomology f ℱ 0)
        (ModuleCat.of k
          (Π₀ x : Scheme.Modules.moduleSupport ℱ, Scheme.Hom.stalkMod f ℱ x)))

/- Lemma 33.33.3 (3): positive-degree cohomology of a coherent module with support of dimension at
most zero on a scheme proper over a field vanishes. -/
@[stacks 0AYT] #check
  (AlgebraicGeometry.Scheme.Modules.SupportDimensionZero.higherCohomology_isZero_of_isProper :
    ∀ {k : Type u} [Field k] {X : Scheme.{u}}
      (f : X ⟶ Spec (CommRingCat.of k)) [IsProper f]
      (ℱ : X.Modules) [ℱ.IsCoherent]
      (hSuppDim : topologicalKrullDim (Scheme.Modules.moduleSupport ℱ) ≤ 0)
      (i : ℕ), 0 < i → IsZero (Scheme.Hom.cohomology f ℱ i))

/- Lemma 33.33.3 (4): the Euler characteristic of a coherent module with support of dimension at
most zero equals the dimension of its degree-zero cohomology. -/
@[stacks 0AYT] #check
  (AlgebraicGeometry.Scheme.Modules.SupportDimensionZero.eulerCharacteristic_eq_zeroCohomologyFinrank :
    ∀ {k : Type u} [Field k] {X : Scheme.{u}}
      (f : X ⟶ Spec (CommRingCat.of k)) [IsProper f]
      (ℱ : X.Modules) [ℱ.IsCoherent]
      (hSuppDim : topologicalKrullDim (Scheme.Modules.moduleSupport ℱ) ≤ 0),
      Scheme.Hom.eulerCharacteristic f ℱ =
        (Scheme.Hom.cohomologyFinrank f ℱ 0 : ℤ))

/- Lemma 33.33.3 (5): tensoring by a finite locally free module of constant rank multiplies the
Euler characteristic by that rank. -/
@[stacks 0AYT] #check
  (AlgebraicGeometry.Scheme.Modules.SupportDimensionZero.eulerCharacteristic_tensor_eq_rank_mul :
    ∀ {k : Type u} [Field k] {X : Scheme.{u}}
      (f : X ⟶ Spec (CommRingCat.of k)) [IsProper f]
      (ℱ : X.Modules) [ℱ.IsCoherent]
      (hSuppDim : topologicalKrullDim (Scheme.Modules.moduleSupport ℱ) ≤ 0)
      (n : ℕ) (ℰ : X.Modules) [Scheme.Modules.IsFiniteLocallyFreeOfRank n ℰ],
      let _ : (ℱ ⊗ ℰ : X.Modules).IsCoherent :=
        Scheme.Modules.isCoherent_tensor_of_isProper_over_field f ℱ n ℰ
      Scheme.Hom.eulerCharacteristic f (ℱ ⊗ ℰ : X.Modules) =
        (n : ℤ) * Scheme.Hom.eulerCharacteristic f ℱ)
