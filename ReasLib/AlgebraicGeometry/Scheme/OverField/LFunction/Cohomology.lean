/-- The L-function of a constructible flat sheaf is the inverse determinant of geometric
Frobenius on compactly supported derived sections computed with a compactification. -/
theorem lFunction_eq_inv_det_geometricFrobenius_compactification
    (X : SchemeOverField k) [Scheme.Hom.FiniteType X.hom]
    (P : Compactification.Of (Spec (CommRingCat.of k)) X)
    (hΛ : Nat.Coprime (Nat.card Λ) p)
    (F : Sheaf X.left.smallEtaleTopology (ModuleCat.{u} Λ))
    (hF : Sheaf.IsConstructibleEtaleModule
      (fun {Y} f ↦ (Sheaf.smallEtaleInverseImage f (ModuleCat.{u} Λ)).obj)
      (fun {Y} G ↦ Sheaf.IsFiniteTypeLocallyConstantModule G) F)
    [IsFlat F] :
    lFunction X hΛ F hF =
      (isPerfect_geometricRGammaCompactSupport_of_constructibleFlat X P hΛ F hF).eulerFactor
        (geometricFrobeniusRGammaCompactSupport X P
          ((DerivedCategory.singleFunctor
          (Sheaf X.left.smallEtaleTopology (ModuleCat.{u} Λ)) (0 : ℤ)).obj F)) 1 := sorry

/-- The L-function of a constructible flat sheaf on a finite-type scheme over a finite field
is its compact-support geometric Frobenius inverse determinant. -/
theorem lFunction_eq_inv_det_geometricFrobenius
    (X : SchemeOverField k) [Scheme.Hom.FiniteType X.hom]
    (hΛ : Nat.Coprime (Nat.card Λ) p)
    (F : Sheaf X.left.smallEtaleTopology (ModuleCat.{u} Λ))
    (hF : Sheaf.IsConstructibleEtaleModule
      (fun {Y} f ↦ (Sheaf.smallEtaleInverseImage f (ModuleCat.{u} Λ)).obj)
      (fun {Y} G ↦ Sheaf.IsFiniteTypeLocallyConstantModule G) F)
    [IsFlat F] :
    lFunction X hΛ F hF = CompactSupport.eulerFactor X hΛ F hF := sorry

end AlgebraicGeometry.SchemeOverField
