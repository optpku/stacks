module

public import ReasLib.Algebra.Homology.DerivedCategory.Completeness.KoszulLimit
public import ReasLib.Algebra.Homology.Koszul.PowerTower
public import Mathlib.Algebra.Homology.DerivedCategory.TStructure
public import Mathlib.Data.List.TFAE
import Mathlib.Tactic.CrossRefAttribute

/-!
# Nonpositive derived-complete objects and powered Koszul complexes

For an object derived complete with respect to a finitely generated ideal, this file compares
nonpositive cohomological bounds before and after tensoring with the quotient and with the first
stage of the powered Koszul tower.

@stack 0H83
-/

@[expose] public section

noncomputable section

open CategoryTheory Opposite
open scoped DerivedTensorProduct KoszulComplex

universe u

namespace CategoryTheory.DerivedCategory.KoszulLimit

variable {A : Type u} [CommRing A] {r : ℕ}

/-- Lemma 15.92.19 (0H83): if `K` is derived complete with respect to the ideal generated by
`f`, then `K`, its derived reduction modulo that ideal, and its derived tensor product with the
first powered Koszul stage are simultaneously cohomologically nonpositive. -/
@[stacks 0H83]
theorem isLE_zero_tfae_of_isDerivedComplete
    (f : Fin r → A) (K : DerivedCategory (ModuleCat.{u} A))
    (hK : K.IsDerivedCompleteWithRespectTo (Ideal.span (Set.range f))) :
    List.TFAE [
      K.IsLE 0,
      (K ⊗[A]^L
        (DerivedCategory.singleFunctor (ModuleCat.{u} A) (0 : ℤ)).obj
          (ModuleCat.of A (A ⧸ Ideal.span (Set.range f)))).IsLE 0,
      (K ⊗[A]^L
        (KoszulComplex.PowerTower.derivedSystem f).obj (op 0)).IsLE 0
    ] := sorry

end CategoryTheory.DerivedCategory.KoszulLimit
