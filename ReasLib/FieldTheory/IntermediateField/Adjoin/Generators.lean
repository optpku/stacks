module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis

@[expose] public section

/-!
# Generators of an adjoined intermediate field

Canonical generators internal to `IntermediateField.adjoin`, together with algebraic-independence
and transcendence-degree API for the field generated by a family.
-/

universe u v w

open scoped IntermediateField

namespace IntermediateField.AdjoinPair

variable {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]

/-- The first canonical generator of a two-generated intermediate field is transcendental
exactly when its ambient representative is transcendental. -/
theorem transcendental_gen₁_iff (x y : E) :
    Transcendental F (gen₁ F x y) ↔ Transcendental F x := by
  exact (transcendental_algebraMap_iff (R := F) (a := gen₁ F x y)
    (algebraMap F⟮x, y⟯ E).injective).symm

/-- The second canonical generator of a two-generated intermediate field is transcendental
exactly when its ambient representative is transcendental. -/
theorem transcendental_gen₂_iff (x y : E) :
    Transcendental F (gen₂ F x y) ↔ Transcendental F y := by
  exact (transcendental_algebraMap_iff (R := F) (a := gen₂ F x y)
    (algebraMap F⟮x, y⟯ E).injective).symm

end IntermediateField.AdjoinPair

namespace IntermediateField

variable {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]

/-- Adjoining the range of a two-entry vector agrees with adjoining its two entries. -/
@[simp]
theorem adjoin_range_pair (x y : E) :
    adjoin F (Set.range ![x, y]) = F⟮x, y⟯ := by
  rw [Matrix.range_cons_cons_empty]

end IntermediateField

namespace IntermediateField.AdjoinRange

variable {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]

/-- The canonical copy of a member of a generating family inside the intermediate field that the
family generates. -/
def gen {ι : Type w} (x : ι → E) (i : ι) : IntermediateField.adjoin F (Set.range x) :=
  ⟨x i, IntermediateField.subset_adjoin F (Set.range x) (Set.mem_range_self i)⟩

/-- Mapping a canonical internal generator to the ambient field recovers the original generator. -/
@[simp]
theorem algebraMap_gen {ι : Type w} (x : ι → E) (i : ι) :
    algebraMap (IntermediateField.adjoin F (Set.range x)) E (gen (F := F) x i) = x i := rfl

/-- The canonical internal generators generate their adjoined intermediate field. -/
theorem adjoin_range_gen_eq_top {ι : Type w} (x : ι → E) :
    IntermediateField.adjoin F (Set.range (gen (F := F) x)) = ⊤ := by
  apply IntermediateField.lift_injective (IntermediateField.adjoin F (Set.range x))
  rw [IntermediateField.lift_adjoin, IntermediateField.lift_top, ← Set.range_comp]
  rfl

/-- The canonical internal generators are algebraically independent exactly when the original
ambient family is. -/
theorem algebraicIndependent_gen_iff {ι : Type w} (x : ι → E) :
    AlgebraicIndependent F (gen (F := F) x) ↔ AlgebraicIndependent F x := by
  exact ((IntermediateField.adjoin F (Set.range x)).val.algebraicIndependent_iff
    Subtype.val_injective).symm

open scoped IntermediateField.algebraAdjoinAdjoin

/-- The canonical internal generators form a transcendence basis exactly when the original
ambient family is algebraically independent. -/
theorem isTranscendenceBasis_gen_iff {ι : Type w} (x : ι → E) :
    IsTranscendenceBasis F (gen (F := F) x) ↔ AlgebraicIndependent F x := by
  constructor
  · intro hx
    exact (algebraicIndependent_gen_iff x).1 hx.1
  · intro hx
    apply ((algebraicIndependent_gen_iff x).2 hx).isTranscendenceBasis_iff_isAlgebraic.mpr
    refine ⟨fun z ↦ ?_⟩
    have hz : z ∈ IntermediateField.adjoin F (Set.range (gen (F := F) x)) := by
      rw [adjoin_range_gen_eq_top]
      trivial
    exact (Algebra.IsAlgebraic.isAlgebraic
      (R := Algebra.adjoin F (Set.range (gen (F := F) x)))
      (⟨z, hz⟩ : IntermediateField.adjoin F (Set.range (gen (F := F) x)))).algebraMap

end IntermediateField.AdjoinRange

namespace AlgebraicIndependent

variable {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]

/-- The transcendence degree of the intermediate field generated by an algebraically independent
family is the cardinality of its index type. -/
theorem trdeg_adjoin_range_eq_cardinalMk {ι : Type w} {x : ι → E}
    (hx : AlgebraicIndependent F x) :
    Cardinal.lift.{w} (Algebra.trdeg F (IntermediateField.adjoin F (Set.range x))) =
      Cardinal.lift.{v} (Cardinal.mk ι) := by
  have hb := (IntermediateField.AdjoinRange.isTranscendenceBasis_gen_iff x).2 hx
  exact hb.lift_cardinalMk_eq_trdeg.symm

/-- The field generated by two algebraically independent elements has transcendence degree two. -/
theorem trdeg_adjoin_pair_eq_two {x y : E}
    (hxy : AlgebraicIndependent F ![x, y]) :
    Algebra.trdeg F (F⟮x, y⟯) = 2 := by
  rw [← IntermediateField.adjoin_range_pair]
  simpa using hxy.trdeg_adjoin_range_eq_cardinalMk

end AlgebraicIndependent

namespace Transcendental

variable {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]

/-- A field extension containing a transcendental element has transcendence degree at least one. -/
theorem one_le_trdeg {x : E} (hx : Transcendental F x) :
    1 ≤ Algebra.trdeg F E := by
  letI : Algebra.Transcendental F E := ⟨⟨x, hx⟩⟩
  exact Cardinal.one_le_iff_pos.mpr (trdeg_pos F E)

end Transcendental
