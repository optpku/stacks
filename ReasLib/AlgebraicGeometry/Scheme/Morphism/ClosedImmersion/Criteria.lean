module

public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Quasicoherent
public import Mathlib.Topology.Sheaves.LocallySurjective
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.LocalGeneration
public import ReasLib.AlgebraicGeometry.RingedSpace.IdealSubobject.Kernel

/-!
# Criteria for closed immersions of schemes

Closed immersions can be detected on an affine open cover or from the underlying closed embedding
and the induced morphism of structure sheaves. The latter description can also record the
quasi-coherence or local generation of the kernel ideal sheaf.
-/

@[expose] public section

open CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry

variable {X Z : Scheme.{u}} (i : Z ⟶ X)

namespace IsClosedImmersion

/-- A scheme morphism is a closed immersion exactly when some affine open cover of the target has
affine inverse images with surjective maps on global sections. -/
theorem iff_exists_affineOpenCover :
    IsClosedImmersion i ↔
      ∃ 𝒰 : X.AffineOpenCover,
        ∀ j : 𝒰.I₀,
          IsAffineOpen (i ⁻¹ᵁ (𝒰.f j).opensRange) ∧
            Function.Surjective ((i ∣_ (𝒰.f j).opensRange).appTop) := sorry

/-- A scheme morphism is a closed immersion exactly when its map of spaces is a closed embedding
and its structure-sheaf map to the pushforward is locally surjective. -/
theorem iff_closedEmbedding_locallySurjective :
    IsClosedImmersion i ↔
      Topology.IsClosedEmbedding i.base ∧
        Sheaf.IsLocallySurjective
          (RingedSpace.Hom.commRingSheafPushforwardMap i.toShHom) := sorry

/-- A scheme morphism is a closed immersion exactly when its map of spaces is a closed embedding,
its structure-sheaf map is locally surjective, and its kernel ideal sheaf is quasi-coherent. -/
theorem iff_closedEmbedding_locallySurjective_quasicoherentKernel :
    IsClosedImmersion i ↔
      Topology.IsClosedEmbedding i.base ∧
        Sheaf.IsLocallySurjective
          (RingedSpace.Hom.commRingSheafPushforwardMap i.toShHom) ∧
          (RingedSpace.Hom.kernelIdealSheaf i.toShHom).IsQuasicoherent := sorry

/-- A scheme morphism is a closed immersion exactly when its map of spaces is a closed embedding,
its structure-sheaf map is locally surjective, and its kernel ideal sheaf is locally generated by
sections. -/
theorem iff_closedEmbedding_locallySurjective_locallyGeneratedKernel :
    IsClosedImmersion i ↔
      Topology.IsClosedEmbedding i.base ∧
        Sheaf.IsLocallySurjective
          (RingedSpace.Hom.commRingSheafPushforwardMap i.toShHom) ∧
          SheafOfModules.IsLocallyGeneratedBySections
            (RingedSpace.Hom.kernelIdealSheaf i.toShHom) := sorry

end IsClosedImmersion

end AlgebraicGeometry
