module

public import stacks_project.Chap52.Remark_52_6_14_Localization_and_derived_completion
public import stacks_project.Chap52.Lemma_52_6_20
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.OverSections
public import ReasLib.AlgebraicGeometry.RingedSite.Module.GlobalSections.Derived.Completion
import StacksCheckRecall

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open RingedSite.Hom RingedSite.Hom.ModuleDerived
open SheafOfModules.RingedSite SheafOfModules.RingedSite.ExtendedCech

universe u

/- Remark 52.6.21: derived sections of an ideal-sheaf completion are the derived completion
of sections at the ideal generated by the chosen finite family in the section ring.
This ideal need not be the full ideal of sections of the ideal sheaf. -/
@[stacks 0CQI] #check
  (RingedSite.Hom.ModuleDerived.derivedSectionsCompletionComparisonIsIso :
    ∀ {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
      [J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})]
      [J.HasSheafCompose (forget₂ RingCat.{u} AddCommGrpCat.{u})]
      [HasWeakSheafify J AddCommGrpCat.{u}]
      [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
      [HasWeakSheafify J CommRingCat.{u}]
      [J.WEqualsLocallyBijective CommRingCat.{u}]
      {O : Sheaf J CommRingCat.{u}}
      (I : Subobject (unitModule J O))
      [(I : ringedSiteModuleCategory J O).IsFiniteType]
      (U : C) {r : ℕ}
      (f : Fin r → (unitModule (J.over U) (O.over U)).sections)
      (hgen : generatedIdeal f = imageSubobject (I.arrow.over U))
      {K Khat : RingedSiteDerived J O} (eta : K ⟶ Khat)
      (heta : IsDerivedCompletion.{u, u, u, u} I eta),
      IsIso (derivedSectionsCompletionComparison I U f hgen eta heta))
