module

public import ReasLib.CategoryTheory.Pretriangulated.Extension
public import Mathlib.CategoryTheory.Triangulated.Generators
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Positive Stages of a Triangulated Envelope

Mathlib owns the natural-number-indexed triangulated envelope of an object
property. This leaf supplies the genuinely additional Chapter 13 interface:
the positive indexing used for one generating object, together with bridges to
additive extension stages and bounded shift intervals.
-/

open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.ObjectProperty
open CategoryTheory.Pretriangulated

universe v u

namespace CategoryTheory.ObjectProperty

section

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [Preadditive C] [HasShift C ℤ]
  [(n : ℤ) → (shiftFunctor C n).Additive] [Pretriangulated C]

namespace triangEnvelopeIter

/-- For a nonempty object property, the canonical natural-number triangulated-envelope iteration
is the additive extension stage of the shift closure, under the positive reindexing
`n ↦ n.natPred`. -/
theorem eq_additiveExtensionStage (P : ObjectProperty C) [P.Nonempty] (n : ℕ+) :
    P.triangEnvelopeIter n.natPred = additiveExtensionStage (P.shiftClosure ℤ) n := sorry

end triangEnvelopeIter

namespace Generated

/-- The positive `n`-th stage generated by an object, viewed through Mathlib's canonical
triangulated-envelope iteration. -/
@[stacks 0FX9]
abbrev stage (E : C) (n : ℕ+) : ObjectProperty C :=
  (singleton E).triangEnvelopeIter n.natPred

namespace Stage

/-- The positive object-generated stage is the corresponding Mathlib triangulated-envelope
iteration. -/
theorem eq_triangEnvelopeIter (E : C) (n : ℕ+) :
    stage E n = (singleton E).triangEnvelopeIter n.natPred := sorry

/-- Positive object-generated stages are monotone in the stage index. -/
theorem mono (E : C) {n m : ℕ+} (h : n ≤ m) :
    stage E n ≤ stage E m := sorry

/-- Every positive object-generated stage lies in the canonical triangulated envelope of the
generating object. -/
theorem le_property (E : C) (n : ℕ+) :
    stage E n ≤ (singleton E).triangEnvelope := sorry

/-- The generating object belongs to every positive object-generated stage. -/
theorem self_mem (E : C) (n : ℕ+) :
    stage E n E := sorry

/-- The first generated stage is the retract closure of the additive closure of all shifts. -/
theorem one (E : C) :
    stage E 1 = (((singleton E).shiftClosure ℤ).additiveClosure).retractClosure := sorry

/-- The successor generated stage is obtained by one additional extension with the first stage. -/
theorem succ (E : C) (n : ℕ+) :
    stage E (n + 1) =
      (extensionProduct (stage E 1) (stage E n)).retractClosure := sorry

/-- The object-generated stage agrees with the additive extension stage of its shift closure. -/
theorem eq_additiveExtensionStage (E : C) (n : ℕ+) :
    stage E n = additiveExtensionStage ((singleton E).shiftClosure ℤ) n := sorry

/-- The generated stage is the retract closure of the iterated extension product of its first
stage. -/
@[stacks 0FX9]
theorem eq_retractClosure_extensionProductIter (E : C) (n : ℕ+) :
    stage E n = ((stage E 1).extensionProductIter n.natPred).retractClosure := sorry

/-- The generated stage is the supremum of its bounded shift-interval presentations. -/
@[stacks 0FX9]
theorem eq_iSup_intervalStage (E : C) (n : ℕ+) :
    stage E n =
      ⨆ m : ℕ+,
        additiveExtensionStage (objectShiftInterval E (-(m : ℤ)) (m : ℤ)) n := sorry

end Stage

end Generated

end

section

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [Preadditive C] [HasShift C ℤ]
  [(n : ℤ) → (shiftFunctor C n).Additive] [Pretriangulated C] [IsTriangulated C]

namespace Generated.Stage

/-- Addition of positive generated stages is the retract closure of their extension product. -/
@[stacks 0FX9]
theorem add (E : C) (n m : ℕ+) :
    Generated.stage E (n + m) =
      (extensionProduct (Generated.stage E n) (Generated.stage E m)).retractClosure := sorry

end Generated.Stage

end

end CategoryTheory.ObjectProperty

namespace CategoryTheory.ObjectProperty.GeneratedNotation

open CategoryTheory.ObjectProperty

/-- Scoped notation for a positive stage generated by an object. -/
scoped notation:max "⟨" E "⟩[" n "]" => Generated.stage E n

end CategoryTheory.ObjectProperty.GeneratedNotation
