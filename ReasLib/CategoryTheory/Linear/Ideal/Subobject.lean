module

public import Mathlib.CategoryTheory.Linear.FunctorCategory
public import Mathlib.CategoryTheory.Subobject.Lattice
public import Mathlib.CategoryTheory.Subobject.Limits
public import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Tactic.CrossRefAttribute

/-!
# Subobjects generated by an ideal action

This file gives both a choice-free universal property for the subobject `I • X` in an
`A`-linear category and its canonical supremum-of-images realization when the subobject lattice
is complete.  The universal property is the portable API: inverse systems and sheaf constructions
can use it without exposing existence machinery for arbitrary joins.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

noncomputable section

universe u v w

namespace Ideal

variable {A : Type w} [CommRing A]
variable {C : Type u} [Category.{v} C] [Preadditive C] [Linear A C]

/-- A monomorphism `ι : K ⟶ X` presents `K` as the subobject generated by the images of
scalar multiplication by elements of `I`.

The last clause is the minimality property: every subobject through which all scalar
endomorphisms from `I` factor also contains `K`. -/
@[stacks 0GYM "subobject generated by an ideal action"]
def IsSMulSubobject (I : Ideal A) {K X : C} (ι : K ⟶ X) : Prop :=
  Mono ι ∧
    (∀ a : I, ∃ lift : X ⟶ K, lift ≫ ι = (a : A) • 𝟙 X) ∧
    ∀ {Y : C} (j : Y ⟶ X) [Mono j],
      (∀ a : I, ∃ lift : X ⟶ Y, lift ≫ j = (a : A) • 𝟙 X) →
        ∃ lift : K ⟶ Y, lift ≫ j = ι

/-- The presenting map of an ideal-generated subobject is monic. -/
theorem IsSMulSubobject.mono
    {I : Ideal A} {K X : C} {ι : K ⟶ X} (h : I.IsSMulSubobject ι) :
    Mono ι := sorry

/-- Every scalar endomorphism belonging to the ideal factors through an ideal-generated
subobject. -/
theorem IsSMulSubobject.factors
    {I : Ideal A} {K X : C} {ι : K ⟶ X} (h : I.IsSMulSubobject ι) (a : I) :
    ∃ lift : X ⟶ K, lift ≫ ι = (a : A) • 𝟙 X := sorry

/-- An ideal-generated subobject factors through every subobject containing all scalar images. -/
theorem IsSMulSubobject.lift
    {I : Ideal A} {K X Y : C} {ι : K ⟶ X} (h : I.IsSMulSubobject ι)
    (j : Y ⟶ X) [Mono j]
    (hj : ∀ a : I, ∃ lift : X ⟶ Y, lift ≫ j = (a : A) • 𝟙 X) :
    ∃ lift : K ⟶ Y, lift ≫ j = ι := sorry

/-- Any two presentations of the subobject generated by the same ideal action are isomorphic over
the ambient object. -/
theorem IsSMulSubobject.exists_iso
    {I : Ideal A} {K L X : C} {ι : K ⟶ X} {κ : L ⟶ X}
    (hι : I.IsSMulSubobject ι) (hκ : I.IsSMulSubobject κ) :
    ∃ e : K ≅ L, e.hom ≫ κ = ι := sorry

/-- An isomorphism between two ideal-action presentations is determined by its compatibility with
the ambient inclusions. -/
theorem IsSMulSubobject.iso_hom_unique
    {I : Ideal A} {K L X : C} {ι : K ⟶ X} {κ : L ⟶ X}
    (hκ : I.IsSMulSubobject κ) (e e' : K ≅ L)
    (he : e.hom ≫ κ = ι) (he' : e'.hom ≫ κ = ι) :
    e.hom = e'.hom := sorry

section CompleteLattice

variable [HasImages C] [∀ X : C, CompleteLattice (Subobject X)]

/-- The image subobject of multiplication by one scalar. -/
def scalarSubobject (a : A) (X : C) : Subobject X :=
  imageSubobject (a • 𝟙 X)

/-- The canonical subobject `I • X`, realized as the supremum of the scalar image subobjects. -/
@[stacks 0GYM "canonical subobject generated by an ideal action"]
def smulSubobject (I : Ideal A) (X : C) : Subobject X :=
  ⨆ a : I, scalarSubobject (a : A) X

/-- The canonical ideal-power subobject `I ^ n • X`. -/
@[stacks 0GYM "canonical ideal-power subobject"]
abbrev powSmulSubobject (I : Ideal A) (n : ℕ) (X : C) : Subobject X :=
  (I ^ n).smulSubobject X

/-- The canonical supremum-of-images construction satisfies the universal property of `I • X`. -/
theorem smulSubobject_isSMulSubobject (I : Ideal A) (X : C) :
    I.IsSMulSubobject (I.smulSubobject X).arrow := sorry

/-- The canonical ideal-power construction satisfies the universal property of `I ^ n • X`. -/
theorem powSmulSubobject_isSMulSubobject (I : Ideal A) (n : ℕ) (X : C) :
    (I ^ n).IsSMulSubobject (I.powSmulSubobject n X).arrow := sorry

end CompleteLattice

end Ideal
