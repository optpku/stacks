module

public import ReasLib.AlgebraicGeometry.Scheme.Morphism.Flat
public import ReasLib.AlgebraicGeometry.Scheme.Morphism.SourceLocus

import Mathlib.Algebra.Field.ULift
import Mathlib.Algebra.DirectSum.Module
import Mathlib.Algebra.Module.ULift
import Mathlib.Algebra.TrivSqZeroExt.Basic
import ReasLib.RingTheory.RingHom.Local.AtPrime
import ReasLib.RingTheory.RingHom.Local.Surjective

/-!
# A flatness counterexample

This module gives a scheme morphism that is flat at a point which does not lie in its flat source
locus.
-/

@[expose] public section

open CategoryTheory Limits
open scoped AlgebraicGeometry

universe u

namespace AlgebraicGeometry.Scheme.Hom

noncomputable section

/-- The polynomial ring used in the affine flatness counterexample. -/
private abbrev integerFiberRing : Type u := Polynomial (ULift.{u} ℚ)

/-- The canonical commutative ring structure on the abbreviated polynomial carrier. -/
-- Local instance justification (defeq pin): dependent-family synthesis must reuse the
-- polynomial carrier's canonical structure through the private abbreviation.
private instance integerFiberRingCommRing : CommRing integerFiberRing :=
  inferInstanceAs (CommRing (Polynomial (ULift.{u} ℚ)))

/-- The closed-point ideal generated by `X - n` in the counterexample ring. -/
private abbrev integerFiberIdeal (n : ℕ) : Ideal integerFiberRing :=
  Ideal.span ({Polynomial.X - Polynomial.C (n : ULift.{u} ℚ)} : Set integerFiberRing)

/-- The countable direct sum of closed fibers used to build the square-zero kernel. -/
private abbrev integerFiberModule : Type u :=
  DirectSum ℕ (fun n => integerFiberRing ⧸ integerFiberIdeal n)

/-- The closed point of `Spec ℚ[X]` cut out by `X - n`. -/
private def integerFiberPrime (n : ℕ) : PrimeSpectrum integerFiberRing :=
  ⟨integerFiberIdeal n,
    (Ideal.span_singleton_prime (Polynomial.X_sub_C_ne_zero (n : ULift.{u} ℚ))).2
      (Polynomial.prime_X_sub_C (n : ULift.{u} ℚ))⟩

/-- A nonzero rational polynomial takes a nonzero value at some natural number. -/
private lemma exists_nat_eval_ne_zero (s : integerFiberRing) (hs : s ≠ 0) :
    ∃ n : ℕ, Polynomial.eval (n : ULift.{u} ℚ) s ≠ 0 := by
  classical
  let roots : Set (ULift.{u} ℚ) := {q | s.IsRoot q}
  have hrootsFinite : roots.Finite := Polynomial.finite_setOf_isRoot hs
  have hnatInfinite : (Set.range fun n : ℕ ↦ (n : ULift.{u} ℚ)).Infinite :=
    Set.infinite_range_of_injective (fun m n hmn ↦ by
      exact_mod_cast congrArg ULift.down hmn)
  -- Choose a natural number outside the finite root set.
  obtain ⟨q, hqNat, hqNotRoot⟩ := hnatInfinite.exists_notMem_finite hrootsFinite
  rcases hqNat with ⟨n, rfl⟩
  exact ⟨n, by simpa [roots, Polynomial.IsRoot.def] using hqNotRoot⟩

/-- The closed point `(X - n)` lies in the support of the countable fiber module. -/
private lemma integerFiberModule_mem_support_closedPoint (n : ℕ) :
    integerFiberPrime n ∈ Module.support integerFiberRing integerFiberModule := by
  rw [Module.mem_support_iff']
  refine ⟨DirectSum.lof integerFiberRing ℕ
      (fun k ↦ integerFiberRing ⧸ integerFiberIdeal k) n
      (Ideal.Quotient.mk (integerFiberIdeal n) 1), ?_⟩
  intro r hr hzero
  have hcomponent := congrArg (fun z : integerFiberModule ↦ z n) hzero
  -- Read the contradiction off the distinguished `n`-th summand.
  have hq' :
      r • (1 : integerFiberRing ⧸ integerFiberIdeal n) = 0 := by
    simpa [DirectSum.smul_apply, DirectSum.lof_eq_of, DirectSum.of_eq_same] using hcomponent
  have hq :
      (Ideal.Quotient.mk (integerFiberIdeal n) r :
        integerFiberRing ⧸ integerFiberIdeal n) = 0 := by
    have hmul :
        (Ideal.Quotient.mk (integerFiberIdeal n) r :
          integerFiberRing ⧸ integerFiberIdeal n) * 1 = 0 := by
      change r • (1 : integerFiberRing ⧸ integerFiberIdeal n) = 0
      exact hq'
    simpa using hmul
  exact hr (Ideal.Quotient.eq_zero_iff_mem.1 hq)

/-- There exist a scheme morphism and a point where it is flat, but the point does not belong to
the flat source locus. -/
public theorem exists_flatAt_not_mem_flatSourceLocus :
    ∃ (X Y : Scheme.{u}) (f : X ⟶ Y) (x : X),
      f.flatAt x ∧ x ∉
        CategoryTheory.MorphismProperty.sourceLocus
          (@Flat : MorphismProperty Scheme.{u}) f :=
by
  let R := integerFiberRing
  let M := integerFiberModule
  let A := TrivSqZeroExt R M
  let π :
      @RingHom A R
        (inferInstance : CommRing A).toCommSemiring.toNonAssocSemiring
        (inferInstance : CommRing R).toCommSemiring.toNonAssocSemiring :=
    { toFun := TrivSqZeroExt.fst
      map_one' := rfl
      map_mul' := fun _ _ ↦ rfl
      map_zero' := rfl
      map_add' := fun _ _ ↦ rfl }
  let X : Scheme.{u} := Spec (CommRingCat.of R)
  let Y : Scheme.{u} := Spec (CommRingCat.of A)
  let f : X ⟶ Y := Spec.map (CommRingCat.ofHom π)
  have hgenericNotSupport : (⊥ : PrimeSpectrum R) ∉ Module.support R M := by
    classical
    refine (Module.notMem_support_iff' (R := R) (M := M) (p := (⊥ : PrimeSpectrum R))).2 ?_
    intro m
    let t : Finset ℕ := m.support
    let r : R := ∏ i ∈ t, (Polynomial.X - Polynomial.C (i : ULift.{u} ℚ))
    refine ⟨r, ?_, ?_⟩
    · intro hr
      have hne : r ≠ 0 := by
        dsimp [r]
        exact Finset.prod_ne_zero_iff.2 fun i hi ↦ Polynomial.X_sub_C_ne_zero (i : ULift.{u} ℚ)
      exact hne hr
    · -- Kill each component by the corresponding linear factor in the finite support.
      ext i
      change r • m i = 0
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (m i)
      rw [← ha]
      by_cases hi : i ∈ t
      · have hri : r ∈ integerFiberIdeal i := by
          rcases
              show (Polynomial.X - Polynomial.C (i : ULift.{u} ℚ)) ∣ r from by
                refine ⟨∏ j ∈ t.erase i, (Polynomial.X - Polynomial.C (j : ULift.{u} ℚ)), ?_⟩
                simpa [r] using
                  (Finset.mul_prod_erase t
                    (fun j ↦ Polynomial.X - Polynomial.C (j : ULift.{u} ℚ)) hi).symm
            with ⟨b, hb⟩
          rw [hb]
          exact Ideal.mul_mem_right b (integerFiberIdeal i)
            (Ideal.subset_span (by simp))
        change (Ideal.Quotient.mk (integerFiberIdeal i) r :
            R ⧸ integerFiberIdeal i) *
            Ideal.Quotient.mk (integerFiberIdeal i) a = 0
        exact Ideal.Quotient.eq_zero_iff_mem.2
          (Ideal.mul_mem_right a (integerFiberIdeal i) hri)
      · have hmi : (Ideal.Quotient.mk (integerFiberIdeal i) a :
            R ⧸ integerFiberIdeal i) = 0 := by
          simpa [ha] using (DFinsupp.notMem_support_iff.1 hi : m i = 0)
        simp [hmi]
  have hπsurj : Function.Surjective π := fun r ↦ ⟨TrivSqZeroExt.inl r, by rfl⟩
  -- Off the support, the localized square-zero kernel vanishes, so the local map is an isomorphism.
  have hflatAt_of_notMemSupport :
      ∀ {p : PrimeSpectrum R}, p ∉ Module.support R M → f.flatAt p := by
    intro p hp
    have hkerZero : π.localKernelIdealAt p = ⊥ := by
      rw [RingHom.localKernelIdealAt, Ideal.map_eq_bot_iff_le_ker]
      intro y hy
      rw [RingHom.mem_ker]
      have hyfst : y.fst = 0 := by
        simpa [π] using hy
      rcases (Module.notMem_support_iff' (R := R) (M := M) (p := p)).1 hp y.snd with
        ⟨r, hrp, hrm⟩
      have hyinr : y = TrivSqZeroExt.inr y.snd := by
        exact TrivSqZeroExt.ext hyfst rfl
      rw [hyinr, IsLocalization.map_eq_zero_iff (PrimeSpectrum.comap π p).asIdeal.primeCompl]
      refine ⟨⟨TrivSqZeroExt.inl r, ?_⟩, ?_⟩
      · change π (TrivSqZeroExt.inl r) ∉ p.asIdeal
        simpa [π] using hrp
      · rw [TrivSqZeroExt.inl_mul_inr, hrm, TrivSqZeroExt.inr_zero]
    have hinj : Function.Injective (π.localRingHomAt p) := by
      rw [RingHom.injective_iff_ker_eq_bot]
      simpa [RingHom.ker_localRingHomAt π hπsurj p] using hkerZero
    have hlocalFlat : (π.localRingHomAt p).Flat :=
      (RingHom.FaithfullyFlat.of_bijective
        ⟨hinj, RingHom.localRingHomAt_surjective π hπsurj p⟩).flat
    change ((Spec.map (CommRingCat.ofHom π)).stalkMap p).hom.Flat
    exact
      (RingHom.Flat.respectsIso.arrow_mk_iso_iff
        (Scheme.arrowStalkMapSpecIso (CommRingCat.ofHom π) p)).2 hlocalFlat
  -- On the support, a nonzero localized kernel element prevents the local map from being flat.
  have hnotFlatAt_of_memSupport :
      ∀ {p : PrimeSpectrum R}, p ∈ Module.support R M → ¬ f.flatAt p := by
    intro p hp hflat
    have hlocalFlat : (π.localRingHomAt p).Flat := by
      change ((Spec.map (CommRingCat.ofHom π)).stalkMap p).hom.Flat at hflat
      exact
        (RingHom.Flat.respectsIso.arrow_mk_iso_iff
          (Scheme.arrowStalkMapSpecIso (CommRingCat.ofHom π) p)).1 hflat
    -- Local instance justification (proof-local temporary data): equips the localized target with the algebra structure induced by the local ring homomorphism.
    letI : Algebra (π.sourceLocalRingAt p) (Localization.AtPrime p.asIdeal) :=
      (π.localRingHomAt p).toAlgebra
    -- Local instance justification (proof-local temporary data): exposes the module structure induced by the localized algebra structure for the flatness argument.
    letI : Module (π.sourceLocalRingAt p) (Localization.AtPrime p.asIdeal) := Algebra.toModule
    -- Local instance justification (proof-local temporary data): records that the localized algebra map is local, as required for faithful flatness.
    haveI : IsLocalHom (algebraMap (π.sourceLocalRingAt p) (Localization.AtPrime p.asIdeal)) := by
      simpa [RingHom.algebraMap_toAlgebra] using
        (inferInstance : IsLocalHom (π.localRingHomAt p))
    -- Local instance justification (proof-local temporary data): supplies the established flatness of the localized algebra to the faithful-flatness theorem.
    letI : Module.Flat (π.sourceLocalRingAt p) (Localization.AtPrime p.asIdeal) := hlocalFlat
    have hff : (π.localRingHomAt p).FaithfullyFlat := by
      exact Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hinj : Function.Injective (π.localRingHomAt p) :=
      RingHom.FaithfullyFlat.injective (f := π.localRingHomAt p) hff
    rcases (Module.mem_support_iff' (R := R) (M := M) (p := p)).1 hp with ⟨m, hm⟩
    let z : π.sourceLocalRingAt p := algebraMap A (π.sourceLocalRingAt p) (TrivSqZeroExt.inr m)
    have hz0 : π.localRingHomAt p z = 0 := by
      calc
        π.localRingHomAt p z
            = algebraMap R (Localization.AtPrime p.asIdeal) (π (TrivSqZeroExt.inr m)) := by
                simpa [z, RingHom.localRingHomAt, RingHom.sourceLocalRingAt,
                  PrimeSpectrum.comap_asIdeal] using
                  (Localization.localRingHom_to_map
                    (PrimeSpectrum.comap π p).asIdeal p.asIdeal π rfl
                    (TrivSqZeroExt.inr m))
        _ = 0 := by
              simp [π]
    have hzne : z ≠ 0 := by
      intro hz
      dsimp [z] at hz
      rw [IsLocalization.map_eq_zero_iff (PrimeSpectrum.comap π p).asIdeal.primeCompl] at hz
      rcases hz with ⟨s, hsz⟩
      have hs : s.1 ∉ Ideal.comap π p.asIdeal := s.2
      have hsp : s.1.fst ∉ p.asIdeal := by
        change π s.1 ∉ p.asIdeal
        simpa [Ideal.mem_comap, π] using hs
      have hsnd : s.1.fst • m = 0 := by
        have hsnd0 :
            TrivSqZeroExt.snd (R := R) (M := M) (s.1 * TrivSqZeroExt.inr m) =
              TrivSqZeroExt.snd (R := R) (M := M) (0 : A) := by
          exact congrArg (TrivSqZeroExt.snd (R := R) (M := M)) hsz
        change s.1.fst • m + MulOpposite.op (0 : R) • s.1.snd = 0 at hsnd0
        simpa using hsnd0
      exact hm s.1.fst hsp hsnd
    exact hzne (hinj (by simpa using hz0))
  -- Any open neighborhood of the generic point contains a closed point `X - n`.
  have hclosedPointInOpen :
      ∀ {U : TopologicalSpace.Opens (PrimeSpectrum integerFiberRing)},
        (⊥ : PrimeSpectrum integerFiberRing) ∈ U →
        ∃ n : ℕ, integerFiberPrime n ∈ U := by
    intro U hηU
    have ⟨_, ⟨r, rfl⟩, hηr, hrU⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.isOpen_iff.mp U.2 _ hηU
    have hrne : r ≠ 0 := by
      change r ∉ (⊥ : PrimeSpectrum integerFiberRing).asIdeal at hηr
      intro hr0
      apply hηr
      change r = 0
      exact hr0
    rcases exists_nat_eval_ne_zero r hrne with ⟨n, hn⟩
    have hbasic : integerFiberPrime n ∈ PrimeSpectrum.basicOpen r := by
      change r ∉ (integerFiberPrime n : PrimeSpectrum integerFiberRing).asIdeal
      intro hrmem
      change r ∈
        Ideal.span ({Polynomial.X - Polynomial.C (n : ULift.{u} ℚ)} : Set integerFiberRing)
        at hrmem
      rcases Ideal.mem_span_singleton'.1 hrmem with ⟨a, ha⟩
      apply hn
      rw [← ha, Polynomial.eval_mul_X_sub_C]
    exact ⟨n, hrU hbasic⟩
  refine ⟨X, Y, f, (⊥ : PrimeSpectrum R), ?_, ?_⟩
  · exact hflatAt_of_notMemSupport hgenericNotSupport
  · intro hη
    rcases
      (CategoryTheory.MorphismProperty.mem_sourceLocus
        (@Flat : MorphismProperty Scheme.{u}) f (⊥ : PrimeSpectrum R)).1 hη with
      ⟨U, hηU, hUflat⟩
    have hηU' :
        (⊥ : PrimeSpectrum integerFiberRing) ∈
          (show TopologicalSpace.Opens (PrimeSpectrum integerFiberRing) from U) := hηU
    rcases
      hclosedPointInOpen
        (U := (show TopologicalSpace.Opens (PrimeSpectrum integerFiberRing) from U)) hηU' with
      ⟨n, hnU⟩
    let xn : U.toScheme := ⟨integerFiberPrime n, hnU⟩
    have hUflatResComp : Flat (f.resLE ⊤ U (by simp) ≫ Y.topIso.hom) := by
      simpa using hUflat
    have hUflatRes : Flat (f.resLE ⊤ U (by simp)) :=
      (CategoryTheory.MorphismProperty.cancel_right_of_respectsIso
        (@Flat : MorphismProperty Scheme.{u})
        (f.resLE ⊤ U (by simp)) Y.topIso.hom).mp hUflatResComp
    have hxnFlatRes : (f.resLE ⊤ U (by simp)).flatAt xn :=
      (Scheme.Hom.flat_iff_forall_flatAt (f.resLE ⊤ U (by simp))).1 hUflatRes xn
    have hxnFlat : f.flatAt (integerFiberPrime n) := by
      exact
        (RingHom.Flat.respectsIso.arrow_mk_iso_iff
          (Scheme.Hom.resLEStalkMap (f := f) (U := ⊤) (V := U) (e := by simp) xn)).1 hxnFlatRes
    exact hnotFlatAt_of_memSupport (integerFiberModule_mem_support_closedPoint n) hxnFlat

end

end AlgebraicGeometry.Scheme.Hom
