module

public import Mathlib.CategoryTheory.Sites.Pretopology
public import Mathlib.CategoryTheory.Sites.Sheaf
public import ReasLib.CategoryTheory.Sites.Precoverage.Tautological

/-!
# Comparisons of pretopology presentations

These are source-facing bridges from comparisons of covering families and
refinements of pretopologies to the canonical Grothendieck-topology and sheaf
predicates.  The underlying Galois insertion remains owned by Mathlib.
-/

@[expose] public section

universe w v u

namespace CategoryTheory
namespace Pretopology

open Limits

variable {C : Type u} [Category.{v} C] [HasPullbacks C]

/-- Tautological replacement of every covering family induces an inclusion of
the Grothendieck topologies generated by two pretopologies. -/
theorem toGrothendieck_le_of_tautological_covers
    {K L : Pretopology C}
    (h : K.toPrecoverage.coversUpToTautologicalEquivalence L.toPrecoverage) :
    K.toGrothendieck ≤ L.toGrothendieck := sorry

/-- A sheaf for `L` is a sheaf for `K` when each `K`-covering family has a
tautologically equivalent `L`-covering family. -/
theorem isSheaf_of_tautological_covers
    {K L : Pretopology C} {P : Cᵒᵖ ⥤ Type w}
    (h : K.toPrecoverage.coversUpToTautologicalEquivalence L.toPrecoverage)
    (hP : Presheaf.IsSheaf L.toGrothendieck P) :
    Presheaf.IsSheaf K.toGrothendieck P := sorry

/-- Mutual tautological replacement of pretopology covering families gives
equivalent set-valued sheaf conditions. -/
theorem isSheaf_iff_of_mutual_tautological_covers
    {K L : Pretopology C} {P : Cᵒᵖ ⥤ Type w}
    (hKL : K.toPrecoverage.coversUpToTautologicalEquivalence L.toPrecoverage)
    (hLK : L.toPrecoverage.coversUpToTautologicalEquivalence K.toPrecoverage) :
    Presheaf.IsSheaf K.toGrothendieck P ↔
      Presheaf.IsSheaf L.toGrothendieck P := sorry

/-- A refinement of a pretopology by covers for the topology generated by
another pretopology induces an inclusion of generated topologies. -/
theorem toGrothendieck_le_of_refinement
    {K L : Pretopology C} (h : K ≤ L.toGrothendieck.toPretopology) :
    K.toGrothendieck ≤ L.toGrothendieck := sorry

/-- A sheaf for `L` is a sheaf for `K` under the usual pretopology refinement
condition. -/
theorem isSheaf_of_refinement
    {K L : Pretopology C} {P : Cᵒᵖ ⥤ Type w}
    (h : K ≤ L.toGrothendieck.toPretopology)
    (hP : Presheaf.IsSheaf L.toGrothendieck P) :
    Presheaf.IsSheaf K.toGrothendieck P := sorry

/-- Mutual refinement of two pretopologies gives equivalent set-valued sheaf
conditions. -/
theorem isSheaf_iff_of_mutual_refinement
    {K L : Pretopology C} {P : Cᵒᵖ ⥤ Type w}
    (hKL : K ≤ L.toGrothendieck.toPretopology)
    (hLK : L ≤ K.toGrothendieck.toPretopology) :
    Presheaf.IsSheaf K.toGrothendieck P ↔
      Presheaf.IsSheaf L.toGrothendieck P := sorry

end Pretopology
end CategoryTheory
