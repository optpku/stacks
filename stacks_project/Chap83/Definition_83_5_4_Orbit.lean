module

public import Mathlib.Logic.Relation
public import stacks_project.Chap78.Definition_78_4_1_PreRelation
public import stacks_project.Chap66.Definition_66_19_1_GeometricPoint

/-!
# Geometric orbits of a pre-relation

This module records weak and ordinary equivalence of slice points of a pre-relation, together
with the corresponding orbit sets. Images of geometric `k`-points in an overfield are formed by
precomposition with the slice morphism of a field-valued factorization.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry AlgebraicSpace

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.FieldValuedPoint.Factorization

/-- The morphism of slices `Over.mk p.hom ⟶ Over.mk q.hom` induced by a factorization of
field-valued points. -/
def sliceHom {S : Scheme.{u}} {X : AlgebraicSpace S} {p q : FieldValuedPoint X}
    (φ : Factorization p q) : Over.mk p.hom ⟶ Over.mk q.hom :=
  Over.homMk (ofOverHomMk φ.schemeHom φ.fac_structure) φ.fac_hom

/-- The underlying morphism of algebraic spaces of `sliceHom φ` is `ofOverHomMk` of the scheme
map. -/
theorem sliceHom_left {S : Scheme.{u}} {X : AlgebraicSpace S} {p q : FieldValuedPoint X}
    (φ : Factorization p q) :
    (sliceHom φ).left = ofOverHomMk φ.schemeHom φ.fac_structure :=
  sorry

end AlgebraicGeometry.AlgebraicSpace.FieldValuedPoint.Factorization

namespace AlgebraicGeometry.AlgebraicSpace.PreRelation

/-- Two `T`-valued points of `U` are weakly equivalent for a pre-relation if they lie in the same
class of the equivalence relation generated by the image of `j` on `T`-points. -/
def weaklyEquivalent {S : Scheme.{u}} {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) (T : Over B) (x y : T ⟶ U) : Prop :=
  _root_.Relation.EqvGen (P.pointRel T) x y

/-- Weak equivalence is the generated equivalence relation of `pointRel`. -/
theorem weaklyEquivalent_iff {S : Scheme.{u}} {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) (T : Over B) (x y : T ⟶ U) :
    weaklyEquivalent P T x y ↔ _root_.Relation.EqvGen (P.pointRel T) x y :=
  sorry

/-- Weak equivalence is an equivalence relation on `T`-valued points of `U`. -/
theorem weaklyEquivalent_equivalence {S : Scheme.{u}} {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) (T : Over B) :
    Equivalence (weaklyEquivalent P T) :=
  sorry

/-- Two geometric `k`-points of `U` are equivalent for a pre-relation if their images in `U(Ω)`
are weakly equivalent for some field-valued overpoint of the geometric point. -/
def orbitEquivalent {S : Scheme.{u}} {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) (b : GeometricPoint B) (x y : Over.mk b.hom ⟶ U) : Prop :=
  ∃ (q : FieldValuedPoint B) (φ : FieldValuedPoint.Factorization q b.toFieldValuedPoint),
    weaklyEquivalent P (Over.mk q.hom) (φ.sliceHom ≫ x) (φ.sliceHom ≫ y)

/-- `R`-equivalence of geometric `k`-points is weak equivalence of their images after some
field-valued factorization. -/
theorem orbitEquivalent_iff {S : Scheme.{u}} {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) (b : GeometricPoint B) (x y : Over.mk b.hom ⟶ U) :
    orbitEquivalent P b x y ↔
      ∃ (q : FieldValuedPoint B) (φ : FieldValuedPoint.Factorization q b.toFieldValuedPoint),
        weaklyEquivalent P (Over.mk q.hom) (φ.sliceHom ≫ x) (φ.sliceHom ≫ y) :=
  sorry

/-- The weak orbit of a `T`-valued point is the set of `T`-valued points weakly equivalent to
it. -/
def weakOrbit {S : Scheme.{u}} {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) (T : Over B) (x : T ⟶ U) : Set (T ⟶ U) :=
  {y | weaklyEquivalent P T x y}

/-- Membership in a weak orbit is weak equivalence with the given point. -/
theorem mem_weakOrbit {S : Scheme.{u}} {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) (T : Over B) (x y : T ⟶ U) :
    y ∈ weakOrbit P T x ↔ weaklyEquivalent P T x y :=
  sorry

/-- The orbit of a geometric `k`-point of `U` is the set of geometric `k`-points equivalent to it
after passage to some overfield. -/
def orbit {S : Scheme.{u}} {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) (b : GeometricPoint B) (x : Over.mk b.hom ⟶ U) :
    Set (Over.mk b.hom ⟶ U) :=
  {y | orbitEquivalent P b x y}

/-- Membership in an orbit is `R`-equivalence with the given geometric `k`-point. -/
theorem mem_orbit {S : Scheme.{u}} {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) (b : GeometricPoint B) (x y : Over.mk b.hom ⟶ U) :
    y ∈ orbit P b x ↔ orbitEquivalent P b x y :=
  sorry

/-- Weak equivalence of geometric `k`-points implies `R`-equivalence. -/
theorem weaklyEquivalent_imp_orbitEquivalent {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) (b : GeometricPoint B) (x y : Over.mk b.hom ⟶ U) :
    weaklyEquivalent P (Over.mk b.hom) x y → orbitEquivalent P b x y :=
  sorry

end AlgebraicGeometry.AlgebraicSpace.PreRelation
