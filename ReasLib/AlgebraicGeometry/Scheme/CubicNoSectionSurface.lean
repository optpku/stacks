module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.AlgebraicGeometry.Restrict
public import Mathlib.Data.Complex.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations

@[expose] public section

open AlgebraicGeometry CategoryTheory MvPolynomial

noncomputable section

namespace AlgebraicGeometry.CubicNoSectionSurface

/-- The coordinate ring of the affine plane `Spec ℂ[s, t]`. -/
abbrev BaseRing : Type :=
  MvPolynomial (Fin 2) ℂ

/-- The first indeterminate of the two-variable polynomial ring over `ℂ`. -/
def s : BaseRing :=
  X 0

/-- The second indeterminate of the two-variable polynomial ring over `ℂ`. -/
def t : BaseRing :=
  X 1

/-- The diagonal cubic polynomial in eight variables with constant term `1` and
coefficients `s`, `s ^ 2`, `t`, `s * t`, `s ^ 2 * t`, `t ^ 2`, `s * t ^ 2`,
and `s ^ 2 * t ^ 2`, respectively. -/
def definingPolynomial : MvPolynomial (Fin 8) BaseRing :=
  1 + C s * X 0 ^ 3 + C (s ^ 2) * X 1 ^ 3 + C t * X 2 ^ 3 +
    C (s * t) * X 3 ^ 3 + C (s ^ 2 * t) * X 4 ^ 3 + C (t ^ 2) * X 5 ^ 3 +
    C (s * t ^ 2) * X 6 ^ 3 + C (s ^ 2 * t ^ 2) * X 7 ^ 3

/-- The principal ideal generated by `definingPolynomial`. -/
def coordinateIdeal : Ideal (MvPolynomial (Fin 8) BaseRing) :=
  Ideal.span {definingPolynomial}

/-- The coordinate ring of the diagonal cubic hypersurface over `ℂ[s, t]`. -/
abbrev coordinateRing : Type :=
  MvPolynomial (Fin 8) BaseRing ⧸ coordinateIdeal

/-- The affine plane `Spec ℂ[s, t]`. -/
abbrev base : Scheme :=
  Spec (CommRingCat.of BaseRing)

/-- The affine diagonal cubic hypersurface `Spec coordinateRing`. -/
abbrev totalSpace : Scheme :=
  Spec (CommRingCat.of coordinateRing)

/-- The projection to the affine plane induced by `algebraMap BaseRing coordinateRing`. -/
def π : totalSpace ⟶ base :=
  Spec.map (CommRingCat.ofHom (algebraMap BaseRing coordinateRing))

/-- No nonempty open of `base` admits a section of the projection `π`. -/
theorem not_exists_nonempty_open_section :
    ¬ ∃ (U : base.Opens), Nonempty U ∧ ∃ σ : U.toScheme ⟶ totalSpace, σ ≫ π = U.ι := sorry

end AlgebraicGeometry.CubicNoSectionSurface
