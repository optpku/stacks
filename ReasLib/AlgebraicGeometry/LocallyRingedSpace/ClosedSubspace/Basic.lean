module

public import ReasLib.AlgebraicGeometry.LocallyRingedSpace.ClosedImmersion
public import ReasLib.AlgebraicGeometry.LocallyRingedSpace.IdealSubobject.LocalGeneration

/-!
# Closed subspaces associated to ideal subobjects

The association predicate uses an explicit ideal input and explicit evidence.
It is deliberately not a typeclass: the chosen representative of an ideal
subobject is mathematical data, not a canonical instance-search output.
-/

@[expose] public section

open CategoryTheory
open AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.LocallyRingedSpace

namespace ClosedSubspace

/-- A morphism `i : Z ⟶ X` exhibits `Z` as a closed subspace associated to `I`
when it is a closed immersion with kernel ideal subobject `I`. -/
@[stacks 01HN "associated closed subspace predicate"]
structure IsAssociated
    {X Z : LocallyRingedSpace.{u}} (i : Z ⟶ X) (I : IdealSubobject X) : Prop
    extends IsClosedImmersion i where
  /-- The kernel ideal of the closed immersion is the specified ideal subobject. -/
  ideal_eq : Hom.kernelIdealSubobject i = I

end ClosedSubspace

/-- Every closed immersion is associated to its own kernel ideal subobject. -/
@[stacks 01HN "closed immersion canonical associated ideal"]
theorem IsClosedImmersion.isAssociated_kernelIdeal
    {X Z : LocallyRingedSpace.{u}} {i : Z ⟶ X} (hi : IsClosedImmersion i) :
    ClosedSubspace.IsAssociated i (Hom.kernelIdealSubobject i) := sorry

namespace ClosedSubspace

/-- Closed-immersion and kernel-identification data construct an associated closed subspace. -/
def IsAssociated.ofConditions
    {X Z : LocallyRingedSpace.{u}} {i : Z ⟶ X} {I : IdealSubobject X}
    (hclosed : IsClosedImmersion i)
    (hideal : Hom.kernelIdealSubobject i = I) :
    IsAssociated i I :=
  ⟨hclosed, hideal⟩

/-- The explicit canonical isomorphism from the kernel ideal sheaf of an associated closed
subspace to the module represented by its specified ideal subobject. -/
@[stacks 01HN "associated ideal sheaf isomorphism"]
noncomputable def IsAssociated.idealSheafIso
    {X Z : LocallyRingedSpace.{u}} {i : Z ⟶ X} {I : IdealSubobject X}
    (hi : IsAssociated i I) :
    Hom.kernelIdealSheaf i ≅ I.toModule :=
  (RingedSpace.Hom.kernelIdealIso i.toShHom).symm ≪≫
    Subobject.underlying.mapIso (eqToIso hi.ideal_eq)

/-- The ideal associated to a closed subspace is locally generated by sections. -/
@[stacks 01HN "associated ideal local generation"]
theorem IsAssociated.ideal_isLocallyGenerated
    {X Z : LocallyRingedSpace.{u}} {i : Z ⟶ X} {I : IdealSubobject X}
    (hi : IsAssociated i I) :
    I.IsLocallyGeneratedBySections := sorry

/-- The defining ideal of an associated closed subspace lies in the kernel ideal of its
inclusion. -/
@[stacks 01HN "associated ideal kernel containment"]
theorem IsAssociated.le_kernel
    {X Z : LocallyRingedSpace.{u}} {i : Z ⟶ X} {I : IdealSubobject X}
    (hi : IsAssociated i I) :
    I ≤ Hom.kernelIdealSubobject i := sorry

/-- Characterization of a closed subspace associated to an ideal subobject. -/
@[stacks 01HN "associated closed subspace characterization"]
theorem isAssociated_iff
    {X Z : LocallyRingedSpace.{u}} {i : Z ⟶ X} {I : IdealSubobject X} :
    IsAssociated i I ↔
      IsClosedImmersion i ∧ Hom.kernelIdealSubobject i = I := sorry

/-- Closed-embedding, quotient, local-generation, and kernel-identification data construct an
associated closed subspace. -/
@[stacks 01HN "associated closed subspace constructor"]
theorem IsAssociated.of_spec
    {X Z : LocallyRingedSpace.{u}} {i : Z ⟶ X} {I : IdealSubobject X}
    (hclosed : Topology.IsClosedEmbedding i.base)
    (hsurj : Sheaf.IsLocallySurjective (Hom.commRingSheafPushforwardMap i))
    (hgen : I.IsLocallyGeneratedBySections)
    (hideal : Hom.kernelIdealSubobject i = I) :
    IsAssociated i I := sorry

/-- A closed subspace is associated to `I` exactly when its underlying map is a closed
embedding, its structure-sheaf map is locally surjective, and its locally generated kernel is
`I`. -/
@[stacks 01HN]
theorem isAssociated_iff_spec
    {X Z : LocallyRingedSpace.{u}} {i : Z ⟶ X} {I : IdealSubobject X} :
    IsAssociated i I ↔
      Topology.IsClosedEmbedding i.base ∧
        Sheaf.IsLocallySurjective (Hom.commRingSheafPushforwardMap i) ∧
          I.IsLocallyGeneratedBySections ∧ Hom.kernelIdealSubobject i = I := sorry

/-- The full defining specification supplied by an associated closed subspace. -/
@[stacks 01HN "specification"]
theorem IsAssociated.spec
    {X Z : LocallyRingedSpace.{u}} {i : Z ⟶ X} {I : IdealSubobject X}
    (hi : IsAssociated i I) :
    Topology.IsClosedEmbedding i.base ∧
      Sheaf.IsLocallySurjective (Hom.commRingSheafPushforwardMap i) ∧
        I.IsLocallyGeneratedBySections ∧ Hom.kernelIdealSubobject i = I := sorry

end ClosedSubspace

end AlgebraicGeometry.LocallyRingedSpace
