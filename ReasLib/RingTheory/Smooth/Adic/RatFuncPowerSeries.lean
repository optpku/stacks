/-!
# Positive-Characteristic Adic Smoothness Examples

This file owns the two examples from Example 15.40.2.  The first is the localization of the
hypersurface `y ^ p - a - x = 0` at the closed point generated by `x` and `y ^ p - a`.  The second
is the map from a rational-function field to a power series ring which sends the rational-function
variable to its coefficient-field image plus the power-series variable.

@stack 07EM
-/

@[expose] public section

noncomputable section

open IsLocalRing

universe u

namespace PurelyInseparableSmoothLocal

variable {p : ℕ} [Fact p.Prime]

/-- The two-variable polynomial ring used in the first example of Example 15.40.2. -/
@[stacks 07EM "hypersurface polynomial ring"]
abbrev PolynomialRing (k : Type u) [Field k] := MvPolynomial (Fin 2) k

/-- The equation `y ^ p - a - x` defining the smooth hypersurface in Example 15.40.2. -/
@[stacks 07EM "hypersurface relation"]
def relation (k : Type u) [Field k] (a : k) : PolynomialRing k :=
  MvPolynomial.X (1 : Fin 2) ^ p - MvPolynomial.C a - MvPolynomial.X (0 : Fin 2)

/-- The principal ideal generated by `y ^ p - a - x`. -/
@[stacks 07EM "hypersurface relation ideal"]
def relationIdeal (k : Type u) [Field k] (a : k) : Ideal (PolynomialRing k) :=
  Ideal.span {relation (p := p) k a}

/-- The hypersurface `k[x, y] / (y ^ p - a - x)`. -/
@[stacks 07EM "explicit smooth hypersurface"]
abbrev Hypersurface (k : Type u) [Field k] (a : k) :=
  PolynomialRing k ⧸ relationIdeal (p := p) k a

/-- The ideal generated by the images of `x` and `y ^ p - a` on the hypersurface. -/
@[stacks 07EM "hypersurface closed point ideal"]
def closedPointIdeal (k : Type u) [Field k] (a : k) :
    Ideal (Hypersurface (p := p) k a) :=
  Ideal.span {
    Ideal.Quotient.mk (relationIdeal (p := p) k a) (MvPolynomial.X (0 : Fin 2)),
    Ideal.Quotient.mk (relationIdeal (p := p) k a)
      (MvPolynomial.X (1 : Fin 2) ^ p - MvPolynomial.C a)}

/-- The canonical multiplicative set defining localization at the source closed point.  It is the
preimage of the non-zero-divisors of the closed-point quotient, so its definition does not choose
a proof that the closed-point ideal is prime. -/
@[stacks 07EM "hypersurface localizing submonoid"]
def localSubmonoid (k : Type u) [Field k] (a : k) :
    Submonoid (Hypersurface (p := p) k a) :=
  Submonoid.comap (Ideal.Quotient.mk (closedPointIdeal (p := p) k a))
    (nonZeroDivisors
      (Hypersurface (p := p) k a ⧸ closedPointIdeal (p := p) k a))

/-- The explicit local hypersurface
`k[x, y]_(x, y ^ p - a) / (y ^ p - a - x)` from Example 15.40.2. -/
@[stacks 07EM "explicit smooth local hypersurface"]
abbrev Ring (k : Type u) [Field k] (a : k) :=
  Localization (localSubmonoid (p := p) k a)

/-- Example 15.40.2 (1): the explicit hypersurface localization is a local ring when `a` is not
a `p`-th power. -/
@[stacks 07EM "Example 15.40.2 (1): local hypersurface"]
theorem isLocalRing (k : Type u) [Field k] [CharP k p] (a : k)
    (ha : a ∉ Set.range (fun b : k ↦ b ^ p)) :
    IsLocalRing (Ring (p := p) k a) := sorry

/-- Example 15.40.2 (2): the map from `k` to the explicit hypersurface localization is smooth. -/
@[stacks 07EM "Example 15.40.2 (2): smooth hypersurface localization"]
theorem smooth (k : Type u) [Field k] [CharP k p] (a : k)
    (ha : a ∉ Set.range (fun b : k ↦ b ^ p)) :
    Algebra.Smooth k (Ring (p := p) k a) := sorry

/-- Example 15.40.2 (3): the explicit local hypersurface is geometrically regular over `k`. -/
@[stacks 07EM "Example 15.40.2 (3): geometrically regular local hypersurface"]
theorem isGeometricallyRegular (k : Type u) [Field k] [CharP k p] (a : k)
    (ha : a ∉ Set.range (fun b : k ↦ b ^ p)) :
    Algebra.IsGeometricallyRegular k (Ring (p := p) k a) := sorry

/-- Example 15.40.2 (4): the residue field of the explicit local hypersurface is purely
inseparable over `k`. -/
@[stacks 07EM "Example 15.40.2 (4): purely inseparable residue field"]
theorem residueField_isPurelyInseparable (k : Type u) [Field k] [CharP k p] (a : k)
    (ha : a ∉ Set.range (fun b : k ↦ b ^ p)) :
    letI : IsLocalRing (Ring (p := p) k a) := isLocalRing (p := p) k a ha
    IsPurelyInseparable k (ResidueField (Ring (p := p) k a)) := sorry

/-- Example 15.40.2 (5): the map to the explicit local hypersurface is formally smooth for its
maximal-ideal-adic topology. -/
@[stacks 07EM "Example 15.40.2 (5): adic formal smoothness of the local hypersurface"]
theorem formallySmoothForAdic (k : Type u) [Field k] [CharP k p] (a : k)
    (ha : a ∉ Set.range (fun b : k ↦ b ^ p)) :
    -- Local instance justification (defeq pin): use the commutative-ring structure underlying the
    -- Ore localization so the maximal ideal and the algebra map use the same semiring model.
    letI : CommRing (Ring (p := p) k a) := OreLocalization.instCommRing
    -- Local instance justification (proof-local temporary data): the preceding source clause
    -- supplies the local-ring structure needed to name the maximal ideal.
    letI : IsLocalRing (Ring (p := p) k a) := isLocalRing (p := p) k a ha
    (algebraMap k (Ring (p := p) k a)).formally_smooth_for_adic
      (maximalIdeal (Ring (p := p) k a)) := sorry

end PurelyInseparableSmoothLocal

namespace RatFunc.PowerSeriesShift

variable {p : ℕ} [Fact p.Prime]

/-- The polynomial substitution which sends the variable to `C(t) + X`, where `t` is the image
of the rational-function generator in `K`. -/
@[stacks 07EM "power-series shift polynomial map"]
noncomputable def polynomialMap (K : Type u) [Field K]
    [Algebra (RatFunc (ZMod p)) K] :
    Polynomial (ZMod p) →+* PowerSeries K :=
  Polynomial.eval₂RingHom
    ((PowerSeries.C : K →+* PowerSeries K).comp
      ((algebraMap (RatFunc (ZMod p)) K).comp
        (algebraMap (ZMod p) (RatFunc (ZMod p)))))
    (PowerSeries.C (algebraMap (RatFunc (ZMod p)) K RatFunc.X) + PowerSeries.X)

/-- Every nonzero polynomial denominator maps to a unit under the shifted substitution. -/
@[stacks 07EM "power-series shift denominators are units"]
theorem polynomialMap_isUnit (K : Type u) [Field K]
    [Algebra (RatFunc (ZMod p)) K]
    (q : nonZeroDivisors (Polynomial (ZMod p))) :
    IsUnit (polynomialMap (p := p) K (q : Polynomial (ZMod p))) := sorry

/-- The localization lift `RatFunc (ZMod p) →+* PowerSeries K` which sends the
rational-function variable to its coefficient-field image plus the power-series variable. -/
@[stacks 07EM "power-series shift map"]
noncomputable def map (K : Type u) [Field K]
    [Algebra (RatFunc (ZMod p)) K] :
    RatFunc (ZMod p) →+* PowerSeries K :=
  IsLocalization.lift (R := Polynomial (ZMod p))
    (M := nonZeroDivisors (Polynomial (ZMod p))) (S := RatFunc (ZMod p))
    (g := polynomialMap (p := p) K) (polynomialMap_isUnit (p := p) K)

/-- The shifted localization map sends the rational-function generator to `C(t) + X`. -/
@[simp, stacks 07EM "power-series shift on the generator"]
theorem map_X (K : Type u) [Field K] [Algebra (RatFunc (ZMod p)) K] :
    map (p := p) K RatFunc.X =
      PowerSeries.C (algebraMap (RatFunc (ZMod p)) K RatFunc.X) + PowerSeries.X := sorry

/-- Example 15.40.2 (6): if `K` is a perfect closure of `RatFunc (ZMod p)`, the shifted map
`RatFunc (ZMod p) →+* PowerSeries K` sending `s` to `t + x` is formally smooth for the
maximal-ideal-adic topology. -/
@[stacks 07EM "Example 15.40.2 (6): rational-function shift"]
theorem formallySmoothForAdic (K : Type u) [Field K] [ExpChar K p] [PerfectRing K p]
    [Algebra (RatFunc (ZMod p)) K]
    [IsPerfectClosure (algebraMap (RatFunc (ZMod p)) K) p] :
    (map (p := p) K).formally_smooth_for_adic
      (maximalIdeal (PowerSeries K)) := sorry

end RatFunc.PowerSeriesShift
