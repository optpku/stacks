module

public import Mathlib.Algebra.Category.Ring.Adjunctions
public import Mathlib.CategoryTheory.Comma.Over.Pullback
public import Mathlib.CategoryTheory.Sites.Adjunction
public import Mathlib.CategoryTheory.Sites.LocallySurjective
public import Mathlib.CategoryTheory.Sites.Limits
import Mathlib.Tactic.CrossRefAttribute

/-!
# Free commutative algebras in sheaves

This file owns the site-level free commutative ring and free commutative algebra constructions.
Topological stalk comparisons belong in the downstream `FreeAlgebra.Stalk` leaf.
-/

@[expose] public section

open CategoryTheory

noncomputable section

universe c v w

namespace CategoryTheory.Sheaf.FreeCommRing

variable {C : Type c} [Category.{v} C] {J : GrothendieckTopology C}
variable [HasWeakSheafify J CommRingCat.{w}]

/-- The free commutative ring sheaf generated by a sheaf of sets on an arbitrary site. -/
@[stacks 08TU "free commutative ring sheaf"]
noncomputable abbrev obj (E : Sheaf J (Type (w))) :
    Sheaf J CommRingCat.{w} :=
  (CategoryTheory.Sheaf.composeAndSheafify J CommRingCat.free).obj E

/-- The universal generator of the free commutative ring sheaf on an arbitrary site. -/
@[stacks 08TU "free commutative ring sheaf generator"]
noncomputable abbrev generator (E : Sheaf J (Type (w))) :
    E ⟶ (CategoryTheory.sheafForget J).obj (obj E) :=
  (CategoryTheory.Sheaf.adjunction J CommRingCat.adj).unit.app E

end CategoryTheory.Sheaf.FreeCommRing

namespace CategoryTheory.Sheaf.FreeAlgebra

variable {C : Type c} [Category.{v} C] {J : GrothendieckTopology C}
variable [HasWeakSheafify J CommRingCat.{w}]

/-- The free commutative algebra sheaf over a ring sheaf, generated by a sheaf of sets. -/
@[stacks 08TU "free commutative algebra sheaf"]
noncomputable abbrev obj
    (A : Sheaf J CommRingCat.{w}) (E : Sheaf J (Type (w))) : Under A :=
  (Under.costar A).obj (CategoryTheory.Sheaf.FreeCommRing.obj E)

/-- The underlying commutative ring sheaf of a free commutative algebra sheaf. -/
noncomputable abbrev underlying
    (A : Sheaf J CommRingCat.{w}) (E : Sheaf J (Type (w))) :
    Sheaf J CommRingCat.{w} :=
  (obj A E).right

scoped[CategoryTheory.Sheaf.FreeAlgebra] notation:max A:max "[" E "]" =>
  CategoryTheory.Sheaf.FreeAlgebra.underlying A E

/-- The structural morphism from the base ring sheaf to its free algebra sheaf. -/
@[stacks 08TU "free commutative algebra base map"]
noncomputable abbrev base
    (A : Sheaf J CommRingCat.{w}) (E : Sheaf J (Type (w))) :
    A ⟶ underlying A E :=
  (obj A E).hom

/-- The canonical inclusion of the free ring sheaf into the underlying free algebra sheaf. -/
noncomputable abbrev freeMap
    (A : Sheaf J CommRingCat.{w}) (E : Sheaf J (Type (w))) :
    CategoryTheory.Sheaf.FreeCommRing.obj E ⟶ underlying A E :=
  (Under.costarAdjForget A).unit.app (CategoryTheory.Sheaf.FreeCommRing.obj E)

/-- The universal generator map of a free commutative algebra sheaf. -/
@[stacks 08TU "free commutative algebra sheaf generator"]
noncomputable def generator
    (A : Sheaf J CommRingCat.{w}) (E : Sheaf J (Type (w))) :
    E ⟶ (CategoryTheory.sheafForget J).obj (underlying A E) :=
  CategoryTheory.Sheaf.FreeCommRing.generator E ≫
    (CategoryTheory.sheafForget J).map (freeMap A E)

/-- Evaluation of a free commutative algebra sheaf at a base map and generator assignment. -/
@[stacks 08TU "free commutative algebra evaluation"]
noncomputable def evaluation
    {A : Sheaf J CommRingCat.{w}} (B : Under A)
    (E : Sheaf J (Type (w)))
    (assign : E ⟶ (CategoryTheory.sheafForget J).obj B.right) :
    obj A E ⟶ B :=
  ((Under.costarAdjForget A).homEquiv _ _).symm
    (((CategoryTheory.Sheaf.adjunction J CommRingCat.adj).homEquiv _ _).symm assign)

/-- Evaluation of a free commutative algebra sheaf extends the prescribed base morphism. -/
@[stacks 08TU "free commutative algebra evaluation on the base"]
theorem evaluation_base
    {A : Sheaf J CommRingCat.{w}} (B : Under A)
    (E : Sheaf J (Type (w)))
    (assign : E ⟶ (CategoryTheory.sheafForget J).obj B.right) :
    base A E ≫ (evaluation B E assign).right = B.hom := sorry

/-- Evaluation of a free commutative algebra sheaf extends the prescribed generator assignment. -/
@[stacks 08TU "free commutative algebra evaluation on generators"]
theorem evaluation_generator
    {A : Sheaf J CommRingCat.{w}} (B : Under A)
    (E : Sheaf J (Type (w)))
    (assign : E ⟶ (CategoryTheory.sheafForget J).obj B.right) :
    generator A E ≫
        (CategoryTheory.sheafForget J).map (evaluation B E assign).right =
      assign := sorry

/-- Evaluation of a free algebra is locally surjective whenever its generator assignment is
locally surjective. -/
instance evaluation_isLocallySurjective
    {A : Sheaf J CommRingCat.{w}} (B : Under A)
    (E : Sheaf J (Type (w)))
    (assign : E ⟶ (CategoryTheory.sheafForget J).obj B.right)
    [Sheaf.IsLocallySurjective assign] :
    Sheaf.IsLocallySurjective (evaluation B E assign).right := sorry

/-- Morphisms from a free commutative algebra sheaf are determined by their values on the
generators. -/
@[ext]
theorem hom_ext
    {A : Sheaf J CommRingCat.{w}} {B : Under A}
    {E : Sheaf J (Type (w))}
    (f g : obj A E ⟶ B)
    (h : generator A E ≫ (CategoryTheory.sheafForget J).map f.right =
      generator A E ≫ (CategoryTheory.sheafForget J).map g.right) :
    f = g := sorry

namespace Presentation

/-- The sheaf of formal generators used by the canonical polynomial presentation of an algebra
sheaf. -/
noncomputable abbrev generators
    {A : Sheaf J CommRingCat.{w}} (B : Under A) :
    Sheaf J (Type (w)) :=
  (CategoryTheory.sheafForget J).obj B.right

/-- The canonical polynomial presentation of an algebra sheaf, bundled under its base. -/
@[stacks 08TU "canonical presentation object"]
noncomputable abbrev obj
    (A : Sheaf J CommRingCat.{w}) (B : Under A) : Under A :=
  FreeAlgebra.obj A (generators B)

/-- The underlying ring sheaf of the canonical polynomial presentation. -/
noncomputable abbrev underlying
    (A : Sheaf J CommRingCat.{w}) (B : Under A) :
    Sheaf J CommRingCat.{w} :=
  (obj A B).right

scoped[CategoryTheory.Sheaf.FreeAlgebra] notation:max A:max "[" B "]" =>
  CategoryTheory.Sheaf.FreeAlgebra.Presentation.underlying A B

/-- The coefficient map into the canonical polynomial presentation. -/
noncomputable abbrev base
    (A : Sheaf J CommRingCat.{w}) (B : Under A) : A ⟶ underlying A B :=
  (obj A B).hom

/-- The canonical polynomial presentation as a morphism of algebras over the base sheaf. -/
@[stacks 08TH "canonical presentation morphism",
  stacks 08TU "canonical presentation morphism"]
noncomputable abbrev hom
    (A : Sheaf J CommRingCat.{w}) (B : Under A) : obj A B ⟶ B :=
  FreeAlgebra.evaluation B (generators B) (𝟙 _)

/-- The evaluation map from the canonical polynomial presentation to the presented ring sheaf. -/
@[stacks 08TH, stacks 08TU]
noncomputable abbrev map
    (A : Sheaf J CommRingCat.{w}) (B : Under A) : underlying A B ⟶ B.right :=
  (hom A B).right

/-- The bracket map into the canonical polynomial presentation. -/
@[stacks 08TU "bracket map"]
noncomputable abbrev generator
    (A : Sheaf J CommRingCat.{w}) (B : Under A) :
    generators B ⟶ (CategoryTheory.sheafForget J).obj (underlying A B) :=
  FreeAlgebra.generator A (generators B)

/-- Evaluating a bracket generator gives the section that labels it. -/
@[simp, stacks 08TH "evaluation", stacks 08TU "evaluation"]
theorem generator_map
    (A : Sheaf J CommRingCat.{w}) (B : Under A) :
    generator A B ≫ (CategoryTheory.sheafForget J).map (map A B) =
      𝟙 (generators B) := sorry

/-- Evaluation after the coefficient map recovers the algebra structure map. -/
@[simp, stacks 08TU "coefficient evaluation"]
theorem base_map
    (A : Sheaf J CommRingCat.{w}) (B : Under A) :
    base A B ≫ map A B = B.hom := sorry

/-- The canonical polynomial presentation map is locally surjective. -/
@[stacks 08TU "canonical presentation is locally surjective"]
instance map_isLocallySurjective
    (A : Sheaf J CommRingCat.{w}) (B : Under A) :
    Sheaf.IsLocallySurjective (map A B) := sorry

end Presentation

end CategoryTheory.Sheaf.FreeAlgebra
