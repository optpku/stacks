module

public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Cover.Fppf

/-!
# Fppf topology on algebraic spaces

The fppf Grothendieck topology on algebraic spaces over a scheme `S` is the
topology generated by the fppf precoverage.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry

universe u

namespace AlgebraicGeometry.AlgebraicSpace

/-- The fppf Grothendieck topology on algebraic spaces over `S`. -/
abbrev fppfTopology (S : Scheme.{u}) : GrothendieckTopology (AlgebraicSpace S) :=
  (fppfPrecoverage S).toGrothendieck

end AlgebraicGeometry.AlgebraicSpace
