module

public import ReasLib.CategoryTheory.Abelian.GrothendieckGroup
public import ReasLib.CategoryTheory.Homology.SpectralSequence.Bounded
public import ReasLib.CategoryTheory.ObjectProperty.WeakSerre

/-!
# Euler Characteristics of Cohomological Spectral Sequences

This module owns support, weak-Serre closure, and Euler-characteristic constructions for a page
of an arbitrary cohomological spectral sequence.  Filtered-complex comparisons belong in the
filtered-complex layer.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits CategoryTheory.ObjectProperty

noncomputable section

universe v u

namespace CategoryTheory

variable {C : Type u} [Category.{v} C] [Abelian C] {r₀ : ℤ}

namespace CohomologicalSpectralSequence.Page.Support

/-- The bidegrees at which a page of a cohomological spectral sequence is nonzero. -/
@[stacks 0BDW "nonzero support of a spectral-sequence page"]
def nonzero (E : CohomologicalSpectralSequence C r₀) {r : ℤ} (hr : r₀ ≤ r) :
    Set (ℤ × ℤ) :=
  {pq | ¬ IsZero ((E.page r hr).X pq)}

/-- Membership in the nonzero support of a page means that its entry is not a zero object. -/
@[simp]
theorem mem_nonzero (E : CohomologicalSpectralSequence C r₀) {r : ℤ} (hr : r₀ ≤ r)
    (pq : ℤ × ℤ) :
    pq ∈ nonzero E hr ↔ ¬ IsZero ((E.page r hr).X pq) := sorry

/-- A finite set supports a page when every entry outside it is zero. -/
@[stacks 0BDW "finite support of a spectral-sequence page"]
def IsSupport (E : CohomologicalSpectralSequence C r₀) {r : ℤ} (hr : r₀ ≤ r)
    (support : Finset (ℤ × ℤ)) : Prop :=
  ∀ ⦃pq : ℤ × ℤ⦄, pq ∉ support → IsZero ((E.page r hr).X pq)

/-- A finite set supports a page exactly when it contains its nonzero support. -/
theorem isSupport_iff (E : CohomologicalSpectralSequence C r₀) {r : ℤ} (hr : r₀ ≤ r)
    (support : Finset (ℤ × ℤ)) :
    IsSupport E hr support ↔ nonzero E hr ⊆ (support : Set (ℤ × ℤ)) := sorry

/-- A page support supplies zero objects at every bidegree outside the support. -/
theorem IsSupport.isZero {E : CohomologicalSpectralSequence C r₀} {r : ℤ}
    {hr : r₀ ≤ r} {support : Finset (ℤ × ℤ)} (h : IsSupport E hr support)
    {pq : ℤ × ℤ} (hpq : pq ∉ support) :
    IsZero ((E.page r hr).X pq) := sorry

/-- Enlarging a finite page support preserves the support property. -/
theorem IsSupport.mono {E : CohomologicalSpectralSequence C r₀} {r : ℤ}
    {hr : r₀ ≤ r} {support support' : Finset (ℤ × ℤ)}
    (h : IsSupport E hr support) (hle : support ⊆ support') :
    IsSupport E hr support' := sorry

/-- The nonzero support of a page is finite exactly when the page admits a finite support. -/
theorem finite_iff_exists (E : CohomologicalSpectralSequence C r₀) {r : ℤ}
    (hr : r₀ ≤ r) :
    (nonzero E hr).Finite ↔
      ∃ support : Finset (ℤ × ℤ), IsSupport E hr support := sorry

end CohomologicalSpectralSequence.Page.Support

namespace CohomologicalSpectralSequence.Page.WeakSerre

/-- The object property generated by all entries on a fixed page. -/
def generators (E : CohomologicalSpectralSequence C r₀) {r : ℤ} (hr : r₀ ≤ r) :
    ObjectProperty C :=
  ObjectProperty.ofObj fun pq : ℤ × ℤ ↦ (E.page r hr).X pq

/-- The smallest weak Serre object property containing every entry on a fixed page. -/
@[stacks 0BDW "weak Serre closure generated by a spectral-sequence page"]
abbrev closure (E : CohomologicalSpectralSequence C r₀) {r : ℤ} (hr : r₀ ≤ r) :
    ObjectProperty C :=
  ObjectProperty.weakSerreClosure (generators E hr)

/-- Every entry on a page belongs to the weak Serre closure generated by that page. -/
theorem entry_mem (E : CohomologicalSpectralSequence C r₀) {r : ℤ}
    (hr : r₀ ≤ r) (pq : ℤ × ℤ) :
    closure E hr ((E.page r hr).X pq) := sorry

/-- The page-generated closure is contained in every weak Serre class containing all page
entries. -/
theorem closure_le (E : CohomologicalSpectralSequence C r₀) {r : ℤ} (hr : r₀ ≤ r)
    (P : ObjectProperty C) [IsWeakSerreClass P]
    (hP : ∀ pq : ℤ × ℤ, P ((E.page r hr).X pq)) :
    closure E hr ≤ P := sorry

/-- A page entry bundled in the weak Serre closure generated by its page. -/
abbrev entry (E : CohomologicalSpectralSequence C r₀) {r : ℤ}
    (hr : r₀ ≤ r) (pq : ℤ × ℤ) :
    (closure E hr).FullSubcategory :=
  ⟨(E.page r hr).X pq, entry_mem E hr pq⟩

/-- Forgetting the bundled page entry recovers the corresponding page object. -/
@[simp]
theorem entry_obj (E : CohomologicalSpectralSequence C r₀) {r : ℤ}
    (hr : r₀ ≤ r) (pq : ℤ × ℤ) :
    (entry E hr pq).obj = (E.page r hr).X pq := sorry

end CohomologicalSpectralSequence.Page.WeakSerre

namespace CohomologicalSpectralSequence.Page.Euler

/-- The alternating Grothendieck-class sum of a page over a finite support. -/
@[stacks 0BDW "Euler characteristic of a finite spectral-sequence page"]
noncomputable def characteristic (E : CohomologicalSpectralSequence C r₀)
    {r : ℤ} (hr : r₀ ≤ r) (support : Finset (ℤ × ℤ)) :
    AbelianK0
      (CohomologicalSpectralSequence.Page.WeakSerre.closure E hr).FullSubcategory :=
  AbelianK0.alternatingSum
    (CohomologicalSpectralSequence.Page.WeakSerre.entry E hr)
    (fun pq ↦ pq.1 + pq.2) support

/-- The page Euler characteristic is its finite alternating sum of bundled page entries. -/
theorem characteristic_def (E : CohomologicalSpectralSequence C r₀)
    {r : ℤ} (hr : r₀ ≤ r) (support : Finset (ℤ × ℤ)) :
    characteristic E hr support =
      AbelianK0.alternatingSum
        (CohomologicalSpectralSequence.Page.WeakSerre.entry E hr)
        (fun pq ↦ pq.1 + pq.2) support := sorry

/-- The Euler characteristic over the empty page support is zero. -/
@[simp]
theorem characteristic_empty (E : CohomologicalSpectralSequence C r₀)
    {r : ℤ} (hr : r₀ ≤ r) :
    characteristic E hr ∅ = 0 := sorry

/-- The page Euler characteristic does not depend on the chosen finite page support. -/
theorem eq_of_support (E : CohomologicalSpectralSequence C r₀)
    {r : ℤ} (hr : r₀ ≤ r) {support support' : Finset (ℤ × ℤ)}
    (hsupport : CohomologicalSpectralSequence.Page.Support.IsSupport E hr support)
    (hsupport' : CohomologicalSpectralSequence.Page.Support.IsSupport E hr support') :
    characteristic E hr support = characteristic E hr support' := sorry

end CohomologicalSpectralSequence.Page.Euler

end CategoryTheory
