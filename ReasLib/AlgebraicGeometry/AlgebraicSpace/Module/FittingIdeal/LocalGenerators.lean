module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Module.LocalGenerators
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Module.FittingIdeal.Stalk
public import ReasLib.AlgebraicGeometry.Scheme.Module.FittingIdeal.LocalGenerators

/-!
# Étale local generators and Fitting ideal stalks

Fitting ideals characterize the number of sections needed to generate a finite-type
quasi-coherent module on an étale neighbourhood of a point of an algebraic space.
-/

@[expose] public section

open AlgebraicGeometry AlgebraicGeometry.AlgebraicSpace
open AlgebraicGeometry.AlgebraicSpace.Modules

universe u

namespace AlgebraicGeometry.AlgebraicSpace.fittingIdealSheaf

/-- A finite-type quasi-coherent module is generated by `r` sections on an étale
neighbourhood of a point exactly when its `r`th Fitting ideal has unit stalk at
every geometric point lying over that point. -/
theorem exists_etale_isGeneratedBy_iff_stalk_eq_top
    {S : Scheme.{u}} {X : AlgebraicSpace S} (F : X.Modules)
    [F.IsFiniteType] [F.IsQuasicoherent] (x : Points X) (r : ℕ) :
    existsEtaleGeneratedBy F x r ↔
      ∀ xbar : GeometricPoint X, xbar.liesOver x →
        fittingIdealStalkIdeal F r xbar = ⊤ :=
  sorry

end AlgebraicGeometry.AlgebraicSpace.fittingIdealSheaf
