module

public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Ideal.Idempotent

@[expose] public section

open AlgebraicGeometry CategoryTheory
open scoped AlgebraicGeometry

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

/-- A closed subscheme of an affine scheme is cut out by an ideal generated by
idempotents. -/
def IsCutOutByIdempotents {X : Scheme.{u}} [IsAffine X] (I : X.IdealSheafData) : Prop :=
  (I.ideal ⟨⊤, isAffineOpen_top X⟩).IsGeneratedByIdempotents

/-- `IsCutOutByIdempotents` is equivalent to generation of the global-sections ideal by the
idempotents it contains. -/
theorem isCutOutByIdempotents_iff {X : Scheme.{u}} [IsAffine X] (I : X.IdealSheafData) :
    I.IsCutOutByIdempotents ↔
      Ideal.span {e : Γ(X, ⊤) | IsIdempotentElem e ∧ e ∈ I.ideal ⟨⊤, isAffineOpen_top X⟩} =
        I.ideal ⟨⊤, isAffineOpen_top X⟩ := sorry

/-- A closed subscheme is Zariski-locally on the ambient scheme cut out by ideals
generated by idempotents. -/
def IsLocallyCutOutByIdempotents {X : Scheme.{u}} (I : X.IdealSheafData) : Prop :=
  ∀ x : X, ∃ U : X.affineOpens, x ∈ U.1 ∧ (I.ideal U).IsGeneratedByIdempotents

/-- `IsLocallyCutOutByIdempotents` is equivalent to an affine open cover on which the
defining ideals are generated by idempotents. -/
theorem isLocallyCutOutByIdempotents_iff {X : Scheme.{u}} (I : X.IdealSheafData) :
    I.IsLocallyCutOutByIdempotents ↔
      ∃ (ι : Type u) (U : ι → X.affineOpens),
        (⨆ i, (U i).1) = ⊤ ∧ ∀ i, (I.ideal (U i)).IsGeneratedByIdempotents := sorry

end AlgebraicGeometry.Scheme.IdealSheafData

namespace AlgebraicGeometry

open Scheme.IdealSheafData

/-- There is an affine scheme with a closed subscheme that is locally cut out by
idempotent-generated ideals but not globally cut out by an idempotent-generated ideal. -/
@[stacks 04QL]
theorem exists_affine_closedSubscheme_locally_cutOutByIdempotents_not_globally :
    ∃ (A : CommRingCat.{u}) (T : (Spec A).IdealSheafData),
      T.IsLocallyCutOutByIdempotents ∧ ¬ T.IsCutOutByIdempotents := sorry

end AlgebraicGeometry
