module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.AlgebraicGeometry.Noetherian
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Noetherian
public import Mathlib.RingTheory.Polynomial.Basic
public import ReasLib.AlgebraicGeometry.Scheme.Divisor.Prime
public import ReasLib.AlgebraicGeometry.Scheme.Divisor.Weil
public import ReasLib.AlgebraicGeometry.Scheme.IdealSheafData.Spec
public import ReasLib.AlgebraicGeometry.Scheme.OverField
public import ReasLib.AlgebraicGeometry.Scheme.OverSpec
public import ReasLib.AlgebraicGeometry.Scheme.Variety

/-!
# The affine quadratic cone `Spec (k[X₀, X₁, X₂] / (X₀ * X₁ - X₂ ^ 2))`

This module packages the standard affine quadratic cone over a field, together
with the ruling `V(X₀, X₂)` as a prime divisor and the associated Weil divisor.
-/

@[expose] public section

open AlgebraicGeometry AlgebraicGeometry.Scheme MvPolynomial

noncomputable section

universe u

namespace AlgebraicGeometry.QuadricCone

/-- The quadratic cone polynomial `X 0 * X 1 - X 2 ^ 2` in three variables. -/
def quadricPoly (k : Type u) [CommRing k] : MvPolynomial (Fin 3) k :=
  X 0 * X 1 - X 2 ^ 2

/-- The defining polynomial is `X 0 * X 1 - X 2 ^ 2`. -/
theorem quadricPoly_def (k : Type u) [CommRing k] :
    quadricPoly k = X 0 * X 1 - X 2 ^ 2 :=
  sorry

/-- The coordinate ring `k[X₀, X₁, X₂] / (X₀ * X₁ - X₂ ^ 2)` of the quadratic cone. -/
abbrev coordinateRing (k : Type u) [CommRing k] : Type u :=
  MvPolynomial (Fin 3) k ⧸ Ideal.span {quadricPoly k}

/-- The defining equation vanishes in the coordinate ring. -/
theorem coordinateRing_mk_quadricPoly_eq_zero (k : Type u) [CommRing k] :
    Ideal.Quotient.mk (Ideal.span {quadricPoly k}) (quadricPoly k) = 0 :=
  sorry

/-- The class of the `i`-th coordinate in the coordinate ring of the quadratic cone. -/
def coord (k : Type u) [CommRing k] (i : Fin 3) : coordinateRing k :=
  Ideal.Quotient.mk (Ideal.span {quadricPoly k}) (X i)

/-- `coord k i` is the class of `X i`. -/
theorem coord_eq_mk (k : Type u) [CommRing k] (i : Fin 3) :
    coord k i = Ideal.Quotient.mk (Ideal.span {quadricPoly k}) (X i) :=
  sorry

/-- The affine quadratic cone `Spec (k[X₀, X₁, X₂] / (X₀ * X₁ - X₂ ^ 2))`. -/
abbrev scheme (k : Type u) [CommRing k] : Scheme.{u} :=
  Spec (CommRingCat.of (coordinateRing k))

/-- The quadratic cone as a scheme over `Spec k`. -/
abbrev overField (k : Type u) [Field k] : SchemeOverField k :=
  OverSpec.affine (CommRingCat.ofHom (algebraMap k (coordinateRing k)))

/-- The underlying scheme of `overField k` is `scheme k`. -/
theorem overField_left_eq_scheme (k : Type u) [Field k] :
    (overField k).left = scheme k :=
  sorry

/-- The quadratic cone is a variety over `k`. -/
instance instVariety_overField (k : Type u) [Field k] : Variety (overField k) :=
  sorry

/-- The underlying scheme of the quadratic cone is integral. -/
instance instIsIntegral_scheme (k : Type u) [Field k] : IsIntegral (scheme k) :=
  sorry

/-- The underlying scheme of the quadratic cone is Noetherian. -/
instance instIsNoetherian_scheme (k : Type u) [Field k] : IsNoetherian (scheme k) :=
  sorry

/-- The ruling ideal generated by the images of `X 0` and `X 2`. -/
def rulingIdeal (k : Type u) [CommRing k] : Ideal (coordinateRing k) :=
  Ideal.span {coord k 0, coord k 2}

/-- The ruling ideal is the span of the images of `X 0` and `X 2`. -/
theorem rulingIdeal_span (k : Type u) [CommRing k] :
    rulingIdeal k = Ideal.span {coord k 0, coord k 2} :=
  sorry

/-- The ideal sheaf on the quadratic cone cut out by the ruling ideal. -/
def rulingIdealSheaf (k : Type u) [CommRing k] : (scheme k).IdealSheafData :=
  idealSheafDataOfIdealOnSpec (rulingIdeal k)

/-- The ruling closed subscheme is integral. -/
theorem rulingIdealSheaf_isIntegral (k : Type u) [Field k] :
    IsIntegral (rulingIdealSheaf k).subscheme :=
  sorry

/-- The support of the ruling is irreducible. -/
theorem rulingIdealSheaf_isIrreducible (k : Type u) [Field k] :
    IsIrreducible ((rulingIdealSheaf k).support : Set (scheme k)) :=
  sorry

/-- The ruling is an irreducible closed subset of codimension one. -/
theorem rulingIdealSheaf_coheight_eq_one (k : Type u) [Field k] :
    Order.coheight
      (⟨((rulingIdealSheaf k).support : Set (scheme k)), rulingIdealSheaf_isIrreducible k,
          (rulingIdealSheaf k).support.isClosed⟩ :
        TopologicalSpace.IrreducibleCloseds (scheme k)) = 1 :=
  sorry

/-- The ruling `V(X₀, X₂)` as a prime divisor on the quadratic cone. -/
def rulingPrimeDivisor (k : Type u) [Field k] : PrimeDivisor (scheme k) :=
  PrimeDivisor.ofIdeal (scheme k) (rulingIdealSheaf k) (rulingIdealSheaf_isIntegral k)
    (rulingIdealSheaf_isIrreducible k) (rulingIdealSheaf_coheight_eq_one k)

/-- The ideal sheaf of the ruling prime divisor is the ruling ideal sheaf. -/
theorem rulingPrimeDivisor_ideal (k : Type u) [Field k] :
    (rulingPrimeDivisor k).ideal = rulingIdealSheaf k :=
  sorry

open Classical in
/-- The coefficient function of the ruling Weil divisor: `1` on the ruling and `0` elsewhere. -/
def rulingWeilDivisor_coeff (k : Type u) [Field k] : PrimeDivisor (scheme k) → ℤ :=
  fun Z ↦ if Z.ideal = rulingIdealSheaf k then 1 else 0

/-- The nonzero coefficients of the ruling Weil divisor form a locally finite family. -/
theorem locallyFinite_rulingWeilDivisor_coeff (k : Type u) [Field k] :
    LocallyFinite fun Z : PrimeDivisor (scheme k) ↦
      if rulingWeilDivisor_coeff k Z = 0 then (∅ : Set (scheme k))
      else (Z.support : Set (scheme k)) :=
  sorry

/-- The Weil divisor `[V(X₀, X₂)]` on the quadratic cone. -/
def rulingWeilDivisor (k : Type u) [Field k] : WeilDivisor (scheme k) :=
  WeilDivisor.ofCoeff (scheme k) (rulingWeilDivisor_coeff k)
    (locallyFinite_rulingWeilDivisor_coeff k)

/-- The ruling prime divisor has coefficient `1` in the ruling Weil divisor. -/
theorem rulingWeilDivisor_coeff_ruling (k : Type u) [Field k] :
    (rulingWeilDivisor k).coeff (rulingPrimeDivisor k) = 1 :=
  sorry

/-- Every prime divisor other than the ruling has coefficient `0`. -/
theorem rulingWeilDivisor_coeff_eq_zero_of_ne (k : Type u) [Field k]
    {Z : PrimeDivisor (scheme k)} (hZ : Z ≠ rulingPrimeDivisor k) :
    (rulingWeilDivisor k).coeff Z = 0 :=
  sorry

end AlgebraicGeometry.QuadricCone
