module

import ReasLib.AlgebraicGeometry.AlgebraicSpace.PreRelation.QuotientPresheaf
import stacks_project.Chap78.Definition_78_4_1_PreRelation
import StacksCheckRecall

universe u

/- 78.19.0.1: the presheaf (Sch/S)^opp_fppf → Sets sending a scheme S' over S
to U(S') / ~_{S'}, the quotient of the functor of points of U by the equivalence
relation generated by the image of j(S'). -/
@[stacks 044I] #check (AlgebraicGeometry.AlgebraicSpace.PreRelation.quotientPresheaf :
  ∀ {S : AlgebraicGeometry.Scheme.{u}} {B : AlgebraicGeometry.AlgebraicSpace S}
    {U : CategoryTheory.Over B},
    AlgebraicGeometry.AlgebraicSpace.PreRelation U →
      CategoryTheory.Functor (CategoryTheory.Over S)ᵒᵖ (Type u))

#check (AlgebraicGeometry.AlgebraicSpace.PreRelation.quotientPresheaf_obj :
  ∀ {S : AlgebraicGeometry.Scheme.{u}} {B : AlgebraicGeometry.AlgebraicSpace S}
    {U : CategoryTheory.Over B}
    (P : AlgebraicGeometry.AlgebraicSpace.PreRelation U) (T : CategoryTheory.Over S),
    P.quotientPresheaf.obj (Opposite.op T) =
      Quot (P.schemePointRel T))
