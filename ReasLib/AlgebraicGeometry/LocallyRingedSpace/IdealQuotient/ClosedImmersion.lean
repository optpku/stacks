module

public import ReasLib.AlgebraicGeometry.LocallyRingedSpace.ClosedSubspace.Basic
public import ReasLib.AlgebraicGeometry.LocallyRingedSpace.IdealQuotient
public import ReasLib.AlgebraicGeometry.LocallyRingedSpace.SupportedQuotient.ClosedImmersion
import Mathlib.Tactic.CrossRefAttribute

/-!
# Closed immersions defined by ideal quotients

This property leaf records that the explicit ideal quotient is the associated closed subspace.
The quotient sheaf, space, and inclusion remain owned by the lower `IdealQuotient` module.
-/

@[expose] public section

open AlgebraicGeometry
open SheafOfModules.RingedSite

noncomputable section

universe u

namespace AlgebraicGeometry.LocallyRingedSpace.IdealQuotient

/-- Local generation of an ideal subobject transfers to the kernel sheaf of its quotient
projection. -/
@[stacks 01HM "ideal quotient kernel local generation"]
instance kernel_isLocallyGenerated
    {X : LocallyRingedSpace.{u}} (I : IdealSubobject X)
    [I.IsLocallyGeneratedBySections] :
    SheafOfModules.IsLocallyGeneratedBySections
      (KernelIdeal.sheaf.{u, u, u} (projection I)) := sorry

/-- The kernel ideal of the quotient inclusion is its defining ideal. -/
@[simp, stacks 01HN "ideal quotient kernel"]
theorem kernelIdealSubobject_ι
    {X : LocallyRingedSpace.{u}} (I : IdealSubobject X) :
    Hom.kernelIdealSubobject (ι I) = I := sorry

/-- The ideal-quotient inclusion is a closed immersion when the defining ideal is locally
generated by sections. -/
@[stacks 01HM "ideal quotient closed immersion", instance]
theorem isClosedImmersion_ι
    {X : LocallyRingedSpace.{u}} (I : IdealSubobject X)
    [I.IsLocallyGeneratedBySections] :
    IsClosedImmersion (ι I) := sorry

/-- The quotient inclusion realizes the closed subspace associated to its defining ideal. -/
@[stacks 01HN "associated quotient"]
theorem ι_isAssociated
    {X : LocallyRingedSpace.{u}} (I : IdealSubobject X)
    [I.IsLocallyGeneratedBySections] :
    ClosedSubspace.IsAssociated (ι I) I := sorry

variable {X : LocallyRingedSpace.{u}} (I : IdealSubobject X)
  [I.IsLocallyGeneratedBySections]

#synth IsClosedImmersion (ι I)

end AlgebraicGeometry.LocallyRingedSpace.IdealQuotient
