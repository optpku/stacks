module

public import ReasLib.RingTheory.MvPolynomial.Cone
public import ReasLib.AlgebraicGeometry.AffineSpace.RegularFunctions

@[expose] public section

noncomputable section

namespace MvPolynomial.LineCone

/-- The principal ideal generated by the second coordinate of the complex affine plane. -/
def lineIdeal : Ideal (MvPolynomial (Fin 2) ℂ) :=
  Ideal.span {(MvPolynomial.X 1 : MvPolynomial (Fin 2) ℂ)}

/-- The ideal generated by the second coordinate of the complex affine plane is prime. -/
instance lineIdeal_isPrime : lineIdeal.IsPrime := sorry

/-- The complex x-axis is the zero locus of the ideal generated by the second coordinate. -/
def line : Set (Fin 2 → ℂ) :=
  MvPolynomial.zeroLocus ℂ lineIdeal

/-- A point lies on the complex x-axis exactly when its second coordinate vanishes. -/
theorem mem_line_iff (point : Fin 2 → ℂ) : point ∈ line ↔ point 1 = 0 := sorry

/-- The origin lies on the complex x-axis. -/
theorem origin_mem_line : (0 : Fin 2 → ℂ) ∈ line := sorry

/-- The punctured complex x-axis is the complement of the origin in the x-axis. -/
def punctured : Set (Fin 2 → ℂ) :=
  line \ {(0 : Fin 2 → ℂ)}

/-- A point lies on the punctured complex x-axis exactly when its second coordinate
vanishes and its first coordinate is nonzero. -/
theorem mem_punctured_iff (point : Fin 2 → ℂ) :
    point ∈ punctured ↔ point 1 = 0 ∧ point 0 ≠ 0 := sorry

/-- The punctured complex x-axis is Zariski open in the complex x-axis. -/
theorem isZariskiOpenIn_punctured : MvPolynomial.IsZariskiOpenIn punctured line := sorry

/-- The reciprocal of the first coordinate on the punctured complex x-axis. -/
def reciprocal : punctured → ℂ :=
  fun point ↦ 1 / point.val 0

/-- The reciprocal function evaluates to the reciprocal of the first coordinate. -/
theorem reciprocal_apply (point : punctured) : reciprocal point = 1 / point.val 0 := sorry

/-- The complex x-axis is closed under multiplication by every complex scalar. -/
theorem isCone_line : MvPolynomial.IsCone line := sorry

/-- The reciprocal of the first coordinate is regular on the punctured complex x-axis. -/
theorem isRegular_reciprocal : MvPolynomial.IsRegular reciprocal := sorry

/-- The reciprocal of the first coordinate on the punctured complex x-axis is not the
restriction of any polynomial on the complex affine plane. -/
theorem not_isPolynomial_reciprocal : ¬ MvPolynomial.IsPolynomial reciprocal := sorry

end MvPolynomial.LineCone
