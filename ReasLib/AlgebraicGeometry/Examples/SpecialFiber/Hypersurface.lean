module

public import Mathlib.Algebra.Polynomial.Eval.Defs
public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.AlgebraicGeometry.Fiber
public import Mathlib.Data.Complex.Basic
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.Line
public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.IdealClosure
public import ReasLib.AlgebraicGeometry.Scheme.Morphism.Projective.Basic
public import Mathlib.AlgebraicGeometry.Morphisms.Flat
public import Mathlib.AlgebraicGeometry.Properties

/-!
# Split-conic and double-line families over the complex affine line

Explicit `Proj` hypersurfaces in `ProjectiveSpace.scheme (Polynomial ℂ) 2` over
`Spec (Polynomial ℂ)`, used as degeneration examples with special fibre at the
origin.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

namespace AlgebraicGeometry.SplitConicOverLine

/-- The affine line `A^1_C = Spec (Polynomial ℂ)`. -/
abbrev base : Scheme :=
  Spec (CommRingCat.of (Polynomial ℂ))

/-- The closed-point morphism `Spec ℂ ⟶ Spec (Polynomial ℂ)` induced by evaluation at `0`. -/
def originHom : Spec (CommRingCat.of ℂ) ⟶ base :=
  Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : ℂ)))

/-- `originHom` is the spectrum of evaluation at `0`. -/
theorem originHom_spec :
    originHom = Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : ℂ))) :=
  sorry

/-- The origin `0` of `Spec (Polynomial ℂ)`, as the image of the closed point of `Spec ℂ`. -/
def origin : base :=
  originHom (IsLocalRing.closedPoint ℂ)

/-- The origin is the image of the unique closed point of `Spec ℂ`. -/
theorem origin_eq :
    origin = originHom (IsLocalRing.closedPoint ℂ) :=
  sorry

/-- The origin is a closed point of `Spec (Polynomial ℂ)`. -/
theorem origin_mem_closedPoints : origin ∈ closedPoints base :=
  sorry

/-- The homogeneous equation `T₁ * T₂ - T * T₀ ^ 2` in `ℙ²` over `Polynomial ℂ`. -/
def equation : MvPolynomial (Fin 3) (Polynomial ℂ) :=
  MvPolynomial.X 1 * MvPolynomial.X 2 -
    MvPolynomial.C Polynomial.X * MvPolynomial.X 0 ^ 2

/-- Unfolding of `equation` as `T₁ * T₂ - T * T₀ ^ 2`. -/
theorem equation_spec :
    equation =
      MvPolynomial.X 1 * MvPolynomial.X 2 -
        MvPolynomial.C Polynomial.X * MvPolynomial.X 0 ^ 2 :=
  sorry

/-- The principal ideal generated by `equation` is homogeneous for the standard `ℙ²` grading. -/
theorem equationIdeal_homogeneous :
    (Ideal.span {equation}).IsHomogeneous (ProjectiveSpace.grading (Polynomial ℂ) 2) :=
  sorry

/-- The homogeneous principal ideal cutting out the split conic in `ℙ²` over `Polynomial ℂ`. -/
def equationIdeal : HomogeneousIdeal (ProjectiveSpace.grading (Polynomial ℂ) 2) where
  toSubmodule := Ideal.span {equation}
  is_homogeneous' := equationIdeal_homogeneous

/-- The underlying ideal of `equationIdeal` is generated by `equation`. -/
theorem equationIdeal_toIdeal :
    equationIdeal.toIdeal = Ideal.span {equation} :=
  sorry

/-- The homogeneous coordinate ring of the split conic. -/
abbrev coordinateRing : Type :=
  MvPolynomial (Fin 3) (Polynomial ℂ) ⧸ equationIdeal.toIdeal

/-- The quotient grading on `coordinateRing`. -/
abbrev grading : ℕ → Submodule (Polynomial ℂ) coordinateRing :=
  GradedAlgebra.Quotient.grading (ProjectiveSpace.grading (Polynomial ℂ) 2) equationIdeal.toIdeal

/-- The quotient by `equationIdeal` inherits the standard projective grading. -/
instance grading_gradedAlgebra : GradedAlgebra grading :=
  GradedAlgebra.Quotient.gradedAlgebra (ProjectiveSpace.grading (Polynomial ℂ) 2)
    equationIdeal.toIdeal equationIdeal.isHomogeneous

/-- The `Proj` model of the split conic over `Spec (Polynomial ℂ)`. -/
abbrev model : Scheme :=
  Proj grading

/-- The closed immersion of the split conic into `ℙ²` over `Polynomial ℂ`. -/
def planeInclusion : model ⟶ ProjectiveSpace.scheme (Polynomial ℂ) 2 :=
  projQuotientMap (ProjectiveSpace.grading (Polynomial ℂ) 2) equationIdeal

/-- `planeInclusion` is the projective-spectrum map of `equationIdeal`. -/
theorem planeInclusion_spec :
    planeInclusion =
      projQuotientMap (ProjectiveSpace.grading (Polynomial ℂ) 2) equationIdeal :=
  sorry

/-- The structure morphism of the split conic to `Spec (Polynomial ℂ)`. -/
def toBase : model ⟶ base :=
  planeInclusion ≫ ProjectiveSpace.toSpec (Polynomial ℂ) 2

/-- `toBase` is the composite of `planeInclusion` with `ProjectiveSpace.toSpec`. -/
theorem toBase_spec :
    toBase = planeInclusion ≫ ProjectiveSpace.toSpec (Polynomial ℂ) 2 :=
  sorry

/-- The scheme-theoretic special fibre of `toBase` over the origin. -/
abbrev specialFiber : Scheme :=
  toBase.fiber origin

/-- `specialFiber` is the scheme-theoretic fibre of `toBase` at `origin`. -/
theorem specialFiber_eq :
    specialFiber = toBase.fiber origin :=
  sorry

/-- Nonzero polynomials act injectively on sections of affine opens of `model` via `toBase`. -/
theorem toBase_affine_nonzerodivisor {V : model.Opens} (hV : IsAffineOpen V)
    (hVle : V ≤ toBase ⁻¹ᵁ ⊤) {p : Polynomial ℂ} (hp : p ≠ 0) :
    Function.Injective fun a : Γ(model, V) ↦
      (toBase.appLE ⊤ V hVle).hom ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial ℂ))).inv.hom p) * a :=
  sorry

/-- Every closed non-origin fibre of the split-conic family is the projective line. -/
theorem fiber_iso_projectiveLine (t : base) (ht : t ∈ closedPoints base) (ht0 : t ≠ origin) :
    Nonempty (toBase.fiber t ≅ ProjectiveLine.scheme ℂ) :=
  sorry

/-- The split-conic special fibre is not the projective line. -/
theorem specialFiber_not_iso_projectiveLine :
    ¬ Nonempty (specialFiber ≅ ProjectiveLine.scheme ℂ) :=
  sorry

/-- The split-conic special fibre is projective over the residue field of the origin. -/
instance specialFiber_projective :
    Projective (toBase.fiberToSpecResidueField origin) :=
  sorry

/-- The split-conic family is flat. -/
instance toBase_flat : Flat toBase :=
  sorry

/-- The split-conic family is projective. -/
instance toBase_projective : Projective toBase :=
  sorry

/-- The split-conic special fibre is reduced. -/
instance specialFiber_reduced : IsReduced specialFiber :=
  sorry

end AlgebraicGeometry.SplitConicOverLine

namespace AlgebraicGeometry.DoubleLineOverLine

/-- The affine line `A^1_C`, identified with `SplitConicOverLine.base`. -/
abbrev base : Scheme :=
  SplitConicOverLine.base

/-- The origin of `Spec (Polynomial ℂ)`. -/
abbrev origin : base :=
  SplitConicOverLine.origin

/-- The homogeneous equation `T₀ ^ 2 - T * T₁ * T₂` of a double line in `ℙ²`. -/
def equation : MvPolynomial (Fin 3) (Polynomial ℂ) :=
  MvPolynomial.X 0 ^ 2 -
    MvPolynomial.C Polynomial.X * MvPolynomial.X 1 * MvPolynomial.X 2

/-- Unfolding of `equation` as `T₀ ^ 2 - T * T₁ * T₂`. -/
theorem equation_spec :
    equation =
      MvPolynomial.X 0 ^ 2 -
        MvPolynomial.C Polynomial.X * MvPolynomial.X 1 * MvPolynomial.X 2 :=
  sorry

/-- The principal ideal generated by `equation` is homogeneous for the standard `ℙ²` grading. -/
theorem equationIdeal_homogeneous :
    (Ideal.span {equation}).IsHomogeneous (ProjectiveSpace.grading (Polynomial ℂ) 2) :=
  sorry

/-- The homogeneous principal ideal cutting out the double line in `ℙ²` over `Polynomial ℂ`. -/
def equationIdeal : HomogeneousIdeal (ProjectiveSpace.grading (Polynomial ℂ) 2) where
  toSubmodule := Ideal.span {equation}
  is_homogeneous' := equationIdeal_homogeneous

/-- The underlying ideal of `equationIdeal` is generated by `equation`. -/
theorem equationIdeal_toIdeal :
    equationIdeal.toIdeal = Ideal.span {equation} :=
  sorry

/-- The homogeneous coordinate ring of the double line. -/
abbrev coordinateRing : Type :=
  MvPolynomial (Fin 3) (Polynomial ℂ) ⧸ equationIdeal.toIdeal

/-- The quotient grading on `coordinateRing`. -/
abbrev grading : ℕ → Submodule (Polynomial ℂ) coordinateRing :=
  GradedAlgebra.Quotient.grading (ProjectiveSpace.grading (Polynomial ℂ) 2) equationIdeal.toIdeal

/-- The quotient by `equationIdeal` inherits the standard projective grading. -/
instance grading_gradedAlgebra : GradedAlgebra grading :=
  GradedAlgebra.Quotient.gradedAlgebra (ProjectiveSpace.grading (Polynomial ℂ) 2)
    equationIdeal.toIdeal equationIdeal.isHomogeneous

/-- The `Proj` model of the double line over `Spec (Polynomial ℂ)`. -/
abbrev model : Scheme :=
  Proj grading

/-- The closed immersion of the double line into `ℙ²` over `Polynomial ℂ`. -/
def planeInclusion : model ⟶ ProjectiveSpace.scheme (Polynomial ℂ) 2 :=
  projQuotientMap (ProjectiveSpace.grading (Polynomial ℂ) 2) equationIdeal

/-- `planeInclusion` is the projective-spectrum map of `equationIdeal`. -/
theorem planeInclusion_spec :
    planeInclusion =
      projQuotientMap (ProjectiveSpace.grading (Polynomial ℂ) 2) equationIdeal :=
  sorry

/-- The structure morphism of the double line to `Spec (Polynomial ℂ)`. -/
def toBase : model ⟶ base :=
  planeInclusion ≫ ProjectiveSpace.toSpec (Polynomial ℂ) 2

/-- `toBase` is the composite of `planeInclusion` with `ProjectiveSpace.toSpec`. -/
theorem toBase_spec :
    toBase = planeInclusion ≫ ProjectiveSpace.toSpec (Polynomial ℂ) 2 :=
  sorry

/-- The scheme-theoretic special fibre of the double line over the origin. -/
abbrev specialFiber : Scheme :=
  toBase.fiber origin

/-- `specialFiber` is the scheme-theoretic fibre of `toBase` at `origin`. -/
theorem specialFiber_eq :
    specialFiber = toBase.fiber origin :=
  sorry

/-- The double-line fibre over a closed point other than the origin is the projective line. -/
theorem fiber_iso_projectiveLine (t : base) (ht : t ∈ closedPoints base) (ht0 : t ≠ origin) :
    Nonempty (toBase.fiber t ≅ ProjectiveLine.scheme ℂ) :=
  sorry

/-- The double-line special fibre is not the projective line. -/
theorem specialFiber_not_iso_projectiveLine :
    ¬ Nonempty (specialFiber ≅ ProjectiveLine.scheme ℂ) :=
  sorry

/-- The double-line special fibre is an irreducible topological space. -/
instance specialFiber_irreducibleSpace : IrreducibleSpace specialFiber :=
  sorry

/-- The double-line special fibre is projective over the residue field of the origin. -/
instance specialFiber_projective :
    Projective (toBase.fiberToSpecResidueField origin) :=
  sorry

/-- The double-line special fibre is irreducible and projective. -/
theorem specialFiber_irreducible_projective :
    IrreducibleSpace specialFiber ∧
      Projective (toBase.fiberToSpecResidueField origin) :=
  sorry

/-- The double-line family is flat. -/
instance toBase_flat : Flat toBase :=
  sorry

/-- The double-line family is projective. -/
instance toBase_projective : Projective toBase :=
  sorry

/-- The double-line family is flat and projective with irreducible special fibre. -/
theorem flat_projective_irreducible_specialFiber :
    Flat toBase ∧ Projective toBase ∧ IrreducibleSpace specialFiber :=
  sorry

end AlgebraicGeometry.DoubleLineOverLine
