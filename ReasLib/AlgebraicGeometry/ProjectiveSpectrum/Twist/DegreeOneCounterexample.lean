module

public import Mathlib.LinearAlgebra.SymmetricAlgebra.Basic
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.BasicOpen
public import ReasLib.RingTheory.GradedAlgebra.Quotient
public import ReasLib.RingTheory.GradedAlgebra.HomogeneousLocalization.Away.Module
public import ReasLib.RingTheory.MvPolynomial.StandardGrading

/-!
# A degree-one counterexample for projective spectra

This file gives an explicit symmetric algebra whose canonical degree-one map to the two-chart
Čech model of its degree-one twist is not injective.
-/

@[expose] public section

open CategoryTheory
open scoped AlgebraicGeometry DirectSum

noncomputable section

universe u

namespace AlgebraicGeometry.Proj.DegreeOneCounterexample

/-- The six affine coordinates in the degree-one counterexample. -/
inductive Coordinate
  | u
  | v
  | s1
  | s2
  | t1
  | t2
  deriving DecidableEq

/-- The ideal generated by `-u*s1 + v*t1 + u*t2`, `v*s1 + u*s2 - v*t2`, `v*s2`, and
`u*t1`. -/
def baseIdeal (k : Type u) [Field k] : Ideal (MvPolynomial Coordinate k) :=
  let u : MvPolynomial Coordinate k := MvPolynomial.X Coordinate.u
  let v : MvPolynomial Coordinate k := MvPolynomial.X Coordinate.v
  let s1 : MvPolynomial Coordinate k := MvPolynomial.X Coordinate.s1
  let s2 : MvPolynomial Coordinate k := MvPolynomial.X Coordinate.s2
  let t1 : MvPolynomial Coordinate k := MvPolynomial.X Coordinate.t1
  let t2 : MvPolynomial Coordinate k := MvPolynomial.X Coordinate.t2
  Ideal.span
    ({-(u * s1) + v * t1 + u * t2, v * s1 + u * s2 - v * t2, v * s2, u * t1} :
      Set (MvPolynomial Coordinate k))

/-- The affine coordinate ring obtained by quotienting by `baseIdeal`. -/
abbrev BaseRing (k : Type u) [Field k] :=
  MvPolynomial Coordinate k ⧸ baseIdeal k

/-- The free rank-two module in the presentation of the counterexample module. -/
abbrev FreeModule (k : Type u) [Field k] :=
  BaseRing k × BaseRing k

/-- The vector `(ū, v̄)` generating the relation in the presented module. -/
def relationVector (k : Type u) [Field k] : FreeModule k :=
  let ubar : BaseRing k :=
    Ideal.Quotient.mk (baseIdeal k) (MvPolynomial.X Coordinate.u)
  let vbar : BaseRing k :=
    Ideal.Quotient.mk (baseIdeal k) (MvPolynomial.X Coordinate.v)
  (ubar, vbar)

/-- The submodule spanned by the relation vector `(ū, v̄)`. -/
def relationSubmodule (k : Type u) [Field k] :
    Submodule (BaseRing k) (FreeModule k) :=
  Submodule.span (BaseRing k) ({relationVector k} : Set (FreeModule k))

/-- The module `(A × A) / A(ū, v̄)`. -/
abbrev PresentedModule (k : Type u) [Field k] :=
  FreeModule k ⧸ relationSubmodule k

/-- The class of `(ūs̄1, v̄t̄2)` in the presented module. -/
def witness (k : Type u) [Field k] : PresentedModule k :=
  let ubar : BaseRing k :=
    Ideal.Quotient.mk (baseIdeal k) (MvPolynomial.X Coordinate.u)
  let vbar : BaseRing k :=
    Ideal.Quotient.mk (baseIdeal k) (MvPolynomial.X Coordinate.v)
  let s1bar : BaseRing k :=
    Ideal.Quotient.mk (baseIdeal k) (MvPolynomial.X Coordinate.s1)
  let t2bar : BaseRing k :=
    Ideal.Quotient.mk (baseIdeal k) (MvPolynomial.X Coordinate.t2)
  (relationSubmodule k).mkQ (ubar * s1bar, vbar * t2bar)

/-- The polynomial ring `A[X, Y]` used to present the symmetric algebra. -/
abbrev PolynomialRing (k : Type u) [Field k] :=
  MvPolynomial (Fin 2) (BaseRing k)

/-- The linear relation `ūX + v̄Y` in `A[X, Y]`. -/
def symmetricRelation (k : Type u) [Field k] : PolynomialRing k :=
  let ubar : BaseRing k :=
    Ideal.Quotient.mk (baseIdeal k) (MvPolynomial.X Coordinate.u)
  let vbar : BaseRing k :=
    Ideal.Quotient.mk (baseIdeal k) (MvPolynomial.X Coordinate.v)
  MvPolynomial.C ubar * MvPolynomial.X (0 : Fin 2) +
    MvPolynomial.C vbar * MvPolynomial.X (1 : Fin 2)

/-- The principal ideal generated by `ūX + v̄Y`. -/
def symmetricIdeal (k : Type u) [Field k] : Ideal (PolynomialRing k) :=
  Ideal.span ({symmetricRelation k} : Set (PolynomialRing k))

/-- The quotient presentation `A[X, Y] / (ūX + v̄Y)`. -/
abbrev SymmetricPresentation (k : Type u) [Field k] :=
  PolynomialRing k ⧸ symmetricIdeal k

/-- The quotient algebra map from `A[X, Y]` to its symmetric presentation. -/
def symmetricQuotientMap (k : Type u) [Field k] :
    PolynomialRing k →ₐ[BaseRing k] SymmetricPresentation k :=
  Ideal.Quotient.mkₐ (BaseRing k) (symmetricIdeal k)

/-- The relation `ūX + v̄Y` is homogeneous for the standard total-degree grading. -/
theorem symmetricRelation_isHomogeneous (k : Type u) [Field k] :
    SetLike.IsHomogeneousElem
      (MvPolynomial.standardGrading (Fin 2) (BaseRing k)) (symmetricRelation k) := sorry

/-- The quotient grading induced by the standard total-degree grading on `A[X, Y]`. -/
noncomputable def grading (k : Type u) [Field k] :
    ℕ → Submodule (BaseRing k) (SymmetricPresentation k) :=
  GradedAlgebra.Quotient.grading
    (MvPolynomial.standardGrading (Fin 2) (BaseRing k)) (symmetricIdeal k)

/-- The canonical graded-algebra structure on the homogeneous quotient presentation. -/
noncomputable instance instGradedAlgebra (k : Type u) [Field k] :
    GradedAlgebra (grading k) :=
  GradedAlgebra.Quotient.spanSingletonGradedAlgebra
    (MvPolynomial.standardGrading (Fin 2) (BaseRing k))
    (symmetricRelation_isHomogeneous k)

/-- The polynomial `ūs̄1X + v̄t̄2Y` representing the degree-one witness. -/
def witnessPolynomial (k : Type u) [Field k] : PolynomialRing k :=
  let ubar : BaseRing k :=
    Ideal.Quotient.mk (baseIdeal k) (MvPolynomial.X Coordinate.u)
  let vbar : BaseRing k :=
    Ideal.Quotient.mk (baseIdeal k) (MvPolynomial.X Coordinate.v)
  let s1bar : BaseRing k :=
    Ideal.Quotient.mk (baseIdeal k) (MvPolynomial.X Coordinate.s1)
  let t2bar : BaseRing k :=
    Ideal.Quotient.mk (baseIdeal k) (MvPolynomial.X Coordinate.t2)
  MvPolynomial.C (ubar * s1bar) * MvPolynomial.X (0 : Fin 2) +
    MvPolynomial.C (vbar * t2bar) * MvPolynomial.X (1 : Fin 2)

/-- The polynomial representing the witness is homogeneous of degree one. -/
theorem witnessPolynomial_mem_homogeneousSubmodule (k : Type u) [Field k] :
    witnessPolynomial k ∈ MvPolynomial.standardGrading (Fin 2) (BaseRing k) 1 := sorry

/-- The quotient class of the witness polynomial belongs to the degree-one quotient piece. -/
theorem witnessDegreeOneClass_mem (k : Type u) [Field k] :
    symmetricQuotientMap k (witnessPolynomial k) ∈ grading k 1 := sorry

/-- The degree-one quotient class represented by `ūs̄1X + v̄t̄2Y`. -/
def witnessDegreeOneClass (k : Type u) [Field k] : grading k 1 :=
  ⟨symmetricQuotientMap k (witnessPolynomial k), witnessDegreeOneClass_mem k⟩

/-- The linear polynomial `aX + bY` attached to `(a, b)` in the free presentation. -/
def linearPolynomial (k : Type u) [Field k] (z : FreeModule k) : PolynomialRing k :=
  let xTerm :=
    (LinearMap.mulRight (BaseRing k) (MvPolynomial.X (0 : Fin 2))).comp
      (Algebra.linearMap (BaseRing k) (PolynomialRing k))
  let yTerm :=
    (LinearMap.mulRight (BaseRing k) (MvPolynomial.X (1 : Fin 2))).comp
      (Algebra.linearMap (BaseRing k) (PolynomialRing k))
  xTerm.coprod yTerm z

/-- Every linear polynomial attached to the free presentation is homogeneous of degree one. -/
theorem linearPolynomial_mem_homogeneousSubmodule
    (k : Type u) [Field k] (z : FreeModule k) :
    linearPolynomial k z ∈ MvPolynomial.standardGrading (Fin 2) (BaseRing k) 1 := sorry

/-- The quotient class of an attached linear polynomial belongs to the degree-one quotient
piece. -/
theorem linearPolynomialClass_mem_grading
    (k : Type u) [Field k] (z : FreeModule k) :
    symmetricQuotientMap k (linearPolynomial k z) ∈ grading k 1 := sorry

/-- The linear map from the free presentation to the degree-one quotient piece. -/
noncomputable def freeToDegreeOne (k : Type u) [Field k] :
    FreeModule k →ₗ[BaseRing k] grading k 1 :=
  let xTerm :=
    (LinearMap.mulRight (BaseRing k) (MvPolynomial.X (0 : Fin 2))).comp
      (Algebra.linearMap (BaseRing k) (PolynomialRing k))
  let yTerm :=
    (LinearMap.mulRight (BaseRing k) (MvPolynomial.X (1 : Fin 2))).comp
      (Algebra.linearMap (BaseRing k) (PolynomialRing k))
  let polynomialMap := xTerm.coprod yTerm
  LinearMap.codRestrict (grading k 1)
    ((symmetricQuotientMap k).toLinearMap.comp polynomialMap)
    (linearPolynomialClass_mem_grading k)

/-- The relation submodule is contained in the kernel of the free degree-one map. -/
theorem relationSubmodule_le_ker_freeToDegreeOne (k : Type u) [Field k] :
    relationSubmodule k ≤ LinearMap.ker (freeToDegreeOne k) := sorry

/-- The canonical linear map from the presented module to the degree-one quotient piece. -/
noncomputable def moduleToDegreeOne (k : Type u) [Field k] :
    PresentedModule k →ₗ[BaseRing k] grading k 1 :=
  (relationSubmodule k).liftQ (freeToDegreeOne k)
    (relationSubmodule_le_ker_freeToDegreeOne k)

/-- The canonical linear map from the presented module into the full symmetric presentation. -/
noncomputable def moduleToPresentation (k : Type u) [Field k] :
    PresentedModule k →ₗ[BaseRing k] SymmetricPresentation k :=
  (grading k 1).subtype.comp (moduleToDegreeOne k)

/-- The canonical module map exhibits the polynomial quotient as the symmetric algebra of the
presented module. -/
theorem moduleToPresentation_isSymmetricAlgebra (k : Type u) [Field k] :
    IsSymmetricAlgebra (moduleToPresentation k) := sorry

/-- The canonical degree-one map sends the module witness to its explicit polynomial class. -/
theorem moduleToDegreeOne_witness (k : Type u) [Field k] :
    moduleToDegreeOne k (witness k) = witnessDegreeOneClass k := sorry

/-- The shifted grading whose degree `n` piece is the degree `n + 1` piece of the symmetric
presentation. -/
noncomputable def shiftOneGrading (k : Type u) [Field k] :
    ℕ → Submodule (BaseRing k) (SymmetricPresentation k) :=
  fun n ↦ grading k (n + 1)

/-- Multiplication by the symmetric presentation respects its grading shifted by one. -/
noncomputable instance instGradedSMulShiftOne (k : Type u) [Field k] :
    SetLike.GradedSMul (grading k) (shiftOneGrading k) where
  smul_mem := sorry

/-- The quotient class of the first polynomial variable. -/
def xClass (k : Type u) [Field k] : SymmetricPresentation k :=
  symmetricQuotientMap k (MvPolynomial.X (0 : Fin 2))

/-- The quotient class of the second polynomial variable. -/
def yClass (k : Type u) [Field k] : SymmetricPresentation k :=
  symmetricQuotientMap k (MvPolynomial.X (1 : Fin 2))

/-- The product of the two distinguished degree-one quotient classes. -/
def xyClass (k : Type u) [Field k] : SymmetricPresentation k :=
  xClass k * yClass k

/-- The first distinguished quotient class has degree one. -/
theorem xClass_mem_grading (k : Type u) [Field k] :
    xClass k ∈ grading k 1 := sorry

/-- The second distinguished quotient class has degree one. -/
theorem yClass_mem_grading (k : Type u) [Field k] :
    yClass k ∈ grading k 1 := sorry

/-- The product of the distinguished quotient classes has degree two. -/
theorem xyClass_mem_grading (k : Type u) [Field k] :
    xyClass k ∈ grading k 2 := sorry

/-- Degree-one twist sections on the projective basic open defined by the first variable. -/
noncomputable abbrev XChartDegreeOneSections (k : Type u) [Field k] :=
  HomogeneousLocalization.Away.Module.degreeZeroPart (grading k) (shiftOneGrading k)
    ⟨xClass k, xClass_mem_grading k⟩

/-- Degree-one twist sections on the projective basic open defined by the second variable. -/
noncomputable abbrev YChartDegreeOneSections (k : Type u) [Field k] :=
  HomogeneousLocalization.Away.Module.degreeZeroPart (grading k) (shiftOneGrading k)
    ⟨yClass k, yClass_mem_grading k⟩

/-- Degree-one twist sections on the intersection of the two distinguished projective basic
opens. -/
noncomputable abbrev XYChartDegreeOneSections (k : Type u) [Field k] :=
  HomogeneousLocalization.Away.Module.degreeZeroPart (grading k) (shiftOneGrading k)
    ⟨xyClass k, xyClass_mem_grading k⟩

/-- The projective basic open defined by the product lies in the basic open defined by the first
factor. -/
theorem basicOpen_xy_le_x (k : Type u) [Field k] :
    Proj.basicOpen (grading k) (xyClass k) ≤ Proj.basicOpen (grading k) (xClass k) := sorry

/-- The projective basic open defined by the product lies in the basic open defined by the second
factor. -/
theorem basicOpen_xy_le_y (k : Type u) [Field k] :
    Proj.basicOpen (grading k) (xyClass k) ≤ Proj.basicOpen (grading k) (yClass k) := sorry

/-- Restriction of a degree-one section from the first chart to the intersection chart. -/
noncomputable def restrictXToXY (k : Type u) [Field k] :
    XChartDegreeOneSections k →+ XYChartDegreeOneSections k :=
  (homogeneousLocalizationAwayToAwayDegreeZeroModuleMap (grading k) (shiftOneGrading k)
    (xClass_mem_grading k) (by omega) (xyClass_mem_grading k) (by omega)
    (basicOpen_xy_le_x k)).toAddMonoidHom

/-- Restriction of a degree-one section from the second chart to the intersection chart. -/
noncomputable def restrictYToXY (k : Type u) [Field k] :
    YChartDegreeOneSections k →+ XYChartDegreeOneSections k :=
  (homogeneousLocalizationAwayToAwayDegreeZeroModuleMap (grading k) (shiftOneGrading k)
    (yClass_mem_grading k) (by omega) (xyClass_mem_grading k) (by omega)
    (basicOpen_xy_le_y k)).toAddMonoidHom

/-- A degree-one homogeneous class gives a section on the first projective basic-open chart. -/
noncomputable def degreeOneToXChart (k : Type u) [Field k] :
    grading k 1 →+ XChartDegreeOneSections k where
  toFun z :=
    ⟨HomogeneousLocalization.Away.Module.powMk (grading k)
        ⟨xClass k, xClass_mem_grading k⟩ 0 z,
      HomogeneousLocalization.Away.Module.mk_mem_degreeZeroPart
        (grading k) (shiftOneGrading k) ⟨xClass k, xClass_mem_grading k⟩
        (n := 0) (by simpa [shiftOneGrading] using z.2)⟩
  map_zero' := Subtype.ext (by
    simpa [HomogeneousLocalization.Away.Module.powMk] using
      (LocalizedModule.mkLinearMap (Submonoid.powers (xClass k))
        (SymmetricPresentation k)).map_zero)
  map_add' a b := Subtype.ext (by
    simpa [HomogeneousLocalization.Away.Module.powMk] using
      (LocalizedModule.mkLinearMap (Submonoid.powers (xClass k))
        (SymmetricPresentation k)).map_add a b)

/-- A degree-one homogeneous class gives a section on the second projective basic-open chart. -/
noncomputable def degreeOneToYChart (k : Type u) [Field k] :
    grading k 1 →+ YChartDegreeOneSections k where
  toFun z :=
    ⟨HomogeneousLocalization.Away.Module.powMk (grading k)
        ⟨yClass k, yClass_mem_grading k⟩ 0 z,
      HomogeneousLocalization.Away.Module.mk_mem_degreeZeroPart
        (grading k) (shiftOneGrading k) ⟨yClass k, yClass_mem_grading k⟩
        (n := 0) (by simpa [shiftOneGrading] using z.2)⟩
  map_zero' := Subtype.ext (by
    simpa [HomogeneousLocalization.Away.Module.powMk] using
      (LocalizedModule.mkLinearMap (Submonoid.powers (yClass k))
        (SymmetricPresentation k)).map_zero)
  map_add' a b := Subtype.ext (by
    simpa [HomogeneousLocalization.Away.Module.powMk] using
      (LocalizedModule.mkLinearMap (Submonoid.powers (yClass k))
        (SymmetricPresentation k)).map_add a b)

/-- Restricting a degree-one class from the first chart agrees with its standard fraction on the
intersection chart. -/
theorem restrictXToXY_degreeOneToXChart (k : Type u) [Field k]
    (z : grading k 1) :
    restrictXToXY k (degreeOneToXChart k z) =
      ⟨HomogeneousLocalization.Away.Module.powMk (grading k)
          ⟨xyClass k, xyClass_mem_grading k⟩ 0 z,
        HomogeneousLocalization.Away.Module.mk_mem_degreeZeroPart
          (grading k) (shiftOneGrading k) ⟨xyClass k, xyClass_mem_grading k⟩
          (n := 0) (by simpa [shiftOneGrading] using z.2)⟩ := sorry

/-- Restricting a degree-one class from the second chart agrees with its standard fraction on the
intersection chart. -/
theorem restrictYToXY_degreeOneToYChart (k : Type u) [Field k]
    (z : grading k 1) :
    restrictYToXY k (degreeOneToYChart k z) =
      ⟨HomogeneousLocalization.Away.Module.powMk (grading k)
          ⟨xyClass k, xyClass_mem_grading k⟩ 0 z,
        HomogeneousLocalization.Away.Module.mk_mem_degreeZeroPart
          (grading k) (shiftOneGrading k) ⟨xyClass k, xyClass_mem_grading k⟩
          (n := 0) (by simpa [shiftOneGrading] using z.2)⟩ := sorry

set_option synthInstance.maxHeartbeats 200000 in
/-- The Čech differential is the difference of the two restrictions to the intersection chart. -/
noncomputable def degreeOneCechDifferential (k : Type u) [Field k] :
    XChartDegreeOneSections k × YChartDegreeOneSections k →+
      XYChartDegreeOneSections k where
  toFun z := restrictXToXY k z.1 - restrictYToXY k z.2
  map_zero' := by simp
  map_add' a b := by simp [sub_add_sub_comm]

set_option synthInstance.maxHeartbeats 200000 in
/-- Compatible pairs of degree-one sections on the two distinguished projective basic opens. -/
noncomputable abbrev DegreeOneGlobalSections (k : Type u) [Field k] :=
  (degreeOneCechDifferential k).ker

set_option synthInstance.maxHeartbeats 200000 in
/-- Membership in the two-chart global-section model is equality of the two restrictions on the
intersection. -/
theorem degreeOneGlobalSections_spec (k : Type u) [Field k]
    (z : XChartDegreeOneSections k × YChartDegreeOneSections k) :
    z ∈ (degreeOneCechDifferential k).ker ↔
      restrictXToXY k z.1 = restrictYToXY k z.2 := sorry

set_option synthInstance.maxHeartbeats 200000 in
/-- The two chart sections attached to a degree-one class agree on their intersection. -/
theorem degreeOneSection_compatible (k : Type u) [Field k] (z : grading k 1) :
    degreeOneCechDifferential k (degreeOneToXChart k z, degreeOneToYChart k z) = 0 := sorry

set_option synthInstance.maxHeartbeats 200000 in
/-- The canonical degree-one homogeneous class viewed as a compatible pair of chart sections. -/
noncomputable def degreeOneSection (k : Type u) [Field k] :
    grading k 1 →+ DegreeOneGlobalSections k where
  toFun z :=
    ⟨(degreeOneToXChart k z, degreeOneToYChart k z), degreeOneSection_compatible k z⟩
  map_zero' := by
    ext <;> simp
  map_add' a b := by
    ext <;> simp

set_option synthInstance.maxHeartbeats 200000 in
/-- The two components of the section attached to a degree-one homogeneous class are its
standard sections on the distinguished charts. -/
theorem degreeOneSection_apply (k : Type u) [Field k] (z : grading k 1) :
    (degreeOneSection k z :
      XChartDegreeOneSections k × YChartDegreeOneSections k) =
        (degreeOneToXChart k z, degreeOneToYChart k z) := sorry

/-- The two distinguished projective basic opens cover the projective spectrum. -/
theorem basicOpen_x_sup_y (k : Type u) [Field k] :
    Proj.basicOpen (grading k) (xClass k) ⊔ Proj.basicOpen (grading k) (yClass k) = ⊤ := sorry

set_option synthInstance.maxHeartbeats 200000 in
/-- The canonical map from the presented module to compatible degree-one chart sections. -/
noncomputable def sectionMap (k : Type u) [Field k] :
    PresentedModule k →+ DegreeOneGlobalSections k :=
  (degreeOneSection k).comp (moduleToDegreeOne k).toAddMonoidHom

set_option synthInstance.maxHeartbeats 200000 in
/-- The section map is the degree-one module map followed by passage to compatible chart
sections. -/
theorem sectionMap_apply (k : Type u) [Field k] (m : PresentedModule k) :
    sectionMap k m = degreeOneSection k (moduleToDegreeOne k m) := sorry

/-- The explicit degree-one witness restricts to zero on the first distinguished chart. -/
theorem witnessDegreeOneClass_mapsToZeroOnX (k : Type u) [Field k] :
    degreeOneToXChart k (witnessDegreeOneClass k) = 0 := sorry

/-- The explicit degree-one witness restricts to zero on the second distinguished chart. -/
theorem witnessDegreeOneClass_mapsToZeroOnY (k : Type u) [Field k] :
    degreeOneToYChart k (witnessDegreeOneClass k) = 0 := sorry

set_option synthInstance.maxHeartbeats 200000 in
/-- The explicit module witness maps to zero in the two-chart model of global degree-one
sections. -/
theorem witness_mapsToZero (k : Type u) [Field k] :
    sectionMap k (witness k) = 0 := sorry

/-- The explicit class of `(ūs̄1, v̄t̄2)` is nonzero in the presented module. -/
theorem witness_ne_zero (k : Type u) [Field k] :
    witness k ≠ 0 := sorry

set_option synthInstance.maxHeartbeats 200000 in
/-- The canonical degree-one map from the presented module to compatible chart sections is not
injective. -/
theorem sectionMap_not_injective (k : Type u) [Field k] :
    ¬ Function.Injective (sectionMap k) := sorry

end AlgebraicGeometry.Proj.DegreeOneCounterexample
