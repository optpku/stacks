module

public import Mathlib.Algebra.Module.ULift
public import Mathlib.Algebra.Polynomial.AlgebraMap
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.TensorProduct.Basic

/-!
# The coordinate ring of the roots-of-unity group scheme

This module defines the quotient presentation of the coordinate ring of roots of unity,
its distinguished coordinate, and the comultiplication determined by that coordinate.
-/

@[expose] public section

noncomputable section

open scoped TensorProduct

universe u

namespace AlgebraicGeometry.RootsOfUnity

/-- The principal ideal generated by `X ^ n - 1` in `(ULift ℤ)[X]`. -/
abbrev relationIdeal (n : ℕ) : Ideal (Polynomial (ULift.{u} ℤ)) :=
  Ideal.span {Polynomial.X ^ n - (1 : Polynomial (ULift.{u} ℤ))}

/-- The coordinate ring `(ULift ℤ)[X] ⨸ (X ^ n - 1)` of the scheme of `n`th roots of unity. -/
abbrev coordinateRing (n : ℕ) :=
  Polynomial (ULift.{u} ℤ) ⧸ relationIdeal n

/-- The canonical quotient commutative-ring structure on `coordinateRing n`. -/
instance (priority := 2000) instCommRingCoordinateRing (n : ℕ) :
    CommRing (coordinateRing.{u} n) :=
  Ideal.Quotient.commRing (relationIdeal n)

/-- The scalar module on `coordinateRing n` induced by its quotient algebra over `ULift ℤ`. -/
instance (priority := 2000) instModuleCoordinateRing (n : ℕ) :
    Module (ULift.{u} ℤ) (coordinateRing.{u} n) :=
  @Algebra.toModule (ULift.{u} ℤ) (coordinateRing.{u} n) _ _
    (Ideal.Quotient.algebra (ULift.{u} ℤ))

/-- The distinguished coordinate in `coordinateRing n`. -/
def generator (n : ℕ) : coordinateRing.{u} n :=
  Ideal.Quotient.mk (relationIdeal n) Polynomial.X

/-- The distinguished coordinate is an `n`th root of unity. -/
theorem generator_pow (n : ℕ) : generator.{u} n ^ n = 1 := by
  rw [show generator.{u} n =
    Ideal.Quotient.mk (relationIdeal n) Polynomial.X by rfl]
  rw [← map_pow]
  refine Ideal.Quotient.eq.2 ?_
  have hrel : Polynomial.X ^ n - (1 : Polynomial (ULift.{u} ℤ)) ∈
      ({Polynomial.X ^ n - (1 : Polynomial (ULift.{u} ℤ))} :
        Set (Polynomial (ULift.{u} ℤ))) := Set.mem_singleton _
  simpa [relationIdeal] using Ideal.subset_span hrel

/-- Evaluation at an `n`th root annihilates the roots-of-unity relation. -/
private theorem eval₂_eq_zero_of_mem_relationIdeal
    {A : Type u} [CommRing A] [Algebra (ULift.{u} ℤ) A]
    (n : ℕ) (x : A) (hx : x ^ n = 1) :
    ∀ p ∈ relationIdeal n,
      Polynomial.eval₂RingHom (algebraMap (ULift.{u} ℤ) A) x p = 0 := by
  intro p hp
  rcases (Ideal.mem_span_singleton.mp (by simpa [relationIdeal] using hp)) with ⟨q, rfl⟩
  simp [hx]

namespace CoordinateRing

/-- Evaluation at `generator n ⊗ₜ generator n` annihilates the roots-of-unity relation. -/
private theorem comul_descends (n : ℕ) :
    ∀ p ∈ relationIdeal n,
      Polynomial.eval₂RingHom
        (algebraMap (ULift.{u} ℤ)
          (coordinateRing.{u} n ⊗[ULift.{u} ℤ] coordinateRing.{u} n))
        (generator.{u} n ⊗ₜ[ULift.{u} ℤ] generator.{u} n) p = 0 := by
  have hpow : ∀ k : ℕ,
      (generator.{u} n ⊗ₜ[ULift.{u} ℤ] generator.{u} n) ^ k =
        (generator.{u} n ^ k) ⊗ₜ[ULift.{u} ℤ] (generator.{u} n ^ k) := by
    intro k
    induction k with
    | zero =>
        exact Algebra.TensorProduct.one_def
          (R := ULift.{u} ℤ) (A := coordinateRing.{u} n)
          (B := coordinateRing.{u} n)
    | succ k ih =>
        rw [pow_succ, ih]
        change
          ((generator.{u} n ^ k) ⊗ₜ[ULift.{u} ℤ] (generator.{u} n ^ k)) *
              (generator.{u} n ⊗ₜ[ULift.{u} ℤ] generator.{u} n) =
            (generator.{u} n ^ (k + 1)) ⊗ₜ[ULift.{u} ℤ]
              (generator.{u} n ^ (k + 1))
        rw [Algebra.TensorProduct.tmul_mul_tmul]
        rfl
  have hx :
      (generator.{u} n ⊗ₜ[ULift.{u} ℤ] generator.{u} n) ^ n = 1 := by
    calc
      (generator.{u} n ⊗ₜ[ULift.{u} ℤ] generator.{u} n) ^ n =
          (generator.{u} n ^ n) ⊗ₜ[ULift.{u} ℤ]
            (generator.{u} n ^ n) := hpow n
      _ = 1 := by
        simpa [generator_pow] using
          (Algebra.TensorProduct.one_def
            (R := ULift.{u} ℤ) (A := coordinateRing.{u} n)
            (B := coordinateRing.{u} n)).symm
  exact eval₂_eq_zero_of_mem_relationIdeal
    (A := coordinateRing.{u} n ⊗[ULift.{u} ℤ] coordinateRing.{u} n)
    n (generator.{u} n ⊗ₜ[ULift.{u} ℤ] generator.{u} n) hx

/-- The coordinate-ring comultiplication sending the universal coordinate to its tensor square. -/
def comul (n : ℕ) :
    coordinateRing.{u} n →+*
      coordinateRing.{u} n ⊗[ULift.{u} ℤ] coordinateRing.{u} n :=
  Ideal.Quotient.lift (relationIdeal n)
    (Polynomial.eval₂RingHom
      (algebraMap (ULift.{u} ℤ)
        (coordinateRing.{u} n ⊗[ULift.{u} ℤ] coordinateRing.{u} n))
      (generator.{u} n ⊗ₜ[ULift.{u} ℤ] generator.{u} n))
    (by
      have hpow : ∀ k : ℕ,
          (generator.{u} n ⊗ₜ[ULift.{u} ℤ] generator.{u} n) ^ k =
            (generator.{u} n ^ k) ⊗ₜ[ULift.{u} ℤ] (generator.{u} n ^ k) := by
        intro k
        induction k with
        | zero =>
            exact Algebra.TensorProduct.one_def
              (R := ULift.{u} ℤ) (A := coordinateRing.{u} n)
              (B := coordinateRing.{u} n)
        | succ k ih =>
            rw [pow_succ, ih]
            change
              ((generator.{u} n ^ k) ⊗ₜ[ULift.{u} ℤ] (generator.{u} n ^ k)) *
                  (generator.{u} n ⊗ₜ[ULift.{u} ℤ] generator.{u} n) =
                (generator.{u} n ^ (k + 1)) ⊗ₜ[ULift.{u} ℤ]
                  (generator.{u} n ^ (k + 1))
            rw [Algebra.TensorProduct.tmul_mul_tmul]
            rfl
      have hx :
          (generator.{u} n ⊗ₜ[ULift.{u} ℤ] generator.{u} n) ^ n = 1 := by
        calc
          (generator.{u} n ⊗ₜ[ULift.{u} ℤ] generator.{u} n) ^ n =
              (generator.{u} n ^ n) ⊗ₜ[ULift.{u} ℤ]
                (generator.{u} n ^ n) := hpow n
          _ = 1 := by
            simpa [generator_pow] using
              (Algebra.TensorProduct.one_def
                (R := ULift.{u} ℤ) (A := coordinateRing.{u} n)
                (B := coordinateRing.{u} n)).symm
      intro p hp
      rcases (Ideal.mem_span_singleton.mp (by simpa [relationIdeal] using hp)) with ⟨q, rfl⟩
      simp [hx])

/-- Comultiplication sends the universal coordinate to its tensor square. -/
theorem comul_generator (n : ℕ) :
    comul.{u} n (generator.{u} n) =
      generator.{u} n ⊗ₜ[ULift.{u} ℤ] generator.{u} n := sorry

end CoordinateRing
end AlgebraicGeometry.RootsOfUnity
