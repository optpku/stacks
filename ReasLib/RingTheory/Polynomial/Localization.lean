module

public import Mathlib.Algebra.Polynomial.AlgebraMap
public import Mathlib.RingTheory.Localization.AtPrime.Basic

@[expose] public section

noncomputable section

universe u

namespace Polynomial

variable {A : Type u} [CommRing A]

/-- The ideal of polynomials whose value at `a` belongs to `m`. -/
def evaluationIdeal (m : Ideal A) (a : A) : Ideal A[X] :=
  Ideal.comap (evalRingHom a) m

/-- Membership in an evaluation ideal is characterized by evaluation. -/
theorem mem_evaluationIdeal {m : Ideal A} {a : A} {p : A[X]} :
    p ∈ evaluationIdeal m a ↔ eval a p ∈ m := sorry

/-- An evaluation ideal is generated by the coefficient ideal and the corresponding linear factor. -/
theorem evaluationIdeal_eq_mapC_sup_XSubC (m : Ideal A) (a : A) :
    evaluationIdeal m a = m.map C ⊔ Ideal.span {X - C a} := sorry

/-- Evaluation ideals are the smallest ideals containing the displayed generators. -/
theorem evaluationIdeal_le_iff {m : Ideal A} {a : A} {I : Ideal A[X]} :
    evaluationIdeal m a ≤ I ↔ m.map C ≤ I ∧ X - C a ∈ I := sorry

/-- The evaluation ideal of a maximal ideal is maximal. -/
instance evaluationIdeal.isMaximal (m : Ideal A) (a : A) [m.IsMaximal] :
    (evaluationIdeal m a).IsMaximal :=
  Ideal.comap_isMaximal_of_surjective (evalRingHom a) (eval_surjective a)

/-- Translation by `a - b` identifies the evaluation ideals at `a` and `b`. -/
theorem evaluationIdeal_comap_translation (m : Ideal A) (a b : A) :
    evaluationIdeal m a = (evaluationIdeal m b).comap (algEquivAevalXAddC (a - b)) := sorry

/-- For a maximal coefficient ideal, the localizations at any two evaluation ideals
are isomorphic as rings. -/
theorem nonempty_localizationAt_evaluationIdeal (m : Ideal A) (a b : A) [m.IsMaximal] :
    Nonempty (Localization.AtPrime (evaluationIdeal m a) ≃+*
      Localization.AtPrime (evaluationIdeal m b)) := sorry

end Polynomial
