module

public import ReasLib.RingTheory.KrullDimension.Polynomial.ClosedPoint
import StacksCheckRecall

@[expose] public section

/-!
# Closed Points of Affine Space

The generator statement remains a source-facing bridge.  The local-dimension
and regularity clauses reuse their canonical theorem and typeclass owners.

@stack 00OP
-/

universe u

section

variable {k : Type u} [Field k]
variable {n : ℕ}
variable (m : MaximalSpectrum (MvPolynomial (Fin n) k))

/- Lemma 10.114.1 (1): a maximal ideal of `k[x₁, ..., xₙ]` is generated by
`n` elements. -/
@[stacks 00OP "(1)"]
#check MvPolynomial.exists_fin_generators_maximalIdeal m

/- Lemma 10.114.1 (2): the local ring at a closed point has Krull dimension `n`. -/
@[stacks 00OP "(2)"]
#check MvPolynomial.ringKrullDim_localizationAtMaximal m

/- Lemma 10.114.1 (3): the local ring at a closed point is regular. -/
@[stacks 00OP "(3)"]
#check (inferInstance : IsRegularLocalRing (Localization.AtPrime m.asIdeal))

end
