module

public import ReasLib.RingTheory.DividedPowers.Thickening.Category
public import ReasLib.RingTheory.DividedPowers.AdicCompletion
public import ReasLib.RingTheory.RingHom.Quotient
public import Mathlib.RingTheory.AdicCompletion.RingHom

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits
open DividedPowers

universe u v

variable {p : ℕ} [Fact (Nat.Prime p)]
variable {A : Type u} [CommRing A] {I : Ideal A} (γ : DividedPowers I)
variable [Algebra (Localization.AtPrime (Ideal.span ({(p : ℤ)} : Set ℤ))) A]
variable {C : Type v} [CommRing C] (f : A →+* C)
variable (hIC : Ideal.map f I = (⊥ : Ideal C))
variable (h_pC : IsNilpotent (p : C))

universe uA vC

/-- A completed crystalline object is a complete divided-power ring over the base,
with a surjective map to the target whose kernel is its divided-power ideal. -/
public def CompletedCrisObject
    (p : ℕ) [Fact (Nat.Prime p)]
    (A : Type uA) [CommRing A] (I : Ideal A) (γ : DividedPowers I)
    [Algebra (Localization.AtPrime (Ideal.span ({(p : ℤ)} : Set ℤ))) A]
    (C : Type vC) [CommRing C] (f : A →+* C)
    (hIC : Ideal.map f I = (⊥ : Ideal C))
    (h_pC : IsNilpotent (p : C)) :=
  Σ B : DividedPowerRing.{vC}, Σ base : DividedPowers.DPMorphism γ B.dividedPowers,
    { toC : B →+* C //
      (Function.Surjective toC ∧ RingHom.ker toC = B.ideal) ∧
        (toC.comp base.toRingHom = f ∧
          IsAdicComplete (Ideal.span ({(p : B)} : Set B)) B) }

section

variable {γ f hIC h_pC}

/-- The underlying completed divided-power ring. -/
def CompletedCrisObject.B (X : CompletedCrisObject p A I γ C f hIC h_pC) :
    DividedPowerRing.{v} := X.1

/-- The divided-power map from the base ring. -/
def CompletedCrisObject.base (X : CompletedCrisObject p A I γ C f hIC h_pC) :
    DividedPowers.DPMorphism γ X.B.dividedPowers := X.2.1

/-- The quotient map from the completed ring to the target ring. -/
def CompletedCrisObject.toC (X : CompletedCrisObject p A I γ C f hIC h_pC) :
    X.B →+* C := X.2.2.1

/-- The quotient map of a completed crystalline object is surjective. -/
def CompletedCrisObject.surjective (X : CompletedCrisObject p A I γ C f hIC h_pC) :
    Function.Surjective X.toC := X.2.2.2.1.1

/-- The distinguished ideal is the kernel of the map to the target ring. -/
def CompletedCrisObject.kernel_eq (X : CompletedCrisObject p A I γ C f hIC h_pC) :
    RingHom.ker X.toC = X.B.ideal := X.2.2.2.1.2

/-- The base and quotient maps form a commutative square. -/
def CompletedCrisObject.commutative (X : CompletedCrisObject p A I γ C f hIC h_pC) :
    X.toC.comp X.base.toRingHom = f := X.2.2.2.2.1

/-- The underlying ring is complete for the ideal generated by the chosen prime. -/
def CompletedCrisObject.complete (X : CompletedCrisObject p A I γ C f hIC h_pC) :
    IsAdicComplete (Ideal.span ({(p : X.B)} : Set X.B)) X.B := X.2.2.2.2.2

end

/-- The divided-power structure on the underlying completed ring. -/
abbrev CompletedCrisObject.dividedPowers
    (X : CompletedCrisObject p A I γ C f hIC h_pC) :
    DividedPowers X.B.ideal :=
  X.B.dividedPowers

/-- The divided-power structure of a completed crystalline object is that of its underlying ring. -/
theorem CompletedCrisObject.dividedPowers_eq
    (X : CompletedCrisObject p A I γ C f hIC h_pC) :
    X.dividedPowers = X.B.dividedPowers := sorry

/-- Construct completed crystalline-object data from its explicit ring, maps, and laws. -/
def CompletedCrisObject.of
    (B : DividedPowerRing.{v})
    (base : DividedPowers.DPMorphism γ B.dividedPowers)
    (toC : B →+* C)
    (surjective : Function.Surjective toC)
    (kernel_eq : RingHom.ker toC = B.ideal)
    (commutative : toC.comp base.toRingHom = f)
    (complete : IsAdicComplete (Ideal.span ({(p : B)} : Set B)) B) :
    CompletedCrisObject p A I γ C f hIC h_pC :=
  ⟨B, base, toC, ⟨⟨surjective, kernel_eq⟩, commutative, complete⟩⟩

/-- The defining quotient, kernel, commutativity, and completeness conditions for a completed
crystalline object. -/
theorem CompletedCrisObject.spec
    (X : CompletedCrisObject p A I γ C f hIC h_pC) :
    (Function.Surjective X.toC ∧ RingHom.ker X.toC = X.B.ideal) ∧
      (X.toC.comp X.base.toRingHom = f ∧
        IsAdicComplete (Ideal.span ({(p : X.B)} : Set X.B)) X.B) := sorry

/-- The inverse of `C ≅ B ⧸ J` associated to a completed crystalline object. -/
def CompletedCrisObject.quotientMap
    (X : CompletedCrisObject p A I γ C f hIC h_pC) :
    C →+* (X.B ⧸ X.B.ideal) :=
  (Ideal.quotEquivOfEq X.kernel_eq).toRingHom.comp
    (X.toC.quotientKerEquivOfSurjective X.surjective).symm.toRingHom

/-- A completed crystalline object with nilpotent `p` is a divided-power thickening. -/
def CompletedCrisObject.toThickening
    (X : CompletedCrisObject p A I γ C f hIC h_pC)
    (h : IsNilpotent (p : X.B)) :
    DividedPowerThickening p A I γ C f hIC h_pC :=
  DividedPowerThickening.of γ f hIC h_pC X.B X.base h X.quotientMap sorry

/-- A completed crystalline object with nilpotent `p` is a `Cris` thickening. -/
def CompletedCrisObject.toCris
    (X : CompletedCrisObject p A I γ C f hIC h_pC)
    (h : IsNilpotent (p : X.B)) :
    DividedPowerThickening.Cris γ f hIC h_pC :=
  ⟨CompletedCrisObject.toThickening γ f hIC h_pC X h, sorry⟩

/-- Recover a completed crystalline object from a `Cris` thickening. -/
def CompletedCrisObject.ofCris
    (T : DividedPowerThickening.Cris γ f hIC h_pC) :
    CompletedCrisObject p A I γ C f hIC h_pC :=
  CompletedCrisObject.of γ f hIC h_pC T.obj.B T.obj.base
    (DividedPowerThickening.Cris.toC γ f hIC h_pC T) sorry sorry sorry sorry

/-- The first-isomorphism quotient of a completed crystalline object is an isomorphism. -/
theorem CompletedCrisObject.isIso_quotientMap
    (X : CompletedCrisObject p A I γ C f hIC h_pC) :
    IsIso (CommRingCat.ofHom X.quotientMap) := sorry

namespace CompletedCris

/-- A morphism of completed crystalline objects is a divided-power map over the base
and the target rings. -/
def Hom (X Y : CompletedCrisObject p A I γ C f hIC h_pC) :=
  { map : DPMorphism X.B.dividedPowers Y.B.dividedPowers //
    map.toRingHom.comp X.base.toRingHom = Y.base.toRingHom ∧
      Y.toC.comp map.toRingHom = X.toC }

section

variable {γ f hIC h_pC}

/-- The underlying divided-power morphism. -/
def Hom.map {X Y : CompletedCrisObject p A I γ C f hIC h_pC}
    (u : Hom γ f hIC h_pC X Y) : DPMorphism X.B.dividedPowers Y.B.dividedPowers := u.1

/-- A completed crystalline morphism commutes with the base maps. -/
def Hom.base_comm {X Y : CompletedCrisObject p A I γ C f hIC h_pC}
    (u : Hom γ f hIC h_pC X Y) :
    u.map.toRingHom.comp X.base.toRingHom = Y.base.toRingHom := u.2.1

/-- A completed crystalline morphism commutes with the maps to the target ring. -/
def Hom.quotient_comm {X Y : CompletedCrisObject p A I γ C f hIC h_pC}
    (u : Hom γ f hIC h_pC X Y) :
    Y.toC.comp u.map.toRingHom = X.toC := u.2.2

end

/-- Construct a morphism from its divided-power map and the two compatibility equations. -/
def Hom.of {X Y : CompletedCrisObject p A I γ C f hIC h_pC}
    (map : DPMorphism X.B.dividedPowers Y.B.dividedPowers)
    (base_comm : map.toRingHom.comp X.base.toRingHom = Y.base.toRingHom)
    (quotient_comm : Y.toC.comp map.toRingHom = X.toC) :
    Hom γ f hIC h_pC X Y :=
  ⟨map, base_comm, quotient_comm⟩

/-- The two compatibility equations defining a completed crystalline morphism. -/
theorem Hom.spec {X Y : CompletedCrisObject p A I γ C f hIC h_pC}
    (u : Hom γ f hIC h_pC X Y) :
    (u.map.toRingHom).comp X.base.toRingHom = Y.base.toRingHom ∧
      Y.toC.comp u.map.toRingHom = X.toC := sorry

/-- Transport a completed crystalline morphism to a thickening morphism. -/
def Hom.toThickeningHom {X Y : CompletedCrisObject p A I γ C f hIC h_pC}
    (hX : IsNilpotent (p : X.B)) (hY : IsNilpotent (p : Y.B))
    (u : Hom γ f hIC h_pC X Y) :
    DividedPowerThickening.Hom γ f (CompletedCrisObject.toThickening γ f hIC h_pC X hX)
      (CompletedCrisObject.toThickening γ f hIC h_pC Y hY) :=
  DividedPowerThickening.Hom.of γ f u.map u.base_comm sorry

/-- Transport a thickening morphism to a completed crystalline morphism. -/
def Hom.ofThickeningHom {X Y : DividedPowerThickening.Cris γ f hIC h_pC}
    (u : X.obj ⟶ Y.obj) :
    Hom γ f hIC h_pC (CompletedCrisObject.ofCris γ f hIC h_pC X)
      (CompletedCrisObject.ofCris γ f hIC h_pC Y) :=
  Hom.of γ f hIC h_pC u.map u.base_comm sorry

/-- The identity morphism of a completed crystalline object. -/
def Hom.id (X : CompletedCrisObject p A I γ C f hIC h_pC) : Hom γ f hIC h_pC X X :=
  Hom.of γ f hIC h_pC (DPMorphism.id X.B.dividedPowers) sorry sorry

/-- Composition of completed crystalline morphisms. -/
def Hom.comp {X Y Z : CompletedCrisObject p A I γ C f hIC h_pC}
    (u : Hom γ f hIC h_pC X Y) (v : Hom γ f hIC h_pC Y Z) : Hom γ f hIC h_pC X Z :=
  Hom.of γ f hIC h_pC (DPMorphism.comp v.map u.map) sorry sorry

/-- The category structure on completed crystalline objects. -/
instance category : Category.{v} (CompletedCrisObject p A I γ C f hIC h_pC) where
  Hom := Hom γ f hIC h_pC
  id := Hom.id γ f hIC h_pC
  comp := fun u v ↦ Hom.comp γ f hIC h_pC u v
  id_comp := sorry
  comp_id := sorry
  assoc := sorry

/-- The property selecting completed crystalline objects for which `p` is nilpotent. -/
def isCrisObject : ObjectProperty (CompletedCrisObject p A I γ C f hIC h_pC) :=
  fun X ↦ IsNilpotent (p : X.B)

/-- The nilpotent full subcategory of completed crystalline objects. -/
abbrev nilpotentCris := (isCrisObject γ f hIC h_pC).FullSubcategory

/-- An object of the nilpotent full subcategory carries the nilpotence condition. -/
theorem mem_nilpotentCris (X : nilpotentCris γ f hIC h_pC) : IsNilpotent (p : X.obj.B) := X.property

/-- The functor from nilpotent completed crystalline objects to crystalline thickenings. -/
def toCrisFunctor : nilpotentCris γ f hIC h_pC ⥤ DividedPowerThickening.Cris γ f hIC h_pC where
  obj X := CompletedCrisObject.toCris γ f hIC h_pC X.obj X.property
  map {X Y} u := ⟨Hom.toThickeningHom γ f hIC h_pC X.property Y.property u.hom⟩

/-- The functor from crystalline thickenings to nilpotent completed crystalline objects. -/
def ofCrisFunctor : DividedPowerThickening.Cris γ f hIC h_pC ⥤ nilpotentCris γ f hIC h_pC where
  obj T := ⟨CompletedCrisObject.ofCris γ f hIC h_pC T, T.obj.p_nilpotent⟩
  map {X Y} u := ⟨Hom.ofThickeningHom γ f hIC h_pC u.hom⟩


/-- Nilpotent completed crystalline objects are equivalent to crystalline thickenings. -/
instance equivalenceCris : (toCrisFunctor γ f hIC h_pC).IsEquivalence := sorry

/-- The forward identification sends a nilpotent completed object to its `Cris` thickening. -/
theorem toCrisFunctor_obj (X : nilpotentCris γ f hIC h_pC) :
    (toCrisFunctor γ f hIC h_pC).obj X =
      CompletedCrisObject.toCris γ f hIC h_pC X.obj X.property := sorry

/-- The inverse identification recovers a nilpotent completed object from a `Cris` thickening. -/
theorem ofCrisFunctor_obj (T : DividedPowerThickening.Cris γ f hIC h_pC) :
    (ofCrisFunctor γ f hIC h_pC).obj T =
      ⟨CompletedCrisObject.ofCris γ f hIC h_pC T, T.obj.p_nilpotent⟩ := sorry

end CompletedCris

open DividedPowers

/-- The least exponent at which the chosen prime vanishes in the target ring. -/
noncomputable def CompletedCris.nilpotenceExponent {p : ℕ} {C : Type v} [CommRing C]
    (h_pC : IsNilpotent (p : C)) : ℕ :=
  @Nat.find (fun n : ℕ ↦ (p : C) ^ n = 0)
    (fun n ↦ Classical.propDecidable ((p : C) ^ n = 0)) h_pC

/-- The nilpotence exponent gives a vanishing power and all smaller powers are nonzero. -/
theorem CompletedCris.nilpotenceExponent_spec {p : ℕ} {C : Type v} [CommRing C]
    (h_pC : IsNilpotent (p : C)) :
    (p : C) ^ CompletedCris.nilpotenceExponent h_pC = 0 ∧
      ∀ n < CompletedCris.nilpotenceExponent h_pC, (p : C) ^ n ≠ 0 := sorry

/-- The uniform crystalline offset is twice the nilpotence exponent in the target ring. -/
noncomputable def pAdicOffset (X : CompletedCrisObject p A I γ C f hIC h_pC) : ℕ :=
  2 * CompletedCris.nilpotenceExponent h_pC

/-- All completed crystalline objects over the same target have the same offset. -/
theorem pAdicOffset_eq (X Y : CompletedCrisObject p A I γ C f hIC h_pC) :
    pAdicOffset γ f hIC h_pC X = pAdicOffset γ f hIC h_pC Y := sorry

/-- The uniform offset gives kernel containment and stability under divided powers. -/
theorem pAdicOffset_spec (X : CompletedCrisObject p A I γ C f hIC h_pC) :
    Ideal.span ({(p : X.B)} : Set X.B) ^ pAdicOffset γ f hIC h_pC X ≤ RingHom.ker X.toC ∧
      IsStableUnderPowers X.B.dividedPowers (Ideal.span ({(p : X.B)} : Set X.B))
        (pAdicOffset γ f hIC h_pC X) := sorry

/-- The exponent used at stage `e` of the `p`-adic inverse system. -/
noncomputable def pAdicExponent (X : CompletedCrisObject p A I γ C f hIC h_pC) (e : ℕ) : ℕ :=
  e + pAdicOffset γ f hIC h_pC X

/-- Unfold the stage exponent as an offset shift. -/
theorem pAdicExponent_eq (X : CompletedCrisObject p A I γ C f hIC h_pC) (e : ℕ) :
    pAdicExponent γ f hIC h_pC X e = e + pAdicOffset γ f hIC h_pC X := sorry

/-- The `e`th `p`-adic quotient divided-power ring of a completed crystalline object. -/
noncomputable def pAdicQuotientRing (X : CompletedCrisObject p A I γ C f hIC h_pC) (e : ℕ) :
    DividedPowerRing.{v} :=
  QuotientPowerTower.stage X.B.dividedPowers (Ideal.span ({(p : X.B)} : Set X.B))
    (pAdicOffset γ f hIC h_pC X) (pAdicOffset_spec γ f hIC h_pC X).2 e

/-- The `e`th stage is the quotient of `X.B` by the corresponding power of `(p)`. -/
theorem pAdicQuotientRing_eq (X : CompletedCrisObject p A I γ C f hIC h_pC) (e : ℕ) :
    pAdicQuotientRing γ f hIC h_pC X e =
      QuotientPowerTower.stage X.B.dividedPowers (Ideal.span ({(p : X.B)} : Set X.B))
        (pAdicOffset γ f hIC h_pC X) (pAdicOffset_spec γ f hIC h_pC X).2 e := sorry


/-- The quotient map of a stage preserves divided powers. -/
theorem pAdicQuotientMk_isDPMorphism (X : CompletedCrisObject p A I γ C f hIC h_pC) (e : ℕ) :
    IsDPMorphism X.B.dividedPowers (pAdicQuotientRing γ f hIC h_pC X e).dividedPowers
      (Ideal.Quotient.mk (Ideal.span ({(p : X.B)} : Set X.B) ^
        pAdicExponent γ f hIC h_pC X e)) := sorry

/-- The canonical divided-power map from `X.B` onto its `e`th `p`-adic quotient. -/
noncomputable def pAdicQuotientMk (X : CompletedCrisObject p A I γ C f hIC h_pC) (e : ℕ) :
    DPMorphism X.B.dividedPowers (pAdicQuotientRing γ f hIC h_pC X e).dividedPowers :=
  DPMorphism.mk' (pAdicQuotientMk_isDPMorphism γ f hIC h_pC X e)

/-- The surjection `B / p^{e+N} B → C` at a crystalline stage. -/
noncomputable def pAdicQuotientToC (X : CompletedCrisObject p A I γ C f hIC h_pC) (e : ℕ) :
    pAdicQuotientRing γ f hIC h_pC X e →+* C :=
  Ideal.Quotient.lift
    (Ideal.span ({(p : X.B)} : Set X.B) ^ pAdicExponent γ f hIC h_pC X e) X.toC
    (fun _ _ ↦ sorry)

/-- The kernel of the stage map to `C` is the distinguished divided-power ideal. -/
theorem pAdicQuotientToC_ker (X : CompletedCrisObject p A I γ C f hIC h_pC) (e : ℕ) :
    RingHom.ker (pAdicQuotientToC γ f hIC h_pC X e) =
      (pAdicQuotientRing γ f hIC h_pC X e).ideal := sorry

/-- The stage map to `C` is surjective. -/
theorem pAdicQuotientToC_surjective (X : CompletedCrisObject p A I γ C f hIC h_pC) (e : ℕ) :
    Function.Surjective (pAdicQuotientToC γ f hIC h_pC X e) := sorry

/-- The `e`th `p`-adic quotient as a divided-power thickening of `C`. -/
noncomputable def pAdicQuotientThickening (X : CompletedCrisObject p A I γ C f hIC h_pC)
    (e : ℕ) : DividedPowerThickening p A I γ C f hIC h_pC :=
  DividedPowerThickening.of γ f hIC h_pC (pAdicQuotientRing γ f hIC h_pC X e)
    (DPMorphism.comp (pAdicQuotientMk γ f hIC h_pC X e) X.base) sorry
    ((Ideal.quotEquivOfEq (pAdicQuotientToC_ker γ f hIC h_pC X e)).toRingHom.comp
      ((pAdicQuotientToC γ f hIC h_pC X e).quotientKerEquivOfSurjective
        (pAdicQuotientToC_surjective γ f hIC h_pC X e)).symm.toRingHom) sorry

/-- The `e`th `p`-adic quotient lies in `Cris(C/A)`. -/
noncomputable def pAdicQuotientStage (X : CompletedCrisObject p A I γ C f hIC h_pC) (e : ℕ) :
    DividedPowerThickening.Cris γ f hIC h_pC :=
  ⟨pAdicQuotientThickening γ f hIC h_pC X e, sorry⟩

/-- The stage object is the bundled `p`-adic quotient thickening. -/
theorem pAdicQuotientStage_obj (X : CompletedCrisObject p A I γ C f hIC h_pC) (e : ℕ) :
    (pAdicQuotientStage γ f hIC h_pC X e).obj =
      pAdicQuotientThickening γ f hIC h_pC X e := sorry

/-- The canonical transition from stage `e + 1` to stage `e`. -/
noncomputable def pAdicQuotientStep (X : CompletedCrisObject p A I γ C f hIC h_pC) (e : ℕ) :
    pAdicQuotientStage γ f hIC h_pC X (e + 1) ⟶ pAdicQuotientStage γ f hIC h_pC X e :=
  ⟨DividedPowerThickening.Hom.of γ f
    (QuotientPowerTower.step X.B.dividedPowers (Ideal.span ({(p : X.B)} : Set X.B))
      (pAdicOffset γ f hIC h_pC X) (pAdicOffset_spec γ f hIC h_pC X).2 e) sorry sorry⟩

/-- The inverse system of stable prime-power quotient crystalline thickenings. -/
noncomputable def pAdicQuotientSystem (X : CompletedCrisObject p A I γ C f hIC h_pC) :
    ℕᵒᵖ ⥤ DividedPowerThickening.Cris γ f hIC h_pC :=
  Functor.ofOpSequence (pAdicQuotientStep γ f hIC h_pC X)

/-- The value of the inverse system at `e` is the corresponding `p`-adic quotient stage. -/
theorem pAdicQuotientSystem_obj (X : CompletedCrisObject p A I γ C f hIC h_pC) (e : ℕ) :
    (pAdicQuotientSystem γ f hIC h_pC X).obj (Opposite.op e) =
      pAdicQuotientStage γ f hIC h_pC X e := sorry

/-- The `p`-adic inverse system, viewed in the completed crystalline category. -/
noncomputable def pAdicQuotientSystemCompleted
    (X : CompletedCrisObject p A I γ C f hIC h_pC) :
    ℕᵒᵖ ⥤ CompletedCrisObject p A I γ C f hIC h_pC :=
  pAdicQuotientSystem γ f hIC h_pC X ⋙
    CompletedCris.ofCrisFunctor γ f hIC h_pC ⋙
      (CompletedCris.isCrisObject γ f hIC h_pC).ι

/-- Unfold the completed-category inverse system. -/
theorem pAdicQuotientSystemCompleted_obj
    (X : CompletedCrisObject p A I γ C f hIC h_pC) (e : ℕ) :
    (pAdicQuotientSystemCompleted γ f hIC h_pC X).obj (Opposite.op e) =
      CompletedCrisObject.ofCris γ f hIC h_pC
        (pAdicQuotientStage γ f hIC h_pC X e) := sorry

/-- The completed object as a cone point over its `p`-adic stages in `Cris^wedge(C/A)`. -/
noncomputable def pAdicQuotientConeπ (X : CompletedCrisObject p A I γ C f hIC h_pC) (e : ℕ) :
    X ⟶ (pAdicQuotientSystemCompleted γ f hIC h_pC X).obj (Opposite.op e) :=
  CompletedCris.Hom.of γ f hIC h_pC
    (DPMorphism.comp (DPMorphism.id (pAdicQuotientRing γ f hIC h_pC X e).dividedPowers)
      (pAdicQuotientMk γ f hIC h_pC X e))
    sorry sorry

/-- The inverse-system cone of a completed crystalline object. -/
noncomputable def pAdicQuotientCone (X : CompletedCrisObject p A I γ C f hIC h_pC) :
    Cone (pAdicQuotientSystemCompleted γ f hIC h_pC X) where
  pt := X
  π :=
    { app := fun e ↦ pAdicQuotientConeπ γ f hIC h_pC X e.unop
      naturality := fun {_ _} _ ↦ sorry }

/-- The cone face at stage `n`, reindexed as a map into the quotient by the `n`th power of `(p)`. -/
noncomputable def pAdicQuotientCone.stageFamily (X : CompletedCrisObject p A I γ C f hIC h_pC)
    (s : Cone (pAdicQuotientSystemCompleted γ f hIC h_pC X)) (n : ℕ) :
    s.pt.B →+* X.B ⧸ Ideal.span ({(p : X.B)} : Set X.B) ^ n :=
  (Ideal.Quotient.factorPow (Ideal.span ({(p : X.B)} : Set X.B))
      (Nat.le_add_right n (pAdicOffset γ f hIC h_pC X))).comp
    (s.π.app (Opposite.op n)).map.toRingHom

/-- The reindexed stage family is compatible with the canonical factor maps. -/
theorem pAdicQuotientCone.stageFamily_compat (X : CompletedCrisObject p A I γ C f hIC h_pC)
    (s : Cone (pAdicQuotientSystemCompleted γ f hIC h_pC X)) {m n : ℕ} (hle : m ≤ n) :
    (Ideal.Quotient.factorPow (Ideal.span ({(p : X.B)} : Set X.B)) hle).comp
        (pAdicQuotientCone.stageFamily γ f hIC h_pC X s n) =
      pAdicQuotientCone.stageFamily γ f hIC h_pC X s m := sorry

/-- The unique `p`-adic limit of the cone's stage maps into the completed ring `X.B`. -/
noncomputable def pAdicQuotientCone.liftRing (X : CompletedCrisObject p A I γ C f hIC h_pC)
    (s : Cone (pAdicQuotientSystemCompleted γ f hIC h_pC X)) :
    s.pt.B →+* X.B :=
  (@AdicCompletion.ofAlgEquiv X.B _ (Ideal.span ({(p : X.B)} : Set X.B))
      X.complete).symm.toRingHom.comp
    (AdicCompletion.liftRingHom (Ideal.span ({(p : X.B)} : Set X.B))
      (pAdicQuotientCone.stageFamily γ f hIC h_pC X s)
      (fun {_ _} hle ↦ pAdicQuotientCone.stageFamily_compat γ f hIC h_pC X s hle))

/-- The lifted ring map preserves divided powers. -/
theorem pAdicQuotientCone.liftRing_isDPMorphism (X : CompletedCrisObject p A I γ C f hIC h_pC)
    (s : Cone (pAdicQuotientSystemCompleted γ f hIC h_pC X)) :
    IsDPMorphism s.pt.dividedPowers X.dividedPowers
      (pAdicQuotientCone.liftRing γ f hIC h_pC X s) := sorry

/-- The unique cone morphism into a completed crystalline object from a cone over its
`p`-adic quotient system. -/
noncomputable def pAdicQuotientCone.lift (X : CompletedCrisObject p A I γ C f hIC h_pC)
    (s : Cone (pAdicQuotientSystemCompleted γ f hIC h_pC X)) :
    s.pt ⟶ X :=
  CompletedCris.Hom.of γ f hIC h_pC
    (DPMorphism.mk' (pAdicQuotientCone.liftRing_isDPMorphism γ f hIC h_pC X s))
    sorry sorry

/-- The lifted comparison map recovers the cone face at every `p`-adic stage. -/
theorem pAdicQuotientCone.lift_fac (X : CompletedCrisObject p A I γ C f hIC h_pC)
    (s : Cone (pAdicQuotientSystemCompleted γ f hIC h_pC X)) (e : ℕ) :
    pAdicQuotientCone.lift γ f hIC h_pC X s ≫
        (pAdicQuotientCone γ f hIC h_pC X).π.app (Opposite.op e) =
      s.π.app (Opposite.op e) := sorry

/-- A completed crystalline object is the limit of its prime-power quotient system. -/
noncomputable def isLimit_pAdicQuotientCone (X : CompletedCrisObject p A I γ C f hIC h_pC) :
    IsLimit (pAdicQuotientCone γ f hIC h_pC X) where
  lift s := pAdicQuotientCone.lift γ f hIC h_pC X s
  fac := sorry
  uniq := sorry

/-- A completed crystalline morphism preserves the equally indexed prime-power ideals. -/
theorem pAdicQuotientHom_ideal (X Y : CompletedCrisObject p A I γ C f hIC h_pC)
    (u : CompletedCris.Hom γ f hIC h_pC X Y) (e : ℕ) :
    Ideal.map u.map.toRingHom
        (Ideal.span ({(p : X.B)} : Set X.B) ^ pAdicExponent γ f hIC h_pC X e) ≤
      Ideal.span ({(p : Y.B)} : Set Y.B) ^ pAdicExponent γ f hIC h_pC Y e := sorry

/-- The ring homomorphism of prime-power quotients induced by a completed crystalline morphism. -/
noncomputable def pAdicQuotientHom (X Y : CompletedCrisObject p A I γ C f hIC h_pC)
    (u : CompletedCris.Hom γ f hIC h_pC X Y) (e : ℕ) :
    pAdicQuotientRing γ f hIC h_pC X e →+* pAdicQuotientRing γ f hIC h_pC Y e :=
  RingHom.quotientByIdeals u.map.toRingHom
    (Ideal.span ({(p : X.B)} : Set X.B) ^ pAdicExponent γ f hIC h_pC X e)
    (Ideal.span ({(p : Y.B)} : Set Y.B) ^ pAdicExponent γ f hIC h_pC Y e)
    (pAdicQuotientHom_ideal γ f hIC h_pC X Y u e)

/-- A completed crystalline morphism induces divided-power maps of `p`-adic quotient stages. -/
theorem pAdicQuotientSystemMap_isDPMorphism {X Y : CompletedCrisObject p A I γ C f hIC h_pC}
    (u : CompletedCris.Hom γ f hIC h_pC X Y) (e : ℕ) :
    IsDPMorphism (pAdicQuotientRing γ f hIC h_pC X e).dividedPowers
      (pAdicQuotientRing γ f hIC h_pC Y e).dividedPowers
      (pAdicQuotientHom γ f hIC h_pC X Y u e) := sorry

/-- The stage map of a completed crystalline morphism. -/
noncomputable def pAdicQuotientSystemApp {X Y : CompletedCrisObject p A I γ C f hIC h_pC}
    (u : CompletedCris.Hom γ f hIC h_pC X Y) (e : ℕ) :
    pAdicQuotientStage γ f hIC h_pC X e ⟶ pAdicQuotientStage γ f hIC h_pC Y e :=
  ⟨DividedPowerThickening.Hom.of γ f
    (DPMorphism.mk' (pAdicQuotientSystemMap_isDPMorphism γ f hIC h_pC u e)) sorry sorry⟩

/-- A morphism of completed objects induces a morphism of their `p`-adic inverse systems. -/
noncomputable def pAdicQuotientSystemMap {X Y : CompletedCrisObject p A I γ C f hIC h_pC}
    (u : CompletedCris.Hom γ f hIC h_pC X Y) :
    pAdicQuotientSystem γ f hIC h_pC X ⟶ pAdicQuotientSystem γ f hIC h_pC Y where
  app e := pAdicQuotientSystemApp γ f hIC h_pC u e.unop
  naturality := fun {_ _} _ ↦ sorry

/-- The morphism of inverse systems at an index is the induced map of `p`-adic quotients. -/
theorem pAdicQuotientSystemMap_app {X Y : CompletedCrisObject p A I γ C f hIC h_pC}
    (u : CompletedCris.Hom γ f hIC h_pC X Y) (e : ℕ) :
    (pAdicQuotientSystemMap γ f hIC h_pC u).app (Opposite.op e) =
      pAdicQuotientSystemApp γ f hIC h_pC u e := sorry
