module

public import Mathlib.Algebra.Module.Projective
public import Mathlib.LinearAlgebra.TensorProduct.RightExactness
public import Mathlib.RingTheory.Finiteness.Defs
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Coefficient ideals of linear maps

The coefficient ideal of a linear map is the canonical ideal generated by all scalar
coefficients obtained by pairing its values with linear functionals on the target.  For a
projective target it detects exactly when the map vanishes after arbitrary extension of scalars;
for a finite source it is finitely generated.
-/

@[expose] public section

open scoped TensorProduct

universe u v w

namespace LinearMap

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]
variable {N : Type w} [AddCommGroup N] [Module R N]

/-- The ideal generated by all values `phi (f m)`, where `m` is in the source and `phi` is an
`R`-linear functional on the target. -/
@[stacks 0F80 "coefficient ideal of a linear map"]
def coefficientIdeal (f : M →ₗ[R] N) : Ideal R :=
  Ideal.span (Set.range fun p : M × (N →ₗ[R] R) ↦ p.2 (f p.1))

/-- The coefficient ideal of the zero map is zero. -/
@[simp]
theorem coefficientIdeal_zero : coefficientIdeal (0 : M →ₗ[R] N) = ⊥ := sorry

/-- Coefficients of a composite are coefficients of the first map paired with functionals
obtained from the second map. -/
theorem coefficientIdeal_comp_le
    {P : Type*} [AddCommGroup P] [Module R P]
    (f : M →ₗ[R] N) (g : N →ₗ[R] P) :
    coefficientIdeal (g.comp f) ≤ coefficientIdeal f := sorry

/-- The coefficient ideal of a sum is contained in the sum of the coefficient ideals. -/
theorem coefficientIdeal_add_le (f g : M →ₗ[R] N) :
    coefficientIdeal (f + g) ≤ coefficientIdeal f + coefficientIdeal g := sorry

/-- Linear equivalences of the target preserve the coefficient ideal. -/
@[simp]
theorem coefficientIdeal_comp_equiv
    {P : Type*} [AddCommGroup P] [Module R P]
    (f : M →ₗ[R] N) (e : N ≃ₗ[R] P) :
    coefficientIdeal (e.toLinearMap.comp f) = coefficientIdeal f := sorry

/-- For a projective target, the coefficient ideal is zero exactly when the map is zero. -/
theorem coefficientIdeal_eq_bot_iff [Module.Projective R N] (f : M →ₗ[R] N) :
    coefficientIdeal f = ⊥ ↔ f = 0 := sorry

/-- For a projective target, an algebra kills the coefficient ideal exactly when the
base-changed linear map is zero. -/
theorem coefficientIdeal_le_ker_iff_baseChange_eq_zero
    [Module.Projective R N] (f : M →ₗ[R] N)
    (S : Type*) [CommRing S] [Algebra R S] :
    coefficientIdeal f ≤ RingHom.ker (algebraMap R S) ↔ f.baseChange S = 0 := sorry

/-- A map into a projective module admits an ideal whose image in every scalar extension
vanishes exactly when the base-changed map is zero. -/
theorem exists_ideal_baseChange_eq_zero_iff [Module.Projective R N]
    (f : M →ₗ[R] N) :
    ∃ I : Ideal R, ∀ (S : Type*) [CommRing S] [Algebra R S],
      f.baseChange S = 0 ↔ I.map (algebraMap R S) = ⊥ := sorry

/-- A map from a finite module to a projective module has finitely generated coefficient ideal. -/
theorem coefficientIdeal_fg [Module.Finite R M] [Module.Projective R N]
    (f : M →ₗ[R] N) : (coefficientIdeal f).FG := sorry

/-- A surjective linear map from a projective module becomes bijective after base change
exactly when the scalar extension kills the coefficient ideal of its kernel inclusion. -/
theorem baseChange_bijective_iff_coefficientIdeal [Module.Projective R M]
    (u : M →ₗ[R] N) (hu : Function.Surjective u)
    (S : Type*) [CommRing S] [Algebra R S] :
    Function.Bijective (u.baseChange S) ↔
      (coefficientIdeal (LinearMap.ker u).subtype).map (algebraMap R S) = ⊥ := sorry

/-- A surjective linear map from a projective module admits an ideal whose image in every
scalar extension vanishes exactly when the base-changed map is bijective. -/
theorem exists_ideal_baseChange_bijective_iff [Module.Projective R M]
    (u : M →ₗ[R] N) (hu : Function.Surjective u) :
    ∃ I : Ideal R, ∀ (S : Type*) [CommRing S] [Algebra R S],
      Function.Bijective (u.baseChange S) ↔ I.map (algebraMap R S) = ⊥ := sorry

end LinearMap
