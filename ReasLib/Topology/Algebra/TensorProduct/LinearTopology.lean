module

public import Mathlib.LinearAlgebra.TensorProduct.Quotient
public import Mathlib.Topology.Defs.Basic
public import Mathlib.Topology.Algebra.LinearTopology
public import Mathlib.Topology.UniformSpace.Defs
public import Mathlib.Algebra.Ring.Defs
public import Mathlib.Topology.Algebra.IsUniformGroup.Defs

/-!
# Linear topology on a tensor product

For linearly topologized modules `M` and `N` over a commutative ring `R`, the algebraic
tensor product `M ⊗[R] N` carries the linear topology whose fundamental open submodules are the
images of `U ⊗ N + M ⊗ V` as `U` and `V` run through open submodules. The topology on `R` is
immaterial for this construction.
-/

@[expose] public section

noncomputable section

open Filter TensorProduct
open scoped Topology

universe u

namespace TensorProduct

variable (R M N : Type u)
variable [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]

/-- The image of `U ⊗ N + M ⊗ V` in `M ⊗[R] N`, as an `R`-submodule. -/
def fundamentalSubmodule (U : Submodule R M) (V : Submodule R N) :
    Submodule R (M ⊗[R] N) :=
  LinearMap.range (map U.subtype LinearMap.id) ⊔ LinearMap.range (map LinearMap.id V.subtype)

/-- The fundamental submodule is the kernel of the stage map `M ⊗[R] N → (M ⧸ U) ⊗[R] (N ⧸ V)`. -/
theorem fundamentalSubmodule_eq_ker (U : Submodule R M) (V : Submodule R N) :
    fundamentalSubmodule R M N U V = LinearMap.ker (map U.mkQ V.mkQ) := sorry

/-- Membership in the image of `U ⊗ N + M ⊗ V`. -/
theorem mem_fundamentalSubmodule {U : Submodule R M} {V : Submodule R N} {x : M ⊗[R] N} :
    x ∈ fundamentalSubmodule R M N U V ↔
      x ∈ LinearMap.range (map U.subtype LinearMap.id) ⊔
        LinearMap.range (map LinearMap.id V.subtype) := sorry

/-- Enlarging the open submodules enlarges the corresponding fundamental submodule. -/
theorem fundamentalSubmodule_mono {U U' : Submodule R M} {V V' : Submodule R N}
    (hU : U ≤ U') (hV : V ≤ V') :
    fundamentalSubmodule R M N U V ≤ fundamentalSubmodule R M N U' V' := sorry

variable [TopologicalSpace M] [TopologicalSpace N]
variable [IsLinearTopology R M] [IsLinearTopology R N]

/-- The linear topology on `M ⊗[R] N` induced by the discrete topologies on the stage tensors
`(M ⧸ U) ⊗[R] (N ⧸ V)` as `U ⊆ M` and `V ⊆ N` run through open submodules. -/
@[implicit_reducible]
def linearTopology : TopologicalSpace (M ⊗[R] N) :=
  ⨅ (U : Submodule R M) (V : Submodule R N) (_ : IsOpen (U : Set M))
    (_ : IsOpen (V : Set N)),
    TopologicalSpace.induced (map U.mkQ V.mkQ)
      (⊥ : TopologicalSpace ((M ⧸ U) ⊗[R] (N ⧸ V)))

/-- Each fundamental submodule of open submodules is open in the linear tensor topology. -/
theorem isOpen_fundamentalSubmodule (U : Submodule R M) (V : Submodule R N)
    (hU : IsOpen (U : Set M)) (hV : IsOpen (V : Set N)) :
    IsOpen[linearTopology R M N] (fundamentalSubmodule R M N U V : Set (M ⊗[R] N)) := sorry

/-- The usual tensor product `M ⊗[R] N`, as a type synonym to carry the linear tensor topology
without registering a global topology on `TensorProduct`. -/
def Linear : Type u := M ⊗[R] N

namespace Linear

/-- The linearly topologized tensor product inherits the algebraic additive group structure. -/
instance instAddCommGroup : AddCommGroup (Linear R M N) :=
  inferInstanceAs (AddCommGroup (M ⊗[R] N))

/-- The linearly topologized tensor product inherits the algebraic `R`-module structure. -/
instance instModule : Module R (Linear R M N) :=
  inferInstanceAs (Module R (M ⊗[R] N))

/-- The linear topology on the tensor product of linearly topologized modules. -/
instance instTopologicalSpace : TopologicalSpace (Linear R M N) := linearTopology R M N

variable [IsTopologicalAddGroup M] [IsTopologicalAddGroup N]

/-- Addition and negation are continuous on the linearly topologized tensor product. -/
instance instIsTopologicalAddGroup : IsTopologicalAddGroup (Linear R M N) := sorry

/-- Open submodules form a neighborhood basis of zero on the linearly topologized tensor product. -/
instance instIsLinearTopology : IsLinearTopology R (Linear R M N) := sorry

/-- The underlying algebraic identification of the linearly topologized tensor product. -/
def equiv : Linear R M N ≃ₗ[R] M ⊗[R] N := LinearEquiv.refl R (M ⊗[R] N)

/-- Neighborhoods of zero are generated by the images of `U ⊗ N + M ⊗ V` for open submodules. -/
theorem hasBasis_nhds_zero :
    (𝓝 (0 : Linear R M N)).HasBasis
      (fun UV : Submodule R M × Submodule R N =>
        IsOpen (UV.1 : Set M) ∧ IsOpen (UV.2 : Set N))
      (fun UV =>
        (Linear.equiv R M N) ⁻¹'
          (fundamentalSubmodule R M N UV.1 UV.2 : Set (M ⊗[R] N))) := sorry

/-- The right uniformity of the linearly topologized tensor product, kept as a named definition
to avoid a `UniformSpace`/`TopologicalSpace` diamond on `Linear`. -/
@[implicit_reducible]
def uniformSpace : UniformSpace (Linear R M N) :=
  IsTopologicalAddGroup.rightUniformSpace (Linear R M N)

/-- The canonical additive uniformity of the linearly topologized tensor product. -/
instance instUniformSpace : UniformSpace (Linear R M N) := uniformSpace R M N

/-- A pair of neighborhood bases on the factors induces the tensor-product neighborhood basis. -/
theorem hasBasis_nhds_zero_of_hasBasis {ι κ : Type*}
    (U : ι → Submodule R M) (V : κ → Submodule R N)
    (p : ι → Prop) (q : κ → Prop)
    (hU : ∀ i, p i → IsOpen (U i : Set M))
    (hV : ∀ j, q j → IsOpen (V j : Set N))
    (hM : (𝓝 (0 : M)).HasBasis p (fun i => (U i : Set M)))
    (hN : (𝓝 (0 : N)).HasBasis q (fun j => (V j : Set N))) :
    (𝓝 (0 : Linear R M N)).HasBasis
      (fun ij : ι × κ => p ij.1 ∧ q ij.2)
      (fun ij =>
        (Linear.equiv R M N) ⁻¹'
          (fundamentalSubmodule R M N (U ij.1) (V ij.2) : Set (M ⊗[R] N))) := sorry

variable [TopologicalSpace R] [ContinuousSMul R M] [ContinuousSMul R N]

/-- Scalar multiplication on the tensor product is continuous when both factor actions are. -/
instance instContinuousSMul : ContinuousSMul R (Linear R M N) := sorry

end Linear

end TensorProduct
