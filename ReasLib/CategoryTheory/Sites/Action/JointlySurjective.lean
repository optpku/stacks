module

public import Mathlib.CategoryTheory.Action.Concrete
public import Mathlib.CategoryTheory.Action.Limits
public import Mathlib.CategoryTheory.Sites.JointlySurjective
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import Mathlib.CategoryTheory.Sites.Subcanonical

/-!
# The jointly-surjective site of actions

This module owns the site structure on the category of universe-sized actions of a monoid.  It is
independent of any particular point of the resulting topos.
-/

@[expose] public section

open CategoryTheory

universe u

namespace Action

variable (G : Type u) [Monoid G]

/-- Example 7.6.5 (00VK) (1): the primitive covering families on the category of `G`-sets are
the presieves whose underlying maps are jointly surjective. -/
@[stacks 00VK "(1)"]
abbrev jointlySurjectivePrecoverage : Precoverage (Action (Type u) G) :=
  Types.jointlySurjectivePrecoverage.comap (Action.forget (Type u) G)

/-- Example 7.6.5 (00VK) (2): the Grothendieck topology on `G`-sets generated by the
jointly-surjective precoverage. -/
@[stacks 00VK "(2)"]
abbrev jointlySurjectiveTopology : GrothendieckTopology (Action (Type u) G) :=
  (jointlySurjectivePrecoverage G).toGrothendieck

/-- Example 7.6.5 (00VK) (3): a sieve is covering for the jointly-surjective topology exactly
when its arrows are jointly surjective on the underlying set. -/
@[stacks 00VK "(3)"]
theorem mem_jointlySurjectiveTopology_iff
    {X : Action (Type u) G} {R : Sieve X} :
    R ∈ jointlySurjectiveTopology G X ↔
      ∀ x : X.V, ∃ (Y : Action (Type u) G) (f : Y ⟶ X), R f ∧ x ∈ Set.range f.hom := sorry

/-- The jointly-surjective topology on `G`-sets is subcanonical. -/
instance jointlySurjectiveTopology_subcanonical :
    (jointlySurjectiveTopology G).Subcanonical := sorry

end Action
