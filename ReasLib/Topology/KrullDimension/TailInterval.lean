module

public import Mathlib.Order.KrullDimension
public import Mathlib.Topology.NoetherianSpace
public import Mathlib.Topology.UnitInterval
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Tail Topology on the Unit Interval

A canonical Noetherian topology on the unit interval whose closed endpoint has
infinite codimension.
-/

@[expose] public section

open Set Order TopologicalSpace
open scoped unitInterval

/-- The unit interval equipped with the tail topology. -/
def TailTopologyUnitInterval : Type := I

namespace TailTopologyUnitInterval

/-- The inclusion of an ordinary unit-interval point into the tail-topology copy. -/
def mk (x : I) : TailTopologyUnitInterval := x

/-- The underlying ordinary unit-interval point of a tail-topology point. -/
def val (x : TailTopologyUnitInterval) : I := x

/-- The left endpoint of the tail-topology unit interval. -/
instance instZero : Zero TailTopologyUnitInterval :=
  ⟨mk 0⟩

/-- The cutoff `1 - 1 / n` for the `n`th tail. -/
noncomputable def cut (n : ℕ) : ℝ :=
  1 - 1 / (n : ℝ)

/-- The open tail `(1 - 1 / n, 1]`. -/
noncomputable def openTail (n : ℕ) : Set TailTopologyUnitInterval :=
  {x | cut n < x.val}

/-- The closed initial interval `[0, 1 - 1 / n]`. -/
noncomputable def closedInitial (n : ℕ) : Set TailTopologyUnitInterval :=
  {x | x.val ≤ cut n}

/-- The topology generated by positive-index open tails. -/
@[stacks 02I5 "tail-topology unit interval"]
noncomputable instance topology : TopologicalSpace TailTopologyUnitInterval :=
  TopologicalSpace.generateFrom {U | ∃ n : ℕ, 0 < n ∧ U = openTail n}

/-- The open subsets are empty, the whole interval, and the open tails. -/
@[stacks 02I5 "classification of the open sets"]
theorem isOpen_iff (U : Set TailTopologyUnitInterval) :
    IsOpen U ↔ U = ∅ ∨ U = univ ∨ ∃ n : ℕ, 0 < n ∧ U = openTail n := sorry

/-- The closed subsets are empty, the endpoint, closed initial intervals, and the whole interval. -/
@[stacks 02I5 "classification of the closed sets"]
theorem isClosed_iff (Z : Set TailTopologyUnitInterval) :
    IsClosed Z ↔ Z = ∅ ∨ Z = {0} ∨
      (∃ n : ℕ, 1 < n ∧ Z = closedInitial n) ∨ Z = univ := sorry

/-- The tail-topology unit interval is Noetherian. -/
@[stacks 02I5 "Noetherianity of the tail topology"]
instance noetherianSpace : NoetherianSpace TailTopologyUnitInterval := sorry

/-- Every proper displayed closed initial interval is irreducible. -/
@[stacks 02I5 "irreducibility of the proper closed initial intervals"]
theorem closedInitial_isIrreducible (n : ℕ) (hn : 1 < n) :
    IsIrreducible (closedInitial n) := sorry

/-- The singleton left endpoint is closed in the tail topology. -/
theorem zero_isClosed : IsClosed ({0} : Set TailTopologyUnitInterval) := sorry

/-- The endpoint `{0}`, bundled as an irreducible closed subset. -/
@[stacks 02I5 "the irreducible closed subset Y = {0}"]
def zeroIrreducibleClosed : IrreducibleCloseds TailTopologyUnitInterval :=
  ⟨{0}, isIrreducible_singleton, zero_isClosed⟩

/-- The endpoint irreducible closed subset has infinite codimension. -/
@[stacks 02I5 "infinite codimension of Y = {0}"]
theorem zero_codimension_eq_top :
    coheight zeroIrreducibleClosed = ⊤ := sorry

end TailTopologyUnitInterval
