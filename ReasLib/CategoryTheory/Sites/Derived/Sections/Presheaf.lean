module

public import ReasLib.CategoryTheory.Sites.Cohomology.Ext
public import ReasLib.CategoryTheory.Sites.Derived.Sections
public import ReasLib.CategoryTheory.Sites.Sheafification.FreeAbelian
public import ReasLib.CategoryTheory.DerivedCategory.Functor.TotalRightDerived
public import Mathlib.CategoryTheory.Limits.FunctorCategory.BinaryBiproducts
import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Derived sections attached to set-valued presheaves

This leaf packages the presheaf version of derived sections.  The sheafification and free
abelianization are the canonical functors from the sheafification library; this file only adds
the derived-Hom and Mayer--Vietoris interfaces needed by later arguments.
-/

open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.Preadditive
open CategoryTheory.Pretriangulated
open CategoryTheory.Sheaf
open DerivedCategory
open Opposite

noncomputable section

universe u v

namespace CategoryTheory.GrothendieckTopology.Derived.Sections.Presheaf

section

variable {C : Type u} [Category.{v} C]
variable (J : GrothendieckTopology C)
variable [HasSheafify J AddCommGrpCat.{max u v}]

/- Mathlib keeps the finite-biproduct instance supplied by an abelian category scoped.  The
   derived row below genuinely uses that canonical instance; no object or instance is chosen. -/
attribute [local instance] Abelian.hasFiniteBiproducts

/-- The set-valued sheafification of a presheaf. -/
@[stacks 0EVZ "set-valued sheafification"]
abbrev sheafify (K : Cᵒᵖ ⥤ Type (max u v)) : Sheaf J (Type (max u v)) :=
  (presheafToSheaf J (Type (max u v))).obj K

/-- The morphism induced on set-valued sheafifications. -/
@[stacks 0EVZ "sheafification map"]
abbrev sheafifyMap {K L : Cᵒᵖ ⥤ Type (max u v)} (f : K ⟶ L) :
    sheafify J K ⟶ sheafify J L :=
  (presheafToSheaf J (Type (max u v))).map f

/-- The canonical free-abelian-sheaf functor on a set-valued presheaf. -/
@[stacks 03AA "free abelian sheaf functor"]
abbrev freeFunctor : (Cᵒᵖ ⥤ Type (max u v)) ⥤
    Sheaf J AddCommGrpCat.{max u v} :=
  presheafToSheaf J (Type (max u v)) ⋙ Sheaf.composeAndSheafify J AddCommGrpCat.free

/-- The free abelian sheaf generated by the sheafification of `K`. -/
@[stacks 0EVZ "free abelian sheaf on a sheafification"]
abbrev free (K : Cᵒᵖ ⥤ Type (max u v)) : Sheaf J AddCommGrpCat.{max u v} :=
  (freeFunctor J).obj K

/-- The free-abelian-sheaf map induced by a presheaf morphism. -/
@[stacks 0EVZ "free abelian sheaf map"]
abbrev freeMap {K L : Cᵒᵖ ⥤ Type (max u v)} (f : K ⟶ L) :
    free J K ⟶ free J L :=
  (freeFunctor J).map f

/-- The cochain-level derived-Hom functor attached to `K`. -/
@[stacks 0EVZ "cochain derived sections"]
abbrev toDerived (K : Cᵒᵖ ⥤ Type (max u v)) :
    CochainComplex (Sheaf J AddCommGrpCat.{max u v}) ℤ ⥤
      DerivedCategory AddCommGrpCat.{max u v} :=
  (preadditiveCoyoneda.obj (Opposite.op (free J K))).mapHomologicalComplex
      (ComplexShape.up ℤ) ⋙ DerivedCategory.Q

/-- The quasi-isomorphism property used for the cochain-level derived-Hom functor. -/
@[stacks 0EVZ "cochain quasi-isomorphisms"]
abbrev quasiIso :
    MorphismProperty (CochainComplex (Sheaf J AddCommGrpCat.{max u v}) ℤ) :=
  HomologicalComplex.quasiIso (Sheaf J AddCommGrpCat.{max u v}) (ComplexShape.up ℤ)

/-- The existence of the total right derived functor attached to `K`. -/
@[stacks 0EVZ "cochain derived-functor existence"]
instance toDerived_hasRightDerivedFunctor (K : Cᵒᵖ ⥤ Type (max u v)) :
    (toDerived J K).HasRightDerivedFunctor (quasiIso J) := sorry

/-- The derived sections functor `RΓ(K^#[J], -)`. -/
@[stacks 0EVZ "derived sections over a presheaf"]
abbrev derived (K : Cᵒᵖ ⥤ Type (max u v)) :
    DerivedCategory (Sheaf J AddCommGrpCat.{max u v}) ⥤
      DerivedCategory AddCommGrpCat.{max u v} :=
  (toDerived J K).totalRightDerived
    (DerivedCategory.Q : CochainComplex (Sheaf J AddCommGrpCat.{max u v}) ℤ ⥤
      DerivedCategory (Sheaf J AddCommGrpCat.{max u v}))
    (quasiIso J)

/-- The comparison unit for the derived sections functor. -/
@[stacks 0EVZ "derived sections unit"]
abbrev unit (K : Cᵒᵖ ⥤ Type (max u v)) :
    toDerived J K ⟶
      (DerivedCategory.Q : CochainComplex (Sheaf J AddCommGrpCat.{max u v}) ℤ ⥤
        DerivedCategory (Sheaf J AddCommGrpCat.{max u v})) ⋙ derived J K :=
  (toDerived J K).totalRightDerivedUnit
    (DerivedCategory.Q : CochainComplex (Sheaf J AddCommGrpCat.{max u v}) ℤ ⥤
      DerivedCategory (Sheaf J AddCommGrpCat.{max u v}))
    (quasiIso J)

/-- The cochain-level restriction induced by `f : K ⟶ L`. -/
@[stacks 0EVZ "cochain restriction"]
abbrev cochainRestriction {K L : Cᵒᵖ ⥤ Type (max u v)} (f : K ⟶ L) :
    toDerived J L ⟶ toDerived J K :=
  Functor.whiskerRight
    (NatTrans.mapHomologicalComplex
      (preadditiveCoyoneda.map (freeMap J f).op)
      (ComplexShape.up ℤ))
    DerivedCategory.Q

/-- Equal sheafification maps induce equal cochain restrictions. -/
@[stacks 0EVZ "cochain restriction invariance"]
theorem cochainRestriction_eq_of_sheafifyMap_eq
    {K L : Cᵒᵖ ⥤ Type (max u v)} {f g : K ⟶ L}
    (hfg : sheafifyMap J f = sheafifyMap J g) :
    cochainRestriction J f = cochainRestriction J g := sorry

/-- The derived restriction map `RΓ(L^#[J], -) ⟶ RΓ(K^#[J], -)`. -/
@[stacks 0EVZ "derived restriction"]
abbrev restriction {K L : Cᵒᵖ ⥤ Type (max u v)} (f : K ⟶ L) :
    derived J L ⟶ derived J K :=
  Functor.rightDerivedNatTrans
    (derived J L) (derived J K)
    (unit J L) (unit J K) (quasiIso J) (cochainRestriction J f)

/-- Equal sheafification maps induce equal derived restrictions. -/
@[stacks 0EVZ "derived restriction invariance"]
theorem restriction_eq_of_sheafifyMap_eq
    {K L : Cᵒᵖ ⥤ Type (max u v)} {f g : K ⟶ L}
    (hfg : sheafifyMap J f = sheafifyMap J g) :
    restriction J f = restriction J g := sorry

/-- Derived restrictions compose contravariantly. -/
@[stacks 0EVZ "derived restriction composition"]
theorem restriction_comp
    {K L M : Cᵒᵖ ⥤ Type (max u v)} (f : K ⟶ L) (g : L ⟶ M) :
    restriction J g ≫ restriction J f = restriction J (f ≫ g) := sorry

/-- The first presheaf Mayer--Vietoris map into a derived biproduct. -/
@[stacks 0EVZ "presheaf Mayer--Vietoris first map"]
abbrev toBiprod {E F G : Cᵒᵖ ⥤ Type (max u v)} (c : E ⟶ G) (d : F ⟶ G) :
    derived J G ⟶ (derived J E ⊞ derived J F) :=
  biprod.lift (restriction J c) (restriction J d)

/-- The second presheaf Mayer--Vietoris difference map. -/
@[stacks 0EVZ "presheaf Mayer--Vietoris difference map"]
abbrev difference {D E F : Cᵒᵖ ⥤ Type (max u v)} (a : D ⟶ E) (b : D ⟶ F) :
    (derived J E ⊞ derived J F) ⟶ derived J D :=
  biprod.desc (restriction J a) (-restriction J b)

/-- The canonical presheaf Mayer--Vietoris row is a complex after sheafification. -/
@[stacks 0EVZ "presheaf Mayer--Vietoris row"]
theorem toBiprod_comp_difference
    {D E F G : Cᵒᵖ ⥤ Type (max u v)}
    {a : D ⟶ E} {b : D ⟶ F} {c : E ⟶ G} {d : F ⟶ G}
    (hpushout :
      IsPushout (sheafifyMap J a) (sheafifyMap J b)
        (sheafifyMap J c) (sheafifyMap J d)) :
    toBiprod J c d ≫ difference J a b = 0 := sorry

/-- Lemma 21.26.4 (0EVZ): a sheafified presheaf pushout with monomorphic overlap gives a
functorial distinguished Mayer--Vietoris triangle for derived sections. -/
@[stacks 0EVZ]
theorem exists_triangle
    {D E F G : Cᵒᵖ ⥤ Type (max u v)}
    {a : D ⟶ E} {b : D ⟶ F} {c : E ⟶ G} {d : F ⟶ G}
    (hpushout :
      IsPushout (sheafifyMap J a) (sheafifyMap J b)
        (sheafifyMap J c) (sheafifyMap J d))
    (hmono : Mono (sheafifyMap J b)) :
    ∃ δ : derived J D ⟶ derived J G ⋙
        shiftFunctor (DerivedCategory AddCommGrpCat.{max u v}) (1 : ℤ),
      ∀ K : DerivedCategory (Sheaf J AddCommGrpCat.{max u v}),
        Triangle.mk ((toBiprod J c d).app K) ((difference J a b).app K)
            (δ.app K) ∈ distTriang (DerivedCategory AddCommGrpCat.{max u v}) := sorry

end

end CategoryTheory.GrothendieckTopology.Derived.Sections.Presheaf
