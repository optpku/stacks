module

public import Mathlib.Algebra.Category.ModuleCat.Basic
public import Mathlib.Algebra.Homology.Embedding.Basic
public import Mathlib.Algebra.Homology.Embedding.Extend
public import Mathlib.Algebra.Homology.HomologicalComplex
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.RingTheory.Extension.Cotangent.Basic
public import Mathlib.RingTheory.TensorProduct.Basic

/-!
# Lichtenbaum–Schlessinger complexes of polynomial presentations

The relation quotient, the scalar-extended free module, and the scalar-extended
Kähler differentials form a three-term complex in cohomological degrees −2, −1, and 0.
The canonical tensor-unit map identifies the relation quotient with its scalar extension.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits
open HomologicalComplex
open ZeroObject
open scoped TensorProduct

noncomputable section

universe u

namespace Algebra.Presentation.LichtenbaumSchlessinger

variable {R S ι σ : Type u} [CommRing R] [CommRing S] [Algebra R S]
variable (P : Presentation R S ι σ)

/-- The free `P.Ring`-module on the relation indices of a polynomial presentation. -/
abbrev free : Type u := σ →₀ P.Ring

/-- The module of relations among the defining polynomials of a presentation. -/
def rel : Submodule P.Ring (free P) :=
  LinearMap.ker (Finsupp.linearCombination P.Ring P.relation)

/-- The Koszul vector associated to two defining polynomials of a presentation. -/
def trivialRelGen (i j : σ) : free P :=
  P.relation i • Finsupp.single j (1 : P.Ring) -
    P.relation j • Finsupp.single i (1 : P.Ring)

/-- The submodule generated by the Koszul vectors of a presentation. -/
def trivialRel : Submodule P.Ring (free P) :=
  Submodule.span P.Ring (Set.range (Function.uncurry (trivialRelGen P)))

/-- Every trivial relation is a relation among the defining polynomials. -/
theorem trivialRel_le_rel : trivialRel P ≤ rel P := sorry

/-- Multiplication by an element of the presentation kernel makes any relation trivial. -/
theorem ker_smul_mem_trivialRel :
    ∀ (scalar : P.Ring), scalar ∈ P.ker →
      ∀ relation : rel P, scalar • (relation : free P) ∈ trivialRel P := sorry

/-- The module of relations modulo the trivial relations of a presentation. -/
abbrev relModTrivial :=
  rel P ⧸ (trivialRel P).comap (rel P).subtype

/-- The tensor-unit map identifies the relation quotient with its scalar extension to `S`. -/
theorem relModTrivial_baseChange_bijective :
    Function.Bijective (TensorProduct.mk P.Ring S (relModTrivial P) 1) := sorry

/-- The linear map sending a relation to its tensor with the unit of `S`. -/
def relToTensor : rel P →ₗ[P.Ring] S ⊗[P.Ring] free P :=
  (TensorProduct.mk P.Ring S (free P) 1).comp (rel P).subtype

/-- Trivial relations vanish under scalar extension to `S`. -/
theorem relToTensor_le_ker :
    (trivialRel P).comap (rel P).subtype ≤ LinearMap.ker (relToTensor P) := sorry

/-- The linear map from the relation quotient to the scalar-extended free module. -/
def toFree : relModTrivial P →ₗ[P.Ring] S ⊗[P.Ring] free P :=
  ((trivialRel P).comap (rel P).subtype).liftQ (relToTensor P) (relToTensor_le_ker P)

/-- The scalar extension of the map from the relation quotient to the free module. -/
def toFreeTensor : S ⊗[P.Ring] relModTrivial P →ₗ[S] S ⊗[P.Ring] free P :=
  (toFree P).liftBaseChange S

/-- The map from the relation quotient sends a relation class to its tensor with the unit. -/
theorem toFree_mk (x : rel P) :
    toFree P (Submodule.Quotient.mk x) = 1 ⊗ₜ[P.Ring] (x : free P) := sorry

/-- The scalar-extended first differential sends a tensor of a relation class to that relation. -/
theorem toFreeTensor_tmul_mk (s : S) (x : rel P) :
    toFreeTensor P (s ⊗ₜ[P.Ring] Submodule.Quotient.mk x) = s ⊗ₜ[P.Ring] (x : free P) := sorry

/-- The linear map sending each relation-index basis vector to the differential of its polynomial. -/
def toKaehler : free P →ₗ[P.Ring] Ω[P.Ring⁄R] :=
  Finsupp.linearCombination P.Ring fun t ↦ KaehlerDifferential.D R P.Ring (P.relation t)

/-- The scalar extension of the map differentiating the defining polynomials. -/
def toCotangentSpace : S ⊗[P.Ring] free P →ₗ[S] P.toExtension.CotangentSpace :=
  (toKaehler P).baseChange S

/-- The second differential sends a tensor of a basis vector to the differential of its polynomial. -/
theorem toCotangentSpace_tmul_single (s : S) (t : σ) :
    toCotangentSpace P (s ⊗ₜ[P.Ring] Finsupp.single t (1 : P.Ring)) =
      s ⊗ₜ[P.Ring] KaehlerDifferential.D R P.Ring (P.relation t) := sorry

/-- The two Lichtenbaum–Schlessinger differentials compose to zero. -/
theorem toCotangentSpace_comp_toFreeTensor :
    (toCotangentSpace P).comp (toFreeTensor P) = 0 := sorry

/-- The Lichtenbaum–Schlessinger differentials compose to zero as morphisms of `S`-modules. -/
theorem toCotangentSpace_comp_toFreeTensor_hom :
    ModuleCat.ofHom (toFreeTensor P) ≫ ModuleCat.ofHom (toCotangentSpace P) = 0 := sorry

/-- The three-term Lichtenbaum–Schlessinger chain complex in degrees 0, 1, and 2. -/
def chainComplex : ChainComplex (ModuleCat.{u} S) ℕ :=
  ChainComplex.mk
    (ModuleCat.of S P.toExtension.CotangentSpace)
    (ModuleCat.of S (S ⊗[P.Ring] free P)) (ModuleCat.of S (S ⊗[P.Ring] relModTrivial P))
    (ModuleCat.ofHom (toCotangentSpace P)) (ModuleCat.ofHom (toFreeTensor P))
    (toCotangentSpace_comp_toFreeTensor_hom P) (fun _ ↦ ⟨0, 0, zero_comp⟩)

/-- The degree-one chain differential is the scalar-extended differentiation map. -/
theorem chainComplex_d_one_zero :
    (chainComplex P).d 1 0 = ModuleCat.ofHom (toCotangentSpace P) := sorry

/-- The degree-two chain differential is the scalar-extended relation-quotient map. -/
theorem chainComplex_d_two_one :
    (chainComplex P).d 2 1 = ModuleCat.ofHom (toFreeTensor P) := sorry

/-- The Lichtenbaum–Schlessinger cochain complex, with its three terms in degrees −2, −1, and 0. -/
def complex : CochainComplex (ModuleCat.{u} S) ℤ :=
  (chainComplex P).extend ComplexShape.embeddingDownNat

/-- The degree-zero term is the scalar-extended module of Kähler differentials. -/
def complex_X_zero : (complex P).X 0 ≅ ModuleCat.of S P.toExtension.CotangentSpace :=
  extendXIso (chainComplex P) ComplexShape.embeddingDownNat
    (rfl : ComplexShape.embeddingDownNat.f 0 = 0)

/-- The degree-minus-one term is the scalar-extended free module on the relation indices. -/
def complex_X_negOne : (complex P).X (-1) ≅ ModuleCat.of S (S ⊗[P.Ring] free P) :=
  extendXIso (chainComplex P) ComplexShape.embeddingDownNat
    (rfl : ComplexShape.embeddingDownNat.f 1 = -1)

/-- The degree-minus-two term is the tensor model of the relation quotient, identified with
the quotient by the bijective tensor-unit map. -/
def complex_X_negTwo : (complex P).X (-2) ≅ ModuleCat.of S (S ⊗[P.Ring] relModTrivial P) :=
  extendXIso (chainComplex P) ComplexShape.embeddingDownNat
    (rfl : ComplexShape.embeddingDownNat.f 2 = -2)

/-- The differential from degree −1 to degree 0 is the scalar-extended differentiation map. -/
theorem complex_d_negOne_zero :
    (complex P).d (-1) 0 =
      (complex_X_negOne P).hom ≫
        ModuleCat.ofHom (toCotangentSpace P) ≫ (complex_X_zero P).inv := sorry

/-- The differential from degree −2 to degree −1 is the scalar-extended relation-quotient map. -/
theorem complex_d_negTwo_negOne :
    (complex P).d (-2) (-1) =
      (complex_X_negTwo P).hom ≫
        ModuleCat.ofHom (toFreeTensor P) ≫ (complex_X_negOne P).inv := sorry

end Algebra.Presentation.LichtenbaumSchlessinger
