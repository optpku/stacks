module

public import Mathlib.RingTheory.Regular.RegularSequence
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Ideals generated by finite lists

This leaf owns the membership interface for `Ideal.ofList`.  It is kept
separate from regular-sequence and quotient arguments so any finite-generator
calculation can import it without pulling in the surrounding chapter.
-/

universe u

namespace Ideal

variable {R : Type u} [Semiring R]

/-- An ideal generated by a list is contained in `I` exactly when every list
entry belongs to `I`. -/
@[stacks 00LF "list-generated ideal containment"]
theorem ofList_le_iff (I : Ideal R) (rs : List R) :
    Ideal.ofList rs ≤ I ↔ ∀ r ∈ rs, r ∈ I := sorry
/- Proof strategy: unfold `Ideal.ofList` as the span of the set of list
entries, then use `span_le` and `Set.mem_setOf_eq`. -/

end Ideal
