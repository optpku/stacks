module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Globally Generated Sheaves of Modules

This file records source-independent finite global-generation predicates for
sheaves of modules.  The underlying families of sections remain owned by
Mathlib's `SheafOfModules.GeneratingSections`.
-/

@[expose] public section

open CategoryTheory Limits

universe u v w

namespace SheafOfModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable {𝒪 : Sheaf J RingCat.{w}}
variable [HasWeakSheafify J AddCommGrpCat.{w}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- A sheaf of `𝒪`-modules is globally generated when it admits a family of global generating
sections. -/
@[stacks 01AM, stacks 03DE "(3)"]
abbrev IsGloballyGenerated (ℱ : SheafOfModules.{w} 𝒪) : Prop :=
  Nonempty ℱ.GeneratingSections

/-- A sheaf of `𝒪`-modules is generated by `r` global sections when there is an epimorphism from
the free sheaf on `ULift (Fin r)`. -/
@[stacks 03DE "(4)"]
class IsGeneratedBy (ℱ : SheafOfModules.{w} 𝒪) (r : ℕ) : Prop where
  exists_epi :
    ∃ π : free (ULift.{w} (Fin r)) ⟶ ℱ, Epi π

/-- A sheaf of `𝒪`-modules is finitely globally generated when it is generated by `r` global
sections for some natural number `r`. -/
@[stacks 03DE "(5)"]
class IsFiniteGloballyGenerated (ℱ : SheafOfModules.{w} 𝒪) : Prop where
  exists_num : ∃ r : ℕ, IsGeneratedBy ℱ r

/-- Global generation is closed under isomorphisms. -/
instance isGloballyGenerated_isClosedUnderIsomorphisms :
    ObjectProperty.IsClosedUnderIsomorphisms
      (IsGloballyGenerated : ObjectProperty (SheafOfModules.{w} 𝒪)) := sorry

namespace IsGloballyGenerated

/-- Transport global generation from the source of a module-sheaf isomorphism to its target. -/
theorem of_iso {M N : SheafOfModules.{w} 𝒪} (e : M ≅ N) [IsGloballyGenerated M] :
    IsGloballyGenerated N := sorry

/-- Global generation is equivalent on isomorphic module sheaves. -/
theorem iff_of_iso {M N : SheafOfModules.{w} 𝒪} (e : M ≅ N) :
    IsGloballyGenerated M ↔ IsGloballyGenerated N := sorry

end IsGloballyGenerated

/-- Generation by a fixed number of sections is closed under isomorphisms. -/
instance isGeneratedBy_isClosedUnderIsomorphisms (r : ℕ) :
    ObjectProperty.IsClosedUnderIsomorphisms
      (fun M : SheafOfModules.{w} 𝒪 => IsGeneratedBy M r) := sorry

namespace IsGeneratedBy

/-- Transport generation by `r` sections across a module-sheaf isomorphism. -/
theorem of_iso {M N : SheafOfModules.{w} 𝒪} (e : M ≅ N) {r : ℕ}
    [IsGeneratedBy M r] : IsGeneratedBy N r := sorry

/-- Generation by `r` sections is equivalent on isomorphic module sheaves. -/
theorem iff_of_iso {M N : SheafOfModules.{w} 𝒪} (e : M ≅ N) {r : ℕ} :
    IsGeneratedBy M r ↔ IsGeneratedBy N r := sorry

end IsGeneratedBy

/-- Finite global generation is closed under isomorphisms. -/
instance isFiniteGloballyGenerated_isClosedUnderIsomorphisms :
    ObjectProperty.IsClosedUnderIsomorphisms
      (IsFiniteGloballyGenerated : ObjectProperty (SheafOfModules.{w} 𝒪)) := sorry

namespace IsFiniteGloballyGenerated

/-- Transport finite global generation across a module-sheaf isomorphism. -/
theorem of_iso {M N : SheafOfModules.{w} 𝒪} (e : M ≅ N)
    [IsFiniteGloballyGenerated M] : IsFiniteGloballyGenerated N := sorry

/-- Finite global generation is equivalent on isomorphic module sheaves. -/
theorem iff_of_iso {M N : SheafOfModules.{w} 𝒪} (e : M ≅ N) :
    IsFiniteGloballyGenerated M ↔ IsFiniteGloballyGenerated N := sorry

end IsFiniteGloballyGenerated

/-- The free sheaf on `ULift (Fin r)` is generated by its `r` tautological sections. -/
instance free_fin_isGeneratedBy (r : ℕ) :
    IsGeneratedBy (free (ULift.{w} (Fin r)) : SheafOfModules.{w} 𝒪) r := sorry

namespace IsGeneratedBy

/-- Generation by `r` global sections implies global generation. -/
theorem isGloballyGenerated
    (ℱ : SheafOfModules.{w} 𝒪) {r : ℕ} [IsGeneratedBy ℱ r] :
    IsGloballyGenerated ℱ := sorry

/-- Generation by a fixed finite number of sections implies finite global generation. -/
theorem isFiniteGloballyGenerated
    (ℱ : SheafOfModules.{w} 𝒪) {r : ℕ} [IsGeneratedBy ℱ r] :
    IsFiniteGloballyGenerated ℱ := sorry

end IsGeneratedBy

namespace IsFiniteGloballyGenerated

/-- A finitely globally generated sheaf is globally generated. -/
instance isGloballyGenerated
    (ℱ : SheafOfModules.{w} 𝒪) [IsFiniteGloballyGenerated ℱ] :
    IsGloballyGenerated ℱ := sorry

end IsFiniteGloballyGenerated

namespace IsGloballyGenerated

/-- A module sheaf is generated by global sections exactly when some indexed family of its global
sections induces an epimorphism from the corresponding free sheaf. -/
@[stacks 01AM "explicit generating-family criterion"]
theorem iff_exists
    (ℱ : SheafOfModules.{w} 𝒪) :
    IsGloballyGenerated ℱ ↔
      ∃ (I : Type w) (s : I → ℱ.sections), Epi (ℱ.freeHomEquiv.symm s) := sorry

end IsGloballyGenerated

end SheafOfModules
