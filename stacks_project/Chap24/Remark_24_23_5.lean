module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.DifferentialGraded.Module.Free
import StacksCheckRecall

@[expose] public section

/-!
# Remark 24.23.5

The reusable construction is split at its natural categorical boundaries: integer-graded sheaves
and their degree fibers, degreewise free module sheaves with zero differential, and the free right
DG module over a fixed differential graded algebra.  The universe lift used to place `ℤ` in the
ambient sheaf universe is hidden by `IntGradedSheaf`.
-/

open CategoryTheory
open scoped SheafOfModules.RingedSite.DifferentialGradedAlgebra
open scoped SheafOfModules.RingedSite.DifferentialGradedModule

noncomputable section

universe u v w

namespace SheafOfModules.RingedSite.DifferentialGradedModule

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
variable [HasWeakSheafify J AddCommGrpCat.{w}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
variable [HasWeakSheafify J (Type w)]
variable [UnivLE.{max u v, w}]
variable {O : Sheaf J CommRingCat.{w}}
variable (A : DGA(O)) (S : IntGradedSheaf.{u, v, w} J)

/- Remark 24.23.5 (1): an integer-graded sheaf is a sheaf of types equipped with a degree map to
the constant integer sheaf, and its degree fibers form an integer-graded object. -/
@[stacks 0FSF "(1), integer-graded sheaves"]
#check (IntGradedSheaf.{u, v, w} J)

#check
  (SmallGradedSheaf.degreeFiberFunctor (J := J) (β := ℤ) :
    IntGradedSheaf.{u, v, w} J ⥤ GradedObject ℤ (Sheaf J (Type w)))

/- Remark 24.23.5 (2): `O[S]` is obtained by freely linearizing the degree fibers of `S`, and the
resulting graded module sheaf has the canonical zero differential. -/
@[stacks 0FSF "(2), free graded module sheaf"]
#check
  (SheafOfModules.freeOnGradedSheaf (ringSheaf J O) :
    IntGradedSheaf.{u, v, w} J ⥤
      GradedObject ℤ (SheafOfModules.{w} (ringSheaf J O)))

#check
  (GradedObject.zeroDifferentialFunctor
    (C := SheafOfModules.{w} (ringSheaf J O)) :
      GradedObject ℤ (SheafOfModules.{w} (ringSheaf J O)) ⥤
        CochainComplex (SheafOfModules.{w} (ringSheaf J O)) ℤ)

/- Remark 24.23.5 (3): `A[S]` is the free right DG `A`-module generated by the integer-graded
sheaf `S`. -/
@[stacks 0FSF "(3), free DG module on a graded sheaf"]
#check
  (DifferentialGradedModule.freeOnGradedSheaf A :
    IntGradedSheaf.{u, v, w} J ⥤ Mod(A, d))

#check
  (DifferentialGradedModule.freeOnGradedSheaf_obj_toComplex A S :
    ((DifferentialGradedModule.freeOnGradedSheaf A).obj S).toComplex =
      HomologicalComplex.tensorObj
        (GradedObject.zeroDifferential
          ((SheafOfModules.freeOnGradedSheaf (ringSheaf J O)).obj S))
        A.toComplex)

end SheafOfModules.RingedSite.DifferentialGradedModule

end
