module

public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.IdealClosure
public import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

/-!
# A weighted projective ideal-closure example

The polynomial ring `ℚ[x, y]` with weights two and three exhibits a scheme-theoretic projective
closure which differs from saturation by the irrelevant ideal.
-/

@[expose] public section

noncomputable section

namespace AlgebraicGeometry.WeightedProjExample

/-- The weight function assigning degree two to `x` and degree three to `y`. -/
def weight (i : Fin 2) : ℕ :=
  if i = 0 then 2 else 3

/-- The internal `ℤ`-linear grading of `ℚ[x, y]` determined by weights two and three. -/
abbrev grading : ℕ → Submodule ℤ (MvPolynomial (Fin 2) ℚ) :=
  fun n ↦ (MvPolynomial.weightedHomogeneousSubmodule ℚ weight n).restrictScalars ℤ

/-- The weighted polynomial ring carries its canonical internal graded-algebra structure. -/
noncomputable instance instGradedAlgebra : GradedAlgebra grading :=
  -- Local instance justification (defeq pin): scalar restriction must use the canonical
  -- weighted decomposition supplied by `MvPolynomial.weightedGradedAlgebra`.
  letI : GradedAlgebra (MvPolynomial.weightedHomogeneousSubmodule ℚ weight) :=
    MvPolynomial.weightedGradedAlgebra ℚ weight
  inferInstance

/-- The degree-two variable in the weighted polynomial ring. -/
abbrev x : MvPolynomial (Fin 2) ℚ :=
  MvPolynomial.X 0

/-- The degree-three variable in the weighted polynomial ring. -/
abbrev y : MvPolynomial (Fin 2) ℚ :=
  MvPolynomial.X 1

/-- The finite set consisting of the two weighted polynomial variables. -/
noncomputable def generatorSet : Finset (MvPolynomial (Fin 2) ℚ) :=
  {x, y}

/-- The assigned degree of each member of the weighted generating set. -/
def generatorDegree (a : {z // z ∈ generatorSet}) : ℕ :=
  if (a : MvPolynomial (Fin 2) ℚ) = x then 2 else 3

/-- The variables `x` and `y`, together with the degree-zero part, generate the weighted
polynomial ring. -/
theorem generators_generate :
    Algebra.adjoin (grading 0)
      (generatorSet : Set (MvPolynomial (Fin 2) ℚ)) = ⊤ := sorry

/-- Each weighted generator belongs to its assigned homogeneous component. -/
theorem generator_mem_grading (a : {z // z ∈ generatorSet}) :
    (a : MvPolynomial (Fin 2) ℚ) ∈ grading (generatorDegree a) := sorry

/-- Each assigned weighted-generator degree is positive. -/
theorem generatorDegree_pos (a : {z // z ∈ generatorSet}) :
    0 < generatorDegree a := sorry

/-- The two variables form explicit positive homogeneous generators of the weighted ring. -/
noncomputable def generators : GradedAlgebra.PositiveGenerators grading :=
  GradedAlgebra.PositiveGenerators.ofFinset generatorSet generatorDegree
    generators_generate generator_mem_grading generatorDegree_pos

/-- The least common multiple of the two weighted-generator degrees is six. -/
theorem generators_period : generators.period = 6 := sorry

/-- The principal ideal generated by `y ^ 2` is homogeneous for the weighted grading. -/
theorem ideal_isHomogeneous :
    (Ideal.span ({y ^ 2} : Set (MvPolynomial (Fin 2) ℚ))).IsHomogeneous grading := sorry

/-- The homogeneous ideal `(y ^ 2)` in the weighted polynomial ring. -/
def ideal : HomogeneousIdeal grading :=
  ⟨Ideal.span ({y ^ 2} : Set (MvPolynomial (Fin 2) ℚ)), ideal_isHomogeneous⟩

/-- The principal ideal generated by `y` is homogeneous for the weighted grading. -/
theorem lineIdeal_isHomogeneous :
    (Ideal.span ({y} : Set (MvPolynomial (Fin 2) ℚ))).IsHomogeneous grading := sorry

/-- The homogeneous ideal `(y)` in the weighted polynomial ring. -/
def lineIdeal : HomogeneousIdeal grading :=
  ⟨Ideal.span ({y} : Set (MvPolynomial (Fin 2) ℚ)), lineIdeal_isHomogeneous⟩

/-- No monomial `x ^ n * y` belongs to `(y ^ 2)`. -/
theorem x_pow_y_not_mem_ySquared (n : ℕ) :
    x ^ n * y ∉ ideal.toIdeal := sorry

/-- The scheme-theoretic projective closure of `(y ^ 2)` is `(y)`. -/
theorem closedIdeal_eq_spanY :
    projClosedSubschemeIdeal grading ideal = lineIdeal := sorry

/-- The ideal `(y)` is not the saturation of `(y ^ 2)` by the irrelevant ideal. -/
theorem lineIdeal_ne_saturation :
    lineIdeal.toIdeal ≠ projSaturation grading ideal := sorry

/-- In weights two and three, `(y ^ 2)` has projective closure `(y)`, but `(y)` is not its
irrelevant-ideal saturation. -/
theorem spec :
    projClosedSubschemeIdeal grading ideal = lineIdeal ∧
      lineIdeal.toIdeal ≠ projSaturation grading ideal := sorry

end AlgebraicGeometry.WeightedProjExample
