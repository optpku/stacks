module

import StacksCheckRecall
import ReasLib.AlgebraicGeometry.Scheme.RelativeProj.QuasiCompact

open AlgebraicGeometry
open CategoryTheory
open scoped AlgebraicGeometry

universe u

/- Lemma 31.30.1: a relative projective-spectrum morphism is quasi-compact if its graded
algebra is affine-locally of finite type over degree zero, is generated by a finite degree-one
module, or has a finite positive submodule whose induced quotient ideal is locally nilpotent. -/
@[stacks 07ZX] #check
  (AlgebraicGeometry.Scheme.Hom.RelativeProjPresentation.quasiCompact_of_finiteness :
    ∀ {S X : Scheme.{u}} {p : X ⟶ S}
      (P : AlgebraicGeometry.Scheme.Hom.RelativeProjPresentation p),
      (P.FiniteTypeAsDegreeZeroAlgebra ∨
        P.GeneratedByDegreeOneFinite ∨
          P.FinitePositiveSubmoduleLocallyNilpotentQuotient) →
        QuasiCompact p)
