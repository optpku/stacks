module

public import stacks_project.Chap71.Definition_71_6_1_EffectiveCartier
public import stacks_project.Chap71.Definition_71_6_1_LocallyPrincipal
import StacksCheckRecall

@[expose] public section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.AlgebraicSpace
open CategoryTheory.MonoidalCategory

noncomputable section

universe u

/- Definition 71.6.1 (1): A locally principal closed subspace of an algebraic space has
an ideal sheaf that is locally generated by one element. -/
@[stacks 083B] #check
  (AlgebraicGeometry.AlgebraicSpace.IsLocallyPrincipal :
    {S : Scheme.{u}} → {D X : AlgebraicSpace S} → (D ⟶ X) → Prop)

#check
  (AlgebraicGeometry.AlgebraicSpace.isLocallyPrincipal_iff :
    ∀ {S : Scheme.{u}} {D X : AlgebraicSpace S} (i : D ⟶ X),
      IsLocallyPrincipal i ↔
        IsClosedImmersion i ∧
          SheafOfModules.IsLocallyGeneratedBy (Hom.idealSheaf i) 1)

/- Definition 71.6.1 (2): An effective Cartier divisor on an algebraic space is a closed
subspace whose ideal sheaf is an invertible module over the structure sheaf. -/
@[stacks 083B] #check
  (AlgebraicGeometry.AlgebraicSpace.IsEffectiveCartierDivisor :
    {S : Scheme.{u}} → {D X : AlgebraicSpace S} → (D ⟶ X) → Prop)

#check
  (AlgebraicGeometry.AlgebraicSpace.isEffectiveCartierDivisor_iff :
    ∀ {S : Scheme.{u}} {D X : AlgebraicSpace S} (i : D ⟶ X),
      IsEffectiveCartierDivisor i ↔
        IsClosedImmersion i ∧ isInvertibleObject (Hom.idealSheaf i))
