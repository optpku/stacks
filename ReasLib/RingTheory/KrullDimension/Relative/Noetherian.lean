module

public import Mathlib.RingTheory.KrullDimension.Basic
public import Mathlib.RingTheory.Ideal.GoingUp
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.LinearAlgebra.FiniteDimensional.Defs
public import Mathlib.RingTheory.Noetherian.Basic
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.Algebra.Module.QuotSMulTop.FiniteLength

@[expose] public section

/-!
# Noetherian intermediate algebras in dimension one

Intermediate subalgebras of finite-dimensional fraction-field extensions of
one-dimensional Noetherian domains are Noetherian.  The dimension bound is
available both as a typeclass and as an equality of Krull dimensions.
-/

universe u v

namespace Subalgebra

variable {R : Type u} {L : Type v}

/-- An intermediate algebra in a finite-dimensional
fraction-field extension of a one-dimensional Noetherian domain is Noetherian. -/
@[stacks 00PG "Noetherian intermediate algebra from dimension at most one"]
instance isNoetherianRing_of_dimLEOne
    [CommRing R] [IsDomain R] [IsNoetherianRing R]
    [Field L] [Algebra (FractionRing R) L]
    [FiniteDimensional (FractionRing R) L]
    [Algebra R L] [IsScalarTower R (FractionRing R) L]
    [Ring.KrullDimLE 1 R]
    (A : Subalgebra R L) : IsNoetherianRing A := sorry
/- Proof strategy: use the finite-dimensional fraction-field lattice and the
finite-length principal-quotient owner to show every nonzero ideal of `A` is
finitely generated, then apply the ideal criterion for Noetherian rings. -/

/-- The equality `ringKrullDim R = 1` implies that an intermediate algebra in a
finite-dimensional fraction-field extension is Noetherian. -/
@[stacks 00PG "Krull-dimension equality bridge"]
theorem isNoetherianRing_of_ringKrullDim_eq_one
    [CommRing R] [IsDomain R] [IsNoetherianRing R]
    [Field L] [Algebra (FractionRing R) L]
    [FiniteDimensional (FractionRing R) L]
    [Algebra R L] [IsScalarTower R (FractionRing R) L]
    (A : Subalgebra R L) (hdim : ringKrullDim R = 1) :
    IsNoetherianRing A := sorry
/- Proof strategy: derive `Ring.KrullDimLE 1 R` from `hdim` and invoke the
canonical `Subalgebra.isNoetherianRing_of_dimLEOne` instance. -/

/-!
The next declarations give the ideal and finite-length ingredients of the
Krull--Akizuki argument separately.
-/

/-- An intermediate algebraic field
extension has the nonzero-contraction property for ideals.  The dimension
hypothesis is not needed for this property. -/
@[stacks 00PG "nonzero base scalar in a nonzero intermediate ideal"]
lemma exists_nonzero_base_mem_ideal
    [CommRing R] [IsDomain R] [Field L] [Algebra R L]
    [Algebra.IsAlgebraic R L]
    (A : Subalgebra R L) (I : Ideal A) (hI : I ≠ ⊥) :
    ∃ x : R, x ≠ 0 ∧ algebraMap R A x ∈ I := sorry

/-- Quotienting an intermediate algebra by
the principal ideal generated by a nonzero base scalar has finite `R`-length. -/
@[stacks 00PG "finite length of a principal intermediate quotient"]
lemma isFiniteLength_quotient_span_base_scalar
    [CommRing R] [IsDomain R] [IsNoetherianRing R]
    [Field L] [Algebra (FractionRing R) L]
    [FiniteDimensional (FractionRing R) L]
    [Algebra R L] [IsScalarTower R (FractionRing R) L]
    [Ring.KrullDimLE 1 R]
    (A : Subalgebra R L) {x : R} (hx : x ≠ 0) :
    IsFiniteLength R (A ⧸ Ideal.span ({algebraMap R A x} : Set A)) := sorry

/-- Every nonzero ideal quotient of an
intermediate algebra in a finite-dimensional algebraic fraction-field extension
is finite over the base one-dimensional Noetherian domain.  Algebraicity over
the base follows from the finite fraction-field extension. -/
@[stacks 00PG "finite quotient of a nonzero intermediate ideal"]
theorem moduleFinite_quotient_of_ne_bot
    [CommRing R] [IsDomain R] [IsNoetherianRing R]
    [Field L] [Algebra (FractionRing R) L]
    [FiniteDimensional (FractionRing R) L]
    [Algebra R L] [IsScalarTower R (FractionRing R) L]
    [Ring.KrullDimLE 1 R]
    (A : Subalgebra R L) {I : Ideal A} (hI : I ≠ ⊥) :
    Module.Finite R (A ⧸ I) := sorry

end Subalgebra
