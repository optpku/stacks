module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.PushforwardContinuous
public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Free.Generated
public import stacks_project.Chap66.Lemma_66_16_4_Etale
public import stacks_project.Chap66.Lemma_66_29_4_Stalk
public import stacks_project.Chap71.Lemma_71_5_1_FittingIdeal

/-!
# Étale local generators and Fitting stalks on algebraic spaces

A finite-type quasi-coherent module on an algebraic space is generated by `r`
sections on an étale neighbourhood of a point exactly when the stalk of its
`r`th Fitting ideal sheaf is the unit ideal of `𝒪_{X, x̄}`.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.AlgebraicSpace
open AlgebraicGeometry.AlgebraicSpace.GeometricPoint
open scoped FittingIdeal

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

/-- The additive presheaf of the unit `𝒪_X`-module is the additive underlying of `𝒪_X`. -/
def unitPresheafAddIso {S : Scheme.{u}} (X : AlgebraicSpace S) :
    (SheafOfModules.unit (structureSheaf X)).val.presheaf ≅
      (structureSheaf X).obj ⋙ forget₂ RingCat.{u} AddCommGrpCat.{u} :=
  NatIso.ofComponents (fun _ ↦ Iso.refl _) (fun {_ _} _ ↦ sorry)

/-- Components of `unitPresheafAddIso` are identity identifications of additive groups. -/
theorem unitPresheafAddIso_app {S : Scheme.{u}} (X : AlgebraicSpace S)
    (U : (smallEtaleSite X)ᵒᵖ) :
    (unitPresheafAddIso X).app U = Iso.refl _ :=
  sorry

/-- Additive comparison of the étale stalk of `𝒪_X` with the additive group of `𝒪_{X, x̄}`. -/
def unitStalkAddIso {S : Scheme.{u}} {X : AlgebraicSpace S} (xbar : GeometricPoint X) :
    (forget₂ (ModuleCat (etaleLocalRing X xbar)) AddCommGrpCat.{u}).obj
      (Modules.stalkModuleCat xbar (SheafOfModules.unit (structureSheaf X))) ≅
      AddCommGrpCat.of (etaleLocalRing X xbar) :=
  (toSmallEtalePoint xbar).presheafFiber.mapIso (unitPresheafAddIso X) ≪≫
    ((toSmallEtalePoint xbar).presheafFiberCompIso
        (forget₂ RingCat.{u} AddCommGrpCat.{u})).app (structureSheaf X).obj

/-- `unitStalkAddIso` is the site-point fiber of `unitPresheafAddIso`, compared with the
forgetful fiber of the étale local ring. -/
theorem unitStalkAddIso_eq {S : Scheme.{u}} {X : AlgebraicSpace S} (xbar : GeometricPoint X) :
    unitStalkAddIso xbar =
      (toSmallEtalePoint xbar).presheafFiber.mapIso (unitPresheafAddIso X) ≪≫
        ((toSmallEtalePoint xbar).presheafFiberCompIso
            (forget₂ RingCat.{u} AddCommGrpCat.{u})).app (structureSheaf X).obj :=
  sorry

/-- Canonical linear identification of the étale stalk of `𝒪_X` as a module with the
regular module on `𝒪_{X, x̄}`. -/
def unitStalkLinearEquiv {S : Scheme.{u}} {X : AlgebraicSpace S} (xbar : GeometricPoint X) :
    Modules.stalkModuleCat xbar (SheafOfModules.unit (structureSheaf X)) ≃ₗ[etaleLocalRing X xbar]
      etaleLocalRing X xbar where
  toFun := ConcreteCategory.hom (unitStalkAddIso xbar).hom
  invFun := ConcreteCategory.hom (unitStalkAddIso xbar).inv
  left_inv := sorry
  right_inv := sorry
  map_add' := sorry
  map_smul' := sorry

/-- The underlying function of `unitStalkLinearEquiv` is the additive comparison
`unitStalkAddIso`. -/
theorem unitStalkLinearEquiv_apply {S : Scheme.{u}} {X : AlgebraicSpace S}
    (xbar : GeometricPoint X)
    (m : Modules.stalkModuleCat xbar (SheafOfModules.unit (structureSheaf X))) :
    unitStalkLinearEquiv xbar m = (unitStalkAddIso xbar).hom m :=
  sorry

/-- Canonical linear map from the étale stalk of `𝒪_X` to the regular module on
`𝒪_{X, x̄}`. -/
abbrev unitStalkLinearMap {S : Scheme.{u}} {X : AlgebraicSpace S} (xbar : GeometricPoint X) :
    Modules.stalkModuleCat xbar (SheafOfModules.unit (structureSheaf X)) →ₗ[etaleLocalRing X xbar]
      etaleLocalRing X xbar :=
  (unitStalkLinearEquiv xbar).toLinearMap

/-- `unitStalkLinearMap` is the linear map of `unitStalkLinearEquiv`. -/
theorem unitStalkLinearMap_eq {S : Scheme.{u}} {X : AlgebraicSpace S}
    (xbar : GeometricPoint X) :
    unitStalkLinearMap xbar = (unitStalkLinearEquiv xbar).toLinearMap :=
  sorry

/-- The étale stalk of the inclusion of `fittingIdealSheaf F r` into `𝒪_X`. -/
def fittingIdealStalkMap {S : Scheme.{u}} {X : AlgebraicSpace S}
    (F : X.Modules) (r : ℕ) (xbar : GeometricPoint X) :
    Modules.stalkModuleCat xbar (fittingIdealSheaf F r : X.Modules) ⟶
      Modules.stalkModuleCat xbar (SheafOfModules.unit (structureSheaf X)) :=
  Modules.stalkModuleCatMap xbar (fittingIdealSheaf F r).arrow

/-- `fittingIdealStalkMap` is the étale module stalk of the Fitting inclusion. -/
theorem fittingIdealStalkMap_eq {S : Scheme.{u}} {X : AlgebraicSpace S}
    (F : X.Modules) (r : ℕ) (xbar : GeometricPoint X) :
    fittingIdealStalkMap F r xbar =
      Modules.stalkModuleCatMap xbar (fittingIdealSheaf F r).arrow :=
  sorry

/-- The Fitting inclusion, viewed in the étale local ring through the unit-stalk
identification. -/
abbrev fittingIdealStalkToRing {S : Scheme.{u}} {X : AlgebraicSpace S}
    (F : X.Modules) (r : ℕ) (xbar : GeometricPoint X) :
    Modules.stalkModuleCat xbar (fittingIdealSheaf F r : X.Modules)
      →ₗ[etaleLocalRing X xbar] etaleLocalRing X xbar :=
  unitStalkLinearMap xbar ∘ₗ (fittingIdealStalkMap F r xbar).hom

/-- `fittingIdealStalkToRing` is the stalk of the Fitting inclusion followed by
`unitStalkLinearMap`. -/
theorem fittingIdealStalkToRing_eq {S : Scheme.{u}} {X : AlgebraicSpace S}
    (F : X.Modules) (r : ℕ) (xbar : GeometricPoint X) :
    fittingIdealStalkToRing F r xbar =
      unitStalkLinearMap xbar ∘ₗ
        (Modules.stalkModuleCatMap xbar (fittingIdealSheaf F r).arrow).hom :=
  sorry

/-- The stalk of `fittingIdealSheaf F r` at a geometric point `xbar`, as an ideal of
the étale local ring `𝒪_{X, x̄}`. -/
def fittingIdealStalkIdeal {S : Scheme.{u}} {X : AlgebraicSpace S}
    (F : X.Modules) (r : ℕ) (xbar : GeometricPoint X) :
    Ideal (etaleLocalRing X xbar) :=
  LinearMap.range (fittingIdealStalkToRing F r xbar)

/-- For a finite-type quasi-coherent module, the stalk of the Fitting ideal sheaf
agrees with the intrinsic Fitting ideal of the étale module stalk. -/
theorem fittingIdealStalkIdeal_eq {S : Scheme.{u}} {X : AlgebraicSpace S}
    (F : X.Modules) [F.IsFiniteType] [F.IsQuasicoherent] (r : ℕ)
    (xbar : GeometricPoint X) :
    fittingIdealStalkIdeal F r xbar =
      Fit[etaleLocalRing X xbar]_(r)(Modules.stalkModuleCat xbar F) :=
  sorry

/-- An element of `𝒪_{X, x̄}` lies in `fittingIdealStalkIdeal F r xbar` exactly when it
is the image of an element of the étale stalk of `fittingIdealSheaf F r`. -/
theorem mem_fittingIdealStalkIdeal_iff {S : Scheme.{u}} {X : AlgebraicSpace S}
    (F : X.Modules) (r : ℕ) (xbar : GeometricPoint X)
    (a : etaleLocalRing X xbar) :
    a ∈ fittingIdealStalkIdeal F r xbar ↔
      ∃ s : Modules.stalkModuleCat xbar (fittingIdealSheaf F r : X.Modules),
        fittingIdealStalkToRing F r xbar s = a :=
  sorry

namespace Modules

/-- `F` is generated by `r` sections on some étale scheme neighbourhood of a
point of `|X|`. -/
def existsEtaleGeneratedBy {S : Scheme.{u}} {X : AlgebraicSpace S}
    (F : X.Modules) (x : Points X) (r : ℕ) : Prop :=
  ∃ (U : Over S) (a : ofOver U ⟶ X) (u : U.left) (V : U.left.Opens),
    Etale a ∧ u ∈ V ∧ Points.map a (ofOver.pointsEquiv U u) = x ∧
      SheafOfModules.IsGeneratedBy ((pullbackToScheme a F).over V) r

/-- Unfolding of `existsEtaleGeneratedBy`. -/
theorem existsEtaleGeneratedBy_iff {S : Scheme.{u}} {X : AlgebraicSpace S}
    (F : X.Modules) (x : Points X) (r : ℕ) :
    existsEtaleGeneratedBy F x r ↔
      ∃ (U : Over S) (a : ofOver U ⟶ X) (u : U.left) (V : U.left.Opens),
        Etale a ∧ u ∈ V ∧ Points.map a (ofOver.pointsEquiv U u) = x ∧
          SheafOfModules.IsGeneratedBy ((pullbackToScheme a F).over V) r :=
  sorry

end Modules

end AlgebraicGeometry.AlgebraicSpace
