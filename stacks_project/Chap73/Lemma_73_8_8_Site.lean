module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Ph.Site

/-!
# The big ph site of algebraic spaces

The ph topology is generated by étale coverings and proper surjections. Its big
site at an algebraic space is the corresponding slice topology.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry

universe u v

namespace AlgebraicGeometry.AlgebraicSpace

#check (properSurjectiveMorphismProperty :
  (S : Scheme.{u}) → MorphismProperty (AlgebraicSpace S))

#check (properSurjectiveMorphismProperty_iff :
  ∀ {S : Scheme.{u}} {X Y : AlgebraicSpace S} (f : X ⟶ Y),
    properSurjectiveMorphismProperty S f ↔ Proper f ∧ Surjective f)

#check (properSurjectivePrecoverage :
  (S : Scheme.{u}) → Precoverage (AlgebraicSpace S))

#check (ofArrows_mem_properSurjectivePrecoverage_iff :
  ∀ {S : Scheme.{u}} {X : AlgebraicSpace S} {ι : Type v}
    {Xᵢ : ι → AlgebraicSpace S} (f : ∀ i, Xᵢ i ⟶ X),
    Presieve.ofArrows Xᵢ f ∈ properSurjectivePrecoverage S X ↔
      (∀ i, Proper (f i) ∧ Surjective (f i)) ∧
        (⋃ i, Set.range (Points.map (f i))) = Set.univ)

#check (phTopology : (S : Scheme.{u}) → GrothendieckTopology (AlgebraicSpace S))

#check (phTopology_eq : ∀ (S : Scheme.{u}),
  phTopology S = etalePrecoverage.toGrothendieck ⊔
    (properSurjectivePrecoverage S).toGrothendieck)

#check (bigPhSite : ∀ {S : Scheme.{u}} (X : AlgebraicSpace S),
  GrothendieckTopology (Over X))

#check (bigPhSite_eq : ∀ {S : Scheme.{u}} (X : AlgebraicSpace S),
  bigPhSite X = (phTopology S).over X)

end AlgebraicGeometry.AlgebraicSpace
