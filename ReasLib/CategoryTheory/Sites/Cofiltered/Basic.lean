module

public import Mathlib.CategoryTheory.Adjunction.CompositionIso
public import Mathlib.CategoryTheory.Sites.Sheafification
public import ReasLib.CategoryTheory.Sites.MorphismOfSites
public import ReasLib.CategoryTheory.Sites.PrecoverageStability

/-!
# Cofiltered diagrams of finite sites

This file owns the reusable data of a cofiltered inverse diagram of
precoverage-presented sites. The selected finite covers are primitive data;
the associated Grothendieck topologies and morphisms of sites are derived API.
-/

@[expose] public section

universe uI uC vC

namespace CategoryTheory

open Limits Opposite

/-- Situation 7.18.1: a cofiltered inverse diagram of categories equipped with
finite selected covers, the literal Stacks-site axioms, and continuous
representably-flat transition functors. -/
@[stacks 0A34]
structure CofilteredSiteDiagram.{uI', uC', vC'} where
  /-- The cofiltered index category `𝓘`. -/
  I : Type uI'
  /-- The category structure on the index category. -/
  [smallCategoryI : SmallCategory I]
  /-- The cofilteredness hypothesis on the index category. -/
  [cofilteredI : IsCofiltered I]
  /-- The contravariant diagram of underlying categories `i ↦ 𝒞ᵢ`. -/
  diagram : Iᵒᵖ ⥤ Cat.{vC', uC'}
  /-- The selected covering families on each stage category. -/
  stageCov (i : I) : Precoverage (diagram.obj (op i))
  /-- Every selected cover at every stage has a finite indexing type. -/
  stageCov_finite {i : I} ⦃X : diagram.obj (op i)⦄ ⦃R : Presieve X⦄ :
    R ∈ stageCov i X → R ∈ Precoverage.finite (diagram.obj (op i)) X
  /-- Singleton isomorphisms are selected covers at every stage. -/
  stageCov_hasIsos (i : I) : (stageCov i).HasIsos
  /-- Selected cover members admit pullbacks at every stage. -/
  stageCov_hasPullbacks (i : I) : (stageCov i).HasPullbacks
  /-- Selected covers are stable under arrowwise refinements. -/
  stageCov_isStableUnderBind (i : I) : (stageCov i).IsStableUnderBind
  /-- Chosen pullbacks of selected covers are selected covers. -/
  stageCov_isStableUnderPullbackArrows (i : I) :
    (stageCov i).IsStableUnderPullbackArrows
  /-- Each transition preserves selected covers and their pullbacks. -/
  transitionContinuous {i j : I} (a : j ⟶ i) :
    Functor.Precoverage.IsContinuous
      (diagram.map a.op).toFunctor (stageCov i) (stageCov j)
  /-- Each transition functor is representably flat. -/
  transition_representablyFlat {i j : I} (a : j ⟶ i) :
    RepresentablyFlat (diagram.map a.op).toFunctor

/-- The stored category structure on the index type. -/
instance instSmallCategory (S : CofilteredSiteDiagram.{uI, uC, vC}) :
    SmallCategory S.I := S.smallCategoryI

/-- The stored cofilteredness of the index category. -/
instance instIsCofiltered (S : CofilteredSiteDiagram.{uI, uC, vC}) :
    IsCofiltered S.I := S.cofilteredI

namespace CofilteredSiteDiagram

variable (S : CofilteredSiteDiagram.{uI, uC, vC})

/-- The category at index `i`. -/
abbrev stage (i : S.I) := S.diagram.obj (op i)

/-- The canonical category structure on a stage. -/
instance stageCategory (i : S.I) : Category (S.stage i) := inferInstance

/-- The contravariant transition functor associated to `a : j ⟶ i`. -/
abbrev stageFunctor {i j : S.I} (a : j ⟶ i) :
    S.stage i ⥤ S.stage j :=
  (S.diagram.map a.op).toFunctor

/-- The identity transition functor agrees with the identity functor. -/
theorem stageFunctor_id_eq (i : S.I) :
    S.stageFunctor (𝟙 i) = 𝟭 _ := sorry

/-- Successive transition functors agree with the transition of the composite. -/
theorem stageFunctor_comp_eq {i j k : S.I} (a : j ⟶ i) (b : k ⟶ j) :
    S.stageFunctor (b ≫ a) = S.stageFunctor a ⋙ S.stageFunctor b := sorry

/-- Stage covers contain all singleton isomorphisms. -/
instance instStageCovHasIsos (i : S.I) : (S.stageCov i).HasIsos :=
  S.stageCov_hasIsos i

/-- Stage cover members have chosen pullbacks. -/
instance instStageCovHasPullbacks (i : S.I) : (S.stageCov i).HasPullbacks :=
  S.stageCov_hasPullbacks i

/-- Stage covers are stable under refinement by selected covers. -/
instance instStageCovIsStableUnderBind (i : S.I) :
    (S.stageCov i).IsStableUnderBind := S.stageCov_isStableUnderBind i

/-- Pullbacks of stage covers are again selected stage covers. -/
instance instStageCovIsStableUnderPullbackArrows (i : S.I) :
    (S.stageCov i).IsStableUnderPullbackArrows :=
  S.stageCov_isStableUnderPullbackArrows i

/-- The Grothendieck topology generated by the selected covers at a stage. -/
abbrev stageTopology (i : S.I) : GrothendieckTopology (S.stage i) :=
  (S.stageCov i).toGrothendieck

/-- Stage topologies have finite refinements because their selected covers are finite. -/
instance stageTopology_finiteRefinement (i : S.I) (X : S.stage i) :
    (S.stageTopology i).HasFiniteRefinement X :=
  GrothendieckTopology.finiteRefinement_of_finite
    (fun _ _ hR => S.stageCov_finite hR) X

/-- The chosen transition continuity data, exposed for the abbreviated stage functor. -/
instance stageFunctorContinuous {i j : S.I} (a : j ⟶ i) :
    Functor.Precoverage.IsContinuous (S.stageFunctor a) (S.stageCov i) (S.stageCov j) :=
  S.transitionContinuous a

/-- The chosen transition flatness data, exposed for the abbreviated stage functor. -/
instance stageFunctor_representablyFlat {i j : S.I} (a : j ⟶ i) :
    RepresentablyFlat (S.stageFunctor a) := S.transition_representablyFlat a

/-- Every transition is continuous for the generated stage topologies. -/
instance stageFunctor_isContinuous {i j : S.I} (a : j ⟶ i) :
    Functor.IsContinuous (S.stageFunctor a) (S.stageTopology i) (S.stageTopology j) :=
  Functor.Precoverage.IsContinuous.toContinuous
    (S.stageFunctorContinuous a)

/-- Every transition is a morphism of the generated stage sites. -/
instance stageFunctor_isMorphismOfSites {i j : S.I} (a : j ⟶ i) :
    IsMorphismOfSites (S.stageTopology i) (S.stageTopology j) (S.stageFunctor a) where
  toIsContinuous := inferInstance
  toRepresentablyFlat := inferInstance

/-- Continuity in the identity-arrow normal form used by a `Cat`-valued
diagram. This named instance avoids repeated local instance pins in sheaf
pullback constructions. -/
instance mapId_continuous (i : S.I) :
    Functor.IsContinuous (S.diagram.map (𝟙 (op i))).toFunctor
      (S.stageTopology i) (S.stageTopology i) := sorry

/-- Continuity in the composite-arrow normal form used by a `Cat`-valued
diagram. This is the normal form of the composite transition in sheaf
pullback constructions. -/
instance mapComp_continuous {i j k : S.I} (a : j ⟶ i) (b : k ⟶ j) :
    Functor.IsContinuous (S.diagram.map (a.op ≫ b.op)).toFunctor
      (S.stageTopology i) (S.stageTopology k) := sorry

/-- The sheaf pullback along an identity transition is canonically the identity.
The equality used to construct this non-Prop datum is taken directly from the
stored `Cat`-valued diagram, so the construction does not depend on the
statement placeholder `stageFunctor_id_eq`. -/
noncomputable def stageSheafPullbackIdIso
    (A : Type*) [Category A] (i : S.I)
    [HasWeakSheafify (S.stageTopology i) A]
    [∀ F : (S.stage i)ᵒᵖ ⥤ A, (S.stageFunctor (𝟙 i)).op.HasLeftKanExtension F] :
    (S.stageFunctor (𝟙 i)).sheafPullback A (S.stageTopology i) (S.stageTopology i) ≅ 𝟭 _ :=
  let e := eqToIso (congrArg Cat.Hom.toFunctor (S.diagram.map_id (op i)))
  Adjunction.leftAdjointIdIso
    ((S.stageFunctor (𝟙 i)).sheafAdjunctionContinuous A
      (S.stageTopology i) (S.stageTopology i))
    (Functor.sheafPushforwardContinuousId' e A (S.stageTopology i))

/-- Sheaf pullbacks along successive transitions compose canonically. The
diagram-composition equality is used directly to keep this non-Prop datum
independent of the public statement placeholder `stageFunctor_comp_eq`. -/
noncomputable def stageSheafPullbackCompIso
    (A : Type*) [Category A] {i j k : S.I} (a : j ⟶ i) (b : k ⟶ j)
    [HasWeakSheafify (S.stageTopology j) A]
    [HasWeakSheafify (S.stageTopology k) A]
    [∀ F : (S.stage i)ᵒᵖ ⥤ A, (S.stageFunctor a).op.HasLeftKanExtension F]
    [∀ F : (S.stage j)ᵒᵖ ⥤ A, (S.stageFunctor b).op.HasLeftKanExtension F]
    [∀ F : (S.stage i)ᵒᵖ ⥤ A, (S.stageFunctor (b ≫ a)).op.HasLeftKanExtension F] :
    (S.stageFunctor a).sheafPullback A (S.stageTopology i) (S.stageTopology j) ⋙
        (S.stageFunctor b).sheafPullback A (S.stageTopology j) (S.stageTopology k) ≅
      (S.stageFunctor (b ≫ a)).sheafPullback A (S.stageTopology i) (S.stageTopology k) :=
  let e := eqToIso (congrArg Cat.Hom.toFunctor (S.diagram.map_comp a.op b.op))
  Adjunction.leftAdjointCompIso
    ((S.stageFunctor a).sheafAdjunctionContinuous A
      (S.stageTopology i) (S.stageTopology j))
    ((S.stageFunctor b).sheafAdjunctionContinuous A
      (S.stageTopology j) (S.stageTopology k))
    ((S.stageFunctor (b ≫ a)).sheafAdjunctionContinuous A
      (S.stageTopology i) (S.stageTopology k))
    (Functor.sheafPushforwardContinuousComp' e.symm
      A (S.stageTopology i) (S.stageTopology j) (S.stageTopology k))

/-- The image of a stage object along the transition represented by an object of
the index over-category. -/
abbrev overImage {i : S.I} (X : S.stage i) (A : (Over i)ᵒᵖ) :
    S.stage A.unop.left :=
  (S.stageFunctor A.unop.hom).obj X

end CofilteredSiteDiagram

end CategoryTheory
