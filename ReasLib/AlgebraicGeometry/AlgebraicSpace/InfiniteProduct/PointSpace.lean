module

public import Mathlib.FieldTheory.Finite.Basic
public import Mathlib.Topology.Connected.TotallyDisconnected
public import Mathlib.Topology.Irreducible
public import Mathlib.Topology.JacobsonSpace
public import Mathlib.Topology.Sober
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.InfiniteProduct.Quotient

/-!
# Points of the infinite product quotient

The point space is the quotient of the product spectrum by the relation induced by the
presentation. Over a finite field it is irreducible, with a generic point given by the
common image of the coordinate points.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Limits
open AlgebraicGeometry.Scheme

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.InfiniteProduct

/-- The relation on `|U|` generated by the scheme-theoretic relation `R`. -/
def spaceRel (k : Type u) [Field k] : (cover k).left → (cover k).left → Prop :=
  fun x y ↦ ∃ r : (preRelation k).left.left,
    (preRelation k).t.left r = x ∧ (preRelation k).s.left r = y

/-- Two points of `|U|` are related exactly when they lift through `s` and `t`. -/
theorem spaceRel_iff_exists (k : Type u) [Field k] (x y : (cover k).left) :
    spaceRel k x y ↔
      ∃ r : (preRelation k).left.left,
        (preRelation k).t.left r = x ∧ (preRelation k).s.left r = y := sorry

/-- The presentation-level point space `|X| = |U| / |R|`. -/
def spacePoints (k : Type u) [Field k] : Type u :=
  Quot (spaceRel k)

/-- The carrier of `spacePoints k` is the quotient of `|U|` by `spaceRel`. -/
theorem spacePoints_eq (k : Type u) [Field k] :
    spacePoints k = Quot (spaceRel k) := sorry

/-- The quotient topology on `|U| / |R|` coinduced by the quotient map from `|U|`. -/
instance instTopologicalSpaceSpacePoints (k : Type u) [Field k] :
    TopologicalSpace (spacePoints k) :=
  TopologicalSpace.coinduced (Quot.mk (spaceRel k)) inferInstance

/-- The quotient map `|U| ⟶ |X|`. -/
def quotientMap (k : Type u) [Field k] : (cover k).left → spacePoints k :=
  Quot.mk (spaceRel k)

/-- The quotient map is the class map of `spaceRel`. -/
theorem quotientMap_eq (k : Type u) [Field k] :
    quotientMap k = Quot.mk (spaceRel k) := sorry

/-- The quotient map `|U| ⟶ |X|` is surjective. -/
theorem quotientMap_surjective (k : Type u) [Field k] :
    Function.Surjective (quotientMap k) := sorry

/-- The quotient map `|U| ⟶ |X|` is continuous. -/
theorem continuous_quotientMap (k : Type u) [Field k] :
    Continuous (quotientMap k) := sorry

/-- The generic point `x_0` of `|X|`, the common image of the open points `u_n`. -/
def genericPoint (k : Type u) [Field k] : spacePoints k :=
  quotientMap k (openPoint k 0)

/-- The generic point is the image of `u_0`. -/
theorem genericPoint_eq (k : Type u) [Field k] :
    genericPoint k = quotientMap k (openPoint k 0) := sorry

/-- Every element of the infinite product over a finite field satisfies `x ^ q = x`. -/
theorem pow_card (k : Type u) [Field k] [Fintype k] (x : ℕ → k) :
    x ^ Fintype.card k = x := sorry

/-- Every residue field of `U` is isomorphic to `k`. -/
theorem nonempty_residueField_ringEquiv (k : Type u) [Field k] [Fintype k]
    (x : (cover k).left) :
    Nonempty ((cover k).left.residueField x ≃+* k) := sorry

/-- Every point of `|U|` is closed. -/
theorem mem_closedPoints_cover (k : Type u) [Field k] [Fintype k] (x : (cover k).left) :
    x ∈ closedPoints (cover k).left := sorry

/-- The points `u_n` are open, hence isolated. -/
theorem isOpen_singleton_openPoint (k : Type u) [Field k] [Fintype k] (n : ℕ) :
    IsOpen {openPoint k n} := sorry

/-- The finite-support ideal is proper. -/
theorem finiteSupportIdeal_ne_top (k : Type u) [Field k] :
    finiteSupportIdeal k ≠ ⊤ := sorry

/-- The finite-support ideal is contained in a maximal ideal. -/
theorem exists_isMaximal_finiteSupportIdeal_le (k : Type u) [Field k] :
    ∃ I : Ideal (ℕ → k), I.IsMaximal ∧ finiteSupportIdeal k ≤ I := sorry

/-- The topology on `|U|` is not discrete. -/
theorem not_discreteTopology_cover (k : Type u) [Field k] [Fintype k] :
    ¬ DiscreteTopology (cover k).left := sorry

/-- Quasi-compactness of `U`, equivalently the proper finite-support ideal, produces points of
`|U|` other than the open points `u_n`. -/
theorem exists_point_not_openPoint (k : Type u) [Field k] [Fintype k] :
    ∃ x : (cover k).left, ∀ n : ℕ, x ≠ openPoint k n := sorry

/-- Every element of the infinite product is a unit times an idempotent. -/
theorem exists_isUnit_mul_isIdempotentElem (k : Type u) [Field k] [Fintype k] (x : ℕ → k) :
    ∃ (u e : ℕ → k), IsUnit u ∧ IsIdempotentElem e ∧ x = u * e := sorry

/-- The space `|U|` is totally disconnected. -/
instance instTotallyDisconnectedSpace_cover (k : Type u) [Field k] [Fintype k] :
    TotallyDisconnectedSpace (cover k).left := sorry

/-- The set of open points `{u_n}` is dense in `|U|`. -/
theorem dense_range_openPoint (k : Type u) [Field k] [Fintype k] :
    Dense (Set.range (openPoint k)) := sorry

/-- On a finite field, the relation on `|U|` identifies exactly the open points `u_n` with each
other, and identifies no other pair of distinct points. -/
theorem spaceRel_iff (k : Type u) [Field k] [Fintype k] (x y : (cover k).left) :
    spaceRel k x y ↔
      x = y ∨ (∃ n, x = openPoint k n) ∧ (∃ m, y = openPoint k m) := sorry

/-- All open points `u_n` map to the same point of `|X|`. -/
theorem genericPoint_eq_quotientMap_openPoint (k : Type u) [Field k] [Fintype k] (n : ℕ) :
    genericPoint k = quotientMap k (openPoint k n) := sorry

/-- The space `|X|` is irreducible. -/
instance instIrreducibleSpace_spacePoints (k : Type u) [Field k] [Fintype k] :
    IrreducibleSpace (spacePoints k) := sorry

/-- The point `x_0` is a generic point of `|X|`. -/
theorem isGenericPoint_genericPoint (k : Type u) [Field k] [Fintype k] :
    IsGenericPoint (genericPoint k) Set.univ := sorry

/-- The generic point `x_0` is the image of the closed point of `S` under the section
`S ⟶ X` induced by `f_0`. -/
theorem genericPoint_eq_image_section (k : Type u) [Field k] [Fintype k] :
    sectionHom k =
        (Scheme.fppfTopology.over (base k)).uliftYoneda.{u + 1}.map (immersionOver k 0) ≫
          atlas k ∧
      genericPoint k =
        quotientMap k ((immersionOver k 0).left (IsLocalRing.closedPoint k)) := sorry

end AlgebraicGeometry.AlgebraicSpace.InfiniteProduct
