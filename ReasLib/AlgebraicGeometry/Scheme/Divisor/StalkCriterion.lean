module

public import Mathlib.AlgebraicGeometry.Noetherian
public import ReasLib.AlgebraicGeometry.RingedSpace.Module.IdealStalk
public import ReasLib.AlgebraicGeometry.Scheme.IdealSubobject
public import ReasLib.AlgebraicGeometry.Scheme.Divisor.EffectiveCartier.Affine
public import ReasLib.RingTheory.Sequence.Regularity.Localization

@[expose] public section

open AlgebraicGeometry
open CategoryTheory
open scoped nonZeroDivisors

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}} [IsLocallyNoetherian X]

/-- The closed subscheme defined by ideal-sheaf data is locally principal exactly when its
ideal is generated by one section on an affine neighborhood of every point of its support. -/
theorem isLocallyPrincipalClosedSubscheme_subschemeι_iff (D : X.IdealSheafData) :
    IsLocallyPrincipalClosedSubscheme D.subschemeι ↔
      ∀ x : X, x ∈ D.support →
        ∃ U : X.affineOpens, x ∈ (U : X.Opens) ∧
          ∃ f : Γ(X, U), D.ideal U = Ideal.span ({f} : Set (Γ(X, U))) := sorry

/-- If the stalk ideal of ideal-sheaf data is principal at every point of its support, then the
corresponding closed subscheme is locally principal. -/
theorem isLocallyPrincipal_of_stalks_principal
    (D : X.IdealSheafData)
    (hprincipal : ∀ x : X, x ∈ D.support →
      (RingedSpace.idealSheafStalkIdeal D.toSubobject x).IsPrincipal) :
    IsLocallyPrincipalClosedSubscheme D.subschemeι := sorry

/-- If the stalk ideal of ideal-sheaf data is generated by a nonzerodivisor at every point of
its support, then the corresponding closed subscheme is an effective Cartier divisor. -/
theorem isEffectiveCartierDivisor_of_stalks_generatedByNonZeroDivisor
    (D : X.IdealSheafData)
    (hregular :
      ∀ x : X, x ∈ D.support →
        ∃ f : X.presheaf.stalk x,
          f ∈ nonZeroDivisors (X.presheaf.stalk x) ∧
            RingedSpace.idealSheafStalkIdeal D.toSubobject x =
              Ideal.span ({f} : Set (X.presheaf.stalk x))) :
    AlgebraicGeometry.IsEffectiveCartierDivisor D.subschemeι := sorry

end AlgebraicGeometry.Scheme.IdealSheafData
