module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Points
public import Mathlib.AlgebraicGeometry.GammaSpecAdjunction
public import Mathlib.CategoryTheory.CommSq
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import Mathlib.RingTheory.Ideal.Maps

/-!
# Polynomial quotient evaluation and affine comparison

Sections satisfying polynomial relations induce morphisms to the spectrum of the
corresponding quotient ring, compatible with the coefficient morphism.
-/

@[expose] public section

open CategoryTheory Opposite

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.AffineComparison

variable {S : Scheme.{u}} {X : AlgebraicSpace S} {U : Over S} {A : CommRingCat.{u}}

/-- The coefficient homomorphism on global sections induced by a morphism to an affine scheme. -/
def coefficientMap (σA : Spec A ⟶ S) (p : X ⟶ ofOver (Over.mk σA))
    (f : ofOver U ⟶ X) : A ⟶ Scheme.Γ.obj (op U.left) :=
  ((ΓSpec.adjunction.homEquiv U.left (op A)).symm
    (yoneda.preimage (f ≫ p)).left).unop

/-- The polynomial ring modulo the ideal generated by the specified relations. -/
def quotientRing {n : ℕ} (g : Fin n → MvPolynomial (Fin n) A) : CommRingCat.{u} :=
  CommRingCat.of (MvPolynomial (Fin n) A ⧸ Ideal.span (Set.range g))

/-- The canonical coefficient homomorphism into the polynomial quotient. -/
def quotientMap {n : ℕ} (g : Fin n → MvPolynomial (Fin n) A) : A ⟶ quotientRing g :=
  CommRingCat.ofHom ((Ideal.Quotient.mk (Ideal.span (Set.range g))).comp MvPolynomial.C)

variable (σA : Spec A ⟶ S) (p : X ⟶ ofOver (Over.mk σA)) (f : ofOver U ⟶ X)
    {n : ℕ} (g : Fin n → MvPolynomial (Fin n) A)
    (h : Fin n → Scheme.Γ.obj (op U.left))
    (hrel : ∀ k, MvPolynomial.eval₂ (coefficientMap σA p f).hom h (g k) = 0)

/-- Evaluation at sections satisfying the relations descends to the polynomial quotient. -/
def quotientEvaluation : quotientRing g ⟶ Scheme.Γ.obj (op U.left) :=
  CommRingCat.ofHom (Ideal.Quotient.lift (Ideal.span (Set.range g))
    (MvPolynomial.eval₂Hom (coefficientMap σA p f).hom h) (by
      intro q hq
      apply RingHom.mem_ker.mp
      apply ((Ideal.span_le (I := RingHom.ker
        (MvPolynomial.eval₂Hom (coefficientMap σA p f).hom h))).mpr ?_) hq
      rintro _ ⟨k, rfl⟩
      exact RingHom.mem_ker.mpr (hrel k)))

/-- Evaluation of the quotient class of a polynomial is its evaluation at the chosen sections. -/
@[simp]
theorem quotientEvaluation_mk (q : MvPolynomial (Fin n) A) :
    (quotientEvaluation σA p f g h hrel).hom
      (Ideal.Quotient.mk (Ideal.span (Set.range g)) q) =
      MvPolynomial.eval₂ (coefficientMap σA p f).hom h q := rfl

/-- Quotient evaluation restricts to the induced homomorphism on coefficients. -/
theorem quotientEvaluation_coeff :
    quotientMap g ≫ quotientEvaluation σA p f g h hrel = coefficientMap σA p f := by
  ext a
  exact MvPolynomial.eval₂_C (coefficientMap σA p f).hom h a

/-- The scheme morphism to the spectrum of the quotient induced by evaluation of sections. -/
def quotientSpecMap : U.left ⟶ Spec (quotientRing g) :=
  ΓSpec.adjunction.homEquiv U.left (op (quotientRing g))
    (quotientEvaluation σA p f g h hrel).op

/-- The morphism induced by quotient evaluation recovers the original affine-target morphism
after composition with the coefficient inclusion on spectra. -/
theorem quotientSpecMap_comp :
    quotientSpecMap σA p f g h hrel ≫ Spec.map (quotientMap g) =
      (yoneda.preimage (f ≫ p)).left := by
  sorry

/-- The morphism induced by quotient evaluation is compatible with the structure map to the base. -/
theorem quotientSpecMap_over :
    quotientSpecMap σA p f g h hrel ≫ (Spec.map (quotientMap g) ≫ σA) = U.hom := by
  rw [← Category.assoc, quotientSpecMap_comp]
  exact Over.w (yoneda.preimage (f ≫ p))

/-- Quotient evaluation as a morphism of schemes over the base. -/
def quotientSpecOverMap :
    U ⟶ Over.mk (Spec.map (quotientMap g) ≫ σA) :=
  Over.homMk (quotientSpecMap σA p f g h hrel) (quotientSpecMap_over σA p f g h hrel)

/-- Evaluation of sections satisfying polynomial relations gives a commutative square of
algebraic spaces with the original morphism to the spectrum of the coefficient ring. -/
theorem quotientEvaluation_commSq :
    CommSq f (AlgebraicGeometry.AlgebraicSpace.ofOverMap
      (quotientSpecOverMap σA p f g h hrel)) p
      (AlgebraicGeometry.AlgebraicSpace.ofOverHomMk (Spec.map (quotientMap g)) rfl) := by
  constructor
  change f ≫ p = yoneda.map (quotientSpecOverMap σA p f g h hrel) ≫
    yoneda.map (Over.homMk (Spec.map (quotientMap g)) rfl :
      Over.mk (Spec.map (quotientMap g) ≫ σA) ⟶ Over.mk σA)
  have hw : quotientSpecOverMap σA p f g h hrel ≫
      (Over.homMk (Spec.map (quotientMap g)) rfl :
        Over.mk (Spec.map (quotientMap g) ≫ σA) ⟶ Over.mk σA) =
      yoneda.preimage (f ≫ p) := by
    apply Over.OverMorphism.ext
    exact quotientSpecMap_comp σA p f g h hrel
  exact (yoneda.map_preimage (f ≫ p)).symm.trans
    ((congrArg (fun k : U ⟶ Over.mk σA => yoneda.map k) hw).symm.trans
      (yoneda.map_comp _ _))

end AlgebraicGeometry.AlgebraicSpace.AffineComparison
