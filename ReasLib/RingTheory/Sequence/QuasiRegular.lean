module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.RingTheory.Regular.RegularSequence
public import ReasLib.RingTheory.Ideal.AssociatedGraded.Basic
public import ReasLib.RingTheory.Sequence.QuasiRegular.Internal

/-!
# Ring-level quasi-regular finite sequences

This leaf gives the ring-level quotient-Rees model of the canonical map
`(R / I)[X_1, …, X_n] → gr_I(R)` attached to a finite sequence, using the
general quotient-Rees associated graded ring and its concrete degree-one
elements. The quasi-regularity predicate itself is owned by
`RingTheory.Sequence.IsQuasiRegularSequence`; its characterization through
this map is `RingTheory.Sequence.IsQuasiRegularSequence.quotientRees_iff`.
-/

@[expose] public section

noncomputable section

universe u

namespace RingTheory.Sequence.QuasiRegular

variable {R : Type u} [CommRing R]

/-- The associated graded ring of an ideal, in the quotient-Rees model. -/
abbrev associatedGradedRing (I : Ideal R) : Type u :=
  Ideal.AssociatedGraded.ring I

/-- An entry of a finite sequence as an element of the ideal generated by the sequence. -/
def sequenceEntry (rs : List R) (i : Fin rs.length) : Ideal.ofList rs :=
  ⟨rs.get i, Ideal.subset_span (List.get_mem rs i)⟩

/-- The degree-one associated-graded class corresponding to an entry of a finite sequence. -/
def sequenceDegreeOne (rs : List R) (i : Fin rs.length) :
    associatedGradedRing (Ideal.ofList rs) :=
  Ideal.AssociatedGraded.degreeOne (sequenceEntry rs i)

/-- The canonical polynomial-to-associated-graded homomorphism of a finite sequence. -/
noncomputable def sequenceAssociatedGradedMap (rs : List R) :
    MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs) →ₐ[R ⧸ Ideal.ofList rs]
      associatedGradedRing (Ideal.ofList rs) :=
  MvPolynomial.aeval (sequenceDegreeOne rs)

end RingTheory.Sequence.QuasiRegular
