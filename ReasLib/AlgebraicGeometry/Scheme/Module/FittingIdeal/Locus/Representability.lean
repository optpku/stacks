module

public import ReasLib.AlgebraicGeometry.Scheme.Module.FittingIdeal.Locus
public import ReasLib.AlgebraicGeometry.Scheme.Module.FittingIdeal.BaseChange
public import ReasLib.AlgebraicGeometry.Scheme.Module.FittingIdeal.LocalGenerators
public import ReasLib.AlgebraicGeometry.Scheme.Module.FittingIdeal.LocallyFree

/-!
# Representability of Fitting loci

Fitting open complements and successive rank loci represent the local-generation
and fixed-rank conditions on pullbacks of finite-type quasicoherent modules.
-/

@[expose] public section

open AlgebraicGeometry
open CategoryTheory
open TopologicalSpace

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme

/-- The closed supports of all Fitting ideal sheaves of a finite-type quasicoherent module
have empty intersection. -/
theorem iInter_support_fittingIdealSheaf_eq_empty
    {S : Scheme.{u}} (F : S.Modules) [F.IsFiniteType] [F.IsQuasicoherent] :
    (⋂ r : ℕ, ((fittingIdealSheaf F r).support : Set S)) = (∅ : Set S) := sorry

/-- A morphism factors uniquely through the complement of the `r`th Fitting closed subscheme
exactly when the pulled-back module is locally generated by `r` sections. -/
theorem fittingOpenComplement_nonempty_over_hom_iff_isLocallyGeneratedBy
    {S T : Scheme.{u}} (g : T ⟶ S) (F : S.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (r : ℕ) :
    Subsingleton (Over.mk g ⟶ Over.mk (fittingOpenComplement F r).ι) ∧
      (Nonempty (Over.mk g ⟶ Over.mk (fittingOpenComplement F r).ι) ↔
        SheafOfModules.IsLocallyGeneratedBy ((Modules.pullback g).obj F) r) := sorry

/-- A morphism factors uniquely through the `r`th Fitting rank locus exactly when the
pulled-back module is finite locally free of rank `r`. -/
theorem fittingRankLocus_nonempty_over_hom_iff_isFiniteLocallyFreeOfRank
    {S T : Scheme.{u}} (g : T ⟶ S) (F : S.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (r : ℕ) :
    Subsingleton (Over.mk g ⟶ Over.mk (fittingRankLocusι F r)) ∧
      (Nonempty (Over.mk g ⟶ Over.mk (fittingRankLocusι F r)) ↔
        SheafOfModules.IsFiniteLocallyFreeOfRank r ((Modules.pullback g).obj F)) := sorry

end AlgebraicGeometry.Scheme
