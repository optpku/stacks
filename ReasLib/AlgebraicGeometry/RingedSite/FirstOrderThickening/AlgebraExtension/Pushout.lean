module

public import ReasLib.Algebra.Category.CommRing.Sheaf.Pullback
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.Ideal.Quotient
public import ReasLib.AlgebraicGeometry.RingedSite.FirstOrderThickening.Split

/-! # Coefficient pushout of square-zero algebra extensions -/

@[expose] public section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Sheaf.CommRing
open SheafOfModules.RingedSite
open SheafOfModules.RingedSite.TrivSqZeroExt

noncomputable section
set_option backward.privateInPublic true
set_option maxHeartbeats 1600000

universe u

namespace SheafOfModules.RingedSite.FirstOrderThickening.Solution

variable {C : Type u} [Category.{u} C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})]
variable [J.HasSheafCompose (forget₂ RingCat.{u} AddCommGrpCat.{u})]
variable [HasWeakSheafify J CommRingCat.{u}]
variable [J.WEqualsLocallyBijective CommRingCat.{u}]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable {A B : Sheaf J CommRingCat.{u}} {f : A ⟶ B}
variable {F H : SheafOfModules (ringSheaf J B)}
variable (c : F ⟶ H)
variable (S : Solution (𝟙 A) (isSquareZero_id A) f F (zeroKernelMap f F))

namespace Pushout

/-- The fibre product of the split extension with the original extension. -/
private def product (c : F ⟶ H)
    (S : Solution (𝟙 A) (isSquareZero_id A) f F (zeroKernelMap f F)) : Sheaf J CommRingCat.{u} :=
  Limits.pullback (TrivSqZeroExt.fst B H) S.proj

/-- The projection to the split extension. -/
private def fst : product c S ⟶ trivSqZeroExt B H :=
  Limits.pullback.fst (TrivSqZeroExt.fst B H) S.proj

/-- The projection to the original extension. -/
private def snd : product c S ⟶ S.middle :=
  Limits.pullback.snd (TrivSqZeroExt.fst B H) S.proj

/-- The common projection to the quotient ring. -/
private def projection : product c S ⟶ B :=
  fst c S ≫ TrivSqZeroExt.fst B H

/-- The two coordinates of an antidiagonal section have equal images in the quotient. -/
private theorem antidiagonalSection_condition (U : Cᵒᵖ) (m : F.val.obj U) :
    (TrivSqZeroExt.fst B H).hom.app U (inr B H (c.val.app U m)) =
      S.proj.hom.app U (- KernelIdeal.ιApp S.proj U
        ((S.proj_squareZero.targetModuleForgetIso S.proj_quotient_isIso).hom.hom.app U
          (S.kernelIso.inv.val.app U m))) := sorry

/-- The pair consisting of a coefficient image and the negative original kernel section. -/
private def antidiagonalSection (U : Cᵒᵖ) (m : F.val.obj U) :
    (product c S).obj.obj U :=
  pullbackSectionMk (TrivSqZeroExt.fst B H) S.proj U (inr B H (c.val.app U m))
    (- KernelIdeal.ιApp S.proj U
      ((S.proj_squareZero.targetModuleForgetIso S.proj_quotient_isIso).hom.hom.app U
        (S.kernelIso.inv.val.app U m))) (antidiagonalSection_condition c S U m)

/-- The antidiagonal section assignment is additive, natural, and linear. -/
private theorem antidiagonalHom_laws :
    (∀ U x y, antidiagonalSection c S U (x + y) =
      antidiagonalSection c S U x + antidiagonalSection c S U y) ∧
    (∀ U V (h : U ⟶ V) x,
      (product c S).obj.map h (antidiagonalSection c S U x) =
        antidiagonalSection c S V (F.val.map h x)) ∧
    (∀ U (r : (product c S).obj.obj U) x,
      antidiagonalSection c S U ((projection c S).hom.app U r • x) =
        r • antidiagonalSection c S U x) := sorry

/-- The antidiagonal section assignment as a module morphism. -/
private def antidiagonalHom :
    (restrictionAlong (projection c S)).obj F ⟶ unitModule J (product c S) where
  val := PresheafOfModules.homMk
    { app := fun U ↦ AddCommGrpCat.ofHom
        (AddMonoidHom.mk' (antidiagonalSection c S U) ((antidiagonalHom_laws c S).1 U))
      naturality := fun U V h ↦ ConcreteCategory.hom_ext _ _
        (fun x ↦ ((antidiagonalHom_laws c S).2.1 U V h x).symm) }
    ((antidiagonalHom_laws c S).2.2)

/-- The ideal generated by the antidiagonal coefficient sections. -/
private def antidiagonal : Subobject (unitModule J (product c S)) :=
  imageSubobject (antidiagonalHom c S)

/-- The antidiagonal ideal is killed by the common quotient projection. -/
private theorem antidiagonal_le_ker :
    antidiagonal c S ≤ KernelIdeal.subobject (projection c S) := sorry

/-- The coefficient pushout ring is the quotient by the antidiagonal ideal. -/
def middle : Sheaf J CommRingCat.{u} :=
  IdealSheaf.Quotient.sheaf (antidiagonal c S)

/-- The projection from the antidiagonal quotient to the original quotient ring. -/
def toTarget : middle c S ⟶ B :=
  IdealSheaf.Quotient.lift (antidiagonal c S) (projection c S)
    (antidiagonal_le_ker c S)

/-- The base and middle maps give compatible pairs in the fibre product. -/
private theorem fromBase_condition (c : F ⟶ H)
    (S : Solution (𝟙 A) (isSquareZero_id A) f F (zeroKernelMap f F)) :
    (f ≫ inl B H) ≫ TrivSqZeroExt.fst B H = S.structureMap ≫ S.proj ∧
    (S.proj ≫ inl B H) ≫ TrivSqZeroExt.fst B H = (𝟙 S.middle) ≫ S.proj ∧
    (∀ U (n : H.val.obj U),
      (TrivSqZeroExt.fst B H).hom.app U (inr B H n) = S.proj.hom.app U 0) := sorry

/-- The base-algebra map into the coefficient pushout. -/
def fromBase : A ⟶ middle c S :=
  Limits.pullback.lift (f ≫ inl B H) S.structureMap (fromBase_condition c S).1 ≫
    IdealSheaf.Quotient.projection (antidiagonal c S)

/-- The original middle algebra maps to the coefficient pushout. -/
def fromMiddle : S.middle ⟶ middle c S :=
  Limits.pullback.lift (S.proj ≫ inl B H) (𝟙 S.middle)
    (fromBase_condition c S).2.1 ≫ IdealSheaf.Quotient.projection (antidiagonal c S)

/-- A coefficient section determines the quotient class of its split inclusion. -/
private def inrSection (U : Cᵒᵖ) (n : H.val.obj U) : (middle c S).obj.obj U :=
  (IdealSheaf.Quotient.projection (antidiagonal c S)).hom.app U
    (pullbackSectionMk (TrivSqZeroExt.fst B H) S.proj U (inr B H n) 0
      ((fromBase_condition c S).2.2 U n))

/-- The coefficient-pushout projection is locally surjective. -/
private theorem proj_isLocallySurjective : Sheaf.IsLocallySurjective (toTarget c S) := sorry

/-- The coefficient-pushout projection has square-zero kernel. -/
private theorem proj_isSquareZero : KernelIdeal.IsSquareZero (toTarget c S) := sorry

/-- The quotient comparison for the coefficient-pushout projection is invertible. -/
private def quotientIsIso : IsIso (KernelIdeal.quotientComparison (toTarget c S)) :=
  @KernelIdeal.quotientComparison_isIso _ _ _ _ _ _ _
    (toTarget c S) _ (proj_isLocallySurjective c S)

/-- The split coefficient inclusion is annihilated by the pushout projection. -/
private theorem inrSection_mem_kernel (U : Cᵒᵖ) (n : H.val.obj U) :
    inrSection c S U n ∈ KernelIdeal.sectionIdeal (toTarget c S) U := sorry

/-- The coefficient inclusion into the descended kernel, on local sections. -/
private def kernelInclusionApp (U : Cᵒᵖ) (n : H.val.obj U) :
    ((proj_isSquareZero c S).targetModule (quotientIsIso c S)).val.obj U :=
  ((proj_isSquareZero c S).targetModuleForgetIso (quotientIsIso c S)).inv.hom.app U
    ((KernelIdeal.sectionsIso (toTarget c S) U).inv
      ⟨inrSection c S U n, inrSection_mem_kernel c S U n⟩)

/-- The kernel inclusion preserves addition, restrictions, and quotient-ring scalars. -/
private theorem kernelInclusion_laws :
    (∀ U x y, kernelInclusionApp c S U (x + y) =
      kernelInclusionApp c S U x + kernelInclusionApp c S U y) ∧
    (∀ U V (h : U ⟶ V) x,
      ((proj_isSquareZero c S).targetModule (quotientIsIso c S)).val.map h
          (kernelInclusionApp c S U x) = kernelInclusionApp c S V (H.val.map h x)) ∧
    (∀ U (r : B.obj.obj U) x,
      kernelInclusionApp c S U (r • x) = r • kernelInclusionApp c S U x) := sorry

/-- The canonical coefficient inclusion into the kernel of the pushout projection. -/
private def kernelInclusion : H ⟶
    (proj_isSquareZero c S).targetModule (quotientIsIso c S) where
  val := PresheafOfModules.homMk
    { app := fun U ↦ AddCommGrpCat.ofHom
        (AddMonoidHom.mk' (kernelInclusionApp c S U) ((kernelInclusion_laws c S).1 U))
      naturality := fun U V h ↦ ConcreteCategory.hom_ext _ _
        (fun x ↦ ((kernelInclusion_laws c S).2.1 U V h x).symm) }
    (kernelInclusion_laws c S).2.2

/-- The coefficient inclusion identifies the coefficient module with the full kernel. -/
private theorem kernelInclusion_isIso : IsIso (kernelInclusion c S) := sorry

/-- The kernel identification is the inverse of the actual coefficient inclusion. -/
def kernelIso : (proj_isSquareZero c S).targetModule (quotientIsIso c S) ≅ H :=
  (@asIso _ _ _ _ (kernelInclusion c S) (kernelInclusion_isIso c S)).symm

/-- The inverse kernel identification includes a coefficient by its split quotient class. -/
private theorem kernelIso_inv_apply (U : Cᵒᵖ) (n : H.val.obj U) :
    (kernelIso c S).inv.val.app U n = kernelInclusionApp c S U n := sorry

/-- The pushout structure maps commute and induce the zero map from the base kernel. -/
private theorem pushoutAlong_laws :
    (fromBase c S ≫ toTarget c S = 𝟙 A ≫ f) ∧
    (∀ h : fromBase c S ≫ toTarget c S = 𝟙 A ≫ f,
      kernelMapOf (𝟙 A) (isSquareZero_id A) f (toTarget c S)
          (proj_isSquareZero c S) (quotientIsIso c S) (fromBase c S) h ≫
        (restrictionAlong f).map (kernelIso c S).hom = zeroKernelMap f H) := sorry

end Pushout

/-- Pushout of a square-zero algebra extension along a morphism of coefficient modules. -/
def pushoutAlong : Solution (𝟙 A) (isSquareZero_id A) f H (zeroKernelMap f H) where
  middle := Pushout.middle c S
  proj := Pushout.toTarget c S
  structureMap := Pushout.fromBase c S
  proj_locallySurjective := Pushout.proj_isLocallySurjective c S
  proj_squareZero := Pushout.proj_isSquareZero c S
  proj_quotient_isIso := Pushout.quotientIsIso c S
  commutes := (Pushout.pushoutAlong_laws c S).1
  kernelIso := Pushout.kernelIso c S
  induces_c := (Pushout.pushoutAlong_laws c S).2 _

/-- The middle ring of coefficient pushout is the antidiagonal quotient. -/
theorem pushoutAlong_middle : (pushoutAlong c S).middle = Pushout.middle c S := sorry

/-- The projection of coefficient pushout is the quotient-induced projection. -/
theorem pushoutAlong_proj : (pushoutAlong c S).proj = Pushout.toTarget c S := sorry

/-- The algebra structure of coefficient pushout is the quotient-induced base map. -/
theorem pushoutAlong_structureMap :
    (pushoutAlong c S).structureMap = Pushout.fromBase c S := sorry

/-- Coefficient pushout preserves the quotient and base maps and induces the prescribed
map on identified coefficient kernels. -/
theorem pushoutAlong_spec :
    Pushout.fromMiddle c S ≫ (pushoutAlong c S).proj = S.proj ∧
    S.structureMap ≫ Pushout.fromMiddle c S = (pushoutAlong c S).structureMap ∧
    (∀ U (x : F.val.obj U),
      (Pushout.fromMiddle c S).hom.app U
          (KernelIdeal.ιApp S.proj U ((kernelIso_forget S).hom.hom.app U x)) =
        KernelIdeal.ιApp (pushoutAlong c S).proj U
          ((kernelIso_forget (pushoutAlong c S)).hom.hom.app U (c.val.app U x))) := sorry

end SheafOfModules.RingedSite.FirstOrderThickening.Solution
