module

public import ReasLib.Topology.Algebra.TensorProduct.Completion
public import ReasLib.Topology.Algebra.TensorProduct.CompletedRing.ModuleComparison
public import ReasLib.Topology.Algebra.TensorProduct.LinearTopology
import StacksCheckRecall

@[expose] public section

noncomputable section

universe u

namespace TensorProduct

open Filter
open scoped Topology

variable (R M N : Type u)
variable [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]
variable [AddCommGroup M] [Module R M] [TopologicalSpace M] [ContinuousSMul R M]
variable [AddCommGroup N] [Module R N] [TopologicalSpace N]
variable [ContinuousSMul R N]
variable [IsLinearTopology R M] [IsLinearTopology R N]
variable [IsTopologicalAddGroup M] [IsTopologicalAddGroup N]

/- Definition 87.4.7 (1): the tensor product of linearly topologized `R`-modules `M` and `N`
is the usual tensor product `M ⊗[R] N` equipped with the linear topology generated by the images
Im(U ⊗ N + M ⊗ V ⟶ M ⊗[R] N) as `U ⊆ M` and `V ⊆ N` run through open submodules. -/
@[stacks 0AMU] #check (TensorProduct.Linear R M N : Type u)

/- Definition 87.4.7 (2): the completed tensor product is the completion of that tensor product,
equally written as the inverse limits
lim (M ⊗[R] N) ⧸ (U ⊗ N + M ⊗ V) = lim (M ⧸ U) ⊗[R] (N ⧸ V). -/
@[stacks 0AMU] #check (TensorProduct.Completed R M N : Type u)

#check (TensorProduct.Linear.hasBasis_nhds_zero (R := R) (M := M) (N := N) :
  (𝓝 (0 : TensorProduct.Linear R M N)).HasBasis
    (fun UV : Submodule R M × Submodule R N =>
      IsOpen (UV.1 : Set M) ∧ IsOpen (UV.2 : Set N))
    (fun UV =>
      (TensorProduct.Linear.equiv R M N) ⁻¹'
        (TensorProduct.fundamentalSubmodule R M N UV.1 UV.2 : Set (M ⊗[R] N))))

#check (TensorProduct.Linear.hasBasis_nhds_zero_of_hasBasis (R := R) (M := M) (N := N) :
  ∀ {ι κ : Type*} (U : ι → Submodule R M) (V : κ → Submodule R N)
    (p : ι → Prop) (q : κ → Prop),
    (∀ i, p i → IsOpen (U i : Set M)) →
    (∀ j, q j → IsOpen (V j : Set N)) →
    (𝓝 (0 : M)).HasBasis p (fun i => (U i : Set M)) →
    (𝓝 (0 : N)).HasBasis q (fun j => (V j : Set N)) →
    (𝓝 (0 : TensorProduct.Linear R M N)).HasBasis
      (fun ij : ι × κ => p ij.1 ∧ q ij.2)
      (fun ij =>
        (TensorProduct.Linear.equiv R M N) ⁻¹'
          (TensorProduct.fundamentalSubmodule R M N (U ij.1) (V ij.2) :
            Set (M ⊗[R] N))))

#check (TensorProduct.Completed.equivQuotientLimit (R := R) (M := M) (N := N) :
  TensorProduct.Completed R M N ≃ₗ[R] TensorProduct.QuotientLimit R M N)

#check (TensorProduct.Completed.denseRange_of (R := R) (M := M) (N := N) :
  DenseRange (TensorProduct.Completed.of R M N :
    TensorProduct.Linear R M N → TensorProduct.Completed R M N))

#check (TensorProduct.Completed.instCompleteSpace (R := R) (M := M) (N := N) :
  CompleteSpace (TensorProduct.Completed R M N))

#check (TensorProduct.Completed.isUniformInducing_of (R := R) (M := M) (N := N) :
  IsUniformInducing (TensorProduct.Completed.of R M N :
    TensorProduct.Linear R M N → TensorProduct.Completed R M N))

#check (TensorProduct.Linear.instContinuousSMul (R := R) (M := M) (N := N) :
  ContinuousSMul R (TensorProduct.Linear R M N))

#check (TensorProduct.Completed.instContinuousSMul (R := R) (M := M) (N := N) :
  ContinuousSMul R (TensorProduct.Completed R M N))

/- Remark after Definition 87.4.7: for linearly topologized `R`-algebras `A` and `B` the
construction gives the completed tensor product `A ⊗̂_R B`; the ring-level carrier (limit over
open ideals) is identified with the module-level one. -/
#check (Algebra.TensorProduct.Completed.equivModuleCompleted :
  ∀ (R A B : Type u) [CommRing R] [CommRing A] [CommRing B] [Algebra R A] [Algebra R B]
    [TopologicalSpace A] [TopologicalSpace B] [IsTopologicalRing A] [IsTopologicalRing B]
    [IsLinearTopology A A] [IsLinearTopology B B],
    Algebra.TensorProduct.Completed R A B ≃ₗ[R] TensorProduct.Completed R A B)

end TensorProduct
