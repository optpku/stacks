module

public import Mathlib.Algebra.Category.Grp.Abelian
public import Mathlib.CategoryTheory.Preadditive.AdditiveFunctor
public import Mathlib.CategoryTheory.Sites.SheafCohomology.Basic
public import Mathlib.CategoryTheory.Functor.Currying
public import Mathlib.CategoryTheory.Preadditive.Yoneda.Basic
public import Mathlib.CategoryTheory.Sites.Abelian
public import ReasLib.CategoryTheory.Sites.Cohomology.Ext
public import ReasLib.CategoryTheory.Sites.Sheafification.FreeAbelian

/-!
# Cohomology over a presheaf of sets

For a type-valued presheaf `G`, this file packages `Ext` from its free abelian sheaf as a
functor of the coefficient sheaf.  The construction uses the direct free-abelian-sheaf owner and
does not require choosing a set-valued sheafification first.
-/

@[expose] public section

noncomputable section

universe z w v u

namespace CategoryTheory.Sheaf

variable {C : Type u} [Category.{v} C]

/-- The Mathlib cohomology-presheaf functor is additive in its coefficient sheaf. -/
@[stacks 03AY "additivity of the cohomology-presheaf functor"]
noncomputable instance cohomologyPresheafFunctor_additive
    {J : GrothendieckTopology C} (n : ℕ)
    [HasSheafify J AddCommGrpCat.{v}]
    [HasExt.{z} (Sheaf J AddCommGrpCat.{v})] :
    (Sheaf.cohomologyPresheafFunctor.{z, v, u} J n).Additive := sorry

/-- Cohomology over a type-valued presheaf, functorially in the abelian coefficient sheaf. -/
@[stacks 03AY "cohomology over a presheaf",
  stacks 09VX "presheaf-target cohomology"]
abbrev cohomologyOverPresheafFunctor
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{max w v}]
    [HasExt.{z} (Sheaf J AddCommGrpCat.{max w v})]
    (G : Cᵒᵖ ⥤ Type (max w v)) (i : ℕ) :
    Sheaf J AddCommGrpCat.{max w v} ⥤ AddCommGrpCat.{z} :=
  Abelian.extFunctorObj
    (J.freeAbelianSheaf G : Sheaf J AddCommGrpCat.{max w v}) i

/-- Evaluating `cohomologyOverPresheafFunctor` is `Ext` from the free abelian sheaf generated
by the target presheaf. -/
@[stacks 03AY "cohomology over a presheaf evaluation",
  stacks 09VX "presheaf-target cohomology evaluation"]
theorem cohomologyOverPresheafFunctor_obj
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{max w v}]
    [HasExt.{z} (Sheaf J AddCommGrpCat.{max w v})]
    (G : Cᵒᵖ ⥤ Type (max w v)) (i : ℕ)
    (I : Sheaf J AddCommGrpCat.{max w v}) :
    (cohomologyOverPresheafFunctor J G i).obj I =
      (Abelian.extFunctorObj
        (J.freeAbelianSheaf G : Sheaf J AddCommGrpCat.{max w v}) i).obj I := sorry

namespace CohomologyOverPresheaf

/-- The covariant additive Hom functor from the free abelian sheaf generated by a
type-valued presheaf. -/
@[stacks 03AY "cohomology-over-presheaf Hom functor",
  stacks 09VX "underived presheaf-target Hom functor"]
abbrev homFunctor
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{max w v}]
    (G : Cᵒᵖ ⥤ Type (max w v)) :
    Sheaf J AddCommGrpCat.{max w v} ⥤ AddCommGrpCat.{max u v w} :=
  preadditiveCoyoneda.obj
    (Opposite.op (J.freeAbelianSheaf G : Sheaf J AddCommGrpCat.{max w v}))

end CohomologyOverPresheaf

/-- The presheaf sending `X` to cohomology over the universe-raised representable
`uliftYoneda.obj X`, functorially in the coefficient sheaf. -/
@[stacks 03AY "universe-raised cohomology presheaf functor"]
noncomputable def uliftCohomologyPresheafFunctor
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{max w v}]
    [HasExt.{z} (Sheaf J AddCommGrpCat.{max w v})]
    (i : ℕ) :
    Sheaf J AddCommGrpCat.{max w v} ⥤ Cᵒᵖ ⥤ AddCommGrpCat.{z} :=
  Functor.flip
    (Functor.op (uliftYoneda.{w} ⋙ J.freeAbelianSheafFunctor) ⋙
      Abelian.extFunctor i)

/-- The universe-raised objectwise cohomology presheaf of one coefficient sheaf. -/
@[stacks 03AY "universe-raised cohomology presheaf"]
abbrev uliftCohomologyPresheaf
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{max w v}]
    [HasExt.{z} (Sheaf J AddCommGrpCat.{max w v})]
    (I : Sheaf J AddCommGrpCat.{max w v}) (i : ℕ) :
    Cᵒᵖ ⥤ AddCommGrpCat.{z} :=
  (uliftCohomologyPresheafFunctor J i).obj I

/-- Evaluating the universe-raised cohomology presheaf at `X` is cohomology over the
universe-raised representable of `X`. -/
@[stacks 03AY "universe-raised cohomology presheaf evaluation"]
theorem uliftCohomologyPresheaf_obj
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{max w v}]
    [HasExt.{z} (Sheaf J AddCommGrpCat.{max w v})]
    (I : Sheaf J AddCommGrpCat.{max w v}) (i : ℕ) (X : C) :
    (uliftCohomologyPresheaf J I i).obj (Opposite.op X) =
      (cohomologyOverPresheafFunctor J (uliftYoneda.{w}.obj X) i).obj I := sorry

end CategoryTheory.Sheaf
