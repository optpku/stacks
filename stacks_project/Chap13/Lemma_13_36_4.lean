module

import ReasLib.CategoryTheory.Pretriangulated.Generation.Comparison
import StacksCheckRecall

@[expose] public section

open CategoryTheory
open CategoryTheory.ObjectProperty

-- Lemma 13.36.4: the reusable orthogonality criterion is stated directly in terms of the
-- canonical triangulated envelope generated by one object. Mathlib's `rightOrthogonal_iff`
-- expands the second condition into vanishing against every object of that envelope.
@[stacks 09SK] #check @CategoryTheory.ObjectProperty.Generated.Property.rightOrthogonal_iff
#check @CategoryTheory.ObjectProperty.triangEnvelope.rightOrthogonal_iff
#check @CategoryTheory.ObjectProperty.triangEnvelope.leftOrthogonal_iff
#check @CategoryTheory.ObjectProperty.rightOrthogonal_iff
