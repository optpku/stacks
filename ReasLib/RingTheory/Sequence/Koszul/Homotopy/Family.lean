module

public import ReasLib.Algebra.Homology.HomologicalComplex.HomologyAnnihilator
public import ReasLib.RingTheory.Sequence.Koszul.Family
public import ReasLib.RingTheory.Sequence.Koszul.Homotopy
import Mathlib.Tactic.CrossRefAttribute

/-!
# Finite-family Koszul contraction API

This file owns the finite-family specialization of the linear-form contraction.  The generic
homological annihilator statements live with homology maps, while this namespace supplies the
canonical basis-vector specialization used for a family of ring elements.

@stack 0663
-/

@[expose] public section

noncomputable section

open CategoryTheory
open HomologicalComplex

universe u

variable {R : Type u} [CommRing R]

namespace KoszulComplex.Family

/-- The canonical null-homotopy for multiplication by a member of a finite family. -/
@[stacks 0663 "finite-family Koszul generator null-homotopy"]
noncomputable def scalarHomotopyZero {r : ℕ} (f : Fin r → R) (i : Fin r) :
    Homotopy ((f i) • 𝟙 (KoszulComplex.family f)) 0 :=
  Eq.mp
    (congrArg (fun a : R => Homotopy (a • 𝟙 (KoszulComplex.family f)) 0)
      (koszulLinearForm_basis f i))
    (KoszulComplex.scalarHomotopyZero (koszulLinearForm f)
      (Pi.basisFun R (Fin r) i))

/-- The ideal generated by a finite family annihilates every homology module of its Koszul complex. -/
@[stacks 0663 "finite-family Koszul homology annihilator"]
theorem span_le_annihilator {r : ℕ} (f : Fin r → R) (n : ℕ)
    [(KoszulComplex.family f).HasHomology n] :
    Ideal.span (Set.range f) ≤
      Module.annihilator R ((KoszulComplex.family f).homology n) := sorry

end KoszulComplex.Family

end
