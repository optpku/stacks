module

public import ReasLib.CategoryTheory.Sites.Point.Refinement.StageDiagram.Basic

/-!
# Sequential refinement-stage diagrams

This file builds a lower stage diagram from successive refinement maps indexed by `ℕ`.
-/

@[expose] public section

open CategoryTheory Limits Opposite

noncomputable section

universe u v r

namespace CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered

variable {C : Type u} [Category.{v} C]

namespace DirectedPreorderSystem.StageDiagram.Sequential

/-- The refinement obtained by composing the successive maps of a sequence from stage `n` to
any later stage `m`.  This is the reusable data owner for countable directed-union constructions;
the coherence statements below are confined to propositions. -/
noncomputable def map
    (A : ℕ → DirectedPreorderSystem.{u, v, r} C)
    (step : ∀ n, OrderedRefinement (A n).diagram (A (n + 1)).diagram)
    {n m : ℕ} (h : n ≤ m) :
    OrderedRefinement (A n).diagram (A m).diagram :=
  Nat.leRecOn (C := fun m => OrderedRefinement (A n).diagram (A m).diagram) h
    (fun {k} H => H.comp (step k))
    (OrderedRefinement.id (A n).diagram)

/-- A zero-length sequential refinement is the identity refinement. -/
@[simp] theorem map_refl
    (A : ℕ → DirectedPreorderSystem.{u, v, r} C)
    (step : ∀ n, OrderedRefinement (A n).diagram (A (n + 1)).diagram)
    (n : ℕ) :
    map A step (n := n) (m := n) le_rfl = OrderedRefinement.id (A n).diagram := sorry

/-- Sequential refinement maps compose along natural-number inequalities. -/
theorem map_comp
    (A : ℕ → DirectedPreorderSystem.{u, v, r} C)
    (step : ∀ n, OrderedRefinement (A n).diagram (A (n + 1)).diagram)
    {n m k : ℕ} (hnm : n ≤ m) (hmk : m ≤ k) :
    map A step (le_trans hnm hmk) = (map A step hnm).comp (map A step hmk) := sorry

/-- The directed stage diagram generated by successive refinement maps.  It is deliberately
lower-level: stage nonemptiness and smallness can be added later through `toDirected`. -/
noncomputable def diagram
    (A : ℕ → DirectedPreorderSystem.{u, v, r} C)
    (step : ∀ n, OrderedRefinement (A n).diagram (A (n + 1)).diagram) :
    DirectedPreorderSystem.StageDiagram ℕ C where
  obj := A
  map := fun h => map A step h
  map_refl := map_refl A step
  map_comp := map_comp A step

end DirectedPreorderSystem.StageDiagram.Sequential

end CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered
