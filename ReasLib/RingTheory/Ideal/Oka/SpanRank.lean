module

public import Mathlib.Algebra.Module.SpanRank
public import Mathlib.RingTheory.Ideal.Oka
import Mathlib.Tactic.CrossRefAttribute

/-!
# Oka families bounded by span rank

For an infinite cardinal `κ`, the ideals whose span rank is at most `κ` form an Oka family.
The intermediate lemma isolates the generator-counting step used by the Oka condition.

@stack 05KD
-/

@[expose] public section

universe u

namespace Ideal

/-- If adjoining one element to `I` and the corresponding colon ideal both have span rank at most
an infinite cardinal `κ`, then `I` also has span rank at most `κ`. -/
theorem spanRank_le_of_sup_colon_le {R : Type u} [CommRing R]
    {I : Ideal R} {a : R} {κ : Cardinal.{u}} (hκ : Cardinal.aleph0 ≤ κ)
    (hsup : (I ⊔ span {a}).spanRank ≤ κ)
    (hcolon : (I.colon (span {a})).spanRank ≤ κ) :
    I.spanRank ≤ κ := sorry

/-- Example 10.28.6 (Tag 05KD): for an infinite cardinal `κ`, the ideals generated by at most
`κ` elements form an Oka family. -/
@[stacks 05KD]
theorem isOka_spanRank_le {R : Type u} [CommRing R]
    (κ : Cardinal.{u}) (hκ : Cardinal.aleph0 ≤ κ) :
    IsOka (fun I : Ideal R ↦ I.spanRank ≤ κ) := sorry

end Ideal
