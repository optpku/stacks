module

public import Mathlib.CategoryTheory.ObjectProperty.CompleteLattice
public import ReasLib.RingTheory.RingHom.IndEtale.Basic
public import stacks_project.Chap61.Lemma_61_12_20_Affine

/-!
# Affine ind-étale objects of the small pro-étale site

The full subcategory of affine objects `U` of `S.ProEt` such that
`Γ(S, ⊤) ⟶ Γ(U, ⊤)` is ind-étale, equipped with the topology generated
by ambient-covering standard pro-étale covers.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.ObjectProperty

universe u

namespace AlgebraicGeometry.Scheme.ProEt

/-- The object property selecting affine objects of the small pro-étale site
whose structure map is ind-étale on global sections. -/
abbrev affineIndEtaleObjects (S : Scheme.{u}) [IsAffine S] : ObjectProperty S.ProEt :=
  affineObjects S ⊓ fun U ↦ (U.hom.appTop).hom.IndEtale

/-- Affine ind-étale objects of the small pro-étale site of an affine scheme
are affine objects `U` with `(U.hom.appTop).hom.IndEtale`. -/
theorem affineIndEtaleObjects_iff (S : Scheme.{u}) [IsAffine S] (U : S.ProEt) :
    affineIndEtaleObjects S U ↔
      IsAffine U.left ∧ (U.hom.appTop).hom.IndEtale := sorry

/-- Affine ind-étale objects of `S.ProEt` are affine objects of `S.ProEt`. -/
theorem affineIndEtaleObjects_le_affineObjects (S : Scheme.{u}) [IsAffine S] :
    affineIndEtaleObjects S ≤ affineObjects S := sorry

/-- The full subcategory of affine ind-étale objects of the small pro-étale
site of an affine scheme. -/
abbrev AffineIndEtale (S : Scheme.{u}) [IsAffine S] :=
  (affineIndEtaleObjects S).FullSubcategory

/-- Construct an affine ind-étale object of the small pro-étale site from an
affine weakly étale morphism whose global-sections map is ind-étale. -/
def AffineIndEtale.mk {S : Scheme.{u}} [IsAffine S] {X : Scheme.{u}} (f : X ⟶ S)
    [IsAffine X] [WeaklyEtale f] (h : (f.appTop).hom.IndEtale) :
    AffineIndEtale S :=
  ⟨ProEt.mk f, ⟨‹IsAffine X›, h⟩⟩

/-- The underlying object of `AffineIndEtale.mk f h` is the corresponding object
of the small pro-étale site. -/
theorem AffineIndEtale.mk_obj {S : Scheme.{u}} [IsAffine S] {X : Scheme.{u}}
    (f : X ⟶ S) [IsAffine X] [WeaklyEtale f] (h : (f.appTop).hom.IndEtale) :
    (AffineIndEtale.mk f h).obj = ProEt.mk f := sorry

/-- The inclusion of affine ind-étale objects into the small pro-étale site. -/
def affineIndEtaleInclusion (S : Scheme.{u}) [IsAffine S] :
    AffineIndEtale S ⥤ S.ProEt :=
  (affineIndEtaleObjects S).ι

/-- The inclusion of an affine ind-étale object is the underlying object of the
small pro-étale site. -/
theorem affineIndEtaleInclusion_obj (S : Scheme.{u}) [IsAffine S]
    (U : AffineIndEtale S) :
    (affineIndEtaleInclusion S).obj U = U.obj := sorry

/-- The inclusion of affine ind-étale objects into the affine objects of the
small pro-étale site. -/
def affineIndEtaleToAffine (S : Scheme.{u}) [IsAffine S] :
    AffineIndEtale S ⥤ Affine S :=
  ιOfLE (inf_le_left : affineIndEtaleObjects S ≤ affineObjects S)

/-- The inclusion into affine objects sends an affine ind-étale object to the
same underlying object of the small pro-étale site. -/
theorem affineIndEtaleToAffine_obj (S : Scheme.{u}) [IsAffine S]
    (U : AffineIndEtale S) :
    ((affineIndEtaleToAffine S).obj U).obj = U.obj := sorry

/-- Every object of the affine ind-étale small pro-étale site has affine source
scheme. -/
instance AffineIndEtale.instIsAffine (S : Scheme.{u}) [IsAffine S]
    (U : AffineIndEtale S) : IsAffine U.obj.left :=
  U.property.1

/-- A presieve on an affine ind-étale object is a standard covering when its
image in the affine small pro-étale site is a standard pro-étale covering. -/
def affineIndEtaleStandardCovering (S : Scheme.{u}) [IsAffine S]
    {U : AffineIndEtale S} (R : Presieve U) : Prop :=
  affineStandardCovering S (R.map (affineIndEtaleToAffine S))

/-- Standard coverings of affine ind-étale objects are the standard pro-étale
coverings of their images in the affine small pro-étale site. -/
theorem affineIndEtaleStandardCovering_iff (S : Scheme.{u}) [IsAffine S]
    {U : AffineIndEtale S} {R : Presieve U} :
    affineIndEtaleStandardCovering S R ↔
      affineStandardCovering S (R.map (affineIndEtaleToAffine S)) := sorry

/-- The precoverage of ambient-covering finite standard pro-étale families on
affine ind-étale objects of the small pro-étale site. -/
def affineIndEtalePrecoverage (S : Scheme.{u}) [IsAffine S] :
    Precoverage (AffineIndEtale S) where
  coverings := fun _ ↦ { R | affineIndEtaleStandardCovering S R }

/-- Membership in the affine ind-étale standard precoverage is the standard
pro-étale covering condition after inclusion into affine objects. -/
theorem mem_affineIndEtalePrecoverage_iff (S : Scheme.{u}) [IsAffine S]
    {U : AffineIndEtale S} {R : Presieve U} :
    R ∈ affineIndEtalePrecoverage S U ↔ affineIndEtaleStandardCovering S R :=
  sorry

/-- The Grothendieck topology on affine ind-étale objects generated by
ambient-covering finite standard pro-étale families. -/
def affineIndEtaleTopology (S : Scheme.{u}) [IsAffine S] :
    GrothendieckTopology (AffineIndEtale S) :=
  (affineIndEtalePrecoverage S).toGrothendieck

/-- The affine ind-étale small pro-étale topology is generated by its standard
pro-étale precoverage. -/
theorem affineIndEtaleTopology_def (S : Scheme.{u}) [IsAffine S] :
    affineIndEtaleTopology S = (affineIndEtalePrecoverage S).toGrothendieck :=
  sorry

end AlgebraicGeometry.Scheme.ProEt
