module

public import ReasLib.AlgebraicGeometry.Scheme.Module.Etale.CurveComparison.NoncommCompactModule
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.LinearAlgebra.Quotient.Basic

@[expose] public section
open CategoryTheory
noncomputable section
universe u

namespace NoncommBalancedTensor
variable (R G : Type u) [Ring R] [Group G]
variable (M : Action (ModuleCat.{u} R) G)

/-- Free LEFT R-module on underlying vectors of M. The tensor uses R as
an (R,R[G])-bimodule via right augmentation, and M as a LEFT R[G]-module. -/
abbrev Free := M.V →₀ R

/-- Independent balanced presentation: additivity in vectors, R-balancing,
and triviality of the first factor's G-action. -/
inductive Relation : Free R G M → Prop
  | zero : Relation (Finsupp.single 0 1)
  | add (x y : M.V) : Relation
      (Finsupp.single (x + y) 1 - Finsupp.single x 1 - Finsupp.single y 1)
  | scalar (r : R) (x : M.V) : Relation
      (Finsupp.single (r • x) 1 - r • Finsupp.single x 1)
  | group (g : G) (x : M.V) : Relation
      (Finsupp.single ((M.ρ g).hom x) 1 - Finsupp.single x 1)

/-- The submodule generated by the specified tensor relations. -/
def relations : Submodule R (Free R G M) := Submodule.span R {v | Relation R G M v}

/-- The balanced quotient is defined before, and independently of, coinvariants. -/
abbrev tensor : ModuleCat.{u} R := ModuleCat.of R ((Free R G M) ⧸ relations R G M)

/-- The specified tensor symbol [1⊗m]. -/
def inclusion : M.V →ₗ[R] tensor R G M where
  toFun m := (relations R G M).mkQ (Finsupp.single m 1)
  map_add' := by sorry
  map_smul' := by sorry

/-- The tensor symbol [r⊗m], using LEFT multiplication on the first factor. -/
def symbol (r : R) (m : M.V) : tensor R G M := r • inclusion R G M m

/-- The genuine right/left balancing law, without commuting r and s. -/
theorem symbol_balanced (r s : R) (m : M.V) :
    symbol R G M (r * s) m = symbol R G M r (s • m) := by
  simp [symbol, mul_smul]

/-- Algebraic geometric coinvariants, used only for comparison to the independent tensor. -/
def coinvariantRelations : Submodule R M.V :=
  Submodule.span R (Set.range (fun gx : G × M.V ↦ (M.ρ gx.1).hom gx.2 - gx.2))

/-- Evaluate a formal tensor sum in the actual coinvariant quotient. -/
def evaluate : Free R G M →ₗ[R] (M.V ⧸ coinvariantRelations R G M) :=
  Finsupp.linearCombination R (fun m ↦ (coinvariantRelations R G M).mkQ m)

/-- Evaluation annihilates precisely the listed balancing relations. -/
theorem relations_le_evaluate_kernel : relations R G M ≤ LinearMap.ker (evaluate R G M) := by sorry

/-- Actual quotient lift of tensor evaluation. -/
def toCoinvariants : tensor R G M →ₗ[R] (M.V ⧸ coinvariantRelations R G M) :=
  (relations R G M).liftQ (evaluate R G M) (relations_le_evaluate_kernel R G M)

/-- The tensor symbol kills the geometric group relations. -/
theorem coinvariantRelations_le_kernel : coinvariantRelations R G M ≤
    LinearMap.ker (inclusion R G M) := by sorry

/-- Actual inverse given by m ↦ [1⊗m]. -/
def fromCoinvariants : (M.V ⧸ coinvariantRelations R G M) →ₗ[R] tensor R G M :=
  (coinvariantRelations R G M).liftQ (inclusion R G M) (coinvariantRelations_le_kernel R G M)

/-- The displayed maps are inverse by evaluating generators, for arbitrary R. -/
def equiv : tensor R G M ≃ₗ[R] (M.V ⧸ coinvariantRelations R G M) :=
  LinearEquiv.ofLinear (toCoinvariants R G M) (fromCoinvariants R G M)
    (by sorry) (by sorry)

/-- For a finite ring and finite coefficient module, the tensor stage is finite. -/
instance finite_tensor [Finite R] [Finite M.V] : Finite (tensor R G M) := by
  -- Local instance justification (defeq pin): the explicit free-module carrier embeds into the finite function type.
  letI : Finite (Free R G M) := Finite.of_injective
    (fun f : Free R G M ↦ (f : M.V → R)) DFunLike.coe_injective
  change Finite ((Free R G M) ⧸ relations R G M)
  exact Finite.of_surjective (relations R G M).mkQ (Submodule.mkQ_surjective _)

variable {M}

/-- Apply an actual equivariant map to each free generator. -/
def freeMap {N : Action (ModuleCat.{u} R) G} (f : M ⟶ N) :
    Free R G M →ₗ[R] Free R G N :=
  Finsupp.linearCombination R (fun m ↦ Finsupp.single (f.hom.hom m) 1)

/-- Equivariance and linearity preserve the specified balancing relations. -/
theorem map_relations {N : Action (ModuleCat.{u} R) G} (f : M ⟶ N) :
    relations R G M ≤ (relations R G N).comap (freeMap R G f) := by sorry

/-- Functoriality of the independent balanced quotient. -/
def map {N : Action (ModuleCat.{u} R) G} (f : M ⟶ N) :
    tensor R G M →ₗ[R] tensor R G N :=
  (relations R G M).mapQ (relations R G N) (freeMap R G f) (map_relations R G f)

/-- The tensor map sends its actual distinguished generator to its image. -/
theorem map_inclusion {N : Action (ModuleCat.{u} R) G} (f : M ⟶ N) (m : M.V) :
    map R G f (inclusion R G M m) = inclusion R G N (f.hom.hom m) := by sorry

end NoncommBalancedTensor
