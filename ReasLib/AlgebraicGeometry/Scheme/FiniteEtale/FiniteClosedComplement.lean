module

public import ReasLib.AlgebraicGeometry.Scheme.PuncturedStrictHenselization
public import ReasLib.AlgebraicGeometry.Scheme.FiniteEtale
public import Mathlib.CategoryTheory.CatCommSq
public import Mathlib.CategoryTheory.Galois.Action
public import Mathlib.CategoryTheory.Galois.Topology
public import Mathlib.Topology.Constructible

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.PreGaloisCategory
open AlgebraicGeometry.PuncturedSpectrum

universe u v w

namespace AlgebraicGeometry.Scheme.FiniteEtale

/-- A connected retrocompact complement of finitely many closed points induces a surjection on
automorphism groups of fiber functors. -/
theorem surjective_of_finiteClosedComplement {X : Scheme.{u}} {ι : Type v} [Finite ι]
    (x : ι → X) (hx : ∀ i, IsClosed ({x i} : Set X)) (U : X.Opens)
    (hUeq : (U : Set X) = (Set.range x)ᶜ) [ConnectedSpace U]
    (hretro : IsRetrocompact (U : Set X)) (Ash : ι → Type u)
    [∀ i, CommRing (Ash i)]
    [∀ i, Algebra (X.presheaf.stalk (x i)) (Ash i)]
    [∀ i, IsStrictHenselizationOf (X.presheaf.stalk (x i)) (Ash i)]
    [∀ i, ConnectedSpace (scheme (Ash i))]
    (FX : FiniteEtale X ⥤ FintypeCat.{w}) [GaloisCategory (FiniteEtale X)] [FiberFunctor FX]
    (FU : FiniteEtale (U : Scheme.{u}) ⥤ FintypeCat.{w})
    [GaloisCategory (FiniteEtale (U : Scheme.{u}))] [FiberFunctor FU]
    (h : ContinuousMonoidHom (Aut FU) (Aut FX))
    (h_id : CatCommSq (finiteEtaleBaseChange U.ι) (functorToAction FX)
      (functorToAction FU) (Action.res FintypeCat h.toMonoidHom)) :
    Function.Surjective h := sorry

/-- The closed normal subgroup generated by the local punctured strict henselization groups is the
kernel of restriction from the complement to the ambient scheme. -/
theorem ker_of_finiteClosedComplement {X : Scheme.{u}} {ι : Type v} [Finite ι]
    (x : ι → X) (hx : ∀ i, IsClosed ({x i} : Set X)) (U : X.Opens)
    (hUeq : (U : Set X) = (Set.range x)ᶜ) [ConnectedSpace U]
    (hretro : IsRetrocompact (U : Set X)) (Ash : ι → Type u)
    [∀ i, CommRing (Ash i)]
    [∀ i, Algebra (X.presheaf.stalk (x i)) (Ash i)]
    [∀ i, IsStrictHenselizationOf (X.presheaf.stalk (x i)) (Ash i)]
    [∀ i, ConnectedSpace (scheme (Ash i))]
    (FX : FiniteEtale X ⥤ FintypeCat.{w}) [GaloisCategory (FiniteEtale X)] [FiberFunctor FX]
    (FU : FiniteEtale (U : Scheme.{u}) ⥤ FintypeCat.{w})
    [GaloisCategory (FiniteEtale (U : Scheme.{u}))] [FiberFunctor FU]
    (h : ContinuousMonoidHom (Aut FU) (Aut FX))
    (h_id : CatCommSq (finiteEtaleBaseChange U.ι) (functorToAction FX)
      (functorToAction FU) (Action.res FintypeCat h.toMonoidHom))
    (FUsh : ∀ i, FiniteEtale (scheme (Ash i)) ⥤ FintypeCat.{w})
    [∀ i, GaloisCategory (FiniteEtale (scheme (Ash i)))]
    [∀ i, FiberFunctor (FUsh i)]
    (hUsh : ∀ i, ContinuousMonoidHom (Aut (FUsh i)) (Aut FU))
    (hUsh_id : ∀ i,
      CatCommSq
        (finiteEtaleBaseChange
          (PuncturedStrictHenselization.map x hx U hUeq Ash i))
        (functorToAction FU) (functorToAction (FUsh i))
        (Action.res FintypeCat (hUsh i).toMonoidHom)) :
    MonoidHom.ker h.toMonoidHom =
      (Subgroup.normalClosure
          (⋃ i, Set.range (hUsh i).toMonoidHom)).topologicalClosure := sorry

end AlgebraicGeometry.Scheme.FiniteEtale
