module

public import ReasLib.RingTheory.DiscreteValuationRing.Extension.ArtinSchreier
public import ReasLib.RingTheory.Etale.Neighborhood.LocalConsequences
public import ReasLib.RingTheory.Normal.Ring
import Mathlib.Tactic.CrossRefAttribute

/-!
# Normalization of an integral Artin--Schreier extension

When the Artin--Schreier parameter lies in the base DVR, the monogenic algebra generated by a
chosen root is integral and etale, identifies with the normalization, and has unramified branches.

@stack 09F0
-/

@[expose] public section

open Polynomial IsLocalRing
open scoped IntermediateField

universe u v

namespace DVR.ArtinSchreier.Normalization

variable {A : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
variable {L : Type v} [Field L] [Algebra A L] [Algebra (FractionRing A) L]
variable [IsScalarTower A (FractionRing A) L]
variable {p : ℕ} [Fact p.Prime] [CharP (FractionRing A) p]
variable {ξ : FractionRing A}

/-- An Artin--Schreier root is integral over the base DVR when its parameter comes from the base
ring. -/
@[stacks 09F0 "integrality of an Artin--Schreier root"]
theorem root_isIntegral_of_mem
    (z : L) (hz : z ^ p - z = algebraMap (FractionRing A) L ξ)
    (hξ : ∃ a : A, algebraMap A (FractionRing A) a = ξ) :
    IsIntegral A z := sorry
-- Proof strategy: choose `a : A` representing `ξ`; the monic polynomial
-- `X ^ p - X - C a : A[X]` evaluates to zero at `z` by `hz`, so apply
-- `IsIntegral.of_aeval_monic`.

/-- The algebra generated by an integral Artin--Schreier root is integral over the base DVR. -/
@[stacks 09F0 "integrality of the monogenic Artin--Schreier algebra"]
theorem adjoin_isIntegral_of_mem
    (z : L) (hz : z ^ p - z = algebraMap (FractionRing A) L ξ)
    (hξ : ∃ a : A, algebraMap A (FractionRing A) a = ξ) :
    Algebra.IsIntegral A (Algebra.adjoin A ({z} : Set L)) := sorry
-- Proof strategy: apply the integrality criterion for `Algebra.adjoin` to
-- `root_isIntegral_of_mem z hz hξ` on the singleton generator.

/-- The algebra generated by an integral Artin--Schreier root is etale over the base DVR. -/
@[stacks 09F0 "etaleness of the monogenic Artin--Schreier algebra"]
theorem adjoin_etale_of_mem
    (z : L) (hz : z ^ p - z = algebraMap (FractionRing A) L ξ)
    (hξ : ∃ a : A, algebraMap A (FractionRing A) a = ξ) :
    let S : Subalgebra A L := Algebra.adjoin A ({z} : Set L)
    Algebra.Etale A S := sorry
-- Proof strategy: identify the monogenic algebra with the quotient by the minimal polynomial of
-- `z`.  That polynomial divides the Artin--Schreier polynomial; its derivative is a unit because
-- `p = 0` and the derivative of `X ^ p - X - C a` is `-1`.  Use the monogenic etale criterion and
-- transport etaleness across `minpoly.equivAdjoin`.

/-- A generating integral Artin--Schreier root identifies its monogenic algebra with the
normalization of the base DVR in the ambient field. -/
@[stacks 09F0 "the monogenic algebra is the integral closure"]
theorem adjoin_isIntegralClosure_of_mem
    (z : L) (hz : z ^ p - z = algebraMap (FractionRing A) L ξ)
    (hgen : (FractionRing A)⟮z⟯ = ⊤)
    (hξ : ∃ a : A, algebraMap A (FractionRing A) a = ξ) :
    let S : Subalgebra A L := Algebra.adjoin A ({z} : Set L)
    IsIntegralClosure S A L := sorry
-- Proof strategy: `adjoin_isIntegral_of_mem` gives integrality and `adjoin_etale_of_mem` makes the
-- monogenic algebra normal over the normal DVR.  Use `hgen` and denominator clearing to show that
-- `L` is its fraction field, then apply `IsIntegralClosure.of_isIntegrallyClosed`.

/-- Every branch of the monogenic algebra generated by an integral Artin--Schreier root is
unramified over the base DVR. -/
@[stacks 09F0 "unramified branches of the monogenic algebra"]
theorem adjoin_branch_isUnramifiedAt_of_mem
    (z : L) (hz : z ^ p - z = algebraMap (FractionRing A) L ξ)
    (hgen : (FractionRing A)⟮z⟯ = ⊤)
    (hξ : ∃ a : A, algebraMap A (FractionRing A) a = ξ) :
    let S : Subalgebra A L := Algebra.adjoin A ({z} : Set L)
    ∀ Q : Ideal S, [Q.IsMaximal] → [Q.LiesOver (maximalIdeal A)] →
      Algebra.IsUnramifiedAt A Q := sorry
-- Proof strategy: apply `adjoin_etale_of_mem` at the localization determined by `Q`.  The etale
-- neighborhood consequences give both the maximal-ideal map equality and a finite separable
-- residue extension, which are the two components of `Algebra.IsUnramifiedAt A Q`.

/-- Every branch of the normalization of an integral Artin--Schreier extension is unramified over
the base DVR. -/
@[stacks 09F0 "unramified branches of the integral closure"]
theorem integralClosure_branch_isUnramifiedAt_of_mem
    (z : L) (hz : z ^ p - z = algebraMap (FractionRing A) L ξ)
    (hgen : (FractionRing A)⟮z⟯ = ⊤)
    (hξ : ∃ a : A, algebraMap A (FractionRing A) a = ξ) :
    ∀ P : Ideal (integralClosure A L), [P.IsMaximal] → [P.LiesOver (maximalIdeal A)] →
      Algebra.IsUnramifiedAt A P := sorry
-- Proof strategy: obtain the canonical equivalence between the monogenic algebra and the integral
-- closure from `adjoin_isIntegralClosure_of_mem`, transport `P` and its lies-over data to that
-- algebra, apply `adjoin_branch_isUnramifiedAt_of_mem`, and transport the local unramified
-- property back along the algebra equivalence.

end DVR.ArtinSchreier.Normalization
