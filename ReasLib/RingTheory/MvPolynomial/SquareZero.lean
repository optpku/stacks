module

public import Mathlib.Algebra.Module.Torsion.Field
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.LocalRing.Basic
public import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
public import Mathlib.RingTheory.LocalRing.ResidueField.Basic
public import ReasLib.RingTheory.Ideal.AssociatedPrime.Domain
public import ReasLib.RingTheory.Ideal.LocallyNilpotent
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Square-zero multivariate-polynomial quotients

For an arbitrary index type `σ`, this module studies the quotient of
`MvPolynomial σ k` by the ideal generated by the squares of the variables.  Its
public data are the relation ideal, its quotient, the class of a variable, and
the constant-term augmentation.  Locality and associated-prime behavior are
proposition-valued consequences; the residue-field equivalences are explicit
views of the quotient's canonical residue-field data.
-/

@[expose] public section

universe u v

namespace MvPolynomial.SquareZero

open IsLocalRing

variable {σ : Type u} {k : Type v}

/-- The ideal generated by all coordinate squares in `MvPolynomial σ k`. -/
@[stacks 05BX "square-zero relation ideal"]
noncomputable abbrev relationIdeal [CommSemiring k] : Ideal (MvPolynomial σ k) :=
  Ideal.span (Set.range fun i : σ => (MvPolynomial.X i : MvPolynomial σ k) ^ 2)

/-- The quotient of `MvPolynomial σ k` in which every coordinate square vanishes. -/
@[stacks 05BX "square-zero polynomial quotient"]
abbrev Quotient [CommRing k] := MvPolynomial σ k ⧸ relationIdeal (σ := σ) (k := k)

/-- The quotient class of a coordinate variable. -/
@[stacks 05BX "square-zero variable class"]
noncomputable abbrev generator [CommRing k] (i : σ) : Quotient (σ := σ) (k := k) :=
  Ideal.Quotient.mk (relationIdeal (σ := σ) (k := k)) (MvPolynomial.X i)

/-- Every coordinate variable is square-zero in the quotient. -/
@[simp, stacks 05BX "square-zero variable relation"]
theorem generator_sq [CommRing k] (i : σ) :
    generator (σ := σ) (k := k) i ^ (2 : ℕ) = 0 := sorry

/-- The square-zero relation ideal is contained in the kernel of any `k`-algebra map that
annihilates every variable square.  Keeping the containment explicit also supports maps not
presented by polynomial evaluation. -/
@[stacks 05BX "square-zero relation ideal kernel criterion"]
theorem relationIdeal_le_ker_of_X_sq
    [CommSemiring k] {A : Type*} [Semiring A] [Algebra k A]
    (f : MvPolynomial σ k →ₐ[k] A)
    (hf : ∀ i, f (MvPolynomial.X i) ^ (2 : ℕ) = 0) :
    relationIdeal (σ := σ) (k := k) ≤ RingHom.ker f.toRingHom := sorry

/-- The universal `k`-algebra map out of the square-zero quotient associated to a polynomial
algebra map that kills the relation ideal. -/
@[stacks 05BX "square-zero quotient universal lift"]
noncomputable def lift
    [CommRing k] {A : Type*} [Semiring A] [Algebra k A]
    (f : MvPolynomial σ k →ₐ[k] A)
    (hker : relationIdeal (σ := σ) (k := k) ≤ RingHom.ker f.toRingHom) :
    Quotient (σ := σ) (k := k) →ₐ[k] A :=
  Ideal.Quotient.liftₐ
    (relationIdeal (σ := σ) (k := k)) f
    (fun _p hp => RingHom.mem_ker.mp (hker hp))

/-- The generic quotient lift agrees with the original algebra map on representatives. -/
@[simp, stacks 05BX "square-zero quotient lift on representatives"]
theorem lift_apply_mk
    [CommRing k] {A : Type*} [Semiring A] [Algebra k A]
    (f : MvPolynomial σ k →ₐ[k] A)
    (hker : relationIdeal (σ := σ) (k := k) ≤ RingHom.ker f.toRingHom)
    (p : MvPolynomial σ k) :
    lift (σ := σ) (k := k) f hker
      (Ideal.Quotient.mk (relationIdeal (σ := σ) (k := k)) p) = f p := sorry

/-- The generic quotient lift sends a square-zero variable class to the corresponding
polynomial variable. -/
@[simp, stacks 05BX "square-zero quotient lift on generators"]
theorem lift_generator
    [CommRing k] {A : Type*} [Semiring A] [Algebra k A]
    (f : MvPolynomial σ k →ₐ[k] A)
    (hker : relationIdeal (σ := σ) (k := k) ≤ RingHom.ker f.toRingHom) (i : σ) :
    lift (σ := σ) (k := k) f hker (generator (σ := σ) (k := k) i) =
      f (MvPolynomial.X i) := sorry

/-- The generic quotient lift preserves the coefficient-ring algebra map. -/
@[simp, stacks 05BX "square-zero quotient lift on coefficients"]
theorem lift_algebraMap
    [CommRing k] {A : Type*} [Semiring A] [Algebra k A]
    (f : MvPolynomial σ k →ₐ[k] A)
    (hker : relationIdeal (σ := σ) (k := k) ≤ RingHom.ker f.toRingHom) (a : k) :
    lift (σ := σ) (k := k) f hker
      (algebraMap k (Quotient (σ := σ) (k := k)) a) = algebraMap k A a := sorry

/-- Composition with the quotient map recovers the original algebra map of a generic lift. -/
@[simp, stacks 05BX "square-zero quotient lift composition"]
theorem lift_comp_mkₐ
    [CommRing k] {A : Type*} [Semiring A] [Algebra k A]
    (f : MvPolynomial σ k →ₐ[k] A)
    (hker : relationIdeal (σ := σ) (k := k) ≤ RingHom.ker f.toRingHom) :
    (lift (σ := σ) (k := k) f hker).comp
        (Ideal.Quotient.mkₐ k (relationIdeal (σ := σ) (k := k))) = f := sorry

/-- The quotient lift is the unique algebra map whose composite with the quotient map is the
original map. -/
@[stacks 05BX "square-zero quotient lift uniqueness"]
theorem lift_unique
    [CommRing k] {A : Type*} [Semiring A] [Algebra k A]
    (f : MvPolynomial σ k →ₐ[k] A)
    (hker : relationIdeal (σ := σ) (k := k) ≤ RingHom.ker f.toRingHom)
    (g : Quotient (σ := σ) (k := k) →ₐ[k] A)
    (hg : g.comp (Ideal.Quotient.mkₐ k (relationIdeal (σ := σ) (k := k))) = f) :
    g = lift (σ := σ) (k := k) f hker := sorry

/-- Two algebra maps out of the square-zero quotient are equal when they agree on every
coordinate variable generator. -/
@[stacks 05BX "square-zero quotient hom extensionality"]
theorem hom_ext
    [CommRing k] {A : Type*} [Semiring A] [Algebra k A]
    {φ ψ : Quotient (σ := σ) (k := k) →ₐ[k] A}
    (h : ∀ i, φ (generator (σ := σ) (k := k) i) =
      ψ (generator (σ := σ) (k := k) i)) :
    φ = ψ := sorry

/-- Evaluation at a square-zero family kills the defining relation ideal. -/
@[stacks 05BX "square-zero evaluation kernel criterion"]
theorem relationIdeal_le_ker_eval₂
    [CommSemiring k] {A : Type*} [CommSemiring A] [Algebra k A]
    (x : σ → A) (hx : ∀ i, x i ^ (2 : ℕ) = 0) :
    relationIdeal (σ := σ) (k := k) ≤
      RingHom.ker (MvPolynomial.eval₂AlgHom k x).toRingHom := sorry

/-- The evaluation specialization of the generic quotient lift. -/
@[stacks 05BX "square-zero evaluation lift"]
noncomputable def lift_eval₂
    [CommRing k] {A : Type*} [CommSemiring A] [Algebra k A]
    (x : σ → A) (hx : ∀ i, x i ^ (2 : ℕ) = 0) :
    Quotient (σ := σ) (k := k) →ₐ[k] A :=
  lift (σ := σ) (k := k) (MvPolynomial.eval₂AlgHom k x)
    (relationIdeal_le_ker_eval₂ (σ := σ) (k := k) x hx)

/-- The evaluation lift agrees with polynomial evaluation on representatives. -/
@[simp, stacks 05BX "square-zero evaluation lift on representatives"]
theorem lift_eval₂_apply_mk
    [CommRing k] {A : Type*} [CommSemiring A] [Algebra k A]
    (x : σ → A) (hx : ∀ i, x i ^ (2 : ℕ) = 0) (p : MvPolynomial σ k) :
    lift_eval₂ (σ := σ) (k := k) x hx
      (Ideal.Quotient.mk (relationIdeal (σ := σ) (k := k)) p) =
      MvPolynomial.eval₂AlgHom k x p := sorry

/-- The evaluation lift sends the quotient generator `i` to `x i`. -/
@[simp, stacks 05BX "square-zero evaluation lift on generators"]
theorem lift_eval₂_generator
    [CommRing k] {A : Type*} [CommSemiring A] [Algebra k A]
    (x : σ → A) (hx : ∀ i, x i ^ (2 : ℕ) = 0) (i : σ) :
    lift_eval₂ (σ := σ) (k := k) x hx (generator (σ := σ) (k := k) i) = x i := sorry

/-- The evaluation lift preserves the coefficient-ring algebra map. -/
@[simp, stacks 05BX "square-zero evaluation lift on coefficients"]
theorem lift_eval₂_algebraMap
    [CommRing k] {A : Type*} [CommSemiring A] [Algebra k A]
    (x : σ → A) (hx : ∀ i, x i ^ (2 : ℕ) = 0) (a : k) :
    lift_eval₂ (σ := σ) (k := k) x hx
      (algebraMap k (Quotient (σ := σ) (k := k)) a) = algebraMap k A a := sorry

/-- The defining ideal is killed by the constant-coefficient map. -/
theorem relationIdeal_mem_ker_constantCoeff [CommSemiring k]
    (p : MvPolynomial σ k) (hp : p ∈ relationIdeal (σ := σ) (k := k)) :
    (MvPolynomial.constantCoeff : MvPolynomial σ k →+* k) p = 0 := sorry

/-- The defining ideal is killed by the constant-term `k`-algebra homomorphism. -/
theorem relationIdeal_mem_ker_constantCoeff_algHom [CommSemiring k]
    (p : MvPolynomial σ k) (hp : p ∈ relationIdeal (σ := σ) (k := k)) :
    (MvPolynomial.eval₂AlgHom k (fun _ : σ => (0 : k))) p = 0 := sorry

/-- The zero evaluation map kills the defining relation ideal, so the canonical augmentation can
reuse the generic quotient lift rather than carrying a second quotient construction. -/
@[stacks 05BX "square-zero zero-evaluation kernel criterion"]
theorem relationIdeal_le_ker_eval₂_zero [CommSemiring k] :
    relationIdeal (σ := σ) (k := k) ≤
      RingHom.ker (MvPolynomial.eval₂AlgHom k (fun _ : σ => (0 : k))).toRingHom := sorry

/-- The augmentation as the canonical `k`-algebra homomorphism. -/
@[stacks 05BX "square-zero augmentation algebra homomorphism"]
noncomputable def augmentationAlgHom [CommRing k] :
    Quotient (σ := σ) (k := k) →ₐ[k] k :=
  lift (σ := σ) (k := k)
    (MvPolynomial.eval₂AlgHom k (fun _ : σ => (0 : k)))
    (relationIdeal_le_ker_eval₂_zero (σ := σ) (k := k))

/-- The `RingHom` projection of the canonical augmentation algebra homomorphism. -/
@[stacks 05BX "square-zero augmentation"]
noncomputable abbrev augmentation [CommRing k] : Quotient (σ := σ) (k := k) →+* k :=
  (augmentationAlgHom (σ := σ) (k := k)).toRingHom

/-- The bundled augmentation projects to the canonical RingHom augmentation. -/
@[simp]
theorem augmentationAlgHom_toRingHom [CommRing k] :
    (augmentationAlgHom (σ := σ) (k := k)).toRingHom =
      augmentation (σ := σ) (k := k) := sorry

/-- The bundled augmentation on a quotient representative is evaluation at zero. -/
@[simp]
theorem augmentationAlgHom_apply_mk [CommRing k] (p : MvPolynomial σ k) :
    augmentationAlgHom (σ := σ) (k := k)
        (Ideal.Quotient.mk (relationIdeal (σ := σ) (k := k)) p) =
      MvPolynomial.eval₂AlgHom k (fun _ : σ => (0 : k)) p := sorry

/-- The bundled augmentation kills every square-zero generator. -/
@[simp]
theorem augmentationAlgHom_apply_generator [CommRing k] (i : σ) :
    augmentationAlgHom (σ := σ) (k := k) (generator (σ := σ) (k := k) i) = 0 := sorry

/-- The bundled augmentation is the identity on the coefficient-ring section. -/
@[simp]
theorem augmentationAlgHom_apply_algebraMap [CommRing k] (a : k) :
    augmentationAlgHom (σ := σ) (k := k)
        (algebraMap k (Quotient (σ := σ) (k := k)) a) = a := sorry

/-- The augmentation on a quotient representative is its constant coefficient. -/
@[simp]
theorem augmentation_apply_mk [CommRing k] (p : MvPolynomial σ k) :
    augmentation (σ := σ) (k := k)
        (Ideal.Quotient.mk (relationIdeal (σ := σ) (k := k)) p) =
      (MvPolynomial.constantCoeff : MvPolynomial σ k →+* k) p := sorry

/-- The augmentation kills every square-zero variable. -/
@[simp]
theorem augmentation_apply_generator [CommRing k] (i : σ) :
    augmentation (σ := σ) (k := k) (generator (σ := σ) (k := k) i) = 0 := sorry

/-- The coefficient-ring map is a right inverse to the augmentation. -/
@[simp]
theorem augmentation_apply_algebraMap [CommRing k] (a : k) :
    augmentation (σ := σ) (k := k)
        (algebraMap k (Quotient (σ := σ) (k := k)) a) = a := sorry

/-- The coefficient-ring map is a right inverse to the augmentation. -/
theorem augmentation_rightInverse_algebraMap [CommRing k] :
    Function.RightInverse
      (fun a : k => algebraMap k (Quotient (σ := σ) (k := k)) a)
      (augmentation (σ := σ) (k := k)) := sorry

/-- The augmentation is surjective. -/
theorem augmentation_surjective [CommRing k] :
    Function.Surjective (augmentation (σ := σ) (k := k)) := sorry

/-- The square-zero quotient is nontrivial over a nontrivial commutative ring. -/
instance quotient_nontrivial [CommRing k] [Nontrivial k] :
    Nontrivial (Quotient (σ := σ) (k := k)) := sorry

/-- In the square-zero quotient over a field, units are exactly the elements with nonzero
augmentation. -/
@[stacks 05BX "square-zero unit criterion"]
theorem isUnit_iff_augmentation_ne_zero [Field k]
    (x : Quotient (σ := σ) (k := k)) :
    IsUnit x ↔ augmentation (σ := σ) (k := k) x ≠ 0 := sorry

/-- An augmentation-zero element is nilpotent; this is the presentation-independent unit test
before specializing the target ring to a field. -/
theorem isNilpotent_of_augmentation_eq_zero [CommRing k]
    {x : Quotient (σ := σ) (k := k)}
    (hx : augmentation (σ := σ) (k := k) x = 0) :
    IsNilpotent x := sorry

/-- Units of the square-zero quotient are exactly the elements whose augmentation is a unit. -/
theorem isUnit_iff_augmentation_isUnit [CommRing k]
    (x : Quotient (σ := σ) (k := k)) :
    IsUnit x ↔ IsUnit (augmentation (σ := σ) (k := k) x) := sorry

/-- The augmentation reflects units over every commutative coefficient ring. -/
@[stacks 05BX "square-zero augmentation is local"]
instance augmentation_isLocalHom [CommRing k] :
    IsLocalHom (augmentation (σ := σ) (k := k)) := sorry

/-- The square-zero quotient over a local coefficient ring is local. -/
@[stacks 05BX "square-zero local ring"]
instance quotient_isLocalRing [CommRing k] [IsLocalRing k] :
    IsLocalRing (Quotient (σ := σ) (k := k)) := sorry

/-- Over a local coefficient ring, the maximal ideal is the inverse image of the coefficient
ring's maximal ideal under augmentation. -/
@[stacks 05BX "square-zero maximal ideal under augmentation"]
theorem maximalIdeal_eq_comap_augmentation [CommRing k] [IsLocalRing k] :
    maximalIdeal (Quotient (σ := σ) (k := k)) =
      Ideal.comap (augmentation (σ := σ) (k := k)) (maximalIdeal k) := sorry

/-- The maximal ideal is the kernel of the augmentation. -/
@[stacks 05BX "square-zero maximal ideal kernel"]
theorem maximalIdeal_eq_ker_augmentation [Field k] :
    maximalIdeal (Quotient (σ := σ) (k := k)) =
      RingHom.ker (augmentation (σ := σ) (k := k)) := sorry

/-- Every square-zero generator lies in the canonical maximal ideal over a local coefficient
ring. -/
@[stacks 05BX "square-zero generator in the maximal ideal"]
theorem generator_mem_maximalIdeal [CommRing k] [IsLocalRing k] (i : σ) :
    generator (σ := σ) (k := k) i ∈
      maximalIdeal (Quotient (σ := σ) (k := k)) := sorry

/-- The augmentation kernel is generated by the square-zero variables. -/
theorem ker_augmentation_eq_span_generators [CommRing k] :
    RingHom.ker (augmentation (σ := σ) (k := k)) =
      Ideal.span (Set.range (generator (σ := σ) (k := k))) := sorry

/-- The maximal ideal is generated by the square-zero variables. -/
@[stacks 05BX "square-zero maximal ideal generators"]
theorem maximalIdeal_eq_span_generators [Field k] :
    maximalIdeal (Quotient (σ := σ) (k := k)) =
      Ideal.span (Set.range (generator (σ := σ) (k := k))) := sorry

/-- The maximal ideal of the square-zero quotient over a field is locally nilpotent. -/
theorem maximalIdeal_isLocallyNilpotent [Field k] :
    (maximalIdeal (Quotient (σ := σ) (k := k))).IsLocallyNilpotent := by
  rw [maximalIdeal_eq_span_generators]
  rw [Ideal.IsLocallyNilpotent, Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  exact mem_nilradical.2 ⟨2, by simpa using generator_sq (σ := σ) (k := k) i⟩

/-- A nonzero quotient class has a fresh generator acting nontrivially when the index type is
infinite. -/
theorem exists_generator_mul_ne_zero [CommRing k] [Nontrivial k] [Infinite σ]
    {x : Quotient (σ := σ) (k := k)} (hx : x ≠ 0) :
    ∃ i : σ, generator (σ := σ) (k := k) i * x ≠ 0 := sorry

/-- A product of pairwise distinct square-zero generators is nonzero over a nontrivial
coefficient ring.  The `Finset` carries distinctness, so no ordering or decidable-equality
parameter is exposed. -/
@[stacks 05BX "nonzero squarefree generator product"]
theorem prod_generator_ne_zero [CommRing k] [Nontrivial k] (s : Finset σ) :
    s.prod (generator (σ := σ) (k := k)) ≠ 0 := sorry

/-- Over a commutative coefficient ring, the radical of the annihilator of a generator is the
radical of the augmentation kernel. -/
@[stacks 05BX "square-zero generator torsion radical"]
theorem generator_torsion_radical_eq_ker_augmentation_radical [CommRing k] (i : σ) :
    (Ideal.torsionOf
        (Quotient (σ := σ) (k := k))
        (Quotient (σ := σ) (k := k))
        (generator (σ := σ) (k := k) i)).radical =
      (RingHom.ker (augmentation (σ := σ) (k := k))).radical := sorry

/-- Over a field, the radical of the annihilator of any generator is the maximal ideal. -/
@[stacks 05BX "square-zero generator torsion radical is maximal"]
theorem generator_torsion_radical_eq_maximalIdeal [Field k] (i : σ) :
    (Ideal.torsionOf
        (Quotient (σ := σ) (k := k))
        (Quotient (σ := σ) (k := k))
        (generator (σ := σ) (k := k) i)).radical =
      maximalIdeal (Quotient (σ := σ) (k := k)) := sorry

/-- The residue field of the square-zero quotient is the coefficient field.  The inverse is
built from the explicit coefficient-field section. -/
@[stacks 05BX "square-zero residue field"]
noncomputable def residueFieldEquiv [Field k] :
    IsLocalRing.ResidueField (Quotient (σ := σ) (k := k)) ≃+* k :=
  (Ideal.quotEquivOfEq
      (maximalIdeal_eq_ker_augmentation (σ := σ) (k := k))).trans
    (RingHom.quotientKerEquivOfRightInverse
      (f := augmentation (σ := σ) (k := k))
      (g := fun a : k => algebraMap k (Quotient (σ := σ) (k := k)) a)
      (augmentation_rightInverse_algebraMap (σ := σ) (k := k)))

/-- The residue-field ring equivalence carries the coefficient-field algebra map to the identity
algebra map. -/
theorem residueFieldEquiv_apply_algebraMap [Field k] (a : k) :
    residueFieldEquiv (σ := σ) (k := k)
        (algebraMap k
          (IsLocalRing.ResidueField (Quotient (σ := σ) (k := k))) a) =
      algebraMap k k a := sorry

/-- The residue-field identification as the canonical `k`-algebra equivalence. -/
@[stacks 05BX "square-zero residue field algebra equivalence"]
noncomputable def residueFieldAlgEquiv [Field k] :
    IsLocalRing.ResidueField (Quotient (σ := σ) (k := k)) ≃ₐ[k] k :=
  AlgEquiv.ofRingEquiv
    (f := residueFieldEquiv (σ := σ) (k := k))
    (residueFieldEquiv_apply_algebraMap (σ := σ) (k := k))

/-- Forgetting scalar compatibility from the residue-field algebra equivalence recovers the
canonical ring equivalence. -/
@[simp]
theorem residueFieldAlgEquiv_toRingEquiv [Field k] :
    (residueFieldAlgEquiv (σ := σ) (k := k)).toRingEquiv =
      residueFieldEquiv (σ := σ) (k := k) := sorry

/-- With infinitely many coordinates, the square-zero quotient has no exact associated primes
as a module over itself. -/
@[stacks 05BX "square-zero self associated primes are empty"]
theorem associatedPrimesOfModule_self_eq_empty [CommRing k] [Nontrivial k] [Infinite σ] :
    associatedPrimesOfModule
        (Quotient (σ := σ) (k := k))
        (Quotient (σ := σ) (k := k)) = ∅ := sorry

/-- No element of an infinite square-zero quotient has annihilator equal to its maximal ideal. -/
theorem not_exists_torsionOf_eq_maximalIdeal
    [CommRing k] [Nontrivial k] [IsLocalRing k] [Infinite σ] :
    ¬ ∃ x : Quotient (σ := σ) (k := k),
      Ideal.torsionOf
        (Quotient (σ := σ) (k := k))
        (Quotient (σ := σ) (k := k)) x =
          maximalIdeal (Quotient (σ := σ) (k := k)) := by
  rintro ⟨x, hx⟩
  have hmax :
      maximalIdeal (Quotient (σ := σ) (k := k)) ∈
        associatedPrimesOfModule
          (Quotient (σ := σ) (k := k))
          (Quotient (σ := σ) (k := k)) := by
    rw [mem_associatedPrimesOfModule_iff]
    exact ⟨(maximalIdeal.isMaximal (Quotient (σ := σ) (k := k))).isPrime, x, hx.symm⟩
  have hempty :
      maximalIdeal (Quotient (σ := σ) (k := k)) ∉
        associatedPrimesOfModule
          (Quotient (σ := σ) (k := k))
          (Quotient (σ := σ) (k := k)) := by
    simpa [associatedPrimesOfModule_self_eq_empty (σ := σ) (k := k)]
  exact hempty hmax

/-- Restriction of scalars along the coefficient-field map does not carry all exact associated
primes of the square-zero quotient into the self-associated-prime set. -/
@[stacks 05BX "square-zero associated-prime restriction failure"]
theorem comap_not_superset [Field k] [Infinite σ] :
    ¬ associatedPrimesOfModule k (Quotient (σ := σ) (k := k)) ⊆
      Ideal.comap (algebraMap k (Quotient (σ := σ) (k := k))) ''
        associatedPrimesOfModule
          (Quotient (σ := σ) (k := k))
          (Quotient (σ := σ) (k := k)) := sorry

end MvPolynomial.SquareZero
