module

public import Mathlib.RingTheory.DiscreteValuationRing.Basic
public import ReasLib.RingTheory.RootsOfUnity.KummerArtinSchreier.PowerLattice

@[expose] public section

/-!
# Quotient-polynomial congruences over a discrete valuation ring

The denominator convention is expressed by membership in the lattice generated by `π ^ (-n)`.
Thus `P(z) ∈ π ^ (-n) B` is the formal counterpart of `π ^ n * P(z) ∈ B`; this agrees with a
finite-level parameter written as `a / π ^ n`.

@stack 09F6
-/

open Polynomial

namespace KummerArtinSchreier
namespace PowerLattice

universe u

/-- Evaluating a Kummer--Artin--Schreier quotient polynomial agrees with `z ^ p - z` modulo the
power lattice obtained by shifting the denominator exponent by the order of `1 - ζ`. -/
@[stacks 09F6 "Equation 15.116.16.1: quotient-polynomial power-lattice congruence"]
theorem aeval_sub_mem
    {B : Type u} [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    {p e n : ℕ} [Fact p.Prime] {π ζ : B} {z : FractionRing B} {P : B[X]}
    (hP : IsQuotient p ζ P)
    (hπ : π ≠ 0)
    (hw : Associated (1 - ζ) (π ^ e))
    (hPz : aeval z P ∈ principal (FractionRing B) π (-(n : ℤ))) :
    aeval z P - (z ^ p - z) ∈
      principal (FractionRing B) π (-(n : ℤ) + e) := sorry
-- Proof strategy: rewrite the difference with `IsQuotient.aeval_sub_eq_sum`.  Each correction
-- coefficient is divisible by `1 - ζ`, hence by the associated element `π ^ e`; combine that shift
-- with the denominator bound encoded by `hPz`.  Use the DVR comparison of principal fractional
-- ideals, `hπ`, and the powers `z ^ i` for `1 ≤ i < p` to place every summand in exponent `-n + e`,
-- then close under the finite sum.

end PowerLattice
end KummerArtinSchreier
