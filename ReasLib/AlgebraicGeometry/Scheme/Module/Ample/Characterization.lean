module

public import Mathlib.Data.List.TFAE
public import Mathlib.CategoryTheory.Subobject.Lattice
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Grothendieck
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Free.Generated
public import ReasLib.AlgebraicGeometry.Scheme.Module.Ample.SectionRingProj.OpenImmersion
public import ReasLib.AlgebraicGeometry.Scheme.Module.GradedSections.Localization.QuasiCompact
public import ReasLib.AlgebraicGeometry.Scheme.Module.Invertible.NonvanishingOpen.Basis
public import ReasLib.AlgebraicGeometry.Scheme.Module.Quasicoherent.FiniteTypeGeneration

/-!
# Characterizations of ample invertible modules

This file relates ampleness to the section-ring morphism, bases of nonvanishing opens,
generation by negative powers, and global generation of sufficiently positive twists.
-/

@[expose] public section

open AlgebraicGeometry
open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.MonoidalCategory
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}}

/-- The positive homogeneous sections of an invertible module cover the scheme and its canonical
section-ring morphism is an open immersion. -/
def IsSectionRingOpenImmersion (L : X.Modules) [Invertible L] : Prop :=
  IsSectionRingCover L ∧
    ∃ f : X ⟶ Proj (RingedSpace.GradedSections.grading L),
      IsSectionRingProjMap L f ∧ IsOpenImmersion f

/-- A module is generated by the images of all morphisms from negative positive-degree powers of
an invertible module. -/
def IsGeneratedByPositivePowers (L F : X.Modules) [Invertible L] : Prop :=
  (⨆ (n : ℕ+) (f : (L ^⊗ (-(n : ℤ))) ⟶ F), imageSubobject f) = ⊤

/-- All sufficiently positive twists of a module by an invertible module are globally generated. -/
def IsEventuallyGloballyGenerated (L F : X.Modules) [Invertible L] : Prop :=
  ∃ n₀ : ℤ, ∀ n : ℤ, n₀ ≤ n →
    SheafOfModules.IsGloballyGenerated (F ⊗ (L ^⊗ n))

/-- A module is generated by finitely many copies of one negative positive-degree power of an
invertible module. -/
def IsFiniteQuotientOfNegativePower (L F : X.Modules) [Invertible L] : Prop :=
  ∃ (n : ℕ+) (k : ℕ) (f : Fin k → ((L ^⊗ (-(n : ℤ))) ⟶ F)),
    (⨆ i, imageSubobject (f i)) = ⊤

/-- An ample invertible module gives an open immersion into the projective spectrum of its
section ring. -/
theorem IsAmple.isSectionRingOpenImmersion {L : X.Modules} [CompactSpace X] [Invertible L]
    (hL : IsAmple L) : IsSectionRingOpenImmersion L := sorry

/-- A section-ring open immersion makes the affine positive-power nonvanishing opens into a
topological basis. -/
theorem IsSectionRingOpenImmersion.isBasis_affine {L : X.Modules}
    [CompactSpace X] [Invertible L] (hL : IsSectionRingOpenImmersion L) :
    TopologicalSpace.Opens.IsBasis
      {U : X.Opens | U ∈ positiveTensorPowerNonvanishingOpens L ∧ IsAffineOpen U} := sorry

/-- If positive-power nonvanishing opens form a basis, then the invertible module is ample. -/
theorem isAmple_of_nonvanishing_isBasis {L : X.Modules} [CompactSpace X] [Invertible L]
    (hL : TopologicalSpace.Opens.IsBasis (positiveTensorPowerNonvanishingOpens L)) :
    IsAmple L := sorry

/-- Every quasi-coherent module is generated by negative positive-degree powers of an ample
invertible module. -/
theorem IsAmple.isGeneratedByPositivePowers {L : X.Modules}
    [CompactSpace X] [Invertible L] (hL : IsAmple L) :
    ∀ F : X.Modules, F.IsQuasicoherent → IsGeneratedByPositivePowers L F := sorry

/-- Generation of all quasi-coherent ideal subobjects by negative positive-degree powers implies
ampleness. -/
theorem isAmple_of_ideal_generation {L : X.Modules} [CompactSpace X] [Invertible L]
    (hL : ∀ I : Subobject (𝟙_ X.Modules),
      (I : X.Modules).IsQuasicoherent → IsGeneratedByPositivePowers L (I : X.Modules)) :
    IsAmple L := sorry

/-- An ample invertible module makes the scheme quasi-separated and sufficiently positive twists
of every finite-type quasi-coherent module globally generated. -/
theorem IsAmple.quasiSeparated_eventualGlobalGeneration {L : X.Modules}
    [CompactSpace X] [Invertible L] (hL : IsAmple L) :
    QuasiSeparatedSpace X ∧
      ∀ F : X.Modules, F.IsQuasicoherent → F.IsFiniteType →
        IsEventuallyGloballyGenerated L F := sorry

/-- Eventual global generation of positive twists gives finite quotients by a single negative
power for all finite-type quasi-coherent modules. -/
theorem finiteNegativePowerQuotients_of_eventualGlobalGeneration
    {L : X.Modules} [CompactSpace X] [Invertible L]
    (hL : QuasiSeparatedSpace X ∧
      ∀ F : X.Modules, F.IsQuasicoherent → F.IsFiniteType →
        IsEventuallyGloballyGenerated L F) :
    QuasiSeparatedSpace X ∧
      ∀ F : X.Modules, F.IsQuasicoherent → F.IsFiniteType →
        IsFiniteQuotientOfNegativePower L F := sorry

/-- Finite negative-power quotients for finite-type quasi-coherent ideals imply generation of all
quasi-coherent ideal subobjects by negative positive-degree powers. -/
theorem idealGeneration_of_finiteNegativePowerQuotients
    {L : X.Modules} [CompactSpace X] [Invertible L]
    (hL : QuasiSeparatedSpace X ∧
      ∀ I : Subobject (𝟙_ X.Modules),
        (I : X.Modules).IsQuasicoherent → (I : X.Modules).IsFiniteType →
          IsFiniteQuotientOfNegativePower L (I : X.Modules)) :
    ∀ I : Subobject (𝟙_ X.Modules),
      (I : X.Modules).IsQuasicoherent → IsGeneratedByPositivePowers L (I : X.Modules) := sorry

/-- For an invertible module on a quasi-compact scheme, ampleness is equivalent to the
section-ring, nonvanishing-basis, generation, and finite-quotient criteria. -/
theorem isAmple_tfae (L : X.Modules) [CompactSpace X] [Invertible L] :
    List.TFAE [
      IsAmple L,
      IsSectionRingOpenImmersion L,
      TopologicalSpace.Opens.IsBasis (positiveTensorPowerNonvanishingOpens L),
      TopologicalSpace.Opens.IsBasis
        {U : X.Opens | U ∈ positiveTensorPowerNonvanishingOpens L ∧ IsAffineOpen U},
      ∀ F : X.Modules, F.IsQuasicoherent → IsGeneratedByPositivePowers L F,
      ∀ I : Subobject (𝟙_ X.Modules),
        (I : X.Modules).IsQuasicoherent → IsGeneratedByPositivePowers L (I : X.Modules),
      QuasiSeparatedSpace X ∧
        ∀ F : X.Modules, F.IsQuasicoherent → F.IsFiniteType →
          IsEventuallyGloballyGenerated L F,
      QuasiSeparatedSpace X ∧
        ∀ F : X.Modules, F.IsQuasicoherent → F.IsFiniteType →
          IsFiniteQuotientOfNegativePower L F,
      QuasiSeparatedSpace X ∧
        ∀ I : Subobject (𝟙_ X.Modules),
          (I : X.Modules).IsQuasicoherent → (I : X.Modules).IsFiniteType →
            IsFiniteQuotientOfNegativePower L (I : X.Modules)] := sorry

/-- Ampleness is equivalent to the section-ring open-immersion criterion. -/
theorem isAmple_iff_sectionRingOpenImmersion
    (L : X.Modules) [CompactSpace X] [Invertible L] :
    IsAmple L ↔ IsSectionRingOpenImmersion L :=
  (isAmple_tfae L).out 0 1

/-- Ampleness is equivalent to positive-power nonvanishing opens forming a basis. -/
theorem isAmple_iff_nonvanishing_isBasis
    (L : X.Modules) [CompactSpace X] [Invertible L] :
    IsAmple L ↔
      TopologicalSpace.Opens.IsBasis (positiveTensorPowerNonvanishingOpens L) :=
  (isAmple_tfae L).out 0 2

/-- Ampleness is equivalent to affine positive-power nonvanishing opens forming a basis. -/
theorem isAmple_iff_affineNonvanishing_isBasis
    (L : X.Modules) [CompactSpace X] [Invertible L] :
    IsAmple L ↔
      TopologicalSpace.Opens.IsBasis
        {U : X.Opens | U ∈ positiveTensorPowerNonvanishingOpens L ∧ IsAffineOpen U} :=
  (isAmple_tfae L).out 0 3

/-- Ampleness is equivalent to generation of every quasi-coherent module by negative
positive-degree powers. -/
theorem isAmple_iff_quasicoherent_generation
    (L : X.Modules) [CompactSpace X] [Invertible L] :
    IsAmple L ↔
      ∀ F : X.Modules, F.IsQuasicoherent → IsGeneratedByPositivePowers L F :=
  (isAmple_tfae L).out 0 4

/-- Ampleness is equivalent to generation of every quasi-coherent ideal subobject by negative
positive-degree powers. -/
theorem isAmple_iff_quasicoherent_ideal_generation
    (L : X.Modules) [CompactSpace X] [Invertible L] :
    IsAmple L ↔
      ∀ I : Subobject (𝟙_ X.Modules),
        (I : X.Modules).IsQuasicoherent → IsGeneratedByPositivePowers L (I : X.Modules) :=
  (isAmple_tfae L).out 0 5

/-- Ampleness is equivalent to quasi-separatedness and eventual global generation of positive
twists of every finite-type quasi-coherent module. -/
theorem isAmple_iff_eventualGlobalGeneration
    (L : X.Modules) [CompactSpace X] [Invertible L] :
    IsAmple L ↔
      QuasiSeparatedSpace X ∧
        ∀ F : X.Modules, F.IsQuasicoherent → F.IsFiniteType →
          IsEventuallyGloballyGenerated L F :=
  (isAmple_tfae L).out 0 6

/-- Ampleness is equivalent to quasi-separatedness and finite negative-power quotients for every
finite-type quasi-coherent module. -/
theorem isAmple_iff_finiteNegativePowerQuotients
    (L : X.Modules) [CompactSpace X] [Invertible L] :
    IsAmple L ↔
      QuasiSeparatedSpace X ∧
        ∀ F : X.Modules, F.IsQuasicoherent → F.IsFiniteType →
          IsFiniteQuotientOfNegativePower L F :=
  (isAmple_tfae L).out 0 7

/-- Ampleness is equivalent to quasi-separatedness and finite negative-power quotients for every
finite-type quasi-coherent ideal subobject. -/
theorem isAmple_iff_finiteNegativePowerIdealQuotients
    (L : X.Modules) [CompactSpace X] [Invertible L] :
    IsAmple L ↔
      QuasiSeparatedSpace X ∧
        ∀ I : Subobject (𝟙_ X.Modules),
          (I : X.Modules).IsQuasicoherent → (I : X.Modules).IsFiniteType →
            IsFiniteQuotientOfNegativePower L (I : X.Modules) :=
  (isAmple_tfae L).out 0 8

end AlgebraicGeometry.Scheme.Modules
