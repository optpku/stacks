module

public import ReasLib.AlgebraicGeometry.Scheme.Module.Picard.Norm.Discriminant
import StacksCheckRecall

@[expose] public section

open AlgebraicGeometry
open CategoryTheory

universe u

/- Lemma 49.9.5: let `f : Y ⟶ X` be a finite flat morphism of Noetherian schemes and
let `N` be its determinantal norm. On an affine open where the finite locally free section
algebra has basis `e`, if a section `b` belongs to the different—meaning that multiplication
by `b` sends every linear functional into the `B`-span of the trace—then `N(b)` belongs to
the ideal generated by the discriminant of `e`. This is the affine-local form of the assertion
that the norm maps `f_*𝔇_f` into the ideal sheaf of `D_f`. -/
@[stacks 0BW8] #check
  (AlgebraicGeometry.Scheme.FiniteMorphismNorm.app_mem_span_discr_of_mem_different :
    ∀ {X Y : Scheme.{u}} (f : Y ⟶ X) [IsNoetherian X] [IsNoetherian Y]
      [IsFinite f] [Flat f] (N : Scheme.FiniteMorphismNorm f) (hN : N.IsDeterminant)
      (U : X.Opens) (hU : IsAffineOpen U) (n : ℕ)
      (e : Module.Basis (Fin n) Γ(X, U) Γ(Y, f ⁻¹ᵁ U)) (b : Γ(Y, f ⁻¹ᵁ U)),
      (∀ φ : Module.Dual Γ(X, U) Γ(Y, f ⁻¹ᵁ U),
        ∃ c : Γ(Y, f ⁻¹ᵁ U), ∀ x : Γ(Y, f ⁻¹ᵁ U),
          φ (b * x) = Algebra.trace Γ(X, U) Γ(Y, f ⁻¹ᵁ U) (c * x)) →
        N.app U b ∈ Ideal.span {Algebra.discr Γ(X, U) e})
