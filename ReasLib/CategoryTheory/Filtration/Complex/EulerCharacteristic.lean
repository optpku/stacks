module

public import ReasLib.CategoryTheory.Filtration.Complex.Convergence
public import ReasLib.CategoryTheory.Homology.SpectralSequence.EulerCharacteristic

/-!
# Euler Characteristics of Filtered Complexes

This filtered-complex layer compares cohomology with the generic page support, weak-Serre closure,
and Euler-characteristic API owned by `Homology/SpectralSequence/EulerCharacteristic`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

noncomputable section

universe v u

namespace CategoryTheory

variable {C : Type u} [Category.{v} C] [Abelian C]

namespace FilteredComplex.Cohomology.Support

/-- The degrees in which the cohomology of a filtered complex is nonzero. -/
@[stacks 0BDW "nonzero cohomology support of a filtered complex"]
def nonzero (K : FilteredComplex C) : Set ℤ :=
  {n | ¬ IsZero (K.underlying.homology n)}

/-- Membership in the nonzero cohomology support means that the corresponding homology object is
not zero. -/
@[simp]
theorem mem_nonzero (K : FilteredComplex C) (n : ℤ) :
    n ∈ nonzero K ↔ ¬ IsZero (K.underlying.homology n) := sorry

/-- A finite set supports the cohomology when every cohomology object outside it is zero. -/
@[stacks 0BDW "finite cohomology support of a filtered complex"]
def IsSupport (K : FilteredComplex C) (support : Finset ℤ) : Prop :=
  ∀ ⦃n : ℤ⦄, n ∉ support → IsZero (K.underlying.homology n)

/-- A finite set supports cohomology exactly when it contains the nonzero cohomology support. -/
theorem isSupport_iff (K : FilteredComplex C) (support : Finset ℤ) :
    IsSupport K support ↔ nonzero K ⊆ (support : Set ℤ) := sorry

/-- A cohomology support supplies zero objects in every degree outside the support. -/
theorem IsSupport.isZero {K : FilteredComplex C} {support : Finset ℤ}
    (h : IsSupport K support) {n : ℤ} (hn : n ∉ support) :
    IsZero (K.underlying.homology n) := sorry

/-- Enlarging a finite cohomology support preserves the support property. -/
theorem IsSupport.mono {K : FilteredComplex C} {support support' : Finset ℤ}
    (h : IsSupport K support) (hle : support ⊆ support') :
    IsSupport K support' := sorry

/-- The nonzero cohomology support is finite exactly when cohomology admits a finite support. -/
theorem finite_iff_exists (K : FilteredComplex C) :
    (nonzero K).Finite ↔ ∃ support : Finset ℤ, IsSupport K support := sorry

/-- Finitely many nonzero entries on one page of an associated spectral sequence imply finitely
many nonzero cohomology objects. -/
@[stacks 0BDW "finite cohomology support from a finite spectral-sequence page"]
theorem finite_of_page {K : FilteredComplex C}
    {E : CohomologicalSpectralSequence C 0} (hfinite : K.HasFiniteFiltrations)
    (hAssoc : FilteredComplex.IsAssociated K E) {r : ℤ} (hr : 0 ≤ r)
    (hpage : (CohomologicalSpectralSequence.Page.Support.nonzero E hr).Finite) :
    (nonzero K).Finite := sorry

/-- A finite page of an associated spectral sequence supplies a finite cohomology support. -/
theorem exists_of_page {K : FilteredComplex C}
    {E : CohomologicalSpectralSequence C 0} (hfinite : K.HasFiniteFiltrations)
    (hAssoc : FilteredComplex.IsAssociated K E) {r : ℤ} (hr : 0 ≤ r)
    (hpage : (CohomologicalSpectralSequence.Page.Support.nonzero E hr).Finite) :
    ∃ support : Finset ℤ, IsSupport K support := sorry

end FilteredComplex.Cohomology.Support

namespace FilteredComplex.Cohomology.PageClosure

/-- Under finite term filtrations, every cohomology object belongs to the weak Serre closure
generated by any page of an associated spectral sequence. -/
theorem entry_mem {K : FilteredComplex C} {E : CohomologicalSpectralSequence C 0}
    (hfinite : K.HasFiniteFiltrations)
    (hAssoc : FilteredComplex.IsAssociated K E) {r : ℤ} (hr : 0 ≤ r) (n : ℤ) :
    CohomologicalSpectralSequence.Page.WeakSerre.closure E hr
      (K.underlying.homology n) := sorry

/-- A cohomology object bundled in the weak Serre closure generated by a page of an associated
spectral sequence. -/
abbrev entry {K : FilteredComplex C} {E : CohomologicalSpectralSequence C 0}
    (hfinite : K.HasFiniteFiltrations)
    (hAssoc : FilteredComplex.IsAssociated K E) {r : ℤ} (hr : 0 ≤ r) (n : ℤ) :
    (CohomologicalSpectralSequence.Page.WeakSerre.closure E hr).FullSubcategory :=
  ⟨K.underlying.homology n, entry_mem hfinite hAssoc hr n⟩

/-- Forgetting a bundled cohomology entry recovers the corresponding homology object. -/
@[simp]
theorem entry_obj {K : FilteredComplex C} {E : CohomologicalSpectralSequence C 0}
    (hfinite : K.HasFiniteFiltrations) (hAssoc : FilteredComplex.IsAssociated K E)
    {r : ℤ} (hr : 0 ≤ r) (n : ℤ) :
    (entry hfinite hAssoc hr n).obj = K.underlying.homology n := sorry

end FilteredComplex.Cohomology.PageClosure

namespace FilteredComplex.Cohomology.Euler

/-- The alternating Grothendieck-class sum of the cohomology over a finite support, computed in
the weak Serre closure generated by a page of an associated spectral sequence. -/
@[stacks 0BDW "Euler characteristic of the cohomology of a filtered complex"]
noncomputable def characteristic {K : FilteredComplex C}
    {E : CohomologicalSpectralSequence C 0} (hfinite : K.HasFiniteFiltrations)
    (hAssoc : FilteredComplex.IsAssociated K E) {r : ℤ} (hr : 0 ≤ r)
    (support : Finset ℤ) :
    AbelianK0
      (CohomologicalSpectralSequence.Page.WeakSerre.closure E hr).FullSubcategory :=
  AbelianK0.alternatingSum
    (FilteredComplex.Cohomology.PageClosure.entry hfinite hAssoc hr)
    (fun n ↦ n) support

/-- The cohomology Euler characteristic is its finite alternating sum of bundled homology
objects. -/
theorem characteristic_def {K : FilteredComplex C}
    {E : CohomologicalSpectralSequence C 0} (hfinite : K.HasFiniteFiltrations)
    (hAssoc : FilteredComplex.IsAssociated K E) {r : ℤ} (hr : 0 ≤ r)
    (support : Finset ℤ) :
    characteristic hfinite hAssoc hr support =
      AbelianK0.alternatingSum
        (FilteredComplex.Cohomology.PageClosure.entry hfinite hAssoc hr)
        (fun n ↦ n) support := sorry

/-- The cohomology Euler characteristic over the empty support is zero. -/
@[simp]
theorem characteristic_empty {K : FilteredComplex C}
    {E : CohomologicalSpectralSequence C 0} (hfinite : K.HasFiniteFiltrations)
    (hAssoc : FilteredComplex.IsAssociated K E) {r : ℤ} (hr : 0 ≤ r) :
    characteristic hfinite hAssoc hr ∅ = 0 := sorry

/-- The cohomology Euler characteristic does not depend on the chosen finite cohomology
support. -/
theorem eq_of_support {K : FilteredComplex C}
    {E : CohomologicalSpectralSequence C 0} (hfinite : K.HasFiniteFiltrations)
    (hAssoc : FilteredComplex.IsAssociated K E) {r : ℤ} (hr : 0 ≤ r)
    {support support' : Finset ℤ}
    (hsupport : FilteredComplex.Cohomology.Support.IsSupport K support)
    (hsupport' : FilteredComplex.Cohomology.Support.IsSupport K support') :
    characteristic hfinite hAssoc hr support =
      characteristic hfinite hAssoc hr support' := sorry

/-- For chosen finite supports, the Euler characteristic of cohomology equals that of an
associated spectral-sequence page. -/
@[stacks 0BDW "Euler characteristic of a finite spectral-sequence page"]
theorem eq_page {K : FilteredComplex C} {E : CohomologicalSpectralSequence C 0}
    (hfinite : K.HasFiniteFiltrations) (hAssoc : FilteredComplex.IsAssociated K E)
    {r : ℤ} (hr : 0 ≤ r) (pageSupport : Finset (ℤ × ℤ))
    (hpage : CohomologicalSpectralSequence.Page.Support.IsSupport E hr pageSupport)
    (cohomologySupport : Finset ℤ)
    (hcohomology : FilteredComplex.Cohomology.Support.IsSupport K cohomologySupport) :
    characteristic hfinite hAssoc hr cohomologySupport =
      CohomologicalSpectralSequence.Page.Euler.characteristic E hr pageSupport := sorry

/-- The Euler characteristic of a finite page of an associated spectral sequence equals the
Euler characteristic of the cohomology in the weak Serre closure generated by that page. -/
@[stacks 0BDW "Euler characteristic of a finite spectral-sequence page"]
theorem exists_support_eq_page {K : FilteredComplex C}
    {E : CohomologicalSpectralSequence C 0} (hfinite : K.HasFiniteFiltrations)
    (hAssoc : FilteredComplex.IsAssociated K E) {r : ℤ} (hr : 0 ≤ r)
    (pageSupport : Finset (ℤ × ℤ))
    (hpage : CohomologicalSpectralSequence.Page.Support.IsSupport E hr pageSupport) :
    ∃ cohomologySupport : Finset ℤ,
      FilteredComplex.Cohomology.Support.IsSupport K cohomologySupport ∧
        characteristic hfinite hAssoc hr cohomologySupport =
          CohomologicalSpectralSequence.Page.Euler.characteristic E hr pageSupport := sorry

end FilteredComplex.Cohomology.Euler

end CategoryTheory
