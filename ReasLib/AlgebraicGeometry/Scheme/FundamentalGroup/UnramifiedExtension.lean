module

public import Mathlib.FieldTheory.Galois.Basic
public import Mathlib.FieldTheory.IsSepClosed
public import ReasLib.AlgebraicGeometry.Scheme.FunctionField.Normalization
public import ReasLib.AlgebraicGeometry.Scheme.Morphism.Etale.GeometricallyUnibranch

@[expose] public section

open AlgebraicGeometry

universe u

namespace AlgebraicGeometry.Scheme.FunctionFieldExtension

/-- `X` is unramified in a finite extension `L` of its function field if the
normalization morphism of `X` in `L` is unramified. -/
def UnramifiedIn
    (X : Scheme.{u}) [IsIntegral X]
    (L : Type u) [Field L] [Algebra X.functionField L]
    [FiniteDimensional X.functionField L] : Prop :=
  Unramified (map X L).fromNormalization

/-- Unramifiedness of `X` in `L` is the unramifiedness of the associated
normalization morphism. -/
theorem UnramifiedIn_iff_unramified_fromNormalization
    (X : Scheme.{u}) [IsIntegral X]
    (L : Type u) [Field L] [Algebra X.functionField L]
    [FiniteDimensional X.functionField L] :
    UnramifiedIn X L ↔ Unramified (map X L).fromNormalization := sorry

/-- The union `M` of the finite subextensions of `SeparableClosure K` in which
the normal integral scheme `X` with function field `K` is unramified. -/
noncomputable def maximalUnramifiedExtension
    (X : Scheme.{u}) [IsIntegral X] (hX : X.isNormal) :
    IntermediateField X.functionField (SeparableClosure X.functionField) :=
  ⨆ (L : IntermediateField X.functionField (SeparableClosure X.functionField))
    (_ : FiniteDimensional X.functionField L)
    (_ : UnramifiedIn X L), L

/-- Membership in the unramified union is generated by finite unramified
intermediate fields. -/
theorem mem_maximalUnramifiedExtension_iff
    (X : Scheme.{u}) [IsIntegral X] (hX : X.isNormal)
    (x : SeparableClosure X.functionField) :
    x ∈ maximalUnramifiedExtension X hX ↔
      ∃ (L : IntermediateField X.functionField (SeparableClosure X.functionField))
        (_ : FiniteDimensional X.functionField L),
        UnramifiedIn X L ∧ x ∈ L := sorry

/-- The unramified union is Galois over the function field. -/
theorem isGalois_maximalUnramifiedExtension
    (X : Scheme.{u}) [IsIntegral X] (hX : X.isNormal) :
    IsGalois X.functionField (maximalUnramifiedExtension X hX) := sorry

/-- The maximal unramified extension of a normal integral scheme is Galois over its
function field. -/
instance instIsGalois_maximalUnramifiedExtension
    (X : Scheme.{u}) [IsIntegral X] (hX : X.isNormal) :
    IsGalois X.functionField (maximalUnramifiedExtension X hX) := sorry

end AlgebraicGeometry.Scheme.FunctionFieldExtension
