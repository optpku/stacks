module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
public import ReasLib.AlgebraicGeometry.AffinePlane.ExceptionalDivisor
public import ReasLib.AlgebraicGeometry.Scheme.IdealSheafData.Spec

/-!
# Inverse images of concrete ideals under the affine-plane blowup

The cubic ideal has Cartier inverse image under the blowup of the affine plane at
the origin, whereas a specified intermediate ideal does not.
-/

@[expose] public section

noncomputable section

universe u

open AlgebraicGeometry CategoryTheory MvPolynomial
open scoped AlgebraicGeometry

namespace AlgebraicGeometry.AffinePlaneBlowup

/-- The cubic monomial ideal generated by all degree-three monomials in two coordinates. -/
def cubicIdeal (k : Type u) [Field k] : Ideal (coordinateRing k) :=
  Ideal.span {X (0 : Fin 2) ^ 3, X 0 ^ 2 * X 1, X 0 * X 1 ^ 2, X 1 ^ 3}

/-- The cubic monomial ideal is the cube of the ideal of the origin. -/
theorem cubicIdeal_eq_pow (k : Type u) [Field k] :
    cubicIdeal k = originIdeal k ^ 3 := sorry

/-- The cubic monomial ideal is contained in the ideal of the origin. -/
theorem cubicIdeal_le_originIdeal (k : Type u) [Field k] :
    cubicIdeal k ≤ originIdeal k := sorry

/-- The ideal sheaf datum on the affine plane associated to the cubic monomial ideal. -/
def cubicIdealSheaf (k : Type u) [Field k] : (affinePlane k).IdealSheafData :=
  Scheme.idealSheafDataOfIdealOnSpec (cubicIdeal k)

/-- The intermediate ideal generated by `X 0 ^ 2`, `X 0 * X 1`, and `X 1 ^ 3`. -/
def nonCartierIdeal (k : Type u) [Field k] : Ideal (coordinateRing k) :=
  Ideal.span {X (0 : Fin 2) ^ 2, X 0 * X 1, X 1 ^ 3}

/-- The cubic monomial ideal is contained in the specified intermediate ideal. -/
theorem cubicIdeal_le_nonCartierIdeal (k : Type u) [Field k] :
    cubicIdeal k ≤ nonCartierIdeal k := sorry

/-- The specified intermediate ideal is contained in the ideal of the origin. -/
theorem nonCartierIdeal_le_originIdeal (k : Type u) [Field k] :
    nonCartierIdeal k ≤ originIdeal k := sorry

/-- The ideal sheaf datum on the affine plane associated to the intermediate ideal. -/
def nonCartierIdealSheaf (k : Type u) [Field k] : (affinePlane k).IdealSheafData :=
  Scheme.idealSheafDataOfIdealOnSpec (nonCartierIdeal k)

/-- The inverse image of the cubic ideal under the origin blowup is an effective Cartier divisor. -/
instance cubicIdealSheaf_comap_hom_isEffectiveCartierDivisor (k : Type u) [Field k] :
    IsEffectiveCartierDivisor ((cubicIdealSheaf k).comap (hom k)).subschemeι := sorry

/-- The inverse image of the intermediate ideal under the origin blowup is not an effective Cartier divisor. -/
theorem nonCartierIdealSheaf_comap_hom_not_isEffectiveCartierDivisor
    (k : Type u) [Field k] :
    ¬ IsEffectiveCartierDivisor ((nonCartierIdealSheaf k).comap (hom k)).subschemeι := sorry

end AlgebraicGeometry.AffinePlaneBlowup
