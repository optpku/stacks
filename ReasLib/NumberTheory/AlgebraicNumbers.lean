module

public import Mathlib.Algebra.Algebra.Rat
public import Mathlib.Algebra.Group.End
public import Mathlib.Analysis.Complex.Polynomial.Basic
public import Mathlib.FieldTheory.AlgebraicClosure
public import Mathlib.FieldTheory.Galois.Basic
public import Mathlib.FieldTheory.Galois.Notation
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.LinearAlgebra.Complex.Module
public import Mathlib.SetTheory.Cardinal.NatCard

/-!
# Complex algebraic numbers and their finite Galois subgroups

The relative algebraic closure of the rationals in the complex numbers contains the
real algebraic numbers. Complex conjugation generates their fixing subgroup, and
every nontrivial finite subgroup of the absolute Galois group is conjugate to it.
-/

@[expose] public section

noncomputable section

namespace AlgebraicNumbers

/-- The field of complex numbers algebraic over the rationals. -/
abbrev algebraicQ : Type := algebraicClosure ℚ ℂ

/-- The group of rational algebra automorphisms of the complex algebraic numbers. -/
abbrev gal : Type := Gal(algebraicQ / ℚ)

/-- The intermediate field of real algebraic numbers inside the complex algebraic numbers. -/
def realIntersection : IntermediateField ℚ algebraicQ where
  carrier := {x | (x : ℂ).im = 0}
  mul_mem' := by
    intro x y hx hy
    change (x : ℂ).im = 0 at hx
    change (y : ℂ).im = 0 at hy
    change ((x : ℂ) * (y : ℂ)).im = 0
    simp only [Complex.mul_im, hx, hy, mul_zero, zero_mul, add_zero]
  add_mem' := by
    intro x y hx hy
    change (x : ℂ).im = 0 at hx
    change (y : ℂ).im = 0 at hy
    change ((x : ℂ) + (y : ℂ)).im = 0
    simp only [Complex.add_im, hx, hy, add_zero]
  algebraMap_mem' := by
    intro r
    change (r : ℂ).im = 0
    exact Complex.ratCast_im r
  inv_mem' := by
    intro x hx
    change ((x : ℂ)⁻¹).im = 0
    rw [Complex.inv_im, hx, neg_zero, zero_div]

/-- A complex algebraic number is real precisely when its imaginary part vanishes. -/
theorem mem_realIntersection_iff (x : algebraicQ) :
    x ∈ realIntersection ↔ (x : ℂ).im = 0 := Iff.rfl

/-- Complex conjugation restricted to the field of complex algebraic numbers. -/
def complexConj : gal :=
  algebraicClosure.algEquivOfAlgEquiv (Complex.conjAe.restrictScalars ℚ)

/-- The restricted conjugation acts by complex conjugation on the underlying complex number. -/
theorem complexConj_apply (x : algebraicQ) :
    (complexConj x : ℂ) = starRingEnd ℂ (x : ℂ) := rfl

/-- Squaring the conjugation automorphism gives the identity. -/
theorem complexConj_sq : complexConj ^ 2 = 1 := by
  apply AlgEquiv.ext
  intro x
  apply Subtype.ext
  change (complexConj (complexConj x) : ℂ) = (x : ℂ)
  rw [complexConj_apply, complexConj_apply]
  exact star_star (x : ℂ)

/-- The conjugation automorphism of the complex algebraic numbers has order two. -/
theorem orderOf_complexConj : orderOf complexConj = 2 := sorry

/-- The cyclic subgroup of the absolute Galois group generated by complex conjugation. -/
def complexConjSubgroup : Subgroup gal :=
  Subgroup.zpowers complexConj

/-- The conjugation subgroup fixes exactly the real algebraic intermediate field. -/
theorem complexConjSubgroup_eq_fixingSubgroup :
    complexConjSubgroup = realIntersection.fixingSubgroup := sorry

/-- The cyclic subgroup generated by complex conjugation has two elements. -/
theorem card_complexConjSubgroup : Nat.card complexConjSubgroup = 2 := sorry

/-- The cyclic subgroup generated by complex conjugation is finite. -/
instance instFinite_complexConjSubgroup : Finite complexConjSubgroup :=
  Nat.finite_of_card_ne_zero (by rw [card_complexConjSubgroup]; decide)

/-- Every finite subgroup of the absolute Galois group of the rationals is trivial or
conjugate to the cyclic subgroup generated by complex conjugation. -/
theorem finite_subgroup_eq_bot_or_isConj (H : Subgroup gal) [Finite H] :
    H = ⊥ ∨ ∃ g : gal, H = complexConjSubgroup.map (MulAut.conj g).toMonoidHom := sorry

end AlgebraicNumbers
