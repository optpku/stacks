module

import StacksCheckRecall
public import ReasLib.RingTheory.DividedPowers.Category.Pushout

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace DividedPowerRing.Pushout

section

variable {A B B' B'' : DividedPowerRing.{u}}
variable (f : A ⟶ B) (g : A ⟶ B') (i : B ⟶ B'') (j : B' ⟶ B'')

/- Remark 23.3.5 (Tag 0H86), part (1): quotienting a pushout by the divided-power ideals gives a
pushout of commutative rings. -/
@[stacks 0H86 "(1)"]
#check (quotient_isPushout f g i j :
  ∀ _ : IsPushout f g i j,
    IsPushout (DividedPowerRing.quotient.map f) (DividedPowerRing.quotient.map g)
      (DividedPowerRing.quotient.map i) (DividedPowerRing.quotient.map j))

/- Remark 23.3.5 (Tag 0H86), part (2): the canonical map from the tensor product of the two
upper rings to the pushout ring is surjective. -/
@[stacks 0H86 "(2)"]
#check (tensorProductTo_surjective f g i j :
  ∀ hpush : IsPushout f g i j,
    Function.Surjective (tensorProductTo f g i j hpush.w))

/- Remark 23.3.5 (Tag 0H86), part (3): the canonical map carries the ideal generated by the two
source ideals onto the target divided-power ideal. -/
@[stacks 0H86 "(3)"]
#check (map_tensorIdeal_eq f g i j :
  ∀ hpush : IsPushout f g i j,
    Ideal.map (tensorProductTo f g i j hpush.w) (tensorIdeal f g) = B''.ideal)

end

end DividedPowerRing.Pushout
