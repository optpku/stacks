module

public import ReasLib.CategoryTheory.InverseSystem.Positive.IdealPower.Presentation
public import ReasLib.CategoryTheory.InverseSystem.Positive.Sequential
import Mathlib.Tactic.CrossRefAttribute

/-!
# Families of ideal powers over positive inverse systems

For a fixed ideal degree `n > 0`, the tower in this file models
`m ↦ I ^ n • F (m + 1)`.  Naturality is owned by a natural transformation into the reindexed
ambient tower.  Exact rows are required only in the source-relevant range `n ≤ m`; degree zero is
adjoined canonically as the ambient tower itself.
-/

@[expose] public section

open CategoryTheory Opposite

universe u v w

namespace CategoryTheory.PNatInverseSystem.IdealPower

variable {A : Type w} [CommRing A]
variable {C : Type u} [Category.{v} C] [Preadditive C] [Linear A C]

/-- A two-parameter family `I ^ n • F (m + 1)` over a positive ideal-power quotient tower.

The natural transformation `ι n` owns compatibility in the varying stage `m`.  The last two
fields say that for `n ≤ m`, its component is the kernel in the short exact row ending at `F n`. -/
@[stacks 0GYL "family of ideal powers over a positive inverse system",
  stacks 0GYN "family of ideal powers over a positive inverse system"]
structure Family (I : Ideal A) (F : PNatInverseSystem C) where
  /-- For positive `n`, the sequential tower `m ↦ I ^ n • F (m + 1)`. -/
  tower : ℕ+ → SequentialInverseSystem C
  /-- The componentwise inclusions into the ambient sequential reindexing of `F`. -/
  ι : ∀ n : ℕ+, tower n ⟶ F.toSequential
  /-- Each component is the subobject generated by the corresponding ideal power. -/
  isSMulSubobject : ∀ (n : ℕ+) (m : ℕ),
    (I ^ (n : ℕ)).IsSMulSubobject ((ι n).app (op m))
  /-- In the range `n ≤ m`, the ideal-power inclusion is killed by the transition to `F n`. -/
  comp_zero : ∀ (n : ℕ+) (m : ℕ) (hnm : (n : ℕ) ≤ m),
    (ι n).app (op m) ≫
      F.toSequential.transitionMap ((Nat.pred_le (n : ℕ)).trans hnm) = 0
  /-- In the range `n ≤ m`, the row
  `I ^ n • F (m + 1) ⟶ F (m + 1) ⟶ F n` is short exact. -/
  shortExact : ∀ (n : ℕ+) (m : ℕ) (hnm : (n : ℕ) ≤ m),
    (ShortComplex.mk
      ((ι n).app (op m))
      (F.toSequential.transitionMap ((Nat.pred_le (n : ℕ)).trans hnm))
      (comp_zero n m hnm)).ShortExact

/-- The fixed-ideal-degree tower, with degree zero canonically the ambient tower. -/
@[stacks 0GYL "fixed ideal-power tower", stacks 0GYN "fixed ideal-power tower"]
def Family.fixedTower
    {I : Ideal A} {F : PNatInverseSystem C} (P : Family I F) :
    ℕ → SequentialInverseSystem C
  | 0 => F.toSequential
  | n + 1 => P.tower (Nat.succPNat n)

/-- The natural inclusion of a fixed ideal-power tower into the ambient tower. -/
@[stacks 0GYL "inclusion of a fixed ideal-power tower",
  stacks 0GYN "inclusion of a fixed ideal-power tower"]
def Family.fixedι
    {I : Ideal A} {F : PNatInverseSystem C} (P : Family I F) :
    ∀ n : ℕ, P.fixedTower n ⟶ F.toSequential
  | 0 => 𝟙 _
  | n + 1 => P.ι (Nat.succPNat n)

/-- The degree-zero fixed tower is the ambient sequential tower. -/
@[simp]
theorem Family.fixedTower_zero
    {I : Ideal A} {F : PNatInverseSystem C} (P : Family I F) :
    P.fixedTower 0 = F.toSequential := sorry

/-- Positive fixed towers recover the supplied positive ideal-power family. -/
@[simp]
theorem Family.fixedTower_succ
    {I : Ideal A} {F : PNatInverseSystem C} (P : Family I F) (n : ℕ) :
    P.fixedTower (n + 1) = P.tower (Nat.succPNat n) := sorry

/-- Every component of a fixed ideal-power inclusion is monic. -/
theorem Family.mono_fixedι_app
    {I : Ideal A} {F : PNatInverseSystem C} (P : Family I F)
    (n m : ℕ) :
    Mono ((P.fixedι n).app (op m)) := sorry

/-- The short exact row `I ^ n • F (m + 1) ⟶ F (m + 1) ⟶ F n`. -/
@[stacks 0GYL "fixed-right ideal-power row", stacks 0GYN "fixed-right ideal-power row"]
abbrev Family.row
    {I : Ideal A} {F : PNatInverseSystem C} (P : Family I F)
    (n : ℕ+) (m : ℕ) (hnm : (n : ℕ) ≤ m) : ShortComplex C :=
  ShortComplex.mk
    ((P.ι n).app (op m))
    (F.toSequential.transitionMap ((Nat.pred_le (n : ℕ)).trans hnm))
    (P.comp_zero n m hnm)

/-- Every fixed-right ideal-power row in the source-relevant range is short exact. -/
theorem Family.row_shortExact
    {I : Ideal A} {F : PNatInverseSystem C} (P : Family I F)
    (n : ℕ+) (m : ℕ) (hnm : (n : ℕ) ≤ m) :
    (P.row n m hnm).ShortExact := sorry

/-- The diagonal family `n ↦ I ^ n • F (n + 1)`, including the canonical degree-zero term. -/
@[stacks 0GYM "diagonal ideal-power family",
  stacks 0GYL "diagonal ideal-power family", stacks 0GYN "diagonal ideal-power family"]
abbrev Family.diagonal
    {I : Ideal A} {F : PNatInverseSystem C} (P : Family I F) : ℕ → C :=
  fun n ↦ (P.fixedTower n).obj (op n)

/-- The inclusion of the positive diagonal term `I ^ n • F (n + 1)` into its ambient stage. -/
def Family.diagonalι
    {I : Ideal A} {F : PNatInverseSystem C} (P : Family I F) :
    ∀ n : ℕ+, (P.tower n).obj (op (n : ℕ)) ⟶ F.stage (n + 1) :=
  fun n ↦ (P.ι n).app (op (n : ℕ)) ≫ eqToHom (F.toSequential_obj (n : ℕ))

/-- The positive diagonal terms and inclusions form a presented ideal-power quotient tower. -/
theorem Family.diagonal_isQuotient
    {I : Ideal A} {F : PNatInverseSystem C} (P : Family I F) :
    F.IsIdealPowerQuotient I
      (fun n ↦ (P.tower n).obj (op (n : ℕ))) P.diagonalι := sorry

/-- The diagonal of a two-parameter ideal-power family as the one-parameter presentation used by
diagonal cohomology arguments. -/
@[stacks 0GYM "diagonal presentation of an ideal-power family"]
def Family.diagonalPresentation
    {I : Ideal A} {F : PNatInverseSystem C} (P : Family I F) :
    Presentation I F where
  positiveTerms n := (P.tower n).obj (op (n : ℕ))
  ι := P.diagonalι
  isQuotient := P.diagonal_isQuotient

/-- The terms of the diagonal presentation are the diagonal of the two-parameter family. -/
theorem Family.terms_diagonalPresentation
    {I : Ideal A} {F : PNatInverseSystem C} (P : Family I F) :
    terms P.diagonalPresentation = P.diagonal := sorry

end CategoryTheory.PNatInverseSystem.IdealPower
