module

public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Noetherian
public import Mathlib.RingTheory.LocalRing.Basic
public import Mathlib.RingTheory.MvPowerSeries.Basic
public import ReasLib.RingTheory.Depth
public import ReasLib.RingTheory.KrullDimension.MvPowerSeries
public import ReasLib.RingTheory.MvPowerSeries.Noetherian
import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

noncomputable section

universe u

open MvPowerSeries
open scoped ENat

namespace MvPowerSeries.DepthDim

/- The quotient family below gives local rings with prescribed dimension and depth. -/

/-- The relation ideal generated by `X 0 ^ 2` and the mixed products of `X 0`
with the first `m - n` successor coordinates. -/
def relationIdeal (k : Type u) [Field k] (m n : ℕ) :
    Ideal (MvPowerSeries (Fin (m + 1)) k) :=
  Ideal.span
    (insert (X (0 : Fin (m + 1)) ^ 2)
      (Set.range fun j : Fin (m - n) ↦
        X (0 : Fin (m + 1)) *
          X (Fin.castLE (Nat.succ_le_succ (Nat.sub_le m n)) j.succ)))

/-- The quotient of `MvPowerSeries (Fin (m + 1)) k` by `relationIdeal k m n`. -/
abbrev Ring (k : Type u) [Field k] (m n : ℕ) : Type u :=
  MvPowerSeries (Fin (m + 1)) k ⧸ relationIdeal k m n

/-- The quotient `Ring k m n` is a local ring. -/
instance instIsLocalRing (k : Type u) [Field k] (m n : ℕ) :
    IsLocalRing (Ring k m n) :=
  sorry

/- The following equalities give the prescribed dimension and depth. -/

/-- The Krull dimension of `Ring k m n` is `m` when `n ≤ m`. -/
@[stacks 0CS4]
theorem ringKrullDim_eq (k : Type u) [Field k] (m n : ℕ) (hn : n ≤ m) :
    ringKrullDim (Ring k m n) = m :=
  sorry

/-- The self-module depth of `Ring k m n` is `n` when `n ≤ m`. -/
@[stacks 0CS4]
theorem moduleDepth_eq (k : Type u) [Field k] (m n : ℕ) (hn : n ≤ m) :
    moduleDepth (Ring k m n) (Ring k m n) = n :=
  sorry

end MvPowerSeries.DepthDim
