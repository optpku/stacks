module

public import ReasLib.AlgebraicGeometry.RingedSpace.Module.Derived.Gluing.OpenFamily
import Mathlib.Tactic.CrossRefAttribute

/-!
# Uniqueness of open-family realizations

The source cover and overlap-generation hypotheses are kept explicit.  They are weaker than
requiring the family itself to be a topological basis.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace
open scoped DerivedExt

noncomputable section

universe u

namespace AlgebraicGeometry.RingedSpace.ModuleDerived.Gluing.OpenFamily

variable {X : RingedSpace.{u}} {𝓑 : Set (Opens X.carrier)}

/-- Pairwise intersections of family members are generated by smaller members of the family. -/
@[stacks 0D68 "open families generating pairwise overlaps",
  stacks 0D69 "open families generating pairwise overlaps"]
abbrev GeneratesOverlaps (X : RingedSpace.{u}) (𝓑 : Set (Opens X.carrier)) : Prop :=
  ∀ ⦃U V : Opens X.carrier⦄ (_ : U ∈ 𝓑) (_ : V ∈ 𝓑),
    U ⊓ V = sSup {W : Opens X.carrier | W ∈ 𝓑 ∧ W ≤ U ⊓ V}

/-- Lemma 20.45.4 (1): two realizations of the same open-family gluing datum are uniquely
isomorphic compatibly with their local identifications. -/
@[stacks 0D68 "uniqueness of open-family derived realizations"]
theorem existsUniqueIso (G : Gluing.OpenFamily X 𝓑)
    (hcover : sSup 𝓑 = ⊤) (hoverlap : GeneratesOverlaps X 𝓑)
    (hneg : G.NegativeSelfExtVanishing)
    {K L : ModuleDerived X} (R : G.Realization K) (S : G.Realization L) :
    ∃! e : K ≅ L, IsCompatibleIso R S e := sorry

/-- Lemma 20.45.4 (2): every realization has globally vanishing negative self-Ext groups. -/
@[stacks 0D68 "negative self-Ext vanishing for an open-family realization"]
theorem negativeSelfExtIsZero (G : Gluing.OpenFamily X 𝓑)
    (hcover : sSup 𝓑 = ⊤) (hoverlap : GeneratesOverlaps X 𝓑)
    (hneg : G.NegativeSelfExtVanishing)
    {K : ModuleDerived X} (hK : G.Realizes K) (i : ℤ) (hi : i < 0) :
    IsZero (AddCommGrpCat.of (Ext⁽i⁾(K, K))) := sorry

end AlgebraicGeometry.RingedSpace.ModuleDerived.Gluing.OpenFamily

end
