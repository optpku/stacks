module

public import ReasLib.Algebra.Category.ModuleCat.FiniteProjective.LocalRing
public import ReasLib.Algebra.Category.ModuleCat.GrothendieckGroup.Basic
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Rank and Free Classes in Module Grothendieck Groups

The class of the rank-one free module defines canonical maps from `ℤ` to both
the projective and finite-module Grothendieck groups. Over a commutative local
ring, finite projective modules are finite free, so rank descends to the
inverse map `K₀(R) →+ ℤ`.
-/

@[expose] public section

noncomputable section

open CategoryTheory

universe u v

namespace CategoryTheory.ModuleCat.K0.Projective

section FreeClass

variable (R : Type u) [Ring R]

/-- The projective Grothendieck class `[R]` of the rank-one free module. -/
@[stacks 00JJ "rank-one free class in projective K0"]
def rankOne : projective.{u, u} R :=
  projectiveOf R
    (⟨ModuleCat.of R R, ⟨inferInstance, inferInstance⟩⟩ : ModuleCat.FiniteProjective R)

/-- The additive map `ℤ →+ K₀(R)` generated by the rank-one free class `[R]`. -/
@[stacks 00JJ "free-rank classes in projective K0"]
def free : ℤ →+ projective.{u, u} R :=
  zmultiplesHom _ (rankOne R)

/-- The free-class map sends `1` to the class `[R]`. -/
@[simp]
theorem free_one :
    free R 1 = rankOne R := sorry

end FreeClass

section LocalRing

variable (R : Type u) [CommRing R] [IsLocalRing R]

/-- The short-exact relations among finite projective modules lie in the kernel of rank, by
`FiniteProjective.finrank_add_of_shortExact`. -/
theorem relations_le_ker_rank :
    ObjectProperty.GrothendieckGroup.relations (ModuleCat.finiteProjective.{u, v} R) ≤
      (FreeAbelianGroup.lift fun M : ModuleCat.FiniteProjective.{u, v} R ↦
        (Module.finrank R M.obj : ℤ)).ker := sorry

/-- Rank as an additive homomorphism `K₀(R) →+ ℤ` for a commutative local ring. -/
@[stacks 00JJ "rank on projective K0"]
def rank : projective.{u, v} R →+ ℤ :=
  ObjectProperty.GrothendieckGroup.lift
    (fun M : ModuleCat.FiniteProjective.{u, v} R ↦ (Module.finrank R M.obj : ℤ))
    (relations_le_ker_rank.{u, v} R)

/-- Projective rank evaluates on a generator by the finite rank of its module. -/
@[simp, stacks 00JJ "projective rank on generators"]
theorem rank_of (M : ModuleCat.FiniteProjective.{u, v} R) :
    rank.{u, v} R (projectiveOf R M) = (Module.finrank R M.obj : ℤ) := sorry

/-- Over a local ring, taking rank after forming a virtual free class is the identity. -/
@[simp]
theorem rank_free (n : ℤ) :
    rank.{u, u} R (free R n) = n := sorry

/-- Over a local ring, the virtual free class of the rank of a projective class is that class. -/
@[simp]
theorem free_rank (x : projective.{u, u} R) :
    free R (rank.{u, u} R x) = x := sorry

/-- Rank identifies the projective Grothendieck group of a commutative local ring with `ℤ`. -/
@[stacks 00JJ "projective K0 of a local ring"]
def rankEquiv : projective.{u, u} R ≃+ ℤ where
  toFun := rank R
  invFun := free R
  left_inv := free_rank R
  right_inv := rank_free R
  map_add' := (rank R).map_add

/-- The projective rank equivalence acts by the projective rank homomorphism. -/
@[simp]
theorem rankEquiv_apply (x : projective.{u, u} R) :
    rankEquiv R x = rank R x := sorry

/-- The inverse projective rank equivalence acts by the virtual free-class map. -/
@[simp]
theorem rankEquiv_symm_apply (n : ℤ) :
    (rankEquiv R).symm n = free R n := sorry

end LocalRing

end CategoryTheory.ModuleCat.K0.Projective

namespace CategoryTheory.ModuleCat.K0.Finite

variable (R : Type u) [Ring R]

/-- The finite-module Grothendieck class `[R]` of the rank-one free module. -/
@[stacks 0FJ8 "rank-one free class in finite-module K0"]
def rankOne : finite.{u, u} R :=
  finiteOf R (FGModuleCat.of R R)

/-- The additive map `ℤ →+ K'_0(R)` generated by the finite-module class `[R]`. -/
@[stacks 0FJ8 "free-rank classes in finite-module K0"]
def free : ℤ →+ finite.{u, u} R :=
  zmultiplesHom _ (rankOne R)

/-- The finite-module free-class map sends `1` to `[R]`. -/
@[simp]
theorem free_one :
    free R 1 = rankOne R := sorry

end CategoryTheory.ModuleCat.K0.Finite
