module

public import Mathlib.Algebra.Homology.ShortComplex.ShortExact
public import Mathlib.GroupTheory.FreeAbelianGroup
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Grothendieck Groups of Object Properties

For an object property in an abelian category, this file defines the Grothendieck group presented
by objects satisfying the property and by those short-exact relations whose three terms satisfy
the property.  The full subcategory need not itself be abelian or extension closed.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits

universe v u w

namespace CategoryTheory

namespace ObjectProperty

namespace GrothendieckGroup

variable {A : Type u} [Category.{v} A] [Abelian A]

/-- The Grothendieck relation attached to an ambient short exact sequence whose terms satisfy
`P`. -/
@[stacks 00JH "property-indexed Grothendieck relation"]
def relation (P : ObjectProperty A)
    (S : { S : ShortComplex P.FullSubcategory // (S.map P.ι).ShortExact }) :
    FreeAbelianGroup P.FullSubcategory :=
  FreeAbelianGroup.of S.1.X₂ - FreeAbelianGroup.of S.1.X₁ - FreeAbelianGroup.of S.1.X₃

/-- The subgroup generated by all ambient short-exact relations between objects satisfying `P`.
-/
@[stacks 00JH "property-indexed Grothendieck relations"]
def relations (P : ObjectProperty A) : AddSubgroup (FreeAbelianGroup P.FullSubcategory) :=
  AddSubgroup.closure (Set.range (relation P))

/-- The relation of an ambient short exact sequence belongs to the defining relation subgroup. -/
theorem relation_mem_relations (P : ObjectProperty A) (S : ShortComplex P.FullSubcategory)
    (hS : (S.map P.ι).ShortExact) :
    FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃ ∈
      relations P := sorry

end GrothendieckGroup

variable {A : Type u} [Category.{v} A] [Abelian A]

/-- The Grothendieck group of objects satisfying `P`, with ambient short exact sequences as
relations. -/
@[stacks 00JH "property-indexed Grothendieck group"]
abbrev GrothendieckGroup (P : ObjectProperty A) : Type u :=
  FreeAbelianGroup P.FullSubcategory ⧸ GrothendieckGroup.relations P

namespace GrothendieckGroup

variable {A : Type u} [Category.{v} A] [Abelian A]

/-- The Grothendieck class of an object equipped with a proof that it satisfies `P`. -/
@[stacks 00JH "property-indexed Grothendieck class"]
abbrev of (P : ObjectProperty A) (X : P.FullSubcategory) : ObjectProperty.GrothendieckGroup P :=
  QuotientAddGroup.mk' (relations P) (FreeAbelianGroup.of X)

/-- An additive invariant of objects satisfying `P` descends when it kills all defining
short-exact relations. -/
@[stacks 00JH "property-indexed Grothendieck universal map"]
def lift {P : ObjectProperty A} {M : Type w} [AddCommGroup M] (f : P.FullSubcategory → M)
    (hf : relations P ≤ (FreeAbelianGroup.lift f).ker) :
    ObjectProperty.GrothendieckGroup P →+ M :=
  QuotientAddGroup.lift (relations P) (FreeAbelianGroup.lift f) hf

/-- The universal Grothendieck map evaluates on a generator as the original invariant. -/
@[simp]
theorem lift_of {P : ObjectProperty A} {M : Type w} [AddCommGroup M]
    (f : P.FullSubcategory → M) (hf : relations P ≤ (FreeAbelianGroup.lift f).ker)
    (X : P.FullSubcategory) :
    lift f hf (of P X) = f X := sorry

/-- The object map of an inclusion of properties kills the source short-exact relations. -/
theorem relations_le_ker_map {P Q : ObjectProperty A} (hPQ : P ≤ Q) :
    relations P ≤
      (FreeAbelianGroup.lift fun X : P.FullSubcategory ↦
        of Q ((ObjectProperty.ιOfLE hPQ).obj X)).ker := sorry

/-- The canonical homomorphism induced by an inclusion `P ≤ Q` of object properties. -/
def map {P Q : ObjectProperty A} (hPQ : P ≤ Q) :
    ObjectProperty.GrothendieckGroup P →+ ObjectProperty.GrothendieckGroup Q :=
  lift (fun X : P.FullSubcategory ↦ of Q ((ObjectProperty.ιOfLE hPQ).obj X))
    (relations_le_ker_map hPQ)

/-- The map induced by `P ≤ Q` sends a generator to the same ambient object regarded as an object
of `Q`. -/
@[simp]
theorem map_of {P Q : ObjectProperty A} (hPQ : P ≤ Q) (X : P.FullSubcategory) :
    map hPQ (of P X) = of Q ((ObjectProperty.ιOfLE hPQ).obj X) := sorry

/-- A short exact sequence of objects satisfying `P` gives the defining additive relation. -/
theorem of_shortExact {P : ObjectProperty A} (S : ShortComplex P.FullSubcategory)
    (hS : (S.map P.ι).ShortExact) :
    of P S.X₂ = of P S.X₁ + of P S.X₃ := sorry

/-- An object with a zero-object witness has trivial Grothendieck class. -/
theorem of_isZero {P : ObjectProperty A} (X : P.FullSubcategory)
    (hX : IsZero X.obj) :
    of P X = 0 := sorry

/-- Isomorphic objects have the same Grothendieck class when the property contains a zero object.
-/
theorem of_iso {P : ObjectProperty A} (Z : P.FullSubcategory) (hZ : IsZero Z.obj)
    {X Y : P.FullSubcategory} (e : X ≅ Y) :
    of P X = of P Y := sorry

end GrothendieckGroup

end ObjectProperty

end CategoryTheory
