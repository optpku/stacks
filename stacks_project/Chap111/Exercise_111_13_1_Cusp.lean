module

public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# The local ring of `k[x, y] ⧸ (y ^ 2 - x ^ 3)` at `(x, y)`

This leaf constructs the coordinate ring of the affine plane cusp defined by
`y ^ 2 = x ^ 3`, the origin ideal `(x, y)`, and the localization at that origin.
-/

@[expose] public section

noncomputable section

universe u

open MvPolynomial

namespace MvPolynomial.Cusp

/-- The plane-cusp equation `X 1 ^ 2 - X 0 ^ 3` in `k[x, y]`, with `X 0` corresponding
to `x` and `X 1` corresponding to `y`. -/
def relation (k : Type u) [Field k] : MvPolynomial (Fin 2) k :=
  X 1 ^ 2 - X 0 ^ 3

/-- The defining equation is `X 1 ^ 2 - X 0 ^ 3`. -/
theorem relation_eq (k : Type u) [Field k] :
    relation k = X 1 ^ 2 - X 0 ^ 3 := sorry

/-- The relation ideal `(y ^ 2 - x ^ 3)` in `k[x, y]`. -/
def relationIdeal (k : Type u) [Field k] : Ideal (MvPolynomial (Fin 2) k) :=
  Ideal.span {relation k}

/-- The relation ideal is the principal ideal generated by `relation`. -/
theorem relationIdeal_eq_span (k : Type u) [Field k] :
    relationIdeal k = Ideal.span {relation k} := sorry

/-- The coordinate ring `k[x, y] ⧸ (y ^ 2 - x ^ 3)`. -/
abbrev CoordinateRing (k : Type u) [Field k] : Type u :=
  MvPolynomial (Fin 2) k ⧸ relationIdeal k

/-- The coordinate ring is the quotient by `relationIdeal`. -/
theorem coordinateRing_eq (k : Type u) [Field k] :
    CoordinateRing k = (MvPolynomial (Fin 2) k ⧸ relationIdeal k) := sorry

/-- The class of the first coordinate, corresponding to the source variable `x`. -/
def coordX (k : Type u) [Field k] : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (X 0)

/-- The class of the second coordinate, corresponding to the source variable `y`. -/
def coordY (k : Type u) [Field k] : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (X 1)

/-- The origin ideal `(x, y)` in the coordinate ring. -/
def originIdeal (k : Type u) [Field k] : Ideal (CoordinateRing k) :=
  Ideal.span {coordX k, coordY k}

/-- The origin ideal is generated by `coordX` and `coordY`. -/
theorem originIdeal_eq_span (k : Type u) [Field k] :
    originIdeal k = Ideal.span {coordX k, coordY k} := sorry

/-- The class of `x` lies in the origin ideal. -/
theorem coordX_mem_originIdeal (k : Type u) [Field k] : coordX k ∈ originIdeal k := sorry

/-- The class of `y` lies in the origin ideal. -/
theorem coordY_mem_originIdeal (k : Type u) [Field k] : coordY k ∈ originIdeal k := sorry

/-- The origin ideal is the extension of `(x, y) = idealOfVars (Fin 2) k`. -/
theorem originIdeal_eq_map (k : Type u) [Field k] :
    originIdeal k =
      Ideal.map (Ideal.Quotient.mk (relationIdeal k)) (idealOfVars (Fin 2) k) := sorry

/-- The origin ideal is maximal, so it is the prime at which we localize. -/
instance originIdeal_isMaximal (k : Type u) [Field k] : (originIdeal k).IsMaximal := sorry

/-- The local ring of `k[x, y] ⧸ (y ^ 2 - x ^ 3)` at the origin `(x, y)`. -/
abbrev LocalRing (k : Type u) [Field k] : Type u :=
  Localization.AtPrime (originIdeal k)

/-- The local ring is the localization of the coordinate ring at `originIdeal`. -/
theorem localRing_eq (k : Type u) [Field k] :
    LocalRing k = Localization.AtPrime (originIdeal k) := sorry

end MvPolynomial.Cusp
