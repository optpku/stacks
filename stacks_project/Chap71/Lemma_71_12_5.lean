module

public import stacks_project.Chap71.Lemma_71_11_11_Functor
public import stacks_project.Chap71.Lemma_71_12_1_Compatibility
public import stacks_project.Chap71.Lemma_71_12_3_OnTarget

/-!
# Lemma 71.12.5

Eventual surjectivity of a map of quasi-coherent graded `𝒪_X`-algebras together with
degree-one generation of the source makes the induced relative projective-spectrum map
a closed immersion from the full source, with isomorphic twist comparisons.
-/

@[expose] public section

open CategoryTheory
open AlgebraicGeometry
open AlgebraicGeometry.AlgebraicSpace
open AlgebraicGeometry.AlgebraicSpace.RelativeProj
open AlgebraicGeometry.AlgebraicSpace.RelativeProjMap
open SheafOfModules.RingedSite

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.RelativeProjMap

variable {S : Scheme.{u}} {X : AlgebraicSpace S}
variable {𝒜 ℬ : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)}
variable [𝒜.IsQuasicoherent] [ℬ.IsQuasicoherent]
variable [𝒜.IsCommutative] [ℬ.IsCommutative]
variable {degA : DegreePieces 𝒜} {degB : DegreePieces ℬ}
variable {FA : ProjFunctor X 𝒜} {hFA : FA.IsAssociatedToQuadruples degA}
variable {FB : ProjFunctor X ℬ} {hFB : FB.IsAssociatedToQuadruples degB}
variable {φ : GradedAlgebraSheaf.Hom.{u + 1, u} 𝒜 ℬ}

/-- Lemma 71.12.5 (1): with the notation of Lemma 71.12.1, if `φ.hom (Int.ofNat d)` is
an epimorphism for all sufficiently large `d` and `𝒜` is generated by `𝒜₁` over
`𝒜₀`, then `U(ψ) = Q`, i.e. the natural domain of the étale-compatible relative
projective-spectrum map is the identity open subspace of `Q`. -/
@[stacks 085J]
theorem domain_eq_id_of_degreeOneGenerated
    (r : RelativeProjMap (toAlgebraicSpace_hom FA hFA) (toAlgebraicSpace_hom FB hFB)
      𝒜 ℬ (CanonicalTwists.family FA hFA).obj (CanonicalTwists.family FB hFB).obj φ)
    (hcompat :
      ∀ (W : Over S) (g : ofOver W ⟶ X) [Etale g]
        [AlgebraicGeometry.RelativeProjFunctor W.left (pullbackAlgebra g degA)]
        [AlgebraicGeometry.RelativeProjFunctor W.left (pullbackAlgebra g degB)],
        Nonempty (EtaleChartCompatibility hFA hFB r g))
    (hφsurj : ∃ N : ℕ, ∀ d ≥ N, Epi (φ.hom (Int.ofNat d)))
    (hgenerated : GeneratedByDegreeOne 𝒜) :
    r.domain = OpenSubspace.id (toAlgebraicSpace FB hFB) :=
  sorry

/-- Lemma 71.12.5 (2): under the same hypotheses, the induced morphism `r_ψ : Q ⟶ P` is a
closed immersion. -/
@[stacks 085J]
theorem mapOnTarget_isClosedImmersion_of_degreeOneGenerated
    (r : RelativeProjMap (toAlgebraicSpace_hom FA hFA) (toAlgebraicSpace_hom FB hFB)
      𝒜 ℬ (CanonicalTwists.family FA hFA).obj (CanonicalTwists.family FB hFB).obj φ)
    (hcompat :
      ∀ (W : Over S) (g : ofOver W ⟶ X) [Etale g]
        [AlgebraicGeometry.RelativeProjFunctor W.left (pullbackAlgebra g degA)]
        [AlgebraicGeometry.RelativeProjFunctor W.left (pullbackAlgebra g degB)],
        Nonempty (EtaleChartCompatibility hFA hFB r g))
    (hφsurj : ∃ N : ℕ, ∀ d ≥ N, Epi (φ.hom (Int.ofNat d)))
    (hgenerated : GeneratedByDegreeOne 𝒜) :
    let hTop := domain_eq_id_of_degreeOneGenerated r hcompat hφsurj hgenerated
    IsClosedImmersion (mapOnTarget r hTop) :=
  sorry

/-- Lemma 71.12.5 (3): under the same hypotheses, each comparison
`θ : r_ψ^* 𝒪_P(n) ⟶ 𝒪_Q(n)` is an isomorphism. -/
@[stacks 085J]
theorem thetaOnTarget_isIso_of_degreeOneGenerated
    (r : RelativeProjMap (toAlgebraicSpace_hom FA hFA) (toAlgebraicSpace_hom FB hFB)
      𝒜 ℬ (CanonicalTwists.family FA hFA).obj (CanonicalTwists.family FB hFB).obj φ)
    (hcompat :
      ∀ (W : Over S) (g : ofOver W ⟶ X) [Etale g]
        [AlgebraicGeometry.RelativeProjFunctor W.left (pullbackAlgebra g degA)]
        [AlgebraicGeometry.RelativeProjFunctor W.left (pullbackAlgebra g degB)],
        Nonempty (EtaleChartCompatibility hFA hFB r g))
    (hφsurj : ∃ N : ℕ, ∀ d ≥ N, Epi (φ.hom (Int.ofNat d)))
    (hgenerated : GeneratedByDegreeOne 𝒜) (n : ℤ) :
    let hTop := domain_eq_id_of_degreeOneGenerated r hcompat hφsurj hgenerated
    IsIso (thetaOnTarget r hTop (domainTopInclusion_comp_ι r hTop) n) :=
  sorry

end AlgebraicGeometry.AlgebraicSpace.RelativeProjMap
