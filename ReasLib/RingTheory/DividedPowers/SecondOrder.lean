module

public import Mathlib.RingTheory.DividedPowers.Basic
public import Mathlib.RingTheory.DividedPowers.SubDPIdeal

@[expose] public section

open DividedPowers

universe u

noncomputable section

/-- The second-order divided-power ideal generated by the square of `K ⊓ J` and
all divided powers of order at least two of elements of `K ⊓ J`. -/
def DividedPowers.secondOrderIdeal {R : Type u} [CommRing R] {J : Ideal R}
    (δ : DividedPowers J) (K : Ideal R) : Ideal R :=
  (K ⊓ J) ^ 2 ⊔ Ideal.span {y | ∃ (n : ℕ) (x : R), 2 ≤ n ∧ x ∈ K ⊓ J ∧ y = δ.dpow n x}

/-- The explicit description of the second-order divided-power ideal. -/
theorem DividedPowers.secondOrderIdeal_def {R : Type u} [CommRing R] {J : Ideal R}
    (δ : DividedPowers J) (K : Ideal R) :
    δ.secondOrderIdeal K =
      (K ⊓ J) ^ 2 ⊔ Ideal.span {y | ∃ (n : ℕ) (x : R), 2 ≤ n ∧ x ∈ K ⊓ J ∧ y = δ.dpow n x} := sorry

end

