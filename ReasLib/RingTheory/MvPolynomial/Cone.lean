module

public import Mathlib.Algebra.Group.Action.Pi
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.RingTheory.Nullstellensatz
public import Mathlib.Data.Complex.Basic

/-!
# Cones in classical affine space

Scalar-stable sets of affine points and homogeneous generators of their ideals.
-/

@[expose] public section

noncomputable section

universe u v

namespace MvPolynomial

variable {k : Type u} {σ : Type v} [Field k]

/-- A subset of affine space is a cone if it is closed under scalar multiplication. -/
def IsCone (X : Set (σ → k)) : Prop :=
  ∀ x ∈ X, ∀ c : k, c • x ∈ X

/-- A subset of affine space is a cone if and only if it is closed under coordinatewise
scalar multiplication. -/
theorem isCone_iff (X : Set (σ → k)) :
    IsCone X ↔ ∀ x ∈ X, ∀ c : k, (fun i ↦ c * x i) ∈ X := sorry

/-- The zero locus of an ideal generated by homogeneous polynomials is a cone. -/
theorem isCone_zeroLocus_span (S : Set (MvPolynomial σ k))
    (hS : ∀ f ∈ S, ∃ d, f.IsHomogeneous d) :
    IsCone (zeroLocus k (Ideal.span S)) := sorry

/-- The zero locus of a prime ideal in a finite-variable complex polynomial ring
generated by homogeneous polynomials is a cone. -/
theorem isCone_zeroLocus {n : ℕ} (p : Ideal (MvPolynomial (Fin n) ℂ)) (hp : p.IsPrime)
    (hS : ∃ S : Set (MvPolynomial (Fin n) ℂ),
      (∀ f ∈ S, ∃ d, f.IsHomogeneous d) ∧ p = Ideal.span S) :
    IsCone (zeroLocus ℂ p) := sorry

/-- A prime ideal in a finite-variable complex polynomial ring whose zero locus is a
cone is generated by homogeneous polynomials. -/
theorem generatedByHomogeneous_of_isCone_zeroLocus {n : ℕ}
    (p : Ideal (MvPolynomial (Fin n) ℂ)) (hp : p.IsPrime)
    (hX : IsCone (zeroLocus ℂ p)) :
    ∃ S : Set (MvPolynomial (Fin n) ℂ),
      (∀ f ∈ S, ∃ d, f.IsHomogeneous d) ∧ p = Ideal.span S := sorry

/-- A prime ideal in a finite-variable complex polynomial ring has a cone as its zero
locus if and only if it is generated by homogeneous polynomials. -/
theorem isCone_zeroLocus_iff_exists_span_isHomogeneous {n : ℕ}
    (p : Ideal (MvPolynomial (Fin n) ℂ)) (hp : p.IsPrime) :
    IsCone (zeroLocus ℂ p) ↔
      ∃ S : Set (MvPolynomial (Fin n) ℂ),
        (∀ f ∈ S, ∃ d, f.IsHomogeneous d) ∧ p = Ideal.span S := sorry

end MvPolynomial
