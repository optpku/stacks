module

public import Mathlib.AlgebraicGeometry.Sites.Proetale
public import Mathlib.CategoryTheory.ObjectProperty.FullSubcategory
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import ReasLib.AlgebraicGeometry.Scheme.Cover.StandardProetale
public import ReasLib.AlgebraicGeometry.Scheme.Sites.Proetale.ChosenPresentation

/-!
# Affine objects of the small pro-étale site

The full subcategory of affine objects of `S.ProEt`, equipped with the
topology generated by ambient-covering standard pro-étale covers.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.ObjectProperty

universe u

namespace AlgebraicGeometry.Scheme.ProEt

/-- The object property selecting affine objects of the small pro-étale site. -/
abbrev affineObjects (S : Scheme.{u}) : ObjectProperty S.ProEt :=
  fun U ↦ IsAffine U.left

/-- Affine objects of the small pro-étale site of `S` are those with affine
source scheme. -/
theorem affineObjects_iff (S : Scheme.{u}) (U : S.ProEt) :
    affineObjects S U ↔ IsAffine U.left := sorry

/-- The full subcategory of affine objects of the small pro-étale site. -/
abbrev Affine (S : Scheme.{u}) := (affineObjects S).FullSubcategory

/-- Construct an affine object of the small pro-étale site from an affine
weakly étale morphism. -/
def Affine.mk {S : Scheme.{u}} {X : Scheme.{u}} (f : X ⟶ S) [IsAffine X]
    [WeaklyEtale f] : Affine S :=
  ⟨ProEt.mk f, ‹IsAffine X›⟩

/-- The underlying object of `Affine.mk f` is the corresponding object in the
small pro-étale site. -/
theorem Affine.mk_obj {S : Scheme.{u}} {X : Scheme.{u}} (f : X ⟶ S) [IsAffine X]
    [WeaklyEtale f] : (Affine.mk f).obj = ProEt.mk f := sorry

/-- The inclusion of affine objects into the small pro-étale site. -/
def affineInclusion (S : Scheme.{u}) : Affine S ⥤ S.ProEt :=
  (affineObjects S).ι

/-- The inclusion of an affine object is the underlying object of the small
pro-étale site. -/
theorem affineInclusion_obj (S : Scheme.{u}) (U : Affine S) :
    (affineInclusion S).obj U = U.obj := sorry

/-- The source-scheme functor from affine objects of the small pro-étale site. -/
def affineToScheme (S : Scheme.{u}) : Affine S ⥤ Scheme.{u} :=
  affineInclusion S ⋙ ProEt.forget S ⋙ Over.forget S

/-- Every object of the affine small pro-étale site has affine source scheme. -/
instance instIsAffine (S : Scheme.{u}) (U : Affine S) : IsAffine U.obj.left :=
  U.property

/-- A presieve on an affine object is a standard covering when it covers in the
ambient small pro-étale site and its image in schemes generates the same sieve
as a finite standard pro-étale cover. -/
def affineStandardCovering (S : Scheme.{u}) {U : Affine S} (R : Presieve U) : Prop :=
  R.map (affineInclusion S) ∈ (topology S).toPrecoverage U.obj ∧
    ∃ 𝒰 : StandardProetaleCover U.obj.left,
      Sieve.generate (R.map (affineToScheme S)) =
        Sieve.generate (Presieve.ofArrows 𝒰.U 𝒰.map)

/-- The precoverage of ambient-covering finite standard pro-étale families on
affine objects of the small pro-étale site. -/
def affinePrecoverage (S : Scheme.{u}) : Precoverage (Affine S) where
  coverings := fun _ ↦ { R | affineStandardCovering S R }

/-- Membership in the affine standard precoverage records both ambient covering
and equality of generated sieves with a finite standard pro-étale cover. -/
theorem mem_affinePrecoverage_iff (S : Scheme.{u}) {U : Affine S} {R : Presieve U} :
    R ∈ affinePrecoverage S U ↔
      R.map (affineInclusion S) ∈ (topology S).toPrecoverage U.obj ∧
        ∃ 𝒰 : StandardProetaleCover U.obj.left,
          Sieve.generate (R.map (affineToScheme S)) =
            Sieve.generate (Presieve.ofArrows 𝒰.U 𝒰.map) := sorry

/-- The Grothendieck topology on affine objects generated by ambient-covering
finite standard pro-étale families. -/
def affineTopology (S : Scheme.{u}) : GrothendieckTopology (Affine S) :=
  (affinePrecoverage S).toGrothendieck

/-- The affine small pro-étale topology is generated by its standard pro-étale
precoverage. -/
theorem affineTopology_def (S : Scheme.{u}) :
    affineTopology S = (affinePrecoverage S).toGrothendieck := sorry

end AlgebraicGeometry.Scheme.ProEt

universe v

namespace AlgebraicGeometry.ChosenBigProetaleSite

/-- The object property selecting affine represented source schemes in a
chosen big pro-étale slice. -/
def bigAffineObjects (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    ObjectProperty (bigSite X S) :=
  fun U ↦ IsAffine (X.toScheme.obj U.left)

/-- The big affine pro-étale carrier is the full subcategory of the chosen big
slice on objects with affine represented source. -/
abbrev bigAffineSite (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :=
  ObjectProperty.FullSubcategory (bigAffineObjects X S)

/-- The inclusion of the chosen big affine pro-étale carrier into the chosen
big slice. -/
def bigAffineInclusion (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    bigAffineSite X S ⥤ bigSite X S :=
  ObjectProperty.ι (bigAffineObjects X S)

/-- The source-scheme functor from the chosen big affine pro-étale carrier. -/
def bigAffineToScheme (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    bigAffineSite X S ⥤ Scheme.{u} :=
  bigAffineInclusion X S ⋙ bigToScheme X S

/-- Every object of the chosen big affine pro-étale carrier has affine
represented source scheme. -/
theorem bigAffineSite_obj_isAffine (X : ChosenBigProetaleSite.{u, v})
    (S : X.carrier) (U : bigAffineSite X S) :
    IsAffine (X.toScheme.obj U.obj.left) := sorry

/-- A finite standard pro-étale cover of an object of the chosen big affine
carrier, using the affine proof stored in that object. -/
abbrev BigAffineStandardCover (X : ChosenBigProetaleSite.{u, v})
    (S : X.carrier) (U : bigAffineSite X S) :=
  @StandardProetaleCover ((bigAffineToScheme X S).obj U) U.property

/-- A presieve on the chosen big affine carrier is a standard covering when it
is a selected covering in the ambient big slice and is a finite family of
weakly étale arrows whose represented images jointly cover the target. -/
def bigAffineStandardCovering (X : ChosenBigProetaleSite.{u, v})
    (S : X.carrier) {U : bigAffineSite X S} (R : Presieve U) : Prop :=
  Presieve.overEquiv U.obj (R.map (bigAffineInclusion X S)) ∈
      X.pretopology U.obj.left ∧
    ∃ (n : ℕ) (V : Fin n → bigAffineSite X S) (f : ∀ i, V i ⟶ U),
      R = Presieve.ofArrows V f ∧
        (∀ i, WeaklyEtale ((bigAffineToScheme X S).map (f i))) ∧
        (∀ t : (bigAffineToScheme X S).obj U,
          ∃ i, t ∈ Set.range ((bigAffineToScheme X S).map (f i)))

/-- The precoverage of ambient-covering finite standard pro-étale families on
the chosen big affine carrier. -/
def bigAffineStandardPrecoverage (X : ChosenBigProetaleSite.{u, v})
    (S : X.carrier) : Precoverage (bigAffineSite X S) where
  coverings := fun _ ↦ { R | bigAffineStandardCovering X S R }

/-- Membership in the chosen big affine standard precoverage records both
selected ambient covering and a finite presentation by weakly étale arrows
whose represented images jointly cover the target. -/
theorem mem_bigAffineStandardPrecoverage_iff
    (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier)
    {U : bigAffineSite X S} {R : Presieve U} :
    R ∈ bigAffineStandardPrecoverage X S U ↔
      Presieve.overEquiv U.obj (R.map (bigAffineInclusion X S)) ∈
          X.pretopology U.obj.left ∧
        ∃ (n : ℕ) (V : Fin n → bigAffineSite X S) (f : ∀ i, V i ⟶ U),
          R = Presieve.ofArrows V f ∧
            (∀ i, WeaklyEtale ((bigAffineToScheme X S).map (f i))) ∧
            (∀ t : (bigAffineToScheme X S).obj U,
              ∃ i, t ∈ Set.range ((bigAffineToScheme X S).map (f i))) := sorry

/-- The Grothendieck topology on the chosen big affine carrier generated by
ambient-covering finite standard pro-étale families. -/
def bigAffineTopology (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    GrothendieckTopology (bigAffineSite X S) :=
  (bigAffineStandardPrecoverage X S).toGrothendieck

/-- The chosen big affine pro-étale topology is generated by its standard
pro-étale precoverage. -/
theorem bigAffineTopology_def (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    bigAffineTopology X S =
      (bigAffineStandardPrecoverage X S).toGrothendieck := sorry

end AlgebraicGeometry.ChosenBigProetaleSite
