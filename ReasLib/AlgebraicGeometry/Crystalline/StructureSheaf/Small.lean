module

public import ReasLib.AlgebraicGeometry.Crystalline.Thickening
public import ReasLib.AlgebraicGeometry.Scheme.Sites.StructureSheaf

@[expose] public section

open AlgebraicGeometry CategoryTheory

universe u

namespace AlgebraicGeometry.Scheme.Crystalline

variable {p : ℕ} [Fact (Nat.Prime p)]
variable {S : Scheme.{u}} (I : S.IdealSheafData)
variable (γ : ∀ V : S.affineOpens, DividedPowers (I.ideal V))
variable (h_compatible :
  ∀ (V : S.affineOpens) (f : Γ(S, V)),
    (γ V).IsDPMorphism (γ (S.affineBasicOpen f))
      (S.presheaf.map (homOfLE (S.basicOpen_le f)).op).hom)
variable (s : S ⟶ Spec (.of (ULift.{u} (Int.LocalizationAtPrime p))))
variable {X : Scheme.{u}} (x₀ : X ⟶ I.subscheme)
variable (h_p : ∀ U : X.affineOpens, IsNilpotent (p : Γ(X, U)))

/-- Global functions on small crystalline thickenings satisfy descent for the topology
generated by crystalline Zariski covering families. -/
theorem smallCrystallineStructureSheaf_isSheaf :
    Presheaf.IsSheaf (smallCrystallineTopology p S I γ h_compatible s X x₀ h_p)
      (Scheme.Site.structurePresheaf (smallThickeningFunctor S I γ h_compatible X x₀)) := sorry

/-- The crystalline structure sheaf on the generated small crystalline topology
assigns global functions to each thickening. -/
def smallCrystallineStructureSheaf :
    Sheaf (smallCrystallineTopology p S I γ h_compatible s X x₀ h_p) RingCat.{u} :=
  ⟨Scheme.Site.structurePresheaf (smallThickeningFunctor S I γ h_compatible X x₀),
    smallCrystallineStructureSheaf_isSheaf I γ h_compatible s x₀ h_p⟩

end AlgebraicGeometry.Scheme.Crystalline
