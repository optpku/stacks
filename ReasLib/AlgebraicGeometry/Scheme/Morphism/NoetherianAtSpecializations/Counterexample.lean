module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.AlgebraicGeometry.Limits
public import Mathlib.Data.Complex.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import ReasLib.AlgebraicGeometry.Scheme.Morphism.NoetherianAtSpecializations

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits TopologicalSpace

namespace AlgebraicGeometry.NoetherianAtSpecializations.Counterexample

open MvPolynomial PrimeSpectrum

/-- The ideal generated by the products `X n * X m` for distinct integers `n` and `m`. -/
def relations : Ideal (MvPolynomial ℤ ℂ) :=
  Ideal.span { p | ∃ n m : ℤ, n ≠ m ∧ p = X n * X m }

/-- Every product of two distinct coordinate variables belongs to `relations`. -/
theorem mul_X_mem_relations (n m : ℤ) (hnm : n ≠ m) :
    X n * X m ∈ relations := sorry

/-- The coordinate ring `ℂ[x_n; n ∈ ℤ] / (x_n x_m; n ≠ m)`. -/
abbrev CoordinateRing : Type := MvPolynomial ℤ ℂ ⧸ relations

/-- The quotient map to `CoordinateRing`. -/
def quotientMap : MvPolynomial ℤ ℂ →+* CoordinateRing :=
  Ideal.Quotient.mk relations

/-- Distinct coordinate variables have zero product in `CoordinateRing`. -/
theorem quotientMap_mul_X_eq_zero (n m : ℤ) (hnm : n ≠ m) :
    quotientMap (X n * X m) = 0 := sorry

/-- Evaluation of all variables at zero kills `relations`. -/
theorem relations_le_originEvaluation_ker :
    relations ≤ RingHom.ker (MvPolynomial.eval₂Hom (RingHom.id ℂ) (fun _ ↦ 0)) := sorry

/-- Evaluation at the origin on `CoordinateRing`. -/
def originEvaluation : CoordinateRing →+* ℂ :=
  Ideal.Quotient.lift relations
    (MvPolynomial.eval₂Hom (RingHom.id ℂ) (fun _ ↦ 0))
    relations_le_originEvaluation_ker

/-- Every coordinate evaluates to zero at the origin. -/
theorem originEvaluation_quotientMap_X (n : ℤ) :
    originEvaluation (quotientMap (X n)) = 0 := sorry

/-- The point of the spectrum at which every coordinate vanishes. -/
def origin : Spec (CommRingCat.of CoordinateRing) :=
  PrimeSpectrum.comap originEvaluation (IsLocalRing.closedPoint ℂ)

/-- The origin is the pullback of the closed point of `Spec(ℂ)` along origin evaluation. -/
theorem origin_eq_comap :
    origin = PrimeSpectrum.comap originEvaluation (IsLocalRing.closedPoint ℂ) := sorry

/-- The origin is a closed point of the spectrum. -/
theorem isClosed_singleton_origin :
    IsClosed ({origin} : Set (Spec (CommRingCat.of CoordinateRing))) := sorry

/-- The open subscheme obtained by deleting the origin. -/
def puncturedOpen : (Spec (CommRingCat.of CoordinateRing)).Opens :=
  ⟨({origin} : Set (Spec (CommRingCat.of CoordinateRing)))ᶜ,
    isClosed_singleton_origin.isOpen_compl⟩

/-- A point belongs to `puncturedOpen` exactly when it is not the origin. -/
theorem mem_puncturedOpen_iff (x : Spec (CommRingCat.of CoordinateRing)) :
    x ∈ puncturedOpen ↔ x ≠ origin := sorry

/-- The punctured open subscheme is locally Noetherian. -/
instance instIsLocallyNoetherianPuncturedOpen :
    IsLocallyNoetherian puncturedOpen.toScheme := sorry

/-- The stalk at the origin of the infinite-axis scheme is not Noetherian. -/
theorem origin_stalk_not_noetherian :
    ¬ IsNoetherianRing ((Spec (CommRingCat.of CoordinateRing)).presheaf.stalk origin) := sorry

/-- The map from the disjoint union of the punctured open and the whole spectrum to the
whole spectrum, given by the open immersion on the first summand and the identity on the
second. -/
def cover :
    puncturedOpen.toScheme ⨿ Spec (CommRingCat.of CoordinateRing) ⟶
      Spec (CommRingCat.of CoordinateRing) :=
  coprod.desc puncturedOpen.ι (𝟙 (Spec (CommRingCat.of CoordinateRing)))

/-- On the first summand, `cover` is the punctured-open immersion. -/
theorem cover_inl :
    (coprod.inl : puncturedOpen.toScheme ⟶
      puncturedOpen.toScheme ⨿ Spec (CommRingCat.of CoordinateRing)) ≫ cover =
      puncturedOpen.ι := sorry

/-- On the second summand, `cover` is the identity. -/
theorem cover_inr :
    (coprod.inr : Spec (CommRingCat.of CoordinateRing) ⟶
      puncturedOpen.toScheme ⨿ Spec (CommRingCat.of CoordinateRing)) ≫ cover =
      𝟙 (Spec (CommRingCat.of CoordinateRing)) := sorry

/-- The square with top map `coprod.inl`, left map the identity, bottom map
`puncturedOpen.ι`, and right map `cover` commutes. -/
theorem square :
    (coprod.inl : puncturedOpen.toScheme ⟶
      puncturedOpen.toScheme ⨿ Spec (CommRingCat.of CoordinateRing)) ≫ cover =
      𝟙 puncturedOpen.toScheme ≫ puncturedOpen.ι := sorry

/-- The morphism `cover` is surjective. -/
instance instSurjectiveCover : Surjective cover := sorry

/-- The morphism `cover` is étale. -/
instance instEtaleCover : Etale cover := sorry

/-- Inclusion of the locally Noetherian punctured open into the first summand has
`NoetherianAtSpecializations`. -/
theorem top :
    NoetherianAtSpecializations
      (coprod.inl : puncturedOpen.toScheme ⟶
        puncturedOpen.toScheme ⨿ Spec (CommRingCat.of CoordinateRing)) := sorry

/-- The punctured-open immersion into the infinite-axis scheme does not have
`NoetherianAtSpecializations`. -/
theorem bottom_not : ¬ NoetherianAtSpecializations puncturedOpen.ι := sorry

end AlgebraicGeometry.NoetherianAtSpecializations.Counterexample
