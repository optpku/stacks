module

public import ReasLib.RingTheory.Gorenstein.Quotient
import StacksCheckRecall

@[expose] public section

universe u

/- Lemma 47.21.6: if `f` is a regular element in the maximal ideal of a Noetherian local
ring `A`, then `A` is Gorenstein if and only if its quotient by the ideal generated by `f`
is Gorenstein. -/
@[stacks 0BJJ]
#check (IsGorensteinLocalRing.iff_quotient_span_singleton :
  ∀ {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (f : IsLocalRing.maximalIdeal A) (hf : IsRegular (f : A)),
    IsGorensteinLocalRing A ↔
      IsGorensteinLocalRing (A ⧸ Ideal.span ({(f : A)} : Set A)))
