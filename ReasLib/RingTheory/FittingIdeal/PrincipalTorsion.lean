module

public import Mathlib.Algebra.Module.FinitePresentation
public import Mathlib.Algebra.Module.Torsion.Basic
public import Mathlib.Algebra.Ring.NonZeroDivisors
public import Mathlib.CategoryTheory.Abelian.Projective.Dimension
public import ReasLib.RingTheory.FittingIdeal.LocallyFree
public import ReasLib.RingTheory.Ideal.Principal
import Mathlib.Tactic.CrossRefAttribute

/-!
# Principal Fitting ideals and torsion

This leaf owns the local generator statement of Lemma 15.8.9 and the five structural conclusions
of Lemma 15.8.10.

@stack 080Z
@stack 0F7M
-/

@[expose] public section

open CategoryTheory
open scoped FittingIdeal

universe u v

namespace FittingIdeal.PrincipalTorsion

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]
variable {k : ℕ} {f : R}

/-- Lemma 15.8.9: over a local ring, if `Fit_k(M) = (f)`, then the quotient of `M` by the
submodule killed by `f` is generated by `k` elements. -/
@[stacks 080Z "principal Fitting ideal gives generators modulo torsion"]
theorem exists_quotient_torsionBy_generators [IsLocalRing R] [Module.Finite R M]
    (hfit : Fit[R]_(k)(M) = principalIdeal f) :
    ∃ v : Fin k → M ⧸ Submodule.torsionBy R M f,
      Submodule.span R (Set.range v) = ⊤ := sorry

section FinitePresentation

variable [Module.FinitePresentation R M]

/-- Lemma 15.8.10 (1): under the principal nonzerodivisor Fitting hypotheses, `M` has projective
dimension at most `1`. -/
@[stacks 0F7M "(1), projective dimension of the module"]
theorem projectiveDimensionLE_one
    (hf : f ∈ nonZeroDivisors R)
    (hfit : Fit[R]_(k)(M) = principalIdeal f)
    (hpreceding : precedingFittingIdeal R M k = ⊥) :
    HasProjectiveDimensionLE (ModuleCat.of R M) 1 := sorry

/-- Lemma 15.8.10 (2): the submodule killed by `f` is the `f`-power-torsion submodule. -/
@[stacks 0F7M "(2), power torsion equals torsion killed by the generator"]
theorem powerTorsion_eq_torsionBy
    (hf : f ∈ nonZeroDivisors R)
    (hfit : Fit[R]_(k)(M) = principalIdeal f)
    (hpreceding : precedingFittingIdeal R M k = ⊥) :
    Submodule.torsion' R M (Submonoid.powers f) = Submodule.torsionBy R M f := sorry

/-- Lemma 15.8.10 (3): the `f`-torsion submodule has projective dimension at most `1`. -/
@[stacks 0F7M "(3), projective dimension of the torsion submodule"]
theorem torsionBy_projectiveDimensionLE_one
    (hf : f ∈ nonZeroDivisors R)
    (hfit : Fit[R]_(k)(M) = principalIdeal f)
    (hpreceding : precedingFittingIdeal R M k = ⊥) :
    HasProjectiveDimensionLE (ModuleCat.of R (Submodule.torsionBy R M f)) 1 := sorry

/-- Lemma 15.8.10 (4): the quotient by the `f`-torsion submodule is finite locally free of rank
`k`. -/
@[stacks 0F7M "(4), locally free quotient by torsion"]
theorem quotient_finiteLocallyFreeOfRank
    (hf : f ∈ nonZeroDivisors R)
    (hfit : Fit[R]_(k)(M) = principalIdeal f)
    (hpreceding : precedingFittingIdeal R M k = ⊥) :
    Module.FiniteLocallyFreeOfRank R (M ⧸ Submodule.torsionBy R M f) k := sorry

/-- Lemma 15.8.10 (5): the module is noncanonically the direct sum of its quotient by
`f`-torsion and its `f`-torsion submodule. -/
@[stacks 0F7M "(5), splitting into quotient and torsion"]
theorem nonempty_quotient_prod_torsionBy_equiv
    (hf : f ∈ nonZeroDivisors R)
    (hfit : Fit[R]_(k)(M) = principalIdeal f)
    (hpreceding : precedingFittingIdeal R M k = ⊥) :
    Nonempty (M ≃ₗ[R] (M ⧸ Submodule.torsionBy R M f) × Submodule.torsionBy R M f) := sorry

end FinitePresentation

end FittingIdeal.PrincipalTorsion
