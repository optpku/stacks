module

public import ReasLib.RingTheory.MvPolynomial.Fin
public import Mathlib.RingTheory.Polynomial.Quotient
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Quotients by a Distinguished Multivariate Variable

This leaf owns the canonical presentation of a multivariate polynomial ring
in `Fin (n + 1)` variables modulo its first variable as the polynomial ring in
the remaining `Fin n` variables.  The construction is independent of all
regular-sequence and module data.
-/

universe u

namespace MvPolynomial.Quotient

variable {A : Type u} [CommRing A]

/-- A quotient of a finite multivariate polynomial ring is generated over its coefficient ring by the
classes of the variables.  This is the quotient-level form of `MvPolynomial.adjoin_range_X` and is
independent of any grading or localization choice. -/
@[stacks 061R "quotient generated by variable classes"]
theorem adjoin_mk_X_eq_top {n : ℕ}
    (J : Ideal (MvPolynomial (Fin (n + 1)) A)) :
    Algebra.adjoin A
        (Set.range fun i : Fin (n + 1) =>
          Ideal.Quotient.mk J (MvPolynomial.X i)) = ⊤ := sorry

/-- Tag `061R`: the principal ideal generated by the first variable of a
finite multivariate polynomial ring. -/
@[reducible, stacks 061R "head multivariate variable ideal"]
noncomputable def headXIdeal (n : ℕ) : Ideal (MvPolynomial (Fin (n + 1)) A) :=
  Ideal.span ({MvPolynomial.X (0 : Fin (n + 1))} : Set (MvPolynomial (Fin (n + 1)) A))

/-- Tag `061R`: quotienting a polynomial ring in `Fin (n + 1)` variables by
its first variable is canonically the polynomial ring in the remaining variables. -/
@[stacks 061R "head multivariate variable quotient"]
noncomputable def headXAlgEquiv (n : ℕ) :
    (MvPolynomial (Fin (n + 1)) A ⧸ headXIdeal n) ≃ₐ[A] MvPolynomial (Fin n) A :=
  let ePoly : MvPolynomial (Fin (n + 1)) A ≃ₐ[A] Polynomial (MvPolynomial (Fin n) A) :=
    MvPolynomial.finSuccEquiv A n
  let eQuot :
      (MvPolynomial (Fin (n + 1)) A ⧸ headXIdeal n) ≃ₐ[A]
        (Polynomial (MvPolynomial (Fin n) A) ⧸
          Ideal.span ({Polynomial.X} : Set (Polynomial (MvPolynomial (Fin n) A)))) :=
    Ideal.quotientEquivAlg
      (headXIdeal n)
      (Ideal.span ({Polynomial.X} : Set (Polynomial (MvPolynomial (Fin n) A))))
      ePoly
      ((congrArg
          (fun x : Polynomial (MvPolynomial (Fin n) A) =>
            Ideal.span ({x} : Set (Polynomial (MvPolynomial (Fin n) A))))
          (MvPolynomial.finSuccEquiv_X_zero (R := A) (n := n)).symm).trans
        ((congrArg
            (fun s : Set (Polynomial (MvPolynomial (Fin n) A)) => Ideal.span s)
            (Set.image_singleton
              (f := (ePoly : MvPolynomial (Fin (n + 1)) A →
                Polynomial (MvPolynomial (Fin n) A)))
              (a := MvPolynomial.X (0 : Fin (n + 1)))).symm).trans
          (Ideal.map_span
            (f := (ePoly : MvPolynomial (Fin (n + 1)) A →+*
              Polynomial (MvPolynomial (Fin n) A)))
            ({MvPolynomial.X (0 : Fin (n + 1))} : Set (MvPolynomial (Fin (n + 1)) A))).symm))
  let eX :
      (Polynomial (MvPolynomial (Fin n) A) ⧸
        Ideal.span ({Polynomial.X} : Set (Polynomial (MvPolynomial (Fin n) A)))) ≃ₐ[A]
        (Polynomial (MvPolynomial (Fin n) A) ⧸
          Ideal.span ({Polynomial.X - Polynomial.C 0} : Set (Polynomial (MvPolynomial (Fin n) A)))) :=
    Ideal.quotientEquivAlgOfEq A
      (congrArg
        (fun x : Polynomial (MvPolynomial (Fin n) A) =>
          Ideal.span ({x} : Set (Polynomial (MvPolynomial (Fin n) A))))
        ((sub_zero (Polynomial.X : Polynomial (MvPolynomial (Fin n) A))).symm.trans
          (congrArg
            (fun x : Polynomial (MvPolynomial (Fin n) A) =>
              (Polynomial.X : Polynomial (MvPolynomial (Fin n) A)) - x)
            (Polynomial.C_0 (R := MvPolynomial (Fin n) A)).symm)))
  eQuot.trans <|
    eX.trans ((Polynomial.quotientSpanXSubCAlgEquiv (0 : MvPolynomial (Fin n) A)).restrictScalars A)

/-- The head-variable quotient sends `X 0` to zero. -/
@[simp, stacks 061R "head quotient head variable"]
theorem headXAlgEquiv_mk_X_zero (n : ℕ) :
    headXAlgEquiv (A := A) n
      (Ideal.Quotient.mk (headXIdeal (A := A) n) (MvPolynomial.X (0 : Fin (n + 1)))) = 0 := sorry

/-- The head-variable quotient sends each successor variable to its tail
counterpart. -/
@[simp, stacks 061R "head quotient successor variable"]
theorem headXAlgEquiv_mk_X_succ (n : ℕ) (j : Fin n) :
    headXAlgEquiv (A := A) n
      (Ideal.Quotient.mk (headXIdeal (A := A) n) (MvPolynomial.X j.succ)) = MvPolynomial.X j := sorry

/-- The head-variable quotient preserves coefficient constants. -/
@[simp, stacks 061R "head quotient coefficient constant"]
theorem headXAlgEquiv_mk_C (n : ℕ) (a : A) :
    headXAlgEquiv (A := A) n
      (Ideal.Quotient.mk (headXIdeal (A := A) n) (MvPolynomial.C a)) = MvPolynomial.C a := sorry

/-- On a quotient representative, the head-variable quotient agrees with
evaluation that sets the first variable to zero. -/
@[simp, stacks 061R "head quotient evaluation on representatives"]
theorem headXAlgEquiv_apply_mk (n : ℕ) (p : MvPolynomial (Fin (n + 1)) A) :
    headXAlgEquiv (A := A) n (Ideal.Quotient.mk (headXIdeal (A := A) n) p) =
      MvPolynomial.Fin.evalHead (A := A) 0 n p := sorry

/-- The head-variable quotient sends the included tail polynomial to the
original tail polynomial. -/
@[simp, stacks 061R "head quotient tail inclusion"]
theorem headXAlgEquiv_mk_includeTail (n : ℕ) (p : MvPolynomial (Fin n) A) :
    headXAlgEquiv (A := A) n
      (Ideal.Quotient.mk (headXIdeal (A := A) n)
        (MvPolynomial.Fin.includeTail (A := A) n p)) = p := sorry

/-- The inverse head-variable quotient equivalence is represented by the
tail-variable inclusion. -/
@[simp, stacks 061R "head quotient inverse representative"]
theorem headXAlgEquiv_symm_apply (n : ℕ) (p : MvPolynomial (Fin n) A) :
    (headXAlgEquiv (A := A) n).symm p =
      Ideal.Quotient.mk (headXIdeal (A := A) n)
        (MvPolynomial.Fin.includeTail (A := A) n p) := sorry

end MvPolynomial.Quotient
