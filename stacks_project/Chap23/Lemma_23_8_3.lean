module

public import ReasLib.RingTheory.CompleteIntersection.RegularQuotient
import StacksCheckRecall

@[expose] public section

/- Lemma 23.8.3 (09Q1): for `I ⊆ p` in a regular ring, the quotient of `R_p` by `I R_p` is a
complete intersection exactly when `I R_p` is generated by a regular sequence, equivalently when
its conormal module is generated by the codimension. -/
universe u

section

variable {R : Type u} [CommRing R] [IsRegularRing R]
variable (p : PrimeSpectrum R) (I : Ideal R) (hIp : I ≤ p.asIdeal)

@[stacks 09Q1]
#check (Ideal.AtPrime.RegularQuotient.criteria p I hIp :
  List.TFAE
    [ IsCompleteIntersectionLocalRing (I.quotientAtPrime p)
    , (I.localizationAtPrime p).IsGeneratedByRegularSequence
    , (I.localizationAtPrime p).CotangentGeneratedByCodimension
    ])

end

#check @Ideal.CotangentGeneratedByCodimension
#check @Ideal.RegularQuotient.completeIntersection_iff_regularSequence
#check @Ideal.RegularQuotient.regularSequence_iff_cotangent
#check @Ideal.RegularQuotient.completeIntersection_iff_cotangent
