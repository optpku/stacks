module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Algebra.MvPolynomial.Rename
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.Noetherian
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import ReasLib.AlgebraicGeometry.Scheme.OverField
public import ReasLib.AlgebraicGeometry.Scheme.Variety
public import ReasLib.AlgebraicGeometry.Scheme.Variety.AffinePresentation

/-!
# The affine quadric cone `k[x, y, z, w] ⧸ (x * y - z * w)`

The affine hypersurface `x * y - z * w = 0` in affine
4-space over a field is a scheme over that field with a closed
immersion into `AffineSpaceOverField k 4`.
-/

@[expose] public section

noncomputable section

universe u

open AlgebraicGeometry CategoryTheory MvPolynomial

namespace AlgebraicGeometry.AffineQuadricCone

/-- The first affine coordinate `x` on `𝔸^4`. -/
def x (k : Type u) [Field k] : MvPolynomial (Fin 4) k :=
  X (0 : Fin 4)

/-- The second affine coordinate `y` on `𝔸^4`. -/
def y (k : Type u) [Field k] : MvPolynomial (Fin 4) k :=
  X (1 : Fin 4)

/-- The third affine coordinate `z` on `𝔸^4`. -/
def z (k : Type u) [Field k] : MvPolynomial (Fin 4) k :=
  X (2 : Fin 4)

/-- The fourth affine coordinate `w` on `𝔸^4`. -/
def w (k : Type u) [Field k] : MvPolynomial (Fin 4) k :=
  X (3 : Fin 4)

/-- The defining equation `x * y - z * w` of the affine quadric cone. -/
def equation (k : Type u) [Field k] : MvPolynomial (Fin 4) k :=
  x k * y k - z k * w k

/-- The affine quadric cone is cut out by `x * y - z * w`. -/
theorem equation_spec (k : Type u) [Field k] :
    equation k = x k * y k - z k * w k := sorry

/-- The principal relation ideal of the affine quadric cone. -/
def relationIdeal (k : Type u) [Field k] : Ideal (MvPolynomial (Fin 4) k) :=
  Ideal.span {equation k}

/-- The relation ideal is the principal ideal generated by `x * y - z * w`. -/
theorem relationIdeal_eq_span (k : Type u) [Field k] :
    relationIdeal k = Ideal.span {equation k} := sorry

/-- The coordinate ring `k[x, y, z, w] ⧸ (x * y - z * w)`. -/
abbrev CoordinateRing (k : Type u) [Field k] : Type u :=
  MvPolynomial (Fin 4) k ⧸ relationIdeal k

/-- The defining equation vanishes in the coordinate ring. -/
theorem mk_equation (k : Type u) [Field k] :
    Ideal.Quotient.mk (relationIdeal k) (equation k) = (0 : CoordinateRing k) := sorry

/-- The class of `x` in the coordinate ring. -/
def xBar (k : Type u) [Field k] : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (x k)

/-- The class of `y` in the coordinate ring. -/
def yBar (k : Type u) [Field k] : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (y k)

/-- The class of `z` in the coordinate ring. -/
def zBar (k : Type u) [Field k] : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (z k)

/-- The class of `w` in the coordinate ring. -/
def wBar (k : Type u) [Field k] : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (w k)

/-- `xBar` is the quotient class of the coordinate `x`. -/
theorem xBar_eq_mk (k : Type u) [Field k] :
    xBar k = Ideal.Quotient.mk (relationIdeal k) (x k) := sorry

/-- `yBar` is the quotient class of the coordinate `y`. -/
theorem yBar_eq_mk (k : Type u) [Field k] :
    yBar k = Ideal.Quotient.mk (relationIdeal k) (y k) := sorry

/-- `zBar` is the quotient class of the coordinate `z`. -/
theorem zBar_eq_mk (k : Type u) [Field k] :
    zBar k = Ideal.Quotient.mk (relationIdeal k) (z k) := sorry

/-- `wBar` is the quotient class of the coordinate `w`. -/
theorem wBar_eq_mk (k : Type u) [Field k] :
    wBar k = Ideal.Quotient.mk (relationIdeal k) (w k) := sorry

/-- The coordinate ring of the affine quadric cone is an integral domain. -/
instance instIsDomain_coordinateRing (k : Type u) [Field k] :
    IsDomain (CoordinateRing k) := sorry

/-- The affine scheme `Spec k[x, y, z, w] ⧸ (x * y - z * w)`. -/
def scheme (k : Type u) [Field k] : Scheme.{u} :=
  Spec (CommRingCat.of (CoordinateRing k))

/-- The structure morphism of the affine quadric cone to `Spec k`. -/
def toBase (k : Type u) [Field k] :
    scheme k ⟶ Spec (CommRingCat.of k) :=
  Spec.map (CommRingCat.ofHom (algebraMap k (CoordinateRing k)))

/-- The structure morphism is `Spec.map` of the coefficient algebra map. -/
theorem toBase_eq_Spec_map (k : Type u) [Field k] :
    toBase k = Spec.map (CommRingCat.ofHom (algebraMap k (CoordinateRing k))) := sorry

/-- The affine quadric cone as a scheme over the field `k`. -/
def over (k : Type u) [Field k] : SchemeOverField k :=
  Over.mk (toBase k)

/-- The underlying scheme of `over k` is `scheme k`. -/
theorem over_left_eq_scheme (k : Type u) [Field k] :
    (over k).left = scheme k := sorry

/-- The affine quadric cone is an affine scheme. -/
instance instIsAffine_scheme (k : Type u) [Field k] : IsAffine (scheme k) := sorry

/-- The affine quadric cone is an integral scheme. -/
instance instIsIntegral_scheme (k : Type u) [Field k] : IsIntegral (scheme k) := sorry

/-- The affine quadric cone is a Noetherian scheme. -/
instance instIsNoetherian_scheme (k : Type u) [Field k] : IsNoetherian (scheme k) := sorry

/-- The affine quadric cone is a variety over `k`. -/
instance instVariety_over (k : Type u) [Field k] : Variety (over k) := sorry

/-- The closed immersion of the affine quadric cone into affine 4-space over `k`. -/
def ι (k : Type u) [Field k] : scheme k ⟶ AffineSpaceOverField k 4 :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (relationIdeal k))) ≫
    Spec.map (CommRingCat.ofHom
      (MvPolynomial.renameEquiv k
        (Equiv.ulift : ULift.{u} (Fin 4) ≃ Fin 4)).toRingEquiv.toRingHom) ≫
    (AffineSpace.SpecIso (ULift.{u} (Fin 4)) (CommRingCat.of.{u} k)).inv

/-- The morphism `ι` is a closed immersion. -/
instance isClosedImmersion_ι (k : Type u) [Field k] :
    IsClosedImmersion (ι k) := sorry

/-- The closed immersion `ι` presents the affine quadric cone in `AffineSpaceOverField k 4`. -/
theorem isAffineSpacePresentation_ι (k : Type u) [Field k] :
    IsAffineSpacePresentation (over k) 4 (ι k) := sorry

/-- The closed immersion `ι` commutes with the structure morphisms to `Spec k`. -/
theorem ι_comp_affineSpaceOverFieldHom (k : Type u) [Field k] :
    ι k ≫ affineSpaceOverFieldHom k 4 = toBase k := sorry

end AlgebraicGeometry.AffineQuadricCone
