module

public import Mathlib.AlgebraicGeometry.Sites.Proetale
public import Mathlib.CategoryTheory.ObjectProperty.FullSubcategory
public import Mathlib.CategoryTheory.Sites.Over
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import ReasLib.AlgebraicGeometry.Scheme.Sites.ChosenPresentation

/-!
# Pro-étale sites in a chosen big-site presentation

This module defines the chosen-slice big pro-étale site of a scheme and the
small full subcategory on weakly étale structural morphisms, with coverings
inherited from the big slice.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.ObjectProperty

universe u v

namespace AlgebraicGeometry

/-- An explicit small presentation of a big pro-étale site. -/
abbrev ChosenBigProetaleSite : Type (max (u + 1) (v + 1)) :=
  ChosenBigSite.{u, v} Scheme.proetalePrecoverage

end AlgebraicGeometry

namespace AlgebraicGeometry.ChosenBigProetaleSite

/-- The carrier of the big pro-étale site over an object in a chosen
presentation is its slice category. -/
abbrev bigSite (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :=
  Over S

/-- The big pro-étale topology over an object in a chosen presentation is the
slice topology induced by the chosen big-site topology. -/
def bigTopology (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    GrothendieckTopology (bigSite X S) :=
  (X.toGrothendieck).over S

/-- The chosen big pro-étale topology is the slice topology of the
chosen big-site topology. -/
theorem bigTopology_def (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    bigTopology X S = (X.toGrothendieck).over S := sorry

/-- The source-scheme functor from a chosen big pro-étale slice. -/
def bigToScheme (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    bigSite X S ⥤ Scheme.{u} :=
  Over.forget S ⋙ X.toScheme

/-- The object property selecting represented weakly étale structural morphisms
in a chosen big pro-étale slice. -/
def smallObjects (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    ObjectProperty (bigSite X S) :=
  fun U ↦ WeaklyEtale (X.toScheme.map U.hom)

/-- The carrier of the small pro-étale site is the full subcategory of a chosen
big slice on represented weakly étale structural morphisms. -/
abbrev smallSite (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :=
  ObjectProperty.FullSubcategory (smallObjects X S)

/-- The inclusion of the chosen small pro-étale site into its big slice. -/
def smallInclusion (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    smallSite X S ⥤ bigSite X S :=
  ObjectProperty.ι (smallObjects X S)

/-- The source-scheme functor from the chosen small pro-étale site. -/
def smallToScheme (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    smallSite X S ⥤ Scheme.{u} :=
  smallInclusion X S ⋙ bigToScheme X S

/-- The represented structural morphism of every object of the chosen small
pro-étale site is weakly étale. -/
theorem smallSite_obj_isWeaklyEtale (X : ChosenBigProetaleSite.{u, v})
    (S : X.carrier) (U : smallSite X S) :
    WeaklyEtale (X.toScheme.map U.obj.hom) := sorry

/-- The precoverage on the chosen small pro-étale site obtained by restricting
selected covering families from the chosen big slice. -/
def smallPrecoverage (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    Precoverage (smallSite X S) where
  coverings := fun U ↦ { R |
    Presieve.overEquiv U.obj (R.map (smallInclusion X S)) ∈ X.pretopology U.obj.left }

/-- A family covers in the chosen small-site precoverage exactly when its
image is a selected covering family in the chosen big slice. -/
theorem mem_smallPrecoverage_iff (X : ChosenBigProetaleSite.{u, v})
    (S : X.carrier) {U : smallSite X S} {R : Presieve U} :
    R ∈ smallPrecoverage X S U ↔
      Presieve.overEquiv U.obj (R.map (smallInclusion X S)) ∈
        X.pretopology U.obj.left := sorry

/-- The Grothendieck topology on the chosen small pro-étale carrier generated by
its inherited precoverage. -/
def smallTopology (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    GrothendieckTopology (smallSite X S) :=
  (smallPrecoverage X S).toGrothendieck

/-- The chosen small pro-étale topology is generated by its inherited
precoverage. -/
theorem smallTopology_def (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    smallTopology X S = (smallPrecoverage X S).toGrothendieck := sorry

end AlgebraicGeometry.ChosenBigProetaleSite
