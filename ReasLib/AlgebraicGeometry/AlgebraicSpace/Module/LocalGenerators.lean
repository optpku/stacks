module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Etale
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Module.SchemePullback
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Points.Comparison
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Free.Generated

/-!
# Étale local generators of modules on algebraic spaces

A module has `r` generators near a point when its pullback to an étale scheme
neighbourhood is generated by `r` sections on an open neighbourhood of a lift.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.AlgebraicSpace

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.Modules

/-- `F` is generated by `r` sections on some étale scheme neighbourhood of a
point of `|X|`. -/
def existsEtaleGeneratedBy {S : Scheme.{u}} {X : AlgebraicSpace S}
    (F : X.Modules) (x : Points X) (r : ℕ) : Prop :=
  ∃ (U : Over S) (a : ofOver U ⟶ X) (u : U.left) (V : U.left.Opens),
    Etale a ∧ u ∈ V ∧ Points.map a (ofOver.pointsEquiv U u) = x ∧
      SheafOfModules.IsGeneratedBy ((pullbackToScheme a F).over V) r

/-- Étale local generation by `r` sections is equivalent to generation on an open
neighbourhood of a lift of the point in an étale scheme chart. -/
theorem existsEtaleGeneratedBy_iff {S : Scheme.{u}} {X : AlgebraicSpace S}
    (F : X.Modules) (x : Points X) (r : ℕ) :
    existsEtaleGeneratedBy F x r ↔
      ∃ (U : Over S) (a : ofOver U ⟶ X) (u : U.left) (V : U.left.Opens),
        Etale a ∧ u ∈ V ∧ Points.map a (ofOver.pointsEquiv U u) = x ∧
          SheafOfModules.IsGeneratedBy ((pullbackToScheme a F).over V) r :=
  Iff.rfl

end AlgebraicGeometry.AlgebraicSpace.Modules
