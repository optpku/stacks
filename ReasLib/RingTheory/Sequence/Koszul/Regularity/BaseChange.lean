module

public import Mathlib.RingTheory.FinitePresentation
public import Mathlib.RingTheory.TensorProduct.Pi
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Sequence.Koszul.Homology.First.BaseChange
public import ReasLib.RingTheory.Sequence.QuasiRegular.Regularity

/-!
# Koszul regularity under tensor base change

This leaf records the quasi-regular and first-homology-regular consequences of the canonical
base-change comparison when the quotient by the finite family is flat over the base ring.

@stack 062H
@stack 0CEP
-/

@[expose] public section

noncomputable section

universe u

open Algebra.TensorProduct
open scoped TensorProduct

namespace RingTheory.Sequence

variable {A B A' : Type u} [CommRing A] [CommRing B] [CommRing A']
variable [Algebra A B] [Algebra A A'] {n : ℕ}

section Flat

variable {R S : Type u} [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S]
variable {M N : Type u} [AddCommGroup M] [Module R M]
variable [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N]

namespace IsH1RegularOn

/-- An `IsBaseChange` linear map over a flat ring map preserves `H₁`-regularity. -/
@[stacks 062H "owner-level flat base change of H1-regularity"]
theorem of_flat_of_isBaseChange {g : M →ₗ[R] N} (hg : IsBaseChange S g)
    {r : ℕ} {f : Fin r → R} (h : IsH1RegularOn M f) :
    IsH1RegularOn N (fun i ↦ algebraMap R S (f i)) := sorry

/-- Flat scalar extension preserves `H₁`-regularity. -/
@[stacks 062H "Lemma 15.30.5 (1)"]
theorem of_flat {r : ℕ} {f : Fin r → R} (h : IsH1RegularOn M f) :
    IsH1RegularOn (S ⊗[R] M) (fun i ↦ algebraMap R S (f i)) := sorry

end IsH1RegularOn

namespace IsKoszulRegularOn

/-- An `IsBaseChange` linear map over a flat ring map preserves Koszul-regularity. -/
@[stacks 062H "owner-level flat base change of Koszul-regularity"]
theorem of_flat_of_isBaseChange {g : M →ₗ[R] N} (hg : IsBaseChange S g)
    {r : ℕ} {f : Fin r → R} (h : IsKoszulRegularOn M f) :
    IsKoszulRegularOn N (fun i ↦ algebraMap R S (f i)) := sorry

/-- Flat scalar extension preserves Koszul-regularity. -/
@[stacks 062H "Lemma 15.30.5 (2)"]
theorem of_flat {r : ℕ} {f : Fin r → R} (h : IsKoszulRegularOn M f) :
    IsKoszulRegularOn (S ⊗[R] M) (fun i ↦ algebraMap R S (f i)) := sorry

end IsKoszulRegularOn

end Flat

namespace IsQuasiRegularSequence

/-- A quasi-regular finite family remains quasi-regular after
arbitrary tensor base change when its quotient is flat over the base ring. -/
@[stacks 0CEP "base change of a quasi-regular family with flat quotient"]
theorem baseChange_of_flat_quotient (f : Fin n → B)
    [Module.Flat A (B ⧸ Ideal.span (Set.range f))]
    (h : IsQuasiRegularSequence (List.ofFn f)) :
    IsQuasiRegularSequence
      (List.ofFn fun i ↦ (includeRight (f i) : A' ⊗[A] B)) := sorry

/-- A quasi-regular finite family with flat quotient becomes regular after base change and
localization at a prime containing the ideal generated by the base-changed family, provided
the ambient algebra is flat and finitely presented. -/
@[stacks 0FUD "localized regularity after base change of a quasi-regular family"]
theorem isRegular_localizationAtPrime_baseChange (f : Fin n → B)
    [Module.Flat A B] [Algebra.FinitePresentation A B]
    [Module.Flat A (B ⧸ Ideal.span (Set.range f))]
    (h : IsQuasiRegularSequence (List.ofFn f))
    (q' : PrimeSpectrum (A' ⊗[A] B))
    (hq' : Ideal.span
      (Set.range (fun i ↦ (includeRight (f i) : A' ⊗[A] B))) ≤ q'.asIdeal) :
    IsRegular (Localization.AtPrime q'.asIdeal)
      (List.ofFn fun i ↦
        algebraMap (A' ⊗[A] B) (Localization.AtPrime q'.asIdeal)
          (includeRight (f i))) := sorry

end IsQuasiRegularSequence

namespace IsH1RegularSequence

/-- An `H₁`-regular finite family remains `H₁`-regular after
arbitrary tensor base change when its quotient is flat over the base ring. -/
@[stacks 0CEP "base change of an H1-regular family with flat quotient"]
theorem baseChange_of_flat_quotient (f : Fin n → B)
    [Module.Flat A (B ⧸ Ideal.span (Set.range f))]
    (h : IsH1RegularSequence f) :
    IsH1RegularSequence
      (fun i ↦ (includeRight (f i) : A' ⊗[A] B)) := sorry

end IsH1RegularSequence

end RingTheory.Sequence
