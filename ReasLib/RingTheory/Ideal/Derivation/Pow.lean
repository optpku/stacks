module

public import Mathlib.RingTheory.Derivation.Basic
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Derivations of ideal powers

This leaf isolates the Leibniz-rule containment used when passing from an
ideal-power quotient to its preceding quotient.
-/

@[expose] public section

universe u v w

namespace Derivation

variable {R : Type u} {S : Type v} {M : Type w}
variable [CommSemiring R] [CommSemiring S] [Algebra R S]
variable [AddCommMonoid M] [Module R M] [Module S M]

/-- A relative derivation sends `I ^ (n + 1)` into the submodule generated by
`I ^ n`.  This is the ideal-power form of the Leibniz rule. -/
@[stacks 02HQ "derivations of ideal powers"]
theorem mem_smul_top_of_mem_pow_succ
    (D : Derivation R S M) (I : Ideal S) (n : ℕ) {x : S}
    (hx : x ∈ I ^ (n + 1)) :
    D x ∈ I ^ n • (⊤ : Submodule S M) := sorry

end Derivation
