module

public import ReasLib.CategoryTheory.Pretriangulated.Extension.Stage
public import ReasLib.CategoryTheory.Pretriangulated.Homological.ShiftVanishing.Interval

@[expose] public section

/-!
# Additive Extensions and Shift Vanishing

This leaf lifts a vanishing interval on a family of generators through finite
coproducts, iterated extensions, and retracts.  The primary result preserves
the translated interval exactly; endpoint multiplication is exposed only as
a coarser normalized envelope.
-/

open CategoryTheory Limits ObjectProperty Pretriangulated

universe vD vA uD uA

namespace CategoryTheory.Functor.shiftVanishingIn

variable {D : Type uD} [Category.{vD} D] [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
variable {A : Type uA} [Category.{vA} A] [Abelian A]
variable (H : D ⥤ A) [H.IsHomological] [H.ShiftSequence ℤ]

/-- Every additive extension stage generated by shifts in `[c, d]` preserves the translated
vanishing interval `[a + c, b + d]`. -/
@[stacks 0FX8]
theorem additiveExtensionStage_le (E : ObjectProperty D) (a b c d : ℤ)
    (hE : E ≤ H.shiftVanishingIn a b) (n : ℕ+) :
    additiveExtensionStage (E[c, d]) n ≤
      H.shiftVanishingIn (a + c) (b + d) := sorry

/-- When `a ≤ 0 ≤ b`, the exact stage bound may be enlarged to the endpoint-multiple
envelope `[(n : ℤ) * a + c, (n : ℤ) * b + d]`. -/
@[stacks 0FX8]
theorem additiveExtensionStage_le_of_nonpos_of_nonneg
    (E : ObjectProperty D) (a b c d : ℤ) (ha : a ≤ 0) (hb : 0 ≤ b)
    (hE : E ≤ H.shiftVanishingIn a b) (n : ℕ+) :
    additiveExtensionStage (E[c, d]) n ≤
      H.shiftVanishingIn ((n : ℤ) * a + c) ((n : ℤ) * b + d) := sorry

/-- Lemma 13.35.8 (Stacks 0FX8), in the mathematically necessary normalized form:
objects in the `n`th additive extension stage generated by shifts in `[-m, m]` vanish outside
`[(n : ℤ) * a - m, (n : ℤ) * b + m]` when `a ≤ 0 ≤ b`. -/
@[stacks 0FX8]
theorem additiveExtensionStage_symmetric_le
    (E : ObjectProperty D) (a b : ℤ) (ha : a ≤ 0) (hb : 0 ≤ b)
    (hE : E ≤ H.shiftVanishingIn a b) (m : ℕ) (n : ℕ+) :
    additiveExtensionStage (E[-(m : ℤ), m]) n ≤
      H.shiftVanishingIn ((n : ℤ) * a - m) ((n : ℤ) * b + m) := sorry

end CategoryTheory.Functor.shiftVanishingIn
