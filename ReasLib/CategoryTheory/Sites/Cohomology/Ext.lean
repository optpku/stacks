module

public import Mathlib.Algebra.Category.Grp.Adjunctions
public import Mathlib.Algebra.Homology.DerivedCategory.Ext.Basic
public import Mathlib.CategoryTheory.Sites.PreservesSheafification

/-!
# Ext cohomology of abelian sheaves

This leaf owns cohomology of an abelian sheaf against a sheaf of sets, expressed as `Ext` from
its free abelian sheaf.  It also records the corresponding positive-degree acyclicity condition.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Abelian CategoryTheory.Limits

noncomputable section

universe u v w z

namespace CategoryTheory
namespace Sheaf

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable [HasWeakSheafify J AddCommGrpCat.{w}]
variable [Abelian (Sheaf J AddCommGrpCat.{w})]

section Cohomology

variable [HasExt.{z} (Sheaf J AddCommGrpCat.{w})]

/-- Cohomology over a sheaf of sets, functorially in the abelian coefficient sheaf.  The Ext
output universe is independent of the coefficient universe. -/
noncomputable abbrev cohomologyOverSheafFunctor
    (K : Sheaf J (Type w)) (p : ℕ) :
    Sheaf J AddCommGrpCat.{w} ⥤ AddCommGrpCat.{z} :=
  Abelian.extFunctorObj ((composeAndSheafify J AddCommGrpCat.free).obj K) p

/-- The object `cohomologyOverSheaf K F p`, defined as the `p`-th `Ext` object from the free
abelian sheaf generated by the sheaf of sets `K` to the abelian sheaf `F`. -/
noncomputable abbrev cohomologyOverSheaf
    (K : Sheaf J (Type w)) (F : Sheaf J AddCommGrpCat.{w}) (p : ℕ) :
    AddCommGrpCat.{z} :=
  (cohomologyOverSheafFunctor K p).obj F

/-- The cohomology of an abelian sheaf over a presheaf of sets, obtained by first sheafifying the
presheaf and then applying `cohomologyOverSheaf`. -/
noncomputable abbrev cohomologyOverPresheaf
    [HasSheafify J (Type w)]
    (K : Cᵒᵖ ⥤ Type w) (F : Sheaf J AddCommGrpCat.{w}) (p : ℕ) :
    AddCommGrpCat.{z} :=
  cohomologyOverSheaf ((presheafToSheaf J (Type w)).obj K) F p

end Cohomology

variable [HasExt.{w} (Sheaf J AddCommGrpCat.{w})]

/-- An abelian sheaf is totally acyclic when its positive Ext cohomology over
every sheaf of sets vanishes. -/
@[stacks 072Y, mk_iff isTotallyAcyclic_iff]
class IsTotallyAcyclic (F : Sheaf J AddCommGrpCat.{w}) : Prop where
  /-- Every positive cohomology group over a sheaf of sets is zero. -/
  isZero_higherCohomologyOverSheaf (K : Sheaf J (Type w)) (n : ℕ) :
    IsZero (cohomologyOverSheaf K F (n + 1))

variable {F : Sheaf J AddCommGrpCat.{w}}

/-- An injective abelian sheaf has vanishing positive Ext cohomology over every sheaf of sets. -/
instance isTotallyAcyclic_of_injective [Injective F] : IsTotallyAcyclic F := sorry

/-- A totally acyclic sheaf has vanishing positive cohomology over any presheaf of sets after
sheafification. -/
theorem IsTotallyAcyclic.isZero_higherCohomologyOverPresheaf
    [HasSheafify J (Type w)] [hF : IsTotallyAcyclic F]
    (K : Cᵒᵖ ⥤ Type w) (n : ℕ) :
    IsZero (cohomologyOverPresheaf K F (n + 1)) := sorry

end Sheaf
end CategoryTheory
