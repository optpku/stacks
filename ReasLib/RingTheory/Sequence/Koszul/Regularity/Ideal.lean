module

public import ReasLib.RingTheory.Sequence.Koszul.Regularity
import Mathlib.Tactic.CrossRefAttribute

/-!
# Ideal identities from H₁-regular quotient generators

This leaf records ideal-theoretic consequences of finite `H₁`-regular families in quotient
rings.

@stack 0666
-/

@[expose] public section

noncomputable section

universe u

namespace Ideal

open RingTheory.Sequence

variable {A : Type u} [CommRing A]

/-- Lemma 15.30.9, tag `0666`: if `I ≤ J` and the quotient ideal
`J / I` is generated by an `H₁`-regular finite family in `A ⧸ I`, then
`I ⊓ J ^ 2 = I * J`. -/
@[stacks 0666 "square intersection for an H1-regular quotient ideal"]
theorem inf_sq_eq_mul_of_quotient_generatedByH1RegularSequence
    (I J : Ideal A) (hIJ : I ≤ J)
    (hgen : ∃ (m : ℕ) (f : Fin m → A ⧸ I),
      J.map (Ideal.Quotient.mk I) = Ideal.span (Set.range f) ∧ IsH1RegularSequence f) :
    I ⊓ J ^ 2 = I * J := sorry

end Ideal
