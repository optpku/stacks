module

public import ReasLib.CategoryTheory.Sites.Family.BaseChange
public import Mathlib.CategoryTheory.EffectiveEpi.Comp
public import Mathlib.CategoryTheory.MorphismProperty.Representable
public import Mathlib.CategoryTheory.Sites.EffectiveEpimorphic

/-!
# Effective epimorphic families

A fixed-target family is effective epimorphic when every component arrow is representable
and the family is effective epimorphic in the categorical sense.
-/

@[expose] public section

universe w v u

namespace CategoryTheory

open Limits

namespace SemiRepresentableFamily.Over

variable {C : Type u} [Category.{v} C] {U : C}

/-- A family of arrows to `U` is effective epimorphic when every component is representable
(i.e., admits pullbacks along arbitrary maps — equivalently, `(𝟭 C).relativelyRepresentable f`
means `HasPullbacksAlong f` in Mathlib) and the underlying arrows form an effective
epimorphic family. -/
class IsEffectiveEpiFamily (K : Over.{w} U) : Prop where
  /-- Every component arrow admits pullbacks along arbitrary maps. Equivalently,
  `HasPullbacksAlong (K.obj i).hom`. -/
  representable (i : K.index) : (𝟭 C).relativelyRepresentable (K.obj i).hom
  /-- The component arrows form an effective epimorphic family. -/
  effectiveEpiFamily :
    EffectiveEpiFamily (fun i : K.index ↦ (K.obj i).left) (fun i ↦ (K.obj i).hom)

/-- Characterization of effective epi families. -/
theorem isEffectiveEpiFamily_iff (K : Over.{w} U) :
    IsEffectiveEpiFamily K ↔
      (∀ i : K.index, (𝟭 C).relativelyRepresentable (K.obj i).hom) ∧
        EffectiveEpiFamily (fun i : K.index ↦ (K.obj i).left) (fun i ↦ (K.obj i).hom) := sorry

/-- The presieve generated by an effective family is effective epimorphic. -/
theorem IsEffectiveEpiFamily.presieveEffEpimorphic (K : Over.{w} U)
    [IsEffectiveEpiFamily K] :
    K.toPresieve.EffectiveEpimorphic := sorry

/-- Every component of an effective family admits pullbacks along arbitrary maps. -/
theorem IsEffectiveEpiFamily.hasPullbacksAlong
    (K : Over.{w} U) [IsEffectiveEpiFamily K] (i : K.index) :
    HasPullbacksAlong (K.obj i).hom := sorry

end SemiRepresentableFamily.Over
end CategoryTheory
