module

public import Mathlib.AlgebraicTopology.SimplicialObject.Basic
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import ReasLib.CategoryTheory.Sites.IndexedSite
public import ReasLib.Topology.Category.TopCat.DiagramOpens

/-!
# The identity-degree open-cover site of a diagram of spaces
-/

@[expose] public section

open CategoryTheory TopologicalSpace TopCat

universe u v w

namespace TopCat.DiagramOpens

variable {C : Type u} [Category.{v} C] (F : C ⥤ TopCat.{w})

/-- The identity-stage open-cover precoverage on a category of diagram opens. -/
def precoverage : Precoverage (DiagramOpens F) where
  coverings U :=
    {R | ∃ (ι : Type (max u v w)) (V : ι → Opens (F.obj U.base))
        (h : ∀ i, V i ≤ U.opens),
      iSup V = U.opens ∧
        R = Presieve.ofArrows (fun i ↦ (fiber F U.base).obj (V i))
          (fun i ↦ homOfLE (h i))}

/-- Membership in the diagram-open precoverage is given by its defining indexed family. -/
@[simp] theorem mem_precoverage_iff {U : DiagramOpens F} {R : Presieve U} :
    R ∈ precoverage F U ↔
      ∃ (ι : Type (max u v w)) (V : ι → Opens (F.obj U.base))
        (h : ∀ i, V i ≤ U.opens),
        iSup V = U.opens ∧
          R = Presieve.ofArrows (fun i ↦ (fiber F U.base).obj (V i))
            (fun i ↦ homOfLE (h i)) := Iff.rfl

/-- An indexed family covers exactly when its degree-zero presieve is selected. -/
def coverings (U : DiagramOpens F) : Set (PreZeroHypercover U) :=
  {E | E.presieve₀ ∈ precoverage F U}

/-- Indexed-family covering membership is exactly membership of its degree-zero presieve. -/
@[simp] theorem mem_coverings_iff {U : DiagramOpens F} {E : PreZeroHypercover U} :
    E ∈ coverings F U ↔ E.presieve₀ ∈ precoverage F U := Iff.rfl

/-- An identity-stage open-arrow family covers exactly when its opens cover the target. -/
theorem ofArrows_mem_precoverage_iff {U : DiagramOpens F} {ι : Type (max u v w)}
    (V : ι → Opens (F.obj U.base)) (h : ∀ i, V i ≤ U.opens) :
    Presieve.ofArrows (fun i ↦ (fiber F U.base).obj (V i)) (fun i ↦ homOfLE (h i)) ∈
        precoverage F U ↔
      iSup V = U.opens := by
  sorry

/-- The Grothendieck topology generated by the identity-stage open-cover precoverage. -/
def topology : GrothendieckTopology (DiagramOpens F) :=
  (precoverage F).toGrothendieck

/-- The diagram-open topology is generated by the diagram-open precoverage. -/
@[simp] theorem topology_def : topology F = (precoverage F).toGrothendieck := rfl

end TopCat.DiagramOpens

namespace CategoryTheory.SimplicialObject

/-- The category of opens in the stages of a simplicial space. -/
abbrev zariskiSite (X : SimplicialObject TopCat.{u}) :=
  DiagramOpens X

/-- The identity-degree open-cover precoverage of a simplicial space. -/
abbrev zariskiPrecoverage (X : SimplicialObject TopCat.{u}) :=
  DiagramOpens.precoverage X

/-- The indexed families selected by the Zariski open-cover precoverage. -/
abbrev zariskiCoverings (X : SimplicialObject TopCat.{u}) :=
  DiagramOpens.coverings X

/-- The Grothendieck topology generated by the Zariski open-cover precoverage. -/
abbrev zariskiTopology (X : SimplicialObject TopCat.{u}) :=
  DiagramOpens.topology X

/-- The Zariski topology is generated by the Zariski open-cover precoverage. -/
@[simp] theorem zariskiTopology_def (X : SimplicialObject TopCat.{u}) :
    zariskiTopology X = (zariskiPrecoverage X).toGrothendieck := rfl

/-- The Zariski open-cover families satisfy the indexed-family site axioms. -/
instance instZariskiCoveringsIsSite (X : SimplicialObject TopCat.{u}) :
    PreZeroHypercover.IsSite (zariskiCoverings X) := by
  sorry

end CategoryTheory.SimplicialObject
