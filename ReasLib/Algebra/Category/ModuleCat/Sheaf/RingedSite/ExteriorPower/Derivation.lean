module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.ExteriorPower.DegreeOne
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.ExteriorPower.DegreeZero
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.ExteriorPower.Epi
public import ReasLib.CategoryTheory.GradedObject.Monoidal.Derivation
import Mathlib.Tactic.CrossRefAttribute

/-!
# Derivations of exterior-power sheaves

Exterior powers are generated by degree one.  Consequently a categorical graded derivation is
determined by its restriction to the original module sheaf.  The notion of derivation itself stays
in the generic graded-object layer; this file owns only the exterior-algebra specialization.
-/

@[expose] public section

open CategoryTheory

noncomputable section

universe u v

namespace SheafOfModules.RingedSite.ExteriorPower

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat)]
variable [HasWeakSheafify J AddCommGrpCat.{max u v}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{max u v}]
variable (O : Sheaf J CommRingCat.{max u v})

/-- Two derivations of the exterior algebra agree when they agree on the original module sheaf. -/
@[stacks 062K "exterior derivations are determined in degree one"]
theorem derivation_ext (F : ringedSiteModuleCategory J O)
    {d e : GradedObject.Predifferential (sheaf O F)}
    (hd : GradedObject.Monoidal.IsDerivation (sheaf O F) (mul O F) d)
    (he : GradedObject.Monoidal.IsDerivation (sheaf O F) (mul O F) e)
    (h₁ : degreeOne O F ≫ d 0 = degreeOne O F ≫ e 0) : d = e := sorry

/-- Two derivations of the exterior algebra agree when their degree-one restrictions agree after
the canonical identification of degree zero with the structure module. -/
theorem derivation_ext_unit (F : ringedSiteModuleCategory J O)
    {d e : GradedObject.Predifferential (sheaf O F)}
    (hd : GradedObject.Monoidal.IsDerivation (sheaf O F) (mul O F) d)
    (he : GradedObject.Monoidal.IsDerivation (sheaf O F) (mul O F) e)
    (h₁ : degreeOne O F ≫ d 0 ≫ degreeZero O F =
      degreeOne O F ≫ e 0 ≫ degreeZero O F) : d = e := sorry

end SheafOfModules.RingedSite.ExteriorPower
