module

public import ReasLib.RingTheory.DividedPowers.Envelope.Universal
public import ReasLib.RingTheory.DividedPowers.Quotient

@[expose] public section

universe u

open DividedPowers

namespace DividedPowerEnvelope

/-- The ideal generated in the envelope carrier by positive divided powers of elements of an ideal. -/
def kernelIdeal
    {A B' : Type u} [CommRing A] [CommRing B'] [Algebra A B']
    {I : Ideal A} {γ : DividedPowers I} {J' : Ideal B'}
    (hIJ' : Ideal.map (algebraMap A B') I ≤ J')
    (E' : DividedPowerEnvelope I γ (algebraMap A B') J' hIJ')
    (K : Ideal B') : Ideal E'.D :=
  Ideal.span {x | ∃ n : ℕ, n ≠ 0 ∧ ∃ k : B', k ∈ K ∧
    x = dpow E'.D.dividedPowers n (E'.toD k)}

/-- The defining span formula for the ideal generated by positive divided powers of an ideal. -/
theorem kernelIdeal_def
    {A B' : Type u} [CommRing A] [CommRing B'] [Algebra A B']
    {I : Ideal A} {γ : DividedPowers I} {J' : Ideal B'}
    (hIJ' : Ideal.map (algebraMap A B') I ≤ J')
    (E' : DividedPowerEnvelope I γ (algebraMap A B') J' hIJ')
    (K : Ideal B') :
    kernelIdeal hIJ' E' K =
      Ideal.span {x | ∃ n : ℕ, n ≠ 0 ∧ ∃ k : B', k ∈ K ∧
        x = dpow E'.D.dividedPowers n (E'.toD k)} := sorry

/-- Positive divided powers of elements of an ideal belong to its generated kernel ideal. -/
theorem kernelIdeal_generator_mem
    {A B' : Type u} [CommRing A] [CommRing B'] [Algebra A B']
    {I : Ideal A} {γ : DividedPowers I} {J' : Ideal B'}
    (hIJ' : Ideal.map (algebraMap A B') I ≤ J')
    (E' : DividedPowerEnvelope I γ (algebraMap A B') J' hIJ')
    (K : Ideal B') {n : ℕ} (hn : n ≠ 0) {k : B'} (hk : k ∈ K) :
    dpow E'.D.dividedPowers n (E'.toD k) ∈ kernelIdeal hIJ' E' K := sorry

/-- The generated kernel ideal, intersected with the envelope ideal, is a sub-divided-power ideal. -/
theorem kernelIdeal_isSubDPIdeal
    {A B' : Type u} [CommRing A] [CommRing B'] [Algebra A B']
    {I : Ideal A} {γ : DividedPowers I} {J' : Ideal B'}
    (hIJ' : Ideal.map (algebraMap A B') I ≤ J')
    (E' : DividedPowerEnvelope I γ (algebraMap A B') J' hIJ')
    (K : Ideal B') (hKsub : K ≤ J') :
    IsSubDPIdeal E'.D.dividedPowers (kernelIdeal hIJ' E' K ⊓ E'.D.ideal) := sorry

/-- Surjective base-algebra maps identify the target divided-power envelope with the corresponding quotient of the source envelope. -/
theorem quotientOfSurjective
    {A B' B : Type u} [CommRing A] [CommRing B'] [CommRing B]
    [Algebra A B'] [Algebra A B]
    (I : Ideal A) (γ : DividedPowers I)
    (φ : B' →ₐ[A] B) (hφ : Function.Surjective φ)
    (J : Ideal B) (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (K : Ideal B') (hK : K = RingHom.ker φ.toRingHom)
    (J' : Ideal B') (hJ' : J' = Ideal.comap φ.toRingHom J)
    (hIJ' : Ideal.map (algebraMap A B') I ≤ J')
    (E' : DividedPowerEnvelope I γ (algebraMap A B') J' hIJ')
    (hE' : DividedPowerEnvelope.IsUniversal γ (algebraMap A B') hIJ' E')
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ)
    (hE : DividedPowerEnvelope.IsUniversal γ (algebraMap A B) hIJ E) :
    ∃ hsub : IsSubDPIdeal E'.D.dividedPowers
        (kernelIdeal hIJ' E' K ⊓ E'.D.ideal),
      Nonempty (E.D ≅
        DividedPowerRing.of (E'.D ⧸ kernelIdeal hIJ' E' K)
          (Ideal.map (Ideal.Quotient.mk (kernelIdeal hIJ' E' K)) E'.D.ideal)
          (DividedPowers.Quotient.dividedPowers E'.D.dividedPowers hsub)) := sorry

end DividedPowerEnvelope
