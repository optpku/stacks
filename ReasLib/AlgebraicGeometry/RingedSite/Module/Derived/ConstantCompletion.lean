module

public import Mathlib.CategoryTheory.Sites.ConstantSheaf
public import Mathlib.RingTheory.Noetherian.Defs
public import ReasLib.RingTheory.Ideal.FiniteGeneration.Family
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.ExtendedCech
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.Ideal.PowerQuotient.Module
public import ReasLib.AlgebraicGeometry.RingedSite.Module.Derived.Completion
public import ReasLib.AlgebraicGeometry.RingedSite.Module.Derived.Tensor

@[expose] public section

open CategoryTheory Opposite
open SheafOfModules.RingedSite SheafOfModules.RingedSite.ExtendedCech

noncomputable section

universe u

namespace RingedSite.Hom.ModuleDerived.ConstantCompletion

variable {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)
variable [J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})]
variable [J.HasSheafCompose (forget₂ RingCat.{u} AddCommGrpCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable [HasWeakSheafify J CommRingCat.{u}]
variable [J.WEqualsLocallyBijective CommRingCat.{u}]
variable {Λ : Type u} [CommRing Λ]

/-- The constant sheaf of commutative rings with value `Λ`. -/
abbrev constantRingSheaf (Λ : Type u) [CommRing Λ] : Sheaf J CommRingCat.{u} :=
  (constantSheaf J CommRingCat.{u}).obj (CommRingCat.of Λ)

/-- The sheafification unit of the constant ring presheaf with value `Λ`. -/
abbrev constantRingUnit (Λ : Type u) [CommRing Λ] :
    (Functor.const Cᵒᵖ).obj (CommRingCat.of Λ) ⟶ (constantRingSheaf J Λ).obj :=
  toSheafify J ((Functor.const Cᵒᵖ).obj (CommRingCat.of Λ))

/-- The constant local section determined by a ring element. -/
def constantSectionValue (a : Λ) (U : Cᵒᵖ) : (constantRingSheaf J Λ).obj.obj U :=
  ((constantRingUnit J Λ).app U).hom a

/-- The global structure-module section determined by a ring element. -/
def constantSection (a : Λ) : (unitModule J (constantRingSheaf J Λ)).sections :=
  PresheafOfModules.sectionsMk (fun U ↦ constantSectionValue J a U)
    (fun {_ V} f ↦ congrArg
      (fun morphism : CommRingCat.of Λ ⟶ (constantRingSheaf J Λ).obj.obj V ↦
        morphism.hom a)
      ((constantRingUnit J Λ).naturality f).symm)

variable [IsNoetherianRing Λ]

/-- The ideal sheaf generated by constant sections of a finite generating family of `I`. -/
def constantIdealSheaf (I : Ideal Λ) : Subobject (unitModule J (constantRingSheaf J Λ)) :=
  let generators := Ideal.FiniteGeneratingFamily.ofFG I I.fg_of_isNoetherianRing
  generatedIdeal (fun index : generators.Index ↦ constantSection J (generators.generator index))

/-- Every finite generating family of an ideal generates the same constant ideal sheaf. -/
theorem constantIdealSheaf_eq_generatedIdeal (I : Ideal Λ) (generators : I.FiniteGeneratingFamily) :
    constantIdealSheaf J I =
      generatedIdeal (fun index : generators.Index ↦
        constantSection J (generators.generator index)) := sorry

/-- The constant ideal sheaf of an ideal of a Noetherian ring is of finite type. -/
instance constantIdealSheaf_isFiniteType (I : Ideal Λ) :
    (constantIdealSheaf J I :
      ringedSiteModuleCategory J (constantRingSheaf J Λ)).IsFiniteType := sorry

section QuotientTower

variable {J} {O : Sheaf J CommRingCat.{u}}

/-- The derived tensor product of `K` with the structure-module quotient by `I ^ n`. -/
abbrev completionQuotientStage
    (I : Subobject (unitModule J O)) (K : RingedSiteDerived J O) (n : ℕ) :
    RingedSiteDerived J O :=
  (derivedTensorLeft K).obj
    ((DerivedCategory.singleFunctor (ringedSiteModuleCategory J O) (0 : ℤ)).obj
      (IdealSheaf.PowerQuotientModule.stage I (unitModule J O) n))

/-- The derived tensor transition from the quotient by `I ^ (n + 1)` to that by `I ^ n`. -/
def completionQuotientStep
    (I : Subobject (unitModule J O)) (K : RingedSiteDerived J O) (n : ℕ) :
    completionQuotientStage I K (n + 1) ⟶ completionQuotientStage I K n :=
  (derivedTensorLeft K).map
    ((DerivedCategory.singleFunctor (ringedSiteModuleCategory J O) (0 : ℤ)).map
      (IdealSheaf.PowerQuotientModule.step I (unitModule J O) n))

/-- The positive ideal-power quotient tensor tower, with stage `n` indexed by `I ^ (n + 1)`. -/
abbrev completionQuotientTower
    (I : Subobject (unitModule J O)) (K : RingedSiteDerived J O) :
    ℕᵒᵖ ⥤ RingedSiteDerived J O :=
  Functor.ofOpSequence (X := fun n ↦ completionQuotientStage I K (n + 1))
    (fun n ↦ completionQuotientStep I K (n + 1))

end QuotientTower

variable (I : Ideal Λ) (K : RingedSiteDerived J (constantRingSheaf J Λ))

/-- Derived completion with constant Noetherian coefficients is a homotopy limit of the
positive ideal-power quotient tensor tower. -/
theorem completionFunctor_isHomotopyLimit :
    HomotopyLimit.IsOf (completionQuotientTower (constantIdealSheaf J I) K)
      ((Completion.functor (constantIdealSheaf J I)).obj K).obj := sorry

/-- A derived module with constant Noetherian coefficients is complete exactly when it is
a homotopy limit of its positive ideal-power quotient tensor tower. -/
theorem isDerivedComplete_iff_isHomotopyLimit :
    IsDerivedCompleteWithRespectTo.{u, u, u, u} K (constantIdealSheaf J I) ↔
      HomotopyLimit.IsOf (completionQuotientTower (constantIdealSheaf J I) K) K := sorry

end RingedSite.Hom.ModuleDerived.ConstantCompletion
