module

public import ReasLib.Algebra.Homology.DerivedCategory.Dualizing.CanonicalExistence
public import Mathlib.RingTheory.Ideal.Height
public import Mathlib.RingTheory.AdicCompletion.Basic
public import Mathlib.Topology.Connected.Basic
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

universe u

open scoped ENat

namespace PrimeSpectrum

/-- For a Noetherian domain admitting a canonical dualizing complex and complete for
the ideal generated by a nonzero element `f`, the set `V(f) ∖ V(𝔞)` is connected
whenever `f ∈ 𝔞` and every minimal prime over `𝔞` has height greater than two. -/
theorem zeroLocus_diff_connected_of_principal
    {A : Type u} [CommRing A] [IsNoetherianRing A] [IsDomain A]
    (𝔞 : Ideal A) (f : A) (hf : f ∈ 𝔞) (hf0 : f ≠ 0)
    (h_dualizing : CategoryTheory.DerivedCategory.HasCanonicalDualizingComplex A)
    [IsAdicComplete (Ideal.span ({f} : Set A)) A]
    (h_codim : (2 : ℕ∞) < 𝔞.height) :
    _root_.IsConnected
      (PrimeSpectrum.zeroLocus (Ideal.span ({f} : Set A) : Set A) \
        PrimeSpectrum.zeroLocus (𝔞 : Set A)) := sorry

end PrimeSpectrum
