module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Internal
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Limits
public import Mathlib.CategoryTheory.Subobject.Lattice
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Grothendieck
public import ReasLib.CategoryTheory.Sites.AbelianSheaf.Grothendieck

@[expose] public section

open CategoryTheory CategoryTheory.Sheaf Opposite

noncomputable section

universe u

namespace CategoryTheory.Sheaf.AddCommGrpSubobject

variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
variable {I : Type u}

/-- An additive-sheaf subobject contains specified local sections when each section lifts
through its inclusion. -/
def ContainsSections {F : Sheaf J AddCommGrpCat.{u}}
    (G : Subobject F) (U : I → C) (s : ∀ a, F.1.obj (op (U a))) : Prop :=
  ∀ a, ∃ x : (G : Sheaf J AddCommGrpCat.{u}).1.obj (op (U a)),
    (G.arrow.hom.app (op (U a))).hom x = s a

/-- Containment of specified additive local sections is exactly the lifting condition through
the subobject inclusion. -/
theorem containsSections_iff {F : Sheaf J AddCommGrpCat.{u}}
    (G : Subobject F) (U : I → C) (s : ∀ a, F.1.obj (op (U a))) :
    ContainsSections G U s ↔
      ∀ a, ∃ x : (G : Sheaf J AddCommGrpCat.{u}).1.obj (op (U a)),
        (G.arrow.hom.app (op (U a))).hom x = s a := sorry

/-- The additive subsheaf generated by a family of local sections. -/
noncomputable def generatedBySections
    (F : Sheaf J AddCommGrpCat.{u}) (U : I → C)
    (s : ∀ a, F.1.obj (op (U a))) : Subobject F :=
  Subobject.sInf {G | ContainsSections G U s}

/-- The generated additive subsheaf is the least subsheaf containing all specified sections. -/
theorem generatedBySections_isLeast
    (F : Sheaf J AddCommGrpCat.{u}) (U : I → C)
    (s : ∀ a, F.1.obj (op (U a))) :
    IsLeast {G : Subobject F | ContainsSections G U s}
      (generatedBySections F U s) := sorry

/-- The generated additive subsheaf contains every prescribed local section. -/
theorem generatedBySections_contains
    (F : Sheaf J AddCommGrpCat.{u}) (U : I → C)
    (s : ∀ a, F.1.obj (op (U a))) :
    ContainsSections (generatedBySections F U s) U s := sorry

/-- The generated additive subsheaf lies below every subsheaf containing the prescribed
local sections. -/
theorem generatedBySections_le
    (F : Sheaf J AddCommGrpCat.{u}) (U : I → C)
    (s : ∀ a, F.1.obj (op (U a))) {G : Subobject F}
    (hG : ContainsSections G U s) :
    generatedBySections F U s ≤ G := sorry

/-- The generated additive subsheaf lies below `G` exactly when `G` contains every
prescribed local section. -/
theorem generatedBySections_le_iff
    (F : Sheaf J AddCommGrpCat.{u}) (U : I → C)
    (s : ∀ a, F.1.obj (op (U a))) {G : Subobject F} :
    generatedBySections F U s ≤ G ↔ ContainsSections G U s := sorry

end CategoryTheory.Sheaf.AddCommGrpSubobject
