module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.FiniteLocallyFree.Rank
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.LocalGeneration
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Blowup.RelativeProj
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.StrictTransform
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Module.FittingIdeal
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Module.LocalGenerators

/-!
# Local generation and rank of strict transforms under Fitting-ideal blowups

Blowing up the `k`th Fitting ideal of a finite-type quasi-coherent module on an
algebraic space makes its strict transform étale-locally generated by `k` sections.
If the module is locally free of rank `k` off the Fitting center, its strict
transform is locally free of rank `k`.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.AlgebraicSpace

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.fittingIdealSheaf

/-- The strict transform of a finite-type quasi-coherent module under a blowup
in its `k`th Fitting ideal is étale-locally generated by `k` sections. -/
@[stacks 0D0P, instance]
instance strictTransformModule_isLocallyGeneratedBy
    {S : Scheme.{u}} {B : AlgebraicSpace S} (F : B.Modules)
    [F.IsFiniteType] [F.IsQuasicoherent] (k : ℕ)
    (π : Blowup B (fittingIdealSheaf F k)) :
    SheafOfModules.IsLocallyGeneratedBy
      (strictTransformModule π.hom (Blowup.exceptionalDivisor π) (𝟙 B) F) k :=
  sorry

/-- The Fitting-blowup strict transform of `F` is generated by `k` sections on an
étale scheme neighbourhood of every point of the fibre-product ambient space. -/
theorem strictTransformModule_existsEtaleGeneratedBy
    {S : Scheme.{u}} {B : AlgebraicSpace S} (F : B.Modules)
    [F.IsFiniteType] [F.IsQuasicoherent] (k : ℕ)
    (π : Blowup B (fittingIdealSheaf F k))
    (x : Points (strictTransformAmbient π.hom (𝟙 B))) :
    Modules.existsEtaleGeneratedBy
      (strictTransformModule π.hom (Blowup.exceptionalDivisor π) (𝟙 B) F) x k :=
  sorry

/-- The strict transform of a finite-type quasi-coherent module under a blowup
in its `k`th Fitting ideal is locally free of rank `k` if the module is locally
free of rank `k` outside the closed subspace cut out by that ideal. -/
@[stacks 0D0Q, instance]
instance strictTransformModule_isFiniteLocallyFreeOfRank
    {S : Scheme.{u}} {B : AlgebraicSpace S} (F : B.Modules)
    [F.IsFiniteType] [F.IsQuasicoherent] (k : ℕ)
    (π : Blowup B (fittingIdealSheaf F k))
    [SheafOfModules.IsFiniteLocallyFreeOfRank k
      ((Modules.pullback (closedImmersionComplementι
          (subschemeι (fittingIdealSheaf F k)))).obj F)] :
    SheafOfModules.IsFiniteLocallyFreeOfRank k
      (strictTransformModule π.hom (Blowup.exceptionalDivisor π) (𝟙 B) F) :=
  sorry

end AlgebraicGeometry.AlgebraicSpace.fittingIdealSheaf
