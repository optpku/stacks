module

public import Mathlib.LinearAlgebra.Matrix.MvPolynomial
public import Mathlib.RingTheory.Spectrum.Prime.Topology

/-!
Coordinate ideals and irreducible components for products of generic `2 × 2` matrices.
-/

@[expose] public section

open Matrix MvPolynomial PrimeSpectrum

universe u

noncomputable section

namespace MvPolynomial.MatrixProduct

section

variable (k : Type u) [CommRing k]

/-- The generic `2 × 2` matrix whose entries use the coordinate block indexed by `s`. -/
def polynomialMatrix (s : Fin 2) :
    Matrix (Fin 2) (Fin 2) (MvPolynomial (Fin 2 × Fin 2 × Fin 2) k) :=
  (mvPolynomialX (Fin 2) (Fin 2) k).map (rename fun ij ↦ (s, ij.1, ij.2))

/-- The ideal generated by the entries of the product of the two generic matrices. -/
def coordinateRingIdeal :
    Ideal (MvPolynomial (Fin 2 × Fin 2 × Fin 2) k) :=
  Ideal.span <| Set.range fun ij : Fin 2 × Fin 2 ↦
    (polynomialMatrix k 0 * polynomialMatrix k 1) ij.1 ij.2

/-- The ideal generated by the entries of the second generic matrix. -/
def ambientYIdeal : Ideal (MvPolynomial (Fin 2 × Fin 2 × Fin 2) k) :=
  Ideal.span <| Set.range fun ij : Fin 2 × Fin 2 ↦
    (polynomialMatrix k 1) ij.1 ij.2

/-- The ideal generated by the entries of the first generic matrix. -/
def ambientXIdeal : Ideal (MvPolynomial (Fin 2 × Fin 2 × Fin 2) k) :=
  Ideal.span <| Set.range fun ij : Fin 2 × Fin 2 ↦
    (polynomialMatrix k 0) ij.1 ij.2

/-- The ideal generated by the product relations and the determinants of both generic matrices. -/
def ambientDeterminantIdeal :
    Ideal (MvPolynomial (Fin 2 × Fin 2 × Fin 2) k) :=
  coordinateRingIdeal k ⊔
    Ideal.span (Set.range fun s : Fin 2 ↦ (polynomialMatrix k s).det)

/-- The product-relation ideal is contained in the determinant-component ideal. -/
theorem coordinateRingIdeal_le_ambientDeterminantIdeal :
    coordinateRingIdeal k ≤ ambientDeterminantIdeal k := sorry

/-- Each determinant of a generic matrix belongs to the determinant-component ideal. -/
theorem polynomialMatrix_det_mem_ambientDeterminantIdeal (s : Fin 2) :
    (polynomialMatrix k s).det ∈ ambientDeterminantIdeal k := sorry

end

section

variable (k : Type u) [Field k]

/-- The product-relation zero locus is the union of the three matrix-product components. -/
theorem zeroLocus_eq_union :
    (zeroLocus (coordinateRingIdeal k) :
        Set (PrimeSpectrum (MvPolynomial (Fin 2 × Fin 2 × Fin 2) k))) =
      zeroLocus (ambientYIdeal k) ∪
        zeroLocus (ambientDeterminantIdeal k) ∪
        zeroLocus (ambientXIdeal k) := sorry

/-- The irreducible components of the product-relation zero locus are the three matrix-product loci. -/
theorem zeroLocus_irreducibleComponents :
    {Z : Set (PrimeSpectrum (MvPolynomial (Fin 2 × Fin 2 × Fin 2) k)) |
        Maximal (fun W ↦ W ⊆ zeroLocus (coordinateRingIdeal k) ∧
          IsClosed W ∧ IsIrreducible W) Z} =
      {zeroLocus (ambientYIdeal k),
        zeroLocus (ambientDeterminantIdeal k),
        zeroLocus (ambientXIdeal k)} := sorry

end

end MvPolynomial.MatrixProduct
