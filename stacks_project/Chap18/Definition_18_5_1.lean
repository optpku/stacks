module

public import ReasLib.CategoryTheory.Sites.Sheafification.FreeAbelian
import StacksCheckRecall

@[expose] public section

open CategoryTheory

noncomputable section

universe u v

namespace CategoryTheory

variable {C : Type u} [Category.{v} C]
variable (J : GrothendieckTopology C)
variable [HasWeakSheafify J AddCommGrpCat.{max u v}]
variable (G : Cᵒᵖ ⥤ Type (max u v))

/- Definition 18.5.1 (03AA), functor form: freely abelianize a presheaf and sheafify. -/
@[stacks 03AA "functor"]
#check (J.freeAbelianSheafFunctor :
  (Cᵒᵖ ⥤ Type (max u v)) ⥤ Sheaf J AddCommGrpCat.{max u v})

/- Definition 18.5.1 (03AA): the free abelian sheaf generated by G. -/
@[stacks 03AA "object"]
#check (J.freeAbelianSheaf G : Sheaf J AddCommGrpCat.{max u v})

end CategoryTheory
