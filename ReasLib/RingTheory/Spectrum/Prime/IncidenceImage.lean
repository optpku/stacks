module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Data.Fin.VecNotation
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Nullstellensatz
public import Mathlib.RingTheory.Spectrum.Prime.RingHom
public import Mathlib.RingTheory.Spectrum.Prime.Topology

@[expose] public section

noncomputable section

open MvPolynomial PrimeSpectrum

universe u

namespace AxBy

/-- The defining polynomial `ax - by - 1` in four variables. -/
def axBySubOne (k : Type u) [CommRing k] : MvPolynomial (Fin 4) k :=
  X 0 * X 2 - X 1 * X 3 - 1

/-- The principal ideal generated by `ax - by - 1`. -/
def axByIdeal (k : Type u) [CommRing k] : Ideal (MvPolynomial (Fin 4) k) :=
  Ideal.span {axBySubOne k}

/-- The coordinate ring `k[x, y, a, b] / (ax - by - 1)`. -/
abbrev AxByCoordinateRing (k : Type u) [CommRing k] : Type u :=
  MvPolynomial (Fin 4) k ⧸ axByIdeal k

/-- The class of the `i`-th coordinate in the incidence coordinate ring. -/
def axByCoord (k : Type u) [CommRing k] (i : Fin 4) : AxByCoordinateRing k :=
  Ideal.Quotient.mk (axByIdeal k) (X i)

/-- The projection to `k[x, y]` sends `x` and `y` to their quotient classes. -/
def axByHom (k : Type u) [CommRing k] :
    MvPolynomial (Fin 2) k →ₐ[k] AxByCoordinateRing k :=
  aeval ![axByCoord k 0, axByCoord k 1]

end AxBy

/-- The image of the incidence projection is `D(x) ∪ D(y)` on prime spectra. -/
theorem axByHom_comap_range (k : Type u) [Field k] [IsAlgClosed k] :
    Set.range (comap (AxBy.axByHom k).toRingHom) =
      (basicOpen (X 0 : MvPolynomial (Fin 2) k) :
          Set (PrimeSpectrum (MvPolynomial (Fin 2) k))) ∪
        (basicOpen (X 1 : MvPolynomial (Fin 2) k) :
          Set (PrimeSpectrum (MvPolynomial (Fin 2) k))) := sorry
