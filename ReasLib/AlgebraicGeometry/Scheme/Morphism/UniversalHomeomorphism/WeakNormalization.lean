module

public import Mathlib.AlgebraicGeometry.Morphisms.UnderlyingMap
public import ReasLib.AlgebraicGeometry.Scheme.Morphism.UniversalHomeomorphism

/-!
# Weak normalization of affine schemes

This module records the existence of a largest intermediate subalgebra whose spectrum is
universally homeomorphic to the base of a dominant affine morphism, together with its compatibility
with localization.
-/

@[expose] public section

universe u

namespace AlgebraicGeometry.UniversalHomeomorphism

variable {A B Aₛ Bₛ : Type u} [CommRing A] [CommRing B] [CommRing Aₛ] [CommRing Bₛ]
variable [Algebra A B]

/-- A dominant affine spectrum map admits an intermediate subalgebra whose spectrum is
universally homeomorphic to the base and which contains the image of every such intermediate
algebra. -/
theorem exists_maximalSubalgebra_of_isDominantSpecMap
    (hAB : IsDominant (Spec.map (CommRingCat.ofHom (algebraMap A B)))) :
    ∃ B' : Subalgebra A B,
      AlgebraicGeometry.UniversalHomeomorphism
        (Spec.map (CommRingCat.ofHom (algebraMap A B'))) ∧
        ∀ {C : Type u} [CommRing C] [Algebra A C] [Algebra C B] [IsScalarTower A C B],
          AlgebraicGeometry.UniversalHomeomorphism
              (Spec.map (CommRingCat.ofHom (algebraMap A C))) →
            ∀ c : C, algebraMap C B c ∈ B' := sorry

variable {S : Submonoid A} [Algebra A Aₛ] [IsLocalization S Aₛ]
variable [Algebra B Bₛ] [IsLocalization (Algebra.algebraMapSubmonoid B S) Bₛ]
variable [Algebra Aₛ Bₛ]
variable [Algebra A Bₛ] [IsScalarTower A B Bₛ] [IsScalarTower A Aₛ Bₛ]

/-- Weak normalization subalgebras of a dominant affine ring map commute with localization: the
localized subalgebra is generated by the image of the original subalgebra. -/
theorem weakNormalizationSubalgebra_localization_eq
    (hAB : IsDominant (Spec.map (CommRingCat.ofHom (algebraMap A B))))
    (B' : Subalgebra A B)
    (hBprimeUniversalHomeomorphism :
      AlgebraicGeometry.UniversalHomeomorphism
        (Spec.map (CommRingCat.ofHom (algebraMap A B'))))
    (hBprimeMaximal :
      ∀ {C : Type u} [CommRing C] [Algebra A C] [Algebra C B] [IsScalarTower A C B],
        AlgebraicGeometry.UniversalHomeomorphism
            (Spec.map (CommRingCat.ofHom (algebraMap A C))) →
          ∀ c : C, algebraMap C B c ∈ B')
    (Bₛ' : Subalgebra Aₛ Bₛ)
    (hBsPrimeUniversalHomeomorphism :
      AlgebraicGeometry.UniversalHomeomorphism
        (Spec.map (CommRingCat.ofHom (algebraMap Aₛ Bₛ'))))
    (hBsPrimeMaximal :
      ∀ {C : Type u} [CommRing C] [Algebra Aₛ C] [Algebra C Bₛ] [IsScalarTower Aₛ C Bₛ],
        AlgebraicGeometry.UniversalHomeomorphism
            (Spec.map (CommRingCat.ofHom (algebraMap Aₛ C))) →
          ∀ c : C, algebraMap C Bₛ c ∈ Bₛ') :
    Algebra.adjoin Aₛ ((algebraMap B Bₛ) '' (B' : Set B)) = Bₛ' := sorry

end AlgebraicGeometry.UniversalHomeomorphism
