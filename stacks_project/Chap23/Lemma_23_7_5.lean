module

import StacksCheckRecall
public import ReasLib.RingTheory.Ideal.Regularity.TorDimension

@[expose] public section

universe u

variable {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
variable {I J : Ideal A}

/- Lemma 23.7.5 (1), tag `09PW`: finite Tor dimension of `A / J`
over `A / I` transfers regular-sequence generation from `J` to `I`. -/
@[stacks 09PW "(1)"]
#check (Ideal.IsGeneratedByRegularSequence.FiniteTorDimension.of_quotient :
  J ≠ ⊤ → ∀ (hIJ : I ≤ J),
    (Ideal.Quotient.factor hIJ).HasFiniteTorDimension →
      J.IsGeneratedByRegularSequence → I.IsGeneratedByRegularSequence)

/- Lemma 23.7.5 (2), tag `09PW`: under the same hypotheses, the image
of `J` in `A / I` is generated by a regular sequence. -/
@[stacks 09PW "(2)"]
#check (Ideal.IsGeneratedByRegularSequence.FiniteTorDimension.quotient :
  J ≠ ⊤ → ∀ (hIJ : I ≤ J),
    (Ideal.Quotient.factor hIJ).HasFiniteTorDimension →
      J.IsGeneratedByRegularSequence →
        (Ideal.map (Ideal.Quotient.mk I) J).IsGeneratedByRegularSequence)
