module

import StacksCheckRecall
import ReasLib.AlgebraicGeometry.Scheme.Module.Derived.FittingIdeal

open AlgebraicGeometry CategoryTheory

noncomputable section

universe u

/- Lemma 38.40.1: for a pseudo-coherent derived module `E`, the ideal sheaf
`fittingIdealSheaf E p k` is of finite type and, on every affine open with a finite-free
presentation `P`, is generated by the minors of its coordinate matrix `P.matrix p` for the
degree-`p` differential, of size `Int.toNat (-k + P.alternatingTailRank p)`. -/
@[stacks 0ESP] #check
  (AlgebraicGeometry.Scheme.ModuleDerived.fittingIdealSheaf_spec :
    ∀ {X : Scheme.{u}}
      (E : RingedSpace.ModuleDerived X.toRingedSpace)
      (hE : RingedSpace.ModuleDerived.IsPseudoCoherent E) (p k : ℤ),
      (AlgebraicGeometry.Scheme.ModuleDerived.fittingIdealSheaf E p k).IsFiniteType ∧
        ∀ (U : X.affineOpens)
          (P : DerivedCategory.FittingPresentation
            ((RingedSpace.moduleDerivedSectionsAtOpen X.toRingedSpace U).obj E)),
          (AlgebraicGeometry.Scheme.ModuleDerived.fittingIdealSheaf E p k).ideal U =
            Matrix.minorIdeal (Int.toNat (-k + P.alternatingTailRank p)) (P.matrix p))
