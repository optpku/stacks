module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.ClassGroup
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.HenselianLocalRing
import StacksCheckRecall

/-!
# Example 72.6.11

The quotient of the coordinate axes by the diagonal and punctured axis-swap graph is an
integral Noetherian algebraic space. The descended sum map is a universal homeomorphism,
is an isomorphism off the origin, and identifies its divisor class group with `ℤ/2ℤ`.
The origin class generates this group, while the henselian local ring there is not a domain.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Limits Opposite
open AlgebraicGeometry.Scheme
open AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient
open AlgebraicGeometry.AlgebraicSpace.Sheaf (isUniversalHomeomorphism)

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient

/- Example 72.6.11: the class group is `ℤ/2ℤ`, generated by the origin class. -/
@[stacks 0ENU]
#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.classGroupEquivZMod :
    ∀ (k : Type u) [Field k],
    classGroup k ≃+ ZMod 2)

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.instIsEtaleEquivalenceRelation_preRelation :
    ∀ (k : Type u) [Field k],
    (preRelation k).IsEtaleEquivalenceRelation)

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.sheafOfPoints_spec :
    ∀ (k : Type u) [Field k],
    (MorphismProperty.over (@Etale)).relative uliftYoneda.{u + 1} (atlas k).hom ∧
      Presheaf.IsLocallySurjective (Scheme.etaleTopology.over (base k)) (atlas k).hom ∧
        uliftYoneda.{u + 1}.relativelyRepresentable (diag (sheafOfPoints k).obj))

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.sumOver_equalizes :
    ∀ (k : Type u) [Field k],
    (preRelation k).t ≫ sumOver k = (preRelation k).s ≫ sumOver k)

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.toAffineLine :
    ∀ (k : Type u) [Field k],
    sheafOfPoints k ⟶
      (Scheme.fppfTopology.over (base k)).uliftYoneda.{u + 1}.obj (affineLine k))

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.toAffineLine_comp_atlas :
    ∀ (k : Type u) [Field k],
    atlas k ≫ toAffineLine k =
      (Scheme.fppfTopology.over (base k)).uliftYoneda.{u + 1}.map (sumOver k))

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.universalHomeomorphism_toAffineLine :
    ∀ (k : Type u) [Field k],
    isUniversalHomeomorphism (toAffineLine k))

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.isIso_over_punctured :
    ∀ (k : Type u) [Field k],
    IsIso
      (pullback.snd (toAffineLine k)
        ((Scheme.fppfTopology.over (base k)).uliftYoneda.{u + 1}.map
          (puncturedAffineLineι k))))

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.isIntegral :
    ∀ (k : Type u) [Field k],
    AlgebraicGeometry.IsReduced (cover k).left ∧
      Sheaf.isUniversalHomeomorphism (toAffineLine k) ∧
      AlgebraicGeometry.IsIntegral (affineLine k).left ∧
      (MorphismProperty.over (@QuasiCompact)).relative uliftYoneda.{u + 1}
        (diag (sheafOfPoints k).obj))

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.isNoetherian :
    ∀ (k : Type u) [Field k],
    AlgebraicGeometry.IsNoetherian (cover k).left ∧
      (MorphismProperty.over (@QuasiCompact)).relative uliftYoneda.{u + 1}
        (diag (sheafOfPoints k).obj))

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.unique_point_over_origin :
    ∀ (k : Type u) [Field k]
    (K : Type u) [Field K] (σ : Spec (CommRingCat.of K) ⟶ base k),
    Nonempty
        ((pullback (toAffineLine k)
            ((Scheme.fppfTopology.over (base k)).uliftYoneda.{u + 1}.map
              (affineLineOriginToAffineLine k))).obj.obj
          (op (Over.mk σ))) ∧
      Subsingleton
        ((pullback (toAffineLine k)
            ((Scheme.fppfTopology.over (base k)).uliftYoneda.{u + 1}.map
              (affineLineOriginToAffineLine k))).obj.obj
          (op (Over.mk σ))))

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.classGroupEquivZMod_origin :
    ∀ (k : Type u) [Field k],
    classGroupEquivZMod k (classGroupMk k (originWeilDivisor k)) = 1)

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.primeDivisor_exists_above :
    ∀ (k : Type u) [Field k]
    (W : AlgebraicGeometry.PrimeDivisor (affineLine k).left),
    ∃ u : (cover k).left, (sumOver k).left u = W.genericPoint)

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.principalWeilDivisor_atlas_coeff :
    ∀ (k : Type u) [Field k]
    (f : (affineLine k).left.functionFieldˣ)
    (p q : Γ((affineLine k).left, ⊤)),
    (affineLine k).left.germToFunctionField ⊤ p ≠ 0 →
    (affineLine k).left.germToFunctionField ⊤ q ≠ 0 →
    (f : (affineLine k).left.functionField) =
      (affineLine k).left.germToFunctionField ⊤ p /
        (affineLine k).left.germToFunctionField ⊤ q →
    ∀ (u : (cover k).left) (W : AlgebraicGeometry.PrimeDivisor (affineLine k).left),
    (sumOver k).left u = W.genericPoint →
    (principalWeilDivisor k f).coeff W =
      ((Ring.ord ((cover k).left.presheaf.stalk u)
        ((cover k).left.presheaf.germ ⊤ u (Set.mem_univ u)
          ((sumOver k).left.appTop p))).toNat : ℤ) -
      ((Ring.ord ((cover k).left.presheaf.stalk u)
        ((cover k).left.presheaf.germ ⊤ u (Set.mem_univ u)
          ((sumOver k).left.appTop q))).toNat : ℤ))

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.principalDivisors_atlas_iff :
    ∀ (k : Type u) [Field k]
    (D : AlgebraicGeometry.WeilDivisor (affineLine k).left),
    D ∈ principalDivisors k ↔
      ∃ (f : (affineLine k).left.functionFieldˣ) (p q : Γ((affineLine k).left, ⊤)),
        (affineLine k).left.germToFunctionField ⊤ p ≠ 0 ∧
        (affineLine k).left.germToFunctionField ⊤ q ≠ 0 ∧
        (f : (affineLine k).left.functionField) =
          (affineLine k).left.germToFunctionField ⊤ p /
            (affineLine k).left.germToFunctionField ⊤ q ∧
        ∀ (u : (cover k).left) (W : AlgebraicGeometry.PrimeDivisor (affineLine k).left),
          (sumOver k).left u = W.genericPoint →
            D.coeff W =
              ((Ring.ord ((cover k).left.presheaf.stalk u)
                ((cover k).left.presheaf.germ ⊤ u (Set.mem_univ u)
                  ((sumOver k).left.appTop p))).toNat : ℤ) -
              ((Ring.ord ((cover k).left.presheaf.stalk u)
                ((cover k).left.presheaf.germ ⊤ u (Set.mem_univ u)
                  ((sumOver k).left.appTop q))).toNat : ℤ))

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.principalWeilDivisor_coordinate :
    ∀ (k : Type u) [Field k],
    principalWeilDivisor k (coordinate k) = 2 • originWeilDivisor k)

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.instIsHenselianLocalRingAtOrigin_of_isHenselizationOf :
    ∀ (k : Type u) [Field k]
    (Ah : Type u) [CommRing Ah] [Algebra (originStalk k) Ah]
    [IsHenselizationOf (originStalk k) Ah],
    IsHenselianLocalRingAtOrigin k Ah)

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.IsHenselianLocalRingAtOrigin.spec :
    ∀ (k : Type u) [Field k]
    (Ah : Type u) [CommRing Ah] [IsHenselianLocalRingAtOrigin k Ah],
    ∃ ι : ∀ U : ElementaryEtaleNeighborhoodAtOrigin k, Γ(U.obj.left, ⊤) →+* Ah,
      ElementaryEtaleNeighborhoodAtOrigin.IsCompatible ι ∧
        ∀ (Bh : Type u) [CommRing Bh]
          (τ : ∀ U : ElementaryEtaleNeighborhoodAtOrigin k, Γ(U.obj.left, ⊤) →+* Bh),
          ElementaryEtaleNeighborhoodAtOrigin.IsCompatible τ →
            ∃! Φ : Ah →+* Bh, ∀ U, Φ.comp (ι U) = τ U)

#check (AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient.not_isDomain_of_isHenselizationOf_originStalk :
    ∀ (k : Type u) [Field k]
    (Ah : Type u) [CommRing Ah] [Algebra (originStalk k) Ah]
    [IsHenselizationOf (originStalk k) Ah],
    ¬ IsDomain Ah)

end AlgebraicGeometry.AlgebraicSpace.CoordinateAxesQuotient
