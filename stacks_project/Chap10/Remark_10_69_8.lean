module

public import ReasLib.RingTheory.Ideal.AssociatedGraded.Basic
public import ReasLib.RingTheory.Sequence.QuasiRegular.Basic
public import Mathlib.RingTheory.TensorProduct.MvPolynomial

/-!
# Remark 10.69.8

@stack 065M

The chapter entry keeps the explicit quotient-ring counterexample and states its three
mathematical properties. The associated-graded comparison map itself is owned by
`RingTheory.Sequence.QuasiRegular.comparisonMap`.
-/

@[expose] public section

open MvPolynomial
open RingTheory.Sequence
open scoped nonZeroDivisors

universe u

noncomputable section

/-- Variables for the quasi-regular counterexample ring. -/
inductive QuasiRegularCounterexampleVar
  | x | y | w | z (n : ℕ)
  deriving DecidableEq

open QuasiRegularCounterexampleVar

section Data

variable (k : Type u) [CommRing k]

/-- The ambient polynomial ring for the quasi-regular counterexample. -/
abbrev quasiRegularCounterexamplePolynomialRing :=
  MvPolynomial QuasiRegularCounterexampleVar k

/-- The exceptional relation `y ^ 2 * z 0 - w * x`. -/
def quasiRegularCounterexampleInitialRelation : quasiRegularCounterexamplePolynomialRing k :=
  X y ^ 2 * X (z 0) - X w * X x

/-- The recursive relation `z n - y * z (n + 1)`. -/
def quasiRegularCounterexampleRecurrenceRelation (n : ℕ) :
    quasiRegularCounterexamplePolynomialRing k :=
  X (z n) - X y * X (z (n + 1))

/-- The defining relations for the counterexample ring. -/
def quasiRegularCounterexampleRelations : Set (quasiRegularCounterexamplePolynomialRing k) :=
  {quasiRegularCounterexampleInitialRelation k} ∪
    Set.range (quasiRegularCounterexampleRecurrenceRelation k)

/-- The ideal generated by the defining relations. -/
def quasiRegularCounterexampleIdeal : Ideal (quasiRegularCounterexamplePolynomialRing k) :=
  Ideal.span (quasiRegularCounterexampleRelations k)

/-- The quotient ring used in Remark 10.69.8. -/
abbrev quasiRegularCounterexampleRing :=
  quasiRegularCounterexamplePolynomialRing k ⧸ quasiRegularCounterexampleIdeal k

/-- The image of `x` in the counterexample ring. -/
abbrev quasiRegularCounterexampleX : quasiRegularCounterexampleRing k :=
  Ideal.Quotient.mk (quasiRegularCounterexampleIdeal k)
    (X x : quasiRegularCounterexamplePolynomialRing k)

/-- The image of `y` in the counterexample ring. -/
abbrev quasiRegularCounterexampleY : quasiRegularCounterexampleRing k :=
  Ideal.Quotient.mk (quasiRegularCounterexampleIdeal k)
    (X y : quasiRegularCounterexamplePolynomialRing k)

/-- The image of `w` in the counterexample ring. -/
abbrev quasiRegularCounterexampleW : quasiRegularCounterexampleRing k :=
  Ideal.Quotient.mk (quasiRegularCounterexampleIdeal k)
    (X w : quasiRegularCounterexamplePolynomialRing k)

/-- The image of `z n` in the counterexample ring. -/
abbrev quasiRegularCounterexampleZ (n : ℕ) : quasiRegularCounterexampleRing k :=
  Ideal.Quotient.mk (quasiRegularCounterexampleIdeal k)
    (X (z n) : quasiRegularCounterexamplePolynomialRing k)

/-- The principal ideal generated by the image of `x`. -/
def quasiRegularCounterexampleXIdeal : Ideal (quasiRegularCounterexampleRing k) :=
  Ideal.span ({quasiRegularCounterexampleX k} : Set (quasiRegularCounterexampleRing k))

/-- The image of `y` after quotienting the counterexample ring by `(x)`. -/
abbrev quasiRegularCounterexampleYModX :
    quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k :=
  Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal k) (quasiRegularCounterexampleY k)

end Data

section Counterexample

variable (k : Type u) [Field k]

local instance quasiRegularCounterexampleRingSelfModule :
    Module (quasiRegularCounterexampleRing k) (quasiRegularCounterexampleRing k) :=
  Semiring.toModule

local instance quasiRegularCounterexampleXQuotientSelfModule :
    Module (quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k)
      (quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k) :=
  Semiring.toModule

/-- In the counterexample ring, the distinguished element `x` is a nonzerodivisor. -/
theorem quasiRegularCounterexample_x_mem_nonZeroDivisors :
    quasiRegularCounterexampleX k ∈ nonZeroDivisors (quasiRegularCounterexampleRing k) := sorry

/-- In the quotient by `(x)`, the image of `y` is a quasi-regular singleton sequence. -/
theorem quasiRegularCounterexample_y_mod_x_isQuasiRegular :
    IsQuasiRegularSequence [quasiRegularCounterexampleYModX k] := sorry

/-- The pair formed by the images of `x` and `y` is not quasi-regular. -/
theorem quasiRegularCounterexample_pair_not_isQuasiRegular :
    ¬ IsQuasiRegularSequence
      [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] := sorry

/-- Chap10 Remark 10 69 8: in the counterexample ring, having `x` as a nonzerodivisor and having
the image of `y` in `A/(x)` quasi-regular does not force the pair `(x, y)` to be
quasi-regular. -/
@[stacks 065M]
theorem quasiRegularCounterexample_shows_quasiRegular_append_criterion_fails :
    ¬ (quasiRegularCounterexampleX k ∈ nonZeroDivisors (quasiRegularCounterexampleRing k) →
        IsQuasiRegularSequence [quasiRegularCounterexampleYModX k] →
        IsQuasiRegularSequence
          [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) := sorry

#check @RingTheory.Sequence.QuasiRegular.comparisonMap
#check @RingTheory.Sequence.isQuasiRegular_iff_injective
#check @quasiRegularCounterexample_shows_quasiRegular_append_criterion_fails

end Counterexample
