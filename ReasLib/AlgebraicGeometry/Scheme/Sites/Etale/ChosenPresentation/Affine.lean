module

public import ReasLib.AlgebraicGeometry.Scheme.Sites.Etale.ChosenPresentation

/-!
# Affine étale sites in a chosen presentation

This module defines the affine full subcategories of chosen big and small
étale sites and the topologies generated by finite standard étale covers
which are covering in the corresponding ambient site.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.ObjectProperty

universe u v

namespace AlgebraicGeometry.ChosenBigEtaleSite

/-- The object property selecting affine represented source schemes in a
chosen big étale slice. -/
def bigAffineObjects (X : ChosenBigEtaleSite.{u, v}) (S : X.carrier) :
    ObjectProperty (bigSite X S) :=
  fun U ↦ IsAffine (X.toScheme.obj U.left)

/-- The big affine étale carrier is the full subcategory of the chosen big
slice on objects with affine represented source. -/
abbrev bigAffineSite (X : ChosenBigEtaleSite.{u, v}) (S : X.carrier) :=
  ObjectProperty.FullSubcategory (bigAffineObjects X S)

/-- The inclusion of the chosen big affine étale carrier into the chosen big
slice. -/
def bigAffineInclusion (X : ChosenBigEtaleSite.{u, v}) (S : X.carrier) :
    bigAffineSite X S ⥤ bigSite X S :=
  ObjectProperty.ι (bigAffineObjects X S)

/-- The source-scheme functor from the chosen big affine étale carrier. -/
def bigAffineToScheme (X : ChosenBigEtaleSite.{u, v}) (S : X.carrier) :
    bigAffineSite X S ⥤ Scheme.{u} :=
  bigAffineInclusion X S ⋙ bigToScheme X S

/-- Every object of the chosen big affine étale carrier has affine represented
source scheme. -/
theorem bigAffineSite_obj_isAffine (X : ChosenBigEtaleSite.{u, v})
    (S : X.carrier) (U : bigAffineSite X S) :
    IsAffine (X.toScheme.obj U.obj.left) := sorry

/-- A finite standard étale cover of an object of the chosen big affine
carrier, using the affine proof stored in that object. -/
abbrev BigAffineStandardCover (X : ChosenBigEtaleSite.{u, v})
    (S : X.carrier) (U : bigAffineSite X S) :=
  @StandardEtaleCover ((bigAffineToScheme X S).obj U) U.property

/-- The object property selecting affine represented source schemes in the
chosen small étale site. -/
def smallAffineObjects (X : ChosenBigEtaleSite.{u, v}) (S : X.carrier) :
    ObjectProperty (smallSite X S) :=
  fun U ↦ IsAffine (X.toScheme.obj U.obj.left)

/-- The small affine étale carrier is the full subcategory of the chosen small
site on objects with affine represented source. -/
abbrev smallAffineSite (X : ChosenBigEtaleSite.{u, v}) (S : X.carrier) :=
  ObjectProperty.FullSubcategory (smallAffineObjects X S)

/-- The inclusion of the chosen small affine étale carrier into the chosen
small site. -/
def smallAffineInclusion (X : ChosenBigEtaleSite.{u, v}) (S : X.carrier) :
    smallAffineSite X S ⥤ smallSite X S :=
  ObjectProperty.ι (smallAffineObjects X S)

/-- The source-scheme functor from the chosen small affine étale carrier. -/
def smallAffineToScheme (X : ChosenBigEtaleSite.{u, v}) (S : X.carrier) :
    smallAffineSite X S ⥤ Scheme.{u} :=
  smallAffineInclusion X S ⋙ smallToScheme X S

/-- Every object of the chosen small affine étale carrier has affine
represented source scheme. -/
theorem smallAffineSite_obj_isAffine (X : ChosenBigEtaleSite.{u, v})
    (S : X.carrier) (U : smallAffineSite X S) :
    IsAffine (X.toScheme.obj U.obj.obj.left) := sorry

/-- A finite standard étale cover of an object of the chosen small affine
carrier, using the affine proof stored in that object. -/
abbrev SmallAffineStandardCover (X : ChosenBigEtaleSite.{u, v})
    (S : X.carrier) (U : smallAffineSite X S) :=
  @StandardEtaleCover ((smallAffineToScheme X S).obj U) U.property

/-- A presieve on the chosen big affine carrier is a standard covering when
it covers in the ambient big slice and its image in schemes generates the
same sieve as a finite standard étale cover. -/
def bigAffineStandardCovering (X : ChosenBigEtaleSite.{u, v})
    (S : X.carrier) {U : bigAffineSite X S} (R : Presieve U) : Prop :=
  R.map (bigAffineInclusion X S) ∈ (bigTopology X S).toPrecoverage U.obj ∧
    ∃ 𝒰 : BigAffineStandardCover X S U,
      Sieve.generate (R.map (bigAffineToScheme X S)) =
        Sieve.generate (Presieve.ofArrows
          (@StandardEtaleCover.U _ U.property 𝒰)
          (@StandardEtaleCover.map _ U.property 𝒰))

/-- The precoverage of ambient-covering finite standard étale families on the
chosen big affine carrier. -/
def bigAffineStandardPrecoverage (X : ChosenBigEtaleSite.{u, v})
    (S : X.carrier) : Precoverage (bigAffineSite X S) where
  coverings := fun _ ↦ { R | bigAffineStandardCovering X S R }

/-- Membership in the chosen big affine standard precoverage records both
ambient covering and equality of generated sieves with a finite standard
étale cover. -/
theorem mem_bigAffineStandardPrecoverage_iff
    (X : ChosenBigEtaleSite.{u, v}) (S : X.carrier)
    {U : bigAffineSite X S} {R : Presieve U} :
    R ∈ bigAffineStandardPrecoverage X S U ↔
      R.map (bigAffineInclusion X S) ∈ (bigTopology X S).toPrecoverage U.obj ∧
        ∃ 𝒰 : BigAffineStandardCover X S U,
          Sieve.generate (R.map (bigAffineToScheme X S)) =
            Sieve.generate (Presieve.ofArrows
              (@StandardEtaleCover.U _ U.property 𝒰)
              (@StandardEtaleCover.map _ U.property 𝒰)) := sorry

/-- The Grothendieck topology on the chosen big affine carrier generated by
ambient-covering finite standard étale families. -/
def bigAffineTopology (X : ChosenBigEtaleSite.{u, v}) (S : X.carrier) :
    GrothendieckTopology (bigAffineSite X S) :=
  (bigAffineStandardPrecoverage X S).toGrothendieck

/-- A presieve on the chosen small affine carrier is a standard covering when
it covers in the ambient small site and its image in schemes generates the
same sieve as a finite standard étale cover. -/
def smallAffineStandardCovering (X : ChosenBigEtaleSite.{u, v})
    (S : X.carrier) {U : smallAffineSite X S} (R : Presieve U) : Prop :=
  R.map (smallAffineInclusion X S) ∈ (smallTopology X S).toPrecoverage U.obj ∧
    ∃ 𝒰 : SmallAffineStandardCover X S U,
      Sieve.generate (R.map (smallAffineToScheme X S)) =
        Sieve.generate (Presieve.ofArrows
          (@StandardEtaleCover.U _ U.property 𝒰)
          (@StandardEtaleCover.map _ U.property 𝒰))

/-- The precoverage of ambient-covering finite standard étale families on the
chosen small affine carrier. -/
def smallAffineStandardPrecoverage (X : ChosenBigEtaleSite.{u, v})
    (S : X.carrier) : Precoverage (smallAffineSite X S) where
  coverings := fun _ ↦ { R | smallAffineStandardCovering X S R }

/-- Membership in the chosen small affine standard precoverage records both
ambient covering and equality of generated sieves with a finite standard
étale cover. -/
theorem mem_smallAffineStandardPrecoverage_iff
    (X : ChosenBigEtaleSite.{u, v}) (S : X.carrier)
    {U : smallAffineSite X S} {R : Presieve U} :
    R ∈ smallAffineStandardPrecoverage X S U ↔
      R.map (smallAffineInclusion X S) ∈ (smallTopology X S).toPrecoverage U.obj ∧
        ∃ 𝒰 : SmallAffineStandardCover X S U,
          Sieve.generate (R.map (smallAffineToScheme X S)) =
            Sieve.generate (Presieve.ofArrows
              (@StandardEtaleCover.U _ U.property 𝒰)
              (@StandardEtaleCover.map _ U.property 𝒰)) := sorry

/-- The Grothendieck topology on the chosen small affine carrier generated by
ambient-covering finite standard étale families. -/
def smallAffineTopology (X : ChosenBigEtaleSite.{u, v}) (S : X.carrier) :
    GrothendieckTopology (smallAffineSite X S) :=
  (smallAffineStandardPrecoverage X S).toGrothendieck

end AlgebraicGeometry.ChosenBigEtaleSite
