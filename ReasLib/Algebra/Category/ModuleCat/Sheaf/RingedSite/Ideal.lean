module

public import Mathlib.CategoryTheory.Subobject.Basic
public import Mathlib.RingTheory.Ideal.Defs
public import Mathlib.RingTheory.Ideal.Maps
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Subobject
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Ideals of sections of ideal sheaves

This leaf owns the sectionwise ideal associated to a subobject of the unit
module sheaf on a ringed site.  It is independent of any particular ringed
space, closed immersion, or scheme.
-/

@[expose] public section

open CategoryTheory Opposite

noncomputable section

universe u v w

namespace SheafOfModules.RingedSite.IdealSheaf

variable {C : Type u} [Category.{v} C]
variable {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]

variable {𝒪 : Sheaf J CommRingCat.{w}}

/-- The ideal of sections over `U` cut out by an ideal sheaf; its carrier is the
section image of the underlying module-sheaf subobject. -/
@[stacks 0GLY "sectionwise ideal"]
noncomputable def sections
    (I : Subobject (unitModule J 𝒪))
    (U : Cᵒᵖ) : Ideal (𝒪.obj.obj U) :=
  SheafOfModules.Subobject.sections I U

/-- Sections of an ideal sheaf identify canonically with its section ideal. -/
@[stacks 0GLY "ideal-sheaf sections equivalence"]
noncomputable def sectionsIso
    (I : Subobject (unitModule J 𝒪)) (U : Cᵒᵖ) :
    (I : ringedSiteModuleCategory J 𝒪).val.obj U ≅
      ModuleCat.of (𝒪.obj.obj U) (sections I U) :=
  SheafOfModules.Subobject.sectionsIso I U

/-- The forward map of `sectionsIso` has underlying value the ideal-sheaf inclusion. -/
@[simp]
theorem sectionsIso_hom_coe
    (I : Subobject (unitModule J 𝒪)) (U : Cᵒᵖ)
    (s : (I : ringedSiteModuleCategory J 𝒪).val.obj U) :
    ((sectionsIso I U).hom s : 𝒪.obj.obj U) =
      SheafOfModules.Subobject.inclusionApp I U s := sorry

/-- The underlying submodule of the section ideal is the generic section image submodule. -/
@[simp]
theorem sections_toSubmodule
    (I : Subobject (unitModule J 𝒪)) (U : Cᵒᵖ) :
    (sections I U : Submodule (𝒪.obj.obj U) (𝒪.obj.obj U)) =
      SheafOfModules.Subobject.sections I U := sorry

/-- The carrier of the section ideal is the carrier of the generic section image submodule. -/
@[simp]
theorem sections_coe
    (I : Subobject (unitModule J 𝒪)) (U : Cᵒᵖ) :
    (sections I U : Set (𝒪.obj.obj U)) =
      ((SheafOfModules.Subobject.sections I U :
        Submodule (𝒪.obj.obj U) (𝒪.obj.obj U)).carrier) := sorry

/-- Membership in the section ideal is witnessed by a section of the ideal sheaf. -/
theorem mem_sections
    (I : Subobject (unitModule J 𝒪)) (U : Cᵒᵖ) (x : 𝒪.obj.obj U) :
    x ∈ sections I U ↔
      ∃ s : (I : ringedSiteModuleCategory J 𝒪).val.obj U,
        SheafOfModules.Subobject.inclusionApp I U s = x := sorry

/-- Every local section of an ideal sheaf maps into its section ideal. -/
theorem inclusionApp_mem_sections
    (I : Subobject (unitModule J 𝒪)) (U : Cᵒᵖ)
    (s : (I : ringedSiteModuleCategory J 𝒪).val.obj U) :
    SheafOfModules.Subobject.inclusionApp I U s ∈ sections I U := sorry

/-- Restriction maps carry the section ideal over `U` into the section ideal over `V`. -/
theorem sections_le_comap
    (I : Subobject (unitModule J 𝒪)) {U V : Cᵒᵖ} (f : U ⟶ V) :
    sections I U ≤ Ideal.comap (𝒪.obj.map f).hom (sections I V) := sorry

/-- The ideal generated by restricted sections is contained in the target section ideal. -/
theorem map_sections_le
    (I : Subobject (unitModule J 𝒪)) {U V : Cᵒᵖ} (f : U ⟶ V) :
    Ideal.map (𝒪.obj.map f).hom (sections I U) ≤ sections I V := sorry

/-- Restriction of a member of a section ideal remains in the target section ideal. -/
theorem map_mem_sections
    (I : Subobject (unitModule J 𝒪)) {U V : Cᵒᵖ} (f : U ⟶ V)
    {x : 𝒪.obj.obj U} (hx : x ∈ sections I U) :
    𝒪.obj.map f x ∈ sections I V := sorry

/-- Section ideals are monotone in the ideal-sheaf subobject. -/
theorem sections_mono
    {I K : Subobject (unitModule J 𝒪)} (h : I ≤ K) (U : Cᵒᵖ) :
    sections I U ≤ sections K U := sorry

/-- Taking the section ideal over a fixed object is monotone in the ideal sheaf. -/
theorem sections_monotone (U : Cᵒᵖ) :
    Monotone (fun I : Subobject (unitModule J 𝒪) ↦ sections I U) := sorry

end SheafOfModules.RingedSite.IdealSheaf
