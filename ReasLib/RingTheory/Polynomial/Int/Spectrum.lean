module

public import Mathlib.Algebra.Field.ZMod
public import Mathlib.RingTheory.Polynomial.Basic
public import Mathlib.RingTheory.Spectrum.Prime.Basic

@[expose] public section

open Polynomial PrimeSpectrum

namespace IntPolynomial

/-- An ideal of `ℤ[X]` is generated by one irreducible polynomial. -/
def IrreduciblePrincipalIdealForm (I : Ideal ℤ[X]) : Prop :=
  ∃ generator : ℤ[X],
    Irreducible generator ∧ I = Ideal.span ({generator} : Set ℤ[X])

/-- An ideal of `ℤ[X]` is generated by a prime constant and a polynomial irreducible over `ℤ` and modulo that prime. -/
def IrreduciblePairIdealForm (I : Ideal ℤ[X]) : Prop :=
  ∃ q : ℕ, Nat.Prime q ∧
    ∃ f : ℤ[X],
      Irreducible f ∧
        Irreducible (f.map (Int.castRingHom (ZMod q))) ∧
          I = Ideal.span ({C (q : ℤ), f} : Set ℤ[X])

namespace IrreduciblePrincipalIdealForm

/-- An ideal in irreducible principal form is prime. -/
theorem isPrime {I : Ideal ℤ[X]} (hI : IrreduciblePrincipalIdealForm I) :
    I.IsPrime := sorry

end IrreduciblePrincipalIdealForm

namespace IrreduciblePairIdealForm

/-- An ideal in irreducible pair form is maximal. -/
theorem isMaximal {I : Ideal ℤ[X]} (hI : IrreduciblePairIdealForm I) :
    I.IsMaximal := sorry

/-- An ideal in irreducible pair form is prime. -/
theorem isPrime {I : Ideal ℤ[X]} (hI : IrreduciblePairIdealForm I) :
    I.IsPrime := sorry

end IrreduciblePairIdealForm

/-- A prime ideal of `ℤ[X]` is zero, irreducible principal, or irreducible pair form. -/
theorem isPrime_iff (I : Ideal ℤ[X]) :
    I.IsPrime ↔
      I = ⊥ ∨
        IrreduciblePrincipalIdealForm I ∨
        IrreduciblePairIdealForm I := sorry

/-- The ideal of every point of `PrimeSpectrum ℤ[X]` has one of the three classified forms. -/
theorem eq_bot_or_principal_or_pair (p : PrimeSpectrum ℤ[X]) :
    p.asIdeal = ⊥ ∨
      IrreduciblePrincipalIdealForm p.asIdeal ∨
      IrreduciblePairIdealForm p.asIdeal := sorry

end IntPolynomial
