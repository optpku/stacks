namespace DividedPowerDifferential

/-- The right `B`-module structure on divided-power differentials induced by commutativity. -/
instance instModuleOpposite
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping differential terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    Module Bᵐᵒᵖ (KaehlerDifferential.DeRham.dividedPowerDifferential f δ) :=
  -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping differential terms definitionally aligned.
  letI : Algebra A B := f.toAlgebra
  Module.compHom _ ((RingHom.id B).fromOpposite mul_comm)

/-- Left and right scalar multiplication agree on divided-power differentials. -/
instance instIsCentralScalar
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping differential terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    IsCentralScalar B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ) := sorry

/-- The `B`-submodule generated by divided-power differentials of elements of `J`. -/
def submodule
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping differential terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    Submodule B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ) :=
  -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping differential and scalar terms definitionally aligned.
  letI : Algebra A B := f.toAlgebra
  Submodule.span B {ω | ∃ x : B, x ∈ J ∧
    ω = KaehlerDifferential.DeRham.dividedPowerDifferentialDerivation f δ x}

/-- Every divided-power differential of an element of `J` belongs to the generated submodule. -/
theorem submodule_generator_mem
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) (x : B) (hx : x ∈ J) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping differential and scalar terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    KaehlerDifferential.DeRham.dividedPowerDifferentialDerivation f δ x ∈ submodule f δ := sorry

/-- Containment in the generated submodule is equivalent to containment of its generators. -/
theorem submodule_le_iff
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J)
    (N :
      -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping differential and scalar terms definitionally aligned.
      letI : Algebra A B := f.toAlgebra
      Submodule B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ)) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping differential and scalar terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    submodule f δ ≤ N ↔ ∀ x : B, x ∈ J →
      KaehlerDifferential.DeRham.dividedPowerDifferentialDerivation f δ x ∈ N := sorry

/-- Multiplication by `J` sends all divided-power differentials into the generated submodule. -/
theorem ideal_smul_mem_submodule
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) (x : B) (hx : x ∈ J)
    (ω :
      -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping differential and scalar terms definitionally aligned.
      letI : Algebra A B := f.toAlgebra
      KaehlerDifferential.DeRham.dividedPowerDifferential f δ) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping differential and scalar terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    x • ω ∈ submodule f δ := sorry

/-- The first-order square-zero extension equipped with its coordinate divided powers. -/
noncomputable def extensionRing
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) : DividedPowerRing :=
  -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping extension terms definitionally aligned.
  letI : Algebra A B := f.toAlgebra
  DividedPowerRing.of (TrivSqZeroExt B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ))
    (DividedPowers.TrivSqZeroExt.submoduleIdeal J (submodule f δ)
      (ideal_smul_mem_submodule f δ))
    (DividedPowers.TrivSqZeroExt.submodulePowers δ (submodule f δ)
      (ideal_smul_mem_submodule f δ))

/-- The distinguished ideal of the first-order extension is the coordinate ideal. -/
theorem extensionRing_ideal
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping extension terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    (extensionRing f δ).ideal =
      DividedPowers.TrivSqZeroExt.submoduleIdeal J (submodule f δ)
        (ideal_smul_mem_submodule f δ) := sorry

/-- The distinguished divided powers of the first-order extension are the coordinate powers. -/
theorem extensionRing_dividedPowers
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping extension terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    (extensionRing f δ).dividedPowers =
      DividedPowers.TrivSqZeroExt.submodulePowers δ (submodule f δ)
        (ideal_smul_mem_submodule f δ) := sorry

set_option backward.privateInPublic true in
/-- The Taylor map preserves one in the square-zero extension. -/
private theorem taylorMap_one
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping Taylor terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    TrivSqZeroExt.inl (1 : B) +
        TrivSqZeroExt.inr (KaehlerDifferential.DeRham.dividedPowerDifferentialDerivation f δ 1) =
      (1 : TrivSqZeroExt B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ)) := sorry

set_option backward.privateInPublic true in
/-- The Taylor map respects multiplication in the square-zero extension. -/
private theorem taylorMap_mul
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) (x y : B) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping Taylor multiplication terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    TrivSqZeroExt.inl (x * y) +
        TrivSqZeroExt.inr (KaehlerDifferential.DeRham.dividedPowerDifferentialDerivation f δ (x * y)) =
      (TrivSqZeroExt.inl x +
        TrivSqZeroExt.inr (KaehlerDifferential.DeRham.dividedPowerDifferentialDerivation f δ x)) *
        (TrivSqZeroExt.inl y +
        TrivSqZeroExt.inr (KaehlerDifferential.DeRham.dividedPowerDifferentialDerivation f δ y) :
          TrivSqZeroExt B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ)) := sorry

