module

public import ReasLib.Algebra.Homology.DerivedCategory.ModuleCat.IdealPower.Tor
public import ReasLib.Algebra.Category.ModuleCat.ProjectiveResolution.Uniformity

@[expose] public section

noncomputable section

universe u

namespace CategoryTheory.DerivedCategory.IdealPower

open Abelian

/-- For an ideal generated by at most `t` elements in a Noetherian ring, uniform
cutoffs make the quotient transitions satisfy all seven equivalent bounded-lift,
Ext-vanishing, and Tor-vanishing conditions in degrees above `t`, for every choice
of projective resolutions of their source and target. -/
theorem uniformArtinRees
    {A : Type u} [CommRing A] [IsNoetherianRing A]
    (I : Ideal A) (t : ℕ)
    (h_generators : ∃ a : Fin t → I,
      I = Ideal.span (Set.range fun j ↦ (a j : A))) :
    ∃ N c : ℕ, ∀ n : ℕ, N ≤ n →
      ∀ (P : ProjectiveResolution (Ideal.PowerQuotient.stage I (ModuleCat.of A A) n))
        (P' : ProjectiveResolution
          (Ideal.PowerQuotient.stage I (ModuleCat.of A A) (n - c))),
      let α := ModuleCat.ofHom (AdicCompletion.transitionMap I A (Nat.sub_le n c))
      let c₁ := ∃ a : P.Hom P' α, ∀ i : ℕ, t < i → a.hom.f i = 0
      let c₂ := ∃ a : P.Hom P' α, a.hom.f (t + 1) = 0
      let c₃ := ∀ (M : ModuleCat.{u} A) (i : ℕ), t < i →
        (Ext.mk₀.{u} α).precomp M (zero_add i) = 0
      let c₄ := ∀ M : ModuleCat.{u} A,
        (Ext.mk₀.{u} α).precomp M (zero_add (t + 1)) = 0
      let c₅ := (Ext.mk₀.{u} α).comp
        (P'.resolutionImageExtClass.{u} t) (zero_add (t + 1)) = 0
      let c₆ := ∀ (M : ModuleCat.{u} A) (i : ℕ), t < i →
        ((Tor (ModuleCat.{u} A) i).map α).app M = 0
      let c₇ := ∀ M : ModuleCat.{u} A,
        ((Tor (ModuleCat.{u} A) (t + 1)).map α).app M = 0
      List.TFAE [c₁, c₂, c₃, c₄, c₅, c₆, c₇] ∧ c₇ := sorry

/-- For an ideal generated by at most `t` elements in a Noetherian local ring
of Krull dimension `d`, uniform cutoffs make the quotient transitions satisfy
all seven equivalent bounded-lift, Ext-vanishing, and Tor-vanishing conditions
in degrees above `d`, for every choice of projective resolutions of their
source and target. -/
theorem uniformArtinRees_of_ringKrullDim
    {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (I : Ideal A) (t d : ℕ)
    (h_generators : ∃ a : Fin t → I,
      I = Ideal.span (Set.range fun j ↦ (a j : A)))
    (h_dimension : ringKrullDim A = d) :
    ∃ N c : ℕ, ∀ n : ℕ, N ≤ n →
      ∀ (P : ProjectiveResolution (Ideal.PowerQuotient.stage I (ModuleCat.of A A) n))
        (P' : ProjectiveResolution
          (Ideal.PowerQuotient.stage I (ModuleCat.of A A) (n - c))),
      let α := ModuleCat.ofHom (AdicCompletion.transitionMap I A (Nat.sub_le n c))
      let c₁ := ∃ a : P.Hom P' α, ∀ i : ℕ, d < i → a.hom.f i = 0
      let c₂ := ∃ a : P.Hom P' α, a.hom.f (d + 1) = 0
      let c₃ := ∀ (M : ModuleCat.{u} A) (i : ℕ), d < i →
        (Ext.mk₀.{u} α).precomp M (zero_add i) = 0
      let c₄ := ∀ M : ModuleCat.{u} A,
        (Ext.mk₀.{u} α).precomp M (zero_add (d + 1)) = 0
      let c₅ := (Ext.mk₀.{u} α).comp
        (P'.resolutionImageExtClass.{u} d) (zero_add (d + 1)) = 0
      let c₆ := ∀ (M : ModuleCat.{u} A) (i : ℕ), d < i →
        ((Tor (ModuleCat.{u} A) i).map α).app M = 0
      let c₇ := ∀ M : ModuleCat.{u} A,
        ((Tor (ModuleCat.{u} A) (d + 1)).map α).app M = 0
      List.TFAE [c₁, c₂, c₃, c₄, c₅, c₆, c₇] ∧ c₇ := sorry

end CategoryTheory.DerivedCategory.IdealPower
