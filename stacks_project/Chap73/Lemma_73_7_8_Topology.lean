module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Fppf.Topology

/-!
# Fppf topology on algebraic spaces

The fppf topology is generated by the fppf precoverage.
-/

@[expose] public section

universe u

#check (AlgebraicGeometry.AlgebraicSpace.fppfTopology :
  ∀ S : AlgebraicGeometry.Scheme.{u},
    CategoryTheory.GrothendieckTopology (AlgebraicGeometry.AlgebraicSpace S))

#check (CategoryTheory.Precoverage.generate_mem_toGrothendieck :
  ∀ {S : AlgebraicGeometry.Scheme.{u}} {X : AlgebraicGeometry.AlgebraicSpace S}
    {R : CategoryTheory.Presieve X},
    R ∈ AlgebraicGeometry.AlgebraicSpace.fppfPrecoverage S X →
      CategoryTheory.Sieve.generate R ∈ AlgebraicGeometry.AlgebraicSpace.fppfTopology S X)
