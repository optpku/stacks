module

public import ReasLib.Algebra.Homology.DerivedCategory.Completeness.CohomologicalDimension
import StacksCheckRecall

/-!
# Cohomological dimension of derived completion

@stack 0AAJ
-/

@[expose] public section

/- Lemma 15.92.21 (1): completion preserves cohomology isomorphisms in degrees `i ≥ 1` and
epimorphisms in degree `0`. -/
@[stacks 0AAJ "(1), upper cohomological bound for derived completion"]
#check @DerivedCategory.DerivedCompletion.map_isIso_ge_one_and_epi_zero

/- Lemma 15.92.21 (2): for an ideal generated by `r` elements, completion shifts the analogous
lower cohomological bound by at most `r`. -/
@[stacks 0AAJ "(2), lower cohomological bound for derived completion"]
#check @DerivedCategory.DerivedCompletion.map_isIso_le_neg_succ_and_mono_neg
