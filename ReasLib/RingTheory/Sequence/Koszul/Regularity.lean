/-!
# Koszul regularity

Module-valued and ring-valued regularity predicates expressed through positive homology of finite
Koszul complexes.

@stack 062E
@stack 062F
@stack 0CEM
@stack 062G
@stack 0665
@stack 0668
@stack 068L
@stack 0669
@stack 068M
@stack 066A
-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits HomologicalComplex MonoidalCategory ModuleCat

namespace RingTheory.Sequence

variable {R : Type u} [CommRing R]

/-- The finite-family Koszul complex of `f` after tensoring on the left with the coefficient
module `M`. -/
@[stacks 062E "Koszul complex tensored with a coefficient module"]
abbrev koszulComplexOnTensorLeft (R : Type u) [CommRing R] (M : Type u)
    [AddCommGroup M] [Module R M] {r : ℕ} (f : Fin r → R) :
  ChainComplex (ModuleCat R) ℕ :=
  ((tensorLeft (of R M)).mapHomologicalComplex (ComplexShape.down ℕ)).obj
    (KoszulComplex.family f)

/-- A finite family is `M`-Koszul-regular when every positive homology object of its tensor
Koszul complex vanishes. -/
@[stacks 062E "Definition 15.30.1 (1), module Koszul-regular finite families"]
noncomputable abbrev IsKoszulRegularOn (M : Type u) [AddCommGroup M] [Module R M]
    {r : ℕ} (f : Fin r → R) : Prop :=
  ∀ i : ℕ, 1 ≤ i → IsZero ((koszulComplexOnTensorLeft R M f).homology i)

/-- A finite family is `M`-`H_1`-regular when the first homology object of its tensor Koszul
complex vanishes. -/
@[stacks 062E "Definition 15.30.1 (2), module H1-regular finite families"]
noncomputable def IsH1RegularOn (M : Type u) [AddCommGroup M] [Module R M]
    {r : ℕ} (f : Fin r → R) : Prop :=
  IsZero ((koszulComplexOnTensorLeft R M f).homology 1)

/-- Tensoring a family Koszul complex with the regular module preserves homology vanishing. -/
theorem isZero_koszulComplexOnTensorLeft_homology_iff (R : Type u) [CommRing R]
    {r : ℕ} (f : Fin r → R) (i : ℕ) :
    IsZero ((koszulComplexOnTensorLeft R R f).homology i) ↔
      IsZero ((KoszulComplex.family f).homology i) := sorry

/-- A finite family is Koszul-regular when it is Koszul-regular on the regular module. -/
@[stacks 062E "Definition 15.30.1 (3), Koszul-regular finite families"]
noncomputable abbrev IsKoszulRegularSequence {r : ℕ} (f : Fin r → R) : Prop :=
  IsKoszulRegularOn R f

/-- Koszul regularity is equivalent to vanishing of all positive homology of the family Koszul
complex. -/
theorem isKoszulRegularSequence_iff {r : ℕ} (f : Fin r → R) :
    IsKoszulRegularSequence f ↔
      ∀ i : ℕ, 1 ≤ i → IsZero ((KoszulComplex.family f).homology i) := sorry

/-- A finite family is `H_1`-regular when it is `H_1`-regular on the regular module. -/
@[stacks 062E "Definition 15.30.1 (4), H1-regular finite families"]
noncomputable abbrev IsH1RegularSequence {r : ℕ} (f : Fin r → R) : Prop :=
  IsH1RegularOn R f

/-- `H_1`-regularity is equivalent to vanishing of the first homology of the family Koszul
complex. -/
theorem isH1RegularSequence_iff {r : ℕ} (f : Fin r → R) :
    IsH1RegularSequence f ↔ IsZero ((KoszulComplex.family f).homology 1) := sorry

namespace IsH1RegularOn

/-- If adjoining `f` and adjoining `g` to the same prefix both give `M`-`H₁`-regular families,
then adjoining `f * g` does as well. -/
@[stacks 062G "Lemma 15.30.4 (1)"]
theorem snoc_mul {M : Type u} [AddCommGroup M] [Module R M]
    {r : ℕ} {fs : Fin r → R} {f g : R}
    (hf : IsH1RegularOn M (Fin.snoc fs f)) (hg : IsH1RegularOn M (Fin.snoc fs g)) :
    IsH1RegularOn M (Fin.snoc fs (f * g)) := sorry

end IsH1RegularOn

namespace IsKoszulRegularOn

/-- If adjoining `f` and adjoining `g` to the same prefix both give `M`-Koszul-regular families,
then adjoining `f * g` does as well. -/
@[stacks 062G "Lemma 15.30.4 (2)"]
theorem snoc_mul {M : Type u} [AddCommGroup M] [Module R M]
    {r : ℕ} {fs : Fin r → R} {f g : R}
    (hf : IsKoszulRegularOn M (Fin.snoc fs f))
    (hg : IsKoszulRegularOn M (Fin.snoc fs g)) :
    IsKoszulRegularOn M (Fin.snoc fs (f * g)) := sorry

end IsKoszulRegularOn

namespace IsH1RegularSequence

/-- If a finite family is `H₁`-regular after passing to `R ⨸ I`, then `I` meets the ideal
generated by the family in its product with that ideal. -/
@[stacks 0665 "intersection with an ideal generated by an H1-regular quotient family"]
theorem inf_span_eq_mul_of_quotient {m : ℕ} (I : Ideal R) (g : Fin m → R)
    (h : IsH1RegularSequence (fun i ↦ Ideal.Quotient.mk I (g i))) :
    I ⊓ Ideal.span (Set.range g) = I * Ideal.span (Set.range g) := sorry

/-- Concatenating an `H₁`-regular family with an `H₁`-regular family modulo the ideal generated
by the first one preserves `H₁`-regularity. -/
@[stacks 0668 "concatenating H1-regular families across a quotient"]
theorem append_of_quotient {n m : ℕ} (f : Fin n → R) (g : Fin m → R)
    (hf : IsH1RegularSequence f)
    (hg : IsH1RegularSequence
      (fun j ↦ Ideal.Quotient.mk (Ideal.span (Set.range f)) (g j))) :
    IsH1RegularSequence (Fin.append f g) := sorry

/-- The tail of an `H₁`-regular concatenated family remains `H₁`-regular after quotienting by
the ideal generated by its prefix. -/
@[stacks 068L "quotient tail of an H1-regular family"]
theorem quotient_tail {n m : ℕ} (f : Fin n → R) (g : Fin m → R)
    (hfg : IsH1RegularSequence (Fin.append f g)) :
    IsH1RegularSequence
      (fun j ↦ Ideal.Quotient.mk (Ideal.span (Set.range f)) (g j)) := sorry

/-- `H₁`-regularity of a finite family depends only on its length and the ideal it generates. -/
@[stacks 066A "H1-regularity is invariant under a same-length change of generators"]
theorem of_span_eq {r : ℕ} (f g : Fin r → R)
    (hspan : Ideal.span (Set.range f) = Ideal.span (Set.range g))
    (hg : IsH1RegularSequence g) : IsH1RegularSequence f := sorry

/-- Same-length `H₁`-regularity is characterized by the generated ideal. -/
@[stacks 066A "same-length H1-regularity iff by generated ideal"]
theorem iff_of_span_eq {r : ℕ} (f g : Fin r → R)
    (hspan : Ideal.span (Set.range f) = Ideal.span (Set.range g)) :
    IsH1RegularSequence f ↔ IsH1RegularSequence g := sorry

end IsH1RegularSequence

namespace IsKoszulRegularSequence

/-- Concatenating a Koszul-regular family with a Koszul-regular family modulo the ideal generated
by the first one preserves Koszul-regularity. -/
@[stacks 0669 "concatenating Koszul-regular families across a quotient"]
theorem append_of_quotient {n m : ℕ} (f : Fin n → R) (g : Fin m → R)
    (hf : IsKoszulRegularSequence f)
    (hg : IsKoszulRegularSequence
      (fun j ↦ Ideal.Quotient.mk (Ideal.span (Set.range f)) (g j))) :
    IsKoszulRegularSequence (Fin.append f g) := sorry

/-- The tail of a Koszul-regular concatenated family remains Koszul-regular after quotienting by
the ideal generated by its Koszul-regular prefix. -/
@[stacks 068M "quotient tail of a Koszul-regular family"]
theorem quotient_tail {n m : ℕ} (f : Fin n → R) (g : Fin m → R)
    (hf : IsKoszulRegularSequence f)
    (hfg : IsKoszulRegularSequence (Fin.append f g)) :
    IsKoszulRegularSequence
      (fun j ↦ Ideal.Quotient.mk (Ideal.span (Set.range f)) (g j)) := sorry

/-- With a Koszul-regular prefix fixed, concatenation is equivalent to regularity of the quotient
tail. -/
@[stacks 068M "append and quotient-tail Koszul regularity equivalence"]
theorem append_iff_quotient {n m : ℕ} (f : Fin n → R) (g : Fin m → R)
    (hf : IsKoszulRegularSequence f) :
    IsKoszulRegularSequence (Fin.append f g) ↔
      IsKoszulRegularSequence
        (fun j ↦ Ideal.Quotient.mk (Ideal.span (Set.range f)) (g j)) := sorry

/-- Koszul-regularity of a finite family depends only on its length and the ideal it generates. -/
@[stacks 066A "Koszul-regularity is invariant under a same-length change of generators"]
theorem of_span_eq {r : ℕ} (f g : Fin r → R)
    (hspan : Ideal.span (Set.range f) = Ideal.span (Set.range g))
    (hg : IsKoszulRegularSequence g) : IsKoszulRegularSequence f := sorry

/-- Same-length Koszul regularity is characterized by the generated ideal. -/
@[stacks 066A "same-length Koszul regularity iff by generated ideal"]
theorem iff_of_span_eq {r : ℕ} (f g : Fin r → R)
    (hspan : Ideal.span (Set.range f) = Ideal.span (Set.range g)) :
    IsKoszulRegularSequence f ↔ IsKoszulRegularSequence g := sorry

end IsKoszulRegularSequence

namespace IsWeaklyRegular

/-- A weakly regular list on `M` induces a Koszul-regular finite family through `List.get`. -/
@[stacks 062F "weakly regular sequences are Koszul-regular"]
theorem isKoszulRegularOn {M : Type u} [AddCommGroup M] [Module R M]
    {rs : List R} (hreg : IsWeaklyRegular M rs) : IsKoszulRegularOn M rs.get := sorry

end IsWeaklyRegular

/-- A weakly regular finite family, expressed as its ordered list, is Koszul-regular. -/
theorem isKoszulRegularSequence_of_isWeaklyRegular {r : ℕ} {f : Fin r → R}
    (hreg : IsWeaklyRegular R (List.ofFn f)) : IsKoszulRegularSequence f := by
  let P : (Σ n, Fin n → R) → Prop := fun s ↦ IsKoszulRegularOn R s.2
  have hsigma :
      (⟨(List.ofFn f).length, (List.ofFn f).get⟩ : Σ n, Fin n → R) = ⟨r, f⟩ := by
    exact Fin.sigma_eq_of_eq_comp_cast List.length_ofFn <| funext fun i ↦ List.get_ofFn f i
  change P ⟨r, f⟩
  rw [← hsigma]
  exact hreg.isKoszulRegularOn

namespace IsRegular

/-- A regular list on `M` induces a Koszul-regular finite family through `List.get`. -/
@[stacks 062F "regular sequences are Koszul-regular"]
theorem isKoszulRegularOn {M : Type u} [AddCommGroup M] [Module R M]
    {rs : List R} (hreg : IsRegular M rs) : IsKoszulRegularOn M rs.get := sorry

end IsRegular

/-- An `M`-Koszul-regular finite family is `M`-`H_1`-regular. -/
@[stacks 0CEM "Koszul-regular implies H1-regular"]
theorem isH1RegularOn_of_isKoszulRegularOn {M : Type u} [AddCommGroup M] [Module R M]
    {r : ℕ} {f : Fin r → R} (hKoszul : IsKoszulRegularOn M f) : IsH1RegularOn M f := sorry

/-- A Koszul-regular finite family is `H_1`-regular. -/
@[stacks 0CEM "Koszul-regular sequences are H1-regular"]
theorem isH1RegularSequence_of_isKoszulRegularSequence {r : ℕ} {f : Fin r → R}
    (hKoszul : IsKoszulRegularSequence f) : IsH1RegularSequence f := sorry

end RingTheory.Sequence
