module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Free.Generated
public import ReasLib.AlgebraicGeometry.Scheme.Artinian.Decomposition
public import ReasLib.AlgebraicGeometry.Scheme.Module.Cohomology.Affine
public import ReasLib.AlgebraicGeometry.Scheme.Module.Cohomology.AffinePushforward
public import ReasLib.AlgebraicGeometry.Scheme.Module.SchemeTheoreticSupport.Coherent
public import ReasLib.AlgebraicGeometry.Scheme.Module.Support

/-!
# Coherent modules with zero-dimensional support

This file records global generation and positive-degree cohomology vanishing for coherent
modules on locally Noetherian schemes whose support has dimension at most zero.
-/

@[expose] public section

open CategoryTheory.Limits

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme.Modules.SupportDimensionZero

variable {X : Scheme.{u}} [IsLocallyNoetherian X]

/-- A coherent module with support of dimension at most zero is generated by global sections. -/
theorem isGloballyGenerated
    (ℱ : X.Modules) [ℱ.IsCoherent]
    (hSuppDim : topologicalKrullDim (moduleSupport ℱ) ≤ 0) :
    SheafOfModules.IsGloballyGenerated ℱ := sorry

/-- A coherent module with support of dimension at most zero has vanishing cohomology in every
positive degree. -/
theorem higherCohomology_isZero
    (ℱ : X.Modules) [ℱ.IsCoherent]
    (hSuppDim : topologicalKrullDim (moduleSupport ℱ) ≤ 0)
    (i : ℕ) (hi : 0 < i) :
    IsZero (((SheafOfModules.toSheaf X.ringCatSheaf).obj ℱ).H' i (⊤ : Opens X)) := sorry

end AlgebraicGeometry.Scheme.Modules.SupportDimensionZero
