module

public import Mathlib.Algebra.Module.LocalizedModule.AtPrime
public import ReasLib.Algebra.Homology.CochainComplex.BerthelotOgus.Eta.Int.DerivedInvariance
public import ReasLib.Algebra.Homology.CochainComplex.Bounded

/-!
# Prime-local form of integer eta determinantal ideals

For a bounded finite-free complex whose localized homology is free, the localized eta
determinantal ideal is generated by a power of the localized scalar.
@stack 0GSV
-/

@[expose] public section

open CategoryTheory
open scoped BerthelotOgus nonZeroDivisors

noncomputable section

universe u

namespace CochainComplex.BerthelotOgus.Int.DeterminantalIdeal

variable {A : Type u} [CommRing A]

/-- If the homology of a bounded termwise finite-free complex becomes free at a prime, then its
eta determinantal ideal becomes the principal ideal generated by a power of the localized
nonzerodivisor. -/
@[stacks 0GSV "local power description of Berthelot-Ogus determinantal ideals"]
theorem map_atPrime_eq_pow_of_homology_free
    (p : PrimeSpectrum A) (f : A) (hf : f ∈ nonZeroDivisors A)
    (K : CochainComplex (ModuleCat A) ℤ)
    (hK : CochainComplex.bounded (ModuleCat A) K)
    [K.IsTermwiseFiniteFree]
    (hH : ∀ j : ℤ,
      Module.Free (Localization.AtPrime p.asIdeal)
        (LocalizedModule.AtPrime p.asIdeal (K.homology j)))
    (i : ℤ) :
    ∃ n : ℕ,
      Ideal.map (algebraMap A (Localization.AtPrime p.asIdeal)) I[f]_(i)(K) =
        principalIdeal ((algebraMap A (Localization.AtPrime p.asIdeal) f) ^ n) := sorry

end CochainComplex.BerthelotOgus.Int.DeterminantalIdeal
