/-- The fixed-right derived tensor/internal-Hom counit is naturally compatible with changing its
right tensor factor. -/
@[stacks 0A8W "fixed-right derived tensor/internal-Hom counit parameter naturality"]
theorem counitOf_natural_source
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    {E₁ E₂ : DerivedCategory C} (f : E₁ ⟶ E₂)
    (N : DerivedCategory C) [DerivedTensor.Right.Has (C := C)] :
