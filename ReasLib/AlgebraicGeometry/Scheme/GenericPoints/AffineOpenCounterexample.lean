/-!
# Generic points without a common affine neighborhood

This file constructs a rational line arrangement and the scheme obtained by doubling its
spectrum away from a distinguished minimal prime.
-/

@[expose] public section

open TopologicalSpace
open scoped AlgebraicGeometry

noncomputable section

namespace AlgebraicGeometry.RationalLineArrangement

/-- The polynomial ring whose `none` coordinate is `x` and whose `some i` coordinate is `yᵢ`. -/
abbrev PolynomialRing := MvPolynomial (Option ℕ+) ℚ

/-- The ideal generated by `(x - i)yᵢ` for all positive integers `i`. -/
def relationIdeal : Ideal PolynomialRing :=
  Ideal.span (Set.range fun i : ℕ+ ↦
    (MvPolynomial.X (none : Option ℕ+) - MvPolynomial.C ((i : ℕ) : ℚ)) *
      MvPolynomial.X (some i))

/-- The coordinate ring `ℚ[x, y₁, y₂, …] / ((x - i)yᵢ)`. -/
abbrev CoordinateRing := PolynomialRing ⧸ relationIdeal

/-- The class of the coordinate `x` in the rational line arrangement. -/
def x : CoordinateRing :=
  Ideal.Quotient.mk relationIdeal (MvPolynomial.X (none : Option ℕ+))

/-- The class of the coordinate `yᵢ` in the rational line arrangement. -/
def y (i : ℕ+) : CoordinateRing :=
  Ideal.Quotient.mk relationIdeal (MvPolynomial.X (some i))

/-- In the coordinate ring, `(x - i)yᵢ` vanishes for every positive integer `i`. -/
theorem relation_zero (i : ℕ+) :
    (x - algebraMap ℚ CoordinateRing ((i : ℕ) : ℚ)) * y i = 0 := by
  have h : Ideal.Quotient.mk relationIdeal
      ((MvPolynomial.X (none : Option ℕ+) - MvPolynomial.C ((i : ℕ) : ℚ)) *
        MvPolynomial.X (some i)) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self i))
  simpa only [map_mul, map_sub, x, y, ← MvPolynomial.algebraMap_eq,
    Ideal.Quotient.mk_algebraMap] using h

/-- The ideal generated by all coordinates `yᵢ`. -/
def axisIdeal : Ideal CoordinateRing :=
  Ideal.span (Set.range y)

/-- The ideal generated by all `yᵢ` is prime. -/
theorem axisIdeal_isPrime : axisIdeal.IsPrime := by
  let f : PolynomialRing →+* PolynomialRing :=
    MvPolynomial.eval₂Hom MvPolynomial.C fun o ↦
      match o with
      | none => MvPolynomial.X none
      | some _ => 0
  have hf : relationIdeal ≤ RingHom.ker f := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    simp [RingHom.mem_ker, f]
  let g : CoordinateRing →+* PolynomialRing := Ideal.Quotient.lift relationIdeal f hf
  have hle : axisIdeal ≤ RingHom.ker g := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    simp [RingHom.mem_ker, g, y, f]
  let q := (Ideal.Quotient.mk axisIdeal).comp (Ideal.Quotient.mk relationIdeal)
  have hq : q.comp f = q := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp [f]
    · intro o
      cases o with
      | none => simp [f]
      | some i =>
        have hy : Ideal.Quotient.mk axisIdeal (y i) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self i))
        simpa [q, f, y] using hy.symm
  have hge : RingHom.ker g ≤ axisIdeal := by
    intro a ha
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
    have hp : f p = 0 := ha
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change q p = 0
    rw [← RingHom.congr_fun hq p]
    change q (f p) = 0
    rw [hp, map_zero]
  rw [show axisIdeal = RingHom.ker g from le_antisymm hle hge]
  exact RingHom.ker_isPrime g

/-- The ideal generated by all `yᵢ` is a minimal prime of the coordinate ring. -/
theorem axisIdeal_mem_minimalPrimes :
    axisIdeal ∈ minimalPrimes CoordinateRing := by
  have hx (i : ℕ+) : x - algebraMap ℚ CoordinateRing ((i : ℕ) : ℚ) ∉ axisIdeal := by
    let f : PolynomialRing →+* ℚ :=
      MvPolynomial.eval₂Hom (RingHom.id ℚ) fun o ↦
        match o with
        | none => (i : ℕ) + 1
        | some _ => 0
    have hf : relationIdeal ≤ RingHom.ker f := by
      apply Ideal.span_le.mpr
      rintro _ ⟨j, rfl⟩
      simp [RingHom.mem_ker, f]
    let g : CoordinateRing →+* ℚ := Ideal.Quotient.lift relationIdeal f hf
    have hle : axisIdeal ≤ RingHom.ker g := by
      apply Ideal.span_le.mpr
      rintro _ ⟨j, rfl⟩
      simp [RingHom.mem_ker, g, y, f]
    intro h
    have hz : g (x - algebraMap ℚ CoordinateRing ((i : ℕ) : ℚ)) = 0 := hle h
    change g (Ideal.Quotient.mk relationIdeal (MvPolynomial.X none) -
      Ideal.Quotient.mk relationIdeal (MvPolynomial.C ((i : ℕ) : ℚ))) = 0 at hz
    simpa [g, f] using hz
  refine ⟨⟨axisIdeal_isPrime, bot_le⟩, ?_⟩
  intro p hp hpa
  apply Ideal.span_le.mpr
  rintro _ ⟨i, rfl⟩
  exact (hp.1.mem_or_mem ((relation_zero i).symm ▸ p.zero_mem)).resolve_left
    (fun h ↦ hx i (hpa h))

/-- The point of the spectrum corresponding to the ideal generated by all `yᵢ`. -/
def axisPoint : PrimeSpectrum CoordinateRing :=
  ⟨axisIdeal, axisIdeal_isPrime⟩

/-- The prime ideal underlying `axisPoint` is `axisIdeal`. -/
theorem axisPoint_asIdeal : axisPoint.asIdeal = axisIdeal := rfl

/-- The affine spectrum of the rational line arrangement. -/
abbrev spectrum : Scheme :=
  Spec (CommRingCat.of CoordinateRing)

/-- The union of the basic opens `D(yᵢ)` in the rational line arrangement. -/
def puncturedOpen : spectrum.Opens :=
  ⨆ i : ℕ+, PrimeSpectrum.basicOpen (y i)

/-- The union of the opens `D(yᵢ)` is the complement of the vanishing locus of `axisIdeal`. -/
theorem puncturedOpen_coe :
    (puncturedOpen : Set spectrum) =
      (PrimeSpectrum.zeroLocus (axisIdeal : Set CoordinateRing))ᶜ := by
  classical
  change (↑(⨆ i, PrimeSpectrum.basicOpen (y i)) : Set (PrimeSpectrum CoordinateRing)) =
    (PrimeSpectrum.zeroLocus (axisIdeal : Set CoordinateRing))ᶜ
  ext p
  change (p ∈ ⨆ i, PrimeSpectrum.basicOpen (y i)) ↔ ¬ axisIdeal ≤ p.asIdeal
  rw [Opens.mem_iSup, axisIdeal, Ideal.span_le]
  simp only [PrimeSpectrum.mem_basicOpen, Set.range_subset_iff, not_forall]
  rfl

/-- The distinguished minimal-prime point does not belong to `puncturedOpen`. -/
theorem axisPoint_not_mem_puncturedOpen : axisPoint ∉ puncturedOpen := by
  intro h
  obtain ⟨i, hi⟩ := Opens.mem_iSup.mp h
  exact hi (Ideal.subset_span (Set.mem_range_self i) : y i ∈ axisIdeal)

/-- Intersecting `puncturedOpen` with any open neighborhood of `axisPoint` gives a noncompact
open subset. -/
theorem puncturedOpen_inf_not_isCompact_of_mem (V : spectrum.Opens)
    (hV : axisPoint ∈ V) :
    ¬ IsCompact (((puncturedOpen ⊓ V : spectrum.Opens) : Set spectrum)) := sorry

namespace DoubleAlong

/-- The scheme obtained by gluing two copies of the spectrum along `puncturedOpen`. -/
abbrev scheme : Scheme :=
  Scheme.doubleAlong puncturedOpen

/-- The `i`-th copy of `axisPoint` in the doubled scheme. -/
def point (i : Fin 2) : scheme :=
  Scheme.DoubleAlong.point puncturedOpen i axisPoint

/-- The two copies of `axisPoint` in the doubled scheme are distinct. -/
theorem point_injective : Function.Injective point := by
  intro i j hij
  fin_cases i <;> fin_cases j
  · rfl
  · exact False.elim ((Scheme.DoubleAlong.point_zero_ne_point_one_of_not_mem
      puncturedOpen axisPoint axisPoint_not_mem_puncturedOpen) hij)
  · exact False.elim ((Scheme.DoubleAlong.point_zero_ne_point_one_of_not_mem
      puncturedOpen axisPoint axisPoint_not_mem_puncturedOpen) hij.symm)
  · rfl

/-- Each copy of `axisPoint` is a generic point of the doubled scheme. -/
theorem point_mem_genericPoints (i : Fin 2) :
    point i ∈ genericPoints scheme := by
  have haxis : closure ({axisPoint} : Set spectrum) ∈ irreducibleComponents spectrum := by
    change closure ({axisPoint} : Set (PrimeSpectrum CoordinateRing)) ∈
      irreducibleComponents (PrimeSpectrum CoordinateRing)
    rw [PrimeSpectrum.closure_singleton]
    apply PrimeSpectrum.zeroLocus_ideal_mem_irreducibleComponents.mpr
    simpa only [axisPoint_asIdeal, axisIdeal_isPrime.isRadical.radical] using
      axisIdeal_mem_minimalPrimes
  let f := Scheme.DoubleAlong.chartMap puncturedOpen i
  have hf : Topology.IsOpenEmbedding (fun a : spectrum ↦ f a) := f.isOpenEmbedding
  change closure ({f axisPoint} : Set scheme) ∈ irreducibleComponents scheme
  refine ⟨isIrreducible_singleton.closure, ?_⟩
  intro Z hZ hsub
  have hne : (Z ∩ Set.range f).Nonempty :=
    ⟨f axisPoint, hsub (subset_closure (Set.mem_singleton (f axisPoint))), axisPoint, rfl⟩
  have heq : f ⁻¹' closure ({f axisPoint} : Set scheme) =
      closure ({axisPoint} : Set spectrum) := by
    have himage : (fun a : spectrum ↦ f a) '' ({axisPoint} : Set spectrum) =
        {f axisPoint} := Set.image_singleton
    exact (congrArg (fun S : Set scheme ↦ (fun a : spectrum ↦ f a) ⁻¹' closure S)
      himage).symm.trans
        (hf.isEmbedding.closure_eq_preimage_closure_image ({axisPoint} : Set spectrum)).symm
  have hpre : f ⁻¹' Z ⊆ closure ({axisPoint} : Set spectrum) :=
    haxis.2 (hZ.preimage hf hne) (heq ▸ Set.preimage_mono hsub)
  apply (subset_closure_inter_of_isPreirreducible_of_isOpen hZ.2 hf.isOpen_range hne).trans
  apply closure_minimal _ isClosed_closure
  rintro z ⟨hz, a, rfl⟩
  have ha : a ∈ f ⁻¹' closure ({f axisPoint} : Set scheme) := heq.symm ▸ hpre hz
  exact ha

/-- The two distinguished points embedded in the generic points of the doubled scheme. -/
def genericPointsEmbedding : Fin 2 ↪ genericPoints scheme where
  toFun i := ⟨point i, point_mem_genericPoints i⟩
  inj' i j hij := point_injective (congrArg Subtype.val hij)

/-- The underlying point of `genericPointsEmbedding i` is the `i`-th copy of `axisPoint`. -/
theorem genericPointsEmbedding_coe (i : Fin 2) :
    (genericPointsEmbedding i : scheme) = point i := rfl

/-- No affine open of the doubled scheme contains both distinguished generic points. -/
theorem not_exists_affineOpen_containing_genericPoints :
    ¬ ∃ U : scheme.affineOpens,
      ∀ i, (genericPointsEmbedding i : scheme) ∈ ((U : scheme.Opens) : Set scheme) := by
  rintro ⟨U, hU⟩
  let ι : (U : scheme.Opens).toScheme ⟶ scheme := (U : scheme.Opens).ι
  let p (i : Fin 2) : (U : scheme.Opens).toScheme := ⟨point i, hU i⟩
  have hp (i : Fin 2) : p i ∈ ι ⁻¹ᵁ Scheme.DoubleAlong.chart puncturedOpen i :=
    Scheme.DoubleAlong.point_mem_chart puncturedOpen i axisPoint
  obtain ⟨A₀, hA₀, hp₀, hsub₀⟩ := exists_isAffineOpen_mem_and_subset (hp 0)
  obtain ⟨A₁, hA₁, hp₁, hsub₁⟩ := exists_isAffineOpen_mem_and_subset (hp 1)
  let B₀ : scheme.Opens := ι ''ᵁ A₀
  let B₁ : scheme.Opens := ι ''ᵁ A₁
  have hB₀ : B₀ ≤ Scheme.DoubleAlong.chart puncturedOpen 0 := by
    rintro z ⟨a, ha, rfl⟩
    exact hsub₀ ha
  have hB₁ : B₁ ≤ Scheme.DoubleAlong.chart puncturedOpen 1 := by
    rintro z ⟨a, ha, rfl⟩
    exact hsub₁ ha
  have hcompact : IsCompact ((B₀ ⊓ B₁ : scheme.Opens) : Set scheme) := by
    have hc := (quasiSeparatedSpace_iff_forall_affineOpens.mp
      (inferInstance : QuasiSeparatedSpace (U : scheme.Opens).toScheme))
        ⟨A₀, hA₀⟩ ⟨A₁, hA₁⟩
    have himage : ι '' (↑A₀ ∩ ↑A₁) = ((B₀ ⊓ B₁ : scheme.Opens) : Set scheme) :=
      Set.image_inter ι.isOpenEmbedding.injective
    rw [← himage]
    exact hc.image ι.continuous
  let f₀ := Scheme.DoubleAlong.chartMap puncturedOpen 0
  let f₁ := Scheme.DoubleAlong.chartMap puncturedOpen 1
  let V : spectrum.Opens := (f₀ ⁻¹ᵁ B₀) ⊓ (f₁ ⁻¹ᵁ B₁)
  have hV : axisPoint ∈ V :=
    ⟨⟨p 0, hp₀, rfl⟩, ⟨p 1, hp₁, rfl⟩⟩
  apply puncturedOpen_inf_not_isCompact_of_mem V hV
  have hkrange : ((B₀ ⊓ B₁ : scheme.Opens) : Set scheme) ⊆ Set.range f₀ :=
    fun z hz ↦ hB₀ hz.1
  have hc := f₀.isOpenEmbedding.isEmbedding.isInducing.isCompact_preimage'
    hcompact hkrange
  have heq : f₀ ⁻¹' ((B₀ ⊓ B₁ : scheme.Opens) : Set scheme) =
      ((puncturedOpen ⊓ V : spectrum.Opens) : Set spectrum) := by
    ext a
    change (f₀ a ∈ B₀ ∧ f₀ a ∈ B₁) ↔
      a ∈ puncturedOpen ∧ f₀ a ∈ B₀ ∧ f₁ a ∈ B₁
    constructor
    · rintro ⟨ha₀, ha₁⟩
      obtain ⟨b, hb⟩ := hB₁ ha₁
      have hab : b = a := by
        have hfold := congrArg (fun z ↦ (Scheme.DoubleAlong.fold puncturedOpen) z) hb
        change (Scheme.DoubleAlong.fold puncturedOpen)
            (Scheme.DoubleAlong.point puncturedOpen 1 b) =
          (Scheme.DoubleAlong.fold puncturedOpen)
            (Scheme.DoubleAlong.point puncturedOpen 0 a) at hfold
        simpa only [Scheme.DoubleAlong.fold_point] using hfold
      subst b
      have he : f₀ a = f₁ a := hb.symm
      exact ⟨(Scheme.DoubleAlong.point_zero_eq_point_one_iff puncturedOpen a).mp he,
        ha₀, he ▸ ha₁⟩
    · rintro ⟨ha, ha₀, ha₁⟩
      have he : f₀ a = f₁ a :=
        Scheme.DoubleAlong.point_zero_eq_point_one_of_mem puncturedOpen a ha
      exact ⟨ha₀, he.symm ▸ ha₁⟩
  exact heq ▸ hc

/-- The doubled rational line arrangement is not quasi-separated. -/
theorem not_quasiSeparated : ¬ QuasiSeparatedSpace scheme := by
  intro h
  letI := h
  apply not_exists_affineOpen_containing_genericPoints
  exact Scheme.exists_affineOpen_containing_genericPoints
    (fun i ↦ genericPoints.component (genericPointsEmbedding i))
    (fun i ↦ (genericPointsEmbedding i : scheme))
    (fun i j hij hcomp ↦ hij (genericPointsEmbedding.injective
      (genericPoints.component_injective hcomp)))
    (fun i ↦ genericPoints.isGenericPoint (genericPointsEmbedding i))

/-- The doubled rational line arrangement is not quasi-separated, and its two distinguished
generic points have no common affine open neighborhood. -/
theorem counterexample :
    ¬ QuasiSeparatedSpace scheme ∧
      ¬ ∃ U : scheme.affineOpens,
        ∀ i, (genericPointsEmbedding i : scheme) ∈ ((U : scheme.Opens) : Set scheme) := by
  exact ⟨not_quasiSeparated, not_exists_affineOpen_containing_genericPoints⟩

end DoubleAlong
end AlgebraicGeometry.RationalLineArrangement
