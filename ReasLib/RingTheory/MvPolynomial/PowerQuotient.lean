module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Data.PNat.Basic
public import ReasLib.Algebra.Module.Graded.NatToInt
public import ReasLib.RingTheory.GradedAlgebra.Quotient
public import ReasLib.RingTheory.MvPolynomial.StandardGrading

/-!
# Quotients by powers of the variables

This file defines the quotient of a multivariable polynomial ring by fixed positive powers of
its variables, together with its standard grading, augmentation, and degree-zero piece.
-/

@[expose] public section

noncomputable section

universe u v

namespace MvPolynomial.PowerQuotient

variable {σ : Type u} {k : Type v} [CommRing k]

/-- The ideal generated by the fixed positive power of every coordinate variable. -/
def relationIdeal (e : ℕ+) : Ideal (MvPolynomial σ k) :=
  Ideal.span (Set.range fun i : σ => (MvPolynomial.X i : MvPolynomial σ k) ^ (e : ℕ))

/-- The quotient in which the chosen positive power of every coordinate variable vanishes. -/
abbrev Quotient (e : ℕ+) := MvPolynomial σ k ⧸ relationIdeal (σ := σ) (k := k) e

/-- The canonical algebra homomorphism to the coordinate-power quotient. -/
def quotientMap (e : ℕ+) : MvPolynomial σ k →ₐ[k] Quotient (σ := σ) (k := k) e :=
  Ideal.Quotient.mkₐ k (relationIdeal (σ := σ) (k := k) e)

/-- The coordinate-power relation ideal is homogeneous for the standard total-degree grading. -/
theorem relationIdeal_isHomogeneous (e : ℕ+) :
    (relationIdeal (σ := σ) (k := k) e).IsHomogeneous
      (MvPolynomial.standardGrading σ k) := sorry

/-- The degree pieces of the coordinate-power quotient induced by the standard grading. -/
def grading (e : ℕ+) (n : ℕ) :
    Submodule k (Quotient (σ := σ) (k := k) e) :=
  GradedAlgebra.Quotient.grading (MvPolynomial.standardGrading σ k)
    (relationIdeal (σ := σ) (k := k) e) n

/-- The canonical graded-algebra structure on the coordinate-power quotient. -/
@[reducible, instance]
def gradedAlgebra (e : ℕ+) :
    GradedAlgebra (grading (σ := σ) (k := k) e) :=
  GradedAlgebra.Quotient.gradedAlgebra (MvPolynomial.standardGrading σ k)
    (relationIdeal (σ := σ) (k := k) e) (relationIdeal_isHomogeneous e)

/-- Evaluation at the origin as an algebra homomorphism from the polynomial ring. -/
def zeroEval : MvPolynomial σ k →ₐ[k] k :=
  MvPolynomial.eval₂AlgHom k (fun _ : σ => (0 : k))

/-- The coordinate-power relation ideal is contained in the kernel of evaluation at the origin. -/
theorem relationIdeal_le_ker_zeroEval (e : ℕ+) :
    relationIdeal (σ := σ) (k := k) e ≤ RingHom.ker (zeroEval (σ := σ) (k := k)).toRingHom :=
  sorry

/-- The augmentation of the coordinate-power quotient obtained by evaluating at the origin. -/
def augmentationAlgHom (e : ℕ+) : Quotient (σ := σ) (k := k) e →ₐ[k] k :=
  Ideal.Quotient.liftₐ (relationIdeal (σ := σ) (k := k) e)
    (zeroEval (σ := σ) (k := k))
    (fun _ hf => RingHom.mem_ker.mp (relationIdeal_le_ker_zeroEval e hf))

/-- The augmentation computes on quotient representatives by evaluation at the origin. -/
theorem augmentation_apply_quotientMap (e : ℕ+) (f : MvPolynomial σ k) :
    augmentationAlgHom (σ := σ) (k := k) e (quotientMap e f) =
      zeroEval (σ := σ) (k := k) f := sorry

/-- The augmentation restricted to the degree-zero quotient piece. -/
def degreeZeroToBase (e : ℕ+) : grading (σ := σ) (k := k) e 0 →ₗ[k] k :=
  (augmentationAlgHom (σ := σ) (k := k) e).toLinearMap.comp
    (grading (σ := σ) (k := k) e 0).subtype

/-- The constant-polynomial embedding into the degree-zero quotient piece. -/
def baseToDegreeZero (e : ℕ+) : k →ₗ[k] grading (σ := σ) (k := k) e 0 :=
  LinearMap.codRestrict (grading (σ := σ) (k := k) e 0)
    ((quotientMap (σ := σ) (k := k) e).toLinearMap.comp
      (Algebra.linearMap k (MvPolynomial σ k)))
    (fun z => by
      simpa [grading, quotientMap, Algebra.linearMap_apply] using
        (GradedAlgebra.Quotient.mk_mem_grading
          (MvPolynomial.standardGrading σ k)
          (relationIdeal (σ := σ) (k := k) e)
          (@MvPolynomial.isHomogeneous_C σ k _ z)))

/-- Mapping a scalar into degree zero and then augmenting recovers that scalar. -/
theorem degreeZeroToBase_baseToDegreeZero (e : ℕ+) :
    (degreeZeroToBase (σ := σ) (k := k) e).comp
        (baseToDegreeZero (σ := σ) (k := k) e) = LinearMap.id := sorry

/-- Augmenting a degree-zero class and then embedding the scalar recovers the class. -/
theorem baseToDegreeZero_degreeZeroToBase (e : ℕ+) :
    (baseToDegreeZero (σ := σ) (k := k) e).comp
        (degreeZeroToBase (σ := σ) (k := k) e) = LinearMap.id := sorry

/-- The degree-zero piece of the coordinate-power quotient is canonically linearly equivalent
to the coefficient ring. -/
def degreeZeroLinearEquiv (e : ℕ+) :
    grading (σ := σ) (k := k) e 0 ≃ₗ[k] k :=
  LinearEquiv.ofLinear (degreeZeroToBase (σ := σ) (k := k) e)
    (baseToDegreeZero (σ := σ) (k := k) e)
    (degreeZeroToBase_baseToDegreeZero e) (baseToDegreeZero_degreeZeroToBase e)

/-- On a homogeneous representative, the degree-zero equivalence is constant coefficient. -/
theorem degreeZeroLinearEquiv_apply_of_representative (e : ℕ+)
    (x : grading (σ := σ) (k := k) e 0)
    (y : MvPolynomial.standardGrading σ k 0)
    (hy : (quotientMap (σ := σ) (k := k) e y :
      Quotient (σ := σ) (k := k) e) = x) :
    degreeZeroLinearEquiv (σ := σ) (k := k) e x = MvPolynomial.constantCoeff y.1 := sorry

/-- The integer grading of the coordinate-power quotient, with every negative piece equal to
the bottom submodule. -/
@[reducible]
def integerGrading (e : ℕ+) :
    ℤ → Submodule k (Quotient (σ := σ) (k := k) e) :=
  DirectSum.Decomposition.natToIntGrading (grading (σ := σ) (k := k) e)

/-- The standard polynomial grading acts homogeneously on the quotient grading. -/
@[instance]
theorem instGradedSMulGrading (e : ℕ+) :
    SetLike.GradedSMul (MvPolynomial.standardGrading σ k)
      (grading (σ := σ) (k := k) e) := sorry

/-- The degree-zero piece of the integer grading is canonically linearly equivalent to the
coefficient ring. -/
def integerDegreeZeroLinearEquiv (e : ℕ+) :
    integerGrading (σ := σ) (k := k) e 0 ≃ₗ[k] k :=
  (DirectSum.Decomposition.natToIntGradingEquiv
      (grading (σ := σ) (k := k) e) 0).symm.trans
    (degreeZeroLinearEquiv (σ := σ) (k := k) e)

end MvPolynomial.PowerQuotient
