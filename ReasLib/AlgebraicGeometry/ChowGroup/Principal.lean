module

public import ReasLib.AlgebraicGeometry.ChowGroup
public import ReasLib.AlgebraicGeometry.Scheme.Morphism.DimensionFunction
public import ReasLib.AlgebraicGeometry.Scheme.Variety
public import ReasLib.AlgebraicGeometry.Scheme.OverField
public import ReasLib.AlgebraicGeometry.Scheme.UniversallyCatenary.Affine
public import ReasLib.RingTheory.Catenary.Field

@[expose] public section

open CategoryTheory Set

noncomputable section

universe u

namespace AlgebraicGeometry.RationalEquivalence

/-- The set of degree-`k` cycles obtained by pushing a principal cycle on the reduced closure
of a point of dimension `k + 1` into the ambient scheme. -/
noncomputable def principalCycles {X : Scheme.{u}} [IsLocallyNoetherian X]
    (d : X → ℤ) [IsDimensionFunction d] (k : ℤ) : Set (CycleGroup X d k) :=
  { α | ∃ (x : X) (hx : d x = k + 1)
      (f : (Scheme.PointClosure.scheme x).functionFieldˣ),
    α = principal d k x hx f }

/-- Membership in `principalCycles d k` is an explicit presentation as a pushed-forward
principal cycle. -/
theorem mem_principalCycles_iff {X : Scheme.{u}} [IsLocallyNoetherian X]
    (d : X → ℤ) [IsDimensionFunction d] (k : ℤ) (α : CycleGroup X d k) :
    α ∈ principalCycles d k ↔
      ∃ (x : X) (hx : d x = k + 1)
        (f : (Scheme.PointClosure.scheme x).functionFieldˣ),
        α = principal d k x hx f := sorry

end AlgebraicGeometry.RationalEquivalence

namespace AlgebraicGeometry.SchemeOverField

/-- A principal cycle coming from a nonzero rational function on a dimension-`k + 1`
subvariety of a variety is rationally equivalent to zero. -/
theorem principal_isRationallyTrivial {K : Type u} [Field K]
    (X : SchemeOverField K) [Variety X] (k : ℤ) (x : X.left)
    (hx : X.hom.relativeDimensionFunction (fun _ : Spec (CommRingCat.of K) ↦ 0) x = k + 1)
    (f : (Scheme.PointClosure.scheme x).functionFieldˣ) :
    @RationalEquivalence.IsRationallyTrivial X.left
      (LocallyOfFiniteType.isLocallyNoetherian X.hom)
      (X.hom.relativeDimensionFunction (fun _ : Spec (CommRingCat.of K) ↦ 0)) inferInstance k
      (@RationalEquivalence.principal X.left
        (LocallyOfFiniteType.isLocallyNoetherian X.hom)
        (X.hom.relativeDimensionFunction (fun _ : Spec (CommRingCat.of K) ↦ 0)) inferInstance
        k x hx f) := sorry

/-- The subgroup of cycles rationally equivalent to zero on a variety is generated by
principal cycles from subvarieties of dimension `k + 1`. -/
theorem boundaries_eq_closure_principalCycles {K : Type u} [Field K]
    (X : SchemeOverField K) [Variety X] (k : ℤ) :
    @RationalEquivalence.boundaries X.left
        (LocallyOfFiniteType.isLocallyNoetherian X.hom)
        (X.hom.relativeDimensionFunction (fun _ : Spec (CommRingCat.of K) ↦ 0)) inferInstance k =
      AddSubgroup.closure
        (@RationalEquivalence.principalCycles X.left
          (LocallyOfFiniteType.isLocallyNoetherian X.hom)
          (X.hom.relativeDimensionFunction (fun _ : Spec (CommRingCat.of K) ↦ 0)) inferInstance
          k) := sorry

end AlgebraicGeometry.SchemeOverField
