module

public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
public import Mathlib.RingTheory.Flat.Basic
public import ReasLib.RingTheory.Algebra.TensorProduct.Multiplication
public import ReasLib.RingTheory.Sequence.Koszul.Regularity

/-!
# Koszul presentations of tensor-square multiplication

This module relates compatible Koszul-regular presentations of an algebra and its
tensor-square multiplication kernel to the determinant generating the kernel's annihilator.
-/

@[expose] public section

open scoped TensorProduct

universe u v w

namespace Algebra

/-- For compatible Koszul-regular presentations of a flat algebra and its tensor-square
multiplication kernel, the annihilator of that kernel is generated by the image of the
determinant of the change-of-generators matrix. -/
theorem tensorSquareMultiplication_ker_annihilator_eq_span_det
    {A : Type u} {P : Type v} {B : Type w}
    [CommRing A] [CommRing P] [CommRing B] [Algebra A P] [Algebra A B]
    [Module.Flat A B] {n : ℕ} (q : P →ₐ[A] B) (f : Fin n → P)
    (h_q : Function.Surjective q)
    (h_ker_q : RingHom.ker q.toRingHom = Ideal.span (Set.range f))
    (h_f : RingTheory.Sequence.IsKoszulRegularSequence f)
    (g : Fin n → P ⊗[A] B)
    (h_g : RingTheory.Sequence.IsKoszulRegularSequence g)
    (gij : Matrix (Fin n) (Fin n) (P ⊗[A] B))
    (h_g_span : Ideal.span (Set.range g) =
      RingHom.ker
        (Algebra.TensorProduct.productLeftAlgHom q (AlgHom.id A B)).toRingHom)
    (h_coeff : ∀ i,
      (Algebra.TensorProduct.includeLeft : P →ₐ[A] P ⊗[A] B) (f i) =
        ∑ j, gij i j * g j) :
    (RingHom.ker (Algebra.tensorSquareMultiplication A B)).annihilator =
      Ideal.span
        {(Algebra.TensorProduct.map q (AlgHom.id A B)) (Matrix.det gij)} := sorry

end Algebra
