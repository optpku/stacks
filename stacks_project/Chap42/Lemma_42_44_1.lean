module

import stacks_project.Chap42.Lemma_42_44_1_ZeroScheme
import stacks_project.Chap42.Definition_42_9_2_AssociatedCycle
import stacks_project.Chap42.«42_37_1_1_FundamentalCycle»
import stacks_project.Chap42.«42_39_1_1_ChernClassTheory»

open CategoryTheory

noncomputable section

universe u

namespace AlgebraicGeometry.ChernClass.Theory

/-- Lemma 42.44.1: if a rank-`r` pulled-back section has a zero scheme of the expected
dimension and its ideal is generically generated by a regular sequence of length `r`, then
the degree-`r` Chern class capped with `[X']ₙ` is `[Z(s)]ₙ₋ᵣ`. -/
@[stacks 0FA9]
theorem capFundamental_eq_sectionZeroClass
    {S X X' : Scheme.{u}} [UniversallyCatenary S] (δ : S → ℤ) [IsDimensionFunction δ]
    (p : X ⟶ S) [LocallyOfFiniteType p] (classes : ChernClass.Theory δ p)
    (E : X.Modules) [E.IsFiniteLocallyFree] (f : X' ⟶ X) [LocallyOfFiniteType f]
    (r : ℕ) [((Scheme.Modules.pullback f).obj E).IsFiniteLocallyFreeOfRank r]
    (s : ((Scheme.Modules.pullback f).obj E).sections) (n : ℤ)
    (hX' : (f ≫ p).closedSubschemeDeltaDimension δ ⊥ = (n : EInt))
    (hZ : (f ≫ p).closedSubschemeDeltaDimension δ
      (Scheme.Modules.sectionZeroIdeal ((Scheme.Modules.pullback f).obj E) r s) ≤
        ((n - (r : ℤ) : ℤ) : EInt))
    (hregular : ∀ ξ : genericPoints
      (Scheme.Modules.sectionZeroIdeal ((Scheme.Modules.pullback f).obj E) r s).subscheme,
      (f ≫ p).relativeDimensionFunction δ
          ((Scheme.Modules.sectionZeroIdeal
            ((Scheme.Modules.pullback f).obj E) r s).subschemeι ξ.1) = n - (r : ℤ) →
        Scheme.IdealSheafData.IsGeneratedByRegularSequenceAt
          (Scheme.Modules.sectionZeroIdeal ((Scheme.Modules.pullback f).obj E) r s)
          ((Scheme.Modules.sectionZeroIdeal
            ((Scheme.Modules.pullback f).obj E) r s).subschemeι ξ.1) r) :
    (classes.component E r).cap
        (Over.homMk f rfl : Over.mk (f ≫ p) ⟶ Over.mk p)
        (𝟙 (Over.mk (f ≫ p))) (Over.homMk f rfl) IsPullback.of_id_snd n
        (@chowClass X'
          (LocallyOfFiniteType.isLocallyNoetherian (f ≫ p))
          ((f ≫ p).relativeDimensionFunction δ) inferInstance n
          (@CycleGroup.fundamental X'
            (LocallyOfFiniteType.isLocallyNoetherian (f ≫ p))
            ((f ≫ p).relativeDimensionFunction δ) n)) =
      @chowClass X' (LocallyOfFiniteType.isLocallyNoetherian (f ≫ p))
        ((f ≫ p).relativeDimensionFunction δ) inferInstance (n - (r : ℤ))
        ((f ≫ p).closedSubschemeCycle δ
          (Scheme.Modules.sectionZeroIdeal ((Scheme.Modules.pullback f).obj E) r s)
          (n - (r : ℤ)) hZ) := sorry

end AlgebraicGeometry.ChernClass.Theory
