module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Sites.SchemesOver
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.PreRelation.QuotientSheaf
public import Mathlib.CategoryTheory.Sites.LeftExact

/-!
# Quotients of algebraic-space points of a pre-relation

The quotient of morphisms over a base by a pre-relation defines a presheaf on
algebraic spaces over that base. Its fppf sheafification and the fiber of the
scheme-site quotient sheaf receive canonical maps from the same sheafified
fiber quotient on schemes over the base.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Opposite ConcreteCategory
open AlgebraicGeometry.AlgebraicSpace.SchemesOver

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.PreRelation

/-- Precomposition in `Over B` preserves the image relation induced by a pre-relation. -/
theorem pointRel_precomp {S : Scheme.{u}} {B : AlgebraicSpace S} {U T T' : Over B}
    (P : PreRelation U) (f : T' ⟶ T) {x y : T ⟶ U} (h : P.pointRel T x y) :
    P.pointRel T' (f ≫ x) (f ≫ y) :=
  match h with
  | ⟨r, hx, hy⟩ =>
    ⟨f ≫ r,
      (Category.assoc f r P.t).trans (congrArg (fun g : T ⟶ U ↦ f ≫ g) hx),
      (Category.assoc f r P.s).trans (congrArg (fun g : T ⟶ U ↦ f ≫ g) hy)⟩

/-- The presheaf on `(Spaces / B)` sending `X` to the quotient of `X ⟶ U` by the
equivalence relation generated by the image of `j`. -/
def spacesQuotientPresheaf {S : Scheme.{u}} {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) : (Over B)ᵒᵖ ⥤ Type (u + 1) where
  obj T := Quot (P.pointRel T.unop)
  map {T T'} f :=
    TypeCat.ofHom <|
      Quot.map (fun x : T.unop ⟶ U ↦ f.unop ≫ x) fun _ _ h ↦
        P.pointRel_precomp f.unop h
  map_id T := by
    apply ConcreteCategory.ext_apply
    intro q
    refine Quot.inductionOn q ?_
    intro x
    change Quot.mk _ ((𝟙 T.unop) ≫ x) = Quot.mk _ x
    rw [Category.id_comp]
  map_comp f g := by
    apply ConcreteCategory.ext_apply
    intro q
    refine Quot.inductionOn q ?_
    intro x
    change Quot.mk _ ((g.unop ≫ f.unop) ≫ x) =
      Quot.mk _ (g.unop ≫ (f.unop ≫ x))
    rw [Category.assoc]

/-- The value of `spacesQuotientPresheaf` on `T` is the quotient by `pointRel`. -/
theorem spacesQuotientPresheaf_obj {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) (T : Over B) :
    P.spacesQuotientPresheaf.obj (op T) = Quot (P.pointRel T) :=
  rfl

/-- Restriction in `spacesQuotientPresheaf` is induced by precomposition on
representatives. -/
theorem spacesQuotientPresheaf_map_mk {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U T T' : Over B} (P : PreRelation U) (f : T' ⟶ T) (x : T ⟶ U) :
    P.spacesQuotientPresheaf.map f.op (Quot.mk (P.pointRel T) x) =
      Quot.mk (P.pointRel T') (f ≫ x) :=
  rfl

/-- The canonical projection from the Yoneda presheaf of `U` to
`spacesQuotientPresheaf`. -/
def spacesQuotientMk {S : Scheme.{u}} {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) : yoneda.obj U ⟶ P.spacesQuotientPresheaf where
  app T := TypeCat.ofHom fun x ↦ Quot.mk (P.pointRel T.unop) x
  naturality {_ _} f := by
    apply ConcreteCategory.ext_apply
    intro x
    rfl

/-- The quotient projection sends a morphism to its class. -/
theorem spacesQuotientMk_app {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) (T : Over B) (x : T ⟶ U) :
    P.spacesQuotientMk.app (op T) x = Quot.mk (P.pointRel T) x :=
  rfl

/-- Two morphisms have the same image in `spacesQuotientPresheaf` exactly when they
are related by the generated equivalence relation. -/
theorem spacesQuotientMk_eq_iff {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) (T : Over B) (x y : T ⟶ U) :
    P.spacesQuotientMk.app (op T) x = P.spacesQuotientMk.app (op T) y ↔
      _root_.Relation.EqvGen (P.pointRel T) x y :=
  Quot.eq

/-- The sheafification of `spacesQuotientPresheaf` on a Grothendieck topology on
`Over B`. -/
noncomputable def spacesQuotientSheaf {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (J : GrothendieckTopology (Over B)) (P : PreRelation U) :
    Sheaf J (Type (u + 1)) :=
  (presheafToSheaf J (Type (u + 1))).obj P.spacesQuotientPresheaf

/-- The underlying presheaf of `spacesQuotientSheaf` is the sheafification of
`spacesQuotientPresheaf`. -/
theorem spacesQuotientSheaf_val {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (J : GrothendieckTopology (Over B)) (P : PreRelation U) :
    (P.spacesQuotientSheaf J).obj = sheafify J P.spacesQuotientPresheaf :=
  rfl

/-- The Yoneda identification sends the image of `j` on `Over B` morphisms to the
image of `j` on scheme-valued points. -/
theorem pointRel_toSchemePointRel {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) {T : Over S} {σ : ofOver T ⟶ B}
    {x y : Over.mk σ ⟶ U} (h : P.pointRel (Over.mk σ) x y) :
    P.schemePointRel T (toFunctorOfPoints x) (toFunctorOfPoints y) :=
  match h with
  | ⟨r, hx, hy⟩ =>
    ⟨toFunctorOfPoints r,
      ((yonedaEquiv_comp
          (r.left : yoneda.obj T ⟶ P.left.left.functorOfPoints) P.t.left).symm).trans
        (congrArg yonedaEquiv (congrArg (fun f : Over.mk σ ⟶ U ↦ f.left) hx)),
      ((yonedaEquiv_comp
          (r.left : yoneda.obj T ⟶ P.left.left.functorOfPoints) P.s.left).symm).trans
        (congrArg yonedaEquiv (congrArg (fun f : Over.mk σ ⟶ U ↦ f.left) hy))⟩

/-- The generating image of `j` on the fiber of `U` over `σ`. -/
def schemePointFiberRel {S : Scheme.{u}} {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) {T : Over S} (σ : ofOver T ⟶ B) :
    schemePointFiber U σ → schemePointFiber U σ → Prop :=
  fun x y ↦ P.schemePointRel T x.val y.val

/-- Fibre relation is the restriction of `schemePointRel`. -/
theorem schemePointFiberRel_iff {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) {T : Over S} (σ : ofOver T ⟶ B)
    (x y : schemePointFiber U σ) :
    P.schemePointFiberRel σ x y ↔ P.schemePointRel T x.val y.val :=
  Iff.rfl

/-- The Yoneda identification sends the image of `j` on `Over B` morphisms into
the fiber relation over `σ`. -/
theorem pointRel_toSchemePointFiberRel {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) {T : Over S} {σ : ofOver T ⟶ B}
    {x y : Over.mk σ ⟶ U} (h : P.pointRel (Over.mk σ) x y) :
    P.schemePointFiberRel σ (toFunctorOfPointsFiber x) (toFunctorOfPointsFiber y) :=
  P.pointRel_toSchemePointRel h

/-- The inverse Yoneda identification sends the fiber relation into the image of
`j` on `Over B` morphisms. -/
theorem pointRel_ofSchemePointFiberRel {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) {T : Over S} {σ : ofOver T ⟶ B}
    {x y : schemePointFiber U σ} (h : P.schemePointFiberRel σ x y) :
    P.pointRel (Over.mk σ) (ofFunctorOfPointsFiber x) (ofFunctorOfPointsFiber y) :=
  sorry

/-- Restriction of schemes over `B` preserves the fiber relation. -/
theorem schemePointFiberRel_comap {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) {σ τ : CostructuredArrow (ofOverFunctor S) B}
    (f : τ ⟶ σ) {x y : schemePointFiber U σ.hom}
    (h : P.schemePointFiberRel σ.hom x y) :
    P.schemePointFiberRel τ.hom (schemePointFiber_comap f x)
      (schemePointFiber_comap f y) :=
  P.schemePointRel_precomp f.left h

/-- Classes in the fiber quotient map to the fiber of the usual scheme-point
quotient over `σ`. -/
theorem toBase_schemePointFiber {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) {T : Over S} {σ : ofOver T ⟶ B}
    (x : schemePointFiber U σ) :
    P.toBase.app (op T) (Quot.mk (P.schemePointRel T) x.val) = yonedaEquiv σ :=
  x.property

/-- The presheaf on schemes over `B` sending `σ : ofOver T ⟶ B` to the quotient
of the fiber `{x : U(T) // U(T) → B(T) sends x to σ}` by `schemePointRel`. -/
def fiberQuotientPresheaf {S : Scheme.{u}} {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) :
    (CostructuredArrow (ofOverFunctor S) B)ᵒᵖ ⥤ Type u where
  obj σ := Quot (P.schemePointFiberRel σ.unop.hom)
  map {σ τ} f :=
    TypeCat.ofHom <|
      Quot.map (schemePointFiber_comap f.unop) fun _ _ h ↦
        P.schemePointFiberRel_comap f.unop h
  map_id σ := by
    apply ConcreteCategory.ext_apply
    intro q
    refine Quot.inductionOn q ?_
    intro x
    change Quot.mk _ (schemePointFiber_comap (𝟙 σ.unop) x) = Quot.mk _ x
    apply congrArg (Quot.mk _)
    apply Subtype.ext
    exact U.left.functorOfPoints.map_id_apply (op σ.unop.left) x.val
  map_comp f g := by
    apply ConcreteCategory.ext_apply
    intro q
    refine Quot.inductionOn q ?_
    intro x
    change Quot.mk _ (schemePointFiber_comap (g.unop ≫ f.unop) x) =
      Quot.mk _ (schemePointFiber_comap g.unop (schemePointFiber_comap f.unop x))
    apply congrArg (Quot.mk _)
    apply Subtype.ext
    exact U.left.functorOfPoints.map_comp_apply f.unop.left.op g.unop.left.op x.val

/-- The value of `fiberQuotientPresheaf` at `σ` is the quotient of the fiber
over `σ`. -/
theorem fiberQuotientPresheaf_obj {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U)
    (σ : CostructuredArrow (ofOverFunctor S) B) :
    P.fiberQuotientPresheaf.obj (op σ) = Quot (P.schemePointFiberRel σ.hom) :=
  rfl

/-- Restriction in `fiberQuotientPresheaf` is induced by restriction of fiber
representatives. -/
theorem fiberQuotientPresheaf_map_mk {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U)
    {σ τ : CostructuredArrow (ofOverFunctor S) B} (f : τ ⟶ σ)
    (x : schemePointFiber U σ.hom) :
    P.fiberQuotientPresheaf.map f.op (Quot.mk (P.schemePointFiberRel σ.hom) x) =
      Quot.mk (P.schemePointFiberRel τ.hom) (schemePointFiber_comap f x) :=
  rfl

/-- Comparison of the `Over B` quotient presheaf, restricted to schemes over `B`,
with the universe-raised fiber of the scheme-point quotient over the structure
morphism. -/
def spacesQuotientComparison {S : Scheme.{u}} {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) :
    (CostructuredArrow.toOver (ofOverFunctor S) B).op ⋙ P.spacesQuotientPresheaf ⟶
      P.fiberQuotientPresheaf ⋙ uliftFunctor.{u + 1, u} where
  app σ :=
    TypeCat.ofHom fun q ↦
      ULift.up
        (Quot.map (fun f : Over.mk σ.unop.hom ⟶ U ↦ toFunctorOfPointsFiber f)
          (fun _ _ h ↦ P.pointRel_toSchemePointFiberRel h) q)
  naturality := sorry

/-- The component of `spacesQuotientComparison` at a scheme over `B` is `ULift.up`
of the quotient map induced by `toFunctorOfPointsFiber`. -/
theorem spacesQuotientComparison_app {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U)
    (σ : CostructuredArrow (ofOverFunctor S) B)
    (x : Over.mk σ.hom ⟶ U) :
    P.spacesQuotientComparison.app (op σ)
        (Quot.mk (P.pointRel (Over.mk σ.hom)) x) =
      ULift.up (Quot.mk (P.schemePointFiberRel σ.hom)
        (toFunctorOfPointsFiber x)) :=
  rfl

/-- Inverse comparison of the universe-raised fiber of the scheme-point quotient
with the restricted `Over B` quotient presheaf. -/
def spacesQuotientComparisonInv {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) :
    P.fiberQuotientPresheaf ⋙ uliftFunctor.{u + 1, u} ⟶
      (CostructuredArrow.toOver (ofOverFunctor S) B).op ⋙ P.spacesQuotientPresheaf where
  app σ :=
    TypeCat.ofHom fun q ↦
      Quot.map (fun x : schemePointFiber U σ.unop.hom ↦ ofFunctorOfPointsFiber x)
        (fun _ _ h ↦ P.pointRel_ofSchemePointFiberRel h) q.down
  naturality := sorry

/-- The component of `spacesQuotientComparisonInv` at a scheme over `B` is the
quotient map induced by `ofFunctorOfPointsFiber`. -/
theorem spacesQuotientComparisonInv_app {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U)
    (σ : CostructuredArrow (ofOverFunctor S) B)
    (x : schemePointFiber U σ.hom) :
    P.spacesQuotientComparisonInv.app (op σ)
        (ULift.up (Quot.mk (P.schemePointFiberRel σ.hom) x)) =
      Quot.mk (P.pointRel (Over.mk σ.hom)) (ofFunctorOfPointsFiber x) :=
  rfl

/-- The continuous pullback of the fppf `Over B` quotient sheaf along schemes over
`B`. -/
noncomputable def spacesFppfQuotientPullback {S : Scheme.{u}}
    {B : AlgebraicSpace S} {U : Over B} (P : PreRelation U) :
    Sheaf (SchemesOver.fppfTopology B) (Type (u + 1)) :=
  ((CostructuredArrow.toOver (ofOverFunctor S) B).sheafPushforwardContinuous (Type (u + 1))
      (SchemesOver.fppfTopology B) ((fppfPrecoverage S).toGrothendieck.over B)).obj
    (P.spacesQuotientSheaf ((fppfPrecoverage S).toGrothendieck.over B))

/-- The underlying presheaf of `spacesFppfQuotientPullback` is the restriction of
the sheafified `Over B` quotient along the canonical schemes-over-base functor. -/
theorem spacesFppfQuotientPullback_obj {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) :
    (spacesFppfQuotientPullback P).obj =
      (CostructuredArrow.toOver (ofOverFunctor S) B).op ⋙
        (P.spacesQuotientSheaf ((fppfPrecoverage S).toGrothendieck.over B)).obj :=
  rfl

/-- The sheafification unit of the restricted `Over B` quotient presheaf, valued
in the continuous pullback of the fppf variant sheaf. -/
noncomputable def spacesFppfQuotientRestrictionUnit {S : Scheme.{u}}
    {B : AlgebraicSpace S} {U : Over B} (P : PreRelation U) :
    (presheafToSheaf (SchemesOver.fppfTopology B) (Type (u + 1))).obj
      ((CostructuredArrow.toOver (ofOverFunctor S) B).op ⋙ P.spacesQuotientPresheaf) ⟶
    spacesFppfQuotientPullback P :=
  ((sheafificationAdjunction (SchemesOver.fppfTopology B) (Type (u + 1))).homEquiv
      ((CostructuredArrow.toOver (ofOverFunctor S) B).op ⋙ P.spacesQuotientPresheaf)
      (spacesFppfQuotientPullback P)).symm
    (Functor.whiskerLeft (CostructuredArrow.toOver (ofOverFunctor S) B).op
      (toSheafify ((fppfPrecoverage S).toGrothendieck.over B)
        P.spacesQuotientPresheaf))

/-- The sheaf morphism on schemes over `B` from the sheafified fiber of the usual
scheme-point quotient to the continuous pullback of the fppf variant sheaf. -/
noncomputable def spacesFppfQuotientComparison {S : Scheme.{u}}
    {B : AlgebraicSpace S} {U : Over B} (P : PreRelation U) :
    (presheafToSheaf (SchemesOver.fppfTopology B) (Type (u + 1))).obj
      (P.fiberQuotientPresheaf ⋙ uliftFunctor.{u + 1, u}) ⟶
    spacesFppfQuotientPullback P :=
  (presheafToSheaf (SchemesOver.fppfTopology B) (Type (u + 1))).map
      P.spacesQuotientComparisonInv ≫
    P.spacesFppfQuotientRestrictionUnit

/-- `spacesFppfQuotientComparison` is sheafification of the inverse Yoneda fiber
map, composed with the sheafification unit into the continuous pullback. -/
theorem spacesFppfQuotientComparison_val {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) :
    spacesFppfQuotientComparison P =
      (presheafToSheaf (SchemesOver.fppfTopology B) (Type (u + 1))).map
          P.spacesQuotientComparisonInv ≫
        P.spacesFppfQuotientRestrictionUnit :=
  rfl

/-- The fppf sheafification of the quotient of morphisms over the base by the
equivalence relation generated by a pre-relation. -/
noncomputable def spacesFppfQuotientSheaf {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) :
    Sheaf ((fppfPrecoverage S).toGrothendieck.over B) (Type (u + 1)) :=
  P.spacesQuotientSheaf ((fppfPrecoverage S).toGrothendieck.over B)

/-- The underlying presheaf of the fppf quotient sheaf is the sheafification of
the quotient presheaf of morphisms over the base. -/
theorem spacesFppfQuotientSheaf_val {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) :
    (spacesFppfQuotientSheaf P).obj =
      sheafify ((fppfPrecoverage S).toGrothendieck.over B) P.spacesQuotientPresheaf :=
  rfl

/-- Continuous restriction of the fppf quotient sheaf to schemes over the base
is the pullback quotient sheaf. -/
theorem spacesFppfQuotientSheaf_pullback {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) :
    ((CostructuredArrow.toOver (ofOverFunctor S) B).sheafPushforwardContinuous
        (Type (u + 1)) (SchemesOver.fppfTopology B)
        ((fppfPrecoverage S).toGrothendieck.over B)).obj
      (spacesFppfQuotientSheaf P) = P.spacesFppfQuotientPullback :=
  rfl

/-- The canonical map from the sheafified fiber quotient to the restriction of
the algebraic-space quotient sheaf is an isomorphism. -/
instance spacesFppfQuotientComparison_isIso {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) : IsIso P.spacesFppfQuotientComparison :=
  sorry

/-- Restriction of the scheme-site quotient sheaf preserves its fiber over a
specified morphism to the base. -/
theorem quotientSheafFiber_map_hom {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U)
    {σ τ : CostructuredArrow (ofOverFunctor S) B} (f : τ ⟶ σ)
    (q : P.quotientSheaf.obj.obj (op σ.left))
    (hq : P.toBaseSheaf.hom.app (op σ.left) q = ULift.up (yonedaEquiv σ.hom)) :
    P.toBaseSheaf.hom.app (op τ.left)
        (P.quotientSheaf.obj.map f.left.op q) = ULift.up (yonedaEquiv τ.hom) :=
  sorry

/-- The fiber of the scheme-site quotient sheaf over the specified base point,
as a presheaf on schemes over the base. -/
def quotientSheafFiberPresheaf {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) :
    (CostructuredArrow (ofOverFunctor S) B)ᵒᵖ ⥤ Type (u + 1) where
  obj σ := {q : P.quotientSheaf.obj.obj (op σ.unop.left) //
    P.toBaseSheaf.hom.app (op σ.unop.left) q = ULift.up (yonedaEquiv σ.unop.hom)}
  map f := TypeCat.ofHom fun q ↦
    ⟨P.quotientSheaf.obj.map f.unop.left.op q.val,
      P.quotientSheafFiber_map_hom f.unop q.val q.property⟩
  map_id σ := by
    apply ConcreteCategory.ext_apply
    intro q
    apply Subtype.ext
    exact P.quotientSheaf.obj.map_id_apply (op σ.unop.left) q.val
  map_comp f g := by
    apply ConcreteCategory.ext_apply
    intro q
    apply Subtype.ext
    exact P.quotientSheaf.obj.map_comp_apply f.unop.left.op g.unop.left.op q.val

/-- The fiber of the scheme-site quotient sheaf is a sheaf on schemes over the
base for the induced fppf topology. -/
theorem quotientSheafFiber_isSheaf {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) :
    Presheaf.IsSheaf (SchemesOver.fppfTopology B) P.quotientSheafFiberPresheaf :=
  sorry

/-- The fppf sheaf of sections of the scheme-site quotient sheaf lying over the
specified morphism to the base. -/
def quotientSheafFiber {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) :
    Sheaf (SchemesOver.fppfTopology B) (Type (u + 1)) :=
  ⟨P.quotientSheafFiberPresheaf, P.quotientSheafFiber_isSheaf⟩

/-- Sections of the quotient fiber sheaf are exactly sections of the original
quotient sheaf with the prescribed image under the base map. -/
theorem quotientSheafFiber_obj {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) (σ : CostructuredArrow (ofOverFunctor S) B) :
    P.quotientSheafFiber.obj.obj (op σ) =
      {q : P.quotientSheaf.obj.obj (op σ.left) //
        P.toBaseSheaf.hom.app (op σ.left) q = ULift.up (yonedaEquiv σ.hom)} :=
  rfl

/-- The base image of the quotient class of a point is the universe lift of the
base image of that point. -/
theorem quotientClass_toBaseSheaf {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) (T : Over S)
    (x : U.left.functorOfPoints.obj (op T)) :
    P.toBaseSheaf.hom.app (op T) (P.quotientClass T x) =
      ULift.up (U.hom.app (op T) x) :=
  sorry

/-- Points related by the generating pre-relation have the same quotient class
in the scheme-site quotient sheaf. -/
theorem quotientClass_eq_of_schemePointRel {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) {T : Over S}
    {x y : U.left.functorOfPoints.obj (op T)} (h : P.schemePointRel T x y) :
    P.quotientClass T x = P.quotientClass T y :=
  sorry

/-- A fiber quotient class determines a section of the fiber of the original
scheme-site quotient sheaf. -/
def fiberQuotientToQuotientSheafFiber {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) :
    P.fiberQuotientPresheaf ⋙ uliftFunctor.{u + 1, u} ⟶ P.quotientSheafFiber.obj where
  app σ := TypeCat.ofHom fun q ↦
    Quot.lift
      (fun x : schemePointFiber U σ.unop.hom ↦
        (⟨P.quotientClass σ.unop.left x.val,
          (P.quotientClass_toBaseSheaf σ.unop.left x.val).trans
            (congrArg ULift.up x.property)⟩ :
          P.quotientSheafFiber.obj.obj σ))
      (fun _ _ h ↦ Subtype.ext (P.quotientClass_eq_of_schemePointRel h)) q.down
  naturality := sorry

/-- The map from fiber quotient classes to the quotient fiber sends a
representative to its original quotient class. -/
theorem fiberQuotientToQuotientSheafFiber_app_mk {S : Scheme.{u}}
    {B : AlgebraicSpace S} {U : Over B} (P : PreRelation U)
    (σ : CostructuredArrow (ofOverFunctor S) B) (x : schemePointFiber U σ.hom) :
    (P.fiberQuotientToQuotientSheafFiber.app (op σ)
      (ULift.up (Quot.mk (P.schemePointFiberRel σ.hom) x))).val =
        P.quotientClass σ.left x.val :=
  rfl

/-- The canonical extension of the fiber quotient map by the sheafification
adjunction into the fiber of the scheme-site quotient sheaf. -/
def schemeFppfQuotientComparison {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) :
    (presheafToSheaf (SchemesOver.fppfTopology B) (Type (u + 1))).obj
      (P.fiberQuotientPresheaf ⋙ uliftFunctor.{u + 1, u}) ⟶ P.quotientSheafFiber :=
  ((sheafificationAdjunction (SchemesOver.fppfTopology B) (Type (u + 1))).homEquiv
    (P.fiberQuotientPresheaf ⋙ uliftFunctor.{u + 1, u}) P.quotientSheafFiber).symm
      P.fiberQuotientToQuotientSheafFiber

/-- The canonical map from the sheafified fiber quotient to the fiber of the
scheme-site quotient sheaf is an isomorphism. -/
instance schemeFppfQuotientComparison_isIso {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) : IsIso P.schemeFppfQuotientComparison :=
  sorry

/-- The algebraic-space quotient sheaf and the fiber of the scheme-site quotient
sheaf are canonically identified through their common sheafified fiber quotient. -/
theorem spacesFppfQuotient_agrees {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U : Over B} (P : PreRelation U) :
    IsIso P.spacesFppfQuotientComparison ∧ IsIso P.schemeFppfQuotientComparison :=
  ⟨inferInstance, inferInstance⟩

end AlgebraicGeometry.AlgebraicSpace.PreRelation
