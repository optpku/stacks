module

public import Mathlib.CategoryTheory.Comma.Over.Basic
public import ReasLib.CategoryTheory.Limits.FormalCoproduct.Equivalence
public import Mathlib.CategoryTheory.Sites.Precoverage

/-!
# Covering formal coproducts and tautological equivalence

This module records the covering predicate for an indexed family with a fixed
target and the componentwise-isomorphism relation between formal coproducts.
-/

@[expose] public section

universe w v u

namespace CategoryTheory.Limits.FormalCoproduct

variable {C : Type u} [Category.{v} C]

namespace Over

/-- Build a formal coproduct in `C / X` from an indexed family of arrows to `X`. -/
def ofArrows {X : C} {I : Type w} (U : I → C) (π : ∀ i : I, U i ⟶ X) :
    FormalCoproduct.{w} (CategoryTheory.Over X) :=
  ⟨I, fun i ↦ CategoryTheory.Over.mk (π i)⟩

/-- The index type of a fixed-target formal coproduct is the supplied index type. -/
@[simp] theorem ofArrows_index {X : C} {I : Type w} (U : I → C)
    (π : ∀ i : I, U i ⟶ X) :
    (ofArrows U π).I = I := sorry

/-- Each object of a fixed-target formal coproduct is its supplied arrow in the slice. -/
@[simp] theorem ofArrows_obj {X : C} {I : Type w} (U : I → C)
    (π : ∀ i : I, U i ⟶ X) (i : I) :
    (ofArrows U π).obj i = CategoryTheory.Over.mk (π i) := sorry

/-- A fixed-target formal coproduct covers when its displayed arrows form a covering presieve. -/
def IsCovering {X : C} (P : Precoverage C)
    (𝒰 : FormalCoproduct.{w} (CategoryTheory.Over X)) : Prop :=
  Presieve.ofArrows (fun i ↦ (𝒰.obj i).left) (fun i ↦ (𝒰.obj i).hom) ∈ P X

/-- Covering is membership of the presieve generated by the displayed arrows. -/
theorem isCovering_iff {X : C} (P : Precoverage C)
    (𝒰 : FormalCoproduct.{w} (CategoryTheory.Over X)) :
    IsCovering P 𝒰 ↔
      Presieve.ofArrows (fun i ↦ (𝒰.obj i).left) (fun i ↦ (𝒰.obj i).hom) ∈ P X := sorry

end Over

end CategoryTheory.Limits.FormalCoproduct
