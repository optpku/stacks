module

public import Mathlib.Algebra.CharP.Defs
public import Mathlib.Algebra.Field.Defs
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Algebra.Polynomial.AlgebraMap
public import Mathlib.Algebra.Polynomial.BigOperators
public import Mathlib.Algebra.Ring.Parity
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import Mathlib.RingTheory.PicardGroup

/-!
# Affine hyperelliptic coordinate rings

The affine model `k[x, y] / (y ^ 2 - ∏ i, (x - t i))` and the point ideal
`(y, x - t i)` defining a nontrivial Picard class for distinct roots of odd
degree at least three over a field of characteristic different from two.
-/

@[expose] public section

noncomputable section

universe u

open MvPolynomial

namespace AffineHyperelliptic

/-- The split polynomial `∏ i, (Polynomial.X - Polynomial.C (t i))`. -/
def prodXSubC {k : Type u} [Field k] {n : ℕ} (t : Fin n → k) : Polynomial k :=
  ∏ i, (Polynomial.X - Polynomial.C (t i))

/-- The Weierstrass equation `Y ^ 2 - f(X)` in `k[x, y]`, with `X 0` corresponding
to `x` and `X 1` corresponding to `y`. -/
def equation {k : Type u} [Field k] {n : ℕ} (t : Fin n → k) : MvPolynomial (Fin 2) k :=
  X 1 ^ 2 - Polynomial.aeval (X 0) (prodXSubC t)

/-- The principal relation ideal generated by `equation t`. -/
def relationIdeal {k : Type u} [Field k] {n : ℕ} (t : Fin n → k) :
    Ideal (MvPolynomial (Fin 2) k) :=
  Ideal.span {equation t}

/-- The coordinate ring `k[x, y] / (y ^ 2 - ∏ i, (x - t i))`. -/
abbrev CoordinateRing {k : Type u} [Field k] {n : ℕ} (t : Fin n → k) : Type u :=
  MvPolynomial (Fin 2) k ⧸ relationIdeal t

/-- The class of the first coordinate `x` in the quotient ring. -/
def x {k : Type u} [Field k] {n : ℕ} (t : Fin n → k) : CoordinateRing t :=
  Ideal.Quotient.mk (relationIdeal t) (X 0)

/-- The class of the second coordinate `y` in the quotient ring. -/
def y {k : Type u} [Field k] {n : ℕ} (t : Fin n → k) : CoordinateRing t :=
  Ideal.Quotient.mk (relationIdeal t) (X 1)

/-- The defining equation vanishes in the coordinate ring. -/
theorem mk_equation_eq_zero {k : Type u} [Field k] {n : ℕ} (t : Fin n → k) :
    Ideal.Quotient.mk (relationIdeal t) (equation t) = 0 := sorry

/-- The point ideal `(y, x - t i)` in `CoordinateRing t`. -/
def pointIdeal {k : Type u} [Field k] {n : ℕ} (t : Fin n → k) (i : Fin n) :
    Ideal (CoordinateRing t) :=
  Ideal.span {y t, Ideal.Quotient.mk (relationIdeal t) (X 0 - C (t i))}

/-- `pointIdeal t i` is generated by `y t` and the class of `x - t i`. -/
theorem pointIdeal_span {k : Type u} [Field k] {n : ℕ} (t : Fin n → k) (i : Fin n) :
    pointIdeal t i =
      Ideal.span {y t, x t - Ideal.Quotient.mk (relationIdeal t) (C (t i))} := sorry

/-- Over a field of characteristic different from two, the point ideal of a split
odd-degree model with distinct roots and degree at least three is invertible. -/
theorem pointIdeal_invertible {k : Type u} [Field k] (hchar : ringChar k ≠ 2)
    {n : ℕ} (hn : 3 ≤ n) (hodd : Odd n) (t : Fin n → k) (ht : Function.Injective t)
    (i : Fin n) :
    Module.Invertible (CoordinateRing t) (pointIdeal t i) := sorry

/-- Over a field of characteristic different from two, an invertible point ideal
of a split odd-degree model with distinct roots and degree at least three has
nontrivial Picard class. -/
theorem pic_mk_pointIdeal_ne_one {k : Type u} [Field k] (hchar : ringChar k ≠ 2)
    {n : ℕ} (hn : 3 ≤ n) (hodd : Odd n) (t : Fin n → k) (ht : Function.Injective t)
    (i : Fin n) [h_inv : Module.Invertible (CoordinateRing t) (pointIdeal t i)] :
    CommRing.Pic.mk (CoordinateRing t) (pointIdeal t i) ≠ 1 := sorry

/-- Over a field of characteristic different from two, the Picard group of a split
odd-degree affine hyperelliptic coordinate ring with distinct roots and degree
at least three is nontrivial. -/
theorem pic_nontrivial {k : Type u} [Field k] (hchar : ringChar k ≠ 2)
    {n : ℕ} (hn : 3 ≤ n) (hodd : Odd n) (t : Fin n → k) (ht : Function.Injective t) :
    Nontrivial (CommRing.Pic (CoordinateRing t)) := sorry

end AffineHyperelliptic
