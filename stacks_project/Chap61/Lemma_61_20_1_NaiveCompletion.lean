module

public import Mathlib.CategoryTheory.Sites.ConstantSheaf
public import Mathlib.RingTheory.Noetherian.Defs
public import ReasLib.RingTheory.Ideal.FiniteGeneration.Family
public import stacks_project.Chap52.Lemma_52_6_16_ExtendedCech
public import stacks_project.Chap52.Remark_52_6_13_Comparison_with_completion
public import stacks_project.Chap52.Remark_52_6_15_Completed_tensor_product
import Mathlib.Tactic.CrossRefAttribute

/-!
# Constant Noetherian ring and ideal sheaves

The constant sheaf `underline(Λ)` and the constant ideal sheaf of `I ⊂ Λ` used by
derived completion in the constant Noetherian case.
-/

@[expose] public section

open CategoryTheory Opposite
open SheafOfModules.RingedSite
open SheafOfModules.RingedSite.ExtendedCech
open SheafOfModules.RingedSite.IdealSheaf

noncomputable section

universe u

namespace RingedSite.Hom.ModuleDerived

variable {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)
variable [J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})]
variable [J.HasSheafCompose (forget₂ RingCat.{u} AddCommGrpCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable [HasWeakSheafify J CommRingCat.{u}]
variable [J.WEqualsLocallyBijective CommRingCat.{u}]
variable {Λ : Type u} [CommRing Λ]

/-- The constant sheaf of commutative rings `underline(Λ)` on a site. -/
abbrev constantRingSheaf (Λ : Type u) [CommRing Λ] : Sheaf J CommRingCat.{u} :=
  (constantSheaf J CommRingCat.{u}).obj (CommRingCat.of Λ)

/-- `constantRingSheaf` is the constant sheaf on `CommRingCat.of Λ`. -/
theorem constantRingSheaf_obj (Λ : Type u) [CommRing Λ] :
    constantRingSheaf J Λ =
      (constantSheaf J CommRingCat.{u}).obj (CommRingCat.of Λ) := sorry

/-- The sheafification unit of the constant ring presheaf with value `Λ`. -/
abbrev constantRingUnit (Λ : Type u) [CommRing Λ] :
    (Functor.const Cᵒᵖ).obj (CommRingCat.of Λ) ⟶ (constantRingSheaf J Λ).obj :=
  toSheafify J ((Functor.const Cᵒᵖ).obj (CommRingCat.of Λ))

/-- `constantRingUnit` is the sheafification unit of the constant ring presheaf. -/
theorem constantRingUnit_eq (Λ : Type u) [CommRing Λ] :
    constantRingUnit J Λ =
      toSheafify J ((Functor.const Cᵒᵖ).obj (CommRingCat.of Λ)) := sorry

/-- The image of a ring element under the sheafification unit of the constant ring
presheaf. -/
def constantSectionValue (a : Λ) (U : Cᵒᵖ) :
    (constantRingSheaf J Λ).obj.obj U :=
  ((constantRingUnit J Λ).app U).hom a

/-- Evaluating `constantSectionValue` applies the sheafification unit at `U`. -/
theorem constantSectionValue_apply (a : Λ) (U : Cᵒᵖ) :
    constantSectionValue J a U = ((constantRingUnit J Λ).app U).hom a := sorry

/-- Restriction of a constant ring-element section is the corresponding constant
section. -/
theorem constantSectionValue_naturality (a : Λ) {U V : Cᵒᵖ} (f : U ⟶ V) :
    (unitModule J (constantRingSheaf J Λ)).val.map f
        (constantSectionValue J a U) =
      constantSectionValue J a V := sorry

/-- The global section of the structure module of `underline(Λ)` associated to an
element of `Λ`. -/
def constantSection (a : Λ) :
    (unitModule J (constantRingSheaf J Λ)).sections :=
  PresheafOfModules.sectionsMk
    (fun U ↦ constantSectionValue J a U)
    (fun {_ _} f ↦ constantSectionValue_naturality J a f)

/-- Evaluating a constant global section recovers `constantSectionValue`. -/
theorem constantSection_apply (a : Λ) (U : Cᵒᵖ) :
    (constantSection J a).val U = constantSectionValue J a U := sorry

variable [IsNoetherianRing Λ]

/-- The constant ideal sheaf of `I ⊂ Λ`, generated by the images of a finite
generating family of `I` as global sections of `underline(Λ)`. -/
def constantIdealSheaf (I : Ideal Λ) :
    Subobject (unitModule J (constantRingSheaf J Λ)) :=
  let G := Ideal.FiniteGeneratingFamily.ofFG I I.fg_of_isNoetherianRing
  generatedIdeal (fun i : G.Index ↦ constantSection J (G.generator i))

/-- `constantIdealSheaf` is the ideal sheaf generated by the constant sections of
a finite generating family of `I`. -/
theorem constantIdealSheaf_def (I : Ideal Λ) :
    constantIdealSheaf J I =
      let G := Ideal.FiniteGeneratingFamily.ofFG I I.fg_of_isNoetherianRing
      generatedIdeal (fun i : G.Index ↦ constantSection J (G.generator i)) :=
  sorry

/-- Over every object of the site, the section ideal of `constantIdealSheaf` is
the extension of `I` along the sheafification unit of the constant ring
presheaf. -/
theorem constantIdealSheaf_spec (I : Ideal Λ) (U : Cᵒᵖ) :
    sections (constantIdealSheaf J I) U =
      Ideal.map ((constantRingUnit J Λ).app U).hom I := sorry

/-- Membership in the section ideal of `constantIdealSheaf` is membership in the
extended ideal of `I`. -/
theorem mem_constantIdealSheaf (I : Ideal Λ) (U : Cᵒᵖ)
    (x : (constantRingSheaf J Λ).obj.obj U) :
    x ∈ sections (constantIdealSheaf J I) U ↔
      x ∈ Ideal.map ((constantRingUnit J Λ).app U).hom I := sorry

/-- The constant ideal sheaf of an ideal of a Noetherian ring is of finite type. -/
instance constantIdealSheaf_isFiniteType (I : Ideal Λ) :
    (constantIdealSheaf J I :
      ringedSiteModuleCategory J (constantRingSheaf J Λ)).IsFiniteType :=
  sorry

end RingedSite.Hom.ModuleDerived
