module

public import Mathlib.AlgebraicTopology.SimplicialObject.Basic
public import Mathlib.CategoryTheory.Limits.Shapes.FiniteProducts
public import Mathlib.CategoryTheory.Subobject.Limits
public import Mathlib.Combinatorics.Quiver.ReflQuiver
public import Mathlib.Data.Finite.Sigma
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Simplicial subobjects generated in bounded degree

This file constructs the canonical subobject of a simplicial object generated by all simplices in
degrees at most `n`. The nonempty finite supremum needs images and binary coproducts, while the
simplicial structure additionally needs pullbacks. The abelian hypothesis appears only in the
normalized-Moore vanishing theorem.
-/

@[expose] public section

open CategoryTheory.Limits Opposite
open scoped Simplicial

noncomputable section

universe u v

namespace CategoryTheory.SimplicialObject

namespace generated

/-- A generator in simplicial degree `Delta` coming from a degree at most `n`. -/
@[stacks 017Y "bounded-degree generator"]
abbrev Generator (n : ℕ) (Delta : SimplexCategory) :=
  Σ i : Fin (n + 1), Delta ⟶ ⦋i.1⦌

/-- The finite collection of all bounded-degree generators. -/
@[stacks 017Y "finite collection of bounded-degree generators"]
noncomputable def generators (n : ℕ) (Delta : SimplexCategory) : Finset (Generator n Delta) :=
  (Set.toFinite (Set.univ : Set (Generator n Delta))).toFinset

/-- Every bounded-degree generator belongs to `generators`. -/
@[simp, stacks 017Y "bounded-degree generator membership"]
theorem mem_generators {n : ℕ} {Delta : SimplexCategory} (p : Generator n Delta) :
    p ∈ generators n Delta := sorry

/-- The bounded-degree generator collection is nonempty. -/
@[stacks 017Y "bounded-degree generator collection nonempty"]
theorem generators_nonempty (n : ℕ) (Delta : SimplexCategory) :
    (generators n Delta).Nonempty := sorry

end generated

section DegreeObject

variable {A : Type u} [Category.{v} A] [HasImages A] [HasBinaryCoproducts A]

/-- The degree-`Delta` subobject generated by simplices in degrees at most `n`. -/
@[stacks 017Y "degreewise subobject generated in bounded degree"]
noncomputable def generated.degree (U : SimplicialObject A) (n : ℕ)
    (Delta : SimplexCategory) : Subobject (U.obj (op Delta)) :=
  (generated.generators n Delta).sup'
    (generated.generators_nonempty n Delta)
    (fun p ↦ imageSubobject (U.map p.2.op))

end DegreeObject

section SimplicialStructure

variable {A : Type u} [Category.{v} A]
variable [HasPullbacks A] [HasImages A] [HasBinaryCoproducts A]

namespace generated.degree

/-- The degreewise generated subobjects are stable under every simplicial structure map. -/
@[stacks 017Y "bounded-degree stability under pullback"]
theorem le_pullback (U : SimplicialObject A) (n : ℕ)
    {Delta Delta' : SimplexCategory} (theta : Delta' ⟶ Delta) :
    generated.degree U n Delta ≤
      (Subobject.pullback (U.map theta.op)).obj (generated.degree U n Delta') := sorry

/-- The simplicial structure map on the bounded-degree generated subobject. -/
@[stacks 017Y "bounded-degree structure map"]
def map (U : SimplicialObject A) (n : ℕ)
    {Delta Delta' : SimplexCategory} (theta : Delta' ⟶ Delta) :
    (generated.degree U n Delta : A) ⟶ (generated.degree U n Delta' : A) :=
  Subobject.ofLE _ _ (le_pullback U n theta) ≫
    Subobject.pullbackπ (U.map theta.op) (generated.degree U n Delta')

/-- The generated structure map commutes with the inclusions into the ambient simplicial
object. -/
@[reassoc, stacks 017Y "bounded-degree inclusion naturality"]
theorem map_arrow (U : SimplicialObject A) (n : ℕ)
    {Delta Delta' : SimplexCategory} (theta : Delta' ⟶ Delta) :
    map U n theta ≫ (generated.degree U n Delta').arrow =
      (generated.degree U n Delta).arrow ≫ U.map theta.op := sorry

/-- The raw bounded-degree generated structure map preserves identity morphisms. -/
@[stacks 017Y "bounded-degree generated simplicial identity law"]
theorem map_id (U : SimplicialObject A) (n : ℕ)
    (Delta : SimplexCategoryᵒᵖ) :
    map U n (𝟙 Delta).unop = 𝟙 (generated.degree U n Delta.unop : A) := sorry

/-- The raw bounded-degree generated structure map preserves composition. -/
@[stacks 017Y "bounded-degree generated simplicial composition law"]
theorem map_comp (U : SimplicialObject A) (n : ℕ)
    {Delta Delta' Delta'' : SimplexCategoryᵒᵖ}
    (theta : Delta ⟶ Delta') (theta' : Delta' ⟶ Delta'') :
    map U n (theta ≫ theta').unop =
      map U n theta.unop ≫ map U n theta'.unop := sorry

end generated.degree

/-- The simplicial object generated by the simplices of `U` in degrees at most `n`. -/
@[stacks 017Y "simplicial object generated in bounded degree"]
def generated.obj (U : SimplicialObject A) (n : ℕ) :
    SimplicialObject A where
  obj Delta := generated.degree U n Delta.unop
  map theta := generated.degree.map U n theta.unop
  map_id := generated.degree.map_id U n
  map_comp := generated.degree.map_comp U n

namespace generated.inclusion

/-- The component data of the inclusion of the bounded-degree generated simplicial object. -/
@[stacks 017Y "bounded-degree generated inclusion component data"]
def app (U : SimplicialObject A) (n : ℕ)
    (Delta : SimplexCategoryᵒᵖ) :
    (generated.obj U n).obj Delta ⟶ U.obj Delta :=
  (generated.degree U n Delta.unop).arrow

/-- The bounded-degree generated inclusion components are natural in the simplex. -/
@[stacks 017Y "bounded-degree generated inclusion component naturality"]
theorem naturality (U : SimplicialObject A) (n : ℕ)
    {Delta Delta' : SimplexCategoryᵒᵖ} (theta : Delta ⟶ Delta') :
    (generated.obj U n).map theta ≫ app U n Delta' =
      app U n Delta ≫ U.map theta := sorry

end generated.inclusion

/-- The canonical inclusion of the bounded-degree generated simplicial object into `U`. -/
@[stacks 017Y "inclusion of the bounded-degree generated simplicial object"]
def generated.inclusion (U : SimplicialObject A) (n : ℕ) :
    generated.obj U n ⟶ U where
  app := generated.inclusion.app U n
  naturality := fun {_ _} theta ↦ generated.inclusion.naturality U n theta

/-- The canonical bounded-degree inclusion is a monomorphism. -/
@[stacks 017Y "bounded-degree inclusion is monomorphic"]
instance generated.inclusion_mono (U : SimplicialObject A) (n : ℕ) :
    Mono (generated.inclusion U n) := sorry

namespace generated.degree

/-- A simplicial morphism carries bounded-degree generators into bounded-degree generators. -/
@[stacks 017Y "bounded-degree generation is preserved by simplicial morphisms"]
theorem le_pullback_map {U V : SimplicialObject A} (f : U ⟶ V) (n : ℕ)
    (Delta : SimplexCategory) :
    generated.degree U n Delta ≤
      (Subobject.pullback (f.app (op Delta))).obj (generated.degree V n Delta) := sorry

end generated.degree

namespace generated.map

/-- The component of a simplicial morphism restricted to bounded-degree generated objects. -/
@[stacks 017Y "bounded-degree generated map component"]
def app {U V : SimplicialObject A} (f : U ⟶ V) (n : ℕ)
    (Delta : SimplexCategoryᵒᵖ) :
    (generated.obj U n).obj Delta ⟶ (generated.obj V n).obj Delta :=
  Subobject.ofLE _ _ (generated.degree.le_pullback_map f n Delta.unop) ≫
    Subobject.pullbackπ (f.app Delta) (generated.degree V n Delta.unop)

/-- A restricted map followed by the target inclusion is the ambient simplicial map. -/
@[reassoc, stacks 017Y "bounded-degree generated map commutes with inclusion"]
theorem app_inclusion {U V : SimplicialObject A} (f : U ⟶ V) (n : ℕ)
    (Delta : SimplexCategoryᵒᵖ) :
    app f n Delta ≫ generated.inclusion.app V n Delta =
      generated.inclusion.app U n Delta ≫ f.app Delta := sorry

/-- The restricted components of a simplicial morphism are natural in the simplex. -/
@[stacks 017Y "bounded-degree generated map naturality"]
theorem naturality {U V : SimplicialObject A} (f : U ⟶ V) (n : ℕ)
    {Delta Delta' : SimplexCategoryᵒᵖ} (theta : Delta ⟶ Delta') :
    (generated.obj U n).map theta ≫ app f n Delta' =
      app f n Delta ≫ (generated.obj V n).map theta := sorry

end generated.map

/-- The restriction of a simplicial morphism to the bounded-degree generated objects. -/
@[stacks 017Y "bounded-degree generated simplicial map"]
def generated.map {U V : SimplicialObject A} (f : U ⟶ V) (n : ℕ) :
    generated.obj U n ⟶ generated.obj V n where
  app := generated.map.app f n
  naturality := fun {_ _} theta ↦ generated.map.naturality f n theta

/-- Restriction to bounded-degree generated objects preserves identity morphisms. -/
@[stacks 017Y "bounded-degree generated map identity law"]
theorem generated.map_id (n : ℕ) (U : SimplicialObject A) :
    generated.map (𝟙 U) n = 𝟙 (generated.obj U n) := sorry

/-- Restriction to bounded-degree generated objects preserves composition. -/
@[stacks 017Y "bounded-degree generated map composition law"]
theorem generated.map_comp (n : ℕ) {U V W : SimplicialObject A}
    (f : U ⟶ V) (g : V ⟶ W) :
    generated.map (f ≫ g) n = generated.map f n ≫ generated.map g n := sorry

/-- The endofunctor taking a simplicial object to the subobject generated in degrees at most
`n`. -/
@[stacks 017Y "bounded-degree generated endofunctor"]
def generated.functor (n : ℕ) : SimplicialObject A ⥤ SimplicialObject A where
  obj U := generated.obj U n
  map f := generated.map f n
  map_id := generated.map_id n
  map_comp := generated.map_comp n

/-- Naturality of the bounded-degree generated inclusion in the ambient simplicial object. -/
@[reassoc, stacks 017Y "bounded-degree generated inclusion naturality in the ambient object"]
theorem generated.map_inclusion (n : ℕ) {U V : SimplicialObject A} (f : U ⟶ V) :
    generated.map f n ≫ generated.inclusion V n = generated.inclusion U n ≫ f := sorry

/-- The natural inclusion of the bounded-degree generated endofunctor into the identity. -/
@[stacks 017Y "natural inclusion of bounded-degree generation"]
def generated.ι (n : ℕ) : generated.functor n ⟶ 𝟭 (SimplicialObject A) where
  app U := generated.inclusion U n
  naturality := fun {_ _} f ↦ generated.map_inclusion n f

/-- Every component of the natural bounded-degree inclusion is a monomorphism. -/
@[stacks 017Y "bounded-degree generated inclusion component is monomorphic"]
instance generated.ι_app_mono (n : ℕ) (U : SimplicialObject A) :
    Mono ((generated.ι n).app U) := sorry

/-- The natural inclusion of bounded-degree generation is a monomorphism. -/
@[stacks 017Y "bounded-degree generated natural inclusion is monomorphic"]
instance generated.ι_mono (n : ℕ) : Mono (generated.ι (A := A) n) := sorry

/-- The canonical simplicial subobject generated by simplices in degrees at most `n`. -/
@[stacks 017Y "simplicial subobject generated in bounded degree"]
def generated (U : SimplicialObject A) (n : ℕ) : Subobject U :=
  Subobject.mk (generated.inclusion U n)

/-- Each component of the canonical bounded-degree inclusion is a monomorphism. -/
@[stacks 017Y "bounded-degree component inclusion is monomorphic"]
instance generated.app_mono (U : SimplicialObject A) (n m : ℕ) :
    Mono (((U.generated n).arrow).app (op ⦋m⦌)) := sorry

/-- Evaluation of `generated` agrees with the explicit finite supremum of image
subobjects. -/
@[stacks 017Y "degreewise generated subobject evaluation"]
theorem generated.app_subobject (U : SimplicialObject A) (n m : ℕ) :
    Subobject.mk (((U.generated n).arrow).app (op ⦋m⦌)) =
      generated.degree U n ⦋m⦌ := sorry

end SimplicialStructure

namespace generated

section Images

variable {A : Type u} [Category.{v} A] [HasImages A] [HasBinaryCoproducts A]

/-- Every generating image is contained in the bounded-degree generated subobject. -/
@[stacks 017Y "generating images lie in bounded-degree generation"]
theorem degree_image_le (U : SimplicialObject A) (n : ℕ) {Delta : SimplexCategory}
    {i : ℕ} (hi : i ≤ n) (theta : Delta ⟶ ⦋i⦌) :
    imageSubobject (U.map theta.op) ≤ degree U n Delta := sorry

/-- The degreewise generated subobject is the least upper bound of the images coming from all
degrees at most `n`. -/
@[stacks 017Y "least-upper-bound description of bounded-degree generation"]
theorem degree_isLUB (U : SimplicialObject A) (n m : ℕ) :
    IsLUB
      (setOf fun P : Subobject (U.obj (op ⦋m⦌)) ↦
        ∃ i, i ≤ n ∧ ∃ theta : ⦋m⦌ ⟶ ⦋i⦌, P = imageSubobject (U.map theta.op))
      (degree U n ⦋m⦌) := sorry

/-- Bounded-degree generation is the whole object in every degree at most the bound. -/
@[stacks 017Y "bounded-degree generation in low degrees"]
theorem degree_eq_top_of_le (U : SimplicialObject A) {n i : ℕ} (h : i ≤ n) :
    degree U n ⦋i⦌ = ⊤ := sorry

end Images

section LowDegrees

variable {A : Type u} [Category.{v} A]
variable [HasPullbacks A] [HasImages A] [HasBinaryCoproducts A]

/-- The bounded-degree inclusion is an isomorphism in every degree at most the bound. -/
@[stacks 017Y "bounded-degree inclusion is an isomorphism in low degrees"]
theorem app_isIso_of_le (U : SimplicialObject A) (n : ℕ) {i : ℕ} (hi : i ≤ n) :
    IsIso (((U.generated n).arrow).app (op ⦋i⦌)) := sorry

end LowDegrees

end generated

end CategoryTheory.SimplicialObject
