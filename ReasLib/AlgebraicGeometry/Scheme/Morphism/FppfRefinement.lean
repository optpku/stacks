module

public import ReasLib.AlgebraicGeometry.Scheme.Cover.Fppf

/-!
# Descent along an fppf refinement

This module records morphism properties that descend from a composite when an
fppf cover of the intermediate scheme factors through the first morphism.
-/

@[expose] public section

open CategoryTheory

universe u v

namespace AlgebraicGeometry.Flat

/-- Flatness descends from `f ≫ g` to `g` when an fppf cover of the intermediate
scheme factors through the singleton presieve generated by `f`. -/
theorem of_comp_of_fppf_refinement {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
    (h_comp : Flat (f ≫ g)) (𝒰 : FppfCover.{u, v} Y)
    (h_refines : 𝒰.presieve₀.FactorsThru (Presieve.singleton f)) : Flat g := sorry

end AlgebraicGeometry.Flat

namespace AlgebraicGeometry.LocallyOfFiniteType

/-- Being locally of finite type descends from `f ≫ g` to `g` when an fppf cover
of the intermediate scheme factors through the singleton presieve generated by `f`. -/
theorem of_comp_of_fppf_refinement {X Y Z : Scheme.{u}}
    (f : X ⟶ Y) (g : Y ⟶ Z) (h_comp : LocallyOfFiniteType (f ≫ g))
    (𝒰 : FppfCover.{u, v} Y)
    (h_refines : 𝒰.presieve₀.FactorsThru (Presieve.singleton f)) : LocallyOfFiniteType g := sorry

end AlgebraicGeometry.LocallyOfFiniteType

namespace AlgebraicGeometry.LocallyOfFinitePresentation

/-- Being locally of finite presentation descends from `f ≫ g` to `g` when an
fppf cover of the intermediate scheme factors through the singleton presieve generated by `f`. -/
theorem of_comp_of_fppf_refinement {X Y Z : Scheme.{u}}
    (f : X ⟶ Y) (g : Y ⟶ Z) (h_comp : LocallyOfFinitePresentation (f ≫ g))
    (𝒰 : FppfCover.{u, v} Y)
    (h_refines : 𝒰.presieve₀.FactorsThru (Presieve.singleton f)) :
    LocallyOfFinitePresentation g := sorry

end AlgebraicGeometry.LocallyOfFinitePresentation
