module

public import Mathlib.Algebra.BigOperators.Group.Finset.Defs
public import Mathlib.Algebra.Ring.Pi
public import Mathlib.Data.Finset.Basic
public import ReasLib.Algebra.WLocalHull.Specializing

/-!
# Finite vanishing-pattern stages

The finite-stage algebra attached to `E : Finset A` is the product of
specializing localizations over vanishing patterns of `E`.
-/

@[expose] public section

universe u

namespace Algebra.WLocalHull

variable (A : Type u) [CommRing A]

/-- A vanishing pattern of a finite set `E` is a subset `E' ⊆ E`, with
complement `E'' = E \ E'` encoding the complementary block of a
decomposition `E = E' ⨿ E''`. -/
abbrev Pattern (E : Finset A) :=
  {s : Finset A // s ⊆ E}

/-- The standard-open generator of a vanishing pattern, the product of the
elements of `E'`. -/
def Pattern.elem {E : Finset A} (p : Pattern A E) : A :=
  p.1.prod fun x ↦ x

/-- The vanishing ideal generated by the complementary block `E \ E'`. -/
noncomputable def Pattern.span {E : Finset A} (p : Pattern A E) : Ideal A :=
  open Classical in Ideal.span ((E \ p.1 : Finset A) : Set A)

/-- The finite-stage `A`-algebra attached to `E`, as the product of
specializing localizations over vanishing patterns of `E`. -/
abbrev stage (E : Finset A) : Type u :=
  ∀ p : Pattern A E, specializingLocalization A p.elem p.span

/-- Projection from the finite-stage algebra onto the factor indexed by a
vanishing pattern. -/
noncomputable def stage.eval {E : Finset A} (p : Pattern A E) :
    stage A E →+* specializingLocalization A p.elem p.span :=
  Pi.evalRingHom (fun q : Pattern A E ↦ specializingLocalization A q.elem q.span) p

end Algebra.WLocalHull
