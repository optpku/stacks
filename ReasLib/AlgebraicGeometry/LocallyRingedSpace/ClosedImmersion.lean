module

public import ReasLib.AlgebraicGeometry.LocallyRingedSpace.IdealSubobject.Kernel
public import ReasLib.AlgebraicGeometry.RingedSpace.Module.ClosedImmersion

/-!
# Closed immersions of locally ringed spaces

This leaf transports the reusable closed-immersion API for ringed spaces along
`LocallyRingedSpace.Hom.toShHom`. It is independent of scheme-specific
closed-subscheme constructions.
-/

@[expose] public section

open CategoryTheory
open AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.LocallyRingedSpace

/-- A morphism of locally ringed spaces is a closed immersion when its
underlying morphism of ringed spaces is a closed immersion. -/
@[stacks 01HK]
abbrev IsClosedImmersion {X Z : LocallyRingedSpace.{u}} (i : Z ⟶ X) : Prop :=
  RingedSpace.IsClosedImmersion i.toShHom

/-- The morphism-property view of locally-ringed-space closed immersions. -/
@[stacks 01HK "closed-immersion morphism property"]
abbrev IsClosedImmersion.morphismProperty : MorphismProperty LocallyRingedSpace.{u} :=
  MorphismProperty.inverseImage RingedSpace.IsClosedImmersion.morphismProperty
    LocallyRingedSpace.forgetToSheafedSpace

section

variable {X Z : LocallyRingedSpace.{u}} (i : Z ⟶ X)

/-- A closed immersion of locally ringed spaces induces a closed embedding on underlying spaces. -/
@[stacks 01HK "closed immersion underlying closed embedding"]
theorem IsClosedImmersion.isClosedEmbedding_base (h : IsClosedImmersion i) :
    Topology.IsClosedEmbedding i.base := sorry

/-- A closed immersion has a locally surjective canonical structure-sheaf map. -/
@[stacks 01HK "closed immersion local surjectivity"]
theorem IsClosedImmersion.isLocallySurjective (h : IsClosedImmersion i) :
    Sheaf.IsLocallySurjective (Hom.commRingSheafPushforwardMap i) := sorry

/-- The kernel ideal sheaf of a closed immersion is canonically locally generated by sections. -/
@[stacks 01HK "locally generated kernel"]
theorem IsClosedImmersion.idealSheaf_isLocallyGeneratedBySections
    [IsClosedImmersion i] :
    SheafOfModules.IsLocallyGeneratedBySections (Hom.kernelIdealSheaf i) := sorry

/-- The closed-embedding, local-surjectivity, and local-generation conditions construct a
closed immersion of locally ringed spaces. -/
@[stacks 01HK]
theorem IsClosedImmersion.of_source_spec
    (hclosed : Topology.IsClosedEmbedding i.base)
    (hsurj : Sheaf.IsLocallySurjective (Hom.commRingSheafPushforwardMap i))
    (hgen : SheafOfModules.IsLocallyGeneratedBySections
      (Hom.kernelIdealSheaf i)) :
    IsClosedImmersion i := sorry

/-- A morphism is a closed immersion exactly when it satisfies the closed-embedding,
local-surjectivity, and locally-generated-kernel conditions. -/
@[stacks 01HK]
theorem IsClosedImmersion.iff :
    IsClosedImmersion i ↔
      Topology.IsClosedEmbedding i.base ∧
        Sheaf.IsLocallySurjective (Hom.commRingSheafPushforwardMap i) ∧
          SheafOfModules.IsLocallyGeneratedBySections
            (Hom.kernelIdealSheaf i) := sorry

/-- A closed immersion satisfies the closed-embedding, local-surjectivity, and
locally-generated-kernel conditions. -/
@[stacks 01HK "closed immersion source specification"]
theorem IsClosedImmersion.source_spec (h : IsClosedImmersion i) :
    Topology.IsClosedEmbedding i.base ∧
      Sheaf.IsLocallySurjective (Hom.commRingSheafPushforwardMap i) ∧
        SheafOfModules.IsLocallyGeneratedBySections
          (Hom.kernelIdealSheaf i) := sorry

end

/-- A composite of closed immersions of locally ringed spaces is a closed immersion. -/
@[stacks 01HK "composition of closed immersions", instance]
theorem IsClosedImmersion.comp {X Y Z : LocallyRingedSpace.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
    [IsClosedImmersion f] [IsClosedImmersion g] :
    IsClosedImmersion (f ≫ g) := sorry

variable {X Z : LocallyRingedSpace.{u}} (i : Z ⟶ X) [IsClosedImmersion i]

variable {Y : LocallyRingedSpace.{u}} {f : X ⟶ Y} {g : Y ⟶ Z}
  [IsClosedImmersion f] [IsClosedImmersion g]

end AlgebraicGeometry.LocallyRingedSpace
