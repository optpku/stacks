      (comparisonOf H T K₁ L M)
      (comparisonOf H T K₂ L M)
      ((MonoidalClosed.preOf H ((MonoidalClosed.preOf H fK).app L)).app M) := by
  refine ⟨?_⟩
  dsimp only [comparisonOf]
  simp only [Category.assoc]
  rw [tensorMapOf_objIsoTensor_assoc H T fK ((H.ihomOf L).obj M)]
  rw [cancel_epi]
  exact (MonoidalClosed.TensorRight.comparisonOf_natural_tensor H fK).w

/-- The derived tensor-to-iterated comparison is contravariantly natural in its middle factor. -/
