module

public import ReasLib.CategoryTheory.Sites.Point.Refinement.Saturation.RefinementAdvance
public import ReasLib.CategoryTheory.Sites.Point.Refinement.Saturation.RefinementTower.Basic

/-!
# Refinement towers generated by an advance

This leaf iterates a uniform one-step refinement advance and exposes the
computation rules needed by consumers of the resulting tower.
-/

@[expose] public section

open CategoryTheory Limits

universe u v q r r'

noncomputable section

namespace CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered
namespace OrderedRefinement
namespace Saturation
namespace RefinementStage
namespace Tower

variable {C : Type u} [Category.{v} C]
variable {ι : Type r} [Preorder ι]
variable {J : GrothendieckTopology C}
variable {S : ιᵒᵖ ⥤ C}
variable [LocallySmall.{q} C]
variable [EssentiallySmall.{q} ιᵒᵖ]
variable [HasColimitsOfShape (EssentiallySmallFiber.fiber S).Elementsᵒᵖ (Type q)]

/-- Iterate an unseparated advance from a supplied initial refinement stage. -/
noncomputable def ofAdvance (A₀ : RefinementStage.{u, v, q, r, r'} S)
    (advance : Advance.{u, v, q, r, r'} (J := J) (S := S)) :
    Tower.{u, v, q, r, r'} (J := J) (S := S) where
  stage := Nat.rec A₀ (fun _ A => advance.next A)
  step := fun n => advance.hom (Nat.rec A₀ (fun _ A => advance.next A) n)
  realizes := fun n => advance.realizes (Nat.rec A₀ (fun _ A => advance.next A) n)

namespace ofAdvance

/-- A tower assembled from an advance starts at its supplied initial stage. -/
@[simp]
theorem stageZero (A₀ : RefinementStage.{u, v, q, r, r'} S)
    (advance : Advance.{u, v, q, r, r'} (J := J) (S := S)) :
    (ofAdvance (J := J) A₀ advance).stage 0 = A₀ := sorry

/-- The successor stage is obtained by advancing the preceding stage. -/
@[simp]
theorem stageSucc (A₀ : RefinementStage.{u, v, q, r, r'} S)
    (advance : Advance.{u, v, q, r, r'} (J := J) (S := S)) (n : ℕ) :
    (ofAdvance (J := J) A₀ advance).stage (n + 1) =
      advance.next ((ofAdvance (J := J) A₀ advance).stage n) := sorry

/-- The successor refinement is the advance refinement at the current stage. -/
@[simp]
theorem step (A₀ : RefinementStage.{u, v, q, r, r'} S)
    (advance : Advance.{u, v, q, r, r'} (J := J) (S := S)) (n : ℕ) :
    (ofAdvance (J := J) A₀ advance).step n =
      advance.hom ((ofAdvance (J := J) A₀ advance).stage n) := sorry

/-- Every successor refinement realizes all requests at its source stage. -/
@[simp]
theorem stepRealizes (A₀ : RefinementStage.{u, v, q, r, r'} S)
    (advance : Advance.{u, v, q, r, r'} (J := J) (S := S)) (n : ℕ) :
    ((ofAdvance (J := J) A₀ advance).step n).realizesAll (J := J) := sorry

end ofAdvance

end Tower
end RefinementStage
end Saturation
end OrderedRefinement
end CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered
