module

public import Mathlib.RingTheory.Localization.Away.Lemmas

@[expose] public section

noncomputable section

namespace Localization.ProdInt

/-- The nontrivial idempotent `(1, 0)` in `ℤ × ℤ`. -/
def idempotent : ℤ × ℤ :=
  (1, 0)

/-- The principal ideal generated by `1 - idempotent` in `ℤ × ℤ`. -/
def ideal : Ideal (ℤ × ℤ) :=
  Ideal.span {1 - idempotent}

/-- The multiplicative submonoid of powers of `idempotent`. -/
def submonoid : Submonoid (ℤ × ℤ) :=
  Submonoid.powers idempotent

/-- The element `idempotent` is idempotent. -/
theorem isIdempotentElem_idempotent : IsIdempotentElem idempotent :=
  sorry

/-- The exhibited ideal is nonzero. -/
theorem ideal_ne_bot : ideal ≠ ⊥ :=
  sorry

/-- The exhibited ideal is proper. -/
theorem ideal_ne_top : ideal ≠ ⊤ :=
  sorry

/-- Localizing `ℤ × ℤ` away from `idempotent` is realized by the quotient by `ideal`. -/
instance isLocalization_quotient : IsLocalization.Away idempotent ((ℤ × ℤ) ⧸ ideal) :=
  IsLocalization.Away.quotient_of_isIdempotentElem isIdempotentElem_idempotent

/-- The quotient by `ideal` is algebra-equivalent over `ℤ × ℤ` to localization away from
`idempotent`. -/
noncomputable def algEquiv :
    ((ℤ × ℤ) ⧸ ideal) ≃ₐ[ℤ × ℤ] Localization.Away idempotent :=
  IsLocalization.algEquiv (Submonoid.powers idempotent) _ _

end Localization.ProdInt
