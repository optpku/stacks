module

public import Mathlib.Algebra.Colimit.Ring
public import Mathlib.RingTheory.IntegralClosure.Algebra.Basic
public import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic

@[expose] public section

universe u v

namespace Algebra.FiniteAdjoin

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]

/-- The subalgebra generated by a finite subset of the ambient algebra. -/
def stage (R : Type u) (S : Type v) [CommRing R] [CommRing S] [Algebra R S]
    (s : Finset S) : Subalgebra R S :=
  Algebra.adjoin R (s : Set S)

/-- The canonical inclusion between finite-adjoin stages. -/
def transition (R : Type u) (S : Type v) [CommRing R] [CommRing S] [Algebra R S]
    (s t : Finset S) (h : s ≤ t) : stage R S s →ₐ[R] stage R S t :=
  Subalgebra.inclusion (Algebra.adjoin_mono (fun _ hx => h hx))

/-- The finite-adjoin inclusions form a directed system. -/
instance instDirectedSystem :
    DirectedSystem (fun s : Finset S => stage R S s)
      (fun s t h => transition R S s t h) where
  map_self := by
    intro s x
    rfl
  map_map := sorry

/-- The canonical map from the direct limit of finite-adjoin stages to the ambient algebra. -/
noncomputable def toRing (R : Type u) (S : Type v) [CommRing R] [CommRing S] [Algebra R S] :
    Ring.DirectLimit (fun s : Finset S => stage R S s)
        (fun s t h => transition R S s t h) →+* S :=
  Ring.DirectLimit.lift (fun s : Finset S => stage R S s) (fun s t h => transition R S s t h)
    S (fun s => (stage R S s).val.toRingHom)
    (by
      intro s t h x
      change (x : S) = (x : S)
      rfl)

/-- The comparison map agrees with the ambient inclusion on every stage. -/
theorem toRing_of (s : Finset S) (x : stage R S s) :
    toRing R S
        (Ring.DirectLimit.of (fun s : Finset S => stage R S s)
          (fun s t h => transition R S s t h) s x) = (x : S) :=
  sorry

/-- The finite-adjoin stages have the ambient algebra as their direct limit. -/
theorem toRing_bijective (R : Type u) (S : Type v) [CommRing R] [CommRing S] [Algebra R S] :
    Function.Bijective (toRing R S) :=
  sorry

/-- Every finite-adjoin stage is finite as a module over the base ring under integrality. -/
instance instFinite [Algebra.IsIntegral R S] (s : Finset S) :
    Module.Finite R (stage R S s) :=
  Algebra.finite_adjoin_of_finite_of_isIntegral s.finite_toSet
    (fun x _ => Algebra.IsIntegral.isIntegral x)

end Algebra.FiniteAdjoin
