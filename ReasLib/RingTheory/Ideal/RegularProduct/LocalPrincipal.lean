module

public import ReasLib.RingTheory.Ideal.RegularProduct
public import Mathlib.RingTheory.LocalRing.Defs
public import Mathlib.RingTheory.Ideal.IsPrincipal

@[expose] public section

universe u

namespace Ideal

variable {R : Type u} [CommRing R] [IsLocalRing R]

/-- In a local ring, an ideal whose product with another ideal is generated by a regular
element is principal. -/
theorem isPrincipal_of_mul_eq_span_singleton_regular
    (I J : Ideal R) (f : R) (hf : IsRegular f)
    (hIJ : I * J = Ideal.span ({f} : Set R)) : I.IsPrincipal := sorry

end Ideal
