module

public import stacks_project.Chap83.Definition_83_4_1_Invariant
public import stacks_project.Chap83.Definition_83_5_4_Orbit

/-!
# Natural k-point maps of invariant morphisms

An `R`-invariant morphism of algebraic spaces over `B` descends along weak equivalence of
`T`-valued points, and therefore induces a map out of the quotient of geometric `k`-points by
the equivalence relation generated by `j(R(k))`.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry AlgebraicSpace

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.PreRelation

/-- An `R`-invariant morphism equalizes `T`-valued points of `U` that are weakly equivalent
for the pre-relation. -/
theorem weaklyEquivalent_comp_eq {S : Scheme.{u}} {B : AlgebraicSpace S} {U X : Over B}
    (P : PreRelation U) {φ : U ⟶ X} (hφ : P.IsInvariant φ) {T : Over B} {x y : T ⟶ U}
    (h : P.weaklyEquivalent T x y) : x ≫ φ = y ≫ φ :=
  sorry

/-- The natural map on geometric `k`-points sending the class of `x` to `x ≫ φ`. -/
def weaklyEquivalentQuotMap {S : Scheme.{u}} {B : AlgebraicSpace S} {U X : Over B}
    (P : PreRelation U) {φ : U ⟶ X} (hφ : P.IsInvariant φ) (kbar : GeometricPoint B) :
    Quot (P.weaklyEquivalent (Over.mk kbar.hom)) → (Over.mk kbar.hom ⟶ X) :=
  Quot.lift (fun x ↦ x ≫ φ) (fun _ _ h ↦ P.weaklyEquivalent_comp_eq hφ h)

/-- The natural map on geometric `k`-points evaluates on a class representative by
postcomposition with `φ`. -/
theorem weaklyEquivalentQuotMap_mk {S : Scheme.{u}} {B : AlgebraicSpace S} {U X : Over B}
    (P : PreRelation U) {φ : U ⟶ X} (hφ : P.IsInvariant φ) (kbar : GeometricPoint B)
    (x : Over.mk kbar.hom ⟶ U) :
    P.weaklyEquivalentQuotMap hφ kbar (Quot.mk (P.weaklyEquivalent (Over.mk kbar.hom)) x) =
      x ≫ φ :=
  sorry

/-- The natural map on geometric `k`-points is bijective if and only if postcomposition with
`φ` is surjective and equal images imply weak equivalence. -/
theorem weaklyEquivalentQuotMap_bijective_iff {S : Scheme.{u}} {B : AlgebraicSpace S}
    {U X : Over B} (P : PreRelation U) {φ : U ⟶ X} (hφ : P.IsInvariant φ)
    (kbar : GeometricPoint B) :
    Function.Bijective (P.weaklyEquivalentQuotMap hφ kbar) ↔
      Function.Surjective (fun x : Over.mk kbar.hom ⟶ U ↦ x ≫ φ) ∧
        ∀ x y, x ≫ φ = y ≫ φ → P.weaklyEquivalent (Over.mk kbar.hom) x y :=
  sorry

end AlgebraicGeometry.AlgebraicSpace.PreRelation
