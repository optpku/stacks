module

public import Mathlib.CategoryTheory.EssentiallySmall
public import Mathlib.CategoryTheory.Limits.FinallySmall
public import Mathlib.CategoryTheory.Sites.Point.OfIsCofiltered

/-!
# Object fibers of essentially-small inverse systems

This module hides the implementation-level `InitiallySmall` witnesses used by
the colimit model of an inverse-system fiber.
-/

@[expose] public section

open CategoryTheory Opposite

universe u v q w₀ v₀

noncomputable section

namespace CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered

variable {C : Type u} [Category.{v} C]

namespace EssentiallySmallFiber

variable {I : Type w₀} [Category.{v₀} I]
variable {S : Iᵒᵖ ⥤ C}
variable [LocallySmall.{q} C] [EssentiallySmall.{q} Iᵒᵖ]

/-- Internal smallness bridge used by the essentially-small fiber interface. -/
local instance initiallySmallOfEssentiallySmall : InitiallySmall.{q} Iᵒᵖ :=
  initiallySmall_of_essentiallySmall Iᵒᵖ

/-- The inverse-system fiber of an essentially small indexing category, formed in the chosen
fiber universe without requiring consumers to install an `InitiallySmall` instance. -/
@[stacks 00YP "essentially-small inverse-system fiber"]
noncomputable abbrev fiber (S : Iᵒᵖ ⥤ C) : C ⥤ Type q :=
  CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered.fiber.{q} S

/-- The canonical generator of an essentially-small inverse-system fiber.  This hides the
implementation-level `InitiallySmall` witness used by `fiberMk`. -/
noncomputable def mk {U : Iᵒᵖ} {W : C} (f : S.obj U ⟶ W) :
    (fiber S).obj W :=
  letI : InitiallySmall.{q} Iᵒᵖ := initiallySmall_of_essentiallySmall Iᵒᵖ
  fiberMk.{q} f

/-- Mapping a canonical fiber generator postcomposes its representing
morphism. -/
@[simp]
theorem fiber.map_mk {U : Iᵒᵖ} {W W' : C}
    (f : S.obj U ⟶ W) (g : W ⟶ W') :
    (fiber S).map g (mk f) = mk (f ≫ g) := sorry

/-- Every element of an essentially-small inverse-system fiber is represented
by one canonical generator. -/
theorem mkJointlySurjective
    (S : Iᵒᵖ ⥤ C) {X : C} (x : (fiber S).obj X) :
    ∃ (U : Iᵒᵖ) (f : S.obj U ⟶ X), mk (S := S) f = x := sorry

section CanonicalUniverse

variable [LocallySmall.{max u v w₀ v₀} C]
variable [EssentiallySmall.{max u v w₀ v₀} Iᵒᵖ]

/-- The inverse-system fiber of an essentially-small indexing category in the canonical universe
generated by the ambient category and its indexing category.  This is the default interface when
no separate fiber universe is mathematically significant; use `fiber` to prescribe one explicitly. -/
noncomputable abbrev fiberMax (S : Iᵒᵖ ⥤ C) :
    C ⥤ Type (max u v w₀ v₀) :=
  fiber.{u, v, max u v w₀ v₀, w₀, v₀} S

end CanonicalUniverse

end EssentiallySmallFiber

end CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered
