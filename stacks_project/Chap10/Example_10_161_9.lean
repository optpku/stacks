module

public import Mathlib.Analysis.Complex.Basic
public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
public import Mathlib.RingTheory.MvPolynomial.Basic
import StacksCheckRecall

@[expose] public section

/-!
# A non-Noetherian normalization which is not finite

Example 10.161.9 uses the subalgebra of `C[x_0, x_1, ...]` generated by all quadratic
monomials.  The concrete subalgebra stays in the source layer; normality, its normalization, and
failure of module finiteness are exposed as separate statements.

@stack 03B7
-/

open MvPolynomial

noncomputable section

/-- The quadratic monomials `X i * X j` in the countable polynomial ring over `C`. -/
@[stacks 03B7 "quadratic monomial generators"]
def complexQuadraticMonomials : Set (MvPolynomial ℕ ℂ) :=
  Set.range fun p : ℕ × ℕ ↦
    ((X p.1 : MvPolynomial ℕ ℂ) * X p.2 : MvPolynomial ℕ ℂ)

/-- The `C`-subalgebra generated by all quadratic monomials. -/
@[stacks 03B7 "invariant subalgebra"]
def complexQuadraticMonomialSubalgebra : Subalgebra ℂ (MvPolynomial ℕ ℂ) :=
  Algebra.adjoin ℂ complexQuadraticMonomials

/-- Example 10.161.9: the quadratic-monomial subalgebra is a normal domain. -/
@[stacks 03B7 "normality"]
theorem isIntegrallyClosed_complexQuadraticMonomialSubalgebra :
    IsIntegrallyClosed complexQuadraticMonomialSubalgebra := sorry

/-- Example 10.161.9: the ambient polynomial ring is the integral closure of the
quadratic-monomial subalgebra in its fraction field. -/
@[stacks 03B7 "integral closure"]
theorem isIntegralClosure_complexQuadraticMonomialSubalgebra :
    IsIntegralClosure
      (MvPolynomial ℕ ℂ)
      complexQuadraticMonomialSubalgebra
      (FractionRing (MvPolynomial ℕ ℂ)) := sorry

/-- Example 10.161.9: the ambient polynomial ring is not finite as a module over the
quadratic-monomial subalgebra. -/
@[stacks 03B7 "nonfinite normalization"]
theorem complexQuadraticMonomialSubalgebra_not_module_finite :
    ¬ Module.Finite complexQuadraticMonomialSubalgebra (MvPolynomial ℕ ℂ) := sorry

/-- Example 10.161.9: the normalization is the ambient polynomial ring but is not module-finite. -/
@[stacks 03B7]
theorem complexQuadraticMonomialSubalgebra_not_module_finite_and_has_integral_closure :
    ¬ Module.Finite complexQuadraticMonomialSubalgebra (MvPolynomial ℕ ℂ) ∧
      IsIntegralClosure
        (MvPolynomial ℕ ℂ)
        complexQuadraticMonomialSubalgebra
        (FractionRing (MvPolynomial ℕ ℂ)) := sorry

@[stacks 03B7 "canonical generated-subalgebra membership"]
#check @Algebra.subset_adjoin

@[stacks 03B7 "canonical integral-closure predicate"]
#check @IsIntegralClosure
