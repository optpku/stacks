module

public import Mathlib.Data.Complex.Basic
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.Over
public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.IdealClosure

/-!
# The smooth Fermat plane conic over ℂ

This module owns the homogeneous equation `X_0 ^ 2 + X_1 ^ 2 + X_2 ^ 2`, the associated
`Proj` model, its closed immersion into `ℙ²_ℂ`, and the structure morphism to `Spec ℂ`.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

namespace AlgebraicGeometry.ComplexConic

/-- The homogeneous Fermat equation `X 0 ^ 2 + X 1 ^ 2 + X 2 ^ 2` in three variables over `ℂ`. -/
def equation : MvPolynomial (Fin 3) ℂ :=
  MvPolynomial.X 0 ^ 2 + MvPolynomial.X 1 ^ 2 + MvPolynomial.X 2 ^ 2

/-- The Fermat equation is the displayed sum of three squares. -/
theorem equation_spec :
    equation = MvPolynomial.X 0 ^ 2 + MvPolynomial.X 1 ^ 2 + MvPolynomial.X 2 ^ 2 := rfl

/-- The principal ideal generated by the Fermat equation is homogeneous. -/
theorem equationIdeal_homogeneous :
    (Ideal.span ({equation} : Set (MvPolynomial (Fin 3) ℂ))).IsHomogeneous
      (ProjectiveSpace.grading ℂ 2) := sorry

/-- The homogeneous principal ideal defining the Fermat plane conic. -/
def equationIdeal : HomogeneousIdeal (ProjectiveSpace.grading ℂ 2) where
  toSubmodule := Ideal.span {equation}
  is_homogeneous' := equationIdeal_homogeneous

/-- The underlying ideal of `equationIdeal` is generated by `equation`. -/
theorem equationIdeal_toIdeal :
    equationIdeal.toIdeal =
      Ideal.span ({equation} : Set (MvPolynomial (Fin 3) ℂ)) := rfl

/-- The homogeneous coordinate ring of the Fermat plane conic. -/
abbrev coordinateRing := MvPolynomial (Fin 3) ℂ ⧸ equationIdeal.toIdeal

/-- The quotient grading on the homogeneous coordinate ring. -/
abbrev grading : ℕ → Submodule ℂ coordinateRing :=
  GradedAlgebra.Quotient.grading (ProjectiveSpace.grading ℂ 2) equationIdeal.toIdeal

/-- The quotient decomposition equips the homogeneous coordinate ring with its canonical grading. -/
instance grading_gradedAlgebra : GradedAlgebra grading :=
  GradedAlgebra.Quotient.gradedAlgebra (ProjectiveSpace.grading ℂ 2)
    equationIdeal.toIdeal equationIdeal.isHomogeneous

/-- The concrete `Proj` model of the Fermat plane conic over `ℂ`. -/
abbrev scheme : Scheme := Proj grading

/-- The closed immersion of the Fermat conic into the projective plane. -/
def planeInclusion : scheme ⟶ ProjectiveSpace.scheme ℂ 2 :=
  projQuotientMap (ProjectiveSpace.grading ℂ 2) equationIdeal

/-- The plane inclusion is a closed immersion. -/
instance planeInclusion_isClosedImmersion : IsClosedImmersion planeInclusion :=
  projQuotientMap_isClosedImmersion (ProjectiveSpace.grading ℂ 2) equationIdeal

/-- The structural morphism of the Fermat conic over `Spec ℂ`. -/
def toSpec : scheme ⟶ Spec (CommRingCat.of ℂ) :=
  planeInclusion ≫ ProjectiveSpace.toSpec ℂ 2

/-- The structure morphism is the composite of the plane inclusion with `ℙ²_ℂ → Spec ℂ`. -/
theorem toSpec_eq :
    toSpec = planeInclusion ≫ ProjectiveSpace.toSpec ℂ 2 := rfl

end AlgebraicGeometry.ComplexConic
