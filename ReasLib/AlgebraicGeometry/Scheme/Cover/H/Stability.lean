module

public import ReasLib.AlgebraicGeometry.Scheme.Cover.H
public import ReasLib.AlgebraicGeometry.Scheme.Cover.Ph.Stability

/-!
# Stability of h covering families

H covering families are characterized by the existence of a refining h cover
and by the singleton family induced from their coproduct map. They are stable
under singleton isomorphisms, dependent composition, and base change.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u v w

namespace AlgebraicGeometry.Scheme

/-- A locally finitely presented family is an h covering exactly when it admits
a refining family which is itself an h covering. -/
theorem hCovering_iff_exists_refinement
    {T : Scheme.{u}} {ι : Type v} (family : ι → Over T)
    (hfamily : ∀ i, LocallyOfFinitePresentation (family i).hom) :
    HCovering family ↔
      ∃ (κ : Type v) (refining : κ → Over T),
        HCovering refining ∧
          SemiRepresentableFamily.Over.Refines
            (SemiRepresentableFamily.Over.ofArrows
              (fun k ↦ (refining k).left) (fun k ↦ (refining k).hom))
            (SemiRepresentableFamily.Over.ofArrows
              (fun i ↦ (family i).left) (fun i ↦ (family i).hom)) := by
  constructor
  · intro h
    exact ⟨ι, family, h, SemiRepresentableFamily.Over.Refines.refl _⟩
  · rintro ⟨κ, refining, h, ⟨φ⟩⟩
    refine ⟨hfamily, ⟨?_, ?_⟩⟩
    · intro i
      letI := hfamily i
      infer_instance
    · intro U
      obtain ⟨Φ, hΦ⟩ := h.toPhCovering.refinesOnAffineOpens U
      refine ⟨Φ, fun j ↦ ?_⟩
      obtain ⟨k, g, hg⟩ := hΦ j
      have hφ : (φ.f k).left ≫ (family (φ.α k)).hom = (refining k).hom :=
        Over.w (φ.f k)
      refine ⟨φ.α k,
        pullback.lift
          (g ≫ pullback.fst (refining k).hom U.1.ι ≫ (φ.f k).left)
          (g ≫ pullback.snd (refining k).hom U.1.ι) ?_, ?_⟩
      · calc
          _ = (g ≫ pullback.fst (refining k).hom U.1.ι) ≫ (refining k).hom := by
            set_option backward.isDefEq.respectTransparency false in
              simpa only [Category.assoc] using
                congrArg (fun l ↦ (g ≫ pullback.fst (refining k).hom U.1.ι) ≫ l) hφ
          _ = _ := by
            simpa only [Category.assoc] using
              congrArg (fun l ↦ g ≫ l)
                (pullback.condition (f := (refining k).hom) (g := U.1.ι))
      · simpa only [pullback.lift_snd] using hg

/-- A locally finitely presented family is an h covering exactly when the
singleton family induced by its coproduct map is an h covering. -/
theorem hCovering_iff_coproductSingleton
    {T : Scheme.{u}} {ι : Type u} (family : ι → Over T)
    (hfamily : ∀ i, LocallyOfFinitePresentation (family i).hom) :
    HCovering family ↔
      HCovering (fun p ↦
        (FormalCoproduct.Over.coproductSingleton
          (FormalCoproduct.ofArrows
            (fun i ↦ (family i).left) (fun i ↦ (family i).hom))).obj p) := by
  letI : ∀ i, LocallyOfFinitePresentation (family i).hom := hfamily
  have hfiniteType : ∀ i, LocallyOfFiniteType (family i).hom := fun _ ↦ inferInstance
  have hph := AlgebraicGeometry.phCovering_iff_coproductSingleton
    (fun i ↦ (family i).left) (fun i ↦ (family i).hom) hfiniteType
  constructor
  · intro h
    refine ⟨?_, hph.mp h.toPhCovering⟩
    intro p
    exact IsZariskiLocalAtSource.sigmaDesc hfamily
  · intro h
    exact ⟨hfamily, hph.mpr h.toPhCovering⟩

/-- A singleton family generated by an isomorphism is an h covering. -/
theorem hCoveringSingletonOfIsIso {T T' : Scheme.{u}} (f : T' ⟶ T) [IsIso f] :
    HCovering (fun _ : Unit ↦ Over.mk f) := by
  refine ⟨?_, ?_⟩
  · intro i
    change LocallyOfFinitePresentation f
    infer_instance
  change AlgebraicGeometry.PhCovering (fun _ : Unit ↦ T') (fun _ : Unit ↦ f)
  refine ⟨fun _ ↦ inferInstance, ?_⟩
  intro U
  let Φ : StandardPhCovering U :=
    { m := 1
      source := U
      toBase := 𝟙 U.1.toScheme
      isProper_toBase := inferInstance
      surjective_toBase := inferInstance
      cover := fun _ ↦ ⟨⊤, isAffineOpen_top _⟩
      cover_eq_top := by simp }
  refine ⟨Φ, fun j ↦ ⟨(),
    pullback.lift (Φ.map j ≫ U.1.ι ≫ inv f) (Φ.map j) ?_, ?_⟩⟩
  · simp
  · exact pullback.lift_snd _ _ _

/-- Dependent composition of h covering families is an h covering. -/
theorem hCoveringComp {T : Scheme.{u}} {ι : Type v} {κ : ι → Type w}
    (X : ι → Over T) (Y : (i : ι) → κ i → Over (X i).left)
    [HCovering X] [∀ i, HCovering (Y i)] :
    HCovering (fun p : Sigma κ ↦
      Over.mk ((Y p.1 p.2).hom ≫ (X p.1).hom)) := by
  letI : ∀ i, LocallyOfFinitePresentation (X i).hom :=
    HCovering.locallyOfFinitePresentation
  letI : ∀ i j, LocallyOfFinitePresentation (Y i j).hom :=
    fun i ↦ HCovering.locallyOfFinitePresentation
  letI : AlgebraicGeometry.PhCovering (fun i ↦ (X i).left) (fun i ↦ (X i).hom) :=
    HCovering.toPhCovering
  letI : ∀ i, AlgebraicGeometry.PhCovering
      (fun j ↦ (Y i j).left) (fun j ↦ (Y i j).hom) :=
    fun i ↦ HCovering.toPhCovering
  refine ⟨?_, ?_⟩
  · intro p
    change LocallyOfFinitePresentation ((Y p.1 p.2).hom ≫ (X p.1).hom)
    infer_instance
  · exact AlgebraicGeometry.phCoveringComp
      (fun i ↦ (X i).left) (fun i ↦ (X i).hom) κ
      (fun i j ↦ (Y i j).left) (fun i j ↦ (Y i j).hom)

/-- Pullback of an h covering family along a scheme morphism is an h covering. -/
theorem hCoveringPullback {T T' : Scheme.{u}} {ι : Type v}
    (X : ι → Over T) [HCovering X] (f : T' ⟶ T) :
    HCovering (fun i : ι ↦ Over.mk (pullback.snd (X i).hom f)) := by
  letI : ∀ i, LocallyOfFinitePresentation (X i).hom :=
    HCovering.locallyOfFinitePresentation
  letI : AlgebraicGeometry.PhCovering (fun i ↦ (X i).left) (fun i ↦ (X i).hom) :=
    HCovering.toPhCovering
  refine ⟨?_, ?_⟩
  · intro i
    change LocallyOfFinitePresentation (pullback.snd (X i).hom f)
    infer_instance
  · exact AlgebraicGeometry.phCoveringPullback
      (fun i ↦ (X i).left) (fun i ↦ (X i).hom) f

/-- Explicit-hypothesis view of dependent composition for h covering families. -/
theorem HCovering.comp {T : Scheme.{u}} {ι : Type v} {κ : ι → Type w}
    (X : ι → Over T) (Y : (i : ι) → κ i → Over (X i).left)
    (hX : HCovering X) (hY : ∀ i, HCovering (Y i)) :
    HCovering (fun p : Sigma κ ↦
      Over.mk ((Y p.1 p.2).hom ≫ (X p.1).hom)) := by
  letI := hX
  letI := hY
  exact hCoveringComp X Y

/-- Explicit-hypothesis view of base change for an h covering family. -/
theorem HCovering.pullback {T T' : Scheme.{u}} {ι : Type v}
    (X : ι → Over T) (hX : HCovering X) (f : T' ⟶ T) :
    HCovering (fun i : ι ↦ Over.mk (pullback.snd (X i).hom f)) := by
  letI := hX
  exact hCoveringPullback X f

end AlgebraicGeometry.Scheme
