module

public import ReasLib.RingTheory.AdicCompletion.RigSmooth.RigFlat
import StacksCheckRecall

/-!
# Rig-smooth arrows of Noetherian adic rings are rig-flat
-/

@[expose] public section

universe u

/- Lemma 88.17.6 (1): A rig-smooth homomorphism of Noetherian adic rings is
rig-flat. -/
@[stacks 0GH1] #check (RingHom.RigSmooth.toRigFlat :
  ∀ {A B : Type u}
    [CommRing A] [TopologicalSpace A] [TopologicalRing.IsAdicRing A] [IsNoetherianRing A]
    [CommRing B] [TopologicalSpace B] [TopologicalRing.IsAdicRing B] [IsNoetherianRing B]
    {φ : A →+* B} [RingHom.RigSmooth φ], RingHom.RigFlat φ)

/- Lemma 88.17.6 (2): At every prime containing the presentation kernel and no
ideal of definition, the localized kernel is generated by a regular sequence. -/
@[stacks 0GH1] #check (RingHom.RigSmooth.ker_localizationAtPrime_isGeneratedByRegularSequence :
  ∀ {A B : Type u}
    [CommRing A] [TopologicalSpace A] [TopologicalRing.IsAdicRing A] [IsNoetherianRing A]
    [CommRing B] [TopologicalSpace B] [TopologicalRing.IsAdicRing B] [IsNoetherianRing B]
    {φ : A →+* B} [RingHom.RigSmooth φ] {n : ℕ}
    (f : RestrictedPowerSeries (Fin n) A →+* B) (hf : Function.Surjective f)
    (hcomm : f.comp (algebraMap A (RestrictedPowerSeries (Fin n) A)) = φ)
    (q : Ideal (RestrictedPowerSeries (Fin n) A)) [q.IsPrime]
    (hJq : RingHom.ker f ≤ q) (hq : q.ContainsNoIdealOfDefinition),
    ((RingHom.ker f).map
        (algebraMap (RestrictedPowerSeries (Fin n) A)
          (Localization.AtPrime q))).IsGeneratedByRegularSequence)

#check (RingHom.RigSmooth.presentation_ker_localizationAtPrime_isGeneratedByRegularSequence :
  ∀ {A B : Type u}
    [CommRing A] [TopologicalSpace A] [TopologicalRing.IsAdicRing A] [IsNoetherianRing A]
    [CommRing B] [TopologicalSpace B] [TopologicalRing.IsAdicRing B] [IsNoetherianRing B]
    [Algebra A B] [RingHom.RigSmooth (algebraMap A B)] {ι : Type u} [Fintype ι]
    (P : Algebra.NaiveCotangent.Restricted.Presentation A B ι)
    (q : Ideal (RestrictedPowerSeries ι A)) [q.IsPrime]
    (hJq : P.ker ≤ q) (hq : q.ContainsNoIdealOfDefinition),
    (P.ker.map
        (algebraMap (RestrictedPowerSeries ι A)
          (Localization.AtPrime q))).IsGeneratedByRegularSequence)
