module

public import stacks_project.Chap52.Lemma_52_14_2
public import Mathlib.RingTheory.Ideal.Height
import StacksCheckRecall

@[expose] public section

open CategoryTheory
open scoped ENat

noncomputable section

universe u

namespace AlgebraicGeometry.AffineAlgebraizationSetup

variable {A : Type u} [CommRing A] [IsNoetherianRing A] [IsDomain A]

/-- Lemma 52.14.3: let `A` be a Noetherian domain with a dualizing complex, let
`f ∈ 𝔞` be nonzero, and suppose that `A` is complete for the principal ideal
generated by `f`. If every irreducible component of `V(𝔞)` has codimension greater
than two in `Spec(A)`, equivalently `(2 : ℕ∞) < 𝔞.height`, then
`V(f) ∖ V(𝔞)` is connected. -/
@[stacks 0EG3]
theorem zeroLocus_diff_connected_of_principal
    [MonoidalCategory (DerivedCategory (ModuleCat.{u} A))]
    (𝔞 : Ideal A) (f : A) (hf : f ∈ 𝔞) (hf0 : f ≠ 0)
    (H : MonoidalClosed (DerivedCategory (ModuleCat.{u} A)))
    (h_dualizing :
      ∃ K : DerivedCategory (ModuleCat.{u} A), K.IsDualizingComplex H)
    [IsAdicComplete (Ideal.span ({f} : Set A)) A]
    (h_codim : (2 : ℕ∞) < 𝔞.height) :
    _root_.IsConnected
      (PrimeSpectrum.zeroLocus (Ideal.span ({f} : Set A) : Set A) \
        PrimeSpectrum.zeroLocus (𝔞 : Set A)) := sorry

end AlgebraicGeometry.AffineAlgebraizationSetup
