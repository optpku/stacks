module

public import ReasLib.FieldTheory.Frobenius.Subfield
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
public import Mathlib.RingTheory.MvPowerSeries.Expand
public import Mathlib.RingTheory.MvPolynomial.Expand
public import Mathlib.RingTheory.Localization.FractionRing
import Mathlib.Tactic.CrossRefAttribute

/-!
# Mixed power-series/polynomial rings attached to a p-basis

@stack 07P5

This leaf owns the explicit rings, coefficient fields, presentation maps, and induced fraction
subfields used by the p-basis mixed-power construction.  Finiteness, directedness, and
intersection statements are separate proposition-valued APIs; the data here remains transparent
so older chapter proofs can use the same `change` and `rfl` reductions.
-/

@[expose] public section

noncomputable section

universe u v w z

namespace FieldExtension.PBasis

open FieldExtension.Frobenius

/- The source uses a scoped caret spelling; the shared owner deliberately uses the named
`FieldExtension.Frobenius.subfield` operation to avoid notation collisions between chapters. -/

/-- The coefficient field generated by the p-th power subfield and the basis elements omitted from
the finite set `J`. -/
@[stacks 07P5 "coefficient complement intermediate field"]
abbrev pbasisComplementField {p : ℕ} [Fact p.Prime] {ι : Type z} [DecidableEq ι]
    (k : Type u) [Field k] [CharP k p] (x : ι → k) (J : Finset ι) :
    IntermediateField (subfield p k) k :=
  IntermediateField.adjoin (subfield p k) (x '' {i | i ∉ J})

/-- The ambient mixed ring `k[[X_σ]][Y_τ]`, represented as a multivariate polynomial ring over
multivariate power series. -/
@[stacks 07P5 "mixed power-series polynomial ring"]
abbrev mixedPowerSeriesPolynomialRing (σ : Type v) (τ : Type w) (k : Type u)
    [Finite σ] [Finite τ] [CommRing k] : Type _ :=
  MvPolynomial τ (MvPowerSeries σ k)

/-- The fresh-variable presentation ring over the coefficient complement field. -/
@[stacks 07P5 "mixed p-power presentation ring"]
abbrev pthPowerMixedSubringModel (σ : Type v) (τ : Type w) {p : ℕ} [Fact p.Prime]
    [Finite σ] [Finite τ] {ι : Type z} [DecidableEq ι] (k : Type u) [Field k] [CharP k p]
    (x : ι → k) (J : Finset ι) : Type _ :=
  MvPolynomial τ (MvPowerSeries σ (pbasisComplementField k x J))

/-- The explicit Frobenius-and-coefficient map from the presentation ring into the ambient ring. -/
@[stacks 07P5 "mixed p-power presentation map"]
abbrev pthPowerMixedSubringToAmbient (σ : Type v) (τ : Type w) {p : ℕ} [Fact p.Prime]
    [Finite σ] [Finite τ] {ι : Type z} [DecidableEq ι] (k : Type u) [Field k] [CharP k p]
    (x : ι → k) (J : Finset ι) : pthPowerMixedSubringModel σ τ k x J →+*
      mixedPowerSeriesPolynomialRing σ τ k :=
  -- Local instance justification: finite variable types need classical equality only inside this
  -- explicit expand/map construction; no decidable-equality choice escapes the returned map.
  let hp : p ≠ 0 := Nat.Prime.ne_zero (Fact.out : Nat.Prime p)
  let kJ := pbasisComplementField k x J
  let _ : DecidableEq σ := Classical.decEq σ
  let _ : DecidableEq τ := Classical.decEq τ
  let φ : MvPowerSeries σ kJ →+* MvPowerSeries σ k :=
    (MvPowerSeries.map (algebraMap kJ k)).comp (MvPowerSeries.expand p hp).toRingHom
  (MvPolynomial.map φ).comp
    (MvPolynomial.expand p).toRingHom

/-- The intrinsic p-power subring of the ambient mixed ring, obtained as the range of the
presentation map. -/
@[stacks 07P5 "intrinsic mixed p-power subring"]
abbrev pthPowerMixedSubring (σ : Type v) (τ : Type w) {p : ℕ} [Fact p.Prime] [Finite σ]
    [Finite τ] {ι : Type z} [DecidableEq ι] (k : Type u) [Field k] [CharP k p] (x : ι → k)
    (J : Finset ι) : Subring (mixedPowerSeriesPolynomialRing σ τ k) :=
  (pthPowerMixedSubringToAmbient σ τ k x J).range

/-- The induced fraction subfield of the ambient fraction field generated by the intrinsic
subring's fraction field. The explicit `IsDomain` parameter records the domain instance used by
the chapter's local presentation, rather than installing a competing global construction. -/
@[stacks 07P5 "fraction subfield of the mixed p-power subring"]
abbrev pthPowerMixedFractionSubfield (σ : Type v) (τ : Type w) {p : ℕ} [Fact p.Prime]
    [Finite σ] [Finite τ] {ι : Type z} [DecidableEq ι] (k : Type u) [Field k] [CharP k p]
    [IsDomain (mixedPowerSeriesPolynomialRing σ τ k)]
    (x : ι → k) (J : Finset ι) : Subfield (FractionRing (mixedPowerSeriesPolynomialRing σ τ k)) :=
  let A_J : Subring (mixedPowerSeriesPolynomialRing σ τ k) := pthPowerMixedSubring σ τ k x J
  ((IsFractionRing.map
      (show Function.Injective A_J.subtype from Subtype.coe_injective) :
    FractionRing A_J →+* FractionRing (mixedPowerSeriesPolynomialRing σ τ k))).fieldRange

end FieldExtension.PBasis
