module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Quasicoherent
public import ReasLib.AlgebraicGeometry.Scheme.Cover.Fpqc
public import ReasLib.AlgebraicGeometry.Scheme.Module.Pullback.LocalGeneration

/-!
# Descent of local generation for scheme modules

Local generation by a fixed number of sections for quasi-coherent scheme modules descends along
fpqc covering families.
-/

@[expose] public section

open CategoryTheory
open AlgebraicGeometry

universe u v

namespace AlgebraicGeometry.Scheme.Modules.IsLocallyGeneratedBy

/-- A quasi-coherent scheme module whose pullbacks along an fpqc covering family are locally
generated by `r` sections is itself locally generated by `r` sections. -/
theorem of_fpqcCovering {X : Scheme.{u}} {ι : Type v}
    (ℱ : X.Modules) [ℱ.IsQuasicoherent] (r : ℕ)
    (family : ι → Over X) (hfamily : Scheme.FpqcCovering family)
    (hpullback : ∀ i : ι, SheafOfModules.IsLocallyGeneratedBy
      ((Scheme.Modules.pullback (family i).hom).obj ℱ) r) :
    SheafOfModules.IsLocallyGeneratedBy ℱ r := sorry

end AlgebraicGeometry.Scheme.Modules.IsLocallyGeneratedBy
