module

public import Mathlib.Algebra.Module.LocalizedModule.Away
public import Mathlib.RingTheory.Flat.FaithfullyFlat.Basic
public import Mathlib.RingTheory.Localization.Away.Basic
public import ReasLib.Algebra.Category.ModuleCat.Tor.Notation
public import ReasLib.Algebra.Category.ModuleCat.ChangeOfRings.Tor
public import ReasLib.Algebra.Category.ModuleCat.Tor.Scalar
public import ReasLib.CategoryTheory.Monoidal.Tor
public import ReasLib.RingTheory.Flatness.Tor
import Mathlib.Tactic.CrossRefAttribute

/-!
# Flatness from finitely many away localizations

For a finite family `f : Fin r → A`, flatness can be reconstructed from the localizations away
from the `f i`, the quotient by `Ideal.span (Set.range f)`, and a finite range of `Tor` vanishing.
The same criterion holds for faithful flatness.  Keeping the family itself, rather than only its
span, records the number of positive `Tor` degrees required by the criterion.

The reusable owner also covers `r = 0`: then the quotient hypothesis is already the conclusion up
to the canonical quotients by the zero ideal.  The source-facing recall retains its stated
assumption `1 ≤ r`.

@stack 0H7P
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open scoped ModuleTor

universe u

namespace Module.Flat

variable {A : Type u} [CommRing A]
variable {M : Type u} [AddCommGroup M] [Module A M]
variable {r : ℕ}

/-- Lemma 10.99.17 (Tag 0H7P) (1): flatness follows from flatness on a finite family of away
localizations, flatness modulo the ideal generated by that family, and vanishing of the first
`r + 1` `Tor` objects against the quotient. -/
@[stacks 0H7P "(1)"]
theorem of_away_of_quotient_of_isZero_tor
    (f : Fin r → A)
    (hlocal : ∀ i, Module.Flat (Localization.Away (f i)) (LocalizedModule.Away (f i) M))
    (hquot : Module.Flat (A ⧸ Ideal.span (Set.range f))
      (M ⧸ (Ideal.span (Set.range f) • (⊤ : Submodule A M))))
    (htor : ∀ i : Fin (r + 1),
      IsZero (Tor⁽i.1 + 1⁾[A](M, A ⧸ Ideal.span (Set.range f)))) :
    Module.Flat A M := sorry

end Module.Flat

namespace Module.FaithfullyFlat

variable {A : Type u} [CommRing A]
variable {M : Type u} [AddCommGroup M] [Module A M]
variable {r : ℕ}

/-- Lemma 10.99.17 (Tag 0H7P) (2): the finite away-localization criterion remains valid with
`Module.Flat` replaced throughout by `Module.FaithfullyFlat`. -/
@[stacks 0H7P "(2)"]
theorem of_away_of_quotient_of_isZero_tor
    (f : Fin r → A)
    (hlocal : ∀ i,
      Module.FaithfullyFlat (Localization.Away (f i)) (LocalizedModule.Away (f i) M))
    (hquot : Module.FaithfullyFlat (A ⧸ Ideal.span (Set.range f))
      (M ⧸ (Ideal.span (Set.range f) • (⊤ : Submodule A M))))
    (htor : ∀ i : Fin (r + 1),
      IsZero (Tor⁽i.1 + 1⁾[A](M, A ⧸ Ideal.span (Set.range f)))) :
    Module.FaithfullyFlat A M := sorry

end Module.FaithfullyFlat
