module

public import Mathlib.Algebra.MvPolynomial.CommRing
public import Mathlib.RingTheory.AdicCompletion.Basic
public import ReasLib.NumberTheory.Padics.Localization
public import ReasLib.RingTheory.DividedPowers.Padic
public import ReasLib.RingTheory.DividedPowers.Envelope.Universal
public import ReasLib.RingTheory.Ideal.Principal

@[expose] public section

noncomputable section

open DividedPowers

namespace PadicPolynomial

/-- The polynomial ring `P = ℤ_[p][x₁,…,x_r]`. -/
abbrev polynomialRing (p r : ℕ) [Fact p.Prime] : Type :=
  MvPolynomial (Fin r) ℤ_[p]


/-- The coordinate ring `C = (ZMod p)[x₁,…,x_r]` of affine space over `𝔽_p`. -/
abbrev coordinateRing (p r : ℕ) [Fact p.Prime] : Type :=
  MvPolynomial (Fin r) (ZMod p)


/-- The presentation map `P → C`, reducing polynomial coefficients modulo `p`. -/
def modP (p r : ℕ) [Fact p.Prime] : polynomialRing p r →ₐ[ℤ_[p]] coordinateRing p r :=
  MvPolynomial.mapAlgHom (Algebra.ofId ℤ_[p] (ZMod p))


/-- The kernel of coefficient reduction is the principal ideal `(p)`. -/
theorem ker_modP_eq_span_p (p r : ℕ) [Fact p.Prime] :
    RingHom.ker (modP p r).toRingHom = Ideal.span {(p : polynomialRing p r)} := sorry

/-- The image of `(p) ⊂ ℤ_[p]` in `C` is zero. -/
theorem modP_prime_bot (p r : ℕ) [Fact p.Prime] :
    Ideal.map (algebraMap ℤ_[p] (coordinateRing p r)) (Ideal.span {(p : ℤ_[p])}) =
      (⊥ : Ideal (coordinateRing p r)) := sorry

/-- The integer `p` is nilpotent on `C`. -/
theorem coordinate_p_nilpotent (p r : ℕ) [Fact p.Prime] :
    IsNilpotent (p : coordinateRing p r) := sorry



/-- The image of `(p)` in `P` is contained in the principal ideal `(p) ⊂ P`. -/
theorem primeMap_le (p r : ℕ) [Fact p.Prime] :
    Ideal.map (algebraMap ℤ_[p] (polynomialRing p r)) (Ideal.span {(p : ℤ_[p])}) ≤
      Ideal.span {(p : polynomialRing p r)} := sorry

/-- The canonical polynomial divided power, computed using the unique quotient by `p`
on the principal ideal and set to zero outside it. -/
def primeDpow (p r n : ℕ) [Fact p.Prime] (x : polynomialRing p r) : polynomialRing p r := by
  classical
  exact if x ∈ Ideal.span {(p : polynomialRing p r)} then
    MvPolynomial.C ((PadicInt.dividedPowers p).dpow n (p : ℤ_[p])) *
      (Function.invFun (fun a : polynomialRing p r ↦ (p : polynomialRing p r) * a) x) ^ n
  else 0

/-- Polynomial divided powers vanish outside the principal ideal generated by `p`. -/
theorem primeDpow_null (p r : ℕ) [Fact p.Prime] {n : ℕ} {x : polynomialRing p r}
    (hx : x ∉ Ideal.span {(p : polynomialRing p r)}) : primeDpow p r n x = 0 := sorry

/-- The zeroth divided power of an element of `(p)` is one. -/
theorem primeDpow_zero (p r : ℕ) [Fact p.Prime] {x : polynomialRing p r}
    (hx : x ∈ Ideal.span {(p : polynomialRing p r)}) : primeDpow p r 0 x = 1 := sorry

/-- The first divided power is the original element on `(p)`. -/
theorem primeDpow_one (p r : ℕ) [Fact p.Prime] {x : polynomialRing p r}
    (hx : x ∈ Ideal.span {(p : polynomialRing p r)}) : primeDpow p r 1 x = x := sorry

/-- Positive polynomial divided powers belong to `(p)`. -/
theorem primeDpow_mem (p r : ℕ) [Fact p.Prime] {n : ℕ} {x : polynomialRing p r}
    (hn : n ≠ 0) (hx : x ∈ Ideal.span {(p : polynomialRing p r)}) :
    primeDpow p r n x ∈ Ideal.span {(p : polynomialRing p r)} := sorry

/-- Polynomial divided powers satisfy the divided binomial addition formula. -/
theorem primeDpow_add (p r : ℕ) [Fact p.Prime] {n : ℕ} {x y : polynomialRing p r}
    (hx : x ∈ Ideal.span {(p : polynomialRing p r)})
    (hy : y ∈ Ideal.span {(p : polynomialRing p r)}) :
    primeDpow p r n (x + y) = (Finset.antidiagonal n).sum
      (fun k ↦ primeDpow p r k.1 x * primeDpow p r k.2 y) := sorry

/-- Multiplying the argument of a divided power scales it by the corresponding power. -/
theorem primeDpow_mul (p r : ℕ) [Fact p.Prime] {n : ℕ} {a x : polynomialRing p r}
    (hx : x ∈ Ideal.span {(p : polynomialRing p r)}) :
    primeDpow p r n (a * x) = a ^ n * primeDpow p r n x := sorry

/-- Products of polynomial divided powers have the binomial coefficient factor. -/
theorem primeDpow_mul_dpow (p r : ℕ) [Fact p.Prime] {m n : ℕ} {x : polynomialRing p r}
    (hx : x ∈ Ideal.span {(p : polynomialRing p r)}) :
    primeDpow p r m x * primeDpow p r n x =
      (Nat.choose (m + n) m : polynomialRing p r) * primeDpow p r (m + n) x := sorry

/-- Iterating polynomial divided powers gives the uniform Bell coefficient. -/
theorem primeDpow_comp (p r : ℕ) [Fact p.Prime] {m n : ℕ} {x : polynomialRing p r}
    (hn : n ≠ 0) (hx : x ∈ Ideal.span {(p : polynomialRing p r)}) :
    primeDpow p r m (primeDpow p r n x) =
      (Nat.uniformBell m n : polynomialRing p r) * primeDpow p r (m * n) x := sorry

/-- The canonical divided powers on the polynomial ideal `(p)`, extending those on `ℤ_[p]`. -/
def dividedPowersPrime (p r : ℕ) [Fact p.Prime] :
    DividedPowers (Ideal.span {(p : polynomialRing p r)}) where
  dpow := fun n ↦ primeDpow p r n
  dpow_null := primeDpow_null p r
  dpow_zero := primeDpow_zero p r
  dpow_one := primeDpow_one p r
  dpow_mem := primeDpow_mem p r
  dpow_add := primeDpow_add p r
  dpow_mul := primeDpow_mul p r
  mul_dpow := primeDpow_mul_dpow p r
  dpow_comp := primeDpow_comp p r

/-- Divided powers on `(p) ⊂ P` are the canonical coefficient formula. -/
theorem dividedPowersPrime_dpow (p r n : ℕ) [Fact p.Prime] (a : polynomialRing p r) :
    (dividedPowersPrime p r).dpow n ((p : polynomialRing p r) * a) =
      algebraMap ℤ_[p] (polynomialRing p r)
          ((PadicInt.dividedPowers p).dpow n (p : ℤ_[p])) * a ^ n := sorry


/-- Extension of the canonical divided powers on `(p) ⊂ ℤ_[p]` along `ℤ_[p] → P`. -/
def dividedPowersPrimeMorphism (p r : ℕ) [Fact p.Prime] :
    DividedPowers.DPMorphism (PadicInt.dividedPowers p) (dividedPowersPrime p r) where
  toRingHom := algebraMap ℤ_[p] (polynomialRing p r)
  ideal_comp := (PadicInt.isDPMorphism_iff_dpow_mul.mpr
    (fun n a ↦ dividedPowersPrime_dpow p r n a)).ideal_comp
  dpow_comp := (PadicInt.isDPMorphism_iff_dpow_mul.mpr
    (fun n a ↦ dividedPowersPrime_dpow p r n a)).dpow_comp

/-- The divided-power morphism is the polynomial structure map on underlying rings. -/
theorem dividedPowersPrimeMorphism_toRingHom (p r : ℕ) [Fact p.Prime] :
    (dividedPowersPrimeMorphism p r).toRingHom =
      algebraMap ℤ_[p] (polynomialRing p r) := rfl

/-- The identity divided-power envelope of the polynomial algebra along `(p)`. -/
def envelope (p r : ℕ) [Fact p.Prime] :
    DividedPowerEnvelope (Ideal.span {(p : ℤ_[p])}) (PadicInt.dividedPowers p)
      (algebraMap ℤ_[p] (polynomialRing p r))
      (Ideal.span {(p : polynomialRing p r)}) (primeMap_le p r) where
  D := DividedPowerRing.of (polynomialRing p r)
    (Ideal.span {(p : polynomialRing p r)}) (dividedPowersPrime p r)
  base := dividedPowersPrimeMorphism p r
  toD := RingHom.id (polynomialRing p r)
  toQuotient := Ideal.Quotient.mk (Ideal.span {(p : polynomialRing p r)})
  base_toD := rfl
  ideal_map := by
    change Ideal.map (RingHom.id (polynomialRing p r)) _ ≤ _
    rw [Ideal.map_id]
    exact le_rfl
  quotient_comp := rfl

/-- The envelope is the identity on `P` followed by the quotient by `(p)`. -/
theorem envelope_spec (p r : ℕ) [Fact p.Prime] :
    (envelope p r).toD = RingHom.id (polynomialRing p r) ∧
      (envelope p r).toQuotient.comp (envelope p r).toD =
        Ideal.Quotient.mk (Ideal.span {(p : polynomialRing p r)}) := ⟨rfl, rfl⟩

/-- The identity envelope of `P` along `(p)` is a divided-power envelope. -/
theorem envelope_isUniversal (p r : ℕ) [Fact p.Prime] :
    DividedPowerEnvelope.IsUniversal (PadicInt.dividedPowers p)
      (algebraMap ℤ_[p] (polynomialRing p r)) (primeMap_le p r) (envelope p r) := sorry

/-- The p-adic completion `D` of `P` as a `ℤ_[p]`-module. -/
abbrev completedRing (p r : ℕ) [Fact p.Prime] : Type :=
  AdicCompletion (Ideal.span {(p : ℤ_[p])}) (polynomialRing p r)


/-- Completing the explicit envelope at `p` is the principal-adic completion of the
polynomial ring. -/
theorem envelope_completion_eq (p r : ℕ) [Fact p.Prime] :
    principalAdicCompletion (p : (envelope p r).D) =
      AdicCompletion (Ideal.span {(p : polynomialRing p r)}) (polynomialRing p r) := rfl

end PadicPolynomial
