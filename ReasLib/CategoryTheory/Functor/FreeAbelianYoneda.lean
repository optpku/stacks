module

public import ReasLib.CategoryTheory.Functor.FreeAbelian
public import Mathlib.CategoryTheory.Adjunction.Additive
public import Mathlib.CategoryTheory.Adjunction.Whiskering
public import Mathlib.CategoryTheory.Preadditive.Injective.Basic
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Free abelian representables

This leaf turns the free/forgetful adjunction and Yoneda lemma into a reusable additive
Hom/sections API for presheaves of abelian groups. Site-specific sheafification comparisons
belong in separate `Sites/Sheafification` leaves.
-/

@[expose] public section

open CategoryTheory Opposite

noncomputable section

universe u v

namespace CategoryTheory

namespace FreeAbelianYoneda

variable {C : Type u} [Category.{v} C]

/-- The free abelian Yoneda functor sends `U` to the free abelian presheaf represented by `U`. -/
@[stacks 03A7 "representable functor"]
noncomputable abbrev functor : C ⥤ Cᵒᵖ ⥤ AddCommGrpCat.{v} :=
  yoneda ⋙ FreeAbelianPresheaf.functor

/-- The free abelian presheaf generated by the representable presheaf at `U`. -/
@[stacks 03A7 "representable"]
noncomputable abbrev obj (U : C) : Cᵒᵖ ⥤ AddCommGrpCat.{v} :=
  functor.obj U

/-- The morphism of free abelian representables induced by a morphism of representing objects. -/
noncomputable abbrev map {U V : C} (f : U ⟶ V) : obj U ⟶ obj V :=
  functor.map f

/-- The free abelian Yoneda functor preserves monomorphisms. -/
instance functor_preservesMonomorphisms :
    (functor (C := C)).PreservesMonomorphisms := sorry

/-- Morphisms from the free abelian representable at
`U` to `P` are equivalent to sections of `P` over `U`. -/
@[stacks 03A8 "representable"]
noncomputable def homEquiv (U : C) (P : Cᵒᵖ ⥤ AddCommGrpCat.{v}) :
    (obj U ⟶ P) ≃ P.obj (op U) :=
  (FreeAbelianPresheaf.homEquiv (yoneda.obj U) P).trans yonedaEquiv

/-- The free-abelian-representable Hom/sections equivalence evaluates a morphism on the free
generator corresponding to the identity of `U`. -/
theorem homEquiv_apply
    (U : C) (P : Cᵒᵖ ⥤ AddCommGrpCat.{v}) (α : obj U ⟶ P) :
    homEquiv U P α = α.app (op U) (FreeAbelianGroup.of (𝟙 U)) := by
  rfl

/-- The free-abelian-representable Hom/sections equivalence commutes with postcomposition in
the target presheaf. -/
theorem homEquiv_comp
    {U : C} {P Q : Cᵒᵖ ⥤ AddCommGrpCat.{v}} (α : obj U ⟶ P) (β : P ⟶ Q) :
    homEquiv U Q (α ≫ β) = β.app (op U) (homEquiv U P α) := sorry

/-- The free-abelian-representable Hom/sections equivalence commutes with restriction along a
morphism of representing objects. -/
theorem homEquiv_naturality
    {U V : C} (f : U ⟶ V) (P : Cᵒᵖ ⥤ AddCommGrpCat.{v}) (α : obj V ⟶ P) :
    homEquiv U P (map f ≫ α) = P.map f.op (homEquiv V P α) := sorry

/-- The free-abelian-representable Hom/sections equivalence is additive. -/
theorem homEquiv_add
    (U : C) (P : Cᵒᵖ ⥤ AddCommGrpCat.{v}) (α β : obj U ⟶ P) :
    homEquiv U P (α + β) = homEquiv U P α + homEquiv U P β := by
  rw [homEquiv_apply, homEquiv_apply, homEquiv_apply]
  rfl

/-- Morphisms from the free abelian representable at `U` identify additively with sections over
`U`. -/
@[stacks 03A8 "additive representable"]
noncomputable def homAddEquiv (U : C) (P : Cᵒᵖ ⥤ AddCommGrpCat.{v}) :
    (obj U ⟶ P) ≃+ P.obj (op U) where
  toEquiv := homEquiv U P
  map_add' := homEquiv_add U P

/-- The additive free-abelian-representable Hom/sections equivalence evaluates a morphism on the
free generator corresponding to the identity of `U`. -/
theorem homAddEquiv_apply
    (U : C) (P : Cᵒᵖ ⥤ AddCommGrpCat.{v}) (α : obj U ⟶ P) :
    homAddEquiv U P α = α.app (op U) (FreeAbelianGroup.of (𝟙 U)) := sorry

/-- The additive free-abelian-representable Hom/sections equivalence commutes with restriction
along a morphism of representing objects. -/
theorem homAddEquiv_naturality
    {U V : C} (f : U ⟶ V) (P : Cᵒᵖ ⥤ AddCommGrpCat.{v}) (α : obj V ⟶ P) :
    homAddEquiv U P (map f ≫ α) = P.map f.op (homAddEquiv V P α) := sorry

/-- The additive free-abelian-representable Hom/sections equivalence commutes with
postcomposition in the target presheaf. -/
theorem homAddEquiv_comp
    {U : C} {P Q : Cᵒᵖ ⥤ AddCommGrpCat.{v}} (α : obj U ⟶ P) (β : P ⟶ Q) :
    homAddEquiv U Q (α ≫ β) = β.app (op U) (homAddEquiv U P α) := sorry

/-- The inverse additive Hom/sections equivalence is natural in the target presheaf. -/
theorem homAddEquiv_symm_naturality
    (U : C) {P Q : Cᵒᵖ ⥤ AddCommGrpCat.{v}} (β : P ⟶ Q) (s : P.obj (op U)) :
    (homAddEquiv U Q).symm (β.app (op U) s) = (homAddEquiv U P).symm s ≫ β := sorry

/-- An injective abelian presheaf has surjective restriction maps along monomorphisms in the
indexing category. -/
theorem sectionsMap_surjective
    {U V : C} (f : U ⟶ V) [Mono f] (P : Cᵒᵖ ⥤ AddCommGrpCat.{v}) [Injective P] :
    Function.Surjective (P.map f.op) := sorry

end FreeAbelianYoneda

end CategoryTheory
