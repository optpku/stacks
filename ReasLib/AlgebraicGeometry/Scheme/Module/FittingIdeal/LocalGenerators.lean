module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Free.Generated
public import ReasLib.AlgebraicGeometry.Scheme.Module.FittingIdeal.Stalk
public import ReasLib.RingTheory.FittingIdeal.LocalGenerators

/-!
# Local generators and Fitting ideal sheaves

Fitting ideals characterize the number of sections needed to generate a finite-type
quasicoherent module on a neighborhood of a point.
-/

@[expose] public section

open AlgebraicGeometry
open scoped FittingIdeal

universe u

namespace AlgebraicGeometry.Scheme

namespace fittingIdealSheaf

/-- A finite-type quasicoherent module is generated by `r` sections on a neighborhood of a
point exactly when the stalk ideal of its `r`th Fitting ideal sheaf is the unit ideal. -/
theorem exists_open_isGeneratedBy_iff_stalk_eq_top
    {S : Scheme.{u}} (ℱ : S.Modules) [ℱ.IsFiniteType] [ℱ.IsQuasicoherent] (s : S) (r : ℕ) :
    (∃ U : S.Opens, s ∈ U ∧ SheafOfModules.IsGeneratedBy (ℱ.over U) r) ↔
      RingedSpace.idealSheafStalkIdeal (fittingIdealSheaf ℱ r).toSubobject s = ⊤ := sorry

end fittingIdealSheaf

/-- A finite-type quasicoherent module is generated by `r` sections on a neighborhood of a
point exactly when the `r`th Fitting ideal of its stalk module is the unit ideal. -/
theorem exists_isGeneratedBy_on_neighborhood_iff_stalk_fittingIdeal_eq_top
    {S : Scheme.{u}} (ℱ : S.Modules) [ℱ.IsFiniteType] [ℱ.IsQuasicoherent] (s : S) (r : ℕ) :
    (∃ U : S.Opens, s ∈ U ∧ SheafOfModules.IsGeneratedBy (ℱ.over U) r) ↔
      Fit[S.presheaf.stalk s]_(r)(RingedSpace.stalkModuleCat ℱ s) = ⊤ := by
  simpa [fittingIdealSheaf_stalkIdeal_eq_stalk_fittingIdeal] using
    fittingIdealSheaf.exists_open_isGeneratedBy_iff_stalk_eq_top ℱ s r

end AlgebraicGeometry.Scheme
