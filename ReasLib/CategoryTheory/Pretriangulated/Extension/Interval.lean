module

public import Mathlib.CategoryTheory.Triangulated.Subcategory
public import Mathlib.Data.Int.ConditionallyCompleteOrder
public import Mathlib.Order.CompletePartialOrder
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Bounded Shift Intervals

This leaf owns bounded shift-interval constructions on object properties in a
category with an integer shift.
-/

open CategoryTheory
open CategoryTheory.Limits

universe v u

namespace CategoryTheory.ObjectProperty

section

variable {C : Type u} [Category.{v} C] [HasShift C ℤ]

/-- The closure of an object property under integer shifts in the interval `[a, b]`. -/
@[stacks 0FX5]
abbrev shiftInterval (P : ObjectProperty C) (a b : ℤ) : ObjectProperty C :=
  ⨆ n : Set.Icc a b, (P.shift n.1).isoClosure

/-- Notation for the bounded shift interval of an object property. -/
notation:max P "[" a ", " b "]" => ObjectProperty.shiftInterval P a b

/-- The bounded shift interval generated by a single object. -/
@[stacks 0FX5]
abbrev objectShiftInterval (E : C) (a b : ℤ) : ObjectProperty C :=
  ((singleton E).isoClosure)[a, b]

/-- Membership in a shift interval is membership in one of its shifted terms, up to isomorphism. -/
@[stacks 0FX5]
theorem prop_shiftInterval_iff (P : ObjectProperty C) (a b : ℤ) (X : C) :
    P[a, b] X ↔ ∃ n ∈ Set.Icc a b, (P.shift n).isoClosure X := sorry

/-- Enlarging the upper endpoint enlarges a shift interval. -/
theorem shiftInterval_mono_upper (P : ObjectProperty C) (a b c : ℤ) (hbc : b ≤ c) :
    P[a, b] ≤ P[a, c] := sorry

/-- Lowering the lower endpoint enlarges a shift interval. -/
theorem shiftInterval_mono_lower (P : ObjectProperty C) (a b c : ℤ) (hca : c ≤ a) :
    P[a, b] ≤ P[c, b] := sorry

end

end CategoryTheory.ObjectProperty
