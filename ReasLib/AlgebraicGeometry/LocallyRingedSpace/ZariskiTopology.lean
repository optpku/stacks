module

public import Mathlib.CategoryTheory.MorphismProperty.Representable
public import Mathlib.CategoryTheory.Sites.JointlySurjective
public import Mathlib.CategoryTheory.Sites.MorphismProperty
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import Mathlib.Geometry.RingedSpace.OpenImmersion
public import Mathlib.Tactic.CrossRefAttribute

/-!
# The Zariski topology on locally ringed spaces
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry.LocallyRingedSpace

/-- Open immersions as a morphism property on locally ringed spaces. -/
@[stacks 01JI "open-immersion morphism property"]
abbrev openImmersionProperty : MorphismProperty LocallyRingedSpace.{u} :=
  fun _ _ f ↦ IsOpenImmersion f

/-- The Zariski precoverage consists of jointly surjective families of open
immersions. -/
@[stacks 01JI "locally-ringed-space Zariski precoverage"]
def zariskiPrecoverage : Precoverage LocallyRingedSpace.{u} :=
  Types.jointlySurjectivePrecoverage.comap
      (forgetToTop ⋙ CategoryTheory.forget TopCat) ⊓
    openImmersionProperty.precoverage

/-- The Grothendieck topology generated by Zariski open covers of locally
ringed spaces. -/
@[stacks 01JI "locally-ringed-space Zariski topology"]
def zariskiTopology : GrothendieckTopology LocallyRingedSpace.{u} :=
  zariskiPrecoverage.toGrothendieck

/-- The locally-ringed-space Zariski topology is generated by its
precoverage. -/
@[stacks 01JI "Zariski topology generated by its precoverage"]
theorem zariskiTopology_def :
    (zariskiTopology : GrothendieckTopology LocallyRingedSpace.{u}) =
      zariskiPrecoverage.toGrothendieck := sorry

/-- A displayed family is a Zariski precover exactly when it is jointly
surjective on points and consists of open immersions. -/
@[simp, stacks 01JI "Zariski precoverage membership criterion"]
theorem ofArrows_mem_zariskiPrecoverage_iff
    {X : LocallyRingedSpace.{u}} {I : Type*} {U : I → LocallyRingedSpace.{u}}
    {f : ∀ i, U i ⟶ X} :
    Presieve.ofArrows U f ∈ zariskiPrecoverage X ↔
      (∀ x, ∃ i, x ∈ Set.range (f i).base) ∧ ∀ i, IsOpenImmersion (f i) := sorry

end AlgebraicGeometry.LocallyRingedSpace
