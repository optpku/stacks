module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.Pullback.LocalGeneration
public import ReasLib.AlgebraicGeometry.RingedSpace.IdealSubobject.LocalGeneration
public import ReasLib.AlgebraicGeometry.RingedSpace.IdealSubobject.Pullback
import Mathlib.Tactic.CrossRefAttribute

/-!
# Local generation of pulled-back ideal subobjects

This property leaf records that inverse image preserves local generation by sections.
-/

@[expose] public section

universe u

namespace AlgebraicGeometry.RingedSpace

/-- Inverse image preserves ideals locally generated by sections. -/
@[stacks 01HQ "local generation under pullback"]
theorem IdealSubobject.pullback_isLocallyGenerated
    {X Y : RingedSpace.{u}} (I : IdealSubobject X) (f : Y ⟶ X)
    (hI : I.IsLocallyGeneratedBySections) :
    (I.pullback f).IsLocallyGeneratedBySections := sorry

/-- Pullback canonically preserves the property of being locally generated by sections. -/
instance IdealSubobject.pullback_isLocallyGeneratedBySections
    {X Y : RingedSpace.{u}} (I : IdealSubobject X) (f : Y ⟶ X)
    [hI : I.IsLocallyGeneratedBySections] :
    (I.pullback f).IsLocallyGeneratedBySections := sorry

end AlgebraicGeometry.RingedSpace
