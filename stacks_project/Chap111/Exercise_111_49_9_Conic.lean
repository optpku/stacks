module

public import Mathlib.AlgebraicGeometry.Morphisms.Smooth
public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.IdealClosure
public import stacks_project.Chap111.Exercise_111_49_9_Line

/-!
# Nonsingular conics in standard projective 3-space

This module owns the closed-immersion predicate for a nonsingular conic in `ℙ³_k`, together
with the standard model cut out by `X 3 = 0` and `X 0 * X 2 - X 1 ^ 2 = 0`.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.ProjectiveSpace

/-- A closed immersion `i : Z ⟶ ℙ³_k` is a nonsingular conic when `Z` is smooth over `k` and
isomorphic to `ℙ¹_k` with `𝒪(1)` of degree two. -/
class IsNonsingularConic {k : Type u} [Field k] {Z : Scheme.{u}}
    (i : Z ⟶ scheme k 3) : Prop extends IsClosedImmersion i where
  /-- The structure morphism of the conic to `Spec k` is smooth. -/
  smooth_over_base : Smooth (i ≫ toSpec k 3)
  /-- There is an isomorphism `ℙ¹_k ≅ Z` under which `𝒪(1)` pulls back to `𝒪(2)`. -/
  exists_iso_degree_two :
    ∃ e : scheme k 1 ≅ Z,
      Scheme.Hom.picardPullback (e.hom ≫ i)
          (Scheme.Modules.picardClass (twistingSheaf k 3 1)) =
        Scheme.Modules.picardClass (twistingSheaf k 1 2)

/-- A morphism to `ℙ³_k` is a nonsingular conic iff it is a smooth closed curve isomorphic to
`ℙ¹_k` of `𝒪(1)`-degree two. -/
theorem isNonsingularConic_iff {k : Type u} [Field k] {Z : Scheme.{u}}
    (i : Z ⟶ scheme k 3) :
    IsNonsingularConic i ↔
      IsClosedImmersion i ∧ Smooth (i ≫ toSpec k 3) ∧
        ∃ e : scheme k 1 ≅ Z,
          Scheme.Hom.picardPullback (e.hom ≫ i)
              (Scheme.Modules.picardClass (twistingSheaf k 3 1)) =
            Scheme.Modules.picardClass (twistingSheaf k 1 2) := sorry

/-- The homogeneous ideal of the standard nonsingular conic `X 3 = X 0 * X 2 - X 1 ^ 2 = 0`
in `ℙ³_k` is generated by those two forms. -/
theorem standardConicIdeal_isHomogeneous (k : Type u) [Field k] :
    (Ideal.span
        ({MvPolynomial.X 3,
            MvPolynomial.X 0 * MvPolynomial.X 2 - MvPolynomial.X 1 ^ 2} :
          Set (MvPolynomial (Fin (3 + 1)) k))).IsHomogeneous
      (grading k 3) := sorry

/-- The homogeneous ideal defining the standard nonsingular conic in `ℙ³_k`. -/
def standardConicIdeal (k : Type u) [Field k] : HomogeneousIdeal (grading k 3) where
  toSubmodule :=
    Ideal.span
      ({MvPolynomial.X 3,
          MvPolynomial.X 0 * MvPolynomial.X 2 - MvPolynomial.X 1 ^ 2} :
        Set (MvPolynomial (Fin (3 + 1)) k))
  is_homogeneous' := standardConicIdeal_isHomogeneous k

/-- The underlying ideal of `standardConicIdeal` is generated by `X 3` and
`X 0 * X 2 - X 1 ^ 2`. -/
theorem standardConicIdeal_toIdeal (k : Type u) [Field k] :
    (standardConicIdeal k).toIdeal =
      Ideal.span
        ({MvPolynomial.X 3,
            MvPolynomial.X 0 * MvPolynomial.X 2 - MvPolynomial.X 1 ^ 2} :
          Set (MvPolynomial (Fin (3 + 1)) k)) := sorry

/-- The closed immersion of the standard nonsingular conic into `ℙ³_k`. -/
def standardConicι (k : Type u) [Field k] :=
  projQuotientMap (grading k 3) (standardConicIdeal k)

/-- `standardConicι` is the projective-spectrum quotient map of `standardConicIdeal`. -/
theorem standardConicι_eq (k : Type u) [Field k] :
    standardConicι k = projQuotientMap (grading k 3) (standardConicIdeal k) := sorry

/-- The standard closed immersion of `X 3 = X 0 * X 2 - X 1 ^ 2 = 0` is a nonsingular conic. -/
instance instIsNonsingularConic_standardConicι (k : Type u) [Field k] :
    IsNonsingularConic (standardConicι k) := sorry

/-- The standard line `(X 0 : X 0 : 0 : X 1)` is disjoint from the standard conic
`X 3 = X 0 * X 2 - X 1 ^ 2 = 0`. -/
theorem disjoint_standardLineHom_standardConicι (k : Type u) [Field k] :
    Disjoint (Set.range (standardLineHom k)) (Set.range (standardConicι k)) := sorry

end AlgebraicGeometry.ProjectiveSpace
