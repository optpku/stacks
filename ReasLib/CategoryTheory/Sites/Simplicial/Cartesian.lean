module

public import ReasLib.CategoryTheory.Sites.Simplicial.LowerShriek
public import ReasLib.CategoryTheory.Sites.Simplicial.DerivedMorphism
public import ReasLib.CategoryTheory.DerivedCategory.Functor.Exact.Composition

/-!
# Cartesian objects on a simplicial site

Canonical restriction comparisons for sheaves and unbounded derived abelian sheaves.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite Functor

noncomputable section

universe u v w

namespace CategoryTheory.SimplicialSites

variable (C : SimplexCategory ⥤ Cat.{v, u}) (J : ∀ n, Precoverage (C.obj n))

/-- Every structure functor of a simplicial site diagram is continuous for the
Grothendieck topologies generated by the stage precoverages. -/
instance toFunctor_isContinuous [IsSiteDiagram C J]
    {m n : SimplexCategory} (φ : m ⟶ n) :
    (C.map φ).toFunctor.IsContinuous (J m).toGrothendieck (J n).toGrothendieck :=
  @Functor.Precoverage.IsContinuous.toContinuous _ _ _ _ (J m) (J n)
    (C.map φ).toFunctor
    (IsSiteDiagram.isSite (C := C) (J := J) m).toHasPullbacks
    (@Precoverage.IsSite.hasFactoringPullbacks _ _ (J m)
      (IsSiteDiagram.isSite (C := C) (J := J) m))
    (@Precoverage.IsSite.hasFactoringPullbacks _ _ (J n)
      (IsSiteDiagram.isSite (C := C) (J := J) n))
    (IsSiteDiagram.isContinuous (C := C) (J := J) φ)

variable [instWeakSheafify : ∀ n, HasWeakSheafify (J n).toGrothendieck (Type w)]
variable [instLeftKan : ∀ (m n : SimplexCategory) (φ : m ⟶ n) (P : (C.obj m)ᵒᵖ ⥤ Type w),
    ((C.map φ).toFunctor).op.HasLeftKanExtension P]
variable [instMorphismDiagram : IsMorphismDiagram C J]
include instMorphismDiagram instWeakSheafify instLeftKan

/-- Direct-image form of `F(φ)`: restriction along `stageInclusionWhisker` yields
`F_m ⟶ (u_φ)_* F_n`. -/
def transitionDirect (A : Type (w + 1)) [Category.{w} A]
    {m n : SimplexCategory} (φ : m ⟶ n) (F : Sheaf (topology C J) A) :
    (stageRestrict C J A m).obj F ⟶
      ((C.map φ).toFunctor.sheafPushforwardContinuous A
        (J m).toGrothendieck (J n).toGrothendieck).obj
        ((stageRestrict C J A n).obj F) :=
  (sheafPushforwardContinuousNatTrans (stageInclusionWhisker C φ) A
      (J m).toGrothendieck (topology C J)).app F ≫
    (sheafPushforwardContinuousComp (C.map φ).toFunctor (ofStage C n) A
        (J m).toGrothendieck (J n).toGrothendieck (topology C J)).inv.app F

/-- The comparison `F(φ) : f_φ⁻¹ F_m ⟶ F_n` for sheaves with coefficients in `A`, the mate of
`transitionDirect` under continuous sheaf adjunction. -/
def sheafTransition (A : Type (w + 1)) [Category.{w} A]
    [∀ n, HasWeakSheafify (J n).toGrothendieck A]
    [∀ (m n : SimplexCategory) (φ : m ⟶ n) (P : (C.obj m)ᵒᵖ ⥤ A),
      ((C.map φ).toFunctor).op.HasLeftKanExtension P]
    {m n : SimplexCategory} (φ : m ⟶ n) (F : Sheaf (topology C J) A) :
    ((C.map φ).toFunctor.sheafPullback A (J m).toGrothendieck (J n).toGrothendieck).obj
      ((stageRestrict C J A m).obj F) ⟶ (stageRestrict C J A n).obj F :=
  (((C.map φ).toFunctor.sheafAdjunctionContinuous A
      (J m).toGrothendieck (J n).toGrothendieck).homEquiv
    ((stageRestrict C J A m).obj F) ((stageRestrict C J A n).obj F)).symm
    (transitionDirect C J A φ F)

/-- The adjunction mate of `sheafTransition` is `transitionDirect`. -/
theorem sheafTransition_homEquiv (A : Type (w + 1)) [Category.{w} A]
    [∀ n, HasWeakSheafify (J n).toGrothendieck A]
    [∀ (m n : SimplexCategory) (φ : m ⟶ n) (P : (C.obj m)ᵒᵖ ⥤ A),
      ((C.map φ).toFunctor).op.HasLeftKanExtension P]
    {m n : SimplexCategory} (φ : m ⟶ n) (F : Sheaf (topology C J) A) :
    (((C.map φ).toFunctor.sheafAdjunctionContinuous A
        (J m).toGrothendieck (J n).toGrothendieck).homEquiv
      ((stageRestrict C J A m).obj F) ((stageRestrict C J A n).obj F))
      (sheafTransition C J A φ F) =
    transitionDirect C J A φ F :=
  Equiv.apply_symm_apply _ _

/-- The comparison `F(φ) : f_φ⁻¹ F_m ⟶ F_n` for type-valued sheaves. -/
abbrev transition {m n : SimplexCategory} (φ : m ⟶ n)
    (F : Sheaf (topology C J) (Type w)) :
    ((C.map φ).toFunctor.sheafPullback (Type w)
      (J m).toGrothendieck (J n).toGrothendieck).obj
      ((stageRestrict C J (Type w) m).obj F) ⟶ (stageRestrict C J (Type w) n).obj F :=
  sheafTransition C J (Type w) φ F

/-- The adjunction mate of `transition` is `transitionDirect`. -/
theorem transition_homEquiv {m n : SimplexCategory} (φ : m ⟶ n)
    (F : Sheaf (topology C J) (Type w)) :
    (((C.map φ).toFunctor.sheafAdjunctionContinuous (Type w)
        (J m).toGrothendieck (J n).toGrothendieck).homEquiv
      ((stageRestrict C J (Type w) m).obj F) ((stageRestrict C J (Type w) n).obj F))
      (transition C J φ F) =
    transitionDirect C J (Type w) φ F :=
  sheafTransition_homEquiv C J (Type w) φ F

/-- The comparison `F(φ) : f_φ⁻¹ F_m ⟶ F_n` for abelian sheaves. -/
abbrev abelianTransition {m n : SimplexCategory} (φ : m ⟶ n)
    [∀ n, HasWeakSheafify (J n).toGrothendieck AddCommGrpCat.{w}]
    [∀ (m n : SimplexCategory) (φ : m ⟶ n) (P : (C.obj m)ᵒᵖ ⥤ AddCommGrpCat.{w}),
      ((C.map φ).toFunctor).op.HasLeftKanExtension P]
    (F : Sheaf (topology C J) AddCommGrpCat.{w}) :
    ((C.map φ).toFunctor.sheafPullback AddCommGrpCat.{w}
      (J m).toGrothendieck (J n).toGrothendieck).obj
      ((stageRestrict C J AddCommGrpCat.{w} m).obj F) ⟶
    (stageRestrict C J AddCommGrpCat.{w} n).obj F :=
  sheafTransition C J AddCommGrpCat.{w} φ F

/-- The adjunction mate of `abelianTransition` is `transitionDirect`. -/
theorem abelianTransition_homEquiv {m n : SimplexCategory} (φ : m ⟶ n)
    [∀ n, HasWeakSheafify (J n).toGrothendieck AddCommGrpCat.{w}]
    [∀ (m n : SimplexCategory) (φ : m ⟶ n) (P : (C.obj m)ᵒᵖ ⥤ AddCommGrpCat.{w}),
      ((C.map φ).toFunctor).op.HasLeftKanExtension P]
    (F : Sheaf (topology C J) AddCommGrpCat.{w}) :
    (((C.map φ).toFunctor.sheafAdjunctionContinuous AddCommGrpCat.{w}
        (J m).toGrothendieck (J n).toGrothendieck).homEquiv
      ((stageRestrict C J AddCommGrpCat.{w} m).obj F)
      ((stageRestrict C J AddCommGrpCat.{w} n).obj F))
      (abelianTransition C J φ F) =
    transitionDirect C J AddCommGrpCat.{w} φ F :=
  sheafTransition_homEquiv C J AddCommGrpCat.{w} φ F


/-- The inverse-image comparison is natural in the total-site sheaf. -/
theorem sheafTransition_naturality (A : Type (w + 1)) [Category.{w} A]
    [∀ n, HasWeakSheafify (J n).toGrothendieck A]
    [∀ (m n : SimplexCategory) (φ : m ⟶ n) (P : (C.obj m)ᵒᵖ ⥤ A),
      ((C.map φ).toFunctor).op.HasLeftKanExtension P]
    {m n : SimplexCategory} (φ : m ⟶ n)
    {F G : Sheaf (topology C J) A} (f : F ⟶ G) :
    ((stageRestrict C J A m) ⋙
      (C.map φ).toFunctor.sheafPullback A (J m).toGrothendieck (J n).toGrothendieck).map f ≫
        sheafTransition C J A φ G =
      sheafTransition C J A φ F ≫ (stageRestrict C J A n).map f :=
  sorry

namespace Sheaf

variable {A : Type (w + 1)} [Category.{w} A]
variable [∀ n, HasWeakSheafify (J n).toGrothendieck A]
variable [∀ (m n : SimplexCategory) (φ : m ⟶ n) (P : (C.obj m)ᵒᵖ ⥤ A),
    ((C.map φ).toFunctor).op.HasLeftKanExtension P]

/-- A sheaf on `C_total` is cartesian when `F(φ) : f_φ⁻¹ F_m ⟶ F_n` is an
isomorphism for every simplex operator `φ`. -/
class IsCartesian (F : Sheaf (topology C J) A) : Prop where
  /-- Every simplex-operator comparison `F(φ)` is an isomorphism. -/
  isIso_transition : ∀ {m n : SimplexCategory} (φ : m ⟶ n),
    IsIso (sheafTransition C J A φ F)

/-- Cartesianness of a sheaf on `C_total` is equivalent to every `F(φ)` being an isomorphism. -/
theorem isCartesian_iff (F : Sheaf (topology C J) A) :
    IsCartesian C J F ↔
      ∀ {m n : SimplexCategory} (φ : m ⟶ n), IsIso (sheafTransition C J A φ F) :=
  ⟨fun h ↦ h.isIso_transition, fun h ↦ ⟨h⟩⟩

/-- A sheaf whose every simplex-operator comparison is an isomorphism is cartesian. -/
instance instIsCartesian_of_isIso (F : Sheaf (topology C J) A)
    [h : ∀ {m n : SimplexCategory} (φ : m ⟶ n), IsIso (sheafTransition C J A φ F)] :
    IsCartesian C J F where
  isIso_transition := h

/-- Every simplex-operator comparison of a cartesian sheaf is an isomorphism. -/
instance instIsIso_sheafTransition (F : Sheaf (topology C J) A) [IsCartesian C J F]
    {m n : SimplexCategory} (φ : m ⟶ n) :
    IsIso (sheafTransition C J A φ F) :=
  IsCartesian.isIso_transition φ

/-- The isomorphism `F(φ) : f_φ⁻¹ F_m ≅ F_n` attached to a cartesian sheaf. -/
def transitionIso (F : Sheaf (topology C J) A) [IsCartesian C J F]
    {m n : SimplexCategory} (φ : m ⟶ n) :
    ((C.map φ).toFunctor.sheafPullback A (J m).toGrothendieck (J n).toGrothendieck).obj
      ((stageRestrict C J A m).obj F) ≅ (stageRestrict C J A n).obj F :=
  asIso (sheafTransition C J A φ F)

/-- The forward map of `transitionIso` is `sheafTransition`. -/
theorem transitionIso_hom (F : Sheaf (topology C J) A) [IsCartesian C J F]
    {m n : SimplexCategory} (φ : m ⟶ n) :
    (transitionIso C J F φ).hom = sheafTransition C J A φ F :=
  rfl

end Sheaf

/-- A sheaf of sets on `C_total` is cartesian when every `F(φ) : f_φ⁻¹ F_m ⟶ F_n` is an
isomorphism. -/
abbrev IsCartesian (F : Sheaf (topology C J) (Type w)) :=
  Sheaf.IsCartesian C J F

/-- Cartesianness of a sheaf of sets is equivalent to every `F(φ)` being an isomorphism. -/
theorem isCartesian_iff (F : Sheaf (topology C J) (Type w)) :
    IsCartesian C J F ↔
      ∀ {m n : SimplexCategory} (φ : m ⟶ n), IsIso (transition C J φ F) :=
  Sheaf.isCartesian_iff C J F

/-- The isomorphism `F(φ) : f_φ⁻¹ F_m ≅ F_n` attached to a cartesian sheaf of sets. -/
def transitionIso (F : Sheaf (topology C J) (Type w)) [IsCartesian C J F]
    {m n : SimplexCategory} (φ : m ⟶ n) :
    ((C.map φ).toFunctor.sheafPullback (Type w)
      (J m).toGrothendieck (J n).toGrothendieck).obj
      ((stageRestrict C J (Type w) m).obj F) ≅ (stageRestrict C J (Type w) n).obj F :=
  Sheaf.transitionIso C J F φ

/-- The forward map of `transitionIso` is `transition`. -/
theorem transitionIso_hom (F : Sheaf (topology C J) (Type w)) [IsCartesian C J F]
    {m n : SimplexCategory} (φ : m ⟶ n) :
    (transitionIso C J F φ).hom = transition C J φ F :=
  rfl

variable [∀ n, HasWeakSheafify (J n).toGrothendieck AddCommGrpCat.{w}]
variable [∀ (m n : SimplexCategory) (φ : m ⟶ n) (P : (C.obj m)ᵒᵖ ⥤ AddCommGrpCat.{w}),
    ((C.map φ).toFunctor).op.HasLeftKanExtension P]

/-- A sheaf of abelian groups on `C_total` is cartesian when every `F(φ) : f_φ⁻¹ F_m ⟶ F_n`
is an isomorphism. -/
abbrev Abelian.IsCartesian (F : Sheaf (topology C J) AddCommGrpCat.{w}) :=
  Sheaf.IsCartesian C J F

/-- Cartesianness of a sheaf of abelian groups is equivalent to every `F(φ)` being an
isomorphism. -/
theorem abelian_isCartesian_iff (F : Sheaf (topology C J) AddCommGrpCat.{w}) :
    Abelian.IsCartesian C J F ↔
      ∀ {m n : SimplexCategory} (φ : m ⟶ n), IsIso (abelianTransition C J φ F) :=
  Sheaf.isCartesian_iff C J F

/-- The isomorphism `F(φ) : f_φ⁻¹ F_m ≅ F_n` attached to a cartesian sheaf of abelian groups. -/
def abelianTransitionIso (F : Sheaf (topology C J) AddCommGrpCat.{w})
    [Abelian.IsCartesian C J F] {m n : SimplexCategory} (φ : m ⟶ n) :
    ((C.map φ).toFunctor.sheafPullback AddCommGrpCat.{w}
      (J m).toGrothendieck (J n).toGrothendieck).obj
      ((stageRestrict C J AddCommGrpCat.{w} m).obj F) ≅
    (stageRestrict C J AddCommGrpCat.{w} n).obj F :=
  Sheaf.transitionIso C J F φ

/-- The forward map of `abelianTransitionIso` is `abelianTransition`. -/
theorem abelianTransitionIso_hom (F : Sheaf (topology C J) AddCommGrpCat.{w})
    [Abelian.IsCartesian C J F] {m n : SimplexCategory} (φ : m ⟶ n) :
    (abelianTransitionIso C J F φ).hom = abelianTransition C J φ F :=
  rfl

variable [HasSheafify (topology C J) AddCommGrpCat.{w}]
variable [∀ n, HasSheafify (J n).toGrothendieck AddCommGrpCat.{w}]

/-- Pullback of abelian sheaves along a simplex operator preserves finite limits. -/
instance toFunctor_abelian_preservesFiniteLimits {m n : SimplexCategory} (φ : m ⟶ n) :
    PreservesFiniteLimits
      ((C.map φ).toFunctor.sheafPullback AddCommGrpCat.{w}
        (J m).toGrothendieck (J n).toGrothendieck) :=
  sorry

/-- Pullback of abelian sheaves along a simplex operator preserves finite colimits. -/
instance toFunctor_abelian_preservesFiniteColimits {m n : SimplexCategory} (φ : m ⟶ n) :
    PreservesFiniteColimits
      ((C.map φ).toFunctor.sheafPullback AddCommGrpCat.{w}
        (J m).toGrothendieck (J n).toGrothendieck) :=
  @PreservesColimitsOfSize.preservesFiniteColimits.{0, 0} _ _ _ _ _
    ((Functor.sheafAdjunctionContinuous (C.map φ).toFunctor AddCommGrpCat.{w}
      (J m).toGrothendieck (J n).toGrothendieck).leftAdjoint_preservesColimits)

/-- The natural transformation of abelian stage restriction whose components are `F(φ)`. -/
def abelianTransitionNatTrans {m n : SimplexCategory} (φ : m ⟶ n) :
    stageRestrict C J AddCommGrpCat.{w} m ⋙
      (C.map φ).toFunctor.sheafPullback AddCommGrpCat.{w}
        (J m).toGrothendieck (J n).toGrothendieck ⟶
    stageRestrict C J AddCommGrpCat.{w} n where
  app F := abelianTransition C J φ F
  naturality _ _ f := sheafTransition_naturality C J AddCommGrpCat.{w} φ f

/-- Bundled exact stage restriction of abelian sheaves. -/
def derivedComponentExact (n : SimplexCategory) :
    Sheaf (topology C J) AddCommGrpCat.{w} ⥤ₑ
      Sheaf ((J n).toGrothendieck) AddCommGrpCat.{w} :=
  ExactFunctor.of (stageRestrict C J AddCommGrpCat.{w} n)

/-- The underlying functor of `derivedComponentExact n` is abelian stage restriction. -/
theorem derivedComponentExact_obj (n : SimplexCategory) :
    (derivedComponentExact C J n).obj = stageRestrict C J AddCommGrpCat.{w} n :=
  rfl

/-- Bundled exact inverse image of abelian sheaves along a simplex operator. -/
def abelianInverseImageExact {m n : SimplexCategory} (φ : m ⟶ n) :
    Sheaf ((J m).toGrothendieck) AddCommGrpCat.{w} ⥤ₑ
      Sheaf ((J n).toGrothendieck) AddCommGrpCat.{w} :=
  ExactFunctor.of
    ((C.map φ).toFunctor.sheafPullback AddCommGrpCat.{w}
      (J m).toGrothendieck (J n).toGrothendieck)

/-- The underlying functor of `abelianInverseImageExact φ` is `f_φ⁻¹`. -/
theorem abelianInverseImageExact_obj {m n : SimplexCategory} (φ : m ⟶ n) :
    (abelianInverseImageExact C J φ).obj = (C.map φ).toFunctor.sheafPullback AddCommGrpCat.{w} (J m).toGrothendieck (J n).toGrothendieck :=
  rfl

/-- Exactness identifies `D(component m ⋙ f_φ⁻¹)` with `f_φ⁻¹` after `K ↦ K_m`. -/
def derivedTransitionCompIso {m n : SimplexCategory} (φ : m ⟶ n) :
    (stageRestrict C J AddCommGrpCat.{w} m ⋙
        (C.map φ).toFunctor.sheafPullback AddCommGrpCat.{w}
          (J m).toGrothendieck (J n).toGrothendieck).mapDerivedCategory ≅
      (derivedRestrict C J m) ⋙ ((C.map φ).toFunctor.sheafPullback AddCommGrpCat.{w} (J m).toGrothendieck (J n).toGrothendieck).mapDerivedCategory :=
  CategoryTheory.ExactFunctor.MapDerivedCategory.compFunctorIso
    (derivedComponentExact C J m) (abelianInverseImageExact C J φ)

/-- `derivedTransitionCompIso` is the exact-functor composition comparison. -/
theorem derivedTransitionCompIso_eq {m n : SimplexCategory} (φ : m ⟶ n) :
    derivedTransitionCompIso C J φ =
      CategoryTheory.ExactFunctor.MapDerivedCategory.compFunctorIso
        (derivedComponentExact C J m) (abelianInverseImageExact C J φ) :=
  rfl

/-- The comparison out of `D(component m ⋙ f_φ⁻¹)` induced by `abelianTransitionNatTrans`. -/
def derivedTransitionComposite {m n : SimplexCategory} (φ : m ⟶ n)
    (K : DerivedCategory (Sheaf (topology C J) AddCommGrpCat.{w})) :
    ((stageRestrict C J AddCommGrpCat.{w} m ⋙
        (C.map φ).toFunctor.sheafPullback AddCommGrpCat.{w}
          (J m).toGrothendieck (J n).toGrothendieck).mapDerivedCategory).obj K ⟶
    (derivedRestrict C J n).obj K :=
  (Localization.liftNatTrans DerivedCategory.Q
      (HomologicalComplex.quasiIso _ (ComplexShape.up ℤ))
      ((stageRestrict C J AddCommGrpCat.{w} m ⋙
          (C.map φ).toFunctor.sheafPullback AddCommGrpCat.{w}
            (J m).toGrothendieck (J n).toGrothendieck).mapHomologicalComplex
        (ComplexShape.up ℤ) ⋙ DerivedCategory.Q)
      ((stageRestrict C J AddCommGrpCat.{w} n).mapHomologicalComplex
        (ComplexShape.up ℤ) ⋙ DerivedCategory.Q)
      (stageRestrict C J AddCommGrpCat.{w} m ⋙
          (C.map φ).toFunctor.sheafPullback AddCommGrpCat.{w}
            (J m).toGrothendieck (J n).toGrothendieck).mapDerivedCategory
      (stageRestrict C J AddCommGrpCat.{w} n).mapDerivedCategory
      (whiskerRight (NatTrans.mapHomologicalComplex (abelianTransitionNatTrans C J φ)
          (ComplexShape.up ℤ))
        DerivedCategory.Q)).app K

/-- The comparison `f_φ⁻¹ K_m ⟶ K_n` of objects of `D(C_total)`. -/
def derivedTransition {m n : SimplexCategory} (φ : m ⟶ n)
    (K : DerivedCategory (Sheaf (topology C J) AddCommGrpCat.{w})) :
    ((C.map φ).toFunctor.sheafPullback AddCommGrpCat.{w} (J m).toGrothendieck (J n).toGrothendieck).mapDerivedCategory.obj ((derivedRestrict C J m).obj K) ⟶
      (derivedRestrict C J n).obj K :=
  (derivedTransitionCompIso C J φ).inv.app K ≫ derivedTransitionComposite C J φ K

/-- `derivedTransition` is the composite comparison conjugated by exactness of `f_φ⁻¹`. -/
theorem derivedTransition_eq {m n : SimplexCategory} (φ : m ⟶ n)
    (K : DerivedCategory (Sheaf (topology C J) AddCommGrpCat.{w})) :
    derivedTransition C J φ K =
      (derivedTransitionCompIso C J φ).inv.app K ≫ derivedTransitionComposite C J φ K :=
  rfl


namespace AbelianDerived

/-- An object of `D(C_total)` is cartesian when `f_φ⁻¹ K_m ⟶ K_n` is an isomorphism for
every simplex operator `φ`. -/
class IsCartesian
    (K : DerivedCategory (Sheaf (topology C J) AddCommGrpCat.{w})) : Prop where
  /-- Every simplex-operator derived comparison is an isomorphism. -/
  isIso_transition : ∀ {m n : SimplexCategory} (φ : m ⟶ n),
    IsIso (derivedTransition C J φ K)

/-- Cartesianness of an object of `D(C_total)` is equivalent to every simplex-operator
comparison being an isomorphism. -/
theorem isCartesian_iff
    (K : DerivedCategory (Sheaf (topology C J) AddCommGrpCat.{w})) :
    IsCartesian C J K ↔
      ∀ {m n : SimplexCategory} (φ : m ⟶ n), IsIso (derivedTransition C J φ K) :=
  ⟨fun h ↦ h.isIso_transition, fun h ↦ ⟨h⟩⟩

/-- An object of `D(C_total)` whose every simplex-operator comparison is an isomorphism
is cartesian. -/
instance instIsCartesian_of_isIso
    (K : DerivedCategory (Sheaf (topology C J) AddCommGrpCat.{w}))
    [h : ∀ {m n : SimplexCategory} (φ : m ⟶ n), IsIso (derivedTransition C J φ K)] :
    IsCartesian C J K where
  isIso_transition := h

/-- Every simplex-operator comparison of a cartesian object of `D(C_total)` is an
isomorphism. -/
instance instIsIso_derivedTransition
    (K : DerivedCategory (Sheaf (topology C J) AddCommGrpCat.{w}))
    [IsCartesian C J K] {m n : SimplexCategory} (φ : m ⟶ n) :
    IsIso (derivedTransition C J φ K) :=
  IsCartesian.isIso_transition φ

/-- The isomorphism `f_φ⁻¹ K_m ≅ K_n` attached to a cartesian object of `D(C_total)`. -/
def transitionIso (K : DerivedCategory (Sheaf (topology C J) AddCommGrpCat.{w}))
    [IsCartesian C J K] {m n : SimplexCategory} (φ : m ⟶ n) :
    ((C.map φ).toFunctor.sheafPullback AddCommGrpCat.{w} (J m).toGrothendieck (J n).toGrothendieck).mapDerivedCategory.obj ((derivedRestrict C J m).obj K) ≅
      (derivedRestrict C J n).obj K :=
  asIso (derivedTransition C J φ K)

/-- The forward map of `AbelianDerived.transitionIso` is `derivedTransition`. -/
theorem transitionIso_hom
    (K : DerivedCategory (Sheaf (topology C J) AddCommGrpCat.{w}))
    [IsCartesian C J K] {m n : SimplexCategory} (φ : m ⟶ n) :
    (transitionIso C J K φ).hom = derivedTransition C J φ K :=
  rfl

end AbelianDerived

/-- An object of `D(C_total)` is cartesian when every `f_φ⁻¹ K_m ⟶ K_n` is an isomorphism. -/
abbrev Derived.IsCartesian
    (K : DerivedCategory (Sheaf (topology C J) AddCommGrpCat.{w})) :=
  AbelianDerived.IsCartesian C J K


end CategoryTheory.SimplicialSites
