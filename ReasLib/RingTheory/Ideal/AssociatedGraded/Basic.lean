/-!
# Associated Graded Objects of an Ideal

This leaf owns the quotient-Rees model of the associated graded ring of an
ideal and the elementary `I`-adic associated graded module.  It deliberately
does not include sequence-specific presentations or quasi-regularity: those
are consumers of these objects.
-/

@[expose] public section

noncomputable section

universe u v

namespace Ideal.AssociatedGraded

section Ring

variable {R : Type u} [CommRing R]

/-- The homogeneous ideal of `reesAlgebra I` generated by the degree-zero
copy of `I`. -/
abbrev definingIdeal (I : Ideal R) : Ideal (reesAlgebra I) :=
  Ideal.map (algebraMap R (reesAlgebra I)) I

/-- The quotient-Rees model of the associated graded ring
`gr_I(R) = ⨁ n, I ^ n / I ^ (n + 1)`. -/
abbrev ring (I : Ideal R) : Type u :=
  reesAlgebra I ⧸ definingIdeal I

/-- The degree-one class of an element of `I` in the quotient-Rees associated
graded ring. -/
def degreeOne {I : Ideal R} (x : I) : ring I :=
  Ideal.Quotient.mk (definingIdeal I) (ReesAlgebra.Grading.degreeOne I x)

/-- A map carrying `I` into `J` carries the defining ideal of `gr_I(R)` into
the defining ideal of `gr_J(S)`. -/
theorem definingIdeal_le_comap
    {S : Type v} [CommRing S] {I : Ideal R} {J : Ideal S}
    (f : R →+* S) (hIJ : I ≤ Ideal.comap f J) :
    definingIdeal I ≤
      Ideal.comap (ReesAlgebra.Grading.map f hIJ) (definingIdeal J) := sorry

/-- The map of quotient-Rees associated graded rings induced by a ring map
carrying `I` into `J`. -/
def map
    {S : Type v} [CommRing S] {I : Ideal R} {J : Ideal S}
    (f : R →+* S) (hIJ : I ≤ Ideal.comap f J) : ring I →+* ring J :=
  Ideal.quotientMap (definingIdeal J) (ReesAlgebra.Grading.map f hIJ)
    (definingIdeal_le_comap f hIJ)

/-- The associated graded map sends a quotient-Rees class to the class of its
coefficientwise image. -/
theorem map_mk
    {S : Type v} [CommRing S] {I : Ideal R} {J : Ideal S}
    (f : R →+* S) (hIJ : I ≤ Ideal.comap f J) (x : reesAlgebra I) :
    map f hIJ (Ideal.Quotient.mk (definingIdeal I) x) =
      Ideal.Quotient.mk (definingIdeal J) (ReesAlgebra.Grading.map f hIJ x) := sorry

/-- The quotient homomorphism from the Rees algebra onto its associated
graded ring. -/
abbrev quotientMap (I : Ideal R) : reesAlgebra I →ₐ[R] ring I :=
  Ideal.Quotient.mkₐ R (definingIdeal I)

/-- The defining ideal of the quotient-Rees presentation is homogeneous for the canonical Rees
grading. -/
@[stacks 00K8 "associated graded homogeneous defining ideal"]
theorem definingIdeal_isHomogeneous (I : Ideal R) :
    (definingIdeal I).IsHomogeneous (ReesAlgebra.Grading.grade I) := sorry

/-- The degree-`n` homogeneous submodule of the quotient-Rees associated graded ring.

This is the generic homogeneous-ideal quotient grading specialized to the canonical Rees grading. -/
abbrev grade (I : Ideal R) (n : ℕ) : Submodule R (ring I) :=
  GradedAlgebra.Quotient.grading (ReesAlgebra.Grading.grade I) (definingIdeal I) n

/-- The degree-one class of an element of `I` is homogeneous of degree one. -/
theorem degreeOne_mem_grade {I : Ideal R} (x : I) :
    degreeOne x ∈ grade I 1 := sorry

/-- The associated graded map preserves the degree-`n` homogeneous pieces. -/
theorem map_mem_grade
    {S : Type v} [CommRing S] (I : Ideal R) (J : Ideal S)
    (f : R →+* S) (hIJ : I ≤ Ideal.comap f J) (n : ℕ)
    {x : ring I} (hx : x ∈ grade I n) :
    map f hIJ x ∈ grade J n := sorry

/-- The degree-`n` component of the associated graded map induced by `f`. -/
def mapGrade
    {S : Type v} [CommRing S] (I : Ideal R) (J : Ideal S)
    (f : R →+* S) (hIJ : I ≤ Ideal.comap f J) (n : ℕ) :
    grade I n → grade J n :=
  fun x ↦ ⟨map f hIJ x, map_mem_grade I J f hIJ n x.2⟩

/-- The quotient-Rees associated graded ring carries its canonical internal
`ℕ`-grading. -/
noncomputable instance gradedAlgebra (I : Ideal R) : GradedAlgebra (grade I) :=
  GradedAlgebra.Quotient.gradedAlgebra
    (ReesAlgebra.Grading.grade I) (definingIdeal I) (definingIdeal_isHomogeneous I)

/-- The quotient-Rees homogeneous pieces form an internal direct-sum decomposition. -/
theorem grade_isInternal (I : Ideal R) :
    DirectSum.IsInternal (grade I) := sorry

end Ring

section Module

variable {R : Type u} [CommRing R]

/-- The `n`-th stage `I ^ n M` of the `I`-adic filtration of an `R`-module. -/
abbrev stage (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M]
    (n : ℕ) : Submodule R M :=
  Ideal.PowerSubmodule.stage I M n

/-- The next `I`-adic stage, regarded as a submodule of the current one. -/
abbrev denominator (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M]
    (n : ℕ) : Submodule R (stage I M n) :=
  (stage I M (n + 1)).submoduleOf (stage I M n)

/-- The degree-`n` associated graded piece `I ^ n M / I ^ (n + 1) M`. -/
abbrev piece (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M]
    (n : ℕ) : Type v :=
  stage I M n ⧸ denominator I M n

/-- The quotient denominator `I (I ^ n M)` inside the current stage. -/
abbrev internalDenominator (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M]
    (n : ℕ) : Submodule R (stage I M n) :=
  I • (⊤ : Submodule R (stage I M n))

/-- The internal quotient model `I ^ n M / I(I ^ n M)` of an associated
graded piece. -/
abbrev internalPiece (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M]
    (n : ℕ) : Type v :=
  stage I M n ⧸ internalDenominator I M n

/-- The direct sum of all associated graded pieces of the `I`-adic filtration
of `M`. -/
abbrev gradedModule (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M] : Type v :=
  DirectSum ℕ (piece I M)

/-- The zeroth `I`-adic stage is the whole module. -/
theorem stage_zero_eq_top (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M] :
    stage I M 0 = ⊤ := sorry

/-- Every module element belongs to the zeroth `I`-adic stage. -/
theorem mem_stage_zero (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M]
    (m : M) : m ∈ stage I M 0 := sorry

/-- Successive `I`-adic stages satisfy `I ^ (n + 1) M = I (I ^ n M)`. -/
theorem stage_succ_eq_smul (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M]
    (n : ℕ) : stage I M (n + 1) = I • stage I M n := sorry

/-- Multiplication by `I ^ d` shifts the `I`-adic filtration stage by `d`. -/
theorem pow_smul_stage_eq (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M]
    (d n : ℕ) :
    ((I ^ d) • stage I M n : Submodule R M) = stage I M (n + d) := sorry

/-- Multiplication by `I ^ d` shifts the quotient denominator in the
`I`-adic filtration. -/
theorem pow_smul_denominator_eq (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M]
    (d n : ℕ) :
    ((I ^ d) • (I • stage I M n) : Submodule R M) =
      I • stage I M (n + d) := sorry

/-- The internal denominator `I(I ^ n M)` is the next filtration stage
inside `I ^ n M`. -/
theorem internalDenominator_eq_denominator
    (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M] (n : ℕ) :
    internalDenominator I M n = denominator I M n := sorry

/-- The internal quotient model is canonically linearly equivalent to the
usual associated graded piece. -/
noncomputable def internalPieceEquiv
    (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M] (n : ℕ) :
    internalPiece I M n ≃ₗ[R] piece I M n :=
  Submodule.quotEquivOfEq _ _ (internalDenominator_eq_denominator I M n)

/-- Each associated graded piece is canonically a module over `R ⧸ I`. -/
noncomputable instance pieceModuleQuotient
    (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M] (n : ℕ) :
    Module (R ⧸ I) (piece I M n) :=
  (internalPieceEquiv I M n).symm.toAddEquiv.module _

/-- The quotient action on a successive-stage model of an associated graded
piece is compatible with its original `R`-module action. -/
@[stacks 00K8 "associated graded piece quotient scalar tower"]
noncomputable instance pieceIsScalarTowerQuotient
    (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M] (n : ℕ) :
    IsScalarTower R (R ⧸ I) (piece I M n) :=
  LinearEquiv.isScalarTower (R := R) (A := R ⧸ I)
    (internalPieceEquiv I M n).symm

/-- The intrinsic and successive-stage models of an associated graded piece
are canonically linearly equivalent over `R ⧸ I`. -/
noncomputable def internalPieceEquivQuotient
    (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M] (n : ℕ) :
    internalPiece I M n ≃ₗ[R ⧸ I] piece I M n :=
  (internalPieceEquiv I M n).extendScalarsOfSurjective
    Ideal.Quotient.mk_surjective

/-- The internal maximal-ideal piece carries its quotient action under the residue-field name. -/
noncomputable instance internalPieceModuleResidueField [IsLocalRing R]
    (M : Type v) [AddCommGroup M] [Module R M] (n : ℕ) :
    Module (IsLocalRing.ResidueField R)
      (internalPiece (IsLocalRing.maximalIdeal R) M n) :=
  inferInstanceAs (Module (R ⧸ IsLocalRing.maximalIdeal R)
    (internalPiece (IsLocalRing.maximalIdeal R) M n))

/-- The usual maximal-ideal graded piece carries its quotient action under the residue-field name. -/
noncomputable instance pieceModuleResidueField [IsLocalRing R]
    (M : Type v) [AddCommGroup M] [Module R M] (n : ℕ) :
    Module (IsLocalRing.ResidueField R)
      (piece (IsLocalRing.maximalIdeal R) M n) :=
  pieceModuleQuotient (IsLocalRing.maximalIdeal R) M n

/-- For a local ring, the two models of a maximal-ideal associated graded
piece are canonically linearly equivalent over the residue field. -/
noncomputable def internalPieceEquivResidueField [IsLocalRing R]
    (M : Type v) [AddCommGroup M] [Module R M] (n : ℕ) :
    internalPiece (IsLocalRing.maximalIdeal R) M n ≃ₗ[IsLocalRing.ResidueField R]
      piece (IsLocalRing.maximalIdeal R) M n :=
  internalPieceEquivQuotient (IsLocalRing.maximalIdeal R) M n

end Module

end Ideal.AssociatedGraded
