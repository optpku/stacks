module

public import ReasLib.RingTheory.MvPolynomial.XyPower
public import Mathlib.AlgebraicGeometry.Noetherian

/-!
# The affine spectrum of the monomial subalgebra generated by `x y^i`

Over a field, this affine scheme has a Noetherian underlying topological space
but is not a Noetherian scheme.
-/

@[expose] public section

universe u

open AlgebraicGeometry TopologicalSpace

namespace MvPolynomial.XyPower

/-- Over a field, the underlying space of the affine spectrum of the monomial
subalgebra generated by `x y^i` is Noetherian. -/
instance instNoetherianSpace_spec {k : Type u} [Field k] :
    NoetherianSpace (Spec (CommRingCat.of (adjoin k))) := sorry

/-- Over a field, the affine spectrum of the monomial subalgebra generated by
`x y^i` is not a Noetherian scheme. -/
theorem not_isNoetherian_spec {k : Type u} [Field k] :
    ¬ IsNoetherian (Spec (CommRingCat.of (adjoin k))) := sorry

end MvPolynomial.XyPower
