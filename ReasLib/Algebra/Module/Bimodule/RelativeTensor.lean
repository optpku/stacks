/-!
# Relative Tensor Products of Algebra Modules

The relative tensor product is the quotient of a ground-ring tensor product by the middle-algebra
balancing relations.  This file owns the quotient, pure tensors, its universal lift, and the
canonical right action inherited from the second factor.  Functorial maps are kept in the
`RelativeTensor.Map` leaf.
-/

@[expose] public section

noncomputable section

open scoped TensorProduct

namespace Module.Bimodule

universe i j u v w x y z t

variable {R : Type u} [CommRing R]
variable {A : Type v} [Ring A] [Algebra R A]
variable {B : Type w} [Ring B] [Algebra R B]

namespace RelativeTensor

variable {M : Type x} [AddCommGroup M] [Module R M] [Module Aᵐᵒᵖ M]
variable [IsScalarTower R Aᵐᵒᵖ M]
variable {N : Type y} [AddCommGroup N] [Module R N] [Module A N]
variable [IsScalarTower R A N]

/-- The ground-ring tensor product before imposing the middle-algebra balancing relation. -/
abbrev Raw := TensorProduct R M N

/-- A generator `(m * a) ⊗ n - m ⊗ (a * n)` of the relative tensor relations. -/
def balanceGenerator (m : M) (a : A) (n : N) : Raw (R := R) (M := M) (N := N) :=
  (MulOpposite.op a • m) ⊗ₜ[R] n - m ⊗ₜ[R] (a • n)

/-- The `R`-submodule generated by the middle-algebra balancing relations. -/
def relations : Submodule R (Raw (R := R) (M := M) (N := N)) :=
  Submodule.span R {z | ∃ (m : M) (a : A) (n : N), z = balanceGenerator m a n}

/-- The relative tensor product `M ⊗_A N`, constructed as the explicit balancing quotient. -/
@[stacks 09LN "concrete relative tensor product"]
abbrev Product :=
  Raw (R := R) (M := M) (N := N) ⧸ relations (R := R) (A := A) (M := M) (N := N)

/-- The quotient map from the ground-ring tensor product to the relative tensor product. -/
def mk : Raw (R := R) (M := M) (N := N) →ₗ[R]
    Product (R := R) (A := A) (M := M) (N := N) :=
  (relations (R := R) (A := A) (M := M) (N := N)).mkQ

/-- The class of a pure tensor in the relative tensor product. -/
def tmul (m : M) (n : N) : Product (R := R) (A := A) (M := M) (N := N) :=
  mk (R := R) (A := A) (M := M) (N := N) (m ⊗ₜ[R] n)

/-- Pure tensor formation with a fixed first input, as an `R`-linear map. -/
def tmulRight (m : M) :
    N →ₗ[R] Product (R := R) (A := A) (M := M) (N := N) where
  toFun := tmul (R := R) (A := A) m
  map_add' := sorry
  map_smul' := sorry

/-- Pure tensor formation with a fixed second input, as an `R`-linear map. -/
def tmulLeft (n : N) :
    M →ₗ[R] Product (R := R) (A := A) (M := M) (N := N) where
  toFun := fun m ↦ tmul (R := R) (A := A) m n
  map_add' := sorry
  map_smul' := sorry

/-- Pure tensors satisfy the defining middle-algebra balancing relation. -/
@[simp]
theorem tmul_balance (m : M) (a : A) (n : N) :
    tmul (R := R) (A := A) (MulOpposite.op a • m) n =
      tmul (R := R) (A := A) m (a • n) := sorry

/-- A bilinear map is `A`-balanced when the right action on its first input agrees with the
left action on its second input. -/
def IsBalanced {Q : Type t} [AddCommGroup Q] [Module R Q] (f : M →ₗ[R] N →ₗ[R] Q) : Prop :=
  ∀ (a : A) (m : M) (n : N), f (MulOpposite.op a • m) n = f m (a • n)

/-- An `A`-balanced bilinear map kills the defining relative tensor relations. -/
theorem relations_le_ker {Q : Type t} [AddCommGroup Q] [Module R Q]
    (f : M →ₗ[R] N →ₗ[R] Q)
    (hf : IsBalanced (R := R) (A := A) (M := M) (N := N) f) :
    relations (R := R) (A := A) (M := M) (N := N) ≤
      LinearMap.ker (TensorProduct.lift (R := R) f) := sorry

/-- Descend an `A`-balanced bilinear map through the relative tensor quotient. -/
def lift {Q : Type t} [AddCommGroup Q] [Module R Q]
    (f : M →ₗ[R] N →ₗ[R] Q)
    (hf : IsBalanced (R := R) (A := A) (M := M) (N := N) f) :
    Product (R := R) (A := A) (M := M) (N := N) →ₗ[R] Q :=
  (relations (R := R) (A := A) (M := M) (N := N)).liftQ
    (TensorProduct.lift (R := R) f)
    (relations_le_ker (R := R) (A := A) (M := M) (N := N) f hf)

/-- A descended balanced map evaluates on a pure tensor by the original bilinear pairing. -/
@[simp]
theorem lift_tmul {Q : Type t} [AddCommGroup Q] [Module R Q]
    (f : M →ₗ[R] N →ₗ[R] Q)
    (hf : IsBalanced (R := R) (A := A) (M := M) (N := N) f) (m : M) (n : N) :
    lift (R := R) (A := A) (M := M) (N := N) f hf
        (tmul (R := R) (A := A) m n) = f m n := sorry

/-- A linear map from a relative tensor product is determined by its values on pure tensors. -/
theorem lift_unique {Q : Type t} [AddCommGroup Q] [Module R Q]
    (f : M →ₗ[R] N →ₗ[R] Q)
    (hf : IsBalanced (R := R) (A := A) (M := M) (N := N) f)
    (g : Product (R := R) (A := A) (M := M) (N := N) →ₗ[R] Q)
    (h : ∀ m n, g (tmul (R := R) (A := A) m n) = f m n) :
    g = lift (R := R) (A := A) (M := M) (N := N) f hf := sorry

/-- Prove a predicate on a relative tensor quotient by checking zero, addition, and pure
tensors. -/
@[elab_as_elim, induction_eliminator]
protected theorem induction_on
    {p : Product (R := R) (A := A) (M := M) (N := N) → Prop}
    (x : Product (R := R) (A := A) (M := M) (N := N))
    (zero : p 0)
    (tmul : ∀ m n, p (tmul (R := R) (A := A) m n))
    (add : ∀ x y, p x → p y → p (x + y)) :
    p x := sorry

variable [Module Bᵐᵒᵖ N] [IsScalarTower R Bᵐᵒᵖ N]
variable [SMulCommClass A Bᵐᵒᵖ N]

/-- Right multiplication in the second factor before passing to the balancing quotient. -/
def rightRaw (b : Bᵐᵒᵖ) :
    Raw (R := R) (M := M) (N := N) →ₗ[R] Raw (R := R) (M := M) (N := N) :=
  TensorProduct.lift
    { toFun := fun m ↦
        { toFun := fun n ↦ m ⊗ₜ[R] (b • n)
          map_add' := sorry
          map_smul' := sorry }
      map_add' := sorry
      map_smul' := sorry }

/-- Right multiplication in the second factor preserves the balancing relations. -/
theorem right_relations (b : Bᵐᵒᵖ) :
    relations (R := R) (A := A) (M := M) (N := N) ≤
      Submodule.comap (rightRaw (R := R) (B := B) (M := M) (N := N) b)
        (relations (R := R) (A := A) (M := M) (N := N)) := sorry

/-- Right multiplication descended to the relative tensor quotient. -/
def rightLinear (b : Bᵐᵒᵖ) :
    Product (R := R) (A := A) (M := M) (N := N) →ₗ[R]
      Product (R := R) (A := A) (M := M) (N := N) :=
  (relations (R := R) (A := A) (M := M) (N := N)).mapQ
    (relations (R := R) (A := A) (M := M) (N := N))
    (rightRaw (R := R) (B := B) (M := M) (N := N) b)
    (right_relations (R := R) (A := A) (B := B) (M := M) (N := N) b)

/-- The relative tensor quotient inherits the canonical right `B`-module structure from its
second factor. -/
instance instModuleRight :
    Module Bᵐᵒᵖ (Product (R := R) (A := A) (M := M) (N := N)) where
  smul b x := rightLinear (R := R) (A := A) (B := B) (M := M) (N := N) b x
  one_smul := sorry
  mul_smul := sorry
  smul_zero := sorry
  smul_add := sorry
  add_smul := sorry
  zero_smul := sorry

/-- The ground-ring and inherited right `B` actions on a relative tensor product form a scalar
tower. -/
instance instIsScalarTowerRight :
    IsScalarTower R Bᵐᵒᵖ (Product (R := R) (A := A) (M := M) (N := N)) where
  smul_assoc := sorry

/-- Right multiplication on a pure relative tensor acts in the second factor. -/
@[simp]
theorem tmul_smul (m : M) (n : N) (b : Bᵐᵒᵖ) :
    b • tmul (R := R) (A := A) m n = tmul (R := R) (A := A) m (b • n) := sorry

/-- Linear maps from a relative tensor product are determined on pure tensors. -/
@[ext]
theorem hom_ext {Q : Type t} [AddCommGroup Q] [Module R Q]
    {f g : Product (R := R) (A := A) (M := M) (N := N) →ₗ[R] Q}
    (h : ∀ m n, f (tmul (R := R) (A := A) m n) =
      g (tmul (R := R) (A := A) m n)) :
    f = g := sorry

/-- Right `B`-linear maps from a relative tensor product are determined on pure tensors. -/
@[ext]
theorem hom_ext_right {Q : Type t} [AddCommGroup Q] [Module Bᵐᵒᵖ Q]
    {f g : Product (R := R) (A := A) (M := M) (N := N) →ₗ[Bᵐᵒᵖ] Q}
    (h : ∀ m n, f (tmul (R := R) (A := A) m n) =
      g (tmul (R := R) (A := A) m n)) :
    f = g := sorry

end RelativeTensor

end Module.Bimodule

/-- Scoped notation for the concrete relative tensor quotient over the middle algebra. -/
scoped[RelativeTensor] notation:100 M:100 " ⊗ᵣ[" R ", " A "] " N:101 =>
  Module.Bimodule.RelativeTensor.Product (R := R) (A := A) (M := M) (N := N)
