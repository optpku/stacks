module

public import ReasLib.CategoryTheory.Sites.Sheafification.FreeAbelian
public import ReasLib.CategoryTheory.Sites.SheafifiedRepresentable.Hom
public import Mathlib.CategoryTheory.Sites.Adjunction
public import Mathlib.CategoryTheory.Preadditive.Yoneda.Basic
public import Mathlib.CategoryTheory.Preadditive.Injective.Basic
import Mathlib.Tactic.CrossRefAttribute

/-!
# Free abelian sheafified representables and sections

This leaf combines the free-abelian sheafification adjunction with the Yoneda-style API for
sheafified representables. It owns the resulting Hom/sections equivalence and its two basic
naturality formulas.
-/

@[expose] public section

open CategoryTheory Opposite

noncomputable section

universe u v

namespace CategoryTheory.GrothendieckTopology.FreeAbelianRepresentable

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
variable [HasWeakSheafify J (Type (max u v))]
variable [HasWeakSheafify J AddCommGrpCat.{max u v}]
variable [J.HasSheafCompose (forget AddCommGrpCat.{max u v})]

/-- The functor which sheafifies representables and then freely abelianizes them. -/
@[stacks 03AB "functor"]
noncomputable abbrev functor : C ⥤ Sheaf J AddCommGrpCat.{max u v} :=
  J.sheafifiedRepresentableFunctor ⋙
    Sheaf.composeAndSheafify J AddCommGrpCat.free

/-- Lemma 18.5.2 (03AB), object form: the free abelian sheaf generated by the sheafified
representable at `U`. -/
@[stacks 03AB "object"]
noncomputable abbrev obj (U : C) :
    Sheaf J AddCommGrpCat.{max u v} :=
  (functor J).obj U

/-- The morphism of free abelian sheafified representables induced by `f`. -/
noncomputable abbrev map {U V : C} (f : U ⟶ V) : obj J U ⟶ obj J V :=
  (functor J).map f

/-- Free abelianization preserves a monomorphism between sheafified representables. -/
@[stacks 03AB "mono map"]
instance map_mono [HasSheafify J AddCommGrpCat.{max u v}]
    {U V : C} (f : U ⟶ V) [Mono (J.sheafifiedRepresentableMap f)] :
    Mono (map J f) := sorry

/-- Lemma 18.5.2 (03AB) (3): morphisms from the free abelian sheafified representable at `U` to
`𝒜` are equivalent to sections of `𝒜` over `U`. -/
@[stacks 03AB "free abelian representable"]
noncomputable def homEquiv
    (U : C) (𝒜 : Sheaf J AddCommGrpCat.{max u v}) :
    (obj J U ⟶ 𝒜) ≃ 𝒜.obj.obj (op U) :=
  ((Sheaf.adjunction J AddCommGrpCat.adj).homEquiv (J.sheafifiedRepresentable U) 𝒜).trans
    (J.sheafifiedRepresentableHomEquiv ((sheafForget J).obj 𝒜) U)

/-- The free-abelian sheafified-representable Hom/sections equivalence commutes with
postcomposition in the target sheaf. -/
theorem homEquiv_comp
    (U : C) {𝒜 ℬ : Sheaf J AddCommGrpCat.{max u v}}
    (α : obj J U ⟶ 𝒜) (β : 𝒜 ⟶ ℬ) :
    homEquiv J U ℬ (α ≫ β) =
      β.hom.app (op U)
        (homEquiv J U 𝒜 α) := sorry

/-- The free-abelian sheafified-representable Hom/sections equivalence commutes with
restriction along a morphism of representing objects. -/
theorem homEquiv_naturality
    {U V : C} (f : U ⟶ V) (𝒜 : Sheaf J AddCommGrpCat.{max u v})
    (α : obj J V ⟶ 𝒜) :
    homEquiv J U 𝒜 (map J f ≫ α) =
      𝒜.obj.map f.op
        (homEquiv J V 𝒜 α) := sorry

/-- The Hom/sections equivalence for a free abelian sheafified representable is additive. -/
theorem homEquiv_add
    (U : C) (𝒜 : Sheaf J AddCommGrpCat.{max u v})
    (α β : obj J U ⟶ 𝒜) :
    homEquiv J U 𝒜 (α + β) =
      homEquiv J U 𝒜 α + homEquiv J U 𝒜 β := sorry

/-- Morphisms from the free abelian sheafified representable at `U` identify additively with
the raw presheaf evaluation at `U`. -/
@[stacks 03AB "additive free abelian representable"]
noncomputable def homAddEquiv
    (U : C) (𝒜 : Sheaf J AddCommGrpCat.{max u v}) :
    (obj J U ⟶ 𝒜) ≃+ 𝒜.obj.obj (op U) where
  toEquiv := homEquiv J U 𝒜
  map_add' := homEquiv_add J U 𝒜

/-- The inverse additive Hom/evaluation equivalence is natural in the target sheaf. -/
theorem homAddEquiv_symm_naturality
    (U : C) {𝒜 ℬ : Sheaf J AddCommGrpCat.{max u v}} (f : 𝒜 ⟶ ℬ)
    (s : 𝒜.obj.obj (op U)) :
    (homAddEquiv J U ℬ).symm (f.hom.app (op U) s) =
      (homAddEquiv J U 𝒜).symm s ≫ f := sorry

/-- An injective abelian sheaf has surjective restriction maps along morphisms whose
sheafified-representable map is mono. -/
@[stacks 03AB "injective sections"]
theorem sectionsMap_surjective [HasSheafify J AddCommGrpCat.{max u v}]
    {U V : C} (f : U ⟶ V) [Mono (J.sheafifiedRepresentableMap f)]
    (𝒜 : Sheaf J AddCommGrpCat.{max u v}) [Injective 𝒜] :
    Function.Surjective (𝒜.obj.map f.op) := sorry

/-- Morphisms from the free abelian sheafified representable at `U` identify additively with
canonical sections over `U`. -/
@[stacks 03AB "canonical sections"]
noncomputable def homSectionsEquiv
    (U : C) (𝒜 : Sheaf J AddCommGrpCat.{max u v}) :
    (obj J U ⟶ 𝒜) ≃+
      ((sheafSections J AddCommGrpCat.{max u v}).obj (op U)).obj 𝒜 :=
  (homAddEquiv J U 𝒜).trans
    (((sheafSectionsNatIsoEvaluation
      (J := J) (A := AddCommGrpCat.{max u v}) (X := U)).app 𝒜).symm.addCommGroupIsoToAddEquiv)

/-- Canonical sections over `U` identify additively with morphisms from the free abelian
sheafified representable at `U`. -/
noncomputable abbrev sectionsHomEquiv
    (U : C) (𝒜 : Sheaf J AddCommGrpCat.{max u v}) :
    ((sheafSections J AddCommGrpCat.{max u v}).obj (op U)).obj 𝒜 ≃+
      (obj J U ⟶ 𝒜) :=
  (homSectionsEquiv J U 𝒜).symm

/-- The canonical-sections Hom/sections additive equivalence commutes with postcomposition in
the target sheaf. -/
theorem homSectionsEquiv_comp
    (U : C) {𝒜 ℬ : Sheaf J AddCommGrpCat.{max u v}}
    (α : obj J U ⟶ 𝒜) (β : 𝒜 ⟶ ℬ) :
    homSectionsEquiv J U ℬ (α ≫ β) =
      ((sheafSections J AddCommGrpCat.{max u v}).obj (op U)).map β
        (homSectionsEquiv J U 𝒜 α) := sorry

/-- The canonical sections-to-Hom additive equivalence is natural in the target sheaf. -/
theorem sectionsHomEquiv_naturality
    (U : C) {𝒜 ℬ : Sheaf J AddCommGrpCat.{max u v}} (β : 𝒜 ⟶ ℬ)
    (s : ((sheafSections J AddCommGrpCat.{max u v}).obj (op U)).obj 𝒜) :
    sectionsHomEquiv J U ℬ
        (((sheafSections J AddCommGrpCat.{max u v}).obj (op U)).map β s) =
      sectionsHomEquiv J U 𝒜 s ≫ β := sorry

/-- The component over `𝒜` of the canonical sections/free-representable Hom comparison. -/
noncomputable def sectionsIsoApp
    (U : C) (𝒜 : Sheaf J AddCommGrpCat.{max u v}) :
    ((sheafSections J AddCommGrpCat.{max u v}).obj (op U)).obj 𝒜 ≅
      (preadditiveCoyoneda.obj (op (obj J U))).obj 𝒜 :=
  (sectionsHomEquiv J U 𝒜).toAddCommGrpIso

/-- The canonical sections/free-representable Hom comparison commutes with a morphism of target
sheaves. -/
theorem sectionsIsoApp_naturality
    (U : C) {𝒜 ℬ : Sheaf J AddCommGrpCat.{max u v}} (β : 𝒜 ⟶ ℬ) :
    ((sheafSections J AddCommGrpCat.{max u v}).obj (op U)).map β ≫
        (sectionsIsoApp J U ℬ).hom =
      (sectionsIsoApp J U 𝒜).hom ≫
        (preadditiveCoyoneda.obj (op (obj J U))).map β := sorry

-- Local declaration justification (localized automation): prevent `NatIso.ofComponents` from
-- unfolding the component equivalence while it checks naturality against the named theorem.
attribute [local irreducible]
  sectionsIsoApp in
/-- The canonical sections functor over `U` is naturally isomorphic to the additive Hom functor
represented by the free abelian sheafified representable at `U`. -/
noncomputable def sectionsIso
    (U : C) :
    (sheafSections J AddCommGrpCat.{max u v}).obj (op U) ≅
      preadditiveCoyoneda.obj (op (obj J U)) :=
  NatIso.ofComponents
    (fun 𝒜 ↦ sectionsIsoApp J U 𝒜)
    (fun β ↦ sectionsIsoApp_naturality J U β)

end CategoryTheory.GrothendieckTopology.FreeAbelianRepresentable
