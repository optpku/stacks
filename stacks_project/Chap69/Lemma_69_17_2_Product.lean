module

public import Mathlib.CategoryTheory.Subobject.Basic
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.GeneratedSubobject
public import stacks_project.Chap66.«66_26_0_1_Pushforward»
public import stacks_project.Chap67.Definition_67_14_4_IdealSubobject

/-!
# Products of ideal sheaves with modules on algebraic spaces

The product `I · F` is the `𝒪_X`-submodule of `F` generated by local products
`a • s` with `a` a local section of `I` and `s` a local section of `F`.
-/

@[expose]
public section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry
open AlgebraicGeometry.AlgebraicSpace

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

/-- Hom-spaces of étale module sheaves on an algebraic space are small. -/
instance locallySmall_modules {S : Scheme.{u}} (X : AlgebraicSpace S) :
    LocallySmall (X.Modules) :=
  sorry

/-- Subobjects of étale module sheaves on an algebraic space are small. -/
instance wellPowered_modules {S : Scheme.{u}} (X : AlgebraicSpace S) :
    WellPowered (X.Modules) :=
  sorry

namespace Modules

/-- The index of local products `a • s` of a section of an ideal sheaf with a
section of a module sheaf. -/
abbrev idealProductIndex {S : Scheme.{u}} {X : AlgebraicSpace S}
    (I : IdealSubobject X) (F : X.Modules) :=
  (U : smallEtaleSite X) × I.toModule.val.obj (op U) × F.val.obj (op U)

/-- The site object of a local-product index. -/
def idealProductSite {S : Scheme.{u}} {X : AlgebraicSpace S}
    (I : IdealSubobject X) (F : X.Modules) :
    idealProductIndex I F → smallEtaleSite X :=
  fun p ↦ p.1

/-- The local product `a • s` associated to a pair of local sections. -/
noncomputable def idealProductSection {S : Scheme.{u}} {X : AlgebraicSpace S}
    (I : IdealSubobject X) (F : X.Modules) :
    (p : idealProductIndex I F) → F.val.obj (op (idealProductSite I F p)) :=
  fun p ↦
    ((I.arrow.val.app (op p.1) p.2.1 : (structureSheaf X).obj.obj (op p.1)) • p.2.2)

/-- The product subobject `I · F ⊆ F` generated by local products `a • s`. -/
noncomputable def idealProductSubobject {S : Scheme.{u}} {X : AlgebraicSpace S}
    (I : IdealSubobject X) (F : X.Modules) : Subobject F :=
  SheafOfModules.Subobject.generatedBySections F
    (idealProductSite I F) (idealProductSection I F)

/-- `I · F` is the subobject generated by local products of sections of `I` with
sections of `F`. -/
theorem idealProductSubobject_eq {S : Scheme.{u}} {X : AlgebraicSpace S}
    (I : IdealSubobject X) (F : X.Modules) :
    idealProductSubobject I F =
      SheafOfModules.Subobject.generatedBySections F
        (idealProductSite I F) (idealProductSection I F) :=
  rfl

/-- The inclusion of the product subobject `I · F` into `F`. -/
noncomputable abbrev idealProductSubobject_arrow {S : Scheme.{u}} {X : AlgebraicSpace S}
    (I : IdealSubobject X) (F : X.Modules) :
    (idealProductSubobject I F : X.Modules) ⟶ F :=
  (idealProductSubobject I F).arrow

/-- `I · F` is the least subobject of `F` containing every local product `a • s`. -/
theorem idealProductSubobject_spec {S : Scheme.{u}} {X : AlgebraicSpace S}
    (I : IdealSubobject X) (F : X.Modules) (G : Subobject F) :
    idealProductSubobject I F ≤ G ↔
      SheafOfModules.Subobject.containsSections G
        (idealProductSite I F) (idealProductSection I F) :=
  sorry

/-- Direct image of étale module sheaves preserves monomorphisms. -/
instance instMono_pushforward_map {S : Scheme.{u}} {X Y : AlgebraicSpace S}
    (f : X ⟶ Y) {M N : X.Modules} (ι : M ⟶ N) [Mono ι] :
    Mono ((pushforward f).map ι) :=
  sorry

/-- The product of a quasi-coherent ideal with a quasi-coherent module is
quasi-coherent. -/
instance instIsQuasicoherent_idealProductSubobject {S : Scheme.{u}}
    {X : AlgebraicSpace S} (I : IdealSubobject X) [IsQuasiCoherent I]
    (F : X.Modules) [F.IsQuasicoherent] :
    (idealProductSubobject I F : X.Modules).IsQuasicoherent :=
  sorry

end Modules

end AlgebraicGeometry.AlgebraicSpace
