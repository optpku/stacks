module

public import ReasLib.RingTheory.Kaehler.DeRham.Wedge
public import Mathlib.RingTheory.AdjoinRoot
public import Mathlib.Algebra.Polynomial.Derivation
public import Mathlib.Data.ZMod.Basic
public import ReasLib.LinearAlgebra.Quotient.Descent

public section

noncomputable section

open Polynomial
open scoped TensorProduct

universe u

namespace PurelyInseparableTrace.Higher

variable (p : ℕ) (hp : p.Prime)
variable (Λ R : Type u) [CommRing Λ] [CommRing R]
variable [Algebra (ZMod p) Λ] [Algebra (ZMod p) R] [Algebra Λ R]
variable [IsScalarTower (ZMod p) Λ R] [Nontrivial R]
variable (a : R)

/-- The power basis of `R[x]/(x ^ p - a)` used to extract coefficients in the higher trace. -/
private noncomputable def powerBasis :
    PowerBasis R (AdjoinRoot (X ^ p - C a)) :=
  AdjoinRoot.powerBasis' (monic_X_pow_sub_C a hp.ne_zero)

/-- The generator of `powerBasis` is the distinguished root of `x ^ p - a`. -/
private theorem powerBasis_gen :
    (powerBasis p hp R a).gen = AdjoinRoot.root (X ^ p - C a) := sorry

/-- The dimension of `powerBasis` is `p`. -/
private theorem powerBasis_dim : (powerBasis p hp R a).dim = p := sorry

/-- The basis index selecting the coefficient of `x ^ (p - 1)`. -/
private theorem topIndex_lt : p - 1 < (powerBasis p hp R a).dim := sorry

/-- The basis index selecting the coefficient of `x ^ (p - 1)`. -/
private def topIndex : Fin (powerBasis p hp R a).dim :=
  ⟨p - 1, topIndex_lt p hp R a⟩

/-- The natural-number value of `topIndex` is `p - 1`. -/
private theorem topIndex_val : (topIndex p hp R a : ℕ) = p - 1 := sorry

/-- The contribution of a basic form `b₀ db₁ ∧ ... ∧ dbₙ` to the higher trace.

Each element of `R[x]/(x ^ p - a)` is expanded in the power basis.  One differential factor
contributes its formal `dx` term, the remaining factors contribute coefficient differentials,
and the coefficient of `x ^ (p - 1)` is wedged with `da`. -/
noncomputable def basicTraceValue (n : ℕ)
    (b₀ : AdjoinRoot (X ^ p - C a))
    (b : Fin n → AdjoinRoot (X ^ p - C a)) :
    KaehlerDifferential.DeRham.Form Λ R n :=
  let P := powerBasis p hp R a
  ∑ i₀ : Fin P.dim, ∑ i : Fin n → Fin P.dim, ∑ j : Fin n,
    P.basis.coord (topIndex p hp R a)
        (algebraMap R (AdjoinRoot (X ^ p - C a)) (P.basis.coord i₀ b₀) *
          P.gen ^ (i₀ : ℕ) *
          ∏ k : Fin n, if k = j then
            algebraMap R (AdjoinRoot (X ^ p - C a))
                (((i k : ℕ) : R) * P.basis.coord (i k) (b k)) *
              P.gen ^ ((i k : ℕ) - 1)
          else P.gen ^ (i k : ℕ)) •
      KaehlerDifferential.DeRham.exact Λ R n fun k ↦
        if k = j then a else P.basis.coord (i k) (b k)

/-- `basicTraceValue` is additive in the coefficient of a basic form. -/
private theorem basicTraceValue_add (n : ℕ) (b : Fin n → AdjoinRoot (X ^ p - C a))
    (b₀ b₀' : AdjoinRoot (X ^ p - C a)) :
    basicTraceValue p hp Λ R a n (b₀ + b₀') b =
      basicTraceValue p hp Λ R a n b₀ b + basicTraceValue p hp Λ R a n b₀' b := sorry

/-- `basicTraceValue` is `R`-linear in the coefficient of a basic form. -/
private theorem basicTraceValue_smul (n : ℕ) (b : Fin n → AdjoinRoot (X ^ p - C a))
    (r : R) (b₀ : AdjoinRoot (X ^ p - C a)) :
    basicTraceValue p hp Λ R a n (r • b₀) b =
      r • basicTraceValue p hp Λ R a n b₀ b := sorry

/-- The `R`-linear contribution of the coefficient of one formal basic form. -/
private noncomputable def basicTraceLinear (n : ℕ)
    (b : Fin n → AdjoinRoot (X ^ p - C a)) :
    AdjoinRoot (X ^ p - C a) →ₗ[R]
      KaehlerDifferential.DeRham.Form Λ R n where
  toFun := fun b₀ ↦ basicTraceValue p hp Λ R a n b₀ b
  map_add' := basicTraceValue_add p hp Λ R a n b
  map_smul' := basicTraceValue_smul p hp Λ R a n b

/-- Evaluation of `basicTraceLinear` is `basicTraceValue`. -/
private theorem basicTraceLinear_apply (n : ℕ)
    (b : Fin n → AdjoinRoot (X ^ p - C a))
    (b₀ : AdjoinRoot (X ^ p - C a)) :
    basicTraceLinear p hp Λ R a n b b₀ = basicTraceValue p hp Λ R a n b₀ b := rfl

/-- The higher trace rule on the free module generated by basic relative forms. -/
private noncomputable def freeTrace (n : ℕ) :
    KaehlerDifferential.DeRham.Free (AdjoinRoot (X ^ p - C a)) n →ₗ[R]
      KaehlerDifferential.DeRham.Form Λ R n :=
  Finsupp.lsum R fun x ↦
    (basicTraceLinear p hp Λ R a n x.2).comp (LinearMap.mulRight R x.1)

/-- `freeTrace` sends a formal basic generator to its explicit trace value. -/
private theorem freeTrace_single (n : ℕ)
    (x : KaehlerDifferential.DeRham.Generator (AdjoinRoot (X ^ p - C a)) n)
    (c : AdjoinRoot (X ^ p - C a)) :
    freeTrace p hp Λ R a n (Finsupp.single x c) =
      basicTraceValue p hp Λ R a n (c * x.1) x.2 := by
  rw [freeTrace, Finsupp.lsum_single]
  rfl

/-- The explicit higher trace kills the scalar-restricted relations between basic forms. -/
private theorem relations_le_ker_freeTrace (n : ℕ) :
    (KaehlerDifferential.DeRham.relations Λ
        (AdjoinRoot (X ^ p - C a)) n).restrictScalars R ≤
      LinearMap.ker (freeTrace p hp Λ R a n) := sorry

/-- The higher trace induced by the explicit rule on representatives. -/
noncomputable def trace (n : ℕ) :
    RestrictScalars R (AdjoinRoot (X ^ p - C a))
        (KaehlerDifferential.DeRham.Form Λ (AdjoinRoot (X ^ p - C a)) n) →ₗ[R]
      KaehlerDifferential.DeRham.Form Λ R n :=
  KaehlerDifferential.DeRham.descendRestrictScalars Λ (AdjoinRoot (X ^ p - C a)) R n
    (freeTrace p hp Λ R a n)
    (relations_le_ker_freeTrace p hp Λ R a n)

/-- Descent evaluates the trace at a quotient class by the rule on representatives. -/
private theorem trace_quotient (n : ℕ)
    (x : KaehlerDifferential.DeRham.Free (AdjoinRoot (X ^ p - C a)) n) :
    trace p hp Λ R a n
      (KaehlerDifferential.DeRham.quotientRestrictScalars Λ
        (AdjoinRoot (X ^ p - C a)) R n x) =
      freeTrace p hp Λ R a n x := by
  exact KaehlerDifferential.DeRham.descendRestrictScalars_quotient _ _ _ _ _ _ x

/-- The canonical higher trace evaluates on a basic form by `basicTraceValue`. -/
theorem trace_basic (n : ℕ) (b₀ : AdjoinRoot (X ^ p - C a))
    (b : Fin n → AdjoinRoot (X ^ p - C a)) :
    PurelyInseparableTrace.Higher.trace p hp Λ R a n (KaehlerDifferential.DeRham.basic Λ
      (AdjoinRoot (X ^ p - C a)) n b₀ b) =
        basicTraceValue p hp Λ R a n b₀ b := sorry

variable {Λ R}
variable {S : Type u} [CommRing S] [Algebra R S] [Algebra Λ S]
variable [IsScalarTower Λ R S]

/-- The commutative square expressing functoriality of relative forms along `R → S`. -/
private theorem algebraMap_square :
    (algebraMap Λ S).comp (RingHom.id Λ) =
      (algebraMap R S).comp (algebraMap Λ R) := sorry

/-- Pullback of relative forms along the extension `R → S`. -/
noncomputable def pullback (n : ℕ) :
    KaehlerDifferential.DeRham.Form Λ R n →ₛₗ[algebraMap R S]
      KaehlerDifferential.DeRham.Form Λ S n :=
  KaehlerDifferential.DeRham.formMap (RingHom.id Λ) (algebraMap R S)
    algebraMap_square n

/-- Pullback applies the algebra map entrywise to a basic relative form. -/
theorem pullback_basic (n : ℕ) (b₀ : R) (b : Fin n → R) :
    pullback (Λ := Λ) (R := R) (S := S) n
        (KaehlerDifferential.DeRham.basic Λ R n b₀ b) =
      KaehlerDifferential.DeRham.basic Λ S n (algebraMap R S b₀)
        (fun i ↦ algebraMap R S (b i)) := sorry

/-- The square defining transport of relative forms along an `R`-algebra equivalence commutes. -/
private theorem equivalence_square {T : Type u} [CommRing T] [Algebra R T] [Algebra Λ T]
    [IsScalarTower Λ R T] (e : S ≃ₐ[R] T) :
    (algebraMap Λ T).comp (RingHom.id Λ) =
      e.toRingEquiv.toRingHom.comp (algebraMap Λ S) := sorry

/-- Transport of relative forms along an `R`-algebra equivalence is additive. -/
private theorem transport_add {T : Type u} [CommRing T] [Algebra R T] [Algebra Λ T]
    [IsScalarTower Λ R T] (e : S ≃ₐ[R] T) (n : ℕ)
    (x y : KaehlerDifferential.DeRham.Form Λ S n) :
    KaehlerDifferential.DeRham.formMap (RingHom.id Λ) e.toRingEquiv.toRingHom
        (equivalence_square e) n (x + y) =
      KaehlerDifferential.DeRham.formMap (RingHom.id Λ) e.toRingEquiv.toRingHom
          (equivalence_square e) n x +
        KaehlerDifferential.DeRham.formMap (RingHom.id Λ) e.toRingEquiv.toRingHom
          (equivalence_square e) n y := sorry

/-- Transport of relative forms along an `R`-algebra equivalence is `R`-linear. -/
private theorem transport_smul {T : Type u} [CommRing T] [Algebra R T] [Algebra Λ T]
    [IsScalarTower Λ R T] (e : S ≃ₐ[R] T) (n : ℕ) (r : R)
    (x : RestrictScalars R S (KaehlerDifferential.DeRham.Form Λ S n)) :
    KaehlerDifferential.DeRham.formMap (RingHom.id Λ) e.toRingEquiv.toRingHom
        (equivalence_square e) n (r • x) =
      @SMul.smul R (RestrictScalars R T (KaehlerDifferential.DeRham.Form Λ T n))
        inferInstance r (KaehlerDifferential.DeRham.formMap (RingHom.id Λ) e.toRingEquiv.toRingHom
        (equivalence_square e) n x) := sorry

/-- Transport of relative forms along an `R`-algebra equivalence, viewed over `R`. -/
private noncomputable def transport {T : Type u} [CommRing T] [Algebra R T] [Algebra Λ T]
    [IsScalarTower Λ R T] (e : S ≃ₐ[R] T) (n : ℕ) :
    RestrictScalars R S (KaehlerDifferential.DeRham.Form Λ S n) →ₗ[R]
      RestrictScalars R T (KaehlerDifferential.DeRham.Form Λ T n) where
  toFun := KaehlerDifferential.DeRham.formMap (RingHom.id Λ) e.toRingEquiv.toRingHom
    (equivalence_square e) n
  map_add' := transport_add (Λ := Λ) (R := R) e n
  map_smul' := transport_smul (Λ := Λ) (R := R) e n

/-- Transport applies the algebra equivalence entrywise to a basic relative form. -/
private theorem transport_basic {T : Type u} [CommRing T] [Algebra R T] [Algebra Λ T]
    [IsScalarTower Λ R T] (e : S ≃ₐ[R] T) (n : ℕ) (b₀ : S) (b : Fin n → S) :
    transport e n (KaehlerDifferential.DeRham.basic Λ S n b₀ b) =
      KaehlerDifferential.DeRham.basic Λ T n (e b₀) (fun i ↦ e (b i)) := sorry

/-- The higher trace for an `R`-algebra presented as `R[x]/(x ^ p - a)`. -/
noncomputable def traceOfEquiv (e : S ≃ₐ[R] AdjoinRoot (X ^ p - C a)) (n : ℕ) :
    RestrictScalars R S (KaehlerDifferential.DeRham.Form Λ S n) →ₗ[R]
      KaehlerDifferential.DeRham.Form Λ R n :=
  (PurelyInseparableTrace.Higher.trace p hp Λ R a n).comp (transport e n)

/-- `traceOfEquiv` is the canonical trace after transport to the standard power presentation. -/
private theorem traceOfEquiv_apply (e : S ≃ₐ[R] AdjoinRoot (X ^ p - C a)) (n : ℕ)
    (ω : KaehlerDifferential.DeRham.Form Λ S n) :
    traceOfEquiv p hp a e n ω =
      PurelyInseparableTrace.Higher.trace p hp Λ R a n (transport e n ω) := sorry

variable (p : ℕ) (hp : p.Prime)
variable (Λ R S : Type u) [CommRing Λ] [CommRing R] [CommRing S]
variable [Algebra (ZMod p) Λ] [Algebra (ZMod p) R] [Algebra Λ R]
variable [IsScalarTower (ZMod p) Λ R] [Nontrivial R]
variable [Algebra R S] [Algebra Λ S] [IsScalarTower Λ R S]
variable (a : R) (e : S ≃ₐ[R] AdjoinRoot (X ^ p - C a))

/-- The canonical linear higher trace the canonical `R`-linear higher trace sends
`η ∧ x ^ i dx` to `η ∧ da` when `i = p - 1`, and to zero for `i < p - 1`.
Here `x` is the element of `S` corresponding under `e` to the distinguished root. -/
theorem traceOfEquiv_wedge_rootPowD (t : ℕ)
    (η : KaehlerDifferential.DeRham.Form Λ R t) (i : Fin p) :
    traceOfEquiv p hp a e (t + 1)
        (KaehlerDifferential.DeRham.formWedge Λ S t 1
          (pullback t η ⊗ₜ
            KaehlerDifferential.DeRham.basic Λ S 1
              ((e.symm (AdjoinRoot.root (X ^ p - C a))) ^ (i : ℕ))
              (fun _ ↦ e.symm (AdjoinRoot.root (X ^ p - C a))))) =
      if (i : ℕ) = p - 1 then
        KaehlerDifferential.DeRham.formWedge Λ R t 1
          (η ⊗ₜ KaehlerDifferential.DeRham.basic Λ R 1 1 (fun _ ↦ a))
      else 0 := sorry

/-- The higher trace the higher trace annihilates the image of
`S ⊗[R] Ω^(t+1)_{R/Λ} → Ω^(t+1)_{S/Λ}`. -/
theorem traceOfEquiv_baseChange (t : ℕ)
    (s : S) (η : KaehlerDifferential.DeRham.Form Λ R (t + 1)) :
    traceOfEquiv p hp a e (t + 1)
      (s • pullback (t + 1) η) = 0 := sorry


/-- Higher traces in positive degree agree for any two power presentations of the same algebra. -/
theorem traceOfEquiv_eq (b : R) (e' : S ≃ₐ[R] AdjoinRoot (X ^ p - C b)) (t : ℕ) :
    traceOfEquiv (Λ := Λ) p hp a e (t + 1) =
      traceOfEquiv (Λ := Λ) p hp b e' (t + 1) := sorry

end PurelyInseparableTrace.Higher
