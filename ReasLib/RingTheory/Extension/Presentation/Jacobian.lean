module

public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.Data.Fin.Embedding
public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
public import Mathlib.RingTheory.Extension.Presentation.Basic
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Jacobians of algebra presentations

This leaf owns Jacobian matrices, embedded square minors, and their target
ideals for presentations with arbitrary variable and relation index types.
-/

@[expose] public section

open MvPolynomial

universe u v w t

namespace Algebra.Presentation

variable {R : Type u} {A : Type v} [CommRing R] [CommRing A] [Algebra R A]
variable {ι : Type w} {σ : Type t} {c : ℕ}

/-- The Jacobian matrix of a presentation, with relations indexing rows and
variables indexing columns. -/
@[stacks 07C8]
noncomputable def jacobianMatrix (P : Presentation R A ι σ) : Matrix σ ι P.Ring :=
  fun j i ↦ pderiv i (P.relation j)

/-- The square Jacobian minor selected by embeddings of `Fin c` into the
variable and relation indices. -/
@[stacks 07C6 "presentation Jacobian minor"]
noncomputable def jacobianMinor (P : Presentation R A ι σ)
    (cols : Fin c ↪ ι) (rows : Fin c ↪ σ) : P.Ring :=
  Matrix.det (P.jacobianMatrix.submatrix rows cols)

/-- The target ideal generated by all `c × c` Jacobian minors with a fixed
embedding of the relation rows. -/
@[stacks 07ER "presentation Jacobian ideal"]
noncomputable def jacobianIdeal (P : Presentation R A ι σ)
    (rows : Fin c ↪ σ) : Ideal A :=
  Ideal.span (Set.range fun cols : Fin c ↪ ι ↦
    algebraMap P.Ring A (P.jacobianMinor cols rows))

/-- Containment of the Jacobian ideal is equivalent to containment of every
minor selected by a variable embedding. -/
theorem jacobianIdeal_le_iff (P : Presentation R A ι σ)
    (rows : Fin c ↪ σ) (J : Ideal A) :
    P.jacobianIdeal rows ≤ J ↔
      ∀ cols : Fin c ↪ ι, algebraMap P.Ring A (P.jacobianMinor cols rows) ∈ J := sorry

/-- The Jacobian ideal depends only on the selected set of relation rows, not
on their enumeration by `Fin c`. -/
theorem jacobianIdeal_eq_of_range_eq (P : Presentation R A ι σ)
    {rows rows' : Fin c ↪ σ} (h : Set.range rows = Set.range rows') :
    P.jacobianIdeal rows = P.jacobianIdeal rows' := sorry

namespace Jacobian

/-- The full Jacobian matrix evaluated in the target algebra. -/
@[stacks 07ET]
noncomputable def target (P : Presentation R A ι σ) : Matrix σ ι A :=
  fun j i ↦ algebraMap P.Ring A (P.jacobianMatrix j i)

end Jacobian

end Algebra.Presentation
