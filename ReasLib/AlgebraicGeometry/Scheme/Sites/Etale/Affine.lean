module

public import ReasLib.AlgebraicGeometry.Scheme.Sites.AffineOver.Pretopology
public import ReasLib.AlgebraicGeometry.Scheme.Sites.Etale.Basic
public import Mathlib.CategoryTheory.Sites.Finite

/-!
# The big affine etale site

This module defines the finite etale pretopology on affine schemes over a fixed
scheme and identifies its generated topology with the canonical topology
induced from the big etale slice site.
-/

@[expose] public section

open CategoryTheory

universe u v

namespace AlgebraicGeometry.Scheme

/-- The pretopology of finite etale covering families on affine schemes over
`S`. -/
noncomputable abbrev bigAffineEtalePretopology (S : Scheme.{u}) : Pretopology S.AffineOver :=
  ((Scheme.precoverage @Etale).comap (AffineOver.toScheme S)).toPretopology ⊓
    Pretopology.finite S.AffineOver

/-- The precoverage of families on affine schemes over `S` that are both
etale-covering after forgetting to schemes and finite. -/
noncomputable abbrev bigAffineEtalePrecoverage (S : Scheme.{u}) : Precoverage S.AffineOver :=
  Scheme.etalePrecoverage.comap (AffineOver.toScheme S) ⊓
    Precoverage.finite S.AffineOver

/-- A presieve covers in the big affine etale precoverage exactly when its
underlying family is an etale covering and it has finitely many arrows. -/
@[simp]
theorem mem_bigAffineEtalePrecoverage_iff
    (S : Scheme.{u}) {U : S.AffineOver} {R : Presieve U} :
    R ∈ bigAffineEtalePrecoverage S U ↔
      R.map (AffineOver.toScheme S) ∈ Scheme.etalePrecoverage U.obj.left ∧
        R.uncurry.Finite := sorry

/-- A finite indexed family covers in the big affine etale precoverage exactly
when its underlying family of scheme morphisms is an etale covering. -/
@[simp]
theorem ofArrows_mem_bigAffineEtalePrecoverage_iff
    (S : Scheme.{u}) {U : S.AffineOver} {ι : Type v} [Finite ι]
    (Y : ι → S.AffineOver) (π : ∀ i, Y i ⟶ U) :
    Presieve.ofArrows Y π ∈ bigAffineEtalePrecoverage S U ↔
      Presieve.ofArrows (fun i ↦ (AffineOver.toScheme S).obj (Y i))
        (fun i ↦ (AffineOver.toScheme S).map (π i)) ∈
        Scheme.etalePrecoverage ((AffineOver.toScheme S).obj U) := sorry

/-- The canonical etale Grothendieck topology on affine schemes over `S`,
induced from the big etale topology on the slice over `S`. -/
noncomputable abbrev bigAffineEtaleTopology (S : Scheme.{u}) : GrothendieckTopology S.AffineOver :=
  affineOverTopology S (S.overGrothendieckTopology @Etale)

/-- The canonical affine etale topology is generated by finite standard etale
covering families. -/
theorem bigAffineEtaleTopology_def (S : Scheme.{u}) :
    bigAffineEtaleTopology S = (bigAffineEtalePrecoverage S).toGrothendieck := sorry

/-- The underlying precoverage of the finite affine etale pretopology is the
finite affine etale precoverage. -/
theorem bigAffineEtalePretopology_toPrecoverage (S : Scheme.{u}) :
    (bigAffineEtalePretopology S).toPrecoverage = bigAffineEtalePrecoverage S := sorry

/-- The topology generated by the finite affine etale pretopology is the
topology generated by its underlying precoverage. -/
theorem bigAffineEtalePretopology_toGrothendieck (S : Scheme.{u}) :
    (bigAffineEtalePretopology S).toGrothendieck =
      (bigAffineEtalePrecoverage S).toGrothendieck := sorry

end AlgebraicGeometry.Scheme
