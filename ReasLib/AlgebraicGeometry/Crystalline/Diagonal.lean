module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
public import Mathlib.AlgebraicGeometry.Modules.Sheaf
public import Mathlib.CategoryTheory.Limits.Shapes.BinaryProducts
public import Mathlib.CategoryTheory.Limits.Shapes.Kernels
public import ReasLib.AlgebraicGeometry.Scheme.IdealSubobject
public import ReasLib.AlgebraicGeometry.RingedSpace.IdealSubobject.Kernel
public import ReasLib.AlgebraicGeometry.Crystalline.Site
public import ReasLib.RingTheory.DividedPowers.SecondOrder
public import Mathlib.RingTheory.DividedPowers.SubDPIdeal

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry.Scheme.Crystalline
open DividedPowers

@[expose] public section

universe u

namespace AlgebraicGeometry.Scheme.Crystalline.Diagonal

variable {S : Scheme.{u}} {I : S.IdealSheafData}
variable {γ : ∀ V : S.affineOpens, DividedPowers (I.ideal V)}
variable {h_compatible :
    ∀ (V : S.affineOpens) (f : Γ(S, V)),
      (γ V).IsDPMorphism (γ (S.affineBasicOpen f))
        (S.presheaf.map (homOfLE (S.basicOpen_le f)).op).hom}
variable {X : Scheme.{u}} {x₀ : X ⟶ I.subscheme}

/-- The diagonal morphism of a self-product cone in `Cris(X/S)`. -/
noncomputable def diag
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1)) : T ⟶ T1 :=
  hprod.lift (BinaryFan.mk (𝟙 T) (𝟙 T))

/-- The thickening map of a crystalline self-product diagonal is a closed immersion. -/
theorem isClosedImmersion
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1)) :
    IsClosedImmersion (diag π0 π1 hprod).hom.thickening := sorry

/-- The quasi-coherent kernel ideal sheaf of the diagonal closed immersion
`Δ : T → T(1)`. -/
noncomputable def ideal
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1)) :
    T1.obj.1.thickening.IdealSheafData :=
  (diag π0 π1 hprod).hom.thickening.ker

/-- The diagonal kernel is contained in the distinguished thickening ideal. -/
theorem ideal_le
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1)) :
    ideal π0 π1 hprod ≤ T1.obj.1.ideal := sorry

/-- The full diagonal kernel on each affine open is preserved by the divided powers
of the distinguished thickening ideal. -/
theorem isSubDPIdeal
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1))
    (V : T1.obj.1.thickening.affineOpens) :
    IsSubDPIdeal (T1.obj.1.gamma V) ((ideal π0 π1 hprod).ideal V) := sorry

/-- The sheaf of second-order divided-power ideals `𝒦^[2]` generated by
squares and divided powers of order at least two in `𝒦 ∩ 𝒥_{T(1)}`. -/
noncomputable def secondOrder
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1)) :
    T1.obj.1.thickening.IdealSheafData :=
  Scheme.IdealSheafData.ofIdeals fun V ↦
    let K := (ideal π0 π1 hprod).ideal V
    K ^ 2 ⊔ (T1.obj.1.gamma V).secondOrderIdeal (K ⊓ T1.obj.1.ideal.ideal V)

/-- On an affine open, the second-order diagonal ideal is generated by the square
of the kernel and its divided powers of order at least two. -/
theorem secondOrder_ideal
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1))
    (V : T1.obj.1.thickening.affineOpens) :
    (secondOrder π0 π1 hprod).ideal V =
      (ideal π0 π1 hprod).ideal V ^ 2 ⊔
        (T1.obj.1.gamma V).secondOrderIdeal
          ((ideal π0 π1 hprod).ideal V ⊓ T1.obj.1.ideal.ideal V) := sorry

/-- `𝒦^[2]` is contained in the diagonal kernel ideal sheaf. -/
theorem secondOrder_le
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1)) :
    secondOrder π0 π1 hprod ≤
      ideal π0 π1 hprod := sorry

/-- `𝒦^[2]` is contained in `𝒦` as module-sheaf subobjects. -/
theorem secondOrder_toSubobject_le
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1)) :
    (secondOrder π0 π1 hprod).toSubobject ≤
      (ideal π0 π1 hprod).toSubobject := sorry

/-- The inclusion of `𝒦^[2]` into `𝒦` as module sheaves on `T(1)`. -/
noncomputable def secondOrderInclusion
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1)) :
    (secondOrder π0 π1 hprod).toModule ⟶
      (ideal π0 π1 hprod).toModule :=
  Subobject.ofLE (secondOrder π0 π1 hprod).toSubobject
    (ideal π0 π1 hprod).toSubobject (secondOrder_toSubobject_le π0 π1 hprod)

/-- The quotient module sheaf `𝒦 / 𝒦^[2]` on the self-product thickening. -/
noncomputable def quotient
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1)) :
    T1.obj.1.thickening.Modules :=
  cokernel (secondOrderInclusion π0 π1 hprod)

end AlgebraicGeometry.Scheme.Crystalline.Diagonal
