module

public import ReasLib.Algebra.Homology.ChainComplex.Disk
public import ReasLib.CategoryTheory.ObjectProperty.FiniteCoproductClosure
public import Mathlib.Algebra.Homology.HomologicalComplexBiprod
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Finite sums of single complexes and identity disks

For an object property `P` in a pointed category, `ChainComplex.trivialSums P`
is generated by objects of `P` placed in degree zero and by identity disks on
objects of `P`, then closed under finite coproducts and isomorphisms.  The
construction is independent of modules, coordinates, and local rings.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

noncomputable section

universe v u

namespace ChainComplex

variable {C : Type u} [Category.{v} C] [HasZeroMorphisms C] [HasZeroObject C]

namespace TrivialSum

/-- A generator is either an object placed in degree zero or an object paired
with the lower degree of its identity disk. -/
@[stacks 00MY "generators for trivial sums of complexes"]
abbrev Generator (P : ObjectProperty C) :=
  Sum (Subtype P) (ℕ × Subtype P)

/-- The chain complex represented by a trivial-sum generator. -/
@[stacks 00MY "complex of a trivial-sum generator"]
def ofGenerator (P : ObjectProperty C) :
    Generator P → ChainComplex C ℕ
  | .inl A => (single₀ C).obj A.1
  | .inr (i, A) => disk A.1 i

/-- The object property consisting of the chosen elementary generators. -/
@[stacks 00MY "trivial-sum generator property"]
abbrev generators (P : ObjectProperty C) :
    ObjectProperty (ChainComplex C ℕ) :=
  ObjectProperty.ofObj (ofGenerator P)

end TrivialSum

/-- The closure of degree-zero singles and identity disks on objects of `P`
under finite coproducts and isomorphisms. -/
@[stacks 00MY "trivial sums of chain complexes"]
abbrev trivialSums (P : ObjectProperty C) :
    ObjectProperty (ChainComplex C ℕ) :=
  (TrivialSum.generators P).additiveClosure

/-- To prove a property of every trivial sum, it suffices to prove it for
degree-zero singles and identity disks, provided the target property is
closed under finite coproducts and isomorphisms. -/
@[stacks 00MY "induction principle for trivial sums"]
theorem trivialSums_le {P : ObjectProperty C}
    {Q : ObjectProperty (ChainComplex C ℕ)}
    [Q.IsClosedUnderIsomorphisms] [Q.IsClosedUnderFiniteCoproducts]
    (hsingle : ∀ {A : C}, P A → Q ((single₀ C).obj A))
    (hdisk : ∀ (i : ℕ) {A : C}, P A → Q (disk A i)) :
    trivialSums P ≤ Q := by
  rw [ObjectProperty.additiveClosure_le_iff,
    ObjectProperty.ofObj_le_iff]
  rintro (A | ⟨i, A⟩)
  · exact hsingle A.property
  · exact hdisk i A.property

namespace trivialSums

variable {P : ObjectProperty C}

/-- An object satisfying `P`, placed in degree zero, belongs to
`trivialSums P`. -/
@[stacks 00MY "single complex in a trivial sum"]
theorem single {A : C} (hA : P A) :
    trivialSums P ((single₀ C).obj A) := sorry

/-- An identity disk on an object satisfying `P` belongs to
`trivialSums P`. -/
@[stacks 00MY "identity disk in a trivial sum"]
theorem disk (i : ℕ) {A : C} (hA : P A) :
    trivialSums P (ChainComplex.disk A i) := sorry

/-- A finite coproduct of trivial sums is a trivial sum. -/
@[stacks 00MY "finite coproduct of trivial sums"]
theorem coproduct {J : Type*} [Finite J]
    (K : J → ChainComplex C ℕ) [HasCoproduct K]
    (hK : ∀ j, trivialSums P (K j)) :
    trivialSums P (∐ K) := sorry

/-- A binary biproduct of trivial sums is a trivial sum. -/
@[stacks 00MY "biproduct of trivial sums"]
theorem biprod {K L : ChainComplex C ℕ} [HasBinaryBiproduct K L]
    (hK : trivialSums P K) (hL : trivialSums P L) :
    trivialSums P (K ⊞ L) := sorry

/-- Every zero chain complex belongs to a trivial-sum closure. -/
@[stacks 00MY "zero object in a trivial sum"]
theorem of_isZero {Z : ChainComplex C ℕ} (hZ : IsZero Z) :
    trivialSums P Z := sorry

/-- The canonical zero complex belongs to every trivial-sum closure. -/
@[stacks 00MY "zero trivial sum"]
theorem zero :
    trivialSums P (HomologicalComplex.zero : ChainComplex C ℕ) :=
  of_isZero HomologicalComplex.isZero_zero

/-- Trivial sums are closed under isomorphism. -/
@[stacks 00MY "transport of a trivial sum"]
theorem of_iso {K L : ChainComplex C ℕ}
    (hK : trivialSums P K) (e : K ≅ L) : trivialSums P L :=
  (trivialSums P).prop_of_iso e hK

/-- The trivial-sum property is invariant under isomorphism. -/
@[stacks 00MY "trivial-sum isomorphism invariance"]
theorem iso_iff {K L : ChainComplex C ℕ} (e : K ≅ L) :
    trivialSums P K ↔ trivialSums P L :=
  (trivialSums P).prop_iff_of_iso e

end trivialSums

end ChainComplex
