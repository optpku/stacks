module

public import Mathlib.Data.List.TFAE
public import Mathlib.RingTheory.Ideal.Pure
public import Mathlib.RingTheory.Spectrum.Prime.Topology
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Ideal.Idempotent
public import ReasLib.RingTheory.Ideal.Pure.Projective

/-!
# Pure Ideals and the Prime Spectrum

@stack 04PU
@stack 05KK

This leaf contains the bridge between a pure ideal and the topology of its
zero locus. It is independent of any finite-projectivity application.
-/

@[expose] public section

universe u

namespace Ideal.Pure

variable {R : Type u} [CommRing R]

/-- Lemma 10.108.4 (04PU) (1): the zero locus of a pure ideal is stable under
generalization in `Spec(R)`. -/
@[stacks 04PU "pure ideal zero locus"]
theorem zeroLocus_stableUnderGeneralization
    (I : Ideal R) (h_pure : I.Pure) :
    StableUnderGeneralization (PrimeSpectrum.zeroLocus (I : Set R)) := sorry

/-- Lemma 10.108.4 (04PU) (2): every closed subset of `Spec(R)` stable under
generalization is the zero locus of a pure ideal. -/
@[stacks 04PU "closed generalization-stable zero locus"]
theorem exists_zeroLocus_eq_of_isClosed_of_stableUnderGeneralization
    (Z : Set (PrimeSpectrum R)) (h_closed : IsClosed Z)
    (h_generalizing : StableUnderGeneralization Z) :
    ∃ I : Ideal R, I.Pure ∧ PrimeSpectrum.zeroLocus (I : Set R) = Z := sorry

/-- A pure ideal whose zero locus is open is generated by an idempotent element. -/
@[stacks 05KK "pure ideal with open zero locus"]
theorem exists_idempotent_generator_of_isOpen_zeroLocus (I : Ideal R)
    (h_pure : I.Pure) (h_open : IsOpen (PrimeSpectrum.zeroLocus (I : Set R))) :
    ∃ e : R, IsIdempotentElem e ∧ I = R ∙ e := sorry

/-- A projective quotient by an ideal has open zero locus in the prime
spectrum. -/
@[stacks 05KK "projective quotient zero locus"]
theorem isOpen_zeroLocus_of_projective_quotient
    (I : Ideal R) (h_projective : Module.Projective R (R ⧸ I)) :
    IsOpen (PrimeSpectrum.zeroLocus (I : Set R)) := sorry

/-- Lemma 10.108.5 (Stacks `05KK`): finite generation and purity are
equivalent to generation by an idempotent, openness of the zero locus, and
projectivity of the quotient. -/
@[stacks 05KK]
theorem fg_tfae (I : Ideal R) :
    List.TFAE
      [ I.Pure ∧ I.FG
      , ∃ e : R, IsIdempotentElem e ∧ I = R ∙ e
      , I.Pure ∧ IsOpen (PrimeSpectrum.zeroLocus (I : Set R))
      , Module.Projective R (R ⧸ I)
      ] := sorry

end Ideal.Pure
