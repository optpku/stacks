module

public import ReasLib.RingTheory.MvPolynomial.XyPower
public import ReasLib.AlgebraicGeometry.XyPower
import StacksCheckRecall

/-!
# The monomial subalgebra generated by `{x y^i}`

The domain `k[x, x y, x y², …]` has a Noetherian prime spectrum but is not a
Noetherian ring. Its localization away from `x` and the unique prime containing
`x` describe its spectrum.
-/

@[expose] public section

universe u

open AlgebraicGeometry TopologicalSpace

variable (k : Type u) [Field k]

/- Example 110.22.2 (1): primes of `A_x` correspond to primes of `A` not containing `x`. -/
@[stacks 0G63]
#check (MvPolynomial.XyPower.primeSpectrum_comap_away_bijOn :
  Set.BijOn (PrimeSpectrum.comap
    (algebraMap (MvPolynomial.XyPower.adjoin k) (Localization.Away (MvPolynomial.XyPower.X k))))
    Set.univ (PrimeSpectrum.basicOpen (MvPolynomial.XyPower.X k)))

/- Example 110.22.2 (2): `A_x` is `k`-algebra equivalent to `k[x, x⁻¹, y]`. -/
@[stacks 0G63]
#check (MvPolynomial.XyPower.awayEquiv k :
  Localization.Away (MvPolynomial.XyPower.X k) ≃ₐ[k]
    Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 2) k))

/- Example 110.22.2 (3): the unique prime containing `x` is the span of all `x y^i`. -/
@[stacks 0G63]
#check (MvPolynomial.XyPower.prime_containing_X_eq :
  ∀ {p : Ideal (MvPolynomial.XyPower.adjoin k)} [p.IsPrime],
    MvPolynomial.XyPower.X k ∈ p ↔ p = MvPolynomial.XyPower.ideal k)

#check (MvPolynomial.XyPower.gen_mem_of_X_mem :
  ∀ {p : Ideal (MvPolynomial.XyPower.adjoin k)} [p.IsPrime],
    MvPolynomial.XyPower.X k ∈ p → ∀ i : ℕ, MvPolynomial.XyPower.gen k i ∈ p)

#check (MvPolynomial.XyPower.instIsPrime_ideal : (MvPolynomial.XyPower.ideal k).IsPrime)

/- Example 110.22.2 (4): the underlying space of `Spec A` is Noetherian. -/
@[stacks 0G63]
#check (MvPolynomial.XyPower.instNoetherianSpace_spec :
  NoetherianSpace (Spec (CommRingCat.of (MvPolynomial.XyPower.adjoin k))))

/- Example 110.22.2 (5): the prime spanned by all `x y^i` is not finitely generated. -/
@[stacks 0G63]
#check (MvPolynomial.XyPower.not_fg_ideal : ¬ (MvPolynomial.XyPower.ideal k).FG)

/- Example 110.22.2 (6): `A` is not a Noetherian ring. -/
@[stacks 0G63]
#check (MvPolynomial.XyPower.not_isNoetherianRing :
  ¬ IsNoetherianRing (MvPolynomial.XyPower.adjoin k))

#check (MvPolynomial.XyPower.not_isNoetherian_spec :
  ¬ IsNoetherian (Spec (CommRingCat.of (MvPolynomial.XyPower.adjoin k))))

/- Example 110.22.2 (7): `A` is a domain. -/
@[stacks 0G63]
#check (Subalgebra.isDomain (MvPolynomial.XyPower.adjoin k) :
  IsDomain (MvPolynomial.XyPower.adjoin k))
