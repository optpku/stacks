module

public import Mathlib.RingTheory.DividedPowers.Padic
public import ReasLib.RingTheory.DividedPowers.Extension.Criteria
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Extending the canonical divided powers on `(p) ⊂ ℤ_[p]`

The coefficient of `a ^ n` is kept as the canonical element
`(PadicInt.dividedPowers p).dpow n p` of `ℤ_[p]`. After embedding into `ℚ_[p]` it is
`p ^ n / n !`; writing `Ring.inverse (n !)` inside `ℤ_[p]` would be incorrect when `p ∣ n !`.
-/

@[expose] public section

universe u

namespace PadicInt

variable {p : ℕ} [Fact p.Prime]
variable {A : Type u} [CommRing A] [Algebra ℤ_[p] A]

/-- The image of the principal ideal `(p) ⊂ ℤ_[p]` in a `ℤ_[p]`-algebra is the principal
ideal generated by `(p : A)`. -/
theorem map_span_prime_eq :
    Ideal.map (algebraMap ℤ_[p] A) (Ideal.span ({(p : ℤ_[p])} : Set ℤ_[p])) =
      Ideal.span ({(p : A)} : Set A) := sorry

/-- On an element of `(p)`, the canonical divided power becomes `x ^ n / n !` after embedding
`ℤ_[p]` into its fraction field `ℚ_[p]`. -/
theorem coe_dpow_eq_of_mem (n : ℕ) {x : ℤ_[p]}
    (hx : x ∈ Ideal.span ({(p : ℤ_[p])} : Set ℤ_[p])) :
    ((dividedPowers p).dpow n x : ℚ_[p]) =
      Ring.inverse (n.factorial : ℚ_[p]) * (x : ℚ_[p]) ^ n := sorry

/-- The canonical divided powers on `(p) ⊂ ℤ_[p]` extend along every `ℤ_[p]`-algebra
structure map. -/
theorem dividedPowers_extends_algebraMap :
    (dividedPowers p).extendsAlong (algebraMap ℤ_[p] A) := sorry

/-- Compatibility with the canonical divided powers on `(p) ⊂ ℤ_[p]` is equivalent to the
formula on the generators `(p : A) * a`. -/
theorem isDPMorphism_iff_dpow_mul
    {gamma : DividedPowers (Ideal.span ({(p : A)} : Set A))} :
    DividedPowers.IsDPMorphism (dividedPowers p) gamma (algebraMap ℤ_[p] A) ↔
      ∀ (n : ℕ) (a : A),
        gamma.dpow n ((p : A) * a) =
          algebraMap ℤ_[p] A ((dividedPowers p).dpow n (p : ℤ_[p])) * a ^ n := sorry

/-- Example 23.2.3 (Tag 07GN): every `ℤ_[p]`-algebra has a unique divided-power structure on
the principal ideal `(p)`, characterized by the canonical coefficient
`(PadicInt.dividedPowers p).dpow n p`; in `ℚ_[p]` this coefficient is `p ^ n / n !`. -/
@[stacks 07GN]
theorem existsUnique_dividedPowers_span_prime :
    ∃! gamma : DividedPowers (Ideal.span ({(p : A)} : Set A)),
      ∀ (n : ℕ) (a : A),
        gamma.dpow n ((p : A) * a) =
          algebraMap ℤ_[p] A ((dividedPowers p).dpow n (p : ℤ_[p])) * a ^ n := sorry

/-- The canonical coefficient formula uniquely determines divided powers on `(p : A)`. -/
theorem dividedPowers_eq_of_dpow_mul
    {gamma delta : DividedPowers (Ideal.span ({(p : A)} : Set A))}
    (hgamma : ∀ (n : ℕ) (a : A),
      gamma.dpow n ((p : A) * a) =
        algebraMap ℤ_[p] A ((dividedPowers p).dpow n (p : ℤ_[p])) * a ^ n)
    (hdelta : ∀ (n : ℕ) (a : A),
      delta.dpow n ((p : A) * a) =
        algebraMap ℤ_[p] A ((dividedPowers p).dpow n (p : ℤ_[p])) * a ^ n) :
    gamma = delta := sorry

/-- Two divided-power structures on `(p : A)` compatible with the canonical structure on
`ℤ_[p]` coincide. -/
theorem dividedPowers_eq_of_isDPMorphism
    {gamma delta : DividedPowers (Ideal.span ({(p : A)} : Set A))}
    (hgamma : DividedPowers.IsDPMorphism
      (dividedPowers p) gamma (algebraMap ℤ_[p] A))
    (hdelta : DividedPowers.IsDPMorphism
      (dividedPowers p) delta (algebraMap ℤ_[p] A)) :
    gamma = delta := sorry

end PadicInt
