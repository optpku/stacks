module

public import Mathlib.CategoryTheory.IsomorphismClasses
public import Mathlib.RingTheory.Extension.Basic
public import ReasLib.Algebra.Homology.DerivedCategory.ModuleCat
public import ReasLib.RingTheory.Sequence.Koszul.Regularity
public import ReasLib.RingTheory.CotangentComplex.Basic
public import ReasLib.RingTheory.Ideal.KoszulRegular
import Mathlib.Tactic.CrossRefAttribute

/-!
# Cotangent complex of a Koszul-regular quotient

The cotangent complex `L_{B/A}` in `D(B)` is isomorphic to the conormal module `I/I²`
placed in cohomological degree `-1`, whenever `A → B` is surjective with locally
Koszul-regular kernel. This includes kernels generated by a Koszul-regular sequence.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits
open Algebra

universe u

noncomputable section

namespace Algebra.CotangentComplex

section

variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]

/-- For a surjective ring map whose kernel is generated by a Koszul-regular sequence,
the cotangent complex is isomorphic in the derived category to the conormal module
concentrated in cohomological degree `-1`. -/
@[stacks 08SJ]
theorem koszulRegularSequence_isIsomorphic_single_conormal
    (h : Function.Surjective (algebraMap A B)) {r : ℕ} {f : Fin r → A}
    (hf : RingTheory.Sequence.IsKoszulRegularSequence f)
    (hI : Ideal.span (Set.range f) = RingHom.ker (algebraMap A B)) :
    IsIsomorphic
      (DerivedCategory.Q.obj (Algebra.cotangentComplex A B))
      ((DerivedCategory.singleFunctor (ModuleCat.{u} B) (-1 : ℤ)).obj
        (ModuleCat.of B (Extension.ofSurjective (Algebra.ofId A B) h).Cotangent)) :=
  sorry

/-- If `A → B` is surjective with kernel generated by a Koszul-regular sequence, then the
André-Quillen homology of `L_{B/A}` vanishes in every cohomological degree other than `-1`. -/
theorem koszulRegularSequence_homology_isZero_of_ne_negOne
    (h : Function.Surjective (algebraMap A B)) {r : ℕ} {f : Fin r → A}
    (hf : RingTheory.Sequence.IsKoszulRegularSequence f)
    (hI : Ideal.span (Set.range f) = RingHom.ker (algebraMap A B))
    {n : ℤ} (hn : n ≠ -1) :
    IsZero ((Algebra.cotangentComplex A B).homology n) :=
  sorry

/-- If `A → B` is surjective with kernel generated by a Koszul-regular sequence, then
`H^{-1}(L_{B/A})` is isomorphic to the conormal module `I/I²` as an object of `ModuleCat B`. -/
theorem koszulRegularSequence_homology_negOne_isIsomorphic
    (h : Function.Surjective (algebraMap A B)) {r : ℕ} {f : Fin r → A}
    (hf : RingTheory.Sequence.IsKoszulRegularSequence f)
    (hI : Ideal.span (Set.range f) = RingHom.ker (algebraMap A B)) :
    IsIsomorphic
      ((Algebra.cotangentComplex A B).homology (-1))
      (ModuleCat.of B (Extension.ofSurjective (Algebra.ofId A B) h).Cotangent) :=
  sorry

/-- If `A → B` is surjective with kernel generated by a regular sequence, then `L_{B/A}` is
quasi-isomorphic to `I/I²[1]` in `D(B)`. -/
theorem regularSequence_isIsomorphic_single_conormal
    (h : Function.Surjective (algebraMap A B)) {r : ℕ} {f : Fin r → A}
    (hf : RingTheory.Sequence.IsRegular A (List.ofFn f))
    (hI : Ideal.span (Set.range f) = RingHom.ker (algebraMap A B)) :
    IsIsomorphic
      (DerivedCategory.Q.obj (Algebra.cotangentComplex A B))
      ((DerivedCategory.singleFunctor (ModuleCat.{u} B) (-1 : ℤ)).obj
        (ModuleCat.of B (Extension.ofSurjective (Algebra.ofId A B) h).Cotangent)) :=
  sorry

end

/-- The cotangent complex of the quotient by a Koszul-regular sequence is isomorphic
in the derived category to the ideal's conormal module concentrated in degree `-1`. -/
theorem quotient_koszulRegularSequence_isIsomorphic_single_conormal
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (hf : RingTheory.Sequence.IsKoszulRegularSequence f) :
    IsIsomorphic
      (DerivedCategory.Q.obj (Algebra.cotangentComplex A (A ⧸ Ideal.span (Set.range f))))
      ((DerivedCategory.singleFunctor
          (ModuleCat.{u} (A ⧸ Ideal.span (Set.range f))) (-1 : ℤ)).obj
        (ModuleCat.of (A ⧸ Ideal.span (Set.range f))
          (Ideal.span (Set.range f)).Cotangent)) :=
  sorry

section

variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]

/-- For a surjective ring map with Koszul-regular kernel, the cotangent complex is
isomorphic in the derived category to the conormal module concentrated in
cohomological degree `-1`. -/
@[stacks 08SK]
theorem isIsomorphic_single_conormal
    (h : Function.Surjective (algebraMap A B))
    (hI : (RingHom.ker (algebraMap A B)).IsKoszulRegularIdeal) :
    IsIsomorphic
      (DerivedCategory.Q.obj (Algebra.cotangentComplex A B))
      ((DerivedCategory.singleFunctor (ModuleCat.{u} B) (-1 : ℤ)).obj
        (ModuleCat.of B (Extension.ofSurjective (Algebra.ofId A B) h).Cotangent)) :=
  sorry

/-- If `A → B` is surjective with Koszul-regular kernel, then the André-Quillen homology of
`L_{B/A}` vanishes in every cohomological degree other than `-1`. -/
theorem homology_isZero_of_ne_negOne
    (h : Function.Surjective (algebraMap A B))
    (hI : (RingHom.ker (algebraMap A B)).IsKoszulRegularIdeal)
    {n : ℤ} (hn : n ≠ -1) :
    IsZero ((Algebra.cotangentComplex A B).homology n) :=
  sorry

/-- If `A → B` is surjective with Koszul-regular kernel, then `H^{-1}(L_{B/A})` is isomorphic
to the conormal module `I/I²` as an object of `ModuleCat B`. -/
theorem homology_negOne_isIsomorphic
    (h : Function.Surjective (algebraMap A B))
    (hI : (RingHom.ker (algebraMap A B)).IsKoszulRegularIdeal) :
    IsIsomorphic
      ((Algebra.cotangentComplex A B).homology (-1))
      (ModuleCat.of B (Extension.ofSurjective (Algebra.ofId A B) h).Cotangent) :=
  sorry

end

/-- Specialization of the Koszul-regular concentration isomorphism to the quotient algebra
`A ⧸ I`, with conormal module `I.Cotangent`. -/
theorem quotient_isIsomorphic_single_conormal {A : Type u} [CommRing A]
    (I : Ideal A) (hI : I.IsKoszulRegularIdeal) :
    IsIsomorphic
      (DerivedCategory.Q.obj (Algebra.cotangentComplex A (A ⧸ I)))
      ((DerivedCategory.singleFunctor (ModuleCat.{u} (A ⧸ I)) (-1 : ℤ)).obj
        (ModuleCat.of (A ⧸ I) I.Cotangent)) :=
  sorry

end Algebra.CotangentComplex

end
