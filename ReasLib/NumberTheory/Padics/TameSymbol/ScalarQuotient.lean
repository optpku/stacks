module

public import Mathlib.NumberTheory.Padics.RingHoms
public import ReasLib.RingTheory.LocalRing.TameSymbol.DiscreteValuationRing.Determinant

@[expose] public section

/-!
# Scalar-quotient determinants of p-adic prime-power units

This module computes the scalar-quotient determinant and tame symbol of products of
powers of a prime with units in the p-adic integers.
-/

noncomputable section

open CategoryTheory
open CategoryTheory.TwoPeriodicEndomorphism
open scoped nonZeroDivisors Pointwise

namespace PadicInt.TwoPeriodic

variable (p : ℕ) [Fact p.Prime]

/-- A power of `p` times a unit of `ℤ_[p]` is a nonzerodivisor. -/
theorem primePowerUnit_mem_nonZeroDivisors (n : ℕ) (u : ℤ_[p]ˣ) :
    (p : ℤ_[p]) ^ n * (u : ℤ_[p]) ∈ ℤ_[p]⁰ := sorry

/-- The nonzerodivisor of `ℤ_[p]` represented by a power of `p` times a unit. -/
def primePowerNonzeroDivisor (n : ℕ) (u : ℤ_[p]ˣ) : ℤ_[p]⁰ :=
  ⟨(p : ℤ_[p]) ^ n * (u : ℤ_[p]), primePowerUnit_mem_nonZeroDivisors p n u⟩

/-- The underlying p-adic integer of `primePowerNonzeroDivisor p n u` is `p ^ n * u`. -/
theorem coe_primePowerNonzeroDivisor (n : ℕ) (u : ℤ_[p]ˣ) :
    (primePowerNonzeroDivisor p n u : ℤ_[p]) =
      (p : ℤ_[p]) ^ n * (u : ℤ_[p]) := sorry

/-- The discrete-valuation order of `p ^ n * u` in `ℚ_[p]` is `n`. -/
theorem ord_mapNonzero_primePowerUnit (n : ℕ) (u : ℤ_[p]ˣ) :
    DVR.TameSymbol.ord ℤ_[p] ℚ_[p]
        (DVR.TameSymbol.mapNonzero ℤ_[p] ℚ_[p]
          (primePowerNonzeroDivisor p n u)) =
      (n : ℤ) := sorry

/-- If `a + b = l`, the submodule generated by the product of `p ^ b * u` and
`p ^ a * v` is the submodule generated by `p ^ l`. -/
theorem primePowerUnits_smulTop_eq (l a b : ℕ) (h_ab : a + b = l) (u v : ℤ_[p]ˣ) :
    (((p : ℤ_[p]) ^ b * (u : ℤ_[p])) * ((p : ℤ_[p]) ^ a * (v : ℤ_[p]))) •
        (⊤ : Submodule ℤ_[p] ℤ_[p]) =
      (p : ℤ_[p]) ^ l • (⊤ : Submodule ℤ_[p] ℤ_[p]) := sorry

/-- The signed unit formula for two p-adic prime-power units equals their tame-symbol
value in the residue field. -/
theorem unitFormula_eq_tameSymbol (a b : ℕ) (u v : ℤ_[p]ˣ) :
    Units.map PadicInt.toZMod.toMonoidHom
        ((-1 : ℤ_[p]ˣ) ^ (a * b) * u ^ a / v ^ b) =
      Units.map PadicInt.residueField.toMonoidHom
        (DVR.TameSymbol.value ℤ_[p] ℚ_[p]
          (DVR.TameSymbol.mapNonzero ℤ_[p] ℚ_[p]
            (primePowerNonzeroDivisor p b u))
          (DVR.TameSymbol.mapNonzero ℤ_[p] ℚ_[p]
            (primePowerNonzeroDivisor p a v))) := sorry

/-- For `a + b = l`, the scalar-quotient determinant of `p ^ b * u` and `p ^ a * v`
is the residue of `(-1) ^ (a * b) * u ^ a / v ^ b`. -/
theorem scalarQuotientSelfDeterminant_primePowerUnits
    (l a b : ℕ) (h_ab : a + b = l) (u v : ℤ_[p]ˣ) :
    Units.map PadicInt.residueField.toMonoidHom
        (scalarQuotientSelfDeterminant
          ((p : ℤ_[p]) ^ b * (u : ℤ_[p])) ((p : ℤ_[p]) ^ a * (v : ℤ_[p]))
          (primePowerUnit_mem_nonZeroDivisors p b u)
          (primePowerUnit_mem_nonZeroDivisors p a v)
          (IsDiscreteValuationRing.ringKrullDim_eq_one ℤ_[p])) =
      Units.map PadicInt.toZMod.toMonoidHom
        ((-1 : ℤ_[p]ˣ) ^ (a * b) * u ^ a / v ^ b) := sorry

end PadicInt.TwoPeriodic
