module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Module.Invertible.Torsor
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.HenselianLocalRing.Functoriality
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Morphism.ResidueFieldTrdeg
public import ReasLib.FieldTheory.Transcendence.PurelyTranscendental
public import Mathlib.FieldTheory.RatFunc.Basic
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.RingHom.Flat
public import Mathlib.Topology.Sober

@[expose] public section

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open AlgebraicGeometry AlgebraicGeometry.AlgebraicSpace
open AlgebraicGeometry.AlgebraicSpace.Modules
open IsLocalRing TopologicalSpace

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

variable {S : Scheme.{u}} {X : AlgebraicSpace S}

namespace Modules

/-- The comparison of henselian local rings along the `G_m`-torsor is flat. -/
theorem gmTorsorπ_henselianMap_flat (L : X.Modules) [isInvertibleObject L]
    [IsDecent X] (ξ : Points X) (ξ' : Points (gmTorsor L))
    (hξ' : Points.map (gmTorsorπ L) ξ' = ξ ∧
      IsGenericPoint ξ' (closure (Points.map (gmTorsorπ L) ⁻¹' {ξ}))) :
    RingHom.Flat (HenselianFunctoriality.map (gmTorsorπ L) ξ' ξ hξ'.1) :=
  sorry

/-- The maximal ideal of `𝒪_{T,ξ'}^h` is generated by the image of `m_ξ^h`. -/
theorem gmTorsorπ_henselianMap_maximalIdeal (L : X.Modules)
    [isInvertibleObject L] [IsDecent X] (ξ : Points X)
    (ξ' : Points (gmTorsor L))
    (hξ' : Points.map (gmTorsorπ L) ξ' = ξ ∧
      IsGenericPoint ξ' (closure (Points.map (gmTorsorπ L) ⁻¹' {ξ}))) :
    maximalIdeal (henselianLocalRing (gmTorsor L) ξ') =
      (maximalIdeal (henselianLocalRing X ξ)).map (HenselianFunctoriality.map (gmTorsorπ L) ξ' ξ hξ'.1) :=
  sorry

/-- At a generic point of a torsor fibre, the henselian residue extension is a one-variable rational function field over the original residue field. -/
theorem gmTorsorπ_henselianResidueField_ratFunc (L : X.Modules)
    [isInvertibleObject L] [IsDecent X] (ξ : Points X) (ξ' : Points (gmTorsor L))
    (hξ' : Points.map (gmTorsorπ L) ξ' = ξ ∧
      IsGenericPoint ξ' (closure (Points.map (gmTorsorπ L) ⁻¹' {ξ}))) :
    ∃ e : RatFunc (ResidueField (henselianLocalRing X ξ)) ≃+*
        ResidueField (henselianLocalRing (gmTorsor L) ξ'),
      e.toRingHom.comp (algebraMap (ResidueField (henselianLocalRing X ξ))
        (RatFunc (ResidueField (henselianLocalRing X ξ)))) =
      ResidueField.map (HenselianFunctoriality.map (gmTorsorπ L) ξ' ξ hξ'.1) := sorry

/-- The residue-field extension induced by the torsor projection on henselian local rings is purely transcendental. -/
theorem gmTorsorπ_henselianMap_isPurelyTranscendental (L : X.Modules)
    [isInvertibleObject L] [IsDecent X] (ξ : Points X)
    (ξ' : Points (gmTorsor L))
    (hξ' : Points.map (gmTorsorπ L) ξ' = ξ ∧
      IsGenericPoint ξ' (closure (Points.map (gmTorsorπ L) ⁻¹' {ξ}))) :
    (ResidueField.map (HenselianFunctoriality.map (gmTorsorπ L) ξ' ξ hξ'.1)).IsPurelyTranscendental :=
  sorry

end Modules

/-- The geometric residue extension at a generic point of a multiplicative torsor fibre has transcendence degree one. -/
theorem gmTorsorπ_residueFieldTrdeg {X : AlgebraicSpace S}
    (L : X.Modules) [isInvertibleObject L] [IsDecent X]
    (ξ : Points X) (ξ' : Points (gmTorsor L))
    (hξ' : Points.map (gmTorsorπ L) ξ' = ξ ∧
      IsGenericPoint ξ' (closure (Points.map (gmTorsorπ L) ⁻¹' {ξ}))) :
    residueFieldTrdegAt (gmTorsorπ L) ξ' = 1 :=
  sorry

end AlgebraicGeometry.AlgebraicSpace
