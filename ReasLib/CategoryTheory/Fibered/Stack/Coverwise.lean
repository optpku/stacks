module

public import ReasLib.CategoryTheory.Fibered.CategoryOver.CoverDescent
public import ReasLib.CategoryTheory.Fibered.Stack.Basic

/-!
# Stack condition via coverwise descent equivalence

A fibered category over a site `(C, J)` is a stack iff for every cover, the canonical descent
functor from the fiber to the descent-data category is an equivalence.

## Main declarations

* `CategoryTheory.GrothendieckTopology.Cover.ofArrows_eq` — a cover's sieve equals the sieve
  generated by its arrows.
* `CategoryTheory.GrothendieckTopology.Cover.Descent.functor` — the fixed-cover descent functor.
* `CategoryTheory.IsStack.OnSite.iff_coverwise` — the coverwise descent characterization.
* `CategoryTheory.IsStack.OnSite.Descent.isStackFor_iff` — the fixed-cover equivalence criterion.
* `CategoryTheory.IsStack.OnSite.Descent.isEquivalence` — the reusable fixed-cover instance.
-/

@[expose] public section

universe u₁ u₂ v₁ v₂

namespace CategoryTheory

open GrothendieckTopology.Cover Limits

variable {C : Type u₁} [Category.{v₁} C]

/-! ## Coverwise descent characterization -/

section

variable {S : Type u₂} [Category.{v₂} S]
variable (J : GrothendieckTopology C) (p : S ⥤ C) [p.IsFibered]

/-- The stack condition on a covering sieve is equivalent to the descent functor for the
cover's arrow family being an equivalence. -/
@[stacks 02ZF "fixed-cover descent equivalence criterion"]
theorem IsStack.OnSite.Descent.isStackFor_iff {U : C} (T : J.Cover U) :
    (Functor.fiberPseudofunctor p).IsStackFor ((T : Sieve U).arrows) ↔
      (GrothendieckTopology.Cover.Descent.functor T p).IsEquivalence := sorry

/-- A fibered category over `(C, J)` is a stack iff for every cover, the canonical descent
functor is an equivalence. -/
@[stacks 02ZF]
theorem IsStack.OnSite.iff_coverwise :
    IsStack.OnSite J p ↔
      ∀ (U : C) (T : J.Cover U),
        (GrothendieckTopology.Cover.Descent.functor T p).IsEquivalence := sorry

end

/-! ## Effective descent over a fixed cover -/

section

variable {S : Type u₂} [Category.{v₂} S]
variable {J : GrothendieckTopology C} {p : S ⥤ C} [IsStack.OnSite J p]

/-- The descent functor attached to any cover of a stack is canonically registered as an
equivalence. -/
@[stacks 02ZF "fixed-cover descent equivalence instance"]
instance IsStack.OnSite.Descent.isEquivalence
    {U : C} (T : J.Cover U) :
    (GrothendieckTopology.Cover.Descent.functor T p).IsEquivalence := sorry

end

end CategoryTheory
