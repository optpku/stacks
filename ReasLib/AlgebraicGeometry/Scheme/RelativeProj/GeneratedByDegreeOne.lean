module

public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.Map.AffineOpenBaseChange
public import ReasLib.RingTheory.GradedAlgebra.GeneratedBy

/-!
# Degree-one generation of graded algebra sheaves

This module records the affine-local meaning of generation in degree one for a graded algebra
sheaf on a scheme.
-/

@[expose] public section

open AlgebraicGeometry
open Opposite

universe u

namespace SheafOfModules.RingedSite.GradedAlgebraSheaf

/-- A graded algebra sheaf is generated in degree one over the structure sheaf when, on every
affine open, its nonnegative homogeneous sections have a compatible graded-ring model whose
degree-zero part is generated by structure-sheaf sections and whose algebra is generated over
degree zero by its degree-one part. -/
def GeneratedByDegreeOne
    {S : Scheme.{u}} (𝒜 : GradedAlgebraSheaf.{u, u} S.sheaf) : Prop :=
  ∀ U : S.affineOpens,
    ∃ (A σ : Type u) (hA : CommRing A) (hσ : SetLike σ A)
      (hadd : AddSubgroupClass σ A) (grading : ℕ → σ) (hgraded : GradedRing grading)
      (model : ∀ d : ℕ,
        (𝒜 (Int.ofNat d)).val.obj (op (U : S.Opens)) ≃+ grading d)
      (hModel : @AffineOpenSectionProj.IsAffineOpenSectionModel
        S A σ hA hσ hadd grading hgraded 𝒜 U model),
      Function.Surjective
          (@AffineOpenSectionProj.degreeZeroStructureMap
            S A σ hA hσ hadd grading hgraded 𝒜 U model hModel) ∧
        @GradedAlgebra.GeneratedBy ℕ inferInstance A σ hA.toCommSemiring hσ
          hadd.toAddSubmonoidClass grading hgraded.toGradedMonoid 1

/-- Degree-one generation over the structure sheaf is exactly the existence, on every affine
open, of a compatible graded-ring model whose structure-sheaf map onto degree zero is
surjective and which is generated by its degree-one component. -/
theorem generatedByDegreeOne_iff
    {S : Scheme.{u}} (𝒜 : GradedAlgebraSheaf.{u, u} S.sheaf) :
    GeneratedByDegreeOne 𝒜 ↔
      ∀ U : S.affineOpens,
        ∃ (A σ : Type u) (hA : CommRing A) (hσ : SetLike σ A)
          (hadd : AddSubgroupClass σ A) (grading : ℕ → σ) (hgraded : GradedRing grading)
          (model : ∀ d : ℕ,
            (𝒜 (Int.ofNat d)).val.obj (op (U : S.Opens)) ≃+ grading d)
          (hModel : @AffineOpenSectionProj.IsAffineOpenSectionModel
            S A σ hA hσ hadd grading hgraded 𝒜 U model),
          Function.Surjective
              (@AffineOpenSectionProj.degreeZeroStructureMap
                S A σ hA hσ hadd grading hgraded 𝒜 U model hModel) ∧
            @GradedAlgebra.GeneratedBy ℕ inferInstance A σ hA.toCommSemiring hσ
              hadd.toAddSubmonoidClass grading hgraded.toGradedMonoid 1 :=
  Iff.rfl

end SheafOfModules.RingedSite.GradedAlgebraSheaf
