module

public import ReasLib.AlgebraicGeometry.Scheme.FundamentalGroup.Ramification
import StacksCheckRecall

@[expose] public section

open AlgebraicGeometry
open AlgebraicGeometry.Scheme.FunctionFieldExtension

universe u

variable (X : Scheme.{u}) [IsIntegral X] (hX : X.isNormal)

/- Lemma 58.13.2 (1): the generic absolute-Galois kernel, identified with restriction
to the maximal unramified extension, is the closed normal subgroup generated by all
inertia groups in the separable normalization. -/
@[stacks 0BTD]
#check (AlgebraicGeometry.Scheme.Ramification.ker_restrict_eq_inertiaClosure X hX :
  (AlgEquiv.restrictNormalHom (maximalUnramifiedExtension X hX) :
    Gal(SeparableClosure X.functionField / X.functionField) →*
      Gal(maximalUnramifiedExtension X hX / X.functionField)).ker =
    AlgebraicGeometry.Scheme.Ramification.inertiaClosure X)

/- Lemma 58.13.2 (2): the same kernel is the closed normal subgroup generated by the
Galois subgroups fixing compatible strict-henselization fraction fields at all points. -/
@[stacks 0BTD]
#check (AlgebraicGeometry.Scheme.Ramification.ker_restrict_eq_strictHenselClosure X hX :
  (AlgEquiv.restrictNormalHom (maximalUnramifiedExtension X hX) :
    Gal(SeparableClosure X.functionField / X.functionField) →*
      Gal(maximalUnramifiedExtension X hX / X.functionField)).ker =
    AlgebraicGeometry.Scheme.Ramification.strictHenselClosure X)

#check (AlgEquiv.restrictNormalHom_surjective (SeparableClosure X.functionField) :
  Function.Surjective
    (AlgEquiv.restrictNormalHom (maximalUnramifiedExtension X hX) :
      Gal(SeparableClosure X.functionField / X.functionField) →*
        Gal(maximalUnramifiedExtension X hX / X.functionField)))
