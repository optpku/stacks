module

public import ReasLib.RingTheory.LocalRing.SumOfSquares
import StacksCheckRecall

/-!
# Exercise 111.55.3

Possible Krull dimensions of a Noetherian local ring whose maximal ideal is
generated by three elements satisfying a sum-of-squares relation.
-/

@[expose] public section

noncomputable section

universe u

open IsLocalRing MvPolynomial

/- Exercise 111.55.3: dimension classification. -/
@[stacks 07DH] #check
  (IsLocalRing.ringKrullDim_eq_zero_or_one_or_two :
    ∀ {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
      (hchar : ringChar (ResidueField A) ≠ 2) (x y z : A),
      maximalIdeal A = Ideal.span {x, y, z} →
      x ^ 2 + y ^ 2 + z ^ 2 = 0 →
      ringKrullDim A = 0 ∨ ringKrullDim A = 1 ∨ ringKrullDim A = 2)

/- Exercise 111.55.3: the zero-dimensional realization. -/
@[stacks 07DH] #check
  (IsLocalRing.field_sumOfSquares_example :
    ∀ {k : Type u} [Field k], ringChar k ≠ 2 →
      ringKrullDim k = 0 ∧ maximalIdeal k = Ideal.span {(0 : k), 0, 0} ∧
        ((0 : k) ^ 2 + (0 : k) ^ 2 + (0 : k) ^ 2 = 0) ∧
        ringChar (ResidueField k) ≠ 2)

/- Exercise 111.55.3: the one-dimensional realization. -/
@[stacks 07DH] #check
  (IsLocalRing.sumOfTwoSquares_ringKrullDim :
    ∀ {k : Type u} [Field k],
      ringChar k ≠ 2 →
      ringKrullDim (MvPolynomial.SumOfTwoSquares.LocalRing k) = 1)

/- Exercise 111.55.3: the two-dimensional realization. -/
@[stacks 07DH] #check
  (IsLocalRing.sumOfThreeSquares_ringKrullDim :
    ∀ {k : Type u} [Field k],
      ringChar k ≠ 2 →
      ringKrullDim (MvPolynomial.SumOfThreeSquares.LocalRing k) = 2)

/- Exercise 111.55.3: the domain conclusion in dimension two. -/
@[stacks 07DH] #check
  (IsLocalRing.isDomain_of_ringKrullDim_eq_two :
    ∀ {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
      (hchar : ringChar (ResidueField A) ≠ 2) (x y z : A),
      maximalIdeal A = Ideal.span {x, y, z} →
      x ^ 2 + y ^ 2 + z ^ 2 = 0 →
      ringKrullDim A = 2 → IsDomain A)
