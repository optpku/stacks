module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Localization.CategoryOfElements.ProjectionFormula
public import ReasLib.CategoryTheory.Sites.AbelianSheaf.LowerShriek.CategoryOfElements
import StacksCheckRecall

/-!
# Remark 18.27.10

This facade records both source clauses.  Part (a) is owned by the reusable
corepresentability API for additive lower shriek.  Part (b) uses sheaves valued in
`ModuleCat.{v} (ULift.{v} ℤ)`, the same-universe model of `ℤ`-modules required by mathlib's
current monoidal instance.  Its monoidal product is tensor product over the lifted integers; in
particular it does not confuse the cartesian monoidal structure on `AddCommGrpCat` with tensor
product.
-/

@[expose] public section

open CategoryTheory CategoryTheory.MonoidalCategory

noncomputable section

universe u v

namespace CategoryTheory

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable (F : Sheaf J (Type v))

section Additive

variable [HasWeakSheafify J AddCommGrpCat.{v}]
variable [HasWeakSheafify (localizationTopology F) AddCommGrpCat.{v}]
variable [J.HasSheafCompose (forget AddCommGrpCat.{v})]
variable [(localizationTopology F).HasSheafCompose (forget AddCommGrpCat.{v})]
variable [(Functor.AbelianLowerShriek.AtSheaf.restriction F).IsRightAdjoint]

/- Remark 18.27.10 (0EYY) (a): for the localization at `F`, lower shriek of the constant
integer sheaf is canonically the free abelian sheaf generated by `F.obj`, i.e.
`jₗ! ℤ ≅ ℤ[F]⁺`. -/
@[stacks 0EYY "(a)"]
#check
  (Functor.AbelianLowerShriek.AtSheaf.constantIntegerLowerShriekIsoFreeAbelian F :
    (Functor.AbelianLowerShriek.AtSheaf.lowerShriek F).obj
        (constantIntegerSheaf (localizationTopology F)) ≅
      J.freeAbelianSheaf F.obj)

end Additive

section Tensor

variable [∀ P : F.obj.Elementsᵒᵖᵒᵖ ⥤ ModuleCat.{v} (ULift.{v} ℤ),
  (localizationProjection F).op.HasPointwiseRightKanExtension P]
variable [HasWeakSheafify J (ModuleCat.{v} (ULift.{v} ℤ))]
variable [HasWeakSheafify (localizationTopology F) (ModuleCat.{v} (ULift.{v} ℤ))]
variable [(J.W (A := ModuleCat.{v} (ULift.{v} ℤ))).IsMonoidal]
variable [((localizationTopology F).W
  (A := ModuleCat.{v} (ULift.{v} ℤ))).IsMonoidal]
variable [(ModuleSheaf.Localization.restriction (ULift.{v} ℤ) F).IsRightAdjoint]
variable (H : Sheaf J (ModuleCat.{v} (ULift.{v} ℤ)))

/- Remark 18.27.10 (0EYY) (b): for every abelian sheaf modeled as a sheaf of
`ULift ℤ`-modules (the universe-correct model of `ℤ`-modules), the category-of-elements
projection formula gives
`jₗ! (j⁻¹ H) ≅ jₗ! (𝟙_) ⊗ H`.  The local tensor unit `𝟙_` is the constant integral module
sheaf. -/
@[stacks 0EYY "(b)"]
#check
  (ModuleSheaf.Localization.unitProjectionFormulaIso (ULift.{v} ℤ) F H :
    (ModuleSheaf.Localization.lowerShriek (ULift.{v} ℤ) F).obj
        ((ModuleSheaf.Localization.restriction (ULift.{v} ℤ) F).obj H) ≅
      (ModuleSheaf.Localization.lowerShriek (ULift.{v} ℤ) F).obj (𝟙_ _) ⊗ H)

end Tensor

end CategoryTheory
