module

public import Mathlib.AlgebraicGeometry.Sites.Fpqc
public import Mathlib.CategoryTheory.Limits.MorphismProperty
public import Mathlib.CategoryTheory.Sites.Over

/-!
# Affine objects in a scheme slice

This module owns the category of affine schemes over `S` and the restriction
of an arbitrary slice-site topology to that category.  It is independent of a
choice of Zariski, etale, smooth, syntomic, fppf, or ph topology.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits

noncomputable section

universe u v

namespace AlgebraicGeometry.Scheme

/-- The property of an object over `S` that its source scheme is affine. -/
abbrev affineOverProperty (S : Scheme.{u}) : ObjectProperty (Over S) :=
  fun X ↦ IsAffine X.left

/-- The category of affine schemes equipped with a morphism to `S`. -/
abbrev AffineOver (S : Scheme.{u}) :=
  (⊤ : MorphismProperty Scheme.{u}).CostructuredArrow ⊤
    AffineScheme.forgetToScheme S

namespace AffineOver

/-- The inclusion from affine schemes over `S` into all schemes over `S`. -/
abbrev forget (S : Scheme.{u}) : S.AffineOver ⥤ Over S :=
  MorphismProperty.CostructuredArrow.toOver
      (⊤ : MorphismProperty Scheme.{u}) AffineScheme.forgetToScheme S ⋙
    MorphismProperty.Over.forget (⊤ : MorphismProperty Scheme.{u}) ⊤ S

/-- The object of `Over S` underlying an affine scheme over `S`. -/
abbrev obj {S : Scheme.{u}} (U : S.AffineOver) : Over S :=
  { left := U.left.obj
    right := ⟨⟨⟩⟩
    hom := U.hom }

/-- The morphism in `Over S` underlying a morphism of affine schemes over `S`. -/
abbrev hom {S : Scheme.{u}} {U V : S.AffineOver} (f : U ⟶ V) : U.obj ⟶ V.obj :=
  (forget S).map f

/-- Construct an affine scheme over `S` from a scheme, its affineness, and its
structure morphism. -/
def mk {S : Scheme.{u}} (X : Scheme.{u}) (hX : IsAffine X) (f : X ⟶ S) :
    S.AffineOver :=
  MorphismProperty.CostructuredArrow.mk (Q := ⊤)
    (A := AffineScheme.mk X hX) f trivial

/-- Construct a morphism of affine schemes over `S` from a morphism of source
schemes compatible with the structure morphisms. -/
def homMk {S : Scheme.{u}} {U V : S.AffineOver}
    (f : U.obj.left ⟶ V.obj.left) (w : f ≫ V.obj.hom = U.obj.hom) : U ⟶ V :=
  MorphismProperty.CostructuredArrow.homMk
    (InducedCategory.homMk f) trivial w

/-- An object of `Over S` lies in the essential image of the affine inclusion
exactly when its source scheme is affine. -/
theorem mem_essImage_forget_iff {S : Scheme.{u}} (X : Over S) :
    (forget S).essImage X ↔ affineOverProperty S X := sorry

/-- The functor sending an affine scheme over `S` to its source scheme. -/
abbrev toScheme (S : Scheme.{u}) : S.AffineOver ⥤ Scheme :=
  forget S ⋙ Over.forget S

end AffineOver

/-- The precoverage on affine schemes over `S` obtained by restricting a precoverage on `Over S`.
-/
abbrev affineOverPrecoverage (S : Scheme.{u}) (J : GrothendieckTopology (Over S)) :
    Precoverage S.AffineOver :=
  J.toPrecoverage.comap (AffineOver.forget S)

/-- Membership in the restricted affine precoverage is membership after applying the affine
inclusion to a presieve. -/
@[simp]
theorem mem_affineOverPrecoverage_iff
    (S : Scheme.{u}) (J : GrothendieckTopology (Over S))
    {U : S.AffineOver} {R : Presieve U} :
    R ∈ affineOverPrecoverage S J U ↔
      R.map (AffineOver.forget S) ∈ J.toPrecoverage (AffineOver.obj U) := sorry

/-- An indexed family in the affine slice is covering for the restricted precoverage exactly
when its underlying family in `Over S` is covering. -/
@[simp]
theorem ofArrows_mem_affineOverPrecoverage_iff
    (S : Scheme.{u}) (J : GrothendieckTopology (Over S))
    {U : S.AffineOver} {ι : Type v} (Y : ι → S.AffineOver) (π : ∀ i, Y i ⟶ U) :
    Presieve.ofArrows Y π ∈ affineOverPrecoverage S J U ↔
      Presieve.ofArrows (fun i ↦ AffineOver.obj (Y i))
        (fun i ↦ AffineOver.hom (π i)) ∈ J.toPrecoverage (AffineOver.obj U) := sorry

/-- The Grothendieck topology on affine schemes over `S` generated by a restricted slice
precoverage. -/
abbrev affineOverTopology (S : Scheme.{u}) (J : GrothendieckTopology (Over S)) :
    GrothendieckTopology S.AffineOver :=
  (affineOverPrecoverage S J).toGrothendieck

/-- The affine slice topology is generated by the restricted affine precoverage. -/
theorem affineOverTopology_def (S : Scheme.{u}) (J : GrothendieckTopology (Over S)) :
    affineOverTopology S J = (affineOverPrecoverage S J).toGrothendieck := sorry

end AlgebraicGeometry.Scheme
