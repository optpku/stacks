module

public import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic
import Mathlib.Tactic.CrossRefAttribute

/-!
# Finite subalgebras generated by integral elements

This leaf complements Mathlib's forward finite-adjoin theorem with reusable iff forms.  The
commutativity of the ambient algebra is essential: finitely many individually integral,
noncommuting elements need not generate a finite module.

@stack 00GM
@stack 02JJ
-/

@[expose] public section

universe u v

namespace Algebra

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]

/-- For a finite set, its generated subalgebra is finite exactly when every generator is
integral. -/
@[stacks 00GM "finite adjoin criterion"]
theorem finite_adjoin_iff_of_finite {s : Set S} (hs : s.Finite) :
    Module.Finite R (adjoin R s) ↔ ∀ x ∈ s, IsIntegral R x := by
  constructor
  · intro h x hx
    have hxIntegral :
        IsIntegral R (⟨x, Algebra.subset_adjoin hx⟩ : Algebra.adjoin R s) :=
      @_root_.IsIntegral.of_finite R (Algebra.adjoin R s) _ _ _ h _
    exact (isIntegral_algebraMap_iff (R := R) (A := Algebra.adjoin R s) (B := S)
      Subtype.coe_injective).mpr hxIntegral
  · exact Algebra.finite_adjoin_of_finite_of_isIntegral hs

/-- Lemma 10.36.4 (Tag 00GM): a finite set consists of integral elements exactly when it is
contained in an `R`-subalgebra that is finite as an `R`-module. -/
@[stacks 00GM]
theorem forall_isIntegral_iff_exists_finite_subalgebra {s : Set S} (hs : s.Finite) :
    (∀ x ∈ s, IsIntegral R x) ↔
      ∃ T : Subalgebra R S, Module.Finite R T ∧ s ⊆ T := by
  constructor
  · intro hsIntegral
    exact ⟨Algebra.adjoin R s,
      Algebra.finite_adjoin_of_finite_of_isIntegral hs hsIntegral,
      Algebra.subset_adjoin⟩
  · rintro ⟨T, hT, hsT⟩ x hx
    have hxIntegral : IsIntegral R (⟨x, hsT hx⟩ : T) :=
      @_root_.IsIntegral.of_finite R T _ _ _ hT _
    exact (isIntegral_algebraMap_iff (R := R) (A := T) (B := S)
      Subtype.coe_injective).mpr hxIntegral

/-- Lemma 10.36.5 (Tag 02JJ): an algebra is finite precisely when it has a finite set of
integral algebra generators. -/
@[stacks 02JJ "finite integral generating set"]
theorem finite_iff_exists_integral_generators :
    Module.Finite R S ↔
      ∃ s : Finset S,
        (∀ x ∈ (s : Set S), IsIntegral R x) ∧ Algebra.adjoin R (s : Set S) = ⊤ := by
  rw [Algebra.finite_iff_isIntegral_and_finiteType]
  constructor
  · rintro ⟨hIntegral, hFiniteType⟩
    obtain ⟨s, hs⟩ := hFiniteType.out
    exact ⟨s, fun x _ ↦ hIntegral.isIntegral x, hs⟩
  · rintro ⟨s, hsIntegral, hs⟩
    constructor
    · have hIntegral : Algebra.IsIntegral R (Algebra.adjoin R (s : Set S)) :=
        Algebra.IsIntegral.adjoin hsIntegral
      rw [hs] at hIntegral
      exact Subalgebra.topEquiv.isIntegral_iff.mp hIntegral
    · exact ⟨⟨s, hs⟩⟩

end Algebra
