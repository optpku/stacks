module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Free.OnSheaf
public import ReasLib.CategoryTheory.Sites.Graded.Sheaf
import Mathlib.Tactic.CrossRefAttribute

/-!
# Free graded module sheaves

The free-on-sheaf functor acts pointwise on graded objects.  Composing it with the degree-fiber
functor gives the canonical free graded module sheaf generated by a total graded sheaf.
-/

@[expose] public section

open CategoryTheory

noncomputable section

universe u v w x

namespace SheafOfModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable (R : Sheaf J RingCat.{w})
variable [HasWeakSheafify J AddCommGrpCat.{w}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- Apply the free-on-sheaf functor independently in every grading degree. -/
@[stacks 0FSF "pointwise free graded module sheaves"]
noncomputable def freeGraded (ι : Type x) :
    GradedObject ι (Sheaf J (Type w)) ⥤
      GradedObject ι (SheafOfModules.{w} R) :=
  Functor.pi (fun _ : ι ↦ freeOnSheaf R)

/-- The degree-`i` component of a pointwise free graded module is the free module sheaf on the
degree-`i` sheaf of generators. -/
@[simp]
theorem freeGraded_obj_apply (ι : Type x)
    (S : GradedObject ι (Sheaf J (Type w))) (i : ι) :
    (freeGraded R ι).obj S i = (freeOnSheaf R).obj (S i) := sorry

/-- A mapped graded morphism is sent degreewise by the free-on-sheaf functor. -/
@[simp]
theorem freeGraded_map_apply (ι : Type x)
    {S T : GradedObject ι (Sheaf J (Type w))} (f : S ⟶ T) (i : ι) :
    (freeGraded R ι).map f i = (freeOnSheaf R).map (f i) := sorry

section TotalGrading

variable [HasWeakSheafify J (Type w)] {β : Type}

/-- The free graded `R`-module sheaf generated by a sheaf equipped with a degree map. -/
@[stacks 0FSF "free graded module on a graded sheaf"]
noncomputable def freeOnGradedSheaf :
    SmallGradedSheaf.{u, v, w} J β ⥤
      GradedObject β (SheafOfModules.{w} R) :=
  SmallGradedSheaf.degreeFiberFunctor ⋙ freeGraded R β

/-- The degree-`b` component is the free module sheaf on the degree-`b` fiber. -/
@[simp]
theorem freeOnGradedSheaf_obj_apply
    (S : SmallGradedSheaf.{u, v, w} J β) (b : β) :
    (freeOnGradedSheaf R).obj S b =
      (freeOnSheaf R).obj (SmallGradedSheaf.degreeFiber S b) := sorry

/-- Before sheafification, the degree-`b` component is pointwise free on local sections of
degree `b`. -/
theorem freeOnGradedSheaf_presheaf_obj
    (S : SmallGradedSheaf.{u, v, w} J β) (b : β) (U : Cᵒᵖ) :
    (freePresheafOnSheaf R (SmallGradedSheaf.degreeFiber S b)).obj U =
      (ModuleCat.free (R.obj.obj U)).obj
        ((SmallGradedSheaf.degreeFiber S b).obj.obj U) := sorry

end TotalGrading

end SheafOfModules

end
