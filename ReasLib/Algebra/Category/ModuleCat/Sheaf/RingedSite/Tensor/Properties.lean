module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.LocalProperties
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.Tensor
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Local properties of tensor products of module sheaves

The tensor product is the canonical monoidal operation on module sheaves over a commutative
ring sheaf.  This leaf records its closure properties without exposing the covers, localized
tensor comparisons, or iterated-slice choices used by proofs.
-/

@[expose] public section

open CategoryTheory
open scoped SheafOfModules.RingedSite

noncomputable section

universe u v w

namespace SheafOfModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
variable [HasWeakSheafify J AddCommGrpCat.{w}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
variable {O : Sheaf J CommRingCat.{w}}

section OneLevel

variable [∀ U : C, HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
variable [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]

namespace IsLocallyFree

/-- The tensor product of locally free module sheaves is locally free. -/
@[stacks 03L6 "(1)"]
theorem tensor
    (F G : RingedSite.ringedSiteModuleCategory.{u, v, w, w} J O)
    [F.IsLocallyFree] [G.IsLocallyFree] :
    (F ⊗ G).IsLocallyFree := sorry

end IsLocallyFree

namespace IsFiniteLocallyFree

/-- The tensor product of finite locally free module sheaves is finite locally free. -/
@[stacks 03L6 "(2)"]
theorem tensor
    (F G : RingedSite.ringedSiteModuleCategory.{u, v, w, w} J O)
    [IsFiniteLocallyFree F] [IsFiniteLocallyFree G] :
    IsFiniteLocallyFree (F ⊗ G) := sorry

end IsFiniteLocallyFree

namespace IsLocallyGeneratedBySections

/-- The tensor product of module sheaves locally generated by sections is locally generated by
sections. -/
@[stacks 03L6 "(3)"]
theorem tensor
    (F G : RingedSite.ringedSiteModuleCategory.{u, v, w, w} J O)
    [IsLocallyGeneratedBySections F] [IsLocallyGeneratedBySections G] :
    IsLocallyGeneratedBySections (F ⊗ G) := sorry

end IsLocallyGeneratedBySections

namespace IsFiniteType

/-- The tensor product of finite-type module sheaves is of finite type. -/
@[stacks 03L6 "(4)"]
theorem tensor
    (F G : RingedSite.ringedSiteModuleCategory.{u, v, w, w} J O)
    [F.IsFiniteType] [G.IsFiniteType] :
    (F ⊗ G).IsFiniteType := sorry

end IsFiniteType

namespace IsQuasicoherent

/-- The tensor product of quasicoherent module sheaves is quasicoherent. -/
@[stacks 03L6 "(5)"]
theorem tensor
    (F G : RingedSite.ringedSiteModuleCategory.{u, v, w, w} J O)
    [F.IsQuasicoherent] [G.IsQuasicoherent] :
    (F ⊗ G).IsQuasicoherent := sorry

end IsQuasicoherent

namespace IsFinitePresentation

/-- The tensor product of finitely presented module sheaves is finitely presented. -/
@[stacks 03L6 "(6)"]
theorem tensor
    (F G : RingedSite.ringedSiteModuleCategory.{u, v, w, w} J O)
    [F.IsFinitePresentation] [G.IsFinitePresentation] :
    (F ⊗ G).IsFinitePresentation := sorry

end IsFinitePresentation

end OneLevel

section Iterated

variable [∀ U : C, HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
variable [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
variable [∀ (U : C) (V : Over U),
  HasWeakSheafify ((J.over U).over V) AddCommGrpCat.{w}]
variable [∀ (U : C) (V : Over U),
  ((J.over U).over V).WEqualsLocallyBijective AddCommGrpCat.{w}]

namespace IsCoherent

/-- Tensoring a finitely presented module sheaf with a coherent module sheaf gives a coherent
module sheaf. -/
@[stacks 03L6 "(7)"]
theorem tensor_of_finitePresentation_left
    (F G : RingedSite.ringedSiteModuleCategory.{u, v, w, w} J O)
    [F.IsFinitePresentation] [IsCoherent G] :
    IsCoherent (F ⊗ G) := sorry

/-- The symmetric form of coherence under tensor: a coherent left factor and a finitely
presented right factor also give a coherent tensor product. -/
theorem tensor_of_finitePresentation_right
    (F G : RingedSite.ringedSiteModuleCategory.{u, v, w, w} J O)
    [IsCoherent F] [G.IsFinitePresentation] :
    IsCoherent (F ⊗ G) := sorry

/-- The tensor product of coherent module sheaves is coherent. -/
@[stacks 03L6 "(8)"]
theorem tensor
    (F G : RingedSite.ringedSiteModuleCategory.{u, v, w, w} J O)
    [IsCoherent F] [IsCoherent G] :
    IsCoherent (F ⊗ G) := sorry

end IsCoherent

end Iterated

end SheafOfModules
