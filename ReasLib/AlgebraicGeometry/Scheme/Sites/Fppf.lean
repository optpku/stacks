module

public import ReasLib.AlgebraicGeometry.Scheme.Sites.AffineOver.Pretopology
public import Mathlib.CategoryTheory.Sites.Finite
public import ReasLib.AlgebraicGeometry.Scheme.Cover.Fppf.Refinement
public import ReasLib.AlgebraicGeometry.Scheme.Cover.Fppf.Stability

/-!
# The big affine fppf site

This module defines the finite fppf pretopology on affine schemes over a fixed
scheme and identifies its generated topology with the canonical topology
induced from the big fppf slice site.
-/

@[expose] public section

open CategoryTheory

universe u v

namespace AlgebraicGeometry.Scheme

/-- The pretopology of finite fppf covering families on affine schemes over
`S`. -/
noncomputable abbrev bigAffineFppfPretopology (S : Scheme.{u}) : Pretopology S.AffineOver :=
  (Scheme.fppfPrecoverage.comap (AffineOver.toScheme S)).toPretopology ⊓
    Pretopology.finite S.AffineOver

/-- The precoverage of families on affine schemes over `S` that are both
fppf-covering after forgetting to schemes and finite. -/
noncomputable abbrev bigAffineFppfPrecoverage (S : Scheme.{u}) : Precoverage S.AffineOver :=
  Scheme.fppfPrecoverage.comap (AffineOver.toScheme S) ⊓
    Precoverage.finite S.AffineOver

/-- A presieve covers in the big affine fppf precoverage exactly when its
underlying family is an fppf covering and it has finitely many arrows. -/
@[simp] theorem mem_bigAffineFppfPrecoverage_iff
    (S : Scheme.{u}) {U : S.AffineOver} {R : Presieve U} :
    R ∈ bigAffineFppfPrecoverage S U ↔
      R.map (AffineOver.toScheme S) ∈ Scheme.fppfPrecoverage U.obj.left ∧
        R.uncurry.Finite := sorry

/-- A finite indexed family covers in the big affine fppf precoverage exactly
when its underlying family of scheme morphisms is an fppf covering. -/
@[simp] theorem ofArrows_mem_bigAffineFppfPrecoverage_iff
    (S : Scheme.{u}) {U : S.AffineOver} {ι : Type v} [Finite ι]
    (Y : ι → S.AffineOver) (π : ∀ i, Y i ⟶ U) :
    Presieve.ofArrows Y π ∈ bigAffineFppfPrecoverage S U ↔
      Presieve.ofArrows (fun i ↦ (AffineOver.toScheme S).obj (Y i))
        (fun i ↦ (AffineOver.toScheme S).map (π i)) ∈
        Scheme.fppfPrecoverage ((AffineOver.toScheme S).obj U) := sorry

/-- The canonical fppf Grothendieck topology on affine schemes over `S`,
induced from the big fppf topology on the slice over `S`. -/
noncomputable abbrev bigAffineFppfTopology (S : Scheme.{u}) : GrothendieckTopology S.AffineOver :=
  affineOverTopology S (Scheme.fppfTopology.over S)

/-- The canonical affine fppf topology is generated by finite standard fppf
covering families. -/
theorem bigAffineFppfTopology_def (S : Scheme.{u}) :
    bigAffineFppfTopology S = (bigAffineFppfPrecoverage S).toGrothendieck := sorry

/-- The underlying precoverage of the finite affine fppf pretopology is the
finite affine fppf precoverage. -/
theorem bigAffineFppfPretopology_toPrecoverage (S : Scheme.{u}) :
    (bigAffineFppfPretopology S).toPrecoverage = bigAffineFppfPrecoverage S := sorry

/-- The topology generated by the finite affine fppf pretopology is the
topology generated by its underlying precoverage. -/
theorem bigAffineFppfPretopology_toGrothendieck (S : Scheme.{u}) :
    (bigAffineFppfPretopology S).toGrothendieck =
      (bigAffineFppfPrecoverage S).toGrothendieck := sorry

end AlgebraicGeometry.Scheme
