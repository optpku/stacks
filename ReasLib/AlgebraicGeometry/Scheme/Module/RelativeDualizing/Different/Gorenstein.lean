/-!
# Gorenstein differents

This file records the intrinsic different statements for quasi-finite Gorenstein
morphisms of Noetherian schemes.
-/

@[expose] public section

noncomputable section

open AlgebraicGeometry AlgebraicGeometry.Scheme CategoryTheory
  CategoryTheory.Limits SheafOfModules
open scoped AlgebraicGeometry

universe u

namespace AlgebraicGeometry.Scheme.Hom.RelativeDualizingSheaf

/-- The different of a quasi-finite Gorenstein morphism is generated by one section
on an affine neighborhood of every point of the source. -/
theorem different_locallyPrincipalIdeal_of_gorenstein
    {X Y : Scheme.{u}} {f : Y ⟶ X} [IsNoetherian X] [IsNoetherian Y]
    [Scheme.Hom.QuasiFinite f] [AlgebraicGeometry.Gorenstein f]
    (W : f.RelativeDualizingSheaf) (τ : sections W.module.obj)
    (hτ : W.IsTraceSection τ) :
    ∀ y : Y, ∃ V : Y.affineOpens, y ∈ (V : Y.Opens) ∧
      ∃ b : Γ(Y, V),
        (W.different τ).ideal V = Ideal.span ({b} : Set Γ(Y, V)) := sorry

/-- The closed subscheme defined by the different of a quasi-finite Gorenstein
morphism is locally principal. -/
theorem different_locallyPrincipalClosedSubscheme_of_gorenstein
    {X Y : Scheme.{u}} {f : Y ⟶ X} [IsNoetherian X] [IsNoetherian Y]
    [Scheme.Hom.QuasiFinite f] [AlgebraicGeometry.Gorenstein f]
    (W : f.RelativeDualizingSheaf) (τ : sections W.module.obj)
    (hτ : W.IsTraceSection τ) :
    IsLocallyPrincipalClosedSubscheme (W.different τ).subschemeι := sorry

/-- On compatible affine opens, the different of a quasi-finite Gorenstein
morphism is the Noether different of the induced section algebra. -/
theorem different_eq_noetherDifferent_on_affine_of_gorenstein
    {X Y : Scheme.{u}} {f : Y ⟶ X} [IsNoetherian X] [IsNoetherian Y]
    [Scheme.Hom.QuasiFinite f] [AlgebraicGeometry.Gorenstein f]
    (W : f.RelativeDualizingSheaf) (τ : sections W.module.obj)
    (hτ : W.IsTraceSection τ) (U : X.affineOpens) (V : Y.affineOpens)
    (hVU : V ≤ f ⁻¹ᵁ U) :
    (W.different τ).ideal V =
      KaehlerDifferential.noetherDifferent Γ(X, U)
        (f.sectionsAlg (U : X.Opens) (V : Y.Opens) hVU) := sorry

/-- The different of a quasi-finite Gorenstein morphism is preserved by the
corresponding cartesian base change. -/
theorem different_baseChange_of_gorenstein
    {X Y X' Y' : Scheme.{u}} {f : Y ⟶ X} {f' : Y' ⟶ X'}
    [IsNoetherian X] [IsNoetherian Y] [IsNoetherian X'] [IsNoetherian Y']
    [Scheme.Hom.QuasiFinite f] [AlgebraicGeometry.Gorenstein f]
    [Flat f'] [Scheme.Hom.QuasiFinite f']
    (W : f.RelativeDualizingSheaf) (W' : f'.RelativeDualizingSheaf)
    (g : X' ⟶ X) (h : Y' ⟶ Y)
    (τ : sections W.module.obj) (τ' : sections W'.module.obj)
    (sq : IsPullback h f' f g) (hτ : W.IsTraceSection τ)
    (hτ' : W'.IsTraceSection τ') :
    W'.different τ' = (W.different τ).comap h := sorry

/-- For a finite quasi-finite Gorenstein morphism, the norm of a local generator
of the different generates the discriminant ideal of a local basis. -/
theorem normDifferent_eq_discriminant_of_gorenstein
    {X Y : Scheme.{u}} (f : Y ⟶ X) [IsNoetherian X] [IsNoetherian Y]
    [IsFinite f] [Scheme.Hom.QuasiFinite f] [AlgebraicGeometry.Gorenstein f]
    (W : f.RelativeDualizingSheaf) (τ : sections W.module.obj)
    (hτ : W.IsTraceSection τ) :
    ∀ x : X, ∃ U : X.affineOpens, x ∈ (U : X.Opens) ∧
      ∃ n : ℕ,
        ∃ e : Module.Basis (Fin n) Γ(X, U)
          (f.sectionsAlg (U : X.Opens) (f ⁻¹ᵁ U) le_rfl),
          ∃ b : f.sectionsAlg (U : X.Opens) (f ⁻¹ᵁ U) le_rfl,
            (W.different τ).ideal ⟨f ⁻¹ᵁ U, U.2.preimage f⟩ = Ideal.span {b} ∧
              Ideal.span {Algebra.norm Γ(X, U) b} =
                Ideal.span {Algebra.discr Γ(X, U) e} := sorry

/-- If a quasi-finite Gorenstein morphism is étale at every associated point of
the source, its different is an effective Cartier divisor with the relative
dualizing sheaf as its associated sheaf. -/
theorem different_cartierAssociatedSheaf_of_gorenstein
    {X Y : Scheme.{u}} {f : Y ⟶ X} [IsNoetherian X] [IsNoetherian Y]
    [Scheme.Hom.QuasiFinite f] [AlgebraicGeometry.Gorenstein f]
    (W : f.RelativeDualizingSheaf) (τ : sections W.module.obj)
    (hτ : W.IsTraceSection τ)
    (h_assoc : ∀ y : Y, y ∈ Y.associatedPoints → f.EtaleAt y) :
    ∃ hD : IsEffectiveCartierDivisor (W.different τ).subschemeι,
      Nonempty ((W.different τ).associatedSheaf (hD := hD) ≅ W.module.obj) := sorry

/-- The different obtained from a trace section is independent of the chosen
relative dualizing sheaf and trace section. -/
theorem different_eq_of_gorenstein
    {X Y : Scheme.{u}} {f : Y ⟶ X} [IsNoetherian X] [IsNoetherian Y]
    [Scheme.Hom.QuasiFinite f] [AlgebraicGeometry.Gorenstein f]
    (W W' : f.RelativeDualizingSheaf)
    (τ : sections W.module.obj) (τ' : sections W'.module.obj)
    (hτ : W.IsTraceSection τ) (hτ' : W'.IsTraceSection τ') :
    W.different τ = W'.different τ' := sorry

end AlgebraicGeometry.Scheme.Hom.RelativeDualizingSheaf
