/-!
# The (4,3)-curve in ℙ¹ ×_ℂ ℙ¹

This file constructs the scheme-theoretic closure of the affine hypersurface
`y³(x⁴ + 1) = x⁴ - 1` in the product of two complex projective lines.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open scoped AlgebraicGeometry

noncomputable section

namespace AlgebraicGeometry.ProjectiveLineProduct

/-- The complex projective line. -/
abbrev line : Scheme := ProjectiveLine.scheme ℂ

/-- The complex projective line as a scheme over `Spec ℂ`. -/
abbrev lineOver : SchemeOverField ℂ := ProjectiveSpace.schemeOver ℂ 1

/-- The product `ℙ¹_ℂ ×_{Spec ℂ} ℙ¹_ℂ` as a scheme over `Spec ℂ`. -/
abbrev ambientOver : SchemeOverField ℂ := lineOver ⨯ lineOver

/-- The underlying scheme of `ℙ¹_ℂ ×_{Spec ℂ} ℙ¹_ℂ`. -/
abbrev ambient : Scheme := ambientOver.left

/-- Projection of the product onto the first factor. -/
def fst : ambient ⟶ line := (prod.fst : ambientOver ⟶ lineOver).left

/-- Projection of the product onto the second factor. -/
def snd : ambient ⟶ line := (prod.snd : ambientOver ⟶ lineOver).left

/-- The standard affine chart `D₊(T_i)` of the complex projective line. -/
def lineChart (i : Fin 2) : line.Opens :=
  if i = 0 then ProjectiveLine.chartX ℂ else ProjectiveLine.chartY ℂ

/-- The product chart `D₊(X_i) × D₊(Y_j)` in `ℙ¹ × ℙ¹`. -/
def affineOpen (i j : Fin 2) : ambient.Opens :=
  fst ⁻¹ᵁ lineChart i ⊓ snd ⁻¹ᵁ lineChart j

/-- The first product chart, with coordinate ring `ℂ[x, y]`. -/
abbrev firstOpen : ambient.Opens := affineOpen 0 0

/-- The second product chart, with coordinate ring `ℂ[x⁻¹, y]`. -/
abbrev secondOpen : ambient.Opens := affineOpen 1 0

/-- The third product chart, with coordinate ring `ℂ[x, y⁻¹]`. -/
abbrev thirdOpen : ambient.Opens := affineOpen 0 1

/-- The last product chart, with coordinate ring `ℂ[x⁻¹, y⁻¹]`. -/
abbrev lastOpen : ambient.Opens := affineOpen 1 1

/-- The affine equation `y³(x⁴ + 1) - (x⁴ - 1)` in coordinates `(x, y)`. -/
def equation : MvPolynomial (Fin 2) ℂ :=
  MvPolynomial.X (1 : Fin 2) ^ 3 * (MvPolynomial.X (0 : Fin 2) ^ 4 + 1) -
    (MvPolynomial.X (0 : Fin 2) ^ 4 - 1)

/-- Unfolding of the first-chart affine equation. -/
theorem equation_def :
    equation =
      MvPolynomial.X (1 : Fin 2) ^ 3 * (MvPolynomial.X (0 : Fin 2) ^ 4 + 1) -
        (MvPolynomial.X (0 : Fin 2) ^ 4 - 1) := sorry

/-- The last-chart affine equation `v³(1 - u⁴) - (1 + u⁴)` in coordinates `(u, v) = (x⁻¹, y⁻¹)`. -/
def lastEquation : MvPolynomial (Fin 2) ℂ :=
  MvPolynomial.X (1 : Fin 2) ^ 3 * (1 - MvPolynomial.X (0 : Fin 2) ^ 4) -
    (1 + MvPolynomial.X (0 : Fin 2) ^ 4)

/-- Unfolding of the last-chart affine equation. -/
theorem lastEquation_def :
    lastEquation =
      MvPolynomial.X (1 : Fin 2) ^ 3 * (1 - MvPolynomial.X (0 : Fin 2) ^ 4) -
        (1 + MvPolynomial.X (0 : Fin 2) ^ 4) := sorry

/-- The bihomogeneous form `Y₁³(X₁⁴ + X₀⁴) - Y₀³(X₁⁴ - X₀⁴)`, with
`X₀ = T(0,0)`, `X₁ = T(0,1)`, `Y₀ = T(1,0)`, and `Y₁ = T(1,1)`. -/
def bihomogeneousEquation : MvPolynomial (Fin 2 × Fin 2) ℂ :=
  MvPolynomial.X (1, 1) ^ 3 *
      (MvPolynomial.X (0, 1) ^ 4 + MvPolynomial.X (0, 0) ^ 4) -
    MvPolynomial.X (1, 0) ^ 3 *
      (MvPolynomial.X (0, 1) ^ 4 - MvPolynomial.X (0, 0) ^ 4)

/-- Unfolding of the bihomogeneous `(4, 3)` equation. -/
theorem bihomogeneousEquation_def :
    bihomogeneousEquation =
      MvPolynomial.X (1, 1) ^ 3 *
          (MvPolynomial.X (0, 1) ^ 4 + MvPolynomial.X (0, 0) ^ 4) -
        MvPolynomial.X (1, 0) ^ 3 *
          (MvPolynomial.X (0, 1) ^ 4 - MvPolynomial.X (0, 0) ^ 4) := sorry

/-- The principal ideal generated by the first-chart affine equation. -/
def affineIdeal : Ideal (MvPolynomial (Fin 2) ℂ) := Ideal.span {equation}

/-- The affine coordinate ring `ℂ[x, y] ⧸ (y³(x⁴ + 1) - (x⁴ - 1))`. -/
abbrev affineCoordinateRing : Type := MvPolynomial (Fin 2) ℂ ⧸ affineIdeal

/-- The closed subscheme of the first affine plane cut out by `equation`. -/
abbrev affineClosed : Scheme := Spec (CommRingCat.of affineCoordinateRing)

/-- `affineClosed` is the spectrum of the first-chart coordinate ring. -/
theorem affineClosed_spec : affineClosed = Spec (CommRingCat.of affineCoordinateRing) := sorry

/-- The structure morphism of the affine closed subscheme to `Spec ℂ`. -/
def affineClosedToSpec : affineClosed ⟶ Spec (CommRingCat.of ℂ) :=
  Spec.map (CommRingCat.ofHom (algebraMap ℂ affineCoordinateRing))

/-- The affine closed subscheme as a scheme over `Spec ℂ`. -/
abbrev affineClosedOver : SchemeOverField ℂ := Over.mk affineClosedToSpec

/-- The first affine plane `𝔸²_ℂ` with coordinates `(x, y)`. -/
abbrev affinePlane : Scheme := 𝔸(Fin 2; Spec (CommRingCat.of ℂ))

/-- The first affine plane as a scheme over `Spec ℂ`. -/
abbrev affinePlaneOver : SchemeOverField ℂ :=
  Over.mk (affinePlane ↘ Spec (CommRingCat.of ℂ))

/-- The closed immersion of the affine hypersurface into `Spec ℂ[x, y]`. -/
def affineClosedToPolynomialSpec :
    affineClosed ⟶ Spec (CommRingCat.of (MvPolynomial (Fin 2) ℂ)) :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk affineIdeal))

/-- The closed immersion of the affine hypersurface into the first affine plane. -/
def affineClosedToPlane : affineClosed ⟶ affinePlane :=
  affineClosedToPolynomialSpec ≫ (AffineSpace.SpecIso (Fin 2) (CommRingCat.of ℂ)).inv

/-- The affine-plane immersion lies over `Spec ℂ`. -/
theorem affineClosedToPlane_toSpec :
    affineClosedToPlane ≫ (affinePlane ↘ Spec (CommRingCat.of ℂ)) = affineClosedToSpec := sorry

/-- The closed immersion of the affine hypersurface into the first affine plane, over `Spec ℂ`. -/
def affineClosedToPlaneOver : affineClosedOver ⟶ affinePlaneOver :=
  Over.homMk affineClosedToPlane affineClosedToPlane_toSpec

/-- The map from the first affine plane to `ℙ¹` selecting the `i`-th coordinate through `D₊(X)`. -/
def planeToChartX (i : Fin 2) : affinePlane ⟶ line :=
  AffineSpace.reindex (fun _ : ULift (Fin 1) ↦ i) (Spec (CommRingCat.of ℂ)) ≫
    (ProjectiveLine.chartXIso ℂ).inv ≫ (ProjectiveLine.chartX ℂ).ι

/-- Each first-chart coordinate map from the affine plane lies over `Spec ℂ`. -/
theorem planeToChartX_toSpec (i : Fin 2) :
    planeToChartX i ≫ ProjectiveLine.toSpec ℂ =
      affinePlane ↘ Spec (CommRingCat.of ℂ) := sorry

/-- The first-chart coordinate map from the affine plane, as a morphism over `Spec ℂ`. -/
def planeToChartXOver (i : Fin 2) : affinePlaneOver ⟶ lineOver :=
  Over.homMk (planeToChartX i) (planeToChartX_toSpec i)

/-- The open immersion of the first affine plane into `ℙ¹ × ℙ¹` through the two `X`-charts. -/
def affinePlaneInclusionOver : affinePlaneOver ⟶ ambientOver :=
  prod.lift (planeToChartXOver 0) (planeToChartXOver 1)

/-- The underlying scheme morphism of the first affine-plane inclusion. -/
def affinePlaneInclusion : affinePlane ⟶ ambient := affinePlaneInclusionOver.left

/-- The map from the last affine plane to `ℙ¹` selecting the `i`-th coordinate through `D₊(Y)`. -/
def planeToChartY (i : Fin 2) : affinePlane ⟶ line :=
  AffineSpace.reindex (fun _ : ULift (Fin 1) ↦ i) (Spec (CommRingCat.of ℂ)) ≫
    (ProjectiveLine.chartYIso ℂ).inv ≫ (ProjectiveLine.chartY ℂ).ι

/-- Each last-chart coordinate map from the affine plane lies over `Spec ℂ`. -/
theorem planeToChartY_toSpec (i : Fin 2) :
    planeToChartY i ≫ ProjectiveLine.toSpec ℂ =
      affinePlane ↘ Spec (CommRingCat.of ℂ) := sorry

/-- The last-chart coordinate map from the affine plane, as a morphism over `Spec ℂ`. -/
def planeToChartYOver (i : Fin 2) : affinePlaneOver ⟶ lineOver :=
  Over.homMk (planeToChartY i) (planeToChartY_toSpec i)

/-- The open immersion of the last affine plane into `ℙ¹ × ℙ¹` through the two `Y`-charts. -/
def lastPlaneInclusionOver : affinePlaneOver ⟶ ambientOver :=
  prod.lift (planeToChartYOver 0) (planeToChartYOver 1)

/-- The underlying scheme morphism of the last affine-plane inclusion. -/
def lastPlaneInclusion : affinePlane ⟶ ambient := lastPlaneInclusionOver.left

/-- The generating morphism of the affine hypersurface into the product, over `Spec ℂ`. -/
def generatingOver : affineClosedOver ⟶ ambientOver :=
  affineClosedToPlaneOver ≫ affinePlaneInclusionOver

/-- The generating morphism of the affine hypersurface into `ℙ¹ × ℙ¹`. -/
def generatingMap : affineClosed ⟶ ambient := generatingOver.left

/-- The generating morphism is the closed immersion into the first affine plane followed by
the first product-chart inclusion. -/
theorem generatingMap_spec :
    generatingMap = affineClosedToPlane ≫ affinePlaneInclusion := sorry

/-- The scheme-theoretic closure of the affine hypersurface in `ℙ¹ × ℙ¹`. -/
abbrev scheme : Scheme := generatingMap.image

/-- The curve is the scheme-theoretic image of `generatingMap`. -/
theorem scheme_eq_image : scheme = generatingMap.image := sorry

/-- The curve as a scheme over `Spec ℂ`. -/
abbrev schemeOver : SchemeOverField ℂ := Scheme.Hom.imageOver generatingOver

/-- The closed immersion of the curve into `ℙ¹ × ℙ¹`. -/
abbrev ι : scheme ⟶ ambient := generatingMap.imageι

/-- The closed immersion is the image inclusion of `generatingMap`. -/
theorem ι_eq_imageι : ι = generatingMap.imageι := sorry

/-- The closed immersion of the curve into the product is a closed immersion. -/
instance instIsClosedImmersion_ι : IsClosedImmersion ι := inferInstance

/-- The first-factor projection `X ⟶ ℙ¹` (source `pr₂`). -/
def xProjection : scheme ⟶ line := ι ≫ fst

/-- The first-factor projection is the composite of `ι` with the first product projection. -/
theorem xProjection_comp_ι : xProjection = ι ≫ fst := sorry

/-- On the first affine piece, the first-factor projection is the coordinate map `(x, y) ↦ x`. -/
theorem xProjection_comp_toImage :
    generatingMap.toImage ≫ xProjection = affineClosedToPlane ≫ planeToChartX 0 := sorry

/-- The complex projective line is an integral scheme. -/
instance instIsIntegral_line : IsIntegral line := sorry

/-- The scheme-theoretic closure is an integral scheme. -/
instance instIsIntegral_scheme : IsIntegral scheme := sorry

/-- The first-factor projection is dominant. -/
instance instIsDominant_xProjection : IsDominant xProjection := sorry

/-- The curve is geometrically irreducible over `ℂ`. -/
instance instGeometricallyIrreducible : GeometricallyIrreducible schemeOver.hom := sorry

/-- The global section of `Spec ℂ` associated to a complex number. -/
def specSection (a : ℂ) : Γ(Spec (CommRingCat.of ℂ), ⊤) :=
  (Scheme.ΓSpecIso (CommRingCat.of ℂ)).inv a

/-- The `k`-point `[1 : a]` of the projective line, via the standard `X`-chart. -/
def xChartPoint (a : ℂ) : Spec (CommRingCat.of ℂ) ⟶ line :=
  AffineSpace.homOfVector (𝟙 _) (fun _ ↦ specSection a) ≫
    (ProjectiveLine.chartXIso ℂ).inv ≫ (ProjectiveLine.chartX ℂ).ι

/-- Each `X`-chart rational point lies over `Spec ℂ`. -/
theorem xChartPoint_toSpec (a : ℂ) :
    xChartPoint a ≫ ProjectiveLine.toSpec ℂ = 𝟙 _ := sorry

/-- The spectrum of `ℂ` as a scheme over itself. -/
abbrev specOver : SchemeOverField ℂ := Over.mk (𝟙 (Spec (CommRingCat.of ℂ)))

/-- The rational point `[1 : a]` as a morphism over `Spec ℂ`. -/
def xChartPointOver (a : ℂ) : specOver ⟶ lineOver :=
  Over.homMk (xChartPoint a) (xChartPoint_toSpec a)

/-- The product point `(a, 0)` in `ℙ¹ × ℙ¹`. -/
def firstAmbientOver (a : ℂ) : specOver ⟶ ambientOver :=
  prod.lift (xChartPointOver a)
    (Over.homMk (ProjectiveLine.zeroSection ℂ) (ProjectiveLine.zeroSection_toSpec ℂ))

/-- The underlying morphism of the product point `(a, 0)`. -/
def firstAmbientPoint (a : ℂ) : Spec (CommRingCat.of ℂ) ⟶ ambient :=
  (firstAmbientOver a).left

/-- The product point `(a, ∞)` in `ℙ¹ × ℙ¹`. -/
def lastAmbientOver (a : ℂ) : specOver ⟶ ambientOver :=
  prod.lift (xChartPointOver a)
    (Over.homMk (ProjectiveLine.infinitySection ℂ) (ProjectiveLine.infinitySection_toSpec ℂ))

/-- The underlying morphism of the product point `(a, ∞)`. -/
def lastAmbientPoint (a : ℂ) : Spec (CommRingCat.of ℂ) ⟶ ambient :=
  (lastAmbientOver a).left

/-- For `a⁴ = 1`, the point `(a, 0)` lies on the curve. -/
theorem firstAmbientPoint_ker (a : ℂ) (ha : a ^ 4 = 1) :
    ι.ker ≤ (firstAmbientPoint a).ker := sorry

/-- For `a⁴ = -1`, the point `(a, ∞)` lies on the curve. -/
theorem lastAmbientPoint_ker (a : ℂ) (ha : a ^ 4 = -1) :
    ι.ker ≤ (lastAmbientPoint a).ker := sorry

/-- The ramification point of `xProjection` in the first chart with coordinates `(a, 0)`. -/
def firstRamificationPoint (a : ℂ) (ha : a ^ 4 = 1) :
    Spec (CommRingCat.of ℂ) ⟶ scheme :=
  IsClosedImmersion.lift ι (firstAmbientPoint a) (firstAmbientPoint_ker a ha)

/-- The ramification point of `xProjection` in the last chart, corresponding to `(x, y) = (a, ∞)`. -/
def lastRamificationPoint (a : ℂ) (ha : a ^ 4 = -1) :
    Spec (CommRingCat.of ℂ) ⟶ scheme :=
  IsClosedImmersion.lift ι (lastAmbientPoint a) (lastAmbientPoint_ker a ha)

/-- First-chart ramification points have ramification index three. -/
theorem ramificationIndexAt_first (a : ℂ) (ha : a ^ 4 = 1) :
    xProjection.ramificationIndexAt
      ((firstRamificationPoint a ha).base (IsLocalRing.closedPoint ℂ)) = 3 := sorry

/-- Last-chart ramification points have ramification index three. -/
theorem ramificationIndexAt_last (a : ℂ) (ha : a ^ 4 = -1) :
    xProjection.ramificationIndexAt
      ((lastRamificationPoint a ha).base (IsLocalRing.closedPoint ℂ)) = 3 := sorry

end AlgebraicGeometry.ProjectiveLineProduct
