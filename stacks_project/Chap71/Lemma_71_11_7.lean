module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.Graded.Commutative
public import stacks_project.Chap67.Definition_67_8_2_QuasiCompact
public import stacks_project.Chap71.Lemma_71_11_7_Finiteness

/-!
# Lemma 71.11.7

In Situation 71.11.1, if a quasi-coherent graded `𝒪_X`-algebra `𝒜` is of finite type over
`𝒜_0`, or is generated by a finite-type `𝒜_0`-module `𝒜_1`, or admits a finite-type
quasi-coherent `𝒜_0`-submodule of `𝒜₊` whose induced quotient ideal is locally nilpotent, then
a morphism `π` that is étale-locally the scheme relative `Proj` of a one-and-mul-preserving
`Type u` section model of `𝒜` is quasi-compact.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.AlgebraicSpace
open AlgebraicGeometry.AlgebraicSpace.RelativeProj
open SheafOfModules.RingedSite

universe u

namespace AlgebraicGeometry.AlgebraicSpace.RelativeProj

/-- Lemma 71.11.7: in Situation 71.11.1, if `𝒜` is of finite type as a sheaf of `𝒜_0`-algebras,
or is generated by `𝒜_1` as an `𝒜_0`-algebra with `𝒜_1` a finite type `𝒜_0`-module, or admits
a finite type quasi-coherent `𝒜_0`-submodule of `𝒜₊` whose induced quotient ideal is locally
nilpotent, then a morphism `π : P ⟶ X` that is étale-locally the scheme relative `Proj` of a
one-and-mul-preserving `Type u` section model of `𝒜`, via the canonical structure morphism
`etaleChartProj`, is quasi-compact. -/
@[stacks 084F]
theorem quasiCompact_of_finiteness
    {S : Scheme.{u}} {X : AlgebraicSpace S}
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X))
    [𝒜.IsCommutative] (hqc : 𝒜.IsQuasicoherent)
    {P : AlgebraicSpace S} (π : P ⟶ X)
    (hπ : IsEtaleLocallyProj 𝒜 π) :
    QuasiCompactFiniteness 𝒜 → QuasiCompact π := sorry

/-- Finite type of `𝒜` as an `𝒜_0`-algebra makes an étale-local scheme relative `Proj`
morphism quasi-compact. -/
theorem quasiCompact_of_finiteTypeAsDegreeZeroAlgebra
    {S : Scheme.{u}} {X : AlgebraicSpace S}
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X))
    [𝒜.IsCommutative] (hqc : 𝒜.IsQuasicoherent)
    {P : AlgebraicSpace S} (π : P ⟶ X)
    (hπ : IsEtaleLocallyProj 𝒜 π) :
    FiniteTypeAsDegreeZeroAlgebra 𝒜 → QuasiCompact π := sorry

/-- Generation of `𝒜` by a finite type `𝒜_0`-module `𝒜_1` makes an étale-local scheme relative
`Proj` morphism quasi-compact. -/
theorem quasiCompact_of_generatedByDegreeOneFinite
    {S : Scheme.{u}} {X : AlgebraicSpace S}
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X))
    [𝒜.IsCommutative] (hqc : 𝒜.IsQuasicoherent)
    {P : AlgebraicSpace S} (π : P ⟶ X)
    (hπ : IsEtaleLocallyProj 𝒜 π) :
    GeneratedByDegreeOneFinite 𝒜 → QuasiCompact π := sorry

/-- A finite type `𝒜_0`-submodule of `𝒜₊` with locally nilpotent quotient makes an étale-local
scheme relative `Proj` morphism quasi-compact. -/
theorem quasiCompact_of_finitePositiveSubmoduleLocallyNilpotentQuotient
    {S : Scheme.{u}} {X : AlgebraicSpace S}
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X))
    [𝒜.IsCommutative] (hqc : 𝒜.IsQuasicoherent)
    {P : AlgebraicSpace S} (π : P ⟶ X)
    (hπ : IsEtaleLocallyProj 𝒜 π) :
    FinitePositiveSubmoduleLocallyNilpotentQuotient 𝒜 → QuasiCompact π := sorry

/-- Every affine-étale base change of an étale-local scheme relative `Proj` morphism is
quasi-compact under any of the three finiteness alternatives. -/
theorem quasiCompact_etaleBaseChange
    {S : Scheme.{u}} {X : AlgebraicSpace S}
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X))
    [𝒜.IsCommutative] (hqc : 𝒜.IsQuasicoherent)
    {P : AlgebraicSpace S} (π : P ⟶ X)
    (hπ : IsEtaleLocallyProj 𝒜 π) (U : affineEtaleSite X) :
    QuasiCompactFiniteness 𝒜 → QuasiCompact (etaleBaseChangeSnd π U.obj) := sorry

end AlgebraicGeometry.AlgebraicSpace.RelativeProj
