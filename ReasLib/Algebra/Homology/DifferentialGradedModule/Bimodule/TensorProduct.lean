module

public import ReasLib.Algebra.Category.DifferentialGraded.Functor
public import ReasLib.Algebra.Homology.DifferentialGradedModule.Bimodule
public import ReasLib.Algebra.Homology.DifferentialGradedModule.TensorProduct

/-!
# Relative Tensor Products of Differential Graded Modules

This file extends the reusable right-left relative tensor complex by the right action inherited
from the second, bimodule factor.  The balancing quotient and its differential are owned by
`DifferentialGradedModule.TensorProduct`; the declarations here retain thin compatibility names
and add only the genuinely bimodule-specific structure.
-/

@[expose] public section

noncomputable section

universe u v w x y

open CategoryTheory
open CategoryTheory.MonoidalCategory
open ComplexShape
open DifferentialGradedCategory
open HomologicalComplex
open scoped DifferentialGradedCategory DifferentialGradedModule MonoidalCategory

namespace DifferentialGradedBimodule.Tensor

variable {R : Type u} [CommRing R]
variable {A : CochainDGAlgebra.{u, x} R} {B : CochainDGAlgebra.{u, y} R}

/-- The underlying complex of the left tensor factor. -/
abbrev leftComplex (M : DifferentialGradedModule.{u, v} A) :
    CochainComplex (ModuleCat.{v} R) ℤ :=
  DifferentialGradedModule.TensorProduct.rightComplex M

/-- The underlying right-`B` complex of the bimodule tensor factor. -/
abbrev rightComplex (N : DifferentialGradedBimodule.{u, w, x, y} A B) :
    CochainComplex (ModuleCat.{w} R) ℤ :=
  DifferentialGradedModule.TensorProduct.leftComplex N.toLeftModule

/-- The total tensor complex over the ground ring before imposing `A`-balancing. -/
@[stacks 09LG "unbalanced relative tensor complex"]
abbrev rawComplex (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B) :
    CochainComplex (ModuleCat.{max v w} R) ℤ :=
  DifferentialGradedModule.TensorProduct.rawComplex M N.toLeftModule

/-- The degree-`n` term of the unbalanced total tensor complex. -/
@[stacks 09LM "degreewise unbalanced relative tensor term"]
abbrev rawTerm (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B) (n : ℤ) :=
  DifferentialGradedModule.TensorProduct.rawTerm M N.toLeftModule n

/-- Reindex the second balancing summand to the same total degree as the first. -/
theorem balanceRightDegree (p i q n : ℤ) (h : (p + i) + q = n) :
    p + (i + q) = n := sorry

/-- A homogeneous generator of the balancing relations
`(m * a) tensor x = m tensor (a * x)`. -/
@[stacks 09LG "homogeneous relative tensor balancing generator"]
abbrev balanceGenerator (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B)
    (p i q n : ℤ) (h : (p + i) + q = n)
    (m : M.X p) (a : A.X i) (x : N.X q) : rawTerm M N n :=
  DifferentialGradedModule.TensorProduct.balanceGenerator M N.toLeftModule
    p i q n h m a x

/-- The submodule generated by all homogeneous `A`-balancing relations in total degree `n`. -/
@[stacks 09LM "balancing relations for the relative tensor product"]
abbrev relations (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B) (n : ℤ) :
    Submodule R (rawTerm M N n) :=
  DifferentialGradedModule.TensorProduct.relations M N.toLeftModule n

/-- Degree `n` of the relative tensor product, as the explicit quotient by balancing relations. -/
@[stacks 09LM "degreewise relative tensor quotient"]
abbrev family (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B) (n : ℤ) : ModuleCat.{max v w} R :=
  DifferentialGradedModule.TensorProduct.family M N.toLeftModule n

/-- The quotient map from the unbalanced total tensor term. -/
@[stacks 09LM "quotient map for the relative tensor product"]
abbrev mk (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B) (n : ℤ) :
    rawTerm M N n →ₗ[R] family M N n :=
  DifferentialGradedModule.TensorProduct.mk M N.toLeftModule n

/-- The class of a homogeneous pure tensor. -/
@[stacks 09LM "pure tensor class in the relative tensor product"]
abbrev tmul (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B) {p q : ℤ}
    (m : M.X p) (x : N.X q) : family M N (p + q) :=
  DifferentialGradedModule.TensorProduct.tmul M N.toLeftModule m x

/-- Pure tensor formation with a fixed left input, as a linear map. -/
abbrev tmulRight (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B) {p q : ℤ} (m : M.X p) :
    N.X q →ₗ[R] family M N (p + q) :=
  DifferentialGradedModule.TensorProduct.tmulRight M N.toLeftModule m

/-- Pure tensor formation with a fixed right input, as a linear map. -/
abbrev tmulLeft (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B) {p q : ℤ} (x : N.X q) :
    M.X p →ₗ[R] family M N (p + q) :=
  DifferentialGradedModule.TensorProduct.tmulLeft M N.toLeftModule x

/-- The raw total differential preserves the balancing relations. -/
theorem differential_relations (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B) (n : ℤ) :
    relations M N n ≤ Submodule.comap ((rawComplex M N).d n (n + 1)).hom
      (relations M N (n + 1)) := sorry

/-- The differential induced on the relative tensor quotient. -/
@[stacks 09LM "differential on the relative tensor quotient"]
abbrev differential (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B) (n : ℤ) :
    family M N n →ₗ[R] family M N (n + 1) :=
  DifferentialGradedModule.TensorProduct.differential M N.toLeftModule n

/-- The total degree after applying a homogeneous right-`B` action in the second factor. -/
theorem rightDegree (p q n i : ℤ) (h : p + q = n) :
    p + (q + i) = n + i := sorry

/-- Right multiplication by `b` on one homogeneous pure tensor in the raw total complex. -/
def rawRightPure (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B)
    (n i p q : ℤ) (h : p + q = n) (m : M.X p) (x : N.X q) (b : B.X i) :
    rawTerm M N (n + i) :=
  (ιMapBifunctor (leftComplex M) (rightComplex N)
    (DifferentialGradedModule.TensorProduct.baseBifunctor (R := R)) (up ℤ)
    p (q + i) (n + i) (rightDegree p q n i h)).hom
      (m ⊗ₜ[R] N.rightMul q i x b)

/-- Right multiplication on a fixed pure tensor, linear in the algebra input. -/
def rawRightLinear (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B)
    (n i p q : ℤ) (h : p + q = n) (m : M.X p) (x : N.X q) :
    B.X i →ₗ[R] rawTerm M N (n + i) where
  toFun := rawRightPure M N n i p q h m x
  map_add' := sorry
  map_smul' := sorry

/-- The raw right action by a fixed homogeneous algebra element on one `(p, q)` summand. -/
def rawRightComponent (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B)
    (n i p q : ℤ) (h : p + q = n) (b : B.X i) :
    DifferentialGradedModule.TensorProduct.baseTensor (R := R) (M.X p) (N.X q) ⟶
      rawTerm M N (n + i) :=
  ModuleCat.TensorProduct.liftOfBilinear R
    (fun m x ↦ rawRightPure M N n i p q h m x b) sorry sorry sorry sorry

/-- The endomorphism of a raw total tensor term induced by a fixed homogeneous element of `B`. -/
def rawRightDesc (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B) (n i : ℤ) (b : B.X i) :
    rawTerm M N n ⟶ rawTerm M N (n + i) :=
  mapBifunctorDesc (K₁ := leftComplex M) (K₂ := rightComplex N)
    (F := DifferentialGradedModule.TensorProduct.baseBifunctor (R := R)) (c := up ℤ)
    (fun p q h ↦ rawRightComponent M N n i p q h b)

/-- The right `B`-action on the unbalanced total tensor term. -/
@[stacks 09LG "raw right action on the relative tensor complex"]
def rawRightMul (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B) (n i : ℤ) :
    rawTerm M N n →ₗ[R] B.X i →ₗ[R] rawTerm M N (n + i) where
  toFun := fun z ↦
    { toFun := fun b ↦ (rawRightDesc M N n i b).hom z
      map_add' := sorry
      map_smul' := sorry }
  map_add' := sorry
  map_smul' := sorry

/-- The raw right action followed by the target quotient map. -/
@[stacks 09LG "raw right action into the relative tensor quotient"]
def rightToQuotient (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B) (n i : ℤ) :
    rawTerm M N n →ₗ[R] B.X i →ₗ[R] family M N (n + i) where
  toFun := fun z ↦
    { toFun := fun b ↦ mk M N (n + i) (rawRightMul M N n i z b)
      map_add' := sorry
      map_smul' := sorry }
  map_add' := sorry
  map_smul' := sorry

/-- The balancing relations are killed by the raw right action after quotienting the target. -/
theorem right_relations (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B) (n i : ℤ) :
    relations M N n ≤ LinearMap.ker (rightToQuotient M N n i) := sorry

/-- The right `B`-action descended to the relative tensor quotient. -/
@[stacks 09LM "right action on the relative tensor quotient"]
def rightMul (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B) (n i : ℤ) :
    family M N n →ₗ[R] B.X i →ₗ[R] family M N (n + i) :=
  (relations M N n).liftQ (rightToQuotient M N n i) (right_relations M N n i)

/-- The relative tensor product `M tensor_A N` as a right differential graded `B`-module. -/
@[stacks 09LM "relative tensor product by a differential graded bimodule"]
def obj (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B) :
    DifferentialGradedModule.{u, max v w} B where
  X := family M N
  d := differential M N
  smul := rightMul M N
  d_sq := sorry
  smul_one := sorry
  smul_mul := sorry
  comm_d := sorry

/-- Degree `n` of the relative tensor product is the explicit balancing quotient. -/
@[stacks 09LM "degreewise object formula for relative tensoring"]
theorem obj_X (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B) (n : ℤ) :
    (obj M N).X n = family M N n := sorry

/-- Pure tensors satisfy the defining homogeneous balancing relation. -/
@[stacks 09LM "balancing relation on pure tensors"]
theorem tmul_smul (M : DifferentialGradedModule.{u, v} A)
    (N : DifferentialGradedBimodule.{u, w, x, y} A B)
    (p i q : ℤ) (m : M.X p) (a : A.X i) (x : N.X q) :
    tmul M N (p := p + i) (q := q) (M.smul p i m a) x =
      cast (congrArg (fun n : ℤ ↦ (family M N n : Type (max v w))) (add_assoc p i q).symm)
        (tmul M N (p := p) (q := i + q) m (N.leftMul i q a x)) := sorry

/-- Applying a degree-`j` map in the first factor changes total degree by `j`. -/
theorem mapDegree (p q n j : ℤ) (h : p + q = n) :
    (p + j) + q = n + j := sorry

/-- Apply a homogeneous map to the first factor of one pure tensor. -/
abbrev rawMapPure (N : DifferentialGradedBimodule.{u, w, x, y} A B)
    {M M' : DifferentialGradedModule.{u, v} A} {j : ℤ}
    (g : DifferentialGradedModule.GradedHom A M M' j)
    (n p q : ℤ) (h : p + q = n) (m : M.X p) (x : N.X q) :
    rawTerm M' N (n + j) :=
  DifferentialGradedModule.TensorProduct.rawMapPure N.toLeftModule g n p q h m x

/-- The map on one homogeneous tensor summand induced by a map in the first factor. -/
abbrev rawMapComponent (N : DifferentialGradedBimodule.{u, w, x, y} A B)
    {M M' : DifferentialGradedModule.{u, v} A} {j : ℤ}
    (g : DifferentialGradedModule.GradedHom A M M' j)
    (n p q : ℤ) (h : p + q = n) :
    DifferentialGradedModule.TensorProduct.baseTensor (R := R) (M.X p) (N.X q) ⟶
      rawTerm M' N (n + j) :=
  DifferentialGradedModule.TensorProduct.rawMapComponent N.toLeftModule g n p q h

/-- The morphism on raw total tensor terms induced by a homogeneous first-factor map. -/
def rawMapDesc (N : DifferentialGradedBimodule.{u, w, x, y} A B)
    {M M' : DifferentialGradedModule.{u, v} A} {j : ℤ}
    (g : DifferentialGradedModule.GradedHom A M M' j) (n : ℤ) :
    rawTerm M N n ⟶ rawTerm M' N (n + j) :=
  ModuleCat.ofHom (DifferentialGradedModule.TensorProduct.rawMap N.toLeftModule g n)

/-- The homogeneous map on unbalanced total tensor terms. -/
abbrev rawMap (N : DifferentialGradedBimodule.{u, w, x, y} A B)
    {M M' : DifferentialGradedModule.{u, v} A} {j : ℤ}
    (g : DifferentialGradedModule.GradedHom A M M' j) (n : ℤ) :
    rawTerm M N n →ₗ[R] rawTerm M' N (n + j) :=
  DifferentialGradedModule.TensorProduct.rawMap N.toLeftModule g n

/-- A homogeneous first-factor map preserves the balancing relations. -/
theorem map_relations (N : DifferentialGradedBimodule.{u, w, x, y} A B)
    {M M' : DifferentialGradedModule.{u, v} A} {j : ℤ}
    (g : DifferentialGradedModule.GradedHom A M M' j) (n : ℤ) :
    relations M N n ≤ Submodule.comap (rawMap N g n) (relations M' N (n + j)) := sorry

/-- The homogeneous map descended to the relative tensor quotients. -/
abbrev mapLinear (N : DifferentialGradedBimodule.{u, w, x, y} A B)
    {M M' : DifferentialGradedModule.{u, v} A} {j : ℤ}
    (g : DifferentialGradedModule.GradedHom A M M' j) (n : ℤ) :
    family M N n →ₗ[R] family M' N (n + j) :=
  DifferentialGradedModule.TensorProduct.mapLinear N.toLeftModule g n

/-- Tensor a homogeneous right-`A`-linear map with the identity of the bimodule. -/
@[stacks 09LM "map induced by a homogeneous first-factor map"]
def map (N : DifferentialGradedBimodule.{u, w, x, y} A B)
    {M M' : DifferentialGradedModule.{u, v} A} {j : ℤ}
    (g : DifferentialGradedModule.GradedHom A M M' j) :
    DifferentialGradedModule.GradedHom B (obj M N) (obj M' N) j :=
  ⟨mapLinear N g, sorry⟩

/-- The induced map sends a pure tensor to the pure tensor of its first-factor image. -/
theorem map_tmul (N : DifferentialGradedBimodule.{u, w, x, y} A B)
    {M M' : DifferentialGradedModule.{u, v} A} {j p q : ℤ}
    (g : DifferentialGradedModule.GradedHom A M M' j) (m : M.X p) (x : N.X q) :
    map N g (p + q) (tmul M N (p := p) (q := q) m x) =
      cast (congrArg (fun n : ℤ ↦ (family M' N n : Type (max v w)))
        (mapDegree p q (p + q) j rfl))
        (tmul M' N (p := p + j) (q := q) (g p m) x) := sorry

/-- Tensoring with `N` sends closed homogeneous maps to closed homogeneous maps. -/
@[stacks 09LM "closed map induced by relative tensoring"]
def mapClosed (N : DifferentialGradedBimodule.{u, w, x, y} A B)
    {M M' : DifferentialGradedModule.{u, v} A} {j : ℤ}
    (g : DifferentialGradedModule.ClosedGradedHom A M M' j) :
    DifferentialGradedModule.ClosedGradedHom B (obj M N) (obj M' N) j :=
  ⟨map N g.1, sorry⟩

/-- Lemma 22.29.1 (09LM): tensoring with a fixed differential graded bimodule is a concrete
differential graded functor. -/
@[stacks 09LM "relative tensor product DG functor", stacks 09LQ]
def dgFunctor (N : DifferentialGradedBimodule.{u, w, x, y} A B) :
    DgFunctor R (DifferentialGradedModule.{u, v} A)
      (DifferentialGradedModule.{u, max v w} B) where
  obj := fun M ↦ obj M N
  map := map N
  map_add := sorry
  map_smul := sorry
  map_d := sorry
  map_id := sorry
  map_comp := sorry

/-- The fixed-right tensor DG functor uses the relative tensor product on objects. -/
@[stacks 09LM "object formula for the relative tensor DG functor"]
theorem dgFunctor_obj (N : DifferentialGradedBimodule.{u, w, x, y} A B)
    (M : DifferentialGradedModule.{u, v} A) :
    (dgFunctor N).obj M = obj M N := sorry

/-- The fixed-right tensor DG functor applies a homogeneous map in the first factor. -/
@[stacks 09LM "map formula for the relative tensor DG functor"]
theorem dgFunctor_map (N : DifferentialGradedBimodule.{u, w, x, y} A B)
    {M M' : DifferentialGradedModule.{u, v} A} {j : ℤ} (g : M ⟶[j] M') :
    (dgFunctor N).map g = map N g := sorry

end DifferentialGradedBimodule.Tensor
