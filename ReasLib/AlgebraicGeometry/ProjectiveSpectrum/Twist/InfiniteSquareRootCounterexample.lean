/-!
# An infinite square-root counterexample for twists on projective spectra

This file constructs a countably generated weighted polynomial algebra with
relations `u ^ (2 * (n + 1)) = z n ^ 2`.  Its projective spectrum has ample
canonical twists, while one affine chart is not of finite type over the base
field.
-/

@[expose] public section

open CategoryTheory MvPolynomial
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.Proj.InfiniteSquareRootCounterexample

/-- The variables `u`, `v`, and `z n` in the weighted polynomial presentation. -/
inductive Variable where
  | u
  | v
  | z : ℕ → Variable
  deriving DecidableEq

/-- The polynomial ring on `u`, `v`, and the countable family `z n`. -/
abbrev PolynomialRing (k : Type u) [CommRing k] :=
  MvPolynomial Variable k

/-- The distinguished polynomial generator `u`. -/
abbrev u (k : Type u) [CommRing k] : PolynomialRing k :=
  X Variable.u

/-- The distinguished polynomial generator `v`. -/
abbrev v (k : Type u) [CommRing k] : PolynomialRing k :=
  X Variable.v

/-- The polynomial generator `z n`, corresponding to the one-indexed generator `Z_(n+1)`. -/
abbrev z (k : Type u) [CommRing k] (n : ℕ) : PolynomialRing k :=
  X (Variable.z n)

/-- The weights of `u`, `v`, and `z n` are respectively `1`, `1`, and `n + 1`. -/
def weight : Variable → ℕ
  | .u => 1
  | .v => 1
  | .z n => n + 1

section Ring

variable (k : Type u) [CommRing k]

/-- The relation at index `n` is `u ^ (2 * (n + 1)) - z n ^ 2`. -/
def relation (n : ℕ) : PolynomialRing k :=
  u k ^ (2 * (n + 1)) - z k n ^ 2

/-- The ideal generated by all relations `u ^ (2 * (n + 1)) - z n ^ 2`. -/
def ideal : Ideal (PolynomialRing k) :=
  Ideal.span (Set.range (relation k))

/-- The quotient of the weighted polynomial ring by the infinite square-root relations. -/
abbrev Ring := PolynomialRing k ⧸ ideal k

/-- The canonical algebra homomorphism to the quotient ring. -/
def quotientMap : PolynomialRing k →ₐ[k] Ring k :=
  Ideal.Quotient.mkₐ k (ideal k)

/-- Every defining relation maps to zero in the quotient ring. -/
@[simp] theorem quotientMap_relation_eq_zero (n : ℕ) :
    quotientMap k (relation k n) = 0 := by
  exact Ideal.Quotient.eq_zero_iff_mem.2 <| Ideal.subset_span ⟨n, rfl⟩

/-- The quotient generators satisfy `u ^ (2 * (n + 1)) = z n ^ 2`. -/
theorem quotientMap_u_pow_eq_z_sq (n : ℕ) :
    quotientMap k (u k ^ (2 * (n + 1))) = quotientMap k (z k n ^ 2) := by
  have h := quotientMap_relation_eq_zero (k := k) n
  simpa [relation, map_sub] using sub_eq_zero.mp h

/-- The variables `t` and `z n` in the affine `v`-chart presentation. -/
inductive VChartVariable where
  | t
  | z : ℕ → VChartVariable
  deriving DecidableEq

/-- The polynomial ring on the affine-chart variables `t` and `z n`. -/
abbrev VChartPolynomialRing := MvPolynomial VChartVariable k

/-- The distinguished affine-chart variable `t`. -/
abbrev vChartT : VChartPolynomialRing k :=
  X VChartVariable.t

/-- The affine-chart variable `z n`, corresponding to the one-indexed variable `t_(n+1)`. -/
abbrev vChartZ (n : ℕ) : VChartPolynomialRing k :=
  X (VChartVariable.z n)

/-- The affine-chart relation at index `n` is `t ^ (2 * (n + 1)) - z n ^ 2`. -/
def vChartRelation (n : ℕ) : VChartPolynomialRing k :=
  vChartT k ^ (2 * (n + 1)) - vChartZ k n ^ 2

/-- The ideal generated by all affine-chart relations. -/
def vChartIdeal : Ideal (VChartPolynomialRing k) :=
  Ideal.span (Set.range (vChartRelation k))

/-- The explicit coordinate ring of the affine `v`-chart. -/
abbrev VChartRing := VChartPolynomialRing k ⧸ vChartIdeal k

/-- The canonical algebra homomorphism to the affine-chart quotient. -/
def vChartQuotientMap : VChartPolynomialRing k →ₐ[k] VChartRing k :=
  Ideal.Quotient.mkₐ k (vChartIdeal k)

/-- Every affine-chart relation maps to zero in its quotient ring. -/
@[simp] theorem vChartQuotientMap_relation_eq_zero (n : ℕ) :
    vChartQuotientMap k (vChartRelation k n) = 0 := by
  exact Ideal.Quotient.eq_zero_iff_mem.2 <| Ideal.subset_span ⟨n, rfl⟩

/-- The affine-chart generators satisfy `t ^ (2 * (n + 1)) = z n ^ 2`. -/
theorem vChartQuotientMap_t_pow_eq_z_sq (n : ℕ) :
    vChartQuotientMap k (vChartT k ^ (2 * (n + 1))) =
      vChartQuotientMap k (vChartZ k n ^ 2) := by
  have h := vChartQuotientMap_relation_eq_zero (k := k) n
  simpa [vChartRelation, map_sub] using sub_eq_zero.mp h

/-- The weighted homogeneous degree-`n` piece of the ambient polynomial ring, regarded as an
integral submodule. -/
abbrev polynomialGrading (n : ℕ) : Submodule ℤ (PolynomialRing k) :=
  (weightedHomogeneousSubmodule k weight n).restrictScalars ℤ

/-- The canonical graded-algebra structure on the weighted polynomial ring. -/
noncomputable instance instPolynomialGradedAlgebra :
    GradedAlgebra (polynomialGrading k) :=
  { (MvPolynomial.weightedGradedAlgebra k weight) with }

/-- Each defining relation is weighted homogeneous of degree `2 * (n + 1)`. -/
theorem relation_mem_polynomialGrading (n : ℕ) :
    relation k n ∈ polynomialGrading k (2 * (n + 1)) := by
  apply Submodule.sub_mem
  · simpa [polynomialGrading, u, weight] using
      (MvPolynomial.isWeightedHomogeneous_X k weight Variable.u).pow (2 * (n + 1))
  · simpa [polynomialGrading, z, weight] using
      (MvPolynomial.isWeightedHomogeneous_X k weight (Variable.z n)).pow 2

/-- The ideal generated by the infinite square-root relations is homogeneous. -/
theorem ideal_isHomogeneous :
    (ideal k).IsHomogeneous (polynomialGrading k) := by
  apply Ideal.homogeneous_span
  rintro _ ⟨n, rfl⟩
  exact ⟨2 * (n + 1), relation_mem_polynomialGrading k n⟩

/-- The quotient grading induced by the weighted polynomial grading. -/
noncomputable def grading (n : ℕ) : Submodule ℤ (Ring k) :=
  GradedAlgebra.Quotient.grading (polynomialGrading k) (ideal k) n

/-- The canonical internal graded-algebra structure on the integral-scalar grading. -/
noncomputable instance instGradedAlgebraGrading : GradedAlgebra (grading k) :=
  by
    change GradedAlgebra
      (GradedAlgebra.Quotient.grading (polynomialGrading k) (ideal k))
    exact GradedAlgebra.Quotient.gradedAlgebra
      (polynomialGrading k) (ideal k) (ideal_isHomogeneous k)

/-- The quotient grading through the additive-subgroup interface used by projective spectra. -/
noncomputable instance instAddSubgroupGradedRing :
    @GradedRing ℕ (Ring k) (Submodule ℤ (Ring k))
      inferInstance inferInstance inferInstance inferInstance
      (AddSubgroupClass.toAddSubmonoidClass) (grading k) :=
  { (instGradedAlgebraGrading k) with }

/-- The quotient class of the generator `u`. -/
def quotientU : Ring k := quotientMap k (u k)

/-- The quotient class of the generator `v`. -/
def quotientV : Ring k := quotientMap k (v k)

/-- The quotient class of the generator `z n`. -/
def quotientZ (n : ℕ) : Ring k := quotientMap k (z k n)

/-- The quotient class of `u` is homogeneous of degree one. -/
theorem quotientU_mem_grading : quotientU k ∈ grading k 1 := by
  change Ideal.Quotient.mk (ideal k) (u k) ∈
    GradedAlgebra.Quotient.grading (polynomialGrading k) (ideal k) 1
  exact GradedAlgebra.Quotient.mk_mem_grading
    (polynomialGrading k) (ideal k) (by
      rw [Submodule.restrictScalars_mem]
      simpa [weight] using
        (MvPolynomial.isWeightedHomogeneous_X k weight Variable.u))

/-- The quotient class of `v` is homogeneous of degree one. -/
theorem quotientV_mem_grading : quotientV k ∈ grading k 1 := by
  change Ideal.Quotient.mk (ideal k) (v k) ∈
    GradedAlgebra.Quotient.grading (polynomialGrading k) (ideal k) 1
  exact GradedAlgebra.Quotient.mk_mem_grading
    (polynomialGrading k) (ideal k) (by
      rw [Submodule.restrictScalars_mem]
      simpa [weight] using
        (MvPolynomial.isWeightedHomogeneous_X k weight Variable.v))

/-- The quotient class of `z n` is homogeneous of degree `n + 1`. -/
theorem quotientZ_mem_grading (n : ℕ) : quotientZ k n ∈ grading k (n + 1) := by
  change Ideal.Quotient.mk (ideal k) (z k n) ∈
    GradedAlgebra.Quotient.grading (polynomialGrading k) (ideal k) (n + 1)
  exact GradedAlgebra.Quotient.mk_mem_grading
    (polynomialGrading k) (ideal k) (by
      rw [Submodule.restrictScalars_mem]
      simpa [weight] using
        (MvPolynomial.isWeightedHomogeneous_X k weight (Variable.z n)))

/-- The projective spectrum of the explicitly graded quotient ring. -/
abbrev ProjectiveScheme := Proj (grading k)

/-- The projective basic opens defined by `u` and `v` cover the projective spectrum. -/
theorem basicOpen_u_sup_basicOpen_v_eq_top :
    Proj.basicOpen (grading k) (quotientU k) ⊔
      Proj.basicOpen (grading k) (quotientV k) = ⊤ := by
  apply top_unique
  intro p _
  change quotientU k ∉ p.asHomogeneousIdeal.toIdeal ∨
    quotientV k ∉ p.asHomogeneousIdeal.toIdeal
  by_contra h
  push Not at h
  have hz (n : ℕ) : quotientZ k n ∈ p.asHomogeneousIdeal.toIdeal := by
    apply p.isPrime.mem_of_pow_mem 2
    have heq : quotientU k ^ (2 * (n + 1)) = quotientZ k n ^ 2 := by
      simpa [quotientU, quotientZ, map_pow] using quotientMap_u_pow_eq_z_sq k n
    rw [← heq]
    exact p.asHomogeneousIdeal.toIdeal.pow_mem_of_mem h.1 _ (by omega)
  let q : PolynomialRing k →+* Ring k ⧸ p.asHomogeneousIdeal.toIdeal :=
    (Ideal.Quotient.mk p.asHomogeneousIdeal.toIdeal).comp (quotientMap k).toRingHom
  have hqX (i : Variable) : q (X i) = 0 := by
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    cases i with
    | u => exact h.1
    | v => exact h.2
    | z n => exact hz n
  have hq : q = (q.comp C).comp constantCoeff := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp
    · intro i
      simp [hqX]
  apply p.not_irrelevant_le
  rw [HomogeneousIdeal.irrelevant_le]
  intro n hn a ha
  obtain ⟨b, hb, rfl⟩ := ha
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change q b = 0
  rw [hq]
  have hc : constantCoeff b = 0 := by
    apply MvPolynomial.IsWeightedHomogeneous.coeff_eq_zero hb 0
    simpa using (Nat.ne_of_gt hn).symm
  simp [hc]

/-- The degree-one open of the projective spectrum is the whole scheme. -/
theorem degreeOpen_one_eq_top : Proj.degreeOpen (grading k) 1 = ⊤ := by
  apply top_unique
  rw [← basicOpen_u_sup_basicOpen_v_eq_top k]
  apply sup_le
  · exact le_iSup_of_le (quotientU k)
      (le_iSup_of_le (quotientU_mem_grading k) le_rfl)
  · exact le_iSup_of_le (quotientV k)
      (le_iSup_of_le (quotientV_mem_grading k) le_rfl)

/-- The degree-zero subring of the graded quotient. -/
abbrev DegreeZeroRing := grading k 0

/-- The scalar map from `k` to the degree-zero subring. -/
def degreeZeroAlgebraMap : k →+* DegreeZeroRing k where
  toFun r :=
    ⟨algebraMap k (Ring k) r, by
      change Ideal.Quotient.mk (ideal k) (C r) ∈ grading k 0
      exact GradedAlgebra.Quotient.mk_mem_grading
        (polynomialGrading k) (ideal k) (by
          rw [Submodule.restrictScalars_mem]
          exact MvPolynomial.isWeightedHomogeneous_C weight r)⟩
  map_one' := Subtype.ext (map_one (algebraMap k (Ring k)))
  map_mul' x y := Subtype.ext (map_mul (algebraMap k (Ring k)) x y)
  map_zero' := Subtype.ext (map_zero (algebraMap k (Ring k)))
  map_add' x y := Subtype.ext (map_add (algebraMap k (Ring k)) x y)

/-- The scalar map identifies `k` bijectively with the degree-zero subring. -/
theorem degreeZeroAlgebraMap_bijective :
    Function.Bijective (degreeZeroAlgebraMap k) := by
  have hI : ideal k ≤ RingHom.ker (constantCoeff : PolynomialRing k →+* k) := by
    rw [ideal, Ideal.span_le]
    rintro _ ⟨n, rfl⟩
    apply RingHom.mem_ker.mpr
    simp [relation, show 2 * (n + 1) ≠ 0 by omega]
  let augmentation : Ring k →+* k :=
    Ideal.Quotient.lift (ideal k) constantCoeff (fun _ ha ↦ hI ha)
  constructor
  · intro x y hxy
    have h := congrArg (fun a : DegreeZeroRing k ↦ augmentation a.1) hxy
    change augmentation (Ideal.Quotient.mk (ideal k) (C x)) =
      augmentation (Ideal.Quotient.mk (ideal k) (C y)) at h
    simpa [augmentation] using h
  · intro x
    obtain ⟨⟨p, hp⟩, hx⟩ := GradedAlgebra.Quotient.exists_rep_of_mem_grading
      (polynomialGrading k) (ideal k) x
    have hpC : p = C (constantCoeff p) := by
      apply MvPolynomial.ext
      intro d
      by_cases hd : d = 0
      · subst d
        simpa using (congrFun MvPolynomial.constantCoeff_eq p).symm
      · have hw : Finsupp.weight weight d ≠ 0 := by
          intro hw
          apply hd
          ext i
          by_contra hi
          have hle := Finsupp.le_weight_of_ne_zero' weight hi
          have hpos : 0 < weight i := by cases i <;> simp [weight]
          omega
        have hc := MvPolynomial.IsWeightedHomogeneous.coeff_eq_zero hp d hw
        simp [hc, coeff_C, Ne.symm hd]
    refine ⟨constantCoeff p, Subtype.ext ?_⟩
    change Ideal.Quotient.mk (ideal k) (C (constantCoeff p)) = x.1
    rw [← hpC]
    exact hx

/-- The structure morphism from the projective spectrum to `Spec(k)`. -/
noncomputable def toSpec : ProjectiveScheme k ⟶ Spec (.of k) :=
  Proj.toSpecZero (grading k) ≫
    Spec.map (CommRingCat.ofHom (degreeZeroAlgebraMap k))

/-- The degree-zero homogeneous localization defining the projective `v`-chart. -/
abbrev VChartAwayRing :=
  HomogeneousLocalization.Away (grading k) (quotientV k)

/-- The scalar map from `k` to the homogeneous localization at `v`. -/
def vChartAwayScalarMap : k →+* VChartAwayRing k :=
  (HomogeneousLocalization.fromZeroRingHom
      (grading k) (Submonoid.powers (quotientV k))).comp
    (degreeZeroAlgebraMap k)

/-- The canonical `k`-algebra structure on the homogeneous localization at `v`. -/
instance instAlgebraVChartAwayRing : Algebra k (VChartAwayRing k) :=
  (vChartAwayScalarMap k).toAlgebra

/-- The fraction `u / v` in the homogeneous localization at `v`. -/
def vChartAwayT : VChartAwayRing k :=
  HomogeneousLocalization.Away.mk (grading k) (quotientV_mem_grading k) 1
    (quotientU k) (by simpa using quotientU_mem_grading k)

/-- The fraction `z n / v ^ (n + 1)` in the homogeneous localization at `v`. -/
def vChartAwayZ (n : ℕ) : VChartAwayRing k :=
  HomogeneousLocalization.Away.mk (grading k) (quotientV_mem_grading k) (n + 1)
    (quotientZ k n) (by simpa using quotientZ_mem_grading k n)

/-- The affine-chart variables evaluated as homogeneous fractions at `v`. -/
def vChartAwayGenerator : VChartVariable → VChartAwayRing k
  | .t => vChartAwayT k
  | .z n => vChartAwayZ k n

/-- The polynomial evaluation homomorphism into the homogeneous localization at `v`. -/
noncomputable def vChartPolynomialMap :
    VChartPolynomialRing k →ₐ[k] VChartAwayRing k :=
  MvPolynomial.aeval (vChartAwayGenerator k)

/-- Each affine-chart relation vanishes under homogeneous localization at `v`. -/
private theorem vChartPolynomialMap_relation_eq_zero (n : ℕ) :
    vChartPolynomialMap k (vChartRelation k n) = 0 := by
  apply HomogeneousLocalization.val_injective
  simp only [vChartRelation, map_sub, map_pow, vChartPolynomialMap,
    MvPolynomial.aeval_X, vChartAwayGenerator, vChartAwayT, vChartAwayZ,
    HomogeneousLocalization.val_sub, HomogeneousLocalization.val_pow,
    HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_zero]
  rw [Localization.mk_pow, Localization.mk_pow]
  rw [sub_eq_zero, Localization.mk_eq_mk_iff]
  apply Localization.r_of_eq
  simpa [quotientU, quotientZ, map_pow, mul_comm, mul_left_comm, mul_assoc, pow_mul] using
    congrArg (fun x ↦ quotientV k ^ (2 * (n + 1)) * x)
      (quotientMap_u_pow_eq_z_sq (k := k) n)

/-- The explicit algebra homomorphism from the affine presentation to the homogeneous
localization at `v`. -/
noncomputable def vChartAwayMap : VChartRing k →ₐ[k] VChartAwayRing k :=
  Ideal.Quotient.liftₐ (vChartIdeal k) (vChartPolynomialMap k) (by
    intro a ha
    apply RingHom.mem_ker.1
    rw [vChartIdeal] at ha
    exact (Ideal.span_le.2 (fun x hx ↦ by
      obtain ⟨n, rfl⟩ := hx
      exact RingHom.mem_ker.2
        (vChartPolynomialMap_relation_eq_zero k n))) ha)

/-- Dehomogenizing at `v` gives an explicit algebra homomorphism from the homogeneous
localization to the affine-chart presentation. -/
noncomputable def vChartAwayInverseMap :
    VChartAwayRing k →ₐ[k] VChartRing k :=
  let generator : Variable → VChartRing k
    | .u => vChartQuotientMap k (vChartT k)
    | .v => 1
    | .z n => vChartQuotientMap k (vChartZ k n)
  let polynomialMap : PolynomialRing k →ₐ[k] VChartRing k :=
    MvPolynomial.aeval generator
  have hrelation (n : ℕ) : polynomialMap (relation k n) = 0 := by
    rw [relation, map_sub, sub_eq_zero]
    simpa only [map_pow, polynomialMap, MvPolynomial.aeval_X, generator] using
      vChartQuotientMap_t_pow_eq_z_sq (k := k) n
  let dehomogenization : Ring k →ₐ[k] VChartRing k :=
    Ideal.Quotient.liftₐ (ideal k) polynomialMap (by
      intro a ha
      apply RingHom.mem_ker.1
      rw [ideal] at ha
      exact (Ideal.span_le.2 (fun x hx ↦ by
        obtain ⟨n, rfl⟩ := hx
        exact RingHom.mem_ker.2 (hrelation n))) ha)
  have hV : dehomogenization (quotientV k) = 1 := by
    change polynomialMap (v k) = 1
    simp [polynomialMap, generator]
  let localizationInverseMap :
      Localization.Away (quotientV k) →ₐ[k] VChartRing k :=
    IsLocalization.Away.liftAlgHom (quotientV k) (f := dehomogenization) (by
      rw [hV]
      exact isUnit_one)
  { __ := localizationInverseMap.toRingHom.comp
      (algebraMap (VChartAwayRing k) (Localization.Away (quotientV k)))
    commutes' := by
      intro r
      change localizationInverseMap ((vChartAwayScalarMap k r).val) =
        algebraMap k (VChartRing k) r
      have hval :
          (vChartAwayScalarMap k r).val =
            algebraMap (Ring k) (Localization.Away (quotientV k))
              (algebraMap k (Ring k) r) := by
        change Localization.mk (algebraMap k (Ring k) r) _ = _
        rw [← Localization.mk_one_eq_algebraMap, Localization.mk_eq_mk_iff]
        exact Localization.r_of_eq (by simp)
      rw [hval]
      simp [localizationInverseMap] }

/-- Homogeneous polynomials recover their degree after multiplying back the denominator. -/
private theorem map_weightedHomogeneous_mul_pow {S : Type*} [CommRing S]
    (α β : PolynomialRing k →+* S) (b : S)
    (hC : ∀ r, α (C r) = β (C r))
    (hX : ∀ i, α (X i) = β (X i) * b ^ weight i)
    {p : PolynomialRing k} {n : ℕ} (hp : p.IsWeightedHomogeneous weight n) :
    α p = β p * b ^ n := by
  induction hp using MvPolynomial.IsWeightedHomogeneous.induction_on with
  | zero => simp
  | add p q hp hq ihp ihq => simp [ihp, ihq, add_mul]
  | monomial d r hd =>
    simp only [MvPolynomial.monomial_eq, Finsupp.prod, map_mul, map_prod,
      map_pow, hX, hC, mul_pow, Finset.prod_mul_distrib, ← pow_mul, mul_assoc]
    rw [Finset.prod_pow_eq_pow_sum]
    simp [← hd, Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, mul_comm]

/-- The explicit homogenization and dehomogenization maps for the affine `v`-chart are
mutually inverse. -/
theorem vChartAwayMaps_inverse :
    Function.LeftInverse (vChartAwayInverseMap k) (vChartAwayMap k) ∧
      Function.LeftInverse (vChartAwayMap k) (vChartAwayInverseMap k) := by
  have hleft : (vChartAwayInverseMap k).comp (vChartAwayMap k) =
      AlgHom.id k (VChartRing k) := by
    apply Ideal.Quotient.algHom_ext
    ext i
    simp only [AlgHom.comp_apply, AlgHom.id_apply, vChartAwayMap,
      Ideal.Quotient.liftₐ_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.lift_mk, AlgHom.coe_toRingHom,
      vChartPolynomialMap, MvPolynomial.aeval_X]
    cases i with
    | t =>
      change vChartAwayInverseMap k (vChartAwayT k) = vChartQuotientMap k (vChartT k)
      dsimp only [vChartAwayInverseMap, IsLocalization.Away.liftAlgHom]
      change IsLocalization.lift _ (vChartAwayT k).val = _
      rw [vChartAwayT, HomogeneousLocalization.Away.val_mk,
        Localization.mk_eq_mk', IsLocalization.lift_mk'_spec]
      simp [quotientU, quotientV, quotientMap, u, v]
    | z n =>
      change vChartAwayInverseMap k (vChartAwayZ k n) = vChartQuotientMap k (vChartZ k n)
      dsimp only [vChartAwayInverseMap, IsLocalization.Away.liftAlgHom]
      change IsLocalization.lift _ (vChartAwayZ k n).val = _
      rw [vChartAwayZ, HomogeneousLocalization.Away.val_mk,
        Localization.mk_eq_mk', IsLocalization.lift_mk'_spec]
      simp [quotientZ, quotientV, quotientMap, z, v]
  have hsurj : Function.Surjective (vChartAwayMap k) := by
    let S := Localization.Away (quotientV k)
    let D : PolynomialRing k →ₐ[k] VChartRing k := MvPolynomial.aeval (fun i ↦
      match i with
      | .u => vChartQuotientMap k (vChartT k)
      | .v => 1
      | .z n => vChartQuotientMap k (vChartZ k n))
    let α : PolynomialRing k →+* S :=
      (algebraMap (Ring k) S).comp (quotientMap k).toRingHom
    let β : PolynomialRing k →+* S :=
      (algebraMap (VChartAwayRing k) S).comp ((vChartAwayMap k).comp D).toRingHom
    let b : S := algebraMap (Ring k) S (quotientV k)
    have hmk (n : ℕ) (a : Ring k) (ha : a ∈ grading k (n • 1)) :
        (HomogeneousLocalization.Away.mk (grading k) (quotientV_mem_grading k) n a ha).val *
          b ^ n = algebraMap (Ring k) S a := by
      change Localization.mk a ⟨quotientV k ^ n, _⟩ * b ^ n = _
      rw [Localization.mk_eq_mk']
      change IsLocalization.mk' S a ⟨quotientV k ^ n, _⟩ *
        (algebraMap (Ring k) S (quotientV k)) ^ n = _
      rw [← map_pow]
      exact IsLocalization.mk'_spec S a ⟨quotientV k ^ n, _⟩
    have hC (r : k) : α (C r) = β (C r) := by
      simp only [α, β, RingHom.comp_apply, AlgHom.toRingHom_eq_coe,
        AlgHom.coe_toRingHom, AlgHom.comp_apply]
      change algebraMap (Ring k) S (quotientMap k (algebraMap k (PolynomialRing k) r)) =
        algebraMap (VChartAwayRing k) S
          (vChartAwayMap k (D (algebraMap k (PolynomialRing k) r)))
      rw [D.commutes, (vChartAwayMap k).commutes, (quotientMap k).commutes]
      change algebraMap (Ring k) S (algebraMap k (Ring k) r) =
        (vChartAwayScalarMap k r).val
      change _ = Localization.mk (algebraMap k (Ring k) r) _
      rw [← Localization.mk_one_eq_algebraMap, Localization.mk_eq_mk_iff]
      exact Localization.r_of_eq (by simp)
    have hβu : β (u k) = (vChartAwayT k).val := by
      simp [S, β, D, u, vChartAwayMap, vChartQuotientMap, vChartPolynomialMap,
        vChartT, vChartAwayGenerator, HomogeneousLocalization.algebraMap_apply]
    have hβv : β (v k) = 1 := by simp [β, D, v]
    have hβz (n : ℕ) : β (z k n) = (vChartAwayZ k n).val := by
      simp [S, β, D, z, vChartAwayMap, vChartQuotientMap, vChartPolynomialMap,
        vChartZ, vChartAwayGenerator, HomogeneousLocalization.algebraMap_apply]
    have hX (i : Variable) : α (X i) = β (X i) * b ^ weight i := by
      cases i with
      | u =>
        change algebraMap (Ring k) S (quotientU k) = β (u k) * b ^ 1
        rw [hβu]
        exact (hmk 1 (quotientU k) (by simpa using quotientU_mem_grading k)).symm
      | v =>
        change b = β (v k) * b ^ 1
        simp [hβv]
      | z n =>
        change algebraMap (Ring k) S (quotientZ k n) = β (z k n) * b ^ (n + 1)
        rw [hβz]
        exact (hmk (n + 1) (quotientZ k n) (by simpa using quotientZ_mem_grading k n)).symm
    intro x
    obtain ⟨n, a, ha, rfl⟩ :=
      HomogeneousLocalization.Away.mk_surjective (grading k) (quotientV_mem_grading k) x
    obtain ⟨⟨p, hp⟩, hpa⟩ := GradedAlgebra.Quotient.exists_rep_of_mem_grading
      (polynomialGrading k) (ideal k) ⟨a, ha⟩
    refine ⟨D p, ?_⟩
    apply HomogeneousLocalization.val_injective
    change β p = Localization.mk a ⟨quotientV k ^ n, _⟩
    rw [Localization.mk_eq_mk', IsLocalization.eq_mk'_iff_mul_eq]
    change β p * algebraMap (Ring k) S (quotientV k ^ n) = algebraMap (Ring k) S a
    have hh := map_weightedHomogeneous_mul_pow k α β b hC hX hp
    have hpmap : α p = algebraMap (Ring k) S a := congrArg (algebraMap (Ring k) S) hpa
    simpa [hpmap, b, map_pow] using hh.symm
  have hleft' : Function.LeftInverse (vChartAwayInverseMap k) (vChartAwayMap k) :=
    AlgHom.congr_fun hleft
  refine ⟨hleft', ?_⟩
  intro x
  obtain ⟨y, rfl⟩ := hsurj x
  rw [hleft']

/-- The explicit affine-presentation map to the homogeneous localization is bijective. -/
theorem vChartAwayMap_bijective : Function.Bijective (vChartAwayMap k) :=
  ⟨(vChartAwayMaps_inverse k).1.injective,
    (vChartAwayMaps_inverse k).2.surjective⟩

/-- The homogeneous localization at `v` is equivalent over `k` to the explicit affine-chart
ring. -/
noncomputable def vChartAwayAlgEquiv : VChartAwayRing k ≃ₐ[k] VChartRing k where
  toFun := vChartAwayInverseMap k
  invFun := vChartAwayMap k
  left_inv := (vChartAwayMaps_inverse k).2
  right_inv := (vChartAwayMaps_inverse k).1
  map_mul' := map_mul (vChartAwayInverseMap k)
  map_add' := map_add (vChartAwayInverseMap k)
  commutes' := (vChartAwayInverseMap k).commutes

/-- The projective basic open defined by `v` is the spectrum of the explicit affine-chart ring. -/
noncomputable def vChartIsoSpec :
    (Proj.basicOpen (grading k) (quotientV k)).toScheme ≅
      Spec (.of (VChartRing k)) :=
  Proj.basicOpenIsoSpec (grading k) (quotientV k)
      (quotientV_mem_grading k) (by omega) ≪≫
    (Scheme.Spec.mapIso (vChartAwayAlgEquiv k).toRingEquiv.toCommRingCatIso.op).symm

/-- The affine `v`-chart identification intertwines its `k`-structure morphism with the
restriction of the projective structure morphism. -/
theorem vChartIsoSpec_hom_toSpec :
    (vChartIsoSpec k).hom ≫
        Spec.map (CommRingCat.ofHom (algebraMap k (VChartRing k))) =
      (Proj.basicOpen (grading k) (quotientV k)).ι ≫ toSpec k := by
  let e := Proj.basicOpenIsoSpec (grading k) (quotientV k)
    (quotientV_mem_grading k) (by omega)
  have hscalar :
      Spec.map (CommRingCat.ofHom (vChartAwayScalarMap k)) =
        e.inv ≫ (Proj.basicOpen (grading k) (quotientV k)).ι ≫ toSpec k := by
    change Spec.map (CommRingCat.ofHom (vChartAwayScalarMap k)) =
      Proj.awayι (grading k) (quotientV k) (quotientV_mem_grading k) (by omega) ≫
        Proj.toSpecZero (grading k) ≫ Spec.map (CommRingCat.ofHom (degreeZeroAlgebraMap k))
    rw [Proj.awayι_toSpecZero_assoc, ← Spec.map_comp]
    rfl
  have hcomp :
      CommRingCat.ofHom (algebraMap k (VChartRing k)) ≫
        CommRingCat.ofHom (vChartAwayMap k).toRingHom =
      CommRingCat.ofHom (vChartAwayScalarMap k) := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro r
    exact (vChartAwayMap k).commutes r
  change e.hom ≫
    Spec.map (CommRingCat.ofHom (vChartAwayMap k).toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap k (VChartRing k))) = _
  rw [← Spec.map_comp, hcomp, hscalar]
  simp

end Ring

section Field

variable (k : Type u) [Field k]

/-- The explicit affine `v`-chart ring is not a finite-type algebra over the base field. -/
theorem vChartRing_not_finiteType :
    ¬ Algebra.FiniteType k (VChartRing k) := by
  classical
  intro h
  obtain ⟨s, hs⟩ := h.out
  obtain ⟨t, _, ht, hts⟩ := s.finite_toSet.exists_subset_finite_image_eq
    (f := vChartQuotientMap k) (s := Set.univ) (by
      intro x _
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
      exact ⟨p, Set.mem_univ _, rfl⟩)
  have hvars : (⋃ p ∈ t, (p.vars : Set VChartVariable)).Finite :=
    ht.biUnion (fun p _ ↦ p.vars.finite_toSet)
  have hzinj : Function.Injective VChartVariable.z := by
    intro a b hab
    cases hab
    rfl
  obtain ⟨n, hn⟩ := (hvars.preimage hzinj.injOn).exists_notMem
  let g : VChartVariable → DualNumber k :=
    fun i ↦ if i = VChartVariable.z n then DualNumber.eps else 0
  have hg (j : ℕ) : MvPolynomial.aeval g (vChartRelation k j) = 0 := by
    simp only [vChartRelation, vChartT, vChartZ, map_sub, map_pow,
      MvPolynomial.aeval_X]
    simp [g, show 2 * (j + 1) ≠ 0 by omega]
  have hzero (j : ℕ) :
      MvPolynomial.aeval (fun _ : VChartVariable ↦ (0 : DualNumber k))
        (vChartRelation k j) = 0 := by
    simp [vChartRelation, vChartT, vChartZ, show 2 * (j + 1) ≠ 0 by omega]
  let φ : VChartRing k →ₐ[k] DualNumber k :=
    Ideal.Quotient.liftₐ (vChartIdeal k) (MvPolynomial.aeval g) (by
      intro a ha
      exact (Ideal.span_le.mpr (by
        rintro _ ⟨j, rfl⟩
        exact RingHom.mem_ker.mpr (hg j)) ha))
  let ψ : VChartRing k →ₐ[k] DualNumber k :=
    Ideal.Quotient.liftₐ (vChartIdeal k)
      (MvPolynomial.aeval (fun _ : VChartVariable ↦ (0 : DualNumber k))) (by
        intro a ha
        exact (Ideal.span_le.mpr (by
          rintro _ ⟨j, rfl⟩
          exact RingHom.mem_ker.mpr (hzero j)) ha))
  have heq : φ = ψ := by
    apply AlgHom.ext_of_adjoin_eq_top hs
    intro x hx
    rw [← hts] at hx
    obtain ⟨p, hp, rfl⟩ := hx
    change MvPolynomial.aeval g p =
      MvPolynomial.aeval (fun _ : VChartVariable ↦ (0 : DualNumber k)) p
    rw [MvPolynomial.aeval_zero']
    apply MvPolynomial.aeval_eq_constantCoeff_of_vars
    intro i hi
    have hine : i ≠ VChartVariable.z n := by
      intro he
      apply hn
      change VChartVariable.z n ∈ ⋃ p ∈ t, (p.vars : Set VChartVariable)
      exact Set.mem_iUnion.mpr ⟨p, Set.mem_iUnion.mpr ⟨hp, he ▸ hi⟩⟩
    simp [g, hine]
  have heps : (DualNumber.eps : DualNumber k) = 0 := by
    have he := AlgHom.congr_fun heq (vChartQuotientMap k (vChartZ k n))
    simpa [φ, ψ, vChartQuotientMap, vChartZ, g] using he
  have he := congrArg TrivSqZeroExt.snd heps
  simpa using he

/-- The structure morphism of the projective spectrum is quasi-compact. -/
instance instQuasiCompactToSpec : QuasiCompact (toSpec k) := by
  have hu := (Proj.isAffineOpen_basicOpen (grading k) (quotientU k)
    (quotientU_mem_grading k) (by omega)).isCompact
  have hv := (Proj.isAffineOpen_basicOpen (grading k) (quotientV k)
    (quotientV_mem_grading k) (by omega)).isCompact
  letI : CompactSpace (ProjectiveScheme k) := ⟨by
    change IsCompact ((⊤ : (ProjectiveScheme k).Opens) : Set (ProjectiveScheme k))
    rw [← basicOpen_u_sup_basicOpen_v_eq_top k]
    exact hu.union hv⟩
  infer_instance

/-- Every integral canonical twist is invertible. -/
noncomputable instance instInvertibleTwist (n : ℤ) :
    Scheme.Modules.Invertible
      (Proj.AssociatedModule.twistingSheaf (grading k) n) :=
  projTwist_invertible_of_degreeOpen_one_eq_top
    (grading k) (degreeOpen_one_eq_top k) n

/-- The canonical twist of integral degree `n` is isomorphic to the `n`th integral tensor
power of the degree-one twist. -/
theorem twistOneInvertiblePower_isomorphic (n : ℤ) :
    Nonempty
      (Proj.AssociatedModule.twistingSheaf (grading k) n ≅
        RingedSpace.InvertiblePower.sheaf
          (Proj.AssociatedModule.twistingSheaf (grading k) 1) n) := sorry

/-- The canonical twist of natural degree `n` is isomorphic to the `n`th tensor power of the
degree-one twist. -/
theorem twistOneTensorPower_isomorphic (n : ℕ) :
    Nonempty
      (Proj.AssociatedModule.twistingSheaf (grading k) (n : ℤ) ≅
        RingedSpace.TensorPower.sheaf
          (Proj.AssociatedModule.twistingSheaf (grading k) 1) n) := by
  obtain ⟨e⟩ := twistOneInvertiblePower_isomorphic k (n : ℤ)
  exact ⟨e ≪≫ (@RingedSpace.InvertiblePower.natIso _
    (Proj.AssociatedModule.twistingSheaf (grading k) 1)
    (Scheme.Modules.Invertible.ringedSpaceIsInvertible (instInvertibleTwist k 1)) n).symm⟩

/-- The canonical map from the degree-`n` quotient piece to global sections of the degree-`n`
twist is bijective. -/
theorem twistSection_bijective (n : ℕ) :
    Function.Bijective
      (fun x : grading k n ↦ Proj.AssociatedModule.twistSection (grading k) x) := sorry

/-- The canonical degree-one twist is ample on the projective spectrum. -/
instance instIsAmpleTwistOne :
    Scheme.Modules.IsAmple
      (Proj.AssociatedModule.twistingSheaf (grading k) 1) := sorry

/-- The canonical degree-one twist is relatively ample over `Spec(k)`. -/
instance instRelativelyAmpleTwistOne :
    RelativelyAmple (toSpec k)
      (Proj.AssociatedModule.twistingSheaf (grading k) 1) :=
  @instRelativelyAmpleOfIsAmpleOfIsAffine (ProjectiveScheme k) (Spec (.of k))
    (toSpec k) (Proj.AssociatedModule.twistingSheaf (grading k) 1)
    inferInstance (instInvertibleTwist k 1) (instIsAmpleTwistOne k)

/-- The structure morphism is not of finite type, as witnessed by its affine `v`-chart. -/
theorem toSpec_not_finiteType : ¬ Scheme.Hom.FiniteType (toSpec k) := by
  intro h
  letI := h
  have hchart : LocallyOfFiniteType
      (Spec.map (CommRingCat.ofHom (algebraMap k (VChartRing k)))) := by
    have hc : LocallyOfFiniteType
        ((vChartIsoSpec k).inv ≫
          (Proj.basicOpen (grading k) (quotientV k)).ι ≫ toSpec k) := by
      infer_instance
    rw [← vChartIsoSpec_hom_toSpec, Iso.inv_hom_id_assoc] at hc
    exact hc
  apply vChartRing_not_finiteType k
  exact RingHom.finiteType_algebraMap.mp
    ((HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp hchart)

/-- No natural tensor power of the degree-one twist is relatively very ample over the base. -/
theorem no_tensorPower_relativelyVeryAmple (n : ℕ) :
    ¬ RelativelyVeryAmple (toSpec k)
      (RingedSpace.TensorPower.sheaf
        (Proj.AssociatedModule.twistingSheaf (grading k) 1) n) := sorry

end Field

end AlgebraicGeometry.Proj.InfiniteSquareRootCounterexample
