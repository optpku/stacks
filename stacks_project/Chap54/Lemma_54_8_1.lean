module

public import ReasLib.AlgebraicGeometry.Scheme.Morphism.Modification.Cohomology
import StacksCheckRecall

@[expose] public section

open AlgebraicGeometry CategoryTheory

universe u

/- Lemma 54.8.1 (1): the first structure-sheaf cohomology groups fit into the
short exact sequence given by the first higher direct image. -/
@[stacks 0AXF]
#check (AlgebraicGeometry.IsModification.structureSheafH1_shortExact :
  ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [_root_.IsNormalRing A],
    ringKrullDim A = 2 → ∀ {X' X : Scheme.{u}}
      (f' : X' ⟶ Spec (.of A)) (f : X ⟶ Spec (.of A))
      [IsModification f'] [IsModification f] (g : X' ⟶ X),
      CommSq g f' f (𝟙 (Spec (.of A))) → X.isNormal →
      ∃ (i : Scheme.Hom.cohomology f (SheafOfModules.unit X.ringCatSheaf) 1 ⟶
          Scheme.Hom.cohomology f' (SheafOfModules.unit X'.ringCatSheaf) 1)
        (p : Scheme.Hom.cohomology f' (SheafOfModules.unit X'.ringCatSheaf) 1 ⟶
          Scheme.Hom.cohomology f
            (RingedSpace.Hom.higherDirectImageModule g.toShHom
              (SheafOfModules.unit X'.ringCatSheaf) 1) 0)
        (zero : i ≫ p = 0),
        (ShortComplex.mk i p zero).ShortExact)

/- Lemma 54.8.1 (2): the support of the first higher direct image has dimension zero. -/
@[stacks 0AXF]
#check (AlgebraicGeometry.IsModification.higherDirectImageOne_structureSheaf_supportDimension_eq_zero :
  ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [_root_.IsNormalRing A],
    ringKrullDim A = 2 → ∀ {X' X : Scheme.{u}}
      (f' : X' ⟶ Spec (.of A)) (f : X ⟶ Spec (.of A))
      [IsModification f'] [IsModification f] (g : X' ⟶ X),
      CommSq g f' f (𝟙 (Spec (.of A))) → X.isNormal →
      topologicalKrullDim
        (Scheme.Modules.moduleSupport
          (RingedSpace.Hom.higherDirectImageModule g.toShHom
            (SheafOfModules.unit X'.ringCatSheaf) 1)) = 0)

/- Lemma 54.8.1 (3): the first higher direct image is generated by global sections. -/
@[stacks 0AXF]
#check (AlgebraicGeometry.IsModification.higherDirectImageOne_structureSheaf_isGloballyGenerated :
  ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [_root_.IsNormalRing A],
    ringKrullDim A = 2 → ∀ {X' X : Scheme.{u}}
      (f' : X' ⟶ Spec (.of A)) (f : X ⟶ Spec (.of A))
      [IsModification f'] [IsModification f] (g : X' ⟶ X),
      CommSq g f' f (𝟙 (Spec (.of A))) → X.isNormal →
      SheafOfModules.IsGloballyGenerated
        (RingedSpace.Hom.higherDirectImageModule g.toShHom
          (SheafOfModules.unit X'.ringCatSheaf) 1))
