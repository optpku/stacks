set_option backward.privateInPublic true in
/-- The Taylor map respects addition in the square-zero extension. -/
private theorem taylorMap_add
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) (x y : B) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping Taylor addition terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    TrivSqZeroExt.inl (x + y) +
        TrivSqZeroExt.inr (KaehlerDifferential.DeRham.dividedPowerDifferentialDerivation f δ (x + y)) =
      (TrivSqZeroExt.inl x +
        TrivSqZeroExt.inr (KaehlerDifferential.DeRham.dividedPowerDifferentialDerivation f δ x)) +
        (TrivSqZeroExt.inl y +
        TrivSqZeroExt.inr (KaehlerDifferential.DeRham.dividedPowerDifferentialDerivation f δ y) :
          TrivSqZeroExt B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ)) := sorry

set_option backward.privateInPublic true in
/-- The first-order Taylor ring homomorphism `b ↦ (b, dδ(b))`. -/
def taylorHom
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping Taylor ring-hom terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    B →+* TrivSqZeroExt B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ) :=
  -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping Taylor ring-hom terms definitionally aligned.
  letI : Algebra A B := f.toAlgebra
  { toFun := fun b ↦ TrivSqZeroExt.inl b +
      TrivSqZeroExt.inr (KaehlerDifferential.DeRham.dividedPowerDifferentialDerivation f δ b)
    map_one' := taylorMap_one f δ
    map_mul' := taylorMap_mul f δ
    map_zero' := taylorMap_zero f δ
    map_add' := taylorMap_add f δ }

/-- The Taylor homomorphism evaluates as `b ↦ (b, dδ(b))`. -/
theorem taylorHom_apply
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) (b : B) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping Taylor evaluation terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    taylorHom f δ b = TrivSqZeroExt.inl b +
      TrivSqZeroExt.inr (KaehlerDifferential.DeRham.dividedPowerDifferentialDerivation f δ b) := sorry

/-- The Taylor and constant inclusions agree after composition with the base map. -/
theorem taylorHom_comp_base
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping base-composition terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    (taylorHom f δ).comp f =
      (TrivSqZeroExt.inlHom B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ)).comp f := sorry

set_option backward.privateInPublic true in
/-- The constant inclusion preserves the coordinate divided powers. -/
private theorem inclusion_isDPMorphism
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping divided-power preservation terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    DividedPowers.IsDPMorphism δ
      (DividedPowers.TrivSqZeroExt.submodulePowers δ (submodule f δ)
        (ideal_smul_mem_submodule f δ))
      (TrivSqZeroExt.inlHom B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ)) := sorry

set_option backward.privateInPublic true in
/-- The Taylor map preserves the coordinate divided powers. -/
private theorem taylor_isDPMorphism
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping divided-power preservation terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    DividedPowers.IsDPMorphism δ
      (DividedPowers.TrivSqZeroExt.submodulePowers δ (submodule f δ)
        (ideal_smul_mem_submodule f δ)) (taylorHom f δ) := sorry

set_option backward.privateInPublic true in
/-- The constant inclusion as a bundled divided-power morphism. -/
noncomputable def inclusionDPMorphism
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping bundled inclusion terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    DividedPowers.DPMorphism δ
      (DividedPowers.TrivSqZeroExt.submodulePowers δ (submodule f δ)
        (ideal_smul_mem_submodule f δ)) :=
  -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping bundled inclusion terms definitionally aligned.
  letI : Algebra A B := f.toAlgebra
  DividedPowers.DPMorphism.mk' (inclusion_isDPMorphism f δ)

/-- The underlying ring homomorphism of the bundled constant inclusion. -/
theorem inclusionDPMorphism_toRingHom
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping the inclusion projection terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    (inclusionDPMorphism f δ).toRingHom =
      TrivSqZeroExt.inlHom B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ) := sorry

set_option backward.privateInPublic true in
/-- The Taylor map as a bundled divided-power morphism. -/
noncomputable def taylorDPMorphism
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping bundled Taylor terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    DividedPowers.DPMorphism δ
      (DividedPowers.TrivSqZeroExt.submodulePowers δ (submodule f δ)
        (ideal_smul_mem_submodule f δ)) :=
  -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping bundled Taylor terms definitionally aligned.
  letI : Algebra A B := f.toAlgebra
  DividedPowers.DPMorphism.mk' (taylor_isDPMorphism f δ)

/-- The underlying ring homomorphism of the bundled Taylor morphism. -/
theorem taylorDPMorphism_toRingHom
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping the Taylor projection terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    (taylorDPMorphism f δ).toRingHom = taylorHom f δ := sorry

/-- A submodule is compatible when its coordinate extension supports both divided-power maps over
the base ring. -/
def compatible
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J)
    (N :
      -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping compatibility terms definitionally aligned.
      letI : Algebra A B := f.toAlgebra
      Submodule B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ)) : Prop :=
  -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping compatibility terms definitionally aligned.
  letI : Algebra A B := f.toAlgebra
  ∃ hJN : ∀ x : B, x ∈ J → ∀ ω : KaehlerDifferential.DeRham.dividedPowerDifferential f δ,
      x • ω ∈ N,
    DividedPowers.IsDPMorphism δ (DividedPowers.TrivSqZeroExt.submodulePowers δ N hJN)
        (TrivSqZeroExt.inlHom B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ)) ∧
      DividedPowers.IsDPMorphism δ (DividedPowers.TrivSqZeroExt.submodulePowers δ N hJN)
        (taylorHom f δ) ∧
      (taylorHom f δ).comp f =
        (TrivSqZeroExt.inlHom B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ)).comp f

/-- Compatibility unfolds to stability, preservation by both maps, and base agreement. -/
theorem compatible_iff
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J)
    (N :
      -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping compatibility terms definitionally aligned.
      letI : Algebra A B := f.toAlgebra
      Submodule B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ)) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping compatibility specification terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    compatible f δ N ↔
      ∃ hJN : ∀ x : B, x ∈ J → ∀ ω : KaehlerDifferential.DeRham.dividedPowerDifferential f δ,
          x • ω ∈ N,
        DividedPowers.IsDPMorphism δ (DividedPowers.TrivSqZeroExt.submodulePowers δ N hJN)
            (TrivSqZeroExt.inlHom B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ)) ∧
          DividedPowers.IsDPMorphism δ (DividedPowers.TrivSqZeroExt.submodulePowers δ N hJN)
            (taylorHom f δ) ∧
          (taylorHom f δ).comp f =
            (TrivSqZeroExt.inlHom B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ)).comp f := sorry

/-- The constant and Taylor maps are compatible for the generated differential submodule. -/
theorem firstOrder_maps
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping first-order map terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    compatible f δ (submodule f δ) := sorry

/-- The generated differential submodule is least among compatible submodules. -/
theorem firstOrder_minimal
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J) :
    -- Local instance justification (defeq pin): f.toAlgebra is the canonical algebra induced by the explicit ring morphism, keeping first-order minimality terms definitionally aligned.
    letI : Algebra A B := f.toAlgebra
    IsLeast {N : Submodule B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ) |
      compatible f δ N} (submodule f δ) := sorry

