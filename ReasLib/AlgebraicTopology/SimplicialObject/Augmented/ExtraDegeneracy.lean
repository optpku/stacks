module

public import ReasLib.AlgebraicTopology.SimplicialObject.Augmented.FromZero
public import ReasLib.AlgebraicTopology.SimplicialObject.Augmented.Composition.Pointwise
public import ReasLib.AlgebraicTopology.SimplicialObject.HomotopyEquiv
public import Mathlib.AlgebraicTopology.ExtraDegeneracy

/-!
# Simplicial homotopy equivalences from extra degeneracies

Mathlib's `SimplicialObject.Augmented.ExtraDegeneracy` owns the contraction data. This file
packages that data as the ReasLib simplicial `HomotopyEquiv`, so downstream constructions can
retain the chosen section and homotopy instead of proving only a proposition-valued consequence.
-/

@[expose] public section

open Opposite
open scoped Simplicial

universe u v u' v'

namespace CategoryTheory.SimplicialObject.Augmented.ExtraDegeneracy

variable {C : Type u} [Category.{v} C]

namespace app

variable {D : Type u'} [Category.{v'} D]
variable {X : SimplicialObject.Augmented (C ⥤ D)}
variable (ed : ExtraDegeneracy X) (A : C)

/-- The evaluated zero-section is a section of the evaluated augmentation. -/
theorem s'_comp_ε :
    ed.s'.app A ≫ (SimplicialObject.Augmented.Pointwise.obj X A).hom.app (Opposite.op ⦋0⦌) =
      𝟙 ((SimplicialObject.Augmented.Pointwise.obj X A).right) := sorry

/-- The initial face relation for an extra degeneracy holds after evaluation. -/
theorem s₀_comp_δ₁ :
    (ed.s 0).app A ≫ (SimplicialObject.Augmented.Pointwise.obj X A).left.δ 1 =
      (SimplicialObject.Augmented.Pointwise.obj X A).hom.app (Opposite.op ⦋0⦌) ≫
        ed.s'.app A := sorry

/-- Evaluated extra degeneracies remain sections of the zeroth faces. -/
theorem s_comp_δ₀ (n : ℕ) :
    (ed.s n).app A ≫ (SimplicialObject.Augmented.Pointwise.obj X A).left.δ 0 = 𝟙 _ := sorry

/-- Evaluated extra degeneracies commute with the remaining faces. -/
theorem s_comp_δ (n : ℕ) (i : Fin (n + 2)) :
    (ed.s (n + 1)).app A ≫
        (SimplicialObject.Augmented.Pointwise.obj X A).left.δ i.succ =
      (SimplicialObject.Augmented.Pointwise.obj X A).left.δ i ≫ (ed.s n).app A := sorry

/-- Evaluated extra degeneracies commute with degeneracies. -/
theorem s_comp_σ (n : ℕ) (i : Fin (n + 1)) :
    (ed.s n).app A ≫
        (SimplicialObject.Augmented.Pointwise.obj X A).left.σ i.succ =
      (SimplicialObject.Augmented.Pointwise.obj X A).left.σ i ≫
        (ed.s (n + 1)).app A := sorry

end app

/-- Evaluate an extra degeneracy on a functor-valued augmented simplicial object at one
object. -/
@[stacks 08ND "objectwise evaluation of an extra degeneracy"]
def app {D : Type u'} [Category.{v'} D]
    {X : SimplicialObject.Augmented (C ⥤ D)}
    (ed : ExtraDegeneracy X) (A : C) :
    ExtraDegeneracy (SimplicialObject.Augmented.Pointwise.obj X A) where
  s' := ed.s'.app A
  s n := (ed.s n).app A
  s'_comp_ε := app.s'_comp_ε ed A
  s₀_comp_δ₁ := app.s₀_comp_δ₁ ed A
  s_comp_δ₀ := app.s_comp_δ₀ ed A
  s_comp_δ := app.s_comp_δ ed A
  s_comp_σ := app.s_comp_σ ed A

/-- The zero-section of an evaluated extra degeneracy is evaluated pointwise. -/
@[simp]
theorem app_s' {D : Type u'} [Category.{v'} D]
    {X : SimplicialObject.Augmented (C ⥤ D)}
    (ed : ExtraDegeneracy X) (A : C) :
    (ed.app A).s' = ed.s'.app A := sorry

/-- Each map of an evaluated extra degeneracy is evaluated pointwise. -/
@[simp]
theorem app_s {D : Type u'} [Category.{v'} D]
    {X : SimplicialObject.Augmented (C ⥤ D)}
    (ed : ExtraDegeneracy X) (A : C) (n : ℕ) :
    (ed.app A).s n = (ed.s n).app A := sorry

/-- The section associated to an extra degeneracy agrees with the simplicial map generated by
its degree-zero section. -/
@[simp, stacks 08ND "section of an extra degeneracy from degree zero"]
theorem section_eq_fromZero {X : SimplicialObject.Augmented C} (ed : ExtraDegeneracy X) :
    ed.section_ = X.left.fromZero ed.s' := sorry

/-- An extra degeneracy packages the augmentation and its canonical section as a simplicial
homotopy equivalence. -/
@[stacks 08ND "simplicial homotopy equivalence from an extra degeneracy"]
def simplicialHomotopyEquiv {X : SimplicialObject.Augmented C} (ed : ExtraDegeneracy X) :
    SimplicialObject.HomotopyEquiv X.left
      ((SimplicialObject.const C).obj X.right) where
  hom := X.hom
  inv := ed.section_
  hom_inv_id := SimplicialObject.Homotopic.of_homotopy ed.homotopy
  inv_hom_id := SimplicialObject.Homotopic.of_eq ed.section_comp_hom

/-- The forward map of the simplicial homotopy equivalence supplied by an extra degeneracy is the
augmentation. -/
@[simp, stacks 08ND "forward map from an extra degeneracy"]
theorem simplicialHomotopyEquiv.hom {X : SimplicialObject.Augmented C}
    (ed : ExtraDegeneracy X) : ed.simplicialHomotopyEquiv.hom = X.hom := sorry

/-- The inverse map of the simplicial homotopy equivalence supplied by an extra degeneracy is its
canonical section. -/
@[simp, stacks 08ND "inverse map from an extra degeneracy"]
theorem simplicialHomotopyEquiv.inv {X : SimplicialObject.Augmented C}
    (ed : ExtraDegeneracy X) : ed.simplicialHomotopyEquiv.inv = ed.section_ := sorry

/-- The inverse supplied by an extra degeneracy is generated by its degree-zero section. -/
@[simp, stacks 08ND "inverse from an extra degeneracy in degree zero"]
theorem simplicialHomotopyEquiv.inv_eq_fromZero {X : SimplicialObject.Augmented C}
    (ed : ExtraDegeneracy X) :
    ed.simplicialHomotopyEquiv.inv = X.left.fromZero ed.s' := sorry

/-- The augmentation of an augmented simplicial object with an extra degeneracy is a simplicial
homotopy equivalence. -/
@[stacks 08ND "augmentation with an extra degeneracy is a homotopy equivalence"]
theorem isHomotopyEquivalence {X : SimplicialObject.Augmented C}
    (ed : ExtraDegeneracy X) : SimplicialObject.IsHomotopyEquivalence X.hom := sorry

end CategoryTheory.SimplicialObject.Augmented.ExtraDegeneracy
