module

public import Mathlib.Algebra.Module.SpanRank
public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Data.Complex.Basic
public import Mathlib.RingTheory.Ideal.Operations

@[expose] public section

universe u

noncomputable section

open MvPolynomial

namespace MvPolynomial

/-- The ideal generated by `X 0 ^ 2`, `X 0 * X 1`, and `X 1 ^ 2` in
`MvPolynomial (Fin 2) R`. -/
def squareMonomialsIdeal (R : Type u) [CommRing R] : Ideal (MvPolynomial (Fin 2) R) :=
  Ideal.span {X 0 ^ 2, X 0 * X 1, X 1 ^ 2}

/-- The ideal `squareMonomialsIdeal R` is the span of its three quadratic monomials. -/
theorem squareMonomialsIdeal_eq_span (R : Type u) [CommRing R] :
    squareMonomialsIdeal R = Ideal.span {X 0 ^ 2, X 0 * X 1, X 1 ^ 2} := sorry

/-- The ideal `squareMonomialsIdeal R` is the square of the ideal generated by `X 0` and `X 1`. -/
theorem squareMonomialsIdeal_eq_span_X_sq (R : Type u) [CommRing R] :
    squareMonomialsIdeal R = (Ideal.span {X 0, X 1} : Ideal (MvPolynomial (Fin 2) R)) ^ 2 := sorry

/-- If `k` is a field, then `squareMonomialsIdeal k` cannot be generated by two elements. -/
theorem squareMonomialsIdeal_not_spanRank_le_two_of_field {k : Type u} [Field k] :
    ¬ (squareMonomialsIdeal k).spanRank ≤ 2 := sorry

/-- The ideal `squareMonomialsIdeal ℂ` cannot be generated by two elements. -/
theorem squareMonomialsIdeal_not_spanRank_le_two :
    ¬ (squareMonomialsIdeal ℂ).spanRank ≤ 2 := sorry

/-- The ideal `squareMonomialsIdeal ℂ` is not the span of any pair of elements. -/
theorem squareMonomialsIdeal_ne_span_pair (f g : MvPolynomial (Fin 2) ℂ) :
    Ideal.span {f, g} ≠ squareMonomialsIdeal ℂ := sorry

/-- The minimal number of generators of `squareMonomialsIdeal ℂ` is three. -/
theorem squareMonomialsIdeal_spanRank_eq_three :
    (squareMonomialsIdeal ℂ).spanRank = 3 := sorry

end MvPolynomial
