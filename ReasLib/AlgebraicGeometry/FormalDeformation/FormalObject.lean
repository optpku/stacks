module

public import Mathlib.CategoryTheory.FiberedCategory.HomLift
public import Mathlib.CategoryTheory.Functor.OfSequence
public import ReasLib.CategoryTheory.InverseSystem.Sequential
public import ReasLib.AlgebraicGeometry.FormalDeformation.CompleteLocal

/-!
# Formal objects of a category over `C_Λ`

A formal object of `p : F ⥤ ArtinianLocalAlgCat Λ k` is a complete local base `R`
together with a sequential inverse system in `F` lying over the maximal-adic
truncations of `R`.
-/

@[expose] public section

open CategoryTheory IsLocalRing

universe u v

noncomputable section

variable {Λ k : Type u} [CommRing Λ] [IsNoetherianRing Λ] [Field k] [Algebra Λ k]
  [Module.Finite Λ k]
variable {F : Type v} [Category.{v} F]

namespace FormalObject

/-- Formal objects of `p` with complete local bases and compatible inverse systems. -/
def _root_.FormalObject {Λ k : Type u} [CommRing Λ] [IsNoetherianRing Λ] [Field k] [Algebra Λ k]
    [Module.Finite Λ k] {F : Type v} [Category.{v} F]
    (p : F ⥤ ArtinianLocalAlgCat Λ k) :=
  Σ' base : CompleteLocalAlgCat Λ k,
    Σ' system : SequentialInverseSystem F,
      Σ' over_obj : ∀ n : ℕ, p.obj (system.family n) = base.truncation n,
        ∀ n : ℕ, p.IsHomLift (base.truncationMap n) (system.stepMap n)

variable {p : F ⥤ ArtinianLocalAlgCat Λ k}

/-- The complete local base of a formal object. -/
def base (ξ : FormalObject p) : CompleteLocalAlgCat Λ k := ξ.1

/-- The inverse system stored in a formal object. -/
def system (ξ : FormalObject p) : SequentialInverseSystem F := ξ.2.1

/-- The stagewise base equations of a formal object. -/
def over_obj (ξ : FormalObject p) : ∀ n : ℕ, p.obj (ξ.system.family n) = ξ.base.truncation n := ξ.2.2.1

/-- The successor lift conditions of a formal object. -/
def over_step (ξ : FormalObject p) : ∀ n : ℕ, p.IsHomLift (ξ.base.truncationMap n) (ξ.system.stepMap n) :=
  ξ.2.2.2

set_option backward.privateInPublic true in
/-- The inverse system generated by lifted successor maps has lifted successor transitions. -/
private theorem ofOverStep (R : CompleteLocalAlgCat Λ k) (ξ : ℕ → F)
    (f : ∀ n, ξ (n + 1) ⟶ ξ n)
    (over_step : ∀ n, p.IsHomLift (R.truncationMap n) (f n)) :
    ∀ n, p.IsHomLift (R.truncationMap n)
      (SequentialInverseSystem.stepMap (Functor.ofOpSequence f) n) := sorry

set_option backward.privateInPublic true in
/-- Package a complete local base and a compatible inverse system as a formal object. -/
noncomputable def of (R : CompleteLocalAlgCat Λ k) (ξ : ℕ → F)
    (f : ∀ n, ξ (n + 1) ⟶ ξ n)
    (over_obj : ∀ n, p.obj (ξ n) = R.truncation n)
    (over_step : ∀ n, p.IsHomLift (R.truncationMap n) (f n)) :
    FormalObject p :=
  ⟨R, Functor.ofOpSequence f, over_obj, ofOverStep R ξ f over_step⟩

/-- The complete local base of a packaged formal object is the supplied algebra. -/
theorem of_base (R : CompleteLocalAlgCat Λ k) (ξ : ℕ → F) (f : ∀ n, ξ (n + 1) ⟶ ξ n)
    (over_obj : ∀ n, p.obj (ξ n) = R.truncation n)
    (over_step : ∀ n, p.IsHomLift (R.truncationMap n) (f n)) :
    (of R ξ f over_obj over_step).base = R := sorry

/-- Stagewise specification of a formal object over the truncations of its base. -/
theorem spec (ξ : FormalObject p) (n : ℕ) :
    p.obj (ξ.system.family n) = ξ.base.truncation n ∧
      p.IsHomLift (ξ.base.truncationMap n) (ξ.system.stepMap n) := sorry

/-- Morphisms of formal objects. -/
def Hom (ξ η : FormalObject p) :=
  Σ' base : ξ.base ⟶ η.base,
    Σ' app : ∀ n : ℕ, ξ.system.family n ⟶ η.system.family n,
      Σ' baseTrunc : ∀ n : ℕ, ξ.base.truncation n ⟶ η.base.truncation n,
        Σ' over : ∀ n : ℕ, p.IsHomLift (baseTrunc n) (app n),
          Σ' baseTrunc_spec : ∀ n : ℕ,
            (ArtinianLocalAlgCat.Hom.toRingHom (baseTrunc n)).comp
                (Ideal.Quotient.mk (CompleteLocalAlgCat.maximalIdeal ξ.base ^ (n + 1))) =
              (Ideal.Quotient.mk (CompleteLocalAlgCat.maximalIdeal η.base ^ (n + 1))).comp
                (CompleteLocalAlgCat.Hom.toRingHom base),
            ∀ n : ℕ, ξ.system.stepMap n ≫ app n = app (n + 1) ≫ η.system.stepMap n

/-- The base map of a formal-object morphism. -/
def Hom.base {ξ η : FormalObject p} (a : Hom ξ η) : ξ.base ⟶ η.base := a.1

/-- The stage maps of a formal-object morphism. -/
def Hom.app {ξ η : FormalObject p} (a : Hom ξ η) : ∀ n : ℕ, ξ.system.family n ⟶ η.system.family n :=
  a.2.1

/-- The truncated base maps of a formal-object morphism. -/
def Hom.baseTrunc {ξ η : FormalObject p} (a : Hom ξ η) :
    ∀ n : ℕ, ξ.base.truncation n ⟶ η.base.truncation n := a.2.2.1

/-- The stagewise lift conditions of a formal-object morphism. -/
def Hom.over {ξ η : FormalObject p} (a : Hom ξ η) : ∀ n : ℕ, p.IsHomLift (a.baseTrunc n) (a.app n) :=
  a.2.2.2.1

/-- The quotient compatibility of a formal-object morphism. -/
def Hom.baseTrunc_spec {ξ η : FormalObject p} (a : Hom ξ η) : ∀ n : ℕ,
    (ArtinianLocalAlgCat.Hom.toRingHom (a.baseTrunc n)).comp
        (Ideal.Quotient.mk (CompleteLocalAlgCat.maximalIdeal ξ.base ^ (n + 1))) =
      (Ideal.Quotient.mk (CompleteLocalAlgCat.maximalIdeal η.base ^ (n + 1))).comp
        (CompleteLocalAlgCat.Hom.toRingHom a.base) := a.2.2.2.2.1

/-- The successor naturality of a formal-object morphism. -/
def Hom.naturality {ξ η : FormalObject p} (a : Hom ξ η) : ∀ n : ℕ,
    ξ.system.stepMap n ≫ a.app n = a.app (n + 1) ≫ η.system.stepMap n := a.2.2.2.2.2

/-- Bundle a base map and compatible stage maps into a morphism of formal objects. -/
def Hom.of {ξ η : FormalObject p} (base : ξ.base ⟶ η.base)
    (app : ∀ n : ℕ, ξ.system.family n ⟶ η.system.family n)
    (baseTrunc : ∀ n : ℕ, ξ.base.truncation n ⟶ η.base.truncation n)
    (over : ∀ n : ℕ, p.IsHomLift (baseTrunc n) (app n))
    (baseTrunc_spec : ∀ n : ℕ,
      (ArtinianLocalAlgCat.Hom.toRingHom (baseTrunc n)).comp
          (Ideal.Quotient.mk (CompleteLocalAlgCat.maximalIdeal ξ.base ^ (n + 1))) =
        (Ideal.Quotient.mk (CompleteLocalAlgCat.maximalIdeal η.base ^ (n + 1))).comp
          (CompleteLocalAlgCat.Hom.toRingHom base))
    (naturality : ∀ n : ℕ,
      ξ.system.stepMap n ≫ app n = app (n + 1) ≫ η.system.stepMap n) : Hom ξ η :=
  ⟨base, app, baseTrunc, over, baseTrunc_spec, naturality⟩

set_option backward.privateInPublic true in
/-- Identity stage maps lie over identity maps of the truncated bases. -/
private theorem Hom.idOver (ξ : FormalObject p) :
    ∀ n : ℕ, p.IsHomLift (𝟙 (ξ.base.truncation n)) (𝟙 (ξ.system.family n)) := sorry

set_option backward.privateInPublic true in
/-- Identity maps on the truncated bases satisfy the quotient square for the identity base map. -/
private theorem Hom.idBaseTruncSpec (ξ : FormalObject p) :
    ∀ n : ℕ,
      (ArtinianLocalAlgCat.Hom.toRingHom (𝟙 (ξ.base.truncation n))).comp
          (Ideal.Quotient.mk (CompleteLocalAlgCat.maximalIdeal ξ.base ^ (n + 1))) =
        (Ideal.Quotient.mk (CompleteLocalAlgCat.maximalIdeal ξ.base ^ (n + 1))).comp
          (CompleteLocalAlgCat.Hom.toRingHom (𝟙 ξ.base)) := sorry

set_option backward.privateInPublic true in
/-- Identity stage maps commute with every successor transition. -/
private theorem Hom.idNaturality (ξ : FormalObject p) :
    ∀ n : ℕ, ξ.system.stepMap n ≫ 𝟙 (ξ.system.family n) =
      𝟙 (ξ.system.family (n + 1)) ≫ ξ.system.stepMap n := sorry

set_option backward.privateInPublic true in
/-- Identity morphism of a formal object. -/
def Hom.id (ξ : FormalObject p) : Hom ξ ξ :=
  ⟨𝟙 ξ.base, fun n ↦ 𝟙 (ξ.system.family n), fun n ↦ 𝟙 (ξ.base.truncation n),
    Hom.idOver ξ, Hom.idBaseTruncSpec ξ, Hom.idNaturality ξ⟩

set_option backward.privateInPublic true in
/-- Composed stage maps lie over the corresponding composed truncated base maps. -/
private theorem Hom.compOver {ξ η ζ : FormalObject p} (a : Hom ξ η) (b : Hom η ζ) :
    ∀ n : ℕ, p.IsHomLift (a.baseTrunc n ≫ b.baseTrunc n) (a.app n ≫ b.app n) := sorry

set_option backward.privateInPublic true in
/-- Composed truncated base maps satisfy the quotient square for the composed base map. -/
private theorem Hom.compBaseTruncSpec {ξ η ζ : FormalObject p} (a : Hom ξ η) (b : Hom η ζ) :
    ∀ n : ℕ,
      (ArtinianLocalAlgCat.Hom.toRingHom (a.baseTrunc n ≫ b.baseTrunc n)).comp
          (Ideal.Quotient.mk (CompleteLocalAlgCat.maximalIdeal ξ.base ^ (n + 1))) =
        (Ideal.Quotient.mk (CompleteLocalAlgCat.maximalIdeal ζ.base ^ (n + 1))).comp
          (CompleteLocalAlgCat.Hom.toRingHom (a.base ≫ b.base)) := sorry

set_option backward.privateInPublic true in
/-- Composed stage maps commute with every successor transition. -/
private theorem Hom.compNaturality {ξ η ζ : FormalObject p} (a : Hom ξ η) (b : Hom η ζ) :
    ∀ n : ℕ, ξ.system.stepMap n ≫ (a.app n ≫ b.app n) =
      (a.app (n + 1) ≫ b.app (n + 1)) ≫ ζ.system.stepMap n := sorry

set_option backward.privateInPublic true in
/-- Composition of morphisms of formal objects. -/
def Hom.comp {ξ η ζ : FormalObject p} (a : Hom ξ η) (b : Hom η ζ) : Hom ξ ζ :=
  ⟨a.base ≫ b.base, fun n ↦ a.app n ≫ b.app n,
    fun n ↦ a.baseTrunc n ≫ b.baseTrunc n,
    Hom.compOver a b, Hom.compBaseTruncSpec a b, Hom.compNaturality a b⟩

/-- A morphism of formal objects lies over its truncated base maps and commutes with successor transitions. -/
theorem Hom.spec {ξ η : FormalObject p} (a : Hom ξ η) (n : ℕ) :
    p.IsHomLift (a.baseTrunc n) (a.app n) ∧
      ξ.system.stepMap n ≫ a.app n = a.app (n + 1) ≫ η.system.stepMap n := sorry

/-- The identity morphism has identity base map. -/
theorem Hom.id_base (ξ : FormalObject p) : (Hom.id ξ).base = 𝟙 ξ.base := sorry

/-- The identity morphism has identity stage maps. -/
theorem Hom.id_app (ξ : FormalObject p) (n : ℕ) :
    (Hom.id ξ).app n = 𝟙 (ξ.system.family n) := sorry

/-- Composition of formal morphisms composes base maps. -/
theorem Hom.comp_base {ξ η ζ : FormalObject p} (a : Hom ξ η) (b : Hom η ζ) :
    (Hom.comp a b).base = a.base ≫ b.base := sorry

/-- Composition of formal morphisms composes stage maps. -/
theorem Hom.comp_app {ξ η ζ : FormalObject p} (a : Hom ξ η) (b : Hom η ζ) (n : ℕ) :
    (Hom.comp a b).app n = a.app n ≫ b.app n := sorry

/-- The identity on the source is a left identity for composition of formal-object morphisms. -/
theorem Hom.id_comp {ξ η : FormalObject p} (a : Hom ξ η) :
    Hom.comp (Hom.id ξ) a = a := sorry

/-- The identity on the target is a right identity for composition of formal-object morphisms. -/
theorem Hom.comp_id {ξ η : FormalObject p} (a : Hom ξ η) :
    Hom.comp a (Hom.id η) = a := sorry

/-- Composition of formal-object morphisms is associative. -/
theorem Hom.assoc {ξ η ζ θ : FormalObject p} (a : Hom ξ η) (b : Hom η ζ) (c : Hom ζ θ) :
    Hom.comp (Hom.comp a b) c = Hom.comp a (Hom.comp b c) := sorry

/-- Category of formal objects of `p`. -/
instance category : Category.{max u v} (FormalObject p) where
  Hom := Hom
  id := Hom.id
  comp f g := Hom.comp f g
  id_comp := Hom.id_comp
  comp_id := Hom.comp_id
  assoc := Hom.assoc

end FormalObject

end
