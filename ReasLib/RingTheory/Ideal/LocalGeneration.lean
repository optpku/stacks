module

public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Finiteness.Defs

@[expose] public section

/-!
# Principal-Open Local Generation of Ideals

This module owns the common Zariski-local shape used when an ideal is generated
by a finite family satisfying a condition after principal-open localization.
-/

universe u

namespace Ideal

variable {R : Type u} [CommRing R]

/-- An ideal is locally generated, near every prime that contains it, by a finite family after
localizing away from an element outside that prime. The predicate `P` records the property required
of that local generating family. -/
def IsGeneratedByFiniteAwaySequence (I : Ideal R)
    (P : ∀ g : R, {r : ℕ} → (Fin r → Localization.Away g) → Prop) : Prop :=
  ∀ p : Ideal R, p.IsPrime → I ≤ p →
    ∃ g : R, g ∉ p ∧ ∃ r : ℕ, ∃ f : Fin r → Localization.Away g,
      P g f ∧ Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f)

namespace IsGeneratedByFiniteAwaySequence

/-- An ideal which is locally generated by finite families on principal opens
is finitely generated. -/
theorem fg {I : Ideal R}
    {P : ∀ g : R, {r : ℕ} → (Fin r → Localization.Away g) → Prop}
    (hI : IsGeneratedByFiniteAwaySequence I P) : I.FG := sorry

end IsGeneratedByFiniteAwaySequence

end Ideal
