module

public import Mathlib.AlgebraicGeometry.Sites.Proetale
public import Mathlib.CategoryTheory.ObjectProperty.FullSubcategory
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import ReasLib.AlgebraicGeometry.Scheme.Cover.StandardProetale

/-!
# Affine objects of the small pro-étale site

The full subcategory of affine objects of `S.ProEt`, equipped with the
topology generated by ambient-covering standard pro-étale covers.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.ObjectProperty

universe u

namespace AlgebraicGeometry.Scheme.ProEt

/-- The object property selecting affine objects of the small pro-étale site. -/
abbrev affineObjects (S : Scheme.{u}) : ObjectProperty S.ProEt :=
  fun U ↦ IsAffine U.left

/-- Affine objects of the small pro-étale site of `S` are those with affine
source scheme. -/
theorem affineObjects_iff (S : Scheme.{u}) (U : S.ProEt) :
    affineObjects S U ↔ IsAffine U.left := sorry

/-- The full subcategory of affine objects of the small pro-étale site. -/
abbrev Affine (S : Scheme.{u}) := (affineObjects S).FullSubcategory

/-- Construct an affine object of the small pro-étale site from an affine
weakly étale morphism. -/
def Affine.mk {S : Scheme.{u}} {X : Scheme.{u}} (f : X ⟶ S) [IsAffine X]
    [WeaklyEtale f] : Affine S :=
  ⟨ProEt.mk f, ‹IsAffine X›⟩

/-- The underlying object of `Affine.mk f` is the corresponding object in the
small pro-étale site. -/
theorem Affine.mk_obj {S : Scheme.{u}} {X : Scheme.{u}} (f : X ⟶ S) [IsAffine X]
    [WeaklyEtale f] : (Affine.mk f).obj = ProEt.mk f := sorry

/-- The inclusion of affine objects into the small pro-étale site. -/
def affineInclusion (S : Scheme.{u}) : Affine S ⥤ S.ProEt :=
  (affineObjects S).ι

/-- The inclusion of an affine object is the underlying object of the small
pro-étale site. -/
theorem affineInclusion_obj (S : Scheme.{u}) (U : Affine S) :
    (affineInclusion S).obj U = U.obj := sorry

/-- The source-scheme functor from affine objects of the small pro-étale site. -/
def affineToScheme (S : Scheme.{u}) : Affine S ⥤ Scheme.{u} :=
  affineInclusion S ⋙ ProEt.forget S ⋙ Over.forget S

/-- Every object of the affine small pro-étale site has affine source scheme. -/
instance instIsAffine (S : Scheme.{u}) (U : Affine S) : IsAffine U.obj.left :=
  U.property

/-- A presieve on an affine object is a standard covering when it covers in the
ambient small pro-étale site and its image in schemes generates the same sieve
as a finite standard pro-étale cover. -/
def affineStandardCovering (S : Scheme.{u}) {U : Affine S} (R : Presieve U) : Prop :=
  R.map (affineInclusion S) ∈ (topology S).toPrecoverage U.obj ∧
    ∃ 𝒰 : StandardProetaleCover U.obj.left,
      Sieve.generate (R.map (affineToScheme S)) =
        Sieve.generate (Presieve.ofArrows 𝒰.U 𝒰.map)

/-- The precoverage of ambient-covering finite standard pro-étale families on
affine objects of the small pro-étale site. -/
def affinePrecoverage (S : Scheme.{u}) : Precoverage (Affine S) where
  coverings := fun _ ↦ { R | affineStandardCovering S R }

/-- Membership in the affine standard precoverage records both ambient covering
and equality of generated sieves with a finite standard pro-étale cover. -/
theorem mem_affinePrecoverage_iff (S : Scheme.{u}) {U : Affine S} {R : Presieve U} :
    R ∈ affinePrecoverage S U ↔
      R.map (affineInclusion S) ∈ (topology S).toPrecoverage U.obj ∧
        ∃ 𝒰 : StandardProetaleCover U.obj.left,
          Sieve.generate (R.map (affineToScheme S)) =
            Sieve.generate (Presieve.ofArrows 𝒰.U 𝒰.map) := sorry

/-- The Grothendieck topology on affine objects generated by ambient-covering
finite standard pro-étale families. -/
def affineTopology (S : Scheme.{u}) : GrothendieckTopology (Affine S) :=
  (affinePrecoverage S).toGrothendieck

/-- The affine small pro-étale topology is generated by its standard pro-étale
precoverage. -/
theorem affineTopology_def (S : Scheme.{u}) :
    affineTopology S = (affinePrecoverage S).toGrothendieck := sorry

end AlgebraicGeometry.Scheme.ProEt
