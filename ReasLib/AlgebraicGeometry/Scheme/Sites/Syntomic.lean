module

public import ReasLib.AlgebraicGeometry.Scheme.Cover.Syntomic.Basic
public import Mathlib.AlgebraicGeometry.Sites.Pretopology

/-!
# The big syntomic site of schemes

This leaf owns the canonical precoverage and Grothendieck topology generated by
jointly surjective syntomic families on the category of schemes.
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry.Scheme

/-- The canonical precoverage of schemes by jointly surjective syntomic
families. -/
abbrev bigSyntomicPrecoverage : Precoverage Scheme.{u} :=
  Scheme.precoverage (@Syntomic)

/-- The Grothendieck topology on schemes generated by jointly surjective
syntomic families. -/
abbrev bigSyntomicSite : GrothendieckTopology Scheme.{u} :=
  Scheme.grothendieckTopology (@Syntomic)

/-- The big syntomic topology is generated by its canonical syntomic
precoverage. -/
theorem bigSyntomicSite_eq_toGrothendieck :
    bigSyntomicSite = bigSyntomicPrecoverage.toGrothendieck := sorry

end AlgebraicGeometry.Scheme
