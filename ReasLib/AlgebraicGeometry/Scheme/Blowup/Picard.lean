module

public import Mathlib.RingTheory.RegularLocalRing.Defs
public import ReasLib.AlgebraicGeometry.Scheme.Module.Picard
public import ReasLib.AlgebraicGeometry.Scheme.Blowup.TwistingSheaf

@[expose] public section

noncomputable section

universe u

open CategoryTheory

namespace AlgebraicGeometry.IsBlowup

/-- The Picard group of the blowup of the spectrum of a two-dimensional regular local ring
at its maximal ideal is infinite cyclic, generated by the class of the exceptional divisor
sheaf `𝒪_X(E)`. -/
theorem existsIntAddEquivPicardGroup_of_maximalIdeal
    (A : Type u) [CommRing A] [IsRegularLocalRing A]
    (h_dim : ringKrullDim A = 2) {X : Scheme.{u}} (f : X ⟶ Spec (.of A))
    [IsBlowup f (Scheme.idealSheafDataOfIdealOnSpec (IsLocalRing.maximalIdeal A))] :
    let E := exceptionalIdeal (IsLocalRing.maximalIdeal A) f
    ∃ e : ℤ ≃+ X.PicardGroup,
      ∀ n : ℤ, e n = n • Scheme.Modules.picardClass E.associatedSheaf := sorry

end AlgebraicGeometry.IsBlowup
