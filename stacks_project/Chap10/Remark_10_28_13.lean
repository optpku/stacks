module

public import stacks_project.Chap10.Remark_10_28_13.BasicModel
import StacksCheckRecall

@[expose] public section

/-!
# Remark 10.28.13

@stack 05KJ

An explicit local quotient ring can have every prime ideal countably generated while admitting
an ideal which is not countably generated.
-/

universe u v

section


variable (k : Type u) [Field k] (T : Type v)

@[stacks 05KJ "explicit quotient-ring model"]
#check @remark102813Ring

@[stacks 05KJ "distinguished non-countably-generated ideal"]
#check @remark102813BadIdeal

@[stacks 05KJ "unique prime ideal"]
#check @remark102813_unique_prime

@[stacks 05KJ "countable generation of the unique prime"]
#check @remark102813_maximalIdeal_spanRank_le_aleph0

/-- The distinguished ideal generated by the `z_{t,n}` classes in the model of Remark 10.28.13
does not have span rank at most `ℵ₀` when `T` is uncountable. -/
@[stacks 05KJ "the bad ideal is not countably generated"]
theorem remark102813_badIdeal_not_spanRank_le_aleph0 [Uncountable T] :
    ¬ (remark102813BadIdeal k T).spanRank ≤ Cardinal.aleph0 := sorry

/-- Remark 10.28.13: in the explicit quotient ring, every prime ideal has span rank at most `ℵ₀`,
but some ideal does not. -/
@[stacks 05KJ]
theorem prime_ideals_spanRank_le_aleph0_but_some_ideal_is_not [Uncountable T] :
    (∀ P : Ideal (remark102813Ring k T), P.IsPrime → P.spanRank ≤ Cardinal.aleph0) ∧
      ∃ I : Ideal (remark102813Ring k T), ¬ I.spanRank ≤ Cardinal.aleph0 := sorry

end
