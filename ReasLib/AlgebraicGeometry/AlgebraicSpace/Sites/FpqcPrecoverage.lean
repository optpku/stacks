module

public import Mathlib.CategoryTheory.Sites.Precoverage
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Cover.Fpqc.Stability

/-!
# Fpqc precoverage on algebraic spaces

The fpqc covering presieves of algebraic spaces over a scheme `S` are the
presieves generated by `FpqcCovering` families.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry

universe u v

namespace AlgebraicGeometry.AlgebraicSpace

/-- The fpqc precoverage on algebraic spaces over `S`. A presieve covers when it
is the `toPresieve` of a family satisfying `FpqcCovering`. -/
def fpqcPrecoverage (S : Scheme.{u}) : Precoverage (AlgebraicSpace S) where
  coverings X :=
    { R | ∃ 𝒰 : SemiRepresentableFamily.Over.{u + 1} X,
        FpqcCovering 𝒰.obj ∧ SemiRepresentableFamily.Over.toPresieve 𝒰 = R }

/-- A displayed family generates an fpqc covering presieve if and only if the
corresponding slice family is an `FpqcCovering`. -/
theorem ofArrows_mem_fpqcPrecoverage_iff {S : Scheme.{u}} {Y : AlgebraicSpace S}
    {ι : Type v} {Yᵢ : ι → AlgebraicSpace S} (g : (i : ι) → Yᵢ i ⟶ Y) :
    Presieve.ofArrows Yᵢ g ∈ (fpqcPrecoverage S).coverings Y ↔
      FpqcCovering (fun i ↦ Over.mk (g i)) :=
  sorry

/-- Membership of an `ofArrows` family in the fpqc precoverage yields the
triangle factorizations of `FpqcCovering.exists_indices` through
`ofStandardFpqcCoverMap`. -/
theorem ofArrows_mem_fpqcPrecoverage_exists_indices {S : Scheme.{u}}
    {Y : AlgebraicSpace S} {ι : Type v} {Yᵢ : ι → AlgebraicSpace S}
    {g : (i : ι) → Yᵢ i ⟶ Y}
    (hg : Presieve.ofArrows Yᵢ g ∈ (fpqcPrecoverage S).coverings Y)
    {Z : Over S} (hZ : IsAffine Z.left) (h : ofOver Z ⟶ Y) :
    ∃ (𝒰 : StandardFpqcCover Z.left) (α : Fin 𝒰.n → ι)
      (φ : ∀ j, ofOver (Over.mk (𝒰.map j ≫ Z.hom)) ⟶ Yᵢ (α j)),
      ∀ j, φ j ≫ g (α j) = ofStandardFpqcCoverMap 𝒰 j ≫ h :=
  sorry

/-- Singleton presieves generated by isomorphisms cover for the fpqc
precoverage. -/
instance instFpqcPrecoverageHasIsos {S : Scheme.{u}} :
    (fpqcPrecoverage S).HasIsos := sorry

/-- Indexed composition of fpqc covering families is again covering. -/
instance instFpqcPrecoverageIsStableUnderComposition {S : Scheme.{u}} :
    (fpqcPrecoverage S).IsStableUnderComposition := sorry

/-- Base change of fpqc covering families along an arbitrary morphism is
covering. -/
instance instFpqcPrecoverageIsStableUnderBaseChange {S : Scheme.{u}} :
    (fpqcPrecoverage S).IsStableUnderBaseChange := sorry

end AlgebraicGeometry.AlgebraicSpace
