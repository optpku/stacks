module

public import ReasLib.RingTheory.Etale.PolynomialFactorization
import Mathlib.Tactic.CrossRefAttribute

/-!
# A counterexample to etale polynomial-factorization lifting

The factor `2 * X^2 + 2 * X + 1` over `ℤ / 4ℤ` is coprime to itself and squares to one, but its
leading coefficient is not a unit.  It therefore supplies the counterexample showing that the
unit-leading-coefficient hypothesis in the etale factorization theorem is necessary.

@stack 07M2
-/

@[expose] public section

open Polynomial

universe u

namespace Algebra.EtaleFactorization.ModFour

/-- The ideal `4ℤ` used in the factorization counterexample. -/
@[stacks 07M2 "counterexample ideal"]
def ideal : Ideal ℤ :=
  Ideal.span ({(4 : ℤ)} : Set ℤ)

/-- The polynomial `2 * X^2 + 2 * X + 1` over `ℤ / 4ℤ`. -/
@[stacks 07M2 "counterexample reduced factor"]
noncomputable def factor : (ℤ ⧸ ideal)[X] :=
  2 * X ^ 2 + 2 * X + 1

/-- The class of `2` is nonzero modulo `4`. -/
@[stacks 07M2 "two is nonzero modulo four"]
theorem two_ne_zero : ((2 : ℤ) : ℤ ⧸ ideal) ≠ 0 := sorry

/-- The quotient `ℤ / 4ℤ` is nontrivial. -/
@[stacks 07M2 "the quotient modulo four is nontrivial"]
theorem quotient_nontrivial : Nontrivial (ℤ ⧸ ideal) := sorry

/-- Base change sends the counterexample ideal to the principal ideal generated by `4`. -/
@[stacks 07M2 "base change of the counterexample ideal"]
theorem map_ideal (A : Type u) [CommRing A] [Algebra ℤ A] :
    Ideal.map (algebraMap ℤ A) ideal = Ideal.span ({(4 : A)} : Set A) := sorry

/-- In an etale `ℤ`-algebra with nontrivial reduction modulo `4`, an element reducing to `2` is
not nilpotent. -/
@[stacks 07M2 "etale rigidity of the class of two modulo four"]
theorem not_isNilpotent_of_eq_two
    (A : Type u) [CommRing A] [Algebra ℤ A] [Algebra.Etale ℤ A]
    [Nontrivial (A ⧸ Ideal.map (algebraMap ℤ A) ideal)]
    {x : A}
    (hx : Ideal.Quotient.mk (Ideal.map (algebraMap ℤ A) ideal) x =
      Ideal.Quotient.mk (Ideal.map (algebraMap ℤ A) ideal) (((2 : ℤ) : A))) :
    ¬ IsNilpotent x := sorry

/-- The reduced counterexample factor squares to one. -/
@[stacks 07M2 "the reduced factor squares to one"]
theorem factor_sq : factor ^ 2 = 1 := sorry

/-- The reduced counterexample factor is coprime to itself. -/
@[stacks 07M2 "self-coprimeness of the reduced factor"]
theorem factor_isCoprime : IsCoprime factor factor := sorry

/-- The leading coefficient of the reduced counterexample factor is not a unit. -/
@[stacks 07M2 "the reduced leading coefficient is not a unit"]
theorem factor_leadingCoeff_not_isUnit : ¬ IsUnit factor.leadingCoeff := sorry

/-- Example 15.9.7: the factorization of `1` by two copies of `factor` has no etale lift that
preserves the quotient modulo `4`. -/
@[stacks 07M2 "failure of etale factorization lifting without a unit leading coefficient"]
theorem no_etale_factorization_lift :
    ¬ ∃ (A' : Type u) (_ : CommRing A') (_ : Algebra ℤ A') (_ : Algebra.Etale ℤ A')
        (quotientAlgEquiv :
          (ℤ ⧸ ideal) ≃ₐ[ℤ ⧸ ideal]
            (A' ⧸ Ideal.map (algebraMap ℤ A') ideal))
        (g' h' : A'[X]),
        (1 : ℤ[X]).map (algebraMap ℤ A') = g' * h' ∧
          factor.map quotientAlgEquiv.toRingHom =
            g'.map (Ideal.Quotient.mk (Ideal.map (algebraMap ℤ A') ideal)) ∧
          factor.map quotientAlgEquiv.toRingHom =
            h'.map (Ideal.Quotient.mk (Ideal.map (algebraMap ℤ A') ideal)) := sorry

end Algebra.EtaleFactorization.ModFour
