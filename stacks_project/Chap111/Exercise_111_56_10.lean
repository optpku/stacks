/-!
# Exercise 111.56.10

The complement of a plane curve `D = V₊(F) ⊂ P²_k` is the basic open `D₊(F)`, and the
`k`-algebra of functions on that open is generated by at most `Nat.choose (d + 2) 2`
elements.
-/

@[expose] public section

open AlgebraicGeometry
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.ProjectiveSpace.PlaneCurve

/-- An irreducible homogeneous form of degree `d` on `P²` has positive degree, so
`Proj.basicOpenIsoAway` applies to `F`. -/
theorem zero_lt_degree_of_irreducible {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d)
    (hirr : Irreducible F) : 0 < d :=
  sorry

/-- Exercise 111.56.10 (1): in Situation 111.56.5, the open subscheme `U ⊂ P²_k` complementary
to the plane curve `D = V₊(F)` is the basic open
`D₊(F) = Proj.basicOpen (ProjectiveSpace.grading k 2) F`. Hence the `k`-algebra
`A = Γ(P²_k, U)` is `HomogeneousLocalization.Away (ProjectiveSpace.grading k 2) F`, identified
with `Γ(P²_k, D₊(F))` by `Proj.basicOpenIsoAway`. -/
@[stacks 09U5]
theorem closedImmersionComplement_eq_basicOpen {k : Type u} [Field k] [IsAlgClosed k]
    (d : ℕ) (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d)
    (hirr : Irreducible F) :
    closedImmersionComplement (closedImmersion d F hF) =
      Proj.basicOpen (ProjectiveSpace.grading k 2) F :=
  sorry

/-- The ring isomorphism `Proj.basicOpenIsoAway` is compatible with the `k`-algebra maps
into `HomogeneousLocalization.Away (ProjectiveSpace.grading k 2) F` and into
`Γ(P²_k, D₊(F))`. -/
theorem basicOpenIsoAway_algebraMap {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d)
    (hd : 0 < d) (x : k) :
    (Proj.basicOpenIsoAway (ProjectiveSpace.grading k 2) F hF hd).hom.hom
        (algebraMap k (HomogeneousLocalization.Away (ProjectiveSpace.grading k 2) F) x) =
      Scheme.Hom.sectionsMap (ProjectiveSpace.toSpec k 2)
        (Proj.basicOpen (ProjectiveSpace.grading k 2) F) x :=
  sorry

/-- Exercise 111.56.10 (2): in Situation 111.56.5, the `k`-algebra
`A = HomogeneousLocalization.Away (ProjectiveSpace.grading k 2) F` is generated by at most
`Nat.choose (d + 2) 2` elements, the number of monomials of degree `d` in three variables. -/
@[stacks 09U5]
theorem exists_adjoin_card_le {k : Type u} [Field k] [IsAlgClosed k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d)
    (hirr : Irreducible F) :
    ∃ s : Finset (HomogeneousLocalization.Away (ProjectiveSpace.grading k 2) F),
      s.card ≤ Nat.choose (d + 2) 2 ∧ Algebra.adjoin k {x | x ∈ s} = ⊤ :=
  sorry

end AlgebraicGeometry.ProjectiveSpace.PlaneCurve
