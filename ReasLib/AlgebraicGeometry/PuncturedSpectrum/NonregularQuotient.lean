module

public import Mathlib.RingTheory.MvPowerSeries.Basic
public import ReasLib.AlgebraicGeometry.PuncturedSpectrum
public import ReasLib.AlgebraicGeometry.Scheme.Module.Picard
public import ReasLib.RingTheory.Depth

@[expose] public section

open AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.PuncturedSpectrum.NonregularQuotient

/-- The eight-variable formal power-series ring over a field. -/
abbrev Ambient (k : Type u) [Field k] := MvPowerSeries (Fin 8) k

/-- The coordinate `a` in `Ambient k`. -/
def a (k : Type u) [Field k] : Ambient k := MvPowerSeries.X (0 : Fin 8)

/-- The coordinate `b` in `Ambient k`. -/
def b (k : Type u) [Field k] : Ambient k := MvPowerSeries.X (1 : Fin 8)

/-- The coordinate `x` in `Ambient k`. -/
def x (k : Type u) [Field k] : Ambient k := MvPowerSeries.X (2 : Fin 8)

/-- The coordinate `y` in `Ambient k`. -/
def y (k : Type u) [Field k] : Ambient k := MvPowerSeries.X (3 : Fin 8)

/-- The coordinate `z` in `Ambient k`. -/
def z (k : Type u) [Field k] : Ambient k := MvPowerSeries.X (4 : Fin 8)

/-- The coordinate `u` in `Ambient k`. -/
def u (k : Type u) [Field k] : Ambient k := MvPowerSeries.X (5 : Fin 8)

/-- The coordinate `v` in `Ambient k`. -/
def v (k : Type u) [Field k] : Ambient k := MvPowerSeries.X (6 : Fin 8)

/-- The coordinate `w` in `Ambient k`. -/
def w (k : Type u) [Field k] : Ambient k := MvPowerSeries.X (7 : Fin 8)

/-- The ideal generated by `a³`, `b³`, `xa² + yab + zb²`, and `w²`. -/
def relationIdeal (k : Type u) [Field k] : Ideal (Ambient k) :=
  Ideal.span
    ({a k ^ 3, b k ^ 3,
      x k * a k ^ 2 + y k * a k * b k + z k * b k ^ 2, w k ^ 2} : Set (Ambient k))

/-- The quotient ring `A = k[[a,b,x,y,z,u,v,w]]/(a^3,b^3,xa^2+yab+zb^2,w^2)`. -/
abbrev Ring (k : Type u) [Field k] := Ambient k ⧸ relationIdeal k

/-- The quotient `Ring k` is a local ring. -/
instance instIsLocalRing (k : Type u) [Field k] : IsLocalRing (Ring k) := sorry

/-- The ideal generated by `a³`, `b³`, and `xa² + yab + zb²` in seven variables. -/
def relationIdeal0 (k : Type u) [Field k] : Ideal (MvPowerSeries (Fin 7) k) :=
  Ideal.span
    ({MvPowerSeries.X (0 : Fin 7) ^ 3, MvPowerSeries.X (1 : Fin 7) ^ 3,
      MvPowerSeries.X (2 : Fin 7) * MvPowerSeries.X (0 : Fin 7) ^ 2 +
        MvPowerSeries.X (3 : Fin 7) * MvPowerSeries.X (0 : Fin 7) *
          MvPowerSeries.X (1 : Fin 7) +
        MvPowerSeries.X (4 : Fin 7) * MvPowerSeries.X (1 : Fin 7) ^ 2} :
      Set (MvPowerSeries (Fin 7) k))

/-- The seven-variable quotient `A₀ = k[[a,b,x,y,z,u,v]]/(a^3,b^3,xa^2+yab+zb^2)`. -/
abbrev Ring0 (k : Type u) [Field k] :=
  MvPowerSeries (Fin 7) k ⧸ relationIdeal0 k

/-- The quotient `Ring0 k` is a local ring. -/
instance instIsLocalRing0 (k : Type u) [Field k] : IsLocalRing (Ring0 k) := sorry

/-- The ideal generated by `a³`, `b³`, and `xa² + yab + zb²` in five variables. -/
def relationIdeal1 (k : Type u) [Field k] : Ideal (MvPowerSeries (Fin 5) k) :=
  Ideal.span
    ({MvPowerSeries.X (0 : Fin 5) ^ 3, MvPowerSeries.X (1 : Fin 5) ^ 3,
      MvPowerSeries.X (2 : Fin 5) * MvPowerSeries.X (0 : Fin 5) ^ 2 +
        MvPowerSeries.X (3 : Fin 5) * MvPowerSeries.X (0 : Fin 5) *
          MvPowerSeries.X (1 : Fin 5) +
        MvPowerSeries.X (4 : Fin 5) * MvPowerSeries.X (1 : Fin 5) ^ 2} :
      Set (MvPowerSeries (Fin 5) k))

/-- The five-variable quotient `A₁ = k[[a,b,x,y,z]]/(a^3,b^3,xa^2+yab+zb^2)`. -/
abbrev Ring1 (k : Type u) [Field k] :=
  MvPowerSeries (Fin 5) k ⧸ relationIdeal1 k

/-- The quotient `Ring1 k` is a local ring. -/
instance instIsLocalRing1 (k : Type u) [Field k] : IsLocalRing (Ring1 k) := sorry

/-- The image of the `i`th five-variable coordinate in `Ring1 k`. -/
def coordinate1 (k : Type u) [Field k] (i : Fin 5) : Ring1 k :=
  Ideal.Quotient.mk (relationIdeal1 k) (MvPowerSeries.X i)

/-- The class of `a^2 b^2` in the five-variable quotient `Ring1 k`. -/
def socleElement (k : Type u) [Field k] : Ring1 k :=
  Ideal.Quotient.mk (relationIdeal1 k)
    (MvPowerSeries.X (0 : Fin 5) ^ 2 * MvPowerSeries.X (1 : Fin 5) ^ 2)

/-- The class `a^2 b^2` is nonzero in `Ring1 k`. -/
theorem socleElement_ne_zero {k : Type u} [Field k] : socleElement k ≠ 0 := sorry

/-- The class `a^2 b^2` is annihilated by every coordinate of `Ring1 k`. -/
theorem coordinate1_mul_socleElement {k : Type u} [Field k] (i : Fin 5) :
    coordinate1 k i * socleElement k = 0 := sorry

/-- The five-variable quotient `Ring1 k` has depth zero. -/
theorem depth_ring1 {k : Type u} [Field k] :
    moduleDepth (Ring1 k) (Ring1 k) = 0 := sorry

/-- The seven-variable quotient `Ring0 k` has depth two. -/
theorem depth_ring0 {k : Type u} [Field k] :
    moduleDepth (Ring0 k) (Ring0 k) = 2 := sorry

/-- The eight-variable quotient `Ring k` has depth two. -/
theorem depth_ring {k : Type u} [Field k] :
    moduleDepth (Ring k) (Ring k) = 2 := sorry

/-- The Picard group of the punctured spectrum of `Ring k` is not subsingleton. -/
theorem picardGroup_not_subsingleton {k : Type u} [Field k] :
    ¬ Subsingleton (Scheme.PicardGroup (PuncturedSpectrum.scheme (Ring k))) := sorry

end AlgebraicGeometry.PuncturedSpectrum.NonregularQuotient
