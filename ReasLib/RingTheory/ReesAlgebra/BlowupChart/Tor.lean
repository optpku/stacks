module

public import ReasLib.Algebra.Category.ModuleCat.Tor.Notation
public import Mathlib.Algebra.Category.ModuleCat.Abelian
public import Mathlib.Algebra.Category.ModuleCat.Projective
public import ReasLib.RingTheory.ReesAlgebra.BlowupChart

@[expose] public section

open CategoryTheory
open scoped AffineBlowupChart ModuleTor

universe u

/-- If an ideal of a commutative Noetherian ring is generated by `t > 0` elements, a single
positive power of the ideal annihilates `Tor⁽i⁾` of its affine blowup chart at the first generator
with every module, uniformly for all degrees `i ≥ t`. -/
theorem AffineBlowupChart.exists_pow_le_annihilator_tor
    {A : Type u} [CommRing A] [IsNoetherianRing A]
    (I : Ideal A) (t : ℕ) (ht : 0 < t) (a : Fin t → I)
    (ha : I = Ideal.span (Set.range fun j ↦ (a j : A))) :
    ∃ c : ℕ, 0 < c ∧ ∀ (M : Type u) [AddCommGroup M] [Module A M] (i : ℕ),
      t ≤ i →
        I ^ c ≤ Module.annihilator A Tor⁽i⁾[A](A[I / (a ⟨0, ht⟩)], M) := sorry
