module

public import Mathlib.Algebra.Category.Grp.Ulift
public import Mathlib.Algebra.Homology.DerivedCategory.Ext.Basic
public import Mathlib.CategoryTheory.Abelian.RightDerived
public import ReasLib.CategoryTheory.DerivedCategory.Functor.Bounded.RightDerived.Canonical
public import ReasLib.CategoryTheory.Sites.Cohomology.Presheaf
import Mathlib.Tactic.CrossRefAttribute

/-!
# Derived cohomology over a presheaf

For a type-valued presheaf `G`, this leaf derives the covariant Hom functor from the free
abelian sheaf generated by `G`.  It exposes the bounded-below derived functor, its restriction
to coefficient sheaves in degree zero, and natural homology comparisons in both equal and
independent output universes.
-/

@[expose] public section

open CategoryTheory

noncomputable section

universe z d w v u

namespace CategoryTheory.Sheaf.CohomologyOverPresheaf

variable {C : Type u} [Category.{v} C]

/-- The canonical bounded-below right-derived Hom functor from the free abelian sheaf
generated by a type-valued presheaf. -/
@[stacks 03AY "derived cohomology over a presheaf",
  stacks 09VX "derived presheaf target"]
abbrev derivedFunctor
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{max w v}]
    [HasDerivedCategory.{d} (Sheaf J AddCommGrpCat.{max w v})]
    [HasDerivedCategory.{d} AddCommGrpCat.{max u v w}]
    (G : Cᵒᵖ ⥤ Type (max w v))
    [(homFunctor J G).toBoundedBelowDerived.HasRightDerivedFunctor
      (HomotopyCategory.Plus.quasiIso
        (Sheaf J AddCommGrpCat.{max w v}))] :
    DerivedCategory.Plus (Sheaf J AddCommGrpCat.{max w v}) ⥤
      DerivedCategory.Plus AddCommGrpCat.{max u v w} :=
  Functor.RightDerived.Bounded.functor (homFunctor J G)

/-- Send a coefficient sheaf, regarded as a complex in degree zero, to its bounded-below
derived cohomology over a type-valued presheaf. -/
@[stacks 03AY "coefficient sheaf for derived cohomology over a presheaf",
  stacks 09VX "coefficient target"]
abbrev coefficientFunctor
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{max w v}]
    [HasDerivedCategory.{d} (Sheaf J AddCommGrpCat.{max w v})]
    [HasDerivedCategory.{d} AddCommGrpCat.{max u v w}]
    (G : Cᵒᵖ ⥤ Type (max w v))
    [(homFunctor J G).toBoundedBelowDerived.HasRightDerivedFunctor
      (HomotopyCategory.Plus.quasiIso
        (Sheaf J AddCommGrpCat.{max w v}))] :
    Sheaf J AddCommGrpCat.{max w v} ⥤
      DerivedCategory.Plus AddCommGrpCat.{max u v w} :=
  DerivedCategory.Plus.singleFunctor (Sheaf J AddCommGrpCat.{max w v}) 0 ⋙
    derivedFunctor J G

/-- The degree-`n` homology of derived cohomology over `G` is `Ext^n` from
`J.freeAbelianSheaf G`.  Both objects are raised to their common universe. -/
@[stacks 03AY "derived cohomology over a presheaf, degree comparison",
  stacks 09VX "derived target cohomology"]
theorem homology_isomorphic
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{max w v}]
    [HasDerivedCategory.{d} (Sheaf J AddCommGrpCat.{max w v})]
    [HasDerivedCategory.{d} AddCommGrpCat.{max u v w}]
    [HasExt.{z} (Sheaf J AddCommGrpCat.{max w v})]
    (G : Cᵒᵖ ⥤ Type (max w v))
    [(homFunctor J G).toBoundedBelowDerived.HasRightDerivedFunctor
      (HomotopyCategory.Plus.quasiIso
        (Sheaf J AddCommGrpCat.{max w v}))]
    (I : Sheaf J AddCommGrpCat.{max w v}) (n : ℕ) :
    IsIsomorphic
      ((AddCommGrpCat.uliftFunctor.{z, max u v w}).obj
        ((DerivedCategory.Plus.homologyFunctor AddCommGrpCat.{max u v w} n).obj
          ((coefficientFunctor J G).obj I)))
      ((AddCommGrpCat.uliftFunctor.{max u v w, z}).obj
        ((cohomologyOverPresheafFunctor J G n).obj I)) := sorry

/-- Functorially in the coefficient sheaf, the universe-raised degree-`n` homology of derived
cohomology over `G` is the universe-raised `Ext`-valued cohomology functor. -/
@[stacks 03AY "universe-raised derived cohomology comparison functor",
  stacks 09VX "universe-raised derived target homology functor"]
theorem homologyFunctor_isIsomorphic_ulift
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{max w v}]
    [HasDerivedCategory.{d} (Sheaf J AddCommGrpCat.{max w v})]
    [HasDerivedCategory.{d} AddCommGrpCat.{max u v w}]
    [HasExt.{z} (Sheaf J AddCommGrpCat.{max w v})]
    (G : Cᵒᵖ ⥤ Type (max w v))
    [(homFunctor J G).toBoundedBelowDerived.HasRightDerivedFunctor
      (HomotopyCategory.Plus.quasiIso
        (Sheaf J AddCommGrpCat.{max w v}))]
    (n : ℕ) :
    IsIsomorphic
      (coefficientFunctor J G ⋙
        DerivedCategory.Plus.homologyFunctor AddCommGrpCat.{max u v w} n ⋙
        AddCommGrpCat.uliftFunctor.{z, max u v w})
      (cohomologyOverPresheafFunctor J G n ⋙
        AddCommGrpCat.uliftFunctor.{max u v w, z}) := sorry

/-- Without a universe change, degree-`n` homology of derived cohomology over `G` is the
existing `Ext`-valued presheaf-cohomology functor. -/
@[stacks 03AY "derived cohomology comparison functor",
  stacks 09VX "derived target homology functor"]
theorem homologyFunctor_isIsomorphic
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{max w v}]
    [HasDerivedCategory.{d} (Sheaf J AddCommGrpCat.{max w v})]
    [HasDerivedCategory.{d} AddCommGrpCat.{max u v w}]
    [HasExt.{max u v w} (Sheaf J AddCommGrpCat.{max w v})]
    (G : Cᵒᵖ ⥤ Type (max w v))
    [(homFunctor J G).toBoundedBelowDerived.HasRightDerivedFunctor
      (HomotopyCategory.Plus.quasiIso
        (Sheaf J AddCommGrpCat.{max w v}))]
    (n : ℕ) :
    IsIsomorphic
      (coefficientFunctor J G ⋙
        DerivedCategory.Plus.homologyFunctor AddCommGrpCat.{max u v w} n)
      (cohomologyOverPresheafFunctor J G n) := sorry

end CategoryTheory.Sheaf.CohomologyOverPresheaf
