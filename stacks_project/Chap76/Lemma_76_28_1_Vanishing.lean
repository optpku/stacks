module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.GeneratedSubobject
public import Mathlib.Algebra.Category.ModuleCat.Presheaf.Submodule
public import Mathlib.Algebra.Category.ModuleCat.Presheaf.Sheafification
public import stacks_project.Chap65.Lemma_65_7_3_Pullback
public import stacks_project.Chap67.Definition_67_48_3_RelativeSpectrum
public import stacks_project.Chap67.Lemma_67_13_1_Correspondence
public import stacks_project.Chap69.Lemma_69_17_2_Product
public import stacks_project.Chap69.Situation_69_16_1_GlobalSections

/-!
# Closed subspaces cut out by finite families of global sections

A finite family of global sections of `𝒪_X` generates a quasi-coherent ideal
sheaf on the small étale site, and therefore a closed subspace `V(fs) ⊂ X`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry
open AlgebraicGeometry.AlgebraicSpace

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

/-- The object of the small étale site of `X` associated to its structure atlas. -/
def atlasSite {S : Scheme.{u}} (X : AlgebraicSpace S) : smallEtaleSite X :=
  smallEtaleSite.mk (atlasHom X)

/-- `atlasSite X` is `smallEtaleSite.mk` of the structure atlas of `X`. -/
theorem atlasSite_eq {S : Scheme.{u}} (X : AlgebraicSpace S) :
    atlasSite X = smallEtaleSite.mk (atlasHom X) :=
  sorry

/-- The image of a global section of `𝒪_X` as a section of the unit `𝒪_X`-module on
the structure atlas. -/
def atlasUnitSection {S : Scheme.{u}} (X : AlgebraicSpace S) (f : globalSectionsRing X) :
    (SheafOfModules.unit (structureSheaf X)).val.obj (op (atlasSite X)) :=
  (globalSectionsRing_ι X).hom f

/-- `atlasUnitSection X f` is the atlas restriction of `f` via `globalSectionsRing_ι`. -/
theorem atlasUnitSection_eq {S : Scheme.{u}} (X : AlgebraicSpace S)
    (f : globalSectionsRing X) :
    atlasUnitSection X f = (globalSectionsRing_ι X).hom f :=
  sorry

/-- The smallest restriction-stable family of submodules containing the given
atlas sections. Its infimum is computed pointwise in the presheaf-submodule
lattice, without a smallness assumption on the whole sheaf category. -/
def vanishingSectionSubmodule {S : Scheme.{u}} {X : AlgebraicSpace S} {r : ℕ}
    (fs : Fin r → globalSectionsRing X) :
    PresheafOfModules.Submodule (SheafOfModules.unit (structureSheaf X)).val :=
  sInf {N | ∀ i, atlasUnitSection X (fs i) ∈ N.obj (op (atlasSite X))}

/-- Sheafify the actual inclusion of the generated presheaf submodule and take
its adjunct into the structure module. -/
def vanishingSectionMap {S : Scheme.{u}} {X : AlgebraicSpace S} {r : ℕ}
    (fs : Fin r → globalSectionsRing X) :
    (PresheafOfModules.sheafification.{u} (𝟙 (structureSheaf X).obj)).obj
      (vanishingSectionSubmodule fs).toPresheafOfModules ⟶
        SheafOfModules.unit (structureSheaf X) :=
  (PresheafOfModules.sheafificationHomEquiv.{u} (𝟙 (structureSheaf X).obj)).symm
    (vanishingSectionSubmodule fs).ι

/-- The quasi-coherent ideal generated by the finite family is the image of
the sheafified inclusion of its restriction-stable presheaf submodule. -/
def vanishingIdeal {S : Scheme.{u}} {X : AlgebraicSpace S} {r : ℕ}
    (fs : Fin r → globalSectionsRing X) : IdealSubobject X :=
  imageSubobject (vanishingSectionMap fs)

/-- The defining image formula for the ideal generated by the atlas restrictions. -/
theorem vanishingIdeal_eq {S : Scheme.{u}} {X : AlgebraicSpace S} {r : ℕ}
    (fs : Fin r → globalSectionsRing X) :
    vanishingIdeal fs = imageSubobject (vanishingSectionMap fs) :=
  rfl

/-- The ideal `vanishingIdeal fs` contains every atlas restriction of the family `fs`. -/
theorem vanishingIdeal_spec {S : Scheme.{u}} {X : AlgebraicSpace S} {r : ℕ}
    (fs : Fin r → globalSectionsRing X) :
    SheafOfModules.Subobject.containsSections (vanishingIdeal fs)
      (fun _ : Fin r ↦ atlasSite X) (fun i ↦ atlasUnitSection X (fs i)) :=
  sorry

/-- `vanishingIdeal fs` is the least ideal subobject containing the atlas restrictions
of `fs`. -/
theorem vanishingIdeal_le_iff {S : Scheme.{u}} {X : AlgebraicSpace S} {r : ℕ}
    (fs : Fin r → globalSectionsRing X) (G : IdealSubobject X) :
    vanishingIdeal fs ≤ G ↔
      SheafOfModules.Subobject.containsSections G
        (fun _ : Fin r ↦ atlasSite X) (fun i ↦ atlasUnitSection X (fs i)) :=
  sorry

/-- The ideal sheaf generated by finitely many global sections is quasi-coherent. -/
instance vanishingIdeal.instIsQuasiCoherent {S : Scheme.{u}} {X : AlgebraicSpace S}
    {r : ℕ} (fs : Fin r → globalSectionsRing X) :
    IsQuasiCoherent (vanishingIdeal fs) :=
  sorry

/-- The closed subspace `V(fs) ⊂ X` cut out by the quasi-coherent ideal generated by
`fs`. -/
def vanishingSubspace {S : Scheme.{u}} {X : AlgebraicSpace S} {r : ℕ}
    (fs : Fin r → globalSectionsRing X) : ClosedSubspace X :=
  ClosedSubspace.ofQuasiCoherentIdeal (vanishingIdeal fs)

/-- `vanishingSubspace fs` is the closed subspace associated to `vanishingIdeal fs`. -/
theorem vanishingSubspace_eq {S : Scheme.{u}} {X : AlgebraicSpace S} {r : ℕ}
    (fs : Fin r → globalSectionsRing X) :
    vanishingSubspace fs = ClosedSubspace.ofQuasiCoherentIdeal (vanishingIdeal fs) :=
  sorry

/-- The inclusion of `V(fs)` is the closed immersion cut out by `vanishingIdeal fs`. -/
theorem vanishingSubspace_ι {S : Scheme.{u}} {X : AlgebraicSpace S} {r : ℕ}
    (fs : Fin r → globalSectionsRing X) :
    (vanishingSubspace fs).ι = subschemeι (vanishingIdeal fs) :=
  sorry

/-- The scheme-theoretic intersection of `V(fs)` with an open subspace of `X`. -/
def vanishingPullback {S : Scheme.{u}} {X : AlgebraicSpace S} {r : ℕ}
    (fs : Fin r → globalSectionsRing X) (U : OpenSubspace X) : AlgebraicSpace S :=
  pullback U.ι (vanishingSubspace fs).ι

/-- `vanishingPullback fs U` is the fibre product of `U ⟶ X` with `V(fs) ⟶ X`. -/
theorem vanishingPullback_eq {S : Scheme.{u}} {X : AlgebraicSpace S} {r : ℕ}
    (fs : Fin r → globalSectionsRing X) (U : OpenSubspace X) :
    vanishingPullback fs U = pullback U.ι (vanishingSubspace fs).ι :=
  sorry

/-- The projection of `V(fs) ∩ U` onto the open subspace `U`. -/
def vanishingPullbackι {S : Scheme.{u}} {X : AlgebraicSpace S} {r : ℕ}
    (fs : Fin r → globalSectionsRing X) (U : OpenSubspace X) :
    vanishingPullback fs U ⟶ U.X :=
  pullback.fst U.ι (vanishingSubspace fs).ι

/-- `vanishingPullbackι fs U` is the first projection of the defining fibre product. -/
theorem vanishingPullbackι_eq {S : Scheme.{u}} {X : AlgebraicSpace S} {r : ℕ}
    (fs : Fin r → globalSectionsRing X) (U : OpenSubspace X) :
    vanishingPullbackι fs U = pullback.fst U.ι (vanishingSubspace fs).ι :=
  sorry

/-- The structure morphism `V(fs) ∩ U ⟶ Y` obtained by composing the inclusion of the
open with `f : X ⟶ Y`. -/
def vanishingPullbackHom {S : Scheme.{u}} {X Y : AlgebraicSpace S} (f : X ⟶ Y) {r : ℕ}
    (fs : Fin r → globalSectionsRing X) (U : OpenSubspace X) :
    vanishingPullback fs U ⟶ Y :=
  vanishingPullbackι fs U ≫ U.ι ≫ f

/-- `vanishingPullbackHom f fs U` is `vanishingPullbackι fs U ≫ U.ι ≫ f`. -/
theorem vanishingPullbackHom_eq {S : Scheme.{u}} {X Y : AlgebraicSpace S} (f : X ⟶ Y)
    {r : ℕ} (fs : Fin r → globalSectionsRing X) (U : OpenSubspace X) :
    vanishingPullbackHom f fs U = vanishingPullbackι fs U ≫ U.ι ≫ f :=
  sorry

end AlgebraicGeometry.AlgebraicSpace
