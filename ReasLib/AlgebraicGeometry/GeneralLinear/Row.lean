module

public import ReasLib.AlgebraicGeometry.GeneralLinear.Scheme
public import ReasLib.AlgebraicGeometry.PuncturedAffineSpace
public import ReasLib.AlgebraicGeometry.PuncturedAffineSpace.Projectivization

/-!
# Rows of the universal general linear matrix

A chosen row of the universal invertible matrix gives a canonical morphism to punctured affine
space and, in finite rank, to projective space. Predicates characterize these maps independently
of their constructors.
-/

@[expose] public section

open CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.GeneralLinear.Row

variable (R : Type u) [CommRing R] (ι : Type u) [Fintype ι] [DecidableEq ι]

/-- The ideal generated by the entries in row `i` of the universal invertible matrix. -/
@[stacks 01KX "universal general-linear row ideal"]
noncomputable abbrev ideal (i : ι) : Ideal (GeneralLinear.coordinateRing R ι) :=
  Matrix.GeneralLinearGroup.rowIdeal (GeneralLinear.universalMatrix R ι) i

/-- The universal row ideal is generated by the corresponding localized coordinates. -/
@[stacks 01KX "universal general-linear row coordinates"]
theorem ideal_eq_span_localizedCoordinate (i : ι) :
    ideal R ι i =
      Ideal.span (Set.range fun j ↦ GeneralLinear.localizedCoordinate R ι i j) := sorry

/-- Every row of the universal invertible matrix is unimodular. -/
@[stacks 01KX "rows of the universal invertible matrix are unimodular"]
theorem ideal_eq_top (i : ι) : ideal R ι i = ⊤ := sorry

/-- The comorphism sending affine coordinates to row `i` of the universal matrix. -/
@[stacks 01KX "universal general-linear row comorphism"]
noncomputable abbrev coordinateComap (i : ι) :
    PuncturedAffineSpace.coordinateRing ι R →ₐ[R] GeneralLinear.coordinateRing R ι :=
  MvPolynomial.aeval (fun j ↦ GeneralLinear.localizedCoordinate R ι i j)

/-- The row comorphism sends `X_j` to the `(i, j)` matrix coordinate. -/
@[simp, stacks 01KX "universal general-linear row coordinate"]
theorem coordinateComap_X (i j : ι) :
    coordinateComap R ι i (MvPolynomial.X j) =
      GeneralLinear.localizedCoordinate R ι i j := sorry

/-- The morphism from the general linear scheme to affine space induced by row `i`. -/
@[stacks 01KX "universal general-linear row morphism"]
noncomputable abbrev toAffineSpace (i : ι) :
  GeneralLinear.scheme R ι ⟶ PuncturedAffineSpace.affineSpace ι R :=
  Spec.map (CommRingCat.ofHom (coordinateComap R ι i).toRingHom) ≫
    (PuncturedAffineSpace.coordinateModelIso ι R).inv

/-- The row morphism respects the structure morphisms to `Spec(R)`. -/
@[reassoc, stacks 01KX "universal general-linear row structure map"]
theorem toAffineSpace_toBase (i : ι) :
    toAffineSpace R ι i ≫ PuncturedAffineSpace.toBase ι R =
      GeneralLinear.toBase R ι := sorry

/-- The image of the row morphism lies in punctured affine space. -/
@[stacks 01KX "universal general-linear row puncture range"]
theorem toAffineSpace_range_subset_punctured (i : ι) :
    Set.range (toAffineSpace R ι i).base ⊆
      Set.range (PuncturedAffineSpace.puncturedOpen ι R).ι.base := sorry

/-- A morphism to punctured affine space realizes row `i` when composing with the open inclusion
recovers the explicit row morphism to affine space. -/
@[stacks 01KX "row morphism to punctured affine space"]
def IsPuncturedLift
    {R : Type u} [CommRing R] {ι : Type u} [Fintype ι] [DecidableEq ι] (i : ι)
    (f : GeneralLinear.scheme R ι ⟶
      (PuncturedAffineSpace.puncturedOpen ι R).toScheme) : Prop :=
  f ≫ (PuncturedAffineSpace.puncturedOpen ι R).ι = toAffineSpace R ι i

/-- The canonical morphism to punctured affine space induced by row `i`. -/
@[stacks 01KX "row of a general linear matrix"]
noncomputable def toPuncturedAffineSpace (i : ι) :
    GeneralLinear.scheme R ι ⟶ (PuncturedAffineSpace.puncturedOpen ι R).toScheme :=
  IsOpenImmersion.lift (PuncturedAffineSpace.puncturedOpen ι R).ι
    (toAffineSpace R ι i) (toAffineSpace_range_subset_punctured R ι i)

/-- The canonical row morphism realizes the row's affine-space morphism. -/
@[stacks 01KX "canonical general-linear row lift"]
theorem IsPuncturedLift.canonical (i : ι) :
    IsPuncturedLift i (toPuncturedAffineSpace R ι i) := sorry

/-- The row morphism to affine space factors uniquely through punctured affine space. -/
@[stacks 01KX "universal general-linear row factorization"]
theorem existsUnique_toPuncturedAffineSpace (i : ι) :
    ∃! f : GeneralLinear.scheme R ι ⟶
        (PuncturedAffineSpace.puncturedOpen ι R).toScheme,
      IsPuncturedLift i f := sorry

/-- Two punctured-affine morphisms realizing the same row are equal. -/
@[stacks 01KX "uniqueness of a general-linear row lift"]
theorem IsPuncturedLift.eq {i : ι}
    {f g : GeneralLinear.scheme R ι ⟶
      (PuncturedAffineSpace.puncturedOpen ι R).toScheme}
    (hf : IsPuncturedLift i f) (hg : IsPuncturedLift i g) : f = g := sorry

/-- Any realization of row `i` through punctured affine space is over `Spec(R)`. -/
@[reassoc, stacks 01KX "general-linear row lift structure map"]
theorem IsPuncturedLift.toBase {i : ι}
    {f : GeneralLinear.scheme R ι ⟶
      (PuncturedAffineSpace.puncturedOpen ι R).toScheme}
    (hf : IsPuncturedLift i f) :
    f ≫ (PuncturedAffineSpace.puncturedOpen ι R).ι ≫
        PuncturedAffineSpace.toBase ι R = GeneralLinear.toBase R ι := sorry

/-- Any factorization of row `i` through punctured affine space is surjective. -/
@[stacks 01KX "surjectivity of a general-linear row lift"]
theorem IsPuncturedLift.surjective {i : ι}
    {f : GeneralLinear.scheme R ι ⟶
      (PuncturedAffineSpace.puncturedOpen ι R).toScheme}
    (hf : IsPuncturedLift i f) : Surjective f := sorry

/-- The canonical row morphism composes with the open inclusion to the affine-space morphism. -/
@[reassoc (attr := simp), stacks 01KX "canonical general-linear row inclusion"]
theorem toPuncturedAffineSpace_ι (i : ι) :
    toPuncturedAffineSpace R ι i ≫ (PuncturedAffineSpace.puncturedOpen ι R).ι =
      toAffineSpace R ι i := sorry

/-- The canonical row morphism to punctured affine space is over `Spec(R)`. -/
@[reassoc, stacks 01KX "canonical general-linear row structure map"]
theorem toPuncturedAffineSpace_toBase (i : ι) :
    toPuncturedAffineSpace R ι i ≫
        (PuncturedAffineSpace.puncturedOpen ι R).ι ≫
          PuncturedAffineSpace.toBase ι R = GeneralLinear.toBase R ι := sorry

/-- The canonical row morphism to punctured affine space is surjective. -/
@[stacks 01KX, instance]
theorem toPuncturedAffineSpace_surjective (i : ι) :
    Surjective (toPuncturedAffineSpace R ι i) := sorry

section ProjectiveSpace

variable (n : ℕ)

/-- Projectivizing any punctured-affine lift of row `i` is surjective. -/
@[stacks 01KX "surjectivity of a projectivized general-linear row lift"]
theorem IsPuncturedLift.projectivization_surjective
    {i : Fin (n + 1)}
    {f : GeneralLinear.scheme R (ULift.{u} (Fin (n + 1))) ⟶
      (PuncturedAffineSpace.puncturedOpen (ULift.{u} (Fin (n + 1))) R).toScheme}
    (hf : IsPuncturedLift (ULift.up i) f)
    {q : (PuncturedAffineSpace.puncturedOpen (ULift.{u} (Fin (n + 1))) R).toScheme ⟶
      ProjectiveSpace.scheme R n}
    (hq : PuncturedAffineSpace.IsProjectivization q) :
    Surjective (f ≫ q) := sorry

/-- Projectivizing a punctured-affine realization of row `i` gives a morphism over `Spec(R)`. -/
@[reassoc, stacks 01KX "projectivized general-linear row lift structure map"]
theorem IsPuncturedLift.projectivization_toBase
    {i : Fin (n + 1)}
    {f : GeneralLinear.scheme R (ULift.{u} (Fin (n + 1))) ⟶
      (PuncturedAffineSpace.puncturedOpen (ULift.{u} (Fin (n + 1))) R).toScheme}
    (hf : IsPuncturedLift (ULift.up i) f)
    {q : (PuncturedAffineSpace.puncturedOpen (ULift.{u} (Fin (n + 1))) R).toScheme ⟶
      ProjectiveSpace.scheme R n}
    (hq : PuncturedAffineSpace.IsProjectivization q) :
    (f ≫ q) ≫ ProjectiveSpace.toSpec R n =
      GeneralLinear.toBase R (ULift.{u} (Fin (n + 1))) := sorry

/-- The canonical projectivization of row `i`. -/
@[stacks 01KX "projectivized row"]
abbrev toProjectiveSpace (i : Fin (n + 1)) :
    GeneralLinear.scheme R (ULift.{u} (Fin (n + 1))) ⟶ ProjectiveSpace.scheme R n :=
  toPuncturedAffineSpace R (ULift.{u} (Fin (n + 1))) (ULift.up i) ≫
    PuncturedAffineSpace.toProjectiveSpace R n

/-- The canonical projectivization of row `i` is over `Spec(R)`. -/
@[reassoc, stacks 01KX "projectivized general-linear row structure map"]
theorem toProjectiveSpace_toBase (i : Fin (n + 1)) :
    toProjectiveSpace R n i ≫ ProjectiveSpace.toSpec R n =
      GeneralLinear.toBase R (ULift.{u} (Fin (n + 1))) := sorry

end ProjectiveSpace

end AlgebraicGeometry.GeneralLinear.Row
