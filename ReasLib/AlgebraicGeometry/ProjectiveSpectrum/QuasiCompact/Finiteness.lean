module

public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.QuasiCompact
public import ReasLib.Algebra.Module.Graded.DegreeZero
public import ReasLib.RingTheory.GradedAlgebra.GeneratedBy
public import ReasLib.RingTheory.Ideal.LocallyNilpotent

/-!
# Finiteness criteria for quasi-compact projective spectra

This file records three algebraic finiteness conditions on a nonnegatively graded ring and their
consequences for the compactness of its projective spectrum.
-/

@[expose] public section

universe u v

namespace AlgebraicGeometry.Proj

variable {A : Type u} {σ : Type v} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
variable (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- A graded ring is generated by its degree-one part over its degree-zero part, and that
degree-one part is finite as a module over the degree-zero part. -/
def GeneratedByDegreeOneFinite : Prop :=
  GradedAlgebra.GeneratedBy 𝒜 1 ∧ Module.Finite (𝒜 0) (𝒜 1)

/-- Generation by degree one together with module finiteness is the conjunction of the two
corresponding algebraic conditions. -/
theorem generatedByDegreeOneFinite_iff :
    GeneratedByDegreeOneFinite 𝒜 ↔
      GradedAlgebra.GeneratedBy 𝒜 1 ∧ Module.Finite (𝒜 0) (𝒜 1) :=
  Iff.rfl

/-- A graded ring has a finite positive submodule with locally nilpotent quotient when some
finite degree-zero submodule lies in the irrelevant ideal and the image of the irrelevant ideal
in the quotient by its generated ideal is locally nilpotent. -/
def FinitePositiveSubmoduleLocallyNilpotentQuotient : Prop :=
  ∃ F : Submodule (𝒜 0) A,
    Module.Finite (𝒜 0) F ∧
      (F : Set A) ⊆ (HomogeneousIdeal.irrelevant 𝒜).toIdeal ∧
        (Ideal.map (Ideal.Quotient.mk (Ideal.span (F : Set A)))
          (HomogeneousIdeal.irrelevant 𝒜).toIdeal).IsLocallyNilpotent

/-- The finite-positive-submodule condition exposes its finite submodule, positive-part
containment, and locally nilpotent quotient ideal. -/
theorem finitePositiveSubmoduleLocallyNilpotentQuotient_iff :
    FinitePositiveSubmoduleLocallyNilpotentQuotient 𝒜 ↔
      ∃ F : Submodule (𝒜 0) A,
        Module.Finite (𝒜 0) F ∧
          (F : Set A) ⊆ (HomogeneousIdeal.irrelevant 𝒜).toIdeal ∧
            (Ideal.map (Ideal.Quotient.mk (Ideal.span (F : Set A)))
              (HomogeneousIdeal.irrelevant 𝒜).toIdeal).IsLocallyNilpotent :=
  Iff.rfl

/-- A projective spectrum of a graded ring of finite type over its degree-zero part is compact. -/
theorem isCompact_univ_of_finiteType
    (h : Algebra.FiniteType (𝒜 0) A) :
    IsCompact (Set.univ : Set (Proj 𝒜)) := sorry

/-- A projective spectrum generated by a finite degree-one module is compact. -/
theorem isCompact_univ_of_generatedByDegreeOneFinite
    (h : GeneratedByDegreeOneFinite 𝒜) :
    IsCompact (Set.univ : Set (Proj 𝒜)) := sorry

namespace FinitePositiveSubmoduleLocallyNilpotentQuotient

/-- A finite positive submodule with locally nilpotent quotient supplies finitely many positive
homogeneous elements whose span contains the irrelevant ideal up to radical. -/
theorem exists_finite_homogeneous_irrelevant_le_radical_span
    (h : FinitePositiveSubmoduleLocallyNilpotentQuotient 𝒜) :
    ∃ n : ℕ, ∃ f : Fin n → A, ∃ deg : Fin n → ℕ,
      (∀ i, 0 < deg i ∧ f i ∈ 𝒜 (deg i)) ∧
        (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
          (Ideal.span (Set.range f)).radical := sorry

end FinitePositiveSubmoduleLocallyNilpotentQuotient

/-- A projective spectrum is compact when a finite positive submodule has locally nilpotent
quotient. -/
theorem isCompact_univ_of_finitePositiveSubmoduleLocallyNilpotentQuotient
    (h : FinitePositiveSubmoduleLocallyNilpotentQuotient 𝒜) :
    IsCompact (Set.univ : Set (Proj 𝒜)) := sorry

end AlgebraicGeometry.Proj
