module

public import ReasLib.RingTheory.DividedPowers.Category.Conormal.Filtration
import StacksCheckRecall

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open DividedPowers

/- Remark 60.6.4 (1): the conormal image of the divided-power differential submodule is the
image of the fold kernel inside the distinguished ideal. -/
@[stacks 07HU] #check (DividedPowerRing.Pushout.kernelComparison_submodule :
  ∀ {A B B₁ : DividedPowerRing.{_}} (f : A ⟶ B) (s₀ s₁ : B ⟶ B₁),
    (hpush : IsPushout f f s₀ s₁) →
      Submodule.map (DividedPowerRing.Pushout.kernelComparison f s₀ s₁ hpush)
          (DividedPowerDifferential.submodule f.toRingHom B.dividedPowers) =
        DividedPowerRing.Pushout.idealImage f s₀ s₁ hpush)

/- Remark 60.6.4 (2): the square-zero extension by universal divided-power differentials is a
divided-power ring with the coordinate ideal and restricted coordinate powers. -/
@[stacks 07HU] #check (DividedPowerDifferential.extensionRing :
  ∀ {A : Type _} [CommRing A] {B : Type _} [CommRing B],
    (A →+* B) → ∀ {J : Ideal B}, DividedPowers J → DividedPowerRing)

/- Remark 60.6.4 (3): the constant and Taylor maps are divided-power morphisms over the base. -/
@[stacks 07HU] #check (DividedPowerDifferential.firstOrder_maps :
  ∀ {A : Type _} [CommRing A] {B : Type _} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J),
    -- Local instance justification (defeq pin): f.toAlgebra aligns the differential submodule and compatibility predicate with the algebra induced by the explicit ring map.
    letI : Algebra A B := f.toAlgebra
    DividedPowerDifferential.compatible f δ
      (DividedPowerDifferential.submodule f δ))

/- Remark 60.6.4 (4): the differential submodule generated by `dδ(J)` is the least compatible
submodule. -/
@[stacks 07HU] #check (DividedPowerDifferential.firstOrder_minimal :
  ∀ {A : Type _} [CommRing A] {B : Type _} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J),
    -- Local instance justification (defeq pin): f.toAlgebra aligns the candidate submodules and their leastness statement with the algebra induced by the explicit ring map.
    letI : Algebra A B := f.toAlgebra
    IsLeast {N : Submodule B (KaehlerDifferential.DeRham.dividedPowerDifferential f δ) |
      DividedPowerDifferential.compatible f δ N}
      (DividedPowerDifferential.submodule f δ))

end
