module

public import Mathlib.RingTheory.RingHom.Flat
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.CompleteIntersection.Basic
public import ReasLib.RingTheory.Completion.LocalRing
public import ReasLib.RingTheory.RingHom.Fiber.Map
public import ReasLib.RingTheory.RingHom.Local.Surjective

@[expose] public section

/-!
# Good Factorizations of Local Ring Maps

This leaf owns the presentation used to compare complete-intersection kernels
of local maps between complete Noetherian local rings.  Its closed fiber uses
the map-first owner `RingHom.Fiber`, so consumers do not have to install an
auxiliary algebra structure.
-/

universe u v w x

open IsLocalRing

namespace RingHom

section LocalSource

variable {A : Type u} {B : Type v} [CommRing A] [CommRing B] [IsLocalRing A]

/-- A good factorization of `f : A →+* B` consists of local maps
`A → S → B`, with `S` Noetherian local, such that the first map is flat with
regular closed fiber, the second is surjective, and their composite is `f`. -/
@[stacks 09QA "good factorization"]
structure GoodFactorization (f : A →+* B) where
  /-- The intermediate Noetherian local ring. -/
  middle : Type w
  /-- The commutative-ring structure on the intermediate ring. -/
  instCommRing : CommRing middle
  /-- The local-ring structure on the intermediate ring. -/
  instIsLocalRing : IsLocalRing middle
  /-- The Noetherian structure on the intermediate ring. -/
  instIsNoetherianRing : IsNoetherianRing middle
  /-- The map from the source to the intermediate ring. -/
  left : A →+* middle
  /-- The map from the intermediate ring to the target. -/
  right : middle →+* B
  /-- The source leg is a local homomorphism. -/
  left_isLocalHom : IsLocalHom left
  /-- The target leg is surjective. Its locality follows from the local intermediate ring. -/
  right_surjective : Function.Surjective right
  /-- The source leg is flat. -/
  left_flat : left.Flat
  /-- The closed fiber of the source leg is a regular local ring. -/
  closedFiber_regular : IsRegularLocalRing (left.Fiber (maximalIdeal A))
  /-- The two legs compose to the original map. -/
  factor : right.comp left = f

-- The factorization value stays explicit; only its canonical property projections participate in
-- typeclass search for the corresponding maps and closed fiber.
attribute [instance] GoodFactorization.instCommRing
  GoodFactorization.instIsLocalRing GoodFactorization.instIsNoetherianRing
  GoodFactorization.left_isLocalHom GoodFactorization.closedFiber_regular

namespace GoodFactorization

variable {f : A →+* B}

/-- Build a good factorization from its two maps and the mathematical conditions not already
carried by the ambient ring instances. -/
@[stacks 09QA "good factorization constructor"]
def ofMaps {S : Type w} [CommRing S] [IsLocalRing S] [IsNoetherianRing S]
    (left : A →+* S) [h_left : IsLocalHom left] (right : S →+* B)
    (right_surjective : Function.Surjective right) (left_flat : left.Flat)
    [h_closedFiber : IsRegularLocalRing (left.Fiber (maximalIdeal A))]
    (factor : right.comp left = f) : GoodFactorization f where
  middle := S
  instCommRing := inferInstance
  instIsLocalRing := inferInstance
  instIsNoetherianRing := inferInstance
  left := left
  right := right
  left_isLocalHom := inferInstance
  right_surjective := right_surjective
  left_flat := left_flat
  closedFiber_regular := inferInstance
  factor := factor

/-- The closed fiber of the source leg of a good factorization. -/
@[stacks 09QA "closed fiber of a good factorization"]
abbrev ClosedFiber (P : GoodFactorization.{u, v, w} f) : Type (max u w) :=
  P.left.Fiber (maximalIdeal A)

/-- A good factorization is complete-intersection when the kernel of its
surjective target leg is generated by a regular sequence. -/
@[stacks 09QA "complete-intersection good factorization"]
abbrev IsCompleteIntersection (P : GoodFactorization f) : Prop :=
  P.right.KernelIsGeneratedByRegularSequence

/-- The target leg carries its canonical local-hom instance. -/
instance instIsLocalHomRight (P : GoodFactorization f) : IsLocalHom P.right := sorry

/-- The target leg of a good factorization is the canonical local surjection induced by its
surjectivity from the local intermediate ring. -/
theorem right_isLocalSurjection (P : GoodFactorization f) :
    P.right.IsLocalSurjection := sorry

/-- The target of a good factorization is a local ring via its local-surjective target leg. -/
@[stacks 09QA "local target of a good factorization"]
theorem target_isLocalRing (P : GoodFactorization f) : IsLocalRing B := sorry

/-- A good factorization exhibits its original map as a local homomorphism. -/
theorem isLocalHom (P : GoodFactorization f) : IsLocalHom f := sorry

/-- The complete defining conditions of a good factorization, grouped by the intermediate ring
and its source and target legs. -/
@[stacks 09QA "good factorization specification"]
theorem spec (P : GoodFactorization f) :
    (IsLocalRing P.middle ∧ IsNoetherianRing P.middle) ∧
      (IsLocalHom P.left ∧ P.left.Flat ∧ IsRegularLocalRing P.ClosedFiber) ∧
        (P.right.IsLocalSurjection ∧ P.right.comp P.left = f) := sorry

end GoodFactorization

end LocalSource

namespace GoodFactorization

section CompleteEndpoints

variable {A : Type u} {B : Type v} [CommRing A] [CommRing B]
variable [IsCompleteLocalRing A] [IsCompleteLocalRing B]
variable {f : A →+* B}

/-- For complete Noetherian local endpoints, the regular-sequence kernel
condition is independent of the chosen good factorization. -/
@[stacks 09QA "independence of good factorization"]
theorem isCompleteIntersection_iff_of_complete
    (P : GoodFactorization.{u, v, w} f) (Q : GoodFactorization.{u, v, x} f)
    [IsNoetherianRing A] [IsNoetherianRing B]
    : P.IsCompleteIntersection ↔ Q.IsCompleteIntersection := sorry

/-- Every local homomorphism between complete Noetherian local rings admits a
good factorization. -/
theorem nonempty (f : A →+* B) [IsLocalHom f]
    [IsNoetherianRing A] [IsNoetherianRing B] :
    Nonempty (GoodFactorization.{u, v, max u v} f) := sorry

/-- Lemma 23.9.1 (Tag 09QA): for a local homomorphism between complete
Noetherian local rings, one good factorization has regular-sequence kernel if
and only if every good factorization does. -/
@[stacks 09QA]
theorem exists_isCompleteIntersection_iff_forall
    (f : A →+* B) [IsLocalHom f]
    [IsNoetherianRing A] [IsNoetherianRing B] :
    (∃ P : GoodFactorization.{u, v, max u v} f, P.IsCompleteIntersection) ↔
      ∀ P : GoodFactorization.{u, v, max u v} f, P.IsCompleteIntersection := sorry

end CompleteEndpoints

end GoodFactorization

end RingHom
