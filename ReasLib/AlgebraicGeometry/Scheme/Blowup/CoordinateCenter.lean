module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme
public import Mathlib.AlgebraicGeometry.Morphisms.Smooth
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import ReasLib.AlgebraicGeometry.Scheme.Blowup.Rees
public import ReasLib.AlgebraicGeometry.Scheme.IdealSheafData.Spec

/-!
# Blowups of coordinate centers

This file records smoothness of a blowup along the ideal generated by the outer variables in
an iterated multivariable polynomial ring, together with smoothness of its exceptional divisor.
-/

@[expose] public section

open CategoryTheory

namespace AlgebraicGeometry.Blowup.CoordinateCenter

universe u

/-- The blowup of an affine space along the coordinate subspace cut out by the outer variables
is smooth over the base whenever there is at least one outer variable. -/
@[instance]
theorem smooth (R : Type u) [CommRing R] (m n : ℕ) [NeZero n]
    (π : Blowup
      (Spec (.of (MvPolynomial (Fin n) (MvPolynomial (Fin m) R))))
      (Scheme.idealSheafDataOfIdealOnSpec
        (MvPolynomial.idealOfVars (Fin n) (MvPolynomial (Fin m) R)))) :
    Smooth
      (π.hom ≫ Spec.map
        (CommRingCat.ofHom
          (algebraMap R (MvPolynomial (Fin n) (MvPolynomial (Fin m) R))))) := sorry

/-- The exceptional divisor of the blowup along the coordinate subspace cut out by the outer
variables is smooth over the base whenever there is at least one outer variable. -/
@[instance]
theorem exceptionalDivisor_smooth (R : Type u) [CommRing R] (m n : ℕ) [NeZero n]
    (π : Blowup
      (Spec (.of (MvPolynomial (Fin n) (MvPolynomial (Fin m) R))))
      (Scheme.idealSheafDataOfIdealOnSpec
        (MvPolynomial.idealOfVars (Fin n) (MvPolynomial (Fin m) R)))) :
    Smooth
      (π.exceptionalDivisor.subschemeι ≫ π.hom ≫ Spec.map
        (CommRingCat.ofHom
          (algebraMap R (MvPolynomial (Fin n) (MvPolynomial (Fin m) R))))) := sorry

end AlgebraicGeometry.Blowup.CoordinateCenter
