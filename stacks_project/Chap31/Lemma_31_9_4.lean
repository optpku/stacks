module

import StacksCheckRecall
import ReasLib.AlgebraicGeometry.Scheme.Module.FittingIdeal.LocalGenerators

universe u

/- Lemma 31.9.4: a finite-type quasicoherent module is generated by `r` sections on a
neighborhood of `s` exactly when the stalk ideal of its `r`th Fitting ideal sheaf is the unit
ideal. -/
@[stacks 0C3F] #check
  (AlgebraicGeometry.Scheme.fittingIdealSheaf.exists_open_isGeneratedBy_iff_stalk_eq_top :
    ∀ {S : AlgebraicGeometry.Scheme.{u}} (ℱ : S.Modules)
      [ℱ.IsFiniteType] [ℱ.IsQuasicoherent] (s : S) (r : ℕ),
      (∃ U : S.Opens, s ∈ U ∧ SheafOfModules.IsGeneratedBy (ℱ.over U) r) ↔
        AlgebraicGeometry.RingedSpace.idealSheafStalkIdeal
          (AlgebraicGeometry.Scheme.fittingIdealSheaf ℱ r).toSubobject s = ⊤)
