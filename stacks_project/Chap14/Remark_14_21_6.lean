module

public import ReasLib.AlgebraicTopology.SimplicialObject.Skeleton.Subcomplex
import StacksCheckRecall

/-!
@stack 018Q

# Remark 14.21.6 compatibility facade

Mathlib uses `sk m` and `cosk m` for the endofunctors obtained by truncating and then applying the
left or right Kan extension.  The truncated-to-untruncated functors remain available separately as
`Truncated.sk m` and `Truncated.cosk m`.
-/

@[expose] public section

open CategoryTheory

universe u v

namespace CategoryTheory.SimplicialObject

variable {C : Type u} [Category.{v} C]
variable (m : ℕ)

section Skeleton

variable [SimplicialObject.Truncated.HasSkeletons C m]

/- Remark 14.21.6: mathlib's `sk m` denotes the skeleton endofunctor, while `Truncated.sk m`
denotes only its left-Kan-extension stage. -/
#check (Truncated.sk (C := C) m :
  SimplicialObject.Truncated C m ⥤ SimplicialObject C)

/- Its source-facing composite is exposed directly by the definition of `sk`. -/
@[stacks 018Q]
#check (rfl : sk m = truncation m ⋙ Truncated.sk m)

end Skeleton

section Coskeleton

variable [SimplicialObject.Truncated.HasCoskeletons C m]

/- Likewise, `cosk m` is the coskeleton endofunctor and `Truncated.cosk m` is its right-Kan-
extension stage. -/
#check (Truncated.cosk (C := C) m :
  SimplicialObject.Truncated C m ⥤ SimplicialObject C)

/- Its source-facing composite is exposed directly by the definition of `cosk`. -/
@[stacks 018Q]
#check (rfl : cosk m = truncation m ⋙ Truncated.cosk m)

end Coskeleton

end CategoryTheory.SimplicialObject

namespace SSet

variable (m : ℕ) (V : SSet.{u})

/- Remark 14.21.6: for simplicial sets, the full `m`-skeleton is the subcomplex generated by
the simplices in degrees at most `m`, hence by those simplices and all their degeneracies. -/
@[stacks 018Q "simplicial-set skeleton as the generated subcomplex"]
#check (skAdj.counit.range m V :
  Subcomplex.range ((skAdj m).counit.app V) = V.skeleton (m + 1))
#check (skeleton.isoApp m V :
  (sk m).obj V ≅ (V.skeleton (m + 1) : SSet))
#check (skeleton.iso m : sk m ≅ skeleton.functor (m + 1))

end SSet
