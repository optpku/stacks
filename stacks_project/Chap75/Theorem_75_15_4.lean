module

public import stacks_project.Chap75.Theorem_75_15_4_Generation
import StacksCheckRecall

@[expose] public section

open AlgebraicGeometry CategoryTheory
open AlgebraicGeometry.AlgebraicSpace

universe u

/- Theorem 75.15.4: if `X` is a quasi-compact and quasi-separated algebraic space over a
scheme `S`, then `D_QCoh(𝒪_X)` is generated by a single perfect object. -/
@[stacks 09IY]
#check
  (AlgebraicGeometry.AlgebraicSpace.DerivedQCoh.exists_isPerfect_isWeakGenerator :
    ∀ {S : Scheme.{u}} {X : AlgebraicSpace S}
      [IsQuasiCompact X] [IsAbsolutelyQuasiSeparated X],
      ∃ P : AlgebraicGeometry.AlgebraicSpace.DerivedQCoh X,
        ModuleDerived.IsPerfect P.obj ∧ CategoryTheory.IsWeakGenerator P)
