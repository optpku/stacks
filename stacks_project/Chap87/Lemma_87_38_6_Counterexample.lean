module

public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.Data.PNat.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import stacks_project.Chap87.Lemma_87_38_6_Comparison

/-!
# Infinite-variable counterexample for completion along a closed subspace

For `A = MvPolynomial ℕ+ R` and `I = MvPolynomial.idealOfVars ℕ+ R`, the
canonical comparison from the completion of `Spec A` along `V(I)` to the
completion along `|V(I)|` fails to be an isomorphism: the test scheme
`Spec(A ⧸ (X n ^ n))` maps into `|Z|` but does not factor through
`completionAlongSubspace`.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Opposite

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.completionAlongSubspace.counterexample

/-- The ideal of all variables in `MvPolynomial ℕ+ R`. -/
def variableIdeal (R : Type u) [CommRing R] : Ideal (MvPolynomial ℕ+ R) :=
  MvPolynomial.idealOfVars ℕ+ R

/-- `variableIdeal R` is the variable ideal of `MvPolynomial ℕ+ R`. -/
theorem variableIdeal_eq (R : Type u) [CommRing R] :
    variableIdeal R = MvPolynomial.idealOfVars ℕ+ R :=
  sorry

/-- The ideal generated by `X n ^ n` for `n : ℕ+`. -/
def powerIdeal (R : Type u) [CommRing R] : Ideal (MvPolynomial ℕ+ R) :=
  Ideal.span (Set.range fun n : ℕ+ ↦ MvPolynomial.X n ^ n.val)

/-- `powerIdeal R` is spanned by the powers `X n ^ n`. -/
theorem powerIdeal_eq (R : Type u) [CommRing R] :
    powerIdeal R =
      Ideal.span (Set.range fun n : ℕ+ ↦ MvPolynomial.X n ^ n.val) :=
  sorry

/-- The structure morphism `Spec(MvPolynomial ℕ+ R) ⟶ Spec R`. -/
def structureHom (R : Type u) [CommRing R] :
    Spec (.of (MvPolynomial ℕ+ R)) ⟶ Spec (.of R) :=
  Spec.map (CommRingCat.ofHom (algebraMap R (MvPolynomial ℕ+ R)))

/-- The algebraic space `X = Spec(MvPolynomial ℕ+ R)` over `Spec R`. -/
def space (R : Type u) [CommRing R] : AlgebraicSpace (Spec (.of R)) :=
  ofOver (Over.mk (structureHom R))

/-- `space R` is the algebraic space represented by `Spec(MvPolynomial ℕ+ R)`. -/
theorem space_eq (R : Type u) [CommRing R] :
    space R = ofOver (Over.mk (structureHom R)) :=
  sorry

/-- The structure morphism of `Spec(A ⧸ I)` over `Spec R`. -/
def closedStructureHom (R : Type u) [CommRing R] :
    Spec (.of (MvPolynomial ℕ+ R ⧸ variableIdeal R)) ⟶ Spec (.of R) :=
  Spec.map
    (CommRingCat.ofHom (algebraMap R (MvPolynomial ℕ+ R ⧸ variableIdeal R)))

/-- The closed immersion `Spec(A ⧸ I) ⟶ Spec A` is a morphism over `Spec R`. -/
theorem closedImmersion_comp (R : Type u) [CommRing R] :
    Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (variableIdeal R))) ≫
        structureHom R =
      closedStructureHom R :=
  sorry

/-- The closed immersion `Spec(A ⧸ I) ⟶ Spec A` as a morphism of algebraic spaces. -/
def closedImmersion (R : Type u) [CommRing R] :
    ofOver (Over.mk (closedStructureHom R)) ⟶ space R :=
  ofOverHomMk (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (variableIdeal R))))
    (closedImmersion_comp R)

/-- The morphism `closedImmersion R` is a closed immersion of algebraic spaces. -/
instance instIsClosedImmersion_closedImmersion (R : Type u) [CommRing R] :
    IsClosedImmersion (closedImmersion R) :=
  sorry

/-- The closed subspace of `space R` cut out by the variable ideal. -/
def closedSubspace (R : Type u) [CommRing R] : ClosedSubspace (space R) :=
  ClosedSubspace.ofι (closedImmersion R)

/-- The inclusion of `closedSubspace R` is `closedImmersion R`. -/
theorem closedSubspace_ι (R : Type u) [CommRing R] :
    (closedSubspace R).ι = closedImmersion R :=
  sorry

/-- The structure morphism of `Spec(A ⧸ (X n ^ n))` over `Spec R`. -/
def testStructureHom (R : Type u) [CommRing R] :
    Spec (.of (MvPolynomial ℕ+ R ⧸ powerIdeal R)) ⟶ Spec (.of R) :=
  Spec.map (CommRingCat.ofHom (algebraMap R (MvPolynomial ℕ+ R ⧸ powerIdeal R)))

/-- The test object `Spec(A ⧸ (X n ^ n))` in `Over (Spec R)`. -/
def testOver (R : Type u) [CommRing R] : Over (Spec (.of R)) :=
  Over.mk (testStructureHom R)

/-- The closed immersion `Spec(A ⧸ (X n ^ n)) ⟶ Spec A` is a morphism over `Spec R`. -/
theorem testHom_comp (R : Type u) [CommRing R] :
    Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (powerIdeal R))) ≫
        structureHom R =
      testStructureHom R :=
  sorry

/-- The test morphism `Spec(A ⧸ (X n ^ n)) ⟶ Spec A` of algebraic spaces over `Spec R`. -/
def testHom (R : Type u) [CommRing R] : ofOver (testOver R) ⟶ space R :=
  ofOverHomMk (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (powerIdeal R))))
    (testHom_comp R)

/-- The Yoneda section of `space R` classified by `testHom R`. -/
def testSection (R : Type u) [CommRing R] :
    (space R).functorOfPoints.obj (op (testOver R)) :=
  yonedaEquiv
    (testHom R : yoneda.obj (testOver R) ⟶ (space R).functorOfPoints)

/-- The test section maps into `T = |Z|`, hence factors through `completionAlong`. -/
theorem testSection_mapsInto (R : Type u) [CommRing R] :
    mapsInto ((closedSubspace R).pointsCloseds : Set (Points (space R)))
      (testSection R) :=
  sorry

/-- The test section does not fppf-locally factor through an infinitesimal
neighbourhood of `Z`, hence does not lift to `completionAlongSubspace`, when
the coefficient ring `R` is nontrivial. The Stacks witness is `R = ℤ`,
`A = MvPolynomial ℕ+ ℤ`, and `I = MvPolynomial.idealOfVars ℕ+ ℤ`. -/
theorem testSection_not_mem_completionAlongSubspace (R : Type u) [CommRing R]
    [Nontrivial R] :
    ¬ fppfLocallyFactorsThroughNeighbourhood (closedSubspace R).ι
      (testSection R) :=
  sorry

end AlgebraicGeometry.AlgebraicSpace.completionAlongSubspace.counterexample
