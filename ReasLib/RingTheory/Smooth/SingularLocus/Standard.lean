module

public import ReasLib.RingTheory.Smooth.SingularLocus
public import ReasLib.RingTheory.Smooth.Standard.Locus

/-!
# The singular ideal from standard elements

This leaf identifies the singular ideal of a finitely presented algebra with
the radical generated by either flavor of standard element.

@stack 07CA
-/

@[expose] public section

universe u v

namespace Algebra

variable {R : Type u} {A : Type v} [CommRing R] [CommRing A] [Algebra R A]
variable [FinitePresentation R A]

namespace SingularIdeal

/-- Elkik's description of the singular ideal using strictly standard
elements. -/
@[stacks 07CA "Elkik's singular ideal theorem"]
theorem eq_radical_span_strictlyStandard :
    singularIdeal R A = (Ideal.span { a | IsStrictlyStandard R a }).radical := sorry

/-- Elkik's description of the singular ideal using elementary standard
elements. -/
@[stacks 07CA "Elkik's singular ideal theorem"]
theorem eq_radical_span_elementaryStandard :
    singularIdeal R A = (Ideal.span { a | IsElementaryStandard R a }).radical := sorry

end SingularIdeal

end Algebra
