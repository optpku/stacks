module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.AlgebraicGeometry.Scheme
public import Mathlib.RingTheory.DiscreteValuationRing.Basic
public import ReasLib.RingTheory.ReesAlgebra.BlowupChart

@[expose] public section

noncomputable section

open MvPolynomial
open scoped AlgebraicGeometry AffineBlowupChart

universe u v

namespace AlgebraicGeometry.NodalModel.Power

variable {R : Type u} [CommRing R]

/-- The equation defining the standard nodal model of exponent `n`. -/
def relation (π : R) (n : ℕ) : MvPolynomial (Fin 2) R :=
  X 0 * X 1 - C (π ^ n)

/-- The defining equation is `X 0 * X 1 - C (π ^ n)`. -/
theorem relation_def (π : R) (n : ℕ) :
    relation π n = X 0 * X 1 - C (π ^ n) := sorry

/-- The standard nodal `R`-algebra `R[x,y]/(xy-πⁿ)`. -/
abbrev Ring (R : Type u) [CommRing R] (π : R) (n : ℕ) :=
  MvPolynomial (Fin 2) R ⧸ Ideal.span {relation π n}

/-- The class of the first coordinate in the nodal-model ring. -/
def x (π : R) (n : ℕ) : Ring R π n :=
  Ideal.Quotient.mk (Ideal.span {relation π n}) (X 0)

/-- The class of the second coordinate in the nodal-model ring. -/
def y (π : R) (n : ℕ) : Ring R π n :=
  Ideal.Quotient.mk (Ideal.span {relation π n}) (X 1)

/-- The two coordinates satisfy the nodal equation `x * y = π ^ n`. -/
theorem x_mul_y (π : R) (n : ℕ) :
    x π n * y π n = algebraMap R (Ring R π n) (π ^ n) := sorry

/-- The distinguished closed-point ideal `(π, x, y)` of the nodal model. -/
def closedPointIdeal (π : R) (n : ℕ) : Ideal (Ring R π n) :=
  Ideal.span {algebraMap R (Ring R π n) π, x π n, y π n}

/-- The distinguished ideal is generated by `π`, `x`, and `y`. -/
theorem closedPointIdeal_eq_span (π : R) (n : ℕ) :
    closedPointIdeal π n =
      Ideal.span {algebraMap R (Ring R π n) π, x π n, y π n} := sorry

/-- The image of `π` belongs to the distinguished closed-point ideal. -/
theorem algebraMap_mem_closedPointIdeal (π : R) (n : ℕ) :
    algebraMap R (Ring R π n) π ∈ closedPointIdeal π n := sorry

/-- The first coordinate belongs to the distinguished closed-point ideal. -/
theorem x_mem_closedPointIdeal (π : R) (n : ℕ) :
    x π n ∈ closedPointIdeal π n := sorry

/-- The second coordinate belongs to the distinguished closed-point ideal. -/
theorem y_mem_closedPointIdeal (π : R) (n : ℕ) :
    y π n ∈ closedPointIdeal π n := sorry

/-- The uniformizer, packaged as a parameter of the distinguished ideal. -/
def centerPi (π : R) (n : ℕ) : closedPointIdeal π n :=
  ⟨algebraMap R (Ring R π n) π, algebraMap_mem_closedPointIdeal π n⟩

/-- The first coordinate, packaged as a parameter of the distinguished ideal. -/
def centerX (π : R) (n : ℕ) : closedPointIdeal π n :=
  ⟨x π n, x_mem_closedPointIdeal π n⟩

/-- The second coordinate, packaged as a parameter of the distinguished ideal. -/
def centerY (π : R) (n : ℕ) : closedPointIdeal π n :=
  ⟨y π n, y_mem_closedPointIdeal π n⟩

/-- The underlying ring element of `centerPi` is the image of `π`. -/
theorem coe_centerPi (π : R) (n : ℕ) :
    (centerPi π n : Ring R π n) = algebraMap R (Ring R π n) π := sorry

/-- The underlying ring element of `centerX` is `x`. -/
theorem coe_centerX (π : R) (n : ℕ) :
    (centerX π n : Ring R π n) = x π n := sorry

/-- The underlying ring element of `centerY` is `y`. -/
theorem coe_centerY (π : R) (n : ℕ) :
    (centerY π n : Ring R π n) = y π n := sorry

/-- The affine scheme associated to the standard nodal ring. -/
abbrev spectrum (R : Type u) [CommRing R] (π : R) (n : ℕ) : Scheme.{u} :=
  Spec (.of (Ring R π n))

/-- The structure morphism from the standard nodal model to `Spec R`. -/
def toBase (π : R) (n : ℕ) : spectrum R π n ⟶ Spec (.of R) :=
  Spec.map (CommRingCat.ofHom (algebraMap R (Ring R π n)))

/-- The structure morphism is induced by the quotient ring's `R`-algebra map. -/
theorem toBase_def (π : R) (n : ℕ) :
    toBase π n = Spec.map (CommRingCat.ofHom (algebraMap R (Ring R π n))) := sorry

/-- Evaluation of the nodal coordinates at two elements of an `R`-algebra. -/
def coordinateMap {B : Type v} [CommRing B] [Algebra R B] (a b : B) :
    MvPolynomial (Fin 2) R →ₐ[R] B :=
  MvPolynomial.aeval (Fin.cases a (fun _ ↦ b))

/-- The nodal relation lies in the kernel of coordinate evaluation whenever the images satisfy
the displayed nodal equation. -/
theorem relationIdeal_le_ker {B : Type v} [CommRing B] [Algebra R B]
    (π : R) (n : ℕ) (a b : B)
    (h_relation : a * b = algebraMap R B (π ^ n)) :
    Ideal.span {relation π n} ≤ RingHom.ker (coordinateMap a b).toRingHom := sorry

/-- The map from a nodal-model ring obtained by prescribing its two coordinates. -/
def lift {B : Type v} [CommRing B] [Algebra R B] (π : R) (n : ℕ) (a b : B)
    (h_relation : a * b = algebraMap R B (π ^ n)) : Ring R π n →ₐ[R] B :=
  Ideal.Quotient.liftₐ (Ideal.span {relation π n}) (coordinateMap a b)
    (relationIdeal_le_ker π n a b h_relation)

/-- The nodal-model lift sends the first coordinate to its prescribed image. -/
theorem lift_x {B : Type v} [CommRing B] [Algebra R B]
    (π : R) (n : ℕ) (a b : B) (h_relation : a * b = algebraMap R B (π ^ n)) :
    lift π n a b h_relation (x π n) = a := sorry

/-- The nodal-model lift sends the second coordinate to its prescribed image. -/
theorem lift_y {B : Type v} [CommRing B] [Algebra R B]
    (π : R) (n : ℕ) (a b : B) (h_relation : a * b = algebraMap R B (π ^ n)) :
    lift π n a b h_relation (y π n) = b := sorry

/-- In the chart with parameter `π`, the two basic fractions satisfy the nodal relation with
exponent `n - 2`. -/
theorem piChart_relation (π : R) (n : ℕ) (h_two : 2 ≤ n) :
    AffineBlowupChart.basicFraction (closedPointIdeal π n) (centerPi π n) (centerX π n) *
        AffineBlowupChart.basicFraction (closedPointIdeal π n) (centerPi π n) (centerY π n) =
      AffineBlowupChart.algebraMap (closedPointIdeal π n) (centerPi π n)
        (algebraMap R (Ring R π n) (π ^ (n - 2))) := sorry

/-- The canonical map from the nodal model of exponent `n - 2` to the `π`-chart of the blowup. -/
def piChartMap (π : R) (n : ℕ) (h_two : 2 ≤ n) :
    Ring R π (n - 2) →ₐ[R]
      affineBlowupChart (closedPointIdeal π n) (centerPi π n) :=
  lift π (n - 2)
    (AffineBlowupChart.basicFraction (closedPointIdeal π n) (centerPi π n) (centerX π n)) (AffineBlowupChart.basicFraction (closedPointIdeal π n) (centerPi π n) (centerY π n))
    (piChart_relation π n h_two)

/-- The canonical nodal-model map identifies the exponent-`n - 2` model with the `π`-chart. -/
theorem piChartMap_bijective [IsDomain R] [IsDiscreteValuationRing R]
    (π : R) [Fact (Irreducible π)] (n : ℕ) (h_two : 2 ≤ n) :
    Function.Bijective (piChartMap π n h_two) := sorry

/-- In the chart with parameter `x`, the image of `x` and the fraction `π / x` satisfy the
nodal relation of exponent one. -/
theorem xChart_relation (π : R) (n : ℕ) :
    AffineBlowupChart.algebraMap (closedPointIdeal π n) (centerX π n) (x π n) *
        AffineBlowupChart.basicFraction (closedPointIdeal π n) (centerX π n) (centerPi π n) =
      AffineBlowupChart.algebraMap (closedPointIdeal π n) (centerX π n)
        (algebraMap R (Ring R π n) (π ^ 1)) := sorry

/-- The canonical map from the exponent-one nodal model to the `x`-chart of the blowup. -/
def xChartMap (π : R) (n : ℕ) :
    Ring R π 1 →ₐ[R] affineBlowupChart (closedPointIdeal π n) (centerX π n) :=
  lift π 1
    (AffineBlowupChart.algebraMap (closedPointIdeal π n) (centerX π n) (x π n)) (AffineBlowupChart.basicFraction (closedPointIdeal π n) (centerX π n) (centerPi π n))
    (xChart_relation π n)

/-- The canonical exponent-one map identifies the nodal model with the `x`-chart. -/
theorem xChartMap_bijective [IsDomain R] [IsDiscreteValuationRing R]
    (π : R) [Fact (Irreducible π)] (n : ℕ) (h_two : 2 ≤ n) :
    Function.Bijective (xChartMap π n) := sorry

/-- In the chart with parameter `y`, the image of `y` and the fraction `π / y` satisfy the
nodal relation of exponent one. -/
theorem yChart_relation (π : R) (n : ℕ) :
    AffineBlowupChart.algebraMap (closedPointIdeal π n) (centerY π n) (y π n) *
        AffineBlowupChart.basicFraction (closedPointIdeal π n) (centerY π n) (centerPi π n) =
      AffineBlowupChart.algebraMap (closedPointIdeal π n) (centerY π n)
        (algebraMap R (Ring R π n) (π ^ 1)) := sorry

/-- The canonical map from the exponent-one nodal model to the `y`-chart of the blowup. -/
def yChartMap (π : R) (n : ℕ) :
    Ring R π 1 →ₐ[R] affineBlowupChart (closedPointIdeal π n) (centerY π n) :=
  lift π 1
    (AffineBlowupChart.algebraMap (closedPointIdeal π n) (centerY π n) (y π n)) (AffineBlowupChart.basicFraction (closedPointIdeal π n) (centerY π n) (centerPi π n))
    (yChart_relation π n)

/-- The canonical exponent-one map identifies the nodal model with the `y`-chart. -/
theorem yChartMap_bijective [IsDomain R] [IsDiscreteValuationRing R]
    (π : R) [Fact (Irreducible π)] (n : ℕ) (h_two : 2 ≤ n) :
    Function.Bijective (yChartMap π n) := sorry

/-- The distinguished ideal is maximal for every positive exponent. -/
instance instClosedPointIdealIsMaximal [IsDomain R] [IsDiscreteValuationRing R]
    (π : R) [Fact (Irreducible π)] (n : ℕ) :
    (closedPointIdeal π (n + 1)).IsMaximal := sorry

end AlgebraicGeometry.NodalModel.Power
