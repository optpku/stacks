module

public import ReasLib.AlgebraicGeometry.Scheme.PreRelation
public import Mathlib.Data.Quot

/-!
# The quotient presheaf of a pre-relation

This module constructs the objectwise quotient of the functor of points by the equivalence
relation generated by a scheme pre-relation.
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry.Scheme.PreRelation

/-- Precomposition preserves the point relation induced by a pre-relation. -/
theorem pointRel_precomp {S : Scheme.{u}} {U T T' : Over S} (P : PreRelation U)
    (f : T' ⟶ T) {x y : T ⟶ U} (h : P.pointRel T x y) :
    P.pointRel T' (f ≫ x) (f ≫ y) := sorry

/-- The presheaf whose value on `T` is the quotient of `T ⟶ U` by the equivalence relation
generated by `P.pointRel T`. -/
def quotientPresheaf {S : Scheme.{u}} {U : Over S} (P : PreRelation U) :
    (Over S)ᵒᵖ ⥤ Type u where
  obj T := Quot (P.pointRel T.unop)
  map {T T'} f :=
    TypeCat.ofHom <| Quot.map (fun x : T.unop ⟶ U ↦ f.unop ≫ x)
      (fun _ _ h ↦ P.pointRel_precomp f.unop h)
  map_id := sorry
  map_comp := sorry

/-- The value of the quotient presheaf on `T` is the quotient by `P.pointRel T`. -/
theorem quotientPresheaf_obj {S : Scheme.{u}} {U : Over S} (P : PreRelation U)
    (T : Over S) :
    P.quotientPresheaf.obj (Opposite.op T) = Quot (P.pointRel T) := sorry

/-- Restriction in the quotient presheaf is induced by precomposition on representatives. -/
theorem quotientPresheaf_map_mk {S : Scheme.{u}} {U T T' : Over S}
    (P : PreRelation U) (f : T' ⟶ T) (x : T ⟶ U) :
    P.quotientPresheaf.map f.op (Quot.mk (P.pointRel T) x) =
      Quot.mk (P.pointRel T') (f ≫ x) := sorry

/-- The canonical projection from the functor of points of `U` to the quotient presheaf. -/
def quotientMk {S : Scheme.{u}} {U : Over S} (P : PreRelation U) :
    yoneda.obj U ⟶ P.quotientPresheaf where
  app T := TypeCat.ofHom fun x ↦ Quot.mk (P.pointRel T.unop) x
  naturality := sorry

/-- The quotient projection sends a point to its quotient class. -/
theorem quotientMk_app {S : Scheme.{u}} {U : Over S} (P : PreRelation U)
    (T : Over S) (x : T ⟶ U) :
    P.quotientMk.app (Opposite.op T) x = Quot.mk (P.pointRel T) x := sorry

/-- Two points have the same image in the quotient presheaf exactly when they are related by
the equivalence relation generated by the point relation. -/
theorem quotientMk_eq_iff {S : Scheme.{u}} {U : Over S} (P : PreRelation U)
    (T : Over S) (x y : T ⟶ U) :
    P.quotientMk.app (Opposite.op T) x = P.quotientMk.app (Opposite.op T) y ↔
      _root_.Relation.EqvGen (P.pointRel T) x y := sorry

/-- For a pre-equivalence relation, equality in the quotient presheaf is exactly the original
point relation. -/
theorem quotientMk_eq_iff_of_isPreEquivalence {S : Scheme.{u}} {U : Over S}
    (P : PreRelation U) (hP : P.IsPreEquivalence) (T : Over S) (x y : T ⟶ U) :
    P.quotientMk.app (Opposite.op T) x = P.quotientMk.app (Opposite.op T) y ↔
      P.pointRel T x y := sorry

end AlgebraicGeometry.Scheme.PreRelation
