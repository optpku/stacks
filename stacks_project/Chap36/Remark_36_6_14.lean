module

import ReasLib.AlgebraicGeometry.Scheme.Module.Cech.PrincipalOpen.LocalCohomology.BaseChange
import StacksCheckRecall

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

/- Pullback carries the ideal generated by a finite family of global sections to the ideal
generated by the pulled-back family. -/
#check (ModuleCech.BaseChange.ideal_comap :
  ∀ {X X' : Scheme.{u}} (g : X' ⟶ X) {c : ℕ} (f : Fin c → Γ(X, ⊤)),
    (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range f))).comap g =
      Scheme.IdealSheafData.ofIdealTop
        (Ideal.span (Set.range fun i ↦ g.appTop.hom (f i))))

/- The closed subscheme defined by a pulled-back ideal is the scheme-theoretic pullback of the
original closed subscheme. -/
#check (Scheme.ClosedSubschemeStructure.comapIso :
  ∀ {X Y : Scheme.{u}} {Z : Closeds Y} (T : Scheme.ClosedSubschemeStructure Z)
    (g : X ⟶ Y),
    (T.comap g).subscheme ≅ Limits.pullback g T.ι)

/- Remark 36.6.14: for a quasicoherent module, the degree-`c` class-map square commutes on the
two zero loci under the canonical restricted pullback. -/
@[stacks 0G7U] #check (ModuleCech.BaseChange.classMap_restricted_commSq :
  ∀ {X X' : Scheme.{u}} (g : X' ⟶ X) {c : ℕ} (f : Fin c → Γ(X, ⊤))
    (ℱ : X.Modules) [ℱ.IsQuasicoherent],
    CommSq
      ((ModuleCech.BaseChange.restrictedPullbackTo g f
        (ModuleCech.BaseChange.zeroLocus_preimage g f)).map
          ((ModuleCech.LocalCohomology.classMap f).app ℱ))
      (ModuleCech.BaseChange.restrictedCoefficientComparisonTo g f ℱ
        (ModuleCech.BaseChange.zeroLocus_preimage g f)
        (ModuleCech.BaseChange.restrictedSquare g f))
      (ModuleCech.BaseChange.restrictedSupportedBaseChange g f ℱ
        (ModuleCech.BaseChange.zeroLocus_preimage g f)
        (ModuleCech.BaseChange.restrictedDerivedPushforwardIso g f)
        (ModuleCech.BaseChange.restrictedLocalCohomology_isLE f ℱ))
      ((ModuleCech.LocalCohomology.classMap
        (fun i ↦ g.appTop.hom (f i))).app ((Scheme.Modules.pullback g).obj ℱ)))

/- Without quasicoherence, the extended Čech-to-local-cohomology comparison commutes with
derived base change along the induced morphism of the two zero loci. -/
#check (ModuleCech.BaseChange.restrictedDerivedCommSq :
  ∀ {X X' : Scheme.{u}} (g : X' ⟶ X) {c : ℕ} (f : Fin c → Γ(X, ⊤))
    (ℱ : X.Modules),
    CommSq (ModuleCech.BaseChange.derivedMap g f ℱ)
      ((RingedSpace.modulePullbackDerived g.toLRSHom.toShHom).map
        ((ModuleCech.ofSectionsToLocalCohomology f).app ℱ))
      ((ModuleCech.ofSectionsToLocalCohomology
        (fun i ↦ g.appTop.hom (f i))).app ((Scheme.Modules.pullback g).obj ℱ))
      (ModuleCech.BaseChange.supportMap g f ℱ
        (ModuleCech.BaseChange.restrictedDerivedPushforwardIso g f)))
