  apply (Iso.comp_inv_eq (T.objIsoTensor K E₂)).2
  rw [Category.assoc]
  symm
  apply (Iso.inv_comp_eq (T.objIsoTensor K E₁)).2
  exact tensorMapOf_objIsoTensor H T f K

namespace InternalHomTensor

/-- 0A65: the iterated derived internal-Hom isomorphism selected by an explicit closed owner and
fixed-right tensor model.  The ambient tensor-source isomorphism is transported to the canonical
derived tensor through `objIsoTensor`. -/
@[stacks 0A65, stacks 01CN, stacks 03EO, stacks 08DJ "derived internal-Hom tensor-source isomorphism"]
noncomputable def isoOf
    (H : MonoidalClosed (DerivedCategory C))
    (T : DerivedTensor.Right.Monoidal.Model (C := C))
