module

public import ReasLib.AlgebraicGeometry.Scheme.Sites.AffineOver.Pretopology
public import Mathlib.AlgebraicGeometry.Morphisms.Proper
public import Mathlib.AlgebraicGeometry.Morphisms.UnderlyingMap
public import Mathlib.AlgebraicGeometry.Sites.BigZariski
public import Mathlib.AlgebraicGeometry.Sites.Small
public import Mathlib.CategoryTheory.Sites.Finite

/-!
# The basic big `ph` site

This module owns the proper-surjective topology on a scheme slice and its
canonical affine restriction.  Sheaf criteria for singleton covers live in
the separate `Ph.Sheaf` leaf.
-/

@[expose] public section

open CategoryTheory

noncomputable section

universe u v

namespace AlgebraicGeometry.Scheme

/-- The morphism property consisting of proper and surjective morphisms. -/
abbrev properSurjectiveMorphismProperty : MorphismProperty Scheme.{u} :=
  (@IsProper) ⊓ (@Surjective)

/-- The topology on `Over S` generated by proper-surjective morphisms. -/
abbrev properSurjectiveTopology (S : Scheme.{u}) : GrothendieckTopology (Over S) :=
  S.overGrothendieckTopology properSurjectiveMorphismProperty

/-- The big `ph` topology on `Over S`, generated by the Zariski and
proper-surjective slice topologies. -/
abbrev bigPhSite (S : Scheme.{u}) : GrothendieckTopology (Over S) :=
  Scheme.zariskiTopology.over S ⊔ properSurjectiveTopology S

/-- The big `ph` topology is the join of the Zariski and proper-surjective
slice topologies. -/
theorem bigPhSite_def (S : Scheme.{u}) :
    bigPhSite S = Scheme.zariskiTopology.over S ⊔ properSurjectiveTopology S := sorry

/-- The affine inclusion is locally cover-dense for the big `ph` topology. -/
theorem bigAffinePhInclusion_isLocallyCoverDense (S : Scheme.{u}) :
    (AffineOver.forget S).LocallyCoverDense (bigPhSite S) := sorry

/-- Instance form of the local cover-density of affine schemes in the big
`ph` site. -/
instance bigAffinePhInclusion_locallyCoverDense (S : Scheme.{u}) :
    (AffineOver.forget S).LocallyCoverDense (bigPhSite S) :=
  bigAffinePhInclusion_isLocallyCoverDense S

/-- The pretopology of finite `ph` covering families on affine schemes over
`S`. -/
abbrev bigAffinePhPretopology (S : Scheme.{u}) : Pretopology S.AffineOver :=
  affineOverPretopology S (bigPhSite S) ⊓ Pretopology.finite S.AffineOver

/-- The precoverage of families on affine schemes over `S` that are both
covering for the restricted big `ph` topology and finite. -/
abbrev bigAffinePhPrecoverage (S : Scheme.{u}) : Precoverage S.AffineOver :=
  affineOverPrecoverage S (bigPhSite S) ⊓ Precoverage.finite S.AffineOver

/-- A presieve covers in the big affine `ph` precoverage exactly when its image
under the affine inclusion covers in the big `ph` slice and it has finitely
many arrows. -/
@[simp]
theorem mem_bigAffinePhPrecoverage_iff (S : Scheme.{u})
    {U : S.AffineOver} {R : Presieve U} :
    R ∈ bigAffinePhPrecoverage S U ↔
      R.map (AffineOver.forget S) ∈ (bigPhSite S).toPrecoverage U.obj ∧
        R.uncurry.Finite := sorry

/-- A finite indexed affine family covers in the big affine `ph` precoverage
exactly when its underlying family covers in the big `ph` slice. -/
@[simp]
theorem ofArrows_mem_bigAffinePhPrecoverage_iff (S : Scheme.{u})
    {U : S.AffineOver} {ι : Type v} [Finite ι] (Y : ι → S.AffineOver)
    (π : ∀ i, Y i ⟶ U) :
    Presieve.ofArrows Y π ∈ bigAffinePhPrecoverage S U ↔
      Presieve.ofArrows (fun i ↦ (Y i).obj) (fun i ↦ AffineOver.hom (π i)) ∈
        (bigPhSite S).toPrecoverage U.obj := sorry

/-- The Grothendieck topology on affine schemes over `S` induced by the big
`ph` slice topology. -/
abbrev bigAffinePhTopology (S : Scheme.{u}) : GrothendieckTopology S.AffineOver :=
  affineOverTopology S (bigPhSite S)

/-- The canonical affine `ph` topology is generated by finite affine `ph`
covering families. -/
theorem bigAffinePhTopology_def (S : Scheme.{u}) :
    bigAffinePhTopology S = (bigAffinePhPrecoverage S).toGrothendieck := sorry

/-- The underlying precoverage of the finite affine `ph` pretopology is the
finite affine `ph` precoverage. -/
theorem bigAffinePhPretopology_toPrecoverage (S : Scheme.{u}) :
    (bigAffinePhPretopology S).toPrecoverage = bigAffinePhPrecoverage S := sorry

/-- The topology generated by the finite affine `ph` pretopology is the
canonical restricted big affine `ph` topology. -/
theorem bigAffinePhPretopology_toGrothendieck (S : Scheme.{u}) :
    (bigAffinePhPretopology S).toGrothendieck = bigAffinePhTopology S := sorry

end AlgebraicGeometry.Scheme
