module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Data.Complex.Basic
public import Mathlib.Data.Fin.VecNotation
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Spectrum.Prime.RingHom
public import Mathlib.RingTheory.Spectrum.Prime.Topology

@[expose] public section

noncomputable section

open MvPolynomial PrimeSpectrum

namespace FermatCubic

/-- The Fermat cubic polynomial `s³ + t³ - 1` in two variables over `ℂ`. -/
def fermatPoly : MvPolynomial (Fin 2) ℂ :=
  X 0 ^ 3 + X 1 ^ 3 - 1

/-- The principal ideal generated by the Fermat cubic. -/
def fermatIdeal : Ideal (MvPolynomial (Fin 2) ℂ) :=
  Ideal.span {fermatPoly}

/-- The coordinate ring `ℂ[s, t] / (s³ + t³ - 1)`. -/
abbrev FermatCoordinateRing : Type :=
  MvPolynomial (Fin 2) ℂ ⧸ fermatIdeal

/-- The class of the `i`-th coordinate in the Fermat coordinate ring. -/
def fermatCoord (i : Fin 2) : FermatCoordinateRing :=
  Ideal.Quotient.mk fermatIdeal (X i)

/-- The map sending `x` to `s²` and `y` to `t²`. -/
def fermatHom : MvPolynomial (Fin 2) ℂ →ₐ[ℂ] FermatCoordinateRing :=
  aeval ![fermatCoord 0 ^ 2, fermatCoord 1 ^ 2]

/-- The elimination polynomial `(1 + x³ - y³)² - 4 x³`. -/
def fermatImagePoly : MvPolynomial (Fin 2) ℂ :=
  (1 + X 0 ^ 3 - X 1 ^ 3) ^ 2 - 4 * X 0 ^ 3

end FermatCubic

/-- The image of the Fermat parametrization is the zero locus of `fermatImagePoly`. -/
theorem fermatHom_comap_range :
    Set.range (comap FermatCubic.fermatHom.toRingHom) =
      PrimeSpectrum.zeroLocus
        ({FermatCubic.fermatImagePoly} : Set (MvPolynomial (Fin 2) ℂ)) := sorry
