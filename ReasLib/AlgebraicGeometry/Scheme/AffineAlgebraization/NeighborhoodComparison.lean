@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite
open AlgebraicGeometry
open SheafOfModules.RingedSite.IdealSheaf
open localCohomology

noncomputable section

universe u

namespace AlgebraicGeometry.AffineAlgebraizationSetup

variable {A : Type u} [CommRing A] [IsNoetherianRing A]

/-- The principal ideal generated by `f` is contained in `𝔞` when `f ∈ 𝔞`. -/
theorem principalIdeal_le (𝔞 : Ideal A) {f : A} (hf : f ∈ 𝔞) :
    Ideal.span {f} ≤ 𝔞 := sorry

/-- The affine algebraization setup with closed-fiber ideal `(f)` and deleted ideal `𝔞`. -/
def ofPrincipal (𝔞 : Ideal A) (f : A) (hf : f ∈ 𝔞) : AffineAlgebraizationSetup A :=
  ofIdeals (Ideal.span {f}) 𝔞 (principalIdeal_le 𝔞 hf)

/-- `ofPrincipal 𝔞 f hf` retains the principal ideal `(f)` and deleted ideal `𝔞`. -/
theorem ofPrincipal_spec (𝔞 : Ideal A) (f : A) (hf : f ∈ 𝔞) :
    (ofPrincipal 𝔞 f hf).I = Ideal.span {f} ∧ (ofPrincipal 𝔞 f hf).a = 𝔞 := sorry

/-- The ideal of a setup restricted to its open complement. -/
abbrev idealOnOpen (S : AffineAlgebraizationSetup A) : S.U.toScheme.IdealSheafData :=
  (Scheme.idealSheafDataOfIdealOnSpec S.I).comap S.U.ι

/-- The restricted ideal is the pullback of the ideal defining the closed fiber. -/
theorem idealOnOpen_def (S : AffineAlgebraizationSetup A) :
    idealOnOpen S = (Scheme.idealSheafDataOfIdealOnSpec S.I).comap S.U.ι := sorry

/-- The open neighborhoods of the restricted closed fiber inside the open complement. -/
abbrev OpenNeighborhoods (S : AffineAlgebraizationSetup A) :=
  { V : S.U.toScheme.Opens // ((idealOnOpen S).support : Set S.U) ⊆ V }

/-- Every member of `OpenNeighborhoods S` contains the restricted closed fiber. -/
theorem OpenNeighborhoods.contains (S : AffineAlgebraizationSetup A)
    (V : OpenNeighborhoods S) : ((idealOnOpen S).support : Set S.U) ⊆ V := sorry

/-- The diagram of sections over open neighborhoods of the restricted closed fiber. -/
abbrev neighborhoodSectionsDiagram (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) : (OpenNeighborhoods S)ᵒᵖ ⥤ Type u :=
  (OrderHom.Subtype.val
      (fun V : S.U.toScheme.Opens ↦ ((idealOnOpen S).support : Set S.U) ⊆ V)).toFunctor.op ⋙
    M.val.presheaf ⋙ CategoryTheory.forget AddCommGrpCat

/-- At a neighborhood `V`, the neighborhood diagram is the section type of `M` over `V`. -/
theorem neighborhoodSectionsDiagram_obj (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) (V : (OpenNeighborhoods S)ᵒᵖ) :
    (neighborhoodSectionsDiagram S M).obj V = M.val.obj (op V.unop.val) := sorry

/-- At ideal power `n`, the diagram of quotient sections over all open neighborhoods. -/
abbrev neighborhoodQuotientSectionsDiagram (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) (n : ℕ) : (OpenNeighborhoods S)ᵒᵖ ⥤ Type u :=
  (OrderHom.Subtype.val
      (fun V : S.U.toScheme.Opens ↦ ((idealOnOpen S).support : Set S.U) ⊆ V)).toFunctor.op ⋙
    (PowerQuotientModule.stage.{u, u, u}
      (idealOnOpen S).toSubobject M n).val.presheaf ⋙
    CategoryTheory.forget AddCommGrpCat

/-- The quotient-section diagram evaluates to the corresponding stage sections. -/
theorem neighborhoodQuotientSectionsDiagram_obj (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) (n : ℕ) (V : (OpenNeighborhoods S)ᵒᵖ) :
    (neighborhoodQuotientSectionsDiagram S M n).obj V =
      (PowerQuotientModule.stage.{u, u, u}
        (idealOnOpen S).toSubobject M n).val.obj (op V.unop.val) := sorry

/-- Quotient projection on neighborhood sections commutes with restriction. -/
theorem neighborhoodQuotientProjection_naturality
    (S : AffineAlgebraizationSetup A) (M : S.U.toScheme.Modules) (n : ℕ)
    {V W : (OpenNeighborhoods S)ᵒᵖ} (g : V ⟶ W) :
    (neighborhoodSectionsDiagram S M).map g ≫
        ↾((PowerQuotientModule.projection.{u, u, u}
          (idealOnOpen S).toSubobject M n).val.app (op W.unop.val)) =
      ↾((PowerQuotientModule.projection.{u, u, u}
          (idealOnOpen S).toSubobject M n).val.app (op V.unop.val)) ≫
        (neighborhoodQuotientSectionsDiagram S M n).map g := sorry

/-- The natural transformation on neighborhood sections induced by `M ⟶ M / I ^ n M`. -/
def neighborhoodQuotientProjection (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) (n : ℕ) :
    neighborhoodSectionsDiagram S M ⟶ neighborhoodQuotientSectionsDiagram S M n where
  app V :=
    ↾((PowerQuotientModule.projection.{u, u, u}
      (idealOnOpen S).toSubobject M n).val.app (op V.unop.val))
  naturality _ _ g := neighborhoodQuotientProjection_naturality S M n g

/-- The component of `neighborhoodQuotientProjection` is the quotient map on sections. -/
theorem neighborhoodQuotientProjection_app (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) (n : ℕ) (V : (OpenNeighborhoods S)ᵒᵖ) :
    (neighborhoodQuotientProjection S M n).app V =
      ↾((PowerQuotientModule.projection.{u, u, u}
        (idealOnOpen S).toSubobject M n).val.app (op V.unop.val)) := sorry

/-- The ideal-power transition on neighborhood sections commutes with restriction. -/
theorem neighborhoodQuotientTransition_naturality
    (S : AffineAlgebraizationSetup A) (M : S.U.toScheme.Modules) (n : ℕ)
    {V W : (OpenNeighborhoods S)ᵒᵖ} (g : V ⟶ W) :
    (neighborhoodQuotientSectionsDiagram S M (n + 1)).map g ≫
        ↾((PowerQuotientModule.step.{u, u, u}
          (idealOnOpen S).toSubobject M n).val.app (op W.unop.val)) =
      ↾((PowerQuotientModule.step.{u, u, u}
          (idealOnOpen S).toSubobject M n).val.app (op V.unop.val)) ≫
        (neighborhoodQuotientSectionsDiagram S M n).map g := sorry

/-- The natural transformation induced by `M / I ^ (n + 1) M ⟶ M / I ^ n M`. -/
def neighborhoodQuotientTransition (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) (n : ℕ) :
    neighborhoodQuotientSectionsDiagram S M (n + 1) ⟶
      neighborhoodQuotientSectionsDiagram S M n where
  app V :=
    ↾((PowerQuotientModule.step.{u, u, u}
      (idealOnOpen S).toSubobject M n).val.app (op V.unop.val))
  naturality _ _ g := neighborhoodQuotientTransition_naturality S M n g

/-- The component of `neighborhoodQuotientTransition` is the ideal-power transition. -/
theorem neighborhoodQuotientTransition_app (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) (n : ℕ) (V : (OpenNeighborhoods S)ᵒᵖ) :
    (neighborhoodQuotientTransition S M n).app V =
      ↾((PowerQuotientModule.step.{u, u, u}
        (idealOnOpen S).toSubobject M n).val.app (op V.unop.val)) := sorry

/-- The transition between neighborhood colimits of consecutive ideal-power quotients. -/
noncomputable def neighborhoodQuotientColimitStep (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) (n : ℕ) :
    colimit (neighborhoodQuotientSectionsDiagram S M (n + 1)) ⟶
      colimit (neighborhoodQuotientSectionsDiagram S M n) :=
  colimMap (neighborhoodQuotientTransition S M n)

/-- The colimit transition is induced by the quotient transition. -/
theorem neighborhoodQuotientColimitStep_def (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) (n : ℕ) :
    neighborhoodQuotientColimitStep S M n =
      colimMap (neighborhoodQuotientTransition S M n) := sorry

/-- The positive ideal-power inverse system formed from neighborhood quotient sections. -/
noncomputable def positiveNeighborhoodSectionsSystem (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) : SequentialInverseSystem (Type u) :=
  SequentialInverseSystem.shift
    (Functor.ofOpSequence
      (X := fun n ↦ colimit (neighborhoodQuotientSectionsDiagram S M n))
      (neighborhoodQuotientColimitStep S M)) 1

/-- Stage `n` is the neighborhood colimit of the `(n + 1)`st quotient sections. -/
theorem positiveNeighborhoodSectionsSystem_obj (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) (n : ℕ) :
    (positiveNeighborhoodSectionsSystem S M).obj (op n) =
      colimit (neighborhoodQuotientSectionsDiagram S M (n + 1)) := sorry

/-- The quotient projections induce the map to stage `n` of the positive system. -/
noncomputable def neighborhoodSectionsProjection (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) (n : ℕ) :
    ((Functor.const ℕᵒᵖ).obj (colimit (neighborhoodSectionsDiagram S M))).obj (op n) ⟶
      (positiveNeighborhoodSectionsSystem S M).obj (op n) :=
  colimMap (neighborhoodQuotientProjection S M (1 + n))

/-- The neighborhood-section projections commute with ideal-power transitions. -/
theorem neighborhoodSectionsProjection_naturality (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) (n : ℕ) :
    ((Functor.const ℕᵒᵖ).obj (colimit (neighborhoodSectionsDiagram S M))).map
          (homOfLE (Nat.le_add_right n 1)).op ≫ neighborhoodSectionsProjection S M n =
      neighborhoodSectionsProjection S M (n + 1) ≫
        (positiveNeighborhoodSectionsSystem S M).map
          (homOfLE (Nat.le_add_right n 1)).op := sorry

/-- The canonical cone from neighborhood sections to the positive quotient system. -/
noncomputable def neighborhoodSectionsCone (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) : Cone (positiveNeighborhoodSectionsSystem S M) where
  pt := colimit (neighborhoodSectionsDiagram S M)
  π := NatTrans.ofOpSequence (neighborhoodSectionsProjection S M)
    (neighborhoodSectionsProjection_naturality S M)

/-- The cone legs are the canonical neighborhood quotient projections. -/
theorem neighborhoodSectionsCone_π (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) :
    (neighborhoodSectionsCone S M).π =
      NatTrans.ofOpSequence (neighborhoodSectionsProjection S M)
        (neighborhoodSectionsProjection_naturality S M) := sorry

/-- The canonical comparison from neighborhood sections to the infinitesimal inverse limit. -/
noncomputable def neighborhoodComparison (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) :
    colimit (neighborhoodSectionsDiagram S M) ⟶
      limit (positiveNeighborhoodSectionsSystem S M) :=
  limit.lift (positiveNeighborhoodSectionsSystem S M) (neighborhoodSectionsCone S M)

/-- Every limit projection of the comparison is the corresponding quotient projection. -/
theorem neighborhoodComparison_fac (S : AffineAlgebraizationSetup A)
    (M : S.U.toScheme.Modules) (n : ℕ) :
    neighborhoodComparison S M ≫
        limit.π (positiveNeighborhoodSectionsSystem S M) (op n) =
      neighborhoodSectionsProjection S M n := sorry

/-- The neighborhood presentation for the principal setup is isomorphic to the corresponding
global-section system of positive ideal-power quotients. -/
theorem positiveNeighborhoodSectionsSystem_isomorphic_positiveSectionsSystem
    (𝔞 : Ideal A) (f : A) (hf : f ∈ 𝔞)
    (M : (ofPrincipal 𝔞 f hf).U.toScheme.Modules) :
    IsIsomorphic (positiveNeighborhoodSectionsSystem (ofPrincipal 𝔞 f hf) M)
      (Scheme.CoherentCompletion.positiveSectionsSystem
        (idealOnOpen (ofPrincipal 𝔞 f hf)) M) := sorry

/-- Under principal completeness, regularity, and local-cohomology finiteness, the
neighborhood-section comparison map is bijective. -/
theorem neighborhoodComparison_bijective_of_principal
    (𝔞 : Ideal A) (f : A) (hf : f ∈ 𝔞)
    (M : ModuleCat A) [Module.Finite A M]
    [IsAdicComplete (Ideal.span {f}) A]
    (h_regular : IsSMulRegular M f)
    [Module.Finite A
      ((localCohomology 𝔞 1).obj
        (ModuleCat.of A
          (M ⧸ (Ideal.span {f} • (⊤ : Submodule A M)))))] :
    Function.Bijective
      (neighborhoodComparison
        (ofPrincipal 𝔞 f hf)
        ((AlgebraicGeometry.tilde M).restrict
          (ofPrincipal 𝔞 f hf).U.ι)) := sorry

end AlgebraicGeometry.AffineAlgebraizationSetup
