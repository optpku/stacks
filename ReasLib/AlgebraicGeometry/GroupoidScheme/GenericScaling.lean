module

public import Mathlib.Algebra.MvPolynomial.Equiv
public import Mathlib.FieldTheory.RatFunc.AsPolynomial
public import Mathlib.RingTheory.Localization.Basic
public import ReasLib.Algebra.Module.Graded.NatToInt.GradedAlgebra
public import ReasLib.AlgebraicGeometry.GroupoidScheme.Action
public import ReasLib.AlgebraicGeometry.GroupoidScheme.Dimension
public import ReasLib.AlgebraicGeometry.GroupoidScheme.Restriction
public import ReasLib.AlgebraicGeometry.Scheme.OverSpec
public import ReasLib.AlgebraicGeometry.Scheme.Spec.GradedAction
public import ReasLib.RingTheory.MvPolynomial.StandardGrading

/-!
# Generic restriction of the scaling groupoid

This module constructs the restriction of the standard multiplicative-group action on the
affine line over `ℚ` to the generic point.  Its arrow scheme has an explicit localization
presentation whose dimension differs from that of the stabilizer.
-/

@[expose] public section

open CategoryTheory Limits MonoidalCategory CartesianMonoidalCategory MonObj ModObj
  TopologicalSpace
open scoped AlgebraicGeometry

noncomputable section

namespace AlgebraicGeometry.GenericScaling

/-- The usual nonnegative grading on the affine-line coordinate ring, extended by zero to
integer degrees. -/
abbrev gradingOverRat (d : ℤ) : Submodule ℚ (MvPolynomial PUnit ℚ) :=
  DirectSum.Decomposition.natToIntGrading
    (MvPolynomial.standardGrading PUnit ℚ) d

/-- The integer grading used to construct the integral scaling action. -/
abbrev grading (d : ℤ) : Submodule ℤ (MvPolynomial PUnit ℚ) :=
  (gradingOverRat d).restrictScalars ℤ

/-- In nonnegative degree, `grading` is the restricted standard homogeneous piece. -/
theorem grading_of_nonneg (d : ℤ) (hd : 0 ≤ d) :
    grading d =
      (MvPolynomial.standardGrading PUnit ℚ d.toNat).restrictScalars ℤ := sorry

/-- Every negative-degree piece of `grading` is zero. -/
theorem grading_of_neg (d : ℤ) (hd : d < 0) : grading d = ⊥ := sorry

/-- The polynomial `P(xy)` in `RatFunc ℚ[y]`. -/
def denominator (P : Polynomial ℚ) : Polynomial (RatFunc ℚ) :=
  Polynomial.eval₂ (algebraMap ℚ (Polynomial (RatFunc ℚ)))
    (Polynomial.C RatFunc.X * Polynomial.X) P

/-- Evaluation of `denominator` is the formula `P(xy)`. -/
theorem denominator_apply (P : Polynomial ℚ) :
    denominator P = Polynomial.eval₂ (algebraMap ℚ (Polynomial (RatFunc ℚ)))
      (Polynomial.C RatFunc.X * Polynomial.X) P := sorry

/-- The multiplicative system generated by all `P(xy)` for nonzero `P ∈ ℚ[T]`. -/
def denominators : Submonoid (Polynomial (RatFunc ℚ)) :=
  Submonoid.closure {f | ∃ P : Polynomial ℚ, P ≠ 0 ∧ f = denominator P}

/-- Every nonzero `P` contributes the generator `P(xy)` to `denominators`. -/
theorem denominator_mem_denominators (P : Polynomial ℚ) (hP : P ≠ 0) :
    denominator P ∈ denominators := sorry

/-- The coordinate ring `ℚ(x)[y][1/P(xy) | 0 ≠ P ∈ ℚ[T]]`. -/
abbrev arrowRing := Localization denominators

/-- The canonical map from `RatFunc ℚ[y]` to the localized arrow ring. -/
def arrowRingMap : Polynomial (RatFunc ℚ) →+* arrowRing :=
  algebraMap (Polynomial (RatFunc ℚ)) arrowRing

/-- Every designated denominator becomes a unit in `arrowRing`. -/
theorem arrowRingMap_denominator_isUnit (P : Polynomial ℚ) (hP : P ≠ 0) :
    IsUnit (arrowRingMap (denominator P)) := sorry

/-- The coordinate-ring map `ℚ[x] → ℚ(x)` defining the generic point. -/
def genericPointRingHom : MvPolynomial PUnit ℚ →+* RatFunc ℚ :=
  (algebraMap (Polynomial ℚ) (RatFunc ℚ)).comp
    (MvPolynomial.uniqueAlgEquiv ℚ PUnit).toRingHom

/-- The generic point, regarded over the integral base used by the graded action. -/
def genericPoint : Over (Spec (CommRingCat.of (ULift ℤ))) :=
  Scheme.OverSpec.affine (CommRingCat.ofHom (algebraMap (ULift ℤ) (RatFunc ℚ)))

/-- The scheme map induced by `genericPointRingHom` is compatible with the integral base maps. -/
theorem genericPointMap_over :
    Spec.map (CommRingCat.ofHom genericPointRingHom) ≫
        (Scheme.OverSpec.affine
          (CommRingCat.ofHom (algebraMap (ULift ℤ) (MvPolynomial PUnit ℚ)))).hom =
      genericPoint.hom := sorry

/-- The generic-point morphism `Spec(ℚ(x)) ⟶ 𝔸¹_ℚ`, over the integral base. -/
def genericPointMap :
    genericPoint ⟶
      Scheme.OverSpec.affine
        (CommRingCat.ofHom (algebraMap (ULift ℤ) (MvPolynomial PUnit ℚ))) :=
  Over.homMk (Spec.map (CommRingCat.ofHom genericPointRingHom)) genericPointMap_over

/-- The underlying map of `genericPointMap` is induced by `genericPointRingHom`. -/
theorem genericPointMap_left :
    genericPointMap.left = Spec.map (CommRingCat.ofHom genericPointRingHom) := sorry

/-- The scaling action groupoid before restriction to the generic point. -/
@[reducible]
def actionGroupoid : GroupoidScheme (Spec (CommRingCat.of (ULift.{0} ℤ))) :=
  GroupoidScheme.ofAction (Grp.mk MultiplicativeGroup.overInt) (GradedSpec.action grading)

/-- The scaling-action groupoid restricted to the generic point `Spec(ℚ(x))`. -/
def groupoid : GroupoidScheme (Spec (CommRingCat.of (ULift ℤ))) :=
  GroupoidScheme.pullback actionGroupoid genericPointMap

/-- The object scheme of `groupoid` is `Spec(ℚ(x))`. -/
theorem groupoid_U : groupoid.U.left = Spec (CommRingCat.of (RatFunc ℚ)) := sorry

/-- The source copy of `RatFunc ℚ` in the displayed arrow ring. -/
def sourceRatFuncRingHom : RatFunc ℚ →+* arrowRing :=
  algebraMap (RatFunc ℚ) arrowRing

/-- The polynomial coordinate map that sends `x` to the target coordinate `xy`. -/
def targetPolynomialRingHom : Polynomial ℚ →+* arrowRing :=
  Polynomial.eval₂RingHom (algebraMap ℚ arrowRing)
    (arrowRingMap (Polynomial.C RatFunc.X * Polynomial.X))

/-- The target polynomial map is the substitution `P ↦ P(xy)`. -/
theorem targetPolynomialRingHom_apply (P : Polynomial ℚ) :
    targetPolynomialRingHom P = arrowRingMap (denominator P) := sorry

/-- Every nonzero polynomial maps to a unit under the target-coordinate substitution. -/
theorem targetPolynomialRingHom_nonzero_isUnit :
    ∀ P : nonZeroDivisors (Polynomial ℚ), IsUnit (targetPolynomialRingHom P) := sorry

/-- The target copy of `RatFunc ℚ` in the arrow ring, obtained by `x ↦ xy`. -/
def targetRatFuncRingHom : RatFunc ℚ →+* arrowRing :=
  IsLocalization.lift targetPolynomialRingHom_nonzero_isUnit

/-- The distinguished denominator `xy` used to write the inverse of the scaling coordinate. -/
def scalingDenominator : denominators :=
  ⟨denominator Polynomial.X,
    denominator_mem_denominators Polynomial.X Polynomial.X_ne_zero⟩

/-- The explicit inverse `x/(xy)` of the scaling coordinate `y`. -/
def scalingCoordinateInv : arrowRing :=
  IsLocalization.mk' arrowRing (Polynomial.C RatFunc.X) scalingDenominator

/-- Multiplying the scaling coordinate by `x/(xy)` gives one. -/
theorem scalingCoordinate_mul_inv :
    arrowRingMap Polynomial.X * scalingCoordinateInv = 1 := sorry

/-- Multiplying `x/(xy)` by the scaling coordinate gives one. -/
theorem scalingCoordinate_inv_mul :
    scalingCoordinateInv * arrowRingMap Polynomial.X = 1 := sorry

/-- The scaling coordinate `y` in the displayed localization, with explicit inverse `x/(xy)`. -/
def arrowRingScalingUnit : arrowRingˣ where
  val := arrowRingMap Polynomial.X
  inv := scalingCoordinateInv
  val_inv := scalingCoordinate_mul_inv
  inv_val := scalingCoordinate_inv_mul

/-- The displayed affine model of the restricted arrow scheme over the integral base. -/
def arrowModel : Over (Spec (CommRingCat.of (ULift ℤ))) :=
  Scheme.OverSpec.affine (CommRingCat.ofHom (algebraMap (ULift ℤ) arrowRing))

/-- The source-coordinate morphism from the displayed arrow model to the generic point. -/
def arrowModelSourceLeft : arrowModel.left ⟶ genericPoint.left :=
  Spec.map (CommRingCat.ofHom sourceRatFuncRingHom)

/-- The source-coordinate morphism respects the integral structure maps. -/
theorem arrowModelSourceLeft_over :
    arrowModelSourceLeft ≫ genericPoint.hom = arrowModel.hom := sorry

/-- The source-coordinate morphism as a morphism over the integral base. -/
def arrowModelSource : arrowModel ⟶ genericPoint :=
  Over.homMk arrowModelSourceLeft arrowModelSourceLeft_over

/-- The target-coordinate morphism from the displayed arrow model to the generic point. -/
def arrowModelTargetLeft : arrowModel.left ⟶ genericPoint.left :=
  Spec.map (CommRingCat.ofHom targetRatFuncRingHom)

/-- The target-coordinate morphism respects the integral structure maps. -/
theorem arrowModelTargetLeft_over :
    arrowModelTargetLeft ≫ genericPoint.hom = arrowModel.hom := sorry

/-- The target-coordinate morphism as a morphism over the integral base. -/
def arrowModelTarget : arrowModel ⟶ genericPoint :=
  Over.homMk arrowModelTargetLeft arrowModelTargetLeft_over

/-- The morphism from the displayed arrow model to `Gₘ` defined by its scaling unit. -/
def arrowModelScalingLeft : arrowModel.left ⟶ MultiplicativeGroup.overInt.left :=
  Spec.map (MultiplicativeGroup.ringHomOfUnit
    (CommRingCat.of arrowRing) arrowRingScalingUnit)

/-- The scaling-coordinate morphism respects the integral structure maps. -/
theorem arrowModelScalingLeft_over :
    arrowModelScalingLeft ≫ MultiplicativeGroup.overInt.hom = arrowModel.hom := sorry

/-- The scaling-coordinate morphism as a morphism over the integral base. -/
def arrowModelScaling : arrowModel ⟶ MultiplicativeGroup.overInt :=
  Over.homMk arrowModelScalingLeft arrowModelScalingLeft_over

/-- The displayed arrow maps to the original action arrow by its scaling and source coordinates. -/
def arrowModelToAction : arrowModel ⟶ actionGroupoid.R :=
  lift arrowModelScaling (arrowModelSource ≫ genericPointMap)

/-- The displayed target and source coordinates give a map to the product of generic points. -/
def arrowModelEndpoints : arrowModel ⟶ genericPoint ⨯ genericPoint :=
  prod.lift arrowModelTarget arrowModelSource

/-- The action arrow and endpoint maps satisfy the pullback compatibility equation. -/
theorem arrowModelToRestricted_condition :
    arrowModelToAction ≫ actionGroupoid.toPreRelation.hom =
      arrowModelEndpoints ≫ prod.map genericPointMap genericPointMap := sorry

/-- The explicit morphism from the displayed affine model to the restricted arrow scheme. -/
def arrowModelToRestricted : arrowModel ⟶ groupoid.R :=
  Limits.pullback.lift arrowModelToAction arrowModelEndpoints
    arrowModelToRestricted_condition

/-- The inverse-coordinate morphism underlying the displayed arrow-scheme isomorphism. -/
def arrowComparisonInv : Spec (CommRingCat.of arrowRing) ⟶ groupoid.R.left :=
  arrowModelToRestricted.left

/-- The canonical projection from a restricted arrow to the original action arrow. -/
def arrowProjection : groupoid.R ⟶ actionGroupoid.R :=
  GroupoidScheme.pullbackArrow actionGroupoid genericPointMap

/-- A restricted arrow remembers its scaling coordinate in `Gₘ`. -/
def arrowToMultiplicativeGroup : groupoid.R.left ⟶ MultiplicativeGroup.overInt.left :=
  (arrowProjection ≫ fst MultiplicativeGroup.overInt (GradedSpec.action grading).X).left

/-- Pullback of rational functions along the source map of the restricted groupoid. -/
def sourceCoordinateRingHom : RatFunc ℚ →+* Γ(groupoid.R.left, ⊤) :=
  let sourceMap := groupoid.s.left
  ((Scheme.ΓSpecIso (CommRingCat.of (RatFunc ℚ))).inv ≫ sourceMap.appTop).hom

/-- The invertible scaling coordinate on the restricted arrow scheme. -/
def scalingCoordinateUnit : Γ(groupoid.R.left, ⊤)ˣ :=
  MultiplicativeGroup.ringHomToUnit Γ(groupoid.R.left, ⊤)
    ((Scheme.ΓSpecIso
      (CommRingCat.of (LaurentPolynomial (ULift ℤ)))).inv ≫
        arrowToMultiplicativeGroup.appTop)

/-- The map `RatFunc ℚ[y] → Γ(groupoid.R, 𝒪)` sending `y` to the scaling coordinate. -/
def polynomialCoordinateRingHom :
    Polynomial (RatFunc ℚ) →+* Γ(groupoid.R.left, ⊤) :=
  Polynomial.eval₂RingHom sourceCoordinateRingHom scalingCoordinateUnit

/-- The coordinate map sends each generator of `denominators` to a unit. -/
theorem polynomialCoordinateRingHom_denominators :
    ∀ y : denominators, IsUnit (polynomialCoordinateRingHom y) := sorry

/-- The coordinate map from the displayed localization to the restricted arrow scheme. -/
def arrowCoordinateRingHom : arrowRing →+* Γ(groupoid.R.left, ⊤) :=
  IsLocalization.lift polynomialCoordinateRingHom_denominators

/-- The canonical morphism from the restricted arrow scheme to its displayed affine model. -/
def arrowComparisonHom : groupoid.R.left ⟶ Spec (CommRingCat.of arrowRing) :=
  (Scheme.homToSpecGlobalSectionsEquiv groupoid.R.left
    (CommRingCat.of arrowRing)).symm (CommRingCat.ofHom arrowCoordinateRingHom)

/-- The forward comparison followed by the inverse comparison is the identity. -/
theorem arrowComparison_hom_inv_id :
    arrowComparisonHom ≫ arrowComparisonInv = 𝟙 groupoid.R.left := sorry

/-- The inverse comparison followed by the forward comparison is the identity. -/
theorem arrowComparison_inv_hom_id :
    arrowComparisonInv ≫ arrowComparisonHom =
      𝟙 (Spec (CommRingCat.of arrowRing)) := sorry

/-- The arrow scheme is the spectrum of
`ℚ(x)[y][1/P(xy) | 0 ≠ P ∈ ℚ[T]]`. -/
def arrowIso : groupoid.R.left ≅ Spec (CommRingCat.of arrowRing) where
  hom := arrowComparisonHom
  inv := arrowComparisonInv
  hom_inv_id := arrowComparison_hom_inv_id
  inv_hom_id := arrowComparison_inv_hom_id

/-- The forward map of `arrowIso` is the coordinate morphism induced by `P(xy)`. -/
theorem arrowIso_hom : arrowIso.hom = arrowComparisonHom := sorry

/-- The arrow scheme has topological Krull dimension one. -/
theorem arrowDimension : topologicalKrullDim groupoid.R.left = 1 := sorry

/-- The stabilizer of the generic point has topological Krull dimension zero. -/
theorem stabilizerDimension :
    topologicalKrullDim groupoid.stabilizer.X.left.left = 0 := sorry

/-- The arrow scheme and the stabilizer have unequal topological Krull dimensions. -/
theorem dimensionEqualityFails :
    topologicalKrullDim groupoid.R.left ≠
      topologicalKrullDim groupoid.stabilizer.X.left.left := sorry

/-- The source and target maps of the restricted scaling groupoid cannot both be locally of
finite type. -/
theorem not_bothLocallyOfFiniteType :
    ¬ (LocallyOfFiniteType groupoid.s.left ∧ LocallyOfFiniteType groupoid.t.left) := sorry

end AlgebraicGeometry.GenericScaling

end
