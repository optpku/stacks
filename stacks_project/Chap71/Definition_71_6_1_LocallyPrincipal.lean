module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.ClosedSubspace.LocallyPrincipal
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.LocalGeneration
public import stacks_project.Chap65.Definition_65_12_1_Subspace
public import stacks_project.Chap67.Lemma_67_28_12_IdealSheaf

/-!
# Locally principal closed subspaces of algebraic spaces

A closed immersion of algebraic spaces is locally principal when its associated
ideal sheaf on the small étale site is locally generated by one section.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.AlgebraicSpace

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

/-- A locally principal closed subspace is a locally principal morphism of algebraic spaces. -/
abbrev IsLocallyPrincipalClosedSubspace {S : Scheme.{u}} {D X : AlgebraicSpace S}
    (i : D ⟶ X) : Prop :=
  IsLocallyPrincipal i

end AlgebraicGeometry.AlgebraicSpace

#check
  (AlgebraicGeometry.AlgebraicSpace.IsLocallyPrincipal :
    {S : Scheme.{u}} → {D X : AlgebraicSpace S} → (D ⟶ X) → Prop)

#check
  (AlgebraicGeometry.AlgebraicSpace.isLocallyPrincipal_iff :
    ∀ {S : Scheme.{u}} {D X : AlgebraicSpace S} (i : D ⟶ X),
      IsLocallyPrincipal i ↔
        IsClosedImmersion i ∧
          SheafOfModules.IsLocallyGeneratedBy (Hom.idealSheaf i) 1)

#check
  (AlgebraicGeometry.AlgebraicSpace.IsLocallyPrincipal.idealSheaf_isLocallyGeneratedBy_one :
    ∀ {S : Scheme.{u}} {D X : AlgebraicSpace S} {i : D ⟶ X}
      [IsLocallyPrincipal i],
      SheafOfModules.IsLocallyGeneratedBy (Hom.idealSheaf i) 1)

#check
  (AlgebraicGeometry.AlgebraicSpace.IsLocallyPrincipal.id :
    ∀ {S : Scheme.{u}} {X : AlgebraicSpace S},
      IsLocallyPrincipal (𝟙 X))

#check
  (AlgebraicGeometry.AlgebraicSpace.ClosedSubspace.isLocallyPrincipalClosedSubspace_iff :
    ∀ {S : Scheme.{u}} {X : AlgebraicSpace S} (Z : ClosedSubspace X),
      IsLocallyPrincipal Z.ι ↔
        SheafOfModules.IsLocallyGeneratedBy (Hom.idealSheaf Z.ι) 1)
