module

public import Mathlib.Algebra.Category.Ring.Adjunctions
public import Mathlib.CategoryTheory.Comma.Over.Pullback
public import ReasLib.CategoryTheory.Adjunction.Iteration
import Mathlib.Tactic.CrossRefAttribute

/-!
# Free commutative algebras under a ring

This file identifies the categorical free algebra obtained from `Under.costar` and the ordinary
multivariable-polynomial algebra.  It is independent of sheaves, spaces, or stalks.
-/

@[expose] public section

open CategoryTheory
open scoped CategoryTheory.IteratedEndofunctor

noncomputable section

universe u

namespace CommRingCat.Under.FreeAlgebra

variable (A : CommRingCat.{u}) (E : Type u)

/-- The free commutative-algebra functor into the category of rings under `A`. -/
@[stacks 00FQ "free commutative algebra functor under a fixed ring"]
noncomputable abbrev functor : Type u ⥤ Under A :=
  CommRingCat.free ⋙ Under.costar A

/-- The carrier functor of rings under `A`, landing in types. -/
@[stacks 00FQ "carrier functor for rings under a fixed ring"]
noncomputable abbrev carrier : Under A ⥤ Type u :=
  Under.forget A ⋙ CategoryTheory.forget CommRingCat.{u}

/-- The free-forgetful adjunction for commutative algebras under `A`. -/
@[stacks 00FQ "free-forgetful adjunction under a fixed ring"]
noncomputable abbrev adjunction : functor A ⊣ carrier A :=
  CommRingCat.adj.comp (Under.costarAdjForget A)

/-- The categorical free algebra over `A` generated by `E`. -/
@[stacks 00FQ "categorical free commutative algebra"]
noncomputable abbrev algebraic : Under A :=
  (functor A).obj E

/-- The multivariable-polynomial model of the free algebra over `A` generated by `E`. -/
@[stacks 00FQ "polynomial model of a free commutative algebra"]
noncomputable abbrev polynomial : Under A :=
  Under.mk (CommRingCat.ofHom
    (MvPolynomial.C : A →+* MvPolynomial E A))

/-- The universal generator of the categorical free algebra.  The generator type is implicit
because it is determined by the source of the map or by the element being generated. -/
@[stacks 00FQ "universal generator of a free commutative algebra"]
noncomputable def generator {E : Type u} :
    E ⟶ (CategoryTheory.forget CommRingCat.{u}).obj (algebraic A E).right :=
  (adjunction A).unit.app E

/-- The polynomial variable map, bundled as a morphism in `Type`. -/
@[stacks 00FQ "polynomial variables as a generator map"]
def polynomialGenerator :
    E ⟶ (CategoryTheory.forget CommRingCat.{u}).obj (polynomial A E).right :=
  TypeCat.ofHom (fun e : E ↦ (MvPolynomial.X e : MvPolynomial E A))

/-- Renaming polynomial variables preserves the structural map from the coefficient ring. -/
@[stacks 00FQ "polynomial renaming over the coefficient ring"]
theorem polynomialMap_base {X Y : Type u} (f : X ⟶ Y) :
    (polynomial A X).hom ≫
        CommRingCat.ofHom ((MvPolynomial.rename (R := A) f).toRingHom) =
      (polynomial A Y).hom := sorry

/-- The morphism of polynomial `A`-algebras induced by renaming variables. -/
@[stacks 00FQ "map of polynomial algebras on variables"]
noncomputable def polynomialMap {X Y : Type u} (f : X ⟶ Y) :
    polynomial A X ⟶ polynomial A Y :=
  Under.homMk
    (CommRingCat.ofHom ((MvPolynomial.rename (R := A) f).toRingHom))
    (polynomialMap_base A f)

/-- Polynomial-variable renaming preserves identity maps. -/
@[stacks 00FQ "identity law for polynomial variable maps"]
theorem polynomialMap_id (X : Type u) :
    polynomialMap A (𝟙 X) = 𝟙 (polynomial A X) := sorry

/-- Polynomial-variable renaming preserves composition. -/
@[stacks 00FQ "composition law for polynomial variable maps"]
theorem polynomialMap_comp {X Y Z : Type u} (f : X ⟶ Y) (g : Y ⟶ Z) :
    polynomialMap A (f ≫ g) = polynomialMap A f ≫ polynomialMap A g := sorry

/-- Multivariable polynomial algebras over `A`, functorial in the variable type. -/
@[stacks 00FQ "polynomial algebra functor over a fixed ring"]
noncomputable def polynomialFunctor : Type u ⥤ Under A where
  obj X := polynomial A X
  map f := polynomialMap A f
  map_id X := polynomialMap_id A X
  map_comp f g := polynomialMap_comp A f g

/-- Renaming variables sends each polynomial generator to the renamed generator. -/
@[simp, stacks 00FQ "polynomial variable map on generators"]
theorem polynomialMap_generator {X Y : Type u} (f : X ⟶ Y) (x : X) :
    (polynomialMap A f).right (polynomialGenerator A X x) =
      polynomialGenerator A Y (f x) := sorry

/-- The map of free `A`-algebras induced by a map of generator types. -/
@[stacks 00FQ "map of free commutative algebras on generators"]
noncomputable abbrev map {X Y : Type u} (f : X ⟶ Y) :
    algebraic A X ⟶ algebraic A Y :=
  (functor A).map f

/-- Naturality of the universal generator in the generator type. -/
@[stacks 00FQ "naturality of the universal free-algebra generator"]
theorem generator.naturality {X Y : Type u} (f : X ⟶ Y) :
    f ≫ (adjunction A).unit.app Y =
      (adjunction A).unit.app X ≫ (carrier A).map (map A f) := sorry

/-- A free-algebra map sends a universal generator to the corresponding generator. -/
@[simp, stacks 00FQ "free-algebra map on universal generators"]
theorem map_generator {X Y : Type u} (f : X ⟶ Y) (x : X) :
    (map A f).right (generator A (E := X) x) = generator A (E := Y) (f x) := sorry

/-- The endofunctor underlying the free-algebra comonad on rings under `A`. -/
@[stacks 00FQ "free commutative algebra comonad endofunctor"]
noncomputable abbrev comonadFunctor : Under A ⥤ Under A :=
  carrier A ⋙ functor A

/-- The iterated universal generator is the free-algebra specialization of the generic iterated
adjunction unit. -/
@[stacks 00FQ "iterated universal free-algebra generator"]
noncomputable abbrev generator.iterate (B : Under A) :
    (n : ℕ) → B.right → (((comonadFunctor A) ⁺⦋n⦌).obj B).right :=
  fun n ↦ CategoryTheory.Adjunction.unit.iterateApp (adjunction A) B n

/-- The zeroth iterated universal generator is the ordinary generator. -/
@[simp, stacks 00FQ "zeroth iterated universal generator"]
theorem generator.iterate_zero (B : Under A) (x : B.right) :
    generator.iterate (A := A) B 0 x = generator A (E := B.right) x := sorry

/-- The successor iterated universal generator adds one outer free bracket. -/
@[simp, stacks 00FQ "successor iterated universal generator"]
theorem generator.iterate_succ (B : Under A) (n : ℕ) (x : B.right) :
    generator.iterate (A := A) B (n + 1) x =
      generator A (E := _) (generator.iterate (A := A) B n x) := sorry

/-- The canonical map from the categorical free algebra to its polynomial model. -/
@[stacks 00FQ "categorical free algebra to polynomial model"]
noncomputable def toPolynomial : algebraic A E ⟶ polynomial A E :=
  ((Under.costarAdjForget A).homEquiv _ _).symm
    ((CommRingCat.adj.homEquiv _ _).symm (polynomialGenerator A E))

/-- The canonical comparison sends the universal free-algebra generator to the corresponding
polynomial variable. -/
@[simp, stacks 00FQ "free-algebra comparison on generators"]
theorem toPolynomial_generator (x : E) :
    (toPolynomial A E).right (generator A x) = polynomialGenerator A E x := sorry

/-- Evaluation at the categorical generator extends the coefficient map from `A`. -/
@[stacks 00FQ "polynomial evaluation extends the coefficient map"]
theorem fromPolynomial_base :
    (polynomial A E).hom ≫
        CommRingCat.ofHom
          (MvPolynomial.eval₂Hom (algebraic A E).hom.hom (generator A (E := E))) =
      (algebraic A E).hom := sorry

/-- The canonical evaluation map from the polynomial model to the categorical free algebra. -/
@[stacks 00FQ "polynomial model to categorical free algebra"]
noncomputable def fromPolynomial : polynomial A E ⟶ algebraic A E :=
  Under.homMk
    (CommRingCat.ofHom
      (MvPolynomial.eval₂Hom (algebraic A E).hom.hom (generator A (E := E))))
    (fromPolynomial_base A E)

/-- The inverse comparison evaluates each polynomial variable at the corresponding universal
free-algebra generator. -/
@[simp, stacks 00FQ "inverse free-algebra comparison on generators"]
theorem fromPolynomial_generator (x : E) :
    (fromPolynomial A E).right (polynomialGenerator A E x) = generator A x := sorry

/-- The canonical maps between the categorical and polynomial models compose to the identity on
the categorical free algebra. -/
@[stacks 00FQ "free algebra polynomial comparison hom-inverse law"]
theorem toPolynomial_comp :
    toPolynomial A E ≫ fromPolynomial A E = 𝟙 _ := sorry

/-- The canonical maps between the categorical and polynomial models compose to the identity on
the polynomial algebra. -/
@[stacks 00FQ "free algebra polynomial comparison inverse-hom law"]
theorem fromPolynomial_comp :
    fromPolynomial A E ≫ toPolynomial A E = 𝟙 _ := sorry

/-- The categorical free algebra on `E` is canonically isomorphic under `A` to `A[E]`. -/
@[stacks 00FQ "categorical free algebra polynomial identification"]
noncomputable def polynomialIso : algebraic A E ≅ polynomial A E where
  hom := toPolynomial A E
  inv := fromPolynomial A E
  hom_inv_id := toPolynomial_comp A E
  inv_hom_id := fromPolynomial_comp A E

/-- The free-algebra comparison is natural in the generator type. -/
@[stacks 00FQ "naturality of the free-algebra polynomial comparison"]
theorem toPolynomial_naturality {X Y : Type u} (f : X ⟶ Y) :
    map A f ≫ toPolynomial A Y =
      toPolynomial A X ≫ polynomialMap A f := sorry

/-- The inverse free-algebra comparison is natural in the generator type. -/
@[stacks 00FQ "naturality of the inverse free-algebra polynomial comparison"]
theorem fromPolynomial_naturality {X Y : Type u} (f : X ⟶ Y) :
    polynomialMap A f ≫ fromPolynomial A Y =
      fromPolynomial A X ≫ map A f := sorry

/-- The forward natural transformation from categorical free algebras to polynomial algebras. -/
@[stacks 00FQ "forward free-algebra polynomial natural transformation"]
noncomputable def polynomialNatTrans : functor A ⟶ polynomialFunctor A where
  app X := toPolynomial A X
  naturality X Y f := toPolynomial_naturality A f

/-- The inverse natural transformation from polynomial algebras to categorical free algebras. -/
@[stacks 00FQ "inverse free-algebra polynomial natural transformation"]
noncomputable def polynomialInvNatTrans : polynomialFunctor A ⟶ functor A where
  app X := fromPolynomial A X
  naturality X Y f := fromPolynomial_naturality A f

/-- The forward and inverse free-algebra polynomial transformations compose to the identity. -/
@[simp, stacks 00FQ "free-algebra polynomial natural transformation hom-inverse law"]
theorem polynomialNatTrans_hom_inv_id :
    polynomialNatTrans A ≫ polynomialInvNatTrans A = 𝟙 (functor A) := sorry

/-- The inverse and forward free-algebra polynomial transformations compose to the identity. -/
@[simp, stacks 00FQ "free-algebra polynomial natural transformation inverse-hom law"]
theorem polynomialNatTrans_inv_hom_id :
    polynomialInvNatTrans A ≫ polynomialNatTrans A = 𝟙 (polynomialFunctor A) := sorry

/-- The categorical free-algebra functor is naturally isomorphic to the multivariable-polynomial
functor over `A`. -/
@[stacks 00FQ "natural polynomial model of free commutative algebras"]
noncomputable def polynomialNatIso : functor A ≅ polynomialFunctor A where
  hom := polynomialNatTrans A
  inv := polynomialInvNatTrans A
  hom_inv_id := polynomialNatTrans_hom_inv_id A
  inv_hom_id := polynomialNatTrans_inv_hom_id A

/-- The forward component of the natural polynomial comparison is `toPolynomial`. -/
@[simp, stacks 00FQ "forward component of the natural polynomial comparison"]
theorem polynomialNatIso.hom_app (X : Type u) :
    (polynomialNatIso A).hom.app X = toPolynomial A X := sorry

/-- The inverse component of the natural polynomial comparison is `fromPolynomial`. -/
@[simp, stacks 00FQ "inverse component of the natural polynomial comparison"]
theorem polynomialNatIso.inv_app (X : Type u) :
    (polynomialNatIso A).inv.app X = fromPolynomial A X := sorry

end CommRingCat.Under.FreeAlgebra
