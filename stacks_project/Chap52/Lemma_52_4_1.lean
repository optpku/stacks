module

public import ReasLib.Algebra.Homology.DerivedCategory.LocalCohomology.CohomologicalDimension.IdealPowerLift
import StacksCheckRecall

@[expose] public section

open scoped BigOperators

universe u

/- Lemma 52.4.1: if `I` is generated by `f` and has local-cohomological dimension one,
then some positive power of `I` admits coefficient maps whose `f`-weighted sum is the
canonical inclusion into `A`. -/
@[stacks 0EIA] #check
  (Ideal.LocalCohomology.existsPowerInclusionLift :
    ∀ {A : Type u} [CommRing A] [IsNoetherianRing A] {r : ℕ} (I : Ideal A)
      (f : Fin r → A), Ideal.span (Set.range f) = I →
      Ideal.LocalCohomology.dimension I I.fg_of_isNoetherianRing = 1 →
      ∃ c : ℕ, 1 ≤ c ∧ ∃ φ : Fin r → I.powerHom A c,
        ∑ j, f j • φ j = (I ^ c).subtype)
