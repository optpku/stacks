module

public import Mathlib.RingTheory.Regular.RegularSequence
public import ReasLib.RingTheory.Ideal.Quotient.List
public import ReasLib.RingTheory.Sequence.QuasiRegular.Basic

/-!
# Quotients of Quasi-Regular Sequences

Quasi-regularity descends after removing an initial segment and quotienting the
module by the submodule generated by that segment.  The append formulation is
the compositional API; the `take`/`drop` formulation records the textbook
specialization.
-/

@[expose] public section

universe u v

namespace RingTheory.Sequence.IsQuasiRegular

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]

/-- Tag `061R`: removing the head of a quasi-regular sequence gives a
quasi-regular sequence on `QuotSMulTop`. -/
@[stacks 061R "head quotient"]
theorem head_quotient {r : R} {rs : List R} (hqr : IsQuasiRegular M (r :: rs)) :
    IsQuasiRegular (QuotSMulTop r M)
      (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))) := sorry

/-- Tag `061R`: the head quotient in the explicit `Ideal.ofList [r]` presentation.  This is a
thin source-facing bridge to `head_quotient`; the quotient carrier is kept explicit so recursive
arguments can change the ambient ring without introducing a local scalar-action instance. -/
@[stacks 061R "head quotient in singleton-list form"]
theorem head_quotient_ofList {r : R} {rs : List R} (hqr : IsQuasiRegular M (r :: rs)) :
    IsQuasiRegular
      (M ⧸ (Ideal.ofList [r] • (⊤ : Submodule R M)))
      (rs.map (Ideal.Quotient.mk (Ideal.ofList [r]))) := sorry

/-- Tag `061R`: a quasi-regular suffix remains quasi-regular after quotienting
by an arbitrary list prefix. -/
@[stacks 061R "append quotient"]
theorem quotient_of_append {ys zs : List R} (hqr : IsQuasiRegular M (ys ++ zs)) :
    IsQuasiRegular
      (M ⧸ (Ideal.ofList ys • (⊤ : Submodule R M)))
      (zs.map (Ideal.Quotient.mk (Ideal.ofList ys))) := sorry

/-- Lemma 10.69.5, tag `061R`: after quotienting by the first `i` terms of a
quasi-regular sequence, the remaining terms are quasi-regular. -/
@[stacks 061R]
theorem tail_quotient {rs : List R} (hqr : IsQuasiRegular M rs) (i : ℕ) :
    IsQuasiRegular
      (M ⧸ (Ideal.ofList (rs.take i) • (⊤ : Submodule R M)))
      ((rs.drop i).map (Ideal.Quotient.mk (Ideal.ofList (rs.take i)))) := sorry

end RingTheory.Sequence.IsQuasiRegular
