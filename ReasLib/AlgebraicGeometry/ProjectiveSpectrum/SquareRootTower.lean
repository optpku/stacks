module

public import ReasLib.RingTheory.GradedAlgebra.Quotient
public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic
public import Mathlib.AlgebraicGeometry.ValuativeCriterion
public import Mathlib.Data.Complex.Basic
public import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
public import Mathlib.RingTheory.Polynomial.Basic

/-!
# The projective spectrum of a square-root tower

This file constructs the powers-of-two grading on a countably generated
polynomial algebra over `ℂ[t]`, descends it through the relations
`Xᵢ² = t Xᵢ₊₁`, and records the resulting projective geometry.
-/

@[expose] public section

open CategoryTheory MvPolynomial
open scoped AlgebraicGeometry

noncomputable section

namespace AlgebraicGeometry

/-- The coefficient ring of the square-root tower is the polynomial ring `ℂ[t]`. -/
abbrev squareRootTowerBaseRing : Type :=
  Polynomial ℂ

/-- The ambient ring is the polynomial algebra over `ℂ[t]` on variables indexed by `ℕ`. -/
abbrev squareRootTowerAmbientRing : Type :=
  MvPolynomial ℕ squareRootTowerBaseRing

/-- The distinguished coefficient `t` in `ℂ[t]`. -/
abbrev squareRootTower_t : squareRootTowerBaseRing :=
  Polynomial.X

/-- The variable indexed by `i` has weight `2 ^ i`. -/
def squareRootTowerWeight : ℕ → ℕ :=
  fun i ↦ 2 ^ i

/-- The weighted homogeneous submodule of degree `n` in the ambient polynomial algebra. -/
abbrev squareRootTowerPolynomialGrading (n : ℕ) :
    Submodule squareRootTowerBaseRing squareRootTowerAmbientRing :=
  weightedHomogeneousSubmodule squareRootTowerBaseRing squareRootTowerWeight n

/-- The canonical graded-algebra structure for the powers-of-two weighted grading. -/
noncomputable instance squareRootTowerPolynomialGradedAlgebra :
    GradedAlgebra squareRootTowerPolynomialGrading :=
  MvPolynomial.weightedGradedAlgebra squareRootTowerBaseRing squareRootTowerWeight

/-- The relation at index `i` is `Xᵢ² - t Xᵢ₊₁`. -/
def squareRootTowerRelation (i : ℕ) : squareRootTowerAmbientRing :=
  X i ^ 2 - C squareRootTower_t * X (i + 1)

/-- The defining ideal is generated by all relations `Xᵢ² - t Xᵢ₊₁`. -/
def squareRootTowerIdeal : Ideal squareRootTowerAmbientRing :=
  Ideal.span (Set.range squareRootTowerRelation)

/-- The square-root tower ring is the quotient by all relations `Xᵢ² = t Xᵢ₊₁`. -/
abbrev squareRootTowerRing : Type :=
  squareRootTowerAmbientRing ⧸ squareRootTowerIdeal

/-- The canonical algebra homomorphism from the ambient polynomial algebra to the tower. -/
def squareRootTowerQuotientMap :
    squareRootTowerAmbientRing →ₐ[squareRootTowerBaseRing] squareRootTowerRing :=
  Ideal.Quotient.mkₐ squareRootTowerBaseRing squareRootTowerIdeal

/-- The degree-`n` piece of the tower is the image of the ambient degree-`n` piece. -/
abbrev squareRootTowerQuotientGrading (n : ℕ) :
    Submodule squareRootTowerBaseRing squareRootTowerRing :=
  GradedAlgebra.Quotient.grading squareRootTowerPolynomialGrading squareRootTowerIdeal n

/-- Each defining relation is weighted homogeneous of degree `2 ^ (i + 1)`. -/
theorem squareRootTowerRelation_mem_polynomialGrading (i : ℕ) :
    squareRootTowerRelation i ∈
      squareRootTowerPolynomialGrading (2 ^ (i + 1)) := sorry

/-- The ideal generated by the square-root relations is homogeneous. -/
theorem squareRootTowerIdeal_isHomogeneous :
    squareRootTowerIdeal.IsHomogeneous squareRootTowerPolynomialGrading := sorry

/-- The quotient grading carries the canonical internal graded-algebra structure. -/
noncomputable instance squareRootTowerQuotientGradedAlgebra :
    GradedAlgebra squareRootTowerQuotientGrading :=
  GradedAlgebra.Quotient.gradedAlgebra
    squareRootTowerPolynomialGrading squareRootTowerIdeal
    squareRootTowerIdeal_isHomogeneous

/-- The class of the variable `Xᵢ` in the square-root tower. -/
def squareRootTowerVariable (i : ℕ) : squareRootTowerRing :=
  squareRootTowerQuotientMap (X i)

/-- The class of the coefficient `t` in the square-root tower. -/
def squareRootTowerParameter : squareRootTowerRing :=
  algebraMap squareRootTowerBaseRing squareRootTowerRing squareRootTower_t

/-- The class of `Xᵢ` is homogeneous of degree `2 ^ i` in the quotient grading. -/
theorem squareRootTowerVariable_mem_grading (i : ℕ) :
    squareRootTowerVariable i ∈ squareRootTowerQuotientGrading (2 ^ i) :=
  GradedAlgebra.Quotient.mk_mem_grading
    squareRootTowerPolynomialGrading squareRootTowerIdeal
    (MvPolynomial.isWeightedHomogeneous_X
      squareRootTowerBaseRing squareRootTowerWeight i)

/-- In the quotient ring, each variable satisfies `Xᵢ² = t Xᵢ₊₁`. -/
theorem squareRootTowerRelation_quotient (i : ℕ) :
    squareRootTowerVariable i ^ 2 =
      squareRootTowerParameter * squareRootTowerVariable (i + 1) := sorry

/-- The standard opens of the quotient variables cover the projective spectrum. -/
theorem squareRootTowerProj_iSup_basicOpen_variable_eq_top :
    ⨆ i : ℕ, Proj.basicOpen squareRootTowerQuotientGrading (squareRootTowerVariable i) = ⊤ :=
  sorry

/-- The class of `t` belongs to no homogeneous prime in the projective spectrum. -/
theorem squareRootTowerParameter_not_mem_proj
    (x : Proj squareRootTowerQuotientGrading) :
    squareRootTowerParameter ∉ x.asHomogeneousIdeal := sorry

/-- Consecutive quotient variables determine the same standard open. -/
theorem squareRootTowerProj_basicOpen_variable_succ_eq (i : ℕ) :
    Proj.basicOpen squareRootTowerQuotientGrading (squareRootTowerVariable i) =
      Proj.basicOpen squareRootTowerQuotientGrading (squareRootTowerVariable (i + 1)) := sorry

/-- The standard open of the first quotient variable is the whole projective spectrum. -/
theorem squareRootTowerProj_basicOpen_variable_zero_eq_top :
    Proj.basicOpen squareRootTowerQuotientGrading (squareRootTowerVariable 0) = ⊤ := sorry

/-- The degree-zero subring of the quotient grading. -/
abbrev squareRootTowerDegreeZeroSubring : Subring squareRootTowerRing :=
  SetLike.GradeZero.subring squareRootTowerQuotientGrading

/-- Every scalar class lies in the degree-zero subring. -/
theorem squareRootTowerConstantClass_mem_degreeZero (r : squareRootTowerBaseRing) :
    algebraMap squareRootTowerBaseRing squareRootTowerRing r ∈
      squareRootTowerDegreeZeroSubring := sorry

/-- The scalar map from `ℂ[t]` to the degree-zero subring. -/
def squareRootTowerDegreeZeroAlgebraMap :
    squareRootTowerBaseRing →+* squareRootTowerDegreeZeroSubring :=
  (algebraMap squareRootTowerBaseRing squareRootTowerRing).codRestrict
    squareRootTowerDegreeZeroSubring squareRootTowerConstantClass_mem_degreeZero

/-- The scalar map to the degree-zero subring is injective. -/
theorem squareRootTowerDegreeZeroAlgebraMap_injective :
    Function.Injective squareRootTowerDegreeZeroAlgebraMap := sorry

/-- Every degree-zero element of the square-root tower is a scalar class. -/
theorem squareRootTowerDegreeZeroAlgebraMap_surjective :
    Function.Surjective squareRootTowerDegreeZeroAlgebraMap := sorry

/-- The degree-zero subring of the square-root tower is canonically isomorphic to `ℂ[t]`. -/
noncomputable def squareRootTowerDegreeZeroRingEquiv :
    squareRootTowerDegreeZeroSubring ≃+* squareRootTowerBaseRing :=
  (RingEquiv.ofBijective squareRootTowerDegreeZeroAlgebraMap
    ⟨squareRootTowerDegreeZeroAlgebraMap_injective,
      squareRootTowerDegreeZeroAlgebraMap_surjective⟩).symm

/-- The spectrum of the degree-zero subring is canonically isomorphic to `Spec(ℂ[t])`. -/
noncomputable def squareRootTowerDegreeZeroSpecIso :
    Spec (.of squareRootTowerDegreeZeroSubring) ≅ Spec (.of squareRootTowerBaseRing) :=
  (Scheme.Spec.mapIso squareRootTowerDegreeZeroRingEquiv.toCommRingCatIso.op).symm

/-- The canonical morphism from the projective square-root tower to `Spec(ℂ[t])`. -/
noncomputable def squareRootTowerProjToSpec :
    Proj squareRootTowerQuotientGrading ⟶ Spec (.of squareRootTowerBaseRing) :=
  Proj.toSpecZero squareRootTowerQuotientGrading ≫
    Spec.map (CommRingCat.ofHom squareRootTowerDegreeZeroAlgebraMap)

/-- The image of the projective square-root tower is the basic open where `t` is nonzero. -/
theorem squareRootTowerProjToSpec_range_eq_basicOpen :
    Set.range squareRootTowerProjToSpec.base =
      (PrimeSpectrum.basicOpen squareRootTower_t :
        Set (PrimeSpectrum squareRootTowerBaseRing)) := sorry

/-- The projective spectrum of the square-root tower is affine. -/
noncomputable instance squareRootTowerProj_isAffine :
    IsAffine (Proj squareRootTowerQuotientGrading) := sorry

/-- The canonical morphism from the projective square-root tower is quasi-compact. -/
instance squareRootTowerProjToSpec_quasiCompact :
    QuasiCompact squareRootTowerProjToSpec := sorry

/-- The canonical morphism from the projective square-root tower is not a closed map. -/
theorem projSquareRootTowerToSpec_not_isClosedMap :
    ¬ IsClosedMap squareRootTowerProjToSpec.base := sorry

/-- The canonical morphism fails the existence part of the valuative criterion. -/
theorem projSquareRootTowerToSpec_not_valuativeCriterionExistence :
    ¬ ValuativeCriterion.Existence squareRootTowerProjToSpec := sorry

/--
For the square-root tower, `t` avoids every projective point, the variable
standard opens cover and are all equal to the first one, the projective
spectrum is affine, and its quasi-compact map to `Spec(ℂ[t])` has image
`D(t)`, is not closed, and fails valuative existence.
-/
theorem squareRootTowerExample :
    (∀ x : Proj squareRootTowerQuotientGrading,
      squareRootTowerParameter ∉ x.asHomogeneousIdeal) ∧
    (⨆ i : ℕ, Proj.basicOpen squareRootTowerQuotientGrading
      (squareRootTowerVariable i)) = ⊤ ∧
    (∀ i : ℕ, Proj.basicOpen squareRootTowerQuotientGrading
      (squareRootTowerVariable i) =
        Proj.basicOpen squareRootTowerQuotientGrading
          (squareRootTowerVariable (i + 1))) ∧
    Proj.basicOpen squareRootTowerQuotientGrading (squareRootTowerVariable 0) = ⊤ ∧
    IsAffine (Proj squareRootTowerQuotientGrading) ∧
    QuasiCompact squareRootTowerProjToSpec ∧
    Set.range squareRootTowerProjToSpec.base =
      (PrimeSpectrum.basicOpen squareRootTower_t :
        Set (PrimeSpectrum squareRootTowerBaseRing)) ∧
    ¬ IsClosedMap squareRootTowerProjToSpec.base ∧
    ¬ ValuativeCriterion.Existence squareRootTowerProjToSpec := by
  exact ⟨squareRootTowerParameter_not_mem_proj,
    squareRootTowerProj_iSup_basicOpen_variable_eq_top,
    squareRootTowerProj_basicOpen_variable_succ_eq,
    squareRootTowerProj_basicOpen_variable_zero_eq_top,
    squareRootTowerProj_isAffine,
    squareRootTowerProjToSpec_quasiCompact,
    squareRootTowerProjToSpec_range_eq_basicOpen,
    projSquareRootTowerToSpec_not_isClosedMap,
    projSquareRootTowerToSpec_not_valuativeCriterionExistence⟩

end AlgebraicGeometry
