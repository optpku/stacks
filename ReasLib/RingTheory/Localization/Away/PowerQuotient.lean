module

public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations

@[expose] public section

noncomputable section

universe u

namespace Localization.Away

variable {R : Type u} [CommRing R]

/-- The ideal generated by the `n`th power of a parameter in the localization away from `f`. -/
def powerIdeal (f parameter : R) (n : ℕ) : Ideal (Localization.Away f) :=
  Ideal.span {algebraMap R (Localization.Away f) parameter ^ n}

/-- The localization away from `f`, modulo the `n`th power of a parameter. -/
abbrev PowerQuotient (f parameter : R) (n : ℕ) :=
  Localization.Away f ⧸ powerIdeal f parameter n

namespace PowerQuotient

/-- Divisibility of localization elements induces the canonical map between localizations. -/
def localizationMap {f g : R} (hfg : f ∣ g) :
    Localization.Away f →ₐ[R] Localization.Away g :=
  IsLocalization.Away.liftAlgHom f
    (f := Algebra.ofId R (Localization.Away g))
    (IsLocalization.Away.isUnit_of_dvd (S := Localization.Away g) g hfg)

/-- Increasing the exponent decreases the principal parameter-power ideal. -/
theorem powerIdeal_antitone (f parameter : R) {n m : ℕ} (hnm : n ≤ m) :
    powerIdeal f parameter m ≤ powerIdeal f parameter n := sorry

/-- The map to a localized parameter-power quotient annihilates the source power ideal. -/
theorem map_annihilates {f g : R} (hfg : f ∣ g) (parameter : R) (n : ℕ) :
    ∀ value ∈ powerIdeal f parameter n,
      ((IsScalarTower.toAlgHom R (Localization.Away g) (PowerQuotient g parameter n)).comp
        (localizationMap hfg)) value = 0 := sorry

/-- Divisibility induces an algebra homomorphism between localized parameter-power quotients. -/
def map {f g : R} (hfg : f ∣ g) (parameter : R) (n : ℕ) :
    PowerQuotient f parameter n →ₐ[R] PowerQuotient g parameter n :=
  Ideal.Quotient.liftₐ (powerIdeal f parameter n)
    ((IsScalarTower.toAlgHom R (Localization.Away g) (PowerQuotient g parameter n)).comp
      (localizationMap hfg)) (map_annihilates hfg parameter n)

/-- A larger parameter-power quotient reduces canonically to every smaller stage. -/
def reduction (f parameter : R) {n m : ℕ} (hnm : n ≤ m) :
    PowerQuotient f parameter m →ₐ[R] PowerQuotient f parameter n :=
  Ideal.Quotient.factorₐ R (powerIdeal_antitone f parameter hnm)

/-- The overlap map sends a quotient representative to its image under localization. -/
theorem map_mk {f g : R} (hfg : f ∣ g) (parameter : R) (n : ℕ)
    (value : Localization.Away f) :
    map hfg parameter n (Ideal.Quotient.mk (powerIdeal f parameter n) value) =
      Ideal.Quotient.mk (powerIdeal g parameter n) (localizationMap hfg value) := sorry

/-- Reduction preserves representatives of the localized ring. -/
theorem reduction_mk (f parameter : R) {n m : ℕ} (hnm : n ≤ m)
    (value : Localization.Away f) :
    reduction f parameter hnm (Ideal.Quotient.mk (powerIdeal f parameter m) value) =
      Ideal.Quotient.mk (powerIdeal f parameter n) value := sorry

/-- Overlap maps commute with reduction of the parameter-power exponent. -/
theorem map_reduction {f g : R} (hfg : f ∣ g) (parameter : R) {n m : ℕ}
    (hnm : n ≤ m) :
    (map hfg parameter n).comp (reduction f parameter hnm) =
      (reduction g parameter hnm).comp (map hfg parameter m) := sorry

end PowerQuotient

end Localization.Away
