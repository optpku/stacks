module

public import Mathlib.Algebra.Homology.HomotopyCategory.KProjective
public import ReasLib.Algebra.Homology.CochainComplex.ProjectiveResolution.Map
public import ReasLib.CategoryTheory.ObjectProperty.Orthogonal.Localization
import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Homotopy Comparison of Projective Resolutions

This leaf is independent of a choice of derived category. It packages the universal comparison
property of bounded-above projective resolutions over arbitrary morphisms in the homotopy
category, together with its identity, composition, and strict-map compatibility API.
-/

open CategoryTheory
open ComplexShape

universe v u

namespace CochainComplex.ProjectiveResolution

variable {𝒜 : Type u} [Category.{v} 𝒜] [Abelian 𝒜]

/-- A morphism between projective models lies over `u` when the induced square with the two
resolution comparisons commutes in the homotopy category. -/
@[stacks 0648 "homotopy map of projective resolutions"]
abbrev IsHomotopyMap {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L)
    (a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex) : Prop :=
  CommSq a ((HomotopyCategory.quotient 𝒜 (up ℤ)).map P.π)
    ((HomotopyCategory.quotient 𝒜 (up ℤ)).map Q.π) u

/-- A homotopy comparison between resolutions of the same complex is a homotopy map lying over
the identity of that complex. -/
@[stacks 0648]
abbrev IsHomotopyComparison {K : CochainComplex 𝒜 ℤ} (P Q : ProjectiveResolution K)
    (a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex) : Prop :=
  P.IsHomotopyMap Q (𝟙 _) a

namespace IsHomotopyMap

/-- The `CommSq` model of `IsHomotopyMap` unfolds to the expected comparison equation. -/
@[simp]
theorem iff {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L)
    (a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex) :
    P.IsHomotopyMap Q u a ↔
      a ≫ (HomotopyCategory.quotient 𝒜 (up ℤ)).map Q.π =
        (HomotopyCategory.quotient 𝒜 (up ℤ)).map P.π ≫ u := sorry

/-- The identity of a projective model lies over the identity of its base complex. -/
theorem id {K : CochainComplex 𝒜 ℤ} (P : ProjectiveResolution K) :
    P.IsHomotopyMap P (𝟙 _) (𝟙 _) := sorry

/-- Compatible homotopy maps are closed under composition. -/
theorem comp {K L M : CochainComplex 𝒜 ℤ}
    {P : ProjectiveResolution K} {Q : ProjectiveResolution L}
    {R : ProjectiveResolution M}
    {u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L}
    {v : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj M}
    {a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex}
    {b : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj R.complex}
    (ha : P.IsHomotopyMap Q u a) (hb : Q.IsHomotopyMap R v b) :
    P.IsHomotopyMap R (u ≫ v) (a ≫ b) := sorry

end IsHomotopyMap

/-- The homotopy-category image of a projective-resolution comparison belongs to the
triangulated localization system generated by acyclic complexes. -/
theorem π_mem_trW {K : CochainComplex 𝒜 ℤ} (P : ProjectiveResolution K) :
    (HomotopyCategory.subcategoryAcyclic 𝒜).trW
      ((HomotopyCategory.quotient 𝒜 (up ℤ)).map P.π) := sorry

/-- The homotopy-category object of a projective resolution is left orthogonal to acyclic
complexes. -/
theorem complex_leftOrthogonal {K : CochainComplex 𝒜 ℤ} (P : ProjectiveResolution K) :
    (HomotopyCategory.subcategoryAcyclic 𝒜).leftOrthogonal
      ((HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex) := sorry

/-- Postcomposition with the quasi-isomorphism of a projective resolution is bijective on
homotopy-category morphisms out of any projective resolution. -/
theorem comparison_bijective {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L) :
    Function.Bijective
      (fun a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
          (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex ↦
        a ≫ (HomotopyCategory.quotient 𝒜 (up ℤ)).map Q.π) := sorry

/-- Postcomposition with a projective-resolution comparison, bundled as the canonical additive
Hom equivalence in the homotopy category. -/
@[stacks 0648 "additive projective-resolution homotopy lifting equivalence"]
noncomputable def comparisonAddEquiv {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L) :
    ((HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
        (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex) ≃+
      ((HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
        (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L) :=
  CategoryTheory.ObjectProperty.leftOrthogonal.homAddEquiv
    (P := HomotopyCategory.subcategoryAcyclic 𝒜)
    (Eq.mp
      (congrArg
        (fun W : CategoryTheory.MorphismProperty (HomotopyCategory 𝒜 (up ℤ)) ↦
          W ((HomotopyCategory.quotient 𝒜 (up ℤ)).map Q.π))
        (HomotopyCategory.quasiIso_eq_trW_subcategoryAcyclic 𝒜))
      ((HomotopyCategory.quotient_map_mem_quasiIso_iff Q.π).2 Q.hw))
    (@CochainComplex.IsKProjective.leftOrthogonal 𝒜 _ _ P.complex
      (@CochainComplex.isKProjective_of_projective 𝒜 _ _ P.complex
        (Classical.choose P.model.obj.property)
        (Classical.choose_spec P.model.obj.property)
        (fun n ↦ P.model.property n)))

/-- Postcomposition with a projective-resolution comparison, bundled as the canonical
hom-set equivalence in the homotopy category. -/
@[stacks 0648 "projective-resolution homotopy lifting equivalence"]
noncomputable def comparisonEquiv {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L) :
    ((HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
        (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex) ≃
      ((HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
        (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L) :=
  CategoryTheory.ObjectProperty.leftOrthogonal.homEquiv
    (P := HomotopyCategory.subcategoryAcyclic 𝒜)
    (Eq.mp
      (congrArg
        (fun W : CategoryTheory.MorphismProperty (HomotopyCategory 𝒜 (up ℤ)) ↦
          W ((HomotopyCategory.quotient 𝒜 (up ℤ)).map Q.π))
        (HomotopyCategory.quasiIso_eq_trW_subcategoryAcyclic 𝒜))
      ((HomotopyCategory.quotient_map_mem_quasiIso_iff Q.π).2 Q.hw))
    (@CochainComplex.IsKProjective.leftOrthogonal 𝒜 _ _ P.complex
      (@CochainComplex.isKProjective_of_projective 𝒜 _ _ P.complex
        (Classical.choose P.model.obj.property)
        (Classical.choose_spec P.model.obj.property)
        (fun n ↦ P.model.property n)))

/-- Evaluating the additive projective-resolution Hom equivalence is postcomposition by the
resolution comparison. -/
@[simp]
theorem comparisonAddEquiv_apply {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex) :
    comparisonAddEquiv P Q a =
      a ≫ (HomotopyCategory.quotient 𝒜 (up ℤ)).map Q.π := sorry

/-- Evaluating the projective-resolution Hom equivalence is postcomposition by the resolution
comparison. -/
@[simp]
theorem comparisonEquiv_apply {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex) :
    comparisonEquiv P Q a =
      a ≫ (HomotopyCategory.quotient 𝒜 (up ℤ)).map Q.π := sorry

/-- The canonical lift of an arbitrary homotopy-category morphism through a projective
resolution comparison. -/
@[stacks 0648 "canonical lift through a projective resolution"]
noncomputable def homotopyLift {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (f : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L) :
    (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex :=
  (comparisonEquiv P Q).symm f

/-- The inverse additive comparison equivalence computes the canonical homotopy lift. -/
@[simp]
theorem comparisonAddEquiv_symm_apply {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (f : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L) :
    (comparisonAddEquiv P Q).symm f = P.homotopyLift Q f := sorry

/-- The inverse comparison equivalence computes the canonical homotopy lift. -/
@[simp]
theorem comparisonEquiv_symm_apply {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (f : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L) :
    (comparisonEquiv P Q).symm f = P.homotopyLift Q f := sorry

/-- A canonical homotopy lift composes to the morphism being lifted. -/
@[reassoc]
theorem homotopyLift_fac {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (f : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L) :
    P.homotopyLift Q f ≫
        (HomotopyCategory.quotient 𝒜 (up ℤ)).map Q.π = f := sorry

/-- A morphism with the prescribed composite is the canonical homotopy lift. -/
theorem homotopyLift_unique {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (f : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L)
    {a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex}
    (ha : a ≫ (HomotopyCategory.quotient 𝒜 (up ℤ)).map Q.π = f) :
    a = P.homotopyLift Q f := sorry

/-- The canonical homotopy lift is characterized by its composite. -/
@[simp]
theorem homotopyLift_eq_iff {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (f : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L)
    (a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex) :
    P.homotopyLift Q f = a ↔
      a ≫ (HomotopyCategory.quotient 𝒜 (up ℤ)).map Q.π = f := sorry

/-- Canonical projective-resolution lifts are natural in the left-hand resolution.

Precomposing the morphism being lifted agrees with first precomposing in the intermediate
projective model and then applying its canonical lift. -/
@[stacks 0648 "precomposition naturality of projective lifts"]
theorem homotopyLift_comp {K L M : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (R : ProjectiveResolution M)
    (k : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj R.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex)
    (f : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L) :
    R.homotopyLift Q (k ≫ f) = k ≫ P.homotopyLift Q f := sorry

/-- The canonical homotopy-category map between projective resolutions lying over `u`. -/
@[stacks 0648 "canonical homotopy map of projective resolutions"]
noncomputable def homotopyMap {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L) :
    (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex :=
  P.homotopyLift Q
    ((HomotopyCategory.quotient 𝒜 (up ℤ)).map P.π ≫ u)

/-- The canonical homotopy map satisfies its comparison square. -/
@[reassoc]
theorem homotopyMap_fac {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L) :
    P.homotopyMap Q u ≫ (HomotopyCategory.quotient 𝒜 (up ℤ)).map Q.π =
      (HomotopyCategory.quotient 𝒜 (up ℤ)).map P.π ≫ u := sorry

/-- The canonical projective-resolution homotopy map is compatible with its base morphism. -/
theorem homotopyMap_isHomotopyMap {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L) :
    P.IsHomotopyMap Q u (P.homotopyMap Q u) := sorry

/-- A homotopy-category map between projective resolutions is determined by the base morphism
over which it lies. -/
theorem homotopyMap_unique {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L)
    {a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex}
    (ha : P.IsHomotopyMap Q u a) : a = P.homotopyMap Q u := sorry

/-- A morphism between projective models lies over `u` exactly when it is the canonical
homotopy map over `u`. -/
@[simp]
theorem isHomotopyMap_iff {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L)
    (a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex) :
    P.IsHomotopyMap Q u a ↔ a = P.homotopyMap Q u := sorry

/-- The canonical map over an identity is the identity of the projective model. -/
@[simp]
theorem homotopyMap_id {K : CochainComplex 𝒜 ℤ} (P : ProjectiveResolution K) :
    P.homotopyMap P (𝟙 _) = 𝟙 _ := sorry

/-- Canonical homotopy maps respect composition of base morphisms. -/
@[simp ←]
theorem homotopyMap_comp {K L M : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (R : ProjectiveResolution M)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L)
    (v : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj M) :
    P.homotopyMap R (u ≫ v) = P.homotopyMap Q u ≫ Q.homotopyMap R v := sorry

/-- A strict map of projective resolutions represents the canonical homotopy map over its base
cochain map. -/
theorem homotopyMap_eq_map {K L : CochainComplex 𝒜 ℤ} {f : K ⟶ L}
    {P : ProjectiveResolution K} {Q : ProjectiveResolution L}
    (m : Map f P Q) :
    P.homotopyMap Q ((HomotopyCategory.quotient 𝒜 (up ℤ)).map f) =
      (HomotopyCategory.quotient 𝒜 (up ℤ)).map m.hom := sorry

/-- A strict map of projective resolutions is a compatible homotopy map after passing to the
homotopy category. -/
theorem Map.isHomotopyMap {K L : CochainComplex 𝒜 ℤ} {f : K ⟶ L}
    {P : ProjectiveResolution K} {Q : ProjectiveResolution L} (m : Map f P Q) :
    P.IsHomotopyMap Q ((HomotopyCategory.quotient 𝒜 (up ℤ)).map f)
      ((HomotopyCategory.quotient 𝒜 (up ℤ)).map m.hom) := sorry

/-- A strict projective-resolution map computes the canonical homotopy map after reidentifying
the base morphism. -/
theorem homotopyMap_eq_map_of_eq {K L : CochainComplex 𝒜 ℤ} {f : K ⟶ L}
    {P : ProjectiveResolution K} {Q : ProjectiveResolution L}
    {u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L}
    (m : Map f P Q) (hu : (HomotopyCategory.quotient 𝒜 (up ℤ)).map f = u) :
    P.homotopyMap Q u = (HomotopyCategory.quotient 𝒜 (up ℤ)).map m.hom := sorry

/-- Canonical homotopy maps simplify when the left factor is represented by a strict
projective-resolution map. -/
@[simp ←]
theorem homotopyMap_map_comp {K L M : CochainComplex 𝒜 ℤ} {f : K ⟶ L}
    {P : ProjectiveResolution K} {Q : ProjectiveResolution L}
    (R : ProjectiveResolution M) (m : Map f P Q)
    (v : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj M) :
    P.homotopyMap R ((HomotopyCategory.quotient 𝒜 (up ℤ)).map f ≫ v) =
      (HomotopyCategory.quotient 𝒜 (up ℤ)).map m.hom ≫ Q.homotopyMap R v := sorry

/-- Canonical homotopy maps simplify when the right factor is represented by a strict
projective-resolution map. -/
@[simp ←]
theorem homotopyMap_comp_map {K L M : CochainComplex 𝒜 ℤ} {g : L ⟶ M}
    (P : ProjectiveResolution K) {Q : ProjectiveResolution L}
    {R : ProjectiveResolution M}
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L)
    (n : Map g Q R) :
    P.homotopyMap R (u ≫ (HomotopyCategory.quotient 𝒜 (up ℤ)).map g) =
      P.homotopyMap Q u ≫ (HomotopyCategory.quotient 𝒜 (up ℤ)).map n.hom := sorry

/-- Every base morphism admits a unique compatible map between chosen projective resolutions in
the homotopy category. -/
@[stacks 0648]
theorem existsUnique_homotopyMap {K L : CochainComplex 𝒜 ℤ}
    (P : ProjectiveResolution K) (Q : ProjectiveResolution L)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L) :
    ∃! a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
        (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex,
      P.IsHomotopyMap Q u a := sorry

/-- A homotopy comparison between two projective resolutions is an isomorphism. -/
theorem isIso_of_isHomotopyComparison {K : CochainComplex 𝒜 ℤ}
    (P Q : ProjectiveResolution K)
    {a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex}
    (ha : P.IsHomotopyComparison Q a) : IsIso a := sorry

/-- Two bounded-above projective resolutions of the same cochain complex admit a unique
compatible comparison in the homotopy category. -/
@[stacks 0648]
theorem existsUnique_homotopyComparison {K : CochainComplex 𝒜 ℤ}
    (P Q : ProjectiveResolution K) :
    ∃! a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj P.complex ⟶
        (HomotopyCategory.quotient 𝒜 (up ℤ)).obj Q.complex,
      P.IsHomotopyComparison Q a := sorry

end CochainComplex.ProjectiveResolution
