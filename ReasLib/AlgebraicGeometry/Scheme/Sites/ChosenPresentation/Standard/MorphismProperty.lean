module

public import ReasLib.AlgebraicGeometry.Scheme.Sites.ChosenPresentation.Standard

/-!
# Morphism properties of standard scheme precoverages

This module identifies the morphism property generated by each standard
scheme precoverage with its corresponding geometric condition.
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry.StandardTopology

/-- Membership in the morphism property generated by a standard precoverage
is equivalent to the corresponding standard geometric property. -/
theorem morphismProperty_iff (τ : StandardTopology)
    {X Y : Scheme.{u}} (f : X ⟶ Y) :
    τ.precoverage.morphismProperty f ↔
      match τ with
      | .zariski => IsOpenImmersion f
      | .etale => Etale f
      | .smooth => Smooth f
      | .syntomic => Syntomic f
      | .fppf => Flat f ∧ LocallyOfFinitePresentation f := sorry

end AlgebraicGeometry.StandardTopology
