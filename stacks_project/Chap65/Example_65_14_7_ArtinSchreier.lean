module

public import Mathlib.Algebra.Algebra.Rat
public import Mathlib.Algebra.Group.End
public import Mathlib.Data.Complex.Basic
public import Mathlib.SetTheory.Cardinal.NatCard
public import Mathlib.FieldTheory.AlgebraicClosure
public import Mathlib.FieldTheory.Galois.Basic
public import Mathlib.FieldTheory.Galois.Notation
public import Mathlib.GroupTheory.OrderOfElement

/-!
# Artin–Schreier finite subgroups of `Gal(algebraicQ / ℚ)`

This module records the relative algebraic closure of `ℚ` in `ℂ`, the real intersection
`algebraicQ ∩ ℝ`, complex conjugation as an element of `Gal(algebraicQ / ℚ)`, and the
classification of finite subgroups of that Galois group.
-/

@[expose] public section

noncomputable section

namespace AlgebraicGeometry.AlgebraicSpace.AlgebraicClosureQuotient

/-- The relative algebraic closure of `ℚ` in `ℂ`, used as the carrier of `Qbar`. -/
abbrev algebraicQ : Type := algebraicClosure ℚ ℂ

/-- `algebraicQ` is the relative algebraic closure of `ℚ` in `ℂ`. -/
theorem algebraicQ_eq : algebraicQ = algebraicClosure ℚ ℂ := sorry

/-- The absolute Galois group `Gal(algebraicQ / ℚ)`. -/
abbrev gal : Type := Gal(algebraicQ / ℚ)

/-- `gal` is the automorphism group of `algebraicQ` over `ℚ`. -/
theorem gal_eq : gal = Gal(algebraicQ / ℚ) := sorry

/-- The real intersection `algebraicQ ∩ ℝ` as an intermediate field of `algebraicQ / ℚ`. -/
def realIntersection : IntermediateField ℚ algebraicQ where
  carrier := {x | (x : ℂ).im = 0}
  mul_mem' := sorry
  add_mem' := sorry
  algebraMap_mem' := sorry
  inv_mem' := sorry

/-- Membership in `realIntersection` is vanishing of the imaginary part in `ℂ`. -/
theorem mem_realIntersection_iff (x : algebraicQ) :
    x ∈ realIntersection ↔ (x : ℂ).im = 0 := sorry

/-- Complex conjugation as an element of `Gal(algebraicQ / ℚ)`, acting by `starRingEnd ℂ`. -/
def complexConj : gal where
  toFun x := ⟨starRingEnd ℂ (x : ℂ), sorry⟩
  invFun x := ⟨starRingEnd ℂ (x : ℂ), sorry⟩
  left_inv := sorry
  right_inv := sorry
  map_mul' := sorry
  map_add' := sorry
  commutes' := sorry

/-- `complexConj` acts by complex conjugation on the underlying complex numbers. -/
theorem complexConj_apply (x : algebraicQ) :
    (complexConj x : ℂ) = starRingEnd ℂ (x : ℂ) := sorry

/-- Complex conjugation is an involution on `algebraicQ`. -/
theorem complexConj_sq : complexConj ^ 2 = 1 := sorry

/-- Complex conjugation has order two in `gal`. -/
theorem orderOf_complexConj : orderOf complexConj = 2 := sorry

/-- The order-two subgroup generated by complex conjugation. -/
def complexConjSubgroup : Subgroup gal :=
  Subgroup.zpowers complexConj

/-- `complexConjSubgroup` is the cyclic subgroup generated by `complexConj`. -/
theorem complexConjSubgroup_eq : complexConjSubgroup = Subgroup.zpowers complexConj := sorry

/-- The conjugation subgroup is the fixer of `realIntersection` in `gal`. -/
theorem complexConjSubgroup_eq_fixingSubgroup :
    complexConjSubgroup = realIntersection.fixingSubgroup := sorry

/-- The conjugation subgroup has cardinality two. -/
theorem card_complexConjSubgroup : Nat.card complexConjSubgroup = 2 := sorry

/-- The conjugation subgroup is finite. -/
instance instFinite_complexConjSubgroup : Finite complexConjSubgroup := sorry

/-- Artin–Schreier: the only finite subgroups of `Gal(algebraicQ / ℚ)` are the trivial
subgroup and the conjugates of the order-two group generated by complex conjugation. -/
theorem finite_subgroup_eq_bot_or_isConj (H : Subgroup gal) [Finite H] :
    H = ⊥ ∨ ∃ g : gal, H = complexConjSubgroup.map (MulAut.conj g).toMonoidHom := sorry

end AlgebraicGeometry.AlgebraicSpace.AlgebraicClosureQuotient
