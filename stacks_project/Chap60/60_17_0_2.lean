module

public import ReasLib.RingTheory.AdicCompletion.InverseSystem
public import stacks_project.Chap60.Remark_60_6_7_Forms
public import ReasLib.RingTheory.DividedPowers.DeRham.CrystallineOmega
import StacksCheckRecall
import Mathlib.Data.Nat.Prime.Basic
public import Mathlib.RingTheory.DividedPowers.DPMorphism
import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u v

/- The source's `D` is equipped with its map from `A` and divided powers `γ̄`;
   the canonical relative divided-power differential module is completed
   along the ideal generated by `p`. -/

/- 60.17.0.2 (1): the completed relative divided-power differential module is
the inverse limit of actual quotient-ring differentials on a stable tail. -/
@[stacks 07J9] #check (crystallineOmegaD_actualLimitIso :
  ∀ {A : Type u} [CommRing A] {D : Type v} [CommRing D]
    (f : A →+* D) {J : Ideal D} (γbar : DividedPowers J)
    (p : ℕ) [Fact (Nat.Prime p)] [Algebra (Int.LocalizationAtPrime p) A]
    (n : ℕ) (hpow : Ideal.span {(p : D)} ^ n ≤ J),
    ModuleCat.of D (crystallineOmegaD f γbar p) ≅
      limit (CrystallineOmega.actualSystem f γbar p n hpow))

/- 60.17.0.2 (2): the completed relative divided-power differential module is
the inverse limit of its positive p-power quotient modules. -/
@[stacks 07J9] #check (crystallineOmegaD_limitIso :
  ∀ {A : Type u} [CommRing A] {D : Type v} [CommRing D]
    (f : A →+* D) {J : Ideal D} (γbar : DividedPowers J)
    (p : ℕ) [Fact (Nat.Prime p)],
    ModuleCat.of D (crystallineOmegaD f γbar p) ≅
      limit (AdicCompletion.positiveQuotientSystem (Ideal.span {(p : D)})
        (KaehlerDifferential.DeRham.dividedPowerDifferential f γbar)))

/-- Transport the canonical completion-to-quotient-limit isomorphism to a
supplied inverse system along an isomorphism with the quotient system. -/
noncomputable def crystallineOmegaD_iso_stageLimit
    {A : Type u} [CommRing A]
    {D : Type v} [CommRing D]
    (f : A →+* D) {J : Ideal D} (γbar : DividedPowers J)
    (p : ℕ) [Fact (Nat.Prime p)]
    (Ω : CategoryTheory.PNatInverseSystem (ModuleCat.{v} D))
    [HasLimit Ω]
    (hΩ : Ω ≅ AdicCompletion.positiveQuotientSystem
      (Ideal.span {(p : D)}) (dividedPowerDifferential f γbar)) :
    ModuleCat.of D (crystallineOmegaD f γbar p) ≅ limit Ω :=
  (AdicCompletion.positiveQuotientLimitIso
      (Ideal.span {(p : D)}) (dividedPowerDifferential f γbar)).symm ≪≫
    HasLimit.isoOfNatIso hΩ.symm

/-- A supplied isomorphism from an inverse system to the positive p-power
quotient system induces an isomorphism between their limits. -/
noncomputable def crystallineOmegaD_stageLimit_iso_quotientLimit
    {A : Type u} [CommRing A]
    {D : Type v} [CommRing D]
    (f : A →+* D) {J : Ideal D} (γbar : DividedPowers J)
    (p : ℕ) [Fact (Nat.Prime p)]
    (Ω : CategoryTheory.PNatInverseSystem (ModuleCat.{v} D))
    [HasLimit Ω]
    (hΩ : Ω ≅ AdicCompletion.positiveQuotientSystem
      (Ideal.span {(p : D)}) (dividedPowerDifferential f γbar)) :
    limit Ω ≅ limit (AdicCompletion.positiveQuotientSystem
      (Ideal.span {(p : D)}) (dividedPowerDifferential f γbar)) :=
  HasLimit.isoOfNatIso hΩ
