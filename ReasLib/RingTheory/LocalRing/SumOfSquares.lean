/-!
# Origin-local rings of sum-of-squares hypersurfaces

This file constructs the coordinate rings and origin-local rings of the
two-variable and three-variable sum-of-squares hypersurfaces, together with
their basic coordinate properties.
-/

@[expose] public section

noncomputable section

universe u

open MvPolynomial IsLocalRing

namespace MvPolynomial.SumOfTwoSquares

/-- The quadratic form `x ^ 2 + y ^ 2` in two variables, with `X 0`
corresponding to `x` and `X 1` corresponding to `y`. -/
def equation (k : Type u) [Field k] : MvPolynomial (Fin 2) k :=
  X (0 : Fin 2) ^ 2 + X (1 : Fin 2) ^ 2

/-- Unfolding of the two-square form as a sum of squares of the two variables. -/
theorem equation_spec (k : Type u) [Field k] :
    equation k = X (0 : Fin 2) ^ 2 + X (1 : Fin 2) ^ 2 := sorry

/-- The principal relation ideal generated by `equation k`. -/
def relationIdeal (k : Type u) [Field k] : Ideal (MvPolynomial (Fin 2) k) :=
  Ideal.span {equation k}

/-- The relation ideal is the principal ideal generated by `equation k`. -/
theorem relationIdeal_eq_span (k : Type u) [Field k] :
    relationIdeal k = Ideal.span {equation k} := sorry

/-- The coordinate ring `k[x, y] ⧸ (x ^ 2 + y ^ 2)`. -/
abbrev CoordinateRing (k : Type u) [Field k] : Type u :=
  MvPolynomial (Fin 2) k ⧸ relationIdeal k

/-- The class of the `i`-th coordinate in `CoordinateRing k`. -/
def coord (k : Type u) [Field k] (i : Fin 2) : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (X i)

/-- `coord k i` is the class of `X i` in the quotient. -/
theorem coord_eq_mk (k : Type u) [Field k] (i : Fin 2) :
    coord k i = Ideal.Quotient.mk (relationIdeal k) (X i) := sorry

/-- The defining equation vanishes in the coordinate ring. -/
theorem sum_coord_sq (k : Type u) [Field k] :
    coord k 0 ^ 2 + coord k 1 ^ 2 = 0 := sorry

/-- The origin ideal `(x, y)` in the coordinate ring. -/
def originIdeal (k : Type u) [Field k] : Ideal (CoordinateRing k) :=
  Ideal.span {coord k 0, coord k 1}

/-- The origin ideal is generated by `coord k 0` and `coord k 1`. -/
theorem originIdeal_eq_span (k : Type u) [Field k] :
    originIdeal k = Ideal.span {coord k 0, coord k 1} := sorry

/-- The origin ideal is the extension of `(x, y) = idealOfVars (Fin 2) k`. -/
theorem originIdeal_eq_map (k : Type u) [Field k] :
    originIdeal k =
      Ideal.map (Ideal.Quotient.mk (relationIdeal k)) (idealOfVars (Fin 2) k) := sorry

/-- The origin ideal is maximal, so it is the prime at which we localize. -/
instance originIdeal_isMaximal (k : Type u) [Field k] : (originIdeal k).IsMaximal := by
  classical
  have relationVanishes : ∀ polynomial : MvPolynomial (Fin 2) k,
      polynomial ∈ relationIdeal k → constantCoeff polynomial = 0 := by
    have relation_le : relationIdeal k ≤
        RingHom.ker (constantCoeff : MvPolynomial (Fin 2) k →+* k) := by
      rw [relationIdeal, Ideal.span_singleton_le_iff_mem]
      simp [RingHom.mem_ker, equation]
    exact fun polynomial membership => relation_le membership
  let evaluation : CoordinateRing k →+* k :=
    Ideal.Quotient.lift (relationIdeal k) constantCoeff relationVanishes
  have evaluation_surjective : Function.Surjective evaluation := by
    apply Ideal.Quotient.lift_surjective_of_surjective
    intro scalar
    exact ⟨C scalar, by simp⟩
  have variables_mem_iff (polynomial : MvPolynomial (Fin 2) k) :
      polynomial ∈ idealOfVars (Fin 2) k ↔ constantCoeff polynomial = 0 := by
    simpa [Nat.lt_one_iff, Finsupp.degree_eq_zero_iff, constantCoeff_eq] using
      mem_pow_idealOfVars_iff' 1 polynomial
  have kernel_eq_map : RingHom.ker evaluation =
      Ideal.map (Ideal.Quotient.mk (relationIdeal k)) (idealOfVars (Fin 2) k) := by
    ext quotient
    obtain ⟨polynomial, rfl⟩ := Ideal.Quotient.mk_surjective quotient
    constructor
    · intro membership
      apply Ideal.mem_map_of_mem
      apply (variables_mem_iff polynomial).mpr
      exact membership
    · intro membership
      obtain ⟨representative, representative_mem, equality⟩ :=
        (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp membership
      rw [← equality]
      exact (variables_mem_iff representative).mp representative_mem
  have origin_eq_map : originIdeal k =
      Ideal.map (Ideal.Quotient.mk (relationIdeal k)) (idealOfVars (Fin 2) k) := by
    simp [originIdeal, idealOfVars, Ideal.map_span, Fin.range_fin_succ,
      Fin.tail, coord, Set.image_insert_eq]
  rw [origin_eq_map, ← kernel_eq_map]
  exact RingHom.ker_isMaximal_of_surjective evaluation evaluation_surjective

/-- The local ring of `k[x, y] ⧸ (x ^ 2 + y ^ 2)` at the origin `(x, y)`. -/
abbrev LocalRing (k : Type u) [Field k] : Type u :=
  Localization.AtPrime (originIdeal k)

/-- The image of the `i`-th coordinate in the local ring. -/
def localCoord (k : Type u) [Field k] (i : Fin 2) : LocalRing k :=
  algebraMap (CoordinateRing k) (LocalRing k) (coord k i)

/-- `localCoord k i` is the image of `coord k i` under the localization map. -/
theorem localCoord_eq (k : Type u) [Field k] (i : Fin 2) :
    localCoord k i = algebraMap (CoordinateRing k) (LocalRing k) (coord k i) := sorry

/-- The maximal ideal of the origin-local ring is generated by the two local coordinates. -/
theorem maximalIdeal_eq_span (k : Type u) [Field k] :
    maximalIdeal (LocalRing k) = Ideal.span {localCoord k 0, localCoord k 1} := sorry

/-- The two-square relation lifts to the local ring. -/
theorem sum_localCoord_sq (k : Type u) [Field k] :
    localCoord k 0 ^ 2 + localCoord k 1 ^ 2 = 0 := sorry

end MvPolynomial.SumOfTwoSquares

namespace MvPolynomial.SumOfThreeSquares

/-- The quadratic form `x ^ 2 + y ^ 2 + z ^ 2` in three variables, with `X 0`
corresponding to `x`, `X 1` corresponding to `y`, and `X 2` corresponding to `z`. -/
def equation (k : Type u) [Field k] : MvPolynomial (Fin 3) k :=
  X (0 : Fin 3) ^ 2 + X (1 : Fin 3) ^ 2 + X (2 : Fin 3) ^ 2

/-- Unfolding of the three-square form as a sum of squares of the three variables. -/
theorem equation_spec (k : Type u) [Field k] :
    equation k = X (0 : Fin 3) ^ 2 + X (1 : Fin 3) ^ 2 + X (2 : Fin 3) ^ 2 := sorry

/-- The principal relation ideal generated by `equation k`. -/
def relationIdeal (k : Type u) [Field k] : Ideal (MvPolynomial (Fin 3) k) :=
  Ideal.span {equation k}

/-- The relation ideal is the principal ideal generated by `equation k`. -/
theorem relationIdeal_eq_span (k : Type u) [Field k] :
    relationIdeal k = Ideal.span {equation k} := sorry

/-- The coordinate ring `k[x, y, z] ⧸ (x ^ 2 + y ^ 2 + z ^ 2)`. -/
abbrev CoordinateRing (k : Type u) [Field k] : Type u :=
  MvPolynomial (Fin 3) k ⧸ relationIdeal k

/-- The class of the `i`-th coordinate in `CoordinateRing k`. -/
def coord (k : Type u) [Field k] (i : Fin 3) : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (X i)

/-- `coord k i` is the class of `X i` in the quotient. -/
theorem coord_eq_mk (k : Type u) [Field k] (i : Fin 3) :
    coord k i = Ideal.Quotient.mk (relationIdeal k) (X i) := sorry

/-- The defining equation vanishes in the coordinate ring. -/
theorem sum_coord_sq (k : Type u) [Field k] :
    coord k 0 ^ 2 + coord k 1 ^ 2 + coord k 2 ^ 2 = 0 := sorry

/-- The origin ideal `(x, y, z)` in the coordinate ring. -/
def originIdeal (k : Type u) [Field k] : Ideal (CoordinateRing k) :=
  Ideal.span {coord k 0, coord k 1, coord k 2}

/-- The origin ideal is generated by the three coordinate classes. -/
theorem originIdeal_eq_span (k : Type u) [Field k] :
    originIdeal k = Ideal.span {coord k 0, coord k 1, coord k 2} := sorry

/-- The origin ideal is the extension of `(x, y, z) = idealOfVars (Fin 3) k`. -/
theorem originIdeal_eq_map (k : Type u) [Field k] :
    originIdeal k =
      Ideal.map (Ideal.Quotient.mk (relationIdeal k)) (idealOfVars (Fin 3) k) := sorry

/-- The origin ideal is maximal, so it is the prime at which we localize. -/
instance originIdeal_isMaximal (k : Type u) [Field k] : (originIdeal k).IsMaximal := by
  classical
  have relationVanishes : ∀ polynomial : MvPolynomial (Fin 3) k,
      polynomial ∈ relationIdeal k → constantCoeff polynomial = 0 := by
    have relation_le : relationIdeal k ≤
        RingHom.ker (constantCoeff : MvPolynomial (Fin 3) k →+* k) := by
      rw [relationIdeal, Ideal.span_singleton_le_iff_mem]
      simp [RingHom.mem_ker, equation]
    exact fun polynomial membership => relation_le membership
  let evaluation : CoordinateRing k →+* k :=
    Ideal.Quotient.lift (relationIdeal k) constantCoeff relationVanishes
  have evaluation_surjective : Function.Surjective evaluation := by
    apply Ideal.Quotient.lift_surjective_of_surjective
    intro scalar
    exact ⟨C scalar, by simp⟩
  have variables_mem_iff (polynomial : MvPolynomial (Fin 3) k) :
      polynomial ∈ idealOfVars (Fin 3) k ↔ constantCoeff polynomial = 0 := by
    simpa [Nat.lt_one_iff, Finsupp.degree_eq_zero_iff, constantCoeff_eq] using
      mem_pow_idealOfVars_iff' 1 polynomial
  have kernel_eq_map : RingHom.ker evaluation =
      Ideal.map (Ideal.Quotient.mk (relationIdeal k)) (idealOfVars (Fin 3) k) := by
    ext quotient
    obtain ⟨polynomial, rfl⟩ := Ideal.Quotient.mk_surjective quotient
    constructor
    · intro membership
      apply Ideal.mem_map_of_mem
      apply (variables_mem_iff polynomial).mpr
      exact membership
    · intro membership
      obtain ⟨representative, representative_mem, equality⟩ :=
        (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp membership
      rw [← equality]
      exact (variables_mem_iff representative).mp representative_mem
  have origin_eq_map : originIdeal k =
      Ideal.map (Ideal.Quotient.mk (relationIdeal k)) (idealOfVars (Fin 3) k) := by
    simp [originIdeal, idealOfVars, Ideal.map_span, Fin.range_fin_succ,
      Fin.tail, coord, Set.image_insert_eq]
  rw [origin_eq_map, ← kernel_eq_map]
  exact RingHom.ker_isMaximal_of_surjective evaluation evaluation_surjective

/-- The local ring of `k[x, y, z] ⧸ (x ^ 2 + y ^ 2 + z ^ 2)` at the origin `(x, y, z)`. -/
abbrev LocalRing (k : Type u) [Field k] : Type u :=
  Localization.AtPrime (originIdeal k)

/-- The image of the `i`-th coordinate in the local ring. -/
def localCoord (k : Type u) [Field k] (i : Fin 3) : LocalRing k :=
  algebraMap (CoordinateRing k) (LocalRing k) (coord k i)

/-- `localCoord k i` is the image of `coord k i` under the localization map. -/
theorem localCoord_eq (k : Type u) [Field k] (i : Fin 3) :
    localCoord k i = algebraMap (CoordinateRing k) (LocalRing k) (coord k i) := sorry

/-- The maximal ideal of the origin-local ring is generated by the three local coordinates. -/
theorem maximalIdeal_eq_span (k : Type u) [Field k] :
    maximalIdeal (LocalRing k) =
      Ideal.span {localCoord k 0, localCoord k 1, localCoord k 2} := sorry

/-- The three-square relation lifts to the local ring. -/
theorem sum_localCoord_sq (k : Type u) [Field k] :
    localCoord k 0 ^ 2 + localCoord k 1 ^ 2 + localCoord k 2 ^ 2 = 0 := sorry

end MvPolynomial.SumOfThreeSquares

namespace IsLocalRing

/-- A Noetherian local ring satisfying a three-generator sum-of-squares relation
has Krull dimension zero, one, or two. -/
theorem ringKrullDim_eq_zero_or_one_or_two
    {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (hchar : ringChar (ResidueField A) ≠ 2) (x y z : A)
    (hspan : maximalIdeal A = Ideal.span {x, y, z})
    (hrel : x ^ 2 + y ^ 2 + z ^ 2 = 0) :
    ringKrullDim A = 0 ∨ ringKrullDim A = 1 ∨ ringKrullDim A = 2 :=
  sorry

/-- A Noetherian local ring whose residue field has characteristic different from two
and whose maximal ideal is generated by three elements whose squares sum to zero
has Krull dimension at most two. -/
theorem ringKrullDim_le_two
    {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (hchar : ringChar (ResidueField A) ≠ 2) (x y z : A)
    (hspan : maximalIdeal A = Ideal.span {x, y, z})
    (hrel : x ^ 2 + y ^ 2 + z ^ 2 = 0) :
    ringKrullDim A ≤ 2 :=
  sorry

/-- A field of characteristic different from two is a zero-dimensional local ring
whose maximal ideal is generated by three zeros satisfying the sum-of-squares
relation, and whose residue characteristic is different from two. -/
theorem field_sumOfSquares_example {k : Type u} [Field k] (hchar : ringChar k ≠ 2) :
    ringKrullDim k = 0 ∧ maximalIdeal k = Ideal.span {(0 : k), 0, 0} ∧
      ((0 : k) ^ 2 + (0 : k) ^ 2 + (0 : k) ^ 2 = 0) ∧
      ringChar (ResidueField k) ≠ 2 := by
  refine ⟨ringKrullDim_eq_zero_of_field k, ?_⟩
  sorry

/-- The maximal ideal of a field is generated by three zeros. -/
theorem field_maximalIdeal_eq_span_zero {k : Type u} [Field k] :
    maximalIdeal k = Ideal.span {(0 : k), 0, 0} :=
  sorry

/-- Three zeros satisfy the sum-of-squares relation. -/
theorem field_sum_of_squares_zero {k : Type u} [Field k] :
    (0 : k) ^ 2 + (0 : k) ^ 2 + (0 : k) ^ 2 = 0 :=
  sorry

/-- The residue field of a field has the same characteristic as the field. -/
theorem field_residueField_ringChar {k : Type u} [Field k] :
    ringChar (ResidueField k) = ringChar k :=
  sorry

/-- The two-square origin-local ring has Krull dimension one. -/
theorem sumOfTwoSquares_ringKrullDim {k : Type u} [Field k]
    (hchar : ringChar k ≠ 2) :
    ringKrullDim (SumOfTwoSquares.LocalRing k) = 1 :=
  sorry

/-- The maximal ideal of the two-square local ring is generated by its local coordinates and zero. -/
theorem sumOfTwoSquares_maximalIdeal_eq_span {k : Type u} [Field k] :
    maximalIdeal (SumOfTwoSquares.LocalRing k) =
      Ideal.span
        {SumOfTwoSquares.localCoord k 0, SumOfTwoSquares.localCoord k 1, 0} :=
  sorry

/-- The local coordinates of the two-square ring satisfy the defining relation. -/
theorem sumOfTwoSquares_sum_localCoord_sq {k : Type u} [Field k] :
    SumOfTwoSquares.localCoord k 0 ^ 2 + SumOfTwoSquares.localCoord k 1 ^ 2 +
        (0 : SumOfTwoSquares.LocalRing k) ^ 2 = 0 :=
  sorry

/-- The residue field of the two-square local ring has the same characteristic as `k`. -/
theorem sumOfTwoSquares_residueField_ringChar {k : Type u} [Field k] :
    ringChar (ResidueField (SumOfTwoSquares.LocalRing k)) = ringChar k :=
  sorry

/-- The three-square origin-local ring has Krull dimension two. -/
theorem sumOfThreeSquares_ringKrullDim {k : Type u} [Field k]
    (hchar : ringChar k ≠ 2) :
    ringKrullDim (SumOfThreeSquares.LocalRing k) = 2 :=
  sorry

/-- The residue field of the three-square local ring has the same characteristic as `k`. -/
theorem sumOfThreeSquares_residueField_ringChar {k : Type u} [Field k] :
    ringChar (ResidueField (SumOfThreeSquares.LocalRing k)) = ringChar k :=
  sorry

/-- Under the three-generator sum-of-squares hypotheses, dimension two implies
the ring is a domain. -/
theorem isDomain_of_ringKrullDim_eq_two
    {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (hchar : ringChar (ResidueField A) ≠ 2) (x y z : A)
    (hspan : maximalIdeal A = Ideal.span {x, y, z})
    (hrel : x ^ 2 + y ^ 2 + z ^ 2 = 0) (hdim : ringKrullDim A = 2) :
    IsDomain A :=
  sorry

end IsLocalRing
