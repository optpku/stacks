module

public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.HasPullback
public import Mathlib.CategoryTheory.Sites.Precoverage
public import stacks_project.Chap65.Definition_65_6_3_Hom
public import stacks_project.Chap65.Lemma_65_7_3_Pullback
public import stacks_project.Chap66.Definition_66_4_1_Points
public import stacks_project.Chap67.Lemma_67_28_11_LocallyOfFinitePresentation
public import stacks_project.Chap67.Lemma_67_30_5_Flat

/-!
# Fppf precoverage on algebraic spaces

The fppf covering families of algebraic spaces over a scheme `S` are the jointly
surjective families of morphisms that are flat and locally of finite presentation.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Limits

universe u v w

namespace AlgebraicGeometry.AlgebraicSpace

/-- The fppf precoverage on algebraic spaces over `S`. A presieve covers when every
arrow is flat and locally of finite presentation, and the family is jointly
surjective on points. -/
def fppfPrecoverage (S : Scheme.{u}) : Precoverage (AlgebraicSpace S) where
  coverings X :=
    { R | (∀ ⦃Y : AlgebraicSpace S⦄ ⦃f : Y ⟶ X⦄, R f →
            Flat f ∧ LocallyOfFinitePresentation f) ∧
          ∀ x : Points X, ∃ (Y : AlgebraicSpace S) (f : Y ⟶ X),
            R f ∧ x ∈ Set.range (Points.map f) }

/-- A displayed family is an fppf covering if and only if each morphism is flat
and locally of finite presentation, and the family is jointly surjective on
points. -/
theorem ofArrows_mem_fppfPrecoverage_iff {S : Scheme.{u}} {X : AlgebraicSpace S}
    {ι : Type v} {Xᵢ : ι → AlgebraicSpace S} (f : (i : ι) → Xᵢ i ⟶ X) :
    Presieve.ofArrows Xᵢ f ∈ (fppfPrecoverage S).coverings X ↔
      (∀ i, Flat (f i)) ∧ (∀ i, LocallyOfFinitePresentation (f i)) ∧
        ∀ x : Points X, ∃ i, x ∈ Set.range (Points.map (f i)) :=
  sorry

/-- Singleton presieves generated by isomorphisms cover for the fppf precoverage. -/
instance instFppfPrecoverageHasIsos {S : Scheme.{u}} :
    (fppfPrecoverage S).HasIsos := sorry

/-- Indexed composition of fppf covering families is again covering. -/
instance instFppfPrecoverageIsStableUnderComposition {S : Scheme.{u}} :
    (fppfPrecoverage S).IsStableUnderComposition := sorry

/-- Base change of fppf covering families along an arbitrary morphism is covering. -/
instance instFppfPrecoverageIsStableUnderBaseChange {S : Scheme.{u}} :
    (fppfPrecoverage S).IsStableUnderBaseChange := sorry

/-- An isomorphism of algebraic spaces over `S` yields a singleton fppf covering. -/
theorem fppfCovering_singleton_of_isIso {S : Scheme.{u}} {X X' : AlgebraicSpace S}
    (f : X' ⟶ X) [IsIso f] :
    Presieve.singleton f ∈ (fppfPrecoverage S).coverings X := sorry

/-- Indexed refinement of fppf coverings remains an fppf covering. -/
theorem fppfCovering_comp {S : Scheme.{u}} {ι : Type v} {X : AlgebraicSpace S}
    {Xᵢ : ι → AlgebraicSpace S} (f : (i : ι) → Xᵢ i ⟶ X)
    (hf : Presieve.ofArrows Xᵢ f ∈ (fppfPrecoverage S).coverings X)
    {J : ι → Type w} {Xᵢⱼ : (i : ι) → J i → AlgebraicSpace S}
    (g : (i : ι) → (j : J i) → Xᵢⱼ i j ⟶ Xᵢ i)
    (hg : ∀ i, Presieve.ofArrows (Xᵢⱼ i) (g i) ∈
      (fppfPrecoverage S).coverings (Xᵢ i)) :
    Presieve.ofArrows (fun ij : Sigma J ↦ Xᵢⱼ ij.1 ij.2)
      (fun ij ↦ g ij.1 ij.2 ≫ f ij.1) ∈ (fppfPrecoverage S).coverings X :=
  sorry

/-- The chosen fibre products of an fppf covering along any morphism of algebraic
spaces form an fppf covering. -/
theorem fppfCovering_pullback {S : Scheme.{u}} {X X' : AlgebraicSpace S}
    {ι : Type v} {Xᵢ : ι → AlgebraicSpace S} (f : (i : ι) → Xᵢ i ⟶ X)
    (hf : Presieve.ofArrows Xᵢ f ∈ (fppfPrecoverage S).coverings X)
    (g : X' ⟶ X) :
    Presieve.ofArrows (fun i ↦ pullback g (f i))
      (fun i ↦ pullback.fst g (f i)) ∈ (fppfPrecoverage S).coverings X' :=
  sorry

end AlgebraicGeometry.AlgebraicSpace
