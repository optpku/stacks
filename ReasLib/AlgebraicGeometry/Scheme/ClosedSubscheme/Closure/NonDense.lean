module

public import Mathlib.RingTheory.MvPolynomial.Basic
public import ReasLib.AlgebraicGeometry.Scheme.ClosedSubscheme.Closure

@[expose] public section

noncomputable section

open MvPolynomial

namespace AlgebraicGeometry.SchemeTheoreticClosure.NonDenseExample

universe u

variable (k : Type u) [Field k]

/-- A variable set consisting of one distinguished coordinate and a countable family of
coordinates. -/
def Variables : Type := Unit ⊕ ℕ

/-- The distinguished polynomial coordinate. -/
def x : MvPolynomial Variables k :=
  X (Sum.inl ())

/-- The countable family of polynomial coordinates. -/
def z (n : ℕ) : MvPolynomial Variables k :=
  X (Sum.inr n)

/-- The ideal generated by the relations `x ^ (n + 1) * z n` for `n : ℕ`. -/
def relationIdeal : Ideal (MvPolynomial Variables k) :=
  Ideal.span (Set.range fun n : ℕ ↦ x k ^ (n + 1) * z k n)

/-- The polynomial ring on the distinguished and countable coordinates modulo the relation
ideal. -/
abbrev coordinateRing :=
  MvPolynomial Variables k ⧸ relationIdeal k

/-- The class of the distinguished coordinate in the quotient ring. -/
def xClass : coordinateRing k :=
  Ideal.Quotient.mk _ (x k)

/-- The class of the `n`-th countable coordinate in the quotient ring. -/
def zClass (n : ℕ) : coordinateRing k :=
  Ideal.Quotient.mk _ (z k n)

/-- The ideal in the quotient ring generated by the countable coordinate classes. -/
def openIdeal : Ideal (coordinateRing k) :=
  Ideal.span (Set.range fun n : ℕ ↦ zClass k n)

/-- The affine spectrum of the quotient coordinate ring. -/
abbrev scheme :=
  Spec (CommRingCat.of (coordinateRing k))

/-- The open complement of the zero locus of the countable-coordinate ideal. -/
def «open» : (scheme k).Opens :=
  ⟨(PrimeSpectrum.zeroLocus (openIdeal k : Set (coordinateRing k)))ᶜ,
    (PrimeSpectrum.isClosed_zeroLocus _).isOpen_compl⟩

/-- The underlying set of the open is the complement of the zero locus of its defining ideal. -/
@[simp]
theorem open_coe_eq_compl_zeroLocus :
    («open» k : Set (scheme k)) =
      (PrimeSpectrum.zeroLocus (openIdeal k : Set (coordinateRing k)))ᶜ := rfl

/-- The scheme-theoretic closure of the specified open is the whole affine scheme. -/
theorem schemeTheoreticClosure_open :
    AlgebraicGeometry.schemeTheoreticClosure («open» k) = scheme k := sorry

/-- The specified open is not dense in the underlying topological space of the affine scheme. -/
theorem not_dense_open :
    ¬ Dense («open» k : Set (scheme k)) := sorry

end AlgebraicGeometry.SchemeTheoreticClosure.NonDenseExample
