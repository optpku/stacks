module

public import ReasLib.AlgebraicGeometry.Scheme.Blowup.Picard
import StacksCheckRecall

@[expose] public section

noncomputable section

universe u

open CategoryTheory

namespace AlgebraicGeometry.IsBlowup

/- Lemma 54.3.3: the Picard group of the blowup of the spectrum of a
two-dimensional regular local ring at its maximal ideal is infinite cyclic, generated by
the class of the exceptional divisor sheaf `𝒪_X(E)`. -/
@[stacks 0C5G]
#check (AlgebraicGeometry.IsBlowup.existsIntAddEquivPicardGroup_of_maximalIdeal :
    ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A]
    (h_dim : ringKrullDim A = 2) {X : Scheme.{u}} (f : X ⟶ Spec (.of A))
    [IsBlowup f (Scheme.idealSheafDataOfIdealOnSpec (IsLocalRing.maximalIdeal A))],
    let E := exceptionalIdeal (IsLocalRing.maximalIdeal A) f
    ∃ e : ℤ ≃+ X.PicardGroup,
      ∀ n : ℤ, e n = n • Scheme.Modules.picardClass E.associatedSheaf)

end AlgebraicGeometry.IsBlowup
