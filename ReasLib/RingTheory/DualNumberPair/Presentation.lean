module

public import ReasLib.RingTheory.DualNumberPair
public import Mathlib.Algebra.Field.ZMod
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.Ideal.Quotient.Basic

@[expose] public section

noncomputable section

open DualNumberPair MvPolynomial
open scoped DualNumberPair

namespace DualNumberPair

/-- `DualNumberPair (ZMod 2)` is the quotient of `MvPolynomial (Fin 2) (ZMod 2)`
by the ideal generated by the squares and mixed product of the variables. -/
def equivMvPolynomial :
    DualNumberPair (ZMod 2) ≃+*
      MvPolynomial (Fin 2) (ZMod 2) ⧸
        (Ideal.span {X 0 ^ 2, X 0 * X 1, X 1 ^ 2} :
          Ideal (MvPolynomial (Fin 2) (ZMod 2))) :=
  let I : Ideal (MvPolynomial (Fin 2) (ZMod 2)) :=
    Ideal.span {X 0 ^ 2, X 0 * X 1, X 1 ^ 2}
  let evalAtEps : MvPolynomial (Fin 2) (ZMod 2) →+* DualNumberPair (ZMod 2) :=
    eval₂Hom (TrivSqZeroExt.inlHom (ZMod 2) (ZMod 2 × ZMod 2))
      (fun i : Fin 2 ↦ if i = 0 then (ε₁ : DualNumberPair (ZMod 2)) else ε₂)
  RingEquiv.ofRingHom
    { toFun x := Ideal.Quotient.mk I (C x.fst + C x.snd.1 * X 0 + C x.snd.2 * X 1)
      map_one' := sorry
      map_mul' := sorry
      map_zero' := sorry
      map_add' := sorry }
    (Ideal.Quotient.lift I evalAtEps sorry)
    sorry
    sorry

/-- `equivMvPolynomial` sends `ε₁` to the class of the first polynomial variable. -/
theorem equivMvPolynomial_eps1 :
    equivMvPolynomial (ε₁ : DualNumberPair (ZMod 2)) =
      Ideal.Quotient.mk
        (Ideal.span {X 0 ^ 2, X 0 * X 1, X 1 ^ 2} :
          Ideal (MvPolynomial (Fin 2) (ZMod 2)))
        (X (0 : Fin 2)) :=
  sorry

/-- `equivMvPolynomial` sends `ε₂` to the class of the second polynomial variable. -/
theorem equivMvPolynomial_eps2 :
    equivMvPolynomial (ε₂ : DualNumberPair (ZMod 2)) =
      Ideal.Quotient.mk
        (Ideal.span {X 0 ^ 2, X 0 * X 1, X 1 ^ 2} :
          Ideal (MvPolynomial (Fin 2) (ZMod 2)))
        (X (1 : Fin 2)) :=
  sorry

end DualNumberPair
