module

public import Mathlib.RingTheory.Extension.Presentation.Basic
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Relation ideals of algebra presentations

This leaf owns the ideal generated by an arbitrary subset of the relations of
a presentation.  It also records the intrinsic condition that multiplication
by a lift of a target element sends every relation into that ideal modulo the
square of the full relation ideal.
-/

@[expose] public section

universe u v w t

namespace Algebra.Presentation

variable {R : Type u} {A : Type v} [CommRing R] [CommRing A] [Algebra R A]
variable {ι : Type w} {σ : Type t}

/-- The ideal generated by the relations whose indices belong to `s`. -/
@[stacks 07C6 "relation ideal of a presentation"]
noncomputable def relationIdeal (P : Presentation R A ι σ) (s : Set σ) : Ideal P.Ring :=
  Ideal.span (P.relation '' s)

/-- A relation selected by `s` belongs to the relation ideal generated by
`s`. -/
theorem relation_mem_relationIdeal (P : Presentation R A ι σ)
    {s : Set σ} {j : σ} (hj : j ∈ s) :
    P.relation j ∈ P.relationIdeal s := sorry

/-- Containment of a relation ideal is equivalent to containment of each
selected relation. -/
theorem relationIdeal_le_iff (P : Presentation R A ι σ)
    (s : Set σ) (J : Ideal P.Ring) :
    P.relationIdeal s ≤ J ↔ ∀ j ∈ s, P.relation j ∈ J := sorry

/-- Enlarging the selected set of relations enlarges its relation ideal. -/
theorem relationIdeal_mono (P : Presentation R A ι σ) :
    Monotone P.relationIdeal := sorry

/-- The empty family of relations generates the zero ideal. -/
@[simp]
theorem relationIdeal_empty (P : Presentation R A ι σ) :
    P.relationIdeal ∅ = ⊥ := sorry

/-- All relations together generate the full kernel of the presentation. -/
@[simp]
theorem relationIdeal_univ (P : Presentation R A ι σ) :
    P.relationIdeal Set.univ = P.ker := sorry

/-- Multiplication by a lift of `a` sends every relation into the ideal
generated by `s`, modulo the square of the full relation ideal. -/
@[stacks 07C6 "fixed-presentation relation condition"]
def relationCondition
    (P : Presentation R A ι σ) (a : A) (s : Set σ) : Prop :=
  ∃ a₀ : P.Ring,
    algebraMap P.Ring A a₀ = a ∧
      ∀ j, a₀ * P.relation j ∈ P.relationIdeal s + P.ker ^ 2

/-- The relation condition can be checked using the distinguished section of
the presentation. -/
theorem relationCondition_iff_sigma
    (P : Presentation R A ι σ) (a : A) (s : Set σ) :
    P.relationCondition a s ↔
      ∀ j, P.σ a * P.relation j ∈ P.relationIdeal s + P.ker ^ 2 := sorry

/-- Enlarging the selected relation family preserves the relation condition. -/
theorem RelationCondition.mono
    (P : Presentation R A ι σ) {a : A} {s t : Set σ}
    (h : P.relationCondition a s) (hst : s ⊆ t) :
    P.relationCondition a t := sorry

end Algebra.Presentation
