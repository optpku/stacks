module

public import ReasLib.Algebra.Homology.CochainComplex.BerthelotOgus.Eta.Int
public import ReasLib.AlgebraicGeometry.RingedSpace.Module.Ideal.Eta.Functoriality
public import ReasLib.AlgebraicGeometry.RingedSpace.Module.Ideal.Stalk.Generator
public import ReasLib.AlgebraicGeometry.RingedSpace.Module.Stalk.Complex
import Mathlib.Tactic.CrossRefAttribute

/-!
# Stalks of the ideal-sheaf eta complex

At a point where the ideal stalk is generated by `f`, the stalk of the ideal-sheaf eta complex
agrees with the divided-differential eta complex over the stalk ring.  The comparison is exposed
degreewise, objectwise, and naturally on the canonical action-monic domain.
-/

@[expose] public section

open CategoryTheory ComplexShape

noncomputable section

universe u

namespace AlgebraicGeometry.RingedSpace.IdealSheaf.Eta.Stalk

variable {X : RingedSpace.{u}}

/-- A chosen generator of `I_x` acts regularly in every degree of the stalk complex of an
`I`-action-monic complex. -/
@[stacks 0GT6 "stalkwise termwise regularity"]
theorem termwiseRegular
    (I : Subobject (SheafOfModules.unit X.ringCatSheaf : X.Modules))
    [IsRegularPrincipal I] (K : CochainComplex X.Modules ℤ)
    [IsActionMono.Complex I K] (x : X) (f : X.presheaf.stalk x)
    (hf : IsStalkGenerator I x f) :
    (RingedSpace.stalkComplex K x).IsTermwiseSMulRegular f := sorry

/-- Taking stalks sends an object of the ideal-sheaf eta domain to the regular domain of the
divided-differential eta construction associated to a chosen stalk generator. -/
theorem domainFunctor_mem
    (I : Subobject (SheafOfModules.unit X.ringCatSheaf : X.Modules))
    [IsRegularPrincipal I] (x : X) (f : X.presheaf.stalk x)
    (hf : IsStalkGenerator I x f) (K : Eta.Domain I) :
    CochainComplex.BerthelotOgus.Int.IsTermwiseTorsionFree f
      (RingedSpace.stalkComplex K.obj x) := sorry

/-- The stalk functor from the ideal-sheaf eta domain to the regular local eta domain determined
by a chosen stalk generator. -/
@[stacks 0GT6 "stalk functor on eta domains"]
noncomputable def domainFunctor
    (I : Subobject (SheafOfModules.unit X.ringCatSheaf : X.Modules))
    [IsRegularPrincipal I] (x : X) (f : X.presheaf.stalk x)
    (hf : IsStalkGenerator I x f) :
    Eta.Domain I ⥤ CochainComplex.BerthelotOgus.Int.Domain f :=
  ObjectProperty.lift _
    ((IsActionMono.complex I (up ℤ)).ι ⋙ RingedSpace.stalkComplexFunctor (up ℤ) x)
    (domainFunctor_mem I x f hf)

/-- The functor obtained by first applying the ideal-sheaf eta functor and then taking the stalk
complex at `x`. -/
abbrev sheafFunctor
    (I : Subobject (SheafOfModules.unit X.ringCatSheaf : X.Modules))
    [IsRegularPrincipal I] (x : X) :
    Eta.Domain I ⥤ CochainComplex (ModuleCat (X.presheaf.stalk x)) ℤ :=
  Eta.functor I ⋙ RingedSpace.stalkComplexFunctor (up ℤ) x

/-- The functor obtained by first taking the stalk complex and then applying the local
divided-differential eta functor for `f`. -/
noncomputable abbrev localFunctor
    (I : Subobject (SheafOfModules.unit X.ringCatSheaf : X.Modules))
    [IsRegularPrincipal I] (x : X) (f : X.presheaf.stalk x)
    (hf : IsStalkGenerator I x f) :
    Eta.Domain I ⥤ CochainComplex (ModuleCat (X.presheaf.stalk x)) ℤ :=
  domainFunctor I x f hf ⋙ CochainComplex.BerthelotOgus.Int.functor f

/-- In each degree, the stalk of an ideal-sheaf eta term is isomorphic to the corresponding
divided-differential eta term over the stalk ring. -/
@[stacks 0GT6 "degreewise stalk comparison"]
theorem objStalk_isomorphic
    (I : Subobject (SheafOfModules.unit X.ringCatSheaf : X.Modules))
    [IsRegularPrincipal I] (K : CochainComplex X.Modules ℤ)
    [IsActionMono.Complex I K] (x : X) (f : X.presheaf.stalk x)
    (hf : IsStalkGenerator I x f) (i : ℤ) :
    IsIsomorphic
      (RingedSpace.stalkModuleCat (Eta.obj I K i) x)
      (ModuleCat.of (X.presheaf.stalk x)
        (CochainComplex.BerthelotOgus.Int.term f
          (RingedSpace.stalkComplex K x) i)) := sorry

/-- Lemma 20.55.4 (0GT6): the stalk of the ideal-sheaf eta complex is isomorphic to the local
divided-differential eta complex associated to a chosen generator of the stalk ideal. -/
@[stacks 0GT6]
theorem complex_isomorphic
    (I : Subobject (SheafOfModules.unit X.ringCatSheaf : X.Modules))
    [IsRegularPrincipal I] (K : CochainComplex X.Modules ℤ)
    [IsActionMono.Complex I K] (x : X) (f : X.presheaf.stalk x)
    (hf : IsStalkGenerator I x f) :
    IsIsomorphic
      (RingedSpace.stalkComplex (Eta.complex I K) x)
      (CochainComplex.BerthelotOgus.Int.eta f
        (RingedSpace.stalkComplex K x) (termwiseRegular I K x f hf)) := sorry

/-- The stalk comparison for the eta construction is natural on the canonical action-monic
domain: the two resulting functors are isomorphic in the functor category. -/
@[stacks 0GT6 "natural stalk comparison"]
theorem functor_isomorphic
    (I : Subobject (SheafOfModules.unit X.ringCatSheaf : X.Modules))
    [IsRegularPrincipal I] (x : X) (f : X.presheaf.stalk x)
    (hf : IsStalkGenerator I x f) :
    IsIsomorphic (sheafFunctor I x) (localFunctor I x f hf) := sorry

end AlgebraicGeometry.RingedSpace.IdealSheaf.Eta.Stalk
