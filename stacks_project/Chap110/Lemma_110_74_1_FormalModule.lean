module

public import Mathlib.AlgebraicGeometry.Modules.Tilde
public import Mathlib.CategoryTheory.Functor.OfSequence
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import ReasLib.AlgebraicGeometry.Scheme.CoherentFormalModule.Completion.ProperSupport
public import stacks_project.Chap99.Lemma_99_5_2
public import stacks_project.Chap99.Proposition_99_8_4_Representable
public import stacks_project.Chap110.Lemma_110_74_1_Scheme

/-!
# The coherent formal module on the non-separated algebraization example

The inverse system `(F_n)` is the pushforward of `tilde(A[x] / (x, t^n))` along the first
chart, equivalently `A_n[x]/(x)` on the first chart and `0` on the second.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
open AlgebraicGeometry.Scheme
open AlgebraicGeometry.Scheme.Modules

noncomputable section

universe u

namespace AlgebraicGeometry.NonseparatedAlgebraization

/-- The ideal sheaf `I 𝒪_X` generated by `t` on `scheme k`. -/
def idealSheaf (k : Type u) [Field k] : (scheme k).IdealSheafData :=
  (idealSheafDataOfIdealOnSpec (adicIdeal k)).comap (toSpec k)

/-- Unfolding of `idealSheaf`. -/
theorem idealSheaf_eq (k : Type u) [Field k] :
    idealSheaf k = (idealSheafDataOfIdealOnSpec (adicIdeal k)).comap (toSpec k) :=
  sorry

/-- The evaluation `A[x] → k` at the special origin `(x, t)`. -/
def originEval (k : Type u) [Field k] : Polynomial (powerSeriesRing k) →+* k :=
  Polynomial.eval₂RingHom PowerSeries.constantCoeff 0

/-- Unfolding of `originEval`. -/
theorem originEval_eq (k : Type u) [Field k] :
    originEval k = Polynomial.eval₂RingHom PowerSeries.constantCoeff 0 := sorry

/-- The closed point `(x, t)` of `Spec(A[x])`. -/
def originPoint (k : Type u) [Field k] : affineLine k :=
  (Spec.map (CommRingCat.ofHom (originEval k))).base default

/-- Unfolding of `originPoint`. -/
theorem originPoint_eq (k : Type u) [Field k] :
    originPoint k = (Spec.map (CommRingCat.ofHom (originEval k))).base default :=
  sorry

/-- The copy of the special origin in the `i`-th canonical chart of `scheme k`. -/
def originSection (k : Type u) [Field k] (i : Fin 2) : scheme k :=
  DoubleAlong.point (puncturedOpen k) i (originPoint k)

/-- Unfolding of `originSection`. -/
theorem originSection_eq (k : Type u) [Field k] (i : Fin 2) :
    originSection k i = DoubleAlong.point (puncturedOpen k) i (originPoint k) :=
  sorry

/-- The ideal `(x, t^n)` in `A[x]`, presenting the chartwise module `A_n[x]/(x)`. -/
def chartStageIdeal (k : Type u) [Field k] (n : ℕ) :
    Ideal (Polynomial (powerSeriesRing k)) :=
  Ideal.span {Polynomial.X} ⊔ (adicIdeal k ^ n).map Polynomial.C

/-- Unfolding of `chartStageIdeal`. -/
theorem chartStageIdeal_eq (k : Type u) [Field k] (n : ℕ) :
    chartStageIdeal k n =
      Ideal.span {Polynomial.X} ⊔ (adicIdeal k ^ n).map Polynomial.C := sorry

/-- Successor ideals `(x, t^{n+1})` are contained in `(x, t^n)`. -/
theorem chartStageIdeal_succ_le (k : Type u) [Field k] (n : ℕ) :
    chartStageIdeal k (n + 1) ≤ chartStageIdeal k n := sorry

/-- The `A[x]`-module `A[x] / (x, t^n)`. -/
def chartStageModule (k : Type u) [Field k] (n : ℕ) :
    ModuleCat (CommRingCat.of (Polynomial (powerSeriesRing k))) :=
  ModuleCat.of _ (Polynomial (powerSeriesRing k) ⧸ chartStageIdeal k n)

/-- Unfolding of `chartStageModule`. -/
theorem chartStageModule_eq (k : Type u) [Field k] (n : ℕ) :
    chartStageModule k n =
      ModuleCat.of _ (Polynomial (powerSeriesRing k) ⧸ chartStageIdeal k n) :=
  sorry

/-- The quasi-coherent sheaf on `Spec(A[x])` associated to `A[x] / (x, t^n)`. -/
def chartStage (k : Type u) [Field k] (n : ℕ) : (affineLine k).Modules :=
  (tilde.functor (CommRingCat.of (Polynomial (powerSeriesRing k)))).obj
    (chartStageModule k n)

/-- Unfolding of `chartStage`. -/
theorem chartStage_eq (k : Type u) [Field k] (n : ℕ) :
    chartStage k n =
      (tilde.functor (CommRingCat.of (Polynomial (powerSeriesRing k)))).obj
        (chartStageModule k n) := sorry

/-- The sheaf on `scheme k` obtained by pushing `chartStage k n` forward along the first chart. -/
def stage (k : Type u) [Field k] (n : ℕ) : (scheme k).Modules :=
  (pushforward (chartMap k 0)).obj (chartStage k n)

/-- Unfolding of `stage`. -/
theorem stage_eq (k : Type u) [Field k] (n : ℕ) :
    stage k n = (pushforward (chartMap k 0)).obj (chartStage k n) := sorry

/-- Restriction of `stage k n` to the first chart recovers `chartStage k n`. -/
def stageRestrictChartZeroIso (k : Type u) [Field k] (n : ℕ) :
    (Scheme.Modules.restrictFunctor (chartMap k 0)).obj (stage k n) ≅ chartStage k n :=
  (Scheme.Modules.restrictFunctorAdjCounitIso (chartMap k 0)).app (chartStage k n)

/-- Unfolding of `stageRestrictChartZeroIso`. -/
theorem stageRestrictChartZeroIso_eq (k : Type u) [Field k] (n : ℕ) :
    stageRestrictChartZeroIso k n =
      (Scheme.Modules.restrictFunctorAdjCounitIso (chartMap k 0)).app
        (chartStage k n) :=
  sorry

/-- Restriction of `stage k n` to the second chart vanishes. -/
theorem isZero_stage_restrict_chartMap_one (k : Type u) [Field k] (n : ℕ) :
    IsZero ((Scheme.Modules.restrictFunctor (chartMap k 1)).obj (stage k n)) :=
  sorry

/-- The sheaf `stage k n` is coherent. -/
theorem isCoherent_stage (k : Type u) [Field k] (n : ℕ) :
    SheafOfModules.IsCoherent (stage k n) := sorry

/-- The coherent module at truncation stage `n` on `scheme k`. -/
def coherentStage (k : Type u) [Field k] (n : ℕ) :
    RingedSpace.Coh (scheme k).toRingedSpace :=
  ⟨stage k n, isCoherent_stage k n⟩

/-- Unfolding of `coherentStage`. -/
theorem coherentStage_eq (k : Type u) [Field k] (n : ℕ) :
    coherentStage k n = ⟨stage k n, isCoherent_stage k n⟩ := sorry

/-- The `A[x]`-linear successor map `A[x]/(x, t^{n+1}) → A[x]/(x, t^n)`. -/
def chartStageFactor (k : Type u) [Field k] (n : ℕ) :
    Polynomial (powerSeriesRing k) ⧸ chartStageIdeal k (n + 1) →ₗ[Polynomial (powerSeriesRing k)]
      Polynomial (powerSeriesRing k) ⧸ chartStageIdeal k n :=
  (Ideal.Quotient.factorₐ (Polynomial (powerSeriesRing k))
    (sup_le_sup le_rfl
      (Ideal.map_mono (Ideal.pow_le_pow_right (Nat.le_succ n))))).toLinearMap

/-- Unfolding of `chartStageFactor`. -/
theorem chartStageFactor_eq (k : Type u) [Field k] (n : ℕ) :
    chartStageFactor k n =
      (Ideal.Quotient.factorₐ (Polynomial (powerSeriesRing k))
        (sup_le_sup le_rfl
          (Ideal.map_mono (Ideal.pow_le_pow_right (Nat.le_succ n))))).toLinearMap :=
  sorry

/-- The sheaf morphism on `Spec(A[x])` induced by the successor quotient. -/
def chartStageHom (k : Type u) [Field k] (n : ℕ) :
    chartStage k (n + 1) ⟶ chartStage k n :=
  (tilde.functor (CommRingCat.of (Polynomial (powerSeriesRing k)))).map
    (ModuleCat.ofHom (chartStageFactor k n))

/-- Unfolding of `chartStageHom`. -/
theorem chartStageHom_eq (k : Type u) [Field k] (n : ℕ) :
    chartStageHom k n =
      (tilde.functor (CommRingCat.of (Polynomial (powerSeriesRing k)))).map
        (ModuleCat.ofHom (chartStageFactor k n)) := sorry

/-- The sheaf morphism on `scheme k` induced by the successor quotient. -/
def stageHomModules (k : Type u) [Field k] (n : ℕ) :
    stage k (n + 1) ⟶ stage k n :=
  (pushforward (chartMap k 0)).map (chartStageHom k n)

/-- Unfolding of `stageHomModules`. -/
theorem stageHomModules_eq (k : Type u) [Field k] (n : ℕ) :
    stageHomModules k n = (pushforward (chartMap k 0)).map (chartStageHom k n) :=
  sorry

/-- The coherent successor morphism `F_{n+1} ⟶ F_n`. -/
def stageHom (k : Type u) [Field k] (n : ℕ) :
    coherentStage k (n + 1) ⟶ coherentStage k n :=
  ObjectProperty.homMk (stageHomModules k n)

/-- Unfolding of `stageHom`. -/
theorem stageHom_eq (k : Type u) [Field k] (n : ℕ) :
    stageHom k n = ObjectProperty.homMk (stageHomModules k n) := sorry

/-- The inverse system `(F_n)` of coherent sheaves on `scheme k`. -/
def formalSystem (k : Type u) [Field k] :
    SequentialInverseSystem (RingedSpace.Coh (scheme k).toRingedSpace) :=
  Functor.ofOpSequence (stageHom k)

/-- Unfolding of `formalSystem`. -/
theorem formalSystem_eq (k : Type u) [Field k] :
    formalSystem k = Functor.ofOpSequence (stageHom k) := sorry

/-- The constructed inverse system is a coherent formal module along `idealSheaf k`. -/
theorem isCoherentFormalModuleSystem_formalSystem (k : Type u) [Field k] :
    IsCoherentFormalModuleSystem (idealSheaf k) (formalSystem k) := sorry

/-- The coherent formal module determined by `(F_n)`. -/
def coherentFormal (k : Type u) [Field k] :
    CoherentFormalModules (scheme k) (idealSheaf k) :=
  ⟨formalSystem k, isCoherentFormalModuleSystem_formalSystem k⟩

/-- Unfolding of `coherentFormal`. -/
theorem coherentFormal_eq (k : Type u) [Field k] :
    coherentFormal k =
      ⟨formalSystem k, isCoherentFormalModuleSystem_formalSystem k⟩ := sorry

/-- The first stage of `coherentFormal k` has support proper over `Spec(A)`. -/
theorem hasProperSupport_stage_one (k : Type u) [Field k] :
    HasProperSupportOver (toSpec k)
      (coherentFormalModuleStage (coherentFormal k) 1).obj := sorry

/-- The object of `Coh_{support proper over A}(X, I)` determined by `(F_n)`. -/
def formalModule (k : Type u) [Field k] :
    CoherentFormalProperSupportOver (toSpec k) (idealSheaf k) :=
  ⟨coherentFormal k, hasProperSupport_stage_one k⟩

/-- Unfolding of `formalModule`. -/
theorem formalModule_eq (k : Type u) [Field k] :
    formalModule k = ⟨coherentFormal k, hasProperSupport_stage_one k⟩ := sorry

/-- The constructed formal module does not lie in the essential image of proper-support
completion. -/
theorem not_mem_essImage (k : Type u) [Field k] :
    ¬ (coherentProperSupportCompletionFunctor :
          CoherentProperSupportOver (toSpec k) ⥤
            CoherentFormalProperSupportOver (toSpec k) (idealSheaf k)).essImage
        (formalModule k) := sorry

end AlgebraicGeometry.NonseparatedAlgebraization
