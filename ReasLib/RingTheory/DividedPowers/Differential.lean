module

public import Mathlib.Algebra.Category.ModuleCat.Basic
public import Mathlib.RingTheory.DividedPowers.Basic
public import ReasLib.RingTheory.DividedPowers.Polynomial
public import ReasLib.RingTheory.Kaehler.DeRham

@[expose] public section

noncomputable section

open CategoryTheory

universe u

namespace DPPolynomial.DeRham

variable (A : Type u) [CommRing A] (ι : Type u)

/-- The canonical divided powers on the positive ideal of the divided-power polynomial algebra. -/
noncomputable def powers : DividedPowers (ideal A ι (⊥ : Ideal A)) :=
  DPPolynomial.dividedPowers (ι := ι) (dividedPowersBot A)

/-- The graded relation generated by the divided-power differential rules and their exterior
products. -/
noncomputable def dividedPowerRelation (i : ℕ) :
    Submodule A (KaehlerDifferential.DeRham.AForm A (DPPolynomial A ι) i) :=
  match i with
  | 0 => 0
  | k + 1 =>
      Submodule.span A (Set.range fun q : DPPolynomial A ι × ℕ ×
          ideal A ι (⊥ : Ideal A) × (Fin k → DPPolynomial A ι) ↦
        KaehlerDifferential.DeRham.aBasic A (DPPolynomial A ι) (k + 1) q.1
            (Fin.cons ((powers A ι).dpow (q.2.1 + 1) q.2.2.1) q.2.2.2) -
          KaehlerDifferential.DeRham.aBasic A (DPPolynomial A ι) (k + 1)
            (q.1 * (powers A ι).dpow q.2.1 q.2.2.1)
            (Fin.cons q.2.2.1 q.2.2.2))

/-- The degree-one specialization of the graded divided-power relation. -/
noncomputable def dividedPowerOneRelation :
    Submodule A (KaehlerDifferential.DeRham.AForm A (DPPolynomial A ι) 1) :=
  dividedPowerRelation A ι 1

/-- The degree-`i` divided-power differential forms, presented by quotienting ordinary forms by
the divided-power differential relations. -/
noncomputable def form (i : ℕ) : ModuleCat.{u} A :=
  ModuleCat.of A
    (KaehlerDifferential.DeRham.AForm A (DPPolynomial A ι) i ⧸
      dividedPowerRelation A ι i)

/-- The divided-power one-form module obtained from the differential relation quotient. -/
noncomputable abbrev dividedPowerForm : ModuleCat.{u} A := form A ι 1

/-- The ordinary differential descends to the divided-power differential-form quotients. -/
noncomputable def formDifferential (i : ℕ) : form A ι i ⟶ form A ι (i + 1) :=
  ModuleCat.ofHom <|
    (dividedPowerRelation A ι i).liftQ
      ((dividedPowerRelation A ι (i + 1)).mkQ.comp
        (KaehlerDifferential.DeRham.rawD A (DPPolynomial A ι) i).hom) (by
          intro x hx
          sorry)

/-- The descended differential sends a basic form to the corresponding exact form. -/
theorem formDifferential_basic (i : ℕ) (b₀ : DPPolynomial A ι)
    (b : Fin i → DPPolynomial A ι) :
    formDifferential A ι i
        ((dividedPowerRelation A ι i).mkQ
          (KaehlerDifferential.DeRham.aBasic A (DPPolynomial A ι) i b₀ b)) =
      (dividedPowerRelation A ι (i + 1)).mkQ
        (KaehlerDifferential.DeRham.aExact A (DPPolynomial A ι) (i + 1)
          (Fin.cons b₀ b)) := sorry

/-- Consecutive descended divided-power differentials compose to zero. -/
theorem dividedPowerFormDifferential (i : ℕ) :
    formDifferential A ι i ≫ formDifferential A ι (i + 1) = 0 := sorry

end DPPolynomial.DeRham
