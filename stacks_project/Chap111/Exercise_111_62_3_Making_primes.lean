module

public import Mathlib.Data.Complex.Basic
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Nullstellensatz
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

noncomputable section

universe u

open MvPolynomial PrimeSpectrum

namespace MvPolynomial

/-- The generator `X 1 - X 0 - C t * X 0 * (X 0 - 1)` of the pencil of plane curves
through `(0, 0)` and `(1, 1)`, with `X 0` corresponding to `x` and `X 1` to `y`. -/
def curvePoly {k : Type u} [CommRing k] (t : k) : MvPolynomial (Fin 2) k :=
  X 1 - X 0 - C t * X 0 * (X 0 - 1)

/-- The principal ideal generated by `curvePoly t`. -/
def curveIdeal {k : Type u} [CommRing k] (t : k) : Ideal (MvPolynomial (Fin 2) k) :=
  Ideal.span {curvePoly t}

/-- `curveIdeal t` is the principal ideal generated by `curvePoly t`. -/
theorem curveIdeal_eq_span {k : Type u} [CommRing k] (t : k) :
    curveIdeal t = Ideal.span {curvePoly t} := sorry

/-- For a field `k`, the principal ideal `curveIdeal t` is prime. -/
instance curveIdeal_isPrime {k : Type u} [Field k] (t : k) : (curveIdeal t).IsPrime := sorry

/-- The affine curve cut out by `curvePoly t` contains the origin. -/
theorem curvePoly_aeval_zero {k : Type u} [CommRing k] (t : k) :
    aeval (0 : Fin 2 → k) (curvePoly t) = 0 := sorry

/-- The affine curve cut out by `curvePoly t` contains the point `(1, 1)`. -/
theorem curvePoly_aeval_one {k : Type u} [CommRing k] (t : k) :
    aeval (1 : Fin 2 → k) (curvePoly t) = 0 := sorry

/-- The vanishing ideal of the origin is the textbook ideal `(x, y)`. -/
theorem vanishingIdeal_zero_eq_idealOfVars {k : Type u} [Field k] :
    vanishingIdeal k {(0 : Fin 2 → k)} = idealOfVars (Fin 2) k := sorry

/-- The vanishing ideal of `(1, 1)` is the textbook ideal `(x - 1, y - 1)`. -/
theorem vanishingIdeal_one_eq_span {k : Type u} [Field k] :
    vanishingIdeal k {(1 : Fin 2 → k)} = Ideal.span {X 0 - 1, X 1 - 1} := sorry

/-- The closed point corresponding to `(x, y)` lies in `PrimeSpectrum.zeroLocus (curveIdeal t)`. -/
theorem zero_mem_zeroLocus_curveIdeal {k : Type u} [Field k] (t : k) :
    pointToPoint (0 : Fin 2 → k) ∈
      PrimeSpectrum.zeroLocus (curveIdeal t : Set (MvPolynomial (Fin 2) k)) := sorry

/-- The closed point corresponding to `(x - 1, y - 1)` lies in
`PrimeSpectrum.zeroLocus (curveIdeal t)`. -/
theorem one_mem_zeroLocus_curveIdeal {k : Type u} [Field k] (t : k) :
    pointToPoint (1 : Fin 2 → k) ∈
      PrimeSpectrum.zeroLocus (curveIdeal t : Set (MvPolynomial (Fin 2) k)) := sorry

/-- Distinct parameters determine distinct members of the pencil. -/
theorem curveIdeal_injective {k : Type u} [Field k] :
    Function.Injective (fun t : k ↦ curveIdeal t) := sorry

/-- Over an infinite field the pencil supplies infinitely many distinct primes. -/
theorem infinite_range_curveIdeal {k : Type u} [Field k] [Infinite k] :
    (Set.range fun t : k ↦ curveIdeal t).Infinite := sorry

/-- Exercise 111.62.3 (Making primes): there are infinitely many distinct prime ideals
`p` of `MvPolynomial (Fin 2) ℂ` such that `PrimeSpectrum.zeroLocus p` contains
`pointToPoint 0` and `pointToPoint 1`, the closed points corresponding to `(x, y)`
and `(x - 1, y - 1)`. -/
@[stacks 0FWM]
theorem infinite_primes_zeroLocus_origin_one :
    {p : Ideal (MvPolynomial (Fin 2) ℂ) |
        p.IsPrime ∧
          pointToPoint (0 : Fin 2 → ℂ) ∈
            PrimeSpectrum.zeroLocus (p : Set (MvPolynomial (Fin 2) ℂ)) ∧
          pointToPoint (1 : Fin 2 → ℂ) ∈
            PrimeSpectrum.zeroLocus (p : Set (MvPolynomial (Fin 2) ℂ))}.Infinite :=
  sorry

end MvPolynomial
