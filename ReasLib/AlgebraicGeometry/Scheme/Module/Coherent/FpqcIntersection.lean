module

public import Mathlib.AlgebraicGeometry.Morphisms.Flat
public import ReasLib.AlgebraicGeometry.Scheme.Module.Coherent.Quasicoherent
public import ReasLib.AlgebraicGeometry.Scheme.Cover.Fpqc.Criteria
public import ReasLib.AlgebraicGeometry.Scheme.Module.FiniteType.Descent
public import ReasLib.AlgebraicGeometry.Scheme.Module.Quasicoherent.Pullback
public import ReasLib.AlgebraicGeometry.Scheme.Module.Quasicoherent.Pushforward

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Scheme.Modules

variable {X Y : Scheme.{u}} (f : Y ⟶ X)
variable [QuasiCompact f] [QuasiSeparated f] [Flat f] [Surjective f]
variable [IsLocallyNoetherian X] [IsLocallyNoetherian Y]
variable (F : X.Modules) [F.IsQuasicoherent]
variable (G : Y.Modules) [G.IsCoherent]
variable (φ : G ⟶ (Scheme.Modules.pullback f).obj F) [Mono φ]

/-- For a flat, surjective, quasi-compact and quasi-separated morphism `f : Y ⟶ X`
of locally Noetherian schemes, the pullback of the adjunction unit `F ⟶ f_* f^* F`
along the pushforward of a monomorphism `G ⟶ f^* F` is coherent when `F` is
quasi-coherent and `G` is coherent. -/
theorem isCoherent_pullbackUnitPushforward :
    (Limits.pullback ((pullbackPushforwardAdjunction f).unit.app F)
      ((Scheme.Modules.pushforward f).map φ)).IsCoherent := by
  classical
  let P : X.Modules :=
    Limits.pullback ((pullbackPushforwardAdjunction f).unit.app F)
      ((Scheme.Modules.pushforward f).map φ)
  have hPullbackQuasicoherent :
      (Scheme.quasiCoherentModuleProperty X)
        (Limits.pullback ((pullbackPushforwardAdjunction f).unit.app F)
          ((Scheme.Modules.pushforward f).map φ)) := by
    let Fqc : Scheme.QCoh X := ⟨F, inferInstance⟩
    let Gqc : Scheme.QCoh X := ⟨(Scheme.Modules.pushforward f).obj G, inferInstance⟩
    let Tqc : Scheme.QCoh X := ⟨(Scheme.Modules.pushforward f).obj
      ((Scheme.Modules.pullback f).obj F), inferInstance⟩
    let unitqc : Fqc ⟶ Tqc :=
      CategoryTheory.ObjectProperty.homMk ((pullbackPushforwardAdjunction f).unit.app F)
    let φqc : Gqc ⟶ Tqc :=
      CategoryTheory.ObjectProperty.homMk ((Scheme.Modules.pushforward f).map φ)
    let Pqc : Scheme.QCoh X :=
      Limits.pullback
        unitqc
        φqc
    let e :=
      PreservesPullback.iso (Scheme.QCoh.inclusion X)
        unitqc
        φqc
    convert (Scheme.quasiCoherentModuleProperty X).prop_of_iso e Pqc.property using 1
    rfl
  have hPQuasicoherent : P.IsQuasicoherent := by
    simpa [P, Scheme.quasiCoherentModuleProperty] using hPullbackQuasicoherent
  -- Reduce coherence on the locally Noetherian target to finite type plus quasicoherence.
  rw [Scheme.Modules.isCoherent_iff_isQuasicoherent_and_isFiniteType P]
  constructor
  · exact hPQuasicoherent
  · -- Descent of finite type will be applied to the singleton fpqc family generated by `f`.
    let family : Unit → Over X := fun _ ↦ Over.mk f
    have hCover : AlgebraicGeometry.Scheme.FpqcCovering family := by
      rw [AlgebraicGeometry.Scheme.Fpqc.Criterion.cover_iff_affine]
      constructor
      · intro i
        change Flat f
        infer_instance
      · intro U hU
        let V : (i : Unit) → (family i).left.Opens := fun _ ↦ by
          change Y.Opens
          exact f ⁻¹ᵁ U
        refine ⟨V, ?_, ?_, ?_⟩
        · classical
          simpa [V] using Set.toFinite {i : Unit | (V i) ≠ ⊥}
        · intro i
          change IsCompact (((f ⁻¹ᵁ U : Y.Opens) : Set Y))
          simpa using (f.isCompact_preimage hU.isCompact :
            IsCompact ((f ⁻¹ᵁ U : Y.Opens) : Set Y))
        · ext x
          constructor
          · intro hx
            simp only [family, V, Set.mem_iUnion, Set.mem_image] at hx
            rcases hx with ⟨_, y, hy, rfl⟩
            exact hy
          · intro hx
            have hSurj : Function.Surjective f := Scheme.Hom.surjective f
            rcases hSurj x with ⟨y, rfl⟩
            refine Set.mem_iUnion.mpr ?_
            exact ⟨(), ⟨y, hx, rfl⟩⟩
    -- Local instance justification (proof-local temporary data): `IsFiniteType.of_fpqcCovering` consumes the established quasicoherence of `P`.
    letI : P.IsQuasicoherent := hPQuasicoherent
    refine Scheme.Modules.IsFiniteType.of_fpqcCovering P
      family hCover ?_
    intro _
    have hPullbackCoherent : ((Scheme.Modules.pullback f).obj P).IsCoherent := by sorry
    -- Once the pulled-back module is coherent, finite type follows immediately.
    change ((Scheme.Modules.pullback f).obj P).IsFiniteType
    exact
      (Scheme.Modules.isCoherent_iff_isQuasicoherent_and_isFiniteType
        ((Scheme.Modules.pullback f).obj P)).mp hPullbackCoherent |>.2

/-- The fpqc pullback intersection of a quasicoherent module with the pushforward of a
coherent submodule carries the canonical coherence instance. -/
instance pullbackUnitPushforward_isCoherent :
    (Limits.pullback ((pullbackPushforwardAdjunction f).unit.app F)
      ((Scheme.Modules.pushforward f).map φ)).IsCoherent :=
  isCoherent_pullbackUnitPushforward f F G φ

end AlgebraicGeometry.Scheme.Modules
