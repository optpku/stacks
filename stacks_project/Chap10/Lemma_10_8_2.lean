module

public import ReasLib.Algebra.Category.ModuleCat.DirectLimit
import StacksCheckRecall

@[expose] public section

/-!
Lemma 10.8.2: for a system of `R`-modules over a preordered set `I`, the colimit is the quotient
of the direct sum by the submodule generated by the transition relations, with the canonical maps
from each stage.  Mathlib's `Module.DirectLimit` is this quotient model and
`ModuleCat.directLimitIsColimit` supplies its universal property.

@stack 00D5
-/

@[stacks 00D5 "direct-limit quotient carrier"]
#check @Module.DirectLimit

@[stacks 00D5 "direct-limit canonical stage map"]
#check @Module.DirectLimit.of

@[stacks 00D5 "direct-limit canonical map compatibility"]
#check @Module.DirectLimit.of_f

@[stacks 00D5 "direct-limit universal map"]
#check @Module.DirectLimit.lift

@[stacks 00D5 "direct-limit universal map on a stage"]
#check @Module.DirectLimit.lift_of

@[stacks 00D5 "direct-limit universal map uniqueness"]
#check @Module.DirectLimit.hom_ext

@[stacks 00D5 "direct-limit universal property"]
#check @ModuleCat.directLimitCocone

@[stacks 00D5 "direct-limit colimit"]
#check @ModuleCat.directLimitIsColimit
