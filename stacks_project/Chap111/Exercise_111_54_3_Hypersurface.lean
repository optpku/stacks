module

public import Mathlib.Algebra.Field.Basic
public import Mathlib.Algebra.Homology.ShortComplex.ShortExact
public import Mathlib.CategoryTheory.IsomorphismClasses
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.Proper
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.Twist.Invertible
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.TwistCohomology.Naturality
public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.IdealClosure
public import ReasLib.AlgebraicGeometry.Scheme.Module.ClosedImmersion.Exact
public import ReasLib.AlgebraicGeometry.Scheme.Module.Coherent
public import ReasLib.AlgebraicGeometry.Scheme.Module.Pullback.StructureSheaf
public import ReasLib.AlgebraicGeometry.Scheme.Variety

/-!
# Smooth plane curves cut out by a homogeneous form in standard P^2

This module owns the homogeneous principal ideal `(F)`, the associated `Proj` curve
`C = V₊(F)`, its closed immersion into `ProjectiveSpace.scheme k 2`, and the
multiplication/restriction maps of the adjunction sequence
`O(-d) ⟶ O(0) ⟶ i_* i^* O(0)`.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

noncomputable section

universe u

namespace AlgebraicGeometry.ProjectiveSpace.PlaneCurve

/-- The principal ideal generated by a degree-`d` form `F` is homogeneous for the standard
grading on `k[X_0, X_1, X_2]`. -/
theorem homogeneousIdeal_isHomogeneous {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) :
    (Ideal.span {F}).IsHomogeneous (ProjectiveSpace.grading k 2) := sorry

/-- The homogeneous principal ideal `(F)` cutting out a plane curve in
`ProjectiveSpace.scheme k 2`. -/
def homogeneousIdeal {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) :
    HomogeneousIdeal (ProjectiveSpace.grading k 2) where
  toSubmodule := Ideal.span {F}
  is_homogeneous' := homogeneousIdeal_isHomogeneous d F hF

/-- The underlying ideal of `homogeneousIdeal d F hF` is generated by `F`. -/
theorem homogeneousIdeal_toIdeal {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) :
    (homogeneousIdeal d F hF).toIdeal = Ideal.span {F} := sorry

/-- The quotient grading on `k[X_0, X_1, X_2] ⧸ (F)`. -/
abbrev quotientGrading {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) :
    ℕ → Submodule k (MvPolynomial (Fin 3) k ⧸ (homogeneousIdeal d F hF).toIdeal) :=
  GradedAlgebra.Quotient.grading (ProjectiveSpace.grading k 2)
    (homogeneousIdeal d F hF).toIdeal

/-- The quotient by `homogeneousIdeal d F hF` carries its canonical graded-algebra
structure. -/
noncomputable instance instGradedAlgebra {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) :
    GradedAlgebra (quotientGrading d F hF) :=
  GradedAlgebra.Quotient.gradedAlgebra (ProjectiveSpace.grading k 2)
    (homogeneousIdeal d F hF).toIdeal
    (homogeneousIdeal d F hF).isHomogeneous

/-- The `Proj` model of the plane curve `C = V₊(F) ⊂ P^2_k`. -/
abbrev scheme {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) : Scheme :=
  Proj (quotientGrading d F hF)

/-- The closed immersion `i : C ⟶ P^2_k` induced by the homogeneous quotient
`k[X_0, X_1, X_2] ⧸ (F)`. -/
def closedImmersion {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) :
    scheme d F hF ⟶ ProjectiveSpace.scheme k 2 :=
  projQuotientMap (ProjectiveSpace.grading k 2) (homogeneousIdeal d F hF)

/-- The morphism `closedImmersion d F hF` is a closed immersion. -/
instance instIsClosedImmersion {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) :
    IsClosedImmersion (closedImmersion d F hF) :=
  projQuotientMap_isClosedImmersion (ProjectiveSpace.grading k 2)
    (homogeneousIdeal d F hF)

/-- The structure morphism `C ⟶ Spec k` of a plane curve `V₊(F)`. -/
abbrev hom {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) :
    scheme d F hF ⟶ Spec (.of k) :=
  closedImmersion d F hF ≫ ProjectiveSpace.toSpec k 2

/-- The structure morphism of a plane curve `V₊(F)` is proper. -/
instance instIsProper_hom {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) :
    IsProper (hom d F hF) := sorry

/-- Multiplication by the degree-`d` form `F`, as a map `O_{P^2}(-d) ⟶ O_{P^2}(0)`. -/
def multiplication {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) :
    twistingSheaf k 2 (-d) ⟶ twistingSheaf k 2 0 :=
  twistingSheaf.mulHomogeneous 2 (-d) d F hF ≫
    eqToHom (congrArg (twistingSheaf k 2) (neg_add_cancel (d : ℤ)))

/-- The adjunction unit `O_{P^2}(0) ⟶ i_* i^* O_{P^2}(0)` along `closedImmersion d F hF`. -/
def restriction {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) :
    twistingSheaf k 2 0 ⟶
      (Scheme.Modules.pushforward (closedImmersion d F hF)).obj
        ((Scheme.Modules.pullback (closedImmersion d F hF)).obj
          (twistingSheaf k 2 0)) :=
  Scheme.Modules.ClosedImmersion.restrictionMap
    (closedImmersion d F hF) (twistingSheaf k 2 0)

/-- Multiplication by `F` followed by restriction to the curve is the zero map. -/
theorem multiplication_comp_restriction {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) :
    multiplication d F hF ≫ restriction d F hF = 0 := sorry

/-- The three-term complex `O_{P^2}(-d) ⟶ O_{P^2}(0) ⟶ i_* i^* O_{P^2}(0)` associated to
`V₊(F)`. -/
def sequence {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) :
    ShortComplex (ProjectiveSpace.scheme k 2).Modules :=
  ShortComplex.mk (multiplication d F hF) (restriction d F hF)
    (multiplication_comp_restriction d F hF)

/-- The pushforward `i_* O_C` of the structure sheaf of the plane curve. -/
def pushforwardStructure {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) :
    (ProjectiveSpace.scheme k 2).Modules :=
  (Scheme.Modules.pushforward (closedImmersion d F hF)).obj
    (SheafOfModules.unit (scheme d F hF).ringCatSheaf)

/-- The degree-zero twisting sheaf on `P^2_k` is isomorphic to the structure sheaf. -/
theorem twistingSheaf_zero_isIsomorphic_unit {k : Type u} [Field k] :
    IsIsomorphic (twistingSheaf k 2 0)
      (SheafOfModules.unit (ProjectiveSpace.scheme k 2).ringCatSheaf) := sorry

/-- The third term of `sequence d F hF` is isomorphic to `i_* O_C`. -/
theorem pushforward_pullback_twisting_zero_isIsomorphic_pushforwardStructure
    {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) :
    IsIsomorphic
      ((Scheme.Modules.pushforward (closedImmersion d F hF)).obj
        ((Scheme.Modules.pullback (closedImmersion d F hF)).obj
          (twistingSheaf k 2 0)))
      (pushforwardStructure d F hF) := sorry

/-- Canonical twisting sheaves on `P^2_k` are coherent. -/
instance instIsCoherent_twistingSheaf {k : Type u} [Field k] (n : ℤ) :
    (twistingSheaf k 2 n).IsCoherent := sorry

/-- The third term `i_* i^* O_{P^2}(0)` of `sequence d F hF` is coherent. -/
instance instIsCoherent_pushforwardPullbackTwistingZero {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) :
    ((Scheme.Modules.pushforward (closedImmersion d F hF)).obj
      ((Scheme.Modules.pullback (closedImmersion d F hF)).obj
        (twistingSheaf k 2 0))).IsCoherent := sorry

/-- The pushforward `i_* O_C` is coherent. -/
instance instIsCoherent_pushforwardStructure {k : Type u} [Field k] (d : ℕ)
    (F : MvPolynomial (Fin 3) k) (hF : F ∈ ProjectiveSpace.grading k 2 d) :
    (pushforwardStructure d F hF).IsCoherent := sorry

end AlgebraicGeometry.ProjectiveSpace.PlaneCurve

