module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Sites.FpqcPrecoverage
public import Mathlib.CategoryTheory.Sites.Precoverage
public import stacks_project.Chap73.Definition_73_9_1_FpqcCovering
public import stacks_project.Chap73.Lemma_73_9_3_Stability

/-!
# Fpqc precoverage on algebraic spaces

The fpqc covering presieves of algebraic spaces over a scheme `S` are the
presieves generated by `FpqcCovering` families.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry

universe u v

namespace AlgebraicGeometry.AlgebraicSpace

#check (AlgebraicGeometry.AlgebraicSpace.fpqcPrecoverage :
  (S : Scheme.{u}) → Precoverage (AlgebraicSpace S))

#check (AlgebraicGeometry.AlgebraicSpace.ofArrows_mem_fpqcPrecoverage_iff :
  ∀ {S : Scheme.{u}} {Y : AlgebraicSpace S}
    {ι : Type v} {Yᵢ : ι → AlgebraicSpace S} (g : (i : ι) → Yᵢ i ⟶ Y),
    Presieve.ofArrows Yᵢ g ∈ (fpqcPrecoverage S).coverings Y ↔
      FpqcCovering (fun i ↦ Over.mk (g i)))

#check (AlgebraicGeometry.AlgebraicSpace.ofArrows_mem_fpqcPrecoverage_exists_indices :
  ∀ {S : Scheme.{u}} {Y : AlgebraicSpace S} {ι : Type v}
    {Yᵢ : ι → AlgebraicSpace S} {g : (i : ι) → Yᵢ i ⟶ Y},
    Presieve.ofArrows Yᵢ g ∈ (fpqcPrecoverage S).coverings Y →
    ∀ {Z : Over S}, IsAffine Z.left → ∀ (h : ofOver Z ⟶ Y),
      ∃ (𝒰 : StandardFpqcCover Z.left) (α : Fin 𝒰.n → ι)
        (φ : ∀ j, ofOver (Over.mk (𝒰.map j ≫ Z.hom)) ⟶ Yᵢ (α j)),
        ∀ j, φ j ≫ g (α j) = ofStandardFpqcCoverMap 𝒰 j ≫ h)

#check (AlgebraicGeometry.AlgebraicSpace.instFpqcPrecoverageHasIsos :
  ∀ {S : Scheme.{u}}, (fpqcPrecoverage S).HasIsos)

#check (AlgebraicGeometry.AlgebraicSpace.instFpqcPrecoverageIsStableUnderComposition :
  ∀ {S : Scheme.{u}}, (fpqcPrecoverage S).IsStableUnderComposition)

#check (AlgebraicGeometry.AlgebraicSpace.instFpqcPrecoverageIsStableUnderBaseChange :
  ∀ {S : Scheme.{u}}, (fpqcPrecoverage S).IsStableUnderBaseChange)

end AlgebraicGeometry.AlgebraicSpace
