module

public import Mathlib.Algebra.Module.Projective
public import Mathlib.Data.Set.Countable
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

universe u v

namespace Ideal

/-- An ideal generated by a countable family of idempotents is projective as an `R`-module. -/
@[stacks 05WH]
theorem projective_of_countable_idempotents {R : Type u} [CommRing R] {ι : Type v} [Countable ι]
    (e : ι → R) (he : ∀ i, IsIdempotentElem (e i)) :
    Module.Projective R (span (Set.range e)) := sorry

/-- An ideal generated by a countable set of idempotents is projective as an `R`-module. -/
theorem projective_span_countable_idempotents {R : Type u} [CommRing R] (S : Set R)
    (hS : S.Countable) (h_idem : ∀ x ∈ S, IsIdempotentElem x) :
    Module.Projective R (span S) := sorry

end Ideal
