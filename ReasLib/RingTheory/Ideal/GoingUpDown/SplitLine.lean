module

public import Mathlib.Topology.Inseparable
public import Mathlib.RingTheory.Ideal.GoingDown
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.Algebra.Polynomial.Bivariate
public import Mathlib.RingTheory.Ideal.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import Mathlib.FieldTheory.IsAlgClosed.Basic

@[expose] public section

noncomputable section

open PrimeSpectrum Polynomial Localization
open scoped Polynomial.Bivariate

universe u

namespace GoingUpDown.SplitLine

/-- The denominator `C X * Y - 1` in the bivariate polynomial ring. -/
def splitLineAwayDenom (k : Type u) [Field k] : k[X][Y] :=
  C X * Y - 1

/-- The idempotent relation `Y ^ 2 - Y` in the bivariate polynomial ring. -/
def splitLineAwayIdempotent (k : Type u) [Field k] : k[X][Y] :=
  Y ^ 2 - Y

/-- The ideal generated by the image of `splitLineAwayIdempotent k` after localization. -/
def splitLineAwayIdeal (k : Type u) [Field k] : Ideal (Away (splitLineAwayDenom k)) :=
  Ideal.span
    {algebraMap (k[X][Y]) (Away (splitLineAwayDenom k)) (splitLineAwayIdempotent k)}

/-- The quotient of the localization away from `splitLineAwayDenom k` by `splitLineAwayIdeal k`. -/
abbrev splitLineAway (k : Type u) [Field k] : Type u :=
  Away (splitLineAwayDenom k) ⧸ splitLineAwayIdeal k

/-- The induced `k[X]`-algebra structure on `splitLineAway k`. -/
instance algebra_splitLineAway (k : Type u) [Field k] : Algebra k[X] (splitLineAway k) :=
  ((Ideal.Quotient.mk (splitLineAwayIdeal k)).comp
    ((algebraMap (k[X][Y]) (Away (splitLineAwayDenom k))).comp
      (algebraMap k[X] k[X][Y]))).toAlgebra

/-- The image of `splitLineAwayDenom k` is a unit in `splitLineAway k`. -/
theorem isUnit_xy_sub_one_splitLineAway (k : Type u) [Field k] :
    IsUnit
      (Ideal.Quotient.mk (splitLineAwayIdeal k)
        (algebraMap (k[X][Y]) (Away (splitLineAwayDenom k)) (splitLineAwayDenom k))) :=
  sorry

/-- The image of `splitLineAwayIdempotent k` vanishes in `splitLineAway k`. -/
theorem splitLineAway_y_mul_y_sub_one (k : Type u) [Field k] :
    Ideal.Quotient.mk (splitLineAwayIdeal k)
      (algebraMap (k[X][Y]) (Away (splitLineAwayDenom k)) (splitLineAwayIdempotent k)) = 0 :=
  sorry

/-- The map on spectra induced by the split-line quotient over an algebraically closed field is not specializing. -/
theorem not_specializingMap_comap_splitLineAway {k : Type u} [Field k] [IsAlgClosed k] :
    ¬ SpecializingMap (comap (algebraMap k[X] (splitLineAway k))) :=
  sorry

/-- The split-line quotient over an algebraically closed field has the going-down property. -/
instance hasGoingDown_splitLineAway {k : Type u} [Field k] [IsAlgClosed k] :
    Algebra.HasGoingDown k[X] (splitLineAway k) :=
  sorry

end GoingUpDown.SplitLine
