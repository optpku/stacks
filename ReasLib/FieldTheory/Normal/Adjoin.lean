module

public import Mathlib.FieldTheory.Normal.Basic
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

universe u v w

open IntermediateField

namespace FieldExtension

variable {F : Type u} {E : Type v}
variable [Field F] [Field E] [Algebra F E]

/-- An extension generated by a set of integral elements whose minimal polynomials split in the
ambient field is normal. -/
theorem normalOfAdjoinEqTopMinpolySplits (S : Set E)
    (hgen : adjoin F S = ⊤)
    (hS : ∀ x ∈ S, IsIntegral F x ∧ ((minpoly F x).map (algebraMap F E)).Splits) :
    Normal F E := by
  rw [normal_iff]
  intro x
  have hx : x ∈ adjoin F S := by
    rw [hgen]
    exact mem_top
  have hxIntegral : IsIntegral F x := by
    let K : IntermediateField F E := adjoin F S
    have hK : Algebra.IsAlgebraic F K :=
      IntermediateField.isAlgebraic_adjoin (fun y hy ↦ (hS y hy).1)
    let xK : K := ⟨x, hx⟩
    simpa [K, xK] using IsIntegral.map K.val ((hK.isAlgebraic xK).isIntegral)
  exact ⟨hxIntegral, splits_of_mem_adjoin F E hS hx⟩

/-- Lemma 9.15.6 (Tag 0BR3, second part): an extension generated by integral elements whose
minimal polynomials split in the ambient field is normal. -/
theorem normalOfAdjoinRangeMinpolySplits {I : Type w} (α : I → E)
    (hgen : adjoin F (Set.range α) = ⊤)
    (hint : ∀ i : I, IsIntegral F (α i))
    (hsplit : ∀ i : I, ((minpoly F (α i)).map (algebraMap F E)).Splits) :
    Normal F E := by
  apply normalOfAdjoinEqTopMinpolySplits (F := F) (E := E) (Set.range α) hgen
  rintro x ⟨i, rfl⟩
  exact ⟨hint i, hsplit i⟩

end FieldExtension
