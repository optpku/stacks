universe u

namespace AlgebraicGeometry
namespace Scheme
namespace DerivedQCoh
namespace ProperDualizingComplex

/-- For a proper one-dimensional scheme over a field, an exact coherent sequence from the curve
dualizing module to a coherent quotient whose support has dimension zero has an epimorphic map
from the free sheaf generated by all global sections of the middle module under the stated
cohomological and submodule hypotheses. -/
theorem globalSectionsToQuotient_epi
    {k : Type u} [Field k] (X : SchemeOverField k) [IsProper X.hom]
    (h_dimension : topologicalKrullDim X.left = 1)
    (hΓ : Function.Bijective (Scheme.Hom.globalSectionsMap X.hom))
    (F Q : X.left.Modules) [F.IsCoherent] [Q.IsCoherent]
    (ι : curveDualizingModule X.hom ⟶ F) (π : F ⟶ Q)
    (h_zero : ι ≫ π = 0)
    (h_exact : (ShortComplex.mk ι π h_zero).Exact) [Epi π]
    (h_support : topologicalKrullDim (RingedSpace.moduleSupport Q) = 0)
    (h_sections : 2 ≤ Scheme.Hom.cohomologyFinrank X.hom Q 0)
    (h_no_submodule : ∀ Q' : Subobject F,
      Mono (Q'.arrow ≫ π) → IsZero (Q' : X.left.Modules)) :
    Epi (F.freeHomEquiv.symm (fun s : F.sections ↦ s) ≫ π) := sorry

/-- For an integral proper one-dimensional scheme over a field, a torsion-free coherent module
in a short exact extension of the curve dualizing module by a zero-dimensional coherent module
with at least two global sections is globally generated. -/
theorem isGloballyGenerated_of_torsionFree
    {k : Type u} [Field k] (X : SchemeOverField k) [IsProper X.hom]
    [IsIntegral X.left]
    (h_dimension : topologicalKrullDim X.left = 1)
    (hΓ : Function.Bijective (Scheme.Hom.globalSectionsMap X.hom))
    (F Q : X.left.Modules) [F.IsCoherent] [Q.IsCoherent]
    [Scheme.Modules.IsTorsionFree F]
    (ι : curveDualizingModule X.hom ⟶ F) (π : F ⟶ Q)
    (h_zero : ι ≫ π = 0)
    (h_short : (ShortComplex.mk ι π h_zero).ShortExact)
    (h_support : topologicalKrullDim (RingedSpace.moduleSupport Q) = 0)
    (h_sections : 2 ≤ Scheme.Hom.cohomologyFinrank X.hom Q 0) :
    SheafOfModules.IsGloballyGenerated F := sorry

/-- For a proper one-dimensional scheme over a field with the expected global sections, tensoring
the curve dualizing module with a relatively very ample invertible module of degree at least two
produces a globally generated module. -/
theorem tensor_isGloballyGenerated_of_relativelyVeryAmple
    {k : Type u} [Field k] (X : SchemeOverField k) [IsProper X.hom]
    (h_dimension : topologicalKrullDim X.left = 1)
    (hΓ : Function.Bijective (Hom.globalSectionsMap X.hom))
    (L : X.left.Modules) [Invertible L]
    (h_veryAmple : RelativelyVeryAmple X.hom L)
    (h_degree : 2 ≤ curveDegreeOfInvertible X.hom h_dimension.le L) :
    SheafOfModules.IsGloballyGenerated (curveDualizingModule X.hom ⊗ L) := sorry

end ProperDualizingComplex
end DerivedQCoh
end Scheme
end AlgebraicGeometry
