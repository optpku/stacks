module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.LocalProperties.Covers
import StacksCheckRecall

/-!
# Lemma 18.23.3

Compatibility facade for the reusable cover criteria in
`ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.LocalProperties.Covers`.
The owner works over an arbitrary sheaf of rings and uses `CoversTop` instead
of exposing a chosen terminal object.
-/

@[expose] public section

open SheafOfModules.RingedSite

/- Lemma 18.23.3 (1) (03DN): local freeness is local on a cover of the top. -/
@[stacks 03DN "(1, local)"]
#check @IsLocallyFree.iff_existsCover

/- Lemma 18.23.3 (1) (03DN): local freeness is equivalent to having free charts. -/
@[stacks 03DN "(1, free)"]
#check @IsLocallyFree.iff_existsFreeCover

/- Lemma 18.23.3 (2) (03DN): finite local freeness is local on a cover of the top. -/
@[stacks 03DN "(2, local)"]
#check @IsFiniteLocallyFree.iff_existsCover

/- Lemma 18.23.3 (2) (03DN): finite local freeness is equivalent to having finite-free charts. -/
@[stacks 03DN "(2, finite free)"]
#check @IsFiniteLocallyFree.iff_existsFiniteFreeCover

/- Lemma 18.23.3 (3) (03DN): local generation is local on a cover of the top. -/
@[stacks 03DN "(3, local)"]
#check @IsLocallyGeneratedBySections.iff_existsCover

/- Lemma 18.23.3 (3) (03DN): local generation is equivalent to having globally generated
charts. -/
@[stacks 03DN "(3, global)"]
#check @IsLocallyGeneratedBySections.iff_existsGloballyGeneratedCover

/- Lemma 18.23.3 (4) (03DN): local generation by `r` sections is local on a cover. -/
@[stacks 03DN "(4, local)"]
#check @IsLocallyGeneratedBy.iff_existsCover

/- Lemma 18.23.3 (4) (03DN): local generation by `r` sections is equivalent to having charts
generated by `r` global sections. -/
@[stacks 03DN "(4, global)"]
#check @IsLocallyGeneratedBy.iff_existsGeneratedByCover

/- Lemma 18.23.3 (5) (03DN): finite type is local on a cover of the top. -/
@[stacks 03DN "(5, local)"]
#check @IsFiniteType.iff_existsCover

/- Lemma 18.23.3 (5) (03DN): finite type is equivalent to finite global generation on a
cover. -/
@[stacks 03DN "(5, global)"]
#check @IsFiniteType.iff_existsFiniteGloballyGeneratedCover

/- Lemma 18.23.3 (6) (03DN): quasi-coherence is local on a cover of the top. -/
@[stacks 03DN "(6, local)"]
#check @IsQuasicoherent.iff_existsCover

/- Lemma 18.23.3 (6) (03DN): quasi-coherence is equivalent to having global presentations on a
cover. -/
@[stacks 03DN "(6, presentation)"]
#check @IsQuasicoherent.iff_existsPresentationCover

/- Lemma 18.23.3 (7) (03DN): finite presentation is local on a cover of the top. -/
@[stacks 03DN "(7, local)"]
#check @IsFinitePresentation.iff_existsCover

/- Lemma 18.23.3 (7) (03DN): finite presentation is equivalent to having finite global
presentations on a cover. -/
@[stacks 03DN "(7, presentation)"]
#check @IsFinitePresentation.iff_existsFinitePresentationCover

/- Lemma 18.23.3 (8) (03DN): coherence is local on a cover of the top. -/
@[stacks 03DN "(8)"]
#check @IsCoherent.iff_existsCover
