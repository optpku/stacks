module

public import stacks_project.Chap65.Lemma_65_7_3_Pullback
public import stacks_project.Chap73.Definition_73_6_1_Covering

/-!
# Stability of syntomic covering families of algebraic spaces

Syntomic covering families of algebraic spaces are stable under singleton
isomorphisms, indexed composition, and base change.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u v w

namespace AlgebraicGeometry.AlgebraicSpace

/-- A singleton family generated by an isomorphism of algebraic spaces is a
syntomic covering. -/
theorem syntomicCovering_singleton_of_isIso {S : Scheme.{u}}
    {X X' : AlgebraicSpace S} (f : X' ⟶ X) [IsIso f] :
    SyntomicCovering (fun _ : Unit ↦ Over.mk f) :=
  sorry

/-- Indexed composition of syntomic covering families of algebraic spaces is a
syntomic covering. -/
theorem syntomicCovering_comp {S : Scheme.{u}} {X : AlgebraicSpace S}
    {ι : Type v} {κ : ι → Type w} (family : ι → Over X)
    (refinement : (i : ι) → κ i → Over (family i).left)
    (hfamily : SyntomicCovering family)
    (hrefinement : ∀ i, SyntomicCovering (refinement i)) :
    SyntomicCovering (fun p : Sigma κ ↦
      Over.mk ((refinement p.1 p.2).hom ≫ (family p.1).hom)) :=
  sorry

/-- Pulling a syntomic covering family of algebraic spaces back along a morphism
yields a syntomic covering. -/
theorem syntomicCovering_pullback {S : Scheme.{u}} {X X' : AlgebraicSpace S}
    {ι : Type v} (family : ι → Over X) (hfamily : SyntomicCovering family)
    (g : X' ⟶ X) :
    SyntomicCovering (fun i ↦ Over.mk (pullback.fst g (family i).hom)) :=
  sorry

end AlgebraicGeometry.AlgebraicSpace
