module

public import ReasLib.Algebra.Homology.CochainComplex.BerthelotOgus.Eta.Int.DeterminantalIdeal
public import ReasLib.AlgebraicGeometry.RingedSpace.Module.Derived.Sections
public import ReasLib.AlgebraicGeometry.Scheme.Divisor.EffectiveCartier.Affine

@[expose] public section

open AlgebraicGeometry CategoryTheory
open scoped AlgebraicGeometry nonZeroDivisors

universe u

namespace AlgebraicGeometry.Scheme

/-- An affine chart for an ideal-sheaf datum and a derived module, consisting of a regular
principal equation and a bounded finite-free complex representing derived sections. -/
structure DivisorComplexChart {X : Scheme.{u}} (D : X.IdealSheafData)
    (M : RingedSpace.ModuleDerived X.toRingedSpace) where
  /-- The affine open underlying the chart. -/
  U : X.affineOpens
  /-- The regular section cutting out the divisor on the chart. -/
  generator : Γ(X, U)
  /-- The bounded finite-free complex modelling derived sections on the chart. -/
  model : CochainComplex (ModuleCat Γ(X, U)) ℤ
  /-- The model is bounded. -/
  bounded : CochainComplex.bounded (ModuleCat Γ(X, U)) model
  /-- Every term of the model is finite free. -/
  finiteFree : model.IsTermwiseFiniteFree
  /-- The chart equation is a nonzerodivisor. -/
  regular : generator ∈ nonZeroDivisors Γ(X, U)
  /-- The divisor ideal is generated by the chart equation. -/
  ideal_eq : D.ideal U = Ideal.span {generator}
  /-- The model represents the derived sections of the given complex on the chart. -/
  represents : IsIsomorphic (DerivedCategory.Q.obj model)
    ((RingedSpace.moduleDerivedSectionsAtOpen X.toRingedSpace U).obj M)

namespace DivisorComplexChart

/-- Construct an affine divisor-complex chart from its explicit open, equation, model, and
validity conditions. -/
def of {X : Scheme.{u}} (D : X.IdealSheafData)
    (M : RingedSpace.ModuleDerived X.toRingedSpace)
    (U : X.affineOpens) (generator : Γ(X, U))
    (model : CochainComplex (ModuleCat Γ(X, U)) ℤ)
    (bounded : CochainComplex.bounded (ModuleCat Γ(X, U)) model)
    (finiteFree : model.IsTermwiseFiniteFree)
    (regular : generator ∈ nonZeroDivisors Γ(X, U))
    (ideal_eq : D.ideal U = Ideal.span {generator})
    (represents : IsIsomorphic (DerivedCategory.Q.obj model)
      ((RingedSpace.moduleDerivedSectionsAtOpen X.toRingedSpace U).obj M)) :
    DivisorComplexChart D M :=
  { U, generator, model, bounded, finiteFree, regular, ideal_eq, represents }

/-- An affine divisor-complex chart simultaneously supplies bounded finite-free coordinates,
a regular principal divisor equation, and a representative of the derived sections. -/
theorem spec {X : Scheme.{u}} {D : X.IdealSheafData}
    {M : RingedSpace.ModuleDerived X.toRingedSpace}
    (C : DivisorComplexChart D M) :
    CochainComplex.bounded (ModuleCat Γ(X, C.U)) C.model ∧
      C.model.IsTermwiseFiniteFree ∧
      C.generator ∈ nonZeroDivisors Γ(X, C.U) ∧
      D.ideal C.U = Ideal.span {C.generator} ∧
      IsIsomorphic (DerivedCategory.Q.obj C.model)
        ((RingedSpace.moduleDerivedSectionsAtOpen X.toRingedSpace C.U).obj M) := sorry

/-- The degreewise Berthelot–Ogus determinantal ideal attached to an affine chart. -/
noncomputable def ideal {X : Scheme.{u}} {D : X.IdealSheafData}
    {M : RingedSpace.ModuleDerived X.toRingedSpace}
    (C : DivisorComplexChart D M) (i : ℤ) : Ideal Γ(X, C.U) :=
  @CochainComplex.BerthelotOgus.Int.etaDeterminantalIdeal
    _ _ C.generator C.model i (C.finiteFree.finite i)
      (C.finiteFree.free (i + 1)) (C.finiteFree.finite (i + 1))

/-- The chart ideal is the canonical degreewise Berthelot–Ogus determinantal ideal. -/
theorem ideal_def {X : Scheme.{u}} {D : X.IdealSheafData}
    {M : RingedSpace.ModuleDerived X.toRingedSpace}
    (C : DivisorComplexChart D M) (i : ℤ) :
    C.ideal i =
      @CochainComplex.BerthelotOgus.Int.etaDeterminantalIdeal
        _ _ C.generator C.model i (C.finiteFree.finite i)
          (C.finiteFree.free (i + 1)) (C.finiteFree.finite (i + 1)) := sorry

end DivisorComplexChart

/-- A divisor, derived module, and scheme form a good triple when every point of the divisor
lies in an affine divisor-complex chart whose degreewise determinantal ideals are principal. -/
def IsGoodTriple {X : Scheme.{u}} (D : X.IdealSheafData)
    (M : RingedSpace.ModuleDerived X.toRingedSpace) : Prop :=
  ∀ x : D.subscheme, ∃ C : DivisorComplexChart D M,
    D.subschemeι x ∈ (C.U : X.Opens) ∧ ∀ i : ℤ, (C.ideal i).IsPrincipal

/-- Goodness is characterized by a cover of the divisor points by affine divisor-complex
charts with principal degreewise determinantal ideals. -/
theorem isGoodTriple_iff {X : Scheme.{u}} (D : X.IdealSheafData)
    (M : RingedSpace.ModuleDerived X.toRingedSpace) :
    IsGoodTriple D M ↔
      ∀ x : D.subscheme, ∃ C : DivisorComplexChart D M,
        D.subschemeι x ∈ (C.U : X.Opens) ∧ ∀ i : ℤ, (C.ideal i).IsPrincipal := sorry

end AlgebraicGeometry.Scheme
