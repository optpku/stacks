module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.RingTheory.Ideal.Span

/-!
# The affine triangle polynomial and ideal
-/

@[expose] public section

noncomputable section

universe u

namespace MvPolynomial.Triangle

/-- The polynomial `xy(x + y - 1)` defining an affine triangle. -/
def generator (k : Type u) [CommRing k] : MvPolynomial (Fin 2) k :=
  X 0 * X 1 * (X 0 + X 1 - 1)

/-- The triangle polynomial is the product of its three affine linear factors. -/
theorem generator_eq (k : Type u) [CommRing k] :
    generator k = X 0 * X 1 * (X 0 + X 1 - 1) := rfl

/-- The principal ideal generated by `xy(x + y - 1)` in the polynomial ring in two variables. -/
def ideal (k : Type u) [CommRing k] : Ideal (MvPolynomial (Fin 2) k) :=
  Ideal.span {generator k}

/-- The triangle ideal is the span of the triangle polynomial. -/
theorem ideal_eq (k : Type u) [CommRing k] :
    ideal k = Ideal.span {generator k} := rfl

end MvPolynomial.Triangle
