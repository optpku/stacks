module

public import ReasLib.AlgebraicGeometry.Scheme.IdealSheafData.IntersectionMultiplicity.Principal
import StacksCheckRecall

@[expose] public section

open CategoryTheory TopologicalSpace AlgebraicGeometry
open scoped AlgebraicGeometry

universe u

/- Lemma 43.16.4: when the stalk ideal of `V` at the generic point of a
component of a proper intersection is generated by one regular element, the local
intersection multiplicity is the length of the corresponding quotient of the local
ring of `W`. -/
@[stacks 0B05] #check
  (AlgebraicGeometry.Scheme.IdealSheafData.intersectionMultiplicity_eq_length_quotSMulTop :
    ∀ {k : Type u} [Field k] (X : SchemeOverField k) [Variety X]
      [Scheme.Regular X.left] (V W : X.left.IdealSheafData)
      [IsIntegral V.subscheme] [IsIntegral W.subscheme],
      TopologicalSpace.Closeds.IntersectProperly V.support W.support →
      ∀ (Z : irreducibleComponents (V ⊔ W).subscheme),
        let Y := X.left
        let ξ := genericPoints.ofComponent Z
        let x := (V ⊔ W).subschemeι ξ.1
        let R := Y.presheaf.stalk x
        let I := RingedSpace.idealSheafStalkIdeal
          (LocallyRingedSpace.Hom.kernelIdealSubobject V.subschemeι.toLRSHom) x
        let J := RingedSpace.idealSheafStalkIdeal
          (LocallyRingedSpace.Hom.kernelIdealSubobject W.subschemeι.toLRSHom) x
        let M := R ⧸ J
        ∀ (f : Fin 1 → R),
          RingTheory.Sequence.IsRegular R (List.ofFn f) →
          Ideal.span (Set.range f) = I →
          V.intersectionMultiplicity W ξ =
            ((Module.length R (QuotSMulTop (f 0) M)).toNat : ℤ))
