/-!
# A spectral space whose closed points are not closed

Given a topological space `T` and a point `t`, equip `T × Fin 2` with the
topology generated by open cylinders `U × {0, 1}`, the complement of `(t, 0)`,
and one-slices `U × {1}` for open `U` avoiding `t`. The carrier uses
`WithTopology` so this topology does not overwrite the product topology.

When `T` is compact, Hausdorff, and totally disconnected and its complement
of `{t}` is not compact, the closed points are the zero-slice and map
bijectively to connected components, but do not form a closed subset.
-/

@[expose] public section

open Set Topology TopologicalSpace

universe u

namespace Topology.NotWLocal

variable {T : Type u}

/-- The cylinder `U × {0, 1}` in the product carrier. -/
def cylinder (U : Set T) : Set (T × Fin 2) :=
  U ×ˢ (univ : Set (Fin 2))

/-- The complement of the distinguished zero-slice point `(t, 0)`. -/
def puncturedZero (t : T) : Set (T × Fin 2) :=
  {(t, (0 : Fin 2))}ᶜ

/-- The one-slice `U × {1}` in the product carrier. -/
def oneSlice (U : Set T) : Set (T × Fin 2) :=
  U ×ˢ ({1} : Set (Fin 2))

/-- The family of open cylinders, the complement of `(t, 0)`, and open one-slices
whose base subsets avoid the distinguished point `t`. -/
def subbasis [TopologicalSpace T] (t : T) : Set (Set (T × Fin 2)) :=
  (cylinder '' {U : Set T | IsOpen U}) ∪ {puncturedZero t} ∪
    (oneSlice '' {U : Set T | IsOpen U ∧ t ∉ U})

/-- A subbasis member is an open cylinder, the complement of `(t, 0)`, or an
open one-slice whose base subset avoids `t`. -/
theorem mem_subbasis_iff [TopologicalSpace T] {t : T} {s : Set (T × Fin 2)} :
    s ∈ subbasis t ↔
      (∃ U, IsOpen U ∧ s = cylinder U) ∨ s = puncturedZero t ∨
        ∃ U, IsOpen U ∧ t ∉ U ∧ s = oneSlice U := by
  simp [subbasis, eq_comm, and_assoc, or_assoc, or_left_comm]

/-- The topology generated by open cylinders, the complement of `(t, 0)`, and
open one-slices whose base subsets avoid `t`. -/
@[implicit_reducible]
def topology [TopologicalSpace T] (t : T) : TopologicalSpace (T × Fin 2) :=
  generateFrom (subbasis t)

/-- The distinguished-point topology is generated by its subbasis. -/
theorem topology_eq_generateFrom [TopologicalSpace T] (t : T) :
    topology t = generateFrom (subbasis t) := rfl

end Topology.NotWLocal

/-- The space `T × {0, 1}` with topology generated by open cylinders, the
complement of `(t, 0)`, and open one-slices whose base subsets avoid `t`. -/
abbrev Topology.NotWLocal (T : Type u) [TopologicalSpace T] (t : T) :=
  WithTopology (T × Fin 2) (Topology.NotWLocal.topology t)

namespace Topology.NotWLocal

variable {T : Type u} [TopologicalSpace T]

/-- The point `(x, i)` of `NotWLocal T t`. -/
def mk {t : T} (x : T) (i : Fin 2) : NotWLocal T t :=
  WithTopology.toTopology (topology t) (x, i)

/-- `mk x i` forgets back to the product pair `(x, i)`. -/
theorem ofTopology_mk {t : T} (x : T) (i : Fin 2) :
    WithTopology.ofTopology (mk x i : NotWLocal T t) = (x, i) := rfl

/-- The zero-slice `X₀ = T × {0}` in `NotWLocal T t`. -/
def zeroSlice (t : T) : Set (NotWLocal T t) :=
  {p | (WithTopology.ofTopology p).2 = 0}

/-- Membership in the zero-slice is having fibre coordinate `0`. -/
theorem mem_zeroSlice_iff {t : T} {p : NotWLocal T t} :
    p ∈ zeroSlice t ↔ (WithTopology.ofTopology p).2 = 0 := Iff.rfl

/-- The zero-slice is the image of `T × {0}` under `mk`. -/
theorem zeroSlice_eq_image_mk (t : T) :
    zeroSlice t = (fun p : T × Fin 2 ↦ mk p.1 p.2) '' (univ ×ˢ ({0} : Set (Fin 2))) :=
  by
    ext p
    constructor
    · intro hp
      exact ⟨WithTopology.ofTopology p, ⟨mem_univ _, hp⟩, rfl⟩
    · rintro ⟨⟨x, i⟩, ⟨_, hi⟩, rfl⟩
      exact hi

/-- `mk x i` lies on the zero-slice if and only if `i = 0`. -/
theorem mk_mem_zeroSlice {t : T} {x : T} {i : Fin 2} :
    mk x i ∈ zeroSlice t ↔ i = 0 := Iff.rfl

/-- Cylinders `U × {0, 1}` are open in `NotWLocal T t`. -/
theorem isOpen_mk_cylinder {t : T} {U : Set T} (hU : IsOpen U) :
    IsOpen (WithTopology.toTopology (topology t) '' cylinder U) := by
  rw [WithTopology.isOpen_iff, preimage_image_eq _ (WithTopology.toTopology_injective _)]
  exact isOpen_generateFrom_of_mem (mem_subbasis_iff.mpr (Or.inl ⟨U, hU, rfl⟩))

/-- The complement of `(t, 0)` is open in `NotWLocal T t`. -/
theorem isOpen_mk_puncturedZero {t : T} :
    IsOpen (WithTopology.toTopology (topology t) '' puncturedZero t) := by
  rw [WithTopology.isOpen_iff, preimage_image_eq _ (WithTopology.toTopology_injective _)]
  exact isOpen_generateFrom_of_mem (mem_subbasis_iff.mpr (Or.inr (Or.inl rfl)))

/-- One-slices `U × {1}` avoiding `t` are open in `NotWLocal T t`. -/
theorem isOpen_mk_oneSlice {t : T} {U : Set T} (hU : IsOpen U) (htU : t ∉ U) :
    IsOpen (WithTopology.toTopology (topology t) '' oneSlice U) := by
  rw [WithTopology.isOpen_iff, preimage_image_eq _ (WithTopology.toTopology_injective _)]
  exact isOpen_generateFrom_of_mem
    (mem_subbasis_iff.mpr (Or.inr (Or.inr ⟨U, hU, htU, rfl⟩)))

private theorem open_imp_one_mem {t : T} {s : Set (T × Fin 2)}
    (hs : IsOpen[topology t] s) : ∀ x, (x, 0) ∈ s → (x, 1) ∈ s := by
  change GenerateOpen (subbasis t) s at hs
  induction hs with
  | basic s hs =>
      rcases mem_subbasis_iff.mp hs with
        ⟨U, _, rfl⟩ | rfl | ⟨U, _, _, rfl⟩
      · exact fun _ hx ↦ ⟨hx.1, mem_univ _⟩
      · intro x _
        simp [puncturedZero]
      · intro x hx
        simp [oneSlice] at hx
  | univ => exact fun _ _ ↦ mem_univ _
  | inter s v _ _ ihs ihv => exact fun x hx ↦ ⟨ihs x hx.1, ihv x hx.2⟩
  | sUnion S _ ih =>
      rintro x ⟨s, hs, hx⟩
      exact ⟨s, hs, ih s hs x hx⟩

private theorem specializes_mk_one_zero {t : T} (x : T) :
    (mk x 1 : NotWLocal T t) ⤳ mk x 0 := by
  refine specializes_iff_forall_open.mpr fun s hs hx ↦ ?_
  exact open_imp_one_mem ((WithTopology.isOpen_iff _).mp hs) x hx

private theorem continuous_fst {t : T} :
    Continuous (fun p : NotWLocal T t ↦ (WithTopology.ofTopology p).1) := by
  refine continuous_def.mpr fun U hU ↦ ?_
  convert isOpen_mk_cylinder (t := t) hU using 1
  ext p
  simp [cylinder, WithTopology.image_toTopology]

private theorem isClosed_singleton_mk_zero [T1Space T] {t : T} (x : T) :
    IsClosed ({mk x 0} : Set (NotWLocal T t)) := by
  classical
  letI : TopologicalSpace (T × Fin 2) := topology t
  rw [WithTopology.isClosed_iff]
  have heq : WithTopology.toTopology (topology t) ⁻¹' {mk x 0} = {(x, (0 : Fin 2))} := by
    ext p
    simp [mk]
  rw [heq]
  rw [← isOpen_compl_iff]
  by_cases hxt : x = t
  · subst x
    exact isOpen_generateFrom_of_mem (mem_subbasis_iff.mpr (Or.inr (Or.inl rfl)))
  · have h₁ : IsOpen[topology t] (cylinder ({x}ᶜ : Set T)) :=
      isOpen_generateFrom_of_mem
        (mem_subbasis_iff.mpr (Or.inl ⟨_, isClosed_singleton.isOpen_compl, rfl⟩))
    have h₂ : IsOpen[topology t] (oneSlice ({t}ᶜ : Set T)) :=
      isOpen_generateFrom_of_mem
        (mem_subbasis_iff.mpr
          (Or.inr (Or.inr ⟨_, isClosed_singleton.isOpen_compl, by simp, rfl⟩)))
    convert h₁.union h₂ using 1
    ext ⟨y, i⟩
    fin_cases i <;> by_cases hy : y = x <;> simp [cylinder, oneSlice, hy, hxt]

private theorem exists_open_punctured_cylinder_subset {t : T} {s : Set (T × Fin 2)}
    (hs : IsOpen[topology t] s) :
    (t, 1) ∈ s → ∃ U, IsOpen U ∧ t ∈ U ∧ ∀ x ∈ U, x ≠ t → (x, 0) ∈ s := by
  change GenerateOpen (subbasis t) s at hs
  induction hs with
  | basic s hs =>
      rcases mem_subbasis_iff.mp hs with
        ⟨U, hU, rfl⟩ | rfl | ⟨U, _, htU, rfl⟩
      · exact fun ht ↦ ⟨U, hU, ht.1, fun _ hx _ ↦ ⟨hx, mem_univ _⟩⟩
      · intro _
        refine ⟨univ, isOpen_univ, mem_univ _, fun x _ hxt ↦ ?_⟩
        simpa [puncturedZero] using hxt
      · exact fun ht ↦ (htU ht.1).elim
  | univ => exact fun _ ↦ ⟨univ, isOpen_univ, mem_univ _, fun _ _ _ ↦ mem_univ _⟩
  | inter s v _ _ ihs ihv =>
      intro ht
      obtain ⟨U, hU, htU, hUs⟩ := ihs ht.1
      obtain ⟨V, hV, htV, hVv⟩ := ihv ht.2
      exact ⟨U ∩ V, hU.inter hV, ⟨htU, htV⟩,
        fun x hx hxt ↦ ⟨hUs x hx.1 hxt, hVv x hx.2 hxt⟩⟩
  | sUnion S _ ih =>
      rintro ⟨s, hs, ht⟩
      obtain ⟨U, hU, htU, hUs⟩ := ih s hs ht
      exact ⟨U, hU, htU, fun x hx hxt ↦ ⟨s, hs, hUs x hx hxt⟩⟩

/-- The distinguished-point two-slice space is spectral when `T` is compact,
Hausdorff, and totally disconnected. -/
instance instSpectralSpace [CompactSpace T] [T2Space T] [TotallyDisconnectedSpace T]
    {t : T} : SpectralSpace (NotWLocal T t) := sorry

variable [CompactSpace T] [T2Space T] [TotallyDisconnectedSpace T]

/-- If the complement of `{t}` is not compact, the closed points of
`NotWLocal T t` are exactly the zero-slice `T × {0}`. -/
@[stacks 0969]
theorem closedPoints_eq (t : T) (ht : ¬ IsCompact ({t}ᶜ : Set T)) :
    closedPoints (NotWLocal T t) = zeroSlice t := by
  ext p
  obtain ⟨⟨x, i⟩, rfl⟩ := WithTopology.toTopology_surjective (topology t) p
  change IsClosed ({mk x i} : Set (NotWLocal T t)) ↔ i = 0
  fin_cases i
  · exact ⟨fun _ ↦ rfl, fun _ ↦ isClosed_singleton_mk_zero x⟩
  · constructor
    · intro hp
      have hz := (specializes_mk_one_zero (t := t) x).mem_closed hp (mem_singleton _)
      simpa [mk] using hz
    · intro h
      exact ((by decide : (1 : Fin 2) ≠ 0) h).elim

/-- If the complement of `{t}` is not compact, the point `(t, 1)` lies in the
closure of the zero-slice. -/
@[stacks 0969]
theorem mem_closure_zeroSlice (t : T) (ht : ¬ IsCompact ({t}ᶜ : Set T)) :
    mk t 1 ∈ closure (zeroSlice t) := by
  classical
  refine mem_closure_iff.mpr fun s hs hts ↦ ?_
  obtain ⟨U, hU, htU, hUs⟩ :=
    exists_open_punctured_cylinder_subset ((WithTopology.isOpen_iff _).mp hs) hts
  have hex : ∃ x ∈ U, x ≠ t := by
    by_contra h
    have hUeq : U = {t} := by
      apply Subset.antisymm
      · intro x hx
        by_contra hxt
        exact h ⟨x, hx, hxt⟩
      · exact singleton_subset_iff.mpr htU
    have hsingle : IsOpen ({t} : Set T) := hUeq ▸ hU
    exact ht hsingle.isClosed_compl.isCompact
  obtain ⟨x, hx, hxt⟩ := hex
  exact ⟨mk x 0, hUs x hx hxt, mk_mem_zeroSlice.mpr rfl⟩

/-- If the complement of `{t}` is not compact, the canonical map from the
closed points of `NotWLocal T t` to its connected components is bijective. -/
@[stacks 0969]
theorem bijective_fromClosedPoints (t : T) (ht : ¬ IsCompact ({t}ᶜ : Set T)) :
    Function.Bijective
      (ConnectedComponents.fromClosedPoints :
        closedPoints (NotWLocal T t) → ConnectedComponents (NotWLocal T t)) :=
  by
    constructor
    · intro a b hab
      apply Subtype.ext
      apply WithTopology.ofTopology_injective (topology t)
      apply Prod.ext
      · exact (continuous_fst (t := t)).image_eq_of_connectedComponent_eq a.val b.val
          (ConnectedComponents.coe_eq_coe.mp hab)
      · have ha : (WithTopology.ofTopology a.val).2 = 0 := by
          apply mem_zeroSlice_iff.mp
          rw [← closedPoints_eq t ht]
          exact a.property
        have hb : (WithTopology.ofTopology b.val).2 = 0 := by
          apply mem_zeroSlice_iff.mp
          rw [← closedPoints_eq t ht]
          exact b.property
        exact ha.trans hb.symm
    · intro c
      obtain ⟨p, rfl⟩ := ConnectedComponents.surjective_coe c
      obtain ⟨⟨x, i⟩, rfl⟩ := WithTopology.toTopology_surjective (topology t) p
      refine ⟨⟨mk x 0, ?_⟩, ?_⟩
      · rw [closedPoints_eq t ht]
        exact mk_mem_zeroSlice.mpr rfl
      · change ConnectedComponents.mk (mk x 0 : NotWLocal T t) =
          ConnectedComponents.mk (mk x i)
        fin_cases i
        · rfl
        · apply ConnectedComponents.coe_eq_coe.mpr
          apply connectedComponent_eq_iff_mem.mpr
          exact (specializes_mk_one_zero x).mem_closed
            isClosed_connectedComponent mem_connectedComponent

/-- If the complement of `{t}` is not compact, the closed points of
`NotWLocal T t` do not form a closed subset. -/
@[stacks 0969]
theorem not_isClosed_closedPoints (t : T) (ht : ¬ IsCompact ({t}ᶜ : Set T)) :
    ¬ IsClosed (closedPoints (NotWLocal T t)) := by
  rw [closedPoints_eq t ht]
  intro h
  have hm := mem_closure_zeroSlice t ht
  rw [h.closure_eq] at hm
  exact (by decide : (1 : Fin 2) ≠ 0) (mk_mem_zeroSlice.mp hm)

end Topology.NotWLocal
