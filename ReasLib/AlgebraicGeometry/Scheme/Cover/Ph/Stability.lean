module

public import ReasLib.AlgebraicGeometry.Scheme.Cover.Ph
public import ReasLib.AlgebraicGeometry.Scheme.Cover.Ph.BaseChange
public import ReasLib.AlgebraicGeometry.Scheme.Cover.Ph.Refinement
public import ReasLib.CategoryTheory.Sites.Family.Covering
public import ReasLib.CategoryTheory.Limits.FormalCoproduct.Singleton.Over

/-!
# Stability of ph covering families

Ph covering families are characterized by the existence of a refining ph
cover and by the singleton family induced from their coproduct map.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u v w

namespace AlgebraicGeometry

/-- A locally finite-type family is a ph covering exactly when it admits a
refining family which is itself a ph covering. -/
theorem phCovering_iff_exists_refinement
    {T : Scheme.{u}} {ι : Type v} (X : ι → Scheme.{u})
    (π : ∀ i, X i ⟶ T) (hπ : ∀ i, LocallyOfFiniteType (π i)) :
    PhCovering X π ↔
      ∃ (κ : Type v) (Y : κ → Scheme.{u}) (φ : ∀ k, Y k ⟶ T),
        PhCovering Y φ ∧
          SemiRepresentableFamily.Over.Refines
            (SemiRepresentableFamily.Over.ofArrows Y φ)
            (SemiRepresentableFamily.Over.ofArrows X π) := sorry

/-- A locally finite-type family is a ph covering exactly when the singleton
family induced by its coproduct map is a ph covering. -/
theorem phCovering_iff_coproductSingleton
    {T : Scheme.{u}} {ι : Type u} (X : ι → Scheme.{u})
    (π : ∀ i, X i ⟶ T) (hπ : ∀ i, LocallyOfFiniteType (π i)) :
    PhCovering X π ↔
      PhCovering
        (fun p ↦
          ((FormalCoproduct.Over.coproductSingleton
            (FormalCoproduct.ofArrows X π)).obj p).left)
        (fun p ↦
          ((FormalCoproduct.Over.coproductSingleton
            (FormalCoproduct.ofArrows X π)).obj p).hom) := sorry

/-- A singleton family generated by an isomorphism is a ph covering. -/
instance phCoveringSingletonOfIsIso {T T' : Scheme.{u}} (f : T' ⟶ T) [IsIso f] :
    PhCovering (fun _ : PUnit ↦ T') (fun _ : PUnit ↦ f) := sorry

/-- Pullback of a ph covering family along a scheme morphism is a ph covering. -/
instance phCoveringPullback {T T' : Scheme.{u}} {I : Type v}
    (X : I → Scheme.{u}) (π : ∀ i, X i ⟶ T) [PhCovering X π] (f : T' ⟶ T) :
    PhCovering (fun i : I ↦ pullback (π i) f)
      (fun i : I ↦ pullback.snd (π i) f) := sorry

/-- Dependent composition of ph covering families is a ph covering. -/
instance phCoveringComp {T : Scheme.{u}} {I : Type v}
    (X : I → Scheme.{u}) (π : ∀ i, X i ⟶ T) [PhCovering X π]
    (J : I → Type w) (Y : ∀ i, J i → Scheme.{u})
    (ρ : ∀ i, ∀ j : J i, Y i j ⟶ X i) [∀ i, PhCovering (Y i) (ρ i)] :
    PhCovering (fun p : Sigma J ↦ Y p.1 p.2)
      (fun p : Sigma J ↦ ρ p.1 p.2 ≫ π p.1) := sorry

end AlgebraicGeometry
