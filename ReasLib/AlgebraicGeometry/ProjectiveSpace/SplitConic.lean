@[expose] public section

open AlgebraicGeometry CategoryTheory
open scoped AlgebraicGeometry

noncomputable section
universe u

namespace AlgebraicGeometry.SplitConic

variable (R : Type u) [CommRing R] (π : R)

/-- The homogeneous equation of the split conic degeneration. -/
def equation : MvPolynomial (Fin 3) R :=
  MvPolynomial.X 1 * MvPolynomial.X 2 - MvPolynomial.C π * MvPolynomial.X 0 ^ 2

/-- The equation generates a homogeneous ideal for the standard grading. -/
theorem equationIdeal_homogeneous :
    (Ideal.span ({equation R π} : Set (MvPolynomial (Fin 3) R))).IsHomogeneous
      (ProjectiveSpace.grading R 2) := sorry

/-- The homogeneous principal ideal defining the degeneration. -/
def equationIdeal : HomogeneousIdeal (ProjectiveSpace.grading R 2) where
  toSubmodule := Ideal.span {equation R π}
  is_homogeneous' := equationIdeal_homogeneous R π

/-- The underlying ideal of the homogeneous equation ideal is generated by the conic equation. -/
theorem equationIdeal_toIdeal :
    (equationIdeal R π).toIdeal =
      Ideal.span ({equation R π} : Set (MvPolynomial (Fin 3) R)) := sorry

/-- The actual homogeneous coordinate ring, with its quotient ring operations. -/
abbrev coordinateRing := MvPolynomial (Fin 3) R ⧸ (equationIdeal R π).toIdeal

/-- The quotient grading on the homogeneous coordinate ring. -/
abbrev grading : ℕ → Submodule R (coordinateRing R π) :=
  GradedAlgebra.Quotient.grading (ProjectiveSpace.grading R 2) (equationIdeal R π).toIdeal

/-- The canonical quotient decomposition gives the coordinate ring its grading. -/
instance grading_gradedAlgebra : GradedAlgebra (grading R π) :=
  GradedAlgebra.Quotient.gradedAlgebra (ProjectiveSpace.grading R 2)
    (equationIdeal R π).toIdeal (equationIdeal R π).isHomogeneous

/-- The concrete Proj model of the degeneration. -/
abbrev model : Scheme := Proj (grading R π)

/-- The closed embedding into the projective plane. -/
def planeInclusion : model R π ⟶ ProjectiveSpace.scheme R 2 :=
  projQuotientMap (ProjectiveSpace.grading R 2) (equationIdeal R π)

/-- The structural morphism of the split conic over its coefficient ring. -/
def toSpec : model R π ⟶ Spec (CommRingCat.of R) :=
  planeInclusion R π ≫ ProjectiveSpace.toSpec R 2

/-- Choose the coordinate pair `(T0,T1)` or `(T0,T2)`. -/
def projectionCoordinates (second : Bool) : Fin 2 → Fin 3 :=
  fun i ↦ if i = 0 then 0 else if second then 2 else 1

/-- The coordinate substitution followed by the homogeneous quotient. -/
def projectionRingHom (second : Bool) : MvPolynomial (Fin 2) R →+* coordinateRing R π :=
  (Ideal.Quotient.mk (equationIdeal R π).toIdeal).comp
    (MvPolynomial.rename (projectionCoordinates second)).toRingHom

/-- Both coordinate substitutions preserve homogeneous degree. -/
theorem projectionRingHom_mem (second : Bool) {d : ℕ}
    {f : MvPolynomial (Fin 2) R} (hf : f ∈ ProjectiveSpace.grading R 1 d) :
    projectionRingHom R π second f ∈ grading R π d := sorry

/-- The two explicit graded ring maps specifying the projections. -/
def projectionGradedHom (second : Bool) : ProjectiveSpace.grading R 1 →+*ᵍ grading R π where
  toRingHom := projectionRingHom R π second
  map_mem := projectionRingHom_mem R π second

/-- The natural open domain of a projection before extension over its centre. -/
abbrev projectionDomain (second : Bool) : (model R π).Opens :=
  projMapDomain (projectionGradedHom R π second)

/-- The projection on its canonical open domain, obtained from the graded map. -/
def partialProjection (second : Bool) :
    (projectionDomain R π second).toScheme ⟶ ProjectiveSpace.scheme R 1 :=
  projMapMap (projectionGradedHom R π second)

/-- The complementary coordinate pair is `(T₂, πT₀)` or `(T₁, πT₀)`, according to which
projection is being extended. -/
def complementaryProjectionCoordinates (second : Bool) :
    Fin 2 → MvPolynomial (Fin 3) R :=
  fun i ↦ if i = 0 then MvPolynomial.X (if second then 1 else 2)
    else MvPolynomial.C π * MvPolynomial.X 0

/-- The complementary coordinate substitution into the conic coordinate ring. -/
def complementaryProjectionRingHom (second : Bool) :
    MvPolynomial (Fin 2) R →+* coordinateRing R π :=
  MvPolynomial.eval₂Hom
    ((Ideal.Quotient.mk (equationIdeal R π).toIdeal).comp MvPolynomial.C)
    (fun i ↦ Ideal.Quotient.mk (equationIdeal R π).toIdeal
      (complementaryProjectionCoordinates R π second i))

/-- The complementary coordinate substitution preserves homogeneous degree. -/
theorem complementaryProjectionRingHom_mem (second : Bool) {d : ℕ}
    {f : MvPolynomial (Fin 2) R} (hf : f ∈ ProjectiveSpace.grading R 1 d) :
    complementaryProjectionRingHom R π second f ∈ grading R π d := sorry

/-- The complementary graded map used to extend a projection over its coordinate base point. -/
def complementaryProjectionGradedHom (second : Bool) :
    ProjectiveSpace.grading R 1 →+*ᵍ grading R π where
  toRingHom := complementaryProjectionRingHom R π second
  map_mem := complementaryProjectionRingHom_mem R π second

/-- The graded map on one of the two charts used to define a total projection. -/
def projectionChartGradedHom (second chart : Bool) :
    ProjectiveSpace.grading R 1 →+*ᵍ grading R π :=
  if chart then complementaryProjectionGradedHom R π second
  else projectionGradedHom R π second

/-- The natural domain of one chart formula for a total projection. -/
abbrev projectionChartOpen (second chart : Bool) : (model R π).Opens :=
  projMapDomain (projectionChartGradedHom R π second chart)

/-- The universe-lifted pair of chart domains used to cover the conic. -/
def projectionOpens (second : Bool) : ULift.{u} Bool → (model R π).Opens :=
  fun chart ↦ projectionChartOpen R π second chart.down

/-- The two complementary chart domains cover the conic. -/
theorem projectionOpens_isOpenCover (second : Bool) :
    TopologicalSpace.IsOpenCover (projectionOpens R π second) := sorry

/-- The two-chart open cover on which a total projection is constructed. -/
def projectionCover (second : Bool) : (model R π).OpenCover :=
  (model R π).openCoverOfIsOpenCover (projectionOpens R π second)
    (projectionOpens_isOpenCover R π second)

/-- The projective morphism defined by the selected coordinate formula on one chart. -/
def projectionChartMap (second : Bool) (chart : ULift.{u} Bool) :
    (projectionCover R π second).X chart ⟶ ProjectiveSpace.scheme R 1 :=
  projMapMap (projectionChartGradedHom R π second chart.down)

/-- The two chart formulas agree on their scheme-theoretic overlap. -/
theorem projectionChartMap_compatible (second : Bool) (i j : ULift.{u} Bool) :
    CategoryTheory.Limits.pullback.fst
        ((projectionCover R π second).f i) ((projectionCover R π second).f j) ≫
      projectionChartMap R π second i =
    CategoryTheory.Limits.pullback.snd
        ((projectionCover R π second).f i) ((projectionCover R π second).f j) ≫
      projectionChartMap R π second j := sorry

/-- The total coordinate projection from the split conic to the projective line. -/
def projection (second : Bool) : model R π ⟶ ProjectiveSpace.scheme R 1 :=
  (projectionCover R π second).glueMorphisms (projectionChartMap R π second)
    (projectionChartMap_compatible R π second)

/-- The total projection restricts to the prescribed morphism on either chart. -/
theorem projection_restrict (second : Bool) (chart : ULift.{u} Bool) :
    (projectionCover R π second).f chart ≫ projection R π second =
      projectionChartMap R π second chart := sorry

/-- On the primary chart, the total projection agrees with the original coordinate projection. -/
theorem projection_restrict_primary (second : Bool) :
    (projectionCover R π second).f (ULift.up false) ≫ projection R π second =
      partialProjection R π second := sorry

/-- Each total projection commutes with the structure morphisms to `Spec R`. -/
theorem projection_over (second : Bool) :
    projection R π second ≫ ProjectiveSpace.toSpec R 1 = toSpec R π := sorry

/-- The commutative square over `Spec R` associated with a total projection. -/
theorem projectionSquare (second : Bool) :
    CommSq (projection R π second) (toSpec R π)
      (ProjectiveSpace.toSpec R 1) (𝟙 _) := sorry

/-- The closed point `[1 : 0]` in the target projective line. -/
def projectionCenterPoint [IsLocalRing R] : ProjectiveSpace.scheme R 1 :=
  (ProjectiveLine.zeroSection R).base (IsLocalRing.closedPoint R)

/-- The target point `[1 : 0]` is closed. -/
theorem projectionCenterPoint_isClosed [IsLocalRing R] :
    projectionCenterPoint R ∈ closedPoints (ProjectiveSpace.scheme R 1) := sorry

/-- The canonical center to which either opposite component is contracted. -/
def projectionCenter [IsLocalRing R] : closedPoints (ProjectiveSpace.scheme R 1) :=
  ⟨projectionCenterPoint R, projectionCenterPoint_isClosed R⟩

section Domain

variable [IsDomain R]

/-- The map on generic fibres induced by a total projection over `Spec R`. -/
def genericFiberProjection (second : Bool) :
    (toSpec R π).fiber (genericPoint (Spec (CommRingCat.of R))) ⟶
      (ProjectiveSpace.toSpec R 1).fiber (genericPoint (Spec (CommRingCat.of R))) :=
  Scheme.Hom.fiberMap (toSpec R π) (projection R π second) (𝟙 _)
    (ProjectiveSpace.toSpec R 1) (projectionSquare R π second)
    (genericPoint (Spec (CommRingCat.of R)))

/-- The generic-fibre projection is compatible with the inclusions into the total spaces. -/
theorem genericFiberProjection_fiberι (second : Bool) :
    genericFiberProjection R π second ≫
        (ProjectiveSpace.toSpec R 1).fiberι (genericPoint (Spec (CommRingCat.of R))) =
      (toSpec R π).fiberι (genericPoint (Spec (CommRingCat.of R))) ≫
        projection R π second := sorry

end Domain

/-- The two component ideals are `(π,T2)` and `(π,T1)` in the conic coordinate ring. -/
def componentRingIdeal (second : Bool) : Ideal (coordinateRing R π) :=
  Ideal.span {Ideal.Quotient.mk (equationIdeal R π).toIdeal (MvPolynomial.C π),
    Ideal.Quotient.mk (equationIdeal R π).toIdeal
      (MvPolynomial.X (if second then 1 else 2))}

/-- The component equations are homogeneous of degrees zero and one. -/
theorem componentRingIdeal_homogeneous (second : Bool) :
    (componentRingIdeal R π second).IsHomogeneous (grading R π) := sorry

/-- The homogeneous ideals cutting out the two closed components. -/
def componentIdeal (second : Bool) : HomogeneousIdeal (grading R π) where
  toSubmodule := componentRingIdeal R π second
  is_homogeneous' := componentRingIdeal_homogeneous R π second

/-- The homogeneous coordinate ring of a component. -/
abbrev componentRing (second : Bool) :=
  coordinateRing R π ⧸ (componentIdeal R π second).toIdeal

/-- The induced grading on a component coordinate ring. -/
abbrev componentGrading (second : Bool) : ℕ → Submodule R (componentRing R π second) :=
  GradedAlgebra.Quotient.grading (grading R π) (componentIdeal R π second).toIdeal

/-- The canonical homogeneous quotient grading of each component. -/
instance componentGrading_gradedAlgebra (second : Bool) :
    GradedRing (componentGrading R π second) :=
  GradedAlgebra.Quotient.gradedAlgebra (grading R π)
    (componentIdeal R π second).toIdeal (componentIdeal R π second).isHomogeneous

/-- The component as the Proj of its explicit homogeneous quotient. -/
abbrev component (second : Bool) : Scheme := Proj (componentGrading R π second)

/-- The canonical closed inclusion of either special-fibre component. -/
def componentInclusion (second : Bool) : component R π second ⟶ model R π :=
  projQuotientMap (grading R π) (componentIdeal R π second)

section DiscreteValuationRing

variable [IsDomain R] [IsDiscreteValuationRing R] [Fact (Irreducible π)]

/-- The retained component maps scheme-theoretically into the target special fibre. -/
theorem specialFiberIdeal_le_componentProjection_ker (second : Bool) :
    (ProjectiveSpace.toSpec R 1).specialFiberIdeal ≤
      (componentInclusion R π second ≫ projection R π second).ker := sorry

/-- The retained component mapped to the closed subscheme representing the target special fibre. -/
def componentProjection (second : Bool) :
    component R π second ⟶ (ProjectiveSpace.toSpec R 1).specialFiberIdeal.subscheme :=
  (ProjectiveSpace.toSpec R 1).specialFiberIdeal.lift
    (componentInclusion R π second ≫ projection R π second)
    (specialFiberIdeal_le_componentProjection_ker R π second)

/-- The component projection followed by the special-fibre inclusion is the original composite. -/
theorem componentProjection_subschemeι (second : Bool) :
    componentProjection R π second ≫
        (ProjectiveSpace.toSpec R 1).specialFiberIdeal.subschemeι =
      componentInclusion R π second ≫ projection R π second := sorry

/-- The residue-field structure morphism of a special-fibre component, obtained from its
projection to the special fibre of the projective line. -/
def componentToResidueField (second : Bool) :
    component R π second ⟶
      Spec (CommRingCat.of
        ((Spec (CommRingCat.of R)).residueField (IsLocalRing.closedPoint R))) :=
  componentProjection R π second ≫
    (ProjectiveSpace.toSpec R 1).specialFiberIso.hom ≫
      (ProjectiveSpace.toSpec R 1).fiberToSpecResidueField (IsLocalRing.closedPoint R)

end DiscreteValuationRing

/-- A coordinate projection sends each projective-line coordinate to its selected conic
coordinate modulo the defining equation. -/
theorem projectionRingHom_apply (second : Bool) (i : Fin 2) :
    projectionRingHom R π second (MvPolynomial.X i) =
      Ideal.Quotient.mk (equationIdeal R π).toIdeal
        (MvPolynomial.X (projectionCoordinates second i)) := sorry

section Degeneration

variable [IsDomain R] [IsDiscreteValuationRing R] [Fact (Irreducible π)]

/-- The special fibre of the split conic is the scheme-theoretic union of its two coordinate
components. -/
theorem specialFiber_eq_union :
    (toSpec R π).specialFiberIdeal =
      (componentInclusion R π false).ker ⊓ (componentInclusion R π true).ker := sorry

/-- Each coordinate component is isomorphic to the projective line over the residue field,
compatibly with its residue-field structure morphism. -/
theorem component_iso_projectiveLine (second : Bool) :
    Nonempty (Over.mk (componentToResidueField R π second) ≅
      ProjectiveSpace.schemeOver
        ((Spec (CommRingCat.of R)).residueField (IsLocalRing.closedPoint R)) 1) := sorry

/-- Each coordinate component of the split conic is an exceptional curve of the first kind. -/
instance component_isExceptionalCurve (second : Bool) :
    IsExceptionalCurveFirstKind ((componentInclusion R π second).ker) := sorry

/-- The split-conic model over a discrete valuation ring is Noetherian. -/
instance model_isNoetherian : IsNoetherian (model R π) := sorry

/-- Each coordinate projection contracts the opposite component to the closed point
`[1 : 0]` of the target projective line. -/
theorem projection_isContraction (second : Bool) :
    IsContraction ((componentInclusion R π (!second)).ker)
      (projection R π second) (projectionCenter R) := sorry

/-- Each coordinate projection identifies its retained component with the special fibre of
the target projective line. -/
instance componentProjection_isIso (second : Bool) :
    IsIso (componentProjection R π second) := sorry

/-- Each coordinate projection induces an isomorphism on the generic fibre. -/
instance genericFiberProjection_isIso (second : Bool) :
    IsIso (genericFiberProjection R π second) := sorry

/-- No automorphism of the target projective line intertwines the two coordinate projections
of the split conic. -/
theorem minimalModels_nonunique :
    ¬ ∃ e : ProjectiveSpace.scheme R 1 ≅ ProjectiveSpace.scheme R 1,
      projection R π false ≫ e.hom = projection R π true := sorry

end Degeneration

end AlgebraicGeometry.SplitConic
