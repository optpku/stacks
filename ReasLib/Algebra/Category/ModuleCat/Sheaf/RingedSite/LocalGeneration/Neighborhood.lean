module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.LocalGeneration
public import ReasLib.Topology.Sheaves.Abelian.Over
import Mathlib.Tactic.CrossRefAttribute

/-!
# Pointwise local generation on topological spaces

Local generation is owned for module sheaves on an arbitrary site by
`SheafOfModules.IsLocallyGeneratedBySections`.  On the site of open subsets of a
topological space, this file identifies that cover-based predicate with its pointwise neighborhood
form.
-/

@[expose] public section

open CategoryTheory TopologicalSpace

universe u w

namespace SheafOfModules.IsLocallyGeneratedBySections

variable {X : TopCat.{u}} {𝒪 : X.Sheaf RingCat.{w}}

variable [hasWeakSheafifyOver : ∀ U : Opens X,
  HasWeakSheafify ((Opens.grothendieckTopology X).over U) AddCommGrpCat.{w}]
variable [wEqualsLocallyBijectiveOver : ∀ U : Opens X,
  ((Opens.grothendieckTopology X).over U).WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- Definition 17.8.1 (01B2): a module sheaf on a topological space is locally generated by
sections exactly when every point has an open neighborhood on which it is globally generated. -/
@[stacks 01B2]
theorem iffExistsNeighborhood (M : SheafOfModules.{w} 𝒪) :
    IsLocallyGeneratedBySections M ↔
      ∀ x : X, ∃ U : Opens X,
        x ∈ U ∧ SheafOfModules.IsGloballyGenerated (M.over U) := sorry

end SheafOfModules.IsLocallyGeneratedBySections
