module

public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
public import ReasLib.RingTheory.Ideal.AssociatedGraded.StageClass

/-!
# Generation of an Associated Graded Ring in Degree One

The quotient-Rees associated graded ring of an ideal is generated over its
degree-zero part by the classes in degree one.
-/

@[expose] public section

noncomputable section

universe u v

open scoped HomogeneousIdeal Ideal

namespace Ideal.AssociatedGraded

variable {R : Type u} [CommRing R]

/-- Every positive-degree stage class belongs to the ideal generated by the
degree-one homogeneous component. -/
theorem stageClass_mem_span_grade_one_of_pos
    (I : Ideal R) {n : ℕ} (hn : 0 < n) (x : stage I R n) :
    stageClass I n x ∈ Ideal.span (grade I 1 : Set (ring I)) := sorry

/-- The irrelevant ideal of `gr_I(R)` is generated by its degree-one
homogeneous component. -/
@[stacks 00K8 "associated graded ring generated in degree one"]
theorem span_grade_one_eq_irrelevant (I : Ideal R) :
    Ideal.span (grade I 1 : Set (ring I)) = (grade I)₊.toIdeal := sorry

end Ideal.AssociatedGraded
