module

public import Mathlib.Algebra.Category.CommAlgCat.Basic
public import Mathlib.CategoryTheory.Category.Preorder
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.RingTheory.DividedPowerAlgebra.Init
public import Mathlib.RingTheory.DividedPowers.DPMorphism
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Divided-power polynomial algebras

This file specializes Mathlib's universal `DividedPowerAlgebra` to the free module on a family
of variables.  The indexed construction is the primary API; `DPPolynomial.Finite` is only its
`Fin n` specialization.
-/

noncomputable section

open DividedPowers

universe u v w x

/-- The divided-power polynomial algebra over `A` on variables indexed by `ι`.

This is the standard Mathlib divided-power algebra on the free `A`-module `ι →₀ A`. -/
@[stacks 07H5 "indexed divided-power polynomial algebra"]
abbrev DPPolynomial (A : Type u) [CommSemiring A] (ι : Type v) : Type (max u v) :=
  DividedPowerAlgebra A (ι →₀ A)

namespace DPPolynomial

section Basic

variable (A : Type u) [CommSemiring A] {ι : Type v}

/-- The variable with index `i` in `DPPolynomial A ι`. -/
abbrev X (i : ι) : DPPolynomial A ι :=
  DividedPowerAlgebra.embed A (ι →₀ A) (Finsupp.single i 1)

/-- The `n`th formal divided power of the variable with index `i`. -/
abbrev dp (n : ℕ) (i : ι) : DPPolynomial A ι :=
  DividedPowerAlgebra.dp A n (Finsupp.single i 1)

/-- The first formal divided power of a variable is that variable. -/
@[simp]
theorem dp_one (i : ι) : dp A 1 i = X A i := sorry

/-- The ideal generated by all positive formal divided powers of the variables. -/
@[stacks 07H5 "positive ideal of a divided-power polynomial algebra"]
def positiveIdeal (ι : Type v) : Ideal (DPPolynomial A ι) :=
  Ideal.span (Set.range fun q : ι × ℕ+ ↦ dp A q.2 q.1)

/-- The positive ideal is the span of the positive formal divided powers of the variables. -/
theorem positiveIdeal_def (ι : Type v) :
    positiveIdeal A ι = Ideal.span (Set.range fun q : ι × ℕ+ ↦ dp A q.2 q.1) := sorry

/-- Every positive formal divided power of a variable belongs to the positive ideal. -/
theorem dp_mem_positiveIdeal (ι : Type v) (n : ℕ+) (i : ι) :
    dp A n i ∈ positiveIdeal A ι := sorry

/-- Every variable belongs to the positive ideal. -/
theorem X_mem_positiveIdeal (ι : Type v) (i : ι) :
    X A i ∈ positiveIdeal A ι := sorry

/-- The ideal obtained from `I` after adjoining the positive divided-power variables. -/
@[stacks 07H5 "extended ideal in a divided-power polynomial algebra"]
def ideal (ι : Type v) (I : Ideal A) : Ideal (DPPolynomial A ι) :=
  I.map (algebraMap A (DPPolynomial A ι)) + positiveIdeal A ι

/-- The extended ideal is the sum of the mapped base ideal and the positive ideal. -/
theorem ideal_def (ι : Type v) (I : Ideal A) :
    ideal A ι I = I.map (algebraMap A (DPPolynomial A ι)) + positiveIdeal A ι := sorry

/-- The image of an element of the base ideal belongs to the extended ideal. -/
theorem algebraMap_mem_ideal (ι : Type v) (I : Ideal A) {a : A} (ha : a ∈ I) :
    algebraMap A (DPPolynomial A ι) a ∈ ideal A ι I := sorry

/-- Every positive formal divided power of a variable belongs to the extended ideal. -/
theorem dp_mem_ideal (ι : Type v) (I : Ideal A) (n : ℕ+) (i : ι) :
    dp A n i ∈ ideal A ι I := sorry

/-- Every variable belongs to the extended ideal. -/
theorem X_mem_ideal (ι : Type v) (I : Ideal A) (i : ι) :
    X A i ∈ ideal A ι I := sorry

end Basic

section Rename

variable (A : Type u) [CommSemiring A]
variable {ι : Type v} {κ : Type w}

/-- Rename divided-power polynomial variables along a map of index types. -/
noncomputable def rename (f : ι → κ) : DPPolynomial A ι →ₐ[A] DPPolynomial A κ :=
  DividedPowerAlgebra.map A (Finsupp.lmapDomain A A f)

/-- The map induced by `f` sends a formal divided power to the divided power of the induced
finitely supported linear combination. -/
@[simp]
theorem rename_apply_dp (f : ι → κ) (n : ℕ) (m : ι →₀ A) :
    rename A f (DividedPowerAlgebra.dp A n m) =
      DividedPowerAlgebra.dp A n (Finsupp.lmapDomain A A f m) := sorry

/-- The map induced by `f` sends the variable `i` to the variable `f i`. -/
@[simp]
theorem rename_X (f : ι → κ) (i : ι) : rename A f (X A i) = X A (f i) := sorry

/-- A map of variable indices carries the source positive ideal into the target positive ideal. -/
theorem rename_positiveIdeal_le (f : ι → κ) :
    (positiveIdeal A ι).map (rename A f).toRingHom ≤ positiveIdeal A κ := sorry

/-- Renaming variables carries every extended divided-power ideal into the corresponding target
ideal. -/
theorem rename_ideal_le (I : Ideal A) (f : ι → κ) :
    (ideal A ι I).map (rename A f).toRingHom ≤ ideal A κ I := sorry

/-- The induced map is uniquely determined by its values on all formal divided powers. -/
theorem rename_unique (f : ι → κ) (g : DPPolynomial A ι →ₐ[A] DPPolynomial A κ)
    (hg : ∀ (n : ℕ) (m : ι →₀ A),
      g (DividedPowerAlgebra.dp A n m) =
        DividedPowerAlgebra.dp A n (Finsupp.lmapDomain A A f m)) :
    g = rename A f := sorry

/-- The divided-power polynomial map induced by the identity is the identity map. -/
@[simp]
theorem rename_id : rename A (id : ι → ι) = AlgHom.id A (DPPolynomial A ι) := sorry

/-- Divided-power polynomial maps compose according to the underlying maps of indices. -/
theorem rename_comp {ζ : Type*} (f : ι → κ) (g : κ → ζ) :
    rename A (g ∘ f) = (rename A g).comp (rename A f) := sorry

end Rename

section DividedPowers

variable {A : Type u} [CommSemiring A] {ι : Type v}

namespace Canonical

/-- Replace the degree-zero generators in a polynomial representative of a divided-power
polynomial by `1`, and retain the positive generators with their positive degree recorded in
`ℕ+`.  This is the normal form used by the explicit canonical divided-power formula. -/
noncomputable def normalize :
    MvPolynomial (ℕ × (ι →₀ A)) A →ₐ[A]
      MvPolynomial (ℕ+ × (ι →₀ A)) A :=
  MvPolynomial.eval₂AlgHom A fun nm ↦
    if h : 0 < nm.1 then
      MvPolynomial.X ((⟨nm.1, h⟩ : ℕ+), nm.2)
    else 1

/-- The nonconstant monomials occurring in a normalized polynomial representative. -/
noncomputable def positiveSupport
    (p : MvPolynomial (ℕ+ × (ι →₀ A)) A) :
    Finset ((ℕ+ × (ι →₀ A)) →₀ ℕ) :=
  open scoped Classical in
  p.support.erase 0

/-- The explicit `n`th divided power of one positive monomial.  The factorial factor is the
iterated product law, while `Nat.uniformBell n k` is the composition law for the generator
representing the `k`th formal divided power. -/
noncomputable def monomialDpow (n : ℕ)
    (d : (ℕ+ × (ι →₀ A)) →₀ ℕ) (a : A) : DPPolynomial A ι :=
  algebraMap A (DPPolynomial A ι) a ^ n *
    (n.factorial : DPPolynomial A ι) ^ ((d.sum fun _ e ↦ e) - 1) *
      d.prod fun km e ↦
        ((Nat.uniformBell n (km.1 : ℕ) : DPPolynomial A ι) *
          DividedPowerAlgebra.dp A (n * (km.1 : ℕ)) km.2) ^ e

/-- The explicit `n`th divided power of the positive part of a normalized polynomial.  The
symmetric power enumerates all distributions of total divided-power degree `n` among its
nonconstant monomials. -/
noncomputable def positiveDpow (n : ℕ)
    (p : MvPolynomial (ℕ+ × (ι →₀ A)) A) : DPPolynomial A ι :=
  open scoped Classical in
  ((positiveSupport p).sym n).sum fun k ↦
    (positiveSupport p).prod fun d ↦
      monomialDpow (Multiset.count d k) d (p.coeff d)

/-- The explicit canonical divided-power formula on a polynomial representative.  It first
separates the normalized constant coefficient from the positive part, then applies the divided
power addition formula. -/
noncomputable def rawDpow {I : Ideal A} (γ : DividedPowers I) (n : ℕ)
    (p : MvPolynomial (ℕ × (ι →₀ A)) A) : DPPolynomial A ι :=
  (Finset.antidiagonal n).sum fun k ↦
    algebraMap A (DPPolynomial A ι) (γ.dpow k.1 ((normalize p).coeff 0)) *
      positiveDpow k.2 (normalize p)

/-- The explicit canonical divided-power formula is invariant under the defining congruence of
`DividedPowerAlgebra A (ι →₀ A)`. -/
theorem rawDpow_sound {I : Ideal A} (γ : DividedPowers I) (n : ℕ)
    {p q : MvPolynomial (ℕ × (ι →₀ A)) A}
    (h : (DividedPowerAlgebra.ringCon A (ι →₀ A)).toSetoid p q) :
    rawDpow γ n p = rawDpow γ n q := sorry

/-- The canonical divided-power operation on indexed divided-power polynomials, obtained by
descending the explicit representative formula. -/
noncomputable def dpow {I : Ideal A} (γ : DividedPowers I) (n : ℕ)
    (x : DPPolynomial A ι) : DPPolynomial A ι :=
  Quotient.liftOn' x (rawDpow γ n) fun p q h ↦
    rawDpow_sound (ι := ι) γ n (p := p) (q := q) h

/-- On the class of a polynomial representative, the canonical operation is the explicit raw
formula. -/
@[simp]
theorem dpow_mk {I : Ideal A} (γ : DividedPowers I) (n : ℕ)
    (p : MvPolynomial (ℕ × (ι →₀ A)) A) :
    dpow γ n (p : DPPolynomial A ι) = rawDpow γ n p := sorry

/-- The canonical operation vanishes away from the extended divided-power ideal. -/
theorem dpow_null {I : Ideal A} (γ : DividedPowers I) {n : ℕ} {x : DPPolynomial A ι}
    (hx : x ∉ ideal A ι I) : dpow γ n x = 0 := sorry

/-- The zeroth canonical divided power of an element of the extended ideal is `1`. -/
theorem dpow_zero {I : Ideal A} (γ : DividedPowers I) {x : DPPolynomial A ι}
    (hx : x ∈ ideal A ι I) : dpow γ 0 x = 1 := sorry

/-- The first canonical divided power is the identity on the extended ideal. -/
theorem dpow_one {I : Ideal A} (γ : DividedPowers I) {x : DPPolynomial A ι}
    (hx : x ∈ ideal A ι I) : dpow γ 1 x = x := sorry

/-- Every positive canonical divided power remains in the extended ideal. -/
theorem dpow_mem {I : Ideal A} (γ : DividedPowers I) {n : ℕ} {x : DPPolynomial A ι}
    (hn : n ≠ 0) (hx : x ∈ ideal A ι I) : dpow γ n x ∈ ideal A ι I := sorry

/-- The canonical divided powers satisfy the divided-power addition formula. -/
theorem dpow_add {I : Ideal A} (γ : DividedPowers I) {n : ℕ}
    {x y : DPPolynomial A ι} (hx : x ∈ ideal A ι I) (hy : y ∈ ideal A ι I) :
    dpow γ n (x + y) =
      (Finset.antidiagonal n).sum fun k ↦ dpow γ k.1 x * dpow γ k.2 y := sorry

/-- The canonical divided powers satisfy the scalar multiplication formula. -/
theorem dpow_mul {I : Ideal A} (γ : DividedPowers I) {n : ℕ}
    {a x : DPPolynomial A ι} (hx : x ∈ ideal A ι I) :
    dpow γ n (a * x) = a ^ n * dpow γ n x := sorry

/-- Products of canonical divided powers satisfy the binomial-coefficient formula. -/
theorem mul_dpow {I : Ideal A} (γ : DividedPowers I) {m n : ℕ}
    {x : DPPolynomial A ι} (hx : x ∈ ideal A ι I) :
    dpow γ m x * dpow γ n x =
      Nat.choose (m + n) m * dpow γ (m + n) x := sorry

/-- Iterated canonical divided powers satisfy the uniform-Bell-number formula. -/
theorem dpow_comp {I : Ideal A} (γ : DividedPowers I) {m n : ℕ}
    {x : DPPolynomial A ι} (hn : n ≠ 0) (hx : x ∈ ideal A ι I) :
    dpow γ m (dpow γ n x) =
      Nat.uniformBell m n * dpow γ (m * n) x := sorry

end Canonical

/-- The canonical divided-power structure on the ideal obtained by extending `I` and adjoining
the positive formal divided powers.  Its operation is the explicit representative formula
`Canonical.dpow γ`. -/
@[stacks 07H5 "canonical divided-power structure data"]
noncomputable def dividedPowers {I : Ideal A} (γ : DividedPowers I) :
    DividedPowers (ideal A ι I) where
  dpow := Canonical.dpow γ
  dpow_null := Canonical.dpow_null γ
  dpow_zero := Canonical.dpow_zero γ
  dpow_one := Canonical.dpow_one γ
  dpow_mem := Canonical.dpow_mem γ
  dpow_add := Canonical.dpow_add γ
  dpow_mul := Canonical.dpow_mul γ
  mul_dpow := Canonical.mul_dpow γ
  dpow_comp := Canonical.dpow_comp γ

/-- The divided-power operation of `dividedPowers γ` is the explicit canonical operation. -/
@[simp]
theorem dividedPowers_dpow {I : Ideal A} (γ : DividedPowers I) (n : ℕ)
    (x : DPPolynomial A ι) :
    (dividedPowers γ).dpow n x = Canonical.dpow γ n x := sorry

/-- A divided-power structure on the extended ideal compatible with the base structure and the
formal divided powers of every variable. -/
structure IsCanonical {I : Ideal A} (γ : DividedPowers I)
    (δ : DividedPowers (ideal A ι I)) : Prop where
  /-- The divided powers of every variable are the formal divided powers. -/
  dpow_X (n : ℕ) (i : ι) : δ.dpow n (X A i) = dp A n i
  /-- The base algebra map preserves the divided-power structures. -/
  algebraMap_isDPMorphism :
    IsDPMorphism γ δ (algebraMap A (DPPolynomial A ι))

/-- A divided-power structure is canonical when it agrees with the formal divided powers of
every variable and the base algebra map preserves divided powers. -/
def IsCanonical.ofConditions {I : Ideal A} {γ : DividedPowers I}
    {δ : DividedPowers (ideal A ι I)}
    (hvariable : ∀ (n : ℕ) (i : ι), δ.dpow n (X A i) = dp A n i)
    (hbase : IsDPMorphism γ δ (algebraMap A (DPPolynomial A ι))) :
    IsCanonical γ δ :=
  { dpow_X := hvariable
    algebraMap_isDPMorphism := hbase }

/-- The canonical divided-power condition is exactly variable compatibility together with
compatibility of the base algebra map. -/
theorem isCanonical_iff {I : Ideal A} {γ : DividedPowers I}
    {δ : DividedPowers (ideal A ι I)} :
    IsCanonical γ δ ↔
      (∀ (n : ℕ) (i : ι), δ.dpow n (X A i) = dp A n i) ∧
        IsDPMorphism γ δ (algebraMap A (DPPolynomial A ι)) := sorry

/-- The explicit divided-power structure satisfies the canonical variable and base-map
specification. -/
@[stacks 07H5 "explicit canonical divided powers on indexed divided-power polynomials"]
theorem dividedPowers_isCanonical {I : Ideal A} (γ : DividedPowers I) :
    IsCanonical (ι := ι) γ (dividedPowers (ι := ι) γ) := sorry

/-- Canonical divided powers of a variable are its formal divided powers. -/
@[simp]
theorem dividedPowers_dpow_X {I : Ideal A} (γ : DividedPowers I) (n : ℕ) (i : ι) :
    (dividedPowers γ).dpow n (X A i) = dp A n i := sorry

/-- The base algebra map is a divided-power morphism into the explicit canonical structure. -/
theorem dividedPowers_algebraMap_isDPMorphism {I : Ideal A} (γ : DividedPowers I) :
    IsDPMorphism γ (dividedPowers γ) (algebraMap A (DPPolynomial A ι)) := sorry

/-- The base algebra map bundled as a morphism into the canonical divided-power polynomial
structure. -/
@[stacks 07H5 "canonical base morphism into divided-power polynomials"]
noncomputable def algebraMapDP {I : Ideal A} (γ : DividedPowers I) :
    DPMorphism γ (dividedPowers (ι := ι) γ) :=
  DPMorphism.mk' (dividedPowers_algebraMap_isDPMorphism (ι := ι) γ)

/-- The ring homomorphism underlying the bundled base map is the ordinary algebra map. -/
@[simp]
theorem algebraMapDP_toRingHom {I : Ideal A} (γ : DividedPowers I) :
    (algebraMapDP (ι := ι) γ).toRingHom = algebraMap A (DPPolynomial A ι) := sorry

/-- The bundled base map acts as the ordinary algebra map on coefficients. -/
@[simp]
theorem algebraMapDP_apply {I : Ideal A} (γ : DividedPowers I) (a : A) :
    algebraMapDP (ι := ι) γ a = algebraMap A (DPPolynomial A ι) a := sorry

/-- Canonical divided powers commute with the base algebra map on the base ideal. -/
@[simp]
theorem dividedPowers_dpow_algebraMap {I : Ideal A} (γ : DividedPowers I)
    (n : ℕ) {a : A} (ha : a ∈ I) :
    (dividedPowers γ).dpow n (algebraMap A (DPPolynomial A ι) a) =
      algebraMap A (DPPolynomial A ι) (γ.dpow n a) := sorry

/-- The canonical divided power of a positive formal divided-power generator is governed by
the uniform-Bell-number composition formula. -/
@[simp]
theorem dividedPowers_dpow_dp {I : Ideal A} (γ : DividedPowers I) (n : ℕ)
    {k : ℕ} (hk : k ≠ 0) (m : ι →₀ A) :
    (dividedPowers γ).dpow n (DividedPowerAlgebra.dp A k m) =
      Nat.uniformBell n k * DividedPowerAlgebra.dp A (n * k) m := sorry

/-- A divided-power structure is canonical exactly when it equals the explicit canonical
structure. -/
theorem isCanonical_iff_eq_dividedPowers {I : Ideal A} {γ : DividedPowers I}
    {δ : DividedPowers (ideal A ι I)} :
    IsCanonical γ δ ↔ δ = dividedPowers γ := sorry

/-- A canonical divided-power structure exists on the extended ideal. -/
theorem exists_isCanonical {I : Ideal A} (γ : DividedPowers I) :
    ∃ δ : DividedPowers (ideal A ι I), IsCanonical γ δ := sorry

/-- Two divided-power structures satisfying the canonical specification are equal. -/
theorem IsCanonical.eq {I : Ideal A} {γ : DividedPowers I}
    {δ δ' : DividedPowers (ideal A ι I)} (hδ : IsCanonical γ δ)
    (hδ' : IsCanonical γ δ') : δ = δ' := sorry

/-- Any structure satisfying the canonical specification equals the explicit canonical
divided-power structure. -/
theorem IsCanonical.eq_dividedPowers {I : Ideal A} {γ : DividedPowers I}
    {δ : DividedPowers (ideal A ι I)} (hδ : IsCanonical γ δ) :
    δ = dividedPowers γ := sorry

/-- There is a unique canonical divided-power structure on the extended ideal of an indexed
divided-power polynomial algebra. -/
@[stacks 07H5 "canonical divided powers on indexed divided-power polynomials"]
theorem existsUnique_dividedPowers {I : Ideal A} (γ : DividedPowers I) :
    ∃! δ : DividedPowers (ideal A ι I), IsCanonical γ δ := sorry

end DividedPowers

section RenameDP

variable {A : Type u} [CommSemiring A] {I : Ideal A} (γ : DividedPowers I)
variable {ι : Type v} {κ : Type w}

/-- Renaming variables preserves the canonical divided-power structures on the extended
ideals. -/
theorem rename_isDPMorphism (f : ι → κ) :
    IsDPMorphism (dividedPowers (ι := ι) γ) (dividedPowers (ι := κ) γ)
      (rename A f).toRingHom := sorry

/-- The bundled divided-power morphism obtained by renaming variables. -/
@[stacks 07H5 "divided-power functoriality under renaming variables"]
noncomputable def renameDP (f : ι → κ) :
    DPMorphism (dividedPowers (ι := ι) γ) (dividedPowers (ι := κ) γ) :=
  DPMorphism.mk' (rename_isDPMorphism γ f)

/-- The ring homomorphism underlying `renameDP γ f` is the algebra homomorphism `rename A f`. -/
@[simp]
theorem renameDP_toRingHom (f : ι → κ) :
    (renameDP γ f).toRingHom = (rename A f).toRingHom := sorry

/-- Bundled renaming sends each variable to the variable with the renamed index. -/
@[simp]
theorem renameDP_X (f : ι → κ) (i : ι) :
    renameDP γ f (X A i) = X A (f i) := sorry

/-- Bundled renaming sends each formal divided power of a variable to the corresponding renamed
formal divided power. -/
@[simp]
theorem renameDP_dp (f : ι → κ) (n : ℕ) (i : ι) :
    renameDP γ f (dp A n i) = dp A n (f i) := sorry

/-- Bundled renaming acts on a formal divided power through the induced map of free modules. -/
@[simp]
theorem renameDP_apply_dp (f : ι → κ) (n : ℕ) (m : ι →₀ A) :
    renameDP γ f (DividedPowerAlgebra.dp A n m) =
      DividedPowerAlgebra.dp A n (Finsupp.lmapDomain A A f m) := sorry

/-- Renaming by the identity is the identity divided-power morphism. -/
@[simp]
theorem renameDP_id :
    renameDP (ι := ι) γ id = DPMorphism.id (dividedPowers (ι := ι) γ) := sorry

/-- Bundled variable renamings compose according to the underlying index maps. -/
theorem renameDP_comp {ζ : Type*} (f : ι → κ) (g : κ → ζ) :
    renameDP γ (g ∘ f) = (renameDP γ g).comp (renameDP γ f) := sorry

end RenameDP

section Lift

variable {A : Type u} [CommSemiring A] {ι : Type v}
variable {I : Ideal A} {γ : DividedPowers I}
variable {C : Type w} [CommSemiring C] {K : Ideal C} {ε : DividedPowers K}

/-- The explicit ring homomorphism from divided-power polynomials determined by a base divided
power morphism and target-ideal values for the variables. -/
@[stacks 07H5 "lift from a divided-power polynomial algebra"]
noncomputable def lift (f : DPMorphism γ ε) (x : ι → K) : DPPolynomial A ι →+* C :=
  -- Local instance justification (instance diamond): `DividedPowerAlgebra.lift` is stated using
  -- `[Algebra A C]`, and the supplied morphism `f` uniquely determines this scoped structure.
  letI : Algebra A C := f.toRingHom.toAlgebra
  (DividedPowerAlgebra.lift ε
    ((K.subtype.restrictScalars A).comp (Finsupp.linearCombination A x))
    (fun m ↦ ((Finsupp.linearCombination A x) m).property)).toRingHom

/-- The explicit lift restricts to the prescribed divided-power morphism on the base ring. -/
@[simp]
theorem lift_comp_algebraMap (f : DPMorphism γ ε) (x : ι → K) :
    (lift f x).comp (algebraMap A (DPPolynomial A ι)) = f.toRingHom := sorry

/-- The explicit lift sends each variable to its prescribed target-ideal value. -/
@[simp]
theorem lift_X (f : DPMorphism γ ε) (x : ι → K) (i : ι) :
    lift f x (X A i) = x i := sorry

/-- The explicit lift sends a formal divided power of a variable to the corresponding target
divided power. -/
@[simp]
theorem lift_dp (f : DPMorphism γ ε) (x : ι → K) (n : ℕ) (i : ι) :
    lift f x (dp A n i) = ε.dpow n (x i) := sorry

/-- The explicit lift sends the formal divided power of a finitely supported linear combination
to the corresponding target divided power. -/
@[simp]
theorem lift_apply_dp (f : DPMorphism γ ε) (x : ι → K) (n : ℕ) (m : ι →₀ A) :
    lift f x (DividedPowerAlgebra.dp A n m) =
      ε.dpow n (m.sum fun i a ↦ f a * x i) := sorry

/-- A divided-power polynomial lift preserves divided powers, restricts to the prescribed
base map, and sends every variable to its prescribed value. -/
structure IsLift (δ : DividedPowers (ideal A ι I))
    (f : DPMorphism γ ε) (x : ι → K) (φ : DPPolynomial A ι →+* C) : Prop where
  /-- The ring homomorphism preserves the chosen divided-power structures. -/
  isDPMorphism : IsDPMorphism δ ε φ
  /-- The ring homomorphism restricts to the prescribed base map. -/
  comp_algebraMap : φ.comp (algebraMap A (DPPolynomial A ι)) = f.toRingHom
  /-- The ring homomorphism takes every variable to its prescribed value. -/
  apply_X (i : ι) : φ (X A i) = x i

/-- The lift predicate is the conjunction of divided-power compatibility, base compatibility,
and the prescribed values on variables. -/
theorem isLift_iff {δ : DividedPowers (ideal A ι I)}
    {f : DPMorphism γ ε} {x : ι → K} {φ : DPPolynomial A ι →+* C} :
    IsLift δ f x φ ↔
      IsDPMorphism δ ε φ ∧
        φ.comp (algebraMap A (DPPolynomial A ι)) = f.toRingHom ∧
        ∀ i : ι, φ (X A i) = x i := sorry

/-- Under the canonical source divided powers, the explicit lift is a divided-power morphism. -/
theorem lift_isDPMorphism {δ : DividedPowers (ideal A ι I)} (hδ : IsCanonical γ δ)
    (f : DPMorphism γ ε) (x : ι → K) : IsDPMorphism δ ε (lift f x) := sorry

/-- The explicit lift satisfies the complete lift specification. -/
theorem lift_isLift {δ : DividedPowers (ideal A ι I)} (hδ : IsCanonical γ δ)
    (f : DPMorphism γ ε) (x : ι → K) : IsLift δ f x (lift f x) := sorry

/-- The explicit lift satisfies the complete specification whenever the source structure is
canonical. -/
def IsLift.ofCanonical {δ : DividedPowers (ideal A ι I)} (hδ : IsCanonical γ δ)
    (f : DPMorphism γ ε) (x : ι → K) : IsLift δ f x (lift f x) :=
  { isDPMorphism := lift_isDPMorphism hδ f x
    comp_algebraMap := lift_comp_algebraMap f x
    apply_X := lift_X f x }

/-- A divided-power polynomial lift from canonical source divided powers with the prescribed
base map and variable values equals the explicit lift. -/
theorem eq_lift {δ : DividedPowers (ideal A ι I)} {f : DPMorphism γ ε} {x : ι → K}
    {φ : DPPolynomial A ι →+* C} (hδ : IsCanonical γ δ) (hφ : IsLift δ f x φ) :
    φ = lift f x := sorry

/-- Package the explicit lift against any source structure satisfying `IsCanonical`.  This is the
low-level bridge used to compare the canonical owner with an externally supplied structure. -/
noncomputable def IsCanonical.dpLift {δ : DividedPowers (ideal A ι I)}
    (hδ : IsCanonical γ δ) (f : DPMorphism γ ε) (x : ι → K) : DPMorphism δ ε :=
  DPMorphism.mk' (lift_isDPMorphism hδ f x)

/-- The underlying ring homomorphism of the low-level bundled lift is the explicit lift. -/
@[simp]
theorem IsCanonical.dpLift_toRingHom {δ : DividedPowers (ideal A ι I)}
    (hδ : IsCanonical γ δ) (f : DPMorphism γ ε) (x : ι → K) :
    (hδ.dpLift f x).toRingHom = lift f x := sorry

/-- The low-level bundled lift sends each variable to its prescribed target-ideal value. -/
@[simp]
theorem IsCanonical.dpLift_X {δ : DividedPowers (ideal A ι I)}
    (hδ : IsCanonical γ δ) (f : DPMorphism γ ε) (x : ι → K) (i : ι) :
    hδ.dpLift f x (X A i) = x i := sorry

/-- The low-level bundled lift sends every formal divided power of a variable to the
corresponding target divided power. -/
@[simp]
theorem IsCanonical.dpLift_dp {δ : DividedPowers (ideal A ι I)}
    (hδ : IsCanonical γ δ) (f : DPMorphism γ ε) (x : ι → K) (n : ℕ) (i : ι) :
    hδ.dpLift f x (dp A n i) = ε.dpow n (x i) := sorry

/-- The low-level bundled lift computes divided powers of arbitrary finitely supported linear
combinations by the target divided-power operation. -/
@[simp]
theorem IsCanonical.dpLift_apply_dp {δ : DividedPowers (ideal A ι I)}
    (hδ : IsCanonical γ δ) (f : DPMorphism γ ε) (x : ι → K) (n : ℕ)
    (m : ι →₀ A) :
    hδ.dpLift f x (DividedPowerAlgebra.dp A n m) =
      ε.dpow n (m.sum fun i a ↦ f a * x i) := sorry

/-- A low-level bundled lift is determined by its base map and variable values. -/
theorem IsCanonical.dpLift_unique {δ : DividedPowers (ideal A ι I)}
    (hδ : IsCanonical γ δ) (f : DPMorphism γ ε) (x : ι → K) {φ : DPMorphism δ ε}
    (hbase : φ.toRingHom.comp (algebraMap A (DPPolynomial A ι)) = f.toRingHom)
    (hX : ∀ i : ι, φ (X A i) = x i) : φ = hδ.dpLift f x := sorry

/-- The low-level bundled lift is uniquely characterized by its base map and variable values. -/
theorem IsCanonical.existsUnique_dpLift {δ : DividedPowers (ideal A ι I)}
    (hδ : IsCanonical γ δ) (f : DPMorphism γ ε) (x : ι → K) :
    ∃! φ : DPMorphism δ ε,
      φ.toRingHom.comp (algebraMap A (DPPolynomial A ι)) = f.toRingHom ∧
        ∀ i : ι, φ (X A i) = x i := sorry

/-- Against any canonical source structure, the explicit lift is the unique ring homomorphism
satisfying the divided-power, base, and variable specifications. -/
theorem IsCanonical.existsUnique_lift {δ : DividedPowers (ideal A ι I)}
    (hδ : IsCanonical γ δ) (f : DPMorphism γ ε) (x : ι → K) :
    ∃! φ : DPPolynomial A ι →+* C, IsLift δ f x φ := sorry

/-- The canonical bundled divided-power polynomial lift.  Its source structure is inferred
from the base divided powers, so callers need not supply a separate `δ` or a canonicity proof. -/
@[stacks 07H5 "canonical divided-power polynomial lift"]
noncomputable def dpLift (f : DPMorphism γ ε) (x : ι → K) :
    DPMorphism (dividedPowers (ι := ι) γ) ε :=
  (dividedPowers_isCanonical (ι := ι) γ).dpLift f x

/-- The underlying ring homomorphism of the canonical bundled lift is the explicit lift. -/
@[simp]
theorem dpLift_toRingHom (f : DPMorphism γ ε) (x : ι → K) :
    (dpLift f x).toRingHom = lift f x := sorry

/-- The canonical bundled lift sends each variable to its prescribed value. -/
@[simp]
theorem dpLift_X (f : DPMorphism γ ε) (x : ι → K) (i : ι) :
    dpLift f x (X A i) = x i := sorry

/-- The canonical bundled lift sends formal divided powers of variables to target divided
powers. -/
@[simp]
theorem dpLift_dp (f : DPMorphism γ ε) (x : ι → K) (n : ℕ) (i : ι) :
    dpLift f x (dp A n i) = ε.dpow n (x i) := sorry

/-- The canonical bundled lift computes formal divided powers of arbitrary finitely supported
linear combinations in the target divided-power structure. -/
@[simp]
theorem dpLift_apply_dp (f : DPMorphism γ ε) (x : ι → K) (n : ℕ) (m : ι →₀ A) :
    dpLift f x (DividedPowerAlgebra.dp A n m) =
      ε.dpow n (m.sum fun i a ↦ f a * x i) := sorry

/-- The canonical bundled lift is determined by its base map and variable values. -/
theorem dpLift_unique (f : DPMorphism γ ε) (x : ι → K)
    {φ : DPMorphism (dividedPowers γ) ε}
    (hbase : φ.toRingHom.comp (algebraMap A (DPPolynomial A ι)) = f.toRingHom)
    (hX : ∀ i : ι, φ (X A i) = x i) : φ = dpLift f x := sorry

/-- The canonical bundled divided-power polynomial lift is uniquely characterized by its base
map and variable values. -/
theorem existsUnique_dpLift (f : DPMorphism γ ε) (x : ι → K) :
    ∃! φ : DPMorphism (dividedPowers γ) ε,
      φ.toRingHom.comp (algebraMap A (DPPolynomial A ι)) = f.toRingHom ∧
        ∀ i : ι, φ (X A i) = x i := sorry

/-- The explicit lift is the unique ring homomorphism satisfying the canonical divided-power,
base, and variable specifications. -/
@[stacks 07H5 "universal property of indexed divided-power polynomials"]
theorem existsUnique_lift (f : DPMorphism γ ε) (x : ι → K) :
    ∃! φ : DPPolynomial A ι →+* C, IsLift (dividedPowers γ) f x φ := sorry

end Lift

section Map

variable {A : Type u} [CommSemiring A] {I : Ideal A} {γ : DividedPowers I}
variable {B : Type w} [CommSemiring B] {J : Ideal B} {δ : DividedPowers J}
variable {ι : Type v}

/-- Map coefficients of divided-power polynomials along a divided-power morphism, fixing the
variable indices.  This is the canonical map obtained from the universal `dpLift`. -/
@[stacks 07H5 "functoriality in the divided-power coefficient ring"]
noncomputable def map (f : DPMorphism γ δ) :
    DPMorphism (dividedPowers (ι := ι) γ) (dividedPowers (ι := ι) δ) :=
  dpLift ((algebraMapDP (ι := ι) δ).comp f)
    (fun i ↦ ⟨X B i, X_mem_ideal B ι J i⟩)

/-- The coefficient map restricts on the base ring to the supplied divided-power morphism,
followed by the target algebra map. -/
@[simp]
theorem map_comp_algebraMap (f : DPMorphism γ δ) :
    (map (ι := ι) f).toRingHom.comp (algebraMap A (DPPolynomial A ι)) =
      (algebraMap B (DPPolynomial B ι)).comp f.toRingHom := sorry

/-- Mapping coefficients fixes every variable. -/
@[simp]
theorem map_X (f : DPMorphism γ δ) (i : ι) :
    map f (X A i) = X B i := sorry

/-- Mapping coefficients fixes the index and degree of every formal divided power of a
variable. -/
@[simp]
theorem map_dp (f : DPMorphism γ δ) (n : ℕ) (i : ι) :
    map f (dp A n i) = dp B n i := sorry

/-- Mapping coefficients evaluates a formal divided power through the canonical target
divided-power operation. -/
@[simp]
theorem map_apply_dp (f : DPMorphism γ δ) (n : ℕ) (m : ι →₀ A) :
    map f (DividedPowerAlgebra.dp A n m) =
      (dividedPowers δ).dpow n
        (m.sum fun i a ↦ algebraMap B (DPPolynomial B ι) (f a) * X B i) := sorry

/-- Mapping coefficients along the identity divided-power morphism is the identity. -/
@[simp]
theorem map_id :
    map (ι := ι) (DPMorphism.id γ) =
      DPMorphism.id (dividedPowers (ι := ι) γ) := sorry

section Composition

variable {C : Type x} [CommSemiring C] {K : Ideal C} {ε : DividedPowers K}

/-- Coefficient maps compose according to the underlying divided-power morphisms. -/
theorem map_comp (f : DPMorphism γ δ) (g : DPMorphism δ ε) :
    map (ι := ι) (g.comp f) = (map (ι := ι) g).comp (map (ι := ι) f) := sorry

end Composition

section RenameNaturality

variable {κ : Type x}

/-- Mapping coefficients commutes with renaming variables. -/
theorem renameDP_naturality (f : DPMorphism γ δ) (g : ι → κ) :
    (map (ι := κ) f).comp (renameDP γ g) =
      (renameDP δ g).comp (map (ι := ι) f) := sorry

end RenameNaturality

end Map

namespace FiniteSubset

section

variable (A : Type u) [CommSemiring A] {ι : Type v}

/-- The divided-power polynomial algebra on the variables in a finite subset `E`. -/
abbrev Ring (E : Finset ι) : Type (max u v) := DPPolynomial A E

/-- The inclusion of the subtype associated with `E ⊆ F`. -/
def inclusion {E F : Finset ι} (h : E ⊆ F) : E → F :=
  fun e ↦ ⟨e, h e.property⟩

/-- The linear map between free variable modules induced by `E ⊆ F`. -/
abbrev linearMap {E F : Finset ι} (h : E ⊆ F) : (E →₀ A) →ₗ[A] (F →₀ A) :=
  Finsupp.lmapDomain A A (inclusion h)

/-- The transition map between finite-subset divided-power polynomial algebras. -/
noncomputable def map {E F : Finset ι} (h : E ⊆ F) : Ring A E →ₐ[A] Ring A F :=
  DPPolynomial.rename A (inclusion h)

/-- The canonical map from the divided-power polynomial algebra on `E` to the algebra on all
variables indexed by `ι`. -/
noncomputable def toIndexed (E : Finset ι) : Ring A E →ₐ[A] DPPolynomial A ι :=
  DPPolynomial.rename A (fun e : E ↦ e.1)

/-- The transition map associated with a reflexive finite-subset inclusion is the identity. -/
@[simp]
theorem map_refl (E : Finset ι) :
    map A (le_refl E) = AlgHom.id A (Ring A E) := sorry

/-- Finite-subset transition maps compose according to transitivity of inclusion. -/
theorem map_trans {E F G : Finset ι} (hEF : E ⊆ F) (hFG : F ⊆ G) :
    map A (hEF.trans hFG) = (map A hFG).comp (map A hEF) := sorry

/-- The canonical map to the indexed algebra sends each finite-subset variable to the variable
with the same underlying index. -/
@[simp]
theorem toIndexed_X (E : Finset ι) (e : E) :
    toIndexed A E (DPPolynomial.X A e) = DPPolynomial.X A e.1 := sorry

/-- The finite-subset transition map sends each formal divided power along the inclusion of free
variable modules. -/
@[simp]
theorem map_apply_dp {E F : Finset ι} (h : E ⊆ F) (n : ℕ) (m : E →₀ A) :
    map A h (DividedPowerAlgebra.dp A n m) =
      DividedPowerAlgebra.dp A n (linearMap A h m) := sorry

/-- The maps from finite subsets into the indexed algebra commute with finite-subset transition
maps. -/
theorem toIndexed_comp_map {E F : Finset ι} (h : E ⊆ F) :
    (toIndexed A F).comp (map A h) = toIndexed A E := sorry

/-- The finite-subset transition map is uniquely characterized by its values on all formal
divided powers. -/
@[stacks 07H6 "finite-subset transition for divided-power polynomials"]
theorem existsUnique_map {E F : Finset ι} (h : E ⊆ F) :
    ∃! φ : Ring A E →ₐ[A] Ring A F,
      ∀ (n : ℕ) (m : E →₀ A),
        φ (DividedPowerAlgebra.dp A n m) =
          DividedPowerAlgebra.dp A n (linearMap A h m) := sorry

variable {B : Type x} [CommSemiring B] [Algebra A B]

/-- Compatibility of a family of maps from the finite-subset divided-power polynomial
algebras. -/
def IsCompatible (φ : ∀ E : Finset ι, Ring A E →ₐ[A] B) : Prop :=
  ∀ (E F : Finset ι) (h : E ⊆ F), (φ F).comp (map A h) = φ E

/-- The compatibility predicate unfolds to commutation with every finite-subset transition. -/
theorem isCompatible_iff {φ : ∀ E : Finset ι, Ring A E →ₐ[A] B} :
    IsCompatible A φ ↔
      ∀ (E F : Finset ι) (h : E ⊆ F), (φ F).comp (map A h) = φ E := sorry

/-- Restricting a finitely supported vector to its support and then mapping it into the indexed
divided-power polynomial algebra recovers its formal divided power. -/
@[simp]
theorem toIndexed_dp_support (n : ℕ) (m : ι →₀ A) :
    toIndexed A m.support
        (DividedPowerAlgebra.dp A n
          (m.subtypeDomain fun i ↦ i ∈ m.support)) =
      DividedPowerAlgebra.dp A n m := sorry

/-- The value assigned by a finite-subset cocone to a formal divided power.  It is computed at
the support of the finitely supported vector, so the construction makes no choice of a finite
stage. -/
def descValue (φ : ∀ E : Finset ι, Ring A E →ₐ[A] B)
    (nm : ℕ × (ι →₀ A)) : B :=
  φ nm.2.support
    (DividedPowerAlgebra.dp A nm.1
      (nm.2.subtypeDomain fun i ↦ i ∈ nm.2.support))

/-- The finite-support value of a zeroth formal divided power is one. -/
theorem descValue_zero (φ : ∀ E : Finset ι, Ring A E →ₐ[A] B) (m : ι →₀ A) :
    descValue A φ (0, m) = 1 := sorry

/-- For a compatible cocone, finite-support values respect scalar multiplication. -/
theorem descValue_smul (φ : ∀ E : Finset ι, Ring A E →ₐ[A] B)
    (hφ : IsCompatible A φ) (n : ℕ) (r : A) (m : ι →₀ A) :
    descValue A φ (n, r • m) = r ^ n • descValue A φ (n, m) := sorry

/-- Finite-support values satisfy the multiplication relation for formal divided powers. -/
theorem descValue_mul (φ : ∀ E : Finset ι, Ring A E →ₐ[A] B)
    (n p : ℕ) (m : ι →₀ A) :
    descValue A φ (n, m) * descValue A φ (p, m) =
      (n + p).choose n • descValue A φ (n + p, m) := sorry

/-- For a compatible cocone, finite-support values satisfy the addition relation for formal
divided powers. -/
theorem descValue_add (φ : ∀ E : Finset ι, Ring A E →ₐ[A] B)
    (hφ : IsCompatible A φ) (n : ℕ) (m m' : ι →₀ A) :
    descValue A φ (n, m + m') =
      (Finset.antidiagonal n).sum fun k ↦
        descValue A φ (k.1, m) * descValue A φ (k.2, m') := sorry

/-- A finite-support value may be computed in any finite stage containing the support. -/
theorem descValue_eq_of_support_subset
    (φ : ∀ E : Finset ι, Ring A E →ₐ[A] B) (hφ : IsCompatible A φ)
    (n : ℕ) (m : ι →₀ A) {E : Finset ι} (hm : m.support ⊆ E) :
    descValue A φ (n, m) =
      φ E
        (DividedPowerAlgebra.dp A n
          (m.subtypeDomain fun i ↦ i ∈ E)) := sorry

/-- The explicit map from indexed divided-power polynomials induced by a compatible family of
finite-subset maps. -/
@[stacks 07H6 "explicit finite-subset descent map"]
noncomputable def desc (φ : ∀ E : Finset ι, Ring A E →ₐ[A] B)
    (hφ : IsCompatible A φ) : DPPolynomial A ι →ₐ[A] B :=
  DividedPowerAlgebra.lift' (f := descValue A φ)
    (descValue_zero A φ) (descValue_smul A φ hφ)
    (descValue_mul A φ) (descValue_add A φ hφ)

/-- A map from the indexed divided-power polynomial algebra descends a compatible family on all
finite subsets. -/
def IsDesc (φ : ∀ E : Finset ι, Ring A E →ₐ[A] B)
    (g : DPPolynomial A ι →ₐ[A] B) : Prop :=
  ∀ E : Finset ι, g.comp (toIndexed A E) = φ E

/-- The descent predicate unfolds to agreement after every canonical finite-subset map. -/
theorem isDesc_iff {φ : ∀ E : Finset ι, Ring A E →ₐ[A] B}
    {g : DPPolynomial A ι →ₐ[A] B} :
    IsDesc A φ g ↔ ∀ E : Finset ι, g.comp (toIndexed A E) = φ E := sorry

/-- The explicit descended map sends a formal divided power to its finite-support value. -/
@[simp]
theorem desc_apply_dp (φ : ∀ E : Finset ι, Ring A E →ₐ[A] B)
    (hφ : IsCompatible A φ) (n : ℕ) (m : ι →₀ A) :
    desc A φ hφ (DividedPowerAlgebra.dp A n m) = descValue A φ (n, m) := sorry

/-- The explicit descended map agrees with the compatible family at every finite stage. -/
theorem desc_isDesc (φ : ∀ E : Finset ι, Ring A E →ₐ[A] B)
    (hφ : IsCompatible A φ) :
    IsDesc A φ (desc A φ hφ) := sorry

/-- The explicit descended map restricts to the given map at each finite stage. -/
@[simp]
theorem desc_comp_toIndexed (φ : ∀ E : Finset ι, Ring A E →ₐ[A] B)
    (hφ : IsCompatible A φ) (E : Finset ι) :
    (desc A φ hφ).comp (toIndexed A E) = φ E := sorry

/-- Every map agreeing with a compatible finite-subset family is the explicit descended map. -/
theorem desc_unique (φ : ∀ E : Finset ι, Ring A E →ₐ[A] B)
    (hφ : IsCompatible A φ) (g : DPPolynomial A ι →ₐ[A] B)
    (hg : IsDesc A φ g) :
    g = desc A φ hφ := sorry

/-- The indexed divided-power polynomial algebra is the colimit of its finite-subset
subalgebras, expressed by its reusable `AlgHom` universal property. -/
@[stacks 07H6 "finite-subset colimit presentation of divided-power polynomials"]
theorem existsUnique_desc (φ : ∀ E : Finset ι, Ring A E →ₐ[A] B)
    (hφ : IsCompatible A φ) :
    ∃! g : DPPolynomial A ι →ₐ[A] B, IsDesc A φ g := sorry

end

section CategoricalColimit

open CategoryTheory CategoryTheory.Limits

variable (A : Type u) [CommRing A] {ι : Type v}

namespace Diagram

/-- The identity law for the finite-subset diagram in `CommAlgCat A`. -/
theorem map_id (E : Finset ι) :
    CommAlgCat.ofHom (map A (leOfHom (𝟙 E))) =
      𝟙 (CommAlgCat.of A (Ring A E)) := sorry

/-- The composition law for the finite-subset diagram in `CommAlgCat A`. -/
theorem map_comp {E F G : Finset ι} (f : E ⟶ F) (g : F ⟶ G) :
    CommAlgCat.ofHom (map A (leOfHom (f ≫ g))) =
      CommAlgCat.ofHom (map A (leOfHom f)) ≫
        CommAlgCat.ofHom (map A (leOfHom g)) := sorry

end Diagram

/-- The diagram of divided-power polynomial algebras on finite subsets of variables. -/
noncomputable abbrev diagram : Finset ι ⥤ CommAlgCat.{max u v} A where
  obj E := CommAlgCat.of A (Ring A E)
  map f := CommAlgCat.ofHom (map A (leOfHom f))
  map_id := Diagram.map_id A
  map_comp := Diagram.map_comp A

namespace Diagram

/-- Naturality of the finite-stage maps into the indexed divided-power polynomial algebra. -/
theorem naturality {E F : Finset ι} (f : E ⟶ F) :
    (diagram (ι := ι) A).map f ≫ CommAlgCat.ofHom (toIndexed A F) =
      CommAlgCat.ofHom (toIndexed A E) ≫
        ((Functor.const (Finset ι)).obj
          (CommAlgCat.of A (DPPolynomial A ι))).map f := sorry

end Diagram

/-- The canonical cocone from finite-subset divided-power polynomials to the indexed algebra. -/
noncomputable def cocone : Cocone (diagram (ι := ι) A) where
  pt := CommAlgCat.of A (DPPolynomial A ι)
  ι :=
    { app E := CommAlgCat.ofHom (toIndexed A E)
      naturality := fun {E F} f ↦ Diagram.naturality (ι := ι) A (E := E) (F := F) f }

/-- The algebra map represented by a leg of an arbitrary finite-subset cocone. -/
def coconeMap (s : Cocone (diagram (ι := ι) A)) (E : Finset ι) :
    Ring A E →ₐ[A] s.pt :=
  (s.ι.app E).hom

/-- Every cocone on the finite-subset diagram gives a compatible family of algebra maps. -/
theorem coconeMap_isCompatible (s : Cocone (diagram (ι := ι) A)) :
    IsCompatible A (coconeMap A s) := sorry

/-- The explicit morphism from the indexed algebra to the point of a finite-subset cocone. -/
noncomputable def colimitDesc (s : Cocone (diagram (ι := ι) A)) :
    (cocone (ι := ι) A).pt ⟶ s.pt :=
  CommAlgCat.ofHom
    (desc A (coconeMap A s)
      (coconeMap_isCompatible (ι := ι) A s))

/-- The explicit colimit morphism agrees with the supplied cocone at every finite stage. -/
@[simp]
theorem colimitDesc_fac (s : Cocone (diagram (ι := ι) A)) (E : Finset ι) :
    (cocone (ι := ι) A).ι.app E ≫ colimitDesc (ι := ι) A s =
      s.ι.app E := sorry

/-- A morphism out of the indexed algebra is determined by its values on all finite stages. -/
theorem colimitDesc_unique (s : Cocone (diagram (ι := ι) A))
    (m : (cocone (ι := ι) A).pt ⟶ s.pt)
    (hm : ∀ E : Finset ι, (cocone (ι := ι) A).ι.app E ≫ m = s.ι.app E) :
    m = colimitDesc (ι := ι) A s := sorry

/-- The indexed divided-power polynomial algebra is the colimit in `CommAlgCat A` of its
finite-subset polynomial algebras. -/
@[stacks 07H6 "categorical finite-subset colimit of divided-power polynomials"]
noncomputable def isColimit : IsColimit (cocone (ι := ι) A) where
  desc := colimitDesc (ι := ι) A
  fac := colimitDesc_fac (ι := ι) A
  uniq := colimitDesc_unique (ι := ι) A

end CategoricalColimit

end FiniteSubset

namespace Finite

section

variable (A : Type u) [CommSemiring A] (n : ℕ)

/-- The divided-power polynomial algebra in `n` variables. -/
abbrev Ring : Type u := DPPolynomial A (Fin n)

/-- The variable with index `i : Fin n` in the finite divided-power polynomial algebra. -/
abbrev X {n : ℕ} (i : Fin n) : Ring A n := DPPolynomial.X A i

/-- The `m`th formal divided power of the variable with index `i : Fin n`. -/
abbrev dp {n : ℕ} (m : ℕ) (i : Fin n) : Ring A n := DPPolynomial.dp A m i

/-- The positive ideal in the finite divided-power polynomial algebra. -/
abbrev positiveIdeal : Ideal (Ring A n) := DPPolynomial.positiveIdeal A (Fin n)

/-- The base ideal extended by the positive ideal in the finite divided-power polynomial
algebra. -/
abbrev ideal (I : Ideal A) : Ideal (Ring A n) := DPPolynomial.ideal A (Fin n) I

end

section

variable {A : Type u} [CommSemiring A] {n : ℕ} {I : Ideal A} {γ : DividedPowers I}
variable {C : Type w} [CommSemiring C] {K : Ideal C} {ε : DividedPowers K}

/-- The finite-variable specialization of the canonical divided-power condition. -/
abbrev IsCanonical (γ : DividedPowers I) (δ : DividedPowers (ideal A n I)) : Prop :=
  DPPolynomial.IsCanonical γ δ

/-- The explicit canonical divided-power structure on a finite divided-power polynomial
ideal. -/
@[stacks 07H5 "finite canonical divided-power structure data"]
noncomputable abbrev dividedPowers (γ : DividedPowers I) :
    DividedPowers (ideal A n I) :=
  DPPolynomial.dividedPowers γ

/-- The finite canonical divided-power structure satisfies the canonical specification. -/
theorem dividedPowers_isCanonical (γ : DividedPowers I) :
    IsCanonical (n := n) γ (dividedPowers (n := n) γ) := sorry

/-- A finite-variable divided-power structure is canonical exactly when it equals the explicit
canonical structure. -/
theorem isCanonical_iff_eq_dividedPowers (γ : DividedPowers I)
    {δ : DividedPowers (ideal A n I)} :
    IsCanonical γ δ ↔ δ = dividedPowers γ := sorry

/-- The finite-variable specialization of the explicit divided-power polynomial lift. -/
noncomputable abbrev lift (f : DPMorphism γ ε) (x : Fin n → K) : Ring A n →+* C :=
  DPPolynomial.lift f x

/-- The finite-variable canonical bundled divided-power polynomial lift. -/
noncomputable abbrev dpLift (f : DPMorphism γ ε) (x : Fin n → K) :
    DPMorphism (dividedPowers (n := n) γ) ε :=
  DPPolynomial.dpLift f x

/-- The finite-variable specialization of the lift specification. -/
abbrev IsLift (δ : DividedPowers (ideal A n I))
    (f : DPMorphism γ ε) (x : Fin n → K) (φ : Ring A n →+* C) : Prop :=
  DPPolynomial.IsLift δ f x φ

/-- There is a unique canonical divided-power structure on the finite divided-power polynomial
ideal. -/
@[stacks 07H5 "finite divided-power polynomial structure"]
theorem existsUnique_dividedPowers (γ : DividedPowers I) :
    ∃! δ : DividedPowers (ideal A n I), IsCanonical γ δ := sorry

/-- The finite canonical bundled lift is characterized uniquely by the base map and the values
of the variables. -/
theorem existsUnique_dpLift (f : DPMorphism γ ε) (x : Fin n → K) :
    ∃! φ : DPMorphism (dividedPowers γ) ε,
      φ.toRingHom.comp (algebraMap A (Ring A n)) = f.toRingHom ∧
        ∀ i : Fin n, φ (X A i) = x i := sorry

/-- The finite divided-power polynomial lift is characterized uniquely by the base map and the
values of the variables, using the explicit canonical source structure. -/
@[stacks 07H5 "finite divided-power polynomial universal property"]
theorem existsUnique_lift (f : DPMorphism γ ε) (x : Fin n → K) :
    ∃! φ : Ring A n →+* C, IsLift (dividedPowers γ) f x φ := sorry

end

end Finite

end DPPolynomial
