module

public import ReasLib.AlgebraicGeometry.Scheme.Cover.Fpqc

/-!
# Stability of fpqc covering families

This module provides indexed-family closure results for fpqc coverings of
schemes, including composition, pullback, refinement, and descent along a
covering family.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.SemiRepresentableFamily.Over

universe u v w

namespace AlgebraicGeometry.Scheme

/- An isomorphism gives a singleton fpqc cover. -/
/-- A singleton family generated by an isomorphism is fpqc-covering. -/
theorem fpqcCovering_singleton_of_isIso {T T' : Scheme.{u}}
    (f : T' ⟶ T) [IsIso f] :
    Scheme.FpqcCovering (fun _ : Unit ↦ Over.mk f) := sorry

/- Indexed composition is expressed directly on the covering families. -/
/-- Indexed composition of fpqc covering families is fpqc-covering. -/
theorem fpqcCovering_comp {T : Scheme.{u}} {ι : Type v} {κ : ι → Type w}
    (X : ι → Over T) (Y : (i : ι) → κ i → Over (X i).left)
    (hX : Scheme.FpqcCovering X) (hY : ∀ i : ι, Scheme.FpqcCovering (Y i)) :
    Scheme.FpqcCovering (fun p : Sigma κ ↦
      Over.mk ((Y p.1 p.2).hom ≫ (X p.1).hom)) := sorry

/- Pullback is expressed with the canonical scheme pullback projection. -/
/-- Pulling an fpqc covering family back along a scheme morphism is fpqc-covering. -/
theorem fpqcCovering_pullback {T T' : Scheme.{u}} {ι : Type v}
    (X : ι → Over T) (hX : Scheme.FpqcCovering X) (f : T' ⟶ T) :
    Scheme.FpqcCovering (fun i : ι ↦ Over.mk (pullback.snd (X i).hom f)) := sorry

/-- A pointwise flat family refined by an fpqc-covering family is fpqc-covering. -/
theorem fpqcCovering_of_flat_of_exists_refinement {T : Scheme.{u}} {ι : Type v}
    (X : ι → Over T) (hflat : ∀ i : ι, Flat (X i).hom)
    (hrefines :
      ∃ (κ : Type w) (Y : κ → Over T),
        IsFpqcCovering Y ∧
          Refines
            (ofArrows (fun j ↦ (Y j).left) fun j ↦ (Y j).hom)
            (ofArrows (fun i ↦ (X i).left) fun i ↦ (X i).hom)) :
    IsFpqcCovering X := sorry

/-- A pointwise flat family is fpqc-covering if it becomes fpqc-covering after
base change along every member of some fpqc-covering family. -/
theorem fpqcCovering_of_flat_of_exists_covering_pullbacks
    {T : Scheme.{u}} {ι : Type v}
    (X : ι → Over T) (hflat : ∀ i : ι, Flat (X i).hom)
    (hpullback :
      ∃ (κ : Type w) (Y : κ → Over T),
        Scheme.FpqcCovering Y ∧
          ∀ j : κ,
            Scheme.FpqcCovering
              (fun i : ι ↦ Over.mk (pullback.fst (Y j).hom (X i).hom))) :
    Scheme.FpqcCovering X := sorry

end AlgebraicGeometry.Scheme
