module

public import Mathlib.RingTheory.Unramified.Finite
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Localization.Away.Idempotent

/-!
# The diagonal of a formally unramified algebra

For an essentially finite-type formally unramified algebra, Mathlib's
canonical separability element cuts out the diagonal as localization at an
idempotent.  The public localization statement is map-level and does not ask
callers to install an algebra structure on the multiplication map.

@stack 02FL
-/

@[expose] public section

open scoped TensorProduct

universe u v

namespace Algebra.FormallyUnramified.Diagonal

variable (R : Type u) (S : Type v) [CommRing R] [CommRing S] [Algebra R S]
variable [Algebra.EssFiniteType R S] [Algebra.FormallyUnramified R S]

/-- The canonical separability element of a formally unramified algebra is
idempotent. -/
@[stacks 02FL "diagonal idempotent"]
theorem elem_isIdempotent :
    IsIdempotentElem (Algebra.FormallyUnramified.elem R S) := sorry

/-- The kernel of tensor multiplication is generated by the complement of
the canonical separability idempotent. -/
@[stacks 02FL "diagonal kernel"]
theorem ker_eq_span_one_sub :
    RingHom.ker (Algebra.TensorProduct.lmul' R).toRingHom =
      Ideal.span {1 - Algebra.FormallyUnramified.elem R S} := sorry

/-- Tensor multiplication for an essentially finite-type formally unramified
algebra is localization at an idempotent. -/
@[stacks 02FL]
theorem isIdempotentLocalization :
    (Algebra.TensorProduct.lmul' R : S ⊗[R] S →ₐ[R] S).toRingHom.IsIdempotentLocalization := sorry

end Algebra.FormallyUnramified.Diagonal
