module

public import Mathlib.Algebra.Field.Equiv
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import ReasLib.RingTheory.Completion.CohenRing
import StacksCheckRecall

/-!
# Cohen rings with prescribed residue field

@stack 0328
-/

@[expose] public section

universe u

open Ideal IsLocalRing

namespace IsCohenRing

/-- For a Cohen ring whose residue field has characteristic `p`, quotienting by the element
`p` gives its residue field. -/
@[stacks 0328 "quotient by the prime generator"]
noncomputable def quotientSpanNatPrimeRingEquiv
    {Λ : Type u} [CommRing Λ] [IsCohenRing Λ] {p : ℕ} [Fact p.Prime]
    [CharP (ResidueField Λ) p] :
    (Λ ⧸ Ideal.span {(p : Λ)}) ≃+* ResidueField Λ := sorry

/-- Lemma 10.160.6 (0328), canonical residue-field form: every field of prime characteristic is
the residue field of a Cohen ring. -/
@[stacks 0328 "residue-field form"]
theorem exists_residueField_ringEquiv
    (p : ℕ) [Fact p.Prime] (k : Type u) [Field k] [CharP k p] :
    ∃ (Λ : Type u) (_ : CommRing Λ) (_ : IsCohenRing Λ),
      Nonempty (ResidueField Λ ≃+* k) := sorry

end IsCohenRing

section

variable (p : ℕ) [Fact p.Prime]
variable (k : Type u) [Field k] [CharP k p]

/-- Lemma 10.160.6 (0328): there is a Cohen ring whose quotient by `p` is `k`. -/
@[stacks 0328]
theorem exists_cohenRing_with_quotient_by_prime_ringEquiv :
    ∃ (Λ : Type u) (_ : CommRing Λ) (_ : IsCohenRing Λ),
      Nonempty ((Λ ⧸ Ideal.span {(p : Λ)}) ≃+* k) := sorry

end

@[stacks 0328 "Cohen-ring owner"]
#check @IsCohenRing

@[stacks 0328 "Cohen-ring specification"]
#check @IsCohenRing.spec

@[stacks 0328 "maximal ideal generated by the residue characteristic"]
#check IsCohenRing.maximalIdeal_eq_span_residueChar

@[stacks 0328 "quotient by the prime generator"]
#check @IsCohenRing.quotientSpanNatPrimeRingEquiv

@[stacks 0328 "canonical residue-field existence"]
#check @IsCohenRing.exists_residueField_ringEquiv
