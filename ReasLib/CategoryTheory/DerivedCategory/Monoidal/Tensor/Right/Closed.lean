/-- The fixed-right derived tensor/internal-Hom counit is natural in its target object. -/
@[reassoc, stacks 0A8W "fixed-right derived tensor/internal-Hom counit naturality"]
theorem counitOf_natural_target
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    (E : DerivedCategory C) [DerivedTensor.Right.Has (C := C)]
