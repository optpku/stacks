module

import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.CategoryTheory.CategoryOfElements.Section
public import ReasLib.CategoryTheory.Fibered.BasedCategory.Basic

/-!
# Based functors from sections

This module packages the neutral category-of-elements functor generated by a section as a strict
functor over the base while preserving the source's native category instance.
-/

@[expose] public section

universe w u v uD vD

namespace CategoryTheory

variable {C : Type u} [Category.{v} C]

namespace CategoryOfElements.Section

/-- A section over the projection of a based category, packaged as a strict functor over the
base.  Accepting the based owner preserves its native category instance. -/
def basedFunctor (X : BasedCategory.{vD, uD} C) (F : Cᵒᵖ ⥤ Type w)
    (σ : (X.p.op ⋙ F).sections) :
    X ⥤ᵇ BasedCategory.ofFunctor (CategoryOfElements.π F).leftOp where
  toFunctor := functor X.p F σ
  w := functor_comp_projection X.p F σ

/-- Forgetting the based structure from `basedFunctor` recovers the section functor. -/
@[simp]
theorem basedFunctor_toFunctor (X : BasedCategory.{vD, uD} C)
    (F : Cᵒᵖ ⥤ Type w) (σ : (X.p.op ⋙ F).sections) :
    (basedFunctor X F σ).toFunctor = functor X.p F σ := sorry

end CategoryOfElements.Section

end CategoryTheory
