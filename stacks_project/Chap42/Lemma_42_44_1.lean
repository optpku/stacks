module

import StacksCheckRecall
public import ReasLib.AlgebraicGeometry.ChowCohomology.ChernClass.Section

open CategoryTheory

noncomputable section

universe u

/- Lemma 42.44.1: if a pulled-back section has a zero scheme of the expected dimension and its
ideal is generically generated by a regular sequence of the rank, then the degree-`r` Chern
class capped with the fundamental class equals the associated zero-scheme class. -/
@[stacks 0FA9] #check
  (AlgebraicGeometry.ChernClass.capFundamental_eq_sectionZeroClass :
    ∀ {S X X' : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.UniversallyCatenary S]
      (δ : S → ℤ) [IsDimensionFunction δ]
      (p : X ⟶ S) [AlgebraicGeometry.LocallyOfFiniteType p]
      (E : X.Modules) [E.IsFiniteLocallyFree] (f : X' ⟶ X)
      [AlgebraicGeometry.LocallyOfFiniteType f] (r : ℕ)
      [((AlgebraicGeometry.Scheme.Modules.pullback f).obj E).IsFiniteLocallyFreeOfRank r]
      (s : ((AlgebraicGeometry.Scheme.Modules.pullback f).obj E).sections) (n : ℤ)
      (hX' : (f ≫ p).closedSubschemeDeltaDimension δ ⊥ = (n : EInt))
      (hZ : (f ≫ p).closedSubschemeDeltaDimension δ
        (AlgebraicGeometry.Scheme.Modules.sectionZeroIdeal
          ((AlgebraicGeometry.Scheme.Modules.pullback f).obj E) r s) ≤
          ((n - (r : ℤ) : ℤ) : EInt))
      (hregular : ∀ ξ : genericPoints
        (AlgebraicGeometry.Scheme.Modules.sectionZeroIdeal
          ((AlgebraicGeometry.Scheme.Modules.pullback f).obj E) r s).subscheme,
        (f ≫ p).relativeDimensionFunction δ
            ((AlgebraicGeometry.Scheme.Modules.sectionZeroIdeal
              ((AlgebraicGeometry.Scheme.Modules.pullback f).obj E) r s).subschemeι ξ.1) =
              n - (r : ℤ) →
          AlgebraicGeometry.Scheme.IdealSheafData.IsGeneratedByRegularSequenceAt
            (AlgebraicGeometry.Scheme.Modules.sectionZeroIdeal
              ((AlgebraicGeometry.Scheme.Modules.pullback f).obj E) r s)
            ((AlgebraicGeometry.Scheme.Modules.sectionZeroIdeal
              ((AlgebraicGeometry.Scheme.Modules.pullback f).obj E) r s).subschemeι ξ.1) r),
      (AlgebraicGeometry.ChernClass.chernClass δ p E r).cap
          (Over.homMk f rfl : Over.mk (f ≫ p) ⟶ Over.mk p)
          (𝟙 (Over.mk (f ≫ p))) (Over.homMk f rfl) IsPullback.of_id_snd n
          (AlgebraicGeometry.RelativeChow.fundamentalClass δ (Over.mk (f ≫ p)) n) =
        AlgebraicGeometry.RelativeChow.closedSubschemeClass δ (Over.mk (f ≫ p))
          (AlgebraicGeometry.Scheme.Modules.sectionZeroIdeal
            ((AlgebraicGeometry.Scheme.Modules.pullback f).obj E) r s : X'.IdealSheafData)
          (n - (r : ℤ)))
