module

public import ReasLib.RingTheory.Ideal.Projective
import StacksCheckRecall

@[expose] public section

universe u v

/- Lemma 110.34.1: if an ideal of a ring is generated by a countable collection of
idempotents, then it is projective as an `R`-module. -/
@[stacks 05WH] #check (Ideal.projective_of_countable_idempotents :
  ∀ {R : Type u} [CommRing R] {ι : Type v} [Countable ι] (e : ι → R),
    (∀ i, IsIdempotentElem (e i)) → Module.Projective R (Ideal.span (Set.range e)))

#check (Ideal.projective_span_countable_idempotents :
  ∀ {R : Type u} [CommRing R] (S : Set R),
    S.Countable → (∀ x ∈ S, IsIdempotentElem x) → Module.Projective R (Ideal.span S))
