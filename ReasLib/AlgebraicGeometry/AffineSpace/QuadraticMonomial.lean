module

public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.RingTheory.Ideal.Height
public import Mathlib.RingTheory.Ideal.Over
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.RingTheory.MvPolynomial.Basic
public import Mathlib.RingTheory.Unramified.Locus

/-!
# Quadratic monomial double covers

The subalgebra generated by products of pairs of coordinates, its origin ideal,
and the ramification of the associated affine-spectrum morphism.
-/

@[expose] public section

open MvPolynomial AlgebraicGeometry CategoryTheory Algebra

universe u v

namespace AlgebraicGeometry.AffineSpace.QuadraticMonomial

noncomputable section

section Construction

variable (k : Type u) (ι : Type v) [CommRing k] [DecidableEq ι]

/-- The set of quadratic monomials `X i * X j` in `MvPolynomial ι k`. -/
def quadraticMonomials : Set (MvPolynomial ι k) :=
  Set.range fun pair : ι × ι ↦ X pair.1 * X pair.2

/-- The `k`-subalgebra generated by all quadratic monomials `X i * X j`. -/
def quadraticMonomialAdjoin : Subalgebra k (MvPolynomial ι k) :=
  Algebra.adjoin k (quadraticMonomials k ι)

/-- The ideal generated by the quadratic monomials in their adjoin subalgebra. -/
def originQuadraticIdeal : Ideal (quadraticMonomialAdjoin k ι) :=
  Ideal.span {element | (element : MvPolynomial ι k) ∈ quadraticMonomials k ι}

/-- The affine-spectrum morphism induced by the quadratic-monomial subalgebra inclusion. -/
def quadraticMonomialCover :
    Spec (CommRingCat.of (MvPolynomial ι k)) ⟶
      Spec (CommRingCat.of (quadraticMonomialAdjoin k ι)) :=
  Spec.map (CommRingCat.ofHom (algebraMap (quadraticMonomialAdjoin k ι) (MvPolynomial ι k)))

variable [IsDomain k]

/-- The ring homomorphism on fraction fields induced by the quadratic-monomial inclusion. -/
def fractionMap_quadraticMonomialAdjoin :
    FractionRing (quadraticMonomialAdjoin k ι) →+* FractionRing (MvPolynomial ι k) :=
  IsFractionRing.map (j := algebraMap (quadraticMonomialAdjoin k ι) (MvPolynomial ι k))
    Subtype.val_injective

/-- The polynomial fraction field is an algebra over the quadratic-monomial fraction field. -/
instance algebra_fraction_quadraticMonomialAdjoin :
    Algebra (FractionRing (quadraticMonomialAdjoin k ι)) (FractionRing (MvPolynomial ι k)) :=
  (fractionMap_quadraticMonomialAdjoin k ι).toAlgebra

/-- A polynomial is a quadratic monomial exactly when it equals some `X i * X j`. -/
theorem mem_quadraticMonomials {polynomial : MvPolynomial ι k} :
    polynomial ∈ quadraticMonomials k ι ↔
      ∃ i j : ι, polynomial = X i * X j := sorry

/-- Every quadratic monomial belongs to the subalgebra generated by quadratic monomials. -/
theorem quadraticMonomials_subset_adjoin :
    quadraticMonomials k ι ⊆ quadraticMonomialAdjoin k ι := sorry

end Construction

variable {k : Type u} {ι : Type v} [Field k] [DecidableEq ι]

/-- In positive finite dimension and characteristic different from `2`, the polynomial
fraction field has degree `2` over the quadratic-monomial fraction field. -/
theorem finrank_fraction_quadraticMonomialAdjoin [Fintype ι] [Nonempty ι]
    (h_char : ringChar k ≠ 2) :
    Module.finrank (FractionRing (quadraticMonomialAdjoin k ι))
      (FractionRing (MvPolynomial ι k)) = 2 := sorry

/-- In positive finite dimension and characteristic different from `2`, the polynomial
algebra is unramified at primes whose contraction is not the quadratic-monomial origin. -/
theorem unramifiedAt_of_ne_origin [Fintype ι] [Nonempty ι] (h_char : ringChar k ≠ 2)
    (q : Ideal (MvPolynomial ι k)) [q.IsPrime]
    (hq : q.comap (algebraMap (quadraticMonomialAdjoin k ι) (MvPolynomial ι k)) ≠
      originQuadraticIdeal k ι) :
    IsUnramifiedAt (quadraticMonomialAdjoin k ι) q := sorry

/-- In positive finite dimension and characteristic different from `2`, the polynomial
algebra is ramified at primes lying over the quadratic-monomial origin. -/
theorem not_unramifiedAt_origin [Fintype ι] [Nonempty ι] (h_char : ringChar k ≠ 2)
    (q : Ideal (MvPolynomial ι k)) [q.IsPrime]
    [q.LiesOver (originQuadraticIdeal k ι)] :
    ¬ IsUnramifiedAt (quadraticMonomialAdjoin k ι) q := sorry

/-- The origin ideal of the finite-dimensional quadratic-monomial algebra over a field
is maximal and has height equal to the number of variables. -/
theorem height_originQuadraticIdeal [Fintype ι] :
    (originQuadraticIdeal k ι).IsMaximal ∧
      (originQuadraticIdeal k ι).height = Fintype.card ι := sorry

end

end AlgebraicGeometry.AffineSpace.QuadraticMonomial
