module

public import ReasLib.RingTheory.Kaehler.Quotient.FittingIdeal
import StacksCheckRecall

@[expose] public section

universe u

/- Lemma 49.7.4: if `B = A[x₁, …, xₙ]/(f₁, …, fₙ)` with `n ≥ 1`, then the
Kähler different `Fit[B]₀(Ω[B⁄A])` is generated by the image in `B` of the
Jacobian determinant `det (fun i j ↦ MvPolynomial.pderiv j (f i))`. -/
@[stacks 0BVZ] #check
  (KaehlerDifferential.Quotient.fittingIdeal_eq_span_jacobianDet :
    ∀ {A : Type u} [CommRing A] {n : ℕ}, 1 ≤ n →
      (f : Fin n → MvPolynomial (Fin n) A) →
        let I := Ideal.span (Set.range f)
        let B := MvPolynomial (Fin n) A ⧸ I
        fittingIdeal B (KaehlerDifferential A B) 0 =
          Ideal.span
            {Ideal.Quotient.mk I
              (Matrix.det (fun i j ↦ MvPolynomial.pderiv j (f i)))})
