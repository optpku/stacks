module

public import stacks_project.Chap67.Definition_67_20_2_Affine
public import stacks_project.Chap69.Lemma_69_17_2_Product
public import stacks_project.Chap69.Lemma_69_17_2_Pullback

/-!
# Lemma 69.17.2

For an affine morphism of algebraic spaces, multiplying a pushed-forward
quasi-coherent module by a quasi-coherent ideal sheaf agrees with the
pushforward of multiplication by the inverse-image ideal.
-/

@[expose]
public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open AlgebraicGeometry.AlgebraicSpace

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.Modules

/-- Lemma 69.17.2: for an affine morphism `f : Y ⟶ X` of algebraic spaces over a
scheme `S`, a quasi-coherent `𝒪_Y`-module `F`, and a quasi-coherent ideal sheaf
`I` on `X`, the product `I · f_* F` equals `f_*(I.pullback f · F)` as
`𝒪_X`-submodules of `f_* F`. Here `I.pullback f` is the inverse-image ideal
`f⁻¹I · 𝒪_Y`, and `f⁻¹I · F` is the subsheaf generated by local products
`a • s`. -/
@[stacks 0GF8]
theorem idealProductSubobject_pushforward_eq_map_of_affine
    {S : Scheme.{u}} {X Y : AlgebraicSpace S} (f : Y ⟶ X) [Affine f]
    (F : Y.Modules) [F.IsQuasicoherent] (I : IdealSubobject X) [IsQuasiCoherent I] :
    idealProductSubobject I ((pushforward f).obj F) =
      (Subobject.map
          ((pushforward f).map
            (idealProductSubobject (I.pullback f) F).arrow)).obj ⊤ :=
  sorry

end AlgebraicGeometry.AlgebraicSpace.Modules
