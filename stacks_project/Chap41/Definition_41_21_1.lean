module

public import ReasLib.AlgebraicGeometry.Scheme.Divisor.NormalCrossings
import StacksCheckRecall

/-!
# Definition 41.21.1

Strict normal crossings divisors on locally Noetherian schemes.

@stack 0BI9
-/

@[expose] public section

universe u

/- Definition 41.21.1

An effective Cartier divisor `D` on a locally Noetherian scheme `X` has strict normal crossings
if every point `p ∈ D.support` has regular local ring and the stalk ideal of `D` is generated by
the product of a nonempty initial segment of a regular system of parameters.
-/
@[stacks 0BI9] #check
  (@AlgebraicGeometry.IsStrictNormalCrossingsDivisor :
    {X : AlgebraicGeometry.Scheme.{u}} → [AlgebraicGeometry.IsLocallyNoetherian X] →
      X.IdealSheafData → Prop)
