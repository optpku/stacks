module

public import Mathlib.Algebra.Polynomial.FieldDivision
public import Mathlib.FieldTheory.IsAlgClosed.Basic
public import Mathlib.RingTheory.Ideal.Maximal
public import Mathlib.RingTheory.Polynomial.Ideal
public import Mathlib.RingTheory.PrincipalIdealDomain
public import Mathlib.RingTheory.Spectrum.Prime.Topology
public import Mathlib.Topology.JacobsonSpace

/-!
# Prime spectrum of a univariate polynomial ring over a field

Prime ideals, specializations, and Zariski-closed sets of `PrimeSpectrum k[X]`
are classified over a field `k`, with an algebraically closed refinement via
evaluation at scalars.
-/

@[expose] public section

noncomputable section

universe u

open Polynomial

namespace Polynomial

variable {k : Type u} [Field k]

/-- A nonzero prime ideal of `k[X]` is generated by a unique monic irreducible polynomial. -/
theorem existsUnique_monic_irreducible {P : Ideal k[X]} (hP : P.IsPrime) (hP0 : P ≠ ⊥) :
    ∃! p : k[X], p.Monic ∧ Irreducible p ∧ P = Ideal.span {p} := sorry

/-- The closed point of `PrimeSpectrum k[X]` obtained by pulling back the zero prime
along evaluation at `a : k`. -/
def closedPoint (a : k) : PrimeSpectrum k[X] :=
  PrimeSpectrum.comap (Polynomial.evalRingHom a) (⊥ : PrimeSpectrum k)

/-- The ideal of `closedPoint a` is the principal ideal generated by `X - C a`. -/
theorem closedPoint_asIdeal (a : k) : (closedPoint a).asIdeal = Ideal.span {X - C a} := sorry

/-- Evaluation at a scalar determines a closed point of `PrimeSpectrum k[X]`. -/
theorem closedPoint_mem_closedPoints (a : k) :
    closedPoint a ∈ closedPoints (PrimeSpectrum k[X]) := sorry

/-- Distinct scalars determine distinct closed points of `PrimeSpectrum k[X]`. -/
theorem closedPoint_injective : Function.Injective (closedPoint : k → PrimeSpectrum k[X]) := sorry

/-- An ideal of `k[X]` is prime if and only if it is zero or principal generated by an
irreducible polynomial. -/
theorem isPrime_iff {P : Ideal k[X]} :
    P.IsPrime ↔ P = ⊥ ∨ ∃ p : k[X], Irreducible p ∧ P = Ideal.span {p} := sorry

/-- Over an algebraically closed field, an ideal of `k[X]` is prime if and only if it is zero
or of the form `Ideal.span {X - C a}` for some `a : k`. -/
theorem isPrime_iff_of_isAlgClosed [IsAlgClosed k] {P : Ideal k[X]} :
    P.IsPrime ↔ P = ⊥ ∨ ∃ a : k, P = Ideal.span {X - C a} := sorry

/-- On `PrimeSpectrum k[X]`, a point specializes only to itself, except that the generic point
`⊥` specializes to every point. -/
theorem specializes_iff {x y : PrimeSpectrum k[X]} :
    x ⤳ y ↔ x = y ∨ x = (⊥ : PrimeSpectrum k[X]) := sorry

/-- A subset of `PrimeSpectrum k[X]` is Zariski closed if and only if it is the whole space or
a finite set of closed points. -/
theorem isClosed_iff {s : Set (PrimeSpectrum k[X])} :
    IsClosed s ↔ s = Set.univ ∨ s.Finite ∧ s ⊆ closedPoints (PrimeSpectrum k[X]) := sorry

/-- Over an algebraically closed field, a Zariski-closed subset of `PrimeSpectrum k[X]` is
either the whole space or the image of a finite set of scalars under `closedPoint`. -/
theorem isClosed_iff_of_isAlgClosed [IsAlgClosed k] {s : Set (PrimeSpectrum k[X])} :
    IsClosed s ↔ s = Set.univ ∨ ∃ t : Finset k, s = closedPoint '' (t : Set k) := sorry

end Polynomial
