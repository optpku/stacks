module

public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Ideal.OfDefinition

@[expose] public section

/-!
# Systems of Parameters in Local Rings

This module provides the chosen-family API for parameter ideals, systems of parameters, and
regular systems of parameters.  The ambient regularity predicate remains mathlib's
`IsRegularLocalRing`.
-/

universe u v

namespace IsLocalRing

section

variable {R : Type u} [CommRing R] [IsLocalRing R]

/-- The ideal generated by an arbitrary family of elements in the maximal ideal of a local ring. -/
@[stacks 00KU "parameter ideal"]
def parameterIdeal {ι : Type v} (x : ι → maximalIdeal R) : Ideal R :=
  Ideal.span (Set.range fun i ↦ (x i : R))

/-- A parameter ideal is the span of the underlying family in the ambient ring. -/
@[simp]
theorem parameterIdeal_eq_span {ι : Type v} (x : ι → maximalIdeal R) :
    parameterIdeal x = Ideal.span (Set.range fun i ↦ (x i : R)) := sorry

/-- A parameter ideal generated by a one-element family is the principal
ideal generated by that entry. -/
@[simp, stacks 00KU "singleton parameter ideal"]
theorem parameterIdeal_fin1_eq_span_singleton (x : Fin 1 → maximalIdeal R) :
    parameterIdeal x = Ideal.span ({(x 0 : R)} : Set R) := sorry

/-- The minimal number of generators of a parameter ideal is bounded by the
cardinality of any finite family that presents it. -/
@[stacks 00KU "parameter ideal generator bound"]
theorem parameterIdeal_spanFinrank_le_card {ι : Type v} [Fintype ι]
    (x : ι → maximalIdeal R) :
    (parameterIdeal x).spanFinrank ≤ Fintype.card ι := sorry

/-- A parameter ideal presented by `d` elements has `spanFinrank` at most
`d`. -/
@[stacks 00KU "finite parameter ideal generator bound"]
theorem parameterIdeal_spanFinrank_le {d : ℕ}
    (x : Fin d → maximalIdeal R) :
    (parameterIdeal x).spanFinrank ≤ d := sorry

/-- A system of parameters is a family in the maximal ideal whose length is the Krull dimension
and whose parameter ideal is an ideal of definition. -/
@[stacks 00KU]
def IsSystemOfParameters {d : ℕ} (x : Fin d → maximalIdeal R) : Prop :=
  ringKrullDim R = d ∧ (parameterIdeal x).IsIdealOfDefinition

/-- A family is a system of parameters exactly when it has the defining dimension and
ideal-of-definition properties. -/
@[simp]
theorem isSystemOfParameters_iff {d : ℕ} (x : Fin d → maximalIdeal R) :
    IsSystemOfParameters x ↔
      ringKrullDim R = d ∧ (parameterIdeal x).IsIdealOfDefinition := sorry

/-- When the Krull dimension is already known, a system of parameters is exactly a family whose
parameter ideal is an ideal of definition. -/
@[simp]
theorem isSystemOfParameters_iff_of_ringKrullDim_eq {d : ℕ}
    (hdim : ringKrullDim R = d) (x : Fin d → maximalIdeal R) :
    IsSystemOfParameters x ↔ (parameterIdeal x).IsIdealOfDefinition := sorry

/-- A regular system of parameters is a system of parameters generating the maximal ideal. -/
@[stacks 00KU]
def IsRegularSystemOfParameters {d : ℕ} (x : Fin d → maximalIdeal R) : Prop :=
  IsSystemOfParameters x ∧ parameterIdeal x = maximalIdeal R

/-- A regular system of parameters has the expected dimension and generates the maximal ideal. -/
@[simp]
theorem isRegularSystemOfParameters_iff {d : ℕ} (x : Fin d → maximalIdeal R) :
    IsRegularSystemOfParameters x ↔
      ringKrullDim R = d ∧ parameterIdeal x = maximalIdeal R := sorry

/-- With the dimension fixed in advance, a regular system of parameters is exactly a family
generating the maximal ideal. -/
@[simp]
theorem isRegularSystemOfParameters_iff_of_ringKrullDim_eq {d : ℕ}
    (hdim : ringKrullDim R = d) (x : Fin d → maximalIdeal R) :
    IsRegularSystemOfParameters x ↔ parameterIdeal x = maximalIdeal R := sorry

namespace IsRegularSystemOfParameters

/-- A regular system of parameters is a system of parameters. -/
theorem isSystemOfParameters {d : ℕ} {x : Fin d → maximalIdeal R}
    (hx : IsRegularSystemOfParameters x) : IsSystemOfParameters x := sorry

end IsRegularSystemOfParameters

/-- A family is part of a regular system of parameters of total length `d` when it is the prefix of
a regular family indexed by `Fin d`. -/
@[stacks 00KU]
def IsPartOfRegularSystemOfParameters (d : ℕ) {c : ℕ}
    (x : Fin c → maximalIdeal R) : Prop :=
  ∃ (hcd : c ≤ d) (y : Fin d → maximalIdeal R),
    (∀ i : Fin c, y (Fin.castLE hcd i) = x i) ∧ IsRegularSystemOfParameters y

/-- Unfold `IsPartOfRegularSystemOfParameters` into its length bound, extending family, prefix
agreement, and regularity condition. -/
theorem isPartOfRegularSystemOfParameters_iff (d : ℕ) {c : ℕ}
    (x : Fin c → maximalIdeal R) :
    IsPartOfRegularSystemOfParameters d x ↔
      ∃ (hcd : c ≤ d) (y : Fin d → maximalIdeal R),
        (∀ i : Fin c, y (Fin.castLE hcd i) = x i) ∧ IsRegularSystemOfParameters y := sorry

namespace IsPartOfRegularSystemOfParameters

/-- A partial regular system has no more entries than the regular system extending it. -/
theorem length_le {d c : ℕ} {x : Fin c → maximalIdeal R}
    (hx : IsPartOfRegularSystemOfParameters d x) : c ≤ d := sorry

/-- A partial regular system admits a regular extension whose first entries are the given family. -/
theorem exists_extension {d c : ℕ} {x : Fin c → maximalIdeal R}
    (hx : IsPartOfRegularSystemOfParameters d x) :
    ∃ (hcd : c ≤ d) (y : Fin d → maximalIdeal R),
      (∀ i : Fin c, y (Fin.castLE hcd i) = x i) ∧ IsRegularSystemOfParameters y := sorry

/-- Construct a partial regular system from a regular extension and an identified prefix. -/
theorem of_extension {d c : ℕ} {x : Fin c → maximalIdeal R}
    (hcd : c ≤ d) (y : Fin d → maximalIdeal R)
    (hy : ∀ i : Fin c, y (Fin.castLE hcd i) = x i)
    (hregular : IsRegularSystemOfParameters y) :
    IsPartOfRegularSystemOfParameters d x := sorry

end IsPartOfRegularSystemOfParameters

namespace IsRegularSystemOfParameters

/-- An initial segment of a regular system of parameters is part of that
regular system. -/
@[stacks 00KU]
theorem initialSegment {d i : ℕ} {x : Fin d → maximalIdeal R}
    (hx : IsRegularSystemOfParameters x) (hi : i ≤ d) :
    IsPartOfRegularSystemOfParameters d (x ∘ Fin.castLE hi) := sorry

end IsRegularSystemOfParameters

end

end IsLocalRing

namespace IsRegularLocalRing

/-- A Noetherian local ring is regular exactly when it has a regular system of parameters indexed
by its Krull dimension. -/
@[stacks 00KU]
theorem iff_exists_regularSystemOfParameters
    {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R] {d : ℕ}
    (hdim : ringKrullDim R = d) :
    IsRegularLocalRing R ↔
      ∃ x : Fin d → IsLocalRing.maximalIdeal R, IsLocalRing.IsRegularSystemOfParameters x := sorry

end IsRegularLocalRing
