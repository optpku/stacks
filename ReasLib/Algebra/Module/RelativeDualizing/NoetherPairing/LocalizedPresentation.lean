module

public import ReasLib.Algebra.Module.RelativeDualizing.NoetherPairing.TraceElement
public import ReasLib.RingTheory.Kaehler.NoetherDifferent.LocalizedPresentation

@[expose] public section

open AlgebraicGeometry

universe u

namespace Algebra.LocalizedPresentation

/-- A quasi-finite localized polynomial complete intersection has a relative
dualizing module generated by the Jacobian determinant, with the generator
identified by a universal trace element. -/
theorem exists_relativeDualizingEquiv
    (A B' B : Type u) [CommRing A] [CommRing B'] [CommRing B]
    [IsNoetherianRing A] [IsNoetherianRing B]
    [Algebra A B'] [Algebra B' B] [Algebra A B] [IsScalarTower A B' B]
    [Algebra.FiniteType A B] [Algebra.QuasiFinite A B] [Module.Finite A B']
    {n : ℕ} (hn : 1 ≤ n) (h : MvPolynomial (Fin n) A)
    (f : Fin n → MvPolynomial (Fin n) A) (q : Localization.Away h →ₐ[A] B)
    (h_q : Function.Surjective q)
    (h_ker_q : RingHom.ker q.toRingHom =
      Ideal.span (Set.range fun i ↦
        algebraMap (MvPolynomial (Fin n) A) (Localization.Away h) (f i)))
    (h_open : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap B' B))))
    (τ : RelativeDualizingModule.of A B' B
      (Algebra.FiniteType.QuasiFinite.of_quasiFinite inferInstance) h_open)
    (hτ : @RelativeDualizingModule.TraceElement.IsUniversal A B' B _ _ _ _ _ _ _ _ _
      (RingHom.flat_algebraMap_iff.mp
        (syntomic hn h f q h_q h_ker_q).flat)
      (Algebra.FiniteType.QuasiFinite.of_quasiFinite inferInstance) _ h_open τ) :
    ∃ e : B ≃ₗ[B] RelativeDualizingModule.of A B' B
        (Algebra.FiniteType.QuasiFinite.of_quasiFinite inferInstance) h_open,
      e (q (algebraMap (MvPolynomial (Fin n) A) (Localization.Away h)
        (Matrix.det (fun i j ↦ MvPolynomial.pderiv j (f i))))) = τ := sorry

end Algebra.LocalizedPresentation
