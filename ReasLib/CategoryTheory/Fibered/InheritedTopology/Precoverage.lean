module

public import ReasLib.CategoryTheory.Fibered.InheritedPrecoverage.Morphism
public import ReasLib.CategoryTheory.Fibered.InheritedTopology
public import ReasLib.CategoryTheory.Sites.Topos.Cocontinuous
public import ReasLib.CategoryTheory.Sites.Topos.Continuous
import Mathlib.Tactic.CrossRefAttribute

/-!
# Topos morphisms from inherited precoverages

This module passes the coverwise API for a cartesian functor to the Grothendieck topologies
generated by an arbitrary precoverage.  It is the canonical owner of the induced morphism of
topoi and its comparison maps.  The common specialization through `J.toPrecoverage` is kept in
`InheritedTopology.Morphism`.
-/

@[expose] public section

noncomputable section

universe uC vC uS₁ vS₁ uS₂ vS₂ uA

namespace CategoryTheory

open Opposite

namespace CartesianBasedFunctor

variable {C : Type uC} [Category.{vC} C]
variable {S₁ : Type uS₁} {S₂ : Type uS₂}
variable [Category.{vS₁} S₁] [Category.{vS₂} S₂]
variable {p₁ : S₁ ⥤ C} {p₂ : S₂ ⥤ C}

namespace Inherited

/-- A cartesian functor is continuous for the topologies generated by the strongly-cartesian
lifts of a common precoverage. -/
@[stacks 06NW "precoverage-level continuity for inherited topologies"]
instance isContinuous
    (F : CartesianBasedFunctor p₁ p₂) (P : Precoverage C)
    [P.IsStableUnderBaseChange] [P.HasPullbacks] [p₁.IsFibered] [p₂.IsFibered] :
    F.toFunctor.IsContinuous
      (P.stronglyCartesianTopology p₁) (P.stronglyCartesianTopology p₂) :=
  Functor.Precoverage.IsContinuous.toGrothendieck

/-- A cartesian functor is cocontinuous for the topologies generated by the strongly-cartesian
lifts of a common precoverage. -/
@[stacks 06NW "precoverage-level cocontinuity for inherited topologies"]
instance isCocontinuous
    (F : CartesianBasedFunctor p₁ p₂) (P : Precoverage C)
    [P.HasPullbacks] [p₁.IsFibered] :
    F.toFunctor.IsCocontinuous
      (P.stronglyCartesianTopology p₁) (P.stronglyCartesianTopology p₂) :=
  Functor.Precoverage.HasCoverLifts.toCocontinuous
    (Precoverage.StronglyCartesianLift.hasCoverLifts P F)

/-- The morphism of sheaf topoi induced by a cartesian functor and a common precoverage on the
base.  Pullback assumptions are imposed only on covering families in `P`. -/
@[stacks 06NW "topos morphism from an inherited precoverage"]
noncomputable def morphismOfTopoi
    (F : CartesianBasedFunctor p₁ p₂) (P : Precoverage C)
    [P.HasPullbacks] [p₁.IsFibered]
    [HasSheafify (P.stronglyCartesianTopology p₁) (Type uA)]
    [∀ Q : S₁ᵒᵖ ⥤ Type uA, F.toFunctor.op.HasPointwiseRightKanExtension Q] :
    MorphismOfTopoiIn
      (P.stronglyCartesianTopology p₂) (P.stronglyCartesianTopology p₁) :=
  F.toFunctor.morphismOfTopoiInOfCocontinuous
    (P.stronglyCartesianTopology p₁) (P.stronglyCartesianTopology p₂)

namespace morphismOfTopoi

/-- The direct image of the inherited-precoverage topos morphism is the canonical
cocontinuous sheaf pushforward. -/
@[stacks 06NW "direct-image formula for an inherited precoverage", simp]
theorem pushforward_eq
    (F : CartesianBasedFunctor p₁ p₂) (P : Precoverage C)
    [P.HasPullbacks] [p₁.IsFibered]
    [HasSheafify (P.stronglyCartesianTopology p₁) (Type uA)]
    [∀ Q : S₁ᵒᵖ ⥤ Type uA, F.toFunctor.op.HasPointwiseRightKanExtension Q] :
    (morphismOfTopoi F P).pushforward =
      F.toFunctor.sheafPushforwardCocontinuous (Type uA)
        (P.stronglyCartesianTopology p₁) (P.stronglyCartesianTopology p₂) := rfl

/-- The inverse image of the inherited-precoverage topos morphism is the canonical
cocontinuous sheaf pullback. -/
@[stacks 06NW "inverse-image formula for an inherited precoverage", simp]
theorem inverseImage_eq
    (F : CartesianBasedFunctor p₁ p₂) (P : Precoverage C)
    [P.HasPullbacks] [p₁.IsFibered]
    [HasSheafify (P.stronglyCartesianTopology p₁) (Type uA)]
    [∀ Q : S₁ᵒᵖ ⥤ Type uA, F.toFunctor.op.HasPointwiseRightKanExtension Q] :
    (morphismOfTopoi F P).inverseImage =
      F.toFunctor.sheafPullbackCocontinuous (Type uA)
        (P.stronglyCartesianTopology p₁) (P.stronglyCartesianTopology p₂) := rfl

/-- The adjunction of the inherited-precoverage topos morphism is the canonical
cocontinuous pullback-pushforward adjunction. -/
@[stacks 06NW "adjunction formula for an inherited precoverage"]
theorem adjunction_eq
    (F : CartesianBasedFunctor p₁ p₂) (P : Precoverage C)
    [P.HasPullbacks] [p₁.IsFibered]
    [HasSheafify (P.stronglyCartesianTopology p₁) (Type uA)]
    [∀ Q : S₁ᵒᵖ ⥤ Type uA, F.toFunctor.op.HasPointwiseRightKanExtension Q] :
    (morphismOfTopoi F P).adjunction =
      F.toFunctor.sheafPullbackCocontinuousAdjunction
        (P.stronglyCartesianTopology p₁) (P.stronglyCartesianTopology p₂) := rfl

/-- The canonical comparison from the inherited-precoverage inverse image to continuous sheaf
pushforward along the total functor. -/
@[stacks 06NW "inherited-precoverage inverse-image comparison"]
noncomputable abbrev inverseImageComparison
    (F : CartesianBasedFunctor p₁ p₂) (P : Precoverage C)
    [P.IsStableUnderBaseChange] [P.HasPullbacks] [p₁.IsFibered] [p₂.IsFibered]
    [HasSheafify (P.stronglyCartesianTopology p₁) (Type uA)]
    [HasWeakSheafify (P.stronglyCartesianTopology p₂) (Type uA)]
    [∀ Q : S₁ᵒᵖ ⥤ Type uA, F.toFunctor.op.HasPointwiseRightKanExtension Q] :
    (morphismOfTopoi F P).inverseImage ⟶
      F.toFunctor.sheafPushforwardContinuous (Type uA)
        (P.stronglyCartesianTopology p₁) (P.stronglyCartesianTopology p₂) :=
  Functor.CocontinuousPullback.comparison.{uA} F.toFunctor
    (P.stronglyCartesianTopology p₁) (P.stronglyCartesianTopology p₂)

/-- The canonical inverse-image comparison for an inherited precoverage is invertible. -/
@[stacks 06NW "invertibility of the inherited-precoverage comparison", instance]
instance inverseImageComparison.isIso
    (F : CartesianBasedFunctor p₁ p₂) (P : Precoverage C)
    [P.IsStableUnderBaseChange] [P.HasPullbacks] [p₁.IsFibered] [p₂.IsFibered]
    [HasSheafify (P.stronglyCartesianTopology p₁) (Type uA)]
    [HasWeakSheafify (P.stronglyCartesianTopology p₂) (Type uA)]
    [∀ Q : S₁ᵒᵖ ⥤ Type uA, F.toFunctor.op.HasPointwiseRightKanExtension Q] :
    IsIso (inverseImageComparison F P) :=
  (Functor.CocontinuousPullback.comparisonIso.{uA} F.toFunctor
    (P.stronglyCartesianTopology p₁) (P.stronglyCartesianTopology p₂)).isIso_hom

/-- The objectwise inverse-image comparison induced by a common inherited precoverage. -/
@[stacks 06NW "objectwise inherited-precoverage comparison"]
noncomputable def inverseImageEvalComparison
    (F : CartesianBasedFunctor p₁ p₂) (P : Precoverage C)
    [P.IsStableUnderBaseChange] [P.HasPullbacks] [p₁.IsFibered] [p₂.IsFibered]
    [HasSheafify (P.stronglyCartesianTopology p₁) (Type uA)]
    [HasWeakSheafify (P.stronglyCartesianTopology p₂) (Type uA)]
    [∀ Q : S₁ᵒᵖ ⥤ Type uA, F.toFunctor.op.HasPointwiseRightKanExtension Q]
    (G : Sheaf (P.stronglyCartesianTopology p₂) (Type uA)) (x : S₁) :
    ((((morphismOfTopoi F P).inverseImage.obj G).obj.obj (op x))) ⟶
      G.obj.obj (op (F.toFunctor.obj x)) :=
  ((Functor.whiskerRight (inverseImageComparison F P)
      (sheafToPresheaf (P.stronglyCartesianTopology p₁) (Type uA))).app G).app (op x) ≫
    (F.toFunctor.sheafPushforwardContinuousObjObjIso (Type uA)
      (J := P.stronglyCartesianTopology p₁)
      (K := P.stronglyCartesianTopology p₂) G x).hom

/-- The objectwise inverse-image comparison for an inherited precoverage is invertible. -/
@[stacks 06NW "invertibility of the objectwise inherited-precoverage comparison", instance]
instance inverseImageEvalComparison.isIso
    (F : CartesianBasedFunctor p₁ p₂) (P : Precoverage C)
    [P.IsStableUnderBaseChange] [P.HasPullbacks] [p₁.IsFibered] [p₂.IsFibered]
    [HasSheafify (P.stronglyCartesianTopology p₁) (Type uA)]
    [HasWeakSheafify (P.stronglyCartesianTopology p₂) (Type uA)]
    [∀ Q : S₁ᵒᵖ ⥤ Type uA, F.toFunctor.op.HasPointwiseRightKanExtension Q]
    (G : Sheaf (P.stronglyCartesianTopology p₂) (Type uA)) (x : S₁) :
    IsIso (inverseImageEvalComparison F P G x) :=
  Iso.isIso_hom
    (((Functor.isoWhiskerRight
        (Functor.CocontinuousPullback.comparisonIso.{uA} F.toFunctor
          (P.stronglyCartesianTopology p₁) (P.stronglyCartesianTopology p₂))
        (sheafToPresheaf (P.stronglyCartesianTopology p₁) (Type uA))).app G).app (op x) ≪≫
      F.toFunctor.sheafPushforwardContinuousObjObjIso (Type uA)
        (J := P.stronglyCartesianTopology p₁)
        (K := P.stronglyCartesianTopology p₂) G x)

namespace inverseImageEvalIso

/-- Evaluate an explicitly supplied inverse of the inherited-precoverage comparison at a source
object.  The inverse data remain explicit rather than being selected from an `IsIso` proof. -/
@[stacks 06NW "explicit inherited-precoverage inverse-image evaluation isomorphism"]
noncomputable def ofComparison
    (F : CartesianBasedFunctor p₁ p₂) (P : Precoverage C)
    [P.IsStableUnderBaseChange] [P.HasPullbacks] [p₁.IsFibered] [p₂.IsFibered]
    [HasSheafify (P.stronglyCartesianTopology p₁) (Type uA)]
    [HasWeakSheafify (P.stronglyCartesianTopology p₂) (Type uA)]
    [∀ Q : S₁ᵒᵖ ⥤ Type uA, F.toFunctor.op.HasPointwiseRightKanExtension Q]
    (e : Functor.CocontinuousPullback.ComparisonIso.{uA} F.toFunctor
      (P.stronglyCartesianTopology p₁) (P.stronglyCartesianTopology p₂))
    (G : Sheaf (P.stronglyCartesianTopology p₂) (Type uA)) (x : S₁) :
    ((((morphismOfTopoi F P).inverseImage.obj G).obj.obj (op x))) ≅
      G.obj.obj (op (F.toFunctor.obj x)) :=
  ((Functor.isoWhiskerRight e.iso
      (sheafToPresheaf (P.stronglyCartesianTopology p₁) (Type uA))).app G).app (op x) ≪≫
    F.toFunctor.sheafPushforwardContinuousObjObjIso (Type uA)
      (J := P.stronglyCartesianTopology p₁)
      (K := P.stronglyCartesianTopology p₂) G x

namespace ofComparison

/-- The forward map of the explicitly supplied objectwise isomorphism is the canonical
objectwise inherited-precoverage comparison. -/
@[stacks 06NW "forward map of an explicit inherited-precoverage isomorphism"]
theorem hom
    (F : CartesianBasedFunctor p₁ p₂) (P : Precoverage C)
    [P.IsStableUnderBaseChange] [P.HasPullbacks] [p₁.IsFibered] [p₂.IsFibered]
    [HasSheafify (P.stronglyCartesianTopology p₁) (Type uA)]
    [HasWeakSheafify (P.stronglyCartesianTopology p₂) (Type uA)]
    [∀ Q : S₁ᵒᵖ ⥤ Type uA, F.toFunctor.op.HasPointwiseRightKanExtension Q]
    (e : Functor.CocontinuousPullback.ComparisonIso.{uA} F.toFunctor
      (P.stronglyCartesianTopology p₁) (P.stronglyCartesianTopology p₂))
    (G : Sheaf (P.stronglyCartesianTopology p₂) (Type uA)) (x : S₁) :
    (inverseImageEvalIso.ofComparison F P e G x).hom =
      inverseImageEvalComparison F P G x := by
  simp only [inverseImageEvalIso.ofComparison, inverseImageEvalComparison,
    Iso.trans_hom, Iso.app_hom, Functor.isoWhiskerRight_hom, e.hom_eq,
    inverseImageComparison]
  rfl

/-- Objectwise isomorphisms obtained from two explicit inverses of the same canonical
comparison agree. -/
@[stacks 06NW "uniqueness of explicit inherited-precoverage isomorphisms"]
theorem eq
    (F : CartesianBasedFunctor p₁ p₂) (P : Precoverage C)
    [P.IsStableUnderBaseChange] [P.HasPullbacks] [p₁.IsFibered] [p₂.IsFibered]
    [HasSheafify (P.stronglyCartesianTopology p₁) (Type uA)]
    [HasWeakSheafify (P.stronglyCartesianTopology p₂) (Type uA)]
    [∀ Q : S₁ᵒᵖ ⥤ Type uA, F.toFunctor.op.HasPointwiseRightKanExtension Q]
    (e e' : Functor.CocontinuousPullback.ComparisonIso.{uA} F.toFunctor
      (P.stronglyCartesianTopology p₁) (P.stronglyCartesianTopology p₂))
    (G : Sheaf (P.stronglyCartesianTopology p₂) (Type uA)) (x : S₁) :
    inverseImageEvalIso.ofComparison F P e G x =
      inverseImageEvalIso.ofComparison F P e' G x := by
  apply Iso.ext
  exact (hom F P e G x).trans (hom F P e' G x).symm

end ofComparison

end inverseImageEvalIso

end morphismOfTopoi

end Inherited

end CartesianBasedFunctor

end CategoryTheory
