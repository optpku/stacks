module

public import Mathlib.CategoryTheory.Sites.Descent.Precoverage
import Mathlib.Tactic.CrossRefAttribute

/-!
# Descent criteria for precoverage-presented sites

The prestack and stack conditions for a topology generated by a precoverage can be checked on
the selected covering families.  Unlike the existing ambient-category criterion, these
statements require pullbacks only for members of the precoverage.
-/

@[expose] public section

universe uC vC uF vF

namespace CategoryTheory

open Bicategory

namespace Precoverage

variable {C : Type uC} [Category.{vC} C]
variable (P : Precoverage C)
variable (F : Pseudofunctor (LocallyDiscrete Cᵒᵖ) Cat.{vF, uF})

/-- A pseudofunctor is a prestack for the topology generated by `P` when it satisfies descent
for every selected covering family.  No ambient `HasPullbacks C` instance is required. -/
@[stacks 04WC "prestack criterion for a precoverage"]
theorem isPrestack_toGrothendieck
    [P.HasIsos] [P.HasPullbacks] [P.IsStableUnderBaseChange]
    [P.IsStableUnderComposition]
    (hF : ∀ (S : C) (R : Presieve S), R ∈ P S → F.IsPrestackFor R) :
    F.IsPrestack P.toGrothendieck := sorry

/-- A pseudofunctor is a stack for the topology generated by `P` when it satisfies effective
descent for every selected covering family.  Pullbacks are required only along those families. -/
@[stacks 04WC "stack criterion for a precoverage"]
theorem isStack_toGrothendieck
    [P.HasIsos] [P.HasPullbacks] [P.IsStableUnderBaseChange]
    [P.IsStableUnderComposition]
    (hF : ∀ (S : C) (R : Presieve S), R ∈ P S → F.IsStackFor R) :
    F.IsStack P.toGrothendieck := sorry

end Precoverage

end CategoryTheory
