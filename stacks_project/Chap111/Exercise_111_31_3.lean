module

public import ReasLib.RingTheory.MvPolynomial.Cone
import StacksCheckRecall

/- Exercise 111.31.3 (1): if a prime `p ⊆ MvPolynomial (Fin n) ℂ` is generated by
homogeneous polynomials, then the affine variety `zeroLocus ℂ p` is a cone. -/
@[stacks 0E9F] #check (MvPolynomial.isCone_zeroLocus :
  ∀ {n : ℕ} (p : Ideal (MvPolynomial (Fin n) ℂ)), p.IsPrime →
    (∃ S : Set (MvPolynomial (Fin n) ℂ),
      (∀ f ∈ S, ∃ d, f.IsHomogeneous d) ∧ p = Ideal.span S) →
        MvPolynomial.IsCone (MvPolynomial.zeroLocus ℂ p))

/- Exercise 111.31.3 (2): conversely, if `zeroLocus ℂ p` is a cone then the prime `p`
corresponding to that affine variety is generated by homogeneous polynomials. -/
@[stacks 0E9F] #check (MvPolynomial.generatedByHomogeneous_of_isCone_zeroLocus :
  ∀ {n : ℕ} (p : Ideal (MvPolynomial (Fin n) ℂ)), p.IsPrime →
    MvPolynomial.IsCone (MvPolynomial.zeroLocus ℂ p) →
    ∃ S : Set (MvPolynomial (Fin n) ℂ),
      (∀ f ∈ S, ∃ d, f.IsHomogeneous d) ∧ p = Ideal.span S)

/- A prime ideal in `MvPolynomial (Fin n) ℂ` is generated by homogeneous polynomials if
and only if its zero locus is a cone. -/
#check (MvPolynomial.isCone_zeroLocus_iff_exists_span_isHomogeneous :
  ∀ {n : ℕ} (p : Ideal (MvPolynomial (Fin n) ℂ)), p.IsPrime →
    (MvPolynomial.IsCone (MvPolynomial.zeroLocus ℂ p) ↔
      ∃ S : Set (MvPolynomial (Fin n) ℂ),
        (∀ f ∈ S, ∃ d, f.IsHomogeneous d) ∧ p = Ideal.span S))
