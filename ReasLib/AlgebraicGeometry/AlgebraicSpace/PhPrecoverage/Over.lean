module

public import Mathlib.CategoryTheory.Sites.Over
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.PhPrecoverage.ChosenSite

/-!
# Localized ph topologies of algebraic spaces

The ph Grothendieck topology induces a topology on the category of algebraic
spaces over an algebraic space. Localizing any chosen big ph site gives the
same topology.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

/-- The Grothendieck topology on `Over X` induced by the ph topology on
algebraic spaces over `S`. -/
abbrev overPhTopology {S : Scheme.{u}} (X : AlgebraicSpace S) :
    GrothendieckTopology (Over X) :=
  (phPrecoverage : Precoverage (AlgebraicSpace S)).toGrothendieck.over X

/-- Localization of the topology generated by any chosen big ph site at `X`
agrees with the topology induced by the ambient ph precoverage. -/
theorem ChosenBigPhSite.over_eq {S : Scheme.{u}} (J : ChosenBigPhSite S)
    (X : AlgebraicSpace S) :
    J.toGrothendieck.over X = overPhTopology X :=
  sorry

end AlgebraicGeometry.AlgebraicSpace
