module

public import Mathlib.RingTheory.Localization.Away.Lemmas
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Idempotent localizations

This leaf records the map-level predicate for localization away from an
idempotent, together with finite-module transport to the canonical
complementary quotient.
@stack 0C2A
-/

universe u v

namespace RingHom

variable {R : Type u} {S : Type v} [CommSemiring R] [CommSemiring S]

/-- A ring homomorphism is an idempotent localization when it exhibits its target as the
localization of its source away from some idempotent. This map-level predicate avoids choosing
an `Algebra` instance merely to state the localization property. -/
@[stacks 0C2A "localization at an idempotent"]
def IsIdempotentLocalization (f : R →+* S) : Prop :=
  ∃ e : R, IsIdempotentElem e ∧ (Submonoid.powers e).IsLocalizationMap f

/-- The map-level idempotent-localization predicate agrees with the traditional
`IsLocalization.Away` formulation after installing the algebra structure induced by the map. -/
theorem isIdempotentLocalization_iff (f : R →+* S) :
    f.IsIdempotentLocalization ↔
      -- Local instance justification (defeq pin): this compatibility view
      -- must use precisely the algebra structure induced by `f`.
      letI : Algebra R S := f.toAlgebra
      ∃ e : R, IsIdempotentElem e ∧ IsLocalization.Away e S := sorry

end RingHom

namespace RingHom.IsIdempotentLocalization

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S]

/-- A surjective ring map whose kernel is generated by the complement of an
idempotent is localization away from that idempotent. -/
@[stacks 02FL "surjective kernel criterion"]
theorem of_surjective {f : R →+* S} {e : R}
    (he : IsIdempotentElem e)
    (hker : RingHom.ker f = Ideal.span {1 - e})
    (hf : Function.Surjective f) :
    f.IsIdempotentLocalization := sorry

end RingHom.IsIdempotentLocalization

namespace IsIdempotentElem

variable {R : Type u} {A : Type v} [CommRing R] [CommRing A] [Algebra R A]

/-- If the localization of an algebra away from an idempotent is finite over the base,
then the quotient by the complementary idempotent is finite over the base. -/
@[stacks 00UK "finite idempotent quotient"]
theorem moduleFinite_quotientOneSub {e : A} (he : IsIdempotentElem e)
    [Module.Finite R (Localization.Away e)] :
    Module.Finite R (A ⧸ Ideal.span ({1 - e} : Set A)) := sorry

end IsIdempotentElem
