module

public import Mathlib.RingTheory.Nullstellensatz
public import Mathlib.Data.Complex.Basic

@[expose] public section

open MvPolynomial

namespace MvPolynomial

/-- The vanishing ideal of a point `α : Fin n → ℂ` is generated by the coordinate differences
`X i - C (α i)`. -/
theorem vanishingIdeal_singleton_eq_span_range_X_sub_C {n : ℕ} (α : Fin n → ℂ) :
    vanishingIdeal ℂ {α} = Ideal.span (Set.range fun i ↦ X i - C (α i)) := sorry

/-- Every maximal ideal of `MvPolynomial (Fin n) ℂ` is generated by coordinate differences at a
point of `ℂ`. -/
theorem eq_span_X_sub_C_of_isMaximal
    {n : ℕ} (m : Ideal (MvPolynomial (Fin n) ℂ)) [m.IsMaximal] :
    ∃ α : Fin n → ℂ, m = Ideal.span (Set.range fun i ↦ X i - C (α i)) := sorry

end MvPolynomial
