module

public import ReasLib.AlgebraicTopology.SimplicialObject.Skeleton.Subcomplex
import StacksCheckRecall

/-!
@stack 018P
-/

@[expose] public section

open CategoryTheory
open scoped Simplicial

noncomputable section

universe u

namespace SSet

variable (n : ℕ) (U : SSet.{u})

/- Lemma 14.21.5 (018P): the counit identifies the simplicial `n`-skeleton with the subcomplex
generated by simplices in degrees at most `n`. -/
@[stacks 018P]
#check (skAdj.counit.range n U :
  Subcomplex.range ((skAdj n).counit.app U) = U.skeleton (n + 1))

/- The canonical objectwise comparison is over `U`, with no repeated proof argument. -/
#check (skeleton.isoApp n U : (sk n).obj U ≅ (U.skeleton (n + 1) : SSet))

/- The objectwise comparison is compatible with the ambient inclusion. -/
#check (skeleton.isoApp.hom_comp_ι n U :
  (skeleton.isoApp n U).hom ≫ (U.skeleton (n + 1)).ι = (skAdj n).counit.app U)

/- The comparisons assemble into a reusable natural isomorphism. -/
#check (skeleton.iso n : sk n ≅ skeleton.functor (n + 1))
#check (skeleton.iso.hom_ι n :
  (skeleton.iso n).hom ≫ skeleton.ι (n + 1) = (skAdj n).counit)

end SSet
