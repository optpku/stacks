module

public import Mathlib.CategoryTheory.Comma.Over.Basic
public import Mathlib.Data.Set.Lattice
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.FiniteLocallyFree.Rank
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.LocalGeneration
public import stacks_project.Chap67.Lemma_67_28_8_FinitePresentation
public import stacks_project.Chap71.Lemma_71_2_1_Pullback
public import stacks_project.Chap71.Lemma_71_5_6_Locus

/-!
# Lemma 71.5.6

Fitting closed subspaces of a finite-type quasi-coherent module on an algebraic
space have empty intersection, represent local generation and fixed-rank
conditions on scheme pullbacks, and are of finite presentation when the module
is.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.AlgebraicSpace

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

/-- Lemma 71.5.6 (1): the Fitting closed subspaces `Z_r` of a finite-type
quasi-coherent module have empty intersection in `|X|`. -/
@[stacks 0CZ9]
theorem fittingClosedSubspace_pointsSet_iInter_eq_empty
    {S : Scheme.{u}} {X : AlgebraicSpace S} (F : X.Modules)
    [F.IsFiniteType] [F.IsQuasicoherent] :
    (⋂ r : ℕ, (fittingClosedSubspace F r).pointsSet) = (∅ : Set (Points X)) :=
  sorry

/-- Lemma 71.5.6 (2): the open subspace `X \ Z_r` represents the functor sending
a scheme `T` over `X` to a point if `F_T` is locally generated by `r` sections,
and to empty otherwise. -/
@[stacks 0CZ9]
theorem fittingOpenComplement_nonempty_over_hom_iff_isLocallyGeneratedBy
    {S : Scheme.{u}} {X : AlgebraicSpace S} {T : Over S}
    (g : ofOver T ⟶ X) (F : X.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (r : ℕ) :
    Subsingleton (Over.mk g ⟶ Over.mk (fittingOpenComplement F r).ι) ∧
      (Nonempty (Over.mk g ⟶ Over.mk (fittingOpenComplement F r).ι) ↔
        SheafOfModules.IsLocallyGeneratedBy (Modules.pullbackToScheme g F) r) :=
  sorry

/-- Lemma 71.5.6 (3): the locally closed subspace `Z_{r-1} \ Z_r` represents the
functor sending a scheme `T` over `X` to a point if `F_T` is finite locally free
of rank `r`, and to empty otherwise. -/
@[stacks 0CZ9]
theorem fittingRankLocus_nonempty_over_hom_iff_isFiniteLocallyFreeOfRank
    {S : Scheme.{u}} {X : AlgebraicSpace S} {T : Over S}
    (g : ofOver T ⟶ X) (F : X.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (r : ℕ) :
    Subsingleton (Over.mk g ⟶ Over.mk (fittingRankLocus F r).ι) ∧
      (Nonempty (Over.mk g ⟶ Over.mk (fittingRankLocus F r).ι) ↔
        SheafOfModules.IsFiniteLocallyFreeOfRank r
          (Modules.pullbackToScheme g F)) :=
  sorry

/-- Lemma 71.5.6 (4): if `F` is of finite presentation, then `Z_r ⟶ X` is of
finite presentation. -/
@[stacks 0CZ9, instance]
instance fittingClosedSubspace_finitePresentation {S : Scheme.{u}}
    {X : AlgebraicSpace S} (F : X.Modules) [F.IsFinitePresentation] (r : ℕ) :
    FinitePresentation (fittingClosedSubspace F r).ι :=
  sorry

/-- Lemma 71.5.6 (5): if `F` is of finite presentation, then `X \ Z_r ⟶ X` is of
finite presentation. -/
@[stacks 0CZ9, instance]
instance fittingOpenComplement_finitePresentation {S : Scheme.{u}}
    {X : AlgebraicSpace S} (F : X.Modules) [F.IsFinitePresentation] (r : ℕ) :
    FinitePresentation (fittingOpenComplement F r).ι :=
  sorry

/-- Lemma 71.5.6 (6): if `F` is of finite presentation, then
`Z_{r-1} \ Z_r ⟶ X` is of finite presentation. -/
@[stacks 0CZ9, instance]
instance fittingRankLocus_finitePresentation {S : Scheme.{u}}
    {X : AlgebraicSpace S} (F : X.Modules) [F.IsFinitePresentation] (r : ℕ) :
    FinitePresentation (fittingRankLocus F r).ι :=
  sorry

end AlgebraicGeometry.AlgebraicSpace
