module

public import Mathlib.Algebra.Homology.DerivedCategory.HomologySequence
public import Mathlib.Algebra.Homology.DerivedCategory.TStructure
public import ReasLib.CategoryTheory.DerivedCategory.Bounded
public import ReasLib.CategoryTheory.Pretriangulated.Extension
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Derived-Category Membership in Extension Stages

This leaf contains the genuinely derived-category consequences of the generic
additive extension-stage API.  The definitions of interval and extension stages
themselves live in `ReasLib.CategoryTheory.Pretriangulated.Extension`.
-/

open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.ObjectProperty
open CategoryTheory.Pretriangulated
open DerivedCategory
open DerivedCategory.TStructure

universe w v u

noncomputable section

namespace DerivedCategory

variable {A : Type u} [Category.{v} A] [Abelian A] [HasDerivedCategory.{w} A]

namespace IntervalExtension

/-- The derived-category interval extension stage generated by an object property in the
underlying abelian category. -/
abbrev stage (E : ObjectProperty A) (a b : ℤ) :
    ObjectProperty (DerivedCategory A) :=
  ObjectProperty.additiveExtensionStage
    ((E.map (singleFunctor A (0 : ℤ)))[a, b])
    (Nat.succPNat (Int.toNat (b - a)))

/-- Cohomology supported in `[a, b]` with values in `E` puts a derived object in the associated
interval extension stage. -/
@[stacks 0FX7]
theorem mem_of_homology (E : ObjectProperty A)
    (K : DerivedCategory A) (a b : ℤ) (hGE : K.IsGE a) (hLE : K.IsLE b)
    (hE : ∀ i : Set.Icc a b, E ((homologyFunctor A i.1).obj K)) :
    stage E a b K := sorry

/-- A bounded cochain-complex representative whose terms lie in `E` puts its derived object in
the associated interval extension stage. -/
@[stacks 0FX7]
theorem mem_of_representative (E : ObjectProperty A)
    (K : DerivedCategory A) (a b : ℤ)
    (hK :
      ∃ (L : CochainComplex A ℤ) (e : Q.obj L ≅ K),
        L.IsStrictlyGE a ∧ L.IsStrictlyLE b ∧ ∀ i : Set.Icc a b, E (L.X i)) :
    stage E a b K := sorry

namespace Closure

/-- The cohomological interval-stage criterion with membership only in the retract closure of
the additive closure of `E`. -/
@[stacks 0FX7]
theorem mem_of_homology (E : ObjectProperty A)
    (K : DerivedCategory A) (a b : ℤ) (hGE : K.IsGE a) (hLE : K.IsLE b)
    (hE : ∀ i : Set.Icc a b,
      E.additiveClosure.retractClosure ((homologyFunctor A i.1).obj K)) :
    stage E a b K := sorry

/-- The representative-side interval-stage criterion with terms in the retract closure of the
additive closure of `E`. -/
@[stacks 0FX7]
theorem mem_of_representative
    (E : ObjectProperty A) (K : DerivedCategory A) (a b : ℤ)
    (hK :
      ∃ (L : CochainComplex A ℤ) (e : Q.obj L ≅ K),
        L.IsStrictlyGE a ∧ L.IsStrictlyLE b ∧
          ∀ i : Set.Icc a b, E.additiveClosure.retractClosure (L.X i)) :
    stage E a b K := sorry

end Closure

end IntervalExtension

end DerivedCategory
