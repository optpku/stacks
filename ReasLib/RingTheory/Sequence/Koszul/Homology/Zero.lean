module

public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Sequence.Koszul.Homology.First

/-!
# Zeroth homology of a finite-family Koszul complex

The zeroth object is owned categorically as the cokernel of the outgoing differential in the
low-degree chain model.  Quotient presentations can be supplied as separate comparison APIs.
@stack 062E
-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory.Limits

namespace KoszulComplex.Homology.H0

variable {R : Type u} [CommRing R] {n : ℕ}

/-- The zeroth Koszul homology object of a finite family with coefficients in `N`. -/
@[stacks 062E "zeroth Koszul homology"]
abbrev obj (f : Fin n → R) (N : Type u) [AddCommGroup N] [Module R N] : ModuleCat R :=
  cokernel (KoszulComplex.Homology.H1.model f N).g

/-- For regular coefficients, the range of the outgoing differential is the ideal generated by
the finite family. -/
theorem range_linearCombination (f : Fin n → R) :
    LinearMap.range (KoszulComplex.Homology.H1.linearCombination f R) =
      Ideal.span (Set.range f) := sorry

/-- Zeroth Koszul homology with regular coefficients is canonically the quotient by the ideal
generated by the family. -/
@[stacks 062E "quotient presentation of zeroth Koszul homology"]
noncomputable def presentationIso (f : Fin n → R) :
    obj f R ≅ ModuleCat.of R (R ⧸ Ideal.span (Set.range f)) :=
  ModuleCat.cokernelIsoRangeQuotient
      (ModuleCat.ofHom (KoszulComplex.Homology.H1.linearCombination f R)) ≪≫
    (Submodule.quotEquivOfEq _ _ (range_linearCombination f)).toModuleIso

end KoszulComplex.Homology.H0
