module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Algebra.MvPolynomial.Rename
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.Data.Nat.Prime.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import ReasLib.AlgebraicGeometry.Scheme.OverField
public import ReasLib.AlgebraicGeometry.Scheme.Variety
public import ReasLib.AlgebraicGeometry.Scheme.Variety.AffinePresentation
public import ReasLib.AlgebraicGeometry.Scheme.Variety.Curve

/-!
# The affine plane curve `y ^ ℓ = x * (x - 1) ^ 3`

This module constructs the affine hypersurface `y ^ ℓ = x * (x - 1) ^ 3` in
`AffineSpaceOverField k 2`, as a scheme over `k`, together with the closed
immersion into affine 2-space.
-/

@[expose] public section

noncomputable section

universe u

open AlgebraicGeometry CategoryTheory MvPolynomial

namespace AlgebraicGeometry.AffineSuperelliptic

/-- The plane equation `X 1 ^ ℓ - X 0 * (X 0 - 1) ^ 3` in `k[x, y]`. -/
def relation (k : Type u) [Field k] (ℓ : ℕ) : MvPolynomial (Fin 2) k :=
  X 1 ^ ℓ - X 0 * (X 0 - 1) ^ 3

/-- The defining equation is `X 1 ^ ℓ - X 0 * (X 0 - 1) ^ 3`. -/
theorem relation_eq (k : Type u) [Field k] (ℓ : ℕ) :
    relation k ℓ = X 1 ^ ℓ - X 0 * (X 0 - 1) ^ 3 := sorry

/-- The principal relation ideal of the affine plane curve. -/
def relationIdeal (k : Type u) [Field k] (ℓ : ℕ) : Ideal (MvPolynomial (Fin 2) k) :=
  Ideal.span {relation k ℓ}

/-- The relation ideal is generated by `relation k ℓ`. -/
theorem relationIdeal_eq_span (k : Type u) [Field k] (ℓ : ℕ) :
    relationIdeal k ℓ = Ideal.span {relation k ℓ} := sorry

/-- The coordinate ring `k[x, y] ⧸ (y ^ ℓ - x * (x - 1) ^ 3)`. -/
abbrev CoordinateRing (k : Type u) [Field k] (ℓ : ℕ) : Type u :=
  MvPolynomial (Fin 2) k ⧸ relationIdeal k ℓ

/-- The coordinate ring is the displayed principal quotient. -/
theorem coordinateRing_eq (k : Type u) [Field k] (ℓ : ℕ) :
    CoordinateRing k ℓ = (MvPolynomial (Fin 2) k ⧸ Ideal.span {relation k ℓ}) := sorry

/-- The class of the first coordinate, corresponding to the source variable `x`. -/
def coordX (k : Type u) [Field k] (ℓ : ℕ) : CoordinateRing k ℓ :=
  Ideal.Quotient.mk (relationIdeal k ℓ) (X 0)

/-- The class of the second coordinate, corresponding to the source variable `y`. -/
def coordY (k : Type u) [Field k] (ℓ : ℕ) : CoordinateRing k ℓ :=
  Ideal.Quotient.mk (relationIdeal k ℓ) (X 1)

/-- `coordX` is the quotient class of `X 0`. -/
theorem coordX_eq_mk (k : Type u) [Field k] (ℓ : ℕ) :
    coordX k ℓ = Ideal.Quotient.mk (relationIdeal k ℓ) (X 0) := sorry

/-- `coordY` is the quotient class of `X 1`. -/
theorem coordY_eq_mk (k : Type u) [Field k] (ℓ : ℕ) :
    coordY k ℓ = Ideal.Quotient.mk (relationIdeal k ℓ) (X 1) := sorry

/-- The two coordinates satisfy `coordY ^ ℓ = coordX * (coordX - 1) ^ 3`. -/
theorem coordY_pow_eq (k : Type u) [Field k] (ℓ : ℕ) :
    coordY k ℓ ^ ℓ = coordX k ℓ * (coordX k ℓ - 1) ^ 3 := sorry

/-- The coordinate ring is an integral domain when `ℓ` is prime and invertible in `k`. -/
instance instIsDomain_coordinateRing (k : Type u) [Field k] (ℓ : ℕ)
    [Fact ℓ.Prime] [NeZero (ℓ : k)] : IsDomain (CoordinateRing k ℓ) := sorry

/-- The affine scheme `Spec (k[x, y] ⧸ (y ^ ℓ - x * (x - 1) ^ 3)`. -/
def scheme (k : Type u) [Field k] (ℓ : ℕ) : Scheme.{u} :=
  Spec (CommRingCat.of (CoordinateRing k ℓ))

/-- The affine curve is the spectrum of its coordinate ring. -/
theorem scheme_eq (k : Type u) [Field k] (ℓ : ℕ) :
    scheme k ℓ = Spec (CommRingCat.of (CoordinateRing k ℓ)) := sorry

/-- The structure morphism to `Spec k` induced by `algebraMap k (CoordinateRing k ℓ)`. -/
def toBase (k : Type u) [Field k] (ℓ : ℕ) :
    scheme k ℓ ⟶ Spec (CommRingCat.of k) :=
  Spec.map (CommRingCat.ofHom (algebraMap k (CoordinateRing k ℓ)))

/-- The structure morphism is `Spec.map` of the coefficient algebra map. -/
theorem toBase_eq (k : Type u) [Field k] (ℓ : ℕ) :
    toBase k ℓ = Spec.map (CommRingCat.ofHom (algebraMap k (CoordinateRing k ℓ))) := sorry

/-- The affine plane curve as a scheme over the field `k`. -/
def over (k : Type u) [Field k] (ℓ : ℕ) : SchemeOverField k :=
  Over.mk (toBase k ℓ)

/-- The underlying scheme of `over k ℓ` is `scheme k ℓ`. -/
theorem over_left_eq_scheme (k : Type u) [Field k] (ℓ : ℕ) :
    (over k ℓ).left = scheme k ℓ := sorry

/-- The affine plane curve is an integral scheme when `ℓ` is prime and invertible in `k`. -/
instance instIsIntegral_scheme (k : Type u) [Field k] (ℓ : ℕ)
    [Fact ℓ.Prime] [NeZero (ℓ : k)] : IsIntegral (scheme k ℓ) := sorry

/-- The affine plane curve is a variety over `k` when `ℓ` is prime and invertible in `k`. -/
instance instVariety_over (k : Type u) [Field k] (ℓ : ℕ)
    [Fact ℓ.Prime] [NeZero (ℓ : k)] : Variety (over k ℓ) := sorry

/-- The affine plane curve is a curve over `k` when `ℓ` is prime and invertible in `k`. -/
instance instCurve_over (k : Type u) [Field k] (ℓ : ℕ)
    [Fact ℓ.Prime] [NeZero (ℓ : k)] : Curve (over k ℓ) := sorry

/-- The closed immersion of the affine plane curve into affine 2-space over `k`. -/
def ι (k : Type u) [Field k] (ℓ : ℕ) : scheme k ℓ ⟶ AffineSpaceOverField k 2 :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (relationIdeal k ℓ))) ≫
    Spec.map (CommRingCat.ofHom
      (MvPolynomial.renameEquiv k
        (Equiv.ulift : ULift.{u} (Fin 2) ≃ Fin 2)).toRingEquiv.toRingHom) ≫
    (AffineSpace.SpecIso (ULift.{u} (Fin 2)) (CommRingCat.of.{u} k)).inv

/-- The morphism `ι` is a closed immersion. -/
instance instIsClosedImmersion_ι (k : Type u) [Field k] (ℓ : ℕ) :
    IsClosedImmersion (ι k ℓ) := sorry

/-- The closed immersion `ι` presents the affine curve in `AffineSpaceOverField k 2`. -/
theorem isAffineSpacePresentation_ι (k : Type u) [Field k] (ℓ : ℕ) :
    IsAffineSpacePresentation (over k ℓ) 2 (ι k ℓ) := sorry

end AlgebraicGeometry.AffineSuperelliptic
