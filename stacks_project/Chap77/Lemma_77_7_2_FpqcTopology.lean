module

public import Mathlib.AlgebraicGeometry.Sites.Fpqc
public import Mathlib.CategoryTheory.Sites.Over
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import stacks_project.Chap77.«77_7_1_1_IsomorphismFunctor»

/-!
# Fpqc site of schemes over an algebraic space

The fpqc covering families of schemes over an algebraic space `B` are the
families whose images under the forgetful functor to schemes over `S` cover
for `Scheme.fpqcTopology.over S`.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.SchemeOver

/-- The fpqc precoverage on schemes over an algebraic space `B`: a family covers
if its image under the forgetful functor to schemes over `S` covers for
`Scheme.fpqcTopology.over S`. -/
def fpqcPrecoverage {S : Scheme.{u}} (B : AlgebraicSpace S) :
    Precoverage (SchemeOver B) :=
  (Scheme.fpqcTopology.over S).toPrecoverage.comap
    (CostructuredArrow.proj (ofOverFunctor S) B)

/-- The fpqc Grothendieck topology on the category of schemes over an algebraic
space `B`. -/
def fpqcTopology {S : Scheme.{u}} (B : AlgebraicSpace S) :
    GrothendieckTopology (SchemeOver B) :=
  (fpqcPrecoverage B).toGrothendieck

/-- The fpqc topology of `SchemeOver B` is generated by `fpqcPrecoverage B`. -/
theorem fpqcTopology_def {S : Scheme.{u}} (B : AlgebraicSpace S) :
    fpqcTopology B = (fpqcPrecoverage B).toGrothendieck :=
  sorry

/-- A displayed family in `SchemeOver B` is an fpqc covering if and only if the
underlying family of schemes over `S` covers for `Scheme.fpqcTopology.over S`. -/
theorem ofArrows_mem_fpqcPrecoverage_iff {S : Scheme.{u}} {B : AlgebraicSpace S}
    {ι : Type u} {U : SchemeOver B} {V : ι → SchemeOver B}
    {f : ∀ i, V i ⟶ U} :
    Presieve.ofArrows V f ∈ fpqcPrecoverage B U ↔
      Presieve.ofArrows (fun i ↦ (V i).left) (fun i ↦ (f i).left) ∈
        (Scheme.fpqcTopology.over S).toPrecoverage U.left :=
  sorry

end AlgebraicGeometry.AlgebraicSpace.SchemeOver
