module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Quasicoherent
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Free.Generated

/-!
# Presentations of Free Sheaves of Modules

Reusable bridges between free sheaves, families of global generators, and
Mathlib's `SheafOfModules.Presentation` owner.
-/

@[expose] public section

open CategoryTheory Limits

universe u v w u' v'

namespace SheafOfModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable {𝒪 : Sheaf J RingCat.{w}}
variable [HasWeakSheafify J AddCommGrpCat.{w}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- A sheaf of `𝒪`-modules has a global presentation when it admits
`SheafOfModules.Presentation` data. -/
@[stacks 03DE "(6)"]
abbrev HasGlobalPresentation (ℱ : SheafOfModules.{w} 𝒪) : Prop :=
  Nonempty ℱ.Presentation

/-- A sheaf of `𝒪`-modules has a finite global presentation when it admits a presentation
with finite families of generators and relations. -/
@[stacks 03DE "(7)"]
abbrev HasFiniteGlobalPresentation (ℱ : SheafOfModules.{w} 𝒪) : Prop :=
  Nonempty {P : ℱ.Presentation // P.IsFinite}

/-- The tautological sections of a free sheaf correspond to its identity morphism. -/
lemma free_tautological_sections_symm (I : Type w) :
    (free (R := 𝒪) I).freeHomEquiv.symm (freeSection (R := 𝒪)) =
      𝟙 (free (R := 𝒪) I) := sorry

/-- The morphism induced by the tautological sections of a free sheaf is an epimorphism. -/
lemma free_tautological_sections_epi (I : Type w) :
    Epi ((free (R := 𝒪) I).freeHomEquiv.symm (freeSection (R := 𝒪))) := sorry

/-- An epimorphism from a free sheaf transports a generating family to its target. -/
lemma nonempty_generatingSections_of_epi_free
    {I : Type w} {ℱ : SheafOfModules.{w} 𝒪} (π : free I ⟶ ℱ) [Epi π] :
    Nonempty ℱ.GeneratingSections := sorry

/-- Reindexing a generating family by `ULift (Fin r)` yields generation by `r` sections. -/
lemma isGeneratedBy_of_generatingSections_equiv_ulift_fin
    {ℱ : SheafOfModules.{w} 𝒪} {σ : ℱ.GeneratingSections} {r : ℕ}
    (e : σ.I ≃ ULift.{w} (Fin r)) :
    IsGeneratedBy ℱ r := sorry

/-- Every finite type is equivalent to `ULift (Fin r)` for some `r`. -/
lemma equiv_ulift_fin_of_finite (I : Type w) [Finite I] :
    ∃ r : ℕ, Nonempty (I ≃ ULift.{w} (Fin r)) := sorry

/-- A sheaf is generated by `r` sections exactly when it has a generating family indexed by a
type equivalent to `ULift (Fin r)`. -/
theorem isGeneratedBy_iff_nonempty_generatingSections_equiv_fin
    (ℱ : SheafOfModules.{w} 𝒪) (r : ℕ) :
    IsGeneratedBy ℱ r ↔
      Nonempty {σ : ℱ.GeneratingSections // Nonempty (σ.I ≃ ULift.{w} (Fin r))} := sorry

/-- A sheaf is finitely globally generated exactly when it has a finite-type family of global
generating sections. -/
theorem isFiniteGloballyGenerated_iff_nonempty_finiteGeneratingSections
    (ℱ : SheafOfModules.{w} 𝒪) :
    IsFiniteGloballyGenerated ℱ ↔
      Nonempty {σ : ℱ.GeneratingSections // σ.IsFiniteType} := sorry

/-- A free sheaf has its tautological family of global generating sections. -/
instance free_generatingSections (I : Type w) :
    Nonempty (free I : SheafOfModules.{w} 𝒪).GeneratingSections := sorry

/-- A free sheaf has a global presentation. -/
instance free_hasGlobalPresentation (I : Type w) :
    HasGlobalPresentation (free I : SheafOfModules.{w} 𝒪) := sorry

/-- A finite free sheaf has a finite global presentation. -/
instance free_hasFiniteGlobalPresentation (I : Type w) [Finite I] :
    HasFiniteGlobalPresentation (free I : SheafOfModules.{w} 𝒪) := sorry

/-- A finite global presentation may be forgotten to a global presentation. -/
instance HasFiniteGlobalPresentation.hasGlobalPresentation
    (ℱ : SheafOfModules.{w} 𝒪) [HasFiniteGlobalPresentation ℱ] :
    HasGlobalPresentation ℱ := sorry

namespace Presentation

variable {ℱ : SheafOfModules.{w} 𝒪}

section Map

variable {D : Type u'} [Category.{v'} D] {K : GrothendieckTopology D}
variable {𝒮 : Sheaf K RingCat.{w}}
variable [HasSheafify J AddCommGrpCat.{w}]
variable [HasSheafify K AddCommGrpCat.{w}]
variable [K.WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- Mapping a finite presentation through a colimit-preserving functor which preserves the
structure module leaves its generator and relation index types finite. -/
@[stacks 03DE "finite presentation under a colimit-preserving functor"]
instance map_isFinite
    (P : ℱ.Presentation) [P.IsFinite]
    (F : SheafOfModules.{w} 𝒪 ⥤ SheafOfModules.{w} 𝒮)
    [PreservesColimitsOfSize.{w, w} F]
    (η : unit 𝒮 ≅ F.obj (unit 𝒪)) :
    (P.map F η).IsFinite := sorry

end Map

/-- The quasicoherent data canonically built from a finite global presentation is locally
finitely presented. -/
@[stacks 03DE "finite global presentation data"]
instance quasicoherentData_isFinitePresentation
    [HasBinaryProducts C]
    [HasSheafify J AddCommGrpCat.{w}]
    [∀ U : C, HasSheafify (J.over U) AddCommGrpCat.{w}]
    [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (P : ℱ.Presentation) [P.IsFinite] :
    P.quasicoherentData.IsFinitePresentation := sorry

/-- A finite global presentation determines Mathlib's local finite-presentation predicate. -/
@[stacks 03DE "finite global presentation is locally finite"]
theorem isFinitePresentation
    [HasBinaryProducts C]
    [HasSheafify J AddCommGrpCat.{w}]
    [∀ U : C, HasSheafify (J.over U) AddCommGrpCat.{w}]
    [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (P : ℱ.Presentation) [P.IsFinite] :
    ℱ.IsFinitePresentation := sorry

/-- The relation morphism associated to a presentation, from the free sheaf on the chosen
relations to the free sheaf on the chosen generators. -/
@[stacks 03DE "relation morphism"]
noncomputable def relationMap (P : ℱ.Presentation) :
    free (R := 𝒪) P.relations.I ⟶ free (R := 𝒪) P.generators.I :=
  P.relations.π ≫ kernel.ι P.generators.π

/-- The relation morphism of a presentation composes trivially with its generator map. -/
@[reassoc (attr := simp)]
theorem relationMap_comp_generators (P : ℱ.Presentation) :
    P.relationMap ≫ P.generators.π = 0 := sorry

/-- The generator map of a presentation is a cokernel of its relation morphism. -/
@[stacks 03DE "presentation as a cokernel"]
noncomputable def isColimitRelationMap (P : ℱ.Presentation)
    [HasSheafify J AddCommGrpCat.{w}] :
    IsColimit
      (CokernelCofork.ofπ P.generators.π P.relationMap_comp_generators) :=
  P.isColimit

/-- The inclusion of one basis vector into the free sheaf on the relations of a presentation. -/
noncomputable abbrev basisInclusion (P : ℱ.Presentation) (i : P.relations.I) :
    unit 𝒪 ⟶ free (R := 𝒪) P.relations.I :=
  ιFree (R := 𝒪) i

/-- A chosen basis relation, viewed as a morphism from the structure module to the free sheaf on
the generators. -/
noncomputable def basisRelation (P : ℱ.Presentation) (i : P.relations.I) :
    unit 𝒪 ⟶ free (R := 𝒪) P.generators.I :=
  P.basisInclusion i ≫ P.relationMap

/-- Each basis relation composes trivially with the generator map. -/
@[reassoc (attr := simp)]
theorem basisRelation_comp_generators (P : ℱ.Presentation) (i : P.relations.I) :
    P.basisRelation i ≫ P.generators.π = 0 := sorry

/-- A morphism out of the generator free sheaf kills the relation morphism exactly when it kills
every chosen basis relation. -/
theorem relationMap_comp_eq_zero_iff (P : ℱ.Presentation)
    {M : SheafOfModules.{w} 𝒪} (f : free (R := 𝒪) P.generators.I ⟶ M) :
    P.relationMap ≫ f = 0 ↔ ∀ i : P.relations.I, P.basisRelation i ≫ f = 0 := sorry

end Presentation

/-- A module sheaf admitting a finite global presentation is finitely presented. -/
@[stacks 03DE "finite global presentation instance"]
instance isFinitePresentation_of_hasFiniteGlobalPresentation
    [HasBinaryProducts C]
    [HasSheafify J AddCommGrpCat.{w}]
    [∀ U : C, HasSheafify (J.over U) AddCommGrpCat.{w}]
    [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (ℱ : SheafOfModules.{w} 𝒪) [HasFiniteGlobalPresentation ℱ] :
    ℱ.IsFinitePresentation := sorry

variable [HasBinaryProducts C]
variable [HasSheafify J AddCommGrpCat.{w}]
variable [∀ U : C, HasSheafify (J.over U) AddCommGrpCat.{w}]
variable [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]

variable (I : Type w) [Finite I]

end SheafOfModules
