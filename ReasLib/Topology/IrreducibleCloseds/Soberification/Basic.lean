module

public import Mathlib.Topology.Sober
public import Mathlib.Tactic.CrossRefAttribute

/-!
# The Soberification by Irreducible Closed Subsets

This module puts the canonical soberification topology on Mathlib's existing
`IrreducibleCloseds X` carrier and records its basis and frame-level API.
-/

@[expose] public section

universe u

open Set TopologicalSpace

variable {X : Type u} [TopologicalSpace X]

namespace IrreducibleCloseds

/-- The basic open of the soberification attached to an open subset `U ⊆ X` consists of the
irreducible closed subsets of `X` that meet `U`. -/
def basicOpen (U : Opens X) : Set (IrreducibleCloseds X) :=
  {Z | ((Z : Set X) ∩ (U : Set X)).Nonempty}

/-- The soberification topology on `IrreducibleCloseds X`, generated by the opens which record
whether an irreducible closed subset meets a given open subset of `X`. -/
instance soberificationTopologicalSpace : TopologicalSpace (IrreducibleCloseds X) :=
  generateFrom (Set.range fun U : Opens X ↦ basicOpen U)

/-- The basic soberification open attached to the total open subset is the whole carrier. -/
theorem basicOpen_top : basicOpen (⊤ : Opens X) = (Set.univ : Set (IrreducibleCloseds X)) := sorry

/-- The basic-open construction is monotone in the source open subset. -/
theorem basicOpen_mono {U V : Opens X} (hUV : U ≤ V) :
    basicOpen U ⊆ basicOpen V := sorry

/-- Basic soberification opens preserve binary intersections. -/
theorem basicOpen_inf (U V : Opens X) :
    basicOpen (U ⊓ V) = basicOpen U ∩ basicOpen V := sorry

/-- Basic soberification opens preserve arbitrary unions. -/
theorem basicOpen_sSup (S : Set (Opens X)) :
    basicOpen (sSup S) = ⋃ U ∈ S, basicOpen U := sorry

end IrreducibleCloseds

/-- The pointwise map sending `x` to the irreducible closed subset `closure {x}`. -/
def toIrreducibleClosedsFun (x : X) : IrreducibleCloseds X :=
  ⟨closure ({x}), isIrreducible_singleton.closure, isClosed_closure⟩

/-- Pulling a basic soberification open back along `x ↦ closure {x}` recovers its source open. -/
@[simp]
theorem preimage_basicOpen_toIrreducibleClosedsFun (U : Opens X) :
    (toIrreducibleClosedsFun ⁻¹' IrreducibleCloseds.basicOpen U) = (U : Set X) := sorry

/-- The pointwise map to irreducible point closures is continuous. -/
theorem continuous_toIrreducibleClosedsFun :
    Continuous (toIrreducibleClosedsFun : X → IrreducibleCloseds X) := sorry

/-- The canonical continuous map from a space to the soberification carried by
its irreducible closed subsets. -/
@[stacks 0A2N "the soberification map"]
def toIrreducibleCloseds : C(X, IrreducibleCloseds X) :=
  ⟨toIrreducibleClosedsFun, continuous_toIrreducibleClosedsFun⟩

/-- The irreducible closed subset represented by a point is its singleton closure. -/
@[simp]
theorem coe_toIrreducibleCloseds (x : X) :
    (toIrreducibleCloseds x : Set X) = closure ({x} : Set X) := sorry

/-- The irreducible point closure of `x` lies below an irreducible closed subset exactly when
that subset contains `x`. -/
@[simp]
theorem toIrreducibleCloseds_le_iff_mem {x : X} {Z : IrreducibleCloseds X} :
    toIrreducibleCloseds x ≤ Z ↔ x ∈ Z := sorry

/-- Every point belongs to the irreducible closed subset represented by its point closure. -/
@[simp]
theorem mem_toIrreducibleCloseds (x : X) : x ∈ toIrreducibleCloseds x := sorry

/-- A specialization induces reverse inclusion on irreducible point closures. -/
theorem Specializes.toIrreducibleCloseds_le {x y : X} (hxy : x ⤳ y) :
    toIrreducibleCloseds y ≤ toIrreducibleCloseds x := sorry

/-- Reverse inclusion between irreducible point closures is exactly specialization of the
representing points. -/
theorem toIrreducibleCloseds_le_iff_specializes {x y : X} :
    toIrreducibleCloseds y ≤ toIrreducibleCloseds x ↔ x ⤳ y := sorry

/-- The canonical map to irreducible point closures identifies exactly inseparable points. -/
theorem toIrreducibleCloseds_eq_iff_inseparable {x y : X} :
    toIrreducibleCloseds x = toIrreducibleCloseds y ↔ Inseparable x y := sorry

/-- The quotient map from a space to its Kolmogorov reflection, bundled as a continuous map. -/
def SeparationQuotient.mkContinuous : C(X, SeparationQuotient X) :=
  ⟨SeparationQuotient.mk, SeparationQuotient.continuous_mk⟩

/-- The map to irreducible point closures descends continuously along the Kolmogorov
reflection. -/
theorem SeparationQuotient.continuous_toIrreducibleCloseds :
    Continuous
      (SeparationQuotient.lift (toIrreducibleCloseds : X → IrreducibleCloseds X)
        (fun _ _ hxy ↦ toIrreducibleCloseds_eq_iff_inseparable.2 hxy)) := sorry

/-- The point-closure map descended from a space to its Kolmogorov reflection. -/
noncomputable def SeparationQuotient.toIrreducibleCloseds :
    C(SeparationQuotient X, IrreducibleCloseds X) :=
  ⟨SeparationQuotient.lift _root_.toIrreducibleCloseds
      (fun _ _ hxy ↦ toIrreducibleCloseds_eq_iff_inseparable.2 hxy),
    SeparationQuotient.continuous_toIrreducibleCloseds⟩

/-- Composing the descended point-closure map with the quotient map recovers the original
point-closure map. -/
@[simp]
theorem SeparationQuotient.toIrreducibleCloseds_comp_mk :
    (SeparationQuotient.toIrreducibleCloseds (X := X)).comp
        (SeparationQuotient.mkContinuous (X := X)) =
      _root_.toIrreducibleCloseds := sorry

/-- The canonical basic opens form a topological basis on `IrreducibleCloseds X`. -/
theorem isTopologicalBasis_basicOpen :
    IsTopologicalBasis (Set.range fun U : Opens X ↦ IrreducibleCloseds.basicOpen U) := sorry

/-- Every open of the soberification is a basic open coming from a unique open subset of `X`. -/
theorem isOpen_iff_exists_basicOpen {s : Set (IrreducibleCloseds X)} :
    IsOpen s ↔ ∃ U : Opens X, s = IrreducibleCloseds.basicOpen U := sorry

namespace IrreducibleCloseds

/-- The basic subset associated to an open subset of `X` is open in the soberification. -/
theorem isOpen_basicOpen (U : Opens X) : IsOpen (basicOpen U) := sorry

/-- The basic soberification open, bundled as an element of `Opens`. -/
def basicOpenOpens (U : Opens X) : Opens (IrreducibleCloseds X) :=
  ⟨basicOpen U, isOpen_basicOpen U⟩

/-- The underlying set of a bundled basic soberification open. -/
@[simp]
theorem coe_basicOpenOpens (U : Opens X) :
    (basicOpenOpens U : Set (IrreducibleCloseds X)) = basicOpen U := sorry

/-- Bundled basic soberification opens preserve the total open. -/
theorem basicOpenOpens_top : basicOpenOpens (⊤ : Opens X) = ⊤ := sorry

/-- Bundled basic soberification opens preserve binary intersections. -/
theorem basicOpenOpens_inf (U V : Opens X) :
    basicOpenOpens (U ⊓ V) = basicOpenOpens U ⊓ basicOpenOpens V := sorry

/-- Bundled basic soberification opens preserve arbitrary unions. -/
theorem basicOpenOpens_sSup (S : Set (Opens X)) :
    basicOpenOpens (sSup S) = sSup (basicOpenOpens '' S) := sorry

/-- Sending an open subset to the corresponding soberification basic open is a frame
homomorphism. -/
def basicOpenFrameHom : FrameHom (Opens X) (Opens (IrreducibleCloseds X)) where
  toFun := basicOpenOpens
  map_top' := basicOpenOpens_top
  map_inf' := basicOpenOpens_inf
  map_sSup' := basicOpenOpens_sSup

/-- Pulling a soberification basic open back to `X` recovers the original open. -/
@[simp]
theorem comap_basicOpenFrameHom (U : Opens X) :
    Opens.comap toIrreducibleCloseds (basicOpenFrameHom U) = U := sorry

/-- Every soberification open is recovered from its inverse image in `X`. -/
@[simp]
theorem basicOpenFrameHom_comap (V : Opens (IrreducibleCloseds X)) :
    basicOpenFrameHom (Opens.comap toIrreducibleCloseds V) = V := sorry

/-- The basic-open frame homomorphism reflects inclusion. -/
theorem basicOpenFrameHom_le_iff {U V : Opens X} :
    basicOpenFrameHom U ≤ basicOpenFrameHom V ↔ U ≤ V := sorry

/-- Opens of `X` are canonically order-isomorphic to opens of its soberification. -/
def opensOrderIso : Opens X ≃o Opens (IrreducibleCloseds X) where
  toFun := basicOpenFrameHom
  invFun := Opens.comap toIrreducibleCloseds
  left_inv := comap_basicOpenFrameHom
  right_inv := basicOpenFrameHom_comap
  map_rel_iff' := basicOpenFrameHom_le_iff

end IrreducibleCloseds

/-- Inverse image along the soberification map is a bijection on opens. -/
@[stacks 0A2N "bijection and frame operations on opens"]
theorem toIrreducibleCloseds_opensComap_bijective :
    Function.Bijective
      (Opens.comap (toIrreducibleCloseds : C(X, IrreducibleCloseds X))) := sorry

/-- The soberification carried by irreducible closed subsets is quasi-sober. -/
instance IrreducibleCloseds.quasiSoberSoberification : QuasiSober (IrreducibleCloseds X) := sorry

/-- The soberification carried by irreducible closed subsets is Kolmogorov. -/
instance IrreducibleCloseds.t0SpaceSoberification : T0Space (IrreducibleCloseds X) := sorry
