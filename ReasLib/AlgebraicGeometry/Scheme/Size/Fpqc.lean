module

public import ReasLib.AlgebraicGeometry.Scheme.Size
public import Mathlib.AlgebraicGeometry.Sites.Fpqc

@[expose] public section

noncomputable section

universe u v

open AlgebraicGeometry CategoryTheory
open scoped Cardinal AlgebraicGeometry

namespace AlgebraicGeometry.Scheme

/-- An fpqc covering of a scheme whose arrows factor through a morphism bounds the
size of the target by the size of the source. -/
theorem size_le_of_fpqcCovering_factors {X Y : Scheme.{u}} (f : X ⟶ Y) {ι : Type v}
    (Yj : ι → Scheme.{u}) (g : (j : ι) → Yj j ⟶ Y)
    (hg : Presieve.ofArrows Yj g ∈ fpqcPrecoverage Y)
    (hfactor : ∀ j, ∃ h : Yj j ⟶ X, h ≫ f = g j) :
    Y.size ≤ X.size := sorry

/-- A fixed-target fpqc cover whose arrows factor through a morphism bounds the
size of the target by the size of the source. -/
theorem size_le_of_fpqcCover_factors {X Y : Scheme.{u}} (f : X ⟶ Y)
    (𝒰 : Y.Cover.{v} fpqcPrecoverage)
    (hfactor : ∀ j, ∃ h : 𝒰.X j ⟶ X, h ≫ f = 𝒰.f j) :
    Y.size ≤ X.size := sorry

/-- If the sieve generated by a morphism is fpqc-covering, the target has size
at most the size of the source. -/
theorem size_le_of_generateSingleton_mem_fpqcTopology {X Y : Scheme.{u}} (f : X ⟶ Y)
    (hf : Sieve.generateSingleton f ∈ fpqcTopology Y) :
    Y.size ≤ X.size := sorry

/-- A flat, surjective, quasi-compact morphism bounds the size of its target by
the size of its source. -/
theorem size_le_of_flat_surjective_quasiCompact {X Y : Scheme.{u}} (f : X ⟶ Y)
    [Flat f] [Surjective f] [QuasiCompact f] :
    Y.size ≤ X.size := sorry

end AlgebraicGeometry.Scheme
