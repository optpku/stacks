module

public import Mathlib.Data.Fin.Embedding
public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Determinantal Ideals of Matrices

This module owns the determinantal ideal generated by fixed-size minors of a
matrix.  It is independent of the later module-presentation applications.
@stack 07Z7
-/

universe u v w

namespace Matrix

variable {R : Type u} [CommRing R]

/-- The ideal generated by the determinants of the `r × r` submatrices of `A`.
It has the usual conventions for empty minors and for unavailable minors. -/
@[stacks 07Z7 "ideal generated by matrix minors"]
def minorIdeal {ι : Type v} {κ : Type w} (r : ℕ) (A : Matrix ι κ R) : Ideal R :=
  Ideal.span <| Set.range fun p : (Fin r ↪ ι) × (Fin r ↪ κ) ↦
    (A.submatrix p.1 p.2).det

/-! Textbook notation for `Matrix.minorIdeal`. -/
notation:max "I_(" r:max ")(" A:arg ")" => minorIdeal r A

/-- A specified `r × r` minor belongs to the ideal generated by all such minors. -/
theorem det_submatrix_mem_minorIdeal {ι : Type v} {κ : Type w}
    (r : ℕ) (A : Matrix ι κ R) (e₁ : Fin r ↪ ι) (e₂ : Fin r ↪ κ) :
    (A.submatrix e₁ e₂).det ∈ I_(r)(A) := sorry

/-- Applying a ring homomorphism coefficientwise to a matrix commutes with forming its
determinantal ideal. -/
theorem minorIdeal_map
    {S : Type*} [CommRing S] (σ : R →+* S) {ι : Type v} {κ : Type w}
    (r : ℕ) (A : Matrix ι κ R) :
    Ideal.map σ (minorIdeal r A) = minorIdeal r (A.map σ) := sorry

end Matrix
