module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.FinitePresentation
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Free.Basic
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Stalk
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Neighborhood freeness of finitely presented module sheaves

This file owns the sheaf-level form of the finite-presentation criterion that promotes a finite
free stalk to a finite free restriction on a neighborhood.  The canonical owner is stated for an
arbitrary RingCat-valued sheaf.  The `CommRing` namespace retains the commutative-ring stalk model
used by ringed-space APIs; it is a genuine bridge because that bundled stalk is not
definitionally the generic RingCat stalk.
-/

@[expose] public section

open CategoryTheory TopologicalSpace

noncomputable section

universe u

namespace SheafOfModules.IsFinitePresentation

variable {X : TopCat.{u}} {R : X.Sheaf RingCat.{u}}

/-- A finitely presented module sheaf with a stalk freely
generated by a finite type `I` is free on `I` after restriction to some neighborhood. -/
@[stacks 0B8J "finite basis, arbitrary ring-sheaf owner"]
theorem existsNeighborhoodFreeOfStalkIso
    (F : SheafOfModules R) [F.IsFinitePresentation]
    (x : X) (I : Type u) [Finite I]
    (h : Nonempty
      ((SheafOfModules.stalkFunctor R x).obj F ≅
        (ModuleCat.free (R.presheaf.stalk x)).obj I)) :
    ∃ (U : Opens X) (_ : x ∈ U),
      Nonempty
        (F.over U ≅
          (SheafOfModules.free I : SheafOfModules (R.over U))) := sorry

/-- A finitely presented module sheaf whose stalk
is free of rank `r` is free of rank `r` after restriction to some neighborhood. -/
@[stacks 0B8J "finite rank, arbitrary ring-sheaf owner"]
theorem existsNeighborhoodFreeOfStalkIsoFin
    (F : SheafOfModules R) [F.IsFinitePresentation]
    (x : X) (r : ℕ)
    (h : Nonempty
      ((SheafOfModules.stalkFunctor R x).obj F ≅
        ModuleCat.freeFin (R.presheaf.stalk x) r)) :
    ∃ (U : Opens X) (_ : x ∈ U),
      Nonempty
        (F.over U ≅
          (SheafOfModules.freeFin r : SheafOfModules (R.over U))) := sorry

namespace CommRing

variable {𝒪 : X.Sheaf CommRingCat.{u}}

/-- A finitely presented module sheaf with a
commutative-ring stalk freely generated by a finite type `I` is free on `I` on a neighborhood. -/
@[stacks 0B8J "commutative-ring stalk bridge"]
theorem existsNeighborhoodFreeOfStalkIso
    (F : SheafOfModules (TopCat.Sheaf.ringSheafOfComm 𝒪)) [F.IsFinitePresentation]
    (x : X) (I : Type u) [Finite I]
    (h : Nonempty
      ((SheafOfModules.stalkFunctorOfCommRing 𝒪 x).obj F ≅
        (ModuleCat.free (𝒪.presheaf.stalk x)).obj I)) :
    ∃ (U : Opens X) (_ : x ∈ U),
      Nonempty
        (F.over U ≅
          (SheafOfModules.free I :
            SheafOfModules ((TopCat.Sheaf.ringSheafOfComm 𝒪).over U))) := sorry

/-- A finitely presented module sheaf
whose commutative-ring stalk is free of rank `r` is free of rank `r` on a neighborhood. -/
@[stacks 0B8J "finite-rank commutative-ring stalk bridge"]
theorem existsNeighborhoodFreeOfStalkIsoFin
    (F : SheafOfModules (TopCat.Sheaf.ringSheafOfComm 𝒪)) [F.IsFinitePresentation]
    (x : X) (r : ℕ)
    (h : Nonempty
      ((SheafOfModules.stalkFunctorOfCommRing 𝒪 x).obj F ≅
        ModuleCat.freeFin (𝒪.presheaf.stalk x) r)) :
    ∃ (U : Opens X) (_ : x ∈ U),
      Nonempty
        (F.over U ≅
          (SheafOfModules.freeFin r :
            SheafOfModules ((TopCat.Sheaf.ringSheafOfComm 𝒪).over U))) := sorry

end CommRing

end SheafOfModules.IsFinitePresentation
