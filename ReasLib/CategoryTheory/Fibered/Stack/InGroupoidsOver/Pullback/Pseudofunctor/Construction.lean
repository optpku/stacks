module

public import ReasLib.CategoryTheory.Bicategory.FullSubbicategory.Pseudofunctor
public import ReasLib.CategoryTheory.Fibered.Groupoids.Pullback.Pseudofunctor.Construction
public import ReasLib.CategoryTheory.Fibered.Stack.InGroupoidsOver
public import ReasLib.CategoryTheory.Fibered.Stack.Pullback.Pseudofunctor.Construction
import Mathlib.Tactic.CrossRefAttribute

/-!
# Construction of fixed-base pullback for stacks in groupoids

The neutral groupoid-fibred pullback pseudofunctor is precomposed with the canonical forgetful
pseudofunctor from stacks in groupoids. Continuity and pullback preservation prove that every image
object is a stack on the source site; the generic full-subbicategory lift then supplies all
non-Prop action and coherence data without rebuilding them.
-/

@[expose] public section

noncomputable section

universe uC uD uS vC vD vS

namespace CategoryTheory

open Bicategory Limits ObjectProperty
open scoped Bicategory

variable {C : Type uC} {D : Type uD}
variable [Category.{vC} C] [Category.{vD} D]

namespace StackOver.Groupoids.Pullback

/-- The groupoid-fibred-category-valued action underlying fixed-base pullback of stacks in
groupoids. -/
@[stacks 04WD "ambient fixed-base pullback pseudofunctor on groupoid stacks"]
noncomputable def ambient (K : GrothendieckTopology D) (u : C ⥤ D) :
    Pseudofunctor
      (StackOver.Groupoids.{uD, vD, uS, vS} K)
      (FiberedCategoryOver.Groupoids.{uC, vC,
        max uC (max uS vD), max vC vS} C) :=
  (StackOver.Groupoids.forget K).toPseudofunctor.comp
    (FiberedCategoryOver.Groupoids.Pullback.pseudofunctor u)

/-- Every object in the groupoid-fibred pullback image is a stack in groupoids for the topology
generated by the source precoverage. -/
@[stacks 04WD "precoverage groupoid-stack closure under fixed-base pullback"]
theorem ambient.isStackOnPrecoverage
    (P : Precoverage C) (Q : Precoverage D) (u : C ⥤ D)
    [P.HasIsos] [P.HasPullbacks] [P.IsStableUnderBaseChange]
    [P.IsStableUnderComposition]
    [Functor.Precoverage.IsContinuous u P Q]
    (T : StackOver.Groupoids.{uD, vD, uS, vS} Q.toGrothendieck) :
    IsStack.InGroupoids.objectProperty P.toGrothendieck
      ((ambient Q.toGrothendieck u).obj T) := sorry

/-- Pullback as a pseudofunctor on stacks in groupoids presented by source and target
precoverages. -/
@[stacks 04WD "pullback pseudofunctor for precoverage-presented groupoid stacks"]
noncomputable def pseudofunctorOfPrecoverage
    (P : Precoverage C) (Q : Precoverage D) (u : C ⥤ D)
    [P.HasIsos] [P.HasPullbacks] [P.IsStableUnderBaseChange]
    [P.IsStableUnderComposition]
    [Functor.Precoverage.IsContinuous u P Q] :
    Pseudofunctor
      (StackOver.Groupoids.{uD, vD, uS, vS} Q.toGrothendieck)
      (StackOver.Groupoids.{uC, vC,
        max uC (max uS vD), max vC vS} P.toGrothendieck) :=
  ObjectProperty.FullSubbicategory.liftPseudofunctor
    (ambient Q.toGrothendieck u) (ambient.isStackOnPrecoverage P Q u)

/-- Every object in the ambient pullback image satisfies the stack condition on the source site.
The continuity and pullback-preservation hypotheses are used only in this Prop-valued closure
statement. -/
@[stacks 04WD "groupoid-stack closure under fixed-base pullback"]
theorem ambient.isStackOnSite
    (J : GrothendieckTopology C) (K : GrothendieckTopology D) (u : C ⥤ D)
    [HasPullbacks C] [PreservesLimitsOfShape WalkingCospan u] [u.IsContinuous J K]
    (T : StackOver.Groupoids.{uD, vD, uS, vS} K) :
    IsStack.InGroupoids.objectProperty J ((ambient K u).obj T) := sorry

/-- Pullback along `u` as the canonical pseudofunctor from stacks in groupoids over `(D, K)` to
stacks in groupoids over `(C, J)`. All non-Prop action and comparison data come from the neutral
groupoid-fibred pullback pseudofunctor. -/
@[stacks 04WD "fixed-base pullback pseudofunctor on groupoid stacks"]
noncomputable def pseudofunctor
    (J : GrothendieckTopology C) (K : GrothendieckTopology D) (u : C ⥤ D)
    [HasPullbacks C] [PreservesLimitsOfShape WalkingCospan u] [u.IsContinuous J K] :
    Pseudofunctor
      (StackOver.Groupoids.{uD, vD, uS, vS} K)
      (StackOver.Groupoids.{uC, vC,
        max uC (max uS vD), max vC vS} J) :=
  ObjectProperty.FullSubbicategory.liftPseudofunctor
    (ambient K u) (ambient.isStackOnSite J K u)

end StackOver.Groupoids.Pullback

namespace StackOver.Groupoids

/-- The stack in groupoids obtained by pullback along a functor continuous for selected
precoverages. -/
@[stacks 04WD "pullback of a precoverage-presented groupoid stack"]
noncomputable abbrev pullbackOfPrecoverage
    (P : Precoverage C) {Q : Precoverage D} (u : C ⥤ D)
    (T : StackOver.Groupoids.{uD, vD, uS, vS} Q.toGrothendieck)
    [P.HasIsos] [P.HasPullbacks] [P.IsStableUnderBaseChange]
    [P.IsStableUnderComposition]
    [Functor.Precoverage.IsContinuous u P Q] :
    StackOver.Groupoids.{uC, vC,
      max uC (max uS vD), max vC vS} P.toGrothendieck :=
  (Pullback.pseudofunctorOfPrecoverage P Q u).obj T

/-- Lemma 8.12.3 (tag 04WD): the bundled stack in groupoids obtained by pulling back along a
continuous pullback-preserving functor. This is the object action of the fixed-base pullback
pseudofunctor. -/
@[stacks 04WD]
noncomputable def pullback
    {J : GrothendieckTopology C} {K : GrothendieckTopology D}
    (u : C ⥤ D) (T : StackOver.Groupoids.{uD, vD, uS, vS} K)
    [HasPullbacks C] [PreservesLimitsOfShape WalkingCospan u] [u.IsContinuous J K] :
    StackOver.Groupoids.{uC, vC,
      max uC (max uS vD), max vC vS} J :=
  (Pullback.pseudofunctor J K u).obj T

end StackOver.Groupoids

end CategoryTheory
