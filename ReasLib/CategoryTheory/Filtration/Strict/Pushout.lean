module

public import ReasLib.CategoryTheory.Filtration.Strict.Abelian
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Pushouts of Filtered Objects

Pushouts are modeled on the ambient pushout, with each filtration stage generated by the images
of the corresponding stages of the two source objects.  The resulting global `HasPushout`
instance lets downstream files use Mathlib's standard `pushout`, `pushout.inl`, and `pushout.inr`
API directly.
-/

@[expose] public section

open CategoryTheory Limits

universe v u

noncomputable section

namespace CategoryTheory.FilteredObject.Hom

open FilteredObject

variable {C : Type u} [Category.{v} C] [Abelian C]
variable {A B D : FilteredObject C}

namespace Pushout

/-- The explicit filtered pushout model on the ambient pushout object, with each stage
generated by the two source filtration stages. -/
def model (f : A ⟶ B) (g : A ⟶ D) : FilteredObject C where
  obj := pushout f.hom g.hom
  filtration :=
    { toFun := fun p ↦ imageSubobject (biprod.desc
        ((B.filtration p).arrow ≫ pushout.inl f.hom g.hom)
        ((D.filtration p).arrow ≫ pushout.inr f.hom g.hom))
      monotone' := sorry }

/-- The left leg into the explicit filtered pushout model. -/
def inl (f : A ⟶ B) (g : A ⟶ D) : B ⟶ model f g where
  hom := pushout.inl f.hom g.hom
  preserves := sorry

/-- The right leg into the explicit filtered pushout model. -/
def inr (f : A ⟶ B) (g : A ⟶ D) : D ⟶ model f g where
  hom := pushout.inr f.hom g.hom
  preserves := sorry

/-- The two legs of the explicit model commute with the given span. -/
theorem condition (f : A ⟶ B) (g : A ⟶ D) :
    f ≫ inl f g = g ≫ inr f g := sorry

/-- The explicit filtered pushout model with its two structure morphisms. -/
def cocone (f : A ⟶ B) (g : A ⟶ D) : PushoutCocone f g :=
  PushoutCocone.mk (inl f g) (inr f g) (condition f g)

/-- The map out of the explicit filtered pushout is the ambient pushout descent map. -/
def desc (f : A ⟶ B) (g : A ⟶ D) (s : PushoutCocone f g) : model f g ⟶ s.pt where
  hom := pushout.desc s.inl.hom s.inr.hom
    (congrArg (fun k : A ⟶ s.pt ↦ k.hom) s.condition)
  preserves := sorry

/-- The explicit filtered pushout cocone has the ambient universal descent maps. -/
def isColimit (f : A ⟶ B) (g : A ⟶ D) : IsColimit (cocone f g) :=
  PushoutCocone.IsColimit.mk (condition f g) (desc f g) sorry sorry sorry

/-- The explicit filtered pushout model satisfies the pushout universal property. -/
theorem isPushout (f : A ⟶ B) (g : A ⟶ D) :
    IsPushout f g (inl f g) (inr f g) :=
  IsPushout.of_isColimit (isColimit f g)

end Pushout

/-- Filtered objects in an abelian category have pushouts. -/
noncomputable instance hasPushout (f : A ⟶ B) (g : A ⟶ D) : HasPushout f g :=
  (Pushout.isPushout f g).hasPushout

namespace Pushout

/-- The explicit filtered pushout model has the chosen ambient pushout as its underlying object. -/
@[simp]
theorem obj (f : A ⟶ B) (g : A ⟶ D) :
    (model f g).obj = pushout f.hom g.hom := rfl

/-- Each stage of the explicit model is the image of the sum of the two source stages. -/
theorem filtration_eq_image (f : A ⟶ B) (g : A ⟶ D) (p : ℤ) :
    (model f g).filtration p =
      imageSubobject (biprod.desc
        ((B.filtration p).arrow ≫ pushout.inl f.hom g.hom)
        ((D.filtration p).arrow ≫ pushout.inr f.hom g.hom)) := rfl

/-- The explicit model's left leg has the ambient pushout inclusion as its underlying map. -/
@[simp]
theorem inl_hom (f : A ⟶ B) (g : A ⟶ D) :
    (inl f g).hom = pushout.inl f.hom g.hom := rfl

/-- The explicit model's right leg has the ambient pushout inclusion as its underlying map. -/
@[simp]
theorem inr_hom (f : A ⟶ B) (g : A ⟶ D) :
    (inr f g).hom = pushout.inr f.hom g.hom := rfl

/-- Forgetting the canonical filtered pushout gives an ambient pushout square. -/
theorem forget_isPushout (f : A ⟶ B) (g : A ⟶ D) :
    IsPushout f.hom g.hom (pushout.inl f g).hom (pushout.inr f g).hom := sorry

/-- The right leg of the canonical filtered pushout is monic when the underlying left leg is
monic. -/
instance mono_inr (f : A ⟶ B) (g : A ⟶ D) [Mono f.hom] :
    Mono (pushout.inr f g) := sorry

end Pushout

/-- In any pushout square of filtered objects, pushing out a strict left leg produces a strict
right leg. -/
@[stacks 05SM]
theorem strict_inr_of_isPushout_of_strict
    {f : A ⟶ B} {g : A ⟶ D} {P : FilteredObject C} {g' : B ⟶ P} {f' : D ⟶ P}
    (sq : IsPushout f g g' f') (hf : Strict f) : Strict f' := sorry

/-- In the canonical pushout square, the pushout of a strict morphism is strict. -/
@[stacks 05SM]
theorem strict_pushout_inr_of_strict (f : A ⟶ B) (g : A ⟶ D) (hf : Strict f) :
    Strict (pushout.inr f g : D ⟶ pushout f g) := sorry

end CategoryTheory.FilteredObject.Hom
