module

public import ReasLib.RingTheory.RingHom.ShiftPower.Spectrum
import StacksCheckRecall

/-!
# Shift-power maps and universal homeomorphisms

@stack 09EF
-/

@[expose] public section

/- Lemma 10.46.11: let `f : R →+* S` have locally nilpotent kernel and suppose that `S` is
generated by elements satisfying a positive shifted-power relation over `R`. Then
`Spec S → Spec R` is a homeomorphism, the induced residue-field maps are purely inseparable,
and both hypotheses persist after arbitrary base change. The following shared owners record the
source conclusions and their base-change forms. -/

@[stacks 09EF "homeomorphism on spectra"]
#check @RingHom.ShiftPower.Spectrum.isHomeomorph_comap

@[stacks 09EF "purely inseparable residue fields"]
#check @RingHom.ShiftPower.Spectrum.residueField_isPurelyInseparable

@[stacks 09EF "base-changed generation"]
#check @RingHom.ShiftPower.BaseChange.isGenerated

@[stacks 09EF "base-changed locally nilpotent kernel"]
#check @RingHom.ShiftPower.Spectrum.BaseChange.ker_isLocallyNilpotent

@[stacks 09EF "base-changed homeomorphism on spectra"]
#check @RingHom.ShiftPower.Spectrum.BaseChange.isHomeomorph_comap

@[stacks 09EF "base-changed purely inseparable residue fields"]
#check @RingHom.ShiftPower.Spectrum.BaseChange.residueField_isPurelyInseparable

/- The shifted-power generation hypothesis also supplies the integrality step used in the source
proof. -/
@[stacks 09EF "integrality"]
#check @RingHom.ShiftPower.isIntegral
