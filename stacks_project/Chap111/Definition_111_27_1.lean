module

public import ReasLib.RingTheory.GradedAlgebra.Homogeneous.Ideal
import StacksCheckRecall

@[expose] public section

section

variable {R : Type*} [CommRing R]
variable (grading : ℕ → AddSubmonoid R) [GradedRing grading] (ideal : Ideal R)

/- Definition 111.27.1: for a graded ring `𝒜`, a homogeneous ideal is an ideal that is also a
graded submodule of `𝒜`. This is the bundled owner `HomogeneousIdeal 𝒜`, equivalently
`HomogeneousSubmodule 𝒜 𝒜`, and equivalently the unbundled predicate `Ideal.IsHomogeneous`.
Equivalently, it is an ideal generated by homogeneous elements, or an ideal closed under all
homogeneous components. -/
@[stacks 0281] #check
  (Ideal.isHomogeneous_iff_exists_homogeneous_span grading ideal :
    ideal.IsHomogeneous grading ↔
      ∃ generators : Set R,
        (∀ element ∈ generators, SetLike.IsHomogeneousElem grading element) ∧
          Ideal.span generators = ideal)

#check (HomogeneousIdeal grading : Type _)
#check (HomogeneousSubmodule grading grading : Type _)
#check
  (Ideal.IsHomogeneous.mem_iff (𝒜 := grading) :
    ∀ (_ : ideal.IsHomogeneous grading) {element : R},
      element ∈ ideal ↔
        ∀ degree, (DirectSum.decompose grading element degree : R) ∈ ideal)

end

end
