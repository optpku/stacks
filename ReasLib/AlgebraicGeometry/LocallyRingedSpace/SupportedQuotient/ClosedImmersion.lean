module

public import ReasLib.AlgebraicGeometry.LocallyRingedSpace.ClosedSubspace.Basic
public import ReasLib.AlgebraicGeometry.LocallyRingedSpace.SupportedQuotient
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Closed immersions from supported quotients

The unconditional closed-embedding, local-surjectivity, and kernel-identification API is owned by
the base `SupportedQuotient` module. This leaf contains only the upgrade that requires local
generation of the quotient kernel and its associated-closed-subspace consequence.
-/

@[expose] public section

open AlgebraicGeometry
open CategoryTheory CategoryTheory.Limits
open SheafOfModules.RingedSite

noncomputable section

universe u

namespace AlgebraicGeometry.LocallyRingedSpace.SupportedQuotient

/-- Local generation of the quotient kernel gives local generation of the inclusion kernel. -/
@[stacks 01HM "supported quotient kernel local generation"]
theorem ι_kernel_isLocallyGenerated
    {X : LocallyRingedSpace.{u}} (Q : Presentation X)
    (hker : SheafOfModules.IsLocallyGeneratedBySections
      (KernelIdeal.sheaf.{u, u, u} Q.projection)) :
    SheafOfModules.IsLocallyGeneratedBySections
      (Hom.kernelIdealSheaf (ι Q)) := sorry

/-- Example 26.4.3: a supported quotient inclusion is a closed immersion when its kernel ideal
is locally generated by sections. -/
@[stacks 01HM]
instance ι_isClosedImmersion
    {X : LocallyRingedSpace.{u}} (Q : Presentation X)
    [SheafOfModules.IsLocallyGeneratedBySections
      (KernelIdeal.sheaf.{u, u, u} Q.projection)] :
    IsClosedImmersion (ι Q) := sorry

/-- Example 26.4.3 (01HM): the supported quotient is the closed subspace associated to the
kernel ideal subobject of its quotient map. -/
@[stacks 01HM "supported quotient as an associated closed subspace"]
theorem ι_isAssociated
    {X : LocallyRingedSpace.{u}} (Q : Presentation X)
    [SheafOfModules.IsLocallyGeneratedBySections
      (KernelIdeal.sheaf.{u, u, u} Q.projection)] :
    ClosedSubspace.IsAssociated (ι Q)
      (KernelIdeal.subobject.{u, u, u} Q.projection) := sorry

end AlgebraicGeometry.LocallyRingedSpace.SupportedQuotient
