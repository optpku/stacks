module

public import ReasLib.AlgebraicGeometry.Scheme.Module.Picard.Norm.FiniteLocallyFree
public import Mathlib.AlgebraicGeometry.Noetherian
public import Mathlib.AlgebraicGeometry.Morphisms.Flat
public import Mathlib.RingTheory.Discriminant

/-!
# Determinantal norms and discriminants

This file relates determinantal finite-morphism norms to the discriminant ideal on affine opens.
-/

@[expose] public section

open AlgebraicGeometry
open CategoryTheory

universe u

namespace AlgebraicGeometry.Scheme.FiniteMorphismNorm

/-- On an affine open of a finite flat morphism of Noetherian schemes, the determinantal norm
of a section satisfying the dual trace condition belongs to the ideal generated by the
discriminant of any chosen finite basis. -/
theorem app_mem_span_discr_of_mem_different
    {X Y : Scheme.{u}} (f : Y ⟶ X) [IsNoetherian X] [IsNoetherian Y]
    [IsFinite f] [Flat f] (N : Scheme.FiniteMorphismNorm f) (hN : N.IsDeterminant)
    (U : X.Opens) (hU : IsAffineOpen U) (n : ℕ)
    (e : Module.Basis (Fin n) Γ(X, U) Γ(Y, f ⁻¹ᵁ U)) (b : Γ(Y, f ⁻¹ᵁ U))
    (hb : ∀ φ : Module.Dual Γ(X, U) Γ(Y, f ⁻¹ᵁ U),
      ∃ c : Γ(Y, f ⁻¹ᵁ U), ∀ x : Γ(Y, f ⁻¹ᵁ U),
        φ (b * x) = Algebra.trace Γ(X, U) Γ(Y, f ⁻¹ᵁ U) (c * x)) :
    N.app U b ∈ Ideal.span {Algebra.discr Γ(X, U) e} := sorry

end AlgebraicGeometry.Scheme.FiniteMorphismNorm
