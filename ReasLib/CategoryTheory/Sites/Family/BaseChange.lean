module

public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.ChosenPullback
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.CategoryTheory.Sites.Family

/-!
# Base change of fixed-target families

A fixed-target family pulls back componentwise along any morphism into its target. The resulting
family comes with its canonical projection back to the original family. This construction is
independent of covering or effective-epimorphism assumptions.

## Main declarations

* `SemiRepresentableFamily.Over.baseChange` - componentwise base change.
* `SemiRepresentableFamily.Over.baseChangeTo` - the canonical projection to the original family.
* `SemiRepresentableFamily.Over.baseChange_toPresieve` - the underlying presieve formula.
* `SemiRepresentableFamily.Over.baseChange_toSieve` - the generated-sieve formula.
-/

@[expose] public section

noncomputable section

universe w u v

namespace CategoryTheory

open Limits

namespace SemiRepresentableFamily.Over

variable {C : Type u} [Category.{v} C] {U V : C}

/-- The componentwise base change of a fixed-target family along `f : V ⟶ U`. -/
@[stacks 02ZD "componentwise family base change"]
noncomputable abbrev baseChange (K : Over.{w} U) (f : V ⟶ U)
    [∀ i : K.index, HasPullback (K.obj i).hom f] : Over.{w} V :=
  ofArrows
    (fun i : K.index ↦ pullback (K.obj i).hom f)
    (fun i ↦ pullback.snd (K.obj i).hom f)

/-- The source object of a member of a base-changed family is the corresponding pullback. -/
@[simp, stacks 02ZD "base-changed family source readout"]
theorem baseChange_obj_left (K : Over.{w} U) (f : V ⟶ U)
    [∀ i : K.index, HasPullback (K.obj i).hom f] (i : K.index) :
    ((K.baseChange f).obj i).left = pullback (K.obj i).hom f := sorry

/-- The structure map of a member of a base-changed family is the second pullback projection. -/
@[simp, stacks 02ZD "base-changed family arrow readout"]
theorem baseChange_obj_hom (K : Over.{w} U) (f : V ⟶ U)
    [∀ i : K.index, HasPullback (K.obj i).hom f] (i : K.index) :
    ((K.baseChange f).obj i).hom = pullback.snd (K.obj i).hom f := sorry

/-- The first pullback projection identifies each base-changed member with its original member
over `U`. -/
@[reassoc, stacks 02ZD "base-change projection compatibility"]
theorem baseChange_fst_hom (K : Over.{w} U) (f : V ⟶ U)
    [∀ i : K.index, HasPullback (K.obj i).hom f] (i : K.index) :
    pullback.fst (K.obj i).hom f ≫ (K.obj i).hom =
      ((K.baseChange f).obj i).hom ≫ f := sorry

/-- Mapping the base-changed family back to the original target gives the canonical family
morphism whose components are the first pullback projections. -/
@[stacks 02ZD "base-change family morphism"]
noncomputable def baseChangeTo (K : Over.{w} U) (f : V ⟶ U)
    [∀ i : K.index, HasPullback (K.obj i).hom f] :
    map (CategoryTheory.Over.map f) (K.baseChange f) ⟶ K where
  α := id
  f := fun i ↦ CategoryTheory.Over.homMk
    (pullback.fst (K.obj i).hom f) (K.baseChange_fst_hom f i)

/-- Componentwise base change of a fixed-target family generates the pullback-arrow presieve.
Only the pullbacks of the displayed family members along `f` are required. -/
@[stacks 02ZD "base-change presieve formula"]
theorem baseChange_toPresieve (K : Over.{w} U) (f : V ⟶ U)
    [∀ i : K.index, HasPullback (K.obj i).hom f] :
    (K.baseChange f).toPresieve = K.toPresieve.pullbackArrows f := sorry

/-- The sieve generated by a componentwise base change is the sieve pullback of the original
generated sieve.  This calculation is independent of any coverage or topology. -/
@[stacks 02ZD "base-change sieve formula"]
theorem baseChange_toSieve (K : Over.{w} U) (f : V ⟶ U)
    [∀ i : K.index, HasPullback (K.obj i).hom f] :
    (K.baseChange f).toSieve = K.toSieve.pullback f := sorry


end SemiRepresentableFamily.Over

end CategoryTheory
