module

public import ReasLib.CategoryTheory.Sites.AlgebraicSheaf
public import ReasLib.CategoryTheory.Sites.Family.Covering
public import ReasLib.CategoryTheory.Sites.MorphismOfSites.Criteria
public import ReasLib.CategoryTheory.Sites.PrecoverageStability

/-!
# Quasi-continuous functors of selected-cover sites

The conditions in this file are formulated for explicit precoverages, not for
their saturated Grothendieck topologies. This retains the finite-family and
chosen-pullback data that the source definition requires.
-/

@[expose] public section

universe u₁ u₂ v₁ v₂

namespace CategoryTheory.Functor.Precoverage

open Limits SemiRepresentableFamily.Over

variable {C : Type u₁} [Category.{v₁} C]
variable {D : Type u₂} [Category.{v₂} D]

/-- The componentwise image of a fixed-target family along a functor. -/
def imageFamily (u : C ⥤ D) {V : C} (S : SemiRepresentableFamily.Over V) :
    SemiRepresentableFamily.Over (u.obj V) where
  index := S.index
  obj := fun i ↦ (Over.post u).obj (S.obj i)

/-- Remark 7.13.6 (00WZ): a functor is quasi-continuous for selected
precoverages when image covers are tautologically represented by selected
covers and the corresponding pullback comparisons are invertible. -/
@[stacks 00WZ]
class IsQuasiContinuous (u : C ⥤ D) (P : _root_.CategoryTheory.Precoverage C)
    (Q : _root_.CategoryTheory.Precoverage D) : Prop where
  /-- Every selected source cover has a tautologically equivalent selected image cover. -/
  image_cover_tautologicallyEquivalent :
    ∀ {V : C} (S : SemiRepresentableFamily.Over.{max (max u₁ v₁) (max u₂ v₂)} V),
      IsCovering P S →
      ∃ T : SemiRepresentableFamily.Over.{max (max u₁ v₁) (max u₂ v₂)} (u.obj V),
        IsCovering Q T ∧ TautologicallyEquivalent (imageFamily u S) T
  /-- Pullback comparison is invertible along a member of a selected source cover. -/
  pullbackComparison_isIso_of_mem :
    ∀ {V : C} {R : Presieve V}, R ∈ P V →
      ∀ {Y : C} {i : Y ⟶ V}, R i →
      ∀ {T : C} (f : T ⟶ V) [HasPullback f i] [HasPullback (u.map f) (u.map i)],
        IsIso (pullbackComparison u f i)

namespace IsQuasiContinuous

/-- Quasi-continuity supplies invertibility of the pullback comparison along a
member of a selected fixed-target cover. -/
theorem pullbackComparison_isIso
    {u : C ⥤ D} {P : _root_.CategoryTheory.Precoverage C}
    {Q : _root_.CategoryTheory.Precoverage D} (h : IsQuasiContinuous u P Q)
    {V : C} (S : SemiRepresentableFamily.Over.{max (max u₁ v₁) (max u₂ v₂)} V)
    (hS : IsCovering P S) {Y : C} {i : Y ⟶ V} (hi : S.toPresieve i)
    {T : C} (f : T ⟶ V) [HasPullback f i] [HasPullback (u.map f) (u.map i)] :
    IsIso (pullbackComparison u f i) := sorry

/-- The image of a selected covering presieve is selected-covering under a
quasi-continuous functor. -/
theorem map_mem {u : C ⥤ D} {P : _root_.CategoryTheory.Precoverage C}
    {Q : _root_.CategoryTheory.Precoverage D} (h : IsQuasiContinuous u P Q)
    {V : C} {R : Presieve V} (hR : R ∈ P V) : R.map u ∈ Q (u.obj V) := sorry

/-- Quasi-continuity preserves a pullback along a member of a selected
covering presieve whenever the indicated pullbacks exist. -/
theorem preservesPullback {u : C ⥤ D} {P : _root_.CategoryTheory.Precoverage C}
    {Q : _root_.CategoryTheory.Precoverage D} (h : IsQuasiContinuous u P Q)
    {V : C} {R : Presieve V} (hR : R ∈ P V) {Y : C} {i : Y ⟶ V} (hi : R i)
    {T : C} (f : T ⟶ V) [HasPullback f i] [HasPullback (u.map f) (u.map i)] :
    PreservesLimit (cospan f i) u := sorry

/-- A quasi-continuous functor is continuous for the same selected precoverages. -/
theorem toIsContinuous {u : C ⥤ D}
    {P : _root_.CategoryTheory.Precoverage C} {Q : _root_.CategoryTheory.Precoverage D}
    [HasPullbacks D] (h : IsQuasiContinuous u P Q) :
    IsContinuous u P Q := sorry

/-- Under the literal Stacks-site axioms, quasi-continuity induces continuity
for the Grothendieck topologies generated by the selected covers. -/
theorem toContinuous {u : C ⥤ D} {P : _root_.CategoryTheory.Precoverage C}
    {Q : _root_.CategoryTheory.Precoverage D} [P.HasPullbacks]
    [P.HasFactoringPullbacks] [Q.HasFactoringPullbacks] [HasPullbacks D]
    (h : IsQuasiContinuous u P Q) :
    u.IsContinuous P.toGrothendieck Q.toGrothendieck := sorry

/-- Under Mathlib's stronger indexed base-change hypotheses, quasi-continuity
also induces continuity for the generated Grothendieck topologies. -/
theorem toContinuousOfBaseChange {u : C ⥤ D}
    {P : _root_.CategoryTheory.Precoverage C} {Q : _root_.CategoryTheory.Precoverage D}
    [P.IsStableUnderBaseChange] [P.HasPullbacks]
    [Q.IsStableUnderBaseChange] [Q.HasPullbacks] [HasPullbacks D]
    (h : IsQuasiContinuous u P Q) :
    u.IsContinuous P.toGrothendieck Q.toGrothendieck := sorry

/-- Typeclass bridge for the base-change presentation of quasi-continuity.
Its hypotheses determine both selected precoverages, so it does not require a
local `letI` at call sites. -/
instance instIsContinuousOfBaseChange {u : C ⥤ D}
    {P : _root_.CategoryTheory.Precoverage C} {Q : _root_.CategoryTheory.Precoverage D}
    [P.IsStableUnderBaseChange] [P.HasPullbacks]
    [Q.IsStableUnderBaseChange] [Q.HasPullbacks] [HasPullbacks D]
    [IsQuasiContinuous u P Q] :
    u.IsContinuous P.toGrothendieck Q.toGrothendieck := sorry

variable {P : _root_.CategoryTheory.Precoverage C}
variable {Q : _root_.CategoryTheory.Precoverage D}

/-- A quasi-continuous functor preserving a terminal object and pullbacks is a morphism of the
Grothendieck sites generated by the selected precoverages. -/
@[stacks 00X8]
theorem toMorphismOfSites
    (u : C ⥤ D) [HasPullbacks C] [HasPullbacks D]
    [P.IsStableUnderBaseChange] [Q.IsStableUnderBaseChange]
    [IsQuasiContinuous u P Q] [HasTerminal C]
    [PreservesLimit (Functor.empty.{0} C) u]
    [PreservesLimitsOfShape WalkingCospan u] :
    IsMorphismOfSites P.toGrothendieck Q.toGrothendieck u := sorry

/-- An explicit terminal object preserved by a quasi-continuous pullback-preserving functor
gives a morphism of the generated Grothendieck sites. -/
theorem toMorphismOfSitesOfTerminal
    (u : C ⥤ D) [HasPullbacks C] [HasPullbacks D]
    [P.IsStableUnderBaseChange] [Q.IsStableUnderBaseChange]
    [IsQuasiContinuous u P Q]
    (X : C) (hX : IsTerminal X) (huX : IsTerminal (u.obj X))
    [PreservesLimitsOfShape WalkingCospan u] :
    IsMorphismOfSites P.toGrothendieck Q.toGrothendieck u := sorry

/-- The pullback on set-valued sheaves induced by a quasi-continuous functor is exact when the
functor preserves a terminal object and pullbacks. -/
@[stacks 00X8]
theorem exactSheafPullback
    (u : C ⥤ D) [HasPullbacks C] [HasPullbacks D]
    [P.IsStableUnderBaseChange] [Q.IsStableUnderBaseChange]
    [IsQuasiContinuous u P Q] [HasTerminal C]
    [PreservesLimit (Functor.empty.{0} C) u]
    [PreservesLimitsOfShape WalkingCospan u]
    [HasSheafify P.toGrothendieck (Type w)] [HasSheafify Q.toGrothendieck (Type w)]
    [∀ A : Cᵒᵖ ⥤ Type w, u.op.HasLeftKanExtension A]
    [PreservesFiniteLimits
      (u.op.lan : (Cᵒᵖ ⥤ Type w) ⥤ Dᵒᵖ ⥤ Type w)] :
    exactFunctor (Sheaf P.toGrothendieck (Type w)) (Sheaf Q.toGrothendieck (Type w))
      (u.sheafPullback (Type w) P.toGrothendieck Q.toGrothendieck) := sorry

/-- The explicit-terminal-object form of `exactSheafPullback`. -/
theorem exactSheafPullbackOfTerminal
    (u : C ⥤ D) [HasPullbacks C] [HasPullbacks D]
    [P.IsStableUnderBaseChange] [Q.IsStableUnderBaseChange]
    [IsQuasiContinuous u P Q]
    (X : C) (hX : IsTerminal X) (huX : IsTerminal (u.obj X))
    [PreservesLimitsOfShape WalkingCospan u]
    [HasSheafify P.toGrothendieck (Type w)] [HasSheafify Q.toGrothendieck (Type w)]
    [∀ A : Cᵒᵖ ⥤ Type w, u.op.HasLeftKanExtension A]
    [PreservesFiniteLimits
      (u.op.lan : (Cᵒᵖ ⥤ Type w) ⥤ Dᵒᵖ ⥤ Type w)] :
    exactFunctor (Sheaf P.toGrothendieck (Type w)) (Sheaf Q.toGrothendieck (Type w))
      (u.sheafPullback (Type w) P.toGrothendieck Q.toGrothendieck) := sorry

end IsQuasiContinuous

end CategoryTheory.Functor.Precoverage
