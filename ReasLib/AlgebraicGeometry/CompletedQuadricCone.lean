module

public import Mathlib.RingTheory.MvPowerSeries.Basic
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.PicardGroup
public import ReasLib.AlgebraicGeometry.PuncturedSpectrum
public import ReasLib.AlgebraicGeometry.Scheme.Divisor.EffectiveCartier.IdealSheaf
public import ReasLib.AlgebraicGeometry.Scheme.IdealSheafData.Spec
public import ReasLib.AlgebraicGeometry.Scheme.Module.Picard
public import ReasLib.AlgebraicGeometry.Scheme.Module.Sections
public import ReasLib.RingTheory.Depth

@[expose] public section

open CategoryTheory CategoryTheory.MonoidalCategory
open AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.CompletedQuadricCone

/-- The ambient four-variable formal power-series ring over a coefficient field. -/
abbrev AmbientRing (k : Type u) [Field k] := MvPowerSeries (Fin 4) k

/-- The first formal coordinate in the ambient power-series ring. -/
def x (k : Type u) [Field k] : AmbientRing k := MvPowerSeries.X (0 : Fin 4)

/-- The second formal coordinate in the ambient power-series ring. -/
def y (k : Type u) [Field k] : AmbientRing k := MvPowerSeries.X (1 : Fin 4)

/-- The third formal coordinate in the ambient power-series ring. -/
def z (k : Type u) [Field k] : AmbientRing k := MvPowerSeries.X (2 : Fin 4)

/-- The fourth formal coordinate in the ambient power-series ring. -/
def w (k : Type u) [Field k] : AmbientRing k := MvPowerSeries.X (3 : Fin 4)

/-- The defining quadratic relation in the ambient power-series ring. -/
def relation (k : Type u) [Field k] : AmbientRing k := x k * y k - z k * w k

/-- The principal ideal generated by the defining quadratic relation. -/
def relationIdeal (k : Type u) [Field k] : Ideal (AmbientRing k) :=
  Ideal.span ({relation k} : Set (AmbientRing k))

/-- The completed quadric cone coordinate ring. -/
abbrev Ring (k : Type u) [Field k] := AmbientRing k ⧸ relationIdeal k

/-- The image of the first coordinate in the completed quadric cone ring. -/
def xBar (k : Type u) [Field k] : Ring k := Ideal.Quotient.mk (relationIdeal k) (x k)

/-- The image of the second coordinate in the completed quadric cone ring. -/
def yBar (k : Type u) [Field k] : Ring k := Ideal.Quotient.mk (relationIdeal k) (y k)

/-- The image of the third coordinate in the completed quadric cone ring. -/
def zBar (k : Type u) [Field k] : Ring k := Ideal.Quotient.mk (relationIdeal k) (z k)

/-- The image of the fourth coordinate in the completed quadric cone ring. -/
def wBar (k : Type u) [Field k] : Ring k := Ideal.Quotient.mk (relationIdeal k) (w k)

/-- The ideal generated by the first and third quotient coordinates. -/
def ideal (k : Type u) [Field k] : Ideal (Ring k) :=
  Ideal.span ({xBar k, zBar k} : Set (Ring k))

/-- The completed quadric cone coordinate ring is local. -/
instance localRing (k : Type u) [Field k] : IsLocalRing (Ring k) := sorry

/-- The complement of the closed point in the spectrum of the completed quadric cone. -/
abbrev puncturedOpen (k : Type u) [Field k] :=
  PuncturedSpectrum.puncturedOpen (Ring k)

/-- The ideal-sheaf datum induced by the coordinate ideal on the punctured spectrum. -/
def divisor (k : Type u) [Field k] : (puncturedOpen k).toScheme.IdealSheafData :=
  (Scheme.idealSheafDataOfIdealOnSpec (ideal k)).comap (puncturedOpen k).ι

/-- The quotient coordinates satisfy the defining quadratic relation. -/
theorem relation_eq_zero (k : Type u) [Field k] : xBar k * yBar k = zBar k * wBar k := sorry

/-- The completed quadric cone coordinate ring has Krull dimension three. -/
theorem ringKrullDim_eq_three (k : Type u) [Field k] :
    ringKrullDim (Ring k) = (3 : WithBot ℕ∞) := sorry

/-- The Picard group of the punctured spectrum is nontrivial. -/
instance nontrivialPicardGroup (k : Type u) [Field k] :
    Nontrivial (Scheme.PicardGroup (puncturedOpen k).toScheme) := sorry

/-- The coordinate ideal defines an effective Cartier divisor on the punctured spectrum. -/
instance divisorIsEffectiveCartier (k : Type u) [Field k] :
    IsEffectiveCartierDivisor (divisor k).subschemeι := sorry

/-- The positive divisor sheaf has a nonzero Picard class. -/
theorem picardClass_ne_zero (k : Type u) [Field k] :
    Scheme.Modules.picardClass (divisor k).associatedSheaf ≠
      (0 : Scheme.PicardGroup (puncturedOpen k).toScheme) := sorry

/-- The quotient by the coordinate ideal has depth two. -/
theorem quotientDepth_eq_two (k : Type u) [Field k] :
    moduleDepth (Ring k) (Ring k ⧸ ideal k) = 2 := sorry

/-- The coordinate ideal has depth three over the maximal ideal. -/
theorem idealDepth_eq_three (k : Type u) [Field k] :
    Ideal.depth (IsLocalRing.maximalIdeal (Ring k)) (ideal k) = 3 := sorry

/-- The coordinate ideal is isomorphic to the global sections of the negative divisor sheaf. -/
theorem ideal_globalSections_iso (k : Type u) [Field k] :
    Nonempty
      (ModuleCat.of (Ring k) (ideal k) ≅
        Scheme.Hom.globalSectionsMod (puncturedOpen k).ι (divisor k).negSheaf) := sorry

/-- The coordinate ideal is not principal. -/
theorem ideal_not_isPrincipal (k : Type u) [Field k] : ¬ (ideal k).IsPrincipal := sorry

/-- The negative divisor sheaf is not isomorphic to the tensor unit. -/
theorem negSheaf_not_trivial (k : Type u) [Field k] :
    ¬ Nonempty
      ((divisor k).negSheaf ≅ 𝟙_ (puncturedOpen k).toScheme.Modules) := sorry

/-- The extension of the coordinate ideal to a localization away from a coordinate. -/
def localizedIdeal (k : Type u) [Field k] (coordinate : Ring k) :
    Ideal (Localization.Away coordinate) :=
  (ideal k).map (algebraMap (Ring k) (Localization.Away coordinate))

/-- The coordinate ideal becomes an invertible module after inverting the first coordinate. -/
instance localizedIdealXInvertible (k : Type u) [Field k] :
    Module.Invertible (Localization.Away (xBar k)) (localizedIdeal k (xBar k)) := sorry

/-- The coordinate ideal becomes an invertible module after inverting the second coordinate. -/
instance localizedIdealYInvertible (k : Type u) [Field k] :
    Module.Invertible (Localization.Away (yBar k)) (localizedIdeal k (yBar k)) := sorry

/-- The coordinate ideal becomes an invertible module after inverting the third coordinate. -/
instance localizedIdealZInvertible (k : Type u) [Field k] :
    Module.Invertible (Localization.Away (zBar k)) (localizedIdeal k (zBar k)) := sorry

/-- The coordinate ideal becomes an invertible module after inverting the fourth coordinate. -/
instance localizedIdealWInvertible (k : Type u) [Field k] :
    Module.Invertible (Localization.Away (wBar k)) (localizedIdeal k (wBar k)) := sorry

/-- The canonical map from the coordinate ring to punctured-spectrum sections is bijective. -/
theorem globalSectionsMap_bijective (k : Type u) [Field k] :
    Function.Bijective (Scheme.Hom.globalSectionsMap (puncturedOpen k).ι) := sorry

end AlgebraicGeometry.CompletedQuadricCone
