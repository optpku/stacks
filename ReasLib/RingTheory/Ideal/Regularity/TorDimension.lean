module

public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.LocalRing.Basic
public import Mathlib.RingTheory.Noetherian.Defs
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.CompleteIntersection.Basic
public import ReasLib.RingTheory.RingHom.TorDimension

/-!
# Regular sequences and finite Tor dimension of quotient maps

These results transfer regular-sequence generation through a quotient map of
ideals in a Noetherian local ring.
-/

@[expose] public section

universe u

namespace Ideal

variable {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
variable {I J : Ideal A}

namespace IsGeneratedByRegularSequence.FiniteTorDimension

/-- If `A / J` has finite Tor dimension over `A / I` and `J` is generated by
a regular sequence, then `I` is generated by a regular sequence. -/
@[stacks 09PW "regularity of the smaller ideal"]
theorem of_quotient
    (hJ : J ≠ ⊤) (hIJ : I ≤ J)
    (hTor : (Ideal.Quotient.factor hIJ).HasFiniteTorDimension)
    (hJreg : J.IsGeneratedByRegularSequence) :
    I.IsGeneratedByRegularSequence := sorry

/-- Under the same finite-Tor hypothesis, the image of `J` in `A / I` is
generated by a regular sequence. -/
@[stacks 09PW "regularity of the quotient ideal"]
theorem quotient
    (hJ : J ≠ ⊤) (hIJ : I ≤ J)
    (hTor : (Ideal.Quotient.factor hIJ).HasFiniteTorDimension)
    (hJreg : J.IsGeneratedByRegularSequence) :
    (Ideal.map (Ideal.Quotient.mk I) J).IsGeneratedByRegularSequence := sorry

end IsGeneratedByRegularSequence.FiniteTorDimension

end Ideal
