module

public import ReasLib.Algebra.Module.RelativeDualizing.TraceElement
public import ReasLib.RingTheory.DedekindDifferent.Comparison

@[expose] public section

noncomputable section

open scoped Algebra.TensorProduct.Right TensorProduct

universe u

namespace Algebra.RelativeDualizingModule

variable (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
variable [IsNoetherianRing A] [IsNoetherianRing B]
variable [Module.Finite A B] [Module.Flat A B]

/-- The affine different ideal is the annihilator of the quotient by the
finite-flat trace element in the relative dualizing module. -/
noncomputable def differentIdeal : Ideal B :=
  Module.annihilator B
    (Algebra.RelativeDualizingModule.of A B B (.of_moduleFinite) inferInstance ⧸
      Submodule.span B {Algebra.RelativeDualizingModule.finiteFlatTraceElement A B})

/-- Membership in the affine different ideal is equivalent to preserving the
submodule generated by the finite-flat trace element under scalar action. -/
theorem mem_differentIdeal_iff (b : B) :
    b ∈ differentIdeal A B ↔
      ∀ ω : Algebra.RelativeDualizingModule.of A B B (.of_moduleFinite) inferInstance,
        b • ω ∈
          Submodule.span B {Algebra.RelativeDualizingModule.finiteFlatTraceElement A B} := sorry

/-- The ideal-valued Dedekind different is the pullback of the fractional
Dedekind different along the canonical map to the generic fibre. -/
noncomputable def dedekindDifferentIdeal : Ideal B :=
  (Submodule.dedekindDifferent A (FractionRing A) B
      (B ⊗[A] FractionRing A)).comap
    (Algebra.linearMap B (B ⊗[A] FractionRing A))

/-- Membership in the ideal-valued Dedekind different is membership of the
canonical image in the fractional Dedekind different. -/
theorem mem_dedekindDifferentIdeal_iff (b : B) :
    b ∈ dedekindDifferentIdeal A B ↔
      algebraMap B (B ⊗[A] FractionRing A) b ∈
        Submodule.dedekindDifferent A (FractionRing A) B
          (B ⊗[A] FractionRing A) := sorry

end Algebra.RelativeDualizingModule
