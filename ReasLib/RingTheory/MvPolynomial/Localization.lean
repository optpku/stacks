module

public import Mathlib.RingTheory.MvPolynomial.Localization
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Localization.Away.Relative

@[expose] public section

/-!
# Coefficient Localizations of Multivariate Polynomial Rings

This leaf owns the canonical comparison between localizing a multivariate
polynomial ring away from a coefficient `C f` and forming multivariate
polynomials over the coefficient localization away from `f`.

The construction is indexed by an arbitrary variable type.  It is independent
of a presentation, a finite-variable model, or a module placed over the
polynomial ring.
-/

universe u v w x

namespace MvPolynomial.Localization

variable {σ : Type u} {A : Type v} [CommRing A]

attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- Tag `051T`: localizing `MvPolynomial σ A` away from `C f` is canonically
the polynomial ring over `Localization.Away f`. -/
@[stacks 051T "coefficient polynomial away localization"]
noncomputable def awayCAlgEquiv (f : A) :
    Localization.Away (MvPolynomial.C (σ := σ) f) ≃ₐ[MvPolynomial σ A]
      MvPolynomial σ (Localization.Away f) :=
  by
    change Localization (Submonoid.powers (MvPolynomial.C (σ := σ) f)) ≃ₐ[MvPolynomial σ A]
      MvPolynomial σ (Localization.Away f)
    rw [← Submonoid.map_powers]
    exact IsLocalization.algEquiv
      ((Submonoid.powers f).map (MvPolynomial.C : A →+* MvPolynomial σ A))
      (Localization ((Submonoid.powers f).map
        (MvPolynomial.C : A →+* MvPolynomial σ A)))
      (MvPolynomial σ (Localization.Away f))

/-- Tag `051T`: the coefficient-localized polynomial ring is canonically the
localization of `MvPolynomial σ A` away from `C f`.  This is a global instance:
it is the normalized form of Mathlib's `MvPolynomial.isLocalization` instance
under `Submonoid.map_powers`. -/
@[stacks 051T "coefficient polynomial localization property"]
instance isLocalizationAwayC (f : A) :
    IsLocalization (Submonoid.powers (MvPolynomial.C (σ := σ) f))
      (MvPolynomial σ (Localization.Away f)) :=
  by
    simpa only [Submonoid.map_powers] using
      (MvPolynomial.isLocalization (σ := σ) (M := Submonoid.powers f)
        (S := Localization.Away f))

/-- The identity ring hom preserves the powers submonoid generated by `C f`. -/
theorem id_le_comap_powers (f : A) :
    Submonoid.powers (MvPolynomial.C (σ := σ) f) ≤
      Submonoid.comap (RingHom.id (MvPolynomial σ A))
        (Submonoid.powers (MvPolynomial.C (σ := σ) f)) := sorry

/-- The inverse comparison sends a localized coefficient polynomial to the
matching coefficient in the localization away from `C f`. -/
@[simp, stacks 051T "coefficient polynomial localization coefficient"]
theorem awayCAlgEquiv_symm_C (f r : A) :
    (awayCAlgEquiv (σ := σ) f).symm
        (MvPolynomial.C (algebraMap A (Localization.Away f) r)) =
      algebraMap (MvPolynomial σ A)
        (Localization.Away (MvPolynomial.C (σ := σ) f))
        (MvPolynomial.C (σ := σ) r) := sorry

/-- The inverse comparison sends every polynomial variable to its canonical
image in the localization away from `C f`. -/
@[simp, stacks 051T "coefficient polynomial localization variable"]
theorem awayCAlgEquiv_symm_X (f : A) (i : σ) :
    (awayCAlgEquiv (σ := σ) f).symm (MvPolynomial.X i) =
      algebraMap (MvPolynomial σ A)
        (Localization.Away (MvPolynomial.C (σ := σ) f))
        (MvPolynomial.X i) := sorry

/-- The inverse comparison is the canonical localization map induced by the
identity of `MvPolynomial σ A`. -/
@[stacks 051T "coefficient polynomial localization map"]
theorem awayCAlgEquiv_symm_eq_map (f : A) :
    (awayCAlgEquiv (σ := σ) f).symm.toRingHom =
      IsLocalization.map
        (M := Submonoid.powers (MvPolynomial.C (σ := σ) f))
        (S := MvPolynomial σ (Localization.Away f))
        (Q := Localization.Away (MvPolynomial.C (σ := σ) f))
        (g := RingHom.id (MvPolynomial σ A))
        (id_le_comap_powers (σ := σ) f) := sorry

/-- A denominator in `powers f` maps under `C` to a denominator in
`powers (C f)`. -/
@[stacks 051T "coefficient polynomial denominator representative"]
theorem c_mem_powers {f : A} (y : Submonoid.powers f) :
    MvPolynomial.C (σ := σ) (y : A) ∈
      Submonoid.powers (MvPolynomial.C (σ := σ) f) := sorry

/-- The inverse comparison sends the explicit coefficient fraction `x / y` to
the matching polynomial coefficient fraction `C x / C y`. -/
@[simp, stacks 051T "coefficient polynomial localization fraction"]
theorem awayCAlgEquiv_symm_C_mk
    (f x : A) (y : Submonoid.powers f) :
    (awayCAlgEquiv (σ := σ) f).symm
        (MvPolynomial.C (IsLocalization.mk' (Localization.Away f) x y)) =
      IsLocalization.mk' (Localization.Away (MvPolynomial.C (σ := σ) f))
        (MvPolynomial.C (σ := σ) x)
        ⟨MvPolynomial.C (σ := σ) (y : A), c_mem_powers (σ := σ) y⟩ := sorry

/-- The inverse comparison followed by coefficient inclusion is the canonical
away map induced by `C : A →+* MvPolynomial σ A`. -/
@[stacks 051T "coefficient polynomial away map"]
theorem awayCAlgEquiv_symm_comp_C (f : A) :
    ((awayCAlgEquiv (σ := σ) f).symm.toRingHom.comp
        (MvPolynomial.C : Localization.Away f →+* MvPolynomial σ (Localization.Away f))) =
      Localization.awayMap (MvPolynomial.C (σ := σ) : A →+* MvPolynomial σ A) f := sorry

/-- The coefficient-localization equivalence sends the canonical away image of
a localized coefficient to the corresponding polynomial coefficient. -/
@[simp, stacks 051T "coefficient polynomial away localization on coefficient"]
theorem awayCAlgEquiv_apply_awayMap_C (f : A) (r : Localization.Away f) :
    awayCAlgEquiv (σ := σ) f
      (Localization.awayMap (MvPolynomial.C (σ := σ) : A →+* MvPolynomial σ A) f r) =
        MvPolynomial.C r := sorry

/-- The coefficient-localization equivalence sends the canonical image of a
polynomial variable to the same variable over the localized coefficient ring. -/
@[simp, stacks 051T "coefficient polynomial away localization on variable"]
theorem awayCAlgEquiv_apply_algebraMap_X (f : A) (i : σ) :
    awayCAlgEquiv (σ := σ) f
      (algebraMap (MvPolynomial σ A)
        (Localization.Away (MvPolynomial.C (σ := σ) f)) (MvPolynomial.X i)) =
          MvPolynomial.X i := sorry

/-- Tag `051T`: the canonical `Localization.Away f`-algebra structure on the
localization of `MvPolynomial σ A` away from `C f`.  It is deliberately scoped rather than
global: the same carrier also has other legitimate scalar presentations. -/
@[reducible, stacks 051T "coefficient polynomial away algebra"]
noncomputable def awayCAlgebra (f : A) :
    Algebra (Localization.Away f)
      (Localization.Away (MvPolynomial.C (σ := σ) f)) :=
  (Localization.awayMapₐ (Algebra.ofId A (MvPolynomial σ A)) f).toAlgebra

/-- The `A_f`-algebra structure on the localization away from `C f` induced by
the standard away map has that away map as its algebra map.  The local
instance is explicit because this theorem fixes the scoped `awayCAlgebra`
presentation. -/
@[stacks 051T "coefficient polynomial away algebra map"]
theorem awayCAlgebraMap_eq_awayMap (f : A) :
    letI : Algebra (Localization.Away f)
      (Localization.Away (MvPolynomial.C (σ := σ) f)) :=
      awayCAlgebra (σ := σ) f
    algebraMap (Localization.Away f)
      (Localization.Away (MvPolynomial.C (σ := σ) f)) =
      Localization.awayMap (MvPolynomial.C (σ := σ) : A →+* MvPolynomial σ A) f := sorry

/-- The scoped coefficient-away algebra action is compatible with the base
scalar tower `A → Localization.Away f → Localization.Away (MvPolynomial.C f)`. -/
@[stacks 051T "coefficient polynomial away scalar tower"]
theorem awayCScalarTower (f : A) :
    letI : Algebra (Localization.Away f)
      (Localization.Away (MvPolynomial.C (σ := σ) f)) :=
      awayCAlgebra (σ := σ) f
    IsScalarTower A (Localization.Away f)
      (Localization.Away (MvPolynomial.C (σ := σ) f)) := sorry

/-- Tag `051T`: the coefficient-localization comparison is linear over the
coefficient localization when the source uses its canonical away-map action. -/
@[stacks 051T "coefficient polynomial away localization over the coefficient chart"]
noncomputable def awayCAlgEquivOverBase (f : A) :
    letI : Algebra (Localization.Away f)
        (Localization.Away (MvPolynomial.C (σ := σ) f)) :=
      awayCAlgebra (σ := σ) f
    Localization.Away (MvPolynomial.C (σ := σ) f) ≃ₐ[Localization.Away f]
      MvPolynomial σ (Localization.Away f) := by
  letI : Algebra (Localization.Away f)
      (Localization.Away (MvPolynomial.C (σ := σ) f)) :=
    awayCAlgebra (σ := σ) f
  refine { (awayCAlgEquiv (σ := σ) f).toRingEquiv with commutes' := ?_ }
  intro r
  rw [awayCAlgebraMap_eq_awayMap (σ := σ) f]
  simpa [MvPolynomial.algebraMap_eq] using
    awayCAlgEquiv_apply_awayMap_C (σ := σ) f r

variable {B : Type w} [CommRing B] [Algebra A B]

/-- Tag `051T`: a target localizing `B` away from the image of a polynomial
presentation denominator also localizes away from the corresponding
coefficient denominator. -/
@[stacks 051T "localized polynomial presentation localization"]
theorem isLocalizationAway_algebraMap
    (π : MvPolynomial σ A →ₐ[A] B) (f : A) {T : Type x} [CommRing T] [Algebra B T]
    [Algebra A T] [IsScalarTower A B T]
    [IsLocalization.Away (π (MvPolynomial.C (σ := σ) f)) T] :
    IsLocalization.Away (algebraMap A B f) T := by
  rw [← MvPolynomial.algHom_C π f]
  infer_instance

/-- Tag `051T`: the localized polynomial presentation with an arbitrary
chosen target localization away from `π(C f)`. -/
@[stacks 051T "localized polynomial presentation target map"]
noncomputable def presentationAwayToAlgHom
    (π : MvPolynomial σ A →ₐ[A] B) (f : A) {T : Type x} [CommRing T] [Algebra B T]
    [Algebra A T] [IsScalarTower A B T]
    [IsLocalization.Away (π (MvPolynomial.C (σ := σ) f)) T] :
    MvPolynomial σ (Localization.Away f) →ₐ[A] T :=
  (IsLocalization.Away.mapₐ (Localization.Away (MvPolynomial.C (σ := σ) f)) T π
    (MvPolynomial.C (σ := σ) f)).comp
      (AlgHom.restrictScalars A (awayCAlgEquiv (σ := σ) f).symm.toAlgHom)

/-- Tag `051T`: the explicit `Localization.Away f`-action on an arbitrary
target of `presentationAwayToAlgHom`.  The local localization instance below
is a proof-local transport across `π(C f) = algebraMap A B f`. -/
@[reducible, stacks 051T "localized polynomial presentation target algebra"]
noncomputable def presentationAwayToAlgebra
    (π : MvPolynomial σ A →ₐ[A] B) (f : A) {T : Type x} [CommRing T] [Algebra B T]
    [Algebra A T] [IsScalarTower A B T]
    [IsLocalization.Away (π (MvPolynomial.C (σ := σ) f)) T] :
    Algebra (Localization.Away f) T := by
  letI : IsLocalization.Away ((Algebra.ofId A B) f) T := by
    change IsLocalization.Away (algebraMap A B f) T
    exact isLocalizationAway_algebraMap (σ := σ) π f
  exact (IsLocalization.Away.mapₐ (Localization.Away f) T (Algebra.ofId A B) f).toAlgebra

/-- The explicit action on a target of a localized polynomial presentation
extends the original coefficient action. -/
@[stacks 051T "localized polynomial presentation target scalar tower"]
theorem presentationAwayToAlgebra_isScalarTower
    (π : MvPolynomial σ A →ₐ[A] B) (f : A) {T : Type x} [CommRing T] [Algebra B T]
    [Algebra A T] [IsScalarTower A B T]
    [IsLocalization.Away (π (MvPolynomial.C (σ := σ) f)) T] :
    letI : Algebra (Localization.Away f) T :=
      presentationAwayToAlgebra (σ := σ) π f
    IsScalarTower A (Localization.Away f) T := sorry

/-- The arbitrary-target localized presentation sends a localized coefficient
constant to its localized coefficient image. -/
@[simp, stacks 051T "localized polynomial presentation target coefficient"]
theorem presentationAwayToAlgHom_C
    (π : MvPolynomial σ A →ₐ[A] B) (f r : A) {T : Type x} [CommRing T] [Algebra B T]
    [Algebra A T] [IsScalarTower A B T]
    [IsLocalization.Away (π (MvPolynomial.C (σ := σ) f)) T] :
    presentationAwayToAlgHom (σ := σ) π f
        (MvPolynomial.C (algebraMap A (Localization.Away f) r)) =
      algebraMap B T (algebraMap A B r) := sorry

/-- The arbitrary-target localized presentation sends a polynomial variable to
the localized image of that variable. -/
@[simp, stacks 051T "localized polynomial presentation target variable"]
theorem presentationAwayToAlgHom_X
    (π : MvPolynomial σ A →ₐ[A] B) (f : A) (i : σ) {T : Type x} [CommRing T] [Algebra B T]
    [Algebra A T] [IsScalarTower A B T]
    [IsLocalization.Away (π (MvPolynomial.C (σ := σ) f)) T] :
    presentationAwayToAlgHom (σ := σ) π f (MvPolynomial.X i) =
      algebraMap B T (π (MvPolynomial.X i)) := sorry

/-- Tag `051T`: with its explicit localized coefficient action, an
arbitrary-target localized presentation is the `aeval` map on its localized
images of the variables. -/
@[stacks 051T "localized polynomial presentation target aeval"]
theorem presentationAwayToAlgHom_eq_aeval
    (π : MvPolynomial σ A →ₐ[A] B) (f : A) {T : Type x} [CommRing T] [Algebra B T]
    [Algebra A T] [IsScalarTower A B T]
    [IsLocalization.Away (π (MvPolynomial.C (σ := σ) f)) T] :
    letI : Algebra (Localization.Away f) T :=
      presentationAwayToAlgebra (σ := σ) π f
    letI : IsScalarTower A (Localization.Away f) T :=
      presentationAwayToAlgebra_isScalarTower (σ := σ) π f
    presentationAwayToAlgHom (σ := σ) π f =
      AlgHom.restrictScalars A
        (MvPolynomial.aeval
          (fun i ↦ algebraMap B T (π (MvPolynomial.X i))) :
          MvPolynomial σ (Localization.Away f) →ₐ[Localization.Away f] T) := sorry

/-- Tag `051T`: the localized polynomial presentation retained as an
`A`-algebra homomorphism.  The ring-hom view is `presentationAway`. -/
@[stacks 051T "localized polynomial presentation algebra map"]
noncomputable def presentationAwayAlgHom
    (π : MvPolynomial σ A →ₐ[A] B) (f : A) :
    MvPolynomial σ (Localization.Away f) →ₐ[A]
      Localization.Away (algebraMap A B f) := by
  -- This proof-local instance is the canonical conversion from the presentation denominator.
  letI : IsLocalization.Away (π (MvPolynomial.C (σ := σ) f))
      (Localization.Away (algebraMap A B f)) := by
    simpa using (inferInstance :
      IsLocalization.Away (algebraMap A B f) (Localization.Away (algebraMap A B f)))
  exact
    (IsLocalization.Away.mapₐ (Localization.Away (MvPolynomial.C (σ := σ) f))
      (Localization.Away (algebraMap A B f)) π (MvPolynomial.C (σ := σ) f)).comp
        (AlgHom.restrictScalars A (awayCAlgEquiv (σ := σ) f).symm.toAlgHom)

/-- Tag `051T`: a polynomial presentation transported to the coefficient-away
chart through `awayCAlgEquiv`. -/
@[stacks 051T "localized polynomial presentation"]
noncomputable def presentationAway
    (π : MvPolynomial σ A →ₐ[A] B) (f : A) :
    MvPolynomial σ (Localization.Away f) →+*
      Localization.Away (algebraMap A B f) :=
  (presentationAwayAlgHom (σ := σ) π f).toRingHom

/-- The coefficient component of a transported polynomial presentation is the
canonical away map induced by the original coefficient presentation. -/
@[stacks 051T "localized polynomial presentation coefficient map"]
theorem presentationAway_comp_C
    (π : MvPolynomial σ A →ₐ[A] B) (f : A) :
    (presentationAway (σ := σ) π f).comp
        (MvPolynomial.C : Localization.Away f →+* MvPolynomial σ (Localization.Away f)) =
      Localization.awayMap (algebraMap A B) f := sorry

/-- The transported presentation sends every coefficient from the localized
base ring through the canonical localized coefficient map. -/
@[simp, stacks 051T "localized polynomial presentation coefficient application"]
theorem presentationAway_C_apply
    (π : MvPolynomial σ A →ₐ[A] B) (f : A) (z : Localization.Away f) :
    presentationAway (σ := σ) π f (MvPolynomial.C z) =
      Localization.awayMap (algebraMap A B) f z := sorry

/-- The transported presentation sends localized coefficient constants to the
corresponding localized coefficients in its target. -/
@[simp, stacks 051T "localized polynomial presentation coefficient"]
theorem presentationAway_C
    (π : MvPolynomial σ A →ₐ[A] B) (f r : A) :
    presentationAway (σ := σ) π f
        (MvPolynomial.C (algebraMap A (Localization.Away f) r)) =
      algebraMap B (Localization.Away (algebraMap A B f))
        (algebraMap A B r) := sorry

/-- The transported presentation sends a polynomial variable to the localized
image of that variable under the original presentation. -/
@[simp, stacks 051T "localized polynomial presentation variable"]
theorem presentationAway_X
    (π : MvPolynomial σ A →ₐ[A] B) (f : A) (i : σ) :
    presentationAway (σ := σ) π f (MvPolynomial.X i) =
      algebraMap B (Localization.Away (algebraMap A B f))
        (π (MvPolynomial.X i)) := sorry

/-- Tag `051T`: after giving its target the canonical localized coefficient
action, a transported polynomial presentation is the `aeval` map on its
localized images of the variables. -/
@[stacks 051T "localized polynomial presentation aeval"]
theorem presentationAwayAlgHom_eq_aeval
    (π : MvPolynomial σ A →ₐ[A] B) (f : A) :
    letI : Algebra (Localization.Away f)
      (Localization.Away (algebraMap A B f)) :=
      Localization.Away.Relative.algebraMapAlgebra (R := A) (S := B) f
    letI : IsScalarTower A (Localization.Away f)
      (Localization.Away (algebraMap A B f)) :=
      Localization.Away.Relative.algebraMapAlgebra_isScalarTower (R := A) (S := B) f
    presentationAwayAlgHom (σ := σ) π f =
      AlgHom.restrictScalars A
        (MvPolynomial.aeval
          (fun i ↦ algebraMap B (Localization.Away (algebraMap A B f))
            (π (MvPolynomial.X i))) :
          MvPolynomial σ (Localization.Away f) →ₐ[Localization.Away f]
            Localization.Away (algebraMap A B f)) := sorry

end MvPolynomial.Localization

/-! The coefficient-away scalar action is canonical but not globally unique:
activate this scope when treating `Localization.Away (C f)` as an
`Localization.Away f`-algebra. -/
scoped[MvPolynomial.Localization] attribute [instance 100]
  MvPolynomial.Localization.awayCAlgebra
  MvPolynomial.Localization.awayCScalarTower

section

open scoped MvPolynomial.Localization

variable {σ : Type u} {A : Type v} [CommRing A]
variable (f : A)

attribute [local instance] MvPolynomial.algebraMvPolynomial

#synth IsLocalization (Submonoid.powers (MvPolynomial.C (σ := σ) f))
  (MvPolynomial σ (Localization.Away f))
#synth Algebra (Localization.Away f)
  (Localization.Away (MvPolynomial.C (σ := σ) f))
#synth IsScalarTower A (Localization.Away f)
  (Localization.Away (MvPolynomial.C (σ := σ) f))

end
