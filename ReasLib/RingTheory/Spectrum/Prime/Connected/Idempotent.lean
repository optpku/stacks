module

public import Mathlib.Data.List.TFAE
public import Mathlib.RingTheory.Localization.Away.Lemmas
public import ReasLib.RingTheory.Ideal.Idempotent
public import ReasLib.RingTheory.Ideal.Quotient.PrimeSpectrum
public import ReasLib.RingTheory.Spectrum.Prime.Connected
public import ReasLib.Topology.ConnectedComponents.Clopen
import Mathlib.Tactic.CrossRefAttribute

/-!
# Connected pieces of prime spectra and idempotents

@stack 04PP
@stack 00EG
@stack 00EM

This leaf connects the intrinsic idempotent APIs for rings and ideals with connected components
and complementary open decompositions of affine prime spectra.
-/

@[expose] public section

open Set Topology

universe u

namespace PrimeSpectrum

variable {R : Type u} [CommRing R]

namespace IdempotentIdeal

/-- Lemma 10.22.1 (Tag `04PP`): closed unions of connected components of an affine spectrum are
exactly clopen intersections and exactly zero loci of idempotent-generated ideals. -/
@[stacks 04PP "closed component unions and idempotent-generated ideals"]
theorem tfae (T : Set (PrimeSpectrum R)) :
    List.TFAE
      [ IsClosed T ∧ ∀ x ∈ T, connectedComponent x ⊆ T
      , ∃ S : Set (Set (PrimeSpectrum R)), (∀ Z ∈ S, IsClopen Z) ∧ T = ⋂₀ S
      , ∃ I : Ideal R, I.IsGeneratedByIdempotents ∧ T = zeroLocus I
      ] := sorry

/-- A closed union of connected components of an affine spectrum is the zero locus of an
idempotent-generated ideal. -/
@[stacks 04PP "idempotent-generated zero-locus presentation"]
theorem exists_zeroLocus_eq (T : Set (PrimeSpectrum R))
    (hT : IsClosed T ∧ ∀ x ∈ T, connectedComponent x ⊆ T) :
    ∃ I : Ideal R, I.IsGeneratedByIdempotents ∧ T = zeroLocus I := sorry

/-- The idempotent-generated ideal defining a fixed closed subset of an affine spectrum is
unique whenever such a presentation exists. -/
@[stacks 04PP "uniqueness of the idempotent-generated ideal"]
theorem existsUnique_zeroLocus_eq (T : Set (PrimeSpectrum R))
    (hT : ∃ I : Ideal R, I.IsGeneratedByIdempotents ∧ T = zeroLocus I) :
    ∃! I : Ideal R, I.IsGeneratedByIdempotents ∧ T = zeroLocus I := sorry

end IdempotentIdeal

/-- Lemma 10.22.2: every connected component of an affine prime spectrum is the zero locus of an
ideal generated by idempotents. -/
@[stacks 00EG "connected component as an idempotent-generated zero locus"]
theorem exists_isGeneratedByIdempotents_connectedComponent_eq_zeroLocus
    (p : PrimeSpectrum R) :
    ∃ I : Ideal R, I.IsGeneratedByIdempotents ∧ connectedComponent p = zeroLocus I := sorry

/-- Lemma 10.22.2: if an idempotent-generated ideal cuts out one connected component, every
idempotent becomes zero or one in the corresponding quotient. -/
@[stacks 00EG "idempotents in a connected-component quotient"]
theorem idempotent_quotient_eq_zero_or_one_of_connectedComponent_eq_zeroLocus
    {p : PrimeSpectrum R} {I : Ideal R}
    (hI : I.IsGeneratedByIdempotents) (hzero : connectedComponent p = zeroLocus I) :
    ∀ ⦃e : R⦄, IsIdempotentElem e →
      Ideal.Quotient.mk I e = 0 ∨ Ideal.Quotient.mk I e = 1 := sorry

/-- Lemma 10.24.3: complementary open subsets of an affine prime spectrum are the basic opens
of a pair of complementary idempotents. -/
@[stacks 00EM "complementary open partition"]
theorem exists_idempotent_basicOpen_eq_of_isCompl_open {U V : Set (PrimeSpectrum R)}
    (hU : IsOpen U) (hV : IsOpen V) (hUV : IsCompl U V) :
    ∃ e : R, IsIdempotentElem e ∧ U = basicOpen e ∧ V = basicOpen (1 - e) := sorry

end PrimeSpectrum
