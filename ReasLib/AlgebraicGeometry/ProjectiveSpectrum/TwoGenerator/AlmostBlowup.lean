module

public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.TwoGenerator
public import ReasLib.AlgebraicGeometry.Scheme.AlmostBlowup
public import ReasLib.AlgebraicGeometry.Scheme.IdealSheafData.Spec

/-!
# Almost blowup square for a two-generator relation

The projective spectrum of the quotient by `f₂ * T₀ - f₁ * T₁` defines an almost blowup
square over the center generated by `f₁` and `f₂`.
-/

@[expose] public section

universe u

namespace AlgebraicGeometry.TwoGeneratorProj

/-- The structure morphism from the projective spectrum of
`A[T₀, T₁] ⧸ (f₂ * T₀ - f₁ * T₁)` forms an almost blowup square with the center generated by
`f₁` and `f₂`. -/
theorem toSpec_isAlmostBlowupSquare (A : CommRingCat.{u}) (f₁ f₂ : A) :
    IsAlmostBlowupSquare (toSpec A f₁ f₂)
      (Scheme.idealSheafDataOfIdealOnSpec (centerIdeal A f₁ f₂)) := sorry

end AlgebraicGeometry.TwoGeneratorProj
