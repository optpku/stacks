/-!
# Degree-one relative projective functors of algebraic spaces

The functor `F_1` of strict-equivalence classes of degree-one triples is recorded as a
size-safe functor over the functor of points of the base algebraic space.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.AlgebraicSpace Opposite
open SheafOfModules.RingedSite

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.RelativeProj

variable {S : Scheme.{u}} {X : AlgebraicSpace S}

/-- Affine-étale identification of sections of a graded algebra sheaf with a
`Type u` graded algebra, preserving the degree-zero unit and homogeneous
multiplication, via universe lift. -/
def IsEtaleSectionModel
    {S : Scheme.{u}} {X : AlgebraicSpace S}
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X))
    (U : smallEtaleSite X) {A : Type u}
    [CommRing A] (grading : ℕ → Submodule ℤ A) [GradedAlgebra grading]
    (model : ∀ d : ℕ,
      (𝒜 (Int.ofNat d)).val.obj (op U) ≃+ ULift.{u + 1} (grading d)) : Prop :=
  model 0 (𝒜.one (op U)) = ULift.up (1 : grading 0) ∧
    ∀ (d e : ℕ)
      (x : (𝒜 (Int.ofNat d)).val.obj (op U))
      (y : (𝒜 (Int.ofNat e)).val.obj (op U)),
      HEq
        (𝒜.mul (op U) (Int.ofNat d) (Int.ofNat e) x y)
        ((model (d + e)).symm
          (ULift.up ((SetLike.gMul grading).mul (model d x).down (model e y).down)))

/-- A compatible affine-étale section model carries the sheaf unit to the graded unit. -/
theorem IsEtaleSectionModel.one_eq
    {S : Scheme.{u}} {X : AlgebraicSpace S}
    {𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)}
    {U : smallEtaleSite X} {A : Type u}
    [CommRing A] {grading : ℕ → Submodule ℤ A} [GradedAlgebra grading]
    {model : ∀ d : ℕ,
      (𝒜 (Int.ofNat d)).val.obj (op U) ≃+ ULift.{u + 1} (grading d)}
    (hModel : IsEtaleSectionModel 𝒜 U grading model) :
    model 0 (𝒜.one (op U)) = ULift.up (1 : grading 0) :=
  hModel.1

/-- A compatible affine-étale section model carries homogeneous sheaf multiplication to
graded multiplication of the model. -/
theorem IsEtaleSectionModel.mul_eq
    {S : Scheme.{u}} {X : AlgebraicSpace S}
    {𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)}
    {U : smallEtaleSite X} {A : Type u}
    [CommRing A] {grading : ℕ → Submodule ℤ A} [GradedAlgebra grading]
    {model : ∀ d : ℕ,
      (𝒜 (Int.ofNat d)).val.obj (op U) ≃+ ULift.{u + 1} (grading d)}
    (hModel : IsEtaleSectionModel 𝒜 U grading model)
    (d e : ℕ)
    (x : (𝒜 (Int.ofNat d)).val.obj (op U))
    (y : (𝒜 (Int.ofNat e)).val.obj (op U)) :
    HEq
      (𝒜.mul (op U) (Int.ofNat d) (Int.ofNat e) x y)
      ((model (d + e)).symm
        (ULift.up ((SetLike.gMul grading).mul (model d x).down (model e y).down))) :=
  hModel.2 d e x y

/-- A quasi-coherent graded `𝒪_X`-algebra is generated as an `𝒜_0`-algebra by `𝒜_1` when,
on every affine object of the small étale site, the nonnegative homogeneous sections
admit a one-and-mul-preserving `Type u` graded-ring model generated in degree one. -/
def GeneratedByDegreeOne
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)) : Prop :=
  ∀ U : affineEtaleSite X,
    ∃ (A : Type u) (hA : CommRing A) (grading : ℕ → Submodule ℤ A)
      (hgraded : GradedAlgebra grading)
      (model : ∀ d : ℕ,
        (𝒜 (Int.ofNat d)).val.obj (op U.obj) ≃+ ULift.{u + 1} (grading d)),
      @IsEtaleSectionModel S X 𝒜 U.obj A hA grading hgraded model ∧
        @GradedAlgebra.GeneratedBy ℕ inferInstance A (Submodule ℤ A) hA.toCommSemiring
          inferInstance inferInstance grading hgraded.toGradedMonoid 1

/-- Degree-one generation is the affine-étale existence of a one-and-mul-preserving
`Type u` graded-ring model generated by its degree-one piece. -/
theorem generatedByDegreeOne_iff
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)) :
    GeneratedByDegreeOne 𝒜 ↔
      ∀ U : affineEtaleSite X,
        ∃ (A : Type u) (hA : CommRing A) (grading : ℕ → Submodule ℤ A)
          (hgraded : GradedAlgebra grading)
          (model : ∀ d : ℕ,
            (𝒜 (Int.ofNat d)).val.obj (op U.obj) ≃+ ULift.{u + 1} (grading d)),
          @IsEtaleSectionModel S X 𝒜 U.obj A hA grading hgraded model ∧
            @GradedAlgebra.GeneratedBy ℕ inferInstance A (Submodule ℤ A) hA.toCommSemiring
              inferInstance inferInstance grading hgraded.toGradedMonoid 1 :=
  Iff.rfl

/-- A degree-one relative projective-spectrum functor is a functor over the functor of
points of its base algebraic space, together with quasicoherence of the graded algebra. -/
structure DegreeOneFunctor {S : Scheme.{u}} (X : AlgebraicSpace S)
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)) where
  /-- The functor on schemes over `S` underlying `F_1`. -/
  toFunctor : (Over S)ᵒᵖ ⥤ Type u
  /-- The structural map to the functor of points of the base algebraic space. -/
  baseMap : toFunctor ⟶ X.functorOfPoints
  /-- Every graded piece of the underlying algebra sheaf is quasicoherent. -/
  algebra_isQuasicoherent : 𝒜.IsQuasicoherent

namespace DegreeOneFunctor

/-- Construct a degree-one functor from a functor over `X.functorOfPoints` and
quasicoherence of `𝒜`. -/
def ofFunctor {S : Scheme.{u}} {X : AlgebraicSpace S}
    {𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)}
    (toFunctor : (Over S)ᵒᵖ ⥤ Type u) (baseMap : toFunctor ⟶ X.functorOfPoints)
    (algebra_isQuasicoherent : 𝒜.IsQuasicoherent) :
    DegreeOneFunctor X 𝒜 where
  toFunctor := toFunctor
  baseMap := baseMap
  algebra_isQuasicoherent := algebra_isQuasicoherent

/-- The fiber of a degree-one functor over a point of the base functor. -/
abbrev pointOver {S : Scheme.{u}} {X : AlgebraicSpace S}
    {𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)}
    (F₁ : DegreeOneFunctor X 𝒜) (T : (Over S)ᵒᵖ)
    (t : X.functorOfPoints.obj T) : Type u :=
  { x : F₁.toFunctor.obj T // F₁.baseMap.app T x = t }

/-- A functor value canonically decomposes into its base point and the fiber over that
point. -/
def objIso {S : Scheme.{u}} {X : AlgebraicSpace S}
    {𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)}
    (F₁ : DegreeOneFunctor X 𝒜) (T : (Over S)ᵒᵖ) :
    F₁.toFunctor.obj T ≃ Σ t : X.functorOfPoints.obj T, F₁.pointOver T t :=
  (Equiv.sigmaFiberEquiv (F₁.baseMap.app T)).symm

/-- `objIso` is the inverse of the sigma-fiber equivalence of `baseMap.app`. -/
theorem objIso_eq {S : Scheme.{u}} {X : AlgebraicSpace S}
    {𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)}
    (F₁ : DegreeOneFunctor X 𝒜) (T : (Over S)ᵒᵖ) :
    objIso F₁ T = (Equiv.sigmaFiberEquiv (F₁.baseMap.app T)).symm :=
  rfl

/-- A degree-one functor is associated to triples when its points are strict-equivalence
classes of degree-one triples and its action is geometric pullback. -/
structure IsAssociatedToTriples {S : Scheme.{u}} {X : AlgebraicSpace S}
    {𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)}
    (F₁ : DegreeOneFunctor X 𝒜) (deg : DegreePieces 𝒜) where
  /-- The relation between a functor point and a representative triple. -/
  associated :
    ∀ T : Over S, F₁.toFunctor.obj (op T) → DegreeOneTriple 𝒜 deg T → Prop
  /-- Every functor point has a representative triple. -/
  exists_triple :
    ∀ (T : Over S) (x : F₁.toFunctor.obj (op T)),
      ∃ q : DegreeOneTriple 𝒜 deg T, associated T x q
  /-- Every triple represents a functor point. -/
  exists_point :
    ∀ (T : Over S) (q : DegreeOneTriple 𝒜 deg T),
      ∃ x : F₁.toFunctor.obj (op T), associated T x q
  /-- The structure morphism of a representative is its image in the base functor. -/
  base_eq :
    ∀ (T : Over S) (x : F₁.toFunctor.obj (op T)) (q : DegreeOneTriple 𝒜 deg T),
      associated T x q → q.morphism.app (op T) (𝟙 T) = F₁.baseMap.app (op T) x
  /-- Equality of points is exactly strict equivalence of representatives. -/
  eq_iff :
    ∀ (T : Over S) (x x' : F₁.toFunctor.obj (op T))
      (q q' : DegreeOneTriple 𝒜 deg T),
      associated T x q → associated T x' q' →
        (x = x' ↔ DegreeOneTriple.StrictlyEquivalent q q')
  /-- The functor action is represented by the canonical pullback of triples. -/
  associated_pullback :
    ∀ (T T' : Over S) (g : T' ⟶ T) (x : F₁.toFunctor.obj (op T))
      (q : DegreeOneTriple 𝒜 deg T),
      associated T x q →
        associated T' (F₁.toFunctor.map (op g) x) (DegreeOneTriple.pullback g q)

namespace IsAssociatedToTriples

/-- Construct an association of a degree-one functor with triples from the
point-representative correspondence and pullback compatibility. -/
def of {S : Scheme.{u}} {X : AlgebraicSpace S}
    {𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)}
    {F₁ : DegreeOneFunctor X 𝒜} {deg : DegreePieces 𝒜}
    (associated :
      ∀ T : Over S, F₁.toFunctor.obj (op T) → DegreeOneTriple 𝒜 deg T → Prop)
    (exists_triple :
      ∀ (T : Over S) (x : F₁.toFunctor.obj (op T)),
        ∃ q : DegreeOneTriple 𝒜 deg T, associated T x q)
    (exists_point :
      ∀ (T : Over S) (q : DegreeOneTriple 𝒜 deg T),
        ∃ x : F₁.toFunctor.obj (op T), associated T x q)
    (base_eq :
      ∀ (T : Over S) (x : F₁.toFunctor.obj (op T)) (q : DegreeOneTriple 𝒜 deg T),
        associated T x q → q.morphism.app (op T) (𝟙 T) = F₁.baseMap.app (op T) x)
    (eq_iff :
      ∀ (T : Over S) (x x' : F₁.toFunctor.obj (op T))
        (q q' : DegreeOneTriple 𝒜 deg T),
        associated T x q → associated T x' q' →
          (x = x' ↔ DegreeOneTriple.StrictlyEquivalent q q'))
    (associated_pullback :
      ∀ (T T' : Over S) (g : T' ⟶ T) (x : F₁.toFunctor.obj (op T))
        (q : DegreeOneTriple 𝒜 deg T),
        associated T x q →
          associated T' (F₁.toFunctor.map (op g) x) (DegreeOneTriple.pullback g q)) :
    F₁.IsAssociatedToTriples deg where
  associated := associated
  exists_triple := exists_triple
  exists_point := exists_point
  base_eq := base_eq
  eq_iff := eq_iff
  associated_pullback := associated_pullback

/-- Pull back a representative triple along a morphism of test schemes. -/
def pullback {S : Scheme.{u}} {X : AlgebraicSpace S}
    {𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)}
    {F₁ : DegreeOneFunctor X 𝒜} {deg : DegreePieces 𝒜}
    (_h : F₁.IsAssociatedToTriples deg) {T T' : Over S} (g : T' ⟶ T)
    (q : DegreeOneTriple 𝒜 deg T) : DegreeOneTriple 𝒜 deg T' :=
  DegreeOneTriple.pullback g q

/-- The point-representative correspondence and its pullback conditions hold
simultaneously. -/
theorem conditions_spec {S : Scheme.{u}} {X : AlgebraicSpace S}
    {𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)}
    {F₁ : DegreeOneFunctor X 𝒜} {deg : DegreePieces 𝒜}
    (h : F₁.IsAssociatedToTriples deg) :
    (∀ (T : Over S) (x : F₁.toFunctor.obj (op T)),
      ∃ q : DegreeOneTriple 𝒜 deg T, h.associated T x q) ∧
    (∀ (T : Over S) (q : DegreeOneTriple 𝒜 deg T),
      ∃ x : F₁.toFunctor.obj (op T), h.associated T x q) ∧
    (∀ (T : Over S) (x : F₁.toFunctor.obj (op T)) (q : DegreeOneTriple 𝒜 deg T),
      h.associated T x q →
        q.morphism.app (op T) (𝟙 T) = F₁.baseMap.app (op T) x) ∧
    (∀ (T : Over S) (x x' : F₁.toFunctor.obj (op T))
        (q q' : DegreeOneTriple 𝒜 deg T),
      h.associated T x q → h.associated T x' q' →
        (x = x' ↔ DegreeOneTriple.StrictlyEquivalent q q')) ∧
    (∀ (T T' : Over S) (g : T' ⟶ T) (x : F₁.toFunctor.obj (op T))
        (q : DegreeOneTriple 𝒜 deg T),
      h.associated T x q →
        h.associated T' (F₁.toFunctor.map (op g) x)
          (DegreeOneTriple.pullback g q)) :=
  sorry

end IsAssociatedToTriples

end DegreeOneFunctor

end AlgebraicGeometry.AlgebraicSpace.RelativeProj
