module

public import Mathlib.Algebra.Group.Idempotent
public import Mathlib.Algebra.Module.Projective
public import Mathlib.Data.ZMod.Basic
public import ReasLib.RingTheory.Flatness.LocallyFree

@[expose] public section

universe u

namespace PrefixOnes

/-- The length-`n` prefix-ones sequence in the product ring `ℕ → ZMod 2`. -/
def seq (n : ℕ) : ℕ → ZMod 2 :=
  fun i ↦ if i < n then 1 else 0

/-- Each prefix-ones sequence is an idempotent. -/
theorem seq_isIdempotentElem (n : ℕ) :
    IsIdempotentElem (seq n) := sorry

/-- The ideal generated by the prefix-ones sequences in `ℕ → ZMod 2`. -/
def ideal : Ideal (ℕ → ZMod 2) :=
  Ideal.span (Set.range seq)

/-- The prefix-ones ideal is projective as a module over `ℕ → ZMod 2`. -/
instance instProjective : Module.Projective (ℕ → ZMod 2) ideal := sorry

/-- The prefix-ones ideal is not locally free as a module over `ℕ → ZMod 2`. -/
theorem not_locallyFree : ¬ Module.LocallyFree (ℕ → ZMod 2) ideal := sorry

end PrefixOnes

namespace Module

/-- Some commutative ring admits an ideal that is projective but not locally free as a module. -/
theorem exists_ideal_projective_not_locallyFree :
    ∃ (R : Type u) (_ : CommRing R) (I : Ideal R),
      Projective R I ∧ ¬ LocallyFree R I := sorry

end Module
