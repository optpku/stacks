module

public import Mathlib.NumberTheory.Cyclotomic.Gal
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

open IsCyclotomicExtension
open Module
open scoped IntermediateField

universe u v

namespace FieldExtension

section

variable {K : Type u} [Field K] {L : Type v} [Field L] [Algebra K L]
variable {n : ℕ} [NeZero n] {ζ : L}

/-- A simple extension generated by a primitive `n`th root of unity is Galois, and its degree
divides the cardinality of `(ZMod n)ˣ`. -/
theorem adjoinPrimitiveRootIsGaloisAndFinrankDvdCardUnits
    (hζ : IsPrimitiveRoot ζ n) :
    IsGalois K K⟮ζ⟯ ∧ finrank K K⟮ζ⟯ ∣ Nat.card (ZMod n)ˣ := by
  -- Local instance justification (proof-local temporary data): equip the adjoined field with the cyclotomic-extension structure induced by the primitive root.
  letI : IsCyclotomicExtension {n} K K⟮ζ⟯ :=
    (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin
      n K L (K⟮ζ⟯ : IntermediateField K L) hζ).2 rfl
  -- Local instance justification (proof-local temporary data): derive Galoisness from the cyclotomic-extension structure.
  letI : IsGalois K K⟮ζ⟯ := isGalois {n} K K⟮ζ⟯
  refine ⟨inferInstance, ?_⟩
  -- Local instance justification (proof-local temporary data): obtain finite dimensionality for the automorphism-cardinality formula.
  letI : FiniteDimensional K K⟮ζ⟯ := finiteDimensional {n} K K⟮ζ⟯
  have hcard : Nat.card Gal(K⟮ζ⟯/K) ∣ Nat.card (ZMod n)ˣ := by
    let hμ := zeta_spec n K K⟮ζ⟯
    exact Subgroup.card_dvd_of_injective (hμ.autToPow K) (hμ.autToPow_injective K)
  rw [← IsGalois.card_aut_eq_finrank K K⟮ζ⟯]
  exact hcard

end

section

variable {K : Type u} [Field K] {L : Type v} [Field L] [Algebra K L]
variable {p : ℕ} [Fact p.Prime] {ζ : L}

/-- Lemma 9.24.2 (Tag 0EXN): adjoining a primitive `p`th root of unity for a prime `p` gives a
Galois extension whose degree divides `p - 1`. -/
theorem adjoinPrimitiveRootIsGaloisAndFinrankDvdPrimeSubOne
    (hζ : IsPrimitiveRoot ζ p) :
    IsGalois K K⟮ζ⟯ ∧ finrank K K⟮ζ⟯ ∣ p - 1 := by
  -- Local instance justification (proof-local temporary data): a prime index is nonzero for the general cyclotomic theorem.
  letI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  rcases adjoinPrimitiveRootIsGaloisAndFinrankDvdCardUnits (K := K) (L := L) hζ with ⟨hgal, hdvd⟩
  refine ⟨hgal, ?_⟩
  simpa [Nat.card_eq_fintype_card, ZMod.card_units p] using hdvd

end

end FieldExtension
