module

public import ReasLib.RingTheory.Kaehler.NoetherDifferent.LocalizedPresentation
public import ReasLib.RingTheory.Kaehler.Quotient.FittingIdeal

@[expose] public section

universe u

namespace Algebra.LocalizedPresentation.Univariate

/-- For a quasi-finite univariate localized hypersurface over a Noetherian ring,
the Noether different is generated by the image of the polynomial derivative. -/
theorem noetherDifferent_eq_span_pderiv
    (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [IsNoetherianRing A]
    [Algebra.FiniteType A B] [Algebra.QuasiFinite A B]
    (f h : MvPolynomial (Fin 1) A) (q : Localization.Away h →ₐ[A] B)
    (h_q : Function.Surjective q)
    (h_ker_q : RingHom.ker q.toRingHom =
      Ideal.span
        {algebraMap (MvPolynomial (Fin 1) A) (Localization.Away h) f}) :
    KaehlerDifferential.noetherDifferent A B =
      Ideal.span
        {q (algebraMap (MvPolynomial (Fin 1) A) (Localization.Away h)
          (MvPolynomial.pderiv 0 f))} := sorry

/-- For a quasi-finite univariate localized hypersurface over a Noetherian ring,
the zeroth Fitting ideal of its Kähler differentials is generated by the image
of the polynomial derivative. -/
theorem fittingIdeal_eq_span_pderiv
    (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [IsNoetherianRing A]
    [Algebra.FiniteType A B] [Algebra.QuasiFinite A B]
    (f h : MvPolynomial (Fin 1) A) (q : Localization.Away h →ₐ[A] B)
    (h_q : Function.Surjective q)
    (h_ker_q : RingHom.ker q.toRingHom =
      Ideal.span
        {algebraMap (MvPolynomial (Fin 1) A) (Localization.Away h) f}) :
    fittingIdeal B (KaehlerDifferential A B) 0 =
      Ideal.span
        {q (algebraMap (MvPolynomial (Fin 1) A) (Localization.Away h)
          (MvPolynomial.pderiv 0 f))} := sorry

end Algebra.LocalizedPresentation.Univariate
