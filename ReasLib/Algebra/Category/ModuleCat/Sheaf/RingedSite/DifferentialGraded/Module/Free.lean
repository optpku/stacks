module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Free.Graded
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.DifferentialGraded.Module.Bimod.Equivalence
public import ReasLib.Algebra.Homology.GradedObject.ZeroDifferential
public import ReasLib.CategoryTheory.Monoidal.Bimod.Free
import Mathlib.Tactic.CrossRefAttribute

/-!
# Free differential graded modules

The free right module over a differential graded algebra is obtained by tensoring an underlying
cochain complex with the algebra.  For a graded sheaf of generators, the input complex is the
zero-differential complex on the degreewise free module sheaves.
-/

@[expose] public section

open CategoryTheory
open scoped SheafOfModules.RingedSite.DifferentialGradedAlgebra
open scoped SheafOfModules.RingedSite.DifferentialGradedModule

noncomputable section

universe u v w

namespace SheafOfModules.RingedSite.DifferentialGradedModule

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
variable [HasWeakSheafify J AddCommGrpCat.{w}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
variable [UnivLE.{max u v, w}]
variable {O : Sheaf J CommRingCat.{w}}

/-- The free right DG `A`-module functor on an underlying cochain complex. -/
@[stacks 0FSF "free differential graded module functor"]
noncomputable def freeFunctor (A : DGA(O)) :
    CochainComplex (DifferentialGradedAlgebra.moduleCategory (J := J) (𝒪 := O)) ℤ ⥤
      Mod(A, d) :=
  CategoryTheory.Bimod.RightModule.free A.toMon ⋙ ofBimodFunctor A

/-- The underlying complex of the free right DG module on `K` is `K ⊗ A`. -/
@[stacks 0FSF "underlying complex of a free DG module"]
theorem freeFunctor_obj_toComplex (A : DGA(O))
    (K : CochainComplex
      (DifferentialGradedAlgebra.moduleCategory (J := J) (𝒪 := O)) ℤ) :
    ((freeFunctor A).obj K).toComplex =
      HomologicalComplex.tensorObj K A.toComplex := sorry

/-- The underlying cochain map of a mapped free DG-module morphism is tensoring the original map
with the identity of `A`. -/
theorem freeFunctor_map_toCochainMap (A : DGA(O))
    {K L : CochainComplex
      (DifferentialGradedAlgebra.moduleCategory (J := J) (𝒪 := O)) ℤ}
    (f : K ⟶ L) :
    ((freeFunctor A).map f).toCochainMap =
      HomologicalComplex.tensorHom f (CategoryStruct.id A.toComplex) := sorry

section GradedSheaf

variable [HasWeakSheafify J (Type w)]

/-- The free right DG `A`-module generated by a sheaf with an integer-valued degree map. -/
@[stacks 0FSF "free DG module on a graded sheaf"]
noncomputable def freeOnGradedSheaf (A : DGA(O)) :
    IntGradedSheaf.{u, v, w} J ⥤ Mod(A, d) :=
  SheafOfModules.freeOnGradedSheaf (ringSheaf J O) ⋙
    (GradedObject.zeroDifferentialFunctor (C := _)) ⋙
      freeFunctor A

/-- The underlying complex of `A[S]` is the tensor product of `A` with the zero-differential
complex on the degreewise free module sheaves generated by `S`. -/
@[stacks 0FSF "underlying complex of A[S]"]
theorem freeOnGradedSheaf_obj_toComplex (A : DGA(O))
    (S : IntGradedSheaf.{u, v, w} J) :
    ((freeOnGradedSheaf A).obj S).toComplex =
      HomologicalComplex.tensorObj
        (GradedObject.zeroDifferential
          ((SheafOfModules.freeOnGradedSheaf (ringSheaf J O)).obj S))
        A.toComplex := sorry

/-- The generators of `A[S]` are first separated into degree fibers and freely linearized before
the standard free DG-module functor is applied. -/
theorem freeOnGradedSheaf_obj (A : DGA(O))
    (S : IntGradedSheaf.{u, v, w} J) :
    (freeOnGradedSheaf A).obj S =
      (freeFunctor A).obj
        (GradedObject.zeroDifferential
          ((SheafOfModules.freeOnGradedSheaf (ringSheaf J O)).obj S)) := sorry

end GradedSheaf

end SheafOfModules.RingedSite.DifferentialGradedModule

end
