module

public import ReasLib.CategoryTheory.Sites.Point.Refinement.Saturation.Stage.Category
public import Mathlib.CategoryTheory.Functor.OfSequence

/-!
# Sequential saturation towers

This leaf owns the reusable natural-number recursion of saturation stages and
the comparison maps generated by its successor steps.
-/

@[expose] public section

open CategoryTheory Limits

universe u v q r r'

noncomputable section

namespace CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered
namespace OrderedRefinement
namespace Saturation

variable {C : Type u} [Category.{v} C]
variable {ι : Type r} [Preorder ι]
variable {J : GrothendieckTopology C}
variable {S : ιᵒᵖ ⥤ C}
variable [LocallySmall.{q} C]
variable [EssentiallySmall.{q} ιᵒᵖ]
variable [HasColimitsOfShape (EssentiallySmallFiber.fiber S).Elementsᵒᵖ (Type q)]
variable {P : Cᵒᵖ ⥤ Type q}
variable {x y : (EssentiallySmallFiber.presheafFiber S).obj P}

/-- A sequential saturation tower. Its successor maps realize all requests at the
preceding stage, and all longer comparisons are derived from those maps. -/
structure Tower where
  /-- The saturation stage at each natural-number level. -/
  stage : ℕ → Stage.{u, v, q, r, r'} (J := J) S P x y
  /-- The compatible refinement from a stage to its successor. -/
  step : ∀ n : ℕ, stage n ⟶ stage (n + 1)
  /-- Every successor map realizes all requests at its source target. -/
  realizes : ∀ n : ℕ, (step n).realizesAll

namespace Tower

/-- Saturation towers are determined by their stages and successor maps. -/
@[ext]
theorem ext
    {T U : Tower (J := J) (S := S) (P := P) (x := x) (y := y)}
    (hstage : T.stage = U.stage) (hstep : HEq T.step U.step) :
    T = U := sorry

/-- The universe-lifted natural-number index used to view a tower as a based stage diagram. -/
abbrev Index : Type r' := ULift.{r'} ℕ

/-- The ordinary natural-number diagram canonically generated by the successor maps of a
saturation tower. -/
noncomputable def natDiagram
    (T : Tower (J := J) (S := S) (P := P) (x := x) (y := y)) :
    ℕ ⥤ Stage.{u, v, q, r, r'} (J := J) S P x y :=
  Functor.ofSequence T.step

/-- Read the map between any two ordered levels from the canonical natural-number diagram. -/
noncomputable def hom
    (T : Tower (J := J) (S := S) (P := P) (x := x) (y := y))
    {n m : ℕ} (hnm : n ≤ m) : T.stage n ⟶ T.stage m :=
  T.natDiagram.map (homOfLE hnm)

namespace natDiagram

/-- The object at `n` of the natural-number diagram is the `n`th tower stage. -/
@[simp]
theorem obj
    (T : Tower (J := J) (S := S) (P := P) (x := x) (y := y)) (n : ℕ) :
    T.natDiagram.obj n = T.stage n := sorry

/-- The successor map in the natural-number diagram is the specified tower step. -/
@[simp]
theorem mapSucc
    (T : Tower (J := J) (S := S) (P := P) (x := x) (y := y)) (n : ℕ) :
    T.natDiagram.map (homOfLE (Nat.le_succ n)) = T.step n := sorry

/-- An arbitrary map of the natural-number diagram is the corresponding tower comparison. -/
@[simp]
theorem map
    (T : Tower (J := J) (S := S) (P := P) (x := x) (y := y))
    {n m : ℕ} (hnm : n ≤ m) :
    T.natDiagram.map (homOfLE hnm) = T.hom hnm := sorry

end natDiagram

namespace hom

/-- The derived comparison from a tower stage to itself is the identity. -/
@[simp]
theorem refl (T : Tower (J := J) (S := S) (P := P) (x := x) (y := y)) (n : ℕ) :
    T.hom (le_rfl : n ≤ n) = 𝟙 (T.stage n) := sorry

/-- The comparison to the next level is the specified tower step. -/
@[simp]
theorem step (T : Tower (J := J) (S := S) (P := P) (x := x) (y := y)) (n : ℕ) :
    T.hom (Nat.le_succ n) = T.step n := sorry

/-- Extending a derived comparison by one successor composes it with that successor map. -/
@[simp]
theorem succ (T : Tower (J := J) (S := S) (P := P) (x := x) (y := y))
    {n m : ℕ} (hnm : n ≤ m) :
    T.hom (Nat.le_succ_of_le hnm) = T.hom hnm ≫ T.step m := sorry

/-- Derived tower comparisons compose along chains of natural-number inequalities. -/
theorem comp (T : Tower (J := J) (S := S) (P := P) (x := x) (y := y))
    {n m p : ℕ} (hnm : n ≤ m) (hmp : m ≤ p) :
    T.hom (le_trans hnm hmp) = T.hom hnm ≫ T.hom hmp := sorry

end hom

end Tower
end Saturation
end OrderedRefinement
end CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered
