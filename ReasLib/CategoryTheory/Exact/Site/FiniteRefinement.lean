module

public import ReasLib.CategoryTheory.Exact.Site
public import ReasLib.CategoryTheory.Sites.FiniteRefinement

@[expose] public section

/-!
# Finite Refinements for Exact-Structure Sites

Every covering sieve in the topology generated by singleton admissible epimorphisms contains a
singleton admissible-epimorphism covering sieve.  Consequently these topologies have finite
refinements, and have enough points whenever the underlying category has finite limits.
-/

open CategoryTheory Limits

universe u v

namespace CategoryTheory.ExactStructure

variable {A : Type u} [Category.{v} A] [Preadditive A] [HasFiniteProducts A]

/-- Every covering sieve for an exact structure contains a singleton admissible-epimorphism
covering sieve. -/
@[stacks 05SF "singleton admissible-epimorphism refinement"]
theorem coveringSieve_has_singletonAdmissibleEpi (E : ExactStructure A) {X : A} {S : Sieve X}
    (hS : S ∈ E.topology X) :
    ∃ (Y : A) (p : Y ⟶ X), E.AdmissibleEpi p ∧
      Sieve.generate (Presieve.singleton p) ≤ S := sorry

/-- The topology of an exact structure has a finite refinement at every object. -/
@[stacks 05SF "finite refinement of the exact-structure topology"]
theorem topology_hasFiniteRefinement (E : ExactStructure A) (X : A) :
    GrothendieckTopology.HasFiniteRefinement E.topology X := sorry

/-- If the underlying exact category has finite limits, its admissible-epimorphism topology has
enough points. -/
@[stacks 05SF "enough points for the exact-structure topology"]
theorem topology_hasEnoughPoints (E : ExactStructure A) [HasFiniteLimits A] :
    GrothendieckTopology.HasEnoughPoints.{max (u + 1) (v + 1)} E.topology := sorry

end CategoryTheory.ExactStructure
