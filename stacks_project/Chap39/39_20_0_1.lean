module

import ReasLib.AlgebraicGeometry.Scheme.PreRelation.QuotientPresheaf
import StacksCheckRecall

universe u

/- 39.20.0.1: the presheaf underlying the quotient sheaf of
Definition 39.20.1 is independent of the standard topology `τ`; it is the
objectwise quotient presheaf `quotientPresheaf`, sending `T` to the quotient
of `T ⟶ U` by the equivalence relation generated by `P.pointRel T`. -/
@[stacks 02VF] #check (@AlgebraicGeometry.Scheme.PreRelation.quotientPresheaf :
  ∀ {S : AlgebraicGeometry.Scheme.{u}} {U : CategoryTheory.Over S},
    AlgebraicGeometry.Scheme.PreRelation U →
      CategoryTheory.Functor (CategoryTheory.Over S)ᵒᵖ (Type u))

#check (@AlgebraicGeometry.Scheme.PreRelation.quotientPresheaf_obj :
  ∀ {S : AlgebraicGeometry.Scheme.{u}} {U : CategoryTheory.Over S}
    (P : AlgebraicGeometry.Scheme.PreRelation U) (T : CategoryTheory.Over S),
    P.quotientPresheaf.obj (Opposite.op T) = Quot (P.pointRel T))
