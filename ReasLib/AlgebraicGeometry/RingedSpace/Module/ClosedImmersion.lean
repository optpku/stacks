module

public import Mathlib.CategoryTheory.MorphismProperty.Composition
public import Mathlib.Topology.Sheaves.LocallySurjective
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.LocalGeneration
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.PushforwardContinuous.LocallySurjective
public import ReasLib.AlgebraicGeometry.RingedSpace.IdealSubobject.Kernel
public import ReasLib.AlgebraicGeometry.RingedSpace.Module.Site
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Closed immersions of ringed spaces

This file defines closed immersions of ringed spaces:

- `RingedSpace.Hom.idealSheaf i`: kernel of `𝒪_X → i_*𝒪_Z`
- `RingedSpace.Hom.idealSheafι i`: its canonical inclusion into `𝒪_X`
- `RingedSpace.IsClosedImmersion i`: closed embedding + locally surjective + kernel locally generated
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Topology
open TopCat.Presheaf
open AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.RingedSpace

namespace Hom

/-- The ideal sheaf of a morphism of ringed spaces as a subobject of the ambient structure
module. -/
@[stacks 01C2 "kernel ideal subobject"]
noncomputable abbrev idealSheafSubobject
    {X Z : RingedSpace.{u}} (i : Z ⟶ X) :
    Subobject (SheafOfModules.unit X.ringCatSheaf : X.Modules) :=
  kernelIdealSubobject i

/-- The ideal sheaf of a morphism of ringed spaces is the kernel of its canonical map
`𝒪_X ⟶ i_*𝒪_Z`. -/
@[stacks 01C2 "kernel ideal sheaf"]
noncomputable abbrev idealSheaf
    {X Z : RingedSpace.{u}} (i : Z ⟶ X) : X.Modules :=
  kernelIdealSheaf i

/-- The canonical inclusion of the ideal sheaf of a ringed-space morphism into the ambient
structure module. -/
@[stacks 01C2 "kernel ideal sheaf inclusion"]
noncomputable abbrev idealSheafι
    {X Z : RingedSpace.{u}} (i : Z ⟶ X) :
    idealSheaf i ⟶ SheafOfModules.unit X.ringCatSheaf :=
  kernelIdealι i

/-- The ideal-sheaf inclusion is annihilated by the canonical map `𝒪_X ⟶ i_*𝒪_Z`. -/
@[reassoc, stacks 01C2 "kernel ideal sheaf equation"]
theorem idealSheafι_comp {X Z : RingedSpace.{u}} (i : Z ⟶ X) :
    idealSheafι i ≫
      SheafOfModules.unitToPushforwardObjUnit (toRingCatSheafHom i) = 0 := sorry

end Hom

/-- A morphism of ringed spaces is a closed immersion if the underlying map is a closed
embedding, the structure sheaf map is locally surjective, and its kernel ideal sheaf is
locally generated by sections. -/
@[stacks 01C2]
class IsClosedImmersion
    {X Z : RingedSpace.{u}} (i : Z ⟶ X) : Prop
    extends Sheaf.IsLocallySurjective (RingedSpace.Hom.commRingSheafPushforwardMap i) where
  /-- The underlying continuous map is a closed embedding. -/
  isClosedEmbedding : Topology.IsClosedEmbedding i.hom.base
  /-- The kernel ideal sheaf is locally generated by sections. -/
  idealSheafLocallyGenerated :
    SheafOfModules.IsLocallyGeneratedBySections (Hom.idealSheaf i)

namespace IsClosedImmersion

variable {X Z : RingedSpace.{u}} {i : Z ⟶ X}

/-- The morphism-property view of `IsClosedImmersion`, used by composition and localization APIs. -/
@[stacks 01C2 "closed-immersion morphism property"]
abbrev morphismProperty : MorphismProperty RingedSpace.{u} :=
  fun {_ _} i => IsClosedImmersion i

/-- Every isomorphism of ringed spaces is a closed immersion. -/
@[stacks 01C2 "isomorphisms are closed immersions", instance]
theorem of_isIso (i : Z ⟶ X) [IsIso i] : IsClosedImmersion i := sorry

/-- A composite of closed immersions of ringed spaces is a closed immersion. -/
@[stacks 01C2 "composition of closed immersions", instance]
theorem comp {Y : RingedSpace.{u}} (f : Z ⟶ Y) (g : Y ⟶ X)
    [IsClosedImmersion f] [IsClosedImmersion g] :
    IsClosedImmersion (f ≫ g) := sorry

/-- Closed immersions of ringed spaces form a multiplicative morphism property. -/
@[stacks 01C2 "closed immersions form a multiplicative property"]
instance isMultiplicative :
    MorphismProperty.IsMultiplicative morphismProperty := sorry

/-- Closed immersions of ringed spaces are invariant under source and target isomorphisms. -/
@[stacks 01C2 "closed immersions respect isomorphisms"]
instance respectsIso :
    MorphismProperty.RespectsIso morphismProperty := sorry

/-- The ideal sheaf of a closed immersion is canonically locally generated by sections. -/
@[stacks 01C2 "locally generated kernel"]
theorem idealSheaf_isLocallyGeneratedBySections [IsClosedImmersion i] :
    SheafOfModules.IsLocallyGeneratedBySections (Hom.idealSheaf i) := sorry

/-- The categorical kernel of the ambient-to-pushed-forward structure-module map of a closed
immersion is locally generated by sections. This bridge makes the kernel presentation available
without unfolding the commutative-ring-sheaf model of `Hom.idealSheaf`. -/
@[stacks 01C2 "structure module kernel"]
theorem kernel_isLocallyGeneratedBySections [IsClosedImmersion i] :
    SheafOfModules.IsLocallyGeneratedBySections
      (kernel (SheafOfModules.unitToPushforwardObjUnit
        (RingedSpace.Hom.toRingCatSheafHom i))) := sorry

/-- The structure-sheaf map of a closed immersion is locally surjective. -/
theorem isLocallySurjective (h : IsClosedImmersion i) :
    Sheaf.IsLocallySurjective (RingedSpace.Hom.commRingSheafPushforwardMap i) := sorry

/-- After forgetting commutativity, the structure-sheaf map of a closed immersion remains
locally surjective. -/
@[stacks 01C2 "underlying ring-sheaf quotient"]
theorem ringSheafMap_isLocallySurjective [IsClosedImmersion i] :
    Sheaf.IsLocallySurjective (RingedSpace.Hom.toRingCatSheafHom i) := sorry

/-- The canonical map from the ambient structure module onto the pushed-forward source
structure module is an epimorphism for a closed immersion. -/
@[stacks 01C2 "structure module quotient"]
theorem structureModuleMap_epi [IsClosedImmersion i] :
    Epi (SheafOfModules.unitToPushforwardObjUnit
      (RingedSpace.Hom.toRingCatSheafHom i)) := sorry

/-- The closed-embedding, local-surjectivity, and local-generation conditions construct a
closed immersion of ringed spaces. -/
@[stacks 01C2 "constructor"]
theorem of_source_spec
    (hclosed : Topology.IsClosedEmbedding i.hom.base)
    (hsurj : Sheaf.IsLocallySurjective (RingedSpace.Hom.commRingSheafPushforwardMap i))
    (hgen : SheafOfModules.IsLocallyGeneratedBySections (Hom.idealSheaf i)) :
    IsClosedImmersion i := sorry

/-- A morphism of ringed spaces is a closed immersion exactly when its underlying map is a closed
embedding, its structure-sheaf map is locally surjective, and its kernel ideal is locally
generated. -/
@[stacks 01C2 "characterization"]
theorem iff :
    IsClosedImmersion i ↔
      Topology.IsClosedEmbedding i.hom.base ∧
        Sheaf.IsLocallySurjective (RingedSpace.Hom.commRingSheafPushforwardMap i) ∧
          SheafOfModules.IsLocallyGeneratedBySections (Hom.idealSheaf i) := sorry

/-- A closed immersion satisfies the closed-embedding, local-surjectivity, and
locally-generated-kernel conditions. -/
theorem source_spec (h : IsClosedImmersion i) :
    Topology.IsClosedEmbedding i.hom.base ∧
      Sheaf.IsLocallySurjective (RingedSpace.Hom.commRingSheafPushforwardMap i) ∧
        SheafOfModules.IsLocallyGeneratedBySections (Hom.idealSheaf i) := sorry

end IsClosedImmersion

variable {X Z : RingedSpace.{u}} {i : Z ⟶ X} [IsClosedImmersion i]

variable {Y : RingedSpace.{u}} {f : X ⟶ Y} {g : Y ⟶ Z}
  [IsClosedImmersion f] [IsClosedImmersion g]

end AlgebraicGeometry.RingedSpace
