module

public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic
public import ReasLib.RingTheory.GradedAlgebra.Quotient
public import ReasLib.RingTheory.MvPolynomial.StandardGrading

/-!
# The projective spectrum of a two-generator linear relation

This module constructs the standard graded quotient
`A[T₀, T₁] ⧸ (f₂ * T₀ - f₁ * T₁)` and its canonical structure morphism to `Spec A`.
-/

@[expose] public section

open CategoryTheory

noncomputable section

universe u

namespace AlgebraicGeometry.TwoGeneratorProj

/-- The ideal of `A` generated by `f₁` and `f₂`. -/
def centerIdeal (A : CommRingCat.{u}) (f₁ f₂ : A) : Ideal A :=
  Ideal.span {f₁, f₂}

/-- The defining formula for the two-generator center ideal. -/
theorem centerIdeal_def (A : CommRingCat.{u}) (f₁ f₂ : A) :
    centerIdeal A f₁ f₂ = Ideal.span {f₁, f₂} := sorry

/-- The homogeneous linear relation `f₂ * T₀ - f₁ * T₁`. -/
def relation (A : CommRingCat.{u}) (f₁ f₂ : A) : MvPolynomial (Fin 2) A :=
  MvPolynomial.C f₂ * MvPolynomial.X (0 : Fin 2) -
    MvPolynomial.C f₁ * MvPolynomial.X (1 : Fin 2)

/-- The relation `f₂ * T₀ - f₁ * T₁` is homogeneous of degree one. -/
theorem relation_mem_degreeOne (A : CommRingCat.{u}) (f₁ f₂ : A) :
    relation A f₁ f₂ ∈ MvPolynomial.standardGrading (Fin 2) A 1 := sorry

/-- The principal ideal generated by the homogeneous linear relation. -/
def relationIdeal (A : CommRingCat.{u}) (f₁ f₂ : A) :
    Ideal (MvPolynomial (Fin 2) A) :=
  Ideal.span {relation A f₁ f₂}

/-- The defining formula for the principal relation ideal. -/
theorem relationIdeal_def (A : CommRingCat.{u}) (f₁ f₂ : A) :
    relationIdeal A f₁ f₂ = Ideal.span {relation A f₁ f₂} := sorry

/-- The coordinate ring `A[T₀, T₁] ⧸ (f₂ * T₀ - f₁ * T₁)`. -/
abbrev CoordinateRing (A : CommRingCat.{u}) (f₁ f₂ : A) :=
  MvPolynomial (Fin 2) A ⧸ relationIdeal A f₁ f₂

/-- The canonical quotient algebra map to the two-generator coordinate ring. -/
def quotientMap (A : CommRingCat.{u}) (f₁ f₂ : A) :
    MvPolynomial (Fin 2) A →ₐ[A] CoordinateRing A f₁ f₂ :=
  Ideal.Quotient.mkₐ A (relationIdeal A f₁ f₂)

/-- The defining linear relation maps to zero in the coordinate ring. -/
@[simp]
theorem quotientMap_relation_eq_zero (A : CommRingCat.{u}) (f₁ f₂ : A) :
    quotientMap A f₁ f₂ (relation A f₁ f₂) = 0 := sorry

/-- The quotient grading induced by total degree on `A[T₀, T₁]`. -/
noncomputable def grading (A : CommRingCat.{u}) (f₁ f₂ : A) (n : ℕ) :
    Submodule A (CoordinateRing A f₁ f₂) :=
  GradedAlgebra.Quotient.grading
    (MvPolynomial.standardGrading (Fin 2) A) (relationIdeal A f₁ f₂) n

/-- The quotient grading carries its canonical graded-algebra structure. -/
noncomputable instance instGradedAlgebra (A : CommRingCat.{u}) (f₁ f₂ : A) :
    GradedAlgebra (grading A f₁ f₂) :=
  GradedAlgebra.Quotient.spanSingletonGradedAlgebra
    (MvPolynomial.standardGrading (Fin 2) A)
    ⟨1, relation_mem_degreeOne A f₁ f₂⟩

/-- The projective spectrum of the explicitly graded two-generator quotient. -/
abbrev ProjectiveScheme (A : CommRingCat.{u}) (f₁ f₂ : A) :=
  Proj (grading A f₁ f₂)

/-- The coefficient-ring homomorphism into the degree-zero quotient component. -/
def degreeZeroAlgebraMap (A : CommRingCat.{u}) (f₁ f₂ : A) :
    A →+* grading A f₁ f₂ 0 where
  toFun r :=
    ⟨algebraMap A (CoordinateRing A f₁ f₂) r, by
      change Ideal.Quotient.mk (relationIdeal A f₁ f₂) (MvPolynomial.C r) ∈
        grading A f₁ f₂ 0
      exact GradedAlgebra.Quotient.mk_mem_grading
        (MvPolynomial.standardGrading (Fin 2) A) (relationIdeal A f₁ f₂)
        (@MvPolynomial.isHomogeneous_C (Fin 2) A _ r)⟩
  map_one' := Subtype.ext (map_one (algebraMap A (CoordinateRing A f₁ f₂)))
  map_mul' r s :=
    Subtype.ext (map_mul (algebraMap A (CoordinateRing A f₁ f₂)) r s)
  map_zero' := Subtype.ext (map_zero (algebraMap A (CoordinateRing A f₁ f₂)))
  map_add' r s :=
    Subtype.ext (map_add (algebraMap A (CoordinateRing A f₁ f₂)) r s)

/-- The degree-zero coefficient map sends `r` to the quotient class of `MvPolynomial.C r`. -/
theorem degreeZeroAlgebraMap_apply (A : CommRingCat.{u}) (f₁ f₂ r : A) :
    (degreeZeroAlgebraMap A f₁ f₂ r : CoordinateRing A f₁ f₂) =
      quotientMap A f₁ f₂ (MvPolynomial.C r) := sorry

/-- The canonical structure morphism from the two-generator projective spectrum to `Spec A`. -/
noncomputable def toSpec (A : CommRingCat.{u}) (f₁ f₂ : A) :
    ProjectiveScheme A f₁ f₂ ⟶ Spec A :=
  Proj.toSpecZero (grading A f₁ f₂) ≫
    Spec.map (CommRingCat.ofHom (degreeZeroAlgebraMap A f₁ f₂))

/-- The two-generator structure morphism is the canonical degree-zero Proj morphism followed by
the coefficient-spectrum map. -/
theorem toSpec_def (A : CommRingCat.{u}) (f₁ f₂ : A) :
    toSpec A f₁ f₂ =
      Proj.toSpecZero (grading A f₁ f₂) ≫
        Spec.map (CommRingCat.ofHom (degreeZeroAlgebraMap A f₁ f₂)) := sorry

end AlgebraicGeometry.TwoGeneratorProj
