module

public import Mathlib.RingTheory.TensorProduct.Maps
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import ReasLib.RingTheory.ReesAlgebra.BlowupChart.Map
public import ReasLib.RingTheory.Ideal.PowerTorsion

/-!
# Base change of affine blowup charts

The comparison map is constructed explicitly from the graded Rees-algebra map
and the tensor-product universal property.  Its API does not expose a chosen
witness.
-/

@[expose] public section

noncomputable section

open scoped AffineBlowupChart TensorProduct

universe u v

namespace AffineBlowupChart

variable {R : Type u} [CommRing R]

/-- The canonical tensor-product comparison between affine blowup charts attached to compatible
center data. -/
@[stacks 0BIP "affine blowup chart tensor comparison"]
noncomputable def tensorMap
    (S : Type v) [CommRing S] [alg : Algebra R S]
    (I : Ideal R) (J : Ideal S) {hIJ : I ≤ Ideal.comap (algebraMap R S) J}
    (a : I) (b : J) {hab : algebraMap R S a = b} :
    S ⊗[R] R[I / a] →ₐ[S] S[J / b] :=
  (@Algebra.TensorProduct.liftEquivRight R S R[I / a] _ _ alg _ _ S[J / b] _
      (instAlgebraOfTower J b) (AffineBlowupChart.instAlgebra J b)
      (@instIsScalarTower S _ J R _ alg b))
    (mapₐ (A := R) (Algebra.ofId R S) I J (hIJ := hIJ) a b (hab := hab))

/-- Evaluation of the tensor comparison on a pure tensor. -/
@[stacks 0BIP "affine blowup chart tensor comparison on pure tensors", simp]
theorem tensorMap_tmul
    (S : Type v) [CommRing S] [Algebra R S]
    (I : Ideal R) (J : Ideal S) {hIJ : I ≤ Ideal.comap (algebraMap R S) J}
    (a : I) (b : J) {hab : algebraMap R S a = b}
    (s : S) (x : R[I / a]) :
    tensorMap S I J (hIJ := hIJ) a b (hab := hab) (s ⊗ₜ[R] x) =
      @algebraMap S S[J / b] _ _ (AffineBlowupChart.instAlgebra J b) s *
        map (algebraMap R S) I J (hIJ := hIJ) a b (hab := hab) x := sorry

namespace tensorMap

/-- The tensor comparison vanishes on the power-torsion ideal generated by the distinguished
source element. -/
@[stacks 0BIP "affine blowup chart tensor comparison torsion vanishing"]
theorem eq_zero_of_mem_powerTorsion
    (S : Type v) [CommRing S] [Algebra R S]
    (I : Ideal R) (J : Ideal S) {hIJ : I ≤ Ideal.comap (algebraMap R S) J}
    (a : I) (b : J) {hab : algebraMap R S a = b}
    (x : S ⊗[R] R[I / a])
    (hx : x ∈ Ideal.principalPowerTorsion (algebraMap R (S ⊗[R] R[I / a]) a)) :
    tensorMap S I J (hIJ := hIJ) a b (hab := hab) x = 0 := sorry

/-- The power-torsion ideal of the distinguished source element lies in the kernel of every
compatible tensor comparison. -/
@[stacks 0BIP "affine blowup chart tensor comparison torsion kernel inclusion"]
theorem powerTorsion_le_ker
    (S : Type v) [CommRing S] [Algebra R S]
    (I : Ideal R) (J : Ideal S) {hIJ : I ≤ Ideal.comap (algebraMap R S) J}
    (a : I) (b : J) {hab : algebraMap R S a = b} :
    Ideal.principalPowerTorsion (algebraMap R (S ⊗[R] R[I / a]) a) ≤
      RingHom.ker (tensorMap S I J (hIJ := hIJ) a b (hab := hab)).toRingHom := sorry

/-- If the target center is exactly the extension of the source center, the tensor comparison is
surjective. -/
@[stacks 0BIP "affine blowup chart tensor comparison surjective"]
theorem surjective
    (S : Type v) [CommRing S] [Algebra R S]
    (I : Ideal R) (J : Ideal S) {hIJ : I ≤ Ideal.comap (algebraMap R S) J}
    (a : I) (b : J) {hab : algebraMap R S a = b}
    (hJ : Ideal.map (algebraMap R S) I = J) :
    Function.Surjective (tensorMap S I J (hIJ := hIJ) a b (hab := hab)) := sorry

/-- If the target center is exactly the extension of the source center, the tensor-comparison
kernel is the power-torsion ideal of the distinguished source element. -/
@[stacks 0BIP "affine blowup chart tensor comparison kernel"]
theorem ker_eq_powerTorsion
    (S : Type v) [CommRing S] [Algebra R S]
    (I : Ideal R) (J : Ideal S) {hIJ : I ≤ Ideal.comap (algebraMap R S) J}
    (a : I) (b : J) {hab : algebraMap R S a = b}
    (hJ : Ideal.map (algebraMap R S) I = J) :
    RingHom.ker (tensorMap S I J (hIJ := hIJ) a b (hab := hab)).toRingHom =
      Ideal.principalPowerTorsion (algebraMap R (S ⊗[R] R[I / a]) a) := sorry

/-- If the target center is the extension of the source center, the tensor-comparison kernel is
the primary component of the principal ideal generated by the distinguished source image. -/
@[stacks 0BIP "affine blowup chart tensor comparison primary component"]
theorem ker_eq_primaryComponent
    (S : Type v) [CommRing S] [Algebra R S]
    (I : Ideal R) (J : Ideal S) {hIJ : I ≤ Ideal.comap (algebraMap R S) J}
    (a : I) (b : J) {hab : algebraMap R S a = b}
    (hJ : Ideal.map (algebraMap R S) I = J) :
    RingHom.ker (tensorMap S I J (hIJ := hIJ) a b (hab := hab)).toRingHom =
      (Ideal.span ({algebraMap R (S ⊗[R] R[I / a]) a} :
        Set (S ⊗[R] R[I / a]))).primaryComponent (S ⊗[R] R[I / a]) := sorry

/-- Membership form of `tensorMap.ker_eq_powerTorsion`. -/
@[stacks 0BIP "affine blowup chart tensor comparison kernel membership", simp]
theorem mem_ker_iff
    (S : Type v) [CommRing S] [Algebra R S]
    (I : Ideal R) (J : Ideal S) {hIJ : I ≤ Ideal.comap (algebraMap R S) J}
    (a : I) (b : J) {hab : algebraMap R S a = b}
    (hJ : Ideal.map (algebraMap R S) I = J) (x : S ⊗[R] R[I / a]) :
    x ∈ RingHom.ker (tensorMap S I J (hIJ := hIJ) a b (hab := hab)).toRingHom ↔
      ∃ n : ℕ, (algebraMap R (S ⊗[R] R[I / a]) a) ^ n * x = 0 := sorry

end tensorMap

/-- The base-changed source chart modulo power torsion of its distinguished element. -/
@[stacks 0BIP "affine blowup chart tensor quotient"]
abbrev TensorQuotient
    (S : Type v) [CommRing S] [Algebra R S] (I : Ideal R) (a : I) :=
  (S ⊗[R] R[I / a]) ⧸
    Ideal.principalPowerTorsion (algebraMap R (S ⊗[R] R[I / a]) a)

/-- The canonical comparison from the tensor source modulo power torsion to a compatible target
affine chart. -/
@[stacks 0BIP "affine blowup chart tensor quotient comparison"]
noncomputable def tensorQuotientMap
    (S : Type v) [CommRing S] [Algebra R S]
    (I : Ideal R) (J : Ideal S) {hIJ : I ≤ Ideal.comap (algebraMap R S) J}
    (a : I) (b : J) {hab : algebraMap R S a = b} :
    TensorQuotient S I a →ₐ[S] S[J / b] :=
  Ideal.Quotient.liftₐ _ (tensorMap S I J (hIJ := hIJ) a b (hab := hab))
    (fun x hx ↦ tensorMap.eq_zero_of_mem_powerTorsion S I J
      (hIJ := hIJ) a b (hab := hab) x hx)

/-- The quotient comparison agrees with the tensor comparison on quotient representatives. -/
@[stacks 0BIP "affine blowup chart tensor quotient comparison on representatives", simp]
theorem tensorQuotientMap_mk
    (S : Type v) [CommRing S] [Algebra R S]
    (I : Ideal R) (J : Ideal S) {hIJ : I ≤ Ideal.comap (algebraMap R S) J}
    (a : I) (b : J) {hab : algebraMap R S a = b}
    (x : S ⊗[R] R[I / a]) :
    tensorQuotientMap S I J (hIJ := hIJ) a b (hab := hab)
        (Ideal.Quotient.mk _ x) =
      tensorMap S I J (hIJ := hIJ) a b (hab := hab) x := sorry

namespace tensorQuotientMap

/-- If the target center is exactly the extension of the source center, quotienting the tensor
source by power torsion identifies it with the target affine chart. -/
@[stacks 0BIP "affine blowup chart tensor quotient comparison bijective"]
theorem bijective
    (S : Type v) [CommRing S] [Algebra R S]
    (I : Ideal R) (J : Ideal S) {hIJ : I ≤ Ideal.comap (algebraMap R S) J}
    (a : I) (b : J) {hab : algebraMap R S a = b}
    (hJ : Ideal.map (algebraMap R S) I = J) :
    Function.Bijective
      (tensorQuotientMap S I J (hIJ := hIJ) a b (hab := hab)) := sorry

/-- The quotient tensor comparison is an algebra equivalence whenever the target center is the
extension of the source center. -/
@[stacks 0BIP "affine blowup chart tensor quotient equivalence"]
noncomputable def equiv
    (S : Type v) [CommRing S] [Algebra R S]
    (I : Ideal R) (J : Ideal S) {hIJ : I ≤ Ideal.comap (algebraMap R S) J}
    (a : I) (b : J) {hab : algebraMap R S a = b}
    (hJ : Ideal.map (algebraMap R S) I = J) :
    TensorQuotient S I a ≃ₐ[S] S[J / b] :=
  AlgEquiv.ofBijective (tensorQuotientMap S I J (hIJ := hIJ) a b (hab := hab))
    (bijective S I J (hIJ := hIJ) a b (hab := hab) hJ)

@[stacks 0BIP "affine blowup chart tensor quotient equivalence evaluation", simp]
theorem equiv_apply
    (S : Type v) [CommRing S] [Algebra R S]
    (I : Ideal R) (J : Ideal S) {hIJ : I ≤ Ideal.comap (algebraMap R S) J}
    (a : I) (b : J) {hab : algebraMap R S a = b}
    (hJ : Ideal.map (algebraMap R S) I = J) (x : TensorQuotient S I a) :
    equiv S I J (hIJ := hIJ) a b (hab := hab) hJ x =
      tensorQuotientMap S I J (hIJ := hIJ) a b (hab := hab) x := sorry

end tensorQuotientMap

namespace BaseChange

/-- The image of a center element in its extension along an algebra map. -/
@[stacks 0BIP "affine blowup chart extended center element"]
def element {S : Type v} [CommRing S] [Algebra R S]
    (I : Ideal R) (a : I) : Ideal.map (algebraMap R S) I :=
  mapElement (algebraMap R S) I _ (hIJ := Ideal.le_comap_map) a

/-- Coercing an extended center element recovers its image under the algebra map. -/
@[stacks 0BIP "affine blowup chart base-change center coercion", simp]
theorem coe_element {S : Type v} [CommRing S] [Algebra R S]
    (I : Ideal R) (a : I) : (element (S := S) I a : S) = algebraMap R S a := sorry

/-- The image of a numerator in a power of the center ideal after base change. -/
@[stacks 0BIP "affine blowup chart extended power numerator"]
def powerElement {S : Type v} [CommRing S] [Algebra R S]
    (I : Ideal R) (n : ℕ) (x : ↥(I ^ n)) :
    ↥((Ideal.map (algebraMap R S) I) ^ n) :=
  mapPowerElement (algebraMap R S) I _ (hIJ := Ideal.le_comap_map) n x

/-- Coercing a base-changed power numerator recovers the ordinary scalar image. -/
@[stacks 0BIP "affine blowup chart base-change power numerator coercion", simp]
theorem coe_powerElement {S : Type v} [CommRing S] [Algebra R S]
    (I : Ideal R) (n : ℕ) (x : ↥(I ^ n)) :
    (powerElement (S := S) I n x : S) = algebraMap R S x.1 := sorry

/-- The target chart after extending `I` and its distinguished element to `S`. -/
@[stacks 0BIP "affine blowup chart base-change target"]
abbrev Target
    {S : Type v} [CommRing S] [Algebra R S] (I : Ideal R) (a : I) :=
  affineBlowupChart (Ideal.map (algebraMap R S) I) (element I a)

/-- The canonical algebra map between an affine blowup chart and its extended-center chart. -/
@[stacks 0BIP "affine blowup chart base-change map"]
noncomputable def map
    {S : Type v} [CommRing S] [Algebra R S] (I : Ideal R) (a : I) :
    R[I / a] →ₐ[R] Target (S := S) I a :=
  mapₐ (A := R) (Algebra.ofId R S) I _ (hIJ := Ideal.le_comap_map)
    a (element I a) (hab := rfl)

/-- The base-change chart map sends a source scalar to its scalar image in the target chart. -/
@[stacks 0BIP "affine blowup chart base-change map on scalars", simp]
theorem map_algebraMap
    {S : Type v} [CommRing S] [Algebra R S] (I : Ideal R) (a : I) (r : R) :
    map (S := S) I a
        (@algebraMap R R[I / a] _ _ (AffineBlowupChart.instAlgebra I a) r) =
      @algebraMap S (Target (S := S) I a) _ _
        (AffineBlowupChart.instAlgebra
          (Ideal.map (algebraMap R S) I) (element I a)) (algebraMap R S r) := sorry

/-- The base-change chart map sends a basic fraction to the basic fraction with base-changed
numerator and parameter. -/
@[stacks 0BIP "affine blowup chart base-change map on basic fractions", simp]
theorem map_basicFraction
    {S : Type v} [CommRing S] [Algebra R S] (I : Ideal R) (a x : I) :
    map (S := S) I a (AffineBlowupChart.basicFraction I a x) =
      AffineBlowupChart.basicFraction (Ideal.map (algebraMap R S) I) (element I a) (element I x) :=
  sorry

/-- The base-change chart map sends a normalized power fraction to the corresponding fraction
with its base-changed numerator and parameter. -/
@[stacks 0BIP "affine blowup chart base-change power fraction", simp]
theorem map_powerFraction
    {S : Type v} [CommRing S] [Algebra R S]
    (I : Ideal R) (a : I) (n : ℕ) (x : ↥(I ^ n)) :
    map (S := S) I a (AffineBlowupChart.powerFraction I a n x) =
      AffineBlowupChart.powerFraction (Ideal.map (algebraMap R S) I) (element I a) n
        (powerElement I n x) := sorry

/-- The canonical affine-blowup comparison `S ⊗[R] R[I / a] → S[IS / aS]`. -/
@[stacks 0BIP "affine blowup chart base-change comparison"]
noncomputable def tensorMap
    (S : Type v) [CommRing S] [Algebra R S] (I : Ideal R) (a : I) :
    S ⊗[R] R[I / a] →ₐ[S] Target (S := S) I a :=
  AffineBlowupChart.tensorMap S I _ (hIJ := Ideal.le_comap_map)
    a (element I a) (hab := rfl)

namespace tensorMap

/-- The canonical tensor comparison to the extended-center chart is surjective. -/
@[stacks 0BIP]
theorem surjective
    (S : Type v) [CommRing S] [Algebra R S] (I : Ideal R) (a : I) :
    Function.Surjective (BaseChange.tensorMap S I a) := sorry

/-- The kernel of the canonical tensor comparison is the power-torsion ideal of the
distinguished source element. -/
@[stacks 0BIP]
theorem ker_eq_powerTorsion
    (S : Type v) [CommRing S] [Algebra R S] (I : Ideal R) (a : I) :
    RingHom.ker (BaseChange.tensorMap S I a).toRingHom =
      Ideal.principalPowerTorsion (algebraMap R (S ⊗[R] R[I / a]) a) := sorry

/-- The specialized base-change tensor kernel is the primary component of the distinguished
tensor scalar. -/
@[stacks 0BIP "affine blowup chart base-change primary component"]
theorem ker_eq_primaryComponent
    (S : Type v) [CommRing S] [Algebra R S] (I : Ideal R) (a : I) :
    RingHom.ker (BaseChange.tensorMap S I a).toRingHom =
      (Ideal.span ({algebraMap R (S ⊗[R] R[I / a]) a} :
        Set (S ⊗[R] R[I / a]))).primaryComponent (S ⊗[R] R[I / a]) := sorry

/-- The kernel of the canonical tensor comparison is precisely the torsion killed by a power of
the distinguished source element. -/
@[stacks 0BIP]
theorem mem_ker_iff
    (S : Type v) [CommRing S] [Algebra R S] (I : Ideal R) (a : I)
    (x : S ⊗[R] R[I / a]) :
    x ∈ RingHom.ker (BaseChange.tensorMap S I a).toRingHom ↔
      ∃ n : ℕ, (algebraMap R (S ⊗[R] R[I / a]) a) ^ n * x = 0 := sorry

end tensorMap

/-- The canonical map from the quotient by power torsion to the extended-center affine chart. -/
@[stacks 0BIP "affine blowup chart base-change quotient comparison"]
noncomputable def quotientMap
    (S : Type v) [CommRing S] [Algebra R S] (I : Ideal R) (a : I) :
    TensorQuotient S I a →ₐ[S] Target (S := S) I a :=
  AffineBlowupChart.tensorQuotientMap S I _ (hIJ := Ideal.le_comap_map)
    a (element I a) (hab := rfl)

namespace quotientMap

/-- Quotienting the tensor source by power torsion identifies it with the extended-center affine
chart. -/
@[stacks 0BIP]
theorem bijective
    (S : Type v) [CommRing S] [Algebra R S] (I : Ideal R) (a : I) :
    Function.Bijective (BaseChange.quotientMap S I a) := sorry

/-- Quotienting the base-changed source chart by parameter power torsion is canonically
equivalent to the extended-center affine blowup chart. -/
@[stacks 0BIP "affine blowup chart base-change quotient equivalence"]
noncomputable def equiv
    (S : Type v) [CommRing S] [Algebra R S] (I : Ideal R) (a : I) :
    TensorQuotient S I a ≃ₐ[S] Target (S := S) I a :=
  AffineBlowupChart.tensorQuotientMap.equiv S I (Ideal.map (algebraMap R S) I)
    (hIJ := Ideal.le_comap_map) a (element I a) (hab := rfl) rfl

/-- The quotient equivalence agrees with the canonical quotient comparison map. -/
@[stacks 0BIP "affine blowup chart base-change quotient equivalence evaluation", simp]
theorem equiv_apply
    (S : Type v) [CommRing S] [Algebra R S] (I : Ideal R) (a : I)
    (x : TensorQuotient S I a) :
    equiv S I a x = BaseChange.quotientMap S I a x := sorry

end quotientMap

/-- Evaluation of the tensor comparison on a pure tensor. -/
@[stacks 0BIP "affine blowup chart base-change tensor comparison on pure tensors", simp]
theorem tensorMap_tmul
    (S : Type v) [CommRing S] [Algebra R S] (I : Ideal R) (a : I)
    (s : S) (x : R[I / a]) :
    tensorMap S I a (s ⊗ₜ[R] x) =
      @algebraMap S (Target (S := S) I a) _ _
        (AffineBlowupChart.instAlgebra
          (Ideal.map (algebraMap R S) I) (element I a)) s *
        map (S := S) I a x := sorry

/-- Evaluation of the base-change tensor comparison on a basic affine-chart fraction. -/
@[stacks 0BIP "affine blowup chart base-change tensor comparison on basic fractions", simp]
theorem tensorMap_basicFraction
    (S : Type v) [CommRing S] [Algebra R S]
    (I : Ideal R) (a x : I) (s : S) :
    tensorMap S I a (s ⊗ₜ[R] AffineBlowupChart.basicFraction I a x) =
      @algebraMap S (Target (S := S) I a) _ _
          (AffineBlowupChart.instAlgebra
            (Ideal.map (algebraMap R S) I) (element I a)) s *
        AffineBlowupChart.basicFraction (Ideal.map (algebraMap R S) I) (element I a) (element I x) :=
  sorry

/-- Evaluation of the base-change tensor comparison on a normalized power fraction. -/
@[stacks 0BIP "affine blowup chart tensor power fraction", simp]
theorem tensorMap_powerFraction
    (S : Type v) [CommRing S] [Algebra R S]
    (I : Ideal R) (a : I) (n : ℕ) (x : ↥(I ^ n)) (s : S) :
    tensorMap S I a (s ⊗ₜ[R] AffineBlowupChart.powerFraction I a n x) =
      @algebraMap S (Target (S := S) I a) _ _
          (AffineBlowupChart.instAlgebra
            (Ideal.map (algebraMap R S) I) (element I a)) s *
        AffineBlowupChart.powerFraction (Ideal.map (algebraMap R S) I) (element I a) n
          (powerElement I n x) := sorry

/-- The base-change tensor comparison sends the source distinguished scalar to its target scalar. -/
@[stacks 0BIP "affine blowup chart tensor parameter", simp]
theorem tensorMap_parameter
    {S : Type v} [CommRing S] [Algebra R S] (I : Ideal R) (a : I) :
    tensorMap S I a
        (algebraMap R (S ⊗[R] R[I / a]) a.1) =
      @algebraMap S (Target (S := S) I a) _ _
        (AffineBlowupChart.instAlgebra
          (Ideal.map (algebraMap R S) I) (element I a)) (algebraMap R S a.1) := sorry

end BaseChange

end AffineBlowupChart
