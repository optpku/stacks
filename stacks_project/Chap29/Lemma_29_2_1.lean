module

public import ReasLib.AlgebraicGeometry.Scheme.Morphism.ClosedImmersion.Criteria
import StacksCheckRecall

@[expose] public section

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry

variable {X Z : Scheme.{u}} (i : Z ⟶ X)

/- Lemma 29.2.1 (1): a morphism of schemes is a closed immersion if and only if it is affine and,
for every affine open `U ⊆ X`, the induced map on sections `Γ(X, U) → Γ(Z, i^{-1}(U))` is
surjective. -/
@[stacks 01QO] #check
  (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom :
    IsClosedImmersion i ↔
      IsAffineHom i ∧ ∀ U : X.Opens, IsAffineOpen U → Function.Surjective (i.app U))

/- Lemma 29.2.1 (2): a morphism of schemes is a closed immersion if and only if there exists an
affine open covering of `X` such that over each covering member the inverse-image scheme is affine
and the induced map on global sections is surjective. -/
@[stacks 01QO] #check
  (AlgebraicGeometry.IsClosedImmersion.iff_exists_affineOpenCover
      i :
    IsClosedImmersion i ↔
      ∃ 𝒰 : X.AffineOpenCover,
        ∀ j : 𝒰.I₀,
          IsAffineOpen (i ⁻¹ᵁ (𝒰.f j).opensRange) ∧
            Function.Surjective ((i ∣_ (𝒰.f j).opensRange).appTop))

/- Lemma 29.2.1 (3): a morphism of schemes is a closed immersion if and only if the underlying
map of spaces is a closed embedding and the structure-sheaf map
`𝒪_X ⟶ i_*𝒪_Z` is locally surjective. -/
@[stacks 01QO] #check
  (AlgebraicGeometry.IsClosedImmersion.iff_closedEmbedding_locallySurjective
      i :
    IsClosedImmersion i ↔
      Topology.IsClosedEmbedding i.base ∧
        Sheaf.IsLocallySurjective
          (RingedSpace.Hom.commRingSheafPushforwardMap i.toShHom))

/- Lemma 29.2.1 (4): a morphism of schemes is a closed immersion if and only if the underlying
map of spaces is a closed embedding, the structure-sheaf map
`𝒪_X ⟶ i_*𝒪_Z` is locally surjective, and its kernel ideal sheaf is
quasi-coherent. -/
@[stacks 01QO] #check
  (AlgebraicGeometry.IsClosedImmersion.iff_closedEmbedding_locallySurjective_quasicoherentKernel
      i :
    IsClosedImmersion i ↔
      Topology.IsClosedEmbedding i.base ∧
        Sheaf.IsLocallySurjective
          (RingedSpace.Hom.commRingSheafPushforwardMap i.toShHom) ∧
          (RingedSpace.Hom.kernelIdealSheaf i.toShHom).IsQuasicoherent)

/- Lemma 29.2.1 (5): a morphism of schemes is a closed immersion if and only if the underlying
map of spaces is a closed embedding, the structure-sheaf map
`𝒪_X ⟶ i_*𝒪_Z` is locally surjective, and its kernel ideal sheaf is locally generated by
sections. -/
@[stacks 01QO] #check
  (AlgebraicGeometry.IsClosedImmersion.iff_closedEmbedding_locallySurjective_locallyGeneratedKernel
      i :
    IsClosedImmersion i ↔
      Topology.IsClosedEmbedding i.base ∧
        Sheaf.IsLocallySurjective
          (RingedSpace.Hom.commRingSheafPushforwardMap i.toShHom) ∧
          SheafOfModules.IsLocallyGeneratedBySections
            (RingedSpace.Hom.kernelIdealSheaf i.toShHom))

end AlgebraicGeometry
