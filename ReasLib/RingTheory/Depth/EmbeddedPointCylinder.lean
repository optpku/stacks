module

public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.KrullDimension.Basic
public import ReasLib.RingTheory.Depth

/-!
# The embedded-point cylinder

This file constructs the quotient `k[x, y, z] ⧸ (x ^ 2, x * y)`, its origin
localization, and the embedded prime used in the depth example.
-/

@[expose] public section

noncomputable section

universe u

open MvPolynomial
open scoped ENat

namespace MvPolynomial.LineWithEmbeddedPointCylinder

/-- The relation ideal `(x ^ 2, x * y)` in `k[x, y, z]`, with `X 0` corresponding to
`x`, `X 1` corresponding to `y`, and `X 2` corresponding to `z`. -/
def relationIdeal (k : Type u) [Field k] : Ideal (MvPolynomial (Fin 3) k) :=
  Ideal.span {X 0 ^ 2, X 0 * X 1}

/-- The relation ideal is the span of `X 0 ^ 2` and `X 0 * X 1`. -/
theorem relationIdeal_eq_span (k : Type u) [Field k] :
    relationIdeal k = Ideal.span {X 0 ^ 2, X 0 * X 1} := rfl

/-- The coordinate ring `k[x, y, z] ⧸ (x ^ 2, x * y)`. -/
abbrev CoordinateRing (k : Type u) [Field k] : Type u :=
  MvPolynomial (Fin 3) k ⧸ relationIdeal k

/-- The class of the first coordinate, corresponding to the source variable `x`. -/
def coordX (k : Type u) [Field k] : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (X 0)

/-- `coordX` is the class of `X 0`. -/
theorem coordX_eq (k : Type u) [Field k] :
    coordX k = Ideal.Quotient.mk (relationIdeal k) (X 0) := rfl

/-- The class of the second coordinate, corresponding to the source variable `y`. -/
def coordY (k : Type u) [Field k] : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (X 1)

/-- `coordY` is the class of `X 1`. -/
theorem coordY_eq (k : Type u) [Field k] :
    coordY k = Ideal.Quotient.mk (relationIdeal k) (X 1) := rfl

/-- The class of the third coordinate, corresponding to the source variable `z`. -/
def coordZ (k : Type u) [Field k] : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (X 2)

/-- `coordZ` is the class of `X 2`. -/
theorem coordZ_eq (k : Type u) [Field k] :
    coordZ k = Ideal.Quotient.mk (relationIdeal k) (X 2) := rfl

/-- The first coordinate is nilpotent of index `2`. -/
theorem coordX_pow_two (k : Type u) [Field k] : coordX k ^ 2 = 0 := by
  rw [coordX, ← map_pow, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span (by simp)

/-- The product of the first two coordinates vanishes. -/
theorem coordX_mul_coordY (k : Type u) [Field k] : coordX k * coordY k = 0 := by
  rw [coordX, coordY, ← map_mul, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span (by simp)

/-- The origin ideal `(x, y, z)` in the coordinate ring. -/
def originIdeal (k : Type u) [Field k] : Ideal (CoordinateRing k) :=
  Ideal.span {coordX k, coordY k, coordZ k}

/-- The origin ideal is generated by `coordX`, `coordY`, and `coordZ`. -/
theorem originIdeal_eq_span (k : Type u) [Field k] :
    originIdeal k = Ideal.span {coordX k, coordY k, coordZ k} := rfl

/-- The origin ideal is the extension of `idealOfVars (Fin 3) k`. -/
theorem originIdeal_eq_map (k : Type u) [Field k] :
    originIdeal k =
      Ideal.map (Ideal.Quotient.mk (relationIdeal k)) (idealOfVars (Fin 3) k) := by
  have hvars : Set.range (X : Fin 3 → MvPolynomial (Fin 3) k) = {X 0, X 1, X 2} := by
    ext p
    simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · rintro ⟨i, rfl⟩
      fin_cases i <;> simp
    · rintro (rfl | rfl | rfl)
      · exact ⟨0, rfl⟩
      · exact ⟨1, rfl⟩
      · exact ⟨2, rfl⟩
  simp [idealOfVars, hvars, Ideal.map_span, Set.image_insert_eq, originIdeal,
    coordX, coordY, coordZ]

private theorem ker_constantCoeff_eq_idealOfVars (k : Type u) [Field k] :
    RingHom.ker (constantCoeff : MvPolynomial (Fin 3) k →+* k) =
      idealOfVars (Fin 3) k := by
  let I := idealOfVars (Fin 3) k
  have hX (i : Fin 3) : Ideal.Quotient.mk I (X i) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
  have hcomp : ((Ideal.Quotient.mk I).comp C).comp constantCoeff =
      Ideal.Quotient.mk I := by
    ext r
    · simp
    · simp [hX]
  apply le_antisymm
  · intro p hp
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    rw [← hcomp, RingHom.comp_apply, show constantCoeff p = 0 from hp, map_zero]
  · rw [idealOfVars, Ideal.span_le, Set.range_subset_iff]
    intro i
    simp [RingHom.mem_ker]

/-- The origin ideal is maximal, so it is the prime at which we localize. -/
instance originIdeal.instIsMaximal (k : Type u) [Field k] :
    (originIdeal k).IsMaximal := by
  haveI hmax : (idealOfVars (Fin 3) k).IsMaximal := by
    rw [← ker_constantCoeff_eq_idealOfVars]
    exact RingHom.ker_isMaximal_of_surjective constantCoeff (fun r ↦ ⟨C r, by simp⟩)
  have hrel : relationIdeal k ≤ idealOfVars (Fin 3) k := by
    rw [relationIdeal, Ideal.span_le]
    rintro p (rfl | rfl)
    · change X 0 ^ 2 ∈ idealOfVars (Fin 3) k
      exact Ideal.pow_mem_of_mem (idealOfVars (Fin 3) k)
        (Ideal.subset_span ⟨0, rfl⟩) 2 (by decide)
    · change X 0 * X 1 ∈ idealOfVars (Fin 3) k
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨0, rfl⟩)
  rw [originIdeal_eq_map]
  apply Ideal.IsMaximal.map_of_surjective_of_ker_le Ideal.Quotient.mk_surjective
  simpa using hrel

/-- The local ring of `k[x, y, z] ⧸ (x ^ 2, x * y)` at the origin `(x, y, z)`. -/
abbrev LocalRing (k : Type u) [Field k] : Type u :=
  Localization.AtPrime (originIdeal k)

/-- The embedded ideal `(x, y)` in the coordinate ring. -/
def embeddedIdeal (k : Type u) [Field k] : Ideal (CoordinateRing k) :=
  Ideal.span {coordX k, coordY k}

/-- The embedded ideal is generated by `coordX` and `coordY`. -/
theorem embeddedIdeal_eq_span (k : Type u) [Field k] :
    embeddedIdeal k = Ideal.span {coordX k, coordY k} := rfl

private theorem span_X_zero_X_one_isPrime (k : Type u) [Field k] :
    (Ideal.span {X 0, X 1} : Ideal (MvPolynomial (Fin 3) k)).IsPrime := by
  let I : Ideal (MvPolynomial (Fin 3) k) := Ideal.span {X 0, X 1}
  let f : MvPolynomial (Fin 3) k →+* MvPolynomial Unit k :=
    eval₂Hom C (fun i ↦ if i = 2 then X () else 0)
  let g : MvPolynomial Unit k →+* MvPolynomial (Fin 3) k ⧸ I :=
    eval₂Hom ((Ideal.Quotient.mk I).comp C) (fun _ ↦ Ideal.Quotient.mk I (X 2))
  have hzero : Ideal.Quotient.mk I (X 0) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
  have hone : Ideal.Quotient.mk I (X 1) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
  have hcomp : g.comp f = Ideal.Quotient.mk I := by
    ext r
    · simp [f, g]
    · fin_cases r <;> simp [f, g, hzero, hone]
  have hker : RingHom.ker f = I := by
    apply le_antisymm
    · intro p hp
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      rw [← hcomp, RingHom.comp_apply, show f p = 0 from hp, map_zero]
    · rw [Ideal.span_le]
      rintro p (rfl | rfl) <;> simp [RingHom.mem_ker, f]
  change I.IsPrime
  rw [← hker]
  exact RingHom.ker_isPrime f

/-- The embedded ideal `(x, y)` is prime in the coordinate ring. -/
instance embeddedIdeal.instIsPrime (k : Type u) [Field k] :
    (embeddedIdeal k).IsPrime := by
  let I : Ideal (MvPolynomial (Fin 3) k) := Ideal.span {X 0, X 1}
  haveI : I.IsPrime := span_X_zero_X_one_isPrime k
  have hrel : relationIdeal k ≤ I := by
    rw [relationIdeal, Ideal.span_le]
    rintro p (rfl | rfl)
    · change X 0 ^ 2 ∈ I
      exact Ideal.pow_mem_of_mem _ (Ideal.subset_span (by simp)) 2 (by decide)
    · change X 0 * X 1 ∈ I
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
  have hmap : embeddedIdeal k = I.map (Ideal.Quotient.mk (relationIdeal k)) := by
    simp [I, embeddedIdeal, Ideal.map_span, Set.image_insert_eq, coordX, coordY]
  rw [hmap]
  exact Ideal.isPrime_map_quotientMk_of_isPrime hrel

/-- The extension of `(x, y)` to the local ring at the origin. -/
def embeddedPrime (k : Type u) [Field k] : Ideal (LocalRing k) :=
  Ideal.map (algebraMap (CoordinateRing k) (LocalRing k)) (embeddedIdeal k)

/-- `embeddedPrime` is the extension of `embeddedIdeal` along the localization map. -/
theorem embeddedPrime_eq_map (k : Type u) [Field k] :
    embeddedPrime k =
      Ideal.map (algebraMap (CoordinateRing k) (LocalRing k)) (embeddedIdeal k) := rfl

/-- The extension of `(x, y)` is prime in the local ring at the origin. -/
instance embeddedPrime.instIsPrime (k : Type u) [Field k] :
    (embeddedPrime k).IsPrime := by
  apply Ideal.isPrime_map_of_isLocalizationAtPrime (originIdeal k)
  rw [embeddedIdeal, originIdeal]
  exact Ideal.span_mono (by
    intro p hp
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hp ⊢
    tauto)

private theorem mul_X_zero_mem_relationIdeal_iff (k : Type u) [Field k]
    (p : MvPolynomial (Fin 3) k) :
    p * X 0 ∈ relationIdeal k ↔ p ∈ Ideal.span {X 0, X 1} := by
  rw [relationIdeal, Ideal.mem_span_pair, Ideal.mem_span_pair]
  constructor
  · rintro ⟨a, b, h⟩
    refine ⟨a, b, ?_⟩
    apply mul_right_cancel₀ (X_ne_zero (0 : Fin 3))
    calc
      (a * X 0 + b * X 1) * X 0 = a * X 0 ^ 2 + b * (X 0 * X 1) := by ring
      _ = p * X 0 := h
  · rintro ⟨a, b, rfl⟩
    exact ⟨a, b, by ring⟩

private theorem mul_coordX_eq_zero_iff (k : Type u) [Field k] (a : CoordinateRing k) :
    a * coordX k = 0 ↔ a ∈ embeddedIdeal k := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  have hrel : relationIdeal k ≤ Ideal.span {X 0, X 1} := by
    intro p hp
    exact (mul_X_zero_mem_relationIdeal_iff k p).mp
      ((relationIdeal k).mul_mem_right _ hp)
  have hmap : embeddedIdeal k =
      (Ideal.span {X 0, X 1}).map (Ideal.Quotient.mk (relationIdeal k)) := by
    simp [embeddedIdeal, Ideal.map_span, Set.image_insert_eq, coordX, coordY]
  rw [coordX, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, hmap,
    Ideal.mem_quotient_iff_mem hrel, mul_X_zero_mem_relationIdeal_iff]

private theorem mul_eq_zero_iff_mem_map {R : Type u} [CommRing R]
    (M : Submonoid R) (S : Type u) [CommRing S] [Algebra R S] [IsLocalization M S]
    (I : Ideal R) (x : R) (hann : ∀ a : R, a * x = 0 ↔ a ∈ I) (a : S) :
    a * algebraMap R S x = 0 ↔ a ∈ I.map (algebraMap R S) := by
  obtain ⟨r, s, rfl⟩ := IsLocalization.exists_mk'_eq M a
  rw [← IsLocalization.mk'_one (M := M) S x, ← IsLocalization.mk'_mul, mul_one,
    IsLocalization.mk'_eq_zero_iff, IsLocalization.mk'_mem_map_algebraMap_iff]
  simp only [← mul_assoc, hann, Subtype.exists, exists_prop]

private theorem moduleDepth_eq_zero_of_annihilator {R : Type u} [CommRing R]
    [IsLocalRing R] (x : R) (hx : x ≠ 0)
    (hann : ∀ a ∈ IsLocalRing.maximalIdeal R, a * x = 0) : moduleDepth R R = 0 := by
  have htop : IsLocalRing.maximalIdeal R • (⊤ : Submodule R R) ≠ ⊤ := by
    simpa only [Ideal.smul_eq_mul, Ideal.mul_top] using
      (inferInstance : (IsLocalRing.maximalIdeal R).IsMaximal).ne_top
  change (IsLocalRing.maximalIdeal R).depth R = 0
  rw [Ideal.depth, if_neg htop]
  apply le_antisymm (sSup_le ?_) zero_le
  rintro n ⟨rs, hreg, hle, rfl⟩
  cases rs with
  | nil => simp
  | cons a rs =>
    have ha : a ∈ IsLocalRing.maximalIdeal R := hle (Ideal.subset_span (by simp))
    have hregular : IsSMulRegular R a :=
      ((RingTheory.Sequence.isWeaklyRegular_cons_iff R a rs).mp hreg.toIsWeaklyRegular).1
    exact (hx (hregular.right_eq_zero_of_smul (hann a ha))).elim

private theorem X_two_notMem_span_X_zero_X_one (k : Type u) [Field k] :
    (X 2 : MvPolynomial (Fin 3) k) ∉ Ideal.span {X 0, X 1} := by
  intro h
  obtain ⟨a, b, h⟩ := Ideal.mem_span_pair.mp h
  have h' := congrArg (eval (fun i : Fin 3 ↦ if i = 2 then (1 : k) else 0)) h
  simpa using h'

private theorem mul_X_two_mem_relationIdeal_iff (k : Type u) [Field k]
    (p : MvPolynomial (Fin 3) k) :
    p * X 2 ∈ relationIdeal k ↔ p ∈ relationIdeal k := by
  constructor
  · intro hp
    have hx : X 0 ∣ p * X 2 := by
      obtain ⟨a, b, h⟩ := Ideal.mem_span_pair.mp hp
      refine ⟨a * X 0 + b * X 1, ?_⟩
      calc
        p * X 2 = a * X 0 ^ 2 + b * (X 0 * X 1) := h.symm
        _ = X 0 * (a * X 0 + b * X 1) := by ring
    obtain ⟨q, rfl⟩ : X 0 ∣ p := (X_dvd_mul_iff.mp hx).resolve_right (by simp)
    have hq : q * X 2 ∈ (Ideal.span {X 0, X 1} : Ideal (MvPolynomial (Fin 3) k)) := by
      apply (mul_X_zero_mem_relationIdeal_iff k (q * X 2)).mp
      convert hp using 1
      ring
    have hq' := (span_X_zero_X_one_isPrime k).mem_or_mem hq
    have hmem := (mul_X_zero_mem_relationIdeal_iff k q).mpr
      (hq'.resolve_right (X_two_notMem_span_X_zero_X_one k))
    simpa only [mul_comm] using hmem
  · intro hp
    exact (relationIdeal k).mul_mem_right _ hp

private theorem coordZ_mem_nonZeroDivisors (k : Type u) [Field k] :
    coordZ k ∈ nonZeroDivisors (CoordinateRing k) := by
  rw [mem_nonZeroDivisors_iff_right]
  intro a ha
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  change Ideal.Quotient.mk (relationIdeal k) p *
    Ideal.Quotient.mk (relationIdeal k) (X 2) = 0 at ha
  rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem,
    mul_X_two_mem_relationIdeal_iff] at ha
  exact Ideal.Quotient.eq_zero_iff_mem.mpr ha

/-- The coordinate ring has module depth at least one at the origin localization. -/
theorem moduleDepth_ge_one (k : Type u) [Field k] :
    (1 : ℕ∞) ≤ moduleDepth (LocalRing k) (LocalRing k) := by
  let S := LocalRing k
  let z := algebraMap (CoordinateRing k) S (coordZ k)
  have hz : z ∈ nonZeroDivisors S :=
    IsLocalization.nonZeroDivisors_le_comap (S := S) (originIdeal k).primeCompl
      (coordZ_mem_nonZeroDivisors k)
  have hreg : IsSMulRegular S z :=
    isSMulRegular_iff_right_eq_zero_of_smul.mpr (mem_nonZeroDivisors_iff_left.mp hz)
  have hzmax : z ∈ IsLocalRing.maximalIdeal S :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff S (originIdeal k) (coordZ k)).mpr
      (Ideal.subset_span (by simp))
  have hrs : RingTheory.Sequence.IsRegular S [z] :=
    RingTheory.Sequence.IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal S
      (by simpa using hzmax)
      ((RingTheory.Sequence.isWeaklyRegular_singleton_iff S z).mpr hreg)
  change (1 : ℕ∞) ≤ (IsLocalRing.maximalIdeal S).depth S
  rw [Ideal.depth]
  split_ifs
  · exact le_top
  · apply le_sSup
    refine ⟨[z], hrs, ?_, by simp⟩
    rwa [Ideal.ofList_singleton, Ideal.span_singleton_le_iff_mem]

/-- The localization at the embedded prime has module depth zero. -/
theorem moduleDepth_atPrime_eq_zero (k : Type u) [Field k] :
    moduleDepth (Localization.AtPrime (embeddedPrime k))
      (Localization.AtPrime (embeddedPrime k)) = 0 := by
  let x := algebraMap (CoordinateRing k) (LocalRing k) (coordX k)
  have hann : ∀ a : LocalRing k, a * x = 0 ↔ a ∈ embeddedPrime k :=
    mul_eq_zero_iff_mem_map (originIdeal k).primeCompl (LocalRing k)
      (embeddedIdeal k) (coordX k) (mul_coordX_eq_zero_iff k)
  let S := Localization.AtPrime (embeddedPrime k)
  let y := algebraMap (LocalRing k) S x
  have hann' (a : S) : a * y = 0 ↔ a ∈ IsLocalRing.maximalIdeal S := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal]
    exact mul_eq_zero_iff_mem_map (embeddedPrime k).primeCompl S (embeddedPrime k) x hann a
  have hy : y ≠ 0 := by
    intro h
    exact (IsLocalRing.maximalIdeal S).one_notMem ((hann' 1).mp (by simp [h]))
  exact moduleDepth_eq_zero_of_annihilator y hy (fun a ha ↦ (hann' a).mpr ha)

private theorem map_lt_map_atPrime {R : Type u} [CommRing R]
    (m : Ideal R) [m.IsPrime] {p q : Ideal R} [p.IsPrime] [q.IsPrime]
    (hpq : p < q) (hqm : q ≤ m) :
    p.map (algebraMap R (Localization.AtPrime m)) <
      q.map (algebraMap R (Localization.AtPrime m)) := by
  apply lt_of_le_of_ne (Ideal.map_mono hpq.le)
  intro h
  apply hpq.ne
  calc
    p = (p.map (algebraMap R (Localization.AtPrime m))).under R :=
      (Ideal.under_map_of_isLocalizationAtPrime m (hpq.le.trans hqm)).symm
    _ = (q.map (algebraMap R (Localization.AtPrime m))).under R :=
      congrArg (fun I : Ideal (Localization.AtPrime m) ↦ I.under R) h
    _ = q := Ideal.under_map_of_isLocalizationAtPrime m hqm

private theorem exists_prime_lt_embeddedIdeal (k : Type u) [Field k] :
    ∃ p : Ideal (CoordinateRing k), p.IsPrime ∧ p < embeddedIdeal k := by
  let I : Ideal (MvPolynomial (Fin 3) k) := Ideal.span {X 0}
  haveI : I.IsPrime := (Ideal.span_singleton_prime (X_ne_zero (0 : Fin 3))).mpr X_prime
  have hrel : relationIdeal k ≤ I := by
    rw [relationIdeal, Ideal.span_le]
    rintro p (rfl | rfl)
    · change X 0 ^ 2 ∈ I
      exact I.pow_mem_of_mem (Ideal.subset_span (by simp)) 2 (by decide)
    · change X 0 * X 1 ∈ I
      exact Ideal.mul_mem_right _ I (Ideal.subset_span (by simp))
  let p := I.map (Ideal.Quotient.mk (relationIdeal k))
  haveI : p.IsPrime := Ideal.isPrime_map_quotientMk_of_isPrime hrel
  have hple : p ≤ embeddedIdeal k := by
    rw [show p = Ideal.span {coordX k} by simp [p, I, Ideal.map_span, coordX]]
    exact Ideal.span_mono (by simp)
  have hy : coordY k ∉ p := by
    change Ideal.Quotient.mk (relationIdeal k) (X 1) ∉
      I.map (Ideal.Quotient.mk (relationIdeal k))
    rw [Ideal.mem_quotient_iff_mem hrel]
    simp [I, Ideal.mem_span_singleton]
  refine ⟨p, inferInstance, lt_of_le_of_ne hple ?_⟩
  intro h
  apply hy
  rw [h]
  exact Ideal.subset_span (by simp)

/-- The localization at the embedded prime has Krull dimension at least one. -/
theorem ringKrullDim_atPrime_ge_one (k : Type u) [Field k] :
    1 ≤ ringKrullDim (Localization.AtPrime (embeddedPrime k)) := by
  obtain ⟨p, hp, hplt⟩ := exists_prime_lt_embeddedIdeal k
  haveI : p.IsPrime := hp
  have hle : embeddedIdeal k ≤ originIdeal k := by
    exact Ideal.span_mono (by
      intro a ha
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha ⊢
      tauto)
  let q := p.map (algebraMap (CoordinateRing k) (LocalRing k))
  haveI : q.IsPrime :=
    Ideal.isPrime_map_of_isLocalizationAtPrime (originIdeal k) (hplt.le.trans hle)
  have hqlt : q < embeddedPrime k := map_lt_map_atPrime (originIdeal k) hplt hle
  let f := algebraMap (LocalRing k) (Localization.AtPrime (embeddedPrime k))
  haveI : (q.map f).IsPrime :=
    Ideal.isPrime_map_of_isLocalizationAtPrime (embeddedPrime k) hqlt.le
  have hlt : q.map f < (embeddedPrime k).map f :=
    map_lt_map_atPrime (embeddedPrime k) hqlt le_rfl
  exact Order.one_le_krullDim_iff.mpr
    ⟨⟨q.map f, inferInstance⟩, ⟨(embeddedPrime k).map f, inferInstance⟩, hlt⟩

end MvPolynomial.LineWithEmbeddedPointCylinder
