module

public import ReasLib.AlgebraicGeometry.MilnorK.Coniveau
import StacksCheckRecall

open AlgebraicGeometry
open MilnorK MilnorK.Coniveau
open scoped BigOperators TensorProduct

universe u v

/- Remark 42.6.4 (Milnor K-theory): for an excellent Noetherian scheme with a dimension
function, the consecutive canonical Milnor coniveau arrows compose to zero. -/
@[stacks 0EAY] #check (MilnorK.Coniveau.comp_eq_zero_of_excellent :
  ∀ (X : Scheme.{u}) [IsNoetherian X] (δ : X → ℤ) [IsDimensionFunction δ]
    [Scheme.Excellent X]
    (i : ℕ) (hi : 1 ≤ i) (j : ℤ),
    (canonicalExcellentSecond X δ i hi j).comp
      (canonicalExcellentFirst X δ i j) = 0)

/- The Milnor K-ring is the tensor algebra on the multiplicative group modulo the
two-sided ideal generated by the Steinberg tensors. -/
#check (MilnorK.Ring : (k : Type u) → [Field k] → Type u)

/- The degree-zero identification with the integers. -/
#check (MilnorK.degreeZeroMap_bijective :
  ∀ (k : Type u) [Field k],
    Function.Bijective (degreeZeroMap k))

/- The degree-one identification with the multiplicative group. -/
#check (MilnorK.degreeOneMap_bijective :
  ∀ (k : Type u) [Field k],
    Function.Bijective (degreeOneMap k))

/- The degree-two Steinberg quotient presentation. -/
#check (MilnorK.degreeTwoMap_bijective :
  ∀ (k : Type u) [Field k],
    Function.Bijective (degreeTwoMap k))

/- The higher tame boundary for a discrete valuation ring. -/
#check (MilnorK.dvrBoundary :
  ∀ (A : Type u) (F : Type v) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field F] [Algebra A F] [IsFractionRing A F] (i : ℕ),
    Group (i + 1) F →+ Group i (IsLocalRing.ResidueField A))

/- The degree-two tame-symbol convention. -/
#check (MilnorK.dvrBoundary_one_symbol :
  ∀ (A : Type u) (F : Type v) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field F] [Algebra A F] [IsFractionRing A F] (x y : Fˣ),
    dvrBoundary A F 1 (symbol ![x, y]) =
      degreeOneMap (IsLocalRing.ResidueField A)
        (Additive.ofMul
          (TameSymbol.value A F (IsDiscreteValuationRing.ringKrullDim_eq_one A) x y)))

/- The normalization-and-norm boundary for an excellent local domain of dimension one. -/
#check (MilnorK.canonicalExcellentLocalBoundary :
  ∀ (A F : Type u) [CommRing A] [IsDomain A] [IsLocalRing A]
    [IsExcellentRing.{u, u} A]
    [Field F] [Algebra A F] [IsFractionRing A F]
    (hdim : ringKrullDim A = 1)
    (i : ℕ),
    MilnorK.Group (i + 1) F →+
      MilnorK.Group i (IsLocalRing.ResidueField A))

/- The excellent local boundary is the sum over normalization branches. -/
#check (MilnorK.canonicalExcellentLocalBoundary_apply :
  ∀ (A F : Type u) [CommRing A] [IsDomain A] [IsLocalRing A]
    [IsExcellentRing.{u, u} A]
    [Field F] [Algebra A F] [IsFractionRing A F]
    (hdim : ringKrullDim A = 1)
    (i : ℕ) (a : MilnorK.Group (i + 1) F),
    canonicalExcellentLocalBoundary A F hdim i a =
      ∑ᶠ b, (MilnorK.normalizationResidueMilnorNorm A F b).map i (MilnorK.normalizationBranchBoundary A F hdim b i a))

/- The excellent local boundary agrees with the tame symbol in degree one. -/
#check (MilnorK.canonicalExcellentLocalBoundary_one :
  ∀ (A F : Type u) [CommRing A] [IsDomain A] [IsLocalRing A]
    [IsExcellentRing.{u, u} A]
    [Field F] [Algebra A F] [IsFractionRing A F]
    (hdim : ringKrullDim A = 1)
    (z : MilnorK.DegreeTwoPresentation F),
    canonicalExcellentLocalBoundary A F hdim 1 (MilnorK.degreeTwoMap F z) =
      MilnorK.degreeOneMap (IsLocalRing.ResidueField A)
        (MilnorK.boundaryOne A F hdim z))

/- The first canonical excellent coniveau arrow. -/
#check (MilnorK.Coniveau.canonicalExcellentFirst :
  ∀ (X : Scheme.{u}) [IsNoetherian X] (δ : X → ℤ) [IsDimensionFunction δ]
    [Scheme.Excellent X]
    (i : ℕ) (j : ℤ),
    MilnorK.Coniveau.Term X δ (i + 1) (j + 1) →+ MilnorK.Coniveau.Term X δ i j)

/- The second canonical excellent coniveau arrow. -/
#check (MilnorK.Coniveau.canonicalExcellentSecond :
  ∀ (X : Scheme.{u}) [IsNoetherian X] (δ : X → ℤ) [IsDimensionFunction δ]
    [Scheme.Excellent X]
    (i : ℕ) (hi : 1 ≤ i) (j : ℤ),
    MilnorK.Coniveau.Term X δ i j →+ MilnorK.Coniveau.Term X δ (i - 1) (j - 1))

/- In Milnor degree one, the composition vanishes for every Noetherian scheme. -/
#check (MilnorK.Coniveau.degreeOne_comp_eq_zero :
  ∀ (X : Scheme.{u}) [IsNoetherian X] (δ : X → ℤ) [IsDimensionFunction δ] (j : ℤ),
    (MilnorK.Coniveau.degreeOneSecond δ j).comp (MilnorK.Coniveau.degreeOneFirst δ j) = 0)

/- The analogous higher boundary for arbitrary one-dimensional Noetherian local domains
is proposed tentatively in the source; no such extension is asserted here. -/
