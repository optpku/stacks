module

public import Mathlib.Algebra.Field.Basic
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.Coordinate
public import ReasLib.RingTheory.GradedAlgebra.Quotient

/-!
# The coordinate cross in standard projective space

The coordinate cross is the projective spectrum of the homogeneous quotient
by the products `T_i * T_j` for `i > j > 0`.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.ProjectiveSpace.CoordinateCross

/-- The homogeneous generators `T_i * T_j` of the coordinate cross, indexed by pairs
of homogeneous coordinates with `0 < j.val` and `j.val < i.val`. -/
def generators (k : Type u) [Field k] (n : ℕ) :
    Set (MvPolynomial (Fin (n + 1)) k) :=
  Set.image (fun indices : Fin (n + 1) × Fin (n + 1) ↦
      coordinate n indices.1 * coordinate n indices.2)
    {indices | 0 < indices.2.val ∧ indices.2.val < indices.1.val}

/-- The ideal generated by the coordinate-cross products is homogeneous for the
standard grading on `k[T_0, …, T_n]`. -/
theorem spanIdeal_isHomogeneous (k : Type u) [Field k] (n : ℕ) :
    (Ideal.span (generators k n)).IsHomogeneous (grading k n) := sorry

/-- The homogeneous ideal of the coordinate cross in standard projective space. -/
def ideal (k : Type u) [Field k] (n : ℕ) :
    HomogeneousIdeal (grading k n) where
  toSubmodule := Ideal.span (generators k n)
  is_homogeneous' := spanIdeal_isHomogeneous k n

/-- Membership in the coordinate-cross ideal is membership in the span of the
products `T_i * T_j` for `i > j > 0`. -/
theorem mem_ideal_iff (k : Type u) [Field k] (n : ℕ)
    {polynomial : MvPolynomial (Fin (n + 1)) k} :
    polynomial ∈ (ideal k n).toIdeal ↔ polynomial ∈ Ideal.span (generators k n) :=
  Iff.rfl

/-- The underlying ideal of the coordinate cross is the span of its quadratic
generators. -/
theorem ideal_eq_span (k : Type u) [Field k] (n : ℕ) :
    (ideal k n).toIdeal = Ideal.span (generators k n) := rfl

/-- The homogeneous coordinate ring of the coordinate cross. -/
abbrev quotientRing (k : Type u) [Field k] (n : ℕ) : Type u :=
  MvPolynomial (Fin (n + 1)) k ⧸ (ideal k n).toIdeal

/-- The quotient grading on the homogeneous coordinate ring of the coordinate
cross. -/
abbrev quotientGrading (k : Type u) [Field k] (n : ℕ) :
    ℕ → Submodule k (quotientRing k n) :=
  GradedAlgebra.Quotient.grading (grading k n) (ideal k n).toIdeal

/-- The quotient by the coordinate-cross ideal carries its canonical
graded-algebra structure. -/
noncomputable instance instGradedAlgebra (k : Type u) [Field k] (n : ℕ) :
    GradedAlgebra (quotientGrading k n) :=
  GradedAlgebra.Quotient.gradedAlgebra (grading k n)
    (ideal k n).toIdeal (ideal k n).isHomogeneous

/-- The coordinate cross in projective `n`-space, realized as `Proj` of the
homogeneous quotient `k[T_0, …, T_n] ⧸ (T_i T_j ; i > j > 0)`. -/
abbrev scheme (k : Type u) [Field k] (n : ℕ) : Scheme :=
  Proj (quotientGrading k n)

/-- The structure morphism of the coordinate cross over `Spec k`, induced by
the coefficient map into its degree-zero homogeneous coordinate ring. -/
def toSpec (k : Type u) [Field k] (n : ℕ) :
    scheme k n ⟶ Spec (.of k) :=
  Proj.toSpecZero (quotientGrading k n) ≫
    Spec.map (CommRingCat.ofHom (algebraMap k (quotientGrading k n 0)))

end AlgebraicGeometry.ProjectiveSpace.CoordinateCross
