module

public import ReasLib.AlgebraicGeometry.Scheme.Cover.Smooth
public import Mathlib.AlgebraicGeometry.Sites.Pretopology

/-!
# The big smooth site

This leaf owns the canonical precoverage and Grothendieck topology generated
by jointly surjective smooth families on schemes.  Slice and sheaf-level
functor APIs live in sibling leaves.
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry.Scheme

/-- Smooth morphisms contain identities. -/
instance smooth_containsIdentities : MorphismProperty.ContainsIdentities (@Smooth) := sorry

/-- The canonical precoverage of schemes by jointly surjective smooth families. -/
abbrev bigSmoothPrecoverage : Precoverage Scheme.{u} :=
  Scheme.precoverage (@Smooth)

/-- The Grothendieck topology generated by smooth covering families. -/
abbrev bigSmoothSite : GrothendieckTopology Scheme.{u} :=
  Scheme.grothendieckTopology (@Smooth)

/-- The big smooth topology is generated by the canonical smooth precoverage. -/
theorem bigSmoothSite_eq_toGrothendieck :
    bigSmoothSite = bigSmoothPrecoverage.toGrothendieck := sorry

end AlgebraicGeometry.Scheme
