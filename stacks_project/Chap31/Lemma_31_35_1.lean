module

public import ReasLib.AlgebraicGeometry.Scheme.Module.FittingIdeal.Blowup
import StacksCheckRecall

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

/- Lemma 31.35.1: let `S` be a scheme, let `ℱ` be a finite-type quasicoherent
`𝒪_S`-module, and let `Z_k` be the closed subscheme cut out by
`Scheme.fittingIdealSheaf ℱ k`. If `b : S' ⟶ S` is the blowup of `S` in `Z_k`, then the strict
transform of `ℱ` along `b` can locally be generated by at most `k` sections. -/
@[stacks 0CZP] #check
  (AlgebraicGeometry.Scheme.fittingIdealSheaf.strictTransformModule_exists_isGeneratedBy_on_neighborhood :
    ∀ {S S' : Scheme.{u}} (b : S' ⟶ S) (ℱ : S.Modules) [ℱ.IsFiniteType] [ℱ.IsQuasicoherent]
      (k : ℕ) [IsBlowup b (Scheme.fittingIdealSheaf ℱ k)]
      (y : strictTransformAmbient b (𝟙 S)),
      ∃ U : Opens (strictTransformAmbient b (𝟙 S)), y ∈ U ∧
        SheafOfModules.IsGeneratedBy
          ((strictTransformModule b ((Scheme.fittingIdealSheaf ℱ k).comap b) (𝟙 S) ℱ).over U) k)
