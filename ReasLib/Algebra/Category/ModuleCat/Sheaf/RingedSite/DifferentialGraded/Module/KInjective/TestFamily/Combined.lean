module

public import Mathlib.CategoryTheory.Preadditive.Injective.LiftingProperties
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.DifferentialGraded.Module.KInjective.Basic
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.DifferentialGraded.Module.KInjective.Limits
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.DifferentialGraded.Module.KInjective.TestFamily.Acyclic
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.DifferentialGraded.Module.KInjective.TestFamily.GradedInjective

/-!
# Test families for graded-injective K-injective DG modules

A combined test family is explicit set-indexed data of monomorphisms between acyclic DG modules
whose right lifting condition detects the combined graded-injective and K-injective property.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits
open DifferentialGradedCategory
open scoped DifferentialGradedCategory
open scoped ZeroObject
open scoped SheafOfModules.RingedSite.DifferentialGradedAlgebra
open scoped SheafOfModules.RingedSite.DifferentialGradedModule

noncomputable section

-- Mathlib intentionally keeps this construction non-global because a global instance breaks
-- sheaf/free elaboration.  The test-family lifting condition uses the K-injective owner's choice.
attribute [local instance] Abelian.hasFiniteBiproducts

universe u v w

namespace SheafOfModules.RingedSite.DifferentialGradedModule.Module.KInjective

section


variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat)]
variable [HasWeakSheafify J AddCommGrpCat.{max u v}]
variable [HasSheafify J AddCommGrpCat.{max u v}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{max u v}]
variable {𝒪 : Sheaf J CommRingCat.{max u v}}

/-- A set-indexed family of acyclic monomorphisms detecting graded-injective K-injective DG
modules by a right lifting condition. -/
@[stacks 0FSY]
structure TestFamily (𝒜 : DGA(𝒪)) where
  /-- The set-sized index type. -/
  index : Type w
  /-- The source DG module of each test map. -/
  source : index → Mod(𝒜, d)
  /-- The target DG module of each test map. -/
  target : index → Mod(𝒜, d)
  /-- The test maps. -/
  ι : ∀ r, source r ⟶ target r
  /-- Every test map is a monomorphism. -/
  mono_ι (r : index) : Mono (ι r)
  /-- Every test source is acyclic. -/
  source_acyclic (r : index) : Module.acyclic 𝒜 (source r)
  /-- Every test target is acyclic. -/
  target_acyclic (r : index) : Module.acyclic 𝒜 (target r)
  /-- The right lifting property against all test maps detects exactly the combined injectivity
  property. -/
  detects (I : Mod(𝒜, d)) :
    IsKInjective.GradedInjective I ↔
      (MorphismProperty.ofHoms ι).rlp (0 : I ⟶ 0)

namespace TestFamily

/-- The morphism property generated by the arrows of a K-injective test family. -/
def arrows {𝒜 : DGA(𝒪)} (T : TestFamily 𝒜) :
    MorphismProperty Mod(𝒜, d) :=
  MorphismProperty.ofHoms T.ι

/-- Every indexed test arrow belongs to the generated morphism property. -/
theorem ι_mem {𝒜 : DGA(𝒪)} (T : TestFamily 𝒜) (r : T.index) :
    T.arrows (T.ι r) :=
  MorphismProperty.ofHoms.mk r

/-- Every arrow in the generated test property is a monomorphism. -/
theorem arrows_le_monomorphisms {𝒜 : DGA(𝒪)} (T : TestFamily 𝒜) :
    T.arrows ≤ MorphismProperty.monomorphisms Mod(𝒜, d) :=
  (MorphismProperty.ofHoms_le_iff T.ι _).2 T.mono_ι

/-- Every indexed test arrow is a quasi-isomorphism because its source and target are
acyclic. -/
theorem quasiIso_ι {𝒜 : DGA(𝒪)} (T : TestFamily 𝒜) (r : T.index) :
    Module.quasiIso 𝒜 (T.ι r) := by
  change _root_.QuasiIso (T.ι r).toCochainMap
  rw [_root_.quasiIso_iff]
  intro n
  exact (_root_.quasiIsoAt_iff_exactAt _ n (T.source_acyclic r n)).2
    (T.target_acyclic r n)

/-- Every arrow generated by a combined test family is a quasi-isomorphism. -/
theorem arrows_le_quasiIso {𝒜 : DGA(𝒪)} (T : TestFamily 𝒜) :
    T.arrows ≤ Module.quasiIso 𝒜 :=
  (MorphismProperty.ofHoms_le_iff T.ι _).2 T.quasiIso_ι

/-- Combined graded and K-injectivity is the right lifting property against the generated test
arrows. -/
theorem gradedInjective_iff_rlp {𝒜 : DGA(𝒪)} (T : TestFamily 𝒜) (I : Mod(𝒜, d)) :
    IsKInjective.GradedInjective I ↔
      T.arrows.rlp (0 : I ⟶ 0) :=
  T.detects I

/-- Expanded lifting criterion: every map from a test source extends across its test arrow. -/
theorem gradedInjective_iff_lifts {𝒜 : DGA(𝒪)} (T : TestFamily 𝒜) (I : Mod(𝒜, d)) :
    IsKInjective.GradedInjective I ↔
      ∀ r (f : T.source r ⟶ I),
        ∃ g : T.target r ⟶ I, T.ι r ≫ g = f := by
  rw [gradedInjective_iff_rlp]
  constructor
  · intro h r f
    letI := h _ (T.ι_mem r)
    have sq : CommSq f (T.ι r) (0 : I ⟶ 0) 0 := ⟨by simp⟩
    exact ⟨sq.lift, sq.fac_left⟩
  · intro h X Y b hb
    cases hb with
    | mk r =>
      constructor
      intro f g sq
      obtain ⟨l, hl⟩ := h r f
      exact CommSq.HasLift.mk'
        { l := l
          fac_left := hl
          fac_right := (isZero_zero _).eq_of_tgt _ _ }

/- A set-sized K-injective test family exists for every sheaf of differential graded
   algebras. -/
/-- A combined test family exists for every differential graded algebra sheaf. -/
@[stacks 0FSY "existence"]
theorem nonempty (𝒜 : DGA(𝒪)) :
    Nonempty (TestFamily.{u, v, max (u + 1) (v + 1)} 𝒜) := sorry

end TestFamily

end


end SheafOfModules.RingedSite.DifferentialGradedModule.Module.KInjective
