module

public import Mathlib.Topology.Category.TopCat.GrothendieckTopology
public import Mathlib.Topology.Category.TopCat.Opens
public import Mathlib.CategoryTheory.Sites.Pretopology
public import ReasLib.CategoryTheory.Sites.Family.Covering
public import ReasLib.Topology.Category.LCCat.Covering

/-!
# Zariski and quasi-compact sites on `LCCat`

This file owns the canonical Zariski and quasi-compact Grothendieck topologies on the category of
Hausdorff locally compact spaces.  The quasi-compact precoverage is defined through the bundled
fixed-target family API, so later site arguments can work with a family and its generated presieve
without choosing a separate raw indexing presentation.
-/

@[expose] public section

universe u w

open CategoryTheory CategoryTheory.Limits TopologicalSpace

namespace LCCat

/-- Every open subspace of an object of `LCCat` is again Hausdorff and locally compact. -/
@[stacks 09X3 "open subspaces remain in LCCat"]
theorem opensToLCCat_obj_property (X : LCCat.{u}) (U : Opens X.obj) :
    property ((Opens.toTopCat X.obj).obj U) := sorry

/-- The functor sending an open subset of `X` to its open subspace, regarded as an object of
`LCCat`. -/
@[stacks 09X3 "open-subspace functor into LCCat"]
def opensToLCCat (X : LCCat.{u}) : Opens X.obj ⥤ LCCat.{u} :=
  property.lift (Opens.toTopCat X.obj) (opensToLCCat_obj_property X)

/-- The inclusion of an open subspace into its ambient `LCCat` object. -/
@[stacks 09X3 "open-subspace inclusion"]
def openInclusion (X : LCCat.{u}) (U : Opens X.obj) :
    (opensToLCCat X).obj U ⟶ X :=
  CategoryTheory.ObjectProperty.homMk (Opens.inclusion' U)

/-- Open-subspace inclusions are natural with respect to inclusions between open subsets. -/
@[stacks 09X3 "naturality of open-subspace inclusions"]
theorem opensToLCCat_map_comp_openInclusion (X : LCCat.{u})
    {U V : Opens X.obj} (f : U ⟶ V) :
    (opensToLCCat X).map f ≫ openInclusion X V = openInclusion X U := sorry

/-- The canonical functor from the small Zariski site of `X` to the slice category `LCCat / X`. -/
@[stacks 09X3 "small Zariski site functor"]
def opensOver (X : LCCat.{u}) : Opens X.obj ⥤ Over X :=
  (opensToLCCat X).toOver X (openInclusion X)
    (opensToLCCat_map_comp_openInclusion X)

/-- The Zariski precoverage on `LCCat` consists of jointly surjective families of open
embeddings. -/
@[stacks 09X3 "the Zariski precoverage"]
def zarPrecoverage : Precoverage LCCat.{u} :=
  TopCat.precoverage.comap toTopCat

/-- The Zariski topology on `LCCat`, generated by jointly surjective families of open
embeddings. -/
@[stacks 09X3 "the site LC_Zar"]
def zarTopology : GrothendieckTopology LCCat.{u} :=
  zarPrecoverage.toGrothendieck

/-- The quasi-compact precoverage on `LCCat`: a presieve covers precisely when it is generated by
a bundled quasi-compact covering family. -/
@[stacks 09X2 "ambient qc-covering infrastructure"]
def qcPrecoverage : Precoverage LCCat.{u} where
  coverings X R := ∃ 𝒰 : SemiRepresentableFamily.Over.{u + 1} X,
    𝒰.IsQuasiCompactCovering ∧ 𝒰.toPresieve = R

/-- Membership in the quasi-compact precoverage is witnessed by a bundled quasi-compact family
which generates the given presieve. -/
@[stacks 09X2 "membership in the ambient qc precoverage"]
theorem mem_qcPrecoverage_iff {X : LCCat.{u}} {R : Presieve X} :
    R ∈ qcPrecoverage X ↔ ∃ 𝒰 : SemiRepresentableFamily.Over.{u + 1} X,
      𝒰.IsQuasiCompactCovering ∧ 𝒰.toPresieve = R := sorry

/-- A bundled family covers for `qcPrecoverage` exactly when it satisfies the intrinsic
quasi-compact covering predicate. -/
@[stacks 09X2 "qc family membership criterion"]
theorem isCovering_qcPrecoverage_iff {X : LCCat.{u}}
    (𝒰 : SemiRepresentableFamily.Over.{w} X) :
    𝒰.IsCovering qcPrecoverage ↔ 𝒰.IsQuasiCompactCovering := sorry

/-- The quasi-compact precoverage contains singleton families induced by isomorphisms. -/
@[stacks 09X2 "qc precoverage contains isomorphisms", instance]
instance instQcPrecoverageHasIsos : qcPrecoverage.HasIsos := sorry

/-- The quasi-compact precoverage is stable under base change. -/
@[stacks 09X2 "qc precoverage is stable under base change", instance]
instance instQcPrecoverageIsStableUnderBaseChange :
    qcPrecoverage.IsStableUnderBaseChange := sorry

/-- The quasi-compact precoverage is stable under composition of covering families. -/
@[stacks 09X2 "qc precoverage is stable under composition", instance]
instance instQcPrecoverageIsStableUnderComposition :
    qcPrecoverage.IsStableUnderComposition := sorry

/-- The pretopology whose covering presieves are exactly the quasi-compact covering families. -/
@[stacks 09X2 "ambient qc pretopology infrastructure"]
def qcPretopology : Pretopology LCCat.{u} :=
  qcPrecoverage.toPretopology

/-- The Grothendieck topology generated by quasi-compact covering families of `LCCat`. -/
@[stacks 09X2 "ambient qc topology infrastructure"]
def qcTopology : GrothendieckTopology LCCat.{u} :=
  qcPretopology.toGrothendieck

/-- Every Zariski covering of `LCCat` is a quasi-compact covering. -/
@[stacks 09X3 "Zariski-to-qc topology comparison"]
theorem zar_le_qc : zarTopology.{u} ≤ qcTopology.{u} := sorry

end LCCat

end
