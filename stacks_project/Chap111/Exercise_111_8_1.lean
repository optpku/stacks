module

public import ReasLib.RingTheory.Ideal.Nakayama.Basic
import StacksCheckRecall

@[expose] public section

universe u v

open scoped Pointwise

/- Exercise 111.8.1: if `A` is a ring, `I` an ideal of `A`, `M` an `A`-module, and
`x1, …, xn ∈ M`, assume that `M ⧸ I • ⊤` is generated by those elements, `M` is a
finite `A`-module, and `I` is contained in every maximal ideal of `A`. Then
`x1, …, xn` generate `M`. This is the finite-family Jacobson form of Nakayama,
owned by `Submodule.span_eq_top_of_quotient_span_eq_top_of_le_jacobson`. -/
@[stacks 076D]
#check (Submodule.span_eq_top_of_quotient_span_eq_top_of_le_jacobson :
  ∀ {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    (I : Ideal R) [Module.Finite R M] (s : Finset M),
    Submodule.span R ((I • (⊤ : Submodule R M)).mkQ '' (s : Set M)) = ⊤ →
    I ≤ Ring.jacobson R → Submodule.span R (s : Set M) = ⊤)

/- Companion: containment in every maximal ideal is the Jacobson-radical comparison
`I ≤ Ring.jacobson R`, via `Ring.jacobson_eq_sInf_isMaximal`. -/
#check Ring.jacobson_eq_sInf_isMaximal

/- Companion: the submodule/sup form of the same Jacobson Nakayama criterion. -/
#check Submodule.eq_top_of_sup_eq_top_of_le_jacobson

/- Companion: the lecture zero-module form used in the suggested quotient reduction. -/
#check Module.subsingleton_of_smul_top_eq_top_of_le_jacobson
