module

public import Mathlib.LinearAlgebra.Span.Basic
public import Mathlib.RingTheory.Artinian.Module
public import Mathlib.RingTheory.Ideal.Cotangent
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.PowerSeries.Ideal
public import ReasLib.AlgebraicGeometry.FormalDeformation.SmallExtension
public import ReasLib.AlgebraicGeometry.FormalDeformation.EssentialSurjection
public import ReasLib.AlgebraicGeometry.FormalDeformation.ArtinianLocal.Residue
public import ReasLib.AlgebraicGeometry.FormalDeformation.ArtinianLocal.Cotangent

/-!
# The square-zero quotient `k⟦X⟧ ⧸ (X ^ 2)` in `ArtinianLocalAlgCat`

With `Λ = PowerSeries k`, the quotient `B = Λ ⧸ (X ^ 2)` is an object of
`ArtinianLocalAlgCat Λ k`, and the lift of `constantCoeff` is the residue morphism
`B ⟶ k`.
-/

@[expose] public section

open CategoryTheory IsLocalRing
open scoped PowerSeries

universe u

noncomputable section

namespace PowerSeries

/-- The algebra structure on the coefficient ring induced by constant coefficient. -/
@[reducible] def constantCoeffAlgebra {k : Type u} [CommRing k] : Algebra (PowerSeries k) k :=
  (constantCoeff : PowerSeries k →+* k).toAlgebra

/-- The coefficient projection makes `k` into a `PowerSeries k`-algebra. -/
instance algebraConstantCoeff {k : Type u} [CommRing k] : Algebra (PowerSeries k) k :=
  constantCoeffAlgebra

/-- The structure map `PowerSeries k →+* k` is `constantCoeff`. -/
theorem algebraMap_eq_constantCoeff {k : Type u} [CommRing k] :
    algebraMap (PowerSeries k) k = constantCoeff := rfl

/-- `k` is generated by `{1}` as a `PowerSeries k`-module via `constantCoeff`. -/
instance instModuleFinite_constantCoeff {k : Type u} [CommRing k] :
    Module.Finite (PowerSeries k) k := sorry

/-- The coefficient projection `PowerSeries k →+* k` is a local homomorphism. -/
instance instIsLocalHom_constantCoeff {k : Type u} [Field k] :
    IsLocalHom (constantCoeff : PowerSeries k →+* k) := sorry

/-- The principal ideal `(X ^ 2)` in `PowerSeries k`. -/
def xSqIdeal (k : Type u) [CommRing k] : Ideal (PowerSeries k) :=
  Ideal.span {X ^ 2}

/-- `X ^ 2` generates `xSqIdeal k`. -/
theorem xSqIdeal_eq_span (k : Type u) [CommRing k] :
    xSqIdeal k = Ideal.span {X ^ 2} := rfl

/-- The structure map `PowerSeries k → k` vanishes on `(X ^ 2)`. -/
theorem algebraMap_eq_zero_of_mem_xSqIdeal {k : Type u} [CommRing k] {a : PowerSeries k}
    (ha : a ∈ xSqIdeal k) : Algebra.ofId (PowerSeries k) k a = 0 := sorry

/-- The ideal `(X ^ 2)` is proper. -/
theorem xSqIdeal_ne_top (k : Type u) [CommRing k] [Nontrivial k] : xSqIdeal k ≠ ⊤ := sorry

/-- The quotient `PowerSeries k ⧸ (X ^ 2)` is nontrivial. -/
instance instNontrivial_quot_xSqIdeal (k : Type u) [CommRing k] [Nontrivial k] :
    Nontrivial (PowerSeries k ⧸ xSqIdeal k) :=
  Ideal.Quotient.nontrivial_iff.mpr (xSqIdeal_ne_top k)

/-- The quotient `PowerSeries k ⧸ (X ^ 2)` is a local ring. -/
instance instIsLocalRing_quot_xSqIdeal (k : Type u) [Field k] :
    IsLocalRing (PowerSeries k ⧸ xSqIdeal k) :=
  IsLocalRing.of_surjective' (Ideal.Quotient.mk (xSqIdeal k)) Ideal.Quotient.mk_surjective

/-- The quotient `PowerSeries k ⧸ (X ^ 2)` is finite as a `k`-module, generated by `{1, mk X}`. -/
instance instModuleFinite_quot_xSqIdeal (k : Type u) [Field k] :
    Module.Finite k (PowerSeries k ⧸ xSqIdeal k) := sorry

/-- The quotient `PowerSeries k ⧸ (X ^ 2)` is an Artinian ring. -/
instance instIsArtinianRing_quot_xSqIdeal (k : Type u) [Field k] :
    IsArtinianRing (PowerSeries k ⧸ xSqIdeal k) :=
  IsArtinianRing.of_finite k (PowerSeries k ⧸ xSqIdeal k)

/-- Coefficient one vanishes on the ideal generated by the square of the variable. -/
theorem xSqIdeal_le_ker_coeffOne (k : Type u) [CommRing k] :
    (xSqIdeal k).restrictScalars k ≤ LinearMap.ker (coeff (R := k) 1) := sorry

end PowerSeries

open PowerSeries

namespace ArtinianLocalAlgCat

/-- The canonical `PowerSeries k`-algebra map `PowerSeries k ⧸ (X ^ 2) →ₐ k` lifting
`constantCoeff`. -/
def modXSqResidueHom (k : Type u) [Field k] :
    PowerSeries k ⧸ xSqIdeal k →ₐ[PowerSeries k] k :=
  Ideal.Quotient.liftₐ (xSqIdeal k) (Algebra.ofId (PowerSeries k) k)
    fun _ ha ↦ algebraMap_eq_zero_of_mem_xSqIdeal ha

/-- `modXSqResidueHom` is the lift of `Algebra.ofId (PowerSeries k) k` along the quotient
by `(X ^ 2)`. -/
theorem modXSqResidueHom_comp_mk (k : Type u) [Field k] :
    (modXSqResidueHom k).comp (Ideal.Quotient.mkₐ (PowerSeries k) (xSqIdeal k)) =
      Algebra.ofId (PowerSeries k) k := rfl

/-- `modXSqResidueHom` is surjective. -/
theorem surjective_modXSqResidueHom (k : Type u) [Field k] :
    Function.Surjective (modXSqResidueHom k) := sorry

/-- The maximal ideal of `PowerSeries k ⧸ (X ^ 2)` is the kernel of `modXSqResidueHom`. -/
theorem maximalIdeal_quot_xSqIdeal_eq_ker (k : Type u) [Field k] :
    IsLocalRing.maximalIdeal (PowerSeries k ⧸ xSqIdeal k) =
      RingHom.ker (modXSqResidueHom k).toRingHom := sorry

/-- The constant-coefficient map descends to the residue field of the square-zero quotient. -/
def modXSqResidueFieldHom (k : Type u) [Field k] :
    ResidueField (PowerSeries k ⧸ xSqIdeal k) →ₐ[PowerSeries k] k :=
  Ideal.Quotient.liftₐ (IsLocalRing.maximalIdeal (PowerSeries k ⧸ xSqIdeal k))
    (modXSqResidueHom k) (fun a ha ↦ by
      change a ∈ RingHom.ker (modXSqResidueHom k).toRingHom
      exact (maximalIdeal_quot_xSqIdeal_eq_ker k) ▸ ha)

/-- A scalar defines a residue class through its constant power series. -/
def modXSqResidueFieldInverse (k : Type u) [Field k] (a : k) :
    ResidueField (PowerSeries k ⧸ xSqIdeal k) :=
  IsLocalRing.residue (PowerSeries k ⧸ xSqIdeal k)
    (Ideal.Quotient.mk (xSqIdeal k) (C a))

/-- Constant series recover each residue class after constant-coefficient evaluation. -/
theorem modXSqResidueField_left_inv (k : Type u) [Field k] :
    Function.LeftInverse (modXSqResidueFieldInverse k) (modXSqResidueFieldHom k) := sorry

/-- Constant-coefficient evaluation of the residue class of a constant returns that constant. -/
theorem modXSqResidueField_right_inv (k : Type u) [Field k] :
    Function.RightInverse (modXSqResidueFieldInverse k) (modXSqResidueFieldHom k) := sorry

/-- The residue field of the square-zero power-series quotient is its coefficient field. -/
def modXSqResidueFieldIso (k : Type u) [Field k] :
    ResidueField (PowerSeries k ⧸ xSqIdeal k) ≃ₐ[PowerSeries k] k where
  __ := modXSqResidueFieldHom k
  invFun := modXSqResidueFieldInverse k
  left_inv := modXSqResidueField_left_inv k
  right_inv := modXSqResidueField_right_inv k

/-- The residue identification of `PowerSeries k ⧸ (X ^ 2)` recovers `modXSqResidueHom`. -/
theorem modXSqResidueFieldIso_apply (k : Type u) [Field k]
    (x : PowerSeries k ⧸ xSqIdeal k) :
    modXSqResidueFieldIso k (IsLocalRing.residue (PowerSeries k ⧸ xSqIdeal k) x) =
      modXSqResidueHom k x := rfl

/-- The object `B = PowerSeries k ⧸ (X ^ 2)` of `ArtinianLocalAlgCat (PowerSeries k) k`. -/
def modXSq (k : Type u) [Field k] : ArtinianLocalAlgCat (PowerSeries k) k :=
  of (PowerSeries k ⧸ xSqIdeal k) (modXSqResidueFieldIso k)

/-- The carrier of `modXSq k` is `PowerSeries k ⧸ (X ^ 2)`. -/
theorem modXSq_carrier (k : Type u) [Field k] :
    (modXSq k).carrier = (PowerSeries k ⧸ xSqIdeal k) := rfl

/-- `modXSq k` is the bundled quotient `PowerSeries k ⧸ (X ^ 2)` with residue identification
`modXSqResidueFieldIso`. -/
theorem modXSq_spec (k : Type u) [Field k] :
    (modXSq k).carrier = (PowerSeries k ⧸ xSqIdeal k) ∧
      (modXSq k).residueFieldIso = modXSqResidueFieldIso k := ⟨rfl, rfl⟩

/-- The residue morphism `B ⟶ A` in `ArtinianLocalAlgCat (PowerSeries k) k`, with
`A = k` and `B = PowerSeries k ⧸ (X ^ 2)`. -/
def modXSqToResidue (k : Type u) [Field k] : modXSq k ⟶ residue (PowerSeries k) k :=
  toResidue (modXSq k)

/-- The underlying algebra map of `modXSqToResidue` is `modXSqResidueHom`. -/
theorem modXSqToResidue_hom (k : Type u) [Field k] :
    (modXSqToResidue k).hom = modXSqResidueHom k := sorry

/-- `modXSqToResidue` sends the class of a constant series `C a` to `a`. -/
theorem modXSqToResidue_mk_C (k : Type u) [Field k] (a : k) :
    (modXSqToResidue k).hom (Ideal.Quotient.mk (xSqIdeal k) (C a)) = a := sorry

/-- `modXSqToResidue` sends the class of `X` to `0`. -/
theorem modXSqToResidue_mk_X (k : Type u) [Field k] :
    (modXSqToResidue k).hom (Ideal.Quotient.mk (xSqIdeal k) X) = 0 := sorry

/-- The class of `X` in `PowerSeries k ⧸ (X ^ 2)` lies in the maximal ideal. -/
theorem mk_X_mem_maximalIdeal (k : Type u) [Field k] :
    Ideal.Quotient.mk (xSqIdeal k) X ∈ IsLocalRing.maximalIdeal (PowerSeries k ⧸ xSqIdeal k) := sorry

/-- Coefficient one descends to the square-zero power-series quotient. -/
def modXSqCoeffOne (k : Type u) [Field k] :
    (PowerSeries k ⧸ xSqIdeal k) →ₗ[k] k :=
  ((xSqIdeal k).restrictScalars k).liftQ (coeff 1) (xSqIdeal_le_ker_coeffOne k)

/-- Coefficient one vanishes on products of elements of the quotient's maximal ideal. -/
theorem modXSqCoeffOne_mul_maximalIdeal (k : Type u) [Field k]
    (x y : IsLocalRing.maximalIdeal (PowerSeries k ⧸ xSqIdeal k)) :
    modXSqCoeffOne k (x * y) = 0 := sorry

/-- A scalar maps to its multiple of the cotangent class of the variable. -/
def cotangentSpaceModXSqMap (k : Type u) [Field k] :
    k →ₗ[k] CotangentSpace (PowerSeries k ⧸ xSqIdeal k) :=
  LinearMap.toSpanSingleton k (CotangentSpace (PowerSeries k ⧸ xSqIdeal k))
    ((IsLocalRing.maximalIdeal (PowerSeries k ⧸ xSqIdeal k)).toCotangent
      ⟨Ideal.Quotient.mk (xSqIdeal k) X, mk_X_mem_maximalIdeal k⟩)

/-- Coefficient one induces a linear functional on the cotangent space of the quotient. -/
def cotangentSpaceModXSqInv (k : Type u) [Field k] :
    CotangentSpace (PowerSeries k ⧸ xSqIdeal k) →ₗ[k] k :=
  Ideal.Cotangent.lift
    ((modXSqCoeffOne k).comp
      ((IsLocalRing.maximalIdeal (PowerSeries k ⧸ xSqIdeal k)).subtype.restrictScalars k))
    (modXSqCoeffOne_mul_maximalIdeal k)

/-- Coefficient extraction is a left inverse of the scalar-to-cotangent map. -/
theorem cotangentSpaceModXSq_left_inv (k : Type u) [Field k] :
    Function.LeftInverse (cotangentSpaceModXSqInv k) (cotangentSpaceModXSqMap k) := sorry

/-- The scalar-to-cotangent map is a left inverse of coefficient extraction. -/
theorem cotangentSpaceModXSq_right_inv (k : Type u) [Field k] :
    Function.RightInverse (cotangentSpaceModXSqInv k) (cotangentSpaceModXSqMap k) := sorry

/-- The cotangent space of the square-zero power-series quotient is generated by the variable. -/
def cotangentSpaceModXSqEquiv (k : Type u) [Field k] :
    k ≃ₗ[k] CotangentSpace (PowerSeries k ⧸ xSqIdeal k) where
  __ := cotangentSpaceModXSqMap k
  invFun := cotangentSpaceModXSqInv k
  left_inv := cotangentSpaceModXSq_left_inv k
  right_inv := cotangentSpaceModXSq_right_inv k

/-- The cotangent equivalence sends one to the cotangent class of the variable. -/
theorem cotangentSpaceModXSqEquiv_apply (k : Type u) [Field k] :
    cotangentSpaceModXSqEquiv k 1 =
      (IsLocalRing.maximalIdeal (PowerSeries k ⧸ xSqIdeal k)).toCotangent
        ⟨Ideal.Quotient.mk (xSqIdeal k) X, mk_X_mem_maximalIdeal k⟩ := by
  exact one_smul k
    ((IsLocalRing.maximalIdeal (PowerSeries k ⧸ xSqIdeal k)).toCotangent
      ⟨Ideal.Quotient.mk (xSqIdeal k) X, mk_X_mem_maximalIdeal k⟩)

/-- The residue map of the square-zero power-series quotient is a small extension. -/
instance instIsSmallExtension_modXSqToResidue (k : Type u) [Field k] :
    IsSmallExtension (modXSqToResidue k) := sorry

/-- The residue map of the square-zero quotient has no section over the power-series base. -/
theorem not_exists_section_modXSqToResidue (k : Type u) [Field k] :
    ¬ ∃ s : residue (PowerSeries k) k ⟶ modXSq k, s ≫ modXSqToResidue k = 𝟙 _ := sorry

/-- The residue map of the square-zero power-series quotient is an essential surjection. -/
instance instIsEssentialSurjection_modXSqToResidue (k : Type u) [Field k] :
    IsEssentialSurjection (modXSqToResidue k) := sorry

/-- The residue map of the square-zero quotient is not bijective on ordinary cotangent spaces. -/
theorem not_bijective_mapAlgHom_modXSqToResidue (k : Type u) [Field k] :
    ¬ Function.Bijective (CotangentSpace.mapAlgHom (modXSqToResidue k).hom) := sorry

/-- The residue map of the square-zero quotient is bijective on relative cotangent spaces. -/
theorem bijective_mapRelative_modXSqToResidue (k : Type u) [Field k] :
    Function.Bijective (Hom.mapRelative (modXSqToResidue k)) := sorry

end ArtinianLocalAlgCat
