module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Quasicoherent
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.LocalGeneration
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Quasicoherent quotients

This file isolates the quotient criterion used throughout closed-subspace arguments: a quotient
of a quasicoherent module is quasicoherent when its kernel is locally generated by sections.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

noncomputable section

universe u v w

namespace SheafOfModules.IsQuasicoherent

variable {C : Type u} [Category.{v} C]
variable {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
variable [HasSheafify J AddCommGrpCat.{w}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
variable [∀ U : C, HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
variable [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- A quotient of a quasicoherent module sheaf is quasicoherent when its kernel is locally
generated by sections. -/
@[stacks 01C3 "quasicoherent quotient"]
theorem of_epi {M N : SheafOfModules.{w} R} (f : M ⟶ N)
    [Epi f] [M.IsQuasicoherent]
    [SheafOfModules.IsLocallyGeneratedBySections (kernel f)] :
    N.IsQuasicoherent := sorry

end SheafOfModules.IsQuasicoherent
