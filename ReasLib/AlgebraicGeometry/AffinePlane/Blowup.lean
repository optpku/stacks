module

public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.Rees.StrictTransform
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.Algebra.Field.Basic

/-!
# Separation of plane curves by blowups

The variable ideal separates the two coordinate divisors but does not separate
the line defined by `X 0` from the parabola defined by `X 0 - X 1 ^ 2`.
The ideal generated by `X 0` and `X 1 ^ 2` has the same support and separates
the latter pair.
-/

@[expose] public section

noncomputable section

universe u

open MvPolynomial ReesAlgebra PrimeSpectrum

namespace AlgebraicGeometry.AffinePlane

variable (k : Type u) [Field k]

/-- The polynomial `X 0 - X 1 ^ 2` defining a parabola in the affine plane. -/
def parabola : MvPolynomial (Fin 2) k :=
  X 0 - X 1 ^ 2

/-- The parabola polynomial equals `X 0 - X 1 ^ 2`. -/
theorem parabola_def : parabola k = X 0 - X 1 ^ 2 := rfl

/-- The ideal generated by `X 0` and `X 1 ^ 2` in the coordinate ring of the
affine plane. -/
def separatingIdeal : Ideal (MvPolynomial (Fin 2) k) :=
  Ideal.span {X 0, X 1 ^ 2}

/-- The separating ideal is the span of `X 0` and `X 1 ^ 2`. -/
theorem separatingIdeal_eq_span :
    separatingIdeal k = Ideal.span {X 0, X 1 ^ 2} := rfl

/-- Blowing up the affine plane along the variable ideal gives disjoint strict
transforms of the divisors `V(X 0)` and `V(X 1)`. -/
theorem disjoint_strictTransform_xAxis_yAxis :
    Disjoint (strictTransform (MvPolynomial.idealOfVars (Fin 2) k) (zeroLocus {X 0}))
      (strictTransform (MvPolynomial.idealOfVars (Fin 2) k) (zeroLocus {X 1})) := sorry

/-- Blowing up the affine plane along the variable ideal does not give disjoint
strict transforms of `V(X 0)` and `V(X 0 - X 1 ^ 2)`. -/
theorem not_disjoint_strictTransform_xAxis_parabola :
    ¬ Disjoint (strictTransform (MvPolynomial.idealOfVars (Fin 2) k) (zeroLocus {X 0}))
        (strictTransform (MvPolynomial.idealOfVars (Fin 2) k) (zeroLocus {parabola k})) := sorry

/-- The ideal generated by `X 0` and `X 1 ^ 2` has the same vanishing locus as
the variable ideal and separates the strict transforms of `V(X 0)` and
`V(X 0 - X 1 ^ 2)`. -/
theorem separatingIdeal_spec :
    zeroLocus (separatingIdeal k : Set (MvPolynomial (Fin 2) k)) =
        zeroLocus (MvPolynomial.idealOfVars (Fin 2) k : Set (MvPolynomial (Fin 2) k)) ∧
      Disjoint (strictTransform (separatingIdeal k) (zeroLocus {X 0}))
        (strictTransform (separatingIdeal k) (zeroLocus {parabola k})) := sorry

/-- The ideal generated by `X 0` and `X 1 ^ 2` has the same vanishing locus as
the variable ideal. -/
theorem zeroLocus_separatingIdeal_eq_zeroLocus_originIdeal :
    zeroLocus (separatingIdeal k : Set (MvPolynomial (Fin 2) k)) =
      zeroLocus (MvPolynomial.idealOfVars (Fin 2) k : Set (MvPolynomial (Fin 2) k)) :=
  (separatingIdeal_spec k).1

/-- Blowing up along the ideal generated by `X 0` and `X 1 ^ 2` separates the
strict transforms of `V(X 0)` and `V(X 0 - X 1 ^ 2)`. -/
theorem disjoint_strictTransform_xAxis_parabola_along_separatingIdeal :
    Disjoint (strictTransform (separatingIdeal k) (zeroLocus {X 0}))
      (strictTransform (separatingIdeal k) (zeroLocus {parabola k})) :=
  (separatingIdeal_spec k).2

end AlgebraicGeometry.AffinePlane
