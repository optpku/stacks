open CategoryTheory

noncomputable section

universe u

namespace AlgebraicGeometry.ProjectiveSpace

/-- The homogeneous ideal generated by a degree-one form in projective three-space. -/
def planeIdeal {k : Type u} [Field k]
    (ℓP : MvPolynomial (Fin (3 + 1)) k) (hP : ℓP ∈ grading k 3 1) :
    HomogeneousIdeal (grading k 3) where
  toSubmodule := Ideal.span {ℓP}
  is_homogeneous' := Ideal.homogeneous_span (grading k 3) {ℓP}
    (fun polynomial hmem ↦ ⟨1, (Set.mem_singleton_iff.mp hmem).symm ▸ hP⟩)

/-- The underlying ideal of a linear hypersurface is generated by its defining form. -/
theorem planeIdeal_toIdeal {k : Type u} [Field k]
    (ℓP : MvPolynomial (Fin (3 + 1)) k) (hP : ℓP ∈ grading k 3 1) :
    (planeIdeal ℓP hP).toIdeal = Ideal.span {ℓP} := rfl

/-- The homogeneous ideal generated by two degree-one forms in projective three-space. -/
def lineIdeal {k : Type u} [Field k]
    (ℓL : Fin 2 → MvPolynomial (Fin (3 + 1)) k) (hL : ∀ i, ℓL i ∈ grading k 3 1) :
    HomogeneousIdeal (grading k 3) where
  toSubmodule := Ideal.span (Set.range ℓL)
  is_homogeneous' := Ideal.homogeneous_span (grading k 3) (Set.range ℓL)
    (fun polynomial hmem ↦ hmem.elim (fun index heq ↦ ⟨1, heq ▸ hL index⟩))

/-- The underlying ideal of the linear intersection is generated by its two forms. -/
theorem lineIdeal_toIdeal {k : Type u} [Field k]
    (ℓL : Fin 2 → MvPolynomial (Fin (3 + 1)) k) (hL : ∀ i, ℓL i ∈ grading k 3 1) :
    (lineIdeal ℓL hL).toIdeal = Ideal.span (Set.range ℓL) := rfl

/-- The graded quotient homomorphism by a degree-one equation. -/
def planeQuotientHom {k : Type u} [Field k]
    (ℓP : MvPolynomial (Fin (3 + 1)) k) (hP : ℓP ∈ grading k 3 1) :
    grading k 3 →+*ᵍ GradedAlgebra.Quotient.grading (grading k 3) (planeIdeal ℓP hP).toIdeal where
  toRingHom := (Ideal.Quotient.mkₐ k (planeIdeal ℓP hP).toIdeal).toRingHom
  map_mem := fun hmem ↦
    GradedAlgebra.Quotient.mk_mem_grading (grading k 3) (planeIdeal ℓP hP).toIdeal hmem

/-- The graded quotient homomorphism by two degree-one equations. -/
def lineQuotientHom {k : Type u} [Field k]
    (ℓL : Fin 2 → MvPolynomial (Fin (3 + 1)) k) (hL : ∀ i, ℓL i ∈ grading k 3 1) :
    grading k 3 →+*ᵍ GradedAlgebra.Quotient.grading (grading k 3) (lineIdeal ℓL hL).toIdeal where
  toRingHom := (Ideal.Quotient.mkₐ k (lineIdeal ℓL hL).toIdeal).toRingHom
  map_mem := fun hmem ↦
    GradedAlgebra.Quotient.mk_mem_grading (grading k 3) (lineIdeal ℓL hL).toIdeal hmem

/-- The irrelevant ideal of the linear hypersurface quotient lies in the image of the
ambient irrelevant ideal. -/
theorem planeQuotient_irrelevant_le {k : Type u} [Field k]
    (ℓP : MvPolynomial (Fin (3 + 1)) k) (hP : ℓP ∈ grading k 3 1) :
    -- Local instance justification (defeq pin): pin the canonical quotient grading used by the quotient projective spectrum so the irrelevant ideal is definitionally aligned.
    letI := GradedAlgebra.Quotient.gradedAlgebra (grading k 3)
      (planeIdeal ℓP hP).toIdeal (planeIdeal ℓP hP).isHomogeneous
    HomogeneousIdeal.irrelevant
        (GradedAlgebra.Quotient.grading (grading k 3) (planeIdeal ℓP hP).toIdeal) ≤
      (HomogeneousIdeal.irrelevant (grading k 3)).map (planeQuotientHom ℓP hP) := by
  letI := GradedAlgebra.Quotient.gradedAlgebra (grading k 3)
    (planeIdeal ℓP hP).toIdeal (planeIdeal ℓP hP).isHomogeneous
  apply (HomogeneousIdeal.irrelevant_le _).mpr
  intro i hi x hx
  obtain ⟨a, ha, rfl⟩ := hx
  exact Ideal.mem_map_of_mem (planeQuotientHom ℓP hP)
    (HomogeneousIdeal.mem_irrelevant_of_mem (grading k 3) hi ha)

/-- The irrelevant ideal of the quotient by two linear equations lies in the image of the
ambient irrelevant ideal. -/
theorem lineQuotient_irrelevant_le {k : Type u} [Field k]
    (ℓL : Fin 2 → MvPolynomial (Fin (3 + 1)) k) (hL : ∀ i, ℓL i ∈ grading k 3 1) :
    -- Local instance justification (defeq pin): pin the canonical quotient grading used by the quotient projective spectrum so the irrelevant ideal is definitionally aligned.
    letI := GradedAlgebra.Quotient.gradedAlgebra (grading k 3)
      (lineIdeal ℓL hL).toIdeal (lineIdeal ℓL hL).isHomogeneous
    HomogeneousIdeal.irrelevant
        (GradedAlgebra.Quotient.grading (grading k 3) (lineIdeal ℓL hL).toIdeal) ≤
      (HomogeneousIdeal.irrelevant (grading k 3)).map (lineQuotientHom ℓL hL) := by
  letI := GradedAlgebra.Quotient.gradedAlgebra (grading k 3)
    (lineIdeal ℓL hL).toIdeal (lineIdeal ℓL hL).isHomogeneous
  apply (HomogeneousIdeal.irrelevant_le _).mpr
  intro i hi x hx
  obtain ⟨a, ha, rfl⟩ := hx
  exact Ideal.mem_map_of_mem (lineQuotientHom ℓL hL)
    (HomogeneousIdeal.mem_irrelevant_of_mem (grading k 3) hi ha)

/-- The inclusion of the closed subscheme cut out by a degree-one equation in projective
three-space. -/
def planeι {k : Type u} [Field k]
    (ℓP : MvPolynomial (Fin (3 + 1)) k) (hP : ℓP ∈ grading k 3 1) :
    -- Local instance justification (defeq pin): pin the canonical quotient grading so the Proj domain is definitionally equal to the constructed quotient spectrum.
    letI := GradedAlgebra.Quotient.gradedAlgebra (grading k 3)
      (planeIdeal ℓP hP).toIdeal (planeIdeal ℓP hP).isHomogeneous
    Proj (GradedAlgebra.Quotient.grading (grading k 3) (planeIdeal ℓP hP).toIdeal) ⟶ scheme k 3 :=
  -- Local instance justification (defeq pin): pin the canonical quotient grading so Proj.map matches its domain and irrelevant-ideal inequality definitionally.
  letI := GradedAlgebra.Quotient.gradedAlgebra (grading k 3)
    (planeIdeal ℓP hP).toIdeal (planeIdeal ℓP hP).isHomogeneous
  Proj.map (planeQuotientHom ℓP hP) (planeQuotient_irrelevant_le ℓP hP)

/-- The inclusion of the closed subscheme cut out by two degree-one equations in projective
three-space. -/
def lineι {k : Type u} [Field k]
    (ℓL : Fin 2 → MvPolynomial (Fin (3 + 1)) k) (hL : ∀ i, ℓL i ∈ grading k 3 1) :
    -- Local instance justification (defeq pin): pin the canonical quotient grading so the Proj domain is definitionally equal to the constructed quotient spectrum.
    letI := GradedAlgebra.Quotient.gradedAlgebra (grading k 3)
      (lineIdeal ℓL hL).toIdeal (lineIdeal ℓL hL).isHomogeneous
    Proj (GradedAlgebra.Quotient.grading (grading k 3) (lineIdeal ℓL hL).toIdeal) ⟶ scheme k 3 :=
  -- Local instance justification (defeq pin): pin the canonical quotient grading so Proj.map matches its domain and irrelevant-ideal inequality definitionally.
  letI := GradedAlgebra.Quotient.gradedAlgebra (grading k 3)
    (lineIdeal ℓL hL).toIdeal (lineIdeal ℓL hL).isHomogeneous
  Proj.map (lineQuotientHom ℓL hL) (lineQuotient_irrelevant_le ℓL hL)

open HomogeneousLocalization in
set_option backward.isDefEq.respectTransparency false in
private theorem isClosedImmersion_gradedMap {A B σ τ : Type u} [CommRing A] [CommRing B]
    [SetLike σ A] [AddSubgroupClass σ A] [SetLike τ B] [AddSubgroupClass τ B]
    {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
    (f : 𝒜 →+*ᵍ ℬ)
    (hf : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒜).map f)
    (hsurj : ∀ i, Function.Surjective (f.gradedAddHom i)) :
    IsClosedImmersion (Proj.map f hf) := by
  let U : (Proj.affineOpenCover 𝒜).I₀ → (Proj 𝒜).Opens :=
    fun s ↦ Proj.basicOpen 𝒜 s.2
  have hU : iSup U = ⊤ := by
    apply Proj.iSup_basicOpen_eq_top
    exact (HomogeneousIdeal.toIdeal_irrelevant_le _).mpr fun i hi x hx ↦
      Ideal.subset_span ⟨⟨⟨i, hi⟩, ⟨x, hx⟩⟩, rfl⟩
  apply IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsClosedImmersion) U hU
  intro s
  let eA := Proj.basicOpenIsoSpec 𝒜 s.2.val s.2.2 s.1.2
  let eB := Proj.basicOpenIsoSpec ℬ (f s.2) (f.map_mem s.2.2) s.1.2
  have hloc : Function.Surjective (Away.map f s.2) := by
    intro x
    obtain ⟨n, b, hb, rfl⟩ := Away.mk_surjective ℬ (f.map_mem s.2.2) x
    obtain ⟨a, ha⟩ := hsurj (n • (s.1 : ℕ)) ⟨b, hb⟩
    refine ⟨Away.mk 𝒜 s.2.2 n a a.2, ?_⟩
    have hab : f a.val = b := congrArg Subtype.val ha
    simp only [Away.map_mk, hab]
  have heq : eB.inv ≫ (Proj.map f hf ∣_ U s) =
      Spec.map (CommRingCat.ofHom (Away.map f s.2)) ≫ eA.inv := by
    apply (cancel_mono (U s).ι).mp
    dsimp only [U, eA, eB]
    rw [Category.assoc, morphismRestrict_ι]
    simpa only [Proj.awayι, Category.assoc, Proj.map_preimage_basicOpen] using
      (Proj.awayι_comp_map f hf s.1.2 s.2 s.2.2)
  apply (MorphismProperty.cancel_left_of_respectsIso @IsClosedImmersion eB.inv _).mp
  rw [heq]
  haveI := IsClosedImmersion.spec_of_surjective
    (CommRingCat.ofHom (Away.map f s.2)) hloc
  exact IsClosedImmersion.comp _ _

/-- The inclusion cut out by a degree-one equation is a closed immersion. -/
instance instIsClosedImmersionPlaneι {k : Type u} [Field k]
    (ℓP : MvPolynomial (Fin (3 + 1)) k) (hP : ℓP ∈ grading k 3 1) :
    IsClosedImmersion (planeι ℓP hP) := by
  letI := GradedAlgebra.Quotient.gradedAlgebra (grading k 3)
    (planeIdeal ℓP hP).toIdeal (planeIdeal ℓP hP).isHomogeneous
  exact isClosedImmersion_gradedMap (planeQuotientHom ℓP hP)
    (planeQuotient_irrelevant_le ℓP hP) fun i ↦
      GradedAlgebra.Quotient.componentMap_surjective (grading k 3) _ i

/-- The inclusion cut out by two degree-one equations is a closed immersion. -/
instance instIsClosedImmersionLineι {k : Type u} [Field k]
    (ℓL : Fin 2 → MvPolynomial (Fin (3 + 1)) k) (hL : ∀ i, ℓL i ∈ grading k 3 1) :
    IsClosedImmersion (lineι ℓL hL) := by
  letI := GradedAlgebra.Quotient.gradedAlgebra (grading k 3)
    (lineIdeal ℓL hL).toIdeal (lineIdeal ℓL hL).isHomogeneous
  exact isClosedImmersion_gradedMap (lineQuotientHom ℓL hL)
    (lineQuotient_irrelevant_le ℓL hL) fun i ↦
      GradedAlgebra.Quotient.componentMap_surjective (grading k 3) _ i

/-- The structure sheaf of a linear hypersurface, pushed forward to projective three-space. -/
def planeModule {k : Type u} [Field k]
    (ℓP : MvPolynomial (Fin (3 + 1)) k) (hP : ℓP ∈ grading k 3 1) :
    (scheme k 3).Modules :=
  (Scheme.Modules.pushforward (planeι ℓP hP)).obj (SheafOfModules.unit _)

/-- The structure sheaf of the intersection of two linear hypersurfaces, pushed forward to
projective three-space. -/
def lineModule {k : Type u} [Field k]
    (ℓL : Fin 2 → MvPolynomial (Fin (3 + 1)) k) (hL : ∀ i, ℓL i ∈ grading k 3 1) :
    (scheme k 3).Modules :=
  (Scheme.Modules.pushforward (lineι ℓL hL)).obj (SheafOfModules.unit _)

/-- A line is contained in a plane when the plane equation lies in the linear span of the
two line equations. -/
def lineContainedInPlane {k : Type u} [Field k]
    (ℓL : Fin 2 → MvPolynomial (Fin (3 + 1)) k)
    (ℓP : MvPolynomial (Fin (3 + 1)) k) : Prop :=
  ℓP ∈ Submodule.span k (Set.range ℓL)

private theorem linearForm_component_mul {R σ : Type*} [CommSemiring R]
    (a ℓ : MvPolynomial σ R) (hℓ : ℓ.IsHomogeneous 1) :
    MvPolynomial.homogeneousComponent 1 (a * ℓ) = MvPolynomial.constantCoeff a • ℓ := by
  classical
  induction a using MvPolynomial.induction_on' with
  | monomial d r =>
    by_cases hd : d = 0
    · subst d
      change MvPolynomial.homogeneousComponent 1 (MvPolynomial.C r * ℓ) =
        MvPolynomial.constantCoeff (MvPolynomial.C r) • ℓ
      rw [MvPolynomial.homogeneousComponent_C_mul,
        MvPolynomial.homogeneousComponent_eq_self hℓ, MvPolynomial.constantCoeff_C,
        MvPolynomial.smul_eq_C_mul]
    · have hdegree : d.degree ≠ 0 := fun h ↦ hd ((Finsupp.degree_eq_zero_iff d).mp h)
      rw [MvPolynomial.homogeneousComponent_of_mem
        ((MvPolynomial.isHomogeneous_monomial r rfl).mul hℓ)]
      simp [hdegree, MvPolynomial.constantCoeff_monomial, hd]
  | add a b ha hb =>
    simp only [add_mul, map_add, ha, hb, add_smul]

/-- For degree-one equations, containment is equivalent to membership of the plane equation
in the ideal generated by the line equations. -/
theorem lineContainedInPlane_iff {k : Type u} [Field k]
    (ℓL : Fin 2 → MvPolynomial (Fin (3 + 1)) k)
    (ℓP : MvPolynomial (Fin (3 + 1)) k)
    (hL : ∀ i, ℓL i ∈ grading k 3 1) (hP : ℓP ∈ grading k 3 1) :
    lineContainedInPlane ℓL ℓP ↔ ℓP ∈ (lineIdeal ℓL hL).toIdeal := by
  change ℓP ∈ Submodule.span k (Set.range ℓL) ↔ ℓP ∈ Ideal.span (Set.range ℓL)
  constructor
  · exact fun h ↦ (Submodule.span_le_restrictScalars k _ _) h
  · intro h
    obtain ⟨a, ha⟩ := Ideal.mem_span_range_iff_exists_fun.mp h
    rw [← MvPolynomial.homogeneousComponent_eq_self hP, ← ha, map_sum]
    exact Submodule.sum_mem _ fun i _ ↦ by
      rw [linearForm_component_mul (a i) (ℓL i) (hL i)]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)

end AlgebraicGeometry.ProjectiveSpace
