module

public import Mathlib.RingTheory.DividedPowers.Padic
public import Mathlib.Algebra.Ring.GeomSum
public import ReasLib.RingTheory.Localization.AtPrime.Int
public import ReasLib.RingTheory.DividedPowers.Extension.Criteria
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Canonical divided powers on `(p)` over prime-local rings

The prime-local construction assumes only that integers not divisible by `p` are units.
Its explicit coefficient removes the `p`-part of the factorial before taking an inverse.
The original p-adic algebra construction and all its public signatures are retained, with
proved comparisons to the general construction.

The coefficient of `a ^ n` is kept as the canonical element
`(PadicInt.dividedPowers p).dpow n p` of `ℤ_[p]`. After embedding into `ℚ_[p]` it is
`p ^ n / n !`; writing `Ring.inverse (n !)` inside `ℤ_[p]` would be incorrect when `p ∣ n !`.
-/

@[expose] public section

universe u v

namespace PadicInt

variable {p : ℕ} [Fact p.Prime]
variable {A : Type u} [CommRing A] [Algebra ℤ_[p] A]

/-- The image of the principal ideal `(p) ⊂ ℤ_[p]` in a `ℤ_[p]`-algebra is the principal
ideal generated by `(p : A)`. -/
theorem map_span_prime_eq :
    Ideal.map (algebraMap ℤ_[p] A) (Ideal.span ({(p : ℤ_[p])} : Set ℤ_[p])) =
      Ideal.span ({(p : A)} : Set A) := by
  rw [Ideal.map_span, Set.image_singleton, map_natCast]

/-- On an element of `(p)`, the canonical divided power becomes `x ^ n / n !` after embedding
`ℤ_[p]` into its fraction field `ℚ_[p]`. -/
theorem coe_dpow_eq_of_mem (n : ℕ) {x : ℤ_[p]}
    (hx : x ∈ Ideal.span ({(p : ℤ_[p])} : Set ℤ_[p])) :
    ((dividedPowers p).dpow n x : ℚ_[p]) =
      Ring.inverse (n.factorial : ℚ_[p]) * (x : ℚ_[p]) ^ n := by
  simpa only [dite_eq_ite, if_pos hx] using (coe_dpow_eq (p := p) n x)

/-- On the principal ideal `(p)`, `invFun` selects an actual multiplicative preimage.
This uses only the proved characterization of membership in a principal ideal. -/
theorem mul_prime_invFun (p : ℕ) (R : Type u) [CommRing R] (x : R)
    (hx : x ∈ Ideal.span ({(p : R)} : Set R)) :
    (p : R) * Function.invFun (fun a : R ↦ (p : R) * a) x = x := by
  apply Function.invFun_eq
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton.mp hx
  exact ⟨a, ha.symm⟩

/-- The prime-free part of a factorial is not divisible by the prime. -/
theorem primeFreeFactorial_not_dvd (p n : ℕ) [Fact p.Prime] :
    ¬ p ∣ n.factorial / p ^ padicValNat p n.factorial := by
  intro h
  apply pow_succ_padicValNat_not_dvd (p := p) n.factorial_ne_zero
  rw [pow_succ]
  exact (Nat.mul_dvd_mul_left _ h).trans
    (dvd_of_eq (Nat.mul_div_cancel' pow_padicValNat_dvd))

/-- The coefficient `p^n/n!` evaluated in a ring where integers prime to `p` are units.
Only the prime-free part of the factorial is inverted. -/
noncomputable def primeLocalCoefficient (p n : ℕ) (R : Type u) [CommRing R] : R :=
  (p : R) ^ (n - padicValNat p n.factorial) *
    Ring.inverse ((n.factorial / p ^ padicValNat p n.factorial : ℕ) : R)

/-- The inverse in the coefficient formula is the inverse of an actual unit. -/
theorem primeLocalCoefficient_denominator_isUnit (p n : ℕ) [Fact p.Prime]
    (R : Type u) [CommRing R]
    (hunit : ∀ k : ℕ, ¬ p ∣ k → IsUnit (k : R)) :
    IsUnit ((n.factorial / p ^ padicValNat p n.factorial : ℕ) : R) :=
  hunit _ (primeFreeFactorial_not_dvd p n)

/-- The degree-zero coefficient is one. -/
@[simp] theorem primeLocalCoefficient_zero (p : ℕ) (R : Type u) [CommRing R] :
    primeLocalCoefficient p 0 R = 1 := by
  simp [primeLocalCoefficient]

/-- The degree-one coefficient is `p`. -/
@[simp] theorem primeLocalCoefficient_one (p : ℕ) (R : Type u) [CommRing R] :
    primeLocalCoefficient p 1 R = p := by
  simp [primeLocalCoefficient]

/-- Every positive coefficient is divisible by `p`, even in a ring with `p`-torsion. -/
theorem primeLocalCoefficient_mem (p n : ℕ) [Fact p.Prime]
    (R : Type u) [CommRing R] (hn : n ≠ 0) :
    primeLocalCoefficient p n R ∈ Ideal.span ({(p : R)} : Set R) := by
  apply Ideal.mem_span_singleton.mpr
  refine ⟨(p : R) ^ (n - padicValNat p n.factorial - 1) *
    Ring.inverse ((n.factorial / p ^ padicValNat p n.factorial : ℕ) : R), ?_⟩
  have hpos : 0 < n - padicValNat p n.factorial :=
    Nat.sub_pos_of_lt (padicValNat_factorial_lt_of_ne_zero p hn)
  unfold primeLocalCoefficient
  rw [← mul_assoc, ← pow_succ', Nat.sub_one_add_one hpos.ne']

/-- The coefficient formula is independent of the representative `x = p*a`. -/
theorem primeLocalCoefficient_mul_pow_eq (p n : ℕ) [Fact p.Prime]
    (R : Type u) [CommRing R] {a b : R} (hab : (p : R) * a = (p : R) * b) :
    primeLocalCoefficient p n R * a ^ n = primeLocalCoefficient p n R * b ^ n := by
  by_cases hn : n = 0
  · simp [hn]
  · obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp (primeLocalCoefficient_mem p n R hn)
    obtain ⟨d, hd⟩ := sub_dvd_pow_sub_pow a b n
    have hpab : (p : R) * (a - b) = 0 := by rw [mul_sub, hab, sub_self]
    apply sub_eq_zero.mp
    rw [← mul_sub, hc, hd]
    calc
      ((p : R) * c) * ((a - b) * d) = ((p : R) * (a - b)) * (c * d) := by ac_rfl
      _ = 0 := by rw [hpab, zero_mul]

/-- Explicit canonical operations on `(p)`, zero off the ideal. The only preimage selection
is for the actual multiplication map; `mul_prime_invFun` proves its specification. -/
noncomputable def primeLocalDpow (p : ℕ) [Fact p.Prime]
    (R : Type u) [CommRing R] (n : ℕ) (x : R) : R := by
  classical
  exact if x ∈ Ideal.span ({(p : R)} : Set R) then
    primeLocalCoefficient p n R * (Function.invFun (fun a : R ↦ (p : R) * a) x) ^ n
  else 0

/-- The canonical formula on every representative. -/
theorem primeLocalDpow_mul (p : ℕ) [Fact p.Prime]
    (R : Type u) [CommRing R] (n : ℕ) (a : R) :
    primeLocalDpow p R n ((p : R) * a) = primeLocalCoefficient p n R * a ^ n := by
  classical
  have hx : (p : R) * a ∈ Ideal.span ({(p : R)} : Set R) :=
    Ideal.mem_span_singleton.mpr ⟨a, rfl⟩
  rw [primeLocalDpow, if_pos hx]
  exact primeLocalCoefficient_mul_pow_eq p n R (mul_prime_invFun p R _ hx)

/-- Prime-to-`p` integers are units in the canonical p-adic base. -/
theorem primeToP_isUnit (p : ℕ) [Fact p.Prime] (n : ℕ) (hn : ¬ p ∣ n) :
    IsUnit (n : ℤ_[p]) :=
  PadicInt.isUnit_iff.mpr (PadicInt.norm_natCast_eq_one_iff.mpr ((Fact.out : p.Prime).coprime_iff_not_dvd.mpr hn))

/-- Every p-adic algebra satisfies the prime-local unit hypothesis. -/
theorem algebra_primeToP_isUnit (n : ℕ) (hn : ¬ p ∣ n) : IsUnit (n : A) := by
  simpa only [map_natCast] using (primeToP_isUnit p n hn).map (algebraMap ℤ_[p] A)

private theorem map_inverse_of_unit {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    (f : R →+* S) (x : R) (hx : IsUnit x) :
    f (Ring.inverse x) = Ring.inverse (f x) := by
  calc
    f (Ring.inverse x) = (f (Ring.inverse x) * f x) * Ring.inverse (f x) := by
      rw [mul_assoc, Ring.mul_inverse_cancel _ (hx.map f), mul_one]
    _ = Ring.inverse (f x) := by rw [← map_mul, Ring.inverse_mul_cancel _ hx, map_one, one_mul]

/-- The explicit coefficient is natural under ring homomorphisms when its denominator
is a unit in the source. -/
theorem primeLocalCoefficient_map (p n : ℕ) [Fact p.Prime]
    {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    (hunit : ∀ k : ℕ, ¬ p ∣ k → IsUnit (k : R)) (f : R →+* S) :
    f (primeLocalCoefficient p n R) = primeLocalCoefficient p n S := by
  unfold primeLocalCoefficient
  rw [map_mul, map_pow, map_natCast,
    map_inverse_of_unit f _ (primeLocalCoefficient_denominator_isUnit p n R hunit), map_natCast]

/-- The prime-local coefficient agrees with the original canonical p-adic coefficient.
This comparison uses the embedding into `ℚ_[p]`, where the factorial is invertible. -/
theorem primeLocalCoefficient_eq_padic (n : ℕ) :
    primeLocalCoefficient p n A =
      algebraMap ℤ_[p] A ((dividedPowers p).dpow n (p : ℤ_[p])) := by
  have hbase : primeLocalCoefficient p n ℤ_[p] = (dividedPowers p).dpow n (p : ℤ_[p]) := by
    apply PadicInt.ext
    rw [coe_dpow_eq_of_mem n (Ideal.subset_span (by simp))]
    have hmap := primeLocalCoefficient_map p n (primeToP_isUnit p) (PadicInt.Coe.ringHom (p := p))
    change ((primeLocalCoefficient p n ℤ_[p] : ℤ_[p]) : ℚ_[p]) = _
    rw [show ((primeLocalCoefficient p n ℤ_[p] : ℤ_[p]) : ℚ_[p]) =
      primeLocalCoefficient p n ℚ_[p] from hmap]
    have hfac : (n.factorial : ℚ_[p]) = (p : ℚ_[p]) ^ padicValNat p n.factorial *
        ((n.factorial / p ^ padicValNat p n.factorial : ℕ) : ℚ_[p]) := by
      exact_mod_cast (Nat.mul_div_cancel' (pow_padicValNat_dvd (p := p) (n := n.factorial))).symm
    have hp0 : (p : ℚ_[p]) ≠ 0 := by exact_mod_cast (Fact.out : p.Prime).ne_zero
    have hf0 : (n.factorial : ℚ_[p]) ≠ 0 := by exact_mod_cast n.factorial_ne_zero
    unfold primeLocalCoefficient
    rw [Ring.inverse_eq_inv, Ring.inverse_eq_inv]
    simp only [coe_natCast]
    apply (eq_inv_mul_iff_mul_eq₀ hf0).2
    rw [hfac, mul_assoc, ← mul_assoc _ ((n.factorial / p ^ padicValNat p n.factorial : ℕ) : ℚ_[p])]
    have hd0 : ((n.factorial / p ^ padicValNat p n.factorial : ℕ) : ℚ_[p]) ≠ 0 :=
      (mul_ne_zero_iff.mp (hfac ▸ hf0)).2
    calc
      _ = (p : ℚ_[p]) ^ padicValNat p n.factorial *
          (p : ℚ_[p]) ^ (n - padicValNat p n.factorial) := by
        field_simp
      _ = (p : ℚ_[p]) ^ n := by rw [← pow_add, Nat.add_sub_of_le (padicValNat_factorial_le p n)]
  rw [← hbase, primeLocalCoefficient_map p n (primeToP_isUnit p) (algebraMap ℤ_[p] A)]

/-- Prime-to-`p` integers are units in the canonical localization of `ℤ`. -/
private theorem primeLocalBase_isUnit (p : ℕ) [Fact p.Prime]
    (n : ℕ) (hn : ¬ p ∣ n) : IsUnit (n : Int.LocalizationAtPrime p) := by
  have hu : IsUnit (algebraMap ℤ (Int.LocalizationAtPrime p) (n : ℤ)) :=
    (IsLocalization.AtPrime.isUnit_to_map_iff (Int.LocalizationAtPrime p)
      (Ideal.span ({(p : ℤ)} : Set ℤ)) (n : ℤ)).2 (by
        change (n : ℤ) ∉ Ideal.span ({(p : ℤ)} : Set ℤ)
        simpa only [Ideal.mem_span_singleton, Int.natCast_dvd_natCast] using hn)
  simpa using hu

/-- The localization universal map. Its unit certificates are proved directly from `hunit`;
no divided-power existence assertion is used. -/
private noncomputable def primeLocalLift (p : ℕ) [Fact p.Prime]
    (R : Type u) [CommRing R]
    (hunit : ∀ k : ℕ, ¬ p ∣ k → IsUnit (k : R)) : Int.LocalizationAtPrime p →+* R :=
  IsLocalization.lift (M := (Ideal.span ({(p : ℤ)} : Set ℤ)).primeCompl)
    (g := Int.castRingHom R) (fun z ↦ by
      have hz : ¬ (p : ℤ) ∣ z.1 := Ideal.mem_span_singleton.not.mp z.2
      have hu : IsUnit (z.1.natAbs : R) := hunit _ (fun h ↦ hz (Int.natCast_dvd.mpr h))
      change IsUnit (z.1 : R)
      rcases Int.natAbs_eq z.1 with h | h
      · rw [h]
        simpa only [Int.cast_natCast] using hu
      · rw [h, Int.cast_neg]
        simpa only [Int.cast_natCast] using hu.neg)

/-- The universal map into the p-adic integers is injective. This follows from the
injectivity of the integer casts, using the proved localization criterion. -/
private theorem primeLocalLift_injective (p : ℕ) [Fact p.Prime] :
    Function.Injective (primeLocalLift p ℤ_[p] (primeToP_isUnit p)) := by
  apply IsLocalization.injective_of_map_algebraMap_zero
    (M := (Ideal.span ({(p : ℤ)} : Set ℤ)).primeCompl)
  intro z hz
  have hz0 : z = 0 := by
    apply Int.cast_injective (α := ℤ_[p])
    simpa [primeLocalLift, IsLocalization.lift_eq] using hz
  simp [hz0]

private theorem primeLocalCoefficient_lift_padic (p n : ℕ) [Fact p.Prime] :
    primeLocalLift p ℤ_[p] (primeToP_isUnit p)
        (primeLocalCoefficient p n (Int.LocalizationAtPrime p)) =
      (dividedPowers p).dpow n (p : ℤ_[p]) := by
  rw [primeLocalCoefficient_map p n (primeLocalBase_isUnit p)]
  simpa using (primeLocalCoefficient_eq_padic (p := p) (A := ℤ_[p]) n)

/-- The binomial coefficient identity is first checked in the canonical p-local integers,
which embed in the p-adic integers, and then mapped to the possibly torsion target. -/
private theorem primeLocalCoefficient_mul (p m n : ℕ) [Fact p.Prime]
    (R : Type u) [CommRing R]
    (hunit : ∀ k : ℕ, ¬ p ∣ k → IsUnit (k : R)) :
    primeLocalCoefficient p m R * primeLocalCoefficient p n R =
      (Nat.choose (m + n) m : R) * primeLocalCoefficient p (m + n) R := by
  have hbase :
      primeLocalCoefficient p m (Int.LocalizationAtPrime p) *
          primeLocalCoefficient p n (Int.LocalizationAtPrime p) =
        (Nat.choose (m + n) m : Int.LocalizationAtPrime p) *
          primeLocalCoefficient p (m + n) (Int.LocalizationAtPrime p) := by
    apply primeLocalLift_injective p
    simp only [map_mul, map_natCast, primeLocalCoefficient_lift_padic]
    exact (dividedPowers p).mul_dpow (Ideal.subset_span (by simp))
  have h := congrArg (primeLocalLift p R hunit) hbase
  simpa only [map_mul, map_natCast,
    primeLocalCoefficient_map p _ (primeLocalBase_isUnit p)] using h

/-- A coefficient identity for composition, proved in the torsion-free universal base.
The element `d` is any actual quotient of the positive coefficient by `p`. -/
private theorem primeLocalCoefficient_comp (p m n : ℕ) [Fact p.Prime] (hn : n ≠ 0)
    (d : Int.LocalizationAtPrime p)
    (hd : (p : Int.LocalizationAtPrime p) * d =
      primeLocalCoefficient p n (Int.LocalizationAtPrime p)) :
    primeLocalCoefficient p m (Int.LocalizationAtPrime p) * d ^ m =
      (Nat.uniformBell m n : Int.LocalizationAtPrime p) *
        primeLocalCoefficient p (m * n) (Int.LocalizationAtPrime p) := by
  let f := primeLocalLift p ℤ_[p] (primeToP_isUnit p)
  have hd' : (p : ℤ_[p]) * f d = (dividedPowers p).dpow n (p : ℤ_[p]) := by
    have h := congrArg f hd
    dsimp only [f] at h ⊢
    simpa only [map_mul, map_natCast, primeLocalCoefficient_lift_padic] using h
  apply primeLocalLift_injective p
  simp only [map_mul, map_pow, map_natCast, primeLocalCoefficient_lift_padic]
  have h := (dividedPowers p).dpow_comp (m := m) (n := n) hn
    (x := (p : ℤ_[p])) (Ideal.subset_span (by simp))
  rw [← hd', mul_comm (p : ℤ_[p]) (f d),
    (dividedPowers p).dpow_mul (Ideal.subset_span (by simp))] at h
  simpa only [mul_comm] using h

/-- The addition law for the explicit prime-local operations. -/
theorem primeLocalDpow_add (p : ℕ) [Fact p.Prime]
    (R : Type u) [CommRing R]
    (hunit : ∀ k : ℕ, ¬ p ∣ k → IsUnit (k : R))
    {n : ℕ} {x y : R} (hx : x ∈ Ideal.span ({(p : R)} : Set R))
    (hy : y ∈ Ideal.span ({(p : R)} : Set R)) :
    primeLocalDpow p R n (x + y) = (Finset.antidiagonal n).sum
      (fun k ↦ primeLocalDpow p R k.1 x * primeLocalDpow p R k.2 y) := by
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hx
  obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton.mp hy
  rw [← mul_add, primeLocalDpow_mul, (Commute.all a b).add_pow', Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro k hk
  have hkn : k.1 + k.2 = n := Finset.mem_antidiagonal.mp hk
  rw [primeLocalDpow_mul, primeLocalDpow_mul, nsmul_eq_mul]
  calc
    _ = ((Nat.choose n k.1 : R) * primeLocalCoefficient p n R) *
        (a ^ k.1 * b ^ k.2) := by ac_rfl
    _ = _ := by
      rw [← hkn, ← primeLocalCoefficient_mul p k.1 k.2 R hunit]
      ac_rfl

/-- The product law for the explicit prime-local operations. -/
theorem primeLocalDpow_mul_dpow (p : ℕ) [Fact p.Prime]
    (R : Type u) [CommRing R]
    (hunit : ∀ k : ℕ, ¬ p ∣ k → IsUnit (k : R))
    {m n : ℕ} {x : R} (hx : x ∈ Ideal.span ({(p : R)} : Set R)) :
    primeLocalDpow p R m x * primeLocalDpow p R n x =
      (Nat.choose (m + n) m : R) * primeLocalDpow p R (m + n) x := by
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hx
  rw [primeLocalDpow_mul, primeLocalDpow_mul, primeLocalDpow_mul]
  calc
    _ = (primeLocalCoefficient p m R * primeLocalCoefficient p n R) * a ^ (m + n) := by
      rw [pow_add]
      ac_rfl
    _ = _ := by rw [primeLocalCoefficient_mul p m n R hunit]; ac_rfl

/-- The composition law for the explicit prime-local operations. -/
theorem primeLocalDpow_comp (p : ℕ) [Fact p.Prime]
    (R : Type u) [CommRing R]
    (hunit : ∀ k : ℕ, ¬ p ∣ k → IsUnit (k : R))
    {m n : ℕ} {x : R} (hn : n ≠ 0) (hx : x ∈ Ideal.span ({(p : R)} : Set R)) :
    primeLocalDpow p R m (primeLocalDpow p R n x) =
      (Nat.uniformBell m n : R) * primeLocalDpow p R (m * n) x := by
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hx
  obtain ⟨d, hd⟩ := Ideal.mem_span_singleton.mp
    (primeLocalCoefficient_mem p n (Int.LocalizationAtPrime p) hn)
  let f := primeLocalLift p R hunit
  have hd' : primeLocalCoefficient p n R = (p : R) * f d := by
    have h := congrArg f hd
    simpa only [map_mul, map_natCast,
      primeLocalCoefficient_map p n (primeLocalBase_isUnit p)] using h
  have hcomp : primeLocalCoefficient p m R * (f d) ^ m =
      (Nat.uniformBell m n : R) * primeLocalCoefficient p (m * n) R := by
    have h := congrArg f (primeLocalCoefficient_comp p m n hn d hd.symm)
    simpa only [map_mul, map_pow, map_natCast,
      primeLocalCoefficient_map p _ (primeLocalBase_isUnit p)] using h
  rw [primeLocalDpow_mul, hd', mul_assoc, primeLocalDpow_mul, primeLocalDpow_mul, mul_pow]
  calc
    _ = (primeLocalCoefficient p m R * (f d) ^ m) * a ^ (m * n) := by
      rw [← pow_mul, Nat.mul_comm n m]
      ring
    _ = _ := by rw [hcomp]; ac_rfl

/-- Canonical divided powers under exactly the prime-to-`p` unit hypothesis of 07GN.
The operations are explicit and do not select a divided-power existence theorem. -/
noncomputable def primeLocalDividedPowers (p : ℕ) [Fact p.Prime]
    (R : Type u) [CommRing R]
    (hunit : ∀ k : ℕ, ¬ p ∣ k → IsUnit (k : R)) :
    DividedPowers (Ideal.span ({(p : R)} : Set R)) where
  dpow := primeLocalDpow p R
  dpow_null hx := by
    classical
    exact if_neg hx
  dpow_zero hx := by
    classical
    simp only [primeLocalDpow, if_pos hx, pow_zero, mul_one, primeLocalCoefficient_zero]
  dpow_one hx := by
    classical
    simp only [primeLocalDpow, if_pos hx, pow_one, primeLocalCoefficient_one]
    exact mul_prime_invFun p R _ hx
  dpow_mem := by
    intro n x hn hx
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hx
    rw [primeLocalDpow_mul]
    exact Ideal.mul_mem_right _ _ (primeLocalCoefficient_mem p n R hn)
  dpow_add := primeLocalDpow_add p R hunit
  dpow_mul := by
    intro n a x hx
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton.mp hx
    rw [show a * ((p : R) * b) = (p : R) * (a * b) by ac_rfl,
      primeLocalDpow_mul, primeLocalDpow_mul, mul_pow]
    ac_rfl
  mul_dpow := primeLocalDpow_mul_dpow p R hunit
  dpow_comp := primeLocalDpow_comp p R hunit

/-- The canonical prime-local structure computes by `p^n/n!`. -/
theorem primeLocalDividedPowers_dpow (p : ℕ) [Fact p.Prime]
    (R : Type u) [CommRing R]
    (hunit : ∀ k : ℕ, ¬ p ∣ k → IsUnit (k : R)) (n : ℕ) (a : R) :
    (primeLocalDividedPowers p R hunit).dpow n ((p : R) * a) =
      primeLocalCoefficient p n R * a ^ n := primeLocalDpow_mul p R n a

/-- Example 23.2.3 (07GN), with the full prime-local hypothesis and explicit coefficient. -/
@[stacks 07GN]
theorem existsUnique_primeLocalDividedPowers (p : ℕ) [Fact p.Prime]
    (R : Type u) [CommRing R]
    (hunit : ∀ k : ℕ, ¬ p ∣ k → IsUnit (k : R)) :
    ∃! γ : DividedPowers (Ideal.span ({(p : R)} : Set R)),
      ∀ (n : ℕ) (a : R), γ.dpow n ((p : R) * a) = primeLocalCoefficient p n R * a ^ n := by
  refine ⟨primeLocalDividedPowers p R hunit, primeLocalDividedPowers_dpow p R hunit, ?_⟩
  intro γ hγ
  apply DividedPowers.ext
  intro n x hx
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hx
  rw [hγ, primeLocalDividedPowers_dpow]

/-- Every ring homomorphism between prime-local rings preserves their canonical divided
powers. The two rings may have independent universes. -/
theorem primeLocalDividedPowers_map_isDPMorphism (p : ℕ) [Fact p.Prime]
    {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    (hR : ∀ k : ℕ, ¬ p ∣ k → IsUnit (k : R))
    (hS : ∀ k : ℕ, ¬ p ∣ k → IsUnit (k : S)) (f : R →+* S) :
    DividedPowers.IsDPMorphism (primeLocalDividedPowers p R hR)
      (primeLocalDividedPowers p S hS) f where
  ideal_comp := by
    rw [Ideal.map_span, Set.image_singleton, map_natCast]
  dpow_comp := by
    intro n x hx
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hx
    simp only [map_mul, map_natCast, primeLocalDividedPowers_dpow, map_pow,
      primeLocalCoefficient_map p n hR f]

/-- The canonical coefficient formula on a `ℤ_[p]`-algebra, set to zero outside `(p)`.
The preimage is selected only from the actual multiplication map, not from an existence
assertion about divided powers. It need not be unique when the algebra has `p`-torsion. -/
noncomputable def algebraDpow (p : ℕ) [Fact p.Prime] (A : Type u) [CommRing A]
    [Algebra ℤ_[p] A] (n : ℕ) (x : A) : A := by
  classical
  exact if x ∈ Ideal.span ({(p : A)} : Set A) then
    algebraMap ℤ_[p] A ((dividedPowers p).dpow n (p : ℤ_[p])) *
      (Function.invFun (fun a : A ↦ (p : A) * a) x) ^ n
  else 0

/-- The new prime-local operation specializes to the existing p-adic algebra operation. -/
theorem primeLocalDpow_eq_algebraDpow : primeLocalDpow p A = algebraDpow p A := by
  classical
  funext n x
  simp only [primeLocalDpow, algebraDpow, primeLocalCoefficient_eq_padic]

/-- The coefficient formula is independent of the multiplicative preimage, even in the
presence of `p`-torsion: every positive-degree coefficient is divisible by `p`. -/
private theorem coefficient_mul_pow_eq (n : ℕ) {a b : A}
    (hab : (p : A) * a = (p : A) * b) :
    algebraMap ℤ_[p] A ((dividedPowers p).dpow n (p : ℤ_[p])) * a ^ n =
      algebraMap ℤ_[p] A ((dividedPowers p).dpow n (p : ℤ_[p])) * b ^ n := by
  by_cases hn : n = 0
  · simp [hn]
  · obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp
      ((dividedPowers p).dpow_mem (x := (p : ℤ_[p])) hn (Ideal.subset_span (by simp)))
    have hcoeff : algebraMap ℤ_[p] A ((dividedPowers p).dpow n (p : ℤ_[p])) =
        (p : A) * algebraMap ℤ_[p] A c := by
      rw [hc, map_mul, map_natCast]
    obtain ⟨d, hd⟩ := sub_dvd_pow_sub_pow a b n
    have hpab : (p : A) * (a - b) = 0 := by rw [mul_sub, hab, sub_self]
    apply sub_eq_zero.mp
    rw [← mul_sub, hcoeff, hd]
    calc
      ((p : A) * algebraMap ℤ_[p] A c) * ((a - b) * d) =
          ((p : A) * (a - b)) * (algebraMap ℤ_[p] A c * d) := by ac_rfl
      _ = 0 := by rw [hpab, zero_mul]

/-- The defining computation rule is valid for every `ℤ_[p]`-algebra, with no
injectivity or torsion-freeness assumption. -/
theorem algebraDpow_mul (n : ℕ) (a : A) :
    algebraDpow p A n ((p : A) * a) =
      algebraMap ℤ_[p] A ((dividedPowers p).dpow n (p : ℤ_[p])) * a ^ n := by
  classical
  have hx : (p : A) * a ∈ Ideal.span ({(p : A)} : Set A) :=
    Ideal.mem_span_singleton.mpr ⟨a, rfl⟩
  rw [algebraDpow, if_pos hx]
  exact coefficient_mul_pow_eq n (mul_prime_invFun p A _ hx)

/-- The canonical divided powers on `(p)` in a `ℤ_[p]`-algebra.
Only the divided-power laws are proof fields; the operation is the explicit coefficient
formula `algebraDpow`. In particular this does not select the admitted existence theorem. -/
noncomputable def algebraDividedPowers (p : ℕ) [Fact p.Prime] (A : Type u) [CommRing A]
    [Algebra ℤ_[p] A] : DividedPowers (Ideal.span ({(p : A)} : Set A)) where
  dpow := algebraDpow p A
  dpow_null hx := by
    classical
    exact if_neg hx
  dpow_zero hx := by
    classical
    simp only [algebraDpow, if_pos hx, pow_zero, mul_one]
    rw [(dividedPowers p).dpow_zero (Ideal.subset_span (by simp)), map_one]
  dpow_one hx := by
    classical
    simp only [algebraDpow, if_pos hx, pow_one]
    rw [(dividedPowers p).dpow_one (Ideal.subset_span (by simp)), map_natCast]
    exact mul_prime_invFun p A _ hx
  dpow_mem := by
    intro n x hn hx
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hx
    rw [algebraDpow_mul]
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp
      ((dividedPowers p).dpow_mem (x := (p : ℤ_[p])) hn (Ideal.subset_span (by simp)))
    apply Ideal.mem_span_singleton.mpr
    refine ⟨algebraMap ℤ_[p] A c * a ^ n, ?_⟩
    rw [hc, map_mul, map_natCast, mul_assoc]
  dpow_add := by
    intro n x y hx hy
    simp only [← primeLocalDpow_eq_algebraDpow]
    exact primeLocalDpow_add p A (algebra_primeToP_isUnit (p := p) (A := A)) hx hy
  dpow_mul := by
    intro n a x hx
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton.mp hx
    rw [show a * ((p : A) * b) = (p : A) * (a * b) by ac_rfl,
      algebraDpow_mul, algebraDpow_mul, mul_pow]
    ac_rfl
  mul_dpow := by
    intro m n x hx
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hx
    rw [algebraDpow_mul, algebraDpow_mul, algebraDpow_mul]
    have h := congrArg (algebraMap ℤ_[p] A)
      ((dividedPowers p).mul_dpow (m := m) (n := n) (x := (p : ℤ_[p]))
        (Ideal.subset_span (by simp)))
    simp only [map_mul, map_natCast] at h
    calc
      _ = (algebraMap ℤ_[p] A ((dividedPowers p).dpow m (p : ℤ_[p])) *
          algebraMap ℤ_[p] A ((dividedPowers p).dpow n (p : ℤ_[p]))) * a ^ (m + n) := by
        rw [pow_add]
        ac_rfl
      _ = _ := by rw [h]; ac_rfl
  dpow_comp := by
    intro m n x hn hx
    simp only [← primeLocalDpow_eq_algebraDpow]
    exact primeLocalDpow_comp p A (algebra_primeToP_isUnit (p := p) (A := A)) hn hx

/-- The public structure uses the canonical coefficient on every element `p * a`. -/
theorem algebraDividedPowers_dpow (n : ℕ) (a : A) :
    (algebraDividedPowers p A).dpow n ((p : A) * a) =
      algebraMap ℤ_[p] A ((dividedPowers p).dpow n (p : ℤ_[p])) * a ^ n :=
  algebraDpow_mul n a

/-- The canonical divided powers on `(p) ⊂ ℤ_[p]` extend along every `ℤ_[p]`-algebra
structure map. -/
theorem dividedPowers_extends_algebraMap :
    (dividedPowers p).extendsAlong (algebraMap ℤ_[p] A) := by
  unfold DividedPowers.extendsAlong
  rw [map_span_prime_eq]
  refine ⟨algebraDividedPowers p A, ?_, ?_⟩
  · rw [map_span_prime_eq]
  · intro n x hx
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hx
    rw [map_mul, map_natCast, algebraDividedPowers_dpow,
      mul_comm (p : ℤ_[p]) a, (dividedPowers p).dpow_mul (Ideal.subset_span (by simp)),
      map_mul, map_pow]
    ac_rfl

/-- Compatibility with the canonical divided powers on `(p) ⊂ ℤ_[p]` is equivalent to the
formula on the generators `(p : A) * a`. -/
theorem isDPMorphism_iff_dpow_mul
    {gamma : DividedPowers (Ideal.span ({(p : A)} : Set A))} :
    DividedPowers.IsDPMorphism (dividedPowers p) gamma (algebraMap ℤ_[p] A) ↔
      ∀ (n : ℕ) (a : A),
        gamma.dpow n ((p : A) * a) =
          algebraMap ℤ_[p] A ((dividedPowers p).dpow n (p : ℤ_[p])) * a ^ n := by
  constructor
  · intro h n a
    have hcoeff : gamma.dpow n (p : A) =
        algebraMap ℤ_[p] A ((dividedPowers p).dpow n (p : ℤ_[p])) := by
      simpa only [map_natCast] using h.dpow_comp (n := n) (p : ℤ_[p]) (Ideal.subset_span (by simp))
    rw [mul_comm (p : A) a, gamma.dpow_mul (Ideal.subset_span (by simp)), hcoeff]
    ac_rfl
  · intro h
    refine ⟨?_, ?_⟩
    · rw [map_span_prime_eq]
    · intro n x hx
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hx
      rw [map_mul, map_natCast, h,
        mul_comm (p : ℤ_[p]) a, (dividedPowers p).dpow_mul (Ideal.subset_span (by simp)),
        map_mul, map_pow]
      ac_rfl

/-- The structure map of every `ℤ_[p]`-algebra preserves the canonical divided powers. -/
theorem algebraDividedPowers_isDPMorphism :
    DividedPowers.IsDPMorphism (dividedPowers p) (algebraDividedPowers p A)
      (algebraMap ℤ_[p] A) :=
  isDPMorphism_iff_dpow_mul.mpr (fun n a ↦ algebraDividedPowers_dpow n a)

/-- Every `ℤ_[p]`-algebra homomorphism preserves the canonical divided powers.
The source and target may live in independent universes. -/
theorem algebraDividedPowers_map_isDPMorphism
    {B : Type v} [CommRing B] [Algebra ℤ_[p] B] (f : A →ₐ[ℤ_[p]] B) :
    DividedPowers.IsDPMorphism (algebraDividedPowers p A) (algebraDividedPowers p B)
      f.toRingHom where
  ideal_comp := by
    rw [Ideal.map_span, Set.image_singleton, map_natCast]
  dpow_comp := by
    intro n x hx
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hx
    simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_mul, map_natCast,
      algebraDividedPowers_dpow, map_pow, AlgHom.commutes]

/-- Example 23.2.3 (Tag 07GN): every `ℤ_[p]`-algebra has a unique divided-power structure on
the principal ideal `(p)`, characterized by the canonical coefficient
`(PadicInt.dividedPowers p).dpow n p`; in `ℚ_[p]` this coefficient is `p ^ n / n !`. -/
@[stacks 07GN]
theorem existsUnique_dividedPowers_span_prime :
    ∃! gamma : DividedPowers (Ideal.span ({(p : A)} : Set A)),
      ∀ (n : ℕ) (a : A),
        gamma.dpow n ((p : A) * a) =
          algebraMap ℤ_[p] A ((dividedPowers p).dpow n (p : ℤ_[p])) * a ^ n := by
  simpa only [primeLocalCoefficient_eq_padic] using
    existsUnique_primeLocalDividedPowers p A (algebra_primeToP_isUnit (p := p) (A := A))

/-- The canonical coefficient formula uniquely determines divided powers on `(p : A)`. -/
theorem dividedPowers_eq_of_dpow_mul
    {gamma delta : DividedPowers (Ideal.span ({(p : A)} : Set A))}
    (hgamma : ∀ (n : ℕ) (a : A),
      gamma.dpow n ((p : A) * a) =
        algebraMap ℤ_[p] A ((dividedPowers p).dpow n (p : ℤ_[p])) * a ^ n)
    (hdelta : ∀ (n : ℕ) (a : A),
      delta.dpow n ((p : A) * a) =
        algebraMap ℤ_[p] A ((dividedPowers p).dpow n (p : ℤ_[p])) * a ^ n) :
    gamma = delta := by
  apply DividedPowers.ext
  intro n x hx
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hx
  rw [hgamma, hdelta]

/-- Two divided-power structures on `(p : A)` compatible with the canonical structure on
`ℤ_[p]` coincide. -/
theorem dividedPowers_eq_of_isDPMorphism
    {gamma delta : DividedPowers (Ideal.span ({(p : A)} : Set A))}
    (hgamma : DividedPowers.IsDPMorphism
      (dividedPowers p) gamma (algebraMap ℤ_[p] A))
    (hdelta : DividedPowers.IsDPMorphism
      (dividedPowers p) delta (algebraMap ℤ_[p] A)) :
    gamma = delta :=
  dividedPowers_eq_of_dpow_mul (isDPMorphism_iff_dpow_mul.mp hgamma)
    (isDPMorphism_iff_dpow_mul.mp hdelta)

/-- Specialization to any p-adic algebra gives exactly its existing canonical structure. -/
theorem primeLocalDividedPowers_eq_algebraDividedPowers
    (hunit : ∀ k : ℕ, ¬ p ∣ k → IsUnit (k : A)) :
    primeLocalDividedPowers p A hunit = algebraDividedPowers p A := by
  apply DividedPowers.ext
  intro n x hx
  change primeLocalDpow p A n x = algebraDpow p A n x
  rw [primeLocalDpow_eq_algebraDpow]

end PadicInt
