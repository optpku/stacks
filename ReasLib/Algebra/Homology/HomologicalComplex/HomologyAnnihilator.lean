module

public import Mathlib.Algebra.Homology.Homotopy
public import Mathlib.Algebra.Category.ModuleCat.Basic
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Ideal.Span
public import ReasLib.Algebra.Homology.HomologicalComplex.HomologyMaps
import Mathlib.Tactic.CrossRefAttribute

/-!
# Homology annihilators from null-homotopies

This leaf owns the module-valued consequences of null-homotopic scalar endomorphisms.  It is
separate from degreewise map identities so downstream constructions can import the annihilator
API without inheriting a chapter-specific Koszul presentation.
@stack 0663
-/

@[expose] public section

noncomputable section

open CategoryTheory

universe u

namespace HomologicalComplex.Homology

variable {R : Type u} [CommRing R]
variable {ι : Type*} {c : ComplexShape ι}
variable {K : HomologicalComplex (ModuleCat R) c}

/-- A null-homotopic scalar endomorphism induces the zero map on homology. -/
@[stacks 0663 "null-homotopic scalar maps vanish on homology"]
theorem map_smulId_eq_zero_of_nullHomotopy (a : R) (i : ι) [K.HasHomology i]
    (h : Homotopy (a • 𝟙 K) 0) : homologyMap (a • 𝟙 K) i = 0 := sorry

/-- A scalar admitting a null-homotopy belongs to the annihilator of homology. -/
@[stacks 0663 "null-homotopic scalar belongs to the homology annihilator"]
theorem mem_annihilator_of_nullHomotopy (a : R) (i : ι) [K.HasHomology i]
    (h : Homotopy (a • 𝟙 K) 0) :
    a ∈ Module.annihilator R (K.homology i) := sorry

/-- An ideal generated by null-homotopic scalars annihilates the corresponding homology module. -/
@[stacks 0663 "null-homotopic scalars generate a homology annihilator"]
theorem span_le_annihilator_of_nullHomotopy (s : Set R) (i : ι) [K.HasHomology i]
    (h : ∀ a ∈ s, Homotopy (a • 𝟙 K) 0) :
    Ideal.span s ≤ Module.annihilator R (K.homology i) := sorry

end HomologicalComplex.Homology

end
