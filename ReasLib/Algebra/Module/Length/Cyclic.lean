module

public import Mathlib.Algebra.Polynomial.Basic
public import Mathlib.Data.Complex.Basic
public import Mathlib.Data.Real.Basic
public import Mathlib.RingTheory.Length
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

namespace Module

/-- The quotient of the integers by the ideal generated by `120` has module length `5`. -/
@[stacks 076G]
theorem intMod120_length :
    Module.length ℤ (ℤ ⧸ Ideal.span {(120 : ℤ)}) = (5 : ℕ∞) :=
  sorry

/-- The quotient of the complex polynomial ring by `X ^ 100 + X + 1` has module
length `100` over the complex polynomial ring. -/
@[stacks 076G]
theorem complexPolyMod_length :
    Module.length (Polynomial ℂ)
      (Polynomial ℂ ⧸ Ideal.span {(Polynomial.X ^ 100 + Polynomial.X + 1 : Polynomial ℂ)}) =
        (100 : ℕ∞) :=
  sorry

/-- The quotient of the real polynomial ring by `X ^ 4 + 2 * X ^ 2 + 1` has module
length `2` over the real polynomial ring. -/
@[stacks 076G]
theorem realPolyMod_length :
    Module.length (Polynomial ℝ)
      (Polynomial ℝ ⧸ Ideal.span {(Polynomial.X ^ 4 + 2 * Polynomial.X ^ 2 + 1 : Polynomial ℝ)}) =
        (2 : ℕ∞) :=
  sorry

end Module
