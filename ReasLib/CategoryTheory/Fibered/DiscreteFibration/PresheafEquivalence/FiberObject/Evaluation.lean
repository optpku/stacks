module

public import ReasLib.CategoryTheory.CategoryOfElements.Section
public import ReasLib.CategoryTheory.Fibered.DiscreteFibration.PresheafEquivalence.FiberObject.Basic

/-!
# Evaluation of fiber-object presheaves

This leaf owns the evaluation and tautological functors between a discrete fibration and the
opposite category of elements of its fiber-object presheaf, together with their object, map, and
strict inverse computation API.
-/

@[expose] public section

universe w u v uS vS

namespace CategoryTheory

open Opposite

variable {C : Type u} [Category.{v} C]

namespace Functor

variable {S : Type uS} [Category.{vS} S]

section FiberObjectPresheafEvaluationImplementation

set_option backward.privateInPublic true
set_option backward.privateInPublic.warn false

namespace Implementation

/-- The raw map of the evaluation functor from the opposite category of elements of the
fiber-object presheaf to the total category. -/
private noncomputable def evaluationMap
    (p : S ⥤ C) [Functor.IsDiscreteFibration p]
    {x y : p.fiberObjectPresheaf.Elementsᵒᵖ} (φ : x ⟶ y) :
    x.unop.2.1 ⟶ y.unop.2.1 :=
  eqToHom (congrArg Subtype.val φ.unop.2).symm ≫
    fiberObjectPresheaf.cartesianHom p φ.unop.1 y.unop.2

/-- Evaluation preserves identity morphisms.

Proof strategy: unfold the raw map, eliminate the category-of-elements identity equality, and use
uniqueness of lifts to identify the selected cartesian arrow over an identity with the identity. -/
private theorem evaluationMap_id
    (p : S ⥤ C) [Functor.IsDiscreteFibration p]
    (x : p.fiberObjectPresheaf.Elementsᵒᵖ) :
    evaluationMap p (𝟙 x) = 𝟙 x.unop.2.1 := sorry

/-- Evaluation preserves composition of morphisms.

Proof strategy: unfold the raw maps and compare both sides as lifts of the same composite base
arrow; `cartesianHom.eq_of_isHomLift` gives equality after the endpoint transports. -/
private theorem evaluationMap_comp
    (p : S ⥤ C) [Functor.IsDiscreteFibration p]
    {x y z : p.fiberObjectPresheaf.Elementsᵒᵖ}
    (φ : x ⟶ y) (ψ : y ⟶ z) :
    evaluationMap p (φ ≫ ψ) =
      evaluationMap p φ ≫ evaluationMap p ψ := sorry

end Implementation

/-- Evaluation from the opposite category of elements of the fiber-object presheaf back to the
total category of a discrete fibration. It forgets the displayed base object and retains the
underlying total object; morphisms are the uniquely determined cartesian lifts. -/
@[stacks 02Y2 "fiber-object evaluation",
  stacks 04SI "fiber-object evaluation"]
noncomputable def fiberObjectPresheaf.evaluation
    (p : S ⥤ C) [Functor.IsDiscreteFibration p] :
    p.fiberObjectPresheaf.Elementsᵒᵖ ⥤ S where
  obj x := x.unop.2.1
  map φ := Implementation.evaluationMap p φ
  map_id x := Implementation.evaluationMap_id p x
  map_comp φ ψ := Implementation.evaluationMap_comp p φ ψ

/- Axiom audit: the object and morphism functions are explicit. Their non-`Prop` data depend only
on the category-of-elements equality and `Classical.choice`; `sorryAx` is confined to the functor
laws. -/

end FiberObjectPresheafEvaluationImplementation

/-- Evaluation returns the underlying total object stored by a category-of-elements object. -/
@[simp]
theorem fiberObjectPresheaf.evaluation.obj
    (p : S ⥤ C) [Functor.IsDiscreteFibration p]
    (x : p.fiberObjectPresheaf.Elementsᵒᵖ) :
    (fiberObjectPresheaf.evaluation p).obj x = x.unop.2.1 := sorry

/-- Evaluation maps a category-of-elements morphism by transporting to the source of the
intrinsic cartesian arrow. -/
@[simp]
theorem fiberObjectPresheaf.evaluation.map
    (p : S ⥤ C) [Functor.IsDiscreteFibration p]
    {x y : p.fiberObjectPresheaf.Elementsᵒᵖ} (φ : x ⟶ y) :
    (fiberObjectPresheaf.evaluation p).map φ =
      eqToHom (congrArg Subtype.val φ.unop.2).symm ≫
        fiberObjectPresheaf.cartesianHom p φ.unop.1 y.unop.2 := sorry

/-- The tautological functor from the total category of a discrete fibration to the opposite
category of elements of its fiber-object presheaf. It records a total object in the fiber over its
own image and sends a morphism to the opposite of its projected base arrow. -/
@[stacks 02Y2 "fiber-object tautological functor",
  stacks 04SI "fiber-object tautological functor"]
noncomputable def fiberObjectPresheaf.unit
    (p : S ⥤ C) [Functor.IsDiscreteFibration p] :
    S ⥤ p.fiberObjectPresheaf.Elementsᵒᵖ :=
  CategoryOfElements.Section.functor p p.fiberObjectPresheaf
    (fiberObjectPresheaf.tautologicalSection p)

/- Axiom audit: the functor is generated by the explicit tautological fiber-object section.
`sorryAx` occurs only in section naturality and generic functor laws, all of which are
`Prop`-valued. -/

/-- The tautological functor places `x` over `p.obj x` with its reflexive fiber witness. -/
@[simp]
theorem fiberObjectPresheaf.unit.obj
    (p : S ⥤ C) [Functor.IsDiscreteFibration p] (x : S) :
    (fiberObjectPresheaf.unit p).obj x =
      op ⟨op (p.obj x), ⟨x, rfl⟩⟩ := sorry

/-- The underlying base arrow of the tautological image of `φ` is `(p.map φ).op`. -/
@[simp]
theorem fiberObjectPresheaf.unit.map.unop_val
    (p : S ⥤ C) [Functor.IsDiscreteFibration p]
    {x y : S} (φ : x ⟶ y) :
    ((fiberObjectPresheaf.unit p).map φ).unop.1 = (p.map φ).op := sorry

/-- Evaluation lies strictly over the category-of-elements projection. -/
theorem fiberObjectPresheaf.evaluation.comp_projection
    (p : S ⥤ C) [Functor.IsDiscreteFibration p] :
    fiberObjectPresheaf.evaluation p ⋙ p =
      (CategoryOfElements.π p.fiberObjectPresheaf).leftOp := sorry

/-- The tautological functor lies strictly over `p`. -/
theorem fiberObjectPresheaf.unit.comp_projection
    (p : S ⥤ C) [Functor.IsDiscreteFibration p] :
    fiberObjectPresheaf.unit p ⋙
        (CategoryOfElements.π p.fiberObjectPresheaf).leftOp =
      p := sorry

/-- Evaluating a tautological category-of-elements object recovers the original total object. -/
@[simp]
theorem fiberObjectPresheaf.evaluation.unit.obj
    (p : S ⥤ C) [Functor.IsDiscreteFibration p] (x : S) :
    (fiberObjectPresheaf.evaluation p).obj
        ((fiberObjectPresheaf.unit p).obj x) = x := sorry

/-- Evaluating a tautological category-of-elements morphism recovers the original total
morphism. -/
@[simp]
theorem fiberObjectPresheaf.evaluation.unit.map
    (p : S ⥤ C) [Functor.IsDiscreteFibration p]
    {x y : S} (φ : x ⟶ y) :
    (fiberObjectPresheaf.evaluation p).map
        ((fiberObjectPresheaf.unit p).map φ) = φ := sorry

/-- The tautological functor followed by evaluation is strictly the identity on the total
category. -/
@[simp]
theorem fiberObjectPresheaf.unit.comp_evaluation
    (p : S ⥤ C) [Functor.IsDiscreteFibration p] :
    fiberObjectPresheaf.unit p ⋙ fiberObjectPresheaf.evaluation p =
      𝟭 S := sorry

/-- Evaluation followed by the tautological functor is strictly the identity on the opposite
category of elements. -/
@[simp]
theorem fiberObjectPresheaf.evaluation.comp_unit
    (p : S ⥤ C) [Functor.IsDiscreteFibration p] :
    fiberObjectPresheaf.evaluation p ⋙ fiberObjectPresheaf.unit p =
      𝟭 p.fiberObjectPresheaf.Elementsᵒᵖ := sorry

end Functor

end CategoryTheory
