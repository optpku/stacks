module

public import Mathlib.RingTheory.Etale.Locus
public import Mathlib.NumberTheory.RamificationInertia.Galois
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.FieldTheory.Galois.IntegralClosure.FixedPoints
public import ReasLib.RingTheory.Ideal.Inertia
public import ReasLib.RingTheory.Invariant.FixedPoints.Subalgebra

@[expose] public section

/-!
# Etale fixed subalgebras of a normalized branch

The fixed-subalgebra etale statement is kept at the inertia-subgroup level.  Chapter files only
recall this owner; the source presentation is not used as the owner of the local criterion.

@stack 09EH
@stack 0BU6
-/

universe u v w

namespace integralClosure.FixedPoints

open Ideal IsLocalRing

variable {A : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
variable {K : Type v} [Field K] [Algebra A K] [IsFractionRing A K]
variable {L : Type w} [Field L] [Algebra A L] [Algebra K L] [IsScalarTower A K L]
  [FiniteDimensional K L] [IsGalois K L]

/-- The inertia-fixed subalgebra of the integral closure is etale over the base at the contracted
branch prime. -/
@[stacks 09EH "inertia fixed subalgebra is etale at the contracted branch"]
theorem etaleAt_inertia (m : Ideal (integralClosure A L)) [m.IsMaximal] :
    Algebra.IsEtaleAt A
      (m.under
        (FixedPoints.subalgebra A (integralClosure A L) (m.inertia Gal(L / K)))) := sorry

-- Proof strategy: apply the local etaleness criterion at the contracted branch.  Use
-- `FixedPoints.isIntegralClosure` to identify the inertia-fixed normalization, the defining
-- trivial residue action of inertia to obtain the separable residue extension, and the
-- ramification-index formula for the inertia fixed field to prove that the localized maximal
-- ideal is generated by the base uniformizer.

/-- Every fixed subalgebra whose subgroup contains inertia is etale over the base at the
contracted branch. -/
@[stacks 0BU6 "fixed subalgebra above inertia is etale at the contracted branch"]
theorem etaleAt_of_inertia_le (m : Ideal (integralClosure A L)) [m.IsMaximal]
    (H : Subgroup Gal(L / K)) (hI : m.inertia Gal(L / K) ≤ H) :
    Algebra.IsEtaleAt A
      (m.under (FixedPoints.subalgebra A (integralClosure A L) H)) := sorry

-- Proof strategy: apply the same local etaleness criterion to the `H`-fixed contraction.  The
-- inclusion `hI` makes the relative inertia group trivial, hence gives ramification index one;
-- the quotient action of the decomposition group supplies the separable residue-field
-- extension.  Fixed-subalgebra integrality provides finite presentation and local flatness.

/-- For `H ≤ H'`, the extension from `H'`-fixed to `H`-fixed elements is etale at the
contracted branch whenever `H` contains inertia. -/
@[stacks 0BU6 "nested fixed subalgebras above inertia are etale"]
theorem etaleAt_of_inertia_le_of_le
    (m : Ideal (integralClosure A L)) [m.IsMaximal]
    {H H' : Subgroup Gal(L / K)} (h : H ≤ H') (hI : m.inertia Gal(L / K) ≤ H) :
    -- Local instance justification (defeq pin): étaleness must use the canonical inclusion
    -- selected by `FixedPoints.subalgebraAlgebraOfLe h`.
    letI : Algebra
        (FixedPoints.subalgebra A (integralClosure A L) H')
        (FixedPoints.subalgebra A (integralClosure A L) H) :=
      FixedPoints.subalgebraAlgebraOfLe h
    Algebra.IsEtaleAt
      (FixedPoints.subalgebra A (integralClosure A L) H')
      (m.under (FixedPoints.subalgebra A (integralClosure A L) H)) := sorry

-- Proof strategy: install only the displayed canonical fixed-subalgebra inclusion, then apply
-- the local etaleness criterion to the nested contraction.  Since inertia is contained in both
-- `H` and `H'`, the relative inertia quotient is trivial; use the fixed-point residue quotient
-- to obtain separability and the relative ramification-index formula to obtain index one.

end integralClosure.FixedPoints
