module

import StacksCheckRecall
public import ReasLib.AlgebraicGeometry.Scheme.Model.Regular
public import stacks_project.Chap55.Situation_55_9_3

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open scoped AlgebraicGeometry

universe u

namespace AlgebraicGeometry.Scheme.Hom

/- Lemma 55.9.4: In Situation 55.9.3, the special fibre
`f.fiber (IsLocalRing.closedPoint R)` is connected. -/
@[stacks 0C62] #check
  (AlgebraicGeometry.Scheme.Hom.regularModel_connectedSpace_specialFiber :
    ∀ (R K : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [Field K] [Algebra R K] [IsFractionRing R K]
    (C : SchemeOverField K) [Curve C] [Smooth C.hom] [Projective C.hom]
    (h_globalSections : Function.Bijective (globalSectionsMap C.hom))
    {X : Scheme.{u}} (f : X ⟶ Spec (CommRingCat.of R))
    [Flat f] [FiniteType f] [IsProper f] [Scheme.Regular X]
    (genericFiberIso : C ≅ Over.mk
      (pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap R K))))),
    ConnectedSpace (f.fiber (IsLocalRing.closedPoint R)))

end AlgebraicGeometry.Scheme.Hom
