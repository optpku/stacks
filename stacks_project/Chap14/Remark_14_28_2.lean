module

public import ReasLib.AlgebraicTopology.CosimplicialObject.Homotopy.DeltaOne.Comparison
import StacksCheckRecall

@[expose] public section

/-!
@stack 0FKJ

# Source-facing bridge for Remark 14.28.2

The product-free `Δ[1]`-indexed presentation now belongs to the reusable neutral module
`ReasLib.AlgebraicTopology.CosimplicialObject.Homotopy.DeltaOne`.  Its canonical comparison
remains `CosimplicialObject.Homotopy`.
-/

open CategoryTheory
open CategoryTheory.Limits
open scoped Simplicial

noncomputable section

universe u v u' v'

namespace CategoryTheory.CosimplicialObject

variable {C : Type u} [Category.{v} C]
variable {U V : CosimplicialObject C} (a b : U ⟶ V)

/- Remark 14.28.2 (1): product-free `Δ[1]`-indexed cosimplicial homotopy requires no
products in `C`. -/
@[stacks 0FKJ "Remark 14.28.2 (1)"]
#check (DeltaOneHomotopy a b : Type v)

/- Remark 14.28.2 (2): a functor preserves each directed product-free homotopy. -/
variable {D : Type u'} [Category.{v'} D] (F : C ⥤ D)

@[stacks 0FKJ "Remark 14.28.2 (2)"]
#check ((fun H : DeltaOneHomotopy a b ↦ H.whiskerRight F) :
  DeltaOneHomotopy a b →
    DeltaOneHomotopy (Functor.whiskerRight a F) (Functor.whiskerRight b F))

/- Remark 14.28.2 (3): the induced zigzag relation is likewise product-free. -/
@[stacks 0FKJ "Remark 14.28.2 (3)"]
#check (DeltaOneHomotopic a b : Prop)

/- Remark 14.28.2 (4): every functor preserves the product-free zigzag relation. -/
@[stacks 0FKJ "Remark 14.28.2 (4)"]
#check ((fun h : DeltaOneHomotopic a b ↦ h.whiskerRight F) :
  DeltaOneHomotopic a b →
    DeltaOneHomotopic (Functor.whiskerRight a F) (Functor.whiskerRight b F))

section Comparison

variable [HasCotensor (Δ[1] : SSet.{0}) V]

/- Remark 14.28.2 (5): when the displayed cotensor exists, the product-free presentation agrees
with the cotensor-valued definition of Definition 14.28.1. -/
@[stacks 0FKJ "Remark 14.28.2 (5)"]
#check (DeltaOneHomotopy.equiv a b :
  DeltaOneHomotopy a b ≃ Homotopy a b)

/- Remark 14.28.2 (6): the zigzag relations generated by the product-free and cotensor-valued
presentations agree. -/
@[stacks 0FKJ "Remark 14.28.2 (6)"]
#check (DeltaOneHomotopic.iff_homotopic a b :
  DeltaOneHomotopic a b ↔ Homotopic a b)

end Comparison

section CanonicalFunctoriality

variable [HasFiniteProducts C] [HasFiniteProducts D]

/- Remark 14.28.2 (7): when both categories have finite products, every functor preserves the
original cotensor-valued zigzag relation. -/
@[stacks 0FKJ "Remark 14.28.2 (7)"]
#check ((fun h : Homotopic a b ↦ h.whiskerRight F) :
  Homotopic a b →
    Homotopic (Functor.whiskerRight a F) (Functor.whiskerRight b F))

end CanonicalFunctoriality

end CategoryTheory.CosimplicialObject
