module

public import Mathlib.Algebra.Field.Basic
public import Mathlib.Algebra.Homology.ShortComplex.Exact
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.Proper
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.Twist.Invertible
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.TwistCohomology.Naturality
public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.IdealClosure
public import ReasLib.AlgebraicGeometry.Scheme.Module.Biproduct
public import ReasLib.AlgebraicGeometry.Scheme.Module.ClosedImmersion.Exact
public import ReasLib.AlgebraicGeometry.Scheme.Module.Coherent
public import ReasLib.AlgebraicGeometry.Scheme.Variety

/-!
# Complete intersections of degrees 5 and 6 in projective 3-space

This module owns the homogeneous ideal (F, G), the associated `Proj` curve, its closed
immersion into `ProjectiveSpace.scheme k 3`, and the Koszul maps supplied by a type
(5, 6) complete intersection.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

noncomputable section

universe u

namespace AlgebraicGeometry.ProjectiveSpace.CompleteIntersection56

/-- The ideal generated by a degree-5 form `F` and a degree-6 form `G` is homogeneous
for the standard grading on `k[X_0, X_1, X_2, X_3]`. -/
theorem homogeneousIdeal_isHomogeneous {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6) :
    (Ideal.span {F, G}).IsHomogeneous (ProjectiveSpace.grading k 3) := sorry

/-- The homogeneous ideal `(F, G)` cutting out a type (5, 6) complete intersection in
`ProjectiveSpace.scheme k 3`. -/
def homogeneousIdeal {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6) :
    HomogeneousIdeal (ProjectiveSpace.grading k 3) where
  toSubmodule := Ideal.span {F, G}
  is_homogeneous' := homogeneousIdeal_isHomogeneous F G hF hG

/-- The underlying ideal of `homogeneousIdeal F G hF hG` is generated by `F` and `G`. -/
theorem homogeneousIdeal_toIdeal {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6) :
    (homogeneousIdeal F G hF hG).toIdeal = Ideal.span {F, G} := sorry

/-- The quotient grading on `k[X_0, X_1, X_2, X_3] ⧸ (F, G)`. -/
abbrev quotientGrading {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6) :
    ℕ → Submodule k (MvPolynomial (Fin (3 + 1)) k ⧸ (homogeneousIdeal F G hF hG).toIdeal) :=
  GradedAlgebra.Quotient.grading (ProjectiveSpace.grading k 3)
    (homogeneousIdeal F G hF hG).toIdeal

/-- The quotient by `homogeneousIdeal F G hF hG` carries its canonical graded-algebra
structure. -/
noncomputable instance instGradedAlgebra {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6) :
    GradedAlgebra (quotientGrading F G hF hG) :=
  GradedAlgebra.Quotient.gradedAlgebra (ProjectiveSpace.grading k 3)
    (homogeneousIdeal F G hF hG).toIdeal
    (homogeneousIdeal F G hF hG).isHomogeneous

/-- The `Proj` model of the type (5, 6) complete-intersection curve
`C = Proj(k[X_0, X_1, X_2, X_3] ⧸ (F, G))`. -/
abbrev scheme {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6) : Scheme :=
  Proj (quotientGrading F G hF hG)

/-- The closed immersion `i : C ⟶ P^3_k` induced by the homogeneous quotient
`k[X_0, X_1, X_2, X_3] ⧸ (F, G)`. -/
def closedImmersion {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6) :
    scheme F G hF hG ⟶ ProjectiveSpace.scheme k 3 :=
  projQuotientMap (ProjectiveSpace.grading k 3) (homogeneousIdeal F G hF hG)

/-- The morphism `closedImmersion F G hF hG` is a closed immersion. -/
instance instIsClosedImmersion {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6) :
    IsClosedImmersion (closedImmersion F G hF hG) :=
  projQuotientMap_isClosedImmersion (ProjectiveSpace.grading k 3)
    (homogeneousIdeal F G hF hG)

/-- The structure morphism `C ⟶ Spec k` of a type (5, 6) complete-intersection curve. -/
abbrev hom {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6) :
    scheme F G hF hG ⟶ Spec (.of k) :=
  closedImmersion F G hF hG ≫ ProjectiveSpace.toSpec k 3

/-- The structure morphism of a type (5, 6) complete-intersection curve is proper. -/
instance instIsProper_hom {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6) :
    IsProper (hom F G hF hG) := sorry

/-- The Koszul map `O(-11) ⟶ O(-5) ⊞ O(-6)` with components `(-G, F)`. -/
def koszulLeft {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6) :
    twistingSheaf k 3 (-11) ⟶
      twistingSheaf k 3 (-5) ⊞ twistingSheaf k 3 (-6) :=
  biprod.lift
    (twistingSheaf.mulHomogeneous 3 (-11) 6 (-G) (neg_mem hG))
    (twistingSheaf.mulHomogeneous 3 (-11) 5 F hF)

/-- The Koszul map `O(-5) ⊞ O(-6) ⟶ O(0)` with components `(F, G)`. -/
def koszulMid {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6) :
    twistingSheaf k 3 (-5) ⊞ twistingSheaf k 3 (-6) ⟶ twistingSheaf k 3 0 :=
  biprod.desc
    (twistingSheaf.mulHomogeneous 3 (-5) 5 F hF)
    (twistingSheaf.mulHomogeneous 3 (-6) 6 G hG)

/-- The restriction map `O(0) ⟶ i_* i^* O(0)` along `closedImmersion F G hF hG`. -/
def restriction {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6) :
    twistingSheaf k 3 0 ⟶
      (Scheme.Modules.pushforward (closedImmersion F G hF hG)).obj
        ((Scheme.Modules.pullback (closedImmersion F G hF hG)).obj
          (twistingSheaf k 3 0)) :=
  Scheme.Modules.ClosedImmersion.restrictionMap
    (closedImmersion F G hF hG) (twistingSheaf k 3 0)

/-- The Koszul maps `koszulLeft` and `koszulMid` compose to zero. -/
theorem koszulLeft_comp_koszulMid {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6) :
    koszulLeft F G hF hG ≫ koszulMid F G hF hG = 0 := sorry

/-- The Koszul map `koszulMid` followed by restriction to the curve is zero. -/
theorem koszulMid_comp_restriction {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6) :
    koszulMid F G hF hG ≫ restriction F G hF hG = 0 := sorry

/-- Being a type (5, 6) complete-intersection curve implies that `koszulLeft` is a
monomorphism. -/
theorem koszulLeft_mono {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6)
    (h_variety : Variety (Over.mk (hom F G hF hG)))
    (h_dim : topologicalKrullDim (scheme F G hF hG) = 1) :
    Mono (koszulLeft F G hF hG) := sorry

/-- Exactness of `koszulLeft` followed by `koszulMid` on a type (5, 6)
complete-intersection curve. -/
theorem koszulLeft_koszulMid_exact {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6)
    (h_variety : Variety (Over.mk (hom F G hF hG)))
    (h_dim : topologicalKrullDim (scheme F G hF hG) = 1) :
    (ShortComplex.mk (koszulLeft F G hF hG) (koszulMid F G hF hG)
      (koszulLeft_comp_koszulMid F G hF hG)).Exact := sorry

/-- Exactness of `koszulMid` followed by restriction on a type (5, 6)
complete-intersection curve. -/
theorem koszulMid_restriction_exact {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6)
    (h_variety : Variety (Over.mk (hom F G hF hG)))
    (h_dim : topologicalKrullDim (scheme F G hF hG) = 1) :
    (ShortComplex.mk (koszulMid F G hF hG) (restriction F G hF hG)
      (koszulMid_comp_restriction F G hF hG)).Exact := sorry

/-- Restriction `O(0) ⟶ i_* i^* O(0)` is an epimorphism on a type (5, 6)
complete-intersection curve. -/
theorem restriction_epi {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6)
    (h_variety : Variety (Over.mk (hom F G hF hG)))
    (h_dim : topologicalKrullDim (scheme F G hF hG) = 1) :
    Epi (restriction F G hF hG) := sorry

/-- Pullbacks of twisting sheaves along `closedImmersion F G hF hG` are coherent. -/
instance instIsCoherent_pullbackTwistingSheaf {k : Type u} [Field k]
    (F G : MvPolynomial (Fin (3 + 1)) k)
    (hF : F ∈ ProjectiveSpace.grading k 3 5)
    (hG : G ∈ ProjectiveSpace.grading k 3 6) (n : ℤ) :
    ((Scheme.Modules.pullback (closedImmersion F G hF hG)).obj
      (twistingSheaf k 3 n)).IsCoherent := sorry

end AlgebraicGeometry.ProjectiveSpace.CompleteIntersection56
