module

public import ReasLib.AlgebraicGeometry.Scheme.Differentials.FittingIdeal
public import ReasLib.AlgebraicGeometry.Scheme.IdealSheafData.Spec
public import ReasLib.RingTheory.Kaehler.LocalizedPresentation

@[expose] public section

open AlgebraicGeometry

universe u

namespace AlgebraicGeometry.Scheme.Hom

/-- For a quasi-finite univariate localized hypersurface, the Kähler different
of the affine morphism of spectra is the ideal sheaf generated by the image of
the polynomial derivative. -/
theorem kaehlerDifferent_specMap_eq_idealSheaf_pderiv
    (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [IsNoetherianRing A]
    [Algebra.FiniteType A B] [Algebra.QuasiFinite A B]
    (f h : MvPolynomial (Fin 1) A) (q : Localization.Away h →ₐ[A] B)
    (h_q : Function.Surjective q)
    (h_ker_q : RingHom.ker q.toRingHom =
      Ideal.span
        {algebraMap (MvPolynomial (Fin 1) A) (Localization.Away h) f}) :
    @Scheme.Hom.kaehlerDifferent _ _
        (Spec.map (CommRingCat.ofHom (algebraMap A B)))
        (HasRingHomProperty.Spec_iff.mpr
          (RingHom.finiteType_algebraMap.mpr inferInstance)) =
      Scheme.idealSheafDataOfIdealOnSpec
        (Ideal.span
          {q (algebraMap (MvPolynomial (Fin 1) A) (Localization.Away h)
            (MvPolynomial.pderiv 0 f))}) := sorry

end AlgebraicGeometry.Scheme.Hom
