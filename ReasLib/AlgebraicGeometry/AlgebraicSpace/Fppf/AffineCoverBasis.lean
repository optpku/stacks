module

public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Algebra.MvPolynomial.CommRing
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Atlas.Input
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Fppf.Topology

/-! # Finitely presented affine charts for the fppf topology -/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.Fppf.AffineCoverBasis

variable {S : Scheme.{u}}

/-- The coordinate ring of an affine member of the fixed atlas cover. -/
abbrev coordinateRing (X : AlgebraicSpace S)
    (i : (AtlasInput.scheme X).left.affineCover.I₀) :=
  Γ((AtlasInput.scheme X).left.affineCover.X i, ⊤)

/-- The quotient of a polynomial ring by the ideal generated by finitely many relations. -/
abbrev presentationRing (X : AlgebraicSpace S)
    (i : (AtlasInput.scheme X).left.affineCover.I₀) (n m : ℕ)
    (p : Fin m → MvPolynomial (Fin n) (coordinateRing X i)) :=
  MvPolynomial (Fin n) (coordinateRing X i) ⧸ Ideal.span (Set.range p)

/-- Finite polynomial presentations of flat algebras over affine opens of the atlas. -/
def ChartCode (X : AlgebraicSpace S) : Type u :=
  Σ i : (AtlasInput.scheme X).left.affineCover.I₀,
    Σ n : ℕ, Σ m : ℕ,
      {p : Fin m → MvPolynomial (Fin n) (coordinateRing X i) //
        Module.Flat (coordinateRing X i) (presentationRing X i n m p)}

/-- The coordinate ring presented by an affine chart code. -/
abbrev ring {X : AlgebraicSpace S} (c : ChartCode X) :=
  presentationRing X c.1 c.2.1 c.2.2.1 c.2.2.2.1

/-- The structural ring homomorphism of the finite polynomial presentation. -/
def baseRingHom {X : AlgebraicSpace S} (c : ChartCode X) :
    coordinateRing X c.1 →+* ring c :=
  (Ideal.Quotient.mk _).comp MvPolynomial.C

/-- The spectrum of a presentation maps to its affine atlas open and then to the atlas. -/
def toAtlas {X : AlgebraicSpace S} (c : ChartCode X) :
    Spec (CommRingCat.of (ring c)) ⟶ (AtlasInput.scheme X).left :=
  Spec.map (CommRingCat.ofHom (baseRingHom c)) ≫
    ((AtlasInput.scheme X).left.affineCover.X c.1).isoSpec.inv ≫
    (AtlasInput.scheme X).left.affineCover.f c.1

/-- The affine scheme of a chart, equipped with its actual map to the base scheme. -/
def scheme {X : AlgebraicSpace S} (c : ChartCode X) : Over S :=
  Over.mk (toAtlas c ≫ (AtlasInput.scheme X).hom)

/-- A chart is the composite of its quotient spectrum with the fixed atlas morphism. -/
def chart {X : AlgebraicSpace S} (c : ChartCode X) : Over X :=
  Over.mk ((ofOverFunctor S).map
    (Over.homMk (toAtlas c) rfl : scheme c ⟶ AtlasInput.scheme X) ≫ AtlasInput.map X)

/-- Every chart map is flat and locally of finite presentation. -/
theorem chart_isFppf {X : AlgebraicSpace S} (c : ChartCode X) :
    Flat (chart c).hom ∧ LocallyOfFinitePresentation (chart c).hom := by
  sorry

/-- A coded factorization is a contravariant ring homomorphism with its two commuting triangles. -/
def Lift {X Y : AlgebraicSpace S} (f : Y ⟶ X) (d : ChartCode Y) (c : ChartCode X) : Type u :=
  {r : ring c →+* ring d //
    ∃ h : Spec.map (CommRingCat.ofHom r) ≫ (scheme c).hom = (scheme d).hom,
      (ofOverFunctor S).map
          (Over.homMk (Spec.map (CommRingCat.ofHom r)) h : scheme d ⟶ scheme c) ≫
          (chart c).hom =
        (chart d).hom ≫ f}

/-- The algebraic-space arrow encoded by a factorization. -/
def liftMap {X Y : AlgebraicSpace S} {f : Y ⟶ X}
    {d : ChartCode Y} {c : ChartCode X} (l : Lift f d c) :
    (chart d).left ⟶ (chart c).left :=
  (ofOverFunctor S).map
    (Over.homMk (Spec.map (CommRingCat.ofHom l.val)) l.property.choose : scheme d ⟶ scheme c)

/-- The coded arrow commutes with the chart maps to the target. -/
theorem liftMap_w {X Y : AlgebraicSpace S} {f : Y ⟶ X}
    {d : ChartCode Y} {c : ChartCode X} (l : Lift f d c) :
    liftMap l ≫ (chart c).hom = (chart d).hom ≫ f :=
  l.property.choose_spec

/-- A covering subset consists of charts whose arrows generate an fppf covering sieve. -/
def Cover (X : AlgebraicSpace S) : Type u :=
  {B : Set (ChartCode X) //
    Sieve.generate (Presieve.ofArrows
      (fun c : B ↦ (chart c.val).left) (fun c ↦ (chart c.val).hom)) ∈ fppfTopology S X}

/-- The family of all flat finite-presentation charts covers the target. -/
theorem allCharts_cover (X : AlgebraicSpace S) :
    Sieve.generate (Presieve.ofArrows
      (fun c : (Set.univ : Set (ChartCode X)) ↦ (chart c.val).left)
      (fun c ↦ (chart c.val).hom)) ∈
        fppfTopology S X := by
  sorry

/-- The covering family of all flat finite-presentation affine charts. -/
def allCharts (X : AlgebraicSpace S) : Cover X :=
  ⟨Set.univ, allCharts_cover X⟩

/-- A sieve is fppf covering exactly when it contains a covering subset of affine charts. -/
theorem coveringSieve_iff {X : AlgebraicSpace S} (R : Sieve X) :
    R ∈ fppfTopology S X ↔
      ∃ B : Cover X, ∀ c : B.val, R (chart c.val).hom := by
  sorry

/-- Pullback refinement contains every chart admitting a factorization through a covering chart. -/
def pullbackCarrier {X Y : AlgebraicSpace S} (f : Y ⟶ X) (B : Cover X) :
    Set (ChartCode Y) :=
  {d | ∃ c : B.val, Nonempty (Lift f d c.val)}

/-- All factorizations through a covering family provide a covering family after base change. -/
theorem pullbackCover_covers {X Y : AlgebraicSpace S} (f : Y ⟶ X) (B : Cover X) :
    Sieve.generate (Presieve.ofArrows
      (fun d : pullbackCarrier f B ↦ (chart d.val).left)
      (fun d ↦ (chart d.val).hom)) ∈ fppfTopology S Y := by
  sorry

/-- The pullback covering uses all coded factorizations, without choosing a covering chart. -/
def pullbackCover {X Y : AlgebraicSpace S} (f : Y ⟶ X) (B : Cover X) : Cover Y :=
  ⟨pullbackCarrier f B, pullbackCover_covers f B⟩

/-- The common refinement contains all charts admitting factorizations through both families. -/
def commonCarrier {X : AlgebraicSpace S} (B C : Cover X) : Set (ChartCode X) :=
  {d | (∃ b : B.val, Nonempty (Lift (𝟙 X) d b.val)) ∧
    ∃ c : C.val, Nonempty (Lift (𝟙 X) d c.val)}

/-- The maximal common affine refinement of two covering families covers the target. -/
theorem commonRefinement_covers {X : AlgebraicSpace S} (B C : Cover X) :
    Sieve.generate (Presieve.ofArrows
      (fun d : commonCarrier B C ↦ (chart d.val).left)
      (fun d ↦ (chart d.val).hom)) ∈ fppfTopology S X := by
  sorry

/-- The common covering refinement retains every pair of qualifying factorizations. -/
def commonRefinement {X : AlgebraicSpace S} (B C : Cover X) : Cover X :=
  ⟨commonCarrier B C, commonRefinement_covers B C⟩

/-- An affine chart in a slice retains its actual composite structure arrow. -/
def overChart {X : AlgebraicSpace S} (V : Over X) (c : ChartCode V.left) : Over X :=
  Over.mk ((chart c).hom ≫ V.hom)

/-- The arrow from an affine chart to the object it covers. -/
def overChartMap {X : AlgebraicSpace S} (V : Over X) (c : ChartCode V.left) :
    overChart V c ⟶ V :=
  Over.homMk (chart c).hom rfl

/-- A coded factorization induces the corresponding morphism in the ambient slice. -/
def overLiftMap {X : AlgebraicSpace S} {V W : Over X} (f : V ⟶ W)
    {d : ChartCode V.left} {c : ChartCode W.left}
    (l : Lift (S := S) (X := W.left) (Y := V.left) f.left d c) :
    overChart V d ⟶ overChart W c :=
  Over.homMk (liftMap (S := S) (X := W.left) (Y := V.left)
    (f := f.left) (d := d) (c := c) l) (by
    change liftMap (f := f.left) l ≫ ((chart (X := W.left) c).hom ≫ W.hom) =
      (chart (X := V.left) d).hom ≫ V.hom
    rw [← Category.assoc,
      liftMap_w (S := S) (X := W.left) (Y := V.left) (f := f.left) (d := d) (c := c) l,
      Category.assoc, Over.w f])

/-- A lifted chart arrow has the specified composite to the target of the slice arrow. -/
theorem overLiftMap_w {X : AlgebraicSpace S} {V W : Over X} (f : V ⟶ W)
    {d : ChartCode V.left} {c : ChartCode W.left} (l : Lift f.left d c) :
    overLiftMap f l ≫ overChartMap W c = overChartMap V d ≫ f := by
  apply Over.OverMorphism.ext
  exact liftMap_w l

end AlgebraicGeometry.AlgebraicSpace.Fppf.AffineCoverBasis
