module

public import ReasLib.RingTheory.Ideal.Principal
import Mathlib.Tactic.CrossRefAttribute

/-!
# Intersections of powers of a principal ideal

This file names the concrete ideal `⨅ n : ℕ, (f) ^ n` used by principal-adic completion arguments.

@stack 0G3G
-/

@[expose] public section

universe u

namespace Ideal

variable {A : Type u} [CommRing A]

/-- Lemma 15.94.9 (Stacks `0G3G`): the concrete intersection of all powers of the principal ideal
generated by `f`. -/
@[stacks 0G3G "principal-power intersection"]
abbrev principalPowerIntersection (f : A) : Ideal A :=
  ⨅ n : ℕ, principalPowerIdeal f n

end Ideal
