module

public import Mathlib.RingTheory.KrullDimension.Zero
public import Mathlib.Topology.NoetherianSpace
public import ReasLib.RingTheory.MvPolynomial.SquareZero
public import ReasLib.Topology.Artinian

@[expose] public section

universe u v

namespace MvPolynomial.SquareZero

variable {σ : Type u} {k : Type v} [Field k]

/-- The polynomial quotient by the coordinate squares over a field has Krull dimension at
most zero. -/
instance instKrullDimLE_zero : Ring.KrullDimLE 0 (Quotient (σ := σ) (k := k)) := sorry

/-- Every prime ideal of the polynomial quotient by the coordinate squares over a field is
generated by the classes of the variables. -/
theorem eq_span_generators_of_isPrime (I : Ideal (Quotient (σ := σ) (k := k))) [I.IsPrime] :
    I = Ideal.span (Set.range (generator (σ := σ) (k := k))) := sorry

/-- In the polynomial quotient by the coordinate squares over a field, the ideal generated
by infinitely many variable classes is not finitely generated. -/
theorem not_fg_span_generators [Infinite σ] :
    ¬ (Ideal.span (Set.range (generator (σ := σ) (k := k)))).FG := sorry

/-- The polynomial quotient by the coordinate squares in infinitely many variables over a
field is not a Noetherian ring. -/
theorem not_isNoetherianRing [Infinite σ] :
    ¬ IsNoetherianRing (Quotient (σ := σ) (k := k)) := sorry

/-- The prime spectrum of the polynomial quotient by the coordinate squares over a field
has at most one point. -/
instance instSubsingletonPrimeSpectrum :
    Subsingleton (PrimeSpectrum (Quotient (σ := σ) (k := k))) := by
  exact Ring.KrullDimLE.subsingleton_primeSpectrum (Quotient (σ := σ) (k := k))

/-- The prime spectrum of the square-zero polynomial quotient over a field is a Noetherian
topological space. -/
instance instNoetherianSpace :
    TopologicalSpace.NoetherianSpace (PrimeSpectrum (Quotient (σ := σ) (k := k))) := by
  exact TopologicalSpace.Finite.to_noetherianSpace

/-- The prime spectrum of the square-zero polynomial quotient over a field is an Artinian
topological space. -/
instance instArtinianSpace :
    TopologicalSpace.ArtinianSpace (PrimeSpectrum (Quotient (σ := σ) (k := k))) := by
  exact TopologicalSpace.Finite.to_artinianSpace

end MvPolynomial.SquareZero
