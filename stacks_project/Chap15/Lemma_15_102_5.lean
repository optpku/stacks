module

import StacksCheckRecall
public import ReasLib.Algebra.Homology.DerivedCategory.ModuleCat.IdealPower.Koszul

@[expose] public section

/-!
# Lemma 15.102.5

@stack 0G3M
-/

universe u

/- Lemma 15.102.5 (0G3M): the positive adic tower generated by a finite family is
pro-isomorphic to the derived tower of powered Koszul ideal complexes
`Q(σ≤-1 Kₙ[-1])`.  The facade exposes the exact `Fin r` source form and, separately, a
same-universe finite-index generalization from the reusable owner. -/
@[stacks 0G3M "Lemma 15.102.5"]
#check @CategoryTheory.DerivedCategory.IdealPower.Koszul.Fin.existsProIsomorphism

#check fun {A : Type u} [CommRing A] [IsNoetherianRing A] {r : ℕ} (f : Fin r → A) ↦
  CategoryTheory.DerivedCategory.IdealPower.Koszul.Fin.existsProIsomorphism f

#check fun {A : Type u} [CommRing A] [IsNoetherianRing A]
    {ι : Type u} [Finite ι] (f : ι → A) ↦
  CategoryTheory.DerivedCategory.IdealPower.Koszul.existsProIsomorphism f
