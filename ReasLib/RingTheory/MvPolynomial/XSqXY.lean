module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Noetherian
public import Mathlib.RingTheory.Polynomial.Basic
public import ReasLib.RingTheory.Ideal.AssociatedPrime.Module
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

noncomputable section

universe u

open MvPolynomial

namespace MvPolynomial.XSqXY

/-- The relation ideal `(x ^ 2, x * y)` in `k[x, y]`, with `X 0` corresponding to `x`
and `X 1` corresponding to `y`. -/
def ideal (k : Type u) [CommRing k] : Ideal (MvPolynomial (Fin 2) k) :=
  Ideal.span {X 0 ^ 2, X 0 * X 1}

/-- `ideal k` is the span of `X 0 ^ 2` and `X 0 * X 1`. -/
theorem ideal_eq_span (k : Type u) [CommRing k] :
    ideal k = Ideal.span {X 0 ^ 2, X 0 * X 1} :=
  rfl

/-- The quotient ring `k[x, y] ⧸ (x ^ 2, x * y)`. -/
abbrev Quot (k : Type u) [CommRing k] : Type u :=
  MvPolynomial (Fin 2) k ⧸ ideal k

/-- The class of the coordinate `X i` in `Quot k`. -/
def mkX (k : Type u) [CommRing k] (i : Fin 2) : Quot k :=
  Ideal.Quotient.mk (ideal k) (X i)

/-- `mkX k i` is the class of `X i` in `Quot k`. -/
theorem mkX_eq (k : Type u) [CommRing k] (i : Fin 2) :
    mkX k i = Ideal.Quotient.mk (ideal k) (X i) :=
  rfl

/-- The ideal `(x)` generated by the class of `X 0` in `Quot k`. -/
def spanX (k : Type u) [CommRing k] : Ideal (Quot k) :=
  Ideal.span {mkX k 0}

/-- `spanX k` is the principal ideal generated by `mkX k 0`. -/
theorem spanX_eq_span (k : Type u) [CommRing k] :
    spanX k = Ideal.span {mkX k 0} :=
  rfl

/-- The ideal `(x, y)` generated by the classes of `X 0` and `X 1` in `Quot k`. -/
def spanXY (k : Type u) [CommRing k] : Ideal (Quot k) :=
  Ideal.span {mkX k 0, mkX k 1}

/-- `spanXY k` is the ideal generated by `mkX k 0` and `mkX k 1`. -/
theorem spanXY_eq_span (k : Type u) [CommRing k] :
    spanXY k = Ideal.span {mkX k 0, mkX k 1} :=
  rfl

/-- Over a field, the ideal `(x)` is prime in `Quot k`. -/
instance spanX.instIsPrime (k : Type u) [Field k] : (spanX k).IsPrime :=
  sorry

/-- Over a field, the ideal `(x, y)` is maximal in `Quot k`. -/
instance spanXY.instIsMaximal (k : Type u) [Field k] : (spanXY k).IsMaximal :=
  sorry

/-- The square of `spanX k` is the zero ideal of `Quot k`. -/
theorem spanX_pow_eq_bot (k : Type u) [CommRing k] : spanX k ^ 2 = ⊥ :=
  sorry

/-- The prime `spanX k` is associated to the `Quot k`-module `Quot k ⧸ spanX k ^ 2`. -/
theorem spanX_mem (k : Type u) [Field k] :
    spanX k ∈ associatedPrimesOfModule (Quot k) (Quot k ⧸ spanX k ^ 2) :=
  sorry

/-- The maximal ideal `spanXY k` is an associated prime of `Quot k ⧸ spanX k ^ 2`. -/
theorem spanXY_mem (k : Type u) [Field k] :
    spanXY k ∈ associatedPrimesOfModule (Quot k) (Quot k ⧸ spanX k ^ 2) :=
  sorry

/-- The primes `(x)` and `(x, y)` of `Quot k` are distinct. -/
theorem spanX_ne_spanXY (k : Type u) [Field k] : spanX k ≠ spanXY k :=
  sorry

/-- The associated primes of `Quot k ⧸ spanX k ^ 2` are exactly `(x)` and `(x, y)`. -/
theorem associatedPrimesOfModule_quot_spanX_sq_eq (k : Type u) [Field k] :
    associatedPrimesOfModule (Quot k) (Quot k ⧸ spanX k ^ 2) = {spanX k, spanXY k} :=
  sorry

/-- Over a field `k`, the ring `k[x, y] ⧸ (x ^ 2, x * y)` is Noetherian, its ideal
`(x)` is prime, and the singleton containing `(x)` is a proper subset of the associated
primes of the quotient by `(x) ^ 2`. -/
@[stacks 0CR9]
theorem associatedPrimesOfModule_quot_spanX_sq (k : Type u) [Field k] :
    IsNoetherianRing (Quot k) ∧ (spanX k).IsPrime ∧
      ({spanX k} ⊂ associatedPrimesOfModule (Quot k) (Quot k ⧸ spanX k ^ 2)) :=
  sorry

end MvPolynomial.XSqXY
