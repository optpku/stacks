module

public import Mathlib.Data.Fin.Embedding
public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
public import ReasLib.AlgebraicGeometry.PrimeSpectrum.Notation
public import ReasLib.RingTheory.AdicCompletion.NaiveCotangent

/-!
# Completed Jacobian minors and Artin-smooth covers

Square Jacobian minors, the elementary relation condition, finite Jacobian
covers of `V(I B)`, and scalar factorization through the completed Jacobian
are defined for completed polynomial presentations.
-/

@[expose] public section

open PrimeSpectrum
open scoped PrimeSpectrum

noncomputable section

universe u

namespace Algebra.NaiveCotangent.Adic
namespace Presentation

variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
variable {I : Ideal A} {ι : Type u}

/-- The square Jacobian minor in `B` selected by kernel generators `fs` and
variable columns `cols`, with `|T| = m` encoded by a common `Fin m`. -/
def jacobianMinor (P : Presentation A B I ι) {m : ℕ} (fs : Fin m → P.ker)
    (cols : Fin m ↪ ι) : B :=
  Matrix.det (fun j i ↦ P.toAlgHom (pderiv I (cols i) (fs j)))

/-- A completed Jacobian minor agrees with the determinant of the selected
`jacobianOnKer` matrix entries. -/
theorem jacobianMinor_apply (P : Presentation A B I ι) {m : ℕ}
    (fs : Fin m → P.ker) (cols : Fin m ↪ ι) :
    jacobianMinor P fs cols =
      Matrix.det (fun j i ↦ jacobianOnKer P (fs j) (cols i)) :=
  sorry

/-- Multiplication by a lift of `b` sends every kernel element into the ideal
generated by the selected relations, modulo the square of the kernel. -/
def relationCondition (P : Presentation A B I ι) {m : ℕ} (b : B)
    (fs : Fin m → P.ker) : Prop :=
  ∃ b₀ : polynomialCompletion A I ι,
    P.toAlgHom b₀ = b ∧
      ∀ g ∈ P.ker,
        b₀ * g ∈
          Ideal.span (Set.range fun j : Fin m ↦ (fs j : polynomialCompletion A I ι)) +
            P.ker ^ 2

/-- The completed relation condition unpacks as a lift of `b` sending the kernel
into the selected span plus `J ^ 2`. -/
theorem relationCondition_iff (P : Presentation A B I ι) {m : ℕ} (b : B)
    (fs : Fin m → P.ker) :
    relationCondition P b fs ↔
      ∃ b₀ : polynomialCompletion A I ι,
        P.toAlgHom b₀ = b ∧
          ∀ g ∈ P.ker,
            b₀ * g ∈
              Ideal.span (Set.range fun j : Fin m ↦ (fs j : polynomialCompletion A I ι)) +
                P.ker ^ 2 :=
  sorry

/-- An element `b` is elementary for a square completed Jacobian minor when the
minor divides `b` and the selected relations satisfy the relation condition. -/
def IsElementaryFor (P : Presentation A B I ι) {m : ℕ} (b : B)
    (fs : Fin m → P.ker) (cols : Fin m ↪ ι) : Prop :=
  jacobianMinor P fs cols ∣ b ∧ relationCondition P b fs

/-- Elementary data for a completed minor is equivalent to divisibility of `b`
by the minor together with the relation condition. -/
theorem IsElementaryFor.iff (P : Presentation A B I ι) {m : ℕ} (b : B)
    (fs : Fin m → P.ker) (cols : Fin m ↪ ι) :
    IsElementaryFor P b fs cols ↔
      jacobianMinor P fs cols ∣ b ∧ relationCondition P b fs :=
  sorry

/-- A finite family in `B` whose zero locus is contained in `V(I B)`, with each
element elementary for some square completed Jacobian minor. -/
def HasJacobianCover (P : Presentation A B I ι) : Prop :=
  ∃ (s : ℕ) (b : Fin s → B),
    V(Set.range b) ⊆ V((I.map (algebraMap A B) : Set B)) ∧
      ∀ l, ∃ (m : ℕ) (fs : Fin m → P.ker) (cols : Fin m ↪ ι),
        IsElementaryFor P (b l) fs cols

/-- A Jacobian cover unpacks as a finite family with `V({b_l}) ⊆ V(I B)` and
pointwise elementary data. -/
theorem HasJacobianCover.iff (P : Presentation A B I ι) :
    HasJacobianCover P ↔
      ∃ (s : ℕ) (b : Fin s → B),
        V(Set.range b) ⊆ V((I.map (algebraMap A B) : Set B)) ∧
          ∀ l, ∃ (m : ℕ) (fs : Fin m → P.ker) (cols : Fin m ↪ ι),
            IsElementaryFor P (b l) fs cols :=
  sorry

/-- Scalar multiplication by the image of `a` on `J / J²` factors through the
completed Jacobian `J / J² ⟶ ⊕ᵢ B dx_i`. -/
def smulFactorsThroughJacobian [Fintype ι] (P : Presentation A B I ι) (a : A) :
    Prop :=
  ∃ h : (ι → B) →ₗ[B] P.toExtension.Cotangent,
    h ∘ₗ jacobian P = (algebraMap A B a) • LinearMap.id

/-- Factorization through the completed Jacobian unpacks as a `B`-linear section
of the Jacobian up to the scalar `a`. -/
theorem smulFactorsThroughJacobian_iff [Fintype ι] (P : Presentation A B I ι)
    (a : A) :
    smulFactorsThroughJacobian P a ↔
      ∃ h : (ι → B) →ₗ[B] P.toExtension.Cotangent,
        h ∘ₗ jacobian P = (algebraMap A B a) • LinearMap.id :=
  sorry

end Presentation
end Algebra.NaiveCotangent.Adic


