module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Free.Generated

/-!
# Local Generation of Sheaves of Modules

Mathlib's `LocalGeneratorsData` is the canonical data owner for generation on
a cover.  This file only adds the source-facing existence predicate and its
fixed-cardinality refinement.  Both work over an arbitrary sheaf of rings.
-/

@[expose] public section

open CategoryTheory

universe u v w

namespace SheafOfModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable {R : Sheaf J RingCat.{w}}
variable [∀ U : C, HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
variable [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- A sheaf of modules is locally generated by sections when it admits local-generator data. -/
@[stacks 03DL "(3)"]
abbrev IsLocallyGeneratedBySections (M : SheafOfModules.{w} R) : Prop :=
  Nonempty M.LocalGeneratorsData.{u}

/-- A sheaf of modules is locally generated by `r` sections when some local-generator cover is
generated by `r` global sections on every chart. -/
@[stacks 03DL "(4)"]
class IsLocallyGeneratedBy (M : SheafOfModules.{w} R) (r : ℕ) : Prop where
  /-- Local generator data whose charts all admit `r` global generators. -/
  exists_data :
    ∃ q : M.LocalGeneratorsData.{u},
      ∀ i : q.I, SheafOfModules.IsGeneratedBy (M.over (q.X i)) r

/-- Local generation by sections is closed under isomorphisms. -/
instance isLocallyGeneratedBySections_isClosedUnderIsomorphisms :
    ObjectProperty.IsClosedUnderIsomorphisms
      (IsLocallyGeneratedBySections : ObjectProperty (SheafOfModules.{w} R)) := sorry

namespace IsLocallyGeneratedBySections

/-- Transport local generation by sections across a module-sheaf isomorphism. -/
theorem of_iso {M N : SheafOfModules.{w} R} (e : M ≅ N)
    [IsLocallyGeneratedBySections M] : IsLocallyGeneratedBySections N := sorry

/-- Local generation by sections is equivalent on isomorphic module sheaves. -/
theorem iff_of_iso {M N : SheafOfModules.{w} R} (e : M ≅ N) :
    IsLocallyGeneratedBySections M ↔ IsLocallyGeneratedBySections N := sorry

end IsLocallyGeneratedBySections

/-- Local generation by a fixed number of sections is closed under isomorphisms. -/
instance isLocallyGeneratedBy_isClosedUnderIsomorphisms (r : ℕ) :
    ObjectProperty.IsClosedUnderIsomorphisms
      (fun M : SheafOfModules.{w} R => IsLocallyGeneratedBy M r) := sorry

namespace IsLocallyGeneratedBy

/-- Transport local generation by `r` sections across a module-sheaf isomorphism. -/
theorem of_iso {M N : SheafOfModules.{w} R} (e : M ≅ N) (r : ℕ)
    [IsLocallyGeneratedBy M r] : IsLocallyGeneratedBy N r := sorry

/-- Local generation by `r` sections is equivalent on isomorphic module sheaves. -/
theorem iff_of_iso {M N : SheafOfModules.{w} R} (e : M ≅ N) (r : ℕ) :
    IsLocallyGeneratedBy M r ↔ IsLocallyGeneratedBy N r := sorry

end IsLocallyGeneratedBy

namespace IsLocallyGeneratedBy

/-- Local generation by `r` sections implies local generation by sections. -/
theorem isLocallyGeneratedBySections
    (M : SheafOfModules.{w} R) (r : ℕ) [IsLocallyGeneratedBy M r] :
    IsLocallyGeneratedBySections M := sorry

end IsLocallyGeneratedBy

namespace IsFiniteType

/-- Mathlib finite type canonically implies local generation by sections. -/
instance isLocallyGeneratedBySections
    (M : SheafOfModules.{w} R) [M.IsFiniteType] :
    IsLocallyGeneratedBySections M := sorry

end IsFiniteType

variable [HasWeakSheafify J AddCommGrpCat.{w}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- The free sheaf on `ULift (Fin r)` is locally generated by `r` sections. -/
instance free_fin_isLocallyGeneratedBy (r : ℕ) :
    IsLocallyGeneratedBy
      (SheafOfModules.free (R := R) (ULift.{w} (Fin r)) : SheafOfModules.{w} R) r := sorry

end SheafOfModules
