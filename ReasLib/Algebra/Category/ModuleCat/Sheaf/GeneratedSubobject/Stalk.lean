module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.GeneratedSubobject
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Stalk.Subobject
import Mathlib.Tactic.CrossRefAttribute

/-!
# Stalks of subobjects generated by local sections

The stalk range of the generated subobject is the span of exactly those prescribed local
sections whose domains contain the point.
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace

noncomputable section

universe u v

namespace SheafOfModules.Subobject

variable {Z : TopCat.{u}} {𝒪 : Z.Sheaf RingCat.{u}} {I : Type v}
variable [LocallySmall (SheafOfModules 𝒪)] [WellPowered (SheafOfModules 𝒪)]

/-- Lemma 17.4.6, for an arbitrary ring sheaf: the stalk range of the subobject generated by
local sections is spanned by the germs of the sections defined at that point. -/
@[stacks 01AR "ring-sheaf form"]
theorem stalkRange_generatedBySections
    (ℱ : SheafOfModules 𝒪) (U : I → Opens Z)
    (s : ∀ i, ℱ.val.obj (op (U i))) (x : Z) :
    stalkRange (generatedBySections ℱ U s) x =
      Submodule.span (𝒪.presheaf.stalk x)
        (Set.range fun i : {i // x ∈ U i} ↦
          TopCat.Presheaf.germ ℱ.val.presheaf (U i) x i.2 (s i)) := sorry

namespace CommRing

variable {𝒪 : Z.Sheaf CommRingCat.{u}}
variable [LocallySmall (SheafOfModules (TopCat.Sheaf.ringSheafOfComm 𝒪))]
variable [WellPowered (SheafOfModules (TopCat.Sheaf.ringSheafOfComm 𝒪))]

/-- Lemma 17.4.6: over a commutative-ring sheaf, the stalk range of the subobject generated by
local sections is spanned by the germs of the sections defined at that point. -/
@[stacks 01AR]
theorem stalkRange_generatedBySections
    (ℱ : SheafOfModules (TopCat.Sheaf.ringSheafOfComm 𝒪)) (U : I → Opens Z)
    (s : ∀ i, ℱ.val.obj (op (U i))) (x : Z) :
    stalkRange (generatedBySections ℱ U s) x =
      Submodule.span (𝒪.presheaf.stalk x)
        (Set.range fun i : {i // x ∈ U i} ↦
          TopCat.Presheaf.germ ℱ.val.presheaf (U i) x i.2 (s i)) := sorry

end CommRing

end SheafOfModules.Subobject
