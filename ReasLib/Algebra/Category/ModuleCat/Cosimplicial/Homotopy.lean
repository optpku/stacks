module

public import ReasLib.Algebra.Category.ModuleCat.Cosimplicial.Module
public import Mathlib.Logic.Relation

@[expose] public section

open CategoryTheory Opposite

universe u

namespace CosimplicialModule

variable {A : CosimplicialObject CommRingCat.{u}}
variable {K M : PresheafOfModules.{u} (moduleRingPresheaf A)}

/-- A directed linear homotopy consists of degreewise linear maps indexed by maps
to the one-simplex, compatible with the cosimplicial structure and with the two endpoints. -/
def DirectedHomotopy (φ ψ : K ⟶ M) : Prop :=
  ∃ components : ∀ n : SimplexCategory, (n ⟶ SimplexCategory.mk 1) →
      (K.obj (op (op n)) ⟶ M.obj (op (op n))),
    (∀ {n m : SimplexCategory} (σ : n ⟶ m) (α : m ⟶ SimplexCategory.mk 1)
      (value : K.obj (op (op n))),
      components m α (K.map σ.op.op value) =
        M.map σ.op.op (components n (σ ≫ α) value)) ∧
    (∀ n, components n (SimplexCategory.const n (SimplexCategory.mk 1) 0) =
      ψ.app (op (op n))) ∧
    (∀ n, components n (SimplexCategory.const n (SimplexCategory.mk 1) 1) =
      φ.app (op (op n)))

/-- Linear homotopy of cosimplicial module morphisms is the equivalence relation
generated by directed linear homotopies. -/
def Homotopic (φ ψ : K ⟶ M) : Prop :=
  Relation.EqvGen DirectedHomotopy φ ψ

end CosimplicialModule
