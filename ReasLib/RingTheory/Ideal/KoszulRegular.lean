module

public import Mathlib.RingTheory.Finiteness.Defs
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Ideal.LocalGeneration
public import ReasLib.RingTheory.Sequence.Koszul.Regularity

@[expose] public section

/-!
# Koszul-Regular Ideals

@stack 07CV

This leaf owns the Zariski-local predicate that an ideal is generated by a
finite Koszul-regular sequence on principal-open neighbourhoods.
-/

universe u

open RingTheory.Sequence

namespace Ideal

variable {R : Type u} [CommRing R]

/-- An ideal is Koszul-regular when it is locally generated by a finite
Koszul-regular sequence. -/
@[stacks 07CV "Definition 15.32.1 (2), Koszul-regular ideals"]
def IsKoszulRegularIdeal (I : Ideal R) : Prop :=
  IsGeneratedByFiniteAwaySequence I (fun _ {_} f ↦ IsKoszulRegularSequence f)

/-- The defining principal-open criterion for a Koszul-regular ideal. -/
theorem isKoszulRegularIdeal_iff (I : Ideal R) :
    I.IsKoszulRegularIdeal ↔
      ∀ p : Ideal R, p.IsPrime → I ≤ p →
        ∃ g : R, g ∉ p ∧ ∃ r : ℕ, ∃ f : Fin r → Localization.Away g,
          IsKoszulRegularSequence f ∧
            Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f) := sorry

namespace IsKoszulRegularIdeal

/-- A Koszul-regular ideal is finitely generated. -/
theorem fg {I : Ideal R} (hI : I.IsKoszulRegularIdeal) : I.FG := sorry

end IsKoszulRegularIdeal

end Ideal
