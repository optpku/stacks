module

public import Mathlib.CategoryTheory.Triangulated.Functor
public import Mathlib.GroupTheory.FreeAbelianGroup
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Triangulated Grothendieck Groups

@stack 0FCN

This module gives the quotient presentation of the zeroth Grothendieck group
of a pretriangulated category.  The relation is defined for every triangle;
the distinguished-triangle condition enters only when selecting the relations
that generate the quotient.  This separates the reusable algebraic relation
from the pretriangulated structure that presents it.

## Main declarations

* `CategoryTheory.TriangulatedK0` is the Grothendieck group.
* `TriangulatedK0.of` is the class of an object.
* `TriangulatedK0.lift` is the quotient universal property.
* `TriangulatedK0.map` is induced by an exact functor.
* `TriangulatedK0.map_id` and `TriangulatedK0.map_comp` make this construction
  functorial for exact functors.
-/

open CategoryTheory.Limits
open CategoryTheory.Pretriangulated

universe v u v₁ u₁ v₂ u₂ v₃ u₃

namespace CategoryTheory

namespace TriangulatedK0

section Relations

variable (C : Type u) [Category.{v} C] [Preadditive C] [HasZeroObject C] [HasShift C ℤ]
  [∀ n : ℤ, Functor.Additive (shiftFunctor C n)] [Pretriangulated C]

/-- The Grothendieck relation `[Y] - [X] - [Z]` of a triangle
`X ⟶ Y ⟶ Z ⟶ X⟦1⟧`. -/
@[stacks 0FCN]
def relation (T : Triangle C) : FreeAbelianGroup C :=
  FreeAbelianGroup.of T.obj₂ - FreeAbelianGroup.of T.obj₁ - FreeAbelianGroup.of T.obj₃

/-- The subgroup of the free abelian group on `C` generated by relations of distinguished
triangles. -/
@[stacks 0FCN]
def relations : AddSubgroup (FreeAbelianGroup C) :=
  AddSubgroup.closure
    (Set.range fun T : { T : Triangle C // T ∈ distTriang C } => relation C T.1)

/-- The relation of a distinguished triangle belongs to the subgroup of triangulated
Grothendieck relations. -/
theorem relation_mem_relations (T : Triangle C) (hT : T ∈ distTriang C) :
    relation C T ∈ relations C := sorry

end Relations

end TriangulatedK0

/-- The zeroth Grothendieck group of a pretriangulated category, obtained by imposing
`[Y] = [X] + [Z]` for every distinguished triangle `X ⟶ Y ⟶ Z ⟶ X⟦1⟧`. -/
@[stacks 0FCN]
abbrev TriangulatedK0
    (C : Type u) [Category.{v} C] [Preadditive C] [HasZeroObject C] [HasShift C ℤ]
    [∀ n : ℤ, Functor.Additive (shiftFunctor C n)] [Pretriangulated C] : Type u :=
  FreeAbelianGroup C ⧸ TriangulatedK0.relations C

namespace TriangulatedK0

section UniversalProperty

variable {C : Type u} [Category.{v} C] [Preadditive C] [HasZeroObject C] [HasShift C ℤ]
  [∀ n : ℤ, Functor.Additive (shiftFunctor C n)] [Pretriangulated C]

/-- The class of an object in the triangulated zeroth Grothendieck group. -/
@[stacks 0FCN]
abbrev of (X : C) : TriangulatedK0 C :=
  QuotientAddGroup.mk' (relations C) (FreeAbelianGroup.of X)

/-- An additive invariant on objects descends to the triangulated Grothendieck group when it
kills all distinguished-triangle relations. -/
@[stacks 0FCN]
def lift {M : Type _} [AddCommGroup M] (f : C → M)
    (hf : relations C ≤ (FreeAbelianGroup.lift f).ker) :
    TriangulatedK0 C →+ M :=
  QuotientAddGroup.lift (relations C) (FreeAbelianGroup.lift f) hf

/-- The homomorphism obtained from `lift` evaluates on an object class as the original
invariant. -/
@[simp]
theorem lift_of {M : Type _} [AddCommGroup M] (f : C → M)
    (hf : relations C ≤ (FreeAbelianGroup.lift f).ker) (X : C) :
    lift f hf (of X) = f X := sorry

/-- Object classes satisfy the Grothendieck relation of every distinguished triangle. -/
theorem of_distinguished (T : Triangle C) (hT : T ∈ distTriang C) :
    of T.obj₂ = of T.obj₁ + of T.obj₃ := sorry

end UniversalProperty

section Functoriality

variable {C₁ : Type u₁} [Category.{v₁} C₁] [Preadditive C₁] [HasZeroObject C₁] [HasShift C₁ ℤ]
  [∀ n : ℤ, Functor.Additive (shiftFunctor C₁ n)] [Pretriangulated C₁]
variable {C₂ : Type u₂} [Category.{v₂} C₂] [Preadditive C₂] [HasZeroObject C₂] [HasShift C₂ ℤ]
  [∀ n : ℤ, Functor.Additive (shiftFunctor C₂ n)] [Pretriangulated C₂]
variable {C₃ : Type u₃} [Category.{v₃} C₃] [Preadditive C₃] [HasZeroObject C₃] [HasShift C₃ ℤ]
  [∀ n : ℤ, Functor.Additive (shiftFunctor C₃ n)] [Pretriangulated C₃]

/-- The distinguished-triangle relations in the source lie in the kernel of the raw map
attached to an exact functor. -/
theorem relations_le_ker_map
    (F : C₁ ⥤ C₂) [F.CommShift ℤ] [F.IsTriangulated] :
    relations C₁ ≤ (FreeAbelianGroup.lift (of ∘ F.obj)).ker := sorry

/-- An exact functor induces a homomorphism on triangulated zeroth Grothendieck groups. -/
@[stacks 0FCN]
def map (F : C₁ ⥤ C₂) [F.CommShift ℤ] [F.IsTriangulated] :
    TriangulatedK0 C₁ →+ TriangulatedK0 C₂ :=
  lift (of ∘ F.obj) (relations_le_ker_map F)

/-- The Grothendieck-group map of an exact functor sends an object class to the class of its
image. -/
@[simp]
theorem map_of (F : C₁ ⥤ C₂) [F.CommShift ℤ] [F.IsTriangulated] (X : C₁) :
    map F (of X) = of (F.obj X) := sorry

/-- The Grothendieck-group map induced by the identity exact functor is the
identity homomorphism. -/
@[stacks 0FCN, simp]
theorem map_id :
    map (𝟭 C₁) = AddMonoidHom.id (TriangulatedK0 C₁) := sorry

/-- Grothendieck-group maps of exact functors respect functor composition. -/
@[stacks 0FCN, simp]
theorem map_comp
    (F : C₁ ⥤ C₂) (G : C₂ ⥤ C₃) [F.CommShift ℤ] [F.IsTriangulated]
    [G.CommShift ℤ] [G.IsTriangulated] :
    map (F ⋙ G) = (map G).comp (map F) := sorry

end Functoriality

end TriangulatedK0

end CategoryTheory
