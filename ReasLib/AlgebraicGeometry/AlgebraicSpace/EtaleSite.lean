module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Morphism.RepresentableProperties
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry.AlgebraicSpace.SmallEtale

/-- The small étale chart category of an algebraic space consists of representably étale
arrows from schemes over the base, with all commuting scheme morphisms. -/
abbrev site {S : Scheme.{u}} (X : AlgebraicSpace S) :=
  MorphismProperty.CostructuredArrow Representable.Etale ⊤ yoneda X.functorOfPoints

/-- The projection from étale charts to schemes over the base. -/
def toOver {S : Scheme.{u}} (X : AlgebraicSpace S) : site X ⥤ Over S :=
  MorphismProperty.CostructuredArrow.forget Representable.Etale ⊤ yoneda X.functorOfPoints ⋙
    CostructuredArrow.proj yoneda X.functorOfPoints

/-- The underlying scheme functor on the small étale chart category. -/
def toScheme {S : Scheme.{u}} (X : AlgebraicSpace S) : site X ⥤ Scheme.{u} :=
  toOver X ⋙ Over.forget S

/-- A family of étale charts covers if its underlying scheme arrows form an étale cover. -/
def precoverage {S : Scheme.{u}} (X : AlgebraicSpace S) : Precoverage (site X) :=
  Scheme.etalePrecoverage.comap (toScheme X)

/-- The small étale topology is generated by the underlying scheme étale covering families. -/
def topology {S : Scheme.{u}} (X : AlgebraicSpace S) : GrothendieckTopology (site X) :=
  (precoverage X).toGrothendieck

end AlgebraicGeometry.AlgebraicSpace.SmallEtale
