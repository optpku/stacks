module

public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.RingTheory.Smooth.Basic
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

universe u

open MvPolynomial

namespace Algebra

/-- The Jacobian row of the hypersurface `R[x, y] ⧸ (f)`, sending `i : Fin 2` to
the class of `pderiv i f`. Identifying `X 0` with `x` and `X 1` with `y`, these
are the images of the two partial derivatives of `f` in the quotient. -/
noncomputable def hypersurfaceJacobian {R : Type u} [CommRing R]
    (f : MvPolynomial (Fin 2) R) :
    Fin 2 → MvPolynomial (Fin 2) R ⧸ Ideal.span {f} :=
  fun i ↦ Ideal.Quotient.mk _ (pderiv i f)

/-- The Jacobian row evaluates to the class of the corresponding partial
derivative. -/
theorem hypersurfaceJacobian_apply {R : Type u} [CommRing R]
    (f : MvPolynomial (Fin 2) R) (i : Fin 2) :
    hypersurfaceJacobian f i = Ideal.Quotient.mk _ (pderiv i f) :=
  sorry

/-- The ideal in `R[x, y] ⧸ (f)` generated by the Jacobian row of `f`. -/
noncomputable def hypersurfaceJacobianIdeal {R : Type u} [CommRing R]
    (f : MvPolynomial (Fin 2) R) :
    Ideal (MvPolynomial (Fin 2) R ⧸ Ideal.span {f}) :=
  Ideal.span (Set.range (hypersurfaceJacobian f))

/-- The Jacobian ideal is generated by the two partial derivatives of `f`. -/
theorem hypersurfaceJacobianIdeal_eq_span {R : Type u} [CommRing R]
    (f : MvPolynomial (Fin 2) R) :
    hypersurfaceJacobianIdeal f =
      Ideal.span {hypersurfaceJacobian f 0, hypersurfaceJacobian f 1} :=
  sorry

/-- The Jacobian row generates the unit ideal in `R[x, y] ⧸ (f)` if and only if
`f` and its two partial derivatives generate the unit ideal in `R[x, y]`. -/
theorem hypersurfaceJacobianIdeal_eq_top_iff {R : Type u} [CommRing R]
    (f : MvPolynomial (Fin 2) R) :
    hypersurfaceJacobianIdeal f = ⊤ ↔
      Ideal.span {f, pderiv (0 : Fin 2) f, pderiv (1 : Fin 2) f} = ⊤ :=
  sorry

namespace FormallySmooth

/-- The hypersurface `R[x, y] ⧸ (f)` is formally smooth over `R` when its
Jacobian row generates the unit ideal. -/
instance instFormallySmooth_of_hypersurfaceJacobianIdeal
    {R : Type u} [CommRing R] (f : MvPolynomial (Fin 2) R)
    [hjac : Fact (hypersurfaceJacobianIdeal f = ⊤)] :
    FormallySmooth R (MvPolynomial (Fin 2) R ⧸ Ideal.span {f}) :=
  sorry

/-- Exercise 111.50.4: if `A = R[x, y] ⧸ (f)` and the images of `pderiv 0 f`
and `pderiv 1 f` generate the unit ideal in `A`, then every `R`-algebra map
`φ : A → B` lifts along a surjective `R`-algebra map `π : B' → B` whose kernel
has square zero. -/
@[stacks 02FF]
theorem exists_lift_of_hypersurfaceJacobianIdeal
    {R B' B : Type u} [CommRing R] [CommRing B'] [CommRing B]
    [Algebra R B'] [Algebra R B] (f : MvPolynomial (Fin 2) R)
    (hjac : hypersurfaceJacobianIdeal f = ⊤) (π : B' →ₐ[R] B)
    (hπ : Function.Surjective π) (hker : (RingHom.ker π) ^ 2 = ⊥)
    (φ : (MvPolynomial (Fin 2) R ⧸ Ideal.span {f}) →ₐ[R] B) :
    ∃ φ' : (MvPolynomial (Fin 2) R ⧸ Ideal.span {f}) →ₐ[R] B',
      π.comp φ' = φ :=
  sorry

end FormallySmooth

end Algebra
