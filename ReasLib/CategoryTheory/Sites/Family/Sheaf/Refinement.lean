module

public import ReasLib.CategoryTheory.Sites.Family.BaseChange
public import ReasLib.CategoryTheory.Sites.Family.Covering
public import ReasLib.CategoryTheory.Sites.Family.Sheaf
public import ReasLib.CategoryTheory.Sites.Sheaf.Refinement
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Sheaf conditions under refinement of fixed-target families

This file translates refinement and componentwise pullback separation into the
canonical presieve sheaf condition.  It is independent of a chosen topology or
precoverage.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits
open Opposite

universe w wF v u uI uJ

namespace CategoryTheory

namespace SemiRepresentableFamily.Over

variable {C : Type u} [Category.{v} C]

/-- A morphism of fixed-target families makes the source generated presieve
factor through the target generated presieve. -/
theorem Hom.factorsThru
    {U : C} {𝒱 𝒰 : Over.{w} U} (φ : 𝒱 ⟶ 𝒰) :
    𝒱.toPresieve.FactorsThru 𝒰.toPresieve := sorry

/-- A refinement makes the refining family's generated presieve factor through
the refined family's generated presieve. -/
theorem Refines.factorsThru
    {U : C} {𝒱 𝒰 : Over.{w} U} (h : Refines 𝒱 𝒰) :
    𝒱.toPresieve.FactorsThru 𝒰.toPresieve := sorry

/-- Separatedness for a refining fixed-target family transfers to the refined
family. -/
theorem isSeparatedFor_of_refines
    {U : C} {F : Cᵒᵖ ⥤ Type w} {𝒱 𝒰 : Over.{w} U}
    (h𝒱 : 𝒱.toPresieve.IsSeparatedFor F) (h : Refines 𝒱 𝒰) :
    𝒰.toPresieve.IsSeparatedFor F := sorry

/-- Separatedness for the presieve generated by a fixed-target family makes
restriction to all of its members injective. -/
theorem isSeparatedFor_restriction_injective
    {U : C} {F : Cᵒᵖ ⥤ Type wF} (𝒰 : Over.{w} U)
    (h𝒰 : 𝒰.toPresieve.IsSeparatedFor F) :
    Function.Injective
      (fun s : F.obj (op U) ↦ fun i : 𝒰.index ↦ F.map (𝒰.obj i).hom.op s) := sorry

/-- A sheaf restricts injectively to the members of every covering fixed-target family. -/
theorem sheaf_restriction_injective
    {U : C} {J : GrothendieckTopology C} (𝒰 : Over.{w} U)
    (h𝒰 : 𝒰.toSieve ∈ J U) (ℱ : Sheaf J (Type wF)) :
    Function.Injective
      (fun s : ℱ.obj.obj (op U) ↦ fun i : 𝒰.index ↦ ℱ.obj.map (𝒰.obj i).hom.op s) := sorry

/-- Pointwise slice isomorphisms in both directions make two displayed arrow
families tautologically equivalent after canonical universe reindexing. -/
theorem TautologicallyEquivalent.ofArrows
    {U : C} {I : Type uI} {Ui : I → C} (π : ∀ i, Ui i ⟶ U)
    {J : Type uJ} {Vj : J → C} (ψ : ∀ j, Vj j ⟶ U)
    (α : I → J) (β : J → I)
    (hα : ∀ i, CategoryTheory.Over.mk (π i) ≅ CategoryTheory.Over.mk (ψ (α i)))
    (hβ : ∀ j, CategoryTheory.Over.mk (ψ j) ≅ CategoryTheory.Over.mk (π (β j))) :
    TautologicallyEquivalent
      (ofArrows (fun i : ULift.{uJ} I ↦ Ui i.down) fun i ↦ π i.down)
      (ofArrows (fun j : ULift.{uI} J ↦ Vj j.down) fun j ↦ ψ j.down) := sorry

/-- Tautologically equivalent fixed-target families impose equivalent sheaf
conditions on every presheaf. -/
theorem TautologicallyEquivalent.isSheafFor_iff
    {U : C} {F : Cᵒᵖ ⥤ Type w} {𝒰 𝒱 : Over.{w} U}
    (h : TautologicallyEquivalent 𝒰 𝒱) :
    𝒰.toPresieve.IsSheafFor F ↔ 𝒱.toPresieve.IsSheafFor F := sorry

/-- Lemma 7.8.6 (0G1L): a presheaf that is a sheaf for a refining fixed-target family
is a sheaf for the refined family when all componentwise base-change restrictions are
injective. -/
@[stacks 0G1L]
theorem isSheafFor_of_refines_of_injective
    {U : C} {𝒰 𝒱 : Over U}
    (h : Refines 𝒱 𝒰)
    (F : Cᵒᵖ ⥤ Type w)
    [∀ i : 𝒰.index, ∀ j : 𝒱.index, HasPullback (𝒱.obj j).hom (𝒰.obj i).hom]
    (h𝒱 : (toPresieve 𝒱).IsSheafFor F)
    (hsep : ∀ i : 𝒰.index,
      Function.Injective
        (fun s : F.obj (op (𝒰.obj i).left) ↦
          fun j : (baseChange 𝒱 (𝒰.obj i).hom).index ↦
            F.map (((baseChange 𝒱 (𝒰.obj i).hom).obj j).hom).op s)) :
    (toPresieve 𝒰).IsSheafFor F := sorry

/-- The indexed-arrow form of the fixed-target-family refinement criterion. -/
theorem isSheafFor_ofArrows_refines_of_injective
    {U : C} {I : Type uI} {Ui : I → C} (π : ∀ i : I, Ui i ⟶ U)
    {J : Type uJ} {Vj : J → C} (ψ : ∀ j : J, Vj j ⟶ U)
    (α : J → I) (f : ∀ j : J, Vj j ⟶ Ui (α j))
    (hf : ∀ j : J, f j ≫ π (α j) = ψ j)
    (F : Cᵒᵖ ⥤ Type w)
    [∀ i : I, ∀ j : J, HasPullback (ψ j) (π i)]
    (hV : Presieve.IsSheafFor F (Presieve.ofArrows Vj ψ))
    (hsep : ∀ i : I,
      Function.Injective
        (fun s : F.obj (op (Ui i)) ↦
          fun j : J ↦ F.map (pullback.snd (ψ j) (π i)).op s)) :
    Presieve.IsSheafFor F (Presieve.ofArrows Ui π) := sorry

end CategoryTheory.SemiRepresentableFamily.Over
