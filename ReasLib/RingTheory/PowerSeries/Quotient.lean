module

public import Mathlib.RingTheory.PowerSeries.NoZeroDivisors
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Quotients of Power-Series Rings

This module identifies the quotient of a one-variable power-series ring by
its variable with the coefficient ring.
-/

universe u

open scoped PowerSeries

namespace PowerSeries

/-- The kernel of the constant-coefficient map is the ideal generated by `X`. -/
theorem ker_constantCoeff {R : Type u} [Semiring R] :
    RingHom.ker (constantCoeff (R := R)) = Ideal.span ({X} : Set R⟦X⟧) := sorry

/-- Quotienting a one-variable power-series ring by `(X)` recovers its
coefficient ring. -/
noncomputable def quotientSpanXRingEquiv {R : Type u} [CommRing R] :
    ((PowerSeries R) ⧸ Ideal.span ({X} : Set (PowerSeries R))) ≃+* R :=
  (Ideal.quotEquivOfEq (ker_constantCoeff (R := R)).symm).trans
    (RingHom.quotientKerEquivOfSurjective (constantCoeff_surj (R := R)))

/-- The quotient equivalence sends the class of a power series to its constant coefficient. -/
@[simp]
theorem quotientSpanXRingEquiv_mk {R : Type u} [CommRing R] (f : PowerSeries R) :
    quotientSpanXRingEquiv (R := R)
        (Ideal.Quotient.mk (Ideal.span ({X} : Set (PowerSeries R))) f) =
      constantCoeff f := sorry

/-- The inverse quotient equivalence sends a coefficient to the class of its constant power
series. -/
@[simp]
theorem quotientSpanXRingEquiv_symm_apply {R : Type u} [CommRing R] (r : R) :
    (quotientSpanXRingEquiv (R := R)).symm r =
      Ideal.Quotient.mk (Ideal.span ({X} : Set (PowerSeries R))) (C r) := sorry

end PowerSeries
