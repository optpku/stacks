module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import ReasLib.RingTheory.Ideal.ResidueField.Quotient
public import ReasLib.RingTheory.LocalRing.ResidueField.Transcendence
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Prime ideals in finite-variable polynomial algebras

This leaf owns the coordinate-ideal normal form used in Noether normalization.
The tail ideal is defined independently of primality, while the prime-coordinate
theorem supplies the finite self-map needed by downstream dimension arguments.
-/

open MvPolynomial

namespace MvPolynomial.NoetherNormalization

universe u

/-- Lemma 10.115.6, tag 051P: the ideal generated by the variables whose finite
indices lie in the tail `r ≤ i.1` of `MvPolynomial (Fin n) A`. -/
@[stacks 051P]
noncomputable def tailIdeal (A : Type u) [CommSemiring A] (n r : ℕ) :
    Ideal (MvPolynomial (Fin n) A) :=
  Ideal.span {f | ∃ i : Fin n, r ≤ i.1 ∧ f = (X i : MvPolynomial (Fin n) A)}

/-- The defining span description of `tailIdeal`. -/
theorem tailIdeal_def (A : Type u) [CommSemiring A] (n r : ℕ) :
    tailIdeal A n r =
      Ideal.span {f | ∃ i : Fin n, r ≤ i.1 ∧ f = (X i : MvPolynomial (Fin n) A)} := sorry
/- Proof strategy: unfold `tailIdeal`; the equality is definitional and can
be discharged by `rfl` once the owner is proved. -/

/-- Every tail coordinate generator belongs to `tailIdeal`. -/
theorem X_mem_tailIdeal (A : Type u) [CommSemiring A] {n : ℕ} {r : ℕ}
    (i : Fin n) (hi : r ≤ i.1) :
    (X i : MvPolynomial (Fin n) A) ∈ tailIdeal A n r := sorry
/- Proof strategy: rewrite with `tailIdeal_def` and use
`Ideal.subset_span` on the explicit witness `⟨i, hi, rfl⟩`. -/

/-- Increasing the cutoff can only shrink the tail-coordinate ideal. -/
theorem tailIdeal_mono {A : Type u} [CommSemiring A] {n r s : ℕ}
    (hrs : r ≤ s) : tailIdeal A n s ≤ tailIdeal A n r := sorry
/- Proof strategy: use `Ideal.span_mono` and map a generator witness for the
larger cutoff to the same witness for the smaller cutoff. -/

/-- The tail-coordinate ideal is zero when its cutoff is beyond all variables. -/
theorem tailIdeal_eq_bot_of_le {A : Type u} [CommSemiring A] {n r : ℕ}
    (hnr : n ≤ r) : tailIdeal A n r = ⊥ := sorry
/- Proof strategy: rewrite by `tailIdeal_def`, apply `Ideal.span_eq_bot`, and
contradict `r ≤ i.1` using `i.isLt` and `n ≤ r`. -/

/-- Lemma 10.115.6, tag 051P: a prime ideal in a finite-variable polynomial
algebra admits a finite self-map whose contraction is the tail ideal indexed by
the residue-field transcendence degree. -/
@[stacks 051P]
theorem exists_finite_comap_eq_tailIdeal
    {k : Type u} [Field k] {n : ℕ}
    (q : Ideal (MvPolynomial (Fin n) k)) [q.IsPrime] :
    ∃ φ : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k,
      φ.Finite ∧
        Ideal.comap φ q =
          tailIdeal k n (Cardinal.toNat (Algebra.trdeg k q.ResidueField)) := sorry
/- Proof strategy: induct on the number of variables, use the finite monic
last-variable substitution and the coefficient-prime induction, then transport
the contraction through the last-variable polynomial equivalence. -/

end MvPolynomial.NoetherNormalization
