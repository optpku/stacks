module

public import ReasLib.RingTheory.RegularLocalRing.Ideal
import StacksCheckRecall

@[expose] public section

universe u

/- Lemma 53.19.2 (1): in a two-dimensional regular local ring, an ideal contained in
the maximal ideal whose quotient is reduced is zero, maximal, or generated by a nonzero
element of the maximal ideal. -/
@[stacks 0C48]
#check (IsRegularLocalRing.ideal_eq_bot_or_maximalIdeal_or_span :
  ∀ {A : Type u} [CommRing A] [IsRegularLocalRing A]
    (hdim : ringKrullDim A = 2) (I : Ideal A)
    (hI : I ≤ IsLocalRing.maximalIdeal A) [IsReduced (A ⧸ I)],
    I = ⊥ ∨ I = IsLocalRing.maximalIdeal A ∨
      ∃ f : A, f ≠ 0 ∧ f ∈ IsLocalRing.maximalIdeal A ∧ I = Ideal.span {f})

/- Lemma 53.19.2 (2): in a two-dimensional regular local ring, an ideal contained in
the maximal ideal whose quotient has depth one is generated by a nonzero element of the
maximal ideal. -/
@[stacks 0C48]
#check (IsRegularLocalRing.ideal_eq_span_of_quotient_depth_eq_one :
  ∀ {A : Type u} [CommRing A] [IsRegularLocalRing A]
    (hdim : ringKrullDim A = 2) (I : Ideal A)
    (hI : I ≤ IsLocalRing.maximalIdeal A)
    (hdepth : moduleDepth A (A ⧸ I) = 1),
    ∃ f : A, f ≠ 0 ∧ f ∈ IsLocalRing.maximalIdeal A ∧ I = Ideal.span {f})
