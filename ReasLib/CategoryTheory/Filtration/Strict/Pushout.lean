module

public import ReasLib.CategoryTheory.Filtration.Strict.Abelian
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Pushouts of Filtered Objects

Pushouts are modeled on the ambient pushout, with each filtration stage generated by the images
of the corresponding stages of the two source objects.  The resulting global `HasPushout`
instance lets downstream files use Mathlib's standard `pushout`, `pushout.inl`, and `pushout.inr`
API directly.
-/

@[expose] public section

open CategoryTheory Limits

universe v u

noncomputable section

namespace CategoryTheory.FilteredObject.Hom

open FilteredObject

variable {C : Type u} [Category.{v} C] [Abelian C]
variable {A B D : FilteredObject C}

/-- The map whose image generates degree `p` of the canonical filtered pushout. -/
private def pushoutStageMap (f : A ⟶ B) (g : A ⟶ D) (p : ℤ) :
    ((B.filtration p : C) ⊞ (D.filtration p : C)) ⟶ pushout f.hom g.hom :=
  biprod.desc
    ((B.filtration p).arrow ≫ pushout.inl f.hom g.hom)
    ((D.filtration p).arrow ≫ pushout.inr f.hom g.hom)

/-- The stage images defining the canonical filtered pushout form an antitone family. -/
private theorem pushoutFiltration_antitone (f : A ⟶ B) (g : A ⟶ D) :
    Antitone fun p : ℤ ↦ imageSubobject (pushoutStageMap f g p) := sorry

/-- The canonical filtered pushout model on the ambient pushout object. -/
private def pushoutModel (f : A ⟶ B) (g : A ⟶ D) : FilteredObject C where
  obj := pushout f.hom g.hom
  filtration :=
    { toFun := fun p ↦ imageSubobject (pushoutStageMap f g p)
      monotone' := by
        intro p q hpq
        exact pushoutFiltration_antitone f g hpq }

/-- The ambient left pushout map preserves the canonical pushout filtration. -/
private theorem pushoutModelInl_preserves (f : A ⟶ B) (g : A ⟶ D) (p : ℤ) :
    ((pushoutModel f g).filtration p).Factors
      ((B.filtration p).arrow ≫ pushout.inl f.hom g.hom) := sorry

/-- The ambient right pushout map preserves the canonical pushout filtration. -/
private theorem pushoutModelInr_preserves (f : A ⟶ B) (g : A ⟶ D) (p : ℤ) :
    ((pushoutModel f g).filtration p).Factors
      ((D.filtration p).arrow ≫ pushout.inr f.hom g.hom) := sorry

/-- The left leg into the canonical filtered pushout model. -/
private def pushoutModelInl (f : A ⟶ B) (g : A ⟶ D) : B ⟶ pushoutModel f g where
  hom := pushout.inl f.hom g.hom
  preserves := pushoutModelInl_preserves f g

/-- The right leg into the canonical filtered pushout model. -/
private def pushoutModelInr (f : A ⟶ B) (g : A ⟶ D) : D ⟶ pushoutModel f g where
  hom := pushout.inr f.hom g.hom
  preserves := pushoutModelInr_preserves f g

/-- The canonical filtered pushout model satisfies the pushout universal property. -/
private theorem pushoutModel_isPushout (f : A ⟶ B) (g : A ⟶ D) :
    IsPushout f g (pushoutModelInl f g) (pushoutModelInr f g) := sorry

/-- Filtered objects in an abelian category have pushouts. -/
noncomputable instance hasPushout (f : A ⟶ B) (g : A ⟶ D) : HasPushout f g :=
  (pushoutModel_isPushout f g).hasPushout

namespace Pushout

/-- The underlying object of the canonical filtered pushout is the ambient pushout. -/
@[simp]
theorem obj (f : A ⟶ B) (g : A ⟶ D) :
    (pushout f g : FilteredObject C).obj = pushout f.hom g.hom := sorry

/-- The underlying map of the left leg of the canonical filtered pushout. -/
@[simp]
theorem inl_hom (f : A ⟶ B) (g : A ⟶ D) :
    (pushout.inl f g).hom ≫ eqToHom (obj f g) = pushout.inl f.hom g.hom := sorry

/-- The underlying map of the right leg of the canonical filtered pushout. -/
@[simp]
theorem inr_hom (f : A ⟶ B) (g : A ⟶ D) :
    (pushout.inr f g).hom ≫ eqToHom (obj f g) = pushout.inr f.hom g.hom := sorry

/-- Forgetting the canonical filtered pushout gives an ambient pushout square. -/
theorem forget_isPushout (f : A ⟶ B) (g : A ⟶ D) :
    IsPushout f.hom g.hom (pushout.inl f g).hom (pushout.inr f g).hom := sorry

/-- The right leg of the canonical filtered pushout is monic when the underlying left leg is
monic. -/
instance mono_inr (f : A ⟶ B) (g : A ⟶ D) [Mono f.hom] :
    Mono (pushout.inr f g) := sorry

end Pushout

/-- In any pushout square of filtered objects, pushing out a strict left leg produces a strict
right leg. -/
@[stacks 05SM]
theorem strict_inr_of_isPushout_of_strict
    {f : A ⟶ B} {g : A ⟶ D} {P : FilteredObject C} {g' : B ⟶ P} {f' : D ⟶ P}
    (sq : IsPushout f g g' f') (hf : Strict f) : Strict f' := sorry

/-- In the canonical pushout square, the pushout of a strict morphism is strict. -/
@[stacks 05SM]
theorem strict_pushout_inr_of_strict (f : A ⟶ B) (g : A ⟶ D) (hf : Strict f) :
    Strict (pushout.inr f g : D ⟶ pushout f g) := sorry

end CategoryTheory.FilteredObject.Hom
