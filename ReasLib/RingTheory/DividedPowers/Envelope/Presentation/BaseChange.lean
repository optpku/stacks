module

public import ReasLib.RingTheory.DividedPowers.Envelope.Presentation
public import ReasLib.RingTheory.Algebra.TensorProduct.RightAlgebra
public import Mathlib.RingTheory.TensorProduct.Maps
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.RingHom.Flat

public section

open scoped TensorProduct Algebra.TensorProduct.Right

universe u v

namespace DividedPowerEnvelope

variable {B B' : Type u} [CommRing B] [CommRing B'] [Algebra B B']
  {I J : Ideal B} (γ : DividedPowers I)
  (hIJ : Ideal.map (RingHom.id B) I ≤ J)
  (E : DividedPowerEnvelope I γ (RingHom.id B) J hIJ)
  (hE : IsUniversal γ (RingHom.id B) hIJ E)
  {ι : Type v} (f : ι → B) (hf : ∀ i, f i ∈ J)
  (hgen : J = I + Ideal.span (Set.range f))

/-- A universal envelope is the quotient of its divided-power polynomial algebra by the
variable and divided-power coefficient relations. -/
private noncomputable def presentationQuotientEquiv :
    (DPPolynomial B ι ⧸ Ideal.span (presentationRelations γ f)) ≃+* E.D :=
  (Ideal.quotEquivOfEq (presentationMap_kernel γ hIJ E hE f hf hgen).symm).trans
    (RingHom.quotientKerEquivOfSurjective
      (presentationMap_surjective γ hIJ E hE f hf hgen).1)

variable {I' : Ideal B'} (γ' : DividedPowers I')
  (hγ : DividedPowers.IsDPMorphism γ γ' (algebraMap B B'))

/-- The coefficient morphism descends through the presentation quotient to a map from
the universal envelope into the quotient by the images of its relations. -/
private noncomputable def toBaseChangePresentation :
    let q := (DPPolynomial.map (DividedPowers.DPMorphism.mk' hγ)).toRingHom
    let K := Ideal.span (presentationRelations γ f)
    let K' := Ideal.map q K
    E.D →+* (DPPolynomial B' ι ⧸ K') :=
  let q := (DPPolynomial.map (DividedPowers.DPMorphism.mk' hγ)).toRingHom
  let K := Ideal.span (presentationRelations γ f)
  (Ideal.quotientMap (Ideal.map q K) q (Ideal.le_comap_map : K ≤ (Ideal.map q K).comap q)).comp
    (presentationQuotientEquiv γ hIJ E hE f hf hgen).symm.toRingHom

variable [Algebra B E.D] (hbase : algebraMap B E.D = E.toD)

/-- The descended coefficient morphism respects the scalar action of the base ring. -/
private theorem toBaseChangePresentation_commutes
    (hbase : algebraMap B E.D = E.toD) (b : B) :
    let q := (DPPolynomial.map (DividedPowers.DPMorphism.mk' hγ)).toRingHom
    let K := Ideal.span (presentationRelations γ f)
    let K' := Ideal.map q K
    toBaseChangePresentation γ hIJ E hE f hf hgen γ' hγ (algebraMap B E.D b) =
      algebraMap B (DPPolynomial B' ι ⧸ K') b := sorry

/-- The descended coefficient morphism is an algebra homomorphism over the base ring. -/
private noncomputable def toBaseChangePresentationAlgHom :
    let q := (DPPolynomial.map (DividedPowers.DPMorphism.mk' hγ)).toRingHom
    let K := Ideal.span (presentationRelations γ f)
    let K' := Ideal.map q K
    E.D →ₐ[B] (DPPolynomial B' ι ⧸ K') :=
  { toBaseChangePresentation γ hIJ E hE f hf hgen γ' hγ with
    commutes' := toBaseChangePresentation_commutes γ hIJ E hE f hf hgen γ' hγ hbase }

/-- Extending the descended coefficient morphism gives the canonical algebra map from
the base-changed envelope to the quotient by the images of the presentation relations. -/
noncomputable def baseChangePresentationMap :
    let q := (DPPolynomial.map (DividedPowers.DPMorphism.mk' hγ)).toRingHom
    let K := Ideal.span (presentationRelations γ f)
    let K' := Ideal.map q K
    TensorProduct B E.D B' →ₐ[B'] (DPPolynomial B' ι ⧸ K') :=
  let q := (DPPolynomial.map (DividedPowers.DPMorphism.mk' hγ)).toRingHom
  let K := Ideal.span (presentationRelations γ f)
  ((AlgHom.liftEquiv B B' E.D (DPPolynomial B' ι ⧸ Ideal.map q K))
      (toBaseChangePresentationAlgHom γ hIJ E hE f hf hgen γ' hγ hbase)).comp
    (Algebra.TensorProduct.commRight B B' E.D).symm.toAlgHom

/-- For a flat divided-power base change whose target ideal is generated by the images of
the source ideal and the target divided-power ideal, the canonical presentation map is bijective. -/
theorem baseChangePresentationMap_bijective
    {B B' : Type u} [CommRing B] [CommRing B'] [Algebra B B']
    {I J : Ideal B} (γ : DividedPowers I)
    (hIJ : Ideal.map (RingHom.id B) I ≤ J)
    (E : DividedPowerEnvelope I γ (RingHom.id B) J hIJ)
    (hE : IsUniversal γ (RingHom.id B) hIJ E)
    {ι : Type v} (f : ι → B) (hf : ∀ i, f i ∈ J)
    (hgen : J = I + Ideal.span (Set.range f))
    {I' J' : Ideal B'} (γ' : DividedPowers I')
    (hγ : DividedPowers.IsDPMorphism γ γ' (algebraMap B B'))
    (hJ' : J' = Ideal.map (algebraMap B B') J + I')
    (hI' : I' ≤ J')
    [Algebra B E.D] (hbase : algebraMap B E.D = E.toD)
    (hflat : RingHom.Flat
      (Ideal.quotientMap I' (algebraMap B B')
        (Ideal.map_le_iff_le_comap.mp hγ.ideal_comp))) :
    Function.Bijective (baseChangePresentationMap γ hIJ E hE f hf hgen γ' hγ hbase) := sorry

/-- The base change of a universal divided-power envelope is the divided-power polynomial
algebra over the new base modulo the images of its original presentation relations. -/
noncomputable def baseChangePresentation
    {B B' : Type u} [CommRing B] [CommRing B'] [Algebra B B']
    {I J : Ideal B} (γ : DividedPowers I)
    (hIJ : Ideal.map (RingHom.id B) I ≤ J)
    (E : DividedPowerEnvelope I γ (RingHom.id B) J hIJ)
    (hE : IsUniversal γ (RingHom.id B) hIJ E)
    {ι : Type v} (f : ι → B) (hf : ∀ i, f i ∈ J)
    (hgen : J = I + Ideal.span (Set.range f))
    {I' J' : Ideal B'} (γ' : DividedPowers I')
    (hγ : DividedPowers.IsDPMorphism γ γ' (algebraMap B B'))
    (hJ' : J' = Ideal.map (algebraMap B B') J + I')
    (hI' : I' ≤ J')
    [Algebra B E.D] (hbase : algebraMap B E.D = E.toD)
    (hflat : RingHom.Flat
      (Ideal.quotientMap I' (algebraMap B B')
        (Ideal.map_le_iff_le_comap.mp hγ.ideal_comp))) :
    let q := (DPPolynomial.map (DividedPowers.DPMorphism.mk' hγ)).toRingHom
    let K := Ideal.span (presentationRelations γ f)
    let K' := Ideal.map q K
    TensorProduct B E.D B' ≃ₐ[B'] (DPPolynomial B' ι ⧸ K') :=
  AlgEquiv.ofBijective (baseChangePresentationMap γ hIJ E hE f hf hgen γ' hγ hbase)
    (baseChangePresentationMap_bijective γ hIJ E hE f hf hgen γ' hγ hJ' hI' hbase hflat)

/-- The base-change presentation equivalence sends a polynomial representative tensored
with a coefficient to its coefficient image in the quotient multiplied by that coefficient. -/
theorem baseChangePresentation_tmul
    {B B' : Type u} [CommRing B] [CommRing B'] [Algebra B B']
    {I J : Ideal B} (γ : DividedPowers I)
    (hIJ : Ideal.map (RingHom.id B) I ≤ J)
    (E : DividedPowerEnvelope I γ (RingHom.id B) J hIJ)
    (hE : IsUniversal γ (RingHom.id B) hIJ E)
    {ι : Type v} (f : ι → B) (hf : ∀ i, f i ∈ J)
    (hgen : J = I + Ideal.span (Set.range f))
    {I' J' : Ideal B'} (γ' : DividedPowers I')
    (hγ : DividedPowers.IsDPMorphism γ γ' (algebraMap B B'))
    (hJ' : J' = Ideal.map (algebraMap B B') J + I')
    (hI' : I' ≤ J')
    [Algebra B E.D] (hbase : algebraMap B E.D = E.toD)
    (hflat : RingHom.Flat
      (Ideal.quotientMap I' (algebraMap B B')
        (Ideal.map_le_iff_le_comap.mp hγ.ideal_comp)))
    (p : DPPolynomial B ι) (b' : B') :
    let q := (DPPolynomial.map (DividedPowers.DPMorphism.mk' hγ)).toRingHom
    let K := Ideal.span (presentationRelations γ f)
    let K' := Ideal.map q K
    baseChangePresentation γ hIJ E hE f hf hgen γ' hγ hJ' hI' hbase hflat
        (TensorProduct.tmul B (presentationMap γ hIJ E f hf p) b') =
      algebraMap B' (DPPolynomial B' ι ⧸ K') b' * Ideal.Quotient.mk K' (q p) := sorry

end DividedPowerEnvelope
