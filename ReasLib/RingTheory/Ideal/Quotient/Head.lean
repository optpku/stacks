module

public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Head Quotients of Finite Families

This leaf owns the ring-theoretic construction obtained by quotienting by the
first member of a finite family.  It has no local, regular, or parameter-system
hypotheses; those refinements belong in the corresponding later leaves.
-/

universe u

namespace Ideal

variable {R : Type u} [CommRing R]

/-- The first member of a finite family, packaged as an element of the ideal generated by the
family.  This keeps the ambient ideal as the span of the whole family, unlike `headIdeal`, which
is the principal ideal generated by the first member. -/
@[stacks 02IE "first member of a finite-family span"]
def spanRangeFirst {d : ℕ} (x : Fin (d + 1) → R) : Ideal.span (Set.range x) :=
  ⟨x 0, Ideal.subset_span ⟨0, rfl⟩⟩

/-- Coercion of `spanRangeFirst` returns the selected first entry. -/
@[simp]
theorem spanRangeFirst_coe {d : ℕ} (x : Fin (d + 1) → R) :
    (spanRangeFirst x : R) = x 0 :=
  rfl

/-- Tag `02IE`: the ideal generated by the first entry of a finite family.
It is reducible so canonical singleton-quotient instances apply directly. -/
@[reducible, stacks 02IE "head ideal of a finite family"]
def headIdeal {d : ℕ} (x : Fin (d + 1) → R) : Ideal R :=
  Ideal.span ({x 0} : Set R)

/-- The head ideal of a cons family is the principal ideal of its first entry. -/
@[simp, stacks 02IE "head ideal of a cons family"]
theorem headIdeal_cons {d : ℕ} (x : R) (xs : Fin d → R) :
    headIdeal (Fin.cons x xs) = Ideal.span ({x} : Set R) := sorry

/-- The tail of a finite family after quotienting by the ideal of its first
entry. -/
@[stacks 02IE "head quotient tail"]
def headQuotientTail {d : ℕ} (x : Fin (d + 1) → R) :
    Fin d → R ⧸ headIdeal x :=
  fun i ↦ Ideal.Quotient.mk (headIdeal x) (x i.succ)

/-- Evaluating the head-quotient tail gives the quotient class of the
corresponding successor entry. -/
@[simp, stacks 02IE "head quotient tail evaluation"]
theorem headQuotientTail_apply {d : ℕ} (x : Fin (d + 1) → R) (i : Fin d) :
    headQuotientTail x i = Ideal.Quotient.mk (headIdeal x) (x i.succ) := sorry

/-- Mapping the ideal generated by a finite family through the quotient by its
head gives the ideal generated by the quotient tail. -/
@[stacks 02IE "finite-family head quotient span"]
theorem map_span_range_headQuotientTail {d : ℕ} (x : Fin (d + 1) → R) :
    Ideal.map (Ideal.Quotient.mk (headIdeal x)) (Ideal.span (Set.range x)) =
      Ideal.span (Set.range (headQuotientTail x)) := sorry

end Ideal
