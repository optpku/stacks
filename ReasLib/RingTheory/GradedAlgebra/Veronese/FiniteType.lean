module

public import Mathlib.RingTheory.GradedAlgebra.FiniteType
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Veronese Subalgebras of Finite-Type Graded Rings

@stack 0EGH

Sufficiently divisible Veronese subalgebras are generated in degree one over the degree-zero
subring.
-/

universe u

namespace GradedAlgebra

/-- Lemma 10.56.2: in a finite-type nonnegatively graded ring, all sufficiently divisible
Veronese subalgebras are generated by their degree-one piece over the degree-zero ring. -/
@[stacks 0EGH]
theorem exists_veronese_adjoin_eq
    {S : Type u} [CommRing S] (𝒜 : ℕ → Submodule ℤ S)
    [GradedAlgebra 𝒜] [Algebra.FiniteType (𝒜 0) S] :
    ∃ d₀ : ℕ+, ∀ ⦃d : ℕ+⦄, (d₀ : ℕ) ∣ (d : ℕ) →
      Algebra.adjoin (𝒜 0) (⋃ n : ℕ, (𝒜 (n * (d : ℕ)) : Set S)) =
        Algebra.adjoin (𝒜 0) (𝒜 (d : ℕ) : Set S) := sorry

end GradedAlgebra
