module

public import Mathlib.CategoryTheory.Limits.Constructions.Over.Basic
public import Mathlib.CategoryTheory.Limits.Over
public import Mathlib.CategoryTheory.Sites.LeftExact
public import Mathlib.Logic.Relation
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Coproduct
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.FiniteType
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.GeometricPoint
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.PreRelation.Pairings
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.PreRelation.Invariant
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.PreRelation.SetTheoretic
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.PreRelation.SpacesQuotient
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Pullback

/-!
# Generated pre-equivalence relation

This module constructs, from a pre-relation `j : R ⟶ U ⨯ U` over `B`, the pre-relation
`j_∞ : R_∞ ⟶ U ⨯ U` obtained by first forming `R_1 = R ∐ U ∐ R` with legs `j`, `j_diag`,
and `j_flip`, then iterating fibre products `R_{n+1} = R_1 ×_{s_1, U, t_n} R_n`, and
finally taking the coproduct `R_∞ = ∐_n R_n`.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.AlgebraicSpace Limits Opposite
open _root_.Relation (EqvGen)

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.PreRelation

/-- The three summands of `R_1 = R ∐ U ∐ R`: the original arrows, the diagonal, and the flip. -/
inductive StageOneIndex : Type where
  | rel
  | diag
  | flip

variable {S : Scheme.{u}} {B : AlgebraicSpace S} {U : Over B}

variable (P : PreRelation U)

/-- The three summands `R`, `U`, and `R` of `R_1 = R ∐ U ∐ R`. -/
def stageOneFamily : StageOneIndex → Over B :=
  fun i ↦
    match i with
    | .rel => P.left
    | .diag => U
    | .flip => P.left

/-- The object `R_1 = R ∐ U ∐ R` in `Over B`. -/
def stageOneObj : Over B :=
  ∐ P.stageOneFamily

/-- The legs `j`, `j_diag`, and `j_flip` of `j_1 : R_1 ⟶ U ⨯ U`. -/
def stageOneLeg : ∀ i : StageOneIndex, P.stageOneFamily i ⟶ U ⨯ U :=
  fun i ↦
    match i with
    | .rel => P.hom
    | .diag => diagonalPairing U
    | .flip => P.flipHom

/-- The morphism `j_1 = j ∐ j_diag ∐ j_flip : R_1 ⟶ U ⨯ U`. -/
def stageOneHom : P.stageOneObj ⟶ U ⨯ U :=
  Sigma.desc P.stageOneLeg

/-- The pre-relation `j_1 : R_1 ⟶ U ⨯ U` on the coproduct `R ∐ U ∐ R`. -/
def stageOne : PreRelation U :=
  ofHom P.stageOneHom

/-- The defining arrow of `stageOne` is `stageOneHom`. -/
theorem stageOne_hom : P.stageOne.hom = P.stageOneHom := rfl

/-- The `i`-th coproduct inclusion into `R_1` postcomposed with `j_1` recovers the
corresponding leg. -/
theorem stageOneHom_ι (i : StageOneIndex) :
    Sigma.ι P.stageOneFamily i ≫ P.stageOneHom = P.stageOneLeg i := sorry

/-- The iterated fibre-product stages `R_n`, with `R_1` at index `0` and
`R_{n+1} = R_1 ×_{s_1, U, t_n} R_n`. -/
def stage (n : ℕ) : PreRelation U :=
  Nat.rec P.stageOne
    (fun _ prev ↦
      ofHom
        (prod.lift (pullback.fst P.stageOne.s prev.t ≫ P.stageOne.t)
          (pullback.snd P.stageOne.s prev.t ≫ prev.s)))
    n

/-- The zeroth stage is `R_1`. -/
theorem stage_zero : P.stage 0 = P.stageOne := rfl

/-- The successor stage is the fibre product of `R_1` with `R_n` over `U`. -/
theorem stage_succ (n : ℕ) :
    P.stage (n + 1) =
      ofHom
        (prod.lift (pullback.fst P.stageOne.s (P.stage n).t ≫ P.stageOne.t)
          (pullback.snd P.stageOne.s (P.stage n).t ≫ (P.stage n).s)) := rfl


/-- The family of underlying `Over B` objects of the stages `R_n`. -/
def generatedFamily (n : ℕ) : Over B :=
  (P.stage n).left

/-- The coproduct object `R_∞ = ∐_n R_n` in `Over B`. -/
def generatedObj : Over B :=
  ∐ P.generatedFamily

/-- The morphism `j_∞ : R_∞ ⟶ U ⨯ U` folding the stage maps `j_n`. -/
def generatedHom : P.generatedObj ⟶ U ⨯ U :=
  Sigma.desc fun n ↦ (P.stage n).hom

/-- The pre-relation `j_∞ : R_∞ ⟶ U ⨯ U` generated by `P`. -/
def generated : PreRelation U :=
  ofHom P.generatedHom

/-- The defining arrow of `generated` is `generatedHom`. -/
theorem generated_hom : P.generated.hom = P.generatedHom := rfl

/-- The coproduct inclusion of the `n`-th stage into `R_∞`. -/
def generated_ι (n : ℕ) : (P.stage n).left ⟶ P.generated.left :=
  Sigma.ι P.generatedFamily n

/-- Postcomposing `generated_ι n` with `j_∞` recovers `j_n`. -/
theorem generatedHom_ι (n : ℕ) :
    P.generated_ι n ≫ P.generated.hom = (P.stage n).hom := sorry

/-- The canonical map of pre-relations `R ⟶ R_∞` including the `R`-summand of `R_1`. -/
def toGenerated : P.left ⟶ P.generated.left :=
  Sigma.ι P.stageOneFamily StageOneIndex.rel ≫ P.generated_ι 0

/-- The inclusion `R ⟶ R_∞` is compatible with the maps to `U ⨯ U`. -/
theorem toGenerated_comp_hom : P.toGenerated ≫ P.generated.hom = P.hom := sorry

/-- The inclusion `R ⟶ R_∞` intertwines the first projections. -/
theorem toGenerated_comp_t : P.toGenerated ≫ P.generated.t = P.t := sorry

/-- The inclusion `R ⟶ R_∞` intertwines the second projections. -/
theorem toGenerated_comp_s : P.toGenerated ≫ P.generated.s = P.s := sorry

/-- Relatedness for `P` implies relatedness for `P.generated`, via `toGenerated`. -/
theorem pointRel_to_generated {T : Over B} {x y : T ⟶ U} (h : P.pointRel T x y) :
    P.generated.pointRel T x y := sorry

/-- The presheaf map `U/R ⟶ U/R_∞` induced by the inclusion of generating relations. -/
def generated_spacesQuotientPresheafMap :
    P.spacesQuotientPresheaf ⟶ P.generated.spacesQuotientPresheaf where
  app T :=
    TypeCat.ofHom <|
      Quot.map (fun x : T.unop ⟶ U ↦ x) fun _ _ h ↦
        P.pointRel_to_generated h
  naturality := sorry

/-- The component of `generated_spacesQuotientPresheafMap` on a class of `x` is the class
of `x` for the generated pre-relation. -/
theorem generated_spacesQuotientPresheafMap_app (T : Over B) (x : T ⟶ U) :
    P.generated_spacesQuotientPresheafMap.app (op T) (Quot.mk (P.pointRel T) x) =
      Quot.mk (P.generated.pointRel T) x := sorry

/-- The canonical map of fppf quotient sheaves `U/R ⟶ U/R_∞` on `Spaces / B`. -/
def generated_spacesQuotientMap :
    P.spacesQuotientSheaf ((fppfPrecoverage S).toGrothendieck.over B) ⟶
      P.generated.spacesQuotientSheaf ((fppfPrecoverage S).toGrothendieck.over B) :=
  (presheafToSheaf ((fppfPrecoverage S).toGrothendieck.over B) (Type (u + 1))).map
    P.generated_spacesQuotientPresheafMap

/-- If `P.s` and `P.t` are locally of finite type, then so is `P.generated.s`. -/
instance instLocallyOfFiniteType_generated_s
    [LocallyOfFiniteType P.s.left] [LocallyOfFiniteType P.t.left] :
    LocallyOfFiniteType P.generated.s.left := sorry

/-- If `P.s` and `P.t` are locally of finite type, then so is `P.generated.t`. -/
instance instLocallyOfFiniteType_generated_t
    [LocallyOfFiniteType P.s.left] [LocallyOfFiniteType P.t.left] :
    LocallyOfFiniteType P.generated.t.left := sorry

/-- The generated pre-relation is a pre-equivalence relation. -/
theorem generated_isPreEquivalence : P.generated.IsPreEquivalence := sorry

/-- A morphism is invariant under a pre-relation if and only if it is invariant under its
generated pre-relation. -/
theorem equalizes_iff_generated {X : Over B} (φ : U ⟶ X) :
    P.IsInvariantHom φ ↔ P.generated.IsInvariantHom φ := sorry

/-- The canonical comparison of fppf quotient sheaves for a pre-relation and its generated
pre-relation is an isomorphism. -/
instance generated_spacesQuotientMap_isIso : IsIso P.generated_spacesQuotientMap := sorry

/-- A pre-relation and its generated pre-relation induce the same weak orbit relation on
geometric points. -/
theorem generated_eqvGen_pointRel (k : GeometricPoint B) (x y : Over.mk k.hom ⟶ U) :
    EqvGen (P.pointRel (Over.mk k.hom)) x y ↔
      EqvGen (P.generated.pointRel (Over.mk k.hom)) x y := sorry

/-- A pre-relation and its generated pre-relation induce the same orbit relation after
restriction along field extensions of a geometric point. -/
theorem generated_orbitRel (k : GeometricPoint B) (x y : Over.mk k.hom ⟶ U) :
    (∃ (L : Type u) (_ : Field L) (_ : Algebra k.K L),
        EqvGen (P.pointRel (Over.mk (fieldExtensionOverMap L k.structureHom ≫ k.hom)))
          (restrictAlongFieldExtension L x) (restrictAlongFieldExtension L y)) ↔
      (∃ (L : Type u) (_ : Field L) (_ : Algebra k.K L),
        EqvGen (P.generated.pointRel
            (Over.mk (fieldExtensionOverMap L k.structureHom ≫ k.hom)))
          (restrictAlongFieldExtension L x) (restrictAlongFieldExtension L y)) := sorry

end AlgebraicGeometry.AlgebraicSpace.PreRelation
