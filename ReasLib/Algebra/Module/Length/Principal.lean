module

public import Mathlib.RingTheory.OrderOfVanishing.Basic

@[expose] public section

universe u

namespace Module

/-- In a one-dimensional Noetherian local domain, the length of the quotient by the
principal ideal generated by a product of nonzero elements is the sum of the lengths
of the quotients by the principal ideals generated by the two factors. -/
theorem length_quotient_span_singleton_mul
    {R : Type u} [CommRing R] [IsDomain R] [IsLocalRing R] [IsNoetherianRing R]
    (hdim : ringKrullDim R = 1) {a b : R} (ha : a ≠ 0) (hb : b ≠ 0) :
    Module.length R (R ⧸ Ideal.span {a * b}) =
      Module.length R (R ⧸ Ideal.span {a}) + Module.length R (R ⧸ Ideal.span {b}) := sorry

end Module
