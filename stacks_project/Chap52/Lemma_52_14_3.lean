module

public import ReasLib.RingTheory.Spectrum.Prime.Connected.Principal
import StacksCheckRecall

@[expose] public section

open scoped ENat

universe u

/- Lemma 52.14.3: let `A` be a Noetherian domain with a dualizing complex, let
`f ∈ 𝔞` be nonzero, and suppose that `A` is complete for the principal ideal
generated by `f`. If every irreducible component of `V(𝔞)` has codimension greater
than two in `Spec(A)`, equivalently `(2 : ℕ∞) < 𝔞.height`, then
`V(f) ∖ V(𝔞)` is connected. -/
@[stacks 0EG3] #check (PrimeSpectrum.zeroLocus_diff_connected_of_principal :
    ∀ {A : Type u} [CommRing A] [IsNoetherianRing A] [IsDomain A]
    (𝔞 : Ideal A) (f : A) (hf : f ∈ 𝔞) (hf0 : f ≠ 0)
    (h_dualizing : CategoryTheory.DerivedCategory.HasCanonicalDualizingComplex A)
    [IsAdicComplete (Ideal.span ({f} : Set A)) A]
    (h_codim : (2 : ℕ∞) < 𝔞.height),
    _root_.IsConnected
      (PrimeSpectrum.zeroLocus (Ideal.span ({f} : Set A) : Set A) \
        PrimeSpectrum.zeroLocus (𝔞 : Set A)))
