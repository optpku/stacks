module

public import Mathlib.FieldTheory.IsAlgClosed.Basic
public import ReasLib.AlgebraicGeometry.Scheme.Module.Picard.Pullback
public import ReasLib.AlgebraicGeometry.Scheme.Morphism.Projective.Basic
public import ReasLib.AlgebraicGeometry.Scheme.Variety.Curve.ClosedPoint

/-!
# Picard restriction away from a closed point

This module describes the Picard kernel of the punctured open of a smooth
projective curve over an algebraically closed field.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.Curve

open ClosedPoint

/-- The Picard restriction kernel away from a closed point is generated by the
class of the associated sheaf of the reduced closed-point ideal. -/
theorem picardPullback_ker_eq_zmultiples_closedPoint
    {k : Type u} [Field k] [IsAlgClosed k]
    (X : SchemeOverField k) [Curve X] [Smooth X.hom] [Projective X.hom]
    (x : X.left) (hx : x ∈ closedPoints X.left) :
    (Scheme.Hom.picardPullback (closedPointOpenComplement x hx).ι).ker =
      AddSubgroup.zmultiples
        (Scheme.Modules.picardClass (closedPointIdeal x hx).associatedSheaf) :=
  sorry

/-- Integer multiplication by the associated-sheaf class of a reduced closed
point is injective in the Picard group of a smooth projective curve. -/
theorem injective_zsmul_closedPointAssociatedSheaf
    {k : Type u} [Field k] [IsAlgClosed k]
    (X : SchemeOverField k) [Curve X] [Smooth X.hom] [Projective X.hom]
    (x : X.left) (hx : x ∈ closedPoints X.left) :
    Function.Injective
      (zmultiplesHom (X.left.PicardGroup)
        (Scheme.Modules.picardClass (closedPointIdeal x hx).associatedSheaf)) :=
  sorry

/-- A Picard class restricts trivially away from a closed point exactly when it
is an integer multiple of the associated-sheaf class of that point. -/
theorem mem_ker_picardPullback_closedPoint_iff
    {k : Type u} [Field k] [IsAlgClosed k]
    (X : SchemeOverField k) [Curve X] [Smooth X.hom] [Projective X.hom]
    (x : X.left) (hx : x ∈ closedPoints X.left) (L : X.left.PicardGroup) :
    Scheme.Hom.picardPullback (closedPointOpenComplement x hx).ι L = 0 ↔
      ∃ n : ℤ, L = n • Scheme.Modules.picardClass
        (closedPointIdeal x hx).associatedSheaf :=
  sorry

end AlgebraicGeometry.Curve
