module

public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Sequence.Koszul.Relations

/-!
# First homology of a finite-family Koszul chain complex

The low-degree chain model is the short complex of trivial relations, tuples, and their linear
combination.  It computes degree-one homology of the contraction Koszul complex and is therefore
the concrete owner relevant to `RingTheory.Sequence.IsH1RegularOn`.
@stack 062E
-/

@[expose] public section

noncomputable section

universe u

namespace KoszulComplex.Homology.H1

open CategoryTheory CategoryTheory.Limits ModuleCat

variable {R : Type u} [CommRing R] {n : ℕ}
variable (f : Fin n → R) (N : Type u) [AddCommGroup N] [Module R N]

/-- A tuple is a degree-one cycle when its linear combination with the finite family is zero. -/
def IsCycle (x : Fin n → N) : Prop :=
  ∑ i, f i • x i = 0

/-- The boundary map generated by the trivial relations
`f i • e j - f j • e i` among a finite family. -/
def relationBoundary : (Fin n × Fin n → N) →ₗ[R] Fin n → N :=
  LinearMap.pi fun j ↦ ∑ i,
    (DistribSMul.toLinearMap R N (f i)).comp
      (LinearMap.proj (R := R) (φ := fun _ : Fin n × Fin n ↦ N) (i, j) -
        LinearMap.proj (R := R) (φ := fun _ : Fin n × Fin n ↦ N) (j, i))

/-- The `j`th coordinate of the trivial-relation boundary is the expected finite sum. -/
@[simp]
theorem relationBoundary_apply (x : Fin n × Fin n → N) (j : Fin n) :
    relationBoundary f N x j = ∑ i, f i • (x (i, j) - x (j, i)) := sorry

/-- For coefficients in the regular module, the low-degree boundary is the universal Koszul
relation map. -/
theorem relationBoundary_self :
    relationBoundary f R = KoszulComplex.relationMap f := sorry

/-- The finite-family linear-combination map `(x i) ↦ ∑ i, f i • x i`. -/
def linearCombination : (Fin n → N) →ₗ[R] N :=
  ∑ i, (DistribSMul.toLinearMap R N (f i)).comp
    (LinearMap.proj (R := R) (φ := fun _ : Fin n ↦ N) i)

/-- The finite-family linear-combination map evaluates as its defining sum. -/
@[simp]
theorem linearCombination_apply (x : Fin n → N) :
    linearCombination f N x = ∑ i, f i • x i := sorry

/-- For coefficients in the regular module, the outgoing differential is the universal Koszul
linear form. -/
theorem linearCombination_self :
    linearCombination f R = koszulLinearForm f := sorry

/-- Trivial Koszul relations lie in the kernel of the linear-combination map. -/
theorem linearCombination_comp_relationBoundary :
    (linearCombination f N).comp (relationBoundary f N) = 0 := sorry

/-- The low-degree chain model
`N^(Fin n × Fin n) ⟶ N^(Fin n) ⟶ N` for first Koszul homology. -/
@[stacks 062E "low-degree model for first Koszul homology"]
def model : ShortComplex (ModuleCat R) :=
  ShortComplex.moduleCatMk (relationBoundary f N) (linearCombination f N)
    (linearCombination_comp_relationBoundary f N)

/-- The first homology object of the finite-family Koszul chain model. -/
@[stacks 062E "first Koszul homology"]
abbrev obj : ModuleCat R :=
  (model f N).homology

/-- The module of degree-one cycles, namely tuples with zero linear combination. -/
abbrev cycles : Submodule R (Fin n → N) :=
  LinearMap.ker (linearCombination f N)

/-- The explicit cycle equation is equivalent to membership in the cycle submodule. -/
theorem mem_cycles_iff (x : Fin n → N) :
    x ∈ cycles f N ↔ IsCycle f N x := sorry

/-- A member of the cycle submodule satisfies the explicit cycle equation. -/
theorem isCycle_of_mem {x : Fin n → N} (hx : x ∈ cycles f N) :
    IsCycle f N x := sorry

/-- The boundary map with codomain restricted to degree-one cycles. -/
abbrev boundary : (Fin n × Fin n → N) →ₗ[R] cycles f N :=
  (model f N).moduleCatToCycles

/-- The coordinates of a degree-one boundary are the expected trivial-relation sums. -/
@[simp]
theorem boundary_apply (x : Fin n × Fin n → N) (j : Fin n) :
    ((boundary f N x : cycles f N) : Fin n → N) j =
      ∑ i, f i • (x (i, j) - x (j, i)) := sorry

/-- The explicit quotient of degree-one cycles by trivial Koszul relations. -/
abbrev Presentation :=
  (model f N).moduleCatLeftHomologyData.H

/-- The canonical comparison from the first-homology object to its cycle-boundary quotient. -/
noncomputable abbrev presentationIso :
    obj f N ≅ ModuleCat.of R (Presentation f N) :=
  (model f N).moduleCatHomologyIso

end KoszulComplex.Homology.H1
