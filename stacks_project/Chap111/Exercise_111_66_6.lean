module

public import Mathlib.FieldTheory.IsAlgClosed.Basic
public import ReasLib.AlgebraicGeometry.Scheme.Variety.Curve.PicardRestriction
import StacksCheckRecall

/-!
# Kernel of Picard restriction away from a closed point
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.Curve

open ClosedPoint

/- Exercise 111.66.6 (1): for a smooth projective curve `X` over an algebraically closed
field `k` and a closed point `x`, the kernel of Picard restriction along
`U = X \ {x}` is the cyclic subgroup generated by the class of `𝒪_X(x)`. -/
@[stacks 0H8V]
#check (AlgebraicGeometry.Curve.picardPullback_ker_eq_zmultiples_closedPoint :
  ∀ {k : Type u} [Field k] [IsAlgClosed k]
    (X : SchemeOverField k) [Curve X] [Smooth X.hom] [Projective X.hom]
    (x : X.left) (hx : x ∈ closedPoints X.left),
    (Scheme.Hom.picardPullback (closedPointOpenComplement x hx).ι).ker =
      AddSubgroup.zmultiples
        (Scheme.Modules.picardClass (closedPointIdeal x hx).associatedSheaf))

/- Exercise 111.66.6 (2): the class of `𝒪_X(x)` has infinite order in `Pic(X)`, so the
kernel of Picard restriction to `X \ {x}` is infinite cyclic. -/
@[stacks 0H8V]
#check (AlgebraicGeometry.Curve.injective_zsmul_closedPointAssociatedSheaf :
  ∀ {k : Type u} [Field k] [IsAlgClosed k]
    (X : SchemeOverField k) [Curve X] [Smooth X.hom] [Projective X.hom]
    (x : X.left) (hx : x ∈ closedPoints X.left),
    Function.Injective
      (zmultiplesHom (X.left.PicardGroup)
        (Scheme.Modules.picardClass (closedPointIdeal x hx).associatedSheaf)))

/- A Picard class is trivial on `X \ {x}` if and only if it is an integer multiple of
the class of `𝒪_X(x)`. -/
#check (AlgebraicGeometry.Curve.mem_ker_picardPullback_closedPoint_iff :
  ∀ {k : Type u} [Field k] [IsAlgClosed k]
    (X : SchemeOverField k) [Curve X] [Smooth X.hom] [Projective X.hom]
    (x : X.left) (hx : x ∈ closedPoints X.left) (L : X.left.PicardGroup),
    Scheme.Hom.picardPullback (closedPointOpenComplement x hx).ι L = 0 ↔
      ∃ n : ℤ, L = n • Scheme.Modules.picardClass
        (closedPointIdeal x hx).associatedSheaf)

end AlgebraicGeometry.Curve
