module

public import Mathlib.AlgebraicGeometry.Noetherian
public import Mathlib.Topology.JacobsonSpace
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Free.Generated
public import ReasLib.AlgebraicGeometry.RingedSpace.Module.Coherent
public import ReasLib.AlgebraicGeometry.Scheme.Module.Cohomology
public import ReasLib.AlgebraicGeometry.Scheme.Module.Support

@[expose] public section

open AlgebraicGeometry CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Scheme.Modules.SingletonSupport

/-- A coherent module on a Noetherian scheme supported at one point has a closed support point. -/
theorem mem_closedPoints
    {X : Scheme.{u}} [IsNoetherian X] (ℱ : X.Modules) [ℱ.IsCoherent]
    (x : X) (hSupp : moduleSupport ℱ = {x}) :
    x ∈ closedPoints X := sorry

/-- A coherent module with singleton support has nonzero degree-zero cohomology. -/
theorem not_isZero_cohomology_zero
    {X : Scheme.{u}} [IsNoetherian X] (ℱ : X.Modules) [ℱ.IsCoherent]
    (x : X) (hSupp : moduleSupport ℱ = {x}) :
    ¬ IsZero (cohomology ℱ 0) := sorry

/-- A coherent module with singleton support is generated by global sections. -/
theorem isGloballyGenerated
    {X : Scheme.{u}} [IsNoetherian X] (ℱ : X.Modules) [ℱ.IsCoherent]
    (x : X) (hSupp : moduleSupport ℱ = {x}) :
    SheafOfModules.IsGloballyGenerated ℱ := sorry

/-- A coherent module with singleton support has vanishing positive-degree cohomology. -/
theorem isZero_cohomology_of_pos
    {X : Scheme.{u}} [IsNoetherian X] (ℱ : X.Modules) [ℱ.IsCoherent]
    (x : X) (hSupp : moduleSupport ℱ = {x}) (p : ℕ) (hp : 0 < p) :
    IsZero (cohomology ℱ p) := sorry

end AlgebraicGeometry.Scheme.Modules.SingletonSupport
