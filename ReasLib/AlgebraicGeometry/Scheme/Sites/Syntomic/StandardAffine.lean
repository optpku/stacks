module

public import ReasLib.AlgebraicGeometry.Scheme.Cover.AffineFamily.AffineOver
public import ReasLib.AlgebraicGeometry.Scheme.Cover.StandardSyntomic
public import ReasLib.AlgebraicGeometry.Scheme.Sites.Syntomic.Affine

/-!
# Standard affine presentations of the syntomic site

Finite standard syntomic charts generate a source-independent pretopology on
the affine slice.  It remains distinct from the canonical restricted syntomic
topology until a refinement theorem proves equality.
-/

@[expose] public section

open CategoryTheory

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme.Syntomic.StandardAffine

/-- A finite standard syntomic covering of the affine source scheme of `U`. -/
abbrev covering {S : Scheme.{u}} (U : S.AffineOver) :=
  StandardSyntomicCovering (AffineOver.obj U).left

/-- A presieve on an affine `S`-scheme is standard-syntomic-covering when it
is represented by a finite standard syntomic covering of its source scheme. -/
def presieve {S : Scheme.{u}} {U : S.AffineOver}
    (R : Presieve U) : Prop :=
  ∃ 𝒰 : covering U,
    R = AffineOver.ofAffineFamilyPresieve U 𝒰.toAffineFamily

/-- A finite standard syntomic covering presents a standard-syntomic-covering
presieve on the affine slice. -/
theorem presieve_of_cover
    {S : Scheme.{u}} {U : S.AffineOver} (𝒰 : covering U) :
    presieve
      (AffineOver.ofAffineFamilyPresieve U 𝒰.toAffineFamily) := sorry

/-- Singleton isomorphisms are standard-syntomic-covering presieves on affine
scheme slices. -/
theorem presieve_hasIsos {S : Scheme.{u}} :
    ∀ ⦃U V : S.AffineOver⦄ (f : V ⟶ U) [IsIso f],
      presieve (Presieve.singleton f) := sorry

/-- Standard syntomic covering presieves on affine scheme slices are stable
under pullback. -/
theorem presieve_pullbacks {S : Scheme.{u}} :
    ∀ ⦃U V : S.AffineOver⦄ (f : V ⟶ U) (R : Presieve U),
      presieve R →
        presieve (Presieve.pullbackArrows f R) := sorry

/-- Standard syntomic covering presieves on affine scheme slices are stable
under refinement. -/
theorem presieve_transitive {S : Scheme.{u}} :
    ∀ ⦃U : S.AffineOver⦄ (R : Presieve U)
      (Ti : ∀ ⦃V⦄ (f : V ⟶ U), R f → Presieve V),
      presieve R →
      (∀ ⦃V⦄ (f : V ⟶ U) (H : R f),
          presieve (Ti f H)) →
            presieve (Presieve.bind R Ti) := sorry

/-- The pretopology on affine schemes over `S` generated by finite standard syntomic
coverings. -/
def pretopology (S : Scheme.{u}) : Pretopology S.AffineOver :=
  { coverings := fun _ ↦ { R | presieve R }
    has_isos := presieve_hasIsos
    pullbacks := presieve_pullbacks
    transitive := presieve_transitive }

/-- A presieve belongs to the standard affine syntomic pretopology exactly
when it is represented by a finite standard syntomic covering. -/
@[simp]
theorem mem_pretopology_iff {S : Scheme.{u}} {U : S.AffineOver} {R : Presieve U} :
    R ∈ pretopology S U ↔ presieve R := sorry

/-- The Grothendieck topology generated by finite standard syntomic coverings
of affine schemes over `S`. -/
abbrev topology (S : Scheme.{u}) : GrothendieckTopology S.AffineOver :=
  (pretopology S).toGrothendieck

/-- Unfolding the standard affine syntomic topology recovers the Grothendieck
topology generated by its standard-cover pretopology. -/
theorem topology_def (S : Scheme.{u}) :
    topology S = (pretopology S).toGrothendieck := sorry

/-- Every standard syntomic covering presieve belongs to the canonical
restricted syntomic precoverage on the affine slice. -/
theorem presieve_mem
    {S : Scheme.{u}} {U : S.AffineOver} {R : Presieve U}
    (hR : presieve R) :
    R ∈ bigAffineSyntomicPrecoverage S U := sorry

end AlgebraicGeometry.Scheme.Syntomic.StandardAffine
