    (MonoidalClosed.ihomOf H K).obj ((MonoidalClosed.ihomOf H L).obj M) ≅
      (MonoidalClosed.ihomOf H (DerivedTensor.Right.obj K L)).obj M :=
  MonoidalClosed.InternalHomTensor.isoOf H K L M ≪≫
    MonoidalClosed.internalHomMapIsoOf H
      (DerivedTensor.Right.Monoidal.Model.objIsoTensor T K L) (Iso.refl M)

/-- The derived iterated internal-Hom isomorphism is specified by ambient transport along the
chosen tensor model. -/
@[stacks 01CN "derived internal-Hom tensor-source isomorphism specification"]
theorem isoOf_spec
    (H : MonoidalClosed (DerivedCategory C))
    (T : DerivedTensor.Right.Monoidal.Model (C := C))
    (K L M : DerivedCategory C) [DerivedTensor.Right.Has (C := C)] :
    isoOf H T K L M =
      MonoidalClosed.InternalHomTensor.isoOf H K L M ≪≫
        MonoidalClosed.internalHomMapIsoOf H
          (DerivedTensor.Right.Monoidal.Model.objIsoTensor T K L) (Iso.refl M) := rfl

/-- The derived iterated internal-Hom isomorphism is contravariantly natural in its left factor. -/
@[stacks 03EO "derived internal-Hom tensor-source left naturality"]
theorem isoOf_natural_left
    (H : MonoidalClosed (DerivedCategory C))
    (T : DerivedTensor.Right.Monoidal.Model (C := C))
    {K₁ K₂ L M : DerivedCategory C} (f : K₁ ⟶ K₂)
    [DerivedTensor.Right.Has (C := C)] :
    (MonoidalClosed.preOf H f).app ((MonoidalClosed.ihomOf H L).obj M) ≫
          (isoOf H T K₁ L M).hom =
      (isoOf H T K₂ L M).hom ≫
        (MonoidalClosed.preOf H ((DerivedTensor.Right.functor L).map f)).app M := by
  dsimp only [isoOf]
  simp only [Iso.trans_hom, MonoidalClosed.internalHomMapIsoOf_hom,
    Iso.refl_hom, MonoidalClosed.internalHomMapOf_pre, Category.assoc]
  rw [← Category.assoc, MonoidalClosed.InternalHomTensor.isoOf_natural_left H f,
    Category.assoc]
  rw [cancel_epi]
  rw [← MonoidalClosed.preOf_comp_app H (f ▷ L) (T.objIsoTensor K₁ L).hom M]
  rw [← MonoidalClosed.preOf_comp_app H (T.objIsoTensor K₂ L).hom
    ((DerivedTensor.Right.functor L).map f) M]
  rw [← MonoidalCategory.tensorHom_id]
  rw [T.objIsoTensor_naturality L f]

/-- The derived iterated internal-Hom isomorphism is contravariantly natural in its middle factor. -/
@[stacks 03EO "derived internal-Hom tensor-source middle naturality"]
theorem isoOf_natural_middle
    (H : MonoidalClosed (DerivedCategory C))
    (T : DerivedTensor.Right.Monoidal.Model (C := C))
    (K : DerivedCategory C) {L₁ L₂ M : DerivedCategory C} (f : L₁ ⟶ L₂)
    [DerivedTensor.Right.Has (C := C)] :
    (MonoidalClosed.ihomOf H K).map ((MonoidalClosed.preOf H f).app M) ≫
          (isoOf H T K L₁ M).hom =
      (isoOf H T K L₂ M).hom ≫
        (MonoidalClosed.preOf H ((tensorMapOf H T f).app K)).app M := by
  dsimp only [isoOf]
  simp only [Iso.trans_hom, MonoidalClosed.internalHomMapIsoOf_hom,
    Iso.refl_hom, MonoidalClosed.internalHomMapOf_pre, Category.assoc]
  rw [← Category.assoc, MonoidalClosed.InternalHomTensor.isoOf_natural_middle H K f,
    Category.assoc]
  rw [cancel_epi]
  rw [← MonoidalClosed.preOf_comp_app H (K ◁ f) (T.objIsoTensor K L₁).hom M]
  rw [← MonoidalClosed.preOf_comp_app H (T.objIsoTensor K L₂).hom
    ((tensorMapOf H T f).app K) M]
  rw [← MonoidalCategory.id_tensorHom]
  rw [tensorMapOf_objIsoTensor H T f K]

/-- The derived iterated internal-Hom isomorphism is covariantly natural in its target. -/
@[stacks 03EO "derived internal-Hom tensor-source target naturality"]
theorem isoOf_natural_right
    (H : MonoidalClosed (DerivedCategory C))
    (T : DerivedTensor.Right.Monoidal.Model (C := C))
    (K L : DerivedCategory C) {M₁ M₂ : DerivedCategory C} (f : M₁ ⟶ M₂)
    [DerivedTensor.Right.Has (C := C)] :
    (MonoidalClosed.ihomOf H K).map ((MonoidalClosed.ihomOf H L).map f) ≫
          (isoOf H T K L M₂).hom =
      (isoOf H T K L M₁).hom ≫
        (MonoidalClosed.ihomOf H (DerivedTensor.Right.obj K L)).map f := by
  dsimp only [isoOf]
  simp only [Iso.trans_hom, MonoidalClosed.internalHomMapIsoOf_hom,
    Iso.refl_hom, MonoidalClosed.internalHomMapOf_pre, Category.assoc]
  rw [← Category.assoc, MonoidalClosed.InternalHomTensor.isoOf_natural_right H K L f,
    Category.assoc]
  rw [cancel_epi]
  exact (MonoidalClosed.preOf_naturality H (T.objIsoTensor K L).hom f).symm

