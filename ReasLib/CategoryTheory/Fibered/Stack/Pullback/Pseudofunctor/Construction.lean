module

public import ReasLib.CategoryTheory.Bicategory.FullSubbicategory.Pseudofunctor
public import ReasLib.CategoryTheory.Fibered.CategoricalPullback.Stack
public import ReasLib.CategoryTheory.Fibered.Pullback.Pseudofunctor
public import ReasLib.CategoryTheory.Fibered.Stack.Over
import Mathlib.Tactic.CrossRefAttribute

/-!
# Construction of fixed-base pullback on stacks

The neutral fibred-category pullback pseudofunctor is precomposed with the forgetful
pseudofunctor from stacks and then lifted through the full subbicategory selected by the source
stack condition. This file owns the construction; its action and comparison computations are in
focused sibling leaves.
-/

@[expose] public section

noncomputable section

universe uC uD uS vC vD vS

namespace CategoryTheory

open Bicategory Limits ObjectProperty
open scoped Bicategory

variable {C : Type uC} {D : Type uD}
variable [Category.{vC} C] [Category.{vD} D]

namespace StackOver.Pullback

/-- The ambient-valued fixed-base pullback pseudofunctor on stacks: first forget the stack
condition and then apply the neutral fibred-category pullback pseudofunctor. -/
@[stacks 04WC "ambient fixed-base pullback pseudofunctor on stacks"]
noncomputable def ambient (K : GrothendieckTopology D) (u : C ⥤ D) :
    Pseudofunctor
      (StackOver.{uD, vD, uS, vS} K)
      (FiberedCategoryOver.{uC, vC,
        max uC (max uS vD), max vC vS} C) :=
  (StackOver.forget K).toPseudofunctor.comp
    (FiberedCategoryOver.Pullback.pseudofunctor u)

/-- Every object in the pullback image is a stack for the topology generated by the source
precoverage when `u` is continuous on the selected covering families. -/
@[stacks 04WC "precoverage stack closure under fixed-base pullback"]
theorem ambient.isStackOnPrecoverage
    (P : Precoverage C) (Q : Precoverage D) (u : C ⥤ D)
    [P.HasIsos] [P.HasPullbacks] [P.IsStableUnderBaseChange]
    [P.IsStableUnderComposition]
    [Functor.Precoverage.IsContinuous u P Q]
    (T : StackOver.{uD, vD, uS, vS} Q.toGrothendieck) :
    IsStack.OnSite.objectProperty P.toGrothendieck
      ((ambient Q.toGrothendieck u).obj T) := sorry

/-- Pullback as a pseudofunctor on stacks presented by source and target precoverages.  Its
non-Prop action is the neutral fibred-category pullback action. -/
@[stacks 04WC "pullback pseudofunctor for precoverage-presented stacks"]
noncomputable def pseudofunctorOfPrecoverage
    (P : Precoverage C) (Q : Precoverage D) (u : C ⥤ D)
    [P.HasIsos] [P.HasPullbacks] [P.IsStableUnderBaseChange]
    [P.IsStableUnderComposition]
    [Functor.Precoverage.IsContinuous u P Q] :
    Pseudofunctor
      (StackOver.{uD, vD, uS, vS} Q.toGrothendieck)
      (StackOver.{uC, vC,
        max uC (max uS vD), max vC vS} P.toGrothendieck) :=
  ObjectProperty.FullSubbicategory.liftPseudofunctor
    (ambient Q.toGrothendieck u) (ambient.isStackOnPrecoverage P Q u)

/-- Every object in the image of ambient fixed-base pullback satisfies the stack condition on
the source site. -/
@[stacks 04WC "stack closure under fixed-base pullback"]
theorem ambient.isStackOnSite
    (J : GrothendieckTopology C) (K : GrothendieckTopology D) (u : C ⥤ D)
    [HasPullbacks C] [PreservesLimitsOfShape WalkingCospan u] [u.IsContinuous J K]
    (T : StackOver.{uD, vD, uS, vS} K) :
    IsStack.OnSite.objectProperty J ((ambient K u).obj T) := sorry

/-- Pullback along `u` as the canonical pseudofunctor from stacks over `(D, K)` to stacks over
`(C, J)`. The construction is the full-subbicategory lift of `ambient K u`; continuity and
pullback preservation are used only for object closure. -/
@[stacks 04WC "fixed-base pullback pseudofunctor on stacks"]
noncomputable def pseudofunctor
    (J : GrothendieckTopology C) (K : GrothendieckTopology D) (u : C ⥤ D)
    [HasPullbacks C] [PreservesLimitsOfShape WalkingCospan u] [u.IsContinuous J K] :
    Pseudofunctor
      (StackOver.{uD, vD, uS, vS} K)
      (StackOver.{uC, vC,
        max uC (max uS vD), max vC vS} J) :=
  ObjectProperty.FullSubbicategory.liftPseudofunctor
    (ambient K u) (ambient.isStackOnSite J K u)

end StackOver.Pullback

namespace StackOver

/-- The stack obtained by pullback along a functor continuous for selected precoverages. -/
@[stacks 04WC "pullback of a precoverage-presented stack"]
noncomputable abbrev pullbackOfPrecoverage
    (P : Precoverage C) {Q : Precoverage D} (u : C ⥤ D)
    (T : StackOver.{uD, vD, uS, vS} Q.toGrothendieck)
    [P.HasIsos] [P.HasPullbacks] [P.IsStableUnderBaseChange]
    [P.IsStableUnderComposition]
    [Functor.Precoverage.IsContinuous u P Q] :
    StackOver.{uC, vC,
      max uC (max uS vD), max vC vS} P.toGrothendieck :=
  (Pullback.pseudofunctorOfPrecoverage P Q u).obj T

/-- Lemma 8.12.2 (tag 04WC): the bundled stack obtained by pulling a stack back along a
continuous pullback-preserving functor. This is the object action of the fixed-base pullback
pseudofunctor. -/
@[stacks 04WC]
noncomputable abbrev pullback
    {J : GrothendieckTopology C} {K : GrothendieckTopology D}
    (u : C ⥤ D) (T : StackOver.{uD, vD, uS, vS} K)
    [HasPullbacks C] [PreservesLimitsOfShape WalkingCospan u] [u.IsContinuous J K] :
    StackOver.{uC, vC, max uC (max uS vD), max vC vS} J :=
  (Pullback.pseudofunctor J K u).obj T

end StackOver

end CategoryTheory
