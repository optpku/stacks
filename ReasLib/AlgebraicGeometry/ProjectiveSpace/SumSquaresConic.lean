module

public import ReasLib.AlgebraicGeometry.ProjectiveSpace.Over
public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.IdealClosure
public import ReasLib.AlgebraicGeometry.Scheme.OverField
public import ReasLib.AlgebraicGeometry.Scheme.SpecialFiber

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.SumSquaresConic

variable (R : Type u) [CommRing R] (π : R)

/-- The homogeneous equation `T₁ ^ 2 + T₂ ^ 2 - π * T₀ ^ 2`. -/
def equation : MvPolynomial (Fin 3) R :=
  MvPolynomial.X 1 ^ 2 + MvPolynomial.X 2 ^ 2 -
    MvPolynomial.C π * MvPolynomial.X 0 ^ 2

/-- The principal ideal generated by the sum-of-squares equation is homogeneous. -/
theorem equationIdeal_homogeneous :
    (Ideal.span ({equation R π} : Set (MvPolynomial (Fin 3) R))).IsHomogeneous
      (ProjectiveSpace.grading R 2) := sorry

/-- The homogeneous principal ideal defining the sum-of-squares conic. -/
def equationIdeal : HomogeneousIdeal (ProjectiveSpace.grading R 2) where
  toSubmodule := Ideal.span {equation R π}
  is_homogeneous' := equationIdeal_homogeneous R π

/-- The underlying ideal of `equationIdeal R π` is generated by `equation R π`. -/
theorem equationIdeal_toIdeal :
    (equationIdeal R π).toIdeal =
      Ideal.span ({equation R π} : Set (MvPolynomial (Fin 3) R)) := rfl

/-- The homogeneous coordinate ring of the sum-of-squares conic. -/
abbrev coordinateRing := MvPolynomial (Fin 3) R ⧸ (equationIdeal R π).toIdeal

/-- The quotient grading on the homogeneous coordinate ring. -/
abbrev grading : ℕ → Submodule R (coordinateRing R π) :=
  GradedAlgebra.Quotient.grading (ProjectiveSpace.grading R 2) (equationIdeal R π).toIdeal

/-- The quotient decomposition equips the coordinate ring with its canonical grading. -/
instance grading_gradedAlgebra : GradedAlgebra (grading R π) :=
  GradedAlgebra.Quotient.gradedAlgebra (ProjectiveSpace.grading R 2)
    (equationIdeal R π).toIdeal (equationIdeal R π).isHomogeneous

/-- The concrete `Proj` model of the sum-of-squares conic. -/
abbrev model : Scheme := Proj (grading R π)

/-- The closed immersion of the conic into the projective plane. -/
def planeInclusion : model R π ⟶ ProjectiveSpace.scheme R 2 :=
  projQuotientMap (ProjectiveSpace.grading R 2) (equationIdeal R π)

/-- The structural morphism of the conic model over `Spec R`. -/
def toSpec : model R π ⟶ Spec (CommRingCat.of R) :=
  planeInclusion R π ≫ ProjectiveSpace.toSpec R 2

/-- The special fibre of the conic over the closed point of a local base. -/
abbrev specialFiber [IsLocalRing R] : Scheme :=
  (toSpec R π).fiber (IsLocalRing.closedPoint R)

/-- The special-fibre view is the canonical scheme-theoretic fibre. -/
theorem specialFiber_def [IsLocalRing R] :
    specialFiber R π = (toSpec R π).fiber (IsLocalRing.closedPoint R) := rfl

/-- The generic fibre after passing from a domain `R` to a fraction field `K`. -/
abbrev genericFiber (K : Type u) [IsDomain R] [Field K] [Algebra R K]
    [IsFractionRing R K] : SchemeOverField K :=
  Over.mk (pullback.snd (toSpec R π)
    (Spec.map (CommRingCat.ofHom (algebraMap R K))))

/-- The generic-fibre view is the canonical pullback to the fraction field. -/
theorem genericFiber_def (K : Type u) [IsDomain R] [Field K] [Algebra R K]
    [IsFractionRing R K] :
    genericFiber R π K = Over.mk (pullback.snd (toSpec R π)
      (Spec.map (CommRingCat.ofHom (algebraMap R K)))) := rfl

end AlgebraicGeometry.SumSquaresConic
