module

public import Mathlib.AlgebraicTopology.SimplicialObject.Basic
public import ReasLib.CategoryTheory.Sites.Product
import Mathlib.Tactic.CrossRefAttribute

/-!
# The simplicial site of a site

This file specializes the reusable product-site construction to the simplex category.
-/

@[expose] public section

open CategoryTheory

universe u v w x

namespace CategoryTheory.SimplicialSite

variable {C : Type u} [Category.{v} C]

/-- The projection from the simplicial indexing category times `C` to `C`. -/
@[stacks 09D1 "simplicial-site projection"]
abbrev projection : SimplexCategory × C ⥤ C :=
  ProductSite.projection SimplexCategory

/-- The precoverage generated by covering families in a fixed simplicial degree. -/
@[stacks 09D1 "simplicial precoverage"]
abbrev precoverage (J : Precoverage C) : Precoverage (SimplexCategory × C) :=
  J.onSnd SimplexCategory

/-- The Grothendieck topology generated by coverings in a fixed simplicial degree. -/
@[stacks 09D1 "simplicial site"]
abbrev topology (J : GrothendieckTopology C) : GrothendieckTopology (SimplexCategory × C) :=
  J.onSnd SimplexCategory

/-- The simplicial-site topology is the topology inherited along the projection to `C`. -/
@[stacks 09D1 "simplicial site as an inherited topology",
  stacks 06NU "simplicial site as an inherited topology"]
theorem topology_eq_inherited (J : GrothendieckTopology C) :
    topology J = projection.inheritedTopology J := sorry

/-- Uncurrying simplicial degree and site variables gives a presheaf on the simplicial site. -/
@[stacks 09D1 "simplicial-site presheaf functor"]
abbrev presheafFunctor (J : GrothendieckTopology C)
    (A : Type w) [Category.{x} A] :
    SimplicialObject (Sheaf J A) ⥤ (SimplexCategory × C)ᵒᵖ ⥤ A :=
  ProductSite.presheafFunctor SimplexCategory J A

/-- A simplicial sheaf is canonically a sheaf on the simplicial site. -/
@[stacks 09D1 "simplicial-site sheaf functor"]
abbrev sheafFunctor (J : GrothendieckTopology C)
    (A : Type w) [Category.{x} A] :
    SimplicialObject (Sheaf J A) ⥤ Sheaf (topology J) A :=
  ProductSite.sheafFunctor SimplexCategory J A

end CategoryTheory.SimplicialSite
