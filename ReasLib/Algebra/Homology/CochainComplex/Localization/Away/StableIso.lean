module

public import Mathlib.Algebra.Category.ModuleCat.ChangeOfRings
public import Mathlib.Algebra.Homology.HomotopyCofiber
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Spectrum.Prime.Basic
public import ReasLib.Algebra.Homology.DerivedCategory.Perfect
public import ReasLib.CategoryTheory.ObjectProperty.FiniteCoproductClosure
import Mathlib.Tactic.CrossRefAttribute

/-!
# Stable isomorphisms of localized perfect complexes

Two bounded finite-projective complexes representing the same derived object become isomorphic
after one away localization and after adding finite sums of elementary contractible disks.

@stack 0F9V
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits
open ComplexShape

universe u

namespace CategoryTheory.CochainComplex.LocalizationAwayStable

variable {R : Type u} [CommRing R]

/-- Degreewise extension of a cochain complex from `R` to the away localization `R_f`. -/
@[stacks 0F9V "Localization-away cochain complex"]
abbrev localized (f : R) (M : CochainComplex (ModuleCat R) ℤ) :
    CochainComplex (ModuleCat (Localization.Away f)) ℤ :=
  ((ModuleCat.extendScalars (algebraMap R (Localization.Away f))).mapHomologicalComplex
    (ComplexShape.up ℤ)).obj M

/-- The elementary contractible disk over `R_f` in consecutive degrees `n` and `n + 1`. -/
@[stacks 0F9V "Elementary localization-away disk"]
abbrev elementaryDisk (f : R) (n : ℤ) :
    CochainComplex (ModuleCat (Localization.Away f)) ℤ :=
  CochainComplex.mappingCone
    (𝟙 ((CochainComplex.singleFunctor (ModuleCat (Localization.Away f)) (n + 1)).obj
      (ModuleCat.of (Localization.Away f) (Localization.Away f))))

/-- The object property generated by elementary contractible disks over `R_f`. -/
@[stacks 0F9V "Elementary localization-away disk property"]
abbrev elementaryDiskProperty (f : R) :
    ObjectProperty (CochainComplex (ModuleCat (Localization.Away f)) ℤ) :=
  ObjectProperty.ofObj (elementaryDisk f)

/-- The closure of elementary disks under finite biproducts and isomorphisms. -/
@[stacks 0F9V "Finite sums of localization-away disks"]
abbrev finiteDiskSums (f : R) :
    ObjectProperty (CochainComplex (ModuleCat (Localization.Away f)) ℤ) :=
  (elementaryDiskProperty f).additiveClosure

/-- Lemma 15.76.8 (0F9V): derived-isomorphic bounded finite-projective complexes become strictly
stably isomorphic over some away localization. -/
@[stacks 0F9V "Stable isomorphism after away localization"]
theorem exists_stableIso
    (p : PrimeSpectrum R) {M N : CochainComplex (ModuleCat R) ℤ}
    (hM : M.IsBoundedFiniteProjective)
    (hN : N.IsBoundedFiniteProjective)
    (hMN : IsIsomorphic (DerivedCategory.Q.obj M) (DerivedCategory.Q.obj N)) :
    ∃ f : R, f ∉ p.asIdeal ∧
      ∃ P Q : CochainComplex (ModuleCat (Localization.Away f)) ℤ,
        finiteDiskSums f P ∧ finiteDiskSums f Q ∧
          IsIsomorphic (localized f M ⊞ P) (localized f N ⊞ Q) := sorry

end CategoryTheory.CochainComplex.LocalizationAwayStable
