module

public import ReasLib.AlgebraicGeometry.WeilCohomology.SchemeClassical

@[expose] public section

noncomputable section

universe u v w x y z

namespace WeilCohomology.SchemeClassicalTheory

open CategoryTheory

variable {k : Type u} [Field k]
variable {F : Type v} [Field F] [CharZero F]
variable {TateLine : Type w} [AddCommGroup TateLine] [Module F TateLine]
variable {V : Type w} [Category.{z} V]
variable {dimension : V → ℕ} {product : V → V → V}
variable {fst : ∀ X Y, product X Y ⟶ X} {snd : ∀ X Y, product X Y ⟶ Y}
variable {pt : V} {H : V → Type x} {CH : V → Type y}
variable [∀ X, Ring (H X)] [∀ X, Algebra F (H X)] [∀ X, CommRing (CH X)]
variable {Hgrade : ∀ X, ℤ → Submodule F (H X)}
variable {CHgrade : ∀ X, ℤ → Submodule ℤ (CH X)}
variable [∀ X, GradedAlgebra (Hgrade X)] [∀ X, GradedAlgebra (CHgrade X)]
variable {cyclePullback : ∀ {X Y : V},
  (X ⟶ Y) → CHgrade Y →ₐᵍ[ℤ] CHgrade X}
variable {cyclePushforward : ∀ {X Y : V}, (X ⟶ Y) → CH X →+ CH Y}

variable (T : SchemeClassicalTheory k F TateLine V dimension product fst snd pt
  H CH Hgrade CHgrade cyclePullback cyclePushforward)

namespace ZeroCycles

/-- The zero-cycle class obtained by pushing forward the fundamental class of a
represented object. -/
def pointClass
    (T : SchemeClassicalTheory k F TateLine V dimension product fst snd pt
      H CH Hgrade CHgrade cyclePullback cyclePushforward)
    {K X : V} (i : K ⟶ X) : CH X :=
  cyclePushforward i (1 : CHgrade K 0)

end ZeroCycles

/-- The subgroup generated by fundamental classes pushed forward from nonempty
zero-dimensional represented objects. -/
def zeroCycles (X : V) : AddSubgroup (CH X) :=
  AddSubgroup.closure
    {alpha | ∃ (K : V) (hK : T.IsNonemptyEquidimensional K 0) (i : K ⟶ X),
      alpha = ZeroCycles.pointClass T i}

namespace ZeroCycles

/-- A pushed-forward fundamental class from a nonempty zero-dimensional object
belongs to the subgroup of zero-cycles. -/
theorem pointClass_mem {K X : V} (hK : T.IsNonemptyEquidimensional K 0)
    (i : K ⟶ X) : pointClass T i ∈ T.zeroCycles X := sorry

/-- A represented zero-dimensional point as a bundled zero-cycle. -/
def point {K X : V} (hK : T.IsNonemptyEquidimensional K 0) (i : K ⟶ X) :
    T.zeroCycles X :=
  ⟨pointClass T i, pointClass_mem T hK i⟩

/-- Coercing a bundled represented point recovers its pushed-forward
fundamental class. -/
theorem point_coe {K X : V} (hK : T.IsNonemptyEquidimensional K 0) (i : K ⟶ X) :
    (point T hK i : CH X) = pointClass T i := sorry

/-- The cycle-class homomorphism restricted to the subgroup of zero-cycles. -/
def cycleClass (X : V) : T.zeroCycles X →+ H X :=
  (T.cycleClass X).comp (T.zeroCycles X).subtype

/-- The restricted cycle-class homomorphism agrees with the ambient cycle-class
homomorphism. -/
theorem cycleClass_apply (X : V) (alpha : T.zeroCycles X) :
    cycleClass T X alpha = T.cycleClass X alpha := sorry

end ZeroCycles

end WeilCohomology.SchemeClassicalTheory
