module

public import Mathlib.CategoryTheory.Triangulated.Functor
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.CategoryTheory.ObjectProperty.Map
public import ReasLib.CategoryTheory.Pretriangulated.Extension.Interval
public import ReasLib.CategoryTheory.Pretriangulated.Extension.Stage

@[expose] public section

/-!
# Functoriality of Extension Constructions

This leaf gives image-comparison maps for shifts, extension products, and
additive extension stages. Generic object-property mapping comparisons are
owned by `ReasLib.CategoryTheory.ObjectProperty.Map`.
-/

open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.Pretriangulated

universe v₁ v₂ u₁ u₂

namespace CategoryTheory.ObjectProperty

section

variable {C : Type u₁} [Category.{v₁} C] [HasShift C ℤ]
variable {D : Type u₂} [Category.{v₂} D] [HasShift D ℤ]
variable (F : C ⥤ D) [F.CommShift ℤ]

/-- Mapping commutes with a fixed shift for an isomorphism-closed object property. -/
theorem map_shift (P : ObjectProperty C) [P.IsClosedUnderIsomorphisms] (n : ℤ) :
    (P.shift n).map F = (P.map F).shift n := sorry

/-- A functor commuting with shifts maps bounded shift intervals exactly. -/
@[stacks 0FX5]
theorem map_shiftInterval (P : ObjectProperty C) [P.IsClosedUnderIsomorphisms] (a b : ℤ) :
    (P[a, b]).map F = (P.map F)[a, b] := sorry

/-- A functor commuting with shifts maps the bounded interval generated by an object exactly. -/
@[stacks 0FX5]
theorem map_objectShiftInterval (E : C) (a b : ℤ) :
    (objectShiftInterval E a b).map F = objectShiftInterval (F.obj E) a b := sorry

end

section

variable {C : Type u₁} [Category.{v₁} C] [HasZeroObject C] [Preadditive C] [HasShift C ℤ]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
variable {D : Type u₂} [Category.{v₂} D] [HasZeroObject D] [Preadditive D] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
variable (F : C ⥤ D) [F.CommShift ℤ] [Functor.IsTriangulated F]

/-- Mapping an extension product is contained in the extension product of the mapped properties. -/
@[stacks 0FX5]
theorem map_extensionProduct_le (P Q : ObjectProperty C) :
    (extensionProduct P Q).map F ≤ extensionProduct (P.map F) (Q.map F) := sorry

/-- Mapping an iterated extension product is contained in the corresponding iterated product of
the mapped property. -/
@[stacks 0FX5]
theorem map_extensionProductIter_le (P : ObjectProperty C) (n : ℕ) :
    (P.extensionProductIter n).map F ≤ (P.map F).extensionProductIter n := sorry

/-- Mapping a natural-number-indexed additive extension stage is contained in the corresponding
stage of the mapped object property. -/
@[stacks 0FX5]
theorem map_additiveExtensionStageNat_le (P : ObjectProperty C) (n : ℕ) :
    (additiveExtensionStageNat P n).map F ≤ additiveExtensionStageNat (P.map F) n := sorry

/-- Mapping a positive additive extension stage is contained in the corresponding stage of the
mapped object property. -/
@[stacks 0FX5]
theorem map_additiveExtensionStage_le (P : ObjectProperty C) (n : ℕ+) :
    (additiveExtensionStage P n).map F ≤ additiveExtensionStage (P.map F) n := sorry

end

end CategoryTheory.ObjectProperty
