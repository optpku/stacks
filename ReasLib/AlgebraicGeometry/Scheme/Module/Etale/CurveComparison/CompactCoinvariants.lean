module

public import ReasLib.AlgebraicGeometry.Scheme.Module.Etale.CurveComparison.CompactAbelian
public import Mathlib.Topology.Algebra.Module.ContinuousLinearMap.Quotient

@[expose] public section

open CategoryTheory CategoryTheory.Action.ModuleCat

noncomputable section

universe u

namespace CompactRepresentation

variable (Λ G : Type u) [CommRing Λ] [Finite Λ]
variable [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- The closed submodule generated by the ACTUAL action differences. -/
def relations (M : Cat Λ G) : Submodule Λ M.obj.V.toModule :=
  (Submodule.span Λ (Set.range (fun gx : G × M.obj.V.toModule ↦
    CompactModule.linear Λ (M.obj.ρ gx.1) gx.2 - gx.2))).topologicalClosure

/-- Actual continuous coinvariants: quotient by the closed span of g*x-x. -/
def coinvariants (M : Cat Λ G) : CompactModule Λ where
  toModule := ModuleCat.of Λ (M.obj.V.toModule ⧸ relations Λ G M)
  topology := inferInstance
  compact := by sorry
  t2 := by sorry
  topologicalAdd := by sorry
  scalarContinuous := by sorry

/-- The canonical continuous quotient projection. -/
def quotientMap (M : Cat Λ G) : M.obj.V ⟶ coinvariants Λ G M :=
  { toLinearMap := (relations Λ G M).mkQ
    cont := by sorry }

theorem map_relations {M N : Cat Λ G} (f : M ⟶ N) :
    relations Λ G M ≤ (relations Λ G N).comap (CompactModule.linear Λ f.hom.hom) := by sorry

/-- Functoriality is induced by the actual equivariant continuous linear map. -/
def coinvariantsMap {M N : Cat Λ G} (f : M ⟶ N) : coinvariants Λ G M ⟶ coinvariants Λ G N :=
  { toLinearMap := (relations Λ G M).mapQ (relations Λ G N)
      (CompactModule.linear Λ f.hom.hom) (map_relations Λ G f)
    cont := by sorry }

def coinvariantsFunctor : Cat Λ G ⥤ CompactModule Λ where
  obj := coinvariants Λ G
  map := coinvariantsMap Λ G
  map_id := by sorry
  map_comp := by sorry

instance : (coinvariantsFunctor Λ G).Additive := by
  constructor
  intros
  sorry

/-- Invariant-vector inclusion for the actual ambient invariants owner. -/
def invariantInclusion (M : DiscreteModuleCat Λ G) :
    ((CategoryTheory.Action.ModuleCat.DiscreteModuleCat.fixedPointsFunctor Λ G).obj M) →ₗ[Λ] M.obj.V :=
  Submodule.subtype _

/-- Restrict an actual character to invariant vectors. -/
def restriction (M : DiscreteModuleCat Λ G) :
    (dual Λ G M).obj.V.toModule →ₗ[Λ]
      (CompactModule.ofCharacter Λ ((CategoryTheory.Action.ModuleCat.DiscreteModuleCat.fixedPointsFunctor Λ G).obj M)).toModule :=
  CharacterModule.dual (invariantInclusion Λ G M)

/-- Restriction annihilates the closed relation submodule by continuity. -/
theorem relations_le_restriction_kernel (M : DiscreteModuleCat Λ G) :
    relations Λ G (dual Λ G M) ≤ LinearMap.ker (restriction Λ G M) := by sorry

/-- The degree-zero comparison is the actual quotient lift of character
restriction to invariants. -/
def coinvariantsToDualInvariants (M : DiscreteModuleCat Λ G) :
    coinvariants Λ G (dual Λ G M) ⟶
      CompactModule.ofCharacter Λ ((CategoryTheory.Action.ModuleCat.DiscreteModuleCat.fixedPointsFunctor Λ G).obj M) :=
  { toLinearMap := (relations Λ G (dual Λ G M)).liftQ
      (restriction Λ G M) (relations_le_restriction_kernel Λ G M)
    cont := by sorry }

/-- The annihilator theorem identifies the kernel exactly; restriction is
surjective because Q/Z is injective on discrete abelian groups. -/
theorem coinvariantsToDualInvariants_bijective (M : DiscreteModuleCat Λ G) :
    Function.Bijective (CompactModule.linear Λ (coinvariantsToDualInvariants Λ G M)) := by sorry

def coinvariantsToDualInvariantsEquiv (M : DiscreteModuleCat Λ G) :=
  LinearEquiv.ofBijective (CompactModule.linear Λ (coinvariantsToDualInvariants Λ G M))
    (coinvariantsToDualInvariants_bijective Λ G M)

theorem coinvariantsToDualInvariants_inverse_continuous (M : DiscreteModuleCat Λ G) :
    Continuous (coinvariantsToDualInvariantsEquiv Λ G M).symm := by sorry

def coinvariantsDualInvariantsIso (M : DiscreteModuleCat Λ G) :
    coinvariants Λ G (dual Λ G M) ≅
      CompactModule.ofCharacter Λ ((CategoryTheory.Action.ModuleCat.DiscreteModuleCat.fixedPointsFunctor Λ G).obj M) where
  hom := coinvariantsToDualInvariants Λ G M
  inv :=
    { toLinearMap := (coinvariantsToDualInvariantsEquiv Λ G M).symm.toLinearMap
      cont := coinvariantsToDualInvariants_inverse_continuous Λ G M }
  hom_inv_id := by sorry
  inv_hom_id := by sorry

/-- The specified comparison evaluates a quotient character on the specified
invariant vector, independent of any inverse choice. -/
theorem coinvariantsToDualInvariants_apply (M : DiscreteModuleCat Λ G)
    (χ : (dual Λ G M).obj.V.toModule)
    (m : (CategoryTheory.Action.ModuleCat.DiscreteModuleCat.fixedPointsFunctor Λ G).obj M) :
    (show CharacterModule _ from
      CompactModule.linear Λ (coinvariantsToDualInvariants Λ G M)
        ((relations Λ G (dual Λ G M)).mkQ χ)) m =
      (show CharacterModule M.obj.V from χ) (invariantInclusion Λ G M m) := rfl

end CompactRepresentation
