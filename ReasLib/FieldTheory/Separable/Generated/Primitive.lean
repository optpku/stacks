module

public import Mathlib.FieldTheory.PrimitiveElement
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.FieldTheory.Separable.Generated

@[expose] public section

/-!
# Separable Primitive Presentations of Finitely Generated Field Extensions

This module owns the reusable primitive-element presentation of a finitely generated separably
generated field extension.  In the algebraic interface, ``finitely generated'' is represented by
`Algebra.EssFiniteType`: a field of finite transcendence degree with finite algebraic residual
extension need not be finite type as an algebra, but is essentially finite type.  The source-facing
enumeration of a transcendence basis is separated from the intrinsic statement that the residual
finite separable extension has a primitive element.

@stack 030Q
-/

open scoped IntermediateField

universe u v

namespace IntermediateField

variable {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]

/-- Adjoining one element over the field generated by `S` gives the ambient field exactly when
adjoining that element to `S` over the original base does. -/
@[stacks 030Q "adjoin presentation bridge"]
theorem adjoin_adjoin_singleton_eq_top_iff
    (S : Set E) (x : E) :
    adjoin (adjoin F S) ({x} : Set E) = ⊤ ↔ adjoin F (S ∪ {x}) = ⊤ := sorry

end IntermediateField

namespace IsTranscendenceBasis

variable {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]

/-- Tag 030Q: a transcendence basis in an essentially finite type field extension can
be reindexed by `Fin (Cardinal.toNat (Algebra.trdeg k K))` without changing its generated field. -/
@[stacks 030Q "finite reindexing"]
theorem existsFinReindex
    [Algebra.EssFiniteType k K]
    {s : Set K} (hs : IsTranscendenceBasis k (Subtype.val : s → K)) :
    ∃ x : Fin (Cardinal.toNat (Algebra.trdeg k K)) → K,
      IsTranscendenceBasis k x ∧
        IntermediateField.adjoin k (Set.range x) = IntermediateField.adjoin k s := sorry

/-- A finitely generated field extension is finite-dimensional over the field generated by any
one of its transcendence bases. -/
@[stacks 030Q "finite dimension over a transcendence-basis field"]
theorem finiteDimensionalOverAdjoin
    [Algebra.EssFiniteType k K]
    {ι : Type*} {x : ι → K} (hx : IsTranscendenceBasis k x) :
    FiniteDimensional (IntermediateField.adjoin k (Set.range x)) K := sorry

/-- Tag 030Q: after fixing a transcendence basis of an essentially finite type extension whose
residual extension is separable, the ambient field is generated over that basis field by one
separable element. -/
@[stacks 030Q "primitive-element stage"]
theorem existsSeparablePrimitiveElement
    [Algebra.EssFiniteType k K]
    {ι : Type*} {x : ι → K}
    [Algebra.IsSeparable (IntermediateField.adjoin k (Set.range x)) K]
    (hx : IsTranscendenceBasis k x) :
    ∃ y : K,
      IntermediateField.adjoin (IntermediateField.adjoin k (Set.range x)) ({y} : Set K) = ⊤ ∧
        IsSeparable (IntermediateField.adjoin k (Set.range x)) y := sorry

end IsTranscendenceBasis

namespace Algebra.IsSeparablyGenerated

variable {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]

/-- Tag 030Q: an essentially finite type separably generated extension has a finite-indexed
transcendence basis whose residual extension is algebraic and separable. -/
@[stacks 030Q "finite-basis stage"]
theorem existsFinBasis
    [Algebra.EssFiniteType k K] [Algebra.IsSeparablyGenerated k K] :
    ∃ x : Fin (Cardinal.toNat (Algebra.trdeg k K)) → K,
      IsTranscendenceBasis k x ∧
        Algebra.IsSeparable (IntermediateField.adjoin k (Set.range x)) K := sorry

namespace Primitive

/-- Lemma 10.42.3 (Tag 030Q): a separably generated essentially finite type field extension has
a transcendence basis indexed by its finite transcendence degree and a separable primitive element
over the field generated by that basis. -/
@[stacks 030Q]
theorem existsFinPresentation
    [Algebra.EssFiniteType k K] [Algebra.IsSeparablyGenerated k K] :
    ∃ x : Fin (Cardinal.toNat (Algebra.trdeg k K)) → K,
      IsTranscendenceBasis k x ∧ ∃ y : K,
        IntermediateField.adjoin (IntermediateField.adjoin k (Set.range x)) ({y} : Set K) = ⊤ ∧
          IsSeparable (IntermediateField.adjoin k (Set.range x)) y := sorry

end Primitive

end Algebra.IsSeparablyGenerated
