module

public import Mathlib.Algebra.Homology.ShortComplex.ModuleCat
public import Mathlib.LinearAlgebra.StdBasis
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Sequence.Koszul.Family

@[expose] public section

/-!
# The relation module of a finite family

@stack 05ED

For `f : Fin n → R`, the relation module is generated by symbols `eᵢ` subject to
`f i • eⱼ = f j • eᵢ`. It maps canonically onto the ideal generated by `f`; its kernel is
the first relation module used by the low-degree Koszul exact sequence.
-/

noncomputable section

universe u

namespace KoszulComplex

open Module

variable {R : Type u} [CommRing R] {n : ℕ}

/-- The basic relation vector `f i • eⱼ - f j • eᵢ` in the free module on `Fin n`. -/
@[stacks 05ED "Koszul relation vector"]
def relationVector (f : Fin n → R) (ij : Fin n × Fin n) : Fin n → R :=
  f ij.1 • Pi.basisFun R (Fin n) ij.2 - f ij.2 • Pi.basisFun R (Fin n) ij.1

/-- The linear map whose range is generated by the basic relation vectors of `f`. -/
@[stacks 05ED "Koszul relation map"]
abbrev relationMap (f : Fin n → R) :
    (Fin n × Fin n → R) →ₗ[R] Fin n → R :=
  piEquiv (Fin n × Fin n) R (Fin n → R) (relationVector f)

/-- Evaluation of the relation map on a standard basis vector. -/
@[simp]
theorem relationMap_basis (f : Fin n → R) (i j : Fin n) :
    relationMap f (Pi.basisFun R (Fin n × Fin n) (i, j)) =
      f i • Pi.basisFun R (Fin n) j - f j • Pi.basisFun R (Fin n) i := sorry

/-- The submodule generated by the basic relations of `f`. -/
@[stacks 05ED "Koszul relation submodule"]
abbrev relations (f : Fin n → R) : Submodule R (Fin n → R) :=
  (relationMap f).range

/-- The module generated by `eᵢ` subject to the relations `f i • eⱼ = f j • eᵢ`. -/
@[stacks 05ED "module presented by Koszul relations"]
abbrev RelationModule (f : Fin n → R) :=
  (Fin n → R) ⧸ relations f

/-- The range of the linear form associated to `f` is the ideal spanned by its entries. -/
theorem range_linearForm (f : Fin n → R) :
    LinearMap.range (koszulLinearForm f) = Ideal.span (Set.range f) := sorry

/-- The linear-combination map from the free module on `Fin n` to the ideal generated by `f`. -/
@[stacks 05ED "free module map to the generated ideal"]
def freeToSpan (f : Fin n → R) :
    (Fin n → R) →ₗ[R] Ideal.span (Set.range f) :=
  (LinearEquiv.ofEq _ _ (range_linearForm f)).toLinearMap ∘ₗ
    (koszulLinearForm f).rangeRestrict

/-- The basic relations lie in the kernel of the linear-combination map. -/
theorem relations_le_ker_freeToSpan (f : Fin n → R) :
    relations f ≤ (freeToSpan f).ker := sorry

namespace RelationModule

/-- The canonical map from the relation module onto the ideal generated by `f`. -/
@[stacks 05ED "Koszul relation module maps onto the generated ideal"]
def toSpan (f : Fin n → R) : RelationModule f →ₗ[R] Ideal.span (Set.range f) :=
  (relations f).liftQ (freeToSpan f) (relations_le_ker_freeToSpan f)

/-- The canonical relation-module map is computed on a quotient representative by the
linear-combination map. -/
@[simp]
theorem toSpan_mk (f : Fin n → R) (x : Fin n → R) :
    toSpan f ((relations f).mkQ x) = freeToSpan f x := sorry

/-- The explicit linear combination of the generators belongs to their span. -/
theorem sum_mem_span (f : Fin n → R) (x : Fin n → R) :
    ∑ i, f i * x i ∈ Ideal.span (Set.range f) := sorry

/-- On a quotient representative, the relation-module map is the expected linear combination
of the generators. -/
@[stacks 05ED "relation-module map formula"]
theorem toSpan_mk_eq_sum (f : Fin n → R) (x : Fin n → R) :
    toSpan f ((relations f).mkQ x) = ⟨∑ i, f i * x i, sum_mem_span f x⟩ := sorry

/-- The kernel of the canonical map from the relation module to the generated ideal. -/
@[stacks 05ED "first Koszul relation kernel"]
abbrev kernel (f : Fin n → R) : Submodule R (RelationModule f) :=
  (toSpan f).ker

/-- The kernel-to-relation-module-to-generated-ideal short complex. -/
@[stacks 05ED "relation presentation short complex"]
abbrev shortComplex (f : Fin n → R) : CategoryTheory.ShortComplex (ModuleCat R) :=
  (toSpan f).shortComplexKer

/-- The canonical map from the relation module to the generated ideal is surjective. -/
theorem toSpan_surjective (f : Fin n → R) : Function.Surjective (toSpan f) := sorry

/-- The relation module, its kernel, and the ideal generated by `f`
form a short exact sequence. -/
@[stacks 05ED "relation presentation of a finitely generated ideal"]
theorem shortExact (f : Fin n → R) : (shortComplex f).ShortExact := sorry

/-- The ideal generated by `f` annihilates the kernel of the
relation-module presentation. -/
@[stacks 05ED "the generated ideal annihilates the relation kernel"]
theorem span_le_annihilator (f : Fin n → R) :
    Ideal.span (Set.range f) ≤ (kernel f).annihilator := sorry

end RelationModule
end KoszulComplex
