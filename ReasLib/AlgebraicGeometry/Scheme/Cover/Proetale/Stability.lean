module

public import Mathlib.AlgebraicGeometry.Sites.Proetale

/-!
# Stability of pro-étale covering families
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits

universe u v w

namespace AlgebraicGeometry.Scheme.Proetale

/-- A singleton family generated by an isomorphism is a pro-étale covering. -/
theorem cover_singleton_of_isIso {T T' : Scheme.{u}} (f : T' ⟶ T) [IsIso f] :
    Presieve.ofArrows (fun _ : Unit ↦ T') (fun _ ↦ f) ∈
      Scheme.proetalePrecoverage.coverings T := sorry

/-- Dependent indexed composition of pro-étale covering families is a
pro-étale covering. -/
theorem cover_comp {T : Scheme.{u}} {ι : Type v} {κ : ι → Type w}
    (X : ι → Over T) (Y : (i : ι) → κ i → Over (X i).left)
    (hX : Presieve.ofArrows (fun i ↦ (X i).left) (fun i ↦ (X i).hom) ∈
      Scheme.proetalePrecoverage.coverings T)
    (hY : ∀ i, Presieve.ofArrows (fun j ↦ (Y i j).left) (fun j ↦ (Y i j).hom) ∈
      Scheme.proetalePrecoverage.coverings (X i).left) :
    Presieve.ofArrows (fun p : Sigma κ ↦ (Y p.1 p.2).left)
      (fun p ↦ (Y p.1 p.2).hom ≫ (X p.1).hom) ∈
      Scheme.proetalePrecoverage.coverings T := sorry

/-- Pullback of a pro-étale covering family along any scheme morphism is a
pro-étale covering of the new base. -/
theorem cover_pullback {T T' : Scheme.{u}} {ι : Type v} (X : ι → Over T)
    (hX : Presieve.ofArrows (fun i ↦ (X i).left) (fun i ↦ (X i).hom) ∈
      Scheme.proetalePrecoverage.coverings T) (f : T' ⟶ T) :
    Presieve.ofArrows (fun i ↦ pullback (X i).hom f)
      (fun i ↦ pullback.snd (X i).hom f) ∈
      Scheme.proetalePrecoverage.coverings T' := sorry

end AlgebraicGeometry.Scheme.Proetale
