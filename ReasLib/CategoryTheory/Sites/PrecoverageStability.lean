module

public import Mathlib.CategoryTheory.Sites.Coverage
public import Mathlib.CategoryTheory.Sites.Finite
public import Mathlib.CategoryTheory.Sites.Sheafification
public import ReasLib.CategoryTheory.Sites.FiniteRefinement
public import ReasLib.CategoryTheory.Sites.Precoverage.Continuous

/-!
# Stability properties of precoverages

Classes and bridges for precoverages satisfying the literal Stacks-site axioms.

The canonical pullback condition is `HasFactoringPullbacks`: it concerns a
whole covering family and matches the pullback-compatibility field of
`Coverage`.  The strictly more presentation-dependent, per-arrow condition is
kept separately as `HasArrowFactoringPullbacks`.

These are strictly weaker than being a Grothendieck topology but stronger than
a bare precoverage.
-/

@[expose] public section

universe v u

namespace CategoryTheory

open Limits

variable {C : Type u} [Category.{v} C]

namespace Precoverage

variable (J : Precoverage C)

/-- A precoverage is stable under bind if composing a covering family with
covering families of each component yields a covering family. -/
class IsStableUnderBind : Prop where
  bind_mem : ∀ {U : C} {R : Presieve U}, R ∈ J U →
    ∀ (S : ∀ ⦃V⦄ (f : V ⟶ U), R f → Presieve V),
      (∀ ⦃V⦄ (f : V ⟶ U) (hf : R f), S f hf ∈ J V) →
        R.bind S ∈ J U

/-- A precoverage is stable under pullback arrows if pulling back a covering
family along any morphism yields a covering family. -/
class IsStableUnderPullbackArrows : Prop where
  -- Use mathlib's `Presieve.HasPullbacks` class: spelling the hypothesis out as an instance
  -- binder makes it a parametric local instance whose `R g` parameter has no forward
  -- dependencies, which Lean 4.32 rejects, and `pullbackArrows` needs it as an instance.
  pullbackArrows_mem : ∀ {U V : C} (f : V ⟶ U) {R : Presieve U} [R.HasPullbacks f],
    R ∈ J U → R.pullbackArrows f ∈ J V

/-- A precoverage has arrowwise factoring pullbacks if every member of a chosen
covering family admits a locally covering family of factorizations after base
change. This is stronger and more presentation-dependent than the canonical
family-level `HasFactoringPullbacks` condition. -/
class HasArrowFactoringPullbacks : Prop where
  exists_factoring : ∀ {U V : C} (f : V ⟶ U) {R : Presieve U},
    R ∈ J U → ∀ ⦃W⦄ (g : W ⟶ U), R g →
      ∃ (S : Presieve V), S ∈ J V ∧
        ∀ ⦃T⦄ (h : T ⟶ V), S h → ∃ (l : T ⟶ W), h ≫ f = l ≫ g

/-- A precoverage has factoring pullbacks if a pullback of every chosen cover is
refined by a chosen cover which factors through the original family. This is the
choice-free condition required to promote a precoverage to a `Coverage`. -/
class HasFactoringPullbacks : Prop where
  exists_factors : ∀ ⦃X Y : C⦄ (f : Y ⟶ X) ⦃S : Presieve X⦄, S ∈ J X →
    ∃ T ∈ J Y, T.FactorsThruAlong S f

/-- Chosen pullback families witness the canonical factoring-pullback condition. -/
instance instHasFactoringPullbacks (J : Precoverage C) [J.HasPullbacks]
    [J.IsStableUnderPullbackArrows] : J.HasFactoringPullbacks := sorry

namespace HasFactoringPullbacks

/-- Promote a precoverage with family-level factoring pullbacks to the canonical
`Coverage` owner. -/
def toCoverage (J : Precoverage C) [J.HasFactoringPullbacks] : Coverage C where
  toPrecoverage := J
  pullback _ _ f _ hS := HasFactoringPullbacks.exists_factors f hS

/-- The `Coverage` attached to a factoring precoverage generates its original
Grothendieck topology. -/
theorem toCoverage_toGrothendieck (J : Precoverage C) [J.HasFactoringPullbacks] :
    (toCoverage J).toGrothendieck = J.toGrothendieck := sorry

/-- Every generated covering sieve contains the sieve generated by one selected
covering family when the precoverage satisfies the literal Stacks-site axioms. -/
theorem exists_generate_le {J : Precoverage C} [J.HasIsos]
    [J.IsStableUnderBind] [J.HasFactoringPullbacks]
    {X : C} {S : Sieve X} (hS : S ∈ J.toGrothendieck X) :
    ∃ R ∈ J X, Sieve.generate R ≤ S := sorry

/-- The sheaf condition for the generated topology is equivalent to the sheaf
condition on the selected covering families. -/
theorem isSheaf_iff (J : Precoverage C) [J.HasFactoringPullbacks]
    (P : Cᵒᵖ ⥤ Type w) :
    Presieve.IsSheaf J.toGrothendieck P ↔
      ∀ {X : C} (R : Presieve X), R ∈ J X → Presieve.IsSheafFor P R := sorry

end HasFactoringPullbacks

end Precoverage

namespace Functor.Precoverage.IsContinuous

variable {D : Type u} [Category.{v} D]
variable {J : Precoverage C} {K : Precoverage D} {u : C ⥤ D}

/-- A functor continuous for selected covers is continuous for the generated
Grothendieck topologies under the literal Stacks-site axioms. -/
theorem toContinuous [J.HasPullbacks] [J.HasFactoringPullbacks]
    [K.HasFactoringPullbacks] (h : IsContinuous u J K) :
    Functor.IsContinuous u J.toGrothendieck K.toGrothendieck := sorry

end Functor.Precoverage.IsContinuous

namespace GrothendieckTopology

/-- Finite selected covering families satisfying the literal Stacks-site axioms
induce finite refinements for every covering sieve of the generated topology. -/
theorem finiteRefinement_of_finite {J : Precoverage C} [J.HasIsos]
    [J.IsStableUnderBind] [J.HasFactoringPullbacks]
    (hfinite : ∀ ⦃U : C⦄ ⦃R : Presieve U⦄, R ∈ J U → R ∈ Precoverage.finite C U)
    (U : C) :
    HasFiniteRefinement J.toGrothendieck U := sorry

end GrothendieckTopology

end CategoryTheory
