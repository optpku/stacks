module

public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.RingTheory.Length
public import Mathlib.RingTheory.LocalRing.ResidueField.Defs

/-!
# Determinant space of a finite-length module

This file gives the generator-and-relation presentation of the determinant
space associated to a finite-length module over a local ring.
-/

@[expose] public section

noncomputable section

universe u v w

namespace Module

namespace FiniteLengthDeterminant

variable (R : Type u) (M : Type v) [CommRing R] [IsLocalRing R]
variable [AddCommGroup M] [Module R M]

/-- The natural number indexing an admissible sequence for a finite-length module. -/
def length (hM : IsFiniteLength R M) : ℕ :=
  (fun _ : IsFiniteLength R M ↦ (Module.length R M).toNat) hM

/-- The finite-length hypothesis identifies `length R M hM` with `Module.length R M`. -/
theorem coe_length (hM : IsFiniteLength R M) :
    (length R M hM : ℕ∞) = Module.length R M := sorry

/-- The submodule generated by the entries strictly preceding `i`. -/
def prefixSpan {n : ℕ} (e : Fin n → M) (i : Fin n) : Submodule R M :=
  Submodule.span R (e '' Set.Iio i)

/-- An admissible sequence has each entry killed modulo the span of its predecessors by the
maximal ideal. -/
def IsAdmissible (hM : IsFiniteLength R M)
    (e : Fin (length R M hM) → M) : Prop :=
  ∀ i r, r ∈ IsLocalRing.maximalIdeal R → r • e i ∈ prefixSpan R M e i

/-- An admissible sequence representing a determinant symbol. -/
def Symbol (hM : IsFiniteLength R M) : Type v :=
  { e : Fin (length R M hM) → M // IsAdmissible R M hM e }

/-- The free residue-field module on admissible determinant symbols. -/
abbrev Free (hM : IsFiniteLength R M) :=
  Symbol R M hM →₀ IsLocalRing.ResidueField R

/-- Swap two entries of a finite sequence. -/
def swapEntries {n : ℕ} (e : Fin n → M) (i j : Fin n) : Fin n → M :=
  fun k ↦ if k = i then e j else if k = j then e i else e k

/-- The three families of admissible relations between determinant symbols. -/
inductive Relation (hM : IsFiniteLength R M) : Free R M hM → Prop
  /-- A symbol vanishes when one entry lies in the span of its predecessors. -/
  | zero (e : Symbol R M hM) (a : Fin (length R M hM))
      (ha : e.1 a ∈ prefixSpan R M e.1 a) :
      Relation hM (Finsupp.single e 1)
  /-- Replacing one entry up to a unit and earlier terms scales the symbol by its residue. -/
  | unitChange (e e' : Symbol R M hM) (a : Fin (length R M hM))
      (unit : Rˣ) (x : M)
      (hAway : ∀ i, i ≠ a → e.1 i = e'.1 i)
      (ha : e.1 a = (unit : R) • e'.1 a + x)
      (hx : x ∈ prefixSpan R M e.1 a) :
      Relation hM
        (Finsupp.single e 1 -
          IsLocalRing.residue R (unit : R) • Finsupp.single e' 1)
  /-- Swapping adjacent entries changes sign when the later entry satisfies the stronger
  admissibility condition. -/
  | swapAdjacent (e e' : Symbol R M hM)
      (previous next : Fin (length R M hM))
      (hnext : next.val = previous.val + 1)
      (hstrong : ∀ r, r ∈ IsLocalRing.maximalIdeal R →
        r • e.1 next ∈ prefixSpan R M e.1 previous)
      (hswap : e'.1 = swapEntries M e.1 previous next) :
      Relation hM (Finsupp.single e 1 + Finsupp.single e' 1)

/-- The residue-field submodule generated by the admissible relations. -/
def relationSubmodule (hM : IsFiniteLength R M) :
    Submodule (IsLocalRing.ResidueField R) (Free R M hM) :=
  Submodule.span (IsLocalRing.ResidueField R) {x | Relation R M hM x}

end FiniteLengthDeterminant

/-- The determinant space of a finite-length module, presented by admissible symbols and
relations. -/
abbrev FiniteLengthDeterminant
    (R : Type u) (M : Type v) [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] (hM : IsFiniteLength R M) :=
  FiniteLengthDeterminant.Free R M hM ⧸
    FiniteLengthDeterminant.relationSubmodule R M hM

namespace FiniteLengthDeterminant

variable (R : Type u) (M : Type v) [CommRing R] [IsLocalRing R]
variable [AddCommGroup M] [Module R M]

/-- The class of an admissible sequence in the determinant space. -/
def symbol (hM : IsFiniteLength R M) (e : Symbol R M hM) :
    Module.FiniteLengthDeterminant R M hM :=
  (relationSubmodule R M hM).mkQ (Finsupp.single e 1)

/-- A determinant symbol is zero when one entry belongs to the span of its predecessors. -/
theorem symbol_eq_zero_of_mem_prefix (hM : IsFiniteLength R M)
    (e : Symbol R M hM) (a : Fin (length R M hM))
    (ha : e.1 a ∈ prefixSpan R M e.1 a) :
    symbol R M hM e = 0 := sorry

/-- Replacing one entry up to a unit and earlier terms scales its determinant symbol by the
residue of that unit. -/
theorem symbol_unitChange (hM : IsFiniteLength R M)
    (e e' : Symbol R M hM) (a : Fin (length R M hM))
    (unit : Rˣ) (x : M)
    (hAway : ∀ i, i ≠ a → e.1 i = e'.1 i)
    (ha : e.1 a = (unit : R) • e'.1 a + x)
    (hx : x ∈ prefixSpan R M e.1 a) :
    symbol R M hM e =
      IsLocalRing.residue R (unit : R) • symbol R M hM e' := sorry

/-- Swapping adjacent entries changes the sign of a determinant symbol under the strengthened
admissibility condition. -/
theorem symbol_swapAdjacent (hM : IsFiniteLength R M)
    (e e' : Symbol R M hM)
    (previous next : Fin (length R M hM))
    (hnext : next.val = previous.val + 1)
    (hstrong : ∀ r, r ∈ IsLocalRing.maximalIdeal R →
      r • e.1 next ∈ prefixSpan R M e.1 previous)
    (hswap : e'.1 = swapEntries M e.1 previous next) :
    symbol R M hM e = -symbol R M hM e' := sorry

/-- A linear map killing each admissible relation kills their generated submodule. -/
theorem relationSubmodule_le_ker (hM : IsFiniteLength R M)
    {N : Type w} [AddCommGroup N] [Module (IsLocalRing.ResidueField R) N]
    (f : Free R M hM →ₗ[IsLocalRing.ResidueField R] N)
    (hf : ∀ x, Relation R M hM x → f x = 0) :
    relationSubmodule R M hM ≤ LinearMap.ker f := sorry

/-- Descend a linear map on the free symbol module that kills every admissible relation. -/
def lift (hM : IsFiniteLength R M)
    {N : Type w} [AddCommGroup N] [Module (IsLocalRing.ResidueField R) N]
    (f : Free R M hM →ₗ[IsLocalRing.ResidueField R] N)
    (hf : ∀ x, Relation R M hM x → f x = 0) :
    Module.FiniteLengthDeterminant R M hM →ₗ[IsLocalRing.ResidueField R] N :=
  (relationSubmodule R M hM).liftQ f (relationSubmodule_le_ker R M hM f hf)

/-- The descended linear map evaluates on a symbol through its defining free-module map. -/
theorem lift_symbol (hM : IsFiniteLength R M)
    {N : Type w} [AddCommGroup N] [Module (IsLocalRing.ResidueField R) N]
    (f : Free R M hM →ₗ[IsLocalRing.ResidueField R] N)
    (hf : ∀ x, Relation R M hM x → f x = 0) (e : Symbol R M hM) :
    lift R M hM f hf (symbol R M hM e) = f (Finsupp.single e 1) := sorry

/-- Linear maps out of the determinant space are equal when they agree on all symbols. -/
theorem hom_ext (hM : IsFiniteLength R M)
    {N : Type w} [AddCommGroup N] [Module (IsLocalRing.ResidueField R) N]
    {f g : Module.FiniteLengthDeterminant R M hM →ₗ[IsLocalRing.ResidueField R] N}
    (h : ∀ e : Symbol R M hM, f (symbol R M hM e) = g (symbol R M hM e)) :
    f = g := sorry

end FiniteLengthDeterminant

end Module
