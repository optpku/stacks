module

public import ReasLib.Algebra.Homology.CochainComplex.BerthelotOgus.Eta
public import ReasLib.Algebra.Homology.HomologicalComplex.CanonicalRows
public import ReasLib.Algebra.Homology.HomologicalComplex.ModIdeal
public import ReasLib.RingTheory.Ideal.Principal

/-!
# Reduction of the Berthelot-Ogus eta complex

This file constructs `eta f K` modulo the principal ideal `(f)` for a nonnegative cochain
complex.  The quotient complex is owned by `HomologicalComplex.ModIdeal`; this leaf supplies the
eta-specific operation of dividing a degree-`n` representative by its visible factor `f ^ n`
before reduction.  The resulting map lands canonically in the cycles, and hence in the homology,
of `K` modulo `(f)`.
@stack 0F7S
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open HomologicalComplex
open scoped nonZeroDivisors

noncomputable section

universe u v

namespace CochainComplex.BerthelotOgus.Nat
namespace Reduction

variable {A : Type u} [CommRing A]

/-- The reduction of `K` modulo the principal ideal generated by `f`. -/
def ambientComplex (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) :
    CochainComplex (ModuleCat.{v} (A ⧸ principalIdeal f)) ℕ :=
  HomologicalComplex.ModIdeal.complex (principalIdeal f) K

/-- Remark 15.96.5, tag `0F7S` (1): the termwise reduction
`eta f K / f * eta f K` over `A ⧸ (f)`. -/
@[stacks 0F7S "reduction of the Berthelot-Ogus eta complex"]
def complex (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) :
    CochainComplex (ModuleCat.{v} (A ⧸ principalIdeal f)) ℕ :=
  HomologicalComplex.ModIdeal.complex (principalIdeal f) (eta f K)

/-- The morphism on reduced eta complexes induced by a cochain map. -/
def map (f : A) {K L : CochainComplex (ModuleCat.{v} A) ℕ} (phi : K ⟶ L) :
    complex f K ⟶ complex f L :=
  HomologicalComplex.ModIdeal.map (principalIdeal f) (Nat.map f phi)

/-- Reduction of eta sends identity morphisms to identity morphisms. -/
@[simp]
theorem map_id (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) :
    map f (𝟙 K) = 𝟙 (complex f K) := sorry

/-- Reduction of eta preserves composition of cochain maps. -/
@[simp]
theorem map_comp (f : A) {K L M : CochainComplex (ModuleCat.{v} A) ℕ}
    (phi : K ⟶ L) (psi : L ⟶ M) : map f (phi ≫ psi) = map f phi ≫ map f psi := sorry

/-- The functor sending `K` to the reduction of `eta f K` modulo `(f)`. -/
def functor (f : A) :
    CochainComplex (ModuleCat.{v} A) ℕ ⥤
      CochainComplex (ModuleCat.{v} (A ⧸ principalIdeal f)) ℕ where
  obj K := complex f K
  map phi := map f phi
  map_id K := map_id f K
  map_comp phi psi := map_comp f phi psi

/-- A representative obtained by dividing an eta-term element by its visible factor `f ^ n`.
The range witness stored in the eta term supplies the representative directly. -/
noncomputable def divide
    (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) (n : ℕ) (x : term f K n) : K.X n :=
  Classical.choose (LinearMap.mem_range.mp x.2.1)

/-- Multiplying a divided representative by `f ^ n` recovers the eta-term element. -/
theorem divide_spec
    (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) (n : ℕ) (x : term f K n) :
    (f ^ n) • divide f K n x = x := sorry

/-- Under termwise torsion-freeness, `divide` is the unique representative with the required
`f ^ n` multiple. -/
theorem divide_unique
    (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) (n : ℕ)
    (hK : IsTermwiseTorsionFree f K) (x : term f K n) (y : K.X n)
    (hy : (f ^ n) • y = x) : divide f K n x = y := sorry

/-- Division of eta-term representatives preserves addition. -/
theorem divide_add
    (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) (n : ℕ)
    (hK : IsTermwiseTorsionFree f K) (x y : term f K n) :
    divide f K n (x + y) = divide f K n x + divide f K n y := sorry

/-- Division of eta-term representatives preserves scalar multiplication. -/
theorem divide_smul
    (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) (n : ℕ)
    (hK : IsTermwiseTorsionFree f K) (a : A) (x : term f K n) :
    divide f K n (a • x) = a • divide f K n x := sorry

/-- Division by the visible factor `f ^ n`, packaged as an `A`-linear map. -/
noncomputable def divideLinear
    (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) (n : ℕ)
    (hK : IsTermwiseTorsionFree f K) : term f K n →ₗ[A] K.X n where
  toFun := divide f K n
  map_add' := divide_add f K n hK
  map_smul' := divide_smul f K n hK

/-- Evaluation of `divideLinear` agrees with the chosen divided representative. -/
theorem divideLinear_apply
    (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) (n : ℕ)
    (hK : IsTermwiseTorsionFree f K) (x : term f K n) :
    divideLinear f K n hK x = divide f K n x := sorry

/-- The quotient-ring-linear map obtained by dividing eta representatives before reducing
modulo `(f)`. -/
noncomputable def quotientLinear
    (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) (n : ℕ)
    (hK : IsTermwiseTorsionFree f K) :
    (complex f K).X n →ₗ[A ⧸ principalIdeal f] (ambientComplex f K).X n :=
  LinearMap.IdealQuotient.map (divideLinear f K n hK) (principalIdeal f)

/-- On a quotient generator, the divided reduction map is represented by `divideLinear`. -/
theorem quotientLinear_mk
    (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) (n : ℕ)
    (hK : IsTermwiseTorsionFree f K) (x : term f K n) :
    quotientLinear f K n hK (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (divideLinear f K n hK x) := sorry

/-- The divided reduction map regarded as a morphism of quotient-ring modules. -/
noncomputable def quotientHom
    (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) (n : ℕ)
    (hK : IsTermwiseTorsionFree f K) :
    (complex f K).X n ⟶ (ambientComplex f K).X n :=
  ModuleCat.ofHom (quotientLinear f K n hK)

/-- The divided reduction map has zero composite with the next reduced differential. -/
theorem quotientHom_comp_d
    (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) (n : ℕ)
    (hK : IsTermwiseTorsionFree f K) :
    quotientHom f K n hK ≫ (ambientComplex f K).d n (n + 1) = 0 := sorry

/-- Remark 15.96.5, tag `0F7S` (2): dividing representatives induces the canonical map
`(eta f K)^n / f * (eta f K)^n ⟶ Z^n(K / fK)`. -/
@[stacks 0F7S "eta reduction maps to cycles modulo f"]
noncomputable def toCycles
    (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) (n : ℕ)
    (hK : IsTermwiseTorsionFree f K) :
    (complex f K).X n ⟶ (ambientComplex f K).cycles n :=
  (ambientComplex f K).liftCycles' (quotientHom f K n hK)
    (n + 1) (rel_succ n) (quotientHom_comp_d f K n hK)

/-- Remark 15.96.5, tag `0F7S` (3): the canonical comparison from a reduced eta term to
`H^n(K / fK)`. -/
@[stacks 0F7S "eta reduction maps to homology modulo f"]
noncomputable def toHomology
    (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) (n : ℕ)
    (hK : IsTermwiseTorsionFree f K) :
    (complex f K).X n ⟶ (ambientComplex f K).homology n :=
  toCycles f K n hK ≫ (ambientComplex f K).homologyπ n

/-- The degree-`n` boundary presentation asserted in Remark 15.96.5.  Its first map gives the
exact row from `B^(n + 1)` through the reduced eta term to cycles, while its second map lifts the
canonical inclusion `B^n ⟶ Z^n`.  Together with `HomologicalComplex.imageCyclesHomology`, this
identifies the remaining quotient with `H^n(K / fK)`. -/
def HasBoundaryPresentation
    (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) (n : ℕ)
    (hK : IsTermwiseTorsionFree f K) : Prop :=
  ∃ (s : image ((ambientComplex f K).d n (n + 1)) ⟶ (complex f K).X n)
      (s' : image ((ambientComplex f K).d ((ComplexShape.up ℕ).prev n) n) ⟶
        (complex f K).X n)
      (hs : s ≫ toCycles f K n hK = 0),
    (ShortComplex.mk s (toCycles f K n hK) hs).ShortExact ∧
      s' ≫ toCycles f K n hK =
        (ambientComplex f K).imageToCycles ((ComplexShape.up ℕ).prev n) n

/-- The reduced eta term admits the boundary presentation described by the source remark. -/
theorem hasBoundaryPresentation
    (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) (n : ℕ)
    (hK : IsTermwiseTorsionFree f K) : HasBoundaryPresentation f K n hK := sorry

/-- Remark 15.96.5, tag `0F7S` (4): for a nonzerodivisor `f` and a termwise
`f`-torsion-free complex, the reduced eta term has the exact boundary presentation whose
remaining quotient is the homology of `K / fK`. -/
@[stacks 0F7S "boundary presentation of the reduced eta complex"]
theorem hasBoundaryPresentation_of_nonZeroDivisor
    (f : A) (K : CochainComplex (ModuleCat.{v} A) ℕ) (n : ℕ)
    (hf : f ∈ nonZeroDivisors A) (hK : IsTermwiseTorsionFree f K) :
    HasBoundaryPresentation f K n hK := sorry

end Reduction
end CochainComplex.BerthelotOgus.Nat
