module

public import ReasLib.CategoryTheory.Sites.Point.Refinement.Saturation.Advance
public import ReasLib.CategoryTheory.Sites.Point.Refinement.Saturation.Tower.Basic

/-!
# Saturation towers generated by an advance

This leaf iterates a uniform one-step saturation advance and exposes the
computation rules needed by consumers of the resulting tower.
-/

@[expose] public section

open CategoryTheory Limits

universe u v q r r'

noncomputable section

namespace CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered
namespace OrderedRefinement
namespace Saturation
namespace Tower

variable {C : Type u} [Category.{v} C]
variable {ι : Type r} [Preorder ι]
variable {J : GrothendieckTopology C}
variable {S : ιᵒᵖ ⥤ C}
variable [LocallySmall.{q} C]
variable [EssentiallySmall.{q} ιᵒᵖ]
variable [HasColimitsOfShape (EssentiallySmallFiber.fiber S).Elementsᵒᵖ (Type q)]
variable {P : Cᵒᵖ ⥤ Type q}
variable {x y : (EssentiallySmallFiber.presheafFiber S).obj P}

/-- Iterate a uniform saturation advance from a specified initial stage. -/
noncomputable def ofAdvance
    (A₀ : Stage.{u, v, q, r, r'} (J := J) S P x y)
    (advance : Advance (J := J) (S := S) (P := P) (x := x) (y := y)) :
    Tower (J := J) (S := S) (P := P) (x := x) (y := y) where
  stage := Nat.rec A₀ (fun _ A => advance.next A)
  step := fun n => advance.hom (Nat.rec A₀ (fun _ A => advance.next A) n)
  realizes := fun n => advance.realizes (Nat.rec A₀ (fun _ A => advance.next A) n)

namespace ofAdvance

/-- A tower assembled from an advance starts at its supplied initial stage. -/
@[simp]
theorem stageZero
    (A₀ : Stage.{u, v, q, r, r'} (J := J) S P x y)
    (advance : Advance (J := J) (S := S) (P := P) (x := x) (y := y)) :
    (ofAdvance (J := J) A₀ advance).stage 0 = A₀ := sorry

/-- The successor stage is obtained by advancing the preceding stage. -/
@[simp]
theorem stageSucc
    (A₀ : Stage.{u, v, q, r, r'} (J := J) S P x y)
    (advance : Advance (J := J) (S := S) (P := P) (x := x) (y := y)) (n : ℕ) :
    (ofAdvance (J := J) A₀ advance).stage (n + 1) =
      advance.next ((ofAdvance (J := J) A₀ advance).stage n) := sorry

/-- The successor morphism is the advance morphism at the current stage. -/
@[simp]
theorem step
    (A₀ : Stage.{u, v, q, r, r'} (J := J) S P x y)
    (advance : Advance (J := J) (S := S) (P := P) (x := x) (y := y)) (n : ℕ) :
    (ofAdvance (J := J) A₀ advance).step n =
      advance.hom ((ofAdvance (J := J) A₀ advance).stage n) := sorry

/-- Every successor morphism realizes all requests at its source stage. -/
@[simp]
theorem stepRealizes
    (A₀ : Stage.{u, v, q, r, r'} (J := J) S P x y)
    (advance : Advance (J := J) (S := S) (P := P) (x := x) (y := y)) (n : ℕ) :
    ((ofAdvance (J := J) A₀ advance).step n).realizesAll := sorry

end ofAdvance

end Tower
end Saturation
end OrderedRefinement
end CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered
