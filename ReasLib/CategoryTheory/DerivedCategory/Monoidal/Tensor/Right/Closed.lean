/-- Equality form of middle-variable naturality for explicit derived internal-Hom composition. -/
@[reassoc, stacks 0A8J "derived internal-Hom composition middle naturality equation"]
theorem compOf_natural_middle_assoc
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    (K : DerivedCategory C) {L₁ L₂ : DerivedCategory C} (g : L₁ ⟶ L₂)
    (N : DerivedCategory C) [DerivedTensor.Right.Has (C := C)] :
