module

public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Data.Complex.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations

@[expose] public section

open AlgebraicGeometry CategoryTheory

noncomputable section

namespace AlgebraicGeometry.CubicNoSection

/-- The indeterminate `t` in `Polynomial ℂ`. -/
abbrev t : Polynomial ℂ := Polynomial.X

/-- The coordinate `x` as the first indeterminate of `MvPolynomial (Fin 2) (Polynomial ℂ)`. -/
abbrev x : MvPolynomial (Fin 2) (Polynomial ℂ) := MvPolynomial.X 0

/-- The coordinate `y` as the second indeterminate of `MvPolynomial (Fin 2) (Polynomial ℂ)`. -/
abbrev y : MvPolynomial (Fin 2) (Polynomial ℂ) := MvPolynomial.X 1

/-- The defining equation `1 + t * x ^ 3 + t ^ 2 * y ^ 3` in `(Polynomial ℂ)[x, y]`. -/
def definingPolynomial : MvPolynomial (Fin 2) (Polynomial ℂ) :=
  1 + MvPolynomial.C t * x ^ 3 + MvPolynomial.C (t ^ 2) * y ^ 3

/-- The principal ideal generated by `definingPolynomial`. -/
def coordinateIdeal : Ideal (MvPolynomial (Fin 2) (Polynomial ℂ)) :=
  Ideal.span {definingPolynomial}

/-- The coordinate ring `ℂ[x, y, t] / (1 + t * x ^ 3 + t ^ 2 * y ^ 3)`. -/
abbrev coordinateRing :=
  MvPolynomial (Fin 2) (Polynomial ℂ) ⧸ coordinateIdeal

/-- The base scheme `S = Spec (Polynomial ℂ)`. -/
abbrev base : Scheme := Spec (CommRingCat.of (Polynomial ℂ))

/-- The total space `X = Spec coordinateRing`. -/
abbrev totalSpace : Scheme := Spec (CommRingCat.of coordinateRing)

/-- The structure morphism `π : totalSpace ⟶ base` induced by `ℂ[t] → coordinateRing`. -/
def π : totalSpace ⟶ base :=
  Spec.map (CommRingCat.ofHom (algebraMap (Polynomial ℂ) coordinateRing))

/-- The image of `definingPolynomial` in `coordinateRing` is zero. -/
theorem mk_definingPolynomial :
    Ideal.Quotient.mk coordinateIdeal definingPolynomial = 0 := sorry

/-- No nonempty open of `base` admits a section of `π : totalSpace ⟶ base`. -/
theorem not_exists_nonempty_open_section :
    ¬ ∃ (U : base.Opens), Nonempty U ∧ ∃ σ : U.toScheme ⟶ totalSpace, σ ≫ π = U.ι := sorry

end AlgebraicGeometry.CubicNoSection
