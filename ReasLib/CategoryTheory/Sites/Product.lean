module

public import Mathlib.CategoryTheory.Functor.Currying
public import Mathlib.CategoryTheory.Sites.Continuous
public import Mathlib.CategoryTheory.Sites.CoverLifting
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import Mathlib.CategoryTheory.Sites.Sheaf
public import ReasLib.CategoryTheory.Fibered.InheritedTopology
import Mathlib.Tactic.CrossRefAttribute

/-!
# Product sites with coverings in the second factor

For an indexing category `I` and a site `(C, J)`, this file equips `I × C` with the topology
whose coverings keep the `I` coordinate fixed and are `J`-coverings in `C`.  It also packages
the canonical uncurrying functor from `Iᵒᵖ`-diagrams of sheaves to sheaves on this product site.
-/

@[expose] public section

open CategoryTheory

universe uI vI uC vC uA vA

namespace CategoryTheory

namespace Precoverage

variable {C : Type uC} [Category.{vC} C]

/-- The precoverage on `I × C` whose covering families are fixed in `I` and covering in `C`. -/
@[stacks 09D1 "coverings in the second factor"]
def onSnd (J : Precoverage C) (I : Type uI) [Category.{vI} I] : Precoverage (I × C) where
  coverings x :=
    { R |
        ∃ (ι : Type (max uC vC)) (U : ι → C) (f : ∀ i, U i ⟶ x.2),
          R = Presieve.ofArrows (fun i ↦ (x.1, U i)) (fun i ↦ (𝟙 x.1, f i)) ∧
            Presieve.ofArrows U f ∈ J x.2 }

/-- Membership in `J.onSnd I` is exactly a `J`-covering family with fixed first coordinate. -/
@[stacks 09D1 "coverings in the second factor membership"]
theorem mem_onSnd_iff (J : Precoverage C) (I : Type uI) [Category.{vI} I]
    {x : I × C} {R : Presieve x} :
    R ∈ (J.onSnd I) x ↔
      ∃ (ι : Type (max uC vC)) (U : ι → C) (f : ∀ i, U i ⟶ x.2),
        R = Presieve.ofArrows (fun i ↦ (x.1, U i)) (fun i ↦ (𝟙 x.1, f i)) ∧
          Presieve.ofArrows U f ∈ J x.2 := sorry

end Precoverage

namespace GrothendieckTopology

variable {C : Type uC} [Category.{vC} C]

/-- The topology on `I × C` generated by coverings in the second factor. -/
@[stacks 09D1 "topology in the second factor"]
def onSnd (J : GrothendieckTopology C) (I : Type uI) [Category.{vI} I] :
    GrothendieckTopology (I × C) :=
  (J.toPrecoverage.onSnd I).toGrothendieck

end GrothendieckTopology

namespace ProductSite

variable {C : Type uC} [Category.{vC} C]

/-- The projection from an indexing category times `C` to `C`. -/
@[stacks 09D1 "product-site projection"]
def projection (I : Type uI) [Category.{vI} I] : I × C ⥤ C :=
  Prod.snd I C

/-- The second projection is canonically a fibred functor. -/
@[stacks 06NU "product projection is fibered", instance]
theorem projection_isFibered (I : Type uI) [Category.{vI} I] :
    (projection (C := C) I).IsFibered := sorry

/-- The fixed-first-coordinate presentation generates the inherited topology of the second
projection.  The precoverages differ by allowing an isomorphism in the first coordinate, but
their generated Grothendieck topologies agree. -/
@[stacks 06NU "product-site topology is inherited"]
theorem topology_eq_inherited (I : Type uI) [Category.{vI} I]
    (J : GrothendieckTopology C) :
    J.onSnd I = (projection (C := C) I).inheritedTopology J := sorry

/-- The second projection is continuous for the topology generated in the second factor. -/
@[stacks 09D1 "second projection is continuous", instance]
theorem projection_isContinuous (I : Type uI) [Category.{vI} I]
    (J : GrothendieckTopology C) :
    (projection (C := C) I).IsContinuous (J.onSnd I) J := sorry

/-- The second projection is cocontinuous for the topology generated in the second factor. -/
@[stacks 09D1 "second projection is cocontinuous", instance]
theorem projection_isCocontinuous (I : Type uI) [Category.{vI} I]
    (J : GrothendieckTopology C) :
    (projection (C := C) I).IsCocontinuous (J.onSnd I) J := sorry

/-- Uncurrying an `Iᵒᵖ`-diagram of sheaves gives a presheaf on `I × C`. -/
@[stacks 09D1 "uncurried product-site presheaf functor"]
def presheafFunctor (I : Type uI) [Category.{vI} I]
    (J : GrothendieckTopology C) (A : Type uA) [Category.{vA} A] :
    (Iᵒᵖ ⥤ Sheaf J A) ⥤ (I × C)ᵒᵖ ⥤ A :=
  (Functor.whiskeringRight Iᵒᵖ (Sheaf J A) (Cᵒᵖ ⥤ A)).obj
      (sheafToPresheaf J A) ⋙
    Functor.uncurry ⋙
      (Functor.whiskeringLeft (I × C)ᵒᵖ (Iᵒᵖ × Cᵒᵖ) A).obj
        (CategoryTheory.prodOpEquiv (C := I) (D := C)).functor

/-- The uncurried presheaf of an `Iᵒᵖ`-diagram of sheaves is a sheaf for `J.onSnd I`. -/
@[stacks 09D1 "uncurried diagram is a sheaf"]
theorem presheafFunctor_obj_isSheaf (I : Type uI) [Category.{vI} I]
    (J : GrothendieckTopology C) (A : Type uA) [Category.{vA} A]
    (F : Iᵒᵖ ⥤ Sheaf J A) :
    Presheaf.IsSheaf (J.onSnd I) ((presheafFunctor I J A).obj F) := sorry

/-- Uncurrying gives a canonical functor from diagrams of sheaves to sheaves on the product
site with coverings in the second factor. -/
@[stacks 09D1 "uncurried diagram sheaf functor"]
def sheafFunctor (I : Type uI) [Category.{vI} I]
    (J : GrothendieckTopology C) (A : Type uA) [Category.{vA} A] :
    (Iᵒᵖ ⥤ Sheaf J A) ⥤ Sheaf (J.onSnd I) A :=
  ObjectProperty.lift (Presheaf.IsSheaf (J.onSnd I)) (presheafFunctor I J A)
    (presheafFunctor_obj_isSheaf I J A)

/-- Forgetting the bundled sheaf recovers the uncurried presheaf on objects. -/
@[stacks 09D1 "underlying uncurried product-site sheaf", simp]
theorem sheafFunctor_obj_val (I : Type uI) [Category.{vI} I]
    (J : GrothendieckTopology C) (A : Type uA) [Category.{vA} A]
    (F : Iᵒᵖ ⥤ Sheaf J A) :
    ((sheafFunctor I J A).obj F).1 = (presheafFunctor I J A).obj F := sorry

/-- Forgetting a morphism of bundled sheaves recovers the uncurried natural transformation. -/
@[stacks 09D1 "underlying uncurried product-site map", simp]
theorem sheafFunctor_map_val (I : Type uI) [Category.{vI} I]
    (J : GrothendieckTopology C) (A : Type uA) [Category.{vA} A]
    {F G : Iᵒᵖ ⥤ Sheaf J A} (α : F ⟶ G) :
    ((sheafFunctor I J A).map α).1 = (presheafFunctor I J A).map α := sorry

end ProductSite

end CategoryTheory
