module

public import Mathlib.Algebra.Homology.AlternatingConst
public import Mathlib.Algebra.Homology.ShortComplex.HomologicalComplex
public import Mathlib.Algebra.Homology.HomologicalComplexAbelian
public import Mathlib.Algebra.Category.Grp.Abelian
public import Mathlib.AlgebraicTopology.AlternatingFaceMapComplex
public import Mathlib.CategoryTheory.Abelian.GrothendieckAxioms.Sheaf
public import Mathlib.CategoryTheory.Sites.Abelian
public import ReasLib.CategoryTheory.Sites.Sheafification.FreeAbelian
import Mathlib.Tactic.CrossRefAttribute

/-!
# Homology of simplicial presheaves

This leaf packages the degreewise free-abelian sheaf complex and each of its homology sheaves as
functors on simplicial presheaves. Hypercovering and Cech applications specialize these functors.
-/

@[expose] public section

noncomputable section

universe w v u

namespace CategoryTheory.SimplicialPresheaf.Homology

open AlgebraicTopology
open Limits
open Opposite

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
variable [HasSheafify J AddCommGrpCat.{max w v}]

/-- The alternating-face-map complex of the degreewise free abelian sheaf generated by a
simplicial presheaf. -/
@[stacks 01GB "complex functor"]
abbrev complexFunctor :
    SimplicialObject (Cᵒᵖ ⥤ Type (max w v)) ⥤
      ChainComplex (Sheaf J AddCommGrpCat.{max w v}) ℕ :=
  (SimplicialObject.whiskering
      (Cᵒᵖ ⥤ Type (max w v)) (Sheaf J AddCommGrpCat.{max w v})).obj
      J.freeAbelianSheafFunctor ⋙
    alternatingFaceMapComplex (Sheaf J AddCommGrpCat.{max w v})

/-- Evaluating `complexFunctor` gives the alternating-face-map complex of the degreewise free
abelian sheaf. -/
@[simp]
theorem complexFunctor_obj
    (K : SimplicialObject (Cᵒᵖ ⥤ Type (max w v))) :
    (complexFunctor J).obj K =
      (alternatingFaceMapComplex (Sheaf J AddCommGrpCat.{max w v})).obj
        (K ⋙ J.freeAbelianSheafFunctor) := sorry

/-- The chain map assigned by `complexFunctor` is induced by applying the free abelian sheaf
functor degreewise. -/
@[simp]
theorem complexFunctor_map
    {K L : SimplicialObject (Cᵒᵖ ⥤ Type (max w v))} (f : K ⟶ L) :
    (complexFunctor J).map f =
      (alternatingFaceMapComplex (Sheaf J AddCommGrpCat.{max w v})).map
        (Functor.whiskerRight f J.freeAbelianSheafFunctor) := sorry

/-- Definition 25.4.1 (Tag 01GB): the degree-`n` homology sheaf functor of simplicial
presheaves. -/
@[stacks 01GB]
noncomputable abbrev functor (n : ℕ) :
    SimplicialObject (Cᵒᵖ ⥤ Type (max w v)) ⥤
      Sheaf J AddCommGrpCat.{max w v} :=
  complexFunctor J ⋙
    HomologicalComplex.homologyFunctor
      (Sheaf J AddCommGrpCat.{max w v}) (ComplexShape.down ℕ) n

/-- Evaluating the degree-`n` homology functor gives the homology of the associated complex. -/
@[simp]
theorem functor_obj
    (K : SimplicialObject (Cᵒᵖ ⥤ Type (max w v))) (n : ℕ) :
    (functor J n).obj K = ((complexFunctor J).obj K).homology n := sorry

/-- The degree-`n` homology functor maps a simplicial-presheaf morphism by the homology map of
its associated chain map. -/
@[simp]
theorem functor_map
    {K L : SimplicialObject (Cᵒᵖ ⥤ Type (max w v))} (f : K ⟶ L) (n : ℕ) :
    (functor J n).map f =
      HomologicalComplex.homologyMap ((complexFunctor J).map f) n := sorry

/-- The degree-zero homology isomorphism for the constant simplicial presheaf on `𝒢`. -/
noncomputable def constZeroIsoApp (𝒢 : Cᵒᵖ ⥤ Type (max w v)) :
    (functor J 0).obj
        ((SimplicialObject.const (Cᵒᵖ ⥤ Type (max w v))).obj 𝒢) ≅
      J.freeAbelianSheaf 𝒢 :=
  (HomologicalComplex.homologyFunctor
      (Sheaf J AddCommGrpCat.{max w v}) (ComplexShape.down ℕ) 0).mapIso
    ((alternatingFaceMapComplex (Sheaf J AddCommGrpCat.{max w v})).mapIso
      (Functor.constComp SimplexCategoryᵒᵖ 𝒢 J.freeAbelianSheafFunctor)) ≪≫
    (HomologicalComplex.homologyFunctor
      (Sheaf J AddCommGrpCat.{max w v}) (ComplexShape.down ℕ) 0).mapIso
      (alternatingFaceMapComplexConst.app (J.freeAbelianSheaf 𝒢)) ≪≫
    ChainComplex.alternatingConstHomologyZero (J.freeAbelianSheaf 𝒢)

/-- The degree-zero constant-object comparison is natural in the presheaf. -/
theorem constZeroIsoApp_naturality
    {𝒢 ℋ : Cᵒᵖ ⥤ Type (max w v)} (f : 𝒢 ⟶ ℋ) :
    (functor J 0).map
        ((SimplicialObject.const (Cᵒᵖ ⥤ Type (max w v))).map f) ≫
        (constZeroIsoApp J ℋ).hom =
      (constZeroIsoApp J 𝒢).hom ≫ (J.freeAbelianSheafFunctor).map f := sorry

/-- The degree-zero homology of the constant simplicial-presheaf functor is naturally
isomorphic to the free abelian sheaf functor. -/
@[stacks 01GB "constant degree zero"]
noncomputable def constZeroIso :
    SimplicialObject.const (Cᵒᵖ ⥤ Type (max w v)) ⋙ functor J 0 ≅
      J.freeAbelianSheafFunctor :=
  NatIso.ofComponents (constZeroIsoApp J) (fun f => constZeroIsoApp_naturality J f)

/-- The component of `constZeroIso` is the canonical degree-zero constant-object comparison. -/
@[simp]
theorem constZeroIso_app (𝒢 : Cᵒᵖ ⥤ Type (max w v)) :
    (constZeroIso J).app 𝒢 = constZeroIsoApp J 𝒢 := sorry

end CategoryTheory.SimplicialPresheaf.Homology

/- The only deferred obligation in `constZeroIso` is the naturality law of its explicitly
constructed objectwise isomorphisms. -/
