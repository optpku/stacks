module

public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Ideal.Regularity
public import ReasLib.RingTheory.Sequence.QuasiRegular.Regularity

/-!
# Zariski-Local Quasi-Regular Ideals

@stack 07CV
@stack 07CW

This leaf owns the local ideal predicate defined by quasi-regular generating
families on principal opens, together with its position in the regularity
hierarchy.
-/

@[expose] public section

universe u

open RingTheory.Sequence

namespace Ideal

variable {R : Type u} [CommRing R]

/-- Definition 15.32.1 (4), tag `07CV`: an ideal
is quasi-regular when near every prime that contains it, it is generated by a
finite quasi-regular sequence on a principal open. -/
@[stacks 07CV "Definition 15.32.1 (4), quasi-regular ideals"]
def IsQuasiRegularIdeal (I : Ideal R) : Prop :=
  IsGeneratedByFiniteAwaySequence I
    (fun g {_} f ↦ IsQuasiRegular (Localization.Away g) (List.ofFn f))

/-- The principal-open finite-family criterion for a quasi-regular ideal. -/
@[stacks 07CV "principal-open criterion for quasi-regular ideals"]
theorem isQuasiRegularIdeal_iff (I : Ideal R) :
    I.IsQuasiRegularIdeal ↔
      ∀ p : Ideal R, p.IsPrime → I ≤ p →
        ∃ g : R, g ∉ p ∧ ∃ r : ℕ, ∃ f : Fin r → Localization.Away g,
          IsQuasiRegular (Localization.Away g) (List.ofFn f) ∧
            Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f) := sorry

namespace IsQuasiRegularIdeal

/-- Lemma 15.32.2, tag `07CW`: a quasi-regular ideal is finitely generated. -/
@[stacks 07CW "quasi-regular ideals are finitely generated"]
theorem fg {I : Ideal R} (hI : I.IsQuasiRegularIdeal) : I.FG := sorry

end IsQuasiRegularIdeal

namespace IsH1RegularIdeal

/-- An `H1`-regular ideal is quasi-regular. -/
@[stacks 07CV "H1-regular ideals are quasi-regular"]
theorem isQuasiRegular {I : Ideal R} (hI : I.IsH1RegularIdeal) :
    I.IsQuasiRegularIdeal := sorry

end IsH1RegularIdeal

namespace IsKoszulRegularIdeal

/-- A Koszul-regular ideal is quasi-regular. -/
@[stacks 07CV "Koszul-regular ideals are quasi-regular"]
theorem isQuasiRegular {I : Ideal R} (hI : I.IsKoszulRegularIdeal) :
    I.IsQuasiRegularIdeal := sorry

end IsKoszulRegularIdeal

end Ideal
