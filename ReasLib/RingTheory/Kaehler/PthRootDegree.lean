module

public import Mathlib.Algebra.Field.ZMod
public import Mathlib.FieldTheory.Relrank
public import Mathlib.LinearAlgebra.LinearIndependent.Lemmas
public import ReasLib.RingTheory.Kaehler.Frobenius
import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Degrees of extensions generated by p-th roots

@stack 07DZ

Linear independence of absolute Kahler differentials detects the degree contributed by a finite
family of chosen `p`-th roots.
-/

universe u v

namespace KaehlerDifferential.Frobenius

variable {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]
variable {p n : ℕ} [Fact p.Prime] [CharP k p] [Algebra (ZMod p) k]

/-- Lemma 10.158.3: adjoining chosen `p`-th roots of elements with linearly independent absolute
differentials gives an extension of relative degree `p ^ n`. -/
@[stacks 07DZ "degree of an independent p-th-root extension"]
theorem relfinrank_adjoin_pthRoots_eq_pow
    (a : Fin n → k) (roots : Fin n → K)
    (hroots : ∀ i, roots i ^ p = algebraMap k K (a i))
    (hd : LinearIndependent k (fun i ↦ KaehlerDifferential.D (ZMod p) k (a i))) :
    (⊥ : IntermediateField k K).relfinrank (IntermediateField.adjoin k (Set.range roots)) =
      p ^ n := sorry

end KaehlerDifferential.Frobenius
