module

public import Mathlib.LinearAlgebra.TensorProduct.Quotient
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Ideal.OfList

/-!
# Tensor Base Change of List Quotients

Mathlib provides the quotient/base-change equivalence for an arbitrary ideal.
This leaf exposes the list-generated specialization used by regular-sequence
and associated-graded constructions, without making either subject own a
second copy of the same quotient model.
-/

@[expose] public section

open scoped TensorProduct

universe u v w

namespace TensorProduct

variable {R : Type u} [CommRing R]
variable {S : Type v} [CommRing S] [Algebra R S]
variable {M : Type w} [AddCommGroup M] [Module R M]

/-- Mathlib's ideal-level tensor quotient equivalence sends the class of a pure tensor to the
pure tensor of its quotient class. -/
@[stacks 00DV "tensor quotient on pure tensors"]
theorem tensorQuotMapSMulEquivTensorQuot_apply_mk_tmul
    (I : Ideal R) (s : S) (m : M) :
    TensorProduct.tensorQuotMapSMulEquivTensorQuot M S I
      (Submodule.Quotient.mk (s ⊗ₜ[R] m)) =
        s ⊗ₜ[R] (Submodule.Quotient.mk m : M ⧸ (I • (⊤ : Submodule R M))) := sorry

/-- Tensor base change commutes with quotienting a module by the submodule generated by a list. -/
@[stacks 00DV "tensor quotient by a mapped list"]
noncomputable def ofListQuotientEquiv (rs : List R) :
    ((S ⊗[R] M) ⧸
      (Ideal.ofList (rs.map (algebraMap R S)) • (⊤ : Submodule S (S ⊗[R] M)))) ≃ₗ[S]
        S ⊗[R] (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) :=
    (Submodule.quotEquivOfEq _ _ (by rw [Ideal.map_ofList])).trans
    (TensorProduct.tensorQuotMapSMulEquivTensorQuot M S (Ideal.ofList rs))

/-- `ofListQuotientEquiv` sends a quotient class of a pure tensor to the corresponding
pure tensor of its source quotient class. -/
@[stacks 00DV "tensor quotient by a mapped list on pure tensors"]
theorem ofListQuotientEquiv_apply_mk_tmul
    (rs : List R) (s : S) (m : M) :
    ofListQuotientEquiv (R := R) (M := M) (S := S) rs
      (Submodule.Quotient.mk (s ⊗ₜ[R] m)) =
        s ⊗ₜ[R] (Submodule.Quotient.mk m :
          M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) := sorry

/-- The inverse of `ofListQuotientEquiv` sends a pure tensor of a source quotient class to the
class of the corresponding pure tensor. -/
@[stacks 00DV "inverse tensor quotient by a mapped list on pure tensors"]
theorem ofListQuotientEquiv_symm_apply_tmul_mk
    (rs : List R) (s : S) (m : M) :
    (ofListQuotientEquiv (R := R) (M := M) (S := S) rs).symm
      (s ⊗ₜ[R] (Submodule.Quotient.mk m :
        M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M)))) =
      Submodule.Quotient.mk (s ⊗ₜ[R] m) := sorry

end TensorProduct
