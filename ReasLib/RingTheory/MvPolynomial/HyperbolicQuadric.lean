module

public import Mathlib.Algebra.Algebra.Equiv
public import Mathlib.Algebra.Field.Defs
public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# The hyperbolic quadric coordinate ring

This file defines the coordinate ring of the hypersurface cut out by
`X 0 * X 1 + X 2 * X 3 + X 4 * X 5` and records its basic coordinate relation.
-/

@[expose] public section

noncomputable section

open MvPolynomial

universe u

namespace HyperbolicQuadric

/-- The polynomial defining the six-variable hyperbolic quadric. -/
def equation (k : Type u) [Field k] : MvPolynomial (Fin 6) k :=
  X 0 * X 1 + X 2 * X 3 + X 4 * X 5

/-- The defining polynomial has its displayed six-variable expression. -/
theorem equation_def (k : Type u) [Field k] :
    equation k = X 0 * X 1 + X 2 * X 3 + X 4 * X 5 := rfl

/-- The principal ideal generated by the hyperbolic quadric equation. -/
def ideal (k : Type u) [Field k] : Ideal (MvPolynomial (Fin 6) k) :=
  Ideal.span {equation k}

/-- The defining ideal is the span of the defining polynomial. -/
theorem ideal_span (k : Type u) [Field k] :
    ideal k = Ideal.span {equation k} := rfl

/-- The coordinate ring of the six-variable hyperbolic quadric. -/
abbrev CoordinateRing (k : Type u) [Field k] : Type u :=
  MvPolynomial (Fin 6) k ⧸ ideal k

/-- The coordinate ring is the quotient by the defining ideal. -/
theorem coordinateRing_eq (k : Type u) [Field k] :
    CoordinateRing k = (MvPolynomial (Fin 6) k ⧸ ideal k) := rfl

/-- The class of a polynomial coordinate in the hyperbolic quadric coordinate ring. -/
def coord (k : Type u) [Field k] (i : Fin 6) : CoordinateRing k :=
  Ideal.Quotient.mk (ideal k) (X i)

/-- The coordinate class is the quotient image of the corresponding polynomial variable. -/
theorem coord_eq_mk (k : Type u) [Field k] (i : Fin 6) :
    coord k i = Ideal.Quotient.mk (ideal k) (X i) := rfl

/-- The defining equation maps to zero in the coordinate ring. -/
theorem mk_equation_eq_zero (k : Type u) [Field k] :
    Ideal.Quotient.mk (ideal k) (equation k) = 0 := sorry

/-- The coordinate classes satisfy the defining quadratic relation. -/
theorem sum_coord_mul_eq_zero (k : Type u) [Field k] :
    coord k 0 * coord k 1 + coord k 2 * coord k 3 + coord k 4 * coord k 5 = 0 := sorry

/-- The hyperbolic quadric coordinate ring is not the polynomial algebra on five variables. -/
theorem not_algEquiv_mvPolynomial_five (k : Type u) [Field k] :
    ¬ Nonempty (CoordinateRing k ≃ₐ[k] MvPolynomial (Fin 5) k) := sorry

/-- The hyperbolic quadric coordinate ring is not the polynomial algebra on six variables. -/
theorem not_algEquiv_mvPolynomial_six (k : Type u) [Field k] :
    ¬ Nonempty (CoordinateRing k ≃ₐ[k] MvPolynomial (Fin 6) k) := sorry

end HyperbolicQuadric
