module

public import Mathlib.RingTheory.DiscreteValuationRing.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import Mathlib.RingTheory.LocalRing.ResidueField.Basic
public import ReasLib.RingTheory.Completion.LocalRing

@[expose] public section

/-!
# Cohen Rings

A Cohen ring is a complete discrete valuation ring whose maximal ideal is generated by the
image of a prime natural number.

## Main definitions

* `IsCohenRing` — a complete DVR with maximal ideal generated by a prime.

@stack 0327
-/

universe u

open Ideal IsLocalRing Ideal.Quotient

section

variable (R : Type u) [CommRing R]

/-- Definition 10.160.5: a Cohen ring is a complete discrete valuation ring whose maximal ideal
is generated by the residue characteristic. -/
@[stacks 0327]
class IsCohenRing : Prop extends IsDomain R, IsDiscreteValuationRing R, IsCompleteLocalRing R where
  /-- The maximal ideal equals the span of the residue characteristic. -/
  maximalIdeal_eq_span_residueChar :
    maximalIdeal R = Ideal.span {(ringChar (ResidueField R) : R)}

end

namespace IsCohenRing

/-- The defining domain, discrete-valuation, completeness, and uniformizer conditions of a
Cohen ring. -/
@[stacks 0327 "Cohen ring specification"]
theorem spec (R : Type u) [CommRing R] [IsCohenRing R] :
    IsDomain R ∧ IsDiscreteValuationRing R ∧ IsCompleteLocalRing R ∧
      maximalIdeal R = Ideal.span {(ringChar (ResidueField R) : R)} := sorry

end IsCohenRing
