module

public import ReasLib.Algebra.Homology.DerivedCategory.InternalHom.Model.RHom.Cohomology.Closed
public import ReasLib.Algebra.Homology.DerivedCategory.InternalHom.Model.RHom.Closed.Bifunctor.Model
import Mathlib.Tactic.CrossRefAttribute

/-!
# Agreement of pointwise and coherent RHom cohomology comparisons

An honest bifunctor comparison and an explicit tensor model determine a pointwise
`RHom.ClosedComparison`.  This leaf records that the cohomology equivalence obtained through that
pointwise view is the original coherent bifunctor equivalence.  It also exposes the specialization
where both views are generated by one parametrized tensor-`RHom` adjunction.
@stack 0E1U
-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory

namespace CategoryTheory.DerivedCategory.InternalHom.RHom.Cohomology

variable {A : Type u} [CommRing A]
variable [MonoidalCategory (DerivedCategory (ModuleCat.{u} A))]
variable [BraidedCategory (DerivedCategory (ModuleCat.{u} A))]
variable [RHom.Has (A := A)]

/-- The pointwise cohomology equivalence reconstructed from a coherent bifunctor comparison is
the coherent cohomology equivalence itself. -/
@[simp, stacks 0E1U "pointwise and coherent RHom cohomology agree"]
theorem linearEquiv_toClosedComparison_eq_bifunctor
    (M : RHom.BifunctorComparison (A := A))
    (T : DerivedTensor.Right.Monoidal.Model (C := ModuleCat.{u} A))
    (K L : DerivedCategory (ModuleCat.{u} A)) (n : ℤ) :
    Closed.linearEquiv (M.toClosedComparison T) K L n =
      RHom.BifunctorComparison.Cohomology.linearEquiv M K L n := by
  symm
  ext x
  rw [RHom.BifunctorComparison.Cohomology.linearEquiv_eq_canonical]
  unfold Closed.linearEquiv
  rw [RHom.BifunctorComparison.toClosedComparison_objIso]
  change RHom.Cohomology.linearEquiv K L n
      (((DerivedCategory.homologyFunctor (ModuleCat.{u} A) n).map
        (M.objIso K L).inv).hom x) =
    RHom.Cohomology.linearEquiv K L n
      (((DerivedCategory.homologyFunctor (ModuleCat.{u} A) n).mapIso
        (M.objIso K L)).inv.hom x)
  rfl

/-- The degree-zero pointwise cohomology equivalence reconstructed from a coherent bifunctor
comparison is the coherent degree-zero equivalence itself. -/
@[simp, stacks 0E1U "pointwise and coherent degree-zero RHom cohomology agree"]
theorem linearEquiv_zero_toClosedComparison_eq_bifunctor
    (M : RHom.BifunctorComparison (A := A))
    (T : DerivedTensor.Right.Monoidal.Model (C := ModuleCat.{u} A))
    (K L : DerivedCategory (ModuleCat.{u} A)) :
    Closed.linearEquiv_zero (M.toClosedComparison T) K L =
      RHom.BifunctorComparison.Cohomology.linearEquiv_zero M K L := by
  unfold Closed.linearEquiv_zero
    RHom.BifunctorComparison.Cohomology.linearEquiv_zero
  rw [linearEquiv_toClosedComparison_eq_bifunctor]
  rfl

/-- The pointwise and coherent cohomology equivalences induced by the same parametrized
tensor-`RHom` adjunction agree. -/
@[simp, stacks 0E1U "parametrized pointwise and coherent RHom cohomology agree"]
theorem linearEquiv_ofAdjunction₂_eq_bifunctor
    (H : MonoidalClosed (DerivedCategory (ModuleCat.{u} A)))
    (T : DerivedTensor.Right.Monoidal.Model (C := ModuleCat.{u} A))
    (adj₂ : RHom.TensorAdjunction₂ (A := A))
    (K L : DerivedCategory (ModuleCat.{u} A)) (n : ℤ) :
    Closed.linearEquiv (RHom.ClosedComparison.ofAdjunction₂ H T adj₂) K L n =
      RHom.BifunctorComparison.Cohomology.linearEquiv
        (RHom.BifunctorComparison.ofAdjunction H adj₂) K L n := by
  symm
  ext x
  rw [RHom.BifunctorComparison.Cohomology.linearEquiv_eq_canonical]
  unfold Closed.linearEquiv
  rw [RHom.ClosedComparison.ofAdjunction₂_objIso_eq_bifunctor]
  change RHom.Cohomology.linearEquiv K L n
      (((DerivedCategory.homologyFunctor (ModuleCat.{u} A) n).map
        ((RHom.BifunctorComparison.ofAdjunction H adj₂).objIso K L).inv).hom x) =
    RHom.Cohomology.linearEquiv K L n
      (((DerivedCategory.homologyFunctor (ModuleCat.{u} A) n).mapIso
        ((RHom.BifunctorComparison.ofAdjunction H adj₂).objIso K L)).inv.hom x)
  rfl

/-- The degree-zero pointwise and coherent cohomology equivalences induced by the same
parametrized tensor-`RHom` adjunction agree. -/
@[simp, stacks 0E1U "parametrized pointwise and coherent degree-zero RHom cohomology agree"]
theorem linearEquiv_zero_ofAdjunction₂_eq_bifunctor
    (H : MonoidalClosed (DerivedCategory (ModuleCat.{u} A)))
    (T : DerivedTensor.Right.Monoidal.Model (C := ModuleCat.{u} A))
    (adj₂ : RHom.TensorAdjunction₂ (A := A))
    (K L : DerivedCategory (ModuleCat.{u} A)) :
    Closed.linearEquiv_zero (RHom.ClosedComparison.ofAdjunction₂ H T adj₂) K L =
      RHom.BifunctorComparison.Cohomology.linearEquiv_zero
        (RHom.BifunctorComparison.ofAdjunction H adj₂) K L := by
  unfold Closed.linearEquiv_zero
    RHom.BifunctorComparison.Cohomology.linearEquiv_zero
  rw [linearEquiv_ofAdjunction₂_eq_bifunctor]
  rfl

end CategoryTheory.DerivedCategory.InternalHom.RHom.Cohomology
