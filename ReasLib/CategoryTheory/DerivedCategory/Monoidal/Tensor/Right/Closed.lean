      (MonoidalClosed.ihomOf H ((MonoidalClosed.ihomOf H K).obj L)).obj M :=
  (DerivedTensor.Right.Monoidal.Model.objIsoTensor T
      ((MonoidalClosed.ihomOf H L).obj M) K).hom ≫
    MonoidalClosed.TensorRight.comparisonOf H K L M

/-- The derived tensor-to-iterated comparison is specified by its ambient model transport. -/
@[stacks 0A8U "derived tensor-to-iterated comparison specification"]
theorem comparisonOf_spec
