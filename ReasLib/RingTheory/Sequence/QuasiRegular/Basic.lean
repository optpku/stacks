/-!
# Quasi-regular finite sequences

This leaf owns the associated-graded comparison map for a finite sequence on
an arbitrary module.  The construction is expressed through the neutral
`I`-adic associated graded objects in `Ideal.AssociatedGraded`, rather than
through a chapter-specific internal quotient model.
-/

@[expose] public section

noncomputable section

open scoped BigOperators TensorProduct

universe u v

namespace RingTheory.Sequence

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]

namespace QuasiRegular

/-
API design: `Ideal.AssociatedGraded.stage`, `piece`, and `gradedModule` are the carrier owners.
The finite sequence contributes only its canonical generators (`monomialDegree` and
`monomialWeight`) and the induced maps.  This separates the filtration data from the
quasi-regularity predicate, keeps coefficient and polynomial module instances discoverable, and
lets users import the comparison map without importing a chapter-facing quotient presentation.
The chapter's `internal*` names are reducible bridges in `QuasiRegular.Internal`, never a second
associated-graded data owner.
-/

/-- The total degree of a monomial exponent in the polynomial presentation
attached to a finite sequence. -/
@[stacks 061P "total degree of a quasi-regular monomial"]
abbrev monomialDegree {rs : List R} (e : Fin rs.length →₀ ℕ) : ℕ :=
  e.degree

/-- Normalizing a monomial degree after inserting the zero stage. -/
@[stacks 061P "zero-stage normalization of a monomial degree"]
theorem monomialDegree_zero_add {rs : List R} (e : Fin rs.length →₀ ℕ) :
    monomialDegree e = 0 + monomialDegree e := by
  simp

/-- The product of the entries of `rs` with exponent vector `e`. -/
@[stacks 061P "monomial weight of a quasi-regular sequence"]
def monomialWeight (rs : List R) (e : Fin rs.length →₀ ℕ) : R :=
  ∏ i : Fin rs.length, rs.get i ^ e i

/-- Monomial weights multiply when their exponent vectors are added. -/
@[stacks 061P "multiplication of quasi-regular monomial weights"]
theorem monomialWeight_add (rs : List R) (e f : Fin rs.length →₀ ℕ) :
    monomialWeight rs e * monomialWeight rs f = monomialWeight rs (e + f) := by
  simp [monomialWeight, Finsupp.add_apply, pow_add, Finset.prod_mul_distrib]

/-- The monomial weight of `e` belongs to the matching power of the ideal
generated by `rs`. -/
@[stacks 061P "monomial weight membership in an ideal power"]
theorem monomialWeight_mem_pow (rs : List R) (e : Fin rs.length →₀ ℕ) :
    monomialWeight rs e ∈ (Ideal.ofList rs) ^ monomialDegree e := by
  classical
  unfold monomialWeight
  rw [monomialDegree, Finsupp.degree_eq_sum, ← Finset.prod_pow_eq_pow_sum]
  exact Ideal.prod_mem_prod fun i _ ↦
    Ideal.pow_mem_pow (Ideal.subset_span (s := {r : R | r ∈ rs}) (List.get_mem rs i)) (e i)

/-- A degree-one monomial weight is the corresponding entry of the sequence. -/
theorem monomialWeight_single (rs : List R) (i : Fin rs.length) :
    monomialWeight rs (Finsupp.single i 1) = rs.get i := by
  classical
  simp [monomialWeight, Finsupp.single_apply]

/-- Monomial weights of total degree `n` generate the `n`th power of the sequence ideal. -/
theorem span_monomialWeight_eq_pow (rs : List R) (n : ℕ) :
    Ideal.span {a : R | ∃ e : Fin rs.length →₀ ℕ,
      monomialDegree e = n ∧ monomialWeight rs e = a} = (Ideal.ofList rs) ^ n := by
  classical
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro a ⟨e, he, rfl⟩
    change monomialWeight rs e ∈ (Ideal.ofList rs) ^ n
    rw [← he]
    exact monomialWeight_mem_pow rs e
  · induction n with
    | zero =>
        have h1 : (1 : R) ∈ Ideal.span {a : R | ∃ e : Fin rs.length →₀ ℕ,
            monomialDegree e = 0 ∧ monomialWeight rs e = a} := by
          apply Ideal.subset_span
          exact ⟨0, by simp [monomialDegree], by simp [monomialWeight]⟩
        rw [pow_zero, Ideal.one_eq_top]
        exact le_of_eq ((Ideal.eq_top_iff_one _).mpr h1).symm
    | succ n ih =>
        rw [pow_succ]
        apply (Ideal.mul_mono ih le_rfl).trans
        rw [Ideal.ofList, Ideal.span_mul_span']
        apply Ideal.span_mono
        rintro a ⟨b, ⟨e, he, rfl⟩, c, hc, rfl⟩
        obtain ⟨i, rfl⟩ := List.mem_iff_get.mp hc
        refine ⟨e + Finsupp.single i 1, ?_, ?_⟩
        · simp [monomialDegree, map_add, he]
        · rw [← monomialWeight_add, monomialWeight_single]

/-- Multiplication by a monomial weight maps `M` to the corresponding
`I`-adic filtration stage. -/
@[stacks 061P "monomial weight action on an associated-graded stage"]
theorem monomialWeight_smul_mem (rs : List R) (e : Fin rs.length →₀ ℕ) (m : M) :
    monomialWeight rs e • m ∈
      Ideal.AssociatedGraded.stage (Ideal.ofList rs) M (monomialDegree e) := by
  exact Submodule.smul_mem_smul (monomialWeight_mem_pow rs e) Submodule.mem_top

/-- Multiplication by a monomial weight shifts an `I`-adic filtration stage
by the total degree of its exponent. -/
@[stacks 061P "monomial weight shifts an associated-graded stage"]
theorem monomialWeight_smul_mem_stage (rs : List R) (n : ℕ)
    (e : Fin rs.length →₀ ℕ)
    (m : Ideal.AssociatedGraded.stage (Ideal.ofList rs) M n) :
    monomialWeight rs e •
        (Ideal.AssociatedGraded.stage (Ideal.ofList rs) M n).subtype m ∈
      Ideal.AssociatedGraded.stage (Ideal.ofList rs) M (n + monomialDegree e) := by
  change monomialWeight rs e • (m : M) ∈
    Ideal.AssociatedGraded.stage (Ideal.ofList rs) M (n + monomialDegree e)
  have h := Submodule.smul_mem_smul (monomialWeight_mem_pow rs e) m.property
  simpa only [Ideal.AssociatedGraded.stage, Ideal.PowerSubmodule.stage,
    ← Submodule.mul_smul, ← pow_add, Nat.add_comm (monomialDegree e) n] using h

/-- The map from `M` to the associated graded piece determined by a monomial
weight. -/
@[stacks 061P "monomial map to an associated-graded piece"]
def monomialMapToPiece (rs : List R) (e : Fin rs.length →₀ ℕ) :
    M →ₗ[R]
      Ideal.AssociatedGraded.piece (Ideal.ofList rs) M (monomialDegree e) :=
  (Submodule.mkQ
    (Ideal.AssociatedGraded.denominator (Ideal.ofList rs) M (monomialDegree e))).comp
    (LinearMap.codRestrict
      (Ideal.AssociatedGraded.stage (Ideal.ofList rs) M (monomialDegree e))
      ((monomialWeight rs e) • (LinearMap.id : M →ₗ[R] M))
      (fun m ↦ monomialWeight_smul_mem (M := M) rs e m))

/-- The monomial map to a graded piece vanishes on the submodule
`Ideal.ofList rs • ⊤`. -/
@[stacks 061P "monomial map factors through the degree-zero quotient"]
theorem monomialMapToPiece_ker_le (rs : List R) (e : Fin rs.length →₀ ℕ) :
    ((Ideal.ofList rs) • ⊤ : Submodule R M) ≤
      LinearMap.ker (monomialMapToPiece (M := M) rs e) := by
  intro m hm
  change Submodule.Quotient.mk
    (⟨monomialWeight rs e • m, monomialWeight_smul_mem rs e m⟩ :
      Ideal.AssociatedGraded.stage (Ideal.ofList rs) M (monomialDegree e)) = 0
  apply (Submodule.Quotient.mk_eq_zero _).mpr
  change monomialWeight rs e • m ∈
    Ideal.AssociatedGraded.stage (Ideal.ofList rs) M (monomialDegree e + 1)
  have hm' : m ∈ Ideal.AssociatedGraded.stage (Ideal.ofList rs) M 1 := by
    simpa only [Ideal.AssociatedGraded.stage, Ideal.PowerSubmodule.stage, pow_one] using hm
  simpa only [Submodule.coe_subtype, Nat.add_comm 1 (monomialDegree e)] using
    monomialWeight_smul_mem_stage (M := M) rs 1 e ⟨m, hm'⟩

/-- The map from `M / Ideal.ofList rs M` to the graded piece indexed by a
monomial exponent. -/
@[stacks 061P "quotient monomial map to an associated-graded piece"]
def monomialMap (rs : List R) (e : Fin rs.length →₀ ℕ) :
    M ⧸ ((Ideal.ofList rs) • ⊤ : Submodule R M) →ₗ[R]
      Ideal.AssociatedGraded.piece (Ideal.ofList rs) M (monomialDegree e) :=
  Submodule.liftQ ((Ideal.ofList rs) • ⊤ : Submodule R M)
    (monomialMapToPiece (M := M) rs e)
    (monomialMapToPiece_ker_le (M := M) rs e)

/-- Multiplication by a monomial weight on an individual `I`-adic
filtration stage. -/
@[stacks 061P "monomial map on an associated-graded stage"]
def monomialMapOnStage (rs : List R) (n : ℕ) (e : Fin rs.length →₀ ℕ) :
    Ideal.AssociatedGraded.stage (Ideal.ofList rs) M n →ₗ[R]
      Ideal.AssociatedGraded.stage (Ideal.ofList rs) M (n + monomialDegree e) :=
  LinearMap.codRestrict
    (Ideal.AssociatedGraded.stage (Ideal.ofList rs) M (n + monomialDegree e))
    ((monomialWeight rs e) •
      (Ideal.AssociatedGraded.stage (Ideal.ofList rs) M n).subtype)
    (fun m ↦ monomialWeight_smul_mem_stage (M := M) rs n e m)

/-- Multiplication by a monomial weight carries the denominator of one
associated graded piece into the denominator of the shifted piece. -/
@[stacks 061P "monomial map preserves associated-graded denominators"]
theorem monomialMapOnStage_denominator_le (rs : List R) (n : ℕ)
    (e : Fin rs.length →₀ ℕ) :
    Ideal.AssociatedGraded.denominator (Ideal.ofList rs) M n ≤
      (Ideal.AssociatedGraded.denominator (Ideal.ofList rs) M
        (n + monomialDegree e)).comap (monomialMapOnStage (M := M) rs n e) := by
  intro m hm
  change monomialWeight rs e • (m : M) ∈
    Ideal.AssociatedGraded.stage (Ideal.ofList rs) M (n + monomialDegree e + 1)
  have hm' : (m : M) ∈ Ideal.AssociatedGraded.stage (Ideal.ofList rs) M (n + 1) := hm
  simpa only [Submodule.coe_subtype, Nat.add_assoc, Nat.add_comm 1 (monomialDegree e)] using
    monomialWeight_smul_mem_stage (M := M) rs (n + 1) e ⟨(m : M), hm'⟩

/-- The monomial operator from the degree-`n` associated graded piece to the
degree-`n + |e|` piece. -/
@[stacks 061P "monomial operator on an associated-graded piece"]
def monomialMapOnPiece (rs : List R) (n : ℕ) (e : Fin rs.length →₀ ℕ) :
    Ideal.AssociatedGraded.piece (Ideal.ofList rs) M n →ₗ[R]
      Ideal.AssociatedGraded.piece (Ideal.ofList rs) M (n + monomialDegree e) :=
  Submodule.mapQ
    (Ideal.AssociatedGraded.denominator (Ideal.ofList rs) M n)
    (Ideal.AssociatedGraded.denominator (Ideal.ofList rs) M (n + monomialDegree e))
    (monomialMapOnStage (M := M) rs n e)
    (monomialMapOnStage_denominator_le (M := M) rs n e)

/-- The additive endomorphism of the associated graded module induced by a
monomial in the polynomial variables. -/
@[stacks 061P "additive monomial action on the associated-graded module"]
def monomialActionAdd (rs : List R) (e : Fin rs.length →₀ ℕ) :
    Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M →+
      Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M :=
  DirectSum.toAddMonoid fun n ↦
    (DirectSum.of (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M)
      (n + monomialDegree e)).comp
      (monomialMapOnPiece (M := M) rs n e).toAddMonoidHom

/-- The additive monomial action preserves addition. -/
@[stacks 061P "additivity of the monomial action"]
theorem monomialActionAdd_map_add (rs : List R) (e : Fin rs.length →₀ ℕ)
    (x y : Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) :
    monomialActionAdd (M := M) rs e (x + y) =
      monomialActionAdd (M := M) rs e x + monomialActionAdd (M := M) rs e y := by
  exact (monomialActionAdd (M := M) rs e).map_add x y

/-- The additive monomial action is linear over the base ring. -/
@[stacks 061P "base-linearity of the monomial action"]
theorem monomialActionAdd_map_smul (rs : List R) (e : Fin rs.length →₀ ℕ)
    (r : R) (x : Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) :
    monomialActionAdd (M := M) rs e (r • x) =
      r • monomialActionAdd (M := M) rs e x := by
  exact (DirectSum.toModule R ℕ _ fun n ↦
    (DirectSum.lof R ℕ _ (n + monomialDegree e)).comp
      (monomialMapOnPiece (M := M) rs n e)).map_smul r x

/-- The `R`-linear endomorphism of the associated graded module induced by a
monomial in the polynomial variables. -/
@[stacks 061P "linear monomial action on the associated-graded module"]
def monomialAction (rs : List R) (e : Fin rs.length →₀ ℕ) :
    Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M →ₗ[R]
      Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M where
  toFun := monomialActionAdd (M := M) rs e
  map_add' := monomialActionAdd_map_add (M := M) rs e
  map_smul' := monomialActionAdd_map_smul (M := M) rs e

/-- A monomial action sends a homogeneous inclusion to the shifted inclusion. -/
theorem monomialAction_of (rs : List R) (e : Fin rs.length →₀ ℕ) (n : ℕ)
    (x : Ideal.AssociatedGraded.piece (Ideal.ofList rs) M n) :
    monomialAction (M := M) rs e
        (DirectSum.of (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M) n x) =
      DirectSum.of (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M)
        (n + monomialDegree e) (monomialMapOnPiece (M := M) rs n e x) := by
  exact DirectSum.toAddMonoid_of _ n x

private theorem of_piece_mk_eq (rs : List R) {n k : ℕ} (hnk : n = k)
    {m l : M} (hm : m ∈ Ideal.AssociatedGraded.stage (Ideal.ofList rs) M n)
    (hl : l ∈ Ideal.AssociatedGraded.stage (Ideal.ofList rs) M k) (hml : m = l) :
    DirectSum.of (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M) n
        (Submodule.Quotient.mk ⟨m, hm⟩) =
      DirectSum.of (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M) k
        (Submodule.Quotient.mk ⟨l, hl⟩) := by
  subst k
  subst l
  rfl

/-- The monomial with zero exponent acts as the identity. -/
theorem monomialAction_zero (rs : List R)
    (x : Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) :
    monomialAction (M := M) rs 0 x = x := by
  induction x using DirectSum.induction_on with
  | zero => exact map_zero _
  | of n y =>
      rw [monomialAction_of]
      refine Submodule.Quotient.induction_on _ y ?_
      intro m
      change DirectSum.of (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M) n (Submodule.Quotient.mk
          (⟨monomialWeight rs 0 • (m : M), _⟩ :
            Ideal.AssociatedGraded.stage (Ideal.ofList rs) M n)) =
        DirectSum.of (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M) n (Submodule.Quotient.mk m)
      apply congrArg (fun z : Ideal.AssociatedGraded.stage (Ideal.ofList rs) M n ↦
        DirectSum.of (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M) n (Submodule.Quotient.mk z))
      apply Subtype.ext
      simp [monomialWeight]
  | add x y hx hy => simpa only [map_add, hx, hy]

/-- Composing monomial operators adds their exponent vectors. -/
theorem monomialAction_add (rs : List R) (e f : Fin rs.length →₀ ℕ)
    (x : Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) :
    monomialAction (M := M) rs e (monomialAction (M := M) rs f x) =
      monomialAction (M := M) rs (e + f) x := by
  induction x using DirectSum.induction_on with
  | zero => simp
  | of n y =>
      rw [monomialAction_of, monomialAction_of, monomialAction_of]
      refine Submodule.Quotient.induction_on _ y ?_
      intro m
      change DirectSum.of (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M)
          (n + monomialDegree f + monomialDegree e)
          (Submodule.Quotient.mk ⟨monomialWeight rs e • (monomialWeight rs f • (m : M)), _⟩) =
        DirectSum.of (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M)
          (n + monomialDegree (e + f))
          (Submodule.Quotient.mk ⟨monomialWeight rs (e + f) • (m : M), _⟩)
      apply of_piece_mk_eq
      · simp [monomialDegree, map_add, Nat.add_comm, Nat.add_left_comm]
      · rw [← mul_smul, monomialWeight_add]
  | add x y hx hy => simp only [map_add, hx, hy]

/-- The polynomial action on the associated graded module obtained by summing
the monomial actions coefficientwise. -/
@[stacks 061P "coefficientwise polynomial action"]
def polynomialSmul (rs : List R)
    (p : MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)) :
  Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M →
      Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M :=
  fun x ↦ (AddMonoidAlgebra.coeff p).sum fun e a ↦
    a • monomialAction (M := M) rs e x

/-- The coefficientwise polynomial action on the associated graded module. -/
@[stacks 061P "polynomial scalar action on the associated-graded module"]
noncomputable instance polynomialSMul (rs : List R) :
    SMul (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))
      (Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) where
  smul p x := polynomialSmul (M := M) rs p x

/-- A single polynomial monomial acts by its coefficient and monomial operator. -/
theorem polynomial_monomial_smul (rs : List R) (e : Fin rs.length →₀ ℕ)
    (a : R ⧸ Ideal.ofList rs)
    (x : Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) :
    MvPolynomial.monomial e a • x = a • monomialAction (M := M) rs e x := by
  change (AddMonoidAlgebra.coeff (MvPolynomial.monomial e a)).sum
    (fun f b ↦ b • monomialAction (M := M) rs f x) = _
  simp [MvPolynomial.monomial]

/-- The polynomial action fixes the associated graded module under the unit
polynomial. -/
@[stacks 061P "unit law for the polynomial action"]
theorem polynomial_one_smul (rs : List R)
    (x : Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) :
    (1 : MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)) • x = x := by
  change (AddMonoidAlgebra.coeff (1 : MvPolynomial (Fin rs.length)
      (R ⧸ Ideal.ofList rs))).sum
    (fun e a ↦ a • monomialAction (M := M) rs e x) = x
  simp [MvPolynomial.one_def, MvPolynomial.monomial, monomialAction_zero]

/-- The polynomial action is compatible with polynomial multiplication. -/
@[stacks 061P "multiplicative law for the polynomial action"]
theorem polynomial_mul_smul (rs : List R)
    (p q : MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))
    (x : Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) :
    (p * q) • x = p • q • x := by
  have hadd (p q : MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))
      (x : Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) :
      (p + q) • x = p • x + q • x := by
    change (AddMonoidAlgebra.coeff p + AddMonoidAlgebra.coeff q).sum
      (fun e a ↦ a • monomialAction (M := M) rs e x) = _
    exact Finsupp.sum_add_index' (fun _ ↦ zero_smul _ _)
      (fun _ _ _ ↦ add_smul _ _ _)
  have hsmul (p : MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))
      (x y : Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) :
      p • (x + y) = p • x + p • y := by
    change (AddMonoidAlgebra.coeff p).sum
        (fun e a ↦ a • monomialAction (M := M) rs e (x + y)) =
      (AddMonoidAlgebra.coeff p).sum (fun e a ↦ a • monomialAction (M := M) rs e x) +
        (AddMonoidAlgebra.coeff p).sum (fun e a ↦ a • monomialAction (M := M) rs e y)
    simp only [map_add, smul_add, Finsupp.sum_add]
  induction p using MvPolynomial.induction_on' generalizing q x with
  | monomial e a =>
      induction q using MvPolynomial.induction_on' generalizing x with
      | monomial f b =>
          rw [MvPolynomial.monomial_mul, polynomial_monomial_smul,
            polynomial_monomial_smul, polynomial_monomial_smul,
            (monomialAction (M := M) rs e).map_smul_of_quotient,
            monomialAction_add, mul_smul]
      | add p q hp hq => rw [mul_add, hadd, hadd, hsmul, hp, hq]
  | add p q hp hq => rw [add_mul, hadd, hadd, hp, hq]

/-- The polynomial action is additive in the module argument. -/
@[stacks 061P "additivity in the associated-graded argument"]
theorem polynomial_smul_add (rs : List R)
    (p : MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))
    (x y : Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) :
    p • (x + y) = p • x + p • y := by
  change (AddMonoidAlgebra.coeff p).sum
      (fun e a ↦ a • monomialAction (M := M) rs e (x + y)) =
    (AddMonoidAlgebra.coeff p).sum (fun e a ↦ a • monomialAction (M := M) rs e x) +
      (AddMonoidAlgebra.coeff p).sum (fun e a ↦ a • monomialAction (M := M) rs e y)
  simp only [map_add, smul_add, Finsupp.sum_add]

/-- Every polynomial sends zero to zero under the associated graded action. -/
@[stacks 061P "zero preservation by the polynomial action"]
theorem polynomial_smul_zero (rs : List R)
    (p : MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)) :
    p • (0 : Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) = 0 := by
  change (AddMonoidAlgebra.coeff p).sum
    (fun e a ↦ a • monomialAction (M := M) rs e 0) = 0
  simp

/-- The polynomial action is additive in the polynomial argument. -/
@[stacks 061P "additivity in the polynomial argument"]
theorem polynomial_add_smul (rs : List R)
    (p q : MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))
    (x : Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) :
    (p + q) • x = p • x + q • x := by
  change (AddMonoidAlgebra.coeff p + AddMonoidAlgebra.coeff q).sum
      (fun e a ↦ a • monomialAction (M := M) rs e x) = _
  exact Finsupp.sum_add_index' (fun _ ↦ zero_smul _ _)
    (fun _ _ _ ↦ add_smul _ _ _)

/-- The zero polynomial acts by zero on the associated graded module. -/
@[stacks 061P "zero polynomial action"]
theorem polynomial_zero_smul (rs : List R)
    (x : Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) :
    (0 : MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)) • x = 0 := by
  change (0 : (Fin rs.length →₀ ℕ) →₀ R ⧸ Ideal.ofList rs).sum
    (fun e a ↦ a • monomialAction (M := M) rs e x) = 0
  exact Finsupp.sum_zero_index

/-- The associated graded module is naturally a module over the polynomial
ring on the entries of the sequence. -/
@[stacks 061P "polynomial module structure on the associated-graded module"]
noncomputable instance polynomialModule (rs : List R) :
    Module (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))
      (Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) where
  smul := (· • ·)
  one_smul := polynomial_one_smul (M := M) rs
  mul_smul := polynomial_mul_smul (M := M) rs
  smul_add := polynomial_smul_add (M := M) rs
  smul_zero := polynomial_smul_zero (M := M) rs
  add_smul := polynomial_add_smul (M := M) rs
  zero_smul := polynomial_zero_smul (M := M) rs

/-- The coefficient action on the associated graded module is compatible with
the polynomial action. -/
@[stacks 061P "coefficient-polynomial scalar tower law"]
theorem polynomialScalarTower (rs : List R) :
    IsScalarTower (R ⧸ Ideal.ofList rs)
      (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))
      (Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) := by
  constructor
  intro a p x
  change (a • AddMonoidAlgebra.coeff p).sum
      (fun e b ↦ b • monomialAction (M := M) rs e x) =
    a • (AddMonoidAlgebra.coeff p).sum
      (fun e b ↦ b • monomialAction (M := M) rs e x)
  rw [Finsupp.sum_smul_index]
  · simp [Finsupp.smul_sum, smul_smul]
  · intro e
    exact zero_smul _ _

/-- The canonical scalar tower from coefficients to polynomials and then to
the associated graded module. -/
@[stacks 061P "coefficient-polynomial scalar tower instance"]
noncomputable instance polynomialScalarTowerInstance (rs : List R) :
    IsScalarTower (R ⧸ Ideal.ofList rs)
      (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))
      (Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) :=
  polynomialScalarTower (M := M) rs

/-- The degree-zero map from `M` to the zeroth associated graded piece. -/
@[stacks 061P "degree-zero map to the associated-graded piece"]
def degreeZeroMapToPiece (rs : List R) :
    M →ₗ[R] Ideal.AssociatedGraded.piece (Ideal.ofList rs) M 0 :=
  (Submodule.mkQ (Ideal.AssociatedGraded.denominator (Ideal.ofList rs) M 0)).comp
    (LinearMap.codRestrict (Ideal.AssociatedGraded.stage (Ideal.ofList rs) M 0)
      (LinearMap.id : M →ₗ[R] M)
      (fun m ↦ Ideal.AssociatedGraded.mem_stage_zero (Ideal.ofList rs) M m))

/-- The degree-zero map vanishes on the first positive `I`-adic stage. -/
@[stacks 061P "degree-zero map factors through the quotient"]
theorem degreeZeroMapToPiece_ker_le (rs : List R) :
    ((Ideal.ofList rs) • ⊤ : Submodule R M) ≤
      LinearMap.ker (degreeZeroMapToPiece (M := M) rs) := by
  intro m hm
  change Submodule.Quotient.mk
    (⟨m, Ideal.AssociatedGraded.mem_stage_zero (Ideal.ofList rs) M m⟩ :
      Ideal.AssociatedGraded.stage (Ideal.ofList rs) M 0) = 0
  apply (Submodule.Quotient.mk_eq_zero _).mpr
  change m ∈ Ideal.AssociatedGraded.stage (Ideal.ofList rs) M (0 + 1)
  simpa only [Ideal.AssociatedGraded.stage, Ideal.PowerSubmodule.stage, zero_add,
    pow_one] using hm

/-- The induced map from `M / Ideal.ofList rs M` to the degree-zero
associated graded piece. -/
@[stacks 061P "degree-zero quotient map"]
def degreeZeroMap (rs : List R) :
    M ⧸ ((Ideal.ofList rs) • ⊤ : Submodule R M) →ₗ[R]
      Ideal.AssociatedGraded.piece (Ideal.ofList rs) M 0 :=
  Submodule.liftQ ((Ideal.ofList rs) • ⊤ : Submodule R M)
    (degreeZeroMapToPiece (M := M) rs)
    (degreeZeroMapToPiece_ker_le (M := M) rs)

/-- The degree-zero inclusion preserves addition. -/
@[stacks 061P "additivity of the degree-zero inclusion"]
theorem degreeZeroInclusion_map_add (rs : List R)
    (x y : M ⧸ ((Ideal.ofList rs) • ⊤ : Submodule R M)) :
    DirectSum.lof (R ⧸ Ideal.ofList rs) ℕ
        (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M) 0
        (degreeZeroMap (M := M) rs (x + y)) =
      DirectSum.lof (R ⧸ Ideal.ofList rs) ℕ
        (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M) 0
        (degreeZeroMap (M := M) rs x) +
      DirectSum.lof (R ⧸ Ideal.ofList rs) ℕ
        (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M) 0
        (degreeZeroMap (M := M) rs y) := by
  simp only [map_add]

/-- The degree-zero inclusion is linear over `R ⧸ Ideal.ofList rs`. -/
@[stacks 061P "scalar compatibility of the degree-zero inclusion"]
theorem degreeZeroInclusion_map_smul (rs : List R) (a : R ⧸ Ideal.ofList rs)
    (x : M ⧸ ((Ideal.ofList rs) • ⊤ : Submodule R M)) :
    DirectSum.lof (R ⧸ Ideal.ofList rs) ℕ
        (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M) 0
        (degreeZeroMap (M := M) rs (a • x)) =
      a • DirectSum.lof (R ⧸ Ideal.ofList rs) ℕ
        (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M) 0
        (degreeZeroMap (M := M) rs x) := by
  rw [(degreeZeroMap (M := M) rs).map_smul_of_quotient, map_smul]

/-- The degree-zero inclusion of `M / Ideal.ofList rs M` into its associated
graded module. -/
@[stacks 061P "degree-zero inclusion into the associated-graded module"]
def degreeZeroInclusion (rs : List R) :
    M ⧸ ((Ideal.ofList rs) • ⊤ : Submodule R M) →ₗ[R ⧸ Ideal.ofList rs]
      Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M where
  toFun x := DirectSum.lof (R ⧸ Ideal.ofList rs) ℕ
    (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M) 0
    (degreeZeroMap (M := M) rs x)
  map_add' := degreeZeroInclusion_map_add (M := M) rs
  map_smul' := degreeZeroInclusion_map_smul (M := M) rs

/-- The standard left-oriented scalar extension of `M / Ideal.ofList rs M`
from `R ⧸ Ideal.ofList rs` to its polynomial ring. -/
@[stacks 061P "left-oriented polynomial scalar extension"]
abbrev polynomialExtension (rs : List R) : Type (max u v) :=
  TensorProduct (R ⧸ Ideal.ofList rs)
    (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))
    (M ⧸ ((Ideal.ofList rs) • ⊤ : Submodule R M))

/-- The right-oriented tensor presentation of the source used by the
associated-graded comparison map. -/
@[stacks 061P "right-oriented associated-graded comparison source"]
abbrev comparisonSource (rs : List R) : Type (max u v) :=
  TensorProduct (R ⧸ Ideal.ofList rs)
    (M ⧸ ((Ideal.ofList rs) • ⊤ : Submodule R M))
    (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))

/-- The polynomial module structure on the right-oriented tensor source,
transported from the standard left-oriented scalar extension. -/
@[stacks 061P "polynomial module on the comparison source"]
noncomputable instance comparisonSourceModule (rs : List R) :
    Module (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))
      (comparisonSource (M := M) rs) :=
  (TensorProduct.comm (R ⧸ Ideal.ofList rs)
    (M ⧸ ((Ideal.ofList rs) • ⊤ : Submodule R M))
    (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))).toAddEquiv.module _

/-- The canonical commutation isomorphism from the right-oriented comparison
source to the standard scalar extension. -/
@[stacks 061P "associated-graded comparison source commutation"]
noncomputable def comparisonSourceComm (rs : List R) :
    comparisonSource (M := M) rs →ₗ[
      MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)]
      polynomialExtension (M := M) rs :=
  (((TensorProduct.comm (R ⧸ Ideal.ofList rs)
    (M ⧸ ((Ideal.ofList rs) • ⊤ : Submodule R M))
    (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))).toAddEquiv).linearEquiv
    (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))).toLinearMap

/-- The comparison-source commutation map swaps a quotient class and a pure polynomial tensor. -/
@[stacks 061P "comparison-source commutation on pure tensors"]
theorem comparisonSourceComm_tmul (rs : List R) (m : M)
    (p : MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)) :
    comparisonSourceComm (M := M) rs
        (Submodule.Quotient.mk m ⊗ₜ[R ⧸ Ideal.ofList rs] p) =
      p ⊗ₜ[R ⧸ Ideal.ofList rs] Submodule.Quotient.mk m := by
  rfl

/-- The polynomial-linear extension of the degree-zero inclusion into the
associated graded module. -/
@[stacks 061P "associated-graded polynomial base-change map"]
noncomputable def baseChangeMap (rs : List R) :
    polynomialExtension (M := M) rs →ₗ[
      MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)]
      Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M :=
  (degreeZeroInclusion (M := M) rs).liftBaseChange
    (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))

/-- The canonical map from
`M / Ideal.ofList rs M ⊗ (R / Ideal.ofList rs)[X]` to the associated graded
module of `M`. -/
@[stacks 061P "associated-graded comparison map"]
noncomputable def comparisonMap (rs : List R) :
    comparisonSource (M := M) rs →ₗ[
      MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)]
      Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M :=
  (baseChangeMap (M := M) rs).comp (comparisonSourceComm (M := M) rs)

/-- The comparison map evaluates a pure tensor by the polynomial action. -/
theorem comparisonMap_tmul (rs : List R) (m : M)
    (p : MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)) :
    comparisonMap (M := M) rs (Submodule.Quotient.mk m ⊗ₜ[R ⧸ Ideal.ofList rs] p) =
      p • degreeZeroInclusion (M := M) rs (Submodule.Quotient.mk m) := by
  rw [comparisonMap, LinearMap.comp_apply, comparisonSourceComm_tmul,
    baseChangeMap, LinearMap.liftBaseChange_tmul]

/-- The comparison map has the defining monomial formula from Stacks. -/
theorem comparisonMap_tmul_monomial (rs : List R) (e : Fin rs.length →₀ ℕ) (m : M) :
    comparisonMap (M := M) rs
        (Submodule.Quotient.mk m ⊗ₜ[R ⧸ Ideal.ofList rs] MvPolynomial.monomial e 1) =
      DirectSum.of (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M) (monomialDegree e)
        (monomialMap (M := M) rs e (Submodule.Quotient.mk m)) := by
  rw [comparisonMap_tmul, polynomial_monomial_smul, one_smul]
  change monomialAction (M := M) rs e
      (DirectSum.of (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M) 0
        (Submodule.Quotient.mk ⟨m, _⟩)) = _
  rw [monomialAction_of]
  change DirectSum.of (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M) (0 + monomialDegree e)
      (Submodule.Quotient.mk ⟨monomialWeight rs e • m, _⟩) =
    DirectSum.of (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M) (monomialDegree e)
      (Submodule.Quotient.mk ⟨monomialWeight rs e • m, _⟩)
  exact of_piece_mk_eq rs (zero_add _) _ _ rfl

/-- The associated-graded comparison map is always surjective. -/
@[stacks 061P "surjectivity of the associated-graded comparison map"]
theorem comparisonMap_surjective (rs : List R) :
    Function.Surjective (comparisonMap (M := M) rs) := by
  let N : Submodule R (Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M) :=
    ((LinearMap.range (comparisonMap (M := M) rs)).restrictScalars
      (R ⧸ Ideal.ofList rs)).restrictScalars R
  let g (n : ℕ) : Ideal.AssociatedGraded.stage (Ideal.ofList rs) M n →ₗ[R]
      Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M :=
    (DirectSum.lof R ℕ (Ideal.AssociatedGraded.piece (Ideal.ofList rs) M) n).comp
      (Submodule.mkQ (Ideal.AssociatedGraded.denominator (Ideal.ofList rs) M n))
  have hweight (n : ℕ) (a : R)
      (ha : a ∈ Ideal.span {b : R | ∃ e : Fin rs.length →₀ ℕ,
        monomialDegree e = n ∧ monomialWeight rs e = b}) :
      ∀ (ha' : a ∈ (Ideal.ofList rs) ^ n) (m : M),
        g n ⟨a • m, Submodule.smul_mem_smul ha' Submodule.mem_top⟩ ∈ N := by
    induction ha using Submodule.span_induction with
    | mem a ha =>
        obtain ⟨e, he, rfl⟩ := ha
        intro ha' m
        have hmap : g n ⟨monomialWeight rs e • m,
            Submodule.smul_mem_smul ha' Submodule.mem_top⟩ =
            comparisonMap (M := M) rs
              (Submodule.Quotient.mk m ⊗ₜ[R ⧸ Ideal.ofList rs] MvPolynomial.monomial e 1) := by
          rw [comparisonMap_tmul_monomial]
          exact of_piece_mk_eq rs he.symm _ _ rfl
        rw [hmap]
        exact LinearMap.mem_range_self _ _
    | zero =>
        intro ha' m
        have hz : (⟨(0 : R) • m, Submodule.smul_mem_smul ha' Submodule.mem_top⟩ :
            Ideal.AssociatedGraded.stage (Ideal.ofList rs) M n) = 0 :=
          Subtype.ext (zero_smul R m)
        rw [hz, map_zero]
        exact N.zero_mem
    | add a b ha hb iha ihb =>
        intro hab m
        have ha' : a ∈ (Ideal.ofList rs) ^ n := (span_monomialWeight_eq_pow rs n).le ha
        have hb' : b ∈ (Ideal.ofList rs) ^ n := (span_monomialWeight_eq_pow rs n).le hb
        have heq : (⟨(a + b) • m, Submodule.smul_mem_smul hab Submodule.mem_top⟩ :
            Ideal.AssociatedGraded.stage (Ideal.ofList rs) M n) =
            ⟨a • m, Submodule.smul_mem_smul ha' Submodule.mem_top⟩ +
              ⟨b • m, Submodule.smul_mem_smul hb' Submodule.mem_top⟩ :=
          Subtype.ext (add_smul a b m)
        rw [heq, map_add]
        exact N.add_mem (iha ha' m) (ihb hb' m)
    | smul r a ha ih =>
        intro hra m
        have ha' : a ∈ (Ideal.ofList rs) ^ n := (span_monomialWeight_eq_pow rs n).le ha
        have heq : (⟨(r • a) • m, Submodule.smul_mem_smul hra Submodule.mem_top⟩ :
            Ideal.AssociatedGraded.stage (Ideal.ofList rs) M n) =
            r • ⟨a • m, Submodule.smul_mem_smul ha' Submodule.mem_top⟩ :=
          Subtype.ext (mul_smul r a m)
        rw [heq, map_smul]
        exact N.smul_mem r (ih ha' m)
  have hstage (n : ℕ) (m : Ideal.AssociatedGraded.stage (Ideal.ofList rs) M n) :
      g n m ∈ N := by
    have h (z : M) (hz : z ∈ (Ideal.ofList rs) ^ n • (⊤ : Submodule R M)) :
        g n ⟨z, hz⟩ ∈ N := by
      induction hz using Submodule.smul_induction_on' with
      | smul a ha z hz =>
          exact hweight n a ((span_monomialWeight_eq_pow rs n).ge ha) ha z
      | add z hz w hw ihz ihw =>
          change g n (⟨z, hz⟩ + ⟨w, hw⟩) ∈ N
          rw [map_add]
          exact N.add_mem ihz ihw
    exact h m m.property
  intro x
  have hx : x ∈ N := by
    induction x using DirectSum.induction_on with
    | zero => exact N.zero_mem
    | of n y =>
        refine Submodule.Quotient.induction_on _ y ?_
        intro m
        exact hstage n m
    | add x y hx hy => exact N.add_mem hx hy
  exact hx

end QuasiRegular

/-- A finite sequence is `M`-quasi-regular when its associated-graded comparison map is
bijective. -/
@[stacks 061P "quasi-regular sequences"]
def IsQuasiRegular (M : Type v) [AddCommGroup M] [Module R M] (rs : List R) : Prop :=
  Function.Bijective (QuasiRegular.comparisonMap (M := M) rs)

/-- Quasi-regularity is implied by injectivity of the associated-graded
comparison map because the map is always surjective. -/
@[stacks 061P "injective comparison map implies quasi-regularity"]
theorem isQuasiRegular_of_injective (rs : List R) :
    Function.Injective (QuasiRegular.comparisonMap (M := M) rs) → IsQuasiRegular M rs := by
  intro hinj
  exact ⟨hinj, QuasiRegular.comparisonMap_surjective rs⟩

/-- Quasi-regularity is equivalent to injectivity of the associated-graded
comparison map. -/
@[stacks 061P "quasi-regularity injectivity characterization"]
theorem isQuasiRegular_iff_injective (rs : List R) :
    IsQuasiRegular M rs ↔ Function.Injective (QuasiRegular.comparisonMap (M := M) rs) := by
  exact ⟨fun h ↦ h.1, isQuasiRegular_of_injective rs⟩

namespace IsQuasiRegular

/-- The canonical polynomial-linear equivalence supplied by a quasi-regular
sequence. -/
@[stacks 061P "linear equivalence from quasi-regularity"]
noncomputable def linearEquiv {rs : List R} (hqr : IsQuasiRegular M rs) :
    QuasiRegular.comparisonSource (M := M) rs ≃ₗ[
      MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)]
      Ideal.AssociatedGraded.gradedModule (Ideal.ofList rs) M :=
  LinearEquiv.ofBijective (QuasiRegular.comparisonMap (M := M) rs) hqr

end IsQuasiRegular

/-- A sequence in a commutative ring is quasi-regular when it is quasi-regular on the regular
module. -/
@[stacks 061P "quasi-regular sequences"]
abbrev IsQuasiRegularSequence (rs : List R) : Prop :=
  IsQuasiRegular R rs

end RingTheory.Sequence
