/-!
# Lemma 10.46.5

The four-generator statement is specific to the polynomial ring `ℤ[x, y]`, so it remains a
source-facing corollary rather than a ReasLib owner.  Its proof-only binomial and valuation
calculations are intentionally not exported.  The reusable closure principle used by that
calculation is `RingHom.PowerGeneration.add_mem_of_nonnegative`.
-/

namespace MvPolynomial
namespace MixedPower

local notation "Pxy" => MvPolynomial (Fin 2) ℤ
local notation "x" => (X (0 : Fin 2) : Pxy)
local notation "y" => (X (1 : Fin 2) : Pxy)

variable (p n m : ℕ)

local notation "mixedPowerMultipleSubalgebra" =>
  Algebra.adjoin ℤ
    ({x ^ (p ^ n), p ^ n • x, y ^ (p ^ m), p ^ m • y} : Set Pxy)

/-- Lemma 10.46.5 (Tag 0545): in `ℤ[x, y]`, sufficiently high powers and multiples of `x + y`
belong to the subalgebra generated by the four displayed prime-power/scalar elements. -/
@[stacks 0545]
theorem exists_power_and_multiple
    (hp : Nat.Prime p) (hn : 0 < n) (hm : 0 < m) :
    ∃ a : ℕ,
      (x + y) ^ (p ^ a) ∈ mixedPowerMultipleSubalgebra ∧
        p ^ a • (x + y) ∈ mixedPowerMultipleSubalgebra := sorry

end MixedPower
end MvPolynomial

/- The generic positive-witness closure used by the source-specific statement. -/
@[stacks 0545 "positive-witness closure companion"]
#check @RingHom.PowerGeneration.add_mem_of_nonnegative
