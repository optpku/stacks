module

public import ReasLib.RingTheory.ReesAlgebra.BlowupChart

/-!
# Principal affine blowup charts

This leaf fixes the canonical center element of the principal ideal generated
by a ring element.  It is intentionally independent of any regularity or
valuation hypothesis, so functorial chart constructions can use it directly.
-/

@[expose] public section

noncomputable section

open scoped AffineBlowupChart

universe u

namespace AffineBlowupChart.Principal

variable {R : Type u} [CommRing R]

/-- The canonical distinguished element of the principal ideal generated by `r`. -/
@[stacks 052Q "principal affine blowup chart parameter"]
def element (r : R) : Ideal.span {r} :=
  ⟨r, Ideal.mem_span_singleton_self r⟩

/-- The affine blowup chart of the principal ideal generated by `r`, taken at its canonical
distinguished element. -/
@[stacks 052Q "principal affine blowup chart"]
abbrev chart (r : R) : Type u :=
  affineBlowupChart (R := R) (Ideal.span {r}) (element r)

end AffineBlowupChart.Principal
