/-- The derived tensor-to-iterated comparison is covariantly natural in its target. -/
@[stacks 0A8U "derived tensor-to-iterated target naturality"]
theorem comparisonOf_natural_target
    (H : MonoidalClosed (DerivedCategory C))
    (T : DerivedTensor.Right.Monoidal.Model (C := C))
