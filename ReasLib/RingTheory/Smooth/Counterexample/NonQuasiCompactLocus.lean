module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Data.PNat.Basic
public import Mathlib.RingTheory.Smooth.Locus
import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Ideal.Principal

@[expose] public section

/-!
# A non-quasi-compact smooth locus

This leaf owns the standard infinitely generated counterexample in which the
smooth locus of a finitely presented ring map is not quasi-compact.
-/

universe u

noncomputable section

namespace Algebra.SmoothCounterexample

/-- The polynomial ring `k[x, y₁, y₂, ...]`, with `none` indexing `x` and `some i` indexing
`yᵢ`. -/
abbrev PolynomialRing (k : Type u) [CommRing k] :=
  MvPolynomial (Option ℕ+) k

/-- The ideal generated by the relations `x * yᵢ`. -/
def relationIdeal (k : Type u) [CommRing k] : Ideal (PolynomialRing k) :=
  Ideal.span (Set.range fun i : ℕ+ ↦
    MvPolynomial.X (none : Option ℕ+) * MvPolynomial.X (some i))

/-- The source ring `k[x, y₁, y₂, ...] / (x * yᵢ)`. -/
abbrev Source (k : Type u) [CommRing k] : Type u :=
  PolynomialRing k ⧸ relationIdeal k

/-- The class of `x` in the source ring. -/
def x (k : Type u) [CommRing k] : Source k :=
  Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X (none : Option ℕ+))

/-- The class of `yᵢ` in the source ring. -/
def yInSource (k : Type u) [CommRing k] (i : ℕ+) : Source k :=
  Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X (some i))

/-- The target ring `A = Source k / (x)`. -/
abbrev Target (k : Type u) [CommRing k] : Type u :=
  Source k ⧸ principalIdeal (x k)

/-- The class of `yᵢ` in the target ring. -/
def y (k : Type u) [CommRing k] (i : ℕ+) : Target k :=
  Ideal.Quotient.mk (principalIdeal (x k)) (yInSource k i)

namespace Target

/-- The quotient map from `Source k` to `Target k` is finitely presented. -/
@[stacks 07CB "finite presentation of the target quotient"]
instance instFinitePresentation (k : Type u) [CommRing k] :
    FinitePresentation (Source k) (Target k) := sorry

end Target

/-- Example 16.2.6 (1): the smooth locus of `Source k → Target k` is the union of the basic
opens `D(yᵢ)`. -/
@[stacks 07CB]
theorem smoothLocus_eq_iUnion_basicOpen (k : Type u) [CommRing k] :
    smoothLocus (Source k) (Target k) =
      ⋃ i : ℕ+, (PrimeSpectrum.basicOpen (y k i) : Set (PrimeSpectrum (Target k))) := sorry

/-- Example 16.2.6 (2): over a nontrivial coefficient ring, this smooth locus is not
quasi-compact. -/
@[stacks 07CB]
theorem smoothLocus_not_isCompact (k : Type u) [CommRing k] [Nontrivial k] :
    ¬ IsCompact (smoothLocus (Source k) (Target k)) := sorry

end Algebra.SmoothCounterexample
