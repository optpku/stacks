module

public import ReasLib.AlgebraicGeometry.RelativeCycle
public import ReasLib.AlgebraicGeometry.Scheme.Morphism.FiberCycleFamily.Hilbert
public import ReasLib.AlgebraicGeometry.Scheme.Morphism.FiniteType

/-!
# Hilbert generators for relative cycles

This file defines flat closed subschemes of bounded relative dimension and the
relative-cycle homomorphism generated by their fibrewise cycle families.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.RelativeCycle

/-- A Hilbert generator is a closed subscheme of `X` that is flat over `S` and
has relative dimension at most `r`. -/
structure Hilb {X S : Scheme.{u}} (f : X ⟶ S) (r : ℕ) where
  /-- The ideal sheaf defining the closed subscheme. -/
  ideal : X.IdealSheafData
  /-- The structure morphism of the closed subscheme is flat. -/
  flat : Flat (ideal.subschemeι ≫ f)
  /-- The structure morphism has relative dimension at most `r`. -/
  relativeDimensionLE : Scheme.Hom.RelativeDimensionLE (ideal.subschemeι ≫ f) r

namespace Hilb

/-- Construct a Hilbert generator from ideal-sheaf data and its two defining
properties. -/
def ofIdeal {X S : Scheme.{u}} (f : X ⟶ S) (r : ℕ) (ideal : X.IdealSheafData)
    (flat : Flat (ideal.subschemeι ≫ f))
    (relativeDimensionLE : Scheme.Hom.RelativeDimensionLE (ideal.subschemeι ≫ f) r) :
    Hilb f r where
  ideal := ideal
  flat := flat
  relativeDimensionLE := relativeDimensionLE

/-- The structure morphism of a Hilbert generator. -/
def structureMap {X S : Scheme.{u}} {f : X ⟶ S} {r : ℕ} (Z : Hilb f r) :
    Z.ideal.subscheme ⟶ S :=
  Z.ideal.subschemeι ≫ f

/-- The structure morphism is the closed immersion followed by the ambient
scheme morphism. -/
theorem structureMap_def {X S : Scheme.{u}} {f : X ⟶ S} {r : ℕ} (Z : Hilb f r) :
    Z.structureMap = Z.ideal.subschemeι ≫ f := sorry

/-- The structure morphism of a Hilbert generator is flat. -/
theorem flat_structureMap {X S : Scheme.{u}} {f : X ⟶ S} {r : ℕ} (Z : Hilb f r) :
    Flat Z.structureMap := sorry

/-- The structure morphism of a Hilbert generator has relative dimension at
most `r`. -/
theorem relativeDimensionLE_structureMap {X S : Scheme.{u}} {f : X ⟶ S} {r : ℕ}
    (Z : Hilb f r) : Scheme.Hom.RelativeDimensionLE Z.structureMap r := sorry

/-- A Hilbert generator satisfies the closed-immersion, flatness, and relative
dimension conditions defining its geometric interpretation. -/
theorem spec {X S : Scheme.{u}} {f : X ⟶ S} {r : ℕ} (Z : Hilb f r) :
    IsClosedImmersion Z.ideal.subschemeι ∧
      Flat Z.structureMap ∧
      Scheme.Hom.RelativeDimensionLE Z.structureMap r := sorry

end Hilb

/-- An ideal-sheaf datum is recognized as a Hilbert generator when its
structure morphism is flat of relative dimension at most `r`. -/
def IsHilb {X S : Scheme.{u}} (f : X ⟶ S) (r : ℕ) (Z : X.IdealSheafData) : Prop :=
  Flat (Z.subschemeι ≫ f) ∧ Scheme.Hom.RelativeDimensionLE (Z.subschemeι ≫ f) r

/-- An ideal-sheaf datum is represented by a Hilbert generator exactly when it
satisfies the flatness and relative-dimension conditions. -/
theorem isHilb_iff {X S : Scheme.{u}} (f : X ⟶ S) (r : ℕ) (Z : X.IdealSheafData) :
    (∃ Z' : Hilb f r, Z'.ideal = Z) ↔ IsHilb f r Z := sorry

/-- The fibrewise `r`-cycle family associated to a Hilbert generator. -/
noncomputable def cycleClass {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f]
    (r : ℕ) (Z : Hilb f r) : f.FiberCycleFamily r :=
  f.closedSubschemeFiberCycleFamily Z.ideal r
    (Scheme.Hom.fiberClosedSubschemeDimensionLE_of_relativeDimensionLE f Z.ideal r
      Z.relativeDimensionLE)

/-- The cycle family of a Hilbert generator is given by the canonical closed
subscheme fibre-cycle construction. -/
theorem cycleClass_eq {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f]
    (r : ℕ) (Z : Hilb f r) :
    cycleClass f r Z =
      f.closedSubschemeFiberCycleFamily Z.ideal r
        (Scheme.Hom.fiberClosedSubschemeDimensionLE_of_relativeDimensionLE f Z.ideal r
          Z.relativeDimensionLE) := sorry

/-- The cycle family associated to a Hilbert generator is a relative cycle. -/
theorem cycleClass_isRelative {X S : Scheme.{u}} (f : X ⟶ S)
    [IsLocallyNoetherian S] [LocallyOfFiniteType f] (r : ℕ) (Z : Hilb f r) :
    IsRelative (cycleClass f r Z) := sorry

/-- The additive homomorphism extending Hilbert-generator cycle families. -/
noncomputable def cycleClassHom {X S : Scheme.{u}} (f : X ⟶ S)
    [LocallyOfFiniteType f] (r : ℕ) :
    FreeAbelianGroup (Hilb f r) →+ f.FiberCycleFamily r :=
  FreeAbelianGroup.lift (cycleClass f r)

/-- The cycle-class homomorphism maps a free generator to its cycle family. -/
theorem cycleClassHom_of {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f]
    (r : ℕ) (Z : Hilb f r) :
    cycleClassHom f r (FreeAbelianGroup.of Z) = cycleClass f r Z := sorry

/-- Every value of the Hilbert cycle-class homomorphism is a relative cycle. -/
theorem cycleClassHom_isRelative {X S : Scheme.{u}} (f : X ⟶ S)
    [IsLocallyNoetherian S] [LocallyOfFiniteType f] (r : ℕ)
    (σ : FreeAbelianGroup (Hilb f r)) :
    IsRelative (cycleClassHom f r σ) := sorry

/-- Every value of the Hilbert cycle-class homomorphism belongs to the relative
cycle subgroup. -/
theorem cycleClassHom_mem_group {X S : Scheme.{u}} (f : X ⟶ S)
    [IsLocallyNoetherian S] [LocallyOfFiniteType f] (r : ℕ)
    (σ : FreeAbelianGroup (Hilb f r)) :
    cycleClassHom f r σ ∈ group f r := sorry

/-- The Hilbert cycle-class homomorphism with codomain restricted to relative
cycles. -/
noncomputable def cycleClassHomToGroup {X S : Scheme.{u}} (f : X ⟶ S)
    [IsLocallyNoetherian S] [f.FiniteType] (r : ℕ) :
    FreeAbelianGroup (Hilb f r) →+ group f r :=
  (cycleClassHom f r).codRestrict (group f r) (cycleClassHom_mem_group f r)

/-- The underlying family of the subgroup-valued cycle-class homomorphism is
the unrestricted cycle-class homomorphism. -/
@[simp]
theorem coe_cycleClassHomToGroup {X S : Scheme.{u}} (f : X ⟶ S)
    [IsLocallyNoetherian S] [f.FiniteType] (r : ℕ)
    (σ : FreeAbelianGroup (Hilb f r)) :
    (cycleClassHomToGroup f r σ).val = cycleClassHom f r σ := sorry

end AlgebraicGeometry.RelativeCycle
