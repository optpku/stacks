module

public import Mathlib.RingTheory.NoetherNormalization
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Noether normalization for polynomial quotients

The declarations here provide the finite polynomial-algebra maps that underlie
the quotient and finite-type forms of Noether normalization.
-/

open MvPolynomial

namespace MvPolynomial.NoetherNormalization

universe u

section

variable {k : Type u} [Field k] {n : ℕ}

/-- Lemma 10.115.3, tag 00OX: a quotient by a nonzero ideal in a polynomial ring in `n + 1`
variables is finite over the algebra generated by `n` suitably chosen integral-coordinate
polynomials. -/
@[stacks 00OX]
theorem exists_finite_quotient_generators
    (I : Ideal (MvPolynomial (Fin (n + 1)) k)) (hI : I ≠ ⊥) :
    ∃ y : Fin n → MvPolynomial (Fin (n + 1)) k,
      (∀ i, y i ∈ Algebra.adjoin ℤ (Set.range (X : Fin (n + 1) → MvPolynomial (Fin (n + 1)) k))) ∧
      let g : MvPolynomial (Fin n) k →ₐ[k] ((MvPolynomial (Fin (n + 1)) k) ⧸ I) :=
        MvPolynomial.aeval fun i ↦ Ideal.Quotient.mk I (y i)
      AlgHom.Finite g := sorry

/-- Lemma 10.115.4 (1), tag 00OY: every proper quotient of a finite-variable polynomial algebra
over a field admits a finite injective polynomial normalization whose generators lie in the
integral coordinate subalgebra. -/
@[stacks 00OY]
theorem exists_finite_injective_quotient_normalization
    (I : Ideal (MvPolynomial (Fin n) k)) (hIproper : I ≠ ⊤) :
    ∃ r : ℕ, ∃ y : Fin r → MvPolynomial (Fin n) k,
      (∀ i, y i ∈ Algebra.adjoin ℤ (Set.range (X : Fin n → MvPolynomial (Fin n) k))) ∧
      let g : MvPolynomial (Fin r) k →ₐ[k] ((MvPolynomial (Fin n) k) ⧸ I) :=
        MvPolynomial.aeval fun i ↦ Ideal.Quotient.mk I (y i)
      Function.Injective g ∧ AlgHom.Finite g := sorry

end

end MvPolynomial.NoetherNormalization
