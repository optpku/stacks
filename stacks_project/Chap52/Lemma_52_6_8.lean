module

public import stacks_project.Chap52.Lemma_52_6_1
public import stacks_project.Chap52.Lemma_52_6_11
public import stacks_project.Chap52.«52_7_0_1_Completion»
public import ReasLib.Algebra.Homology.CochainComplex.Nat.Derived
public import ReasLib.CategoryTheory.Monoidal.Closed.Functoriality

@[expose] public section

open CategoryTheory CategoryTheory.MonoidalCategory
open SheafOfModules.RingedSite SheafOfModules.RingedSite.ExtendedCech

noncomputable section

universe u

namespace RingedSite.Hom.ModuleDerived
namespace CechCompletion

variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})]
variable [J.HasSheafCompose (forget₂ RingCat.{u} AddCommGrpCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable [HasWeakSheafify J CommRingCat.{u}]
variable [J.WEqualsLocallyBijective CommRingCat.{u}]
variable {O : Sheaf J CommRingCat.{u}}
variable [MonoidalCategory (RingedSiteDerived J O)]

/-- The explicit Čech completion functor `K ↦ RHom_O(Čech(f), K)` on the derived
category of modules over a ringed site. -/
noncomputable abbrev functor {r : ℕ}
    (H : MonoidalClosed (RingedSiteDerived J O))
    (f : Fin r → (unitModule J O).sections) :
    RingedSiteDerived J O ⥤ RingedSiteDerived J O :=
  MonoidalClosed.ihomOf H (ExtendedCech.derived f)

/-- The value `RHom_O(Čech(f), K)` of the explicit Čech completion functor. -/
noncomputable abbrev obj {r : ℕ}
    (H : MonoidalClosed (RingedSiteDerived J O))
    (f : Fin r → (unitModule J O).sections) (K : RingedSiteDerived J O) :
    RingedSiteDerived J O :=
  (functor H f).obj K

/-- The functorial map from `K` to `RHom_O(Čech(f), K)` induced by the Čech projection
and an explicit identification of the degree-zero structure module with the tensor unit. -/
noncomputable def unit {r : ℕ}
    (H : MonoidalClosed (RingedSiteDerived J O))
    (s : (DerivedCategory.singleFunctor (ringedSiteModuleCategory J O) (0 : ℤ)).obj
      (unitModule J O) ≅ 𝟙_ (RingedSiteDerived J O))
    (f : Fin r → (unitModule J O).sections) :
    𝟭 (RingedSiteDerived J O) ⟶ functor H f :=
  MonoidalClosed.unitOfPreOfIsoUnit H s (ExtendedCech.projection f)

/-- The explicit Čech completion object is derived complete with respect to the ideal
generated by the chosen sections. -/
theorem obj_isDerivedComplete {r : ℕ} (I : Subobject (unitModule J O))
    (f : Fin r → (unitModule J O).sections) (hgen : generatedIdeal f = I)
    (H : MonoidalClosed (RingedSiteDerived J O)) (K : RingedSiteDerived J O) :
    IsDerivedCompleteWithRespectTo.{u, u, u, u} (obj H f K) I := sorry

/-- Lemma 52.6.8 (1): the map from `K` to its functorial Čech/internal-Hom completion
is a derived completion with respect to the ideal generated by the chosen sections. -/
@[stacks 099B]
theorem unit_isDerivedCompletion {r : ℕ} (I : Subobject (unitModule J O))
    (f : Fin r → (unitModule J O).sections) (hgen : generatedIdeal f = I)
    (H : MonoidalClosed (RingedSiteDerived J O))
    (s : (DerivedCategory.singleFunctor (ringedSiteModuleCategory J O) (0 : ℤ)).obj
      (unitModule J O) ≅ 𝟙_ (RingedSiteDerived J O))
    (K : RingedSiteDerived J O) :
    IsDerivedCompletion.{u, u, u, u} I ((unit H s f).app K) := sorry

/-- Precomposition with the explicit Čech-completion unit is a bijection on morphisms into
every object derived complete with respect to the generated ideal. -/
theorem unit_bijective {r : ℕ} (I : Subobject (unitModule J O))
    (f : Fin r → (unitModule J O).sections) (hgen : generatedIdeal f = I)
    (H : MonoidalClosed (RingedSiteDerived J O))
    (s : (DerivedCategory.singleFunctor (ringedSiteModuleCategory J O) (0 : ℤ)).obj
      (unitModule J O) ≅ 𝟙_ (RingedSiteDerived J O))
    (K E : RingedSiteDerived J O)
    (hE : IsDerivedCompleteWithRespectTo.{u, u, u, u} E I) :
    Function.Bijective
      (fun φ : obj H f K ⟶ E ↦ (unit H s f).app K ≫ φ) := sorry

/-- The explicit Čech completion functor lifted to the full subcategory of objects derived
complete with respect to `I`. -/
noncomputable def toComplete {r : ℕ} (I : Subobject (unitModule J O))
    (f : Fin r → (unitModule J O).sections) (hgen : generatedIdeal f = I)
    (H : MonoidalClosed (RingedSiteDerived J O)) :
    RingedSiteDerived J O ⥤
      (derivedCompleteObjectProperty.{u, u, u, u} I).FullSubcategory :=
  (derivedCompleteObjectProperty.{u, u, u, u} I).lift (functor H f)
    (fun K ↦ obj_isDerivedComplete I f hgen H K)

/-- After inclusion into the ambient derived category, `toComplete` is canonically isomorphic
to the explicit internal-Hom functor. -/
noncomputable def toCompleteCompInclusionIso {r : ℕ}
    (I : Subobject (unitModule J O))
    (f : Fin r → (unitModule J O).sections) (hgen : generatedIdeal f = I)
    (H : MonoidalClosed (RingedSiteDerived J O)) :
    toComplete I f hgen H ⋙ (derivedCompleteObjectProperty.{u, u, u, u} I).ι ≅
      functor H f :=
  (derivedCompleteObjectProperty.{u, u, u, u} I).liftCompιIso (functor H f)
    (fun K ↦ obj_isDerivedComplete I f hgen H K)

/-- Lemma 52.6.8 (2): the explicit Čech completion functor into derived-complete
objects is left adjoint to the inclusion into the ambient derived category. -/
@[stacks 099B]
theorem existsAdjunction {r : ℕ} (I : Subobject (unitModule J O))
    (f : Fin r → (unitModule J O).sections) (hgen : generatedIdeal f = I)
    (H : MonoidalClosed (RingedSiteDerived J O))
    (s : (DerivedCategory.singleFunctor (ringedSiteModuleCategory J O) (0 : ℤ)).obj
      (unitModule J O) ≅ 𝟙_ (RingedSiteDerived J O)) :
    Nonempty
      (toComplete I f hgen H ⊣ (derivedCompleteObjectProperty.{u, u, u, u} I).ι) := sorry

end CechCompletion
end RingedSite.Hom.ModuleDerived
