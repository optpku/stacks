module

import StacksCheckRecall
import ReasLib.RingTheory.Ideal.HilbertSamuel.KoszulMultiplicity

open scoped BigOperators

universe u

/- Theorem 43.15.5: for an ideal of definition generated by `r` elements, the degree-`r`
Hilbert--Samuel multiplicity of a finite module is the alternating sum of the lengths of the
homology modules of its coefficient Koszul complex. -/
@[stacks 0AZZ] #check (Ideal.HilbertSamuel.multiplicityInDegree_eq_koszulHomologyLengthSum :
  {R : Type u} → [CommRing R] → [IsLocalRing R] → [IsNoetherianRing R] →
    {M : Type u} → [AddCommGroup M] → [Module R M] → [Module.Finite R M] →
      (r : ℕ) → (I : Ideal R) → (f : Fin r → R) →
        Ideal.span (Set.range f) = I → I.IsIdealOfDefinition →
          Ideal.HilbertSamuel.multiplicityInDegree I M r =
            ((∑ i ∈ Finset.range (r + 1), (Int.negOnePow i : ℤ) *
              ((Module.length R
                ((RingTheory.Sequence.koszulComplexOnTensorLeft R M f).homology i)).toNat : ℤ) : ℤ) : ℚ))
