module

public import Mathlib.CategoryTheory.Sites.Canonical
import Mathlib.Tactic.CrossRefAttribute

/-!
# Finest topologies generated by a family

This module gives the indexed-family interface to the canonical
`Sheaf.finestTopology` construction.  The API is independent of a chosen site
presentation and does not enlarge the import surface of raw family sheaf
conditions.
-/

@[expose] public section

universe u v w x

namespace CategoryTheory.Sheaf.Family

variable {C : Type u} [Category.{v} C]

/-- Every member of a family is a sheaf for the finest topology generated by
the range of that family. -/
theorem isSheaf_finestTopology {I : Type x} (F : I → Cᵒᵖ ⥤ Type w) (i : I) :
    Presieve.IsSheaf (finestTopology (Set.range F)) (F i) := sorry

/-- If every member of an indexed family is a sheaf for `J`, then `J` is below
the finest topology generated by the range of that family. -/
theorem le_finestTopology {I : Type x} (F : I → Cᵒᵖ ⥤ Type w)
    (J : GrothendieckTopology C) (hF : ∀ i, Presieve.IsSheaf J (F i)) :
    J ≤ finestTopology (Set.range F) := sorry

/-- A topology below the finest topology generated by a family makes every
member of the family a sheaf. -/
theorem isSheaf_of_le_finestTopology {I : Type x} (F : I → Cᵒᵖ ⥤ Type w)
    (J : GrothendieckTopology C) (hJ : J ≤ finestTopology (Set.range F)) (i : I) :
    Presieve.IsSheaf J (F i) := sorry

/-- A topology is below the finest topology generated by a family precisely
when every member of the family is a sheaf for it. -/
@[stacks 00Z9]
theorem le_finestTopology_iff {I : Type x} (F : I → Cᵒᵖ ⥤ Type w)
    (J : GrothendieckTopology C) :
    J ≤ finestTopology (Set.range F) ↔ ∀ i, Presieve.IsSheaf J (F i) := sorry

end CategoryTheory.Sheaf.Family
