module

public import ReasLib.CategoryTheory.Sites.Point.Reindexing.EssentiallySmall
public import ReasLib.CategoryTheory.Sites.Point.Reindexing.OrderEmbedding.Basic

/-!
# Order-embedding reindexing for essentially-small inverse systems

This module specializes essentially-small fiber reindexing to order embeddings
without requiring a bundled `OrderedRefinement` value.
-/

@[expose] public section

open CategoryTheory Opposite

universe u v q w₀ w₁ w₂

noncomputable section

namespace CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered.Reindexing.OrderEmbedding

namespace EssentiallySmall

variable {C : Type u} [Category.{v} C]
variable {ι : Type w₀} [Preorder ι]
variable {ι' : Type w₁} [Preorder ι']
variable {S : ιᵒᵖ ⥤ C}

section ExplicitUniverse

variable [LocallySmall.{q} C]
variable [CategoryTheory.EssentiallySmall.{q} ιᵒᵖ]
  [CategoryTheory.EssentiallySmall.{q} ι'ᵒᵖ]

/-- Internal smallness bridge used by the essentially-small order-embedding interface. -/
local instance sourceInitiallySmallOfEssentiallySmall : InitiallySmall.{q} ιᵒᵖ :=
  initiallySmall_of_essentiallySmall ιᵒᵖ

/-- Internal smallness bridge used by the essentially-small order-embedding interface. -/
local instance targetInitiallySmallOfEssentiallySmall : InitiallySmall.{q} ι'ᵒᵖ :=
  initiallySmall_of_essentiallySmall ι'ᵒᵖ

/-- The inverse-system fiber map of an order-embedding reindexing between essentially small
preorders.  The source and target indices may live in different universes; this hides the
implementation-level `InitiallySmall` instances used by the colimit model of fibers. -/
noncomputable abbrev fiberMap
    (j : ι ↪o ι') (T : ι'ᵒᵖ ⥤ C) (e : S ≅ (j.toOrderHom.toFunctor).op ⋙ T) :
    EssentiallySmallFiber.fiber S ⟶ EssentiallySmallFiber.fiber T :=
  CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered.Reindexing.EssentiallySmall.fiber.{u, v, q, w₀, w₁, w₀, w₁}
    j.toOrderHom.toFunctor T e

namespace fiberMap

namespace app

/-- The essentially-small order-embedding fiber map sends a canonical generator to its
transported target generator. -/
@[simp]
theorem fiberMk
    (j : ι ↪o ι') (T : ι'ᵒᵖ ⥤ C) (e : S ≅ (j.toOrderHom.toFunctor).op ⋙ T)
    {U : ιᵒᵖ} {W : C} (f : S.obj U ⟶ W) :
    (fiberMap j T e).app W (ofIsCofiltered.fiberMk.{q} f) =
      ofIsCofiltered.fiberMk.{q} (p := T) (e.inv.app U ≫ f) := sorry

/-- The essentially-small order-embedding fiber map has the expected formula on
encapsulated canonical generators. -/
@[simp]
theorem mk
    (j : ι ↪o ι') (T : ι'ᵒᵖ ⥤ C) (e : S ≅ (j.toOrderHom.toFunctor).op ⋙ T)
    {U : ιᵒᵖ} {W : C} (f : S.obj U ⟶ W) :
    (fiberMap j T e).app W (EssentiallySmallFiber.mk (S := S) f) =
      EssentiallySmallFiber.mk (S := T) (e.inv.app U ≫ f) := sorry

end app

/-- The identity order embedding acts as the identity through the essentially-small fiber
interface. -/
@[simp]
theorem id (S : ιᵒᵖ ⥤ C) :
    fiberMap (OrderEmbedding.id ι) S (OrderEmbedding.idIso S) =
      𝟙 (EssentiallySmallFiber.fiber S) := sorry

section Composition

variable {ι'' : Type w₂} [Preorder ι'']
variable [CategoryTheory.EssentiallySmall.{q} ι''ᵒᵖ]
variable {T : ι'ᵒᵖ ⥤ C} {U : ι''ᵒᵖ ⥤ C}

/-- Essentially-small maps of successive order-embedding reindexings compose
to the map of their composite. -/
@[simp]
theorem comp
    (j : ι ↪o ι') (k : ι' ↪o ι'')
    (e : S ≅ (j.toOrderHom.toFunctor).op ⋙ T)
    (e' : T ≅ (k.toOrderHom.toFunctor).op ⋙ U) :
    fiberMap (j.comp k) U (OrderEmbedding.compIso j k e e') =
      fiberMap j T e ≫ fiberMap k U e' := sorry

end Composition

end fiberMap

end ExplicitUniverse

section CanonicalUniverse

variable [LocallySmall.{max u v w₀ w₁} C]
variable [CategoryTheory.EssentiallySmall.{max u v w₀ w₁} ιᵒᵖ]
  [CategoryTheory.EssentiallySmall.{max u v w₀ w₁} ι'ᵒᵖ]

/-- The essentially-small order-embedding fiber map in the canonical universe generated by the
ambient category and both index preorders. This is the default interface when no separate fiber
universe is mathematically significant; use `fiberMap` to prescribe one explicitly. -/
noncomputable abbrev fiberMapMax
    (j : ι ↪o ι') (T : ι'ᵒᵖ ⥤ C) (e : S ≅ (j.toOrderHom.toFunctor).op ⋙ T) :
    EssentiallySmallFiber.fiber.{u, v, max u v w₀ w₁, w₀, w₀} S ⟶
      EssentiallySmallFiber.fiber.{u, v, max u v w₀ w₁, w₁, w₁} T :=
  fiberMap.{u, v, max u v w₀ w₁, w₀, w₁} j T e

namespace fiberMapMax

namespace app

/-- The canonical-universe essentially-small order-embedding map transports the encapsulated
fiber generators along the supplied restriction isomorphism. -/
@[simp]
theorem mk
    (j : ι ↪o ι') (T : ι'ᵒᵖ ⥤ C) (e : S ≅ (j.toOrderHom.toFunctor).op ⋙ T)
    {U : ιᵒᵖ} {W : C} (f : S.obj U ⟶ W) :
    (fiberMapMax j T e).app W (EssentiallySmallFiber.mk (S := S) f) =
      EssentiallySmallFiber.mk (S := T) (e.inv.app U ≫ f) := sorry

end app

end fiberMapMax

end CanonicalUniverse

end EssentiallySmall

end CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered.Reindexing.OrderEmbedding
