module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.CategoryTheory.IsomorphismClasses
public import Mathlib.RingTheory.Ideal.Cotangent
public import ReasLib.Algebra.Homology.DerivedCategory.ModuleCat
public import stacks_project.Chap110.Lemma_110_43_1_Cotangent
import Mathlib.Tactic.CrossRefAttribute

/-!
# Cotangent complex of evaluation at zero on a polynomial ring

This file identifies `L_{B/A}` in `D(B)` with the conormal module `I/I²`
placed in cohomological degree `-1`, for the evaluation map
`MvPolynomial σ R →+* R` sending each variable to `0`.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits
open Algebra

universe u

noncomputable section

namespace Algebra.CotangentComplex

/-- Lemma 92.14.1. Let `A = MvPolynomial (Fin n) ℤ → B = ℤ` be the ring map sending
each `X i` to `0`. Let `I = Ideal.span (Set.range MvPolynomial.X) ⊂ A`. Then `L_{B/A}`
is quasi-isomorphic to `I.Cotangent` placed in cohomological degree `-1`. Recorded here
as an isomorphism in `D(ℤ)` between `DerivedCategory.Q.obj` of
`RingHom.cotangentComplex MvPolynomial.constantCoeff` and the image of
`ModuleCat.of ℤ I.Cotangent` under `DerivedCategory.singleFunctor` in cohomological
degree `-1`. -/
@[stacks 08SI]
theorem evalAtZero_isIsomorphic_single_conormal (n : ℕ) :
    IsIsomorphic
      (DerivedCategory.Q.obj (RingHom.cotangentComplex
        (MvPolynomial.constantCoeff : MvPolynomial (Fin n) ℤ →+* ℤ)))
      ((DerivedCategory.singleFunctor (ModuleCat.{0} ℤ) (-1 : ℤ)).obj
        (ModuleCat.of ℤ
          ((Ideal.span (Set.range (MvPolynomial.X : Fin n → MvPolynomial (Fin n) ℤ))).Cotangent))) :=
  sorry

section

variable {R : Type u} [CommRing R] {σ : Type u}

/-- The André-Quillen complex of `MvPolynomial.constantCoeff : MvPolynomial σ R →+* R`
is isomorphic in `D(R)` to the conormal module of `Ideal.span (Set.range MvPolynomial.X)`
placed in cohomological degree `-1`. -/
theorem constantCoeff_isIsomorphic_single_conormal :
    IsIsomorphic
      (DerivedCategory.Q.obj (RingHom.cotangentComplex
        (MvPolynomial.constantCoeff : MvPolynomial σ R →+* R)))
      ((DerivedCategory.singleFunctor (ModuleCat.{u} R) (-1 : ℤ)).obj
        (ModuleCat.of R
          ((Ideal.span (Set.range (MvPolynomial.X : σ → MvPolynomial σ R))).Cotangent))) :=
  sorry

/-- The kernel of `MvPolynomial.constantCoeff` is the ideal generated by the variables. -/
theorem evalAtZero_ker_eq_span_X :
    RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial σ R →+* R) =
      Ideal.span (Set.range (MvPolynomial.X : σ → MvPolynomial σ R)) :=
  sorry

/-- `MvPolynomial.constantCoeff` is a surjective ring map. -/
theorem constantCoeff_surjective :
    Function.Surjective (MvPolynomial.constantCoeff : MvPolynomial σ R →+* R) :=
  sorry

/-- The André-Quillen homology of `MvPolynomial.constantCoeff` vanishes in every
cohomological degree other than `-1`. -/
theorem constantCoeff_homology_isZero_of_ne_negOne {n : ℤ} (hn : n ≠ -1) :
    IsZero
      ((RingHom.cotangentComplex
        (MvPolynomial.constantCoeff : MvPolynomial σ R →+* R)).homology n) :=
  sorry

/-- `H^{-1}` of the André-Quillen complex of `MvPolynomial.constantCoeff` is isomorphic
to the conormal module of the ideal generated by the variables. -/
theorem constantCoeff_homology_negOne_isIsomorphic :
    IsIsomorphic
      ((RingHom.cotangentComplex
        (MvPolynomial.constantCoeff : MvPolynomial σ R →+* R)).homology (-1))
      (ModuleCat.of R
        ((Ideal.span (Set.range (MvPolynomial.X : σ → MvPolynomial σ R))).Cotangent)) :=
  sorry

end

end Algebra.CotangentComplex

end
