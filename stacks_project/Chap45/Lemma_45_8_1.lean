module

public import ReasLib.AlgebraicGeometry.ChowGroup.SeparableClosedPoints
import StacksCheckRecall

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace

noncomputable section

universe u

/- Lemma 45.8.1: if `X` is smooth and projective over a field `k`, then
`CH₀(X)` is generated by the classes of closed points whose residue fields are
separable over `k`. -/
@[stacks 0FH5] #check
  (AlgebraicGeometry.ChowGroup.closure_separableClosedPointClasses_eq_top :
    ∀ {k : Type u} [Field k] (X : AlgebraicGeometry.SchemeOverField k)
      [AlgebraicGeometry.Smooth X.hom] [AlgebraicGeometry.Projective X.hom],
    AddSubgroup.closure
      {alpha : @AlgebraicGeometry.ChowGroup X.left
          (AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian X.hom)
          (X.hom.relativeDimensionFunction
            (fun _ : Spec (CommRingCat.of k) ↦ 0)) inferInstance 0 |
        ∃ x : closedPoints X.left,
          Algebra.IsSeparable k (X.left.residueField x) ∧
            alpha = @AlgebraicGeometry.chowClass X.left
              (AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian X.hom)
              (X.hom.relativeDimensionFunction
                (fun _ : Spec (CommRingCat.of k) ↦ 0)) inferInstance 0
              (AlgebraicGeometry.CycleGroup.point
                (X.hom.relativeDimensionFunction
                  (fun _ : Spec (CommRingCat.of k) ↦ 0)) 0 x
                (AlgebraicGeometry.SchemeOverField.closedPoint_relativeDimensionFunction_eq_zero
                  X x))} = ⊤)
