module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Quasicoherent
public import ReasLib.AlgebraicGeometry.RingedSpace.IdealSubobject.LocalGeneration
public import ReasLib.AlgebraicGeometry.Scheme.IdealSubobject

/-!
# Quasi-coherent ideal subobjects
-/

@[expose] public section

open CategoryTheory

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme.IdealSubobject

variable {X : Scheme.{u}}

/-- An ideal subobject on a scheme is locally generated by sections exactly when its module
sheaf is quasi-coherent. -/
@[stacks 01IN "quasi-coherent ideal sheaves"]
theorem isLocallyGeneratedBySections_iff_isQuasicoherent
    (I : Scheme.IdealSubobject X) :
    I.IsLocallyGeneratedBySections ↔ I.toModule.IsQuasicoherent := sorry

/-- A locally generated ideal subobject of a scheme is represented by ideal-sheaf data. -/
@[stacks 01QQ]
theorem exists_idealSheafData_of_isLocallyGeneratedBySections
    (I : Scheme.IdealSubobject X) (hI : I.IsLocallyGeneratedBySections) :
    ∃ J : X.IdealSheafData, J.toSubobject = I := sorry

/-- An ideal subobject identified with the kernel ideal of a closed immersion is
quasi-coherent. -/
@[stacks 01QQ]
theorem isQuasicoherent_of_eq_kernelIdealSubobject
    {Z : Scheme.{u}} (I : Scheme.IdealSubobject X) (i : Z ⟶ X)
    [IsClosedImmersion i] (hker : i.kernelIdealSubobject = I) :
    I.toModule.IsQuasicoherent := sorry

end AlgebraicGeometry.Scheme.IdealSubobject

namespace AlgebraicGeometry.Scheme.Modules.IdealSubobject

variable {X : Scheme.{u}}

/-- In Mathlib's `Scheme.Modules` presentation, an ideal subobject of the structure sheaf is
locally generated by sections exactly when its underlying module sheaf is quasi-coherent. -/
@[stacks 01IN "quasi-coherent ideal sheaves in the scheme-module presentation"]
theorem isLocallyGeneratedBySections_iff_isQuasicoherent
    (I : Subobject (SheafOfModules.unit X.ringCatSheaf : X.Modules)) :
    SheafOfModules.IsLocallyGeneratedBySections (Subobject.underlying.obj I) ↔
      (Subobject.underlying.obj I).IsQuasicoherent := sorry

end AlgebraicGeometry.Scheme.Modules.IdealSubobject
