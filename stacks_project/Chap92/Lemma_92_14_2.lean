module

public import ReasLib.RingTheory.CotangentComplex.KoszulRegular
import StacksCheckRecall

open CategoryTheory
open CategoryTheory.Limits
open Algebra

universe u

/- Lemma 92.14.2. A surjective ring map whose kernel is generated by a
Koszul-regular sequence has cotangent complex quasi-isomorphic to `I/I²[1]`. -/
@[stacks 08SJ] #check (Algebra.CotangentComplex.koszulRegularSequence_isIsomorphic_single_conormal :
  ∀
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    (h : Function.Surjective (algebraMap A B)) {r : ℕ} {f : Fin r → A}
    (hf : RingTheory.Sequence.IsKoszulRegularSequence f)
    (hI : Ideal.span (Set.range f) = RingHom.ker (algebraMap A B)),
    IsIsomorphic
      (DerivedCategory.Q.obj (Algebra.cotangentComplex A B))
      ((DerivedCategory.singleFunctor (ModuleCat.{u} B) (-1 : ℤ)).obj
        (ModuleCat.of B (Extension.ofSurjective (Algebra.ofId A B) h).Cotangent)))

#check (Algebra.CotangentComplex.koszulRegularSequence_homology_isZero_of_ne_negOne :
  ∀
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    (h : Function.Surjective (algebraMap A B)) {r : ℕ} {f : Fin r → A}
    (hf : RingTheory.Sequence.IsKoszulRegularSequence f)
    (hI : Ideal.span (Set.range f) = RingHom.ker (algebraMap A B))
    {n : ℤ} (hn : n ≠ -1),
    IsZero ((Algebra.cotangentComplex A B).homology n))

#check (Algebra.CotangentComplex.koszulRegularSequence_homology_negOne_isIsomorphic :
  ∀
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    (h : Function.Surjective (algebraMap A B)) {r : ℕ} {f : Fin r → A}
    (hf : RingTheory.Sequence.IsKoszulRegularSequence f)
    (hI : Ideal.span (Set.range f) = RingHom.ker (algebraMap A B)),
    IsIsomorphic
      ((Algebra.cotangentComplex A B).homology (-1))
      (ModuleCat.of B (Extension.ofSurjective (Algebra.ofId A B) h).Cotangent))

#check (Algebra.CotangentComplex.regularSequence_isIsomorphic_single_conormal :
  ∀
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    (h : Function.Surjective (algebraMap A B)) {r : ℕ} {f : Fin r → A}
    (hf : RingTheory.Sequence.IsRegular A (List.ofFn f))
    (hI : Ideal.span (Set.range f) = RingHom.ker (algebraMap A B)),
    IsIsomorphic
      (DerivedCategory.Q.obj (Algebra.cotangentComplex A B))
      ((DerivedCategory.singleFunctor (ModuleCat.{u} B) (-1 : ℤ)).obj
        (ModuleCat.of B (Extension.ofSurjective (Algebra.ofId A B) h).Cotangent)))

#check (Algebra.CotangentComplex.quotient_koszulRegularSequence_isIsomorphic_single_conormal :
  ∀
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (hf : RingTheory.Sequence.IsKoszulRegularSequence f),
    IsIsomorphic
      (DerivedCategory.Q.obj (Algebra.cotangentComplex A (A ⧸ Ideal.span (Set.range f))))
      ((DerivedCategory.singleFunctor
          (ModuleCat.{u} (A ⧸ Ideal.span (Set.range f))) (-1 : ℤ)).obj
        (ModuleCat.of (A ⧸ Ideal.span (Set.range f))
          (Ideal.span (Set.range f)).Cotangent)))

