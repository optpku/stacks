/-!
# Lemma 71.18.9

The strict transform of a finite-type quasi-coherent module on an algebraic
space, along the blowup in the closed subspace cut out by its `k`th Fitting
ideal, is étale-locally generated by `k` sections.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.AlgebraicSpace

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.fittingIdealSheaf

/-- The `k`th Fitting ideal of a finite-type quasi-coherent module is a
quasi-coherent ideal subobject. -/
instance instIsQuasiCoherent {S : Scheme.{u}} {B : AlgebraicSpace S}
    (F : B.Modules) [F.IsFiniteType] [F.IsQuasicoherent] (k : ℕ) :
    IsQuasiCoherent (fittingIdealSheaf F k) :=
  sorry

/-- Lemma 71.18.9: let `S` be a scheme, let `B` be an algebraic space over `S`,
and let `F` be a finite-type quasi-coherent `𝒪_B`-module. Let `Z_k ⊂ B` be the
closed subspace cut out by `Fit_k(F)`, let `π` be a blowup of `B` in `Z_k`, and
let `F'` be the strict transform of `F`. Then `F'` is étale-locally generated by
`k` sections. -/
@[stacks 0D0P, instance]
instance strictTransformModule_isLocallyGeneratedBy
    {S : Scheme.{u}} {B : AlgebraicSpace S} (F : B.Modules)
    [F.IsFiniteType] [F.IsQuasicoherent] (k : ℕ)
    (π : Blowup B (fittingIdealSheaf F k)) :
    SheafOfModules.IsLocallyGeneratedBy
      (strictTransformModule π.hom (Blowup.exceptionalDivisor π) (𝟙 B) F) k :=
  sorry

/-- The Fitting-blowup strict transform of `F` is generated by `k` sections on an
étale scheme neighbourhood of every point of the fibre-product ambient space. -/
theorem strictTransformModule_existsEtaleGeneratedBy
    {S : Scheme.{u}} {B : AlgebraicSpace S} (F : B.Modules)
    [F.IsFiniteType] [F.IsQuasicoherent] (k : ℕ)
    (π : Blowup B (fittingIdealSheaf F k))
    (x : Points (strictTransformAmbient π.hom (𝟙 B))) :
    Modules.existsEtaleGeneratedBy
      (strictTransformModule π.hom (Blowup.exceptionalDivisor π) (𝟙 B) F) x k :=
  sorry

end AlgebraicGeometry.AlgebraicSpace.fittingIdealSheaf
