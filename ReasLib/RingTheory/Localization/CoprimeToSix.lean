module

public import Mathlib.Algebra.Field.IsField
public import Mathlib.Data.Fin.VecNotation
public import Mathlib.RingTheory.Localization.Away.Basic

@[expose] public section

noncomputable section

namespace Localization.CoprimeToSix

/-- The ideal of `ℤ` generated by `2`. -/
def twoIdeal : Ideal ℤ :=
  Ideal.span {(2 : ℤ)}

/-- The ideal of `ℤ` generated by `3`. -/
def threeIdeal : Ideal ℤ :=
  Ideal.span {(3 : ℤ)}

/-- The principal ideal generated by `2` in `ℤ` is prime. -/
instance instTwoIdealIsPrime : twoIdeal.IsPrime := sorry

/-- The principal ideal generated by `3` in `ℤ` is prime. -/
instance instThreeIdealIsPrime : threeIdeal.IsPrime := sorry

/-- The multiplicative set of integers divisible by neither `2` nor `3`. -/
def denominators : Submonoid ℤ :=
  twoIdeal.primeCompl ⊓ threeIdeal.primeCompl

/-- An integer belongs to `denominators` exactly when neither `2` nor `3` divides it. -/
theorem mem_denominators_iff (integer : ℤ) :
    integer ∈ denominators ↔ ¬ 2 ∣ integer ∧ ¬ 3 ∣ integer := sorry

/-- The localization of `ℤ` at integers coprime to `6`. -/
abbrev Integers : Type :=
  Localization denominators

/-- The localization of `ℤ` at integers coprime to `6` is an integral domain. -/
instance instIsDomain : IsDomain Integers := sorry

/-- The image of `6` in the localization of `ℤ` at integers coprime to `6`. -/
def six : Integers :=
  algebraMap ℤ Integers 6

/-- The zero ideal and the extensions of the ideals generated by `2` and `3` to `Integers`. -/
def primes : Fin 3 → Ideal Integers :=
  ![⊥, twoIdeal.map (algebraMap ℤ Integers), threeIdeal.map (algebraMap ℤ Integers)]

/-- The zero ideal and the extensions of `(2)` and `(3)` are three distinct prime ideals
of the localization of `ℤ` at integers coprime to `6`. -/
theorem hasThreePairwiseDistinctPrimes :
    Function.Injective primes ∧ ∀ index, (primes index).IsPrime := sorry

/-- Inverting the image of `6` in the localization of `ℤ` at integers coprime to `6`
yields a field. -/
theorem isField_away_six : IsField (Localization.Away six) := sorry

end Localization.CoprimeToSix
