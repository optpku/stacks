module

import StacksCheckRecall
import ReasLib.AlgebraicGeometry.Scheme.Blowup.CoordinateCenter

open CategoryTheory

namespace AlgebraicGeometry.Blowup.CoordinateCenter

universe u

/- Remark 37.17.2 (1): the blowup of
`Spec (MvPolynomial (Fin n) (MvPolynomial (Fin m) R))` along the ideal generated by the
outer variables is smooth over `Spec R` when `n` is positive. -/
@[stacks 0H1H] #check
  (AlgebraicGeometry.Blowup.CoordinateCenter.smooth :
    ∀ (R : Type u) [CommRing R] (m n : ℕ) [NeZero n]
      (π : Blowup
        (Spec (.of (MvPolynomial (Fin n) (MvPolynomial (Fin m) R))))
        (Scheme.idealSheafDataOfIdealOnSpec
          (MvPolynomial.idealOfVars (Fin n) (MvPolynomial (Fin m) R)))),
      Smooth
        (π.hom ≫ Spec.map
          (CommRingCat.ofHom
            (algebraMap R (MvPolynomial (Fin n) (MvPolynomial (Fin m) R))))))

/- Remark 37.17.2 (2): the exceptional divisor of the coordinate-center blowup is smooth
over `Spec R` when `n` is positive. -/
@[stacks 0H1H] #check
  (AlgebraicGeometry.Blowup.CoordinateCenter.exceptionalDivisor_smooth :
    ∀ (R : Type u) [CommRing R] (m n : ℕ) [NeZero n]
      (π : Blowup
        (Spec (.of (MvPolynomial (Fin n) (MvPolynomial (Fin m) R))))
        (Scheme.idealSheafDataOfIdealOnSpec
          (MvPolynomial.idealOfVars (Fin n) (MvPolynomial (Fin m) R)))),
      Smooth
        (π.exceptionalDivisor.subschemeι ≫ π.hom ≫ Spec.map
          (CommRingCat.ofHom
            (algebraMap R (MvPolynomial (Fin n) (MvPolynomial (Fin m) R))))))

end AlgebraicGeometry.Blowup.CoordinateCenter
