module

public import Mathlib.RingTheory.Ideal.Quotient.Noetherian
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.Localization.Submodule
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Polynomial.Basic
public import Mathlib.RingTheory.KrullDimension.Basic
public import ReasLib.RingTheory.CohenMacaulay.Module

/-!
# The local ring of a line with an embedded point

This file defines the coordinate ring of the plane curve with relations
`x ^ 2 = 0` and `x * y = 0`, its origin ideal, and the localization at that
ideal.
-/

@[expose] public section

noncomputable section

universe u

open MvPolynomial

namespace MvPolynomial.LineWithEmbeddedPoint

variable (k : Type u) [Field k]

/-- The ideal generated by the square and mixed product of the coordinates. -/
def relationIdeal : Ideal (MvPolynomial (Fin 2) k) :=
  Ideal.span {X 0 ^ 2, X 0 * X 1}

/-- The defining ideal is generated by the square and mixed product relations. -/
theorem relationIdeal_eq_span :
    relationIdeal k = Ideal.span {X 0 ^ 2, X 0 * X 1} := sorry

/-- The coordinate ring of the line with an embedded point. -/
abbrev CoordinateRing : Type u :=
  MvPolynomial (Fin 2) k ⧸ relationIdeal k

/-- The class of the first coordinate variable in the coordinate ring. -/
def coordX : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (X 0)

/-- The class of the second coordinate variable in the coordinate ring. -/
def coordY : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (X 1)

/-- The first coordinate is square-zero in the coordinate ring. -/
theorem coordX_pow_two : coordX k ^ 2 = 0 := sorry

/-- The product of the two coordinate classes vanishes. -/
theorem coordX_mul_coordY : coordX k * coordY k = 0 := sorry

/-- The ideal of the origin in the coordinate ring. -/
def originIdeal : Ideal (CoordinateRing k) :=
  Ideal.span {coordX k, coordY k}

/-- The origin ideal is generated by the two coordinate classes. -/
theorem originIdeal_eq_span :
    originIdeal k = Ideal.span {coordX k, coordY k} := sorry

/-- The first coordinate class belongs to the origin ideal. -/
theorem coordX_mem_originIdeal : coordX k ∈ originIdeal k := sorry

/-- The second coordinate class belongs to the origin ideal. -/
theorem coordY_mem_originIdeal : coordY k ∈ originIdeal k := sorry

/-- The origin ideal is the image of the ideal generated by the polynomial variables. -/
theorem originIdeal_eq_map :
    originIdeal k =
      Ideal.map (Ideal.Quotient.mk (relationIdeal k)) (idealOfVars (Fin 2) k) := sorry

/-- The origin ideal is maximal in the coordinate ring. -/
instance originIdeal_isMaximal : (originIdeal k).IsMaximal := sorry

/-- The localization of the coordinate ring at its origin ideal. -/
abbrev LocalRing : Type u :=
  Localization.AtPrime (originIdeal k)

/-- The image of the second coordinate in the local ring. -/
def yParam : LocalRing k :=
  algebraMap (CoordinateRing k) (LocalRing k) (coordY k)

/-- The parameter is the localization image of the second coordinate class. -/
theorem yParam_eq :
    yParam k = algebraMap (CoordinateRing k) (LocalRing k) (coordY k) := sorry

/-- The local ring has Krull dimension one. -/
theorem ringKrullDim_localRing :
    ringKrullDim (LocalRing k) = 1 := sorry

/-- Every element of the maximal ideal is a zerodivisor. -/
theorem notMem_nonZeroDivisors_of_mem_maximalIdeal
    {a : LocalRing k} (ha : a ∈ IsLocalRing.maximalIdeal (LocalRing k)) :
    a ∉ nonZeroDivisors (LocalRing k) := sorry

/-- The exhibited parameter belongs to the maximal ideal of the local ring. -/
theorem yParam_mem_maximalIdeal :
    yParam k ∈ IsLocalRing.maximalIdeal (LocalRing k) := sorry

/-- The quotient by the exhibited parameter has Krull dimension zero. -/
theorem ringKrullDim_quotient_span_yParam :
    ringKrullDim (LocalRing k ⧸ Ideal.span {yParam k}) = 0 := sorry

/-- The exhibited parameter belongs to the maximal ideal and cuts the local ring to dimension zero. -/
theorem yParam_spec :
    yParam k ∈ IsLocalRing.maximalIdeal (LocalRing k) ∧
      ringKrullDim (LocalRing k ⧸ Ideal.span {yParam k}) = 0 := sorry

/-- The local ring of a line with an embedded point at the origin is not Cohen--Macaulay. -/
theorem localRing_not_cohenMacaulay :
    ¬ Module.CohenMacaulay (LocalRing k) (LocalRing k) := sorry

end MvPolynomial.LineWithEmbeddedPoint
