module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Cover.Fppf
public import ReasLib.CategoryTheory.Sites.IndexedSite.CardinalRank
public import Mathlib.CategoryTheory.Sites.Over

/-!
# Chosen big fppf sites of algebraic spaces

A chosen big fppf site retains set-indexed fppf covering families bounded by
both index cardinality and the rank of their complete family codes. Its
presieve presentation generates the fppf topology and can be localized at an
algebraic space.
-/

@[expose] public section

open CategoryTheory

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

/-- The set-indexed fppf covering families of an algebraic space over `S`. -/
def fppfSetIndexedCoverings (S : Scheme.{u}) (X : AlgebraicSpace S) :
    Set (SetIndexedFamily.{u + 1} X) :=
  {F | FppfCovering F.X F.f}

/-- Set-indexed fppf coverings satisfy the site axioms. -/
theorem fppfSetIndexedCoverings_isSite (S : Scheme.{u}) :
    SetIndexedFamily.IsSite (fppfSetIndexedCoverings S) :=
  sorry

/-- A chosen big fppf site consists of cardinal and limit-rank bounds whose
selected fppf families form a site and represent every fppf family up to
combinatorial equivalence. -/
structure ChosenBigFppfSite (S : Scheme.{u}) : Type (u + 2) where
  /-- The cardinal bound on index sets of selected covering families. -/
  bound : Cardinal.{u + 1}
  /-- The strict rank bound on complete codes of selected covering families. -/
  rankBound : Ordinal.{u + 1}
  /-- The rank bound is a limit ordinal. -/
  isSuccLimit : Order.IsSuccLimit rankBound
  /-- The selected covering families satisfy the site axioms. -/
  isSite : SetIndexedFamily.IsSite
    (SetIndexedFamily.restrictCardinalRank (fppfSetIndexedCoverings S) bound rankBound)
  /-- Every fppf family is combinatorially equivalent to a selected family. -/
  equivalent : ∀ (X : AlgebraicSpace S) (F : SetIndexedFamily.{u + 1} X),
    F ∈ fppfSetIndexedCoverings S X →
      ∃ G : SetIndexedFamily.{u + 1} X,
        G ∈ SetIndexedFamily.restrictCardinalRank
          (fppfSetIndexedCoverings S) bound rankBound X ∧
        SemiRepresentableFamily.Over.CombinatoriallyEquivalent F.toFamily G.toFamily

namespace ChosenBigFppfSite

variable {S : Scheme.{u}}

/-- Construct a chosen fppf site from bounds, the limit-ordinal and site laws,
and combinatorial replacement of all fppf families. -/
def ofBounds (κ : Cardinal.{u + 1}) (α : Ordinal.{u + 1})
    (h_limit : Order.IsSuccLimit α)
    (h_site : SetIndexedFamily.IsSite
      (SetIndexedFamily.restrictCardinalRank (fppfSetIndexedCoverings S) κ α))
    (h_equiv : ∀ (X : AlgebraicSpace S) (F : SetIndexedFamily.{u + 1} X),
      F ∈ fppfSetIndexedCoverings S X →
        ∃ G : SetIndexedFamily.{u + 1} X,
          G ∈ SetIndexedFamily.restrictCardinalRank (fppfSetIndexedCoverings S) κ α X ∧
          SemiRepresentableFamily.Over.CombinatoriallyEquivalent F.toFamily G.toFamily) :
    ChosenBigFppfSite S where
  bound := κ
  rankBound := α
  isSuccLimit := h_limit
  isSite := h_site
  equivalent := h_equiv

/-- The selected set-indexed fppf families are the cardinal and rank truncation
at the stored bounds. -/
def coverings (𝒮 : ChosenBigFppfSite S) (X : AlgebraicSpace S) :
    Set (SetIndexedFamily.{u + 1} X) :=
  SetIndexedFamily.restrictCardinalRank
    (fppfSetIndexedCoverings S) 𝒮.bound 𝒮.rankBound X

/-- A family is selected exactly when it is fppf and satisfies both the family-code
rank bound and the index-set cardinal bound. -/
theorem mem_coverings_iff (𝒮 : ChosenBigFppfSite S) {X : AlgebraicSpace S}
    {F : SetIndexedFamily.{u + 1} X} :
    F ∈ 𝒮.coverings X ↔
      FppfCovering F.X F.f ∧ F.code.rank < 𝒮.rankBound ∧ F.indexSet.card ≤ 𝒮.bound := by
  rfl

/-- The rank bound is a limit ordinal, the selected families form a site, and
every fppf family has a combinatorially equivalent selected representative. -/
theorem spec (𝒮 : ChosenBigFppfSite S) :
    Order.IsSuccLimit 𝒮.rankBound ∧ SetIndexedFamily.IsSite 𝒮.coverings ∧
      (∀ (X : AlgebraicSpace S) (F : SetIndexedFamily.{u + 1} X),
        F ∈ fppfSetIndexedCoverings S X →
          ∃ G : SetIndexedFamily.{u + 1} X, G ∈ 𝒮.coverings X ∧
            SemiRepresentableFamily.Over.CombinatoriallyEquivalent F.toFamily G.toFamily) :=
  ⟨𝒮.isSuccLimit, 𝒮.isSite, 𝒮.equivalent⟩

/-- A presieve covers when it is generated by a selected set-indexed fppf family. -/
def precoverage (𝒮 : ChosenBigFppfSite S) : Precoverage (AlgebraicSpace S) where
  coverings X := {R | ∃ F : SetIndexedFamily.{u + 1} X,
    F ∈ 𝒮.coverings X ∧ F.toFamily.toPresieve = R}

/-- The Grothendieck topology generated by the selected fppf families. -/
def toGrothendieck (𝒮 : ChosenBigFppfSite S) :
    GrothendieckTopology (AlgebraicSpace S) :=
  𝒮.precoverage.toGrothendieck

/-- The selected fppf families generate the topology of all fppf coverings. -/
theorem toGrothendieck_eq (𝒮 : ChosenBigFppfSite S) :
    𝒮.toGrothendieck = (fppfPrecoverage S).toGrothendieck :=
  sorry

/-- Localizing the chosen fppf topology at `X` gives a topology on algebraic
spaces over `X`. -/
def over (𝒮 : ChosenBigFppfSite S) (X : AlgebraicSpace S) :
    GrothendieckTopology (Over X) :=
  𝒮.toGrothendieck.over X

end ChosenBigFppfSite

/-- Every scheme admits a chosen big fppf site of algebraic spaces. -/
theorem ChosenBigFppfSite.exists (S : Scheme.{u}) : Nonempty (ChosenBigFppfSite S) :=
  sorry

end AlgebraicGeometry.AlgebraicSpace
