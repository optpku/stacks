module

public import Mathlib.Algebra.CharP.Defs
public import Mathlib.Algebra.Field.Basic
public import Mathlib.RingTheory.MvPolynomial.Symmetric.Defs
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.Basic
public import ReasLib.AlgebraicGeometry.Scheme.Regular
public import ReasLib.AlgebraicGeometry.Scheme.Topology.RegularLocus
public import ReasLib.RingTheory.GradedAlgebra.Quotient

/-!
# Projective schemes defined by the first three power sums

The homogeneous ideal generated by the first three power sums defines a projective
scheme whose singularity is classified in positive characteristic different from `2` and `3`.
-/

@[expose] public section

open AlgebraicGeometry MvPolynomial
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.ProjectiveSpace.PowerSum

/-- The ideal generated by the first three power sums in `k[X_0, …, X_n]` is
homogeneous for the standard polynomial grading. -/
theorem relationIdeal_isHomogeneous (k : Type u) [Field k] (n : ℕ) :
    (Ideal.span
      {psum (Fin (n + 1)) k 1, psum (Fin (n + 1)) k 2,
        psum (Fin (n + 1)) k 3}).IsHomogeneous (ProjectiveSpace.grading k n) := sorry

/-- The homogeneous ideal generated by the first three power sums in
`k[X_0, …, X_n]`. -/
def relationIdeal (k : Type u) [Field k] (n : ℕ) :
    HomogeneousIdeal (ProjectiveSpace.grading k n) where
  toSubmodule :=
    Ideal.span
      {psum (Fin (n + 1)) k 1, psum (Fin (n + 1)) k 2, psum (Fin (n + 1)) k 3}
  is_homogeneous' := relationIdeal_isHomogeneous k n

/-- The underlying ideal of `relationIdeal k n` is generated by the first three
power sums. -/
theorem relationIdeal_eq_span (k : Type u) [Field k] (n : ℕ) :
    (relationIdeal k n).toIdeal =
      Ideal.span
        {psum (Fin (n + 1)) k 1, psum (Fin (n + 1)) k 2,
          psum (Fin (n + 1)) k 3} := sorry

/-- The quotient grading on `k[X_0, …, X_n] ⧸ (psum 1, psum 2, psum 3)`. -/
abbrev quotientGrading (k : Type u) [Field k] (n : ℕ) :
    ℕ → Submodule k
      (MvPolynomial (Fin (n + 1)) k ⧸ (relationIdeal k n).toIdeal) :=
  GradedAlgebra.Quotient.grading (ProjectiveSpace.grading k n)
    (relationIdeal k n).toIdeal

/-- The quotient by `relationIdeal k n` carries its canonical graded-algebra
structure. -/
noncomputable instance instGradedAlgebra (k : Type u) [Field k] (n : ℕ) :
    GradedAlgebra (quotientGrading k n) :=
  GradedAlgebra.Quotient.gradedAlgebra (ProjectiveSpace.grading k n)
    (relationIdeal k n).toIdeal (relationIdeal k n).isHomogeneous

/-- The `Proj` model of the closed subscheme of `P^n_k` cut out by the first
three power sums. -/
abbrev scheme (k : Type u) [Field k] (n : ℕ) : Scheme :=
  Proj (quotientGrading k n)

/-- Over a field of positive characteristic `p` different from `2` and `3`, the
projective scheme cut out by the first three power sums in `n + 1` homogeneous
coordinates is singular if and only if `p ≤ n + 1`. -/
theorem singular_iff {k : Type u} [Field k] {p : ℕ} [CharP k p] (n : ℕ)
    (hp : 0 < p) (h2 : p ≠ 2) (h3 : p ≠ 3) :
    ¬ Scheme.Regular (scheme k n) ↔ p ≤ n + 1 := sorry

/-- Over a field of positive characteristic `p` different from `2` and `3`, the
singular locus of the projective scheme defined by the first three power sums
in `n + 1` homogeneous coordinates is nonempty if and only if `p ≤ n + 1`. -/
theorem singularLocus_nonempty_iff {k : Type u} [Field k] {p : ℕ} [CharP k p]
    (n : ℕ) (hp : 0 < p) (h2 : p ≠ 2) (h3 : p ≠ 3) :
    (Sing(scheme k n)).Nonempty ↔ p ≤ n + 1 := sorry

end AlgebraicGeometry.ProjectiveSpace.PowerSum
