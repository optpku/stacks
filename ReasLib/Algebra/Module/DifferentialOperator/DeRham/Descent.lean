module

public import ReasLib.Algebra.Module.DifferentialOperator.DeRham
public import ReasLib.LinearAlgebra.Quotient.Descent

/-!
# Descent of Exterior-Power de Rham Families

@stack 07HY

This leaf constructs a degree-raising exterior-power family on the target of a
surjective linear map when the source family preserves the induced kernels.
It is independent of Kähler differentials and specializes to them through
`LinearMap.compDer`.
-/

@[expose] public section

universe u v

namespace DifferentialOperator.DeRham

section

variable {R : Type u} {S : Type v} {M : Type v} {N : Type v}
variable [CommRing R] [CommRing S] [Algebra R S]
variable [AddCommGroup M] [Module S M] [Module R M] [IsScalarTower R S M]
variable [AddCommGroup N] [Module S N] [Module R N] [IsScalarTower R S N]

/-- The kernel of a quotient map is generated by elements whose degree-one differential becomes
zero after passing to the quotient. -/
@[stacks 07HY]
def KernelCondition (f : M →ₗ[S] N) (δ : Family R S M) : Prop :=
  Submodule.span S
      {x : M |
        f x = 0 ∧ exteriorPower.form.mapRestrictScalars R f 2 (δ 1 x) = 0} =
    LinearMap.ker f

namespace KernelCondition

/-- A kernel satisfying `KernelCondition` is preserved in every exterior-form degree by a family
that satisfies the de Rham formulas and whose derivation spans the source module. -/
@[stacks 07HY]
theorem preservesKernel
    {D : Derivation R S M}
    (f : M →ₗ[S] N) (hf : Function.Surjective f)
    (δ : Family R S M) (hδ : SatisfiesFormula D δ)
    (hspan : Submodule.span S (Set.range D) = ⊤)
    (hcondition : KernelCondition f δ) :
    PreservesKernel f δ := sorry

end KernelCondition

namespace Family

/-- The exterior-power family induced on the target of a surjective linear map
when the source family preserves the kernels of the degreewise induced maps,
with explicit surjectivity witnesses in each degree. -/
@[stacks 07HY]
noncomputable def descend
    (f : M →ₗ[S] N)
    (hsurjective : ∀ p, Function.Surjective (exteriorPower.form.mapRestrictScalars R f p))
    (δ : Family R S M) (hpres : PreservesKernel f δ) :
    Family R S N :=
  fun p ↦
    -- Local instance justification (defeq pin): fix the source degree-p action used by the quotient map.
    letI : Module R (exteriorPower.form S M p) :=
      exteriorPower.form.moduleOfScalarTower (A := R) (B := S) (M := M) p
    -- Local instance justification (defeq pin): fix the source degree-(p + 1) action used by the differential.
    letI : Module R (exteriorPower.form S M (p + 1)) :=
      exteriorPower.form.moduleOfScalarTower (A := R) (B := S) (M := M) (p + 1)
    -- Local instance justification (defeq pin): fix the target degree-p action used by the quotient map.
    letI : Module R (exteriorPower.form S N p) :=
      exteriorPower.form.moduleOfScalarTower (A := R) (B := S) (M := N) p
    -- Local instance justification (defeq pin): fix the target degree-(p + 1) action used by the descended differential.
    letI : Module R (exteriorPower.form S N (p + 1)) :=
      exteriorPower.form.moduleOfScalarTower (A := R) (B := S) (M := N) (p + 1)
    LinearMap.descendOfSurjective
      (exteriorPower.form.mapRestrictScalars R f p)
      (hsurjective p)
      ((exteriorPower.form.mapRestrictScalars R f (p + 1)).comp (δ p))
      (hpres p)

/-- The descended family composes with each degreewise quotient map to the
corresponding source differential followed by the next quotient map. -/
@[stacks 07HY]
theorem descend_comp
    (f : M →ₗ[S] N)
    (hsurjective : ∀ p, Function.Surjective (exteriorPower.form.mapRestrictScalars R f p))
    (δ : Family R S M) (hpres : PreservesKernel f δ) (p : ℕ) :
    (descend f hsurjective δ hpres p).comp (exteriorPower.form.mapRestrictScalars R f p) =
      (exteriorPower.form.mapRestrictScalars R f (p + 1)).comp (δ p) := sorry

/-- The family constructed by `Family.descend` satisfies the degreewise
intertwining relation with its source family. -/
@[stacks 07HY]
theorem descend_descends
    (f : M →ₗ[S] N)
    (hsurjective : ∀ p, Function.Surjective (exteriorPower.form.mapRestrictScalars R f p))
    (δ : Family R S M) (hpres : PreservesKernel f δ) :
    Descends f δ (descend f hsurjective δ hpres) := sorry

/-- A family satisfying the same degreewise descent equations is the family constructed by
`Family.descend`. -/
@[stacks 07HY]
theorem eq_descend_of_descends
    (f : M →ₗ[S] N)
    (hsurjective : ∀ p, Function.Surjective (exteriorPower.form.mapRestrictScalars R f p))
    (δ : Family R S M) (hpres : PreservesKernel f δ)
    (δ' : Family R S N) (hdesc : Descends f δ δ') :
    δ' = descend f hsurjective δ hpres := sorry

/-- If the source family squares to zero, then its family descended along a
surjective linear map also squares to zero. -/
@[stacks 07HY]
theorem descend_squaresToZero
    (f : M →ₗ[S] N)
    (hsurjective : ∀ p, Function.Surjective (exteriorPower.form.mapRestrictScalars R f p))
    (δ : Family R S M) (hδ : SquaresToZero δ)
    (hpres : PreservesKernel f δ) :
    SquaresToZero (descend f hsurjective δ hpres) := sorry

/-- The quotient family satisfies the de Rham formulas for the derivation induced on the target. -/
@[stacks 07HY]
theorem descend_satisfiesFormula
    {D : Derivation R S M}
    (f : M →ₗ[S] N)
    (hsurjective : ∀ p, Function.Surjective (exteriorPower.form.mapRestrictScalars R f p))
    (δ : Family R S M) (hδ : SatisfiesFormula D δ)
    (hpres : PreservesKernel f δ) :
    SatisfiesFormula (f.compDer D) (descend f hsurjective δ hpres) := sorry

/-- A de Rham differential family descends to the family for the derivation
obtained by composing its derivation with the quotient map. -/
@[stacks 07HY]
theorem descend_isDifferential
    {D : Derivation R S M}
    (f : M →ₗ[S] N)
    (hsurjective : ∀ p, Function.Surjective (exteriorPower.form.mapRestrictScalars R f p))
    (δ : Family R S M) (hδ : IsDifferential D δ)
    (hpres : PreservesKernel f δ) :
    IsDifferential (f.compDer D) (descend f hsurjective δ hpres) := sorry

/-- A source de Rham family whose quotient kernel satisfies `KernelCondition` induces a de Rham
family on the quotient together with the degreewise descent equations. -/
@[stacks 07HY]
theorem existsDescended
    {D : Derivation R S M}
    (f : M →ₗ[S] N) (hf : Function.Surjective f)
    (δ : Family R S M) (hδ : IsDifferential D δ)
    (hspan : Submodule.span S (Set.range D) = ⊤)
    (hcondition : KernelCondition f δ) :
    ∃ δN : Family R S N,
      IsDifferential (f.compDer D) δN ∧ Descends f δ δN := sorry

end Family

end

end DifferentialOperator.DeRham
