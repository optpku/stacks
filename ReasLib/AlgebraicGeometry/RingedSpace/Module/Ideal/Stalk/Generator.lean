module

public import ReasLib.AlgebraicGeometry.RingedSpace.Module.Ideal.Torsion
import Mathlib.Tactic.CrossRefAttribute

/-!
# Generators of ideal-sheaf stalks

This file packages the statement that an element generates the image ideal of an ideal-sheaf
stalk.  The predicate is independent of a local chart and uses the canonical image ideal in the
stalk ring.
-/

@[expose] public section

open CategoryTheory TopologicalSpace

noncomputable section

universe u

namespace AlgebraicGeometry.RingedSpace.IdealSheaf

variable {X : RingedSpace.{u}}

/-- The element `f` generates the image of `I_x` in the structure-sheaf stalk `𝒪_{X,x}`. -/
@[stacks 0GT6 "generator of an ideal-sheaf stalk"]
def IsStalkGenerator
    (I : Subobject (SheafOfModules.unit X.ringCatSheaf : X.Modules))
    (x : X) (f : X.presheaf.stalk x) : Prop :=
  idealSheafStalkIdeal I x = Ideal.span {f}

/-- The stalk-generator predicate unfolds to equality with the principal ideal generated by
`f`. -/
theorem isStalkGenerator_iff
    (I : Subobject (SheafOfModules.unit X.ringCatSheaf : X.Modules))
    (x : X) (f : X.presheaf.stalk x) :
    IsStalkGenerator I x f ↔ idealSheafStalkIdeal I x = Ideal.span {f} := sorry

/-- A stalk generator belongs to the image ideal that it generates. -/
theorem IsStalkGenerator.mem
    {I : Subobject (SheafOfModules.unit X.ringCatSheaf : X.Modules)}
    {x : X} {f : X.presheaf.stalk x} (hf : IsStalkGenerator I x f) :
    f ∈ idealSheafStalkIdeal I x := sorry

/-- The germ of the generator of a principal chart generates the corresponding stalk ideal. -/
@[stacks 0GT4 "principal-chart germ generates the stalk ideal"]
theorem Chart.isStalkGenerator
    {I : Subobject (SheafOfModules.unit X.ringCatSheaf : X.Modules)}
    {U : Opens X} (c : Chart I U) (x : X) (hx : x ∈ U) :
    IsStalkGenerator I x (X.presheaf.germ U x hx c.generator) := sorry

namespace IsRegularPrincipal

/-- Every stalk of a locally principal regular ideal sheaf admits a generator. -/
@[stacks 0GT4 "existence of stalk generators"]
theorem exists_stalkGenerator
    (I : Subobject (SheafOfModules.unit X.ringCatSheaf : X.Modules))
    [IsRegularPrincipal I] (x : X) :
    ∃ f : X.presheaf.stalk x, IsStalkGenerator I x f := sorry

end IsRegularPrincipal

/-- If `I` acts regularly on `M`, every chosen stalk generator acts regularly on `M_x`. -/
theorem IsStalkGenerator.isSMulRegular
    {I : Subobject (SheafOfModules.unit X.ringCatSheaf : X.Modules)}
    {M : X.Modules} {x : X} {f : X.presheaf.stalk x}
    (hf : IsStalkGenerator I x f) (hM : IsRegularOn I M) :
    IsSMulRegular (stalkModuleCat M x) f := sorry

end AlgebraicGeometry.RingedSpace.IdealSheaf
