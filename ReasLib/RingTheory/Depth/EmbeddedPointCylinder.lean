module

public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.KrullDimension.Basic
public import ReasLib.RingTheory.Depth

/-!
# The embedded-point cylinder

This file constructs the quotient `k[x, y, z] ⧸ (x ^ 2, x * y)`, its origin
localization, and the embedded prime used in the depth example.
-/

@[expose] public section

noncomputable section

universe u

open MvPolynomial
open scoped ENat

namespace MvPolynomial.LineWithEmbeddedPointCylinder

/-- The relation ideal `(x ^ 2, x * y)` in `k[x, y, z]`, with `X 0` corresponding to
`x`, `X 1` corresponding to `y`, and `X 2` corresponding to `z`. -/
def relationIdeal (k : Type u) [Field k] : Ideal (MvPolynomial (Fin 3) k) :=
  Ideal.span {X 0 ^ 2, X 0 * X 1}

/-- The relation ideal is the span of `X 0 ^ 2` and `X 0 * X 1`. -/
theorem relationIdeal_eq_span (k : Type u) [Field k] :
    relationIdeal k = Ideal.span {X 0 ^ 2, X 0 * X 1} := sorry

/-- The coordinate ring `k[x, y, z] ⧸ (x ^ 2, x * y)`. -/
abbrev CoordinateRing (k : Type u) [Field k] : Type u :=
  MvPolynomial (Fin 3) k ⧸ relationIdeal k

/-- The class of the first coordinate, corresponding to the source variable `x`. -/
def coordX (k : Type u) [Field k] : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (X 0)

/-- `coordX` is the class of `X 0`. -/
theorem coordX_eq (k : Type u) [Field k] :
    coordX k = Ideal.Quotient.mk (relationIdeal k) (X 0) := sorry

/-- The class of the second coordinate, corresponding to the source variable `y`. -/
def coordY (k : Type u) [Field k] : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (X 1)

/-- `coordY` is the class of `X 1`. -/
theorem coordY_eq (k : Type u) [Field k] :
    coordY k = Ideal.Quotient.mk (relationIdeal k) (X 1) := sorry

/-- The class of the third coordinate, corresponding to the source variable `z`. -/
def coordZ (k : Type u) [Field k] : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (X 2)

/-- `coordZ` is the class of `X 2`. -/
theorem coordZ_eq (k : Type u) [Field k] :
    coordZ k = Ideal.Quotient.mk (relationIdeal k) (X 2) := sorry

/-- The first coordinate is nilpotent of index `2`. -/
theorem coordX_pow_two (k : Type u) [Field k] : coordX k ^ 2 = 0 := sorry

/-- The product of the first two coordinates vanishes. -/
theorem coordX_mul_coordY (k : Type u) [Field k] : coordX k * coordY k = 0 := sorry

/-- The origin ideal `(x, y, z)` in the coordinate ring. -/
def originIdeal (k : Type u) [Field k] : Ideal (CoordinateRing k) :=
  Ideal.span {coordX k, coordY k, coordZ k}

/-- The origin ideal is generated by `coordX`, `coordY`, and `coordZ`. -/
theorem originIdeal_eq_span (k : Type u) [Field k] :
    originIdeal k = Ideal.span {coordX k, coordY k, coordZ k} := sorry

/-- The origin ideal is the extension of `idealOfVars (Fin 3) k`. -/
theorem originIdeal_eq_map (k : Type u) [Field k] :
    originIdeal k =
      Ideal.map (Ideal.Quotient.mk (relationIdeal k)) (idealOfVars (Fin 3) k) := sorry

/-- The origin ideal is maximal, so it is the prime at which we localize. -/
instance originIdeal.instIsMaximal (k : Type u) [Field k] :
    (originIdeal k).IsMaximal := sorry

/-- The local ring of `k[x, y, z] ⧸ (x ^ 2, x * y)` at the origin `(x, y, z)`. -/
abbrev LocalRing (k : Type u) [Field k] : Type u :=
  Localization.AtPrime (originIdeal k)

/-- The embedded ideal `(x, y)` in the coordinate ring. -/
def embeddedIdeal (k : Type u) [Field k] : Ideal (CoordinateRing k) :=
  Ideal.span {coordX k, coordY k}

/-- The embedded ideal is generated by `coordX` and `coordY`. -/
theorem embeddedIdeal_eq_span (k : Type u) [Field k] :
    embeddedIdeal k = Ideal.span {coordX k, coordY k} := sorry

/-- The embedded ideal `(x, y)` is prime in the coordinate ring. -/
instance embeddedIdeal.instIsPrime (k : Type u) [Field k] :
    (embeddedIdeal k).IsPrime := sorry

/-- The extension of `(x, y)` to the local ring at the origin. -/
def embeddedPrime (k : Type u) [Field k] : Ideal (LocalRing k) :=
  Ideal.map (algebraMap (CoordinateRing k) (LocalRing k)) (embeddedIdeal k)

/-- `embeddedPrime` is the extension of `embeddedIdeal` along the localization map. -/
theorem embeddedPrime_eq_map (k : Type u) [Field k] :
    embeddedPrime k =
      Ideal.map (algebraMap (CoordinateRing k) (LocalRing k)) (embeddedIdeal k) := sorry

/-- The extension of `(x, y)` is prime in the local ring at the origin. -/
instance embeddedPrime.instIsPrime (k : Type u) [Field k] :
    (embeddedPrime k).IsPrime := sorry

/-- The coordinate ring has module depth at least one at the origin localization. -/
theorem moduleDepth_ge_one (k : Type u) [Field k] :
    (1 : ℕ∞) ≤ moduleDepth (LocalRing k) (LocalRing k) := sorry

/-- The localization at the embedded prime has module depth zero. -/
theorem moduleDepth_atPrime_eq_zero (k : Type u) [Field k] :
    moduleDepth (Localization.AtPrime (embeddedPrime k))
      (Localization.AtPrime (embeddedPrime k)) = 0 := sorry

/-- The localization at the embedded prime has Krull dimension at least one. -/
theorem ringKrullDim_atPrime_ge_one (k : Type u) [Field k] :
    1 ≤ ringKrullDim (Localization.AtPrime (embeddedPrime k)) := sorry

end MvPolynomial.LineWithEmbeddedPointCylinder
