module

public import ReasLib.AlgebraicGeometry.Scheme.DescentData.Pullback.FullyFaithful
import StacksCheckRecall

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry
namespace Scheme
namespace DescentData
namespace Pullback

/- Lemma 35.35.4: if the singleton family generated by `f : X' ⟶ X` is an fpqc
covering, then pullback of descent data along `f` over a common base is fully faithful. -/
@[stacks 0241] #check (AlgebraicGeometry.Scheme.DescentData.Pullback.fullyFaithful :
  {X X' S : Scheme.{u}} → (a : X ⟶ S) → (a' : X' ⟶ S) →
    (f : X' ⟶ X) → (sq : CommSq f a' a (𝟙 S)) →
      Scheme.FpqcCovering (fun _ : Unit ↦ Over.mk f) →
        Nonempty (functor a a' (𝟙 S) f sq).FullyFaithful)

end Pullback
end DescentData
end Scheme
end AlgebraicGeometry
