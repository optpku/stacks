module

public import Mathlib.Algebra.Polynomial.Basic
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import ReasLib.RingTheory.CohenMacaulay.Module
public import ReasLib.RingTheory.Localization.AtPrime.Int
public import stacks_project.Chap111.Exercise_111_13_1_Cusp
public import stacks_project.Chap111.Exercise_111_13_1_EmbeddedPoint
import Mathlib.Tactic.CrossRefAttribute

/-!
# Exercise 111.13.1

Six concrete Cohen-Macaulay and regularity questions for local rings
`ℤ_(p)`, `k[x]_(x)`, the plane cusp, and the line with an embedded point.
-/

@[expose] public section

noncomputable section

universe u

open Polynomial

namespace Int

/-- Exercise 111.13.1 (1): for a prime `p`, the local ring `Int.LocalizationAtPrime p`
is a Cohen-Macaulay local ring (yes). -/
@[stacks 0CT4, instance]
instance localizationAtPrime_cohenMacaulay (p : ℕ) [Fact p.Prime] :
    Module.CohenMacaulay (LocalizationAtPrime p) (LocalizationAtPrime p) := sorry

/-- Exercise 111.13.1 (2): for a prime `p`, the local ring `Int.LocalizationAtPrime p`
is a regular local ring (yes). -/
@[stacks 0CT4, instance]
instance localizationAtPrime_isRegularLocalRing (p : ℕ) [Fact p.Prime] :
    IsRegularLocalRing (LocalizationAtPrime p) := sorry

end Int

namespace Polynomial

/-- The principal ideal generated by `X` in `k[X]` is prime. -/
instance spanX_isPrime (k : Type u) [Field k] : (Ideal.span {(X : k[X])}).IsPrime := sorry

/-- Exercise 111.13.1 (3): for a field `k`, the local ring `k[X]_(X)` is a
Cohen-Macaulay local ring (yes). -/
@[stacks 0CT4, instance]
instance localizationAtX_cohenMacaulay (k : Type u) [Field k] :
    Module.CohenMacaulay (Localization.AtPrime (Ideal.span {(X : k[X])}))
      (Localization.AtPrime (Ideal.span {(X : k[X])})) := sorry

/-- Exercise 111.13.1 (4): for a field `k`, the local ring `k[X]_(X)` is a
regular local ring (yes). -/
@[stacks 0CT4, instance]
instance localizationAtX_isRegularLocalRing (k : Type u) [Field k] :
    IsRegularLocalRing (Localization.AtPrime (Ideal.span {(X : k[X])})) := sorry

end Polynomial

namespace MvPolynomial.Cusp

/-- Exercise 111.13.1 (5): for a field `k`, the local ring
`(k[x, y] ⧸ (y ^ 2 - x ^ 3))_{(x, y)}` is a Cohen-Macaulay local ring (yes).
This is `LocalRing k`, the localization of the quotient at the origin; the
source also identifies it with the quotient of `k[x, y]_{(x, y)}` by the
extended relation. -/
@[stacks 0CT4, instance]
instance localRing_cohenMacaulay (k : Type u) [Field k] :
    Module.CohenMacaulay (LocalRing k) (LocalRing k) := sorry

end MvPolynomial.Cusp

namespace MvPolynomial.EmbeddedPoint

/-- Exercise 111.13.1 (6): for a field `k`, the local ring
`(k[x, y] ⧸ (y ^ 2, x * y))_{(x, y)}` is not a Cohen-Macaulay local ring (no).
This is `LocalRing k`, the localization of the quotient at the origin; the
source also identifies it with the quotient of `k[x, y]_{(x, y)}` by the
extended relation ideal. -/
@[stacks 0CT4]
theorem localRing_not_cohenMacaulay (k : Type u) [Field k] :
    ¬ Module.CohenMacaulay (LocalRing k) (LocalRing k) := sorry

end MvPolynomial.EmbeddedPoint
