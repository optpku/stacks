/-- The explicit derived internal-Hom composition is contravariantly natural in its source. -/
@[stacks 0A8J "derived internal-Hom composition source naturality"]
theorem compOf_natural_source
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    {K₁ K₂ : DerivedCategory C} (f : K₁ ⟶ K₂) (L N : DerivedCategory C)
    [DerivedTensor.Right.Has (C := C)] :
    CommSq
      ((tensorMapOf H M ((MonoidalClosed.preOf H f).app L)).app
        ((MonoidalClosed.ihomOf H L).obj N))
