module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.LocalGeneration
public import ReasLib.AlgebraicGeometry.RingedSpace.IdealSubobject
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Locally generated ideal subobjects

This leaf specializes local generation by sections to ideal subobjects on a ringed space.
-/

@[expose] public section

universe u

namespace AlgebraicGeometry.RingedSpace

/-- An ideal subobject is locally generated by sections when its represented module sheaf is. -/
@[stacks 03DL "ideal-subobject local-generation predicate"]
abbrev IdealSubobject.IsLocallyGeneratedBySections
    {X : RingedSpace.{u}} (I : IdealSubobject X) : Prop :=
  SheafOfModules.IsLocallyGeneratedBySections I.toModule

/-- An ideal subobject is locally generated by sections exactly when its represented module sheaf
admits local-generator data. -/
@[stacks 03DL "ideal-subobject local-generator data"]
theorem IdealSubobject.isLocallyGeneratedBySections_iff
    {X : RingedSpace.{u}} (I : IdealSubobject X) :
    I.IsLocallyGeneratedBySections ↔ Nonempty I.toModule.LocalGeneratorsData.{u} := sorry

end AlgebraicGeometry.RingedSpace
