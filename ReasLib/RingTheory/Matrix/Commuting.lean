module

public import Mathlib.Algebra.MvPolynomial.CommRing
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Data.Matrix.Mul
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# The coefficient ring of a family of commuting matrices

For arbitrary labels `ι` and a finite matrix index `κ`, the coefficient ring is
`MvPolynomial (ι × κ × κ) R` modulo the entries of all commutators. Its algebra
homomorphisms to a commutative `R`-algebra are explicitly equivalent to families
of pairwise commuting `κ × κ` matrices. Neither index type has to be nonempty.

This is coordinate data for representation spaces and affine Hilbert charts.
It does not impose a cyclic vector or construct or glue Hilbert charts. Compare
Stacks Project, tag `0B99`, where the base ring and polynomial generators are
arbitrary and the degree can be zero.
-/

@[expose] public section

noncomputable section

universe uR uι uκ uS

namespace Matrix.Commuting

/-- A family with the pairwise commutation property, with no chosen extra data. -/
abbrev Family (S : Type uS) [CommRing S] (ι : Type uι) (κ : Type uκ) [Fintype κ] :=
  {M : ι → Matrix κ κ S // ∀ a b, Commute (M a) (M b)}

variable (R : Type uR) [CommRing R] (ι : Type uι) (κ : Type uκ)

/-- One polynomial variable for each labelled matrix entry. -/
abbrev PolynomialRing := MvPolynomial (ι × κ × κ) R

/-- The labelled generic matrices over the polynomial ring. -/
def polynomialMatrix (a : ι) : Matrix κ κ (PolynomialRing R ι κ) :=
  fun i j ↦ MvPolynomial.X (a, i, j)

@[simp]
theorem polynomialMatrix_apply (a : ι) (i j : κ) :
    polynomialMatrix R ι κ a i j = MvPolynomial.X (a, i, j) := rfl

variable {ι κ} {S : Type uS} [CommRing S] [Algebra R S]

/-- Polynomial evaluation at all entries of a given family, before imposing relations. -/
def polynomialEval (M : ι → Matrix κ κ S) : PolynomialRing R ι κ →ₐ[R] S :=
  MvPolynomial.aeval fun x ↦ M x.1 x.2.1 x.2.2

@[simp]
theorem polynomialEval_X (M : ι → Matrix κ κ S) (a : ι) (i j : κ) :
    polynomialEval R M (MvPolynomial.X (a, i, j)) = M a i j :=
  MvPolynomial.aeval_X _ _

variable (ι κ) [Fintype κ]

/-- An entry of a commutator of two generic matrices. -/
def commutatorEntry (a b : ι) (i j : κ) : PolynomialRing R ι κ :=
  (polynomialMatrix R ι κ a * polynomialMatrix R ι κ b -
    polynomialMatrix R ι κ b * polynomialMatrix R ι κ a) i j

/-- The ideal generated by every entry of every commutator. -/
def commutatorIdeal : Ideal (PolynomialRing R ι κ) :=
  Ideal.span (Set.range fun x : ι × ι × κ × κ ↦
    commutatorEntry R ι κ x.1 x.2.1 x.2.2.1 x.2.2.2)

theorem commutatorEntry_mem (a b : ι) (i j : κ) :
    commutatorEntry R ι κ a b i j ∈ commutatorIdeal R ι κ :=
  Ideal.subset_span (Set.mem_range_self (a, b, i, j))

/-- The actual polynomial quotient parametrizing commuting families. -/
abbrev CoefficientRing := PolynomialRing R ι κ ⧸ commutatorIdeal R ι κ

/-- The native quotient algebra map. -/
def quotientMap : PolynomialRing R ι κ →ₐ[R] CoefficientRing R ι κ :=
  Ideal.Quotient.mkₐ R (commutatorIdeal R ι κ)

/-- The universal matrices, obtained by taking the classes of generic entries. -/
def universalMatrix (a : ι) : Matrix κ κ (CoefficientRing R ι κ) :=
  (polynomialMatrix R ι κ a).map (quotientMap R ι κ)

@[simp]
theorem universalMatrix_apply (a : ι) (i j : κ) :
    universalMatrix R ι κ a i j = quotientMap R ι κ (MvPolynomial.X (a, i, j)) := rfl

theorem quotientMap_commutatorEntry (a b : ι) (i j : κ) :
    quotientMap R ι κ (commutatorEntry R ι κ a b i j) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr (commutatorEntry_mem R ι κ a b i j)

/-- The universal matrices satisfy the defining pairwise commutation equations. -/
theorem universalMatrix_commute (a b : ι) :
    Commute (universalMatrix R ι κ a) (universalMatrix R ι κ b) := by
  change universalMatrix R ι κ a * universalMatrix R ι κ b =
    universalMatrix R ι κ b * universalMatrix R ι κ a
  apply sub_eq_zero.mp
  ext i j
  have h := quotientMap_commutatorEntry R ι κ a b i j
  simpa [commutatorEntry, universalMatrix, Matrix.mul_apply, map_sum] using h

variable {ι κ}

theorem polynomialEval_commutatorEntry (M : ι → Matrix κ κ S) (a b : ι) (i j : κ) :
    polynomialEval R M (commutatorEntry R ι κ a b i j) =
      (M a * M b - M b * M a) i j := by
  simp [commutatorEntry, polynomialMatrix, polynomialEval, Matrix.mul_apply, map_sum]

/-- Commutation is precisely what is needed for evaluation to kill the relations. -/
theorem commutatorIdeal_le_ker (M : ι → Matrix κ κ S)
    (hM : ∀ a b, Commute (M a) (M b)) :
    commutatorIdeal R ι κ ≤ RingHom.ker (polynomialEval R M).toRingHom := by
  rw [commutatorIdeal, Ideal.span_le]
  rintro _ ⟨⟨a, b, i, j⟩, rfl⟩
  change polynomialEval R M (commutatorEntry R ι κ a b i j) = 0
  rw [polynomialEval_commutatorEntry]
  change (M a * M b) i j - (M b * M a) i j = 0
  rw [(hM a b).eq, sub_self]

/-- Evaluation on the quotient, using the native `Ideal.Quotient.liftₐ`.
The commutation hypothesis is only used to verify that the relations vanish. -/
def eval (M : ι → Matrix κ κ S) (hM : ∀ a b, Commute (M a) (M b)) :
    CoefficientRing R ι κ →ₐ[R] S :=
  Ideal.Quotient.liftₐ (commutatorIdeal R ι κ) (polynomialEval R M)
    (fun _ hp ↦ commutatorIdeal_le_ker R M hM hp)

@[simp]
theorem eval_quotientMap (M : ι → Matrix κ κ S) (hM : ∀ a b, Commute (M a) (M b))
    (p : PolynomialRing R ι κ) :
    eval R M hM (quotientMap R ι κ p) = polynomialEval R M p := rfl

@[simp]
theorem eval_universalMatrix (M : ι → Matrix κ κ S)
    (hM : ∀ a b, Commute (M a) (M b)) (a : ι) (i j : κ) :
    eval R M hM (universalMatrix R ι κ a i j) = M a i j := by
  rw [universalMatrix_apply, eval_quotientMap, polynomialEval_X]

/-- Algebra homomorphisms out of the coefficient ring are determined by universal entries. -/
@[ext]
theorem algHom_ext {f g : CoefficientRing R ι κ →ₐ[R] S}
    (h : ∀ a i j, f (universalMatrix R ι κ a i j) =
      g (universalMatrix R ι κ a i j)) : f = g := by
  apply Ideal.Quotient.algHom_ext R
  apply MvPolynomial.algHom_ext
  rintro ⟨a, i, j⟩
  exact h a i j

/-- Read the family of matrices from an algebra homomorphism by evaluating universal entries. -/
def toFamily (f : CoefficientRing R ι κ →ₐ[R] S) : Family S ι κ :=
  ⟨fun a ↦ (universalMatrix R ι κ a).map f, fun a b ↦ by
    change (universalMatrix R ι κ a).map f * (universalMatrix R ι κ b).map f =
      (universalMatrix R ι κ b).map f * (universalMatrix R ι κ a).map f
    simpa only [Matrix.map_mul] using
      congrArg (fun N : Matrix κ κ (CoefficientRing R ι κ) ↦ N.map f)
        (universalMatrix_commute R ι κ a b).eq⟩

@[simp]
theorem toFamily_apply (f : CoefficientRing R ι κ →ₐ[R] S) (a : ι) (i j : κ) :
    (toFamily R f).val a i j = f (universalMatrix R ι κ a i j) := rfl

@[simp]
theorem toFamily_eval (M : ι → Matrix κ κ S) (hM : ∀ a b, Commute (M a) (M b)) :
    toFamily R (eval R M hM) = ⟨M, hM⟩ := by
  apply Subtype.ext
  funext a i j
  exact eval_universalMatrix R M hM a i j

@[simp]
theorem eval_toFamily (f : CoefficientRing R ι κ →ₐ[R] S) :
    eval R (toFamily R f).val (toFamily R f).property = f := by
  apply algHom_ext
  intro a i j
  exact eval_universalMatrix R (toFamily R f).val (toFamily R f).property a i j

/-- The universal property with both functions given explicitly, rather than chosen from
an existence or bijectivity statement. -/
def algHomEquiv : (CoefficientRing R ι κ →ₐ[R] S) ≃ Family S ι κ where
  toFun := toFamily R
  invFun := fun M ↦ eval R M.val M.property
  left_inv := eval_toFamily R
  right_inv := fun M ↦ toFamily_eval R M.val M.property

@[simp]
theorem algHomEquiv_apply (f : CoefficientRing R ι κ →ₐ[R] S) :
    algHomEquiv R f = toFamily R f := rfl

@[simp]
theorem algHomEquiv_symm_apply (M : Family S ι κ) :
    (algHomEquiv R).symm M = eval R M.val M.property := rfl

/-- With no rows, there are no commutator entries and hence no relations. -/
theorem commutatorIdeal_eq_bot_of_isEmpty [IsEmpty κ] : commutatorIdeal R ι κ = ⊥ := by
  apply le_antisymm _ bot_le
  rw [commutatorIdeal, Ideal.span_le]
  rintro _ ⟨⟨_, _, i, _⟩, _⟩
  exact isEmptyElim i

end Matrix.Commuting
