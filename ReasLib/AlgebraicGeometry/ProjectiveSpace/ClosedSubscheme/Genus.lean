module

public import ReasLib.AlgebraicGeometry.ProjectiveSpace.ClosedSubscheme.Principality
public import ReasLib.AlgebraicGeometry.Scheme.Module.Cohomology.GlobalSections

@[expose] public section

open CategoryTheory Set TopologicalSpace

universe u

namespace AlgebraicGeometry.ProjectiveSpace.ClosedSubscheme

/-- The canonical map from the ground field to the global sections of a nonempty
equidimensional plane curve with no embedded points and homogeneous ideal generated by `F`
is bijective. -/
theorem planeCurve_globalSectionsMap_bijective
    (k : Type u) [Field k]
    (Z : (ProjectiveSpace.scheme k 2).IdealSheafData)
    [Nonempty Z.subscheme]
    (P : ProjTwistPresentation (ProjectiveSpace.grading k 2))
    [h_componentDim : Fact (∀ C : irreducibleComponents Z.subscheme,
      topologicalKrullDim (C : Set Z.subscheme) = 1)]
    [h_noEmbeddedPoints : Fact (Z.subscheme.embeddedPoints = (∅ : Set Z.subscheme))]
    (F : MvPolynomial (Fin 3) k)
    (h_generator : (twistIdeal 2 Z P).toIdeal = Ideal.span {F}) :
    Function.Bijective
      (Scheme.Hom.globalSectionsMap (Z.subschemeι ≫ ProjectiveSpace.toSpec k 2)) := sorry

/-- The first structure-sheaf cohomology of a nonempty equidimensional plane curve with no
embedded points and homogeneous ideal generated by `F` has dimension
`((F.totalDegree - 1) * (F.totalDegree - 2)) / 2` over the ground field. -/
theorem planeCurve_genus_eq_totalDegree
    (k : Type u) [Field k]
    (Z : (ProjectiveSpace.scheme k 2).IdealSheafData)
    [Nonempty Z.subscheme]
    (P : ProjTwistPresentation (ProjectiveSpace.grading k 2))
    [h_componentDim : Fact (∀ C : irreducibleComponents Z.subscheme,
      topologicalKrullDim (C : Set Z.subscheme) = 1)]
    [h_noEmbeddedPoints : Fact (Z.subscheme.embeddedPoints = (∅ : Set Z.subscheme))]
    (F : MvPolynomial (Fin 3) k)
    (h_generator : (twistIdeal 2 Z P).toIdeal = Ideal.span {F}) :
    Scheme.Hom.cohomologyFinrank
      (Z.subschemeι ≫ ProjectiveSpace.toSpec k 2)
      (SheafOfModules.unit Z.subscheme.ringCatSheaf : Z.subscheme.Modules) 1 =
      ((F.totalDegree - 1) * (F.totalDegree - 2)) / 2 := sorry

end AlgebraicGeometry.ProjectiveSpace.ClosedSubscheme
