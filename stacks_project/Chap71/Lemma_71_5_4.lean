module

import StacksCheckRecall
import ReasLib.AlgebraicGeometry.AlgebraicSpace.Module.FittingIdeal.LocalGenerators

universe u

/- Lemma 71.5.4: A finite-type quasi-coherent module on an algebraic space is
 generated by `r` sections on an étale neighbourhood of a point if and only if
 its `r`th Fitting ideal has unit stalk at every geometric point above it. -/
@[stacks 0CZ7] #check
  (AlgebraicGeometry.AlgebraicSpace.fittingIdealSheaf.exists_etale_isGeneratedBy_iff_stalk_eq_top :
    ∀ {S : AlgebraicGeometry.Scheme.{u}} {X : AlgebraicGeometry.AlgebraicSpace S}
      (F : X.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
      (x : AlgebraicGeometry.AlgebraicSpace.Points X) (r : ℕ),
      AlgebraicGeometry.AlgebraicSpace.Modules.existsEtaleGeneratedBy F x r ↔
        ∀ xbar : AlgebraicGeometry.AlgebraicSpace.GeometricPoint X, xbar.liesOver x →
          AlgebraicGeometry.AlgebraicSpace.fittingIdealStalkIdeal F r xbar = ⊤)
