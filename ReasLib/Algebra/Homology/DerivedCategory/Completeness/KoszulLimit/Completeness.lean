module

public import ReasLib.Algebra.Homology.DerivedCategory.Completeness.HomotopyLimit
public import ReasLib.Algebra.Homology.DerivedCategory.Completeness.KoszulLimit
import Mathlib.Tactic.CrossRefAttribute

/-!
# Derived completeness of powered-Koszul limits

Any chosen derived limit of the powered-Koszul tensor tower is derived complete with respect to
the ideal generated by the chosen finite family.

@stack 091Y
-/

@[expose] public section

noncomputable section

open CategoryTheory

universe u

namespace CategoryTheory.DerivedCategory.KoszulLimit

variable {A : Type u} [CommRing A] {r : ℕ}

/-- Lemma 15.92.16 (091Y): a derived limit of the powered-Koszul tensor tower is derived complete
with respect to the ideal generated by the chosen finite family. -/
@[stacks 091Y]
theorem isDerivedComplete_of_isDerivedLimit
    (f : Fin r → A) (K L : DerivedCategory (ModuleCat.{u} A))
    (hlim : IsDerivedLimit (tensorSystem f K) L) :
    L.IsDerivedCompleteWithRespectTo (Ideal.span (Set.range f)) := sorry

end CategoryTheory.DerivedCategory.KoszulLimit
