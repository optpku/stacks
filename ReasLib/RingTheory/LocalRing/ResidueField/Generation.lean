module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Generators in residue fields

This leaf relates a generating set of an algebra to the image of its prime quotient in the
corresponding residue field.  The statements are independent of the predicate that supplied the
generating set.
-/

@[expose] public section

universe u v

namespace Ideal.ResidueField

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]

/-- If `G` generates `S` as an `R`-algebra, then the image of `S ⧸ q` in `κ(q)` is the subring
generated by the images of `R` and `G`. -/
@[stacks 09EF]
theorem quotient_range_eq_closure_of_adjoin_eq_top
    (G : Set S) (hG : Algebra.adjoin R G = ⊤) (q : PrimeSpectrum S) :
    (algebraMap (S ⧸ q.asIdeal) q.asIdeal.ResidueField).range =
      Subring.closure
        (Set.range (algebraMap R q.asIdeal.ResidueField) ∪
          ((algebraMap S q.asIdeal.ResidueField) '' G)) := sorry

/-- If `G` generates `S` as an `R`-algebra, then the subfield of `κ(q)` generated by the images
of `R` and `G` is all of `κ(q)`. -/
@[stacks 09EF]
theorem subfieldClosure_eq_top_of_adjoin_eq_top
    (G : Set S) (hG : Algebra.adjoin R G = ⊤) (q : PrimeSpectrum S) :
    Subfield.closure
      (Set.range (algebraMap R q.asIdeal.ResidueField) ∪
        ((algebraMap S q.asIdeal.ResidueField) '' G)) = ⊤ := sorry

end Ideal.ResidueField
