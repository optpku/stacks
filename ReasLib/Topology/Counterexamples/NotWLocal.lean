module

public import Mathlib.Topology.Connected.TotallyDisconnected
public import Mathlib.Topology.JacobsonSpace
public import Mathlib.Topology.Order
public import Mathlib.Topology.Spectral.Basic
public import Mathlib.Topology.WithTopology
public import ReasLib.Topology.ConnectedComponents.ClosedPoints

/-!
# A spectral space whose closed points are not closed

Given a topological space `T` and a point `t`, equip `T × Fin 2` with the
topology generated by open cylinders `U × {0, 1}`, the complement of `(t, 0)`,
and one-slices `U × {1}` for open `U` avoiding `t`. The carrier uses
`WithTopology` so this topology does not overwrite the product topology.

When `T` is compact, Hausdorff, and totally disconnected and its complement
of `{t}` is not compact, the closed points are the zero-slice and map
bijectively to connected components, but do not form a closed subset.
-/

@[expose] public section

open Set Topology TopologicalSpace

universe u

namespace Topology.NotWLocal

variable {T : Type u}

/-- The cylinder `U × {0, 1}` in the product carrier. -/
def cylinder (U : Set T) : Set (T × Fin 2) :=
  U ×ˢ (univ : Set (Fin 2))

/-- The complement of the distinguished zero-slice point `(t, 0)`. -/
def puncturedZero (t : T) : Set (T × Fin 2) :=
  {(t, (0 : Fin 2))}ᶜ

/-- The one-slice `U × {1}` in the product carrier. -/
def oneSlice (U : Set T) : Set (T × Fin 2) :=
  U ×ˢ ({1} : Set (Fin 2))

/-- The family of open cylinders, the complement of `(t, 0)`, and open one-slices
whose base subsets avoid the distinguished point `t`. -/
def subbasis [TopologicalSpace T] (t : T) : Set (Set (T × Fin 2)) :=
  (cylinder '' {U : Set T | IsOpen U}) ∪ {puncturedZero t} ∪
    (oneSlice '' {U : Set T | IsOpen U ∧ t ∉ U})

/-- A subbasis member is an open cylinder, the complement of `(t, 0)`, or an
open one-slice whose base subset avoids `t`. -/
theorem mem_subbasis_iff [TopologicalSpace T] {t : T} {s : Set (T × Fin 2)} :
    s ∈ subbasis t ↔
      (∃ U, IsOpen U ∧ s = cylinder U) ∨ s = puncturedZero t ∨
        ∃ U, IsOpen U ∧ t ∉ U ∧ s = oneSlice U := sorry

/-- The topology generated by open cylinders, the complement of `(t, 0)`, and
open one-slices whose base subsets avoid `t`. -/
@[implicit_reducible]
def topology [TopologicalSpace T] (t : T) : TopologicalSpace (T × Fin 2) :=
  generateFrom (subbasis t)

/-- The distinguished-point topology is generated by its subbasis. -/
theorem topology_eq_generateFrom [TopologicalSpace T] (t : T) :
    topology t = generateFrom (subbasis t) := sorry

end Topology.NotWLocal

/-- The space `T × {0, 1}` with topology generated by open cylinders, the
complement of `(t, 0)`, and open one-slices whose base subsets avoid `t`. -/
abbrev Topology.NotWLocal (T : Type u) [TopologicalSpace T] (t : T) :=
  WithTopology (T × Fin 2) (Topology.NotWLocal.topology t)

namespace Topology.NotWLocal

variable {T : Type u} [TopologicalSpace T]

/-- The point `(x, i)` of `NotWLocal T t`. -/
def mk {t : T} (x : T) (i : Fin 2) : NotWLocal T t :=
  WithTopology.toTopology (topology t) (x, i)

/-- `mk x i` forgets back to the product pair `(x, i)`. -/
theorem ofTopology_mk {t : T} (x : T) (i : Fin 2) :
    WithTopology.ofTopology (mk x i : NotWLocal T t) = (x, i) := sorry

/-- The zero-slice `X₀ = T × {0}` in `NotWLocal T t`. -/
def zeroSlice (t : T) : Set (NotWLocal T t) :=
  {p | (WithTopology.ofTopology p).2 = 0}

/-- Membership in the zero-slice is having fibre coordinate `0`. -/
theorem mem_zeroSlice_iff {t : T} {p : NotWLocal T t} :
    p ∈ zeroSlice t ↔ (WithTopology.ofTopology p).2 = 0 := sorry

/-- The zero-slice is the image of `T × {0}` under `mk`. -/
theorem zeroSlice_eq_image_mk (t : T) :
    zeroSlice t = (fun p : T × Fin 2 ↦ mk p.1 p.2) '' (univ ×ˢ ({0} : Set (Fin 2))) :=
  sorry

/-- `mk x i` lies on the zero-slice if and only if `i = 0`. -/
theorem mk_mem_zeroSlice {t : T} {x : T} {i : Fin 2} :
    mk x i ∈ zeroSlice t ↔ i = 0 := sorry

/-- Cylinders `U × {0, 1}` are open in `NotWLocal T t`. -/
theorem isOpen_mk_cylinder {t : T} {U : Set T} (hU : IsOpen U) :
    IsOpen (WithTopology.toTopology (topology t) '' cylinder U) := sorry

/-- The complement of `(t, 0)` is open in `NotWLocal T t`. -/
theorem isOpen_mk_puncturedZero {t : T} :
    IsOpen (WithTopology.toTopology (topology t) '' puncturedZero t) := sorry

/-- One-slices `U × {1}` avoiding `t` are open in `NotWLocal T t`. -/
theorem isOpen_mk_oneSlice {t : T} {U : Set T} (hU : IsOpen U) (htU : t ∉ U) :
    IsOpen (WithTopology.toTopology (topology t) '' oneSlice U) := sorry

/-- The distinguished-point two-slice space is spectral when `T` is compact,
Hausdorff, and totally disconnected. -/
instance instSpectralSpace [CompactSpace T] [T2Space T] [TotallyDisconnectedSpace T]
    {t : T} : SpectralSpace (NotWLocal T t) := sorry

variable [CompactSpace T] [T2Space T] [TotallyDisconnectedSpace T]

/-- If the complement of `{t}` is not compact, the closed points of
`NotWLocal T t` are exactly the zero-slice `T × {0}`. -/
@[stacks 0969]
theorem closedPoints_eq (t : T) (ht : ¬ IsCompact ({t}ᶜ : Set T)) :
    closedPoints (NotWLocal T t) = zeroSlice t := sorry

/-- If the complement of `{t}` is not compact, the point `(t, 1)` lies in the
closure of the zero-slice. -/
@[stacks 0969]
theorem mem_closure_zeroSlice (t : T) (ht : ¬ IsCompact ({t}ᶜ : Set T)) :
    mk t 1 ∈ closure (zeroSlice t) := sorry

/-- If the complement of `{t}` is not compact, the canonical map from the
closed points of `NotWLocal T t` to its connected components is bijective. -/
@[stacks 0969]
theorem bijective_fromClosedPoints (t : T) (ht : ¬ IsCompact ({t}ᶜ : Set T)) :
    Function.Bijective
      (ConnectedComponents.fromClosedPoints :
        closedPoints (NotWLocal T t) → ConnectedComponents (NotWLocal T t)) :=
  sorry

/-- If the complement of `{t}` is not compact, the closed points of
`NotWLocal T t` do not form a closed subset. -/
@[stacks 0969]
theorem not_isClosed_closedPoints (t : T) (ht : ¬ IsCompact ({t}ᶜ : Set T)) :
    ¬ IsClosed (closedPoints (NotWLocal T t)) := sorry

end Topology.NotWLocal
