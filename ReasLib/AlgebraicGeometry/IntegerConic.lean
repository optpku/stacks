module

public import Mathlib.Algebra.Field.ZMod
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Algebra.Ring.Equiv
public import Mathlib.Data.Fin.VecNotation
public import Mathlib.Data.Rat.Defs
public import Mathlib.RingTheory.FiniteType

/-!
# The affine integer conic `ℤ[x, y] / (x ^ 2 + y ^ 2 + 1)`

This file constructs the finite-type `ℤ`-algebra
`ℤ[x, y] / (x ^ 2 + y ^ 2 + 1)`, with coordinates `X 0, X 1`.
-/

@[expose] public section

noncomputable section

open MvPolynomial

namespace AlgebraicGeometry.IntegerConic

/-- The polynomial `X 0 ^ 2 + X 1 ^ 2 + 1` in two variables over `ℤ`. -/
def equation : MvPolynomial (Fin 2) ℤ :=
  X 0 ^ 2 + X 1 ^ 2 + 1

/-- The principal ideal generated by `equation`. -/
def ideal : Ideal (MvPolynomial (Fin 2) ℤ) :=
  Ideal.span {equation}

/-- The coordinate ring `ℤ[x, y] / (x ^ 2 + y ^ 2 + 1)`. -/
abbrev CoordinateRing : Type :=
  MvPolynomial (Fin 2) ℤ ⧸ ideal

/-- The class of the `i`-th coordinate in `CoordinateRing`. -/
def coord (i : Fin 2) : CoordinateRing :=
  Ideal.Quotient.mk ideal (X i)

/-- The defining equation vanishes in the quotient. -/
theorem mk_equation_eq_zero :
    Ideal.Quotient.mk ideal equation = 0 := sorry

/-- The coordinate ring is a finite-type `ℤ`-algebra. -/
instance instFiniteType : Algebra.FiniteType ℤ CoordinateRing :=
  inferInstance

/-- The defining equation lies in the kernel of evaluation at an `F_p`-point of the conic. -/
theorem equation_mem_ker_aeval (p : ℕ) [Fact p.Prime] (x y : ZMod p)
    (h : x ^ 2 + y ^ 2 + 1 = 0) {f : MvPolynomial (Fin 2) ℤ} (hf : f ∈ ideal) :
    (aeval ![x, y]).toRingHom f = 0 := by
  have hker : ideal ≤ RingHom.ker (aeval ![x, y]).toRingHom := by
    rw [ideal]
    refine Ideal.span_le.2 ?_
    intro g hg
    rw [Set.mem_singleton_iff.mp hg]
    change (aeval ![x, y]).toRingHom equation = 0
    simpa [equation] using h
  exact RingHom.mem_ker.mp (hker hf)

/-- Evaluation of `CoordinateRing` at an `F_p`-point `(x, y)` of the affine conic. -/
def homZMod (p : ℕ) [Fact p.Prime] (x y : ZMod p) (h : x ^ 2 + y ^ 2 + 1 = 0) :
    CoordinateRing →+* ZMod p :=
  Ideal.Quotient.lift ideal (aeval ![x, y]).toRingHom fun _ hf ↦
    equation_mem_ker_aeval p x y h hf

/-- Evaluation at an `F_p`-point is surjective. -/
theorem homZMod_surjective (p : ℕ) [Fact p.Prime] (x y : ZMod p)
    (h : x ^ 2 + y ^ 2 + 1 = 0) :
    Function.Surjective (homZMod p x y h) := sorry

/-- A ring map `CoordinateRing →+* ℚ` exists if and only if the conic has a rational point. -/
theorem hom_rational_iff_point :
    Nonempty (CoordinateRing →+* ℚ) ↔ ∃ x y : ℚ, x ^ 2 + y ^ 2 + 1 = 0 := sorry

/-- The affine conic has an `F_p`-point for every prime `p`. -/
theorem exists_zmod_point (p : ℕ) [Fact p.Prime] :
    ∃ x y : ZMod p, x ^ 2 + y ^ 2 + 1 = 0 := sorry

/-- There is no ring map from the integer conic to the rational numbers. -/
theorem not_exists_ringHom_rat :
    ¬ Nonempty (CoordinateRing →+* ℚ) := sorry

/-- Every prime gives a maximal ideal whose residue ring is `ZMod p`. -/
theorem exists_maximalIdeal_residueEquiv_zmod (p : ℕ) [Fact p.Prime] :
    ∃ m : Ideal CoordinateRing, m.IsMaximal ∧
      Nonempty ((CoordinateRing ⧸ m) ≃+* ZMod p) := sorry

end AlgebraicGeometry.IntegerConic
