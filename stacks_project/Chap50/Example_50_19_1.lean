module

import ReasLib.RingTheory.Kaehler.MvPolynomial
import StacksCheckRecall

/- Example 50.19.1: in `B = ℂ[X, Y]`, the invariant differential `2X dY` is not a
`B`-linear combination of `d(X²)`, `d(XY)`, and `d(Y²)`. Thus it does not come from the
differentials of the invariant subring generated by `X²`, `XY`, and `Y²`. -/
@[stacks 0FK7] #check (KaehlerDifferential.mvPolynomial_twoXdy_not_linearCombination :
    ¬ ∃ a b c : MvPolynomial (Fin 2) ℂ,
      ((2 : MvPolynomial (Fin 2) ℂ) * MvPolynomial.X 0) •
          KaehlerDifferential.D ℂ (MvPolynomial (Fin 2) ℂ) (MvPolynomial.X 1) =
        a • KaehlerDifferential.D ℂ (MvPolynomial (Fin 2) ℂ) (MvPolynomial.X 0 ^ 2) +
        b • KaehlerDifferential.D ℂ (MvPolynomial (Fin 2) ℂ)
          (MvPolynomial.X 0 * MvPolynomial.X 1) +
        c • KaehlerDifferential.D ℂ (MvPolynomial (Fin 2) ℂ) (MvPolynomial.X 1 ^ 2))
