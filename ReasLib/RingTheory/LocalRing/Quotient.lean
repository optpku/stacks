module

public import Mathlib.RingTheory.LocalRing.Quotient
public import Mathlib.RingTheory.HopkinsLevitzki
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Quotients of Local Rings

@stack 05WQ
@stack 07FH

This file provides the canonical local-ring structures for proper quotients,
including the automatic local-ring instance for a principal quotient generated
by an element of the maximal ideal.  It also records the local and Artinian
instances for quotients by positive powers of the maximal ideal.
-/

open IsLocalRing

universe u

namespace IsLocalRing

variable {R : Type u} [CommRing R] [IsLocalRing R]

/-- The quotient of a local ring by a proper ideal is a local ring. -/
@[stacks 05WQ "proper local quotient"]
theorem quotient (I : Ideal R) (hI : I ≠ ⊤) : IsLocalRing (R ⧸ I) := by
  -- Local instance justification (proof-local temporary data): properness of I supplies quotient nontriviality required by the local-ring construction.
  letI : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
  exact IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective

/-- A quotient by an ideal contained in the maximal ideal of a local ring is
local.  This packages the properness consequence of the containment for
downstream quotient constructions. -/
@[stacks 05WQ "local quotient below the maximal ideal"]
theorem quotient_of_le_maximalIdeal (I : Ideal R) (hI : I ≤ maximalIdeal R) :
    IsLocalRing (R ⧸ I) :=
  quotient I <| ne_top_of_le_ne_top (maximalIdeal.isMaximal R).ne_top hI

/-- The principal ideal generated by an element of the maximal ideal of a
local ring is proper. -/
@[stacks 05WQ "maximal-ideal singleton quotient is proper"]
theorem span_singleton_ne_top (x : maximalIdeal R) :
    Ideal.span ({(x : R)} : Set R) ≠ ⊤ := by
  apply ne_top_of_le_ne_top (maximalIdeal.isMaximal R).ne_top
  rw [Ideal.span_le]
  simpa using x.2

/-- A quotient of a local ring by the principal ideal generated by an element
of its maximal ideal is a local ring.  Its `Nontrivial` instance is inherited
from `IsLocalRing`. -/
@[stacks 05WQ "maximal-ideal singleton quotient is local"]
instance quotientSpanSingleton (x : maximalIdeal R) :
    IsLocalRing (R ⧸ Ideal.span ({(x : R)} : Set R)) :=
  quotient _ (span_singleton_ne_top x)

/-- The residue quotient of a local ring is Artinian. This instance exposes the
field quotient under its canonical ideal-quotient presentation, so downstream
finiteness APIs do not need a local instance bridge through `ResidueField R`. -/
@[stacks 07FH "maximal-ideal quotient is Artinian"]
instance quotientMaximalIdealIsArtinian :
    IsArtinianRing (R ⧸ maximalIdeal R) := by
  -- Local instance justification (proof-local temporary data): the canonical quotient field structure is used only to infer Artinianity.
  letI : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field (maximalIdeal R)
  infer_instance

namespace MaximalIdealQuotient

/-- A quotient of a local ring by a positive power of its maximal ideal is
local. -/
@[stacks 07FH "positive maximal-ideal-power quotient is local"]
instance isLocal (n : ℕ+) :
    IsLocalRing (R ⧸ maximalIdeal R ^ (n : ℕ)) :=
  quotient_of_le_maximalIdeal _ (Ideal.pow_le_self n.ne_zero)

/-- A quotient of a Noetherian local ring by a positive power of its maximal
ideal is Artinian. -/
@[stacks 07FH "positive maximal-ideal-power quotient is Artinian"]
instance isArtinian [IsNoetherianRing R] (n : ℕ+) :
    IsArtinianRing (R ⧸ maximalIdeal R ^ (n : ℕ)) := by
  -- Local instance justification (proof-local temporary data): quotient Noetherianity from surjectivity is needed by the Artinian criterion.
  letI : IsNoetherianRing (R ⧸ maximalIdeal R ^ (n : ℕ)) :=
    isNoetherianRing_of_surjective R _
      (Ideal.Quotient.mk (maximalIdeal R ^ (n : ℕ))) Ideal.Quotient.mk_surjective
  apply (isArtinianRing_iff_isNilpotent_maximalIdeal _).2
  refine ⟨(n : ℕ), ?_⟩
  rw [← IsLocalRing.map_maximalIdeal_of_surjective
      (Ideal.Quotient.mk (maximalIdeal R ^ (n : ℕ))) Ideal.Quotient.mk_surjective,
    ← Ideal.map_pow]
  change Ideal.map (Ideal.Quotient.mk (maximalIdeal R ^ (n : ℕ)))
      (maximalIdeal R ^ (n : ℕ)) = ⊥
  rw [Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]

end MaximalIdealQuotient

end IsLocalRing
