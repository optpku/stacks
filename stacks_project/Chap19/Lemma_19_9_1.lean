module

public import ReasLib.CategoryTheory.Exact.Abelian
import StacksCheckRecall

@[expose] public section

open CategoryTheory

universe u v

namespace CategoryTheory

variable (A : Type u) [Category.{v} A] [Abelian A]

/- Lemma 19.9.1 (05PM) (1): singleton epimorphisms are the covering families of a pretopology on
an abelian category. -/
@[stacks 05PM] #check (Abelian.epiPretopology A : Pretopology A)

/- Lemma 19.9.1 (05PM) (2): a covering presieve is exactly a singleton generated by an
epimorphism. -/
@[stacks 05PM "covering presieves"] #check
  (Abelian.mem_epiPretopology_iff (A := A) :
    ∀ {X : A} {S : Presieve X}, S ∈ Abelian.epiPretopology A X ↔
      ∃ (Y : A) (p : Y ⟶ X), Epi p ∧ S = Presieve.singleton p)

/- Lemma 19.9.1 (05PM) (3): the singleton-epimorphism coverage generates the canonical site
topology on the abelian category. -/
@[stacks 05PM "site topology"] #check
  (Abelian.epiTopology A : GrothendieckTopology A)

/- Lemma 19.9.1 (05PM) (4): the topology of the site is generated by the preceding
pretopology. -/
@[stacks 05PM "pretopology-to-site bridge"] #check
  (Abelian.epiPretopology_toGrothendieck A :
    (Abelian.epiPretopology A).toGrothendieck = Abelian.epiTopology A)

end CategoryTheory
