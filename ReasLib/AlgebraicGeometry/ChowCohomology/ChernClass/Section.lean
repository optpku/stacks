module

public import ReasLib.AlgebraicGeometry.ChowCohomology.ChernClass.RankDecomposition
public import ReasLib.AlgebraicGeometry.ChowGroup.Relative.Cycle
public import ReasLib.AlgebraicGeometry.Scheme.IdealSheafData.RegularSequence
public import ReasLib.AlgebraicGeometry.Scheme.Module.ZeroScheme.FiniteLocallyFree

@[expose] public section

open CategoryTheory

noncomputable section

universe u

namespace AlgebraicGeometry.ChernClass

/-- If a pulled-back section has a zero scheme of the expected dimension and its ideal is
generically generated by a regular sequence of the rank, then the top Chern class capped with
the fundamental class equals the associated zero-scheme class. -/
theorem capFundamental_eq_sectionZeroClass
    {S X X' : Scheme.{u}} [UniversallyCatenary S] (δ : S → ℤ) [IsDimensionFunction δ]
    (p : X ⟶ S) [LocallyOfFiniteType p]
    (E : X.Modules) [E.IsFiniteLocallyFree] (f : X' ⟶ X) [LocallyOfFiniteType f]
    (r : ℕ) [((Scheme.Modules.pullback f).obj E).IsFiniteLocallyFreeOfRank r]
    (s : ((Scheme.Modules.pullback f).obj E).sections) (n : ℤ)
    (hX' : (f ≫ p).closedSubschemeDeltaDimension δ ⊥ = (n : EInt))
    (hZ : (f ≫ p).closedSubschemeDeltaDimension δ
      (Scheme.Modules.sectionZeroIdeal ((Scheme.Modules.pullback f).obj E) r s) ≤
        ((n - (r : ℤ) : ℤ) : EInt))
    (hregular : ∀ ξ : genericPoints
      (Scheme.Modules.sectionZeroIdeal ((Scheme.Modules.pullback f).obj E) r s).subscheme,
      (f ≫ p).relativeDimensionFunction δ
          ((Scheme.Modules.sectionZeroIdeal
            ((Scheme.Modules.pullback f).obj E) r s).subschemeι ξ.1) = n - (r : ℤ) →
        Scheme.IdealSheafData.IsGeneratedByRegularSequenceAt
          (Scheme.Modules.sectionZeroIdeal ((Scheme.Modules.pullback f).obj E) r s)
          ((Scheme.Modules.sectionZeroIdeal
            ((Scheme.Modules.pullback f).obj E) r s).subschemeι ξ.1) r) :
    (chernClass δ p E r).cap
        (Over.homMk f rfl : Over.mk (f ≫ p) ⟶ Over.mk p)
        (𝟙 (Over.mk (f ≫ p))) (Over.homMk f rfl) IsPullback.of_id_snd n
        (RelativeChow.fundamentalClass δ (Over.mk (f ≫ p)) n) =
      RelativeChow.closedSubschemeClass δ (Over.mk (f ≫ p))
        (Scheme.Modules.sectionZeroIdeal ((Scheme.Modules.pullback f).obj E) r s :
          X'.IdealSheafData)
        (n - (r : ℤ)) := sorry

end AlgebraicGeometry.ChernClass
