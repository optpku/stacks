module

public import ReasLib.RingTheory.Depth.Exact
public import Mathlib.RingTheory.KrullDimension.Regular

import ReasLib.RingTheory.Depth.IdealExact
import Mathlib.RingTheory.Regular.Category

/-!
# Depth and Regular Sequences

This leaf records the one-step depth formula and the existence of maximal
regular-sequence extensions.  Maximal-ideal containment is separated as a
general local-ring lemma with no finiteness or Noetherian assumptions.
-/

@[expose] public section

open RingTheory.Sequence IsLocalRing
open scoped ENat

universe u v

namespace RingTheory.Sequence

variable {R : Type u} [CommRing R] [IsLocalRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]

namespace IsSMulRegular

/-- Quotienting a finite module by a regular element of the maximal ideal lowers
the local module depth by one. -/
@[stacks 090R "depth after a regular element"]
theorem moduleDepth_quotSMulTop_eq_sub_one [IsNoetherianRing R]
    [Module.Finite R M] {x : R} (hreg : IsSMulRegular M x)
    (hx : x ∈ maximalIdeal R) :
    moduleDepth R (QuotSMulTop x M) = moduleDepth R M - 1 := sorry

end IsSMulRegular

namespace IsRegular

/-- Every regular sequence on a finite module over a Noetherian local ring
extends to one realizing the module depth. -/
@[stacks 090R "regular sequence realizing depth"]
theorem exists_append_eq_moduleDepth [IsNoetherianRing R] [Module.Finite R M]
    {rs : List R} (hreg : IsRegular M rs) :
    ∃ rs' : List R,
      IsRegular M (rs ++ rs') ∧ moduleDepth R M = (rs ++ rs').length := sorry

/-- A regular sequence over a local ring is contained in the maximal ideal. -/
@[stacks 090R "regular sequence lies in the maximal ideal"]
theorem ofList_le_maximalIdeal {rs : List R} (hreg : IsRegular M rs) :
    Ideal.ofList rs ≤ maximalIdeal R := sorry

/-- A regular sequence in a local ring has every prefix inside the maximal
ideal, so the corresponding prefix quotient is again local. -/
theorem isLocalRing_quotient_take {rs : List R}
    (hreg : IsRegular R rs) (i : ℕ) :
    IsLocalRing (R ⧸ Ideal.ofList (rs.take i)) := sorry

/-- A finite module's regular sequence has length bounded by its local depth. -/
@[stacks 00N4 "regular-sequence depth bound"]
theorem length_le_moduleDepth [Module.Finite R M] {rs : List R}
    (hreg : IsRegular M rs) :
    (rs.length : ℕ∞) ≤ moduleDepth R M := sorry

end IsRegular

end RingTheory.Sequence

namespace RingTheory.Sequence.IsRegular

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]

/-- A regular sequence in a Noetherian local ring cannot be longer than the ring dimension. -/
@[stacks 00OB "regular-sequence dimension bound"]
theorem length_le_ringKrullDim {xs : List R} (hreg : IsRegular R xs) :
    xs.length ≤ ringKrullDim R := sorry

end RingTheory.Sequence.IsRegular

namespace Module

variable {R : Type u} [CommRing R] [IsLocalRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]

/-- A nonzero finite module over a local ring is not generated by the maximal
ideal. -/
theorem maximalIdeal_smul_top_ne_top [Module.Finite R M] [Nontrivial M] :
    maximalIdeal R • (⊤ : Submodule R M) ≠ ⊤ := sorry

/-- A nonzero finite module over a local ring has depth zero exactly when the
maximal ideal contains no regular element on the module. -/
theorem moduleDepth_eq_zero_iff_no_isSMulRegular [Module.Finite R M]
    [Nontrivial M] :
    moduleDepth R M = 0 ↔ ¬ ∃ x ∈ maximalIdeal R, IsSMulRegular M x := sorry

/-- Nonzero depth of a nonzero finite module over a local ring yields a regular
element in the maximal ideal. -/
theorem exists_isSMulRegular_of_moduleDepth_ne_zero [Module.Finite R M]
    [Nontrivial M] (hdepth : moduleDepth R M ≠ 0) :
    ∃ x ∈ maximalIdeal R, IsSMulRegular M x := sorry

/-- A finite value of local module depth is realized by a regular sequence in
the maximal ideal. -/
theorem exists_isRegular_of_moduleDepth_eq {n : ℕ}
    (hdepth : moduleDepth R M = n) :
    ∃ rs : List R, IsRegular M rs ∧
      Ideal.ofList rs ≤ maximalIdeal R ∧ rs.length = n := sorry

end Module

namespace Ideal

variable {R : Type u} [CommRing R]

/-- For a finite module, ideal depth is the supremum of the lengths of weakly
regular sequences contained in the ideal. -/
@[stacks 0AUI]
theorem depth_eq_sSup_lengths_of_isWeaklyRegular (I : Ideal R) (M : Type v)
    [AddCommGroup M] [Module R M] [Module.Finite R M] :
    I.depth M = sSup {d : ℕ∞ | ∃ rs : List R,
      IsWeaklyRegular M rs ∧ ofList rs ≤ I ∧ d = rs.length} := sorry

/-- A natural number is at most the depth precisely when the ideal generates
the whole module or contains a regular sequence of that length. -/
@[stacks 0AUI "regular-sequence length characterization"]
theorem natCast_le_depth_iff
    (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M] (n : ℕ) :
    (n : ℕ∞) ≤ I.depth M ↔
      I • (⊤ : Submodule R M) = ⊤ ∨
        ∃ rs : List R, IsRegular M rs ∧ ofList rs ≤ I ∧ rs.length = n := sorry

/-- For the regular self-module, the exceptional depth-infinity condition is
equivalent to the ideal being the unit ideal. -/
@[stacks 0AUI "self-module characterization"]
theorem natCast_le_depth_self_iff
    (I : Ideal R) (n : ℕ) :
    (n : ℕ∞) ≤ I.depth R ↔
      I = ⊤ ∨ ∃ rs : List R,
        IsRegular R rs ∧ ofList rs ≤ I ∧ rs.length = n := sorry

end Ideal

namespace Ideal

variable {A : Type u} [CommRing A] [IsNoetherianRing A]
variable {M : Type v} [AddCommGroup M] [Module A M] [Module.Finite A M]

/-- For a proper ideal action on a finite Noetherian module, quotienting by a
regular element of the ideal lowers ideal depth by one. -/
@[stacks 0BUW]
theorem depth_quotSMulTop_eq_sub_one (I : Ideal A)
    (hIM : I • (⊤ : Submodule A M) ≠ ⊤) {x : A}
    (hx : x ∈ I) (hreg : IsSMulRegular M x) :
    I.depth (QuotSMulTop x M) = I.depth M - 1 := sorry

/-- Every finite regular sequence contained in an ideal extends to a regular
sequence contained in that ideal whose length equals the ideal depth. -/
@[stacks 0BUW]
theorem exists_isRegular_append_eq_depth (I : Ideal A)
    (hIM : I • (⊤ : Submodule A M) ≠ ⊤) {rs : List A}
    (hreg : IsRegular M rs) (hrsI : Ideal.ofList rs ≤ I) :
    ∃ rs' : List A, IsRegular M (rs ++ rs') ∧
      Ideal.ofList (rs ++ rs') ≤ I ∧ I.depth M = (rs ++ rs').length := sorry

end Ideal
