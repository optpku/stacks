module

public import Mathlib.Algebra.Category.ModuleCat.ChangeOfRings
public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.AdicCompletion.Functoriality
public import ReasLib.RingTheory.DividedPowers.DeRham

@[expose] public section

noncomputable section

open CategoryTheory ModuleCat MonoidalCategory TensorProduct

universe u

namespace DPPolynomial.DeRham

variable (A : Type u) [CommRing A] (ι : Type u) (p : ℕ)

/-- The principal ideal generated by `p` in the divided-power polynomial algebra. -/
noncomputable abbrev principalIdeal : Ideal (DPPolynomial A ι) :=
  Ideal.span ({(p : DPPolynomial A ι)} : Set (DPPolynomial A ι))

/-- The `p`-adic completion of the divided-power polynomial algebra. -/
noncomputable abbrev completedRing : Type u :=
  AdicCompletion (principalIdeal A ι p) (DPPolynomial A ι)

/-- The principal ideal generated by `p` in the coefficient ring. -/
noncomputable abbrev principalIdealA : Ideal A :=
  Ideal.span ({(p : A)} : Set A)

/-- The graded divided-power differential relations in the relative forms of the completed
ring, generated by the images of the polynomial divided powers and all their exterior products. -/
noncomputable def completedRingRelation (i : ℕ) :
    Submodule A (KaehlerDifferential.DeRham.AForm A (completedRing A ι p) i) :=
  let toCompletion := algebraMap (DPPolynomial A ι) (completedRing A ι p)
  match i with
  | 0 => 0
  | k + 1 =>
      Submodule.span A (Set.range fun q : completedRing A ι p × ℕ ×
          ideal A ι (⊥ : Ideal A) × (Fin k → completedRing A ι p) ↦
        KaehlerDifferential.DeRham.aBasic A (completedRing A ι p) (k + 1) q.1
            (Fin.cons (toCompletion ((powers A ι).dpow (q.2.1 + 1) q.2.2.1))
              q.2.2.2) -
          KaehlerDifferential.DeRham.aBasic A (completedRing A ι p) (k + 1)
            (q.1 * toCompletion ((powers A ι).dpow q.2.1 q.2.2.1))
            (Fin.cons (toCompletion q.2.2.1) q.2.2.2))

/-- Relative forms of the completed ring modulo the divided-power relations from its dense
polynomial subalgebra. -/
noncomputable def completedRingForm (i : ℕ) : ModuleCat.{u} A :=
  ModuleCat.of A
    (KaehlerDifferential.DeRham.AForm A (completedRing A ι p) i ⧸
      completedRingRelation A ι p i)

/-- The relative de Rham differential descends through the polynomial divided-power relations
in the completed ring. -/
noncomputable def completedRingFormDifferential (i : ℕ) :
    completedRingForm A ι p i ⟶ completedRingForm A ι p (i + 1) :=
  ModuleCat.ofHom <|
    (completedRingRelation A ι p i).liftQ
      ((completedRingRelation A ι p (i + 1)).mkQ.comp
        (KaehlerDifferential.DeRham.rawD A (completedRing A ι p) i).hom) (by sorry)

/-- The degree-zero completed form module is the completed ring itself; the positive-degree
modules are the `p`-adic completions of its relative divided-power forms. -/
noncomputable def completedForm : ℕ → ModuleCat.{u} A
  | 0 => ModuleCat.of A (completedRing A ι p)
  | i + 1 => ModuleCat.of A
      (AdicCompletion (principalIdealA A p) (completedRingForm A ι p (i + 1)))

/-- The completed tensor product of two `A`-modules. -/
noncomputable abbrev completedTensor (M N : Type u)
    [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N] : Type u :=
  AdicCompletion (principalIdealA A p) (M ⊗[A] N)

/-- The completed coefficient term in degree zero or positive degree. -/
noncomputable def completedCoefficientTerm
    (M : Type u) [AddCommGroup M] [Module A M] : ℕ → ModuleCat.{u} A
  | 0 => ModuleCat.of A M
  | n + 1 => ModuleCat.of A (completedTensor A p M (completedForm A ι p n))

/-- The completed degree-zero unit form. -/
noncomputable def completedFormUnit : completedForm A ι p 0 :=
  (1 : completedRing A ι p)

/-- The augmentation into the completed degree-zero coefficient term. -/
noncomputable def completedAugmentation (M : Type u) [AddCommGroup M] [Module A M] :
    completedCoefficientTerm A ι p M 0 ⟶ completedCoefficientTerm A ι p M 1 :=
  ModuleCat.ofHom
    { toFun := fun m =>
        AdicCompletion.of (principalIdealA A p)
          (M ⊗[A] (completedForm A ι p 0))
          (TensorProduct.tmul A m (completedFormUnit A ι p))
      map_add' := by sorry
      map_smul' := by sorry }

/-- The completed divided-power differential on forms. -/
noncomputable def completedFormDifferential :
    (i : ℕ) → completedForm A ι p i ⟶ completedForm A ι p (i + 1)
  | 0 =>
    ModuleCat.ofHom
      { toFun := fun x =>
          AdicCompletion.of (principalIdealA A p) (completedRingForm A ι p 1)
            ((completedRingFormDifferential A ι p 0).hom
              ((completedRingRelation A ι p 0).mkQ
                (KaehlerDifferential.DeRham.aBasic A (completedRing A ι p) 0 x Fin.elim0)))
        map_add' := by sorry
        map_smul' := by sorry }
  | i + 1 =>
    ModuleCat.ofHom
      ((AdicCompletion.map (principalIdealA A p)
        (completedRingFormDifferential A ι p (i + 1)).hom).restrictScalars A)

/-- The differentials in the completed coefficient complex. -/
noncomputable def completedCoefficientDifferential
    (M : Type u) [AddCommGroup M] [Module A M] :
    (n : ℕ) →
      completedCoefficientTerm A ι p M n ⟶ completedCoefficientTerm A ι p M (n + 1)
  | 0 => completedAugmentation A ι p M
  | n + 1 =>
    ModuleCat.ofHom
      { toFun := fun x =>
          AdicCompletion.map (principalIdealA A p)
            (TensorProduct.map (LinearMap.id (R := A) (M := M))
              (completedFormDifferential A ι p n).hom) x
        map_add' := by sorry
        map_smul' := by sorry }

/-- The augmented completed divided-power de Rham complex. -/
noncomputable def completedCoefficientComplex
    (M : Type u) [AddCommGroup M] [Module A M] :
    CochainComplex (ModuleCat.{u} A) ℕ :=
  CochainComplex.of (completedCoefficientTerm A ι p M)
    (completedCoefficientDifferential A ι p M) (fun _ ↦ by sorry)

/-- The degree-zero completed coefficient term is `M`. -/
theorem completedCoefficientComplex_X_zero
    (M : Type u) [AddCommGroup M] [Module A M] :
    (completedCoefficientComplex A ι p M).X 0 = ModuleCat.of A M := sorry

/-- A positive-degree completed coefficient term is a completed tensor with forms. -/
theorem completedCoefficientComplex_X_succ
    (M : Type u) [AddCommGroup M] [Module A M] (n : ℕ) :
    (completedCoefficientComplex A ι p M).X (n + 1) =
      ModuleCat.of A (completedTensor A p M (completedForm A ι p n)) := sorry

/-- The completed divided-power de Rham coefficient complex is acyclic for complete modules. -/
theorem completedCoefficientComplex_acyclic
    [Fact (Nat.Prime p)] (M : Type u) [AddCommGroup M] [Module A M]
    [IsAdicComplete (principalIdealA A p) M] :
    (completedCoefficientComplex A ι p M).Acyclic := sorry

end DPPolynomial.DeRham
