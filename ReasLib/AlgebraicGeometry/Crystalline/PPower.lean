module

public import ReasLib.AlgebraicGeometry.Crystalline.Site
public import ReasLib.CategoryTheory.Sites.Presheaf.Terminal
public import Mathlib.CategoryTheory.Subfunctor.Basic
public import Mathlib.RingTheory.DividedPowers.SubDPIdeal
public import Mathlib.Algebra.Ring.ULift

@[expose] public section

open AlgebraicGeometry CategoryTheory Opposite

universe u

namespace AlgebraicGeometry.Scheme.Crystalline.PPower

noncomputable section

/-- The affine quotient of `Spec A` by the ideal generated by `p ^ e`. -/
def stageScheme (A : Type u) [CommRing A] (p e : ℕ) : Scheme.{u} :=
  Spec (.of (A ⧸ Ideal.span {(p : A) ^ e}))

/-- The quotient-induced morphism from a prime-power stage to its affine base. -/
def stageToBase (A : Type u) [CommRing A] (p e : ℕ) :
    stageScheme A p e ⟶ Spec (.of A) :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {(p : A) ^ e})))

/-- The structure morphism determined by a prime-local algebra structure on `A`. -/
def baseMap (A : Type u) [CommRing A] (p : ℕ) [Fact (Nat.Prime p)]
    [Algebra (Int.LocalizationAtPrime p) A] :
    Spec (.of A) ⟶ Spec (.of (ULift.{u} (Int.LocalizationAtPrime p))) :=
  Spec.map (CommRingCat.ofHom
    ((algebraMap (Int.LocalizationAtPrime p) A).comp ULift.ringEquiv.toRingHom))

variable (p : ℕ) [Fact (Nat.Prime p)] {A : Type u} [CommRing A]
  [Algebra (Int.LocalizationAtPrime p) A]
variable {I : (Spec (.of A)).IdealSheafData}
  {γ : ∀ V : (Spec (.of A)).affineOpens, DividedPowers (I.ideal V)}
  {h_compatible : ∀ (V : (Spec (.of A)).affineOpens) (f : Γ(Spec (.of A), V)),
    (γ V).IsDPMorphism (γ ((Spec (.of A)).affineBasicOpen f))
      ((Spec (.of A)).presheaf.map (homOfLE ((Spec (.of A)).basicOpen_le f)).op).hom}
  {X : Scheme.{u}} {x₀ : X ⟶ I.subscheme}

/-- A crystalline thickening factors through a prime-power stage if its base map does. -/
def FactorsThrough (e : ℕ) (T : CRIS (Spec (.of A)) I γ h_compatible X x₀) : Prop :=
  ∃ g : T.thickening ⟶ stageScheme A p e,
    T.thickeningToBase = g ≫ stageToBase A p e

/-- Factorization through a prime-power quotient persists at every larger exponent. -/
theorem factorsThrough_mono {e f : ℕ} (hef : e ≤ f)
    {T : CRIS (Spec (.of A)) I γ h_compatible X x₀}
    (hT : FactorsThrough p e T) : FactorsThrough p f T := sorry

/-- Factorization of a crystalline thickening's base map is preserved by precomposition. -/
theorem factorsThrough_precomp {e : ℕ}
    {T U : CRIS (Spec (.of A)) I γ h_compatible X x₀}
    (f : CrystallineObject.Hom T U) (hU : FactorsThrough p e U) :
    FactorsThrough p e T := sorry

/-- Beyond a stable cutoff, every prime-power ideal is a divided-power subideal. -/
def StableTail (I : (Spec (.of A)).IdealSheafData)
    (γ : ∀ V : (Spec (.of A)).affineOpens, DividedPowers (I.ideal V)) (e₀ : ℕ) : Prop :=
  ∀ e ≥ e₀, ∀ V : (Spec (.of A)).affineOpens,
    DividedPowers.IsSubDPIdeal (γ V) (Ideal.span {(p : Γ(Spec (.of A), V)) ^ e})

/-- Compatible divided powers on a quasi-coherent affine ideal with nilpotent residual
prime admit a stable prime-power tail. -/
theorem exists_stableTail (p : ℕ) [Fact (Nat.Prime p)] {A : Type u} [CommRing A]
    [Algebra (Int.LocalizationAtPrime p) A] (I : (Spec (.of A)).IdealSheafData)
    (γ : ∀ V : (Spec (.of A)).affineOpens, DividedPowers (I.ideal V))
    (h_compatible : ∀ (V : (Spec (.of A)).affineOpens) (f : Γ(Spec (.of A), V)),
      (γ V).IsDPMorphism (γ ((Spec (.of A)).affineBasicOpen f))
        ((Spec (.of A)).presheaf.map (homOfLE ((Spec (.of A)).basicOpen_le f)).op).hom)
    (h_I_quasiCoherent : I.toModule.IsQuasicoherent)
    (h_pAmodI : IsNilpotent (Ideal.Quotient.mk
      (I.ideal ⟨⊤, isAffineOpen_top (Spec (.of A))⟩) (p : Γ(Spec (.of A), ⊤)))) :
    ∃ e₀ : ℕ, StableTail p I γ e₀ := sorry

variable (I γ h_compatible X x₀)

/-- The subterminal presheaf selecting thickenings factoring through a prime-power stage. -/
def stageSubfunctor (e : ℕ) :
    Subfunctor (Presheaf.terminal.{u + 1}
      (smallCrystallineSite (Spec (.of A)) I γ h_compatible X x₀)) where
  obj T := fun _ ↦ FactorsThrough p e T.unop.obj.1
  map f _ h := factorsThrough_precomp p f.unop.hom h

/-- Membership in the stage subfunctor is precisely factorization of the thickening. -/
theorem stageSubfunctor_obj (e : ℕ)
    (T : (smallCrystallineSite (Spec (.of A)) I γ h_compatible X x₀)ᵒᵖ)
    (x : (Presheaf.terminal.{u + 1}
      (smallCrystallineSite (Spec (.of A)) I γ h_compatible X x₀)).obj T) :
    x ∈ (stageSubfunctor p I γ h_compatible X x₀ e).obj T ↔
      FactorsThrough p e T.unop.obj.1 := sorry

/-- The presheaf of prime-power-stage crystalline objects. -/
def stagePresheaf (e : ℕ) :
    (smallCrystallineSite (Spec (.of A)) I γ h_compatible X x₀)ᵒᵖ ⥤ Type (u + 1) :=
  (stageSubfunctor p I γ h_compatible X x₀ e).toFunctor

/-- Increasing the exponent includes one stage presheaf into the next. -/
def stageInclusion {e f : ℕ} (hef : e ≤ f) :
    stagePresheaf p I γ h_compatible X x₀ e ⟶
      stagePresheaf p I γ h_compatible X x₀ f :=
  Subfunctor.homOfLe (fun _ _ h ↦ factorsThrough_mono p hef h)

/-- The full crystalline subcategory of thickenings factoring through a prime-power stage. -/
abbrev stageSite (e : ℕ) :=
  ObjectProperty.FullSubcategory
    (fun T : smallCrystallineSite (Spec (.of A)) I γ h_compatible X x₀ ↦
      FactorsThrough p e T.obj.1)

/-- The topology on a prime-power stage induced by the ambient crystalline topology. -/
abbrev stageTopology (h_p : ∀ U : X.affineOpens, IsNilpotent (p : Γ(X, U))) (e : ℕ) :
    GrothendieckTopology (stageSite p I γ h_compatible X x₀ e) :=
  (ObjectProperty.ι (fun T : smallCrystallineSite (Spec (.of A)) I γ h_compatible X x₀ ↦
    FactorsThrough p e T.obj.1)).inducedTopology
      (smallCrystallineTopology p (Spec (.of A)) I γ h_compatible (baseMap A p) X x₀ h_p)

end

end AlgebraicGeometry.Scheme.Crystalline.PPower
