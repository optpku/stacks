module

public import Mathlib.CategoryTheory.Comma.Over.Basic
public import Mathlib.CategoryTheory.Sites.Precoverage
public import ReasLib.CategoryTheory.Limits.FormalCoproduct.Map

/-!
# Fixed-target formal coproducts

This module records the generic formal-coproduct presentation of indexed families of arrows
with one fixed target.  It is independent of any site topology or coverage structure.
-/

@[expose] public section

universe w v u

namespace CategoryTheory
namespace Limits
namespace FormalCoproduct

variable {C : Type u} [Category.{v} C]

/-- Build a fixed-target formal coproduct from an indexed family of arrows into `X`. -/
def ofArrows {X : C} {I : Type w} (U : I → C) (π : ∀ i : I, U i ⟶ X) :
    FormalCoproduct.{w} (CategoryTheory.Over X) :=
  ⟨I, fun i ↦ CategoryTheory.Over.mk (π i)⟩

/-- The presieve generated by a formal coproduct of arrows with fixed target `X`. -/
abbrev toPresieve {X : C} (K : FormalCoproduct.{w} (CategoryTheory.Over X)) : Presieve X :=
  Presieve.ofArrows (fun i ↦ (K.obj i).left) fun i ↦ (K.obj i).hom

/-- The sieve generated by a formal coproduct of arrows with fixed target `X`. -/
abbrev toSieve {X : C} (K : FormalCoproduct.{w} (CategoryTheory.Over X)) : Sieve X :=
  Sieve.generate K.toPresieve

/-- The presieve of a formal coproduct built from arrows is the original arrow presieve. -/
@[simp]
theorem toPresieve_ofArrows {X : C} {I : Type w} (U : I → C)
    (π : ∀ i : I, U i ⟶ X) :
    (ofArrows U π).toPresieve = Presieve.ofArrows U π := sorry

/-- The sieve of a formal coproduct built from arrows is the original generated sieve. -/
@[simp]
theorem toSieve_ofArrows {X : C} {I : Type w} (U : I → C)
    (π : ∀ i : I, U i ⟶ X) :
    (ofArrows U π).toSieve = Sieve.ofArrows U π := sorry

/-- The indexing type of a formal coproduct built from arrows is its original indexing type. -/
@[simp]
theorem ofArrows_index {X : C} {I : Type w} (U : I → C) (π : ∀ i : I, U i ⟶ X) :
    (ofArrows U π).I = I := sorry

/-- The source object of an arrow in a formal coproduct built from arrows is its supplied source.
-/
@[simp]
theorem ofArrows_obj_left {X : C} {I : Type w} (U : I → C)
    (π : ∀ i : I, U i ⟶ X) (i : I) :
    ((ofArrows U π).obj i).left = U i := sorry

/-- The structure arrow of an entry in a formal coproduct built from arrows is the supplied
arrow. -/
@[simp]
theorem ofArrows_obj_hom {X : C} {I : Type w} (U : I → C)
    (π : ∀ i : I, U i ⟶ X) (i : I) :
    ((ofArrows U π).obj i).hom = π i := sorry

/-- Forgetting the structure maps to `X` sends a formal coproduct in `C / X` to its underlying
formal coproduct in `C`. -/
def forgetOver (X : C) :
    FormalCoproduct.{w} (CategoryTheory.Over X) ⥤ FormalCoproduct.{w} C :=
  map (CategoryTheory.Over.forget X)

/-- Forgetting a fixed target retains the indexing type of a formal coproduct. -/
@[simp]
theorem forgetOver_obj_index {X : C} (K : FormalCoproduct.{w} (CategoryTheory.Over X)) :
    ((forgetOver X).obj K).I = K.I := sorry

/-- Forgetting a fixed target replaces each slice object by its underlying source object. -/
@[simp]
theorem forgetOver_obj_obj {X : C} (K : FormalCoproduct.{w} (CategoryTheory.Over X))
    (i : K.I) :
    ((forgetOver X).obj K).obj i = (K.obj i).left := sorry

/-- Forgetting a fixed target preserves the index function of a formal-coproduct morphism. -/
@[simp]
theorem forgetOver_map_f {X : C} {K L : FormalCoproduct.{w} (CategoryTheory.Over X)}
    (φ : K ⟶ L) :
    ((forgetOver X).map φ).f = φ.f := sorry

/-- Forgetting a fixed target replaces each slice morphism by its underlying morphism in `C`. -/
@[simp]
theorem forgetOver_map_φ {X : C} {K L : FormalCoproduct.{w} (CategoryTheory.Over X)}
    (φ : K ⟶ L) (i : K.I) :
    ((forgetOver X).map φ).φ i = (φ.φ i).left := sorry

end FormalCoproduct
end Limits
end CategoryTheory
