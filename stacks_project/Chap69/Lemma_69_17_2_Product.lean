module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Module.IdealProduct
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Module.DirectImage

/-!
# Products of ideal sheaves with modules on algebraic spaces

The product is the subobject generated by local scalar products. These typed
checks retain the compatibility view of its shared construction and specification.
-/

@[expose] public section

open CategoryTheory Opposite AlgebraicGeometry
open AlgebraicGeometry.AlgebraicSpace AlgebraicGeometry.AlgebraicSpace.Modules

universe u

#check
  (AlgebraicGeometry.AlgebraicSpace.Modules.idealProductIndex :
    ∀ {S : Scheme.{u}} {X : AlgebraicSpace S},
      IdealSubobject X → X.Modules → Type (u + 1))

#check
  (AlgebraicGeometry.AlgebraicSpace.Modules.idealProductSite :
    ∀ {S : Scheme.{u}} {X : AlgebraicSpace S}
      (I : IdealSubobject X) (F : X.Modules),
      idealProductIndex I F → smallEtaleSite X)

#check
  (AlgebraicGeometry.AlgebraicSpace.Modules.idealProductSection :
    ∀ {S : Scheme.{u}} {X : AlgebraicSpace S}
      (I : IdealSubobject X) (F : X.Modules)
      (p : idealProductIndex I F), F.val.obj (op (idealProductSite I F p)))

#check
  (AlgebraicGeometry.AlgebraicSpace.Modules.idealProductSubobject :
    ∀ {S : Scheme.{u}} {X : AlgebraicSpace S},
      IdealSubobject X → (F : X.Modules) → Subobject F)

#check
  (AlgebraicGeometry.AlgebraicSpace.Modules.idealProductSubobject_eq :
    ∀ {S : Scheme.{u}} {X : AlgebraicSpace S}
      (I : IdealSubobject X) (F : X.Modules),
      idealProductSubobject I F =
        SheafOfModules.Subobject.generatedBySections F
          (idealProductSite I F) (idealProductSection I F))

#check
  (AlgebraicGeometry.AlgebraicSpace.Modules.idealProductSubobject_spec :
    ∀ {S : Scheme.{u}} {X : AlgebraicSpace S}
      (I : IdealSubobject X) (F : X.Modules) (G : Subobject F),
      idealProductSubobject I F ≤ G ↔
        SheafOfModules.Subobject.containsSections G
          (idealProductSite I F) (idealProductSection I F))

#check
  (AlgebraicGeometry.AlgebraicSpace.Modules.instIsQuasicoherent_idealProductSubobject :
    ∀ {S : Scheme.{u}} {X : AlgebraicSpace S}
      (I : IdealSubobject X) [IsQuasiCoherent I]
      (F : X.Modules) [F.IsQuasicoherent],
      (idealProductSubobject I F : X.Modules).IsQuasicoherent)

#check
  (AlgebraicGeometry.AlgebraicSpace.Modules.pushforward_preservesMonomorphisms :
    ∀ {S : Scheme.{u}} {X Y : AlgebraicSpace S} (f : X ⟶ Y),
      (pushforward f).PreservesMonomorphisms)
