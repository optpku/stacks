module

public import Mathlib.AlgebraicGeometry.Scheme
public import Mathlib.CategoryTheory.EssentialImage
public import Mathlib.Data.Nat.Prime.Int
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import ReasLib.AlgebraicGeometry.RingedSpace.Point

/-!
# One-point locally ringed spaces

This module constructs the one-point locally ringed space attached to a local ring and records a
concrete one-point locally ringed space that is not a scheme.
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace Topology

noncomputable section

universe u

namespace AlgebraicGeometry.LocallyRingedSpace

/-- The unique stalk of `RingedPoint.of R` is a local ring when `R` is local. -/
theorem onePoint_isLocalRing (R : Type u) [CommRing R] [IsLocalRing R]
    (x : RingedPoint.of R) :
    IsLocalRing ((RingedPoint.of R).presheaf.stalk x) := by
  cases x
  exact (RingedPoint.stalkIso R).symm.commRingCatIsoToRingEquiv.isLocalRing

/-- The one-point locally ringed space whose structure sheaf is the skyscraper sheaf of a local
ring `R`. -/
def onePoint (R : Type u) [CommRing R] [IsLocalRing R] : LocallyRingedSpace.{u} where
  toSheafedSpace := RingedPoint.of R
  isLocalRing := onePoint_isLocalRing R

/-- The unique point of `onePoint R` specializes to every point of the space. -/
theorem onePoint_unit_specializes (R : Type u) [CommRing R] [IsLocalRing R]
    (x : onePoint R) :
    RingedPoint.point ⤳ x := by
  cases x
  exact specializes_rfl

/-- The unique stalk of `onePoint R` is canonically isomorphic to `R`. -/
def onePoint_stalkIso (R : Type u) [CommRing R] [IsLocalRing R] (x : onePoint R) :
    (onePoint R).presheaf.stalk x ≅ CommRingCat.of R :=
  TopCat.Sheaf.Skyscraper.stalkIsoOfSpecializes RingedPoint.point (CommRingCat.of R)
    (onePoint_unit_specializes R x)

/-- `onePoint R` is nonempty. -/
def onePoint_nonempty (R : Type u) [CommRing R] [IsLocalRing R] :
    Nonempty (onePoint R) :=
  ⟨PUnit.unit⟩

/-- `onePoint R` is a subsingleton. -/
def onePoint_subsingleton (R : Type u) [CommRing R] [IsLocalRing R] :
    Subsingleton (onePoint R) where
  allEq := sorry

/-- A locally ringed space lies in the essential image of `Scheme.forgetToLocallyRingedSpace` if and
only if it is locally affine in the sense of `Scheme.local_affine`. -/
theorem essImage_iff_local_affine (X : LocallyRingedSpace.{u}) :
    Scheme.forgetToLocallyRingedSpace.essImage X ↔
      ∀ x : X, ∃ (U : OpenNhds x) (S : CommRingCat.{u}),
        Nonempty (X.restrict U.isOpenEmbedding ≅ Spec.toLocallyRingedSpace.obj (op S)) :=
  sorry

/-- `onePoint R` is a scheme if and only if `PrimeSpectrum R` is a subsingleton. -/
theorem onePoint_essImage_iff (R : Type u) [CommRing R] [IsLocalRing R] :
    Scheme.forgetToLocallyRingedSpace.essImage (onePoint R) ↔
      Subsingleton (PrimeSpectrum R) :=
  sorry

/-- The principal ideal generated by `2` in `ℤ` is prime. -/
instance span_two_isPrime : (Ideal.span {(2 : ℤ)}).IsPrime :=
  Ideal.isPrime_span_singleton_of_prime (Nat.prime_iff_prime_int.mp Nat.prime_two)

/-- The localization of `ℤ` at `Ideal.span {(2 : ℤ)}` is a local ring. -/
instance instIsLocalRing_atPrimeTwo :
    IsLocalRing (Localization.AtPrime (Ideal.span {(2 : ℤ)})) :=
  Localization.AtPrime.isLocalRing (Ideal.span {(2 : ℤ)})

/-- The one-point locally ringed space attached to the localization of `ℤ` at `2`. -/
def atPrimeTwo : LocallyRingedSpace.{0} :=
  onePoint (Localization.AtPrime (Ideal.span {(2 : ℤ)}))

/-- `PrimeSpectrum` of the localization of `ℤ` at `2` is not a subsingleton. -/
theorem not_subsingleton_primeSpectrum_atPrimeTwo :
    ¬ Subsingleton (PrimeSpectrum (Localization.AtPrime (Ideal.span {(2 : ℤ)}))) :=
  sorry

/-- `atPrimeTwo` is not a scheme. -/
theorem atPrimeTwo_not_mem_essImage :
    ¬ Scheme.forgetToLocallyRingedSpace.essImage atPrimeTwo :=
  sorry

/-- There exists a one-point locally ringed space that is not a scheme. -/
theorem exists_onePoint_not_scheme :
    ∃ X : LocallyRingedSpace.{0},
      Nonempty X ∧ Subsingleton X ∧ ¬ Scheme.forgetToLocallyRingedSpace.essImage X :=
  sorry

end AlgebraicGeometry.LocallyRingedSpace
