module

public import Mathlib.Algebra.Homology.ShortComplex.ShortExact
public import Mathlib.Algebra.Ring.NegOnePow
public import Mathlib.GroupTheory.FreeAbelianGroup
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Grothendieck Groups of Abelian Categories

The Grothendieck group of an abelian category is presented by generators indexed by objects and
relations supplied by short exact sequences.  The public API consists of the class map, its
universal lift, and additivity on short exact sequences.
-/

@[expose] public section

universe v u w

namespace CategoryTheory

namespace AbelianK0

variable (A : Type u) [Category.{v} A] [Abelian A]

/-- The Grothendieck relation `[X₂] - [X₁] - [X₃]` attached to a short exact sequence
`0 ⟶ X₁ ⟶ X₂ ⟶ X₃ ⟶ 0`. -/
def relation (S : { S : ShortComplex A // S.ShortExact }) : FreeAbelianGroup A :=
  FreeAbelianGroup.of S.1.X₂ - FreeAbelianGroup.of S.1.X₁ - FreeAbelianGroup.of S.1.X₃

/-- The subgroup generated by the Grothendieck relations of short exact sequences. -/
def relations : AddSubgroup (FreeAbelianGroup A) :=
  AddSubgroup.closure (Set.range (relation A))

/-- The relation of a short exact sequence belongs to `relations A`. -/
theorem sub_mem_relations_of_shortExact (S : ShortComplex A) (hS : S.ShortExact) :
    FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃ ∈
      relations A := sorry

end AbelianK0

/-- The Grothendieck group of an abelian category. -/
@[stacks 02MU "Grothendieck group of an abelian category"]
abbrev AbelianK0 (A : Type u) [Category.{v} A] [Abelian A] : Type u :=
  FreeAbelianGroup A ⧸ AbelianK0.relations A

namespace AbelianK0

variable {A : Type u} [Category.{v} A] [Abelian A]

/-- The class of an object in the Grothendieck group of its abelian category. -/
abbrev of (X : A) : AbelianK0 A :=
  QuotientAddGroup.mk' (relations A) (FreeAbelianGroup.of X)

/-- An additive invariant descends to the Grothendieck group when it kills every short-exact
relation. -/
def lift {M : Type*} [AddCommGroup M] (f : A → M)
    (hf : relations A ≤ (FreeAbelianGroup.lift f).ker) : AbelianK0 A →+ M :=
  QuotientAddGroup.lift (relations A) (FreeAbelianGroup.lift f) hf

/-- The descended invariant evaluates on an object class as the original invariant. -/
@[simp↓]
theorem lift_of {M : Type*} [AddCommGroup M] (f : A → M)
    (hf : relations A ≤ (FreeAbelianGroup.lift f).ker) (X : A) :
    lift f hf (of X) = f X := by
  exact FreeAbelianGroup.lift_apply_of f X

/-- Additivity on short exact sequences kills the subgroup of Grothendieck relations. -/
theorem relations_le_ker_of_shortExact {M : Type w} [AddCommGroup M] (f : A → M)
    (hf : ∀ (S : ShortComplex A), S.ShortExact → f S.X₂ = f S.X₁ + f S.X₃) :
    relations A ≤ (FreeAbelianGroup.lift f).ker := by
  apply (AddSubgroup.closure_le _).2
  rintro _ ⟨⟨S, hS⟩, rfl⟩
  change FreeAbelianGroup.lift f (relation A ⟨S, hS⟩) = 0
  simp only [relation, map_sub, FreeAbelianGroup.lift_apply_of]
  rw [hf S hS, add_sub_cancel_left, sub_self]

/-- Descend an invariant additive on short exact sequences to the Grothendieck group. -/
def liftShortExact {M : Type w} [AddCommGroup M] (f : A → M)
    (hf : ∀ (S : ShortComplex A), S.ShortExact → f S.X₂ = f S.X₁ + f S.X₃) :
    AbelianK0 A →+ M :=
  lift f (relations_le_ker_of_shortExact f hf)

/-- The short-exact lift evaluates on an object class as the original invariant. -/
@[simp↓]
theorem liftShortExact_of {M : Type w} [AddCommGroup M] (f : A → M)
    (hf : ∀ (S : ShortComplex A), S.ShortExact → f S.X₂ = f S.X₁ + f S.X₃) (X : A) :
    liftShortExact f hf (of X) = f X :=
  lift_of f (relations_le_ker_of_shortExact f hf) X

/-- Homomorphisms out of the Grothendieck group are determined by object classes. -/
@[ext]
theorem hom_ext {M : Type w} [AddCommGroup M] {f g : AbelianK0 A →+ M}
    (h : ∀ X : A, f (of X) = g (of X)) : f = g := by
  apply QuotientAddGroup.addMonoidHom_ext
  exact FreeAbelianGroup.lift_ext _ _ h

/-- An invariant additive on short exact sequences extends uniquely to the Grothendieck group. -/
theorem existsUnique_lift_shortExact {M : Type w} [AddCommGroup M] (f : A → M)
    (hf : ∀ (S : ShortComplex A), S.ShortExact → f S.X₂ = f S.X₁ + f S.X₃) :
    ∃! g : AbelianK0 A →+ M, ∀ X : A, g (of X) = f X := by
  refine ⟨liftShortExact f hf, liftShortExact_of f hf, ?_⟩
  intro g hg
  exact hom_ext fun X ↦ (hg X).trans (liftShortExact_of f hf X).symm

/-- Notation for the class of an object in an abelian Grothendieck group. -/
notation:max "K₀[" X "]" => AbelianK0.of X

/-- The finite alternating Grothendieck-class sum of a graded family of objects. -/
noncomputable def alternatingSum {ι : Type*} (X : ι → A) (degree : ι → ℤ)
    (support : Finset ι) : AbelianK0 A :=
  Finset.sum support fun i ↦ (Int.negOnePow (degree i) : ℤ) • K₀[X i]

/-- Object classes are additive on short exact sequences. -/
theorem of_shortExact (S : ShortComplex A) (hS : S.ShortExact) :
    K₀[S.X₂] = K₀[S.X₁] + K₀[S.X₃] := sorry

end AbelianK0

end CategoryTheory
