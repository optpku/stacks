module

public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.NumberTheory.Padics.PadicIntegers
public import Mathlib.RingTheory.MvPowerSeries.Basic
public import ReasLib.RingTheory.Module.SectionsWithSupport

@[expose] public section

noncomputable section

namespace PadicNode

/-- The ambient two-variable power-series ring over the p-adic integers. -/
abbrev Ambient (p : ℕ) [Fact p.Prime] := MvPowerSeries (Fin 2) ℤ_[p]

/-- The first formal power-series coordinate in the ambient ring. -/
def x (p : ℕ) [Fact p.Prime] : Ambient p := MvPowerSeries.X (0 : Fin 2)

/-- The second formal power-series coordinate in the ambient ring. -/
def y (p : ℕ) [Fact p.Prime] : Ambient p := MvPowerSeries.X (1 : Fin 2)

/-- The image of the integer `p` in the ambient power-series ring. -/
def pElement (p : ℕ) [Fact p.Prime] : Ambient p :=
  algebraMap ℤ_[p] (Ambient p) (p : ℤ_[p])

/-- The principal relation ideal generated by `x * y - p`. -/
def relationIdeal (p : ℕ) [Fact p.Prime] : Ideal (Ambient p) :=
  Ideal.span ({x p * y p - pElement p} : Set (Ambient p))

/-- The nodal quotient module `Ambient p ⧸ relationIdeal p`. -/
abbrev NodeModule (p : ℕ) [Fact p.Prime] := Ambient p ⧸ relationIdeal p

/-- The principal adic ideal generated by `p` in the ambient ring. -/
def adicIdeal (p : ℕ) [Fact p.Prime] : Ideal (Ambient p) :=
  Ideal.span ({pElement p} : Set (Ambient p))

/-- The support ideal generated by `p` and `x` in the ambient ring. -/
def supportIdeal (p : ℕ) [Fact p.Prime] : Ideal (Ambient p) :=
  Ideal.span ({pElement p, x p} : Set (Ambient p))

/-- The sum of the nodal relation ideal and the `n`th power of the adic ideal. -/
def stageIdeal (p n : ℕ) [Fact p.Prime] : Ideal (Ambient p) :=
  relationIdeal p ⊔ adicIdeal p ^ n

/-- The quotient presenting the nodal module modulo `p ^ n`. -/
abbrev Stage (p n : ℕ) [Fact p.Prime] := Ambient p ⧸ stageIdeal p n

/-- The closed locus cut out by the ideal generated by `p` and `x`. -/
def supportLocus (p : ℕ) [Fact p.Prime] : Set (PrimeSpectrum (Ambient p)) :=
  PrimeSpectrum.zeroLocus (supportIdeal p : Set (Ambient p))

/-- The stage ideal is contained in the first-stage ideal for every positive exponent. -/
theorem stageIdeal_le_first (p n : ℕ) [Fact p.Prime] (hn : 1 ≤ n) :
    stageIdeal p n ≤ stageIdeal p 1 := sorry

/-- The canonical quotient transition from the `n`th stage to the first stage. -/
def stageTransition (p n : ℕ) [Fact p.Prime] (hn : 1 ≤ n) :
    Stage p n →ₗ[Ambient p] Stage p 1 :=
  Submodule.factor (stageIdeal_le_first p n hn)

/-- The quotient transition restricted to sections supported on the locus `(p, x)`,
with values in the full first-stage quotient. -/
def h0TransitionAmbient (p n : ℕ) [Fact p.Prime] (hn : 1 ≤ n) :
    Module.sectionsWithSupport (supportLocus p) (Stage p n) →ₗ[Ambient p] Stage p 1 :=
  (stageTransition p n hn).domRestrict (Module.sectionsWithSupport (supportLocus p) (Stage p n))

/-- The class of `y` in the first quotient stage. -/
def yClass (p : ℕ) [Fact p.Prime] : Stage p 1 :=
  Ideal.Quotient.mk (stageIdeal p 1) (y p)

/-- The first-stage ideal equals the ideal generated by `p` and `x * y`. -/
theorem stageIdeal_one_eq (p : ℕ) [Fact p.Prime] :
    stageIdeal p 1 = Ideal.span ({pElement p, x p * y p} : Set (Ambient p)) := sorry

/-- The image of the supported-section transition from the `n`th nodal quotient stage
to the first stage is the principal ideal generated by the `n`th power of the class of `y`. -/
theorem image_h0Transition_eq_yPow (p n : ℕ) [Fact p.Prime] (hn : 1 ≤ n) :
    Set.range (h0TransitionAmbient p n hn) =
      (Ideal.span ({yClass p ^ n} : Set (Stage p 1)) : Set (Stage p 1)) := sorry

end PadicNode
