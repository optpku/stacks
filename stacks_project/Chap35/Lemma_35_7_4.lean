module

public import ReasLib.AlgebraicGeometry.Scheme.Module.LocalGeneration.Descent
import StacksCheckRecall

@[expose] public section

open CategoryTheory
open AlgebraicGeometry

universe u v

/- Lemma 35.7.4: a quasi-coherent scheme module whose pullbacks along an fpqc covering
family are locally generated by `r` sections is itself locally generated by `r` sections. -/
@[stacks 082U] #check
  (AlgebraicGeometry.Scheme.Modules.IsLocallyGeneratedBy.of_fpqcCovering :
    ∀ {X : Scheme.{u}} {ι : Type v}
      (ℱ : X.Modules) [ℱ.IsQuasicoherent] (r : ℕ)
      (family : ι → Over X), Scheme.FpqcCovering family →
      (∀ i : ι, SheafOfModules.IsLocallyGeneratedBy
        ((Scheme.Modules.pullback (family i).hom).obj ℱ) r) →
      SheafOfModules.IsLocallyGeneratedBy ℱ r)
