module

public import ReasLib.RingTheory.Ideal.HilbertSamuel.TorMultiplicity
import StacksCheckRecall

@[expose] public section

open CategoryTheory
open scoped BigOperators

universe u

/- Lemma 43.16.2: if `I` is generated by a regular sequence `f` of length `r` and
`M ⧸ I • ⊤` has zero-dimensional support, then the degree-`r` Hilbert--Samuel
multiplicity of `M` is the alternating sum of the lengths of
`Torᵢᴿ(R ⧸ I, M)`. -/
@[stacks 0B03] #check
  (Ideal.HilbertSamuel.multiplicityInDegree_eq_torLengthSum_of_regularSequence :
    ∀ {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
      {M : Type u} [AddCommGroup M] [Module R M] [Module.Finite R M]
      (r : ℕ) (I : Ideal R) (f : Fin r → R),
      Ideal.span (Set.range f) = I →
      RingTheory.Sequence.IsRegular R (List.ofFn f) →
      Module.supportDim R (M ⧸ (I • ⊤ : Submodule R M)) = 0 →
      Ideal.HilbertSamuel.multiplicityInDegree I M r =
        ((∑ᶠ i : ℕ, (Int.negOnePow i : ℤ) *
          ((Module.length R
            (ModuleCat.Tor.obj i (ModuleCat.of R (R ⧸ I)) (ModuleCat.of R M))).toNat : ℤ) : ℤ) :
          ℚ))
