module

public import ReasLib.AlgebraicGeometry.Scheme.Module.Coherent.SingletonSupport
import StacksCheckRecall

@[expose] public section

open AlgebraicGeometry CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Scheme.Modules

/- Exercise 111.52.1 (1): on a Noetherian scheme `X`, if `ℱ` is a coherent
`𝒪_X`-module with `moduleSupport ℱ = {x}`, then `x` is a closed point of `X`. -/
@[stacks 02AW] #check
  (AlgebraicGeometry.Scheme.Modules.SingletonSupport.mem_closedPoints :
    ∀ {X : Scheme.{u}} [IsNoetherian X] (ℱ : X.Modules) [ℱ.IsCoherent]
      (x : X) (hSupp : moduleSupport ℱ = {x}), x ∈ closedPoints X)

/- Exercise 111.52.1 (2): on a Noetherian scheme `X`, if `ℱ` is a coherent
`𝒪_X`-module with `moduleSupport ℱ = {x}`, then `cohomology ℱ 0` is not zero. -/
@[stacks 02AW] #check
  (AlgebraicGeometry.Scheme.Modules.SingletonSupport.not_isZero_cohomology_zero :
    ∀ {X : Scheme.{u}} [IsNoetherian X] (ℱ : X.Modules) [ℱ.IsCoherent]
      (x : X) (hSupp : moduleSupport ℱ = {x}), ¬ IsZero (cohomology ℱ 0))

/- Exercise 111.52.1 (3): on a Noetherian scheme `X`, if `ℱ` is a coherent
`𝒪_X`-module with `moduleSupport ℱ = {x}`, then `ℱ` is generated by global
sections. -/
@[stacks 02AW] #check
  (AlgebraicGeometry.Scheme.Modules.SingletonSupport.isGloballyGenerated :
    ∀ {X : Scheme.{u}} [IsNoetherian X] (ℱ : X.Modules) [ℱ.IsCoherent]
      (x : X) (hSupp : moduleSupport ℱ = {x}), SheafOfModules.IsGloballyGenerated ℱ)

/- Exercise 111.52.1 (4): on a Noetherian scheme `X`, if `ℱ` is a coherent
`𝒪_X`-module with `moduleSupport ℱ = {x}`, then `cohomology ℱ p` is zero for
every `p > 0`. -/
@[stacks 02AW] #check
  (AlgebraicGeometry.Scheme.Modules.SingletonSupport.isZero_cohomology_of_pos :
    ∀ {X : Scheme.{u}} [IsNoetherian X] (ℱ : X.Modules) [ℱ.IsCoherent]
      (x : X) (hSupp : moduleSupport ℱ = {x}) (p : ℕ) (hp : 0 < p),
      IsZero (cohomology ℱ p))

end AlgebraicGeometry.Scheme.Modules
