module

public import Mathlib.AlgebraicGeometry.Sites.AffineEtale
public import Mathlib.CategoryTheory.Sites.Finite

/-!
# The small affine etale site

Mathlib already owns the canonical small affine etale site as `Scheme.AffineEtale`. Its
inclusion into the small etale site is `Scheme.AffineEtale.Spec`, and the induced topology is
`Scheme.AffineEtale.topology`.

This module equips that category with the finite part of its canonical induced
pretopology and identifies the resulting topology with the canonical one.
-/

@[expose] public section

open CategoryTheory

universe u v

namespace AlgebraicGeometry.Scheme

noncomputable section

/-- The pretopology of finite covering families on the small affine etale site
of `S`. -/
abbrev smallAffineEtalePretopology (S : Scheme.{u}) : Pretopology S.AffineEtale :=
  (AffineEtale.topology S).toPretopology ⊓ Pretopology.finite S.AffineEtale

/-- The precoverage of families on the small affine etale site that are both
covering for the canonical induced topology and finite. -/
abbrev smallAffineEtalePrecoverage (S : Scheme.{u}) : Precoverage S.AffineEtale :=
  (AffineEtale.topology S).toPrecoverage ⊓ Precoverage.finite S.AffineEtale

/-- A presieve covers in the finite small affine etale precoverage exactly
when it covers for the canonical induced topology and has finitely many
arrows. -/
@[simp]
theorem mem_smallAffineEtalePrecoverage_iff
    (S : Scheme.{u}) {U : S.AffineEtale} {R : Presieve U} :
    R ∈ smallAffineEtalePrecoverage S U ↔
      R ∈ (AffineEtale.topology S).toPrecoverage U ∧ R.uncurry.Finite := sorry

/-- A finite indexed family covers in the small affine etale precoverage
exactly when its underlying morphisms of schemes are jointly surjective. -/
@[simp]
theorem ofArrows_mem_smallAffineEtalePrecoverage_iff
    (S : Scheme.{u}) {U : S.AffineEtale} {ι : Type v} [Finite ι]
    (Y : ι → S.AffineEtale) (π : ∀ i, Y i ⟶ U) :
    Presieve.ofArrows Y π ∈ smallAffineEtalePrecoverage S U ↔
      ⋃ i, Set.range (((AffineEtale.Spec S).map (π i)).left) = Set.univ := sorry

/-- The canonical topology on the small affine etale site is generated by
finite jointly surjective covering families. -/
theorem smallAffineEtaleTopology_def (S : Scheme.{u}) :
    AffineEtale.topology S = (smallAffineEtalePrecoverage S).toGrothendieck := sorry

/-- The underlying precoverage of the finite small affine etale pretopology is
the finite small affine etale precoverage. -/
theorem smallAffineEtalePretopology_toPrecoverage (S : Scheme.{u}) :
    (smallAffineEtalePretopology S).toPrecoverage = smallAffineEtalePrecoverage S := sorry

/-- The topology generated by the finite small affine etale pretopology is the
topology generated by its underlying precoverage. -/
theorem smallAffineEtalePretopology_toGrothendieck (S : Scheme.{u}) :
    (smallAffineEtalePretopology S).toGrothendieck =
      (smallAffineEtalePrecoverage S).toGrothendieck := sorry

end

end AlgebraicGeometry.Scheme
