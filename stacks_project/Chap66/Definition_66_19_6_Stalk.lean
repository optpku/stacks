module

public import Mathlib.CategoryTheory.Limits.Types.ColimitType
public import stacks_project.Chap66.Definition_66_19_6_Neighborhood

/-!
# Stalks of small étale presheaves at geometric points

The stalk of a type-valued presheaf on the small étale site of an algebraic space, at a
geometric point, is the colimit of its sections over étale neighborhoods in that site.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Opposite

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.GeometricPoint

variable {S : Scheme.{u}} {X : AlgebraicSpace S}

/-- The diagram of sections of a presheaf over étale neighborhoods of a geometric point. -/
def sectionsDiagram (xbar : GeometricPoint X)
    (F : (smallEtaleSite X)ᵒᵖ ⥤ Type (u + 1)) :
    (SmallEtaleNeighborhood xbar)ᵒᵖ ⥤ Type (u + 1) :=
  (CategoryOfElements.π (smallLiftFunctor xbar)).op ⋙ F

/-- The value of `sectionsDiagram` at a neighborhood is the value of the presheaf on the
underlying site object. -/
theorem sectionsDiagram_obj (xbar : GeometricPoint X)
    (F : (smallEtaleSite X)ᵒᵖ ⥤ Type (u + 1)) (N : SmallEtaleNeighborhood xbar) :
    (sectionsDiagram xbar F).obj (op N) = F.obj (op N.toSite) :=
  sorry

/-- The morphism of sections diagrams induced by a morphism of presheaves. -/
def sectionsDiagramMap (xbar : GeometricPoint X)
    {F G : (smallEtaleSite X)ᵒᵖ ⥤ Type (u + 1)} (α : F ⟶ G) :
    sectionsDiagram xbar F ⟶ sectionsDiagram xbar G where
  app j := α.app ((CategoryOfElements.π (smallLiftFunctor xbar)).op.obj j)
  naturality := sorry

/-- Componentwise, `sectionsDiagramMap` applies the underlying presheaf morphism. -/
theorem sectionsDiagramMap_app (xbar : GeometricPoint X)
    {F G : (smallEtaleSite X)ᵒᵖ ⥤ Type (u + 1)} (α : F ⟶ G)
    (j : (SmallEtaleNeighborhood xbar)ᵒᵖ) :
    (sectionsDiagramMap xbar α).app j =
      α.app ((CategoryOfElements.π (smallLiftFunctor xbar)).op.obj j) :=
  sorry

/-- Naturality of a presheaf morphism on the étale-neighborhood diagram. -/
theorem sectionsDiagram_natural (xbar : GeometricPoint X)
    {F G : (smallEtaleSite X)ᵒᵖ ⥤ Type (u + 1)} (α : F ⟶ G)
    {j j' : (SmallEtaleNeighborhood xbar)ᵒᵖ} (f : j ⟶ j') :
    (sectionsDiagramMap xbar α).app j' ∘ (sectionsDiagram xbar F).map f =
      (sectionsDiagram xbar G).map f ∘ (sectionsDiagramMap xbar α).app j :=
  sorry

/-- The stalk of a presheaf on the small étale site at a geometric point, as the colimit of
sections over étale neighborhoods in that site. -/
def stalk (xbar : GeometricPoint X) (F : (smallEtaleSite X)ᵒᵖ ⥤ Type (u + 1)) :
    Type (u + 1) :=
  (sectionsDiagram xbar F).ColimitType

/-- The stalk is the colimit type of the sections diagram over étale neighborhoods. -/
theorem stalk_def (xbar : GeometricPoint X) (F : (smallEtaleSite X)ᵒᵖ ⥤ Type (u + 1)) :
    stalk xbar F = (sectionsDiagram xbar F).ColimitType :=
  sorry

/-- The germ map from sections over an étale neighborhood to the stalk. -/
def toStalk {xbar : GeometricPoint X} {F : (smallEtaleSite X)ᵒᵖ ⥤ Type (u + 1)}
    (N : SmallEtaleNeighborhood xbar) (σ : F.obj (op N.toSite)) : stalk xbar F :=
  (sectionsDiagram xbar F).ιColimitType (op N) σ

/-- The germ of a section is the canonical colimit inclusion of that section. -/
theorem toStalk_apply {xbar : GeometricPoint X}
    {F : (smallEtaleSite X)ᵒᵖ ⥤ Type (u + 1)} (N : SmallEtaleNeighborhood xbar)
    (σ : F.obj (op N.toSite)) :
    toStalk N σ = (sectionsDiagram xbar F).ιColimitType (op N) σ :=
  sorry

/-- Germs are compatible with restriction along morphisms of étale neighborhoods. -/
theorem toStalk_map {xbar : GeometricPoint X} {F : (smallEtaleSite X)ᵒᵖ ⥤ Type (u + 1)}
    {N N' : SmallEtaleNeighborhood xbar} (f : N ⟶ N') (σ : F.obj (op N'.toSite)) :
    toStalk N (F.map f.val.op σ) = toStalk N' σ :=
  sorry

/-- Every stalk element is the germ of a section over some étale neighborhood. -/
theorem exists_rep_stalk {xbar : GeometricPoint X} {F : (smallEtaleSite X)ᵒᵖ ⥤ Type (u + 1)}
    (t : stalk xbar F) :
    ∃ (N : SmallEtaleNeighborhood xbar) (σ : F.obj (op N.toSite)), toStalk N σ = t :=
  sorry

/-- Equality of germs is generated by the colimit relation on the sections diagram. -/
theorem toStalk_eq_iff {xbar : GeometricPoint X} {F : (smallEtaleSite X)ᵒᵖ ⥤ Type (u + 1)}
    {N N' : SmallEtaleNeighborhood xbar} (σ : F.obj (op N.toSite)) (σ' : F.obj (op N'.toSite)) :
    toStalk N σ = toStalk N' σ' ↔
      Relation.EqvGen (sectionsDiagram xbar F).ColimitTypeRel ⟨op N, σ⟩ ⟨op N', σ'⟩ :=
  sorry

/-- The stalk functor at a geometric point, sending a presheaf to its stalk. -/
def stalkFunctor (xbar : GeometricPoint X) :
    ((smallEtaleSite X)ᵒᵖ ⥤ Type (u + 1)) ⥤ Type (u + 1) where
  obj F := stalk xbar F
  map {F G} α :=
    ↾((sectionsDiagram xbar F).descColimitType
      ((sectionsDiagram xbar G).coconeTypes.precompose
        (fun j σ ↦ (sectionsDiagramMap xbar α).app j σ)
        (sectionsDiagram_natural xbar α)))
  map_id := sorry
  map_comp := sorry

/-- The stalk functor evaluates to the stalk. -/
theorem stalkFunctor_obj (xbar : GeometricPoint X)
    (F : (smallEtaleSite X)ᵒᵖ ⥤ Type (u + 1)) :
    (stalkFunctor xbar).obj F = stalk xbar F :=
  sorry

end AlgebraicGeometry.AlgebraicSpace.GeometricPoint
