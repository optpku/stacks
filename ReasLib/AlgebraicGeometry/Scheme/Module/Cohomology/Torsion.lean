module

public import ReasLib.AlgebraicGeometry.Scheme.Module.Cohomology.Boundary
public import ReasLib.AlgebraicGeometry.Scheme.Module.ZeroScheme
public import ReasLib.AlgebraicGeometry.Scheme.Morphism.Modification
public import ReasLib.AlgebraicGeometry.Scheme.Normal
public import ReasLib.RingTheory.Normal.Local
public import ReasLib.RingTheory.Normal.Nagata
public import Mathlib.RingTheory.KrullDimension.Basic
public import Mathlib.Algebra.Module.Torsion.Basic
public import Mathlib.LinearAlgebra.Isomorphisms

@[expose] public section

open CategoryTheory Opposite TopologicalSpace
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme.Hom.PrincipalZero

variable {A : Type u} [CommRing A] {X : Scheme.{u}}

/-- The principal zero scheme of the pullback of a scalar along a scheme morphism to
an affine scheme. -/
noncomputable def scheme (f : X ⟶ Spec (.of A)) (a : A) : Scheme.{u} :=
  X.zeroScheme (SheafOfModules.unit X.ringCatSheaf)
    (RingedSpace.unitSectionFromTop X.toRingedSpace (globalSectionsMap f a))

/-- The closed immersion of the principal zero scheme into its ambient scheme. -/
noncomputable abbrev immersion (f : X ⟶ Spec (.of A)) (a : A) : scheme f a ⟶ X :=
  X.zeroSchemeι (SheafOfModules.unit X.ringCatSheaf)
    (RingedSpace.unitSectionFromTop X.toRingedSpace (globalSectionsMap f a))

/-- Global sections of the principal zero scheme, with scalars induced by its morphism
to the affine base. -/
noncomputable abbrev sections (f : X ⟶ Spec (.of A)) (a : A) : ModuleCat A :=
  globalSectionsMod (immersion f a ≫ f) (SheafOfModules.unit (scheme f a).ringCatSheaf)

/-- The scalar-to-section linear map generated by the unit section of the principal
zero scheme. -/
noncomputable def constants (f : X ⟶ Spec (.of A)) (a : A) : A →ₗ[A] sections f a :=
  LinearMap.toSpanSingleton A (sections f a) (RingedSpace.unitTopValue (scheme f a).toRingedSpace)

/-- The scalar-to-section linear map is the global-sections ring map of the principal
zero scheme over the affine base. -/
theorem constants_apply (f : X ⟶ Spec (.of A)) (a scalar : A) :
    constants f a scalar = globalSectionsMap (immersion f a ≫ f) scalar := sorry

/-- Multiplication by the defining scalar followed by restriction to the principal
zero scheme is zero. -/
theorem comp_zero (f : X ⟶ Spec (.of A)) (a : A) :
    (SheafOfModules.unit X.ringCatSheaf).unitHomEquiv.symm
        (RingedSpace.unitSectionFromTop X.toRingedSpace (globalSectionsMap f a)) ≫
      SheafOfModules.unitToPushforwardObjUnit (immersion f a).toRingCatSheafHom = 0 := sorry

/-- The structure-module short complex whose arrows are multiplication by the defining
scalar and restriction to its principal zero scheme. -/
noncomputable def structureComplex (f : X ⟶ Spec (.of A)) (a : A) :
    ShortComplex X.Modules :=
  ShortComplex.mk
    ((SheafOfModules.unit X.ringCatSheaf).unitHomEquiv.symm
      (RingedSpace.unitSectionFromTop X.toRingedSpace (globalSectionsMap f a)))
    (SheafOfModules.unitToPushforwardObjUnit (immersion f a).toRingCatSheafHom)
    (comp_zero f a)

variable [IsLocalRing A] [NagataRing A] [_root_.IsNormalRing A]

/-- For a nonzero scalar and a normal modification over a two-dimensional local normal
Nagata domain, the principal-zero structure-module complex is short exact. -/
theorem shortExact (f : X ⟶ Spec (.of A)) [IsModification f] (a : A)
    (h_dimension : ringKrullDim A = 2) (ha : a ≠ 0) (hX : X.isNormal) :
    (structureComplex f a).ShortExact := sorry

/-- The first cohomology boundary class of a section on the principal zero scheme of
a nonzero scalar on a normal modification. -/
def boundaryValue (f : X ⟶ Spec (.of A)) [IsModification f] (a : A)
    (h_dimension : ringKrullDim A = 2) (ha : a ≠ 0) (hX : X.isNormal)
    (globalSection : sections f a) :
    cohomology f (SheafOfModules.unit X.ringCatSheaf : X.Modules) 1 :=
  cohomologyBoundaryFromExt (S := structureComplex f a) f
    (shortExact f a h_dimension ha hX)
    ((SheafOfModules.pushforwardSections (immersion f a).toRingCatSheafHom
      (RingedSpace.sectionFromTop (SheafOfModules.unit (scheme f a).ringCatSheaf)
        globalSection)).1 (op ⊤))

/-- Principal-zero boundary values preserve addition of global sections. -/
theorem boundaryValue_add (f : X ⟶ Spec (.of A)) [IsModification f] (a : A)
    (h_dimension : ringKrullDim A = 2) (ha : a ≠ 0) (hX : X.isNormal)
    (first second : sections f a) :
    boundaryValue f a h_dimension ha hX (first + second) =
      boundaryValue f a h_dimension ha hX first +
        boundaryValue f a h_dimension ha hX second := sorry

/-- Principal-zero boundary values commute with multiplication by a scalar from the
affine base. -/
theorem boundaryValue_smul (f : X ⟶ Spec (.of A)) [IsModification f] (a : A)
    (h_dimension : ringKrullDim A = 2) (ha : a ≠ 0) (hX : X.isNormal)
    (scalar : A) (globalSection : sections f a) :
    boundaryValue f a h_dimension ha hX (scalar • globalSection) =
      scalar • boundaryValue f a h_dimension ha hX globalSection := sorry

/-- The connecting linear map from sections of the principal zero scheme to first
cohomology of the ambient structure module. -/
noncomputable def boundary (f : X ⟶ Spec (.of A)) [IsModification f] (a : A)
    (h_dimension : ringKrullDim A = 2) (ha : a ≠ 0) (hX : X.isNormal) :
    sections f a →ₗ[A] cohomology f (SheafOfModules.unit X.ringCatSheaf : X.Modules) 1 where
  toFun := boundaryValue f a h_dimension ha hX
  map_add' := boundaryValue_add f a h_dimension ha hX
  map_smul' := boundaryValue_smul f a h_dimension ha hX

/-- The principal-zero connecting map has kernel equal to the image of the constants
from the affine base. -/
theorem boundary_ker (f : X ⟶ Spec (.of A)) [IsModification f] (a : A)
    (h_dimension : ringKrullDim A = 2) (ha : a ≠ 0) (hX : X.isNormal) :
    (boundary f a h_dimension ha hX).ker = (constants f a).range := sorry

/-- The image of the principal-zero connecting map is the submodule of first
structure-module cohomology annihilated by the defining scalar. -/
theorem boundary_range (f : X ⟶ Spec (.of A)) [IsModification f] (a : A)
    (h_dimension : ringKrullDim A = 2) (ha : a ≠ 0) (hX : X.isNormal) :
    (boundary f a h_dimension ha hX).range =
      Submodule.torsionBy A
        (cohomology f (SheafOfModules.unit X.ringCatSheaf : X.Modules) 1) a := sorry

/-- Sections of the principal zero scheme modulo constants identify linearly with the
submodule of first structure-module cohomology annihilated by its defining scalar. -/
noncomputable def cokernelEquivH1Torsion (f : X ⟶ Spec (.of A)) [IsModification f] (a : A)
    (h_dimension : ringKrullDim A = 2) (ha : a ≠ 0) (hX : X.isNormal) :
    (sections f a ⧸ (constants f a).range) ≃ₗ[A]
      Submodule.torsionBy A
        (cohomology f (SheafOfModules.unit X.ringCatSheaf : X.Modules) 1) a :=
  Submodule.quotEquivOfEq _ _ (boundary_ker f a h_dimension ha hX).symm ≪≫ₗ
    (boundary f a h_dimension ha hX).quotKerEquivRange ≪≫ₗ
      LinearEquiv.ofEq _ _ (boundary_range f a h_dimension ha hX)

/-- The principal-zero cokernel equivalence sends a quotient representative to its
connecting boundary class in first cohomology. -/
theorem cokernelEquivH1Torsion_apply_mk (f : X ⟶ Spec (.of A)) [IsModification f] (a : A)
    (h_dimension : ringKrullDim A = 2) (ha : a ≠ 0) (hX : X.isNormal)
    (globalSection : sections f a) :
    (cokernelEquivH1Torsion f a h_dimension ha hX (Submodule.Quotient.mk globalSection) :
      cohomology f (SheafOfModules.unit X.ringCatSheaf : X.Modules) 1) =
        boundary f a h_dimension ha hX globalSection := sorry

end AlgebraicGeometry.Scheme.Hom.PrincipalZero
