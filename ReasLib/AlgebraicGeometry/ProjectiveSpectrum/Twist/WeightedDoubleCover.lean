/-!
# Weighted double covers of the projective line

This file constructs the quotient of a weighted polynomial ring by an equation
whose square term has the same degree as a binary form. It also defines the
projective spectrum, its canonical twists, and the low-degree binary-section
map.
-/

@[expose] public section

open CategoryTheory MvPolynomial
open scoped AlgebraicGeometry BigOperators

noncomputable section

universe u

namespace AlgebraicGeometry.Proj.WeightedDoubleCover

/-- The variables `u`, `v`, and `z` in a weighted double-cover presentation. -/
inductive Variable where
  | u
  | v
  | z
  deriving DecidableEq

/-- The two variables in the binary-form subring. -/
inductive BinaryVariable where
  | u
  | v
  deriving DecidableEq

/-- The polynomial ring on the three variables of a weighted double cover. -/
abbrev PolynomialRing (k : Type u) [CommRing k] :=
  MvPolynomial Variable k

/-- The polynomial ring on the two binary-form variables. -/
abbrev BinaryPolynomialRing (k : Type u) [CommRing k] :=
  MvPolynomial BinaryVariable k

/-- The weight function assigning degrees `1`, `1`, and `d` to `u`, `v`, and `z`. -/
def weight (d : ℕ+) : Variable → ℕ
  | .u => 1
  | .v => 1
  | .z => d

/-- The standard degree-one weight on the two binary-form variables. -/
def binaryWeight : BinaryVariable → ℕ
  | .u => 1
  | .v => 1

/-- The distinguished polynomial generator `u`. -/
abbrev u (k : Type u) [CommRing k] : PolynomialRing k :=
  X Variable.u

/-- The distinguished polynomial generator `v`. -/
abbrev v (k : Type u) [CommRing k] : PolynomialRing k :=
  X Variable.v

/-- The distinguished polynomial generator `z`. -/
abbrev z (k : Type u) [CommRing k] : PolynomialRing k :=
  X Variable.z

/-- The inclusion of binary forms into the weighted polynomial ring. -/
def binaryInclusion (k : Type u) [CommRing k] :
    BinaryPolynomialRing k →ₐ[k] PolynomialRing k :=
  MvPolynomial.rename fun
    | .u => Variable.u
    | .v => Variable.v

/-- The binary generator `u` maps to the weighted generator `u`. -/
@[simp] theorem binaryInclusion_X_u (k : Type u) [CommRing k] :
    binaryInclusion k (X BinaryVariable.u) = u k := by
  simp [binaryInclusion]

/-- The binary generator `v` maps to the weighted generator `v`. -/
@[simp] theorem binaryInclusion_X_v (k : Type u) [CommRing k] :
    binaryInclusion k (X BinaryVariable.v) = v k := by
  simp [binaryInclusion]

/-- The equation `z² - ∏ i, (u - lam i * v)` in the weighted polynomial ring. -/
def relation (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) : PolynomialRing k :=
  z k ^ 2 - ∏ i, (u k - C (lam i) * v k)

/-- The principal ideal generated by the weighted double-cover equation. -/
def ideal (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) : Ideal (PolynomialRing k) :=
  Ideal.span ({relation k d lam} : Set (PolynomialRing k))

/-- The quotient ring defined by the weighted double-cover equation. -/
abbrev Ring (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) :=
  PolynomialRing k ⧸ ideal k d lam

/-- The canonical algebra homomorphism to the weighted double-cover quotient. -/
def quotientMap (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) : PolynomialRing k →ₐ[k] Ring k d lam :=
  Ideal.Quotient.mkₐ k (ideal k d lam)

/-- The defining equation maps to zero in the quotient ring. -/
@[simp] theorem quotientMap_relation_eq_zero (k : Type u) [CommRing k]
    (d : ℕ+) (lam : Fin (2 * (d : ℕ)) → k) :
    quotientMap k d lam (relation k d lam) = 0 := by
  exact Ideal.Quotient.eq_zero_iff_mem.2 <|
    Ideal.subset_span (by simp : relation k d lam ∈ ({relation k d lam} : Set (PolynomialRing k)))

/-- The degree-`n` binary forms, regarded as an integral submodule. -/
abbrev binaryGrading (k : Type u) [CommRing k] (n : ℕ) :
    Submodule ℤ (BinaryPolynomialRing k) :=
  (weightedHomogeneousSubmodule k binaryWeight n).restrictScalars ℤ

/-- The weighted degree-`n` polynomials, regarded as an integral submodule. -/
abbrev polynomialGrading (k : Type u) [CommRing k] (d : ℕ+) (n : ℕ) :
    Submodule ℤ (PolynomialRing k) :=
  (weightedHomogeneousSubmodule k (weight d) n).restrictScalars ℤ

/-- The weighted polynomial ring carries its canonical internal grading. -/
noncomputable instance instPolynomialGradedAlgebra
    (k : Type u) [CommRing k] (d : ℕ+) :
    GradedAlgebra (polynomialGrading k d) :=
  { (MvPolynomial.weightedGradedAlgebra k (weight d)) with }

/-- The defining equation is weighted homogeneous of degree `2d`. -/
theorem relation_mem_polynomialGrading (k : Type u) [CommRing k]
    (d : ℕ+) (lam : Fin (2 * (d : ℕ)) → k) :
    relation k d lam ∈ polynomialGrading k d (2 * (d : ℕ)) := sorry

/-- The canonical quotient grading induced by the weighted polynomial grading. -/
noncomputable def grading (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) (n : ℕ) : Submodule ℤ (Ring k d lam) :=
  GradedAlgebra.Quotient.grading (polynomialGrading k d) (ideal k d lam) n

/-- The quotient grading carries its canonical internal graded-algebra structure. -/
noncomputable instance instGradedAlgebraGrading
    (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) : GradedAlgebra (grading k d lam) := by
  change GradedAlgebra
    (GradedAlgebra.Quotient.grading (polynomialGrading k d) (ideal k d lam))
  exact GradedAlgebra.Quotient.spanSingletonGradedAlgebra
    (polynomialGrading k d) ⟨2 * (d : ℕ), relation_mem_polynomialGrading k d lam⟩

/-- The quotient grading through the additive-subgroup interface used by projective spectra. -/
noncomputable instance instAddSubgroupGradedRing
    (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) :
    @GradedRing ℕ (Ring k d lam) (Submodule ℤ (Ring k d lam))
      inferInstance inferInstance inferInstance inferInstance
      AddSubgroupClass.toAddSubmonoidClass (grading k d lam) :=
  { (instGradedAlgebraGrading k d lam) with }

/-- The algebra homomorphism from binary forms to the quotient ring. -/
def binaryToRing (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) : BinaryPolynomialRing k →ₐ[k] Ring k d lam :=
  (quotientMap k d lam).comp (binaryInclusion k)

/-- The binary generator `u` maps to the quotient class of the weighted generator `u`. -/
@[simp] theorem binaryToRing_X_u (k : Type u) [CommRing k]
    (d : ℕ+) (lam : Fin (2 * (d : ℕ)) → k) :
    binaryToRing k d lam (X BinaryVariable.u) = quotientMap k d lam (u k) := by
  simp [binaryToRing]

/-- The binary generator `v` maps to the quotient class of the weighted generator `v`. -/
@[simp] theorem binaryToRing_X_v (k : Type u) [CommRing k]
    (d : ℕ+) (lam : Fin (2 * (d : ℕ)) → k) :
    binaryToRing k d lam (X BinaryVariable.v) = quotientMap k d lam (v k) := by
  simp [binaryToRing]

/-- The image of the degree-`n` binary forms in the weighted quotient. -/
def binaryGradingImage (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) (n : ℕ) : Submodule ℤ (Ring k d lam) :=
  (binaryGrading k n).map
    ((binaryToRing k d lam).toLinearMap.restrictScalars ℤ :
      BinaryPolynomialRing k →ₗ[ℤ] Ring k d lam)

/-- Below the weight of `z`, every quotient homogeneous element is represented by a binary
form. -/
theorem grading_eq_binaryGradingImage_of_lt (k : Type u) [CommRing k]
    (d : ℕ+) (lam : Fin (2 * (d : ℕ)) → k) {n : ℕ}
    (hn : n < (d : ℕ)) :
    grading k d lam n = binaryGradingImage k d lam n := sorry

/-- Below the weight of `z`, membership in a quotient degree piece is equivalent to membership
in the image of the binary forms of that degree. -/
theorem mem_grading_iff_mem_binaryGradingImage_of_lt
    (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) {n : ℕ} (hn : n < (d : ℕ))
    {x : Ring k d lam} :
    x ∈ grading k d lam n ↔ x ∈ binaryGradingImage k d lam n := by
  rw [grading_eq_binaryGradingImage_of_lt k d lam hn]

/-- The quotient class of the generator `u`. -/
def quotientU (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) : Ring k d lam :=
  quotientMap k d lam (u k)

/-- The quotient class of the generator `v`. -/
def quotientV (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) : Ring k d lam :=
  quotientMap k d lam (v k)

/-- The quotient class of `u` is homogeneous of degree one. -/
theorem quotientU_mem_grading (k : Type u) [CommRing k]
    (d : ℕ+) (lam : Fin (2 * (d : ℕ)) → k) :
    quotientU k d lam ∈ grading k d lam 1 := by
  change Ideal.Quotient.mk (ideal k d lam) (u k) ∈
    GradedAlgebra.Quotient.grading (polynomialGrading k d) (ideal k d lam) 1
  exact GradedAlgebra.Quotient.mk_mem_grading
    (polynomialGrading k d) (ideal k d lam) (by
      rw [Submodule.restrictScalars_mem]
      simpa [weight] using MvPolynomial.isWeightedHomogeneous_X k (weight d) Variable.u)

/-- The quotient class of `v` is homogeneous of degree one. -/
theorem quotientV_mem_grading (k : Type u) [CommRing k]
    (d : ℕ+) (lam : Fin (2 * (d : ℕ)) → k) :
    quotientV k d lam ∈ grading k d lam 1 := by
  change Ideal.Quotient.mk (ideal k d lam) (v k) ∈
    GradedAlgebra.Quotient.grading (polynomialGrading k d) (ideal k d lam) 1
  exact GradedAlgebra.Quotient.mk_mem_grading
    (polynomialGrading k d) (ideal k d lam) (by
      rw [Submodule.restrictScalars_mem]
      simpa [weight] using MvPolynomial.isWeightedHomogeneous_X k (weight d) Variable.v)

/-- The projective spectrum of the canonically graded weighted quotient. -/
abbrev ProjectiveScheme (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) :=
  Proj (grading k d lam)

/-- The degree-one projective open is the whole weighted double-cover spectrum. -/
theorem degreeOpen_one_eq_top (k : Type u) [CommRing k]
    (d : ℕ+) (lam : Fin (2 * (d : ℕ)) → k) :
    Proj.degreeOpen (grading k d lam) 1 = ⊤ := sorry

/-- The degree-zero subring of the weighted quotient. -/
abbrev DegreeZeroRing (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) :=
  grading k d lam 0

/-- The scalar map from the coefficient ring to the degree-zero subring. -/
def degreeZeroAlgebraMap (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) : k →+* DegreeZeroRing k d lam where
  toFun r :=
    ⟨algebraMap k (Ring k d lam) r, by
      change Ideal.Quotient.mk (ideal k d lam) (C r) ∈ grading k d lam 0
      exact GradedAlgebra.Quotient.mk_mem_grading
        (polynomialGrading k d) (ideal k d lam) (by
          rw [Submodule.restrictScalars_mem]
          exact MvPolynomial.isWeightedHomogeneous_C (weight d) r)⟩
  map_one' := Subtype.ext (map_one (algebraMap k (Ring k d lam)))
  map_mul' x y := Subtype.ext (map_mul (algebraMap k (Ring k d lam)) x y)
  map_zero' := Subtype.ext (map_zero (algebraMap k (Ring k d lam)))
  map_add' x y := Subtype.ext (map_add (algebraMap k (Ring k d lam)) x y)

/-- The canonical structure morphism from the projective spectrum to the coefficient spectrum. -/
noncomputable def toSpec (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) : ProjectiveScheme k d lam ⟶ Spec (.of k) :=
  Proj.toSpecZero (grading k d lam) ≫
    Spec.map (CommRingCat.ofHom (degreeZeroAlgebraMap k d lam))

/-- The canonical integral twist on the weighted projective spectrum. -/
noncomputable abbrev twist (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) (n : ℤ) : (ProjectiveScheme k d lam).Modules :=
  Proj.AssociatedModule.twistingSheaf (grading k d lam) n

/-- Every canonical integral twist on the weighted projective spectrum is invertible. -/
noncomputable instance instInvertibleTwist
    (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) (n : ℤ) :
    Scheme.Modules.Invertible (twist k d lam n) :=
  projTwist_invertible_of_degreeOpen_one_eq_top
    (grading k d lam) (degreeOpen_one_eq_top k d lam) n

/-- A binary homogeneous form determines a canonical section of the corresponding twist. -/
noncomputable def binaryTwistSection
    (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) (n : ℕ) (p : binaryGrading k n) :
    Γ(twist k d lam n, ⊤) := by
  apply Proj.AssociatedModule.twistSection (grading k d lam)
  refine ⟨binaryToRing k d lam p, GradedAlgebra.Quotient.mk_mem_grading
    (polynomialGrading k d) (ideal k d lam) ?_⟩
  have hp : (p : BinaryPolynomialRing k) ∈
      weightedHomogeneousSubmodule k binaryWeight n := by
    simpa only [Submodule.restrictScalars_mem] using p.2
  rw [Submodule.restrictScalars_mem]
  refine MvPolynomial.IsWeightedHomogeneous.induction_on
    (motive := fun q hq =>
      (binaryInclusion k q).IsWeightedHomogeneous (weight d) n) ?_ ?_ ?_ hp
  · simpa [binaryInclusion] using MvPolynomial.isWeightedHomogeneous_zero k (weight d) n
  · intro q r hq hr ihq ihr
    simpa using ihq.add ihr
  · intro e r hr
    rw [binaryInclusion, MvPolynomial.rename_monomial]
    apply MvPolynomial.isWeightedHomogeneous_monomial
    rw [← hr]
    change ((Finsupp.weight (weight d)).comp
      (Finsupp.mapDomain.addMonoidHom fun
        | BinaryVariable.u => Variable.u
        | BinaryVariable.v => Variable.v)) e =
      (Finsupp.weight binaryWeight) e
    congr 1
    ext i
    cases i <;> simp [Finsupp.weight_single, binaryWeight, weight]

/-- Below the weight of `z`, the canonical binary-form section map is bijective. -/
theorem binaryTwistSection_bijective_of_lt
    (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) {n : ℕ} (hn : n < (d : ℕ)) :
    Function.Bijective (binaryTwistSection k d lam n) := sorry

/-- The degree-one twist on a weighted double-cover projective spectrum is ample. -/
instance instIsAmpleTwistOne
    (k : Type u) [CommRing k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → k) :
    Scheme.Modules.IsAmple (twist k d lam 1) := sorry

/-- Relative very ampleness of an integral twist over an infinite field forces its index to be
at least the weight of the square-root generator. -/
theorem le_of_twist_relativelyVeryAmple
    (k : Type u) [Field k] [Infinite k] (d : ℕ+)
    (lam : Fin (2 * (d : ℕ)) → kˣ) (n : ℤ)
    (h : RelativelyVeryAmple (toSpec k d (fun i => (lam i : k)))
      (twist k d (fun i => (lam i : k)) n)) :
    (d : ℤ) ≤ n := sorry

end AlgebraicGeometry.Proj.WeightedDoubleCover
