module

public import Mathlib.Algebra.Field.Defs
public import Mathlib.Algebra.Field.Rat
public import Mathlib.Algebra.Field.ULift
public import Mathlib.Data.PNat.Basic
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.LocalRing.ResidueField.Defs
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Ideal.Quotient.FormallyEtale
public import ReasLib.RingTheory.CotangentComplex.Basic

@[expose] public section

universe u

noncomputable section

open CategoryTheory
open CategoryTheory.Limits
open MvPolynomial

namespace EtaleCotangent

/-- The two families of variables `x n` and `y n` for `n ≥ 1` in the presentation. -/
inductive Var
  | x : ℕ+ → Var
  | y : ℕ+ → Var
  deriving DecidableEq

variable (k : Type u)

section

variable [CommRing k]

/-- The relation `x 1 * y 1`. -/
def xyRelation : MvPolynomial Var k :=
  X (.x 1) * X (.y 1)

/-- The relation `x (n * m) ^ m - x n`. -/
def xPowerRelation (n m : ℕ+) : MvPolynomial Var k :=
  X (.x (n * m)) ^ (m : ℕ) - X (.x n)

/-- The relation `y (n * m) ^ m - y n`. -/
def yPowerRelation (n m : ℕ+) : MvPolynomial Var k :=
  X (.y (n * m)) ^ (m : ℕ) - X (.y n)

/-- The three families of defining relations. -/
def relations : Set (MvPolynomial Var k) :=
  {xyRelation k} ∪ Set.range (Function.uncurry (xPowerRelation k)) ∪
    Set.range (Function.uncurry (yPowerRelation k))

/-- The defining ideal `(x 1 * y 1, x (n * m) ^ m - x n, y (n * m) ^ m - y n)`. -/
def relationIdeal : Ideal (MvPolynomial Var k) :=
  Ideal.span (relations k)

/-- The quotient ring `k[{x n}, {y n}] ⧸ (x 1 y 1, x_{n m} ^ m - x n, y_{n m} ^ m - y n)`. -/
abbrev Quotient : Type u :=
  MvPolynomial Var k ⧸ relationIdeal k

/-- The image of `x n` in the quotient. -/
def x (n : ℕ+) : Quotient k :=
  Ideal.Quotient.mk (relationIdeal k) (X (.x n))

/-- The image of `y n` in the quotient. -/
def y (n : ℕ+) : Quotient k :=
  Ideal.Quotient.mk (relationIdeal k) (X (.y n))

/-- The ideal generated by all `x n` and `y n`. -/
def maximalIdeal : Ideal (Quotient k) :=
  Ideal.span (Set.range (x k) ∪ Set.range (y k))

/-- The bilinear relation lies in the defining ideal. -/
theorem xyRelation_mem_relationIdeal : xyRelation k ∈ relationIdeal k := by
  exact Ideal.subset_span (Or.inl (Or.inl (Set.mem_singleton _)))

/-- Each `x`-power relation lies in the defining ideal. -/
theorem xPowerRelation_mem_relationIdeal (n m : ℕ+) :
    xPowerRelation k n m ∈ relationIdeal k := by
  exact Ideal.subset_span (Or.inl (Or.inr ⟨(n, m), rfl⟩))

/-- Each `y`-power relation lies in the defining ideal. -/
theorem yPowerRelation_mem_relationIdeal (n m : ℕ+) :
    yPowerRelation k n m ∈ relationIdeal k := by
  exact Ideal.subset_span (Or.inr ⟨(n, m), rfl⟩)

/-- The images satisfy `x 1 * y 1 = 0`. -/
theorem x_mul_y_one : x k 1 * y k 1 = 0 := by
  simpa only [xyRelation, map_mul, x, y] using
    (Ideal.Quotient.eq_zero_iff_mem.mpr (xyRelation_mem_relationIdeal k))

/-- The `x`-power relations hold in the quotient. -/
theorem x_pow_mul (n m : ℕ+) : x k (n * m) ^ (m : ℕ) = x k n := by
  apply sub_eq_zero.mp
  simpa only [xPowerRelation, map_sub, map_pow, x] using
    (Ideal.Quotient.eq_zero_iff_mem.mpr (xPowerRelation_mem_relationIdeal k n m))

/-- The `y`-power relations hold in the quotient. -/
theorem y_pow_mul (n m : ℕ+) : y k (n * m) ^ (m : ℕ) = y k n := by
  apply sub_eq_zero.mp
  simpa only [yPowerRelation, map_sub, map_pow, y] using
    (Ideal.Quotient.eq_zero_iff_mem.mpr (yPowerRelation_mem_relationIdeal k n m))

/-- Each generator `x n` lies in the ideal generated by all variables. -/
theorem x_mem_maximalIdeal (n : ℕ+) : x k n ∈ maximalIdeal k := by
  exact Ideal.subset_span (Or.inl ⟨n, rfl⟩)

/-- Each generator `y n` lies in the ideal generated by all variables. -/
theorem y_mem_maximalIdeal (n : ℕ+) : y k n ∈ maximalIdeal k := by
  exact Ideal.subset_span (Or.inr ⟨n, rfl⟩)

/-- The variable ideal is idempotent because every generator is a square of another
generator. This does not require the coefficient ring to be a field. -/
theorem maximalIdeal_isIdempotentElem : IsIdempotentElem (maximalIdeal k) := by
  apply le_antisymm Ideal.mul_le_left
  refine Ideal.span_le.mpr ?_
  rintro a (⟨n, rfl⟩ | ⟨n, rfl⟩)
  · rw [← x_pow_mul k n 2, PNat.val_ofNat, pow_two]
    exact Ideal.mul_mem_mul (x_mem_maximalIdeal k (n * 2)) (x_mem_maximalIdeal k (n * 2))
  · rw [← y_pow_mul k n 2, PNat.val_ofNat, pow_two]
    exact Ideal.mul_mem_mul (y_mem_maximalIdeal k (n * 2)) (y_mem_maximalIdeal k (n * 2))

end

section

variable [Field k]

/-- The ideal generated by all variables is maximal. -/
instance maximalIdeal_isMaximal : (maximalIdeal k).IsMaximal := by
  have hrelations : relationIdeal k ≤ RingHom.ker (constantCoeff : MvPolynomial Var k →+* k) := by
    refine Ideal.span_le.mpr ?_
    rintro p ((hp | ⟨⟨n, m⟩, rfl⟩) | ⟨⟨n, m⟩, rfl⟩)
    · rcases hp with rfl
      simp [RingHom.mem_ker, xyRelation]
    · simp [RingHom.mem_ker, xPowerRelation, PNat.ne_zero]
    · simp [RingHom.mem_ker, yPowerRelation, PNat.ne_zero]
  let ε : Quotient k →+* k := Ideal.Quotient.lift (relationIdeal k) constantCoeff hrelations
  have hsurj : Function.Surjective ε := by
    intro a
    exact ⟨Ideal.Quotient.mk _ (C a), by simp [ε]⟩
  have hreduce (p : MvPolynomial Var k) :
      Ideal.Quotient.mk (relationIdeal k) p -
        Ideal.Quotient.mk (relationIdeal k) (C (constantCoeff p)) ∈ maximalIdeal k := by
    induction p using MvPolynomial.induction_on with
    | C a => simp
    | add p q hp hq =>
      simpa only [map_add, add_sub_add_comm] using (maximalIdeal k).add_mem hp hq
    | mul_X p v hp =>
      simp only [map_mul, constantCoeff_X, mul_zero, map_zero, sub_zero]
      apply (maximalIdeal k).mul_mem_left
      cases v with
      | x n => exact x_mem_maximalIdeal k n
      | y n => exact y_mem_maximalIdeal k n
  have hker : RingHom.ker ε = maximalIdeal k := by
    apply le_antisymm
    · intro q hq
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
      have hp : constantCoeff p = 0 := by simpa [RingHom.mem_ker, ε] using hq
      simpa [hp] using hreduce p
    · refine Ideal.span_le.mpr ?_
      rintro q (⟨n, rfl⟩ | ⟨n, rfl⟩)
      · simp [RingHom.mem_ker, x, ε]
      · simp [RingHom.mem_ker, y, ε]
  rw [← hker]
  exact RingHom.ker_isMaximal_of_surjective ε hsurj

/-- The localization of the presented quotient at the maximal ideal generated by all
variables. -/
abbrev localization : Type u :=
  Localization.AtPrime (maximalIdeal k)

/-- The residue map of the localization at the maximal ideal generated by all variables. -/
def residue : localization k →+* IsLocalRing.ResidueField (localization k) :=
  IsLocalRing.residue (localization k)

/-- The maximal ideal of the localization is idempotent. -/
theorem localization_maximalIdeal_isIdempotentElem :
    IsIdempotentElem (IsLocalRing.maximalIdeal (localization k)) := by
  change IsLocalRing.maximalIdeal (localization k) *
      IsLocalRing.maximalIdeal (localization k) = IsLocalRing.maximalIdeal (localization k)
  rw [← Localization.AtPrime.map_eq_maximalIdeal (I := maximalIdeal k), ← Ideal.map_mul]
  exact congrArg (Ideal.map (algebraMap (Quotient k) (localization k)))
    (maximalIdeal_isIdempotentElem k)

/-- The residue map of the localization is formally étale. -/
theorem residue_formallyEtale : (residue k).FormallyEtale := by
  letI := (residue k).toAlgebra
  change Algebra.FormallyEtale (localization k) (IsLocalRing.ResidueField (localization k))
  apply (Algebra.FormallyEtale.iff_of_surjective
    (show Function.Surjective (residue k) from Ideal.Quotient.mk_surjective)).mpr
  change IsIdempotentElem (RingHom.ker (Ideal.Quotient.mk
    (IsLocalRing.maximalIdeal (localization k))))
  rw [Ideal.mk_ker]
  exact localization_maximalIdeal_isIdempotentElem k

/-- The residue map of the localization is surjective. -/
theorem residue_surjective : Function.Surjective (residue k) := by
  exact Ideal.Quotient.mk_surjective

/-- The André-Quillen homology of the residue map is nonzero in cohomological degree `-2`. -/
theorem residue_cotangentComplex_homology_not_isZero :
    ¬ IsZero ((RingHom.cotangentComplex (residue k)).homology (-2)) := by
  intro hzero
  sorry

end

end EtaleCotangent

namespace RingHom

/-- There exists a formally étale surjective ring map with nontrivial
André-Quillen cotangent complex. -/
@[stacks 06E6]
theorem exists_formallyEtale_surjective_cotangentComplex_ne_zero :
    ∃ (A B : Type u) (_ : CommRing A) (_ : CommRing B) (f : A →+* B),
      f.FormallyEtale ∧ Function.Surjective f ∧
        ∃ n : ℤ, ¬ IsZero ((cotangentComplex f).homology n) := by
  let k := ULift.{u} ℚ
  exact ⟨EtaleCotangent.localization k,
    IsLocalRing.ResidueField (EtaleCotangent.localization k), inferInstance, inferInstance,
    EtaleCotangent.residue k, EtaleCotangent.residue_formallyEtale k,
    EtaleCotangent.residue_surjective k, -2,
    EtaleCotangent.residue_cotangentComplex_homology_not_isZero k⟩

end RingHom
