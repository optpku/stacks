module

public import Mathlib.Order.Filter.CountablyGenerated
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.Noetherian.Defs
public import ReasLib.RingTheory.Topology.WeaklyAdmissible
public import ReasLib.RingTheory.Topology.TopologicalNilradical.Quotient
public import ReasLib.Topology.Algebra.TensorProduct.CompletedRing

/-!
# Preservation of admissibility along completed tensor products

If `algebraMap B A` and `algebraMap B C` are continuous maps of linearly
topologized rings, the completed tensor `Completed B A C` preserves weak
pre-admissibility as weak admissibility, pre-admissibility as admissibility,
countable open-ideal neighbourhood bases, pre-adic finitely generated ideals
of definition as adic finitely generated ideals of definition, and pre-adic
Noetherian rings with finite type on the topological-nilradical quotient as
adic Noetherian rings.
-/

@[expose] public section

noncomputable section

open scoped Topology

universe u

namespace Algebra.TensorProduct.Completed

/-- The canonical ideal `I(A ⊗̂_B C) + J(A ⊗̂_B C)` generated by the images of
`I` and `J` under `includeLeft` and `includeRight`. -/
def ofIdeals (B A C : Type u) [CommRing B] [CommRing A] [CommRing C]
    [Algebra B A] [Algebra B C] [TopologicalSpace A] [TopologicalSpace C]
    (I : Ideal A) (J : Ideal C) : Ideal (Completed B A C) :=
  I.map (includeLeft B A C) + J.map (includeRight B A C)

variable {B A C : Type u}
variable [CommRing B] [CommRing A] [CommRing C]
variable [Algebra B A] [Algebra B C]
variable [TopologicalSpace B] [TopologicalSpace A] [TopologicalSpace C]

/-- `ofIdeals I J` is the sum of the extended images of `I` and `J`. -/
theorem ofIdeals_def (I : Ideal A) (J : Ideal C) :
    ofIdeals B A C I J =
      I.map (includeLeft B A C) + J.map (includeRight B A C) := rfl

/-- Finite generation is preserved by `ofIdeals`. -/
theorem ofIdeals_fg (I : Ideal A) (J : Ideal C) (hI : I.FG) (hJ : J.FG) :
    (ofIdeals B A C I J).FG := sorry

/-- If `I` and `J` are finitely generated ideals of definition of pre-adic
rings `A` and `C`, then `ofIdeals I J` is an ideal of definition of
`Completed B A C`. -/
theorem isIdealOfDefinition_ofIdeals [IsTopologicalRing B] [IsLinearTopology B B]
    [TopologicalRing.IsPreadicRing A] [TopologicalRing.IsPreadicRing C]
    [IsLinearTopology A A] [IsLinearTopology C C]
    (hA : Continuous (algebraMap B A)) (hC : Continuous (algebraMap B C))
    (I : Ideal A) (J : Ideal C) (hIfg : I.FG) (hJfg : J.FG)
    (hI : TopologicalRing.Ideal.IsIdealOfDefinition I)
    (hJ : TopologicalRing.Ideal.IsIdealOfDefinition J) :
    TopologicalRing.Ideal.IsIdealOfDefinition (ofIdeals B A C I J) := sorry

/-- If `A` and `C` are weakly pre-admissible, then `Completed B A C` is weakly
admissible. -/
theorem isWeaklyAdmissibleRing [IsTopologicalRing B] [IsLinearTopology B B]
    [TopologicalRing.IsWeaklyPreadmissibleRing A]
    [TopologicalRing.IsWeaklyPreadmissibleRing C]
    (hA : Continuous (algebraMap B A)) (hC : Continuous (algebraMap B C)) :
    TopologicalRing.IsWeaklyAdmissibleRing (Completed B A C) := sorry

/-- If `A` and `C` are pre-admissible, then `Completed B A C` is admissible. -/
theorem isAdmissibleRing [IsTopologicalRing B] [IsLinearTopology B B]
    [TopologicalRing.IsPreadmissibleRing A] [TopologicalRing.IsPreadmissibleRing C]
    (hA : Continuous (algebraMap B A)) (hC : Continuous (algebraMap B C)) :
    TopologicalRing.IsAdmissibleRing (Completed B A C) := sorry

/-- If `A` and `C` have countable fundamental systems of open ideals, then so
does `Completed B A C`. -/
theorem isCountablyGenerated_nhds [IsTopologicalRing B] [IsLinearTopology B B]
    [IsTopologicalRing A] [IsLinearTopology A A]
    [IsTopologicalRing C] [IsLinearTopology C C]
    [(nhds (0 : A)).IsCountablyGenerated] [(nhds (0 : C)).IsCountablyGenerated]
    (hA : Continuous (algebraMap B A)) (hC : Continuous (algebraMap B C)) :
    (nhds (0 : Completed B A C)).IsCountablyGenerated := sorry

/-- If `A` and `C` are pre-adic with finitely generated ideals of definition,
then `Completed B A C` is adic. -/
theorem isAdicRing [IsTopologicalRing B] [IsLinearTopology B B]
    [TopologicalRing.IsPreadicRing A] [TopologicalRing.IsPreadicRing C]
    [IsLinearTopology A A] [IsLinearTopology C C]
    (hA : Continuous (algebraMap B A)) (hC : Continuous (algebraMap B C))
    (hAfg : ∃ I : Ideal A, I.FG ∧ TopologicalRing.Ideal.IsIdealOfDefinition I)
    (hCfg : ∃ J : Ideal C, J.FG ∧ TopologicalRing.Ideal.IsIdealOfDefinition J) :
    TopologicalRing.IsAdicRing (Completed B A C) := sorry

/-- If `A` and `C` are pre-adic with finitely generated ideals of definition,
then `Completed B A C` has a finitely generated ideal of definition. -/
theorem exists_fg_isIdealOfDefinition [IsTopologicalRing B] [IsLinearTopology B B]
    [TopologicalRing.IsPreadicRing A] [TopologicalRing.IsPreadicRing C]
    [IsLinearTopology A A] [IsLinearTopology C C]
    (hA : Continuous (algebraMap B A)) (hC : Continuous (algebraMap B C))
    (hAfg : ∃ I : Ideal A, I.FG ∧ TopologicalRing.Ideal.IsIdealOfDefinition I)
    (hCfg : ∃ J : Ideal C, J.FG ∧ TopologicalRing.Ideal.IsIdealOfDefinition J) :
    ∃ K : Ideal (Completed B A C),
      K.FG ∧ TopologicalRing.Ideal.IsIdealOfDefinition K := sorry

/-- If `A` and `C` are pre-adic with finitely generated ideals of definition,
then `Completed B A C` is adic and has a finitely generated ideal of
definition. -/
theorem isAdicWithFGIdealOfDefinition [IsTopologicalRing B] [IsLinearTopology B B]
    [TopologicalRing.IsPreadicRing A] [TopologicalRing.IsPreadicRing C]
    [IsLinearTopology A A] [IsLinearTopology C C]
    (hA : Continuous (algebraMap B A)) (hC : Continuous (algebraMap B C))
    (hAfg : ∃ I : Ideal A, I.FG ∧ TopologicalRing.Ideal.IsIdealOfDefinition I)
    (hCfg : ∃ J : Ideal C, J.FG ∧ TopologicalRing.Ideal.IsIdealOfDefinition J) :
    TopologicalRing.IsAdicRing (Completed B A C) ∧
      ∃ K : Ideal (Completed B A C),
        K.FG ∧ TopologicalRing.Ideal.IsIdealOfDefinition K := sorry

/-- If `A` and `C` are pre-adic Noetherian and
`B ⧸ topologicalNilradical B →+* A ⧸ topologicalNilradical A` is of finite
type, then `Completed B A C` is Noetherian. -/
theorem isNoetherianRing [IsTopologicalRing B] [IsLinearTopology B B]
    [TopologicalRing.IsPreadicRing A] [TopologicalRing.IsPreadicRing C]
    [IsLinearTopology A A] [IsLinearTopology C C]
    [IsNoetherianRing A] [IsNoetherianRing C]
    (hA : Continuous (algebraMap B A)) (hC : Continuous (algebraMap B C))
    (hfin : (topologicalNilradical.quotientMap (algebraMap B A) hA).FiniteType) :
    IsNoetherianRing (Completed B A C) := sorry

/-- If `A` and `C` are pre-adic Noetherian and
`B ⧸ topologicalNilradical B →+* A ⧸ topologicalNilradical A` is of finite
type, then `Completed B A C` is adic Noetherian. -/
theorem isAdicNoetherianRing [IsTopologicalRing B] [IsLinearTopology B B]
    [TopologicalRing.IsPreadicRing A] [TopologicalRing.IsPreadicRing C]
    [IsLinearTopology A A] [IsLinearTopology C C]
    [IsNoetherianRing A] [IsNoetherianRing C]
    (hA : Continuous (algebraMap B A)) (hC : Continuous (algebraMap B C))
    (hfin : (topologicalNilradical.quotientMap (algebraMap B A) hA).FiniteType) :
    TopologicalRing.IsAdicRing (Completed B A C) ∧
      IsNoetherianRing (Completed B A C) := sorry

end Algebra.TensorProduct.Completed
