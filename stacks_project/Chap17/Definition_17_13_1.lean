module

public import ReasLib.AlgebraicGeometry.RingedSpace.Module.ClosedImmersion
import StacksCheckRecall

@[expose] public section

open AlgebraicGeometry

/- Definition 17.13.1 (01C2): a morphism of ringed spaces is a closed immersion when its
underlying map is a closed embedding, its structure-sheaf map is locally surjective, and the
kernel ideal sheaf is locally generated by sections. -/
@[stacks 01C2]
#check @RingedSpace.IsClosedImmersion

#check @RingedSpace.Hom.idealSheaf
#check @RingedSpace.Hom.idealSheafι
#check @RingedSpace.Hom.idealSheafι_comp
#check @RingedSpace.IsClosedImmersion.of_source_spec
#check @RingedSpace.IsClosedImmersion.iff
#check @RingedSpace.IsClosedImmersion.source_spec
