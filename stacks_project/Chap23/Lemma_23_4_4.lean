module

public import Mathlib.RingTheory.DividedPowers.SubDPIdeal
import StacksCheckRecall

@[expose] public section

universe u

section

variable {A : Type u} [CommRing A] {I : Ideal A}
variable (gamma : DividedPowers I) {S : Set A} (hS : S ⊆ I)

/- Lemma 23.4.4 (07H3): the smallest sub-divided-power ideal containing a set has underlying
ideal generated by its positive divided powers. -/
@[stacks 07H3]
#check (DividedPowers.SubDPIdeal.span_carrier_eq_dpow_span gamma hS :
  (DividedPowers.SubDPIdeal.span gamma S).carrier =
    Ideal.span {y : A | ∃ (n : ℕ) (_ : n ≠ 0) (x : A) (_ : x ∈ S),
      y = gamma.dpow n x})

end
