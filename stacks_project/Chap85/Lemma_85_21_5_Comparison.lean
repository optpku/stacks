module

public import Mathlib.CategoryTheory.Comma.Over.Pullback
public import stacks_project.Chap85.Lemma_85_21_5_Diagram
public import stacks_project.Chap85.Situation_85_3_3_Fiberwise

/-!
# Total site of a simplicial slice diagram

The Grothendieck construction of `sliceDiagram U` is the total category of
objects `V / U_n`. Morphisms correspond to Lemma 85.3.1 pullback-homs via
`Over.mapPullbackAdj`, and selected coverings are identity-degree stage covers.
-/

@[expose] public section

universe u v

open CategoryTheory CategoryTheory.Limits Opposite

noncomputable section

namespace CategoryTheory.SimplicialObject

variable {C : Type u} [Category.{v} C]

/-- The total category `(C / U)_total`: objects are pairs `(n, V / U_n)`. -/
abbrev sliceTotalSite (U : SimplicialObject C) :=
  Grothendieck (sliceDiagram U)

/-- `sliceTotalSite U` is the Grothendieck construction of `sliceDiagram U`. -/
theorem sliceTotalSite_def (U : SimplicialObject C) :
    sliceTotalSite U = Grothendieck (sliceDiagram U) :=
  sorry

/-- Identity-degree fiber precoverage on `(C / U)_total`. -/
abbrev sliceTotalPrecoverage (J : GrothendieckTopology C) (U : SimplicialObject C) :
    Precoverage (sliceTotalSite U) :=
  Grothendieck.precoverage (sliceDiagram U) (slicePrecoverage J U)

/-- The Grothendieck topology on `(C / U)_total` generated by identity-degree stage
covers. -/
abbrev sliceTotalTopology (J : GrothendieckTopology C) (U : SimplicialObject C) :
    GrothendieckTopology (sliceTotalSite U) :=
  Grothendieck.topology (sliceDiagram U) (slicePrecoverage J U)

/-- The total-site topology is generated by `sliceTotalPrecoverage`. -/
theorem sliceTotalTopology_eq_toGrothendieck (J : GrothendieckTopology C)
    (U : SimplicialObject C) :
    sliceTotalTopology J U = (sliceTotalPrecoverage J U).toGrothendieck :=
  sorry

/-- A morphism `V / U_n ⟶ W / U_m` in `(C / U)_total` is equivalently a simplex operator
`φ : [m] ⟶ [n]` together with a morphism `V ⟶ W ×_{U_m} U_n` over `U_n`. -/
def sliceTotalHom_pullbackEquiv (U : SimplicialObject C) [HasPullbacks C]
    {X Y : sliceTotalSite U} :
    (X ⟶ Y) ≃
      Σ φ : Y.base.unop ⟶ X.base.unop,
        X.fiber ⟶ (Over.pullback (U.map φ.op)).obj Y.fiber where
  toFun f :=
    ⟨f.base.unop, (Over.mapPullbackAdj (U.map f.base)).homEquiv X.fiber Y.fiber f.fiber⟩
  invFun p :=
    ({ base := p.1.op,
       fiber := ((Over.mapPullbackAdj (U.map p.1.op)).homEquiv X.fiber Y.fiber).symm p.2 } : X ⟶ Y)
  left_inv := sorry
  right_inv := sorry

/-- `sliceTotalHom_pullbackEquiv` unpacks a total morphism as its simplex operator and
the adjunct pullback-hom. -/
theorem sliceTotalHom_pullbackEquiv_apply (U : SimplicialObject C) [HasPullbacks C]
    {X Y : sliceTotalSite U} (f : X ⟶ Y) :
    sliceTotalHom_pullbackEquiv U f =
      ⟨f.base.unop, (Over.mapPullbackAdj (U.map f.base)).homEquiv X.fiber Y.fiber f.fiber⟩ :=
  sorry

/-- The inverse of `sliceTotalHom_pullbackEquiv` rebuilds the Grothendieck morphism from a
simplex operator and a pullback-hom. -/
theorem sliceTotalHom_pullbackEquiv_symm_apply (U : SimplicialObject C) [HasPullbacks C]
    {X Y : sliceTotalSite U} (φ : Y.base.unop ⟶ X.base.unop)
    (g : X.fiber ⟶ (Over.pullback (U.map φ.op)).obj Y.fiber) :
    (sliceTotalHom_pullbackEquiv U).symm ⟨φ, g⟩ =
      ({ base := φ.op,
         fiber := ((Over.mapPullbackAdj (U.map φ.op)).homEquiv X.fiber Y.fiber).symm g } : X ⟶ Y) :=
  sorry

/-- An identity-degree family covers in `(C / U)_total` iff the underlying family covers in
`J.over U_n`. -/
theorem ofStage_mem_sliceTotalPrecoverage_iff (J : GrothendieckTopology C)
    (U : SimplicialObject C) {X : sliceTotalSite U} {I : Type (max u v)}
    (V : I → Over (U.obj X.base)) (p : ∀ i, V i ⟶ X.fiber) :
    Grothendieck.ofFiber (sliceDiagram U) X V p ∈ sliceTotalPrecoverage J U X ↔
      Presieve.ofArrows V p ∈ slicePrecoverage J U X.base X.fiber :=
  sorry

end CategoryTheory.SimplicialObject
