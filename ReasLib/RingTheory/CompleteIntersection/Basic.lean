module

public import Mathlib.RingTheory.EssentialFiniteness
public import Mathlib.RingTheory.Regular.RegularSequence
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Sequence.Regularity

@[expose] public section

/-!
# Complete Intersections: Basic Definitions

This module contains the presentation-theoretic core of complete intersections:
regular-sequence kernels and local complete intersections over a field.
-/

universe u v w

open Ideal RingTheory Sequence IsLocalRing

namespace Ideal

variable {R : Type u} [CommRing R]

/-- An ideal is generated by a regular sequence when it is the ideal spanned by a regular list. -/
@[stacks 00SC "ideal generated by a regular sequence"]
def IsGeneratedByRegularSequence (I : Ideal R) : Prop :=
  ∃ fs : List R, IsRegular R fs ∧ Ideal.ofList fs = I

/-- An ideal is generated by a regular sequence exactly when it is spanned by a regular list. -/
@[simp]
theorem isGeneratedByRegularSequence_iff (I : Ideal R) :
    I.IsGeneratedByRegularSequence ↔
      ∃ fs : List R, IsRegular R fs ∧ Ideal.ofList fs = I := sorry

namespace IsGeneratedByRegularSequence

/-- A regular list spanning an ideal proves that the ideal is generated by a regular sequence. -/
theorem of_regularSequence {I : Ideal R} {fs : List R} (hfs : IsRegular R fs)
    (hI : Ideal.ofList fs = I) : I.IsGeneratedByRegularSequence := sorry

/-- A regular-sequence-generated ideal admits a regular list that spans it. -/
theorem exists_regularSequence {I : Ideal R} (hI : I.IsGeneratedByRegularSequence) :
    ∃ fs : List R, IsRegular R fs ∧ Ideal.ofList fs = I := sorry

section Equiv

variable {S : Type v} [CommRing S]

/-- Mapping a regular-sequence-generated ideal along a ring equivalence preserves the
regular-sequence condition. -/
@[stacks 00SC "regular-sequence ideal under ring equivalence"]
theorem map_ringEquiv {I : Ideal R} (hI : I.IsGeneratedByRegularSequence)
    (e : R ≃+* S) : (I.map (e : R →+* S)).IsGeneratedByRegularSequence := sorry

/-- A ring equivalence preserves and reflects whether an ideal is generated by a regular
sequence. -/
@[stacks 00SC "regular-sequence ideal under ring equivalence iff"]
theorem map_ringEquiv_iff (I : Ideal R) (e : R ≃+* S) :
    (I.map (e : R →+* S)).IsGeneratedByRegularSequence ↔
      I.IsGeneratedByRegularSequence := sorry

end Equiv

end IsGeneratedByRegularSequence

end Ideal

namespace RingHom

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S]

/-- The kernel of a ring homomorphism is generated by a regular sequence in its source ring. -/
@[stacks 00SC "regular-sequence kernel"]
abbrev KernelIsGeneratedByRegularSequence (f : R →+* S) : Prop :=
  (RingHom.ker f).IsGeneratedByRegularSequence

namespace KernelIsGeneratedByRegularSequence

variable {A : Type u} {B : Type v} {C : Type w}
variable [CommRing A] [CommRing B] [CommRing C]

/-- Precomposing a presentation by a ring equivalence preserves the property that its kernel is
generated by a regular sequence. -/
@[stacks 00SC "regular-sequence kernel under source ring equivalence"]
theorem comp_ringEquiv {f : B →+* C}
    (h : f.KernelIsGeneratedByRegularSequence) (e : A ≃+* B) :
    (f.comp (e : A →+* B)).KernelIsGeneratedByRegularSequence := sorry

/-- Precomposition by a ring equivalence preserves and reflects the property that a kernel is
generated by a regular sequence. -/
@[stacks 00SC "regular-sequence kernel under source ring equivalence iff"]
theorem comp_ringEquiv_iff {f : B →+* C} (e : A ≃+* B) :
    (f.comp (e : A →+* B)).KernelIsGeneratedByRegularSequence ↔
      f.KernelIsGeneratedByRegularSequence := sorry

/-- A regular list spanning the kernel proves that the kernel is generated by a regular sequence. -/
theorem of_regularSequence {f : A →+* B} {fs : List A} (hfs : IsRegular A fs)
    (hker : Ideal.ofList fs = RingHom.ker f) :
    f.KernelIsGeneratedByRegularSequence := sorry

/-- A regular-sequence-generated kernel admits a regular list that spans it. -/
theorem exists_regularSequence {f : A →+* B}
    (hf : f.KernelIsGeneratedByRegularSequence) :
    ∃ fs : List A, IsRegular A fs ∧ Ideal.ofList fs = RingHom.ker f := sorry

end KernelIsGeneratedByRegularSequence

end RingHom

namespace Algebra

/-- A local `k`-algebra `S` essentially of finite type over `k` is a complete intersection over
`k` when it is the quotient of a regular local `k`-algebra essentially of finite type by a kernel
generated by a regular sequence. -/
@[stacks 00SD]
class IsCompleteIntersectionOver (k : Type u) (S : Type v) [Field k] [CommRing S] [Algebra k S] :
    Prop where
  /-- A regular-local, essentially finite type presentation with regular-sequence kernel. -/
  exists_presentation :
    ∃ (R : Type (max u v)) (_ : CommRing R) (_ : Algebra k R) (_ : Algebra.EssFiniteType k R)
      (_ : IsRegularLocalRing R) (π : R →ₐ[k] S),
        Function.Surjective π ∧ π.toRingHom.KernelIsGeneratedByRegularSequence

/-- The complete-intersection-over-a-field condition is exactly the existence of a regular-local,
essentially finite type presentation with regular-sequence kernel. -/
@[stacks 00SD "presentation criterion for a complete intersection over a field"]
theorem isCompleteIntersectionOver_iff
    (k : Type u) (S : Type v) [Field k] [CommRing S] [Algebra k S] :
    IsCompleteIntersectionOver k S ↔
      ∃ (R : Type (max u v)) (_ : CommRing R) (_ : Algebra k R)
        (_ : Algebra.EssFiniteType k R) (_ : IsRegularLocalRing R) (π : R →ₐ[k] S),
          Function.Surjective π ∧ π.toRingHom.KernelIsGeneratedByRegularSequence := sorry

namespace IsCompleteIntersectionOver

variable {k : Type u} {S : Type v} [Field k] [CommRing S] [Algebra k S]

/-- Extract a regular-local, essentially finite type presentation from a complete intersection
over a field. -/
theorem presentation [IsCompleteIntersectionOver k S] :
    ∃ (R : Type (max u v)) (_ : CommRing R) (_ : Algebra k R)
      (_ : Algebra.EssFiniteType k R) (_ : IsRegularLocalRing R) (π : R →ₐ[k] S),
        Function.Surjective π ∧ π.toRingHom.KernelIsGeneratedByRegularSequence := sorry

/-- Build a complete intersection over a field from a regular-local, essentially finite type
presentation with regular-sequence kernel. -/
theorem of_presentation
    (h : ∃ (R : Type (max u v)) (_ : CommRing R) (_ : Algebra k R)
      (_ : Algebra.EssFiniteType k R) (_ : IsRegularLocalRing R) (π : R →ₐ[k] S),
        Function.Surjective π ∧ π.toRingHom.KernelIsGeneratedByRegularSequence) :
    IsCompleteIntersectionOver k S := sorry

end IsCompleteIntersectionOver

section

variable {k : Type u} {S : Type v} [Field k] [CommRing S] [Algebra k S]

namespace IsCompleteIntersectionOver

/-- A complete intersection over a field is essentially of finite type over that field. -/
theorem essFiniteType (h : IsCompleteIntersectionOver k S) :
    Algebra.EssFiniteType k S := sorry

/-- A complete intersection over a field is a local ring. This remains a named theorem rather
than an instance because the target `IsLocalRing S` does not determine the ground field `k`. -/
@[stacks 00SD "complete intersections over fields are local rings"]
theorem isLocalRing (h : IsCompleteIntersectionOver k S) : IsLocalRing S := sorry

end IsCompleteIntersectionOver

end

section

variable {k : Type u} {S : Type v} [Field k] [CommRing S] [Algebra k S]
variable [Algebra.EssFiniteType k S]

namespace IsCompleteIntersectionOver

/-- A regular local essentially-finite-type algebra over a field is a complete intersection.
This is a named constructor rather than a global instance: `Algebra.EssFiniteType k S` is also a
derived instance of `IsCompleteIntersectionOver k S`, so registering the converse construction
would create a typeclass cycle while synthesizing the complete-intersection condition. -/
@[stacks 00SD "regular-local complete-intersection constructor"]
theorem of_isRegularLocalRing [IsRegularLocalRing S] :
    IsCompleteIntersectionOver k S := sorry

end IsCompleteIntersectionOver

end

end Algebra
