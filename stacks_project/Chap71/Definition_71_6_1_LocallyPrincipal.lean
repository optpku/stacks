module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.LocalGeneration
public import stacks_project.Chap65.Definition_65_12_1_Subspace
public import stacks_project.Chap67.Lemma_67_28_12_IdealSheaf

/-!
# Locally principal closed subspaces of algebraic spaces

A closed immersion of algebraic spaces is locally principal when its associated
ideal sheaf on the small étale site is locally generated by one section.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

/-- A morphism of algebraic spaces is a locally principal closed subspace when it is a
closed immersion whose associated ideal sheaf is locally generated by one section. -/
class IsLocallyPrincipalClosedSubspace {S : Scheme.{u}} {D X : AlgebraicSpace S}
    (i : D ⟶ X) : Prop extends IsClosedImmersion i where
  /-- The associated ideal sheaf is locally generated by one section. -/
  idealSheaf_isLocallyGeneratedBy_one :
    SheafOfModules.IsLocallyGeneratedBy (Hom.idealSheaf i) 1

/-- Local principality unfolds as a closed immersion whose ideal sheaf is locally
generated by one section. -/
theorem isLocallyPrincipalClosedSubspace_iff {S : Scheme.{u}} {D X : AlgebraicSpace S}
    (i : D ⟶ X) :
    IsLocallyPrincipalClosedSubspace i ↔
      IsClosedImmersion i ∧
        SheafOfModules.IsLocallyGeneratedBy (Hom.idealSheaf i) 1 :=
  sorry

/-- A locally principal closed subspace supplies local generation of its ideal sheaf by
one section to typeclass search. -/
instance instIsLocallyGeneratedBy_idealSheaf {S : Scheme.{u}} {D X : AlgebraicSpace S}
    (i : D ⟶ X) [h : IsLocallyPrincipalClosedSubspace i] :
    SheafOfModules.IsLocallyGeneratedBy (Hom.idealSheaf i) 1 :=
  h.idealSheaf_isLocallyGeneratedBy_one

/-- The identity closed immersion of an algebraic space is locally principal. -/
instance instIsLocallyPrincipalClosedSubspace_id {S : Scheme.{u}} {X : AlgebraicSpace S} :
    IsLocallyPrincipalClosedSubspace (𝟙 X) :=
  sorry

namespace ClosedSubspace

/-- A closed subspace is locally principal exactly when the ideal sheaf of its inclusion
is locally generated by one section. -/
theorem isLocallyPrincipalClosedSubspace_iff {S : Scheme.{u}} {X : AlgebraicSpace S}
    (Z : ClosedSubspace X) :
    IsLocallyPrincipalClosedSubspace Z.ι ↔
      SheafOfModules.IsLocallyGeneratedBy (Hom.idealSheaf Z.ι) 1 :=
  sorry

end ClosedSubspace

end AlgebraicGeometry.AlgebraicSpace
