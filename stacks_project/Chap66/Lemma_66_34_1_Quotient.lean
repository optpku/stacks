/-!
# Free abstract-group quotients of algebraic spaces

This module records the pointwise action of an abstract group homomorphism
`ρ : G →* Aut X` on the functor of points of an algebraic space, the orbit
presheaf `T ↦ X(T)/G`, and the associated fppf quotient sheaf.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Limits Opposite

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

variable {S : Scheme.{u}} {X : AlgebraicSpace S} {G : Type u} [Group G]

/-- The pointwise action of `g : G` on an `S`-point of `X`, via `ρ : G →* Aut X`. -/
def smul (ρ : G →* Aut X) {T : (Over S)ᵒᵖ} (g : G)
    (x : X.functorOfPoints.obj T) : X.functorOfPoints.obj T :=
  (ρ g).hom.app T x

/-- The pointwise action is evaluation of the automorphism `(ρ g).hom`. -/
theorem smul_def (ρ : G →* Aut X) {T : (Over S)ᵒᵖ} (g : G)
    (x : X.functorOfPoints.obj T) :
    smul ρ g x = (ρ g).hom.app T x := sorry

/-- The identity of `G` acts by the identity transformation of `X`. -/
theorem smul_one (ρ : G →* Aut X) {T : (Over S)ᵒᵖ}
    (x : X.functorOfPoints.obj T) : smul ρ (1 : G) x = x := sorry

/-- The action of a product in `G` is the composite action. -/
theorem smul_mul (ρ : G →* Aut X) {T : (Over S)ᵒᵖ} (g h : G)
    (x : X.functorOfPoints.obj T) :
    smul ρ (g * h) x = smul ρ g (smul ρ h x) := sorry

/-- The orbit relation on `X(T)` generated by the action of `ρ`. -/
def orbitRel (ρ : G →* Aut X) (T : (Over S)ᵒᵖ)
    (x y : X.functorOfPoints.obj T) : Prop :=
  ∃ g : G, smul ρ g x = y

/-- Two `S`-points of `X` are in the same `G`-orbit iff some group element
carries one to the other. -/
theorem orbitRel_iff (ρ : G →* Aut X) {T : (Over S)ᵒᵖ}
    (x y : X.functorOfPoints.obj T) :
    orbitRel ρ T x y ↔ ∃ g : G, smul ρ g x = y := sorry

/-- Restriction of schemes over `S` preserves `G`-orbits. -/
theorem orbitRel_map (ρ : G →* Aut X) {T T' : (Over S)ᵒᵖ} (f : T ⟶ T')
    {x y : X.functorOfPoints.obj T} (h : orbitRel ρ T x y) :
    orbitRel ρ T' (X.functorOfPoints.map f x) (X.functorOfPoints.map f y) := sorry

/-- A homomorphism `ρ : G →* Aut X` is a free action if `G × X(T) → X(T)` is
free for every scheme `T` over `S`. -/
class IsFree (ρ : G →* Aut X) : Prop where
  /-- For each point `x : X(T)`, the map `g ↦ g • x` is injective. -/
  smul_left_injective :
    ∀ (T : Over S) (x : X.functorOfPoints.obj (op T)) {g h : G},
      smul ρ g x = smul ρ h x → g = h

/-- Freeness of `ρ` is injectivity of the shear `G × X(T) → X(T) × X(T)`,
`(g, x) ↦ (g • x, x)`. -/
theorem isFree_iff (ρ : G →* Aut X) :
    IsFree ρ ↔ ∀ (T : (Over S)ᵒᵖ),
      Function.Injective
        (fun p : G × X.functorOfPoints.obj T ↦ (smul ρ p.1 p.2, p.2)) := sorry

/-- Freeness of `ρ` is pointwise cancellativity of the explicit `SMul` package
coming from `smul ρ`. -/
theorem isFree_iff_isCancelSMul (ρ : G →* Aut X) :
    IsFree ρ ↔ ∀ (T : (Over S)ᵒᵖ),
      @IsCancelSMul G (X.functorOfPoints.obj T) ⟨fun g x ↦ smul ρ g x⟩ := sorry

/-- A homomorphism out of a subsingleton group is a free action. -/
instance instIsFree_subsingleton [Subsingleton G] (ρ : G →* Aut X) :
    IsFree ρ := sorry

/-- The presheaf of orbits `T ↦ X(T)/G`. -/
def quotientPresheaf (ρ : G →* Aut X) : (Over S)ᵒᵖ ⥤ Type u where
  obj T := Quot (orbitRel ρ T)
  map f := TypeCat.ofHom <|
    Quot.map (X.functorOfPoints.map f) fun _ _ h ↦ orbitRel_map ρ f h
  map_id := sorry
  map_comp := sorry

/-- The value of the orbit presheaf on `T` is the quotient of `X(T)` by `G`. -/
theorem quotientPresheaf_obj (ρ : G →* Aut X) (T : Over S) :
    (quotientPresheaf ρ).obj (op T) = Quot (orbitRel ρ (op T)) := sorry

/-- Restriction in the orbit presheaf is induced by restriction of representatives. -/
theorem quotientPresheaf_map_mk (ρ : G →* Aut X) {T T' : Over S}
    (f : T' ⟶ T) (x : X.functorOfPoints.obj (op T)) :
    (quotientPresheaf ρ).map f.op (Quot.mk (orbitRel ρ (op T)) x) =
      Quot.mk (orbitRel ρ (op T')) (X.functorOfPoints.map f.op x) := sorry

/-- The objectwise orbit projection `X(T) ⟶ X(T)/G`. -/
def quotientPresheafMk (ρ : G →* Aut X) :
    X.functorOfPoints ⟶ quotientPresheaf ρ where
  app T := TypeCat.ofHom fun x ↦ Quot.mk (orbitRel ρ T) x
  naturality := sorry

/-- The fppf sheaf associated to the presheaf `T ↦ X(T)/G`. Values are raised
one universe before sheafification. -/
noncomputable def quotientSheaf (ρ : G →* Aut X) :
    Sheaf (Scheme.fppfTopology.over S) (Type (u + 1)) :=
  (presheafToSheaf (Scheme.fppfTopology.over S) (Type (u + 1))).obj
    (quotientPresheaf ρ ⋙ uliftFunctor.{u + 1, u})

/-- The underlying presheaf of `quotientSheaf` is the sheafification of the
universe-raised orbit presheaf. -/
theorem quotientSheaf_val (ρ : G →* Aut X) :
    (quotientSheaf ρ).obj =
      sheafify (Scheme.fppfTopology.over S)
        (quotientPresheaf ρ ⋙ uliftFunctor.{u + 1, u}) := sorry

/-- The canonical morphism `X ⟶ X/G` at the sheaf layer, obtained by
sheafifying the orbit projection. -/
noncomputable def quotientMk (ρ : G →* Aut X) :
    X.functorOfPoints ⋙ uliftFunctor.{u + 1, u} ⟶ (quotientSheaf ρ).obj :=
  Functor.whiskerRight (quotientPresheafMk ρ) uliftFunctor.{u + 1, u} ≫
    toSheafify (Scheme.fppfTopology.over S)
      (quotientPresheaf ρ ⋙ uliftFunctor.{u + 1, u})

/-- If `G` acts freely on `X`, the fppf sheaf associated to `T ↦ X(T)/G` is an
algebraic space at the `uliftYoneda` layer: it has representable diagonal, and
there is a representable étale locally-surjective atlas. -/
theorem quotientSheaf_spec (ρ : G →* Aut X) [IsFree ρ] :
    uliftYoneda.{u + 1}.relativelyRepresentable (diag (quotientSheaf ρ).obj) ∧
      ∃ (U : Over S)
        (p : (Scheme.fppfTopology.over S).uliftYoneda.{u + 1}.obj U ⟶
          quotientSheaf ρ),
        (MorphismProperty.over (@Etale)).relative uliftYoneda.{u + 1} p.hom ∧
          Presheaf.IsLocallySurjective (Scheme.etaleTopology.over S) p.hom :=
  sorry

/-- The diagonal of the fppf quotient sheaf `X/G` is representable with respect
to `uliftYoneda`. -/
theorem quotientSheaf_representableDiagonal (ρ : G →* Aut X) [IsFree ρ] :
    uliftYoneda.{u + 1}.relativelyRepresentable
      (diag (quotientSheaf ρ).obj) := sorry

/-- There is a representable étale locally-surjective atlas from a scheme over
`S` to the fppf quotient sheaf `X/G`. -/
theorem exists_etaleAtlas_quotientSheaf (ρ : G →* Aut X) [IsFree ρ] :
    ∃ (U : Over S)
      (p : (Scheme.fppfTopology.over S).uliftYoneda.{u + 1}.obj U ⟶
        quotientSheaf ρ),
      (MorphismProperty.over (@Etale)).relative uliftYoneda.{u + 1} p.hom ∧
        Presheaf.IsLocallySurjective (Scheme.etaleTopology.over S) p.hom :=
  sorry

end AlgebraicGeometry.AlgebraicSpace
