module

public import Mathlib.GroupTheory.QuotientGroup.Defs
public import stacks_project.Chap72.Lemma_72_7_3_Quotient

/-!
# Weil divisor classes of invertible modules

On a locally Noetherian integral algebraic space, the Weil divisor of a
regular meromorphic section of an invertible module is already
`nonzeroMeromorphicSectionWeilDivisor`. This module quotients `Div(X)` by
the subgroup generated by `WeilDivisor.ofRationalUnit`, and records the
resulting class of an invertible module.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.AlgebraicSpace
open CategoryTheory.MonoidalCategory

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

variable {S : Scheme.{u}} (X : AlgebraicSpace S)
variable [IsLocallyNoetherian X] [IsIntegral X]

/-- A Weil divisor is principal when it is the principal divisor of a
rational-function unit. -/
def IsPrincipalWeilDivisor (D : WeilDivisor X) : Prop :=
  ∃ f : (RationalFunction X)ˣ, D = WeilDivisor.ofRationalUnit f

/-- Principality is equivalent to matching the order-of-vanishing coefficients
of some rational unit. -/
theorem IsPrincipalWeilDivisor_iff_coeff (D : WeilDivisor X) :
    IsPrincipalWeilDivisor X D ↔
      ∃ f : (RationalFunction X)ˣ,
        ∀ Z : PrimeDivisor X, D.coeff Z = Z.ord f :=
  sorry

/-- The principal Weil divisor of a rational unit is principal. -/
theorem ofRationalUnit_isPrincipal (f : (RationalFunction X)ˣ) :
    IsPrincipalWeilDivisor X (WeilDivisor.ofRationalUnit f) :=
  sorry

/-- The subgroup of principal Weil divisors. -/
def principalWeilDivisors : AddSubgroup (WeilDivisor X) where
  carrier := IsPrincipalWeilDivisor X
  zero_mem' := sorry
  add_mem' := sorry
  neg_mem' := sorry

/-- The subgroup of principal Weil divisors on an algebraic space. -/
scoped notation "Prin(" X ")" => principalWeilDivisors X

/-- Membership in the principal-divisor subgroup is the principal-divisor
predicate. -/
theorem mem_principalWeilDivisors_iff (D : WeilDivisor X) :
    D ∈ principalWeilDivisors X ↔ IsPrincipalWeilDivisor X D :=
  sorry

/-- The principal Weil divisor of a rational unit belongs to the principal
divisor subgroup. -/
theorem ofRationalUnit_mem_principalWeilDivisors (f : (RationalFunction X)ˣ) :
    WeilDivisor.ofRationalUnit f ∈ principalWeilDivisors X :=
  sorry

/-- The Weil divisor class group is the quotient of Weil divisors by principal
Weil divisors. -/
abbrev WeilDivisorClassGroup : Type (u + 1) :=
  WeilDivisor X ⧸ principalWeilDivisors X

/-- The Weil divisor class group of an algebraic space. -/
scoped notation "Cl(" X ")" => WeilDivisorClassGroup X

/-- The canonical quotient homomorphism from Weil divisors to the divisor class
group. -/
abbrev weilDivisorClassGroupMk : WeilDivisor X →+ WeilDivisorClassGroup X :=
  QuotientAddGroup.mk' (principalWeilDivisors X)

/-- The quotient map from Weil divisors to the class group is surjective. -/
theorem weilDivisorClassGroupMk_surjective :
    Function.Surjective (weilDivisorClassGroupMk X) :=
  sorry

/-- Two Weil divisors determine the same class if and only if their difference
is principal. -/
theorem weilDivisorClassGroupMk_eq_iff (D E : WeilDivisor X) :
    weilDivisorClassGroupMk X D = weilDivisorClassGroupMk X E ↔
      D - E ∈ principalWeilDivisors X :=
  sorry

variable {X}

/-- The Weil divisor class associated to a nonzero meromorphic section of an
invertible module. -/
def nonzeroMeromorphicSectionWeilDivisorClass {L : X.Modules}
    [isInvertibleObject L] (s : meromorphicSections X L)
    (hs : IsRegularMeromorphicSection X L s) : WeilDivisorClassGroup X :=
  weilDivisorClassGroupMk X (nonzeroMeromorphicSectionWeilDivisor s hs)

/-- The class of a nonzero meromorphic section is the image of its Weil divisor
under the canonical quotient homomorphism. -/
theorem nonzeroMeromorphicSectionWeilDivisorClass_def {L : X.Modules}
    [isInvertibleObject L] (s : meromorphicSections X L)
    (hs : IsRegularMeromorphicSection X L s) :
    nonzeroMeromorphicSectionWeilDivisorClass s hs =
      weilDivisorClassGroupMk X (nonzeroMeromorphicSectionWeilDivisor s hs) :=
  sorry

/-- The Weil divisor class of a nonzero meromorphic section of an invertible
module is independent of the chosen regular meromorphic section. -/
theorem nonzeroMeromorphicSectionWeilDivisorClass_eq {L : X.Modules}
    [isInvertibleObject L] (s t : meromorphicSections X L)
    (hs : IsRegularMeromorphicSection X L s)
    (ht : IsRegularMeromorphicSection X L t) :
    nonzeroMeromorphicSectionWeilDivisorClass s hs =
      nonzeroMeromorphicSectionWeilDivisorClass t ht :=
  sorry

/-- The Weil divisor class associated to an invertible module, selected as the
common class of the Weil divisors of its regular meromorphic sections. -/
def invertibleModuleWeilDivisorClass (L : X.Modules) [isInvertibleObject L] :
    WeilDivisorClassGroup X :=
  @Classical.epsilon (WeilDivisorClassGroup X) ⟨(0 : WeilDivisorClassGroup X)⟩
    fun c ↦
      ∀ (s : meromorphicSections X L) (hs : IsRegularMeromorphicSection X L s),
        c = nonzeroMeromorphicSectionWeilDivisorClass s hs

/-- The Weil divisor class of an invertible module equals the class of the Weil
divisor of any nonzero meromorphic section. -/
theorem invertibleModuleWeilDivisorClass_eq (L : X.Modules)
    [isInvertibleObject L] (s : meromorphicSections X L)
    (hs : IsRegularMeromorphicSection X L s) :
    invertibleModuleWeilDivisorClass L =
      nonzeroMeromorphicSectionWeilDivisorClass s hs :=
  sorry

end AlgebraicGeometry.AlgebraicSpace
