module

public import Mathlib.Algebra.MvPolynomial.CommRing
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.Algebra.Ring.NonZeroDivisors

@[expose] public section

open MvPolynomial

universe u

noncomputable section

namespace NodeCoordinateRing

variable (k : Type u) [CommRing k]

/-- The ideal generated by the product of the two coordinate variables. -/
def ideal : Ideal (MvPolynomial (Fin 2) k) :=
  Ideal.span {X 0 * X 1}

/-- The quotient ring `k[X 0, X 1] / (X 0 * X 1)` of the nodal coordinate equation. -/
abbrev Ring := MvPolynomial (Fin 2) k ⧸ ideal k

/-- The image in `Ring k` of the `i`-th polynomial coordinate. -/
def coordinate (i : Fin 2) : Ring k :=
  Ideal.Quotient.mk (ideal k) (X i)

/-- The principal coordinate ideal cutting out an axis of the node: index `0` gives
`(x)` and index `1` gives `(y)`. -/
def axisIdeal (i : Fin 2) : Ideal (Ring k) :=
  Ideal.span {coordinate k i}

/-- The sum of the two coordinates is a non-zero-divisor in the nodal quotient over a
nontrivial coefficient ring. -/
theorem branchSum_mem_nonZeroDivisors [Nontrivial k] :
    coordinate k 0 + coordinate k 1 ∈ nonZeroDivisors (Ring k) := sorry

end NodeCoordinateRing
