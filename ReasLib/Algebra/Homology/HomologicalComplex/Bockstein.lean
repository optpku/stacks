module

public import Mathlib.Algebra.Homology.HomologySequenceLemmas
public import Mathlib.Algebra.Module.Torsion.Basic
public import Mathlib.CategoryTheory.ObjectProperty.FullSubcategory
public import ReasLib.Algebra.Homology.HomologicalComplex.Termwise.Regular
public import ReasLib.Algebra.Homology.HomologicalComplex.HomologyMaps
public import ReasLib.Algebra.Homology.HomologicalComplex.ModIdeal.Change
public import ReasLib.Algebra.Homology.HomologicalComplex.ModIdeal.Homology
public import ReasLib.CategoryTheory.Homology.ShortComplex.Cycles
public import ReasLib.RingTheory.Ideal.Principal

/-!
# Bockstein operators from scalar quotient rows

For a scalar `f` acting regularly in every degree, the quotient row

`K / fK ⟶ K / (f)^2 K ⟶ K / fK`

is short exact.  This file owns the row, its connecting operator, and the resulting Bockstein
complex.  Low-level operator constructors accept a short-exactness proof explicitly.  The
Bockstein complex itself additionally uses termwise regularity: its square-zero law comes from the
factorization through the integral scalar row, not from short exactness of the quotient row alone.
The operators are transported back to the canonical `A ⧸ (f)`-linear homology objects.

@stack 0GSQ
@stack 0GSP
@stack 0F7Y
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open HomologicalComplex.HomologySequence
open scoped nonZeroDivisors

noncomputable section

universe u v w

namespace HomologicalComplex

variable {A : Type u} [CommRing A]
variable {ι : Type w} {c : ComplexShape ι}

namespace Bockstein

/-- The canonical category of complexes on which multiplication by `f` is regular in every
degree. -/
@[stacks 0GSQ "Bockstein regular complex domain"]
abbrev Domain (f : A) :=
  HomologicalComplex.RegularDomain (c := c) f

/-- The square of the principal ideal generated by the Bockstein scalar. -/
@[stacks 0GSQ "square ideal in the Bockstein row"]
abbrev squareIdeal (f : A) : Ideal A := principalPowerIdeal f 2

/-- The square of a principal ideal is contained in that principal ideal. -/
theorem squareIdeal_le (f : A) : squareIdeal f ≤ principalIdeal f := sorry

/-- The scalar-restricted quotient complex `K / fK`. -/
@[stacks 0GSQ "first scalar quotient complex"]
abbrev modF (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c) :
    HomologicalComplex (ModuleCat.{v} A) c :=
  ModIdeal.restrictedComplex (principalIdeal f) K

/-- The scalar-restricted quotient complex `K / (f)^2 K`. -/
@[stacks 0GSQ "square scalar quotient complex"]
abbrev modFSq (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c) :
    HomologicalComplex (ModuleCat.{v} A) c :=
  ModIdeal.restrictedComplex (squareIdeal f) K

/-- The canonical reduction map `K / (f)^2 K ⟶ K / fK`. -/
@[stacks 0F7Y "reduction modulo a scalar from square to first power"]
def reduction (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c) :
    modFSq f K ⟶ modF f K :=
  ModIdeal.restrictedOfLE (squareIdeal_le f) K

/-- Multiplication by `f` sends `fK` into `(f)^2 K`. -/
theorem smul_top_le_square_comap (f : A) (M : ModuleCat.{v} A) :
    principalIdeal f • (⊤ : Submodule A M) ≤
      (squareIdeal f • (⊤ : Submodule A M)).comap (LinearMap.lsmul A M f) := sorry

/-- Multiplication by `f` from `K / fK` to `K / (f)^2 K` in one degree. -/
@[stacks 0GSQ "degreewise multiplication between scalar quotients"]
def multiplicationLinear (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c) (i : ι) :
    (modF f K).X i →ₗ[A] (modFSq f K).X i :=
  Submodule.mapQ
    (principalIdeal f • (⊤ : Submodule A (K.X i)))
    (squareIdeal f • (⊤ : Submodule A (K.X i)))
    (LinearMap.lsmul A (K.X i) f)
    (smul_top_le_square_comap f (K.X i))

/-- Multiplication sends the class of `x` modulo `f` to the class of `f • x` modulo `(f)^2`. -/
theorem multiplicationLinear_mk (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (i : ι) (x : K.X i) :
    multiplicationLinear f K i (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (f • x) := sorry

/-- The multiplication maps commute with the quotient differentials. -/
theorem multiplication_comm (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (i j : ι) (hij : c.Rel i j) :
    ModuleCat.ofHom
        (X := (modF f K).X i) (Y := (modFSq f K).X i)
        (multiplicationLinear f K i) ≫ (modFSq f K).d i j =
      (modF f K).d i j ≫ ModuleCat.ofHom
        (X := (modF f K).X j) (Y := (modFSq f K).X j)
        (multiplicationLinear f K j) := sorry

/-- The cochain map `K / fK ⟶ K / (f)^2 K` induced by multiplication by `f`. -/
@[stacks 0GSQ "multiplication between the first and square scalar quotients"]
def multiplication (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c) :
    modF f K ⟶ modFSq f K where
  f i := ModuleCat.ofHom
    (X := (modF f K).X i) (Y := (modFSq f K).X i)
    (multiplicationLinear f K i)
  comm' i j hij := multiplication_comm f K i j hij

/-- Multiplication between the first and square scalar quotients is natural in the complex. -/
theorem multiplication_naturality (f : A)
    {K L : HomologicalComplex (ModuleCat.{v} A) c} (φ : K ⟶ L) :
    ModIdeal.restrictedMap (principalIdeal f) φ ≫ multiplication f L =
      multiplication f K ≫ ModIdeal.restrictedMap (squareIdeal f) φ := sorry

/-- Multiplication by `f`, followed by reduction modulo `f`, is zero. -/
theorem multiplication_comp_reduction (f : A)
    (K : HomologicalComplex (ModuleCat.{v} A) c) :
    multiplication f K ≫ reduction f K = 0 := sorry

/-- The scalar quotient row `K / fK ⟶ K / (f)^2 K ⟶ K / fK`. -/
@[stacks 0GSQ "Bockstein scalar quotient row"]
def row (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c) :
    ShortComplex (HomologicalComplex (ModuleCat.{v} A) c) :=
  ShortComplex.mk (multiplication f K) (reduction f K)
    (multiplication_comp_reduction f K)

/-- Reduction from the square scalar quotient to the first scalar quotient is natural in the
complex. -/
theorem reduction_naturality (f : A)
    {K L : HomologicalComplex (ModuleCat.{v} A) c} (φ : K ⟶ L) :
    ModIdeal.restrictedMap (squareIdeal f) φ ≫ reduction f L =
      reduction f K ≫ ModIdeal.restrictedMap (principalIdeal f) φ := sorry

/-- A morphism of complexes induces a morphism between their scalar quotient rows. -/
@[stacks 0GSQ "map of Bockstein scalar quotient rows"]
def rowMap (f : A) {K L : HomologicalComplex (ModuleCat.{v} A) c} (φ : K ⟶ L) :
    row f K ⟶ row f L where
  τ₁ := ModIdeal.restrictedMap (principalIdeal f) φ
  τ₂ := ModIdeal.restrictedMap (squareIdeal f) φ
  τ₃ := ModIdeal.restrictedMap (principalIdeal f) φ
  comm₁₂ := multiplication_naturality f φ
  comm₂₃ := reduction_naturality f φ

/-- Scalar quotient rows preserve identity morphisms. -/
@[simp]
theorem rowMap_id (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c) :
    rowMap f (𝟙 K) = 𝟙 (row f K) := sorry

/-- Scalar quotient rows preserve composition. -/
@[simp]
theorem rowMap_comp (f : A) {K L M : HomologicalComplex (ModuleCat.{v} A) c}
    (φ : K ⟶ L) (ψ : L ⟶ M) :
    rowMap f (φ ≫ ψ) = rowMap f φ ≫ rowMap f ψ := sorry

/-- The scalar quotient row as a functor of the homological complex. -/
@[stacks 0GSQ "functorial Bockstein scalar quotient row"]
def rowFunctor (f : A) :
    HomologicalComplex (ModuleCat.{v} A) c ⥤
      ShortComplex (HomologicalComplex (ModuleCat.{v} A) c) where
  obj K := row f K
  map φ := rowMap f φ
  map_id K := rowMap_id f K
  map_comp φ ψ := rowMap_comp f φ ψ

/-- The scalar quotient row is short exact for a termwise `f`-torsion-free complex. -/
@[stacks 0GSQ "short exact scalar quotient row"]
theorem shortExact (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hK : K.IsTermwiseSMulRegular f) : (row f K).ShortExact := sorry

/-- Multiplication by `f` followed by projection modulo `(f)` is zero. -/
theorem smul_comp_projection (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c) :
    f • 𝟙 K ≫ ModIdeal.projection (principalIdeal f) K = 0 := sorry

/-- The integral scalar row `K --f→ K ⟶ K / fK`. -/
@[stacks 0GSP "integral scalar quotient row"]
def integralRow (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c) :
    ShortComplex (HomologicalComplex (ModuleCat.{v} A) c) :=
  ShortComplex.mk (f • 𝟙 K) (ModIdeal.projection (principalIdeal f) K)
    (smul_comp_projection f K)

/-- Scalar multiplication in the integral row is natural in the complex. -/
theorem integralRowMap_comm₁₂ (f : A)
    {K L : HomologicalComplex (ModuleCat.{v} A) c} (φ : K ⟶ L) :
    φ ≫ (f • 𝟙 L) = (f • 𝟙 K) ≫ φ := sorry

/-- Projection to the first scalar quotient is natural in the complex. -/
theorem integralRowMap_comm₂₃ (f : A)
    {K L : HomologicalComplex (ModuleCat.{v} A) c} (φ : K ⟶ L) :
    φ ≫ ModIdeal.projection (principalIdeal f) L =
      ModIdeal.projection (principalIdeal f) K ≫
        ModIdeal.restrictedMap (principalIdeal f) φ := sorry

/-- A morphism of complexes induces a morphism between their integral scalar rows. -/
@[stacks 0GSP "map of integral scalar quotient rows"]
def integralRowMap (f : A)
    {K L : HomologicalComplex (ModuleCat.{v} A) c} (φ : K ⟶ L) :
    integralRow f K ⟶ integralRow f L where
  τ₁ := φ
  τ₂ := φ
  τ₃ := ModIdeal.restrictedMap (principalIdeal f) φ
  comm₁₂ := integralRowMap_comm₁₂ f φ
  comm₂₃ := integralRowMap_comm₂₃ f φ

/-- Integral scalar rows preserve identity morphisms. -/
@[simp]
theorem integralRowMap_id (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c) :
    integralRowMap f (𝟙 K) = 𝟙 (integralRow f K) := sorry

/-- Integral scalar rows preserve composition. -/
@[simp]
theorem integralRowMap_comp (f : A)
    {K L M : HomologicalComplex (ModuleCat.{v} A) c} (φ : K ⟶ L) (ψ : L ⟶ M) :
    integralRowMap f (φ ≫ ψ) = integralRowMap f φ ≫ integralRowMap f ψ := sorry

/-- The integral scalar row as a functor of the homological complex. -/
@[stacks 0GSP "functorial integral scalar quotient row"]
def integralRowFunctor (f : A) :
    HomologicalComplex (ModuleCat.{v} A) c ⥤
      ShortComplex (HomologicalComplex (ModuleCat.{v} A) c) where
  obj K := integralRow f K
  map φ := integralRowMap f φ
  map_id K := integralRowMap_id f K
  map_comp φ ψ := integralRowMap_comp f φ ψ

/-- The integral scalar row is short exact when multiplication by `f` is injective termwise. -/
theorem integralShortExact (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hK : K.IsTermwiseSMulRegular f) : (integralRow f K).ShortExact := sorry

/-- The left square from the integral scalar row to the square-quotient row commutes. -/
theorem factorizationHom_comm₁₂ (f : A)
    (K : HomologicalComplex (ModuleCat.{v} A) c) :
    ModIdeal.projection (principalIdeal f) K ≫ multiplication f K =
      (f • 𝟙 K) ≫ ModIdeal.projection (squareIdeal f) K := sorry

/-- The right square from the integral scalar row to the square-quotient row commutes. -/
theorem factorizationHom_comm₂₃ (f : A)
    (K : HomologicalComplex (ModuleCat.{v} A) c) :
    ModIdeal.projection (squareIdeal f) K ≫ reduction f K =
      ModIdeal.projection (principalIdeal f) K ≫ 𝟙 (modF f K) := sorry

/-- The canonical morphism from `K --f→ K ⟶ K/fK` to
`K/fK ⟶ K/(f)^2K ⟶ K/fK`. -/
@[stacks 0GSP "morphism of scalar quotient rows"]
def factorizationHom (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c) :
    integralRow f K ⟶ row f K where
  τ₁ := ModIdeal.projection (principalIdeal f) K
  τ₂ := ModIdeal.projection (squareIdeal f) K
  τ₃ := 𝟙 (modF f K)
  comm₁₂ := factorizationHom_comm₁₂ f K
  comm₂₃ := factorizationHom_comm₂₃ f K

/-- The morphism from the integral scalar row to the quotient row is natural in the complex. -/
theorem factorizationHom_naturality (f : A)
    {K L : HomologicalComplex (ModuleCat.{v} A) c} (φ : K ⟶ L) :
    integralRowMap f φ ≫ factorizationHom f L =
      factorizationHom f K ≫ rowMap f φ := sorry

/-- The integral-to-quotient row factorization as a natural transformation. -/
@[stacks 0GSP "natural factorization of Bockstein scalar rows"]
def factorizationNatTrans (f : A) :
    integralRowFunctor.{u, v, w} (c := c) f ⟶ rowFunctor f where
  app K := factorizationHom f K
  naturality _ _ φ := factorizationHom_naturality f φ

/-- The connecting morphism of an explicitly supplied short-exact integral scalar row. -/
@[stacks 0GSP "integral connecting operator with an explicit exactness proof"]
noncomputable def integralOperatorOfShortExact (f : A)
    (K : HomologicalComplex (ModuleCat.{v} A) c) (h : (integralRow f K).ShortExact)
    (i j : ι) (hij : c.Rel i j) :
    (modF f K).homology i ⟶ K.homology j :=
  h.δ i j hij

/-- The canonical connecting morphism from homology modulo `f` to integral homology. -/
@[stacks 0GSP "canonical integral connecting operator"]
noncomputable def integralOperator (f : A)
    (K : HomologicalComplex (ModuleCat.{v} A) c) (hK : K.IsTermwiseSMulRegular f)
    (i j : ι) (hij : c.Rel i j) :
    (modF f K).homology i ⟶ K.homology j :=
  integralOperatorOfShortExact f K (integralShortExact f K hK) i j hij

/-- The connecting morphism of an explicitly supplied short-exact scalar quotient row, at the
scalar-restricted `A`-linear level. -/
@[stacks 0GSQ "restricted Bockstein operator with explicit exactness"]
noncomputable def restrictedOperatorOfShortExact (f : A)
    (K : HomologicalComplex (ModuleCat.{v} A) c) (h : (row f K).ShortExact)
    (i j : ι) (hij : c.Rel i j) :
    (modF f K).homology i ⟶ (modF f K).homology j :=
  h.δ i j hij

/-- The `A ⧸ (f)`-linear Bockstein operator attached to an explicitly supplied short-exact
scalar quotient row. -/
@[stacks 0GSQ "Bockstein operator with explicit exactness"]
noncomputable def operatorOfShortExact (f : A)
    (K : HomologicalComplex (ModuleCat.{v} A) c) (h : (row f K).ShortExact)
    (i j : ι) (hij : c.Rel i j) :
    (ModIdeal.complex (principalIdeal f) K).homology i ⟶
      (ModIdeal.complex (principalIdeal f) K).homology j :=
  ModIdeal.Homology.descend (principalIdeal f) i j
    (restrictedOperatorOfShortExact f K h i j hij)

/-- The explicitly short-exact Bockstein operator is independent of the supplied proof. -/
theorem operatorOfShortExact_proof_irrel (f : A)
    (K : HomologicalComplex (ModuleCat.{v} A) c) (h h' : (row f K).ShortExact)
    (i j : ι) (hij : c.Rel i j) :
    operatorOfShortExact f K h i j hij =
      operatorOfShortExact f K h' i j hij := sorry

/-- The scalar-restricted view of the canonical Bockstein operator. -/
@[stacks 0GSQ "scalar-restricted canonical Bockstein operator"]
noncomputable def restrictedOperator (f : A)
    (K : HomologicalComplex (ModuleCat.{v} A) c) (hK : K.IsTermwiseSMulRegular f)
    (i j : ι) (hij : c.Rel i j) :
    (modF f K).homology i ⟶ (modF f K).homology j :=
  restrictedOperatorOfShortExact f K (shortExact f K hK) i j hij

/-- Equation 15.96.5.1, tag `0GSP`: the Bockstein operator factors through integral homology as
the connecting morphism for `K --f→ K ⟶ K/fK`, followed by reduction modulo `f`. -/
theorem integralOperatorOfShortExact_comp_reduction (f : A)
    (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hInt : (integralRow f K).ShortExact) (hRow : (row f K).ShortExact)
    (i j : ι) (hij : c.Rel i j) :
    integralOperatorOfShortExact f K hInt i j hij ≫
        HomologicalComplex.homologyMap (ModIdeal.projection (principalIdeal f) K) j =
      restrictedOperatorOfShortExact f K hRow i j hij := sorry

/-- Equation 15.96.5.1, tag `0GSP`: for the canonical regular scalar rows, the Bockstein
operator factors through integral homology. -/
@[stacks 0GSP "factorization of the Bockstein operator"]
theorem integralOperator_comp_reduction (f : A)
    (K : HomologicalComplex (ModuleCat.{v} A) c) (hK : K.IsTermwiseSMulRegular f)
    (i j : ι) (hij : c.Rel i j) :
    integralOperator f K hK i j hij ≫
        HomologicalComplex.homologyMap (ModIdeal.projection (principalIdeal f) K) j =
      restrictedOperator f K hK i j hij := sorry

/-- The canonical `A ⧸ (f)`-linear Bockstein operator, defined from the integral connecting
morphism followed by reduction modulo `f`. -/
@[stacks 0GSQ "Bockstein operator"]
noncomputable def operator (f : A)
    (K : HomologicalComplex (ModuleCat.{v} A) c) (hK : K.IsTermwiseSMulRegular f)
    (i j : ι) (hij : c.Rel i j) :
    (ModIdeal.complex (principalIdeal f) K).homology i ⟶
      (ModIdeal.complex (principalIdeal f) K).homology j :=
  ModIdeal.Homology.descend (principalIdeal f) i j
    (integralOperator f K hK i j hij ≫
      HomologicalComplex.homologyMap (ModIdeal.projection (principalIdeal f) K) j)

/-- Restricting scalars on the canonical Bockstein operator recovers its connecting morphism at
the `A`-linear level. -/
@[simp, stacks 0GSQ "scalar restriction of the Bockstein operator"]
theorem restrict_operator (f : A)
    (K : HomologicalComplex (ModuleCat.{v} A) c) (hK : K.IsTermwiseSMulRegular f)
    (i j : ι) (hij : c.Rel i j) :
    ModIdeal.Homology.restrict (principalIdeal f) i j (operator f K hK i j hij) =
      restrictedOperator f K hK i j hij := sorry

/-- The canonical Bockstein operator is independent of the proof of termwise regularity. -/
theorem operator_proof_irrel (f : A)
    (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hK hK' : K.IsTermwiseSMulRegular f) (i j : ι) (hij : c.Rel i j) :
    operator f K hK i j hij = operator f K hK' i j hij := sorry

/-- The canonical Bockstein operator is natural in morphisms of termwise regular complexes. -/
theorem operator_naturality (f : A)
    {K L : HomologicalComplex (ModuleCat.{v} A) c} (φ : K ⟶ L)
    (hK : K.IsTermwiseSMulRegular f) (hL : L.IsTermwiseSMulRegular f)
    (i j : ι) (hij : c.Rel i j) :
    HomologicalComplex.homologyMap (ModIdeal.map (principalIdeal f) φ) i ≫
        operator f L hL i j hij =
      operator f K hK i j hij ≫
        HomologicalComplex.homologyMap (ModIdeal.map (principalIdeal f) φ) j := sorry

/-- Every cycle modulo `f` in a specified degree lifts to a cycle modulo `(f)^2`. -/
@[stacks 0F7Y "cycle-lifting condition for the scalar quotient row"]
def CyclesLift (f : A)
    (K : HomologicalComplex (ModuleCat.{v} A) c) (i : ι) : Prop :=
  Epi (HomologicalComplex.cyclesMap (reduction f K) i)

/-- For an explicitly short-exact quotient row, cycles lift exactly when its Bockstein operator
vanishes along the specified relation. -/
theorem cyclesLift_iff_operatorOfShortExact_eq_zero
    (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hRow : (row f K).ShortExact) (i j : ι) (hij : c.Rel i j) :
    CyclesLift f K i ↔ operatorOfShortExact f K hRow i j hij = 0 := sorry

/-- For a termwise regular scalar, cycles lift exactly when the canonical Bockstein operator
vanishes along the specified relation. -/
@[stacks 0F7Y "surjectivity on reduced cycles versus the Bockstein operator"]
theorem cyclesLift_iff_operator_eq_zero
    (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hK : K.IsTermwiseSMulRegular f) (i j : ι) (hij : c.Rel i j) :
    CyclesLift f K i ↔ operator f K hK i j hij = 0 := sorry

/-- Bockstein operators from explicitly short-exact integral and quotient rows have zero
composite along any two composable relations of the complex shape. -/
theorem operatorOfShortExact_comp (f : A)
    (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hInt : (integralRow f K).ShortExact) (hRow : (row f K).ShortExact)
    {i j k : ι} (hij : c.Rel i j) (hjk : c.Rel j k) :
    operatorOfShortExact f K hRow i j hij ≫
      operatorOfShortExact f K hRow j k hjk = 0 := sorry

/-- Canonical Bockstein operators have zero composite along any two composable relations of the
complex shape. -/
@[stacks 0GSQ "the Bockstein differential squares to zero"]
theorem operator_comp (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hK : K.IsTermwiseSMulRegular f) {i j k : ι}
    (hij : c.Rel i j) (hjk : c.Rel j k) :
    operator f K hK i j hij ≫ operator f K hK j k hjk = 0 := sorry

/-- The shape-aware Bockstein differential on the homology of `K / fK`. -/
@[stacks 0GSQ "shape-aware Bockstein differential"]
noncomputable def differential (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hK : K.IsTermwiseSMulRegular f) (i j : ι) :
    (ModIdeal.complex (principalIdeal f) K).homology i ⟶
      (ModIdeal.complex (principalIdeal f) K).homology j :=
  @dite _ (c.Rel i j) (Classical.propDecidable _)
    (fun hij ↦ operator f K hK i j hij) (fun _ ↦ 0)

/-- Along a relation of the complex shape, the Bockstein differential is the connecting
operator. -/
theorem differential_eq (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hK : K.IsTermwiseSMulRegular f) {i j : ι} (hij : c.Rel i j) :
    differential f K hK i j = operator f K hK i j hij := sorry

/-- The Bockstein differential vanishes outside the relation of the complex shape. -/
theorem differential_shape (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hK : K.IsTermwiseSMulRegular f) (i j : ι) (hij : ¬c.Rel i j) :
    differential f K hK i j = 0 := sorry

/-- Two successive shape-aware Bockstein differentials compose to zero. -/
theorem differential_comp (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hK : K.IsTermwiseSMulRegular f) (i j k : ι) :
    differential f K hK i j ≫ differential f K hK j k = 0 := sorry

/-- The homology of `K / fK`, equipped with its Bockstein differential and the same shape as
`K`. -/
@[stacks 0GSQ "Bockstein homological complex"]
noncomputable def complex (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hK : K.IsTermwiseSMulRegular f) :
    HomologicalComplex (ModuleCat.{v} (A ⧸ principalIdeal f)) c where
  X i := (ModIdeal.complex (principalIdeal f) K).homology i
  d i j := differential f K hK i j
  shape i j hij := differential_shape f K hK i j hij
  d_comp_d' i j k _ _ := differential_comp f K hK i j k

/-- The degree-`i` object of the Bockstein complex is the `i`th homology of `K / fK`. -/
@[simp, stacks 0GSQ "terms of the Bockstein complex"]
theorem complex_X (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hK : K.IsTermwiseSMulRegular f) (i : ι) :
    (complex f K hK).X i = (ModIdeal.complex (principalIdeal f) K).homology i := sorry

/-- Along a relation, the differential of the Bockstein complex is its Bockstein operator. -/
@[simp, stacks 0GSQ "differential of the Bockstein complex"]
theorem complex_d (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hK : K.IsTermwiseSMulRegular f) {i j : ι} (hij : c.Rel i j) :
    (complex f K hK).d i j = operator f K hK i j hij := sorry

/-- The homology maps modulo `f` commute with the Bockstein differentials. -/
theorem complexMap_comm (f : A)
    {K L : HomologicalComplex (ModuleCat.{v} A) c} (φ : K ⟶ L)
    (hK : K.IsTermwiseSMulRegular f) (hL : L.IsTermwiseSMulRegular f)
    (i j : ι) (hij : c.Rel i j) :
    HomologicalComplex.homologyMap (ModIdeal.map (principalIdeal f) φ) i ≫
        (complex f L hL).d i j =
      (complex f K hK).d i j ≫
        HomologicalComplex.homologyMap (ModIdeal.map (principalIdeal f) φ) j := sorry

/-- A morphism of termwise regular complexes induces a morphism of Bockstein complexes. -/
@[stacks 0GSQ "map of Bockstein homological complexes"]
noncomputable def complexMap (f : A)
    {K L : HomologicalComplex (ModuleCat.{v} A) c} (φ : K ⟶ L)
    (hK : K.IsTermwiseSMulRegular f) (hL : L.IsTermwiseSMulRegular f) :
    complex f K hK ⟶ complex f L hL where
  f i := HomologicalComplex.homologyMap (ModIdeal.map (principalIdeal f) φ) i
  comm' i j hij := complexMap_comm f φ hK hL i j hij

/-- The Bockstein construction sends identity maps to identity maps. -/
@[simp]
theorem complexMap_id (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hK : K.IsTermwiseSMulRegular f) :
    complexMap f (𝟙 K) hK hK = 𝟙 (complex f K hK) := sorry

/-- The Bockstein construction preserves composition. -/
@[simp]
theorem complexMap_comp (f : A)
    {K L M : HomologicalComplex (ModuleCat.{v} A) c} (φ : K ⟶ L) (ψ : L ⟶ M)
    (hK : K.IsTermwiseSMulRegular f) (hL : L.IsTermwiseSMulRegular f)
    (hM : M.IsTermwiseSMulRegular f) :
    complexMap f (φ ≫ ψ) hK hM = complexMap f φ hK hL ≫ complexMap f ψ hL hM := sorry

/-- The Bockstein complex as a functor on the canonical termwise regular domain. -/
@[stacks 0GSQ "functorial Bockstein homological complex"]
noncomputable def complexFunctor (f : A) :
    Domain (c := c) f ⥤
      HomologicalComplex (ModuleCat.{v} (A ⧸ principalIdeal f)) c where
  obj K := complex f K.obj K.property
  map {K L} φ := complexMap f φ.hom K.property L.property
  map_id K := complexMap_id f K.obj K.property
  map_comp {K L M} φ ψ :=
    complexMap_comp f φ.hom ψ.hom K.property L.property M.property

section Integer

variable (f : A) (K : CochainComplex (ModuleCat.{v} A) ℤ)

/-- For an integer-indexed complex, two consecutive canonical Bockstein operators compose to
zero. -/
theorem operator_sq (hK : K.IsTermwiseSMulRegular f) (i : ℤ) :
    operator f K hK i (i + 1) (ComplexShape.up_mk i (i + 1) rfl) ≫
      operator f K hK (i + 1) ((i + 1) + 1)
        (ComplexShape.up_mk (i + 1) ((i + 1) + 1) rfl) = 0 := sorry

end Integer

/-- If `f` acts regularly on the target homology object, the integral connecting operator
vanishes along the specified relation. -/
theorem integralOperator_eq_zero_of_isSMulRegular_homology
    (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hK : K.IsTermwiseSMulRegular f) (i j : ι) (hij : c.Rel i j)
    (hH : IsSMulRegular (K.homology j) f) :
    integralOperator f K hK i j hij = 0 := sorry

/-- If `f` acts regularly on the target homology object, the Bockstein operator vanishes along
the specified relation. -/
theorem operator_eq_zero_of_isSMulRegular_homology
    (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hK : K.IsTermwiseSMulRegular f) (i j : ι) (hij : c.Rel i j)
    (hH : IsSMulRegular (K.homology j) f) :
    operator f K hK i j hij = 0 := sorry

/-- Regularity of `f` on the next homology object makes cycles lift along any relation of the
complex shape. -/
theorem cyclesLift_of_isSMulRegular_homology
    (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hK : K.IsTermwiseSMulRegular f) (i j : ι) (hij : c.Rel i j)
    (hH : IsSMulRegular (K.homology j) f) : CyclesLift f K i := sorry

/-- Lemma 15.96.7, tag `0F7Y` (2): absence of `f`-torsion in the next homology object implies that
cycles lift from reduction modulo `(f)^2` to reduction modulo `f`. -/
@[stacks 0F7Y "torsion-free homology implies lifting of reduced cycles"]
theorem cyclesLift_of_torsionBy_eq_bot
    (f : A) (K : HomologicalComplex (ModuleCat.{v} A) c)
    (hK : K.IsTermwiseSMulRegular f) (i j : ι) (hij : c.Rel i j)
    (hH : Submodule.torsionBy A (K.homology j) f = ⊥) : CyclesLift f K i := sorry

end Bockstein

end HomologicalComplex
