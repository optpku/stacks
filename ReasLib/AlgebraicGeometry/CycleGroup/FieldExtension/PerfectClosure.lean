module

public import ReasLib.AlgebraicGeometry.CycleGroup.FieldExtension
public import ReasLib.Algebra.Module.IdealPower.Predicate
public import ReasLib.FieldTheory.PerfectClosure.Algebra

/-!
# Perfect-closure torsion of cycle-group cokernels

This file records the torsion properties of cycle-group pullback to a perfect
closure.
-/

@[expose] public section

open AlgebraicGeometry
open AlgebraicGeometry.FieldExtension
open AlgebraicGeometry.SchemeOverField

noncomputable section

universe u

namespace AlgebraicGeometry.CycleGroup.FieldExtension

/-- The cokernel of perfect-closure pullback on cycles is power torsion for the
principal ideal generated by the characteristic. -/
theorem perfectClosure_coker_isIdealPowerTorsion
    {k : Type u} [Field k] (p : ℕ) [Fact p.Prime] [CharP k p]
    (X : SchemeOverField k) [Algebraic X] (r : ℕ) :
    Module.IsIdealPowerTorsion (principalIdeal (p : ℤ))
      (cycleGroup (Over.baseChange k (PerfectClosure k p) X) r ⧸
        (algebraicExtensionPullback k (PerfectClosure k p) X r).range) :=
  sorry

/-- The cokernel of perfect-closure pullback on cycles is torsion with respect
to the powers of the characteristic. -/
theorem perfectClosure_coker_isTorsion'
    {k : Type u} [Field k] (p : ℕ) [Fact p.Prime] [CharP k p]
    (X : SchemeOverField k) [Algebraic X] (r : ℕ) :
    Module.IsTorsion'
      (cycleGroup (Over.baseChange k (PerfectClosure k p) X) r ⧸
        (algebraicExtensionPullback k (PerfectClosure k p) X r).range)
      (Submonoid.powers (p : ℤ)) :=
  sorry

end AlgebraicGeometry.CycleGroup.FieldExtension
