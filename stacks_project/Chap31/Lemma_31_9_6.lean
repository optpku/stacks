module

public import ReasLib.AlgebraicGeometry.Scheme.Module.FittingIdeal.Locus.Representability
public import ReasLib.AlgebraicGeometry.Scheme.Module.FittingIdeal.Locus.FinitePresentation
import StacksCheckRecall

@[expose] public section

open CategoryTheory

noncomputable section

universe u

/- Lemma 31.9.6 (1): for a finite-type quasicoherent module, the intersection of the closed
subschemes defined by all Fitting ideals is empty. -/
@[stacks 05P8] #check
  (AlgebraicGeometry.Scheme.iInter_support_fittingIdealSheaf_eq_empty :
    ∀ {S : AlgebraicGeometry.Scheme.{u}} (F : S.Modules)
      [F.IsFiniteType] [F.IsQuasicoherent],
      (⋂ r : ℕ, ((AlgebraicGeometry.Scheme.fittingIdealSheaf F r).support : Set S)) =
        (∅ : Set S))

/- Lemma 31.9.6 (2): the complement of the `r`th Fitting closed subscheme represents the
condition that the pulled-back module is locally generated by at most `r` sections. -/
@[stacks 05P8] #check
  (AlgebraicGeometry.Scheme.fittingOpenComplement_nonempty_over_hom_iff_isLocallyGeneratedBy :
    ∀ {S T : AlgebraicGeometry.Scheme.{u}} (g : T ⟶ S) (F : S.Modules)
      [F.IsFiniteType] [F.IsQuasicoherent] (r : ℕ),
      Subsingleton
          (CategoryTheory.Over.mk g ⟶ CategoryTheory.Over.mk
            (AlgebraicGeometry.Scheme.fittingOpenComplement F r).ι) ∧
        (Nonempty
            (CategoryTheory.Over.mk g ⟶ CategoryTheory.Over.mk
              (AlgebraicGeometry.Scheme.fittingOpenComplement F r).ι) ↔
          SheafOfModules.IsLocallyGeneratedBy
            ((AlgebraicGeometry.Scheme.Modules.pullback g).obj F) r))

/- Lemma 31.9.6 (3): the successive Fitting stratum `Z_{r-1} \ Z_r` represents the condition
that the pulled-back module is finite locally free of rank `r`. -/
@[stacks 05P8] #check
  (AlgebraicGeometry.Scheme.fittingRankLocus_nonempty_over_hom_iff_isFiniteLocallyFreeOfRank :
    ∀ {S T : AlgebraicGeometry.Scheme.{u}} (g : T ⟶ S) (F : S.Modules)
      [F.IsFiniteType] [F.IsQuasicoherent] (r : ℕ),
      Subsingleton
          (CategoryTheory.Over.mk g ⟶ CategoryTheory.Over.mk
            (AlgebraicGeometry.Scheme.fittingRankLocusι F r)) ∧
        (Nonempty
            (CategoryTheory.Over.mk g ⟶ CategoryTheory.Over.mk
              (AlgebraicGeometry.Scheme.fittingRankLocusι F r)) ↔
          SheafOfModules.IsFiniteLocallyFreeOfRank r
            ((AlgebraicGeometry.Scheme.Modules.pullback g).obj F)))

/- Lemma 31.9.6 (4): a closed subscheme defined by a Fitting ideal of a finitely presented
module is of finite presentation over the ambient scheme. -/
@[stacks 05P8] #check
  (AlgebraicGeometry.Scheme.fittingClosedSubscheme_hom_finitePresentation :
    ∀ {S : AlgebraicGeometry.Scheme.{u}} (F : S.Modules)
      [F.IsFinitePresentation] (r : ℕ),
      AlgebraicGeometry.Scheme.Hom.FinitePresentation
        (AlgebraicGeometry.Scheme.fittingIdealSheaf F r).subschemeι)

/- Lemma 31.9.6 (5): the complement of a Fitting closed subscheme of a finitely presented
module is of finite presentation over the ambient scheme. -/
@[stacks 05P8] #check
  (AlgebraicGeometry.Scheme.fittingOpenComplement_hom_finitePresentation :
    ∀ {S : AlgebraicGeometry.Scheme.{u}} (F : S.Modules)
      [F.IsFinitePresentation] (r : ℕ),
      AlgebraicGeometry.Scheme.Hom.FinitePresentation
        (AlgebraicGeometry.Scheme.fittingOpenComplement F r).ι)

/- Lemma 31.9.6 (6): every successive Fitting rank locus of a finitely presented module is of
finite presentation over the ambient scheme. -/
@[stacks 05P8] #check
  (AlgebraicGeometry.Scheme.fittingRankLocus_hom_finitePresentation :
    ∀ {S : AlgebraicGeometry.Scheme.{u}} (F : S.Modules)
      [F.IsFinitePresentation] (r : ℕ),
      AlgebraicGeometry.Scheme.Hom.FinitePresentation
        (AlgebraicGeometry.Scheme.fittingRankLocusι F r))
