module

public import ReasLib.Algebra.Homology.DerivedCategory.Completeness
import Mathlib.Tactic.CrossRefAttribute

/-!
# Cohomological dimension of derived completion

An ideal generated by `r` elements gives the derived-completion functor a cohomological range of
length `r`.  The two morphism criteria below retain the chosen `Fin r`-indexed generating family
because the lower bound depends on its cardinality.

@stack 0AAJ
-/

@[expose] public section

noncomputable section

open CategoryTheory

universe u

namespace Ideal

/-- A `Fin r`-indexed family spanning `I` exhibits `I` as finitely generated. -/
@[stacks 0AAJ "finite generation from a finite spanning family"]
theorem fg_of_span_range_fin {A : Type u} [CommRing A] {r : ℕ}
    (I : Ideal A) (f : Fin r → A) (hspan : Ideal.span (Set.range f) = I) :
    I.FG := sorry

end Ideal

namespace DerivedCategory.DerivedCompletion

variable {A : Type u} [CommRing A] {r : ℕ}

-- Local declaration justification (source-local notation): keep the source's short derived-module
-- spelling in the two cohomology-map criteria.
local notation "DMod" => DerivedCategory (ModuleCat A)
-- Local declaration justification (source-local notation): keep the source's cohomology-functor
-- spelling while the public theorem names remain mathematical.
local notation "H" => DerivedCategory.homologyFunctor (ModuleCat A)

/-- Lemma 15.92.21 (1): derived completion preserves isomorphisms on cohomology in degrees
`i ≥ 1` together with epimorphisms in degree `0`. -/
@[stacks 0AAJ "(1), upper cohomological bound for derived completion"]
theorem map_isIso_ge_one_and_epi_zero
    (I : Ideal A) (f : Fin r → A) (hspan : Ideal.span (Set.range f) = I)
    {K L : DMod} (φ : K ⟶ L)
    (hφ_iso : ∀ i : ℤ, 1 ≤ i → IsIso ((H i).map φ))
    (hφ_epi : Epi ((H 0).map φ)) :
    (∀ i : ℤ, 1 ≤ i →
      IsIso ((H i).map
        ((derivedCompletion I (Ideal.fg_of_span_range_fin I f hspan)).map φ))) ∧
      Epi ((H 0).map
        ((derivedCompletion I (Ideal.fg_of_span_range_fin I f hspan)).map φ)) := sorry

/-- Lemma 15.92.21 (2): if `I` is generated by `r` elements, derived completion carries
isomorphisms in degrees `i ≤ -1` and a monomorphism in degree `0` to isomorphisms in degrees
`i ≤ -r - 1` and a monomorphism in degree `-r`. -/
@[stacks 0AAJ "(2), lower cohomological bound for derived completion"]
theorem map_isIso_le_neg_succ_and_mono_neg
    (I : Ideal A) (f : Fin r → A) (hspan : Ideal.span (Set.range f) = I)
    {K L : DMod} (φ : K ⟶ L)
    (hφ_iso : ∀ i : ℤ, i ≤ -1 → IsIso ((H i).map φ))
    (hφ_mono : Mono ((H 0).map φ)) :
    (∀ i : ℤ, i ≤ -((r : ℤ) + 1) →
      IsIso ((H i).map
        ((derivedCompletion I (Ideal.fg_of_span_range_fin I f hspan)).map φ))) ∧
      Mono ((H (-(r : ℤ))).map
        ((derivedCompletion I (Ideal.fg_of_span_range_fin I f hspan)).map φ)) := sorry

end DerivedCategory.DerivedCompletion
