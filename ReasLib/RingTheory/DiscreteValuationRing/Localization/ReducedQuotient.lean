module

public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import ReasLib.RingTheory.DiscreteValuationRing.Characterization

@[expose] public section

open IsLocalRing

universe u

namespace minimalPrimes

/-- Localizing a Noetherian ring at a minimal prime over a nonzerodivisor with reduced
principal quotient gives a discrete valuation ring whose maximal ideal is generated by
the image of that nonzerodivisor. -/
theorem isDiscreteValuationRing_atPrime_of_reduced_quotient
    {A : Type u} [CommRing A] [IsNoetherianRing A]
    (f : A) (hf : f ∈ nonZeroDivisors A) [IsReduced (A ⧸ Ideal.span {f})]
    (p : Ideal A) [p.IsPrime] (hp : p ∈ (Ideal.span {f}).minimalPrimes) :
    ∃ h_domain : IsDomain (Localization.AtPrime p),
      @IsDiscreteValuationRing (Localization.AtPrime p) inferInstance h_domain ∧
        maximalIdeal (Localization.AtPrime p) =
          Ideal.span {algebraMap A (Localization.AtPrime p) f} := sorry

end minimalPrimes
