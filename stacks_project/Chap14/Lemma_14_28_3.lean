module

public import ReasLib.AlgebraicTopology.CosimplicialObject.Homotopy.Opposite.Cotensor
import StacksCheckRecall

/-!
@stack 019X

# Opposite simplicial presentation of cosimplicial homotopy

The reusable product-free `Δ[1]` / opposite-simplicial comparison is owned by
`ReasLib.AlgebraicTopology.CosimplicialObject.Homotopy.Opposite`.
-/

@[expose] public section

open CategoryTheory
open scoped Simplicial

noncomputable section

universe u v

namespace CategoryTheory.CosimplicialObject

variable {C : Type u} [Category.{v} C]
variable {U V : CosimplicialObject C} (a b : U ⟶ V)

/- Lemma 14.28.3: product-free cosimplicial `Δ[1]`-homotopies are equivalent to simplicial
homotopies between the corresponding opposite morphisms. -/
@[stacks 019X "Lemma 14.28.3: directed homotopies"]
#check (DeltaOneHomotopy.opposite.equiv a b :
  DeltaOneHomotopy a b ≃
    SimplicialObject.Homotopy (NatTrans.op a) (NatTrans.op b))

/- Lemma 14.28.3: the zigzag relations generated by the two presentations agree after passage
to opposite simplicial objects. -/
@[stacks 019X "Lemma 14.28.3: zigzag homotopy relation"]
#check (DeltaOneHomotopic.iff_op a b :
  DeltaOneHomotopic a b ↔
    SimplicialObject.Homotopic (NatTrans.op a) (NatTrans.op b))

section Cotensor

variable [HasCotensor (Δ[1] : SSet.{0}) V]

/- Under the finite-product presentation, the same source relation is the cotensor-valued
homotopy relation. The product-free statement above remains the general entry. -/
@[stacks 019X "Lemma 14.28.3: cotensor homotopy presentation"]
#check (Homotopic.iff_op a b :
  Homotopic a b ↔
    SimplicialObject.Homotopic (NatTrans.op a) (NatTrans.op b))

end Cotensor

end CategoryTheory.CosimplicialObject
