module

public import Mathlib.RingTheory.AdicCompletion.Algebra
public import ReasLib.RingTheory.Ideal.Principal

@[expose] public section

universe u

namespace AdicCompletion.Nat

/-- Completion with respect to the ideal generated by a natural-number scalar. -/
abbrev ring (p : ℕ) (R : Type u) [CommRing R] := AdicCompletion (Ideal.span {(p : R)}) R

variable (p : ℕ) {R S T : Type u} [CommRing R] [CommRing S] [CommRing T]

/-- The finite-stage map induced by a ring homomorphism on scalar-adic completions. -/
noncomputable def evalFamily (f : R →+* S) (e : ℕ) :
    ring p R →+* S ⧸ (Ideal.span {(p : S)}) ^ e :=
  (principalPowerIdealQuotientMap f (p : R) (map_natCast f p) e).comp
    (AdicCompletion.evalₐ (Ideal.span {(p : R)}) e).toRingHom

/-- The finite-stage maps commute with transition to a smaller scalar-power quotient. -/
theorem evalFamily_compat (f : R →+* S) {m k : ℕ} (h : m ≤ k) :
    (Ideal.Quotient.factorPow (Ideal.span {(p : S)}) h).comp (evalFamily p f k) =
      evalFamily p f m := sorry

/-- Functorial scalar-adic completion of a ring homomorphism. -/
noncomputable def map (f : R →+* S) : ring p R →+* ring p S :=
  AdicCompletion.liftRingHom (Ideal.span {(p : S)}) (evalFamily p f)
    (fun h ↦ evalFamily_compat p f h)

/-- Completion carries the image of a ring element to the image of its mapped value. -/
theorem map_of (f : R →+* S) (r : R) :
    map p f (AdicCompletion.of _ R r) = AdicCompletion.of _ S (f r) := sorry

/-- Completion preserves identity homomorphisms. -/
theorem map_id : map p (RingHom.id R) = RingHom.id (ring p R) := sorry

/-- Completion preserves composition of homomorphisms. -/
theorem map_comp (f : R →+* S) (g : S →+* T) :
    map p (g.comp f) = (map p g).comp (map p f) := sorry

/-- Completing a bijective ring homomorphism gives a bijective homomorphism. -/
theorem map_bijective (f : R →+* S) (hf : Function.Bijective f) :
    Function.Bijective (map p f) := sorry

end AdicCompletion.Nat
