module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.FunctorOfPoints
public import ReasLib.CategoryTheory.Sites.Precoverage.Cardinality
public import ReasLib.CategoryTheory.Sites.Precoverage.Combinatorial
public import ReasLib.CategoryTheory.Sites.PrecoverageSite
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck

/-!
# Chosen big sites of algebraic spaces

A chosen big site on algebraic spaces over a scheme is a cardinal truncation
of an ambient precoverage that remains a site and combinatorially represents
every covering of the ambient class.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry
open scoped Cardinal

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

variable {S : Scheme.{u}}

/-- A chosen big site for a precoverage `P` on algebraic spaces over `S` is a
cardinal bound `κ` such that `P.restrictCardinalLE κ` is a site and every
`P`-covering is combinatorially equivalent to a covering of that truncation. -/
structure ChosenBigSite (P : Precoverage (AlgebraicSpace S)) : Type (u + 2) where
  /-- Cardinal bound on the chosen covering families. -/
  bound : Cardinal.{u + 1}
  /-- The cardinal truncation of `P` is a site. -/
  isSite : (P.restrictCardinalLE bound).IsSite
  /-- Every covering of `P` is combinatorially equivalent to a covering of the
  truncation. -/
  equivalent :
    P.coversUpToCombinatorialEquivalence (P.restrictCardinalLE bound)

namespace ChosenBigSite

variable {P : Precoverage (AlgebraicSpace S)}

/-- Package a cardinal bound at which `P.restrictCardinalLE κ` is a site that
combinatorially represents every `P`-covering. -/
def ofBound (κ : Cardinal.{u + 1})
    (h_site : (P.restrictCardinalLE κ).IsSite)
    (h_equiv : P.coversUpToCombinatorialEquivalence (P.restrictCardinalLE κ)) :
    ChosenBigSite P where
  bound := κ
  isSite := h_site
  equivalent := h_equiv

/-- The bound of `ChosenBigSite.ofBound κ h_site h_equiv` is `κ`. -/
theorem ofBound_bound (κ : Cardinal.{u + 1})
    (h_site : (P.restrictCardinalLE κ).IsSite)
    (h_equiv : P.coversUpToCombinatorialEquivalence (P.restrictCardinalLE κ)) :
    (ofBound κ h_site h_equiv).bound = κ :=
  sorry

/-- The chosen covering precoverage is the cardinal truncation of the ambient
class at the stored bound. -/
def precoverage (X : ChosenBigSite P) : Precoverage (AlgebraicSpace S) :=
  P.restrictCardinalLE X.bound

/-- The Grothendieck topology generated by the chosen covering set. -/
def toGrothendieck (X : ChosenBigSite P) : GrothendieckTopology (AlgebraicSpace S) :=
  X.precoverage.toGrothendieck

/-- A chosen big site is a cardinal truncation of `P` that is a site and
combinatorially represents every `P`-covering. -/
theorem spec (X : ChosenBigSite P) :
    X.precoverage = P.restrictCardinalLE X.bound ∧
      (P.restrictCardinalLE X.bound).IsSite ∧
      P.coversUpToCombinatorialEquivalence (P.restrictCardinalLE X.bound) :=
  sorry

/-- Membership in the chosen covering set is ambient covering together with the
cardinal bound on the uncurried support. -/
theorem mem_precoverage_iff (X : ChosenBigSite P) {Y : AlgebraicSpace S}
    {R : Presieve Y} :
    R ∈ X.precoverage Y ↔
      R ∈ P Y ∧ Cardinal.lift #(R.uncurry) ≤ Cardinal.lift X.bound :=
  sorry

/-- The topology generated by a chosen big site agrees with the topology
generated by the ambient precoverage. -/
theorem toGrothendieck_eq (X : ChosenBigSite P) :
    X.toGrothendieck = P.toGrothendieck :=
  sorry

end ChosenBigSite

end AlgebraicGeometry.AlgebraicSpace
