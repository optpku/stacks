module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Ideal.Span

/-!
# Polynomial relation parameters

This module constructs a coefficient algebra parametrizing finitely supported
relations among a finite family of multivariate polynomials.
-/

@[expose] public section

universe u

namespace MvPolynomial.RelationParameter

/-- The coefficient algebra whose variables parameterize `K × m` polynomial relations and
whose defining ideal makes those universal relations annihilate the equations `f`. -/
abbrev CoefficientAlgebra
    (C : Type u) [CommRing C] {n m : ℕ} (K : ℕ)
    (f : Fin m → MvPolynomial (Fin n) C) (Ω : Finset (Fin n →₀ ℕ)) :=
  (MvPolynomial (Fin K × Fin m × Ω) C) ⧸
    Ideal.span (Set.range fun p : Fin K × (Fin n →₀ ℕ) ↦
      MvPolynomial.coeff p.2
        (∑ j, (∑ I : Ω, MvPolynomial.monomial I.1
          (MvPolynomial.X (p.1, j, I))) * MvPolynomial.map MvPolynomial.C (f j)))

/-- The universal polynomial whose coefficients are the parameters for the `k`-th relation
at the equation index `j`. -/
noncomputable def polynomial
    (C : Type u) [CommRing C] {n m K : ℕ}
    (f : Fin m → MvPolynomial (Fin n) C) (Ω : Finset (Fin n →₀ ℕ))
    (k : Fin K) (j : Fin m) :
    MvPolynomial (Fin n) (CoefficientAlgebra C K f Ω) :=
  MvPolynomial.map
    (algebraMap (MvPolynomial (Fin K × Fin m × Ω) C)
      (CoefficientAlgebra C K f Ω))
    (∑ I : Ω, MvPolynomial.monomial I.1 (MvPolynomial.X (k, j, I)))

/-- The `k`-th universal relation, regarded as a finitely supported vector indexed by the
equations. -/
noncomputable def vector
    (C : Type u) [CommRing C] {n m K : ℕ}
    (f : Fin m → MvPolynomial (Fin n) C) (Ω : Finset (Fin n →₀ ℕ))
    (k : Fin K) : Fin m →₀ MvPolynomial (Fin n) (CoefficientAlgebra C K f Ω) :=
  Finsupp.equivFunOnFinite.symm (fun j ↦ polynomial C f Ω k j)

/-- Evaluating a universal relation vector at an equation index gives the corresponding
universal polynomial. -/
theorem vector_apply
    (C : Type u) [CommRing C] {n m K : ℕ}
    (f : Fin m → MvPolynomial (Fin n) C) (Ω : Finset (Fin n →₀ ℕ))
    (k : Fin K) (j : Fin m) :
    vector C f Ω k j = polynomial C f Ω k j := sorry

/-- The linear map generated by the universal relation vectors. -/
noncomputable def relationMap
    (C : Type u) [CommRing C] {n m K : ℕ}
    (f : Fin m → MvPolynomial (Fin n) C) (Ω : Finset (Fin n →₀ ℕ)) :
    (Fin K →₀ MvPolynomial (Fin n) (CoefficientAlgebra C K f Ω)) →ₗ[
      MvPolynomial (Fin n) (CoefficientAlgebra C K f Ω)]
      Fin m →₀ MvPolynomial (Fin n) (CoefficientAlgebra C K f Ω) :=
  Finsupp.linearCombination (MvPolynomial (Fin n) (CoefficientAlgebra C K f Ω))
    (vector C f Ω)

/-- The linear map generated by the equations after extending their coefficients to the
relation-parameter algebra. -/
noncomputable def equationMap
    (C : Type u) [CommRing C] {n m K : ℕ}
    (f : Fin m → MvPolynomial (Fin n) C) (Ω : Finset (Fin n →₀ ℕ)) :
    (Fin m →₀ MvPolynomial (Fin n) (CoefficientAlgebra C K f Ω)) →ₗ[
      MvPolynomial (Fin n) (CoefficientAlgebra C K f Ω)]
      MvPolynomial (Fin n) (CoefficientAlgebra C K f Ω) :=
  Finsupp.linearCombination (MvPolynomial (Fin n) (CoefficientAlgebra C K f Ω))
    (fun j ↦ MvPolynomial.map (algebraMap C (CoefficientAlgebra C K f Ω)) (f j))

/-- If every equation is supported on `Ω`, the universal relation map followed by the
equation map is zero. -/
theorem equationMap_comp_relationMap
    {C : Type u} [CommRing C] {n m K : ℕ}
    (f : Fin m → MvPolynomial (Fin n) C) (Ω : Finset (Fin n →₀ ℕ))
    (h_f_support : ∀ j, (f j).support ⊆ Ω) :
    (equationMap C (K := K) f Ω).comp (relationMap C (K := K) f Ω) = 0 := sorry

end MvPolynomial.RelationParameter
