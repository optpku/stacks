module

public import Mathlib.AlgebraicTopology.SimplicialSet.Skeleton
public import Mathlib.AlgebraicTopology.SimplicialSet.StdSimplex
public import ReasLib.AlgebraicTopology.SimplicialSet.Dimension

/-!
@stack 017T

# Degreewise API for simplicial-set skeletons

This file exposes the degreewise membership formula, dimension bound, and high-degree
degeneracy rule for the canonical Mathlib subcomplex `SSet.skeleton`.
-/

@[expose] public section

open CategoryTheory Opposite
open scoped Simplicial

universe u

namespace SSet

namespace skeleton

namespace succ

/-- A simplex belongs to the subcomplex generated in degrees at most `n` exactly when it is the
image of a simplex in one of those degrees. -/
@[stacks 017T "membership in the generated subcomplex"]
theorem mem_iff (U : SSet.{u}) (n : ℕ) {m : ℕ} (x : U _⦋m⦌) :
    x ∈ (U.skeleton (n + 1)).obj (op ⦋m⦌) ↔
      ∃ i ≤ n, ∃ φ : ⦋m⦌ ⟶ ⦋i⦌, x ∈ Set.range (U.map φ.op) := sorry

/-- Degreewise, the subcomplex generated by simplices in degrees at most `n` is the union of the
ranges of all restriction maps from those degrees. -/
@[stacks 017T "degreewise generated-subcomplex formula"]
theorem obj_eq_generated (U : SSet.{u}) (n m : ℕ) :
    (U.skeleton (n + 1)).obj (op ⦋m⦌) =
      { x : U _⦋m⦌ | ∃ i ≤ n, ∃ φ : ⦋m⦌ ⟶ ⦋i⦌, x ∈ Set.range (U.map φ.op) } := sorry

/-- Every simplex of the subcomplex generated in degrees at most `n` is degenerate in degrees
strictly greater than `n`. -/
@[stacks 017T "high-degree degeneracy"]
theorem mem_degenerate_of_lt (U : SSet.{u}) {n m : ℕ} (h : n < m)
    (x : (U.skeleton (n + 1) : SSet) _⦋m⦌) :
    x ∈ (U.skeleton (n + 1) : SSet).degenerate m := sorry

end succ

/-- The simplicial set underlying the `n`-skeleton subcomplex has dimension strictly less than
`n`. -/
@[stacks 017T "dimension of the generated subcomplex"]
instance hasDimensionLT (U : SSet.{u}) (n : ℕ) :
    ((U.skeleton n : SSet)).HasDimensionLT n := sorry

/-- The simplicial set underlying a generated skeleton is eventually degenerate. -/
@[stacks 017T "eventual degeneracy of the generated subcomplex"]
instance eventuallyDegenerate (U : SSet.{u}) (n : ℕ) :
    (U.skeleton n : SSet).EventuallyDegenerate := sorry

end skeleton

end SSet
