module

public import ReasLib.AlgebraicGeometry.SquareZero
import StacksCheckRecall

@[expose] public section

universe u v

open AlgebraicGeometry TopologicalSpace

namespace MvPolynomial.SquareZero

variable {σ : Type u} {k : Type v} [Field k]

/- Example 110.22.1 (1): every prime ideal is generated by the variable classes. -/
@[stacks 0G62] #check
  (MvPolynomial.SquareZero.eq_span_generators_of_isPrime (σ := σ) (k := k) :
    ∀ (I : Ideal (Quotient (σ := σ) (k := k))) [I.IsPrime],
      I = Ideal.span (Set.range (generator (σ := σ) (k := k))))

/- Countably infinite specialization: the index type is the natural numbers. -/
#check (MvPolynomial.SquareZero.eq_span_generators_of_isPrime (σ := ℕ) (k := k) :
  ∀ (I : Ideal (Quotient (σ := ℕ) (k := k))) [I.IsPrime],
    I = Ideal.span (Set.range (generator (σ := ℕ) (k := k))))

/- Assertion (2): the spectrum is a single point, hence its topology is Noetherian. -/
#check (PrimeSpectrum.unique_of_ringKrullDimLE_zero :
  Unique (PrimeSpectrum (Quotient (σ := σ) (k := k))))
#check (Finite.to_noetherianSpace (α := PrimeSpectrum (Quotient (σ := σ) (k := k))) :
  NoetherianSpace (Spec (CommRingCat.of (Quotient (σ := σ) (k := k)))))

variable [Infinite σ]

/- Assertion (3): the ideal generated by the variable classes is not finitely generated. -/
#check (MvPolynomial.SquareZero.not_fg_span_generators (σ := σ) (k := k) :
  ¬ (Ideal.span (Set.range (generator (σ := σ) (k := k)))).FG)

/- Ring consequence: the ring is not Noetherian. -/
#check (MvPolynomial.SquareZero.not_isNoetherianRing (σ := σ) (k := k) :
  ¬ IsNoetherianRing (Quotient (σ := σ) (k := k)))

/- Scheme consequence: the affine scheme is not Noetherian. -/
#check (MvPolynomial.SquareZero.not_isNoetherian_spec (σ := σ) (k := k) :
  ¬ IsNoetherian (Spec (CommRingCat.of (Quotient (σ := σ) (k := k)))))

end MvPolynomial.SquareZero
