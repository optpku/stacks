module

public import ReasLib.AlgebraicGeometry.Scheme.Cover.Smooth

/-!
# Stability of smooth covering families

Smooth covering families of schemes are stable under singleton isomorphisms,
indexed composition, and base change.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits

universe u v w

namespace AlgebraicGeometry.Scheme

/-- A singleton family generated by an isomorphism is a smooth covering. -/
theorem smoothCovering_singleton_of_isIso {T T' : Scheme.{u}}
    (f : T' ⟶ T) [IsIso f] :
    SmoothCovering (fun _ : Unit ↦ Over.mk f) := sorry

/-- Indexed composition of smooth covering families is a smooth covering. -/
theorem smoothCovering_comp {T : Scheme.{u}} {ι : Type v} {κ : ι → Type w}
    (X : ι → Over T) (Y : (i : ι) → κ i → Over (X i).left)
    (hX : SmoothCovering X) (hY : ∀ i : ι, SmoothCovering (Y i)) :
    SmoothCovering (fun p : Sigma κ ↦
      Over.mk ((Y p.1 p.2).hom ≫ (X p.1).hom)) := sorry

/-- Pullback of a smooth covering family along a scheme morphism is a smooth covering. -/
theorem smoothCovering_pullback {T T' : Scheme.{u}} {ι : Type v}
    (X : ι → Over T) (hX : SmoothCovering X) (f : T' ⟶ T) :
    SmoothCovering (fun i : ι ↦ Over.mk (pullback.fst f (X i).hom)) := sorry

end AlgebraicGeometry.Scheme
