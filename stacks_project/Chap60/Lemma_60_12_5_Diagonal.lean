module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
public import Mathlib.AlgebraicGeometry.Modules.Sheaf
public import Mathlib.CategoryTheory.Limits.Shapes.BinaryProducts
public import Mathlib.CategoryTheory.Limits.Shapes.Kernels
public import ReasLib.AlgebraicGeometry.Scheme.IdealSubobject
public import ReasLib.AlgebraicGeometry.RingedSpace.IdealSubobject.Kernel
public import stacks_project.Chap60.Lemma_60_6_3
public import stacks_project.Chap60.«60_9_1_1»

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry.Scheme.Crystalline
open DividedPowers

@[expose] public section

universe u

variable {S : Scheme.{u}} {I : S.IdealSheafData}
variable {γ : ∀ V : S.affineOpens, DividedPowers (I.ideal V)}
variable {h_compatible :
    ∀ (V : S.affineOpens) (f : Γ(S, V)),
      (γ V).IsDPMorphism (γ (S.affineBasicOpen f))
        (S.presheaf.map (homOfLE (S.basicOpen_le f)).op).hom}
variable {X : Scheme.{u}} {x₀ : X ⟶ I.subscheme}

/-- The diagonal morphism of a self-product cone in `Cris(X/S)`. -/
noncomputable def crystallineSiteDiag
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1)) : T ⟶ T1 :=
  hprod.lift (BinaryFan.mk (𝟙 T) (𝟙 T))

/-- The quasi-coherent kernel ideal sheaf of the diagonal closed immersion
`Δ : T → T(1)`. -/
noncomputable def crystallineSiteDiagKer
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1)) :
    T1.obj.1.thickening.IdealSheafData :=
  (crystallineSiteDiag π0 π1 hprod).hom.thickening.ker

/-- The sheaf of second-order divided-power ideals `𝒦^[2]` generated by
squares and divided powers of order at least two in `𝒦 ∩ 𝒥_{T(1)}`. -/
noncomputable def crystallineSiteDiagSecondOrder
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1)) :
    T1.obj.1.thickening.IdealSheafData :=
  Scheme.IdealSheafData.ofIdeals fun V ↦
    let K := (crystallineSiteDiagKer π0 π1 hprod).ideal V
    K ^ 2 ⊔ (T1.obj.1.gamma V).secondOrderIdeal (K ⊓ T1.obj.1.ideal.ideal V)

/-- `𝒦^[2]` is contained in the diagonal kernel ideal sheaf. -/
theorem crystallineSiteDiagSecondOrder_le
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1)) :
    crystallineSiteDiagSecondOrder π0 π1 hprod ≤
      crystallineSiteDiagKer π0 π1 hprod := sorry

/-- `𝒦^[2]` is contained in `𝒦` as module-sheaf subobjects. -/
theorem crystallineSiteDiagSecondOrder_toSubobject_le
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1)) :
    (crystallineSiteDiagSecondOrder π0 π1 hprod).toSubobject ≤
      (crystallineSiteDiagKer π0 π1 hprod).toSubobject := sorry

/-- The inclusion of `𝒦^[2]` into `𝒦` as module sheaves on `T(1)`. -/
noncomputable def crystallineSiteDiagSecondOrder_arrow
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1)) :
    (crystallineSiteDiagSecondOrder π0 π1 hprod).toModule ⟶
      (crystallineSiteDiagKer π0 π1 hprod).toModule :=
  Subobject.ofLE
    (crystallineSiteDiagSecondOrder π0 π1 hprod).toSubobject
    (crystallineSiteDiagKer π0 π1 hprod).toSubobject
    (crystallineSiteDiagSecondOrder_toSubobject_le π0 π1 hprod)

/-- The quotient module sheaf `𝒦 / 𝒦^[2]` on the self-product thickening. -/
noncomputable def crystallineSiteDiagKernelQuotient
    {T T1 : smallCrystallineSite S I γ h_compatible X x₀}
    (π0 π1 : T1 ⟶ T) (hprod : IsLimit (BinaryFan.mk π0 π1)) :
    T1.obj.1.thickening.Modules :=
  cokernel (crystallineSiteDiagSecondOrder_arrow π0 π1 hprod)
