module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.PowerSeries.Basic

@[expose] public section

noncomputable section

universe u

namespace PowerSeries.NonflatLocalization

variable (k : Type u) [Field k]

/-- The ideal generated by all `y * aᵢ` and `aᵢ * aⱼ`, where `Sum.inl 0`
indexes `y`, `Sum.inl 1` indexes `z`, and `Sum.inr index` indexes `a_(index+1)`. -/
def relations : Ideal (MvPolynomial (Fin 2 ⊕ ℕ) k) :=
  Ideal.span
    (Set.range (fun index : ℕ =>
      MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inr index)) ∪
      Set.range (fun indices : ℕ × ℕ =>
        MvPolynomial.X (Sum.inr indices.1) * MvPolynomial.X (Sum.inr indices.2)))

/-- The ring `k[y,z,a₁,a₂,…]` modulo all relations `y * aᵢ = 0`
and `aᵢ * aⱼ = 0`. -/
abbrev Ring := MvPolynomial (Fin 2 ⊕ ℕ) k ⧸ relations k

/-- The residue class of the variable `z` in the quotient ring. -/
def z : Ring k :=
  Ideal.Quotient.mk (relations k) (MvPolynomial.X (Sum.inl 1))

/-- The coefficientwise localization homomorphism on formal power series,
localizing the quotient ring at the residue class of `z`. -/
def localizationMap :
    PowerSeries (Ring k) →+* PowerSeries (Localization.Away (z k)) :=
  PowerSeries.map (algebraMap (Ring k) (Localization.Away (z k)))

end PowerSeries.NonflatLocalization
