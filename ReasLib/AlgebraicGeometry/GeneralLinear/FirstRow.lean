module

public import ReasLib.AlgebraicGeometry.GeneralLinear.Row

/-!
# The first row of a general linear matrix

The first row of an invertible `(n + 1) × (n + 1)` matrix defines canonical morphisms to
punctured affine `(n + 1)`-space and projective `n`-space. `GL₂ → 𝔸² ∖ {0} → ℙ¹` is the first
specialization.
-/

@[expose] public section

open CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.GeneralLinear.FirstRow

variable (R : Type u) [CommRing R] (n : ℕ)

/-- The ideal generated by the first row of the universal `(n + 1) × (n + 1)` matrix. -/
@[stacks 01KX "first-row ideal"]
noncomputable abbrev ideal :
    Ideal (GeneralLinear.coordinateRing R (ULift.{u} (Fin (n + 1)))) :=
  Row.ideal R (ULift.{u} (Fin (n + 1))) (ULift.up 0)

/-- The first row of the universal invertible matrix is unimodular. -/
@[stacks 01KX "first-row unimodularity"]
theorem ideal_eq_top : ideal R n = ⊤ :=
  Row.ideal_eq_top R (ULift.{u} (Fin (n + 1))) (ULift.up 0)

/-- The comorphism from affine `(n + 1)`-space sending its coordinates to the first row of the
generic invertible matrix. -/
@[stacks 01KX "first-row coordinate comap"]
noncomputable abbrev coordinateComap :
    PuncturedAffineSpace.coordinateRing (ULift.{u} (Fin (n + 1))) R →ₐ[R]
      GeneralLinear.coordinateRing R (ULift.{u} (Fin (n + 1))) :=
  Row.coordinateComap R (ULift.{u} (Fin (n + 1))) (ULift.up 0)

/-- The first-row comorphism sends the `j`-th affine coordinate to the `(0, j)` matrix
coordinate. -/
@[simp, stacks 01KX "first-row coordinate evaluation"]
theorem coordinateComap_X (j : Fin (n + 1)) :
    coordinateComap R n (MvPolynomial.X (ULift.up j)) =
      GeneralLinear.localizedCoordinate R (ULift.{u} (Fin (n + 1)))
        (ULift.up 0) (ULift.up j) := sorry

/-- The morphism from `GL(n + 1)` to affine `(n + 1)`-space induced by the first row. -/
@[stacks 01KX "first-row affine morphism"]
noncomputable abbrev toAffineSpace :
    GeneralLinear.scheme R (ULift.{u} (Fin (n + 1))) ⟶
      PuncturedAffineSpace.affineSpace (ULift.{u} (Fin (n + 1))) R :=
  Row.toAffineSpace R (ULift.{u} (Fin (n + 1))) (ULift.up 0)

/-- The first-row morphism respects the structure morphisms to `Spec(R)`. -/
@[reassoc, stacks 01KX "first-row affine structure map"]
theorem toAffineSpace_toBase :
    toAffineSpace R n ≫
        PuncturedAffineSpace.toBase (ULift.{u} (Fin (n + 1))) R =
      GeneralLinear.toBase R (ULift.{u} (Fin (n + 1))) := sorry

/-- The first row of an invertible matrix lies in punctured affine space. -/
@[stacks 01KX "first-row puncture range"]
theorem toAffineSpace_range_subset_punctured :
    Set.range (toAffineSpace R n).base ⊆
      Set.range
        (PuncturedAffineSpace.puncturedOpen (ULift.{u} (Fin (n + 1))) R).ι.base :=
  Row.toAffineSpace_range_subset_punctured R
    (ULift.{u} (Fin (n + 1))) (ULift.up 0)

/-- The canonical first-row morphism to punctured affine `(n + 1)`-space. -/
@[stacks 01KX "first row of a general linear matrix"]
abbrev toPuncturedAffineSpace :
    GeneralLinear.scheme R (ULift.{u} (Fin (n + 1))) ⟶
      (PuncturedAffineSpace.puncturedOpen (ULift.{u} (Fin (n + 1))) R).toScheme :=
  Row.toPuncturedAffineSpace R (ULift.{u} (Fin (n + 1))) (ULift.up 0)

/-- The first-row lift composes with the punctured-open inclusion to `toAffineSpace`. -/
@[reassoc (attr := simp), stacks 01KX "first-row punctured inclusion"]
theorem toPuncturedAffineSpace_ι :
    toPuncturedAffineSpace R n ≫
        (PuncturedAffineSpace.puncturedOpen (ULift.{u} (Fin (n + 1))) R).ι =
      toAffineSpace R n := sorry

/-- The first-row morphism to punctured affine space is over `Spec(R)`. -/
@[reassoc, stacks 01KX "first-row punctured structure map"]
theorem toPuncturedAffineSpace_toBase :
    toPuncturedAffineSpace R n ≫
        (PuncturedAffineSpace.puncturedOpen (ULift.{u} (Fin (n + 1))) R).ι ≫
          PuncturedAffineSpace.toBase (ULift.{u} (Fin (n + 1))) R =
      GeneralLinear.toBase R (ULift.{u} (Fin (n + 1))) := sorry

/-- The canonical projectivization of the first row. -/
@[stacks 01KX "projectivized first row"]
abbrev toProjectiveSpace :
    GeneralLinear.scheme R (ULift.{u} (Fin (n + 1))) ⟶ ProjectiveSpace.scheme R n :=
  Row.toProjectiveSpace R n 0

/-- The projectivized first-row morphism is over `Spec(R)`. -/
@[reassoc, stacks 01KX "projectivized first-row structure map"]
theorem toProjectiveSpace_toBase :
    toProjectiveSpace R n ≫ ProjectiveSpace.toSpec R n =
      GeneralLinear.toBase R (ULift.{u} (Fin (n + 1))) := sorry

end AlgebraicGeometry.GeneralLinear.FirstRow
