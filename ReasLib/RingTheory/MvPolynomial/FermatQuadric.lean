module

public import ReasLib.RingTheory.Depth
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import Mathlib.Algebra.MvPolynomial.Basic

@[expose] public section

noncomputable section

universe u

namespace MvPolynomial.FermatQuadric

/-- The Fermat equation `X 0 ^ 2 + X 1 ^ 2 + X 2 ^ 2` in `k[x, y, z]`, with
`X 0`, `X 1`, `X 2` corresponding to `x`, `y`, `z`. -/
def equation (k : Type u) [Field k] : MvPolynomial (Fin 3) k :=
  X 0 ^ 2 + X 1 ^ 2 + X 2 ^ 2

/-- `equation k` is the polynomial `X 0 ^ 2 + X 1 ^ 2 + X 2 ^ 2`. -/
theorem equation_eq (k : Type u) [Field k] :
    equation k = X 0 ^ 2 + X 1 ^ 2 + X 2 ^ 2 := sorry

/-- The principal relation ideal `(x ^ 2 + y ^ 2 + z ^ 2)` in `k[x, y, z]`. -/
def relationIdeal (k : Type u) [Field k] : Ideal (MvPolynomial (Fin 3) k) :=
  Ideal.span {equation k}

/-- `relationIdeal k` is the principal ideal generated by `equation k`. -/
theorem relationIdeal_eq_span (k : Type u) [Field k] :
    relationIdeal k = Ideal.span {equation k} := sorry

/-- The affine Fermat quadric `k[x, y, z] ⧸ (x ^ 2 + y ^ 2 + z ^ 2)`. -/
abbrev Ring (k : Type u) [Field k] :=
  MvPolynomial (Fin 3) k ⧸ relationIdeal k

/-- The irrelevant ideal `(x, y, z)` in the affine Fermat quadric. -/
def irrelevantIdeal (k : Type u) [Field k] : Ideal (Ring k) :=
  Ideal.map (Ideal.Quotient.mk (relationIdeal k)) (Ideal.span {X 0, X 1, X 2})

/-- `irrelevantIdeal k` is the image of `Ideal.span {X 0, X 1, X 2}` in `Ring k`. -/
theorem irrelevantIdeal_eq_map (k : Type u) [Field k] :
    irrelevantIdeal k =
      Ideal.map (Ideal.Quotient.mk (relationIdeal k))
        (Ideal.span {X 0, X 1, X 2}) := sorry

/-- Over any field, the coordinate ring of the affine Fermat quadric has depth `2`
with respect to its irrelevant ideal. -/
theorem depth_irrelevant (k : Type u) [Field k] :
    Ideal.depth (irrelevantIdeal k) (Ring k) = 2 := sorry

end MvPolynomial.FermatQuadric
