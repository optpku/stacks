module

public import Mathlib.Algebra.Category.ModuleCat.Presheaf
public import Mathlib.Algebra.Homology.HomologicalComplex
public import Mathlib.CategoryTheory.Subobject.Lattice
public import Mathlib.SetTheory.Ordinal.Univ
import Mathlib.Tactic.CrossRefAttribute

/-!
# Small subcomplexes of complexes of presheaves of modules

This file owns the cardinal invariants and containment predicate used to construct a uniformly
small subcomplex containing prescribed local sections.  All relevant cardinals live in one
common universe; in particular, the bound cannot be discharged by moving to a successor universe
and choosing its universe cardinal.
-/

@[expose] public section

open CategoryTheory Opposite

noncomputable section

universe u v w z

namespace CategoryTheory.PresheafOfModules

variable {C : Type u} [Category.{v} C]

/-- Cochain complexes of modules over a ring-valued presheaf. -/
abbrev Cochain (O : Cᵒᵖ ⥤ RingCat.{w}) :=
  CochainComplex (PresheafOfModules.{z} O) ℤ

namespace Cochain

variable {O : Cᵒᵖ ⥤ RingCat.{w}}

/-- A family of prescribed sections, indexed by the degree and the object of the base
category. -/
abbrev SectionFamily (F : Cochain.{u, v, w, z} O) :=
  ∀ i : ℤ, ∀ U : C, Set ((F.X i).obj (op U))

/-- The cardinality of all objectwise sections in all degrees of a cochain complex. -/
@[stacks 0GYX "cardinality of a complex of presheaves of modules"]
def sectionsCardinal (F : Cochain.{u, v, w, z} O) :
    Cardinal.{max (max u v) (max w z)} :=
  Cardinal.lift.{max (max u v) (max w z), max u z}
    (Cardinal.mk (Σ i : ℤ, Σ U : C, (F.X i).obj (op U)))

namespace SectionFamily

variable {F : Cochain.{u, v, w, z} O}

/-- The cardinality of a family of prescribed sections. -/
@[stacks 0GYX "cardinality of prescribed sections"]
def cardinal (Omega : SectionFamily F) : Cardinal.{max (max u v) (max w z)} :=
  Cardinal.lift.{max (max u v) (max w z), max u z}
    (Cardinal.mk (Σ i : ℤ, Σ U : C, {x : (F.X i).obj (op U) // x ∈ Omega i U}))

/-- A section family is contained in a subcomplex when every prescribed section is in the
objectwise image of the subcomplex inclusion. -/
def IsContainedIn (Omega : SectionFamily F) (G : Subobject F) : Prop :=
  ∀ i : ℤ, ∀ U : C, Omega i U ⊆ Set.range ((G.arrow.f i).app (op U))

/-- Containment of prescribed sections is preserved when a subcomplex is enlarged. -/
theorem IsContainedIn.mono {Omega : SectionFamily F} {G H : Subobject F}
    (hOmega : Omega.IsContainedIn G) (hGH : G ≤ H) : Omega.IsContainedIn H := sorry

end SectionFamily

/-- The cardinality of the complex underlying a subobject. -/
def subcomplexCardinal {F : Cochain.{u, v, w, z} O} (G : Subobject F) :
    Cardinal.{max (max u v) (max w z)} :=
  sectionsCardinal (G : Cochain.{u, v, w, z} O)

/-- Lemma 21.43.6 (0GYX): one cardinal uniformly bounds a subcomplex generated by any prescribed
family of local sections.  The resulting subobject contains every prescribed section and its
objectwise section cardinality is bounded by the maximum of the uniform bound and the seed
cardinality. -/
@[stacks 0GYX]
theorem exists_small_subcomplex (O : Cᵒᵖ ⥤ RingCat.{w}) :
    ∃ kappa : Cardinal.{max (max u v) (max w z)},
      ∀ (F : Cochain.{u, v, w, z} O) (Omega : SectionFamily F),
        ∃ G : Subobject F,
          Omega.IsContainedIn G ∧
            subcomplexCardinal G ≤ max kappa Omega.cardinal := sorry

end Cochain
end CategoryTheory.PresheafOfModules
