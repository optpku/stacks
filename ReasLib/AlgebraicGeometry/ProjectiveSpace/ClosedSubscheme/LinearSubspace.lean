module

public import Mathlib.LinearAlgebra.LinearIndependent.Defs
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.ClosedSubscheme.CoordinateIdeal

@[expose] public section

universe u

namespace AlgebraicGeometry.ProjectiveSpace.ClosedSubscheme

/-- A closed subscheme of `scheme k 3` is a linear line when its homogeneous coordinate
ideal is generated by two linearly independent degree-one forms. -/
def IsLinearLine {k : Type u} [Field k] (Z : (scheme k 3).IdealSheafData) : Prop :=
  ∃ ℓ : Fin 2 → MvPolynomial (Fin (3 + 1)) k,
    (∀ i, ℓ i ∈ grading k 3 1) ∧
      LinearIndependent k ℓ ∧
        coordinateIdeal 3 Z = Ideal.span (Set.range ℓ)

/-- Linear lines in `scheme k 3` are exactly the closed subschemes whose coordinate ideal is
the span of two linearly independent linear forms. -/
theorem isLinearLine_iff {k : Type u} [Field k] (Z : (scheme k 3).IdealSheafData) :
    IsLinearLine Z ↔
      ∃ ℓ : Fin 2 → MvPolynomial (Fin (3 + 1)) k,
        (∀ i, ℓ i ∈ grading k 3 1) ∧
          LinearIndependent k ℓ ∧
            coordinateIdeal 3 Z = Ideal.span (Set.range ℓ) := Iff.rfl

/-- A closed subscheme of `scheme k 3` is not contained in a plane when its coordinate
ideal contains no nonzero linear form. -/
def notContainedInPlane {k : Type u} [Field k]
    (Z : (scheme k 3).IdealSheafData) : Prop :=
  ∀ f : MvPolynomial (Fin (3 + 1)) k,
    f ∈ grading k 3 1 → f ≠ 0 → f ∉ coordinateIdeal 3 Z

/-- Noncontainment in a plane is the absence of a nonzero linear form in the coordinate
ideal. -/
theorem notContainedInPlane_iff {k : Type u} [Field k]
    (Z : (scheme k 3).IdealSheafData) :
    notContainedInPlane Z ↔
      ∀ f : MvPolynomial (Fin (3 + 1)) k,
        f ∈ grading k 3 1 → f ≠ 0 → f ∉ coordinateIdeal 3 Z := Iff.rfl

end AlgebraicGeometry.ProjectiveSpace.ClosedSubscheme
