module

public import ReasLib.RingTheory.FittingIdeal.PrincipalTorsion
import StacksCheckRecall

/-!
# A principal Fitting ideal generated by a nonzerodivisor

@stack 0F7M
-/

namespace FittingIdeal.PrincipalTorsion

-- Lemma 15.8.10 (1): the module has projective dimension at most `1`.
@[stacks 0F7M "(1), projective dimension of the module"]
#check @projectiveDimensionLE_one

-- Lemma 15.8.10 (2): power torsion is the submodule killed by `f`.
@[stacks 0F7M "(2), power torsion"]
#check @powerTorsion_eq_torsionBy

-- Lemma 15.8.10 (3): the torsion submodule has projective dimension at most `1`.
@[stacks 0F7M "(3), projective dimension of the torsion submodule"]
#check @torsionBy_projectiveDimensionLE_one

-- Lemma 15.8.10 (4): the quotient by torsion is finite locally free of rank `k`.
@[stacks 0F7M "(4), locally free quotient"]
#check @quotient_finiteLocallyFreeOfRank

-- Lemma 15.8.10 (5): the module splits noncanonically into quotient and torsion.
@[stacks 0F7M "(5), quotient-torsion splitting"]
#check @nonempty_quotient_prod_torsionBy_equiv

end FittingIdeal.PrincipalTorsion
