module

public import Mathlib.CategoryTheory.Sites.Sheaf

/-!
# Sheaf conditions for a displayed family

This module gives the small generic bridge from a family of arrows to the
canonical `Presieve.IsSheafFor` condition.  It is independent of schemes and
can be used by any site presentation based on families.
-/

@[expose] public section

open CategoryTheory

universe u v w x

namespace CategoryTheory.Presheaf

/-- A presheaf satisfies the sheaf condition for a displayed family when it
satisfies the canonical sheaf condition for the presieve generated by that
family. -/
abbrev IsSheafForFamily {C : Type u} [Category.{v} C]
    (F : Cᵒᵖ ⥤ Type w) {ι : Type x} {T : C}
    (family : ι → C) (map : ∀ i, family i ⟶ T) : Prop :=
  Presieve.IsSheafFor F (Presieve.ofArrows family map)

/-- The family sheaf condition unfolds to the generated-presieve sheaf
condition. -/
theorem isSheafForFamily_iff {C : Type u} [Category.{v} C]
    (F : Cᵒᵖ ⥤ Type w) {ι : Type x} {T : C}
    (family : ι → C) (map : ∀ i, family i ⟶ T) :
    IsSheafForFamily F family map ↔
      Presieve.IsSheafFor F (Presieve.ofArrows family map) := sorry

end CategoryTheory.Presheaf
