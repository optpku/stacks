module

public import Mathlib.RingTheory.AdicCompletion.Functoriality

@[expose] public section

universe u

namespace AdicCompletion

/-- The principal ideal generated by the natural-number coefficient `p`. -/
noncomputable abbrev principalIdeal (R : Type u) [CommRing R] (p : ℕ) : Ideal R :=
  Ideal.span ({(p : R)} : Set R)

section CompletionMaps

variable (R S : Type u) [CommRing R] [CommRing S] (p : ℕ)
variable {U V : Type u} [AddCommGroup U] [Module R U] [AddCommGroup V] [Module S V]

/-- An additive map extends to principal p-adic completions by its quotient maps. -/
noncomputable def completeAddMap (map : U →+ V) :
    AdicCompletion (principalIdeal R p) U →+
      AdicCompletion (principalIdeal S p) V where
  toFun element :=
    ⟨fun degree ↦ Quotient.map map (fun _ _ _ ↦ sorry) (element.val degree), sorry⟩
  map_zero' := sorry
  map_add' := sorry

/-- The completed additive map agrees with the original map on uncompleted elements. -/
theorem completeAddMap_of (map : U →+ V) (element : U) :
    completeAddMap R S p map (AdicCompletion.of (principalIdeal R p) U element) =
      AdicCompletion.of (principalIdeal S p) V (map element) := sorry

variable {W : Type u} [AddCommGroup W] [Module R W]

/-- An additive map into a completed module extends using evaluation at each finite quotient. -/
noncomputable def extendCompleteAddMap (map : U →+ AdicCompletion (principalIdeal R p) W) :
    AdicCompletion (principalIdeal R p) U →+
      AdicCompletion (principalIdeal R p) W where
  toFun element :=
    ⟨fun degree ↦ Quotient.lift (fun value ↦ (map value).val degree)
      (fun _ _ _ ↦ sorry) (element.val degree), sorry⟩
  map_zero' := sorry
  map_add' := sorry

/-- Extending a completed-valued additive map recovers its values on the original module. -/
theorem extendCompleteAddMap_of
    (map : U →+ AdicCompletion (principalIdeal R p) W) (element : U) :
    extendCompleteAddMap R p map (AdicCompletion.of (principalIdeal R p) U element) =
      map element := sorry

end CompletionMaps

section CompletedWedge

variable (B : Type u) [CommRing B] (p : ℕ)
variable {U V W : Type u} [AddCommGroup U] [Module B U]
variable [AddCommGroup V] [Module B V] [AddCommGroup W] [Module B W]

/-- Complete a bilinear map by applying it to representatives at each finite p-power quotient. -/
noncomputable def completeBilinear (map : U →ₗ[B] V →ₗ[B] W) :
    AdicCompletion (principalIdeal B p) U →ₗ[AdicCompletion (principalIdeal B p) B]
      AdicCompletion (principalIdeal B p) V →ₗ[AdicCompletion (principalIdeal B p) B]
        AdicCompletion (principalIdeal B p) W where
  toFun first :=
    { toFun := fun second ↦
        ⟨fun degree ↦ Quotient.map₂ (fun left right ↦ map left right)
          (fun _ _ _ _ _ _ ↦ sorry) (first.val degree) (second.val degree), sorry⟩
      map_add' := sorry
      map_smul' := sorry }
  map_add' := sorry
  map_smul' := sorry

/-- Completed bilinear maps retain their original formula on pairs of uncompleted elements. -/
theorem completeBilinear_of (map : U →ₗ[B] V →ₗ[B] W) (first : U) (second : V) :
    completeBilinear B p map
        (AdicCompletion.of (principalIdeal B p) U first)
        (AdicCompletion.of (principalIdeal B p) V second) =
      AdicCompletion.of (principalIdeal B p) W (map first second) := sorry

end CompletedWedge

end AdicCompletion

end
