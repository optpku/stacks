module

public import ReasLib.AlgebraicGeometry.PuncturedAffineSpace.QuasiCompact
import StacksCheckRecall

@[expose] public section

open AlgebraicGeometry

universe u

section Field

variable (k : Type u) [Field k]

/- Example 26.19.6: in `Spec(k[x₁, x₂, ...])`, the ideal generated by the
coordinates is the maximal ideal of the origin, and its singleton complement is not
quasi-compact. -/
@[stacks 01K8] #check PuncturedAffineSpace.coordinateSpectrum (ULift.{u} ℕ) k
@[stacks 01K8] #check PuncturedAffineSpace.originIdeal_eq_span (ULift.{u} ℕ) k
@[stacks 01K8] #check PuncturedAffineSpace.originIdeal_isMaximal (ULift.{u} ℕ) k
@[stacks 01K8] #check
  PuncturedAffineSpace.coordinatePuncturedOpen.coe_eq_compl_coordinateOrigin
    (ULift.{u} ℕ) k
@[stacks 01K8] #check PuncturedAffineSpace.affineSpace (ULift.{u} ℕ) k
@[stacks 01K8] #check PuncturedAffineSpace.coordinateModelIso (ULift.{u} ℕ) k
@[stacks 01K8] #check PuncturedAffineSpace.coordinateModelIso.preimage_puncturedOpen
  (ULift.{u} ℕ) k
@[stacks 01K8] #check PuncturedAffineSpace.puncturedOpen (ULift.{u} ℕ) k
@[stacks 01K8] #check PuncturedAffineSpace.puncturedOpen.coe_eq_compl_origin
  (ULift.{u} ℕ) k
@[stacks 01K8] #check PuncturedAffineSpace.puncturedOpen_not_isCompact
  (ULift.{u} ℕ) k
@[stacks 01K8] #check PuncturedAffineSpace.puncturedOpen_not_quasiCompact
  (ULift.{u} ℕ) k

end Field

section Generalization

variable (k : Type u) [CommRing k] [Nontrivial k]

/- For a general nontrivial base ring, the same construction removes the whole zero-section
image and remains non-quasi-compact. -/
#check PuncturedAffineSpace.puncturedOpen.coe_eq_compl_range_zeroSection (ULift.{u} ℕ) k
#check PuncturedAffineSpace.puncturedOpen_not_isCompact (ULift.{u} ℕ) k
#check PuncturedAffineSpace.puncturedOpen_not_quasiCompact (ULift.{u} ℕ) k

end Generalization
