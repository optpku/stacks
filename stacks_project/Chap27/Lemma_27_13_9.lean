module

public import ReasLib.AlgebraicGeometry.Scheme.Module.GeneratingSections.InvertibleKernel
import StacksCheckRecall

@[expose] public section

open AlgebraicGeometry
open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.MonoidalCategory

universe u

/- Lemma 27.13.9: if an invertible module on a scheme is generated by a finite family of
global sections, then tensoring the kernel of the evaluation morphism with that module gives
a globally generated module. -/
@[stacks 0B3B] #check
  (AlgebraicGeometry.Scheme.Modules.kernelTensorSectionFamilyHom_isGloballyGenerated :
    ∀ {X : Scheme.{u}} (L : X.Modules)
      [CategoryTheory.MonoidalCategory.isInvertibleObject L]
      (n : ℕ) (s : Fin (n + 1) → L.sections)
      (hgen : Epi
        (L.freeHomEquiv.symm (fun i : ULift.{u} (Fin (n + 1)) ↦ s i.down))),
      SheafOfModules.IsGloballyGenerated
        (tensorObj
          (kernel (L.freeHomEquiv.symm
            (fun i : ULift.{u} (Fin (n + 1)) ↦ s i.down))) L : X.Modules))
