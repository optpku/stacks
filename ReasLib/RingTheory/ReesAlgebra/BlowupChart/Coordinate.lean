module

public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.ReesAlgebra.BlowupChart.Presentation
public import ReasLib.RingTheory.MvPolynomial.Coordinate

/-!
# Coordinate presentation of the first affine blowup chart

This leaf specializes the relation-level presentation of an affine blowup chart to
the coordinate ideal of a polynomial algebra.  The relation, quotient, and
evaluation map are inherited from `AffineBlowupChart.Presentation`; the only
coordinate-specific assertion is the injectivity of the resulting map.
-/

@[expose] public section

noncomputable section

universe u

open MvPolynomial
open scoped AffineBlowupChart

namespace AffineBlowupChart.Presentation.Coordinate

variable {R : Type u} [CommRing R]

/-! ## Coordinate data -/

/-- Source-facing alias for the neutral polynomial base ring `R[t₀, ..., tₙ₋₁]`. -/
@[stacks 0G8R "coordinate affine blowup base polynomial ring"]
abbrev base (n : ℕ) := MvPolynomial.Coordinate.base (R := R) n

/-- Source-facing alias for the neutral ideal generated by the polynomial variables. -/
@[stacks 0G8R "coordinate affine blowup center ideal"]
abbrev center (n : ℕ) := MvPolynomial.Coordinate.center (R := R) n

/-- The distinguished first coordinate, packaged as an element of the coordinate ideal. -/
@[stacks 0G8R "coordinate affine blowup distinguished parameter"]
def parameter (n : ℕ) [NeZero n] : center (R := R) n :=
  MvPolynomial.Coordinate.generator (R := R) n 0

/-- The distinguished coordinate has underlying polynomial `X 0`. -/
@[stacks 0G8R "coordinate affine blowup parameter coercion", simp]
theorem coe_parameter (n : ℕ) [NeZero n] :
    (parameter (R := R) n : base (R := R) n) = X (0 : Fin n) := sorry

/-- The successor coordinate appearing in the relation for a tail variable. -/
@[stacks 0G8R "coordinate affine blowup successor index"]
abbrev index (n : ℕ) (i : Fin (n - 1)) : Fin n :=
  MvPolynomial.Coordinate.tailIndex n i

/-- The successor index has the expected underlying natural number. -/
@[stacks 0G8R "coordinate affine blowup successor index value", simp]
theorem index_val (n : ℕ) (i : Fin (n - 1)) :
    (index n i).1 = i.1 + 1 := sorry

/-- A tail index is different from the distinguished first coordinate. -/
@[stacks 0G8R "coordinate affine blowup successor nonzero"]
theorem index_ne_zero (n : ℕ) [NeZero n] (i : Fin (n - 1)) :
    index n i ≠ 0 := sorry

/-- The successor indexing of tail variables is injective. -/
@[stacks 0G8R "coordinate affine blowup successor injectivity"]
theorem index_injective (n : ℕ) : Function.Injective (index n) := sorry

/-- The numerator `tᵢ₊₁` of the `i`-th coordinate fraction. -/
@[stacks 0G8R "coordinate affine blowup numerator"]
def numerator (n : ℕ) (i : Fin (n - 1)) : center (R := R) n :=
  MvPolynomial.Coordinate.generator (R := R) n (index n i)

/-- A tail numerator has underlying polynomial `X (index n i)`. -/
@[stacks 0G8R "coordinate affine blowup numerator coercion", simp]
theorem coe_numerator (n : ℕ) (i : Fin (n - 1)) :
    (numerator (R := R) n i : base (R := R) n) = X (index n i) := sorry

/-- The polynomial quotient by the relations `t₀ X i = tᵢ₊₁`. -/
@[stacks 0G8R "coordinate affine blowup quotient"]
abbrev quotient (n : ℕ) [NeZero n] :=
  AffineBlowupChart.Presentation.Quotient (parameter (R := R) n)
    (numerator (R := R) n)

/-- The first affine blowup chart of the coordinate ideal. -/
@[stacks 0G8R "coordinate affine blowup chart"]
abbrev chart (n : ℕ) [NeZero n] :=
  affineBlowupChart (center (R := R) n) (parameter (R := R) n)

/-! ## Canonical map and its coordinate specialization -/

/-- The canonical quotient-to-chart map, inherited from the generic presentation owner. -/
@[stacks 0G8R "coordinate affine blowup presentation map"]
noncomputable abbrev map (n : ℕ) [NeZero n] :
    quotient (R := R) n →ₐ[base (R := R) n] chart (R := R) n :=
  AffineBlowupChart.Presentation.map (parameter (R := R) n)
    (numerator (R := R) n)

/-- The coordinate presentation map is surjective because the variables generate the center. -/
@[stacks 0G8R "coordinate affine blowup presentation surjectivity"]
theorem map_surjective (n : ℕ) [NeZero n] : Function.Surjective (map (R := R) n) := sorry

/-- The coordinate presentation map is injective. -/
@[stacks 0G8R "coordinate affine blowup presentation injectivity"]
theorem map_injective (n : ℕ) [NeZero n] : Function.Injective (map (R := R) n) := sorry

/-- The coordinate presentation map is bijective. -/
@[stacks 0G8R "coordinate affine blowup presentation bijectivity"]
theorem map_bijective (n : ℕ) [NeZero n] : Function.Bijective (map (R := R) n) := sorry

/-- Example 10.70.5 (0G8R): the coordinate quotient is canonically isomorphic to the affine
blowup chart. -/
@[stacks 0G8R "coordinate affine blowup quotient equivalence"]
noncomputable def equiv (n : ℕ) [NeZero n] :
    quotient (R := R) n ≃ₐ[base (R := R) n] chart (R := R) n :=
  AlgEquiv.ofBijective (map (R := R) n) (map_bijective (R := R) n)

/-- Example 10.70.5 (0G8R): the coordinate equivalence evaluates the `i`-th quotient variable at
the fraction `tᵢ₊₁ / t₀`. -/
@[stacks 0G8R "coordinate affine blowup variable evaluation", simp]
theorem equiv_apply_variable (n : ℕ) [NeZero n] (i : Fin (n - 1)) :
    equiv (R := R) n
        (Ideal.Quotient.mk
          (AffineBlowupChart.Presentation.relationIdeal
            (parameter (R := R) n) (numerator (R := R) n))
          (X i : MvPolynomial (Fin (n - 1)) (base (R := R) n))) =
      AffineBlowupChart.basicFraction (center (R := R) n) (parameter (R := R) n)
        (numerator (R := R) n i) := sorry

/-! ## Successor-indexed coordinate chart -/

namespace Succ

/-- The successor-indexed polynomial base ring, with one head coordinate and `n` tail
coordinates. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup base polynomial ring"]
abbrev base (n : ℕ) := MvPolynomial.Coordinate.Succ.base (R := R) n

/-- The coordinate ideal in the successor-indexed polynomial base ring. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup center ideal"]
abbrev center (n : ℕ) := MvPolynomial.Coordinate.Succ.center (R := R) n

/-- The distinguished chart parameter is the neutral head coordinate generator. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup distinguished parameter"]
abbrev parameter (n : ℕ) : center (R := R) n :=
  MvPolynomial.Coordinate.Succ.headGenerator (R := R) n

/-- The successor-indexed distinguished parameter has underlying polynomial `X 0`. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup parameter coercion", simp]
theorem coe_parameter (n : ℕ) :
    (parameter (R := R) n : base (R := R) n) = X (0 : Fin (n + 1)) := sorry

/-- The tail coordinate index in a polynomial ring with a distinguished head coordinate. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup tail index"]
abbrev index (n : ℕ) (i : Fin n) : Fin (n + 1) :=
  MvPolynomial.Coordinate.Succ.tailIndex n i

/-- A successor-indexed tail coordinate has value `i + 1`. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup tail index value", simp]
theorem index_val (n : ℕ) (i : Fin n) : (index n i).1 = i.1 + 1 := sorry

/-- A successor-indexed tail coordinate is different from the distinguished parameter index. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup tail index nonzero"]
theorem index_ne_zero (n : ℕ) (i : Fin n) : index n i ≠ 0 := sorry

/-- The successor-indexed tail coordinate embedding is injective. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup tail index injectivity"]
theorem index_injective (n : ℕ) : Function.Injective (index n) := sorry

/-- The chart numerators are the neutral tail coordinate generators. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup numerators"]
abbrev numerator (n : ℕ) : Fin n → center (R := R) n :=
  MvPolynomial.Coordinate.Succ.tailGenerator (R := R) n

/-- A successor-indexed chart numerator has its expected coordinate polynomial. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup numerator coercion", simp]
theorem coe_numerator (n : ℕ) (i : Fin n) :
    (numerator (R := R) n i : base (R := R) n) = X (index n i) := sorry

/-- The polynomial quotient by the relations between the head parameter and tail numerators. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup quotient"]
abbrev quotient (n : ℕ) :=
  AffineBlowupChart.Presentation.Quotient (parameter (R := R) n)
    (numerator (R := R) n)

/-- The affine blowup chart away from the successor-indexed head parameter. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup chart"]
abbrev chart (n : ℕ) :=
  affineBlowupChart (center (R := R) n) (parameter (R := R) n)

/-- The canonical quotient-to-chart map for successor-indexed coordinates. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup presentation map"]
noncomputable abbrev map (n : ℕ) :
    quotient (R := R) n →ₐ[base (R := R) n] chart (R := R) n :=
  AffineBlowupChart.Presentation.map (parameter (R := R) n)
    (numerator (R := R) n)

/-- The successor-indexed coordinate presentation map is surjective. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup presentation surjectivity"]
theorem map_surjective (n : ℕ) : Function.Surjective (map (R := R) n) := sorry

/-- The successor-indexed coordinate presentation map is injective. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup presentation injectivity"]
theorem map_injective (n : ℕ) : Function.Injective (map (R := R) n) := sorry

/-- The successor-indexed coordinate presentation map is bijective. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup presentation bijectivity"]
theorem map_bijective (n : ℕ) : Function.Bijective (map (R := R) n) := sorry

/-- Example 10.70.5 (0G8R): the successor-indexed coordinate quotient is canonically
isomorphic to its affine blowup chart. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup quotient equivalence"]
noncomputable def equiv (n : ℕ) :
    quotient (R := R) n ≃ₐ[base (R := R) n] chart (R := R) n :=
  AlgEquiv.ofBijective (map (R := R) n) (map_bijective (R := R) n)

/-- Example 10.70.5 (0G8R): the successor-indexed coordinate equivalence sends the `i`-th
quotient variable to the fraction `tᵢ₊₁ / t₀`. -/
@[stacks 0G8R "successor-indexed coordinate affine blowup variable evaluation", simp]
theorem equiv_apply_variable (n : ℕ) (i : Fin n) :
    equiv (R := R) n
        (Ideal.Quotient.mk
          (AffineBlowupChart.Presentation.relationIdeal
            (parameter (R := R) n) (numerator (R := R) n))
          (X i : MvPolynomial (Fin n) (base (R := R) n))) =
      AffineBlowupChart.basicFraction (center (R := R) n) (parameter (R := R) n)
        (numerator (R := R) n i) := sorry

end Succ

end AffineBlowupChart.Presentation.Coordinate
