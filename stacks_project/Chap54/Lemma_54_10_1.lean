module

import StacksCheckRecall
public import ReasLib.AlgebraicGeometry.Scheme.PointBlowupTower.NonsingularArc

@[expose] public section

open AlgebraicGeometry

universe u

/- Lemma 54.10.1: a locally Noetherian point-blowup tower which preserves residue fields and
whose exceptional divisors are all generated by the image of one initial-stalk element is
realized by compatible lifts of a nonsingular formal arc from a complete discrete valuation
ring. -/
@[stacks 0BG2] #check
  (AlgebraicGeometry.Scheme.PointBlowupTower.exists_nonsingularFormalArc :
    ∀ {X : Scheme.{u}} [IsLocallyNoetherian X]
      (p : closedPoints X)
      (S : AlgebraicGeometry.Scheme.PointBlowupTower X p)
      (h_residue : S.PreservesResidueFields)
      (h_generator : S.HasCommonExceptionalGenerator),
      ∃ (R : Type u) (_ : CommRing R) (_ : IsDomain R)
        (_ : IsDiscreteValuationRing R) (_ : IsCompleteLocalRing R)
        (A : AlgebraicGeometry.Scheme.FormalArc X p R)
        (L : S.Lift A.hom (IsLocalRing.closedPoint R)), A.IsNonsingular)
