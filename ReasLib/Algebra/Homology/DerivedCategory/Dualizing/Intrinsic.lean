module

public import ReasLib.Algebra.Homology.DerivedCategory.InjectiveAmplitude
public import Mathlib.Algebra.Homology.DerivedCategory.Linear
public import Mathlib.RingTheory.Noetherian.Defs

@[expose] public section

open CategoryTheory

noncomputable section

universe u

namespace CategoryTheory.DerivedCategory

/-- A complex over a Noetherian commutative ring is dualizing when it has finite
injective dimension and cohomology, scalar endomorphisms are exactly the
endomorphisms generated by the ring action, and all nonzero shifts have no
endomorphisms. -/
def IsDualizing {A : Type u} [CommRing A] [IsNoetherianRing A]
    (K : DerivedCategory (ModuleCat.{u} A)) : Prop :=
  K.HasFiniteInjectiveDimension ∧
    (∀ i : ℤ,
      Module.Finite A ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj K)) ∧
    Function.Bijective (fun scalar : A => scalar • 𝟙 K) ∧
    (∀ degree : ℤ, degree ≠ 0 → Subsingleton (K ⟶ K⟦degree⟧))

end CategoryTheory.DerivedCategory
