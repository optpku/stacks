module

public import stacks_project.Chap75.Lemma_75_15_6_Generation
import StacksCheckRecall

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace
open AlgebraicGeometry.AlgebraicSpace

universe u

/- Lemma 75.15.6: if `X` is a quasi-compact and quasi-separated algebraic space over a
scheme `S` and `T ⊆ |X|` is closed with `|X| \ T` quasi-compact, then `D_QCoh,T(𝒪_X)`
is generated by a single perfect object. -/
@[stacks 0AEC]
#check
  (AlgebraicGeometry.AlgebraicSpace.DerivedQCoh.SupportedOn.exists_isPerfect_isWeakGenerator :
    ∀ {S : Scheme.{u}} {X : AlgebraicSpace S}
      [IsQuasiCompact X] [IsAbsolutelyQuasiSeparated X]
      (T : Closeds (Points X)),
      QuasiCompact (OpenSubspace.ofOpensι T.compl) →
        ∃ P : AlgebraicGeometry.AlgebraicSpace.DerivedQCoh.SupportedOn X (T : Set (Points X)),
          ModuleDerived.IsPerfect P.obj ∧ CategoryTheory.IsWeakGenerator P)
