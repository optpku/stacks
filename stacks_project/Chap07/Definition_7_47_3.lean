module

public import ReasLib.CategoryTheory.Sites.Sieve
import StacksCheckRecall

@[expose] public section

universe u v w

open CategoryTheory

variable {C : Type u} [Category.{v} C] {U : C} {I : Type w}

#check (CategoryTheory.Sieve.ofArrows :
  (Y : I → C) → (∀ i, Y i ⟶ U) → CategoryTheory.Sieve U)

/- Definition 7.47.3: in a category C, given a family of morphisms
`{f_i : U_i ⟶ U}_{i ∈ I}` with target U, the unique smallest sieve on U
containing those morphisms (Lemma 7.47.2 (4)) is the sieve on U generated by
the morphisms f_i. The canonical construction `Sieve.ofArrows` is named by
this leastness property. -/
@[stacks 00Z1] #check (CategoryTheory.Sieve.ofArrows_isLeast :
  ∀ (Y : I → C) (f : ∀ i, Y i ⟶ U),
    IsLeast {S : CategoryTheory.Sieve U | ∀ i, S (f i)}
      (CategoryTheory.Sieve.ofArrows Y f))
