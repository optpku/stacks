module

public import ReasLib.AlgebraicTopology.SimplicialObject.HomotopyCategory
public import ReasLib.CategoryTheory.Sites.Hypercovering.PresheafTarget.Category
public import ReasLib.CategoryTheory.Sites.Hypercovering.PresheafTarget.Terminal
import Mathlib.Tactic.CrossRefAttribute

/-!
# Refinements of presheaf-target hypercoverings

Augmentation-preserving maps are identified up to zigzag simplicial homotopy.  Reversing the
resulting homotopy category gives the refinement category used by hypercovering Čech cohomology.
-/

@[expose] public section

noncomputable section

universe w v u

namespace CategoryTheory.HypercoveringOf

variable {C : Type u} [Category.{v} C]
variable {J : GrothendieckTopology C}
variable {𝒢 : Cᵒᵖ ⥤ Type (max w v)}

/-- The hom-set relation generated by simplicial homotopy of augmentation-preserving maps. -/
def homotopyRel : HomRel (HypercoveringOf J 𝒢) :=
  fun _ _ f g => SimplicialObject.Homotopic (Hom.toSimplicial f) (Hom.toSimplicial g)

/-- Simplicial homotopy of presheaf-target hypercovering maps is compatible with identities and
composition. -/
instance homotopyRelCongruence : Congruence (homotopyRel (J := J) (𝒢 := 𝒢)) := sorry

/-- The category of hypercoverings of `𝒢` with augmentation-preserving maps taken up to zigzag
simplicial homotopy. -/
def HomotopyCategory (J : GrothendieckTopology C)
    (𝒢 : Cᵒᵖ ⥤ Type (max w v)) :=
  CategoryTheory.Quotient (homotopyRel (J := J) (𝒢 := 𝒢))

/-- The homotopy quotient inherits its category structure from `CategoryTheory.Quotient`. -/
instance homotopyCategoryInstCategory : Category (HomotopyCategory J 𝒢) :=
  inferInstanceAs <| Category
    (CategoryTheory.Quotient (homotopyRel (J := J) (𝒢 := 𝒢)))

namespace HomotopyCategory

/-- The quotient functor from presheaf-target hypercoverings to their homotopy category. -/
def quotient : HypercoveringOf J 𝒢 ⥤ HomotopyCategory J 𝒢 :=
  CategoryTheory.Quotient.functor (homotopyRel (J := J) (𝒢 := 𝒢))

/-- Two augmentation-preserving maps have the same homotopy-class image exactly when their
underlying simplicial maps are homotopic. -/
theorem quotient_map_eq_iff {K L : HypercoveringOf J 𝒢} (f g : K ⟶ L) :
    quotient.map f = quotient.map g ↔
      SimplicialObject.Homotopic (Hom.toSimplicial f) (Hom.toSimplicial g) := sorry

/-- Every morphism in the homotopy category is represented by an augmentation-preserving map. -/
instance quotientFull : (quotient (J := J) (𝒢 := 𝒢)).Full := sorry

/-- Every object of the homotopy category is represented by a presheaf-target hypercovering. -/
instance quotientEssSurj : (quotient (J := J) (𝒢 := 𝒢)).EssSurj := sorry

end HomotopyCategory

/-- The opposite category of strict augmentation-preserving hypercovering maps. -/
abbrev RawRefinementCategory (J : GrothendieckTopology C)
    (𝒢 : Cᵒᵖ ⥤ Type (max w v)) :=
  (HypercoveringOf J 𝒢)ᵒᵖ

/-- Proposition 25.10.2 (09VZ): the refinement index category of hypercoverings of a fixed
presheaf, with morphisms taken up to simplicial homotopy. -/
@[stacks 09VZ "presheaf-target hypercovering refinement category"]
abbrev RefinementCategory (J : GrothendieckTopology C)
    (𝒢 : Cᵒᵖ ⥤ Type (max w v)) :=
  (HomotopyCategory J 𝒢)ᵒᵖ

/-- The quotient functor from strict refinements to homotopy classes of refinements. -/
abbrev refinementQuotient :
    RawRefinementCategory J 𝒢 ⥤ RefinementCategory J 𝒢 :=
  (HomotopyCategory.quotient (J := J) (𝒢 := 𝒢)).op

/-- A hypercovering regarded as a stage of the refinement category. -/
abbrev refinementObject (K : HypercoveringOf J 𝒢) : RefinementCategory J 𝒢 :=
  Opposite.op (HomotopyCategory.quotient.obj K)

/-- An augmentation-preserving map `M ⟶ K`, regarded as a refinement arrow from the stage `K`
to the stage `M`. -/
abbrev refinementMap {M K : HypercoveringOf J 𝒢} (f : M ⟶ K) :
    refinementObject K ⟶ refinementObject M :=
  refinementQuotient.map f.op

namespace Terminal

/-- The refinement category of site-level hypercoverings. -/
abbrev RefinementCategory (J : GrothendieckTopology C) :=
  HypercoveringOf.RefinementCategory J (Presheaf.terminal C)

/-- Site-level hypercoverings form a filtered refinement category when the site has fibre
products and binary products.  This is the categorical common-refinement interface used by
Čech representatives. -/
instance refinementCategoryIsFiltered
    [Limits.HasPullbacks C] [Limits.HasBinaryProducts C] :
    IsFiltered (Terminal.RefinementCategory J) := sorry

end Terminal

end CategoryTheory.HypercoveringOf
