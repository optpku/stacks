module

public import ReasLib.LinearAlgebra.Matrix.ScalarInverse
public import Mathlib.LinearAlgebra.Matrix.ToLin
public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Ideal.Operations

@[expose] public section

universe u v w x

namespace LinearMap

/-- Between modules with finite bases of the same rank, a one-sided scalar inverse
becomes two-sided after any prescribed rescaling exponent greater than the rank times
the original exponent. -/
theorem scaledV_comp
    {R : Type u} [CommRing R]
    {M : Type v} {M' : Type w}
    [AddCommGroup M] [Module R M] [AddCommGroup M'] [Module R M']
    (p i r N : ℕ) (e : Module.Basis (Fin r) R M) (e' : Module.Basis (Fin r) R M')
    (f : M →ₗ[R] M') (v : M' →ₗ[R] M)
    (hfv : v.comp f = ((p : R) ^ i) • (LinearMap.id : M →ₗ[R] M))
    (hN : r * i < N) :
    (((p : R) ^ N) • v).comp f =
        ((p : R) ^ (N + i)) • (LinearMap.id : M →ₗ[R] M) ∧
      f.comp (((p : R) ^ N) • v) =
        ((p : R) ^ (N + i)) • (LinearMap.id : M' →ₗ[R] M') := sorry

/-- A linear map between modules with finite bases of the same rank admitting a
one-sided scalar inverse has kernel and cokernel annihilated by a common power
of the principal ideal generated by the scalar. -/
theorem exists_commonPower_annihilating_kernel_cokernel
    {R : Type u} [CommRing R]
    {M : Type v} {M' : Type w}
    [AddCommGroup M] [Module R M] [AddCommGroup M'] [Module R M']
    (p i r : ℕ) (e : Module.Basis (Fin r) R M) (e' : Module.Basis (Fin r) R M')
    (f : M →ₗ[R] M') (v : M' →ₗ[R] M)
    (hfv : v.comp f = ((p : R) ^ i) • (LinearMap.id : M →ₗ[R] M)) :
    ∃ j : ℕ,
      (Ideal.span ({(p : R)} : Set R)) ^ j ≤ Module.annihilator R f.ker ∧
        (Ideal.span ({(p : R)} : Set R)) ^ j ≤
          Module.annihilator R (M' ⧸ f.range) := sorry

/-- For a family of equal-rank based module pairs with bounded ranks and a common
one-sided scalar-inverse exponent, every rescaling exponent above the rank bound
times that exponent gives the same two-sided identities throughout the family. -/
theorem scaledV_comp_of_boundedRank
    {T : Type x} {R : T → Type u} [∀ t, CommRing (R t)]
    {M : T → Type v} {M' : T → Type w}
    [∀ t, AddCommGroup (M t)] [∀ t, Module (R t) (M t)]
    [∀ t, AddCommGroup (M' t)] [∀ t, Module (R t) (M' t)]
    (p i bound N : ℕ) (r : T → ℕ)
    (e : ∀ t, Module.Basis (Fin (r t)) (R t) (M t))
    (e' : ∀ t, Module.Basis (Fin (r t)) (R t) (M' t))
    (f : ∀ t, M t →ₗ[R t] M' t) (v : ∀ t, M' t →ₗ[R t] M t)
    (hr : ∀ t, r t ≤ bound)
    (hfv : ∀ t, (v t).comp (f t) = ((p : R t) ^ i) • (LinearMap.id : M t →ₗ[R t] M t))
    (hN : bound * i < N) :
    ∀ t, (((p : R t) ^ N) • v t).comp (f t) =
          ((p : R t) ^ (N + i)) • (LinearMap.id : M t →ₗ[R t] M t) ∧
      (f t).comp (((p : R t) ^ N) • v t) =
        ((p : R t) ^ (N + i)) • (LinearMap.id : M' t →ₗ[R t] M' t) := sorry

/-- For a bounded-rank family of equal-rank based module pairs admitting one-sided
scalar inverses with a common exponent, one power of the scalar's principal ideal
annihilates every kernel and cokernel, even when the coefficient rings vary. -/
theorem exists_commonPower_annihilating_kernel_cokernel_of_boundedRank
    {T : Type x} {R : T → Type u} [∀ t, CommRing (R t)]
    {M : T → Type v} {M' : T → Type w}
    [∀ t, AddCommGroup (M t)] [∀ t, Module (R t) (M t)]
    [∀ t, AddCommGroup (M' t)] [∀ t, Module (R t) (M' t)]
    (p i bound : ℕ) (r : T → ℕ)
    (e : ∀ t, Module.Basis (Fin (r t)) (R t) (M t))
    (e' : ∀ t, Module.Basis (Fin (r t)) (R t) (M' t))
    (f : ∀ t, M t →ₗ[R t] M' t) (v : ∀ t, M' t →ₗ[R t] M t)
    (hr : ∀ t, r t ≤ bound)
    (hfv : ∀ t, (v t).comp (f t) = ((p : R t) ^ i) • (LinearMap.id : M t →ₗ[R t] M t)) :
    ∃ j : ℕ, ∀ t,
      (Ideal.span ({(p : R t)} : Set (R t))) ^ j ≤ Module.annihilator (R t) (f t).ker ∧
        (Ideal.span ({(p : R t)} : Set (R t))) ^ j ≤
          Module.annihilator (R t) (M' t ⧸ (f t).range) := sorry

end LinearMap
