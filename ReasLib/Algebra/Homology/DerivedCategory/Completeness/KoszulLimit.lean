module

public import ReasLib.Algebra.Homology.DerivedCategory.Completeness
public import ReasLib.Algebra.Homology.DerivedCategory.ModuleCat.DerivedAction
public import ReasLib.Algebra.Homology.Koszul.PowerTower
public import ReasLib.CategoryTheory.DerivedCategory.Limit.MilnorTriangle
import Mathlib.Tactic.CrossRefAttribute

/-!
# Derived completion from powered Koszul limits

For a finite family `f : Fin r → A` and `K : D(A)`, this file owns the powered-Koszul
derived tensor tower, its canonical maps from `K`, and the data-bearing comparison with a chosen
derived limit.  The comparison is the canonical `IsDerivedLimit.Comparison`, so its derived-limit
presentation and all stage equations remain explicit data.

@stack 091Z
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits ComplexShape Opposite

universe u

namespace CategoryTheory.DerivedCategory.KoszulLimit

variable {A : Type u} [CommRing A] {r : ℕ}

local notation "DMod" => DerivedCategory (ModuleCat A)

/-- The powered-Koszul derived tensor tower
`n ↦ K_n^• ⊗ᴸ_A K` attached to a finite family `f`. -/
@[stacks 091Z "powered Koszul derived-completion tower"]
abbrev tensorSystem (f : Fin r → A) (K : DMod) : SequentialInverseSystem DMod :=
  KoszulComplex.PowerTower.derivedSystem f ⋙ DerivedTensor.Right.functor K

/-- The canonical map from the regular module in degree zero to the `n`th powered Koszul
derived stage. -/
@[stacks 091Z "unit map to a powered Koszul derived stage"]
abbrev unitToDerivedStage (f : Fin r → A) (n : ℕ) :
    ModuleCat.single0 (ModuleCat.of A A) ⟶
      (KoszulComplex.PowerTower.derivedSystem f).obj (op n) :=
  ((DerivedCategory.singleFunctorIsoCompQ (ModuleCat A) (0 : ℤ)).app
      (ModuleCat.of A A)).hom ≫
    DerivedCategory.Q.map
      ((HomologicalComplex.extendSingleIso embeddingDownNat (ModuleCat.of A A)
          (0 : ℕ) (0 : ℤ) rfl).inv ≫
        KoszulComplex.PowerTower.Fin.unitComponent f n)

/-- The canonical map from `K` to the `n`th stage
`K_n^• ⊗ᴸ_A K` of the powered-Koszul derived tensor tower. -/
@[stacks 091Z "powered Koszul derived-completion stage map"]
noncomputable def toStage (f : Fin r → A) (K : DMod) (n : ℕ) :
    K ⟶ (tensorSystem f K).obj (op n) :=
  (ModuleCat.DerivedAction.fixedRightActionIso K).inv ≫
    (DerivedTensor.Right.functor K).map (unitToDerivedStage f n)

/-- The canonical maps from `K` to the powered-Koszul tensor stages are compatible with the
successor transitions. -/
@[stacks 091Z "compatibility of powered Koszul derived-completion stage maps"]
theorem toStage_comp_stepMap (f : Fin r → A) (K : DMod) (n : ℕ) :
    toStage f K (n + 1) ≫ (tensorSystem f K).stepMap n = toStage f K n := sorry

/-- A data-bearing comparison from `K` to a chosen derived limit of its powered-Koszul tensor
tower, normalized by the canonical maps to every stage. -/
@[stacks 091Z "powered Koszul derived-completion comparison"]
abbrev Comparison (f : Fin r → A) (K L : DMod) (c : K ⟶ L) :=
  IsDerivedLimit.Comparison (tensorSystem f K) c (toStage f K)

namespace Comparison

/-- The chosen derived-limit presentation carried by a powered-Koszul completion comparison. -/
@[stacks 091Z "derived-limit presentation of a powered Koszul comparison"]
noncomputable abbrev isDerivedLimit
    {f : Fin r → A} {K L : DMod} {c : K ⟶ L} (hc : Comparison f K L c) :
    IsDerivedLimit (tensorSystem f K) L :=
  hc.derivedLimit

/-- A powered-Koszul completion comparison recovers the canonical map to every tower stage. -/
@[stacks 091Z "stage formula for a powered Koszul comparison"]
theorem comp_stageProjection
    {f : Fin r → A} {K L : DMod} {c : K ⟶ L}
    (hc : Comparison f K L c) (n : ℕ) :
    c ≫ hc.isDerivedLimit.stageProjection n = toStage f K n := sorry

/-- The target of a powered-Koszul derived-completion comparison is derived complete with
respect to the ideal generated by the chosen family. -/
theorem target_isDerivedComplete
    {f : Fin r → A} {K L : DMod} {c : K ⟶ L} (hc : Comparison f K L c) :
    L.IsDerivedCompleteWithRespectTo (Ideal.span (Set.range f)) := sorry

end Comparison

/-- Lemma 15.92.17 (Stacks `091Z`): for a normalized comparison from `K` to a derived limit of
the powered-Koszul tensor tower, `K` is derived complete with respect to the ideal generated by
`f` if and only if the comparison is an isomorphism. -/
@[stacks 091Z]
theorem isDerivedComplete_iff_isIso
    (f : Fin r → A) {K L : DMod} (c : K ⟶ L) (hc : Comparison f K L c) :
    K.IsDerivedCompleteWithRespectTo (Ideal.span (Set.range f)) ↔ IsIso c := sorry

end CategoryTheory.DerivedCategory.KoszulLimit
