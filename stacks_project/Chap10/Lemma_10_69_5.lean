module

public import ReasLib.RingTheory.Sequence.QuasiRegular.Quotient
import StacksCheckRecall

@[expose] public section

/-! @stack 061R -/

universe u v

namespace RingTheory.Sequence.IsQuasiRegular

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]

variable {rs : List R} (hqr : IsQuasiRegular M rs) (i : ℕ)

/- Lemma 10.69.5: after quotienting a module by the submodule generated by the first `i`
elements of a quasi-regular sequence, the remaining sequence is quasi-regular. -/
@[stacks 061R]
#check (hqr.tail_quotient i :
  IsQuasiRegular
    (M ⧸ (Ideal.ofList (rs.take i) • (⊤ : Submodule R M)))
    ((rs.drop i).map (Ideal.Quotient.mk (Ideal.ofList (rs.take i)))))

#check @quotient_of_append
#check @head_quotient

end RingTheory.Sequence.IsQuasiRegular
