/-!
# An open immersion which is not a localization

@stack 00F1

This file names the two rings, the presentation map, its relation, the three
generators of the punctured ring, and the induced map on spectra from the
source example.  Polynomial division, chart gluing, and unit calculations are
proof-stage material and are not exposed as parallel Chapter-level APIs.
-/

@[expose] public section

noncomputable section

open Polynomial PrimeSpectrum Topology
open scoped Polynomial.Bivariate

namespace Algebra.Example_10_27_4

/-- The ring `R = {f ∈ ℚ[z] | f(0) = f(1)}`. -/
abbrev BaseRing : Type := Polynomial.equalEndpoint ℚ

/-- Constant polynomials belong to the equal-endpoint ring. -/
theorem constant_mem (q : ℚ) : Polynomial.C q ∈ Polynomial.equalEndpoint ℚ := sorry

/-- The element `z^2-z` of the equal-endpoint ring. -/
theorem quadratic_mem : (X ^ 2 - X : Polynomial ℚ) ∈ Polynomial.equalEndpoint ℚ := sorry

/-- The element `A = z^2-z` used in the presentation. -/
def quadratic : BaseRing := ⟨X ^ 2 - X, quadratic_mem⟩

/-- The element `z^3-z^2` of the equal-endpoint ring. -/
theorem cubic_mem : (X ^ 3 - X ^ 2 : Polynomial ℚ) ∈ Polynomial.equalEndpoint ℚ := sorry

/-- The element `B = z^3-z^2` used in the presentation. -/
def cubic : BaseRing := ⟨X ^ 3 - X ^ 2, cubic_mem⟩

/-- The relation `A^3-B^2+AB` in `ℚ[A,B]`, modeled by `ℚ[X][Y]`. -/
def relation : ℚ[X][Y] := Polynomial.C (X ^ 3) - Y ^ 2 + Polynomial.C X * Y

/-- The presentation map `φ : ℚ[A,B] → R`. -/
def presentation : ℚ[X][Y] →ₐ[ℚ] BaseRing :=
  Polynomial.aevalAeval quadratic cubic

/-- The principal relation ideal of the presentation. -/
def presentationIdeal : Ideal ℚ[X][Y] :=
  Ideal.span ({relation} : Set ℚ[X][Y])

/-- The displayed relation ideal lies in the kernel of `φ`. -/
theorem presentationIdeal_le_ker :
    presentationIdeal ≤ RingHom.ker presentation := sorry

/-- The quotient by the displayed relation. -/
abbrev PresentationRing : Type := ℚ[X][Y] ⧸ presentationIdeal

/-- The canonical map from the displayed quotient to `R`. -/
def quotientMap : PresentationRing →ₐ[ℚ] BaseRing :=
  Ideal.Quotient.liftₐ presentationIdeal presentation presentationIdeal_le_ker

/-- Example 10.27.4 (1): the relation `A^3-B^2+AB` is irreducible. -/
@[stacks 00F1 "(1)"]
theorem relation_irreducible : Irreducible relation := sorry

/-- Example 10.27.4 (2): the presentation map `φ` is surjective. -/
@[stacks 00F1 "(2)"]
theorem presentation_surjective : Function.Surjective presentation := sorry

/-- Example 10.27.4 (3): the kernel of `φ` is generated by the displayed relation. -/
@[stacks 00F1 "(3)"]
theorem presentation_ker : RingHom.ker presentation = presentationIdeal := sorry

/-- Example 10.27.4 (4): the canonical map from
`ℚ[A,B]/(A^3-B^2+AB)` to `R` is bijective. -/
@[stacks 00F1 "(4)"]
theorem quotientMap_bijective : Function.Bijective quotientMap := sorry

/-- Evaluation at `r` on the equal-endpoint ring. -/
def evaluation (r : ℚ) : BaseRing →+* ℚ :=
  (Polynomial.evalRingHom r).comp (Polynomial.equalEndpoint ℚ).val.toRingHom

/-- The point `m_r` of `Spec(R)` given by evaluation at `r`. -/
def evaluationPoint (r : ℚ) : PrimeSpectrum BaseRing :=
  PrimeSpectrum.comap (evaluation r) (IsLocalRing.closedPoint ℚ)

namespace Away

/-- Evaluation at `r` sends the inverted polynomial `z-a` to a unit when `a ≠ r`. -/
theorem evalDenominator_isUnit (a r : ℚ) (h : a ≠ r) :
    IsUnit (Polynomial.evalRingHom r (X - Polynomial.C a)) := sorry

/-- Evaluation at `r` extended to `ℚ[z,1/(z-a)]`. -/
def evalRingHom (a r : ℚ) (h : a ≠ r) :
    Localization.Away (X - Polynomial.C a) →+* ℚ :=
  Localization.awayLift (Polynomial.evalRingHom r) (X - Polynomial.C a)
    (evalDenominator_isUnit a r h)

/-- The extended evaluation map fixes rational constants. -/
theorem evalRingHom_C (a r : ℚ) (h : a ≠ r) (q : ℚ) :
    evalRingHom a r h
        (algebraMap (Polynomial ℚ) (Localization.Away (X - Polynomial.C a))
          (Polynomial.C q)) = q := sorry

/-- Evaluation at `r` as a `ℚ`-algebra homomorphism. -/
def eval (a r : ℚ) (h : a ≠ r) :
    Localization.Away (X - Polynomial.C a) →ₐ[ℚ] ℚ :=
  { evalRingHom a r h with
    commutes' := evalRingHom_C a r h }

/-- The ring `R_a = {f ∈ ℚ[z,1/(z-a)] | f(0)=f(1)}`. -/
def Ring (a : ℚ) (h0 : a ≠ 0) (h1 : a ≠ 1) :
    Subalgebra ℚ (Localization.Away (X - Polynomial.C a)) :=
  AlgHom.equalizer (eval a 0 h0) (eval a 1 h1)

/-- The localization image of an element of `R` belongs to `R_a`. -/
theorem inclusion_mem (a : ℚ) (h0 : a ≠ 0) (h1 : a ≠ 1) (f : BaseRing) :
    algebraMap (Polynomial ℚ) (Localization.Away (X - Polynomial.C a)) f.1 ∈
      Ring a h0 h1 := sorry

/-- The canonical inclusion `R →+* R_a`. -/
def inclusionRingHom (a : ℚ) (h0 : a ≠ 0) (h1 : a ≠ 1) :
    BaseRing →+* Ring a h0 h1 :=
  (((algebraMap (Polynomial ℚ) (Localization.Away (X - Polynomial.C a))).comp
      (Polynomial.equalEndpoint ℚ).val.toRingHom).codRestrict
        (Ring a h0 h1) (inclusion_mem a h0 h1))

/-- The inclusion `R → R_a` respects rational scalars. -/
theorem inclusionRingHom_commutes (a : ℚ) (h0 : a ≠ 0) (h1 : a ≠ 1) (q : ℚ) :
    inclusionRingHom a h0 h1 (algebraMap ℚ BaseRing q) =
      algebraMap ℚ (Ring a h0 h1) q := sorry

/-- The canonical inclusion `R →ₐ[ℚ] R_a`. -/
def inclusion (a : ℚ) (h0 : a ≠ 0) (h1 : a ≠ 1) :
    BaseRing →ₐ[ℚ] Ring a h0 h1 :=
  { inclusionRingHom a h0 h1 with
    commutes' := inclusionRingHom_commutes a h0 h1 }

/-- The canonical algebra structure induced by `R → R_a`. -/
noncomputable instance instAlgebraBaseRing (a : ℚ) (h0 : a ≠ 0) (h1 : a ≠ 1) :
    Algebra BaseRing (Ring a h0 h1) :=
  (inclusion a h0 h1).toRingHom.toAlgebra

/-- The generator `z^2-z` in `R_a`. -/
def quadratic (a : ℚ) (h0 : a ≠ 0) (h1 : a ≠ 1) : Ring a h0 h1 :=
  inclusion a h0 h1 Algebra.Example_10_27_4.quadratic

/-- The element `z^3-z` belongs to `R`. -/
theorem cubicMinusLinear_mem :
    (X ^ 3 - X : Polynomial ℚ) ∈ Polynomial.equalEndpoint ℚ := sorry

/-- The element `z^3-z` in `R`. -/
def cubicMinusLinear : BaseRing := ⟨X ^ 3 - X, cubicMinusLinear_mem⟩

/-- The generator `z^3-z` in `R_a`. -/
def cubic (a : ℚ) (h0 : a ≠ 0) (h1 : a ≠ 1) : Ring a h0 h1 :=
  inclusion a h0 h1 cubicMinusLinear

/-- The ambient element `(a^2-a)/(z-a)+z`. -/
def linearFractionalAmbient (a : ℚ) : Localization.Away (X - Polynomial.C a) :=
  algebraMap (Polynomial ℚ) (Localization.Away (X - Polynomial.C a)) X +
    algebraMap ℚ (Localization.Away (X - Polynomial.C a)) (a ^ 2 - a) *
      IsLocalization.Away.invSelf (X - Polynomial.C a)

/-- The displayed linear-fractional element belongs to `R_a`. -/
theorem linearFractional_mem (a : ℚ) (h0 : a ≠ 0) (h1 : a ≠ 1) :
    linearFractionalAmbient a ∈ Ring a h0 h1 := sorry

/-- The generator `(a^2-a)/(z-a)+z` in `R_a`. -/
def linearFractional (a : ℚ) (h0 : a ≠ 0) (h1 : a ≠ 1) : Ring a h0 h1 :=
  ⟨linearFractionalAmbient a, linearFractional_mem a h0 h1⟩

/-- Example 10.27.4 (5): for `a ∉ {0,1/2,1}`, the three displayed elements
generate `R_a` as a `ℚ`-algebra. -/
@[stacks 00F1 "(5)"]
theorem adjoin_eq_top (a : ℚ) (h0 : a ≠ 0) (hhalf : a ≠ (1 / 2 : ℚ))
    (h1 : a ≠ 1) :
    Algebra.adjoin ℚ
        ({quadratic a h0 h1, cubic a h0 h1, linearFractional a h0 h1} :
          Set (Ring a h0 h1)) = ⊤ := sorry

/-- Example 10.27.4 (6): for `a ∉ {0,1/2,1}`, the ring `R_a` is a finite-type
`ℚ`-algebra. -/
@[stacks 00F1 "(6)"]
theorem finiteType (a : ℚ) (h0 : a ≠ 0) (hhalf : a ≠ (1 / 2 : ℚ))
    (h1 : a ≠ 1) :
    Algebra.FiniteType ℚ (Ring a h0 h1) := sorry

end Away

/-- Example 10.27.4 (7): the map `Spec(R_a) → Spec(R)` is an open embedding. -/
@[stacks 00F1 "(7)"]
theorem spectrumMap_isOpenEmbedding (a : ℚ) (h0 : a ≠ 0)
    (hhalf : a ≠ (1 / 2 : ℚ)) (h1 : a ≠ 1) :
    IsOpenEmbedding
      (PrimeSpectrum.comap (Away.inclusion a h0 h1).toRingHom) := sorry

/-- Example 10.27.4 (8): the image of `Spec(R_a) → Spec(R)` is the complement
of the evaluation point `m_a`. -/
@[stacks 00F1 "(8)"]
theorem spectrumMap_range_eq (a : ℚ) (h0 : a ≠ 0)
    (hhalf : a ≠ (1 / 2 : ℚ)) (h1 : a ≠ 1) :
    Set.range (PrimeSpectrum.comap (Away.inclusion a h0 h1).toRingHom) =
      ({evaluationPoint a} : Set (PrimeSpectrum BaseRing))ᶜ := sorry

/-- Example 10.27.4 (9): the units of `R` are exactly the nonzero rational
constants. -/
@[stacks 00F1 "(9)"]
theorem base_isUnit_iff {x : BaseRing} :
    IsUnit x ↔ ∃ q : ℚ, q ≠ 0 ∧ x = algebraMap ℚ BaseRing q := sorry

/-- Example 10.27.4 (10): for `a ∉ {0,1/2,1}`, the units of `R_a` are exactly
the nonzero rational constants. -/
@[stacks 00F1 "(10)"]
theorem away_isUnit_iff (a : ℚ) (h0 : a ≠ 0) (hhalf : a ≠ (1 / 2 : ℚ))
    (h1 : a ≠ 1) {x : Away.Ring a h0 h1} :
    IsUnit x ↔
      ∃ q : ℚ, q ≠ 0 ∧ x = algebraMap ℚ (Away.Ring a h0 h1) q := sorry

/-- Example 10.27.4 (11): despite the open-immersion behavior on spectra,
`R_a` is not a localization of `R` at any submonoid. -/
@[stacks 00F1 "(11)"]
theorem away_not_isLocalization (a : ℚ) (h0 : a ≠ 0)
    (hhalf : a ≠ (1 / 2 : ℚ)) (h1 : a ≠ 1) (S : Submonoid BaseRing) :
    ¬ IsLocalization S (Away.Ring a h0 h1) := sorry

#check @Ideal.Quotient.liftₐ
#check @PrimeSpectrum.comap
#check @Algebra.Example_10_27_4.presentation
#check @Algebra.Example_10_27_4.Away.inclusion

#print axioms Algebra.Example_10_27_4.presentation
#print axioms Algebra.Example_10_27_4.quotientMap
#print axioms Algebra.Example_10_27_4.Away.evalRingHom
#print axioms Algebra.Example_10_27_4.Away.Ring
#print axioms Algebra.Example_10_27_4.Away.inclusion
