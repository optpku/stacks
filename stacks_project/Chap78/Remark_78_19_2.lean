module

public import stacks_project.Chap78.Remark_78_19_2_Quotient

@[expose] public section

open CategoryTheory AlgebraicGeometry AlgebraicSpace

universe u

namespace AlgebraicGeometry.AlgebraicSpace.PreRelation

variable {S : Scheme.{u}} {B : AlgebraicSpace S} {U : Over B}

/-- Remark 78.19.2 (1): the fppf sheafification of the functor
`(Spaces / B)ᵒᵖ ⟶ Type` sending `X` to the quotient of `X ⟶ U` by the
equivalence relation generated by the image of `j : R ⟶ U ⨯ U`. -/
@[stacks 044K]
noncomputable def spacesFppfQuotientSheaf (P : PreRelation U) :
    Sheaf ((fppfPrecoverage S).toGrothendieck.over B) (Type (u + 1)) :=
  P.spacesQuotientSheaf ((fppfPrecoverage S).toGrothendieck.over B)

/-- The underlying presheaf of `spacesFppfQuotientSheaf` is the fppf
sheafification of `spacesQuotientPresheaf`. -/
theorem spacesFppfQuotientSheaf_val (P : PreRelation U) :
    (spacesFppfQuotientSheaf P).obj =
      sheafify ((fppfPrecoverage S).toGrothendieck.over B) P.spacesQuotientPresheaf :=
  sorry

/-- The continuous pullback of `spacesFppfQuotientSheaf` along schemes over `B`
is `spacesFppfQuotientPullback`. -/
theorem spacesFppfQuotientSheaf_pullback (P : PreRelation U) :
    ((schemesOver B).sheafPushforwardContinuous (Type (u + 1))
        (schemesOverFppf B) ((fppfPrecoverage S).toGrothendieck.over B)).obj
      (spacesFppfQuotientSheaf P) =
      P.spacesFppfQuotientPullback :=
  rfl

/-- Remark 78.19.2 (2): via the identifications of sheaves on `(Spaces / B)_fppf`
with sheaves on schemes over `B`, the continuous pullback of
`spacesFppfQuotientSheaf` along schemes over `B` agrees with the fppf
sheafification of the fiber of the usual scheme-point quotient over `B`; the
comparison morphism is an isomorphism. -/
@[stacks 044K]
theorem spacesFppfQuotientComparison_isIso (P : PreRelation U) :
    IsIso P.spacesFppfQuotientComparison :=
  sorry

end AlgebraicGeometry.AlgebraicSpace.PreRelation
