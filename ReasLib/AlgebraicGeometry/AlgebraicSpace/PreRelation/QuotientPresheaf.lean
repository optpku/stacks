module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.PreRelation
public import Mathlib.CategoryTheory.Types.Basic
public import Mathlib.Data.Quot

/-!
# Quotient presheaf of a pre-relation on an algebraic space

This module constructs the objectwise quotient of scheme-valued points of `U` by the
image of a pre-relation `j : R ⟶ U ⨯ U` over a base algebraic space.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Opposite ConcreteCategory

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.PreRelation

variable {S : Scheme.{u}} [CategoryTheory.Limits.HasPullbacks (AlgebraicSpace S)]

/-- The generating relation on scheme-valued points of `U`: the image of `j` on
`T`-points over `S`. -/
def schemePointRel {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) (T : Over S) :
    U.left.functorOfPoints.obj (op T) → U.left.functorOfPoints.obj (op T) → Prop :=
  fun x y ↦ ∃ r : P.left.left.functorOfPoints.obj (op T),
    P.t.left.app (op T) r = x ∧ P.s.left.app (op T) r = y

/-- Two scheme-valued points of `U` are related exactly when they are the two
projections of a point of the source of `j`. -/
theorem schemePointRel_iff {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) (T : Over S) (x y : U.left.functorOfPoints.obj (op T)) :
    P.schemePointRel T x y ↔
      ∃ r : P.left.left.functorOfPoints.obj (op T),
        P.t.left.app (op T) r = x ∧ P.s.left.app (op T) r = y := sorry

/-- Restriction of schemes over `S` preserves the generating image of `j`. -/
theorem schemePointRel_precomp {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) {T T' : Over S} (f : T' ⟶ T)
    {x y : U.left.functorOfPoints.obj (op T)} (h : P.schemePointRel T x y) :
    P.schemePointRel T' (U.left.functorOfPoints.map f.op x)
      (U.left.functorOfPoints.map f.op y) :=
  match h with
  | ⟨r, hx, hy⟩ =>
    ⟨P.left.left.functorOfPoints.map f.op r,
      (NatTrans.naturality_apply P.t.left f.op r).trans
        (ConcreteCategory.congr_arg (U.left.functorOfPoints.map f.op) hx),
      (NatTrans.naturality_apply P.s.left f.op r).trans
        (ConcreteCategory.congr_arg (U.left.functorOfPoints.map f.op) hy)⟩

/-- Restriction of quotient classes is induced by restriction of scheme-valued points. -/
def quotientRestrict {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) {T T' : Over S} (f : T' ⟶ T) :
    Quot (P.schemePointRel T) → Quot (P.schemePointRel T') :=
  Quot.map (U.left.functorOfPoints.map f.op) fun _ _ h ↦ P.schemePointRel_precomp f h

/-- Restriction along an identity scheme morphism is the identity on quotient classes. -/
theorem quotientRestrict_id {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) (T : Over S) :
    TypeCat.ofHom (P.quotientRestrict (𝟙 T)) = 𝟙 (Quot (P.schemePointRel T)) := sorry

/-- Quotient restriction reverses composition of scheme morphisms. -/
theorem quotientRestrict_comp {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) {T T' T'' : Over S} (f : T'' ⟶ T') (g : T' ⟶ T) :
    TypeCat.ofHom (P.quotientRestrict (f ≫ g)) =
      TypeCat.ofHom (P.quotientRestrict g) ≫ TypeCat.ofHom (P.quotientRestrict f) := sorry

/-- The presheaf sending a scheme `T` over `S` to the quotient of `U(T)` by the
equivalence relation generated by the image of `j(T)`. -/
def quotientPresheaf {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) : (Over S)ᵒᵖ ⥤ Type u where
  obj T := Quot (P.schemePointRel T.unop)
  map f := TypeCat.ofHom (P.quotientRestrict f.unop)
  map_id T := P.quotientRestrict_id T.unop
  map_comp f g := P.quotientRestrict_comp g.unop f.unop

/-- The value of the quotient presheaf on `T` is the quotient by `schemePointRel`. -/
theorem quotientPresheaf_obj {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) (T : Over S) :
    P.quotientPresheaf.obj (op T) = Quot (P.schemePointRel T) := sorry

/-- Restriction in the quotient presheaf is induced by restriction of representatives. -/
theorem quotientPresheaf_map_mk {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) {T T' : Over S} (f : T' ⟶ T)
    (x : U.left.functorOfPoints.obj (op T)) :
    P.quotientPresheaf.map f.op (Quot.mk (P.schemePointRel T) x) =
      Quot.mk (P.schemePointRel T') (U.left.functorOfPoints.map f.op x) := sorry

/-- Taking quotient classes commutes with restriction of scheme-valued points. -/
theorem quotientMk_naturality {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) {T T' : Over S} (f : T' ⟶ T) :
    U.left.functorOfPoints.map f.op ≫ TypeCat.ofHom (Quot.mk (P.schemePointRel T')) =
      TypeCat.ofHom (Quot.mk (P.schemePointRel T)) ≫ P.quotientPresheaf.map f.op := sorry

/-- The canonical projection from the functor of points of `U` to the quotient
presheaf. -/
def quotientMk {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) : U.left.functorOfPoints ⟶ P.quotientPresheaf where
  app T := TypeCat.ofHom fun x ↦ Quot.mk (P.schemePointRel T.unop) x
  naturality {_ _} f := P.quotientMk_naturality f.unop

/-- The quotient projection sends a point to its quotient class. -/
theorem quotientMk_app {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) (T : Over S) (x : U.left.functorOfPoints.obj (op T)) :
    P.quotientMk.app (op T) x = Quot.mk (P.schemePointRel T) x := sorry

/-- Two points have the same image in the quotient presheaf exactly when they are
related by the generated equivalence relation. -/
theorem quotientMk_eq_iff {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) (T : Over S) (x y : U.left.functorOfPoints.obj (op T)) :
    P.quotientMk.app (op T) x = P.quotientMk.app (op T) y ↔
      _root_.Relation.EqvGen (P.schemePointRel T) x y := sorry

/-- Related scheme-valued points of `U` have the same image in `B`. -/
theorem schemePointRel_hom_eq {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) {T : Over S}
    {x y : U.left.functorOfPoints.obj (op T)} (h : P.schemePointRel T x y) :
    U.hom.app (op T) x = U.hom.app (op T) y :=
  match h with
  | ⟨r, hx, hy⟩ =>
    (ConcreteCategory.congr_arg (U.hom.app (op T)) hx.symm).trans <|
      (CategoryTheory.comp_apply (P.t.left.app (op T)) (U.hom.app (op T)) r).symm.trans <|
        (ConcreteCategory.congr_hom (NatTrans.congr_app P.t.w (op T)) r).trans <|
          (ConcreteCategory.congr_hom (NatTrans.congr_app P.s.w.symm (op T)) r).trans <|
            (CategoryTheory.comp_apply (P.s.left.app (op T)) (U.hom.app (op T)) r).trans <|
              ConcreteCategory.congr_arg (U.hom.app (op T)) hy

/-- The descended map to the base commutes with restriction of quotient classes. -/
theorem toBase_naturality {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) {T T' : Over S} (f : T' ⟶ T) :
    P.quotientPresheaf.map f.op ≫
        TypeCat.ofHom (Quot.lift (fun x ↦ U.hom.app (op T') x)
          (fun _ _ h ↦ P.schemePointRel_hom_eq h)) =
      TypeCat.ofHom (Quot.lift (fun x ↦ U.hom.app (op T) x)
        (fun _ _ h ↦ P.schemePointRel_hom_eq h)) ≫ B.functorOfPoints.map f.op := sorry

/-- The canonical transformation from the quotient presheaf to the functor of
points of `B`, using that `j` lands in `U ⨯_B U`. -/
def toBase {B : AlgebraicSpace S} {U : Over B}
    (P : PreRelation U) : P.quotientPresheaf ⟶ B.functorOfPoints where
  app T :=
    TypeCat.ofHom <|
      Quot.lift (fun x ↦ U.hom.app T x) fun _ _ h ↦
        P.schemePointRel_hom_eq h
  naturality {_ _} f := P.toBase_naturality f.unop

end AlgebraicGeometry.AlgebraicSpace.PreRelation
