module

public import stacks_project.Chap61.Definition_61_12_6_Cover
public import stacks_project.Chap61.Definition_61_12_8_Presentation

/-!
# Affine pro-étale sites in a chosen presentation

This module defines the affine full subcategory of a chosen big pro-étale
slice and the topology generated by ambient-covering standard pro-étale
covers.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.ObjectProperty

universe u v

namespace AlgebraicGeometry.ChosenBigProetaleSite

/-- The object property selecting affine represented source schemes in a
chosen big pro-étale slice. -/
def bigAffineObjects (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    ObjectProperty (bigSite X S) :=
  fun U ↦ IsAffine (X.toScheme.obj U.left)

/-- The big affine pro-étale carrier is the full subcategory of the chosen big
slice on objects with affine represented source. -/
abbrev bigAffineSite (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :=
  ObjectProperty.FullSubcategory (bigAffineObjects X S)

/-- The inclusion of the chosen big affine pro-étale carrier into the chosen
big slice. -/
def bigAffineInclusion (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    bigAffineSite X S ⥤ bigSite X S :=
  ObjectProperty.ι (bigAffineObjects X S)

/-- The source-scheme functor from the chosen big affine pro-étale carrier. -/
def bigAffineToScheme (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    bigAffineSite X S ⥤ Scheme.{u} :=
  bigAffineInclusion X S ⋙ bigToScheme X S

/-- Every object of the chosen big affine pro-étale carrier has affine
represented source scheme. -/
theorem bigAffineSite_obj_isAffine (X : ChosenBigProetaleSite.{u, v})
    (S : X.carrier) (U : bigAffineSite X S) :
    IsAffine (X.toScheme.obj U.obj.left) := sorry

/-- A finite standard pro-étale cover of an object of the chosen big affine
carrier, using the affine proof stored in that object. -/
abbrev BigAffineStandardCover (X : ChosenBigProetaleSite.{u, v})
    (S : X.carrier) (U : bigAffineSite X S) :=
  @StandardProetaleCover ((bigAffineToScheme X S).obj U) U.property

/-- A presieve on the chosen big affine carrier is a standard covering when it
covers in the ambient big slice and its image in schemes generates the same
sieve as a finite standard pro-étale cover. -/
def bigAffineStandardCovering (X : ChosenBigProetaleSite.{u, v})
    (S : X.carrier) {U : bigAffineSite X S} (R : Presieve U) : Prop :=
  R.map (bigAffineInclusion X S) ∈ (bigTopology X S).toPrecoverage U.obj ∧
    ∃ 𝒰 : BigAffineStandardCover X S U,
      Sieve.generate (R.map (bigAffineToScheme X S)) =
        Sieve.generate (Presieve.ofArrows
          (@StandardProetaleCover.U _ U.property 𝒰)
          (@StandardProetaleCover.map _ U.property 𝒰))

/-- The precoverage of ambient-covering finite standard pro-étale families on
the chosen big affine carrier. -/
def bigAffineStandardPrecoverage (X : ChosenBigProetaleSite.{u, v})
    (S : X.carrier) : Precoverage (bigAffineSite X S) where
  coverings := fun _ ↦ { R | bigAffineStandardCovering X S R }

/-- Membership in the chosen big affine standard precoverage records both
ambient covering and equality of generated sieves with a finite standard
pro-étale cover. -/
theorem mem_bigAffineStandardPrecoverage_iff
    (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier)
    {U : bigAffineSite X S} {R : Presieve U} :
    R ∈ bigAffineStandardPrecoverage X S U ↔
      R.map (bigAffineInclusion X S) ∈ (bigTopology X S).toPrecoverage U.obj ∧
        ∃ 𝒰 : BigAffineStandardCover X S U,
          Sieve.generate (R.map (bigAffineToScheme X S)) =
            Sieve.generate (Presieve.ofArrows
              (@StandardProetaleCover.U _ U.property 𝒰)
              (@StandardProetaleCover.map _ U.property 𝒰)) := sorry

/-- The Grothendieck topology on the chosen big affine carrier generated by
ambient-covering finite standard pro-étale families. -/
def bigAffineTopology (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    GrothendieckTopology (bigAffineSite X S) :=
  (bigAffineStandardPrecoverage X S).toGrothendieck

/-- The chosen big affine pro-étale topology is generated by its standard
pro-étale precoverage. -/
theorem bigAffineTopology_def (X : ChosenBigProetaleSite.{u, v}) (S : X.carrier) :
    bigAffineTopology X S =
      (bigAffineStandardPrecoverage X S).toGrothendieck := sorry

end AlgebraicGeometry.ChosenBigProetaleSite
