module

public import Mathlib.CategoryTheory.MorphismProperty.Comma
public import Mathlib.CategoryTheory.Sites.CoverLifting
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.EtaleSite
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.SchemeFunctor
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Etale
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Points
public import ReasLib.CategoryTheory.Sites.SpecialCocontinuous

/-!
# The étale site of algebraic spaces

The spaces-étale site has algebraic spaces étale over a fixed algebraic space as
objects, with covering families detected on points.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry MorphismProperty

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

/-- The étale site of algebraic spaces over `X`. -/
abbrev spacesEtaleSite {S : Scheme.{u}} (X : AlgebraicSpace S) :=
  MorphismProperty.Over
    (@AlgebraicGeometry.AlgebraicSpace.Etale S : MorphismProperty (AlgebraicSpace S)) ⊤ X

/-- The inclusion of the small étale site into the spaces-étale site. -/
def smallEtaleInclusion {S : Scheme.{u}} (X : AlgebraicSpace S) :
    SmallEtale.site X ⥤
      MorphismProperty.Over
        (@AlgebraicGeometry.AlgebraicSpace.Etale S : MorphismProperty (AlgebraicSpace S))
        ⊤ X :=
  { obj U :=
        MorphismProperty.Over.mk ⊤ U.hom (AlgebraicGeometry.AlgebraicSpace.Etale.of
        (fun φ hφ ↦ by
          -- Local instance justification (proof-local temporary data): composition stability for scheme-over-base étale morphisms is used only in the inclusion-object composition proof.
          letI : MorphismProperty.IsStableUnderComposition
              (MorphismProperty.over (@AlgebraicGeometry.Etale) :
                MorphismProperty (Over S)) :=
            ⟨fun f g hf hg ↦
              (inferInstance : MorphismProperty.IsMultiplicative
                (@AlgebraicGeometry.Etale : MorphismProperty Scheme.{u})).comp_mem
                f.left g.left hf hg⟩
          -- Local instance justification (proof-local temporary data): composition stability for representable étale morphisms is used only in the relative-composition step of the inclusion-object proof.
          letI : MorphismProperty.IsStableUnderComposition Representable.Etale :=
            MorphismProperty.relative_isStableUnderComposition
              (P := (MorphismProperty.over (@AlgebraicGeometry.Etale) :
                MorphismProperty (Over S))) (F := yoneda)
          exact MorphismProperty.comp_mem Representable.Etale φ U.hom hφ U.prop))
    map f := MorphismProperty.Over.homMk (ofOverMap f.left) (by
      rw [ofOverMap_eq]
      exact f.w)
    map_id := by
      intro U
      refine MorphismProperty.Over.Hom.ext ?_
      change ofOverMap (𝟙 U.left) = 𝟙 (ofOver U.left)
      exact (ofOverFunctor S).map_id U.left
    map_comp := by
      intro U V W f g
      refine MorphismProperty.Over.Hom.ext ?_
      change ofOverMap (f.left ≫ g.left) = ofOverMap f.left ≫ ofOverMap g.left
      exact (ofOverFunctor S).map_comp f.left g.left }

/-- A family covers in the spaces-étale site when its maps on points are jointly surjective. -/
def spacesEtalePrecoverage {S : Scheme.{u}} (X : AlgebraicSpace S) :
    Precoverage (spacesEtaleSite X) where
  coverings U :=
    { R | ∃ (I : Type u) (_ : Small.{u} I) (V : I → spacesEtaleSite X)
        (f : ∀ i, V i ⟶ U),
        R = Presieve.ofArrows V f ∧
          ⋃ i, Set.range (Points.map (f i).left) = Set.univ }

/-- The spaces-étale topology generated by jointly surjective point families. -/
def spacesEtaleTopology {S : Scheme.{u}} (X : AlgebraicSpace S) :
    GrothendieckTopology (spacesEtaleSite X) :=
  (spacesEtalePrecoverage X).toGrothendieck

/-- The small-to-spaces étale inclusion is special cocontinuous. -/
instance smallEtaleInclusion_isSpecialCocontinuous {S : Scheme.{u}}
    (X : AlgebraicSpace S) :
    (smallEtaleInclusion X).IsSpecialCocontinuous
      (SmallEtale.topology X) (spacesEtaleTopology X) :=
  sorry

/-- The opposite of the small-to-spaces étale inclusion admits pointwise right Kan extensions:
each indexing category `StructuredArrow U (smallEtaleInclusion X).op` has objects in
`Type (u + 1)` and morphisms in `Type u`, so the limits exist in `Type (u + 1)`. -/
instance smallEtaleInclusion_op_hasPointwiseRightKanExtension {S : Scheme.{u}}
    (X : AlgebraicSpace S) (P : (SmallEtale.site X)ᵒᵖ ⥤ Type (u + 1)) :
    (smallEtaleInclusion X).op.HasPointwiseRightKanExtension P :=
  fun _ ↦ inferInstance

end AlgebraicGeometry.AlgebraicSpace
