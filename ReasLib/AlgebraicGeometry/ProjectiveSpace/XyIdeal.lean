module

public import Mathlib.Algebra.Module.LinearMap.Basic
public import Mathlib.LinearAlgebra.Prod
public import Mathlib.CategoryTheory.IsomorphismClasses
public import Mathlib.RingTheory.Finiteness.Defs
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.Basic
public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.IdealClosure
public import ReasLib.AlgebraicGeometry.Scheme.GlobalSections
public import ReasLib.AlgebraicGeometry.Scheme.Module.Sections
public import ReasLib.AlgebraicGeometry.Scheme.Morphism.Projective.Basic
public import ReasLib.RingTheory.GradedAlgebra.Quotient

/-!
# The projective closed subscheme cut out by `xyI`

This module constructs `Proj(R[x, y] / xyI)` as a closed subscheme of `P¹_R`, the
pushforward `i_* 𝒪_X`, and the pair module `M = {(a, b) | a - b ∈ I}`.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.ProjectiveSpace.XyIdeal

variable {R : Type u} [CommRing R] (I : Ideal R)

/-- The homogeneous ideal `xyI` of `R[x, y]`, generated by products of `x y` with the
extension of `I`. -/
def xyIdeal : Ideal (MvPolynomial (Fin 2) R) :=
  Ideal.map MvPolynomial.C I * Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}

/-- The defining formula for the homogeneous ideal `xyI`. -/
theorem xyIdeal_def :
    xyIdeal I =
      Ideal.map MvPolynomial.C I * Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :=
  rfl

/-- The ideal `xyI` is homogeneous for the standard polynomial grading. -/
theorem xyIdeal_isHomogeneous :
    (xyIdeal I).IsHomogeneous (ProjectiveSpace.grading R 1) := sorry

/-- The homogeneous ideal `xyI` in the standard grading of `P¹_R`. -/
def homogeneousIdeal : HomogeneousIdeal (ProjectiveSpace.grading R 1) where
  toSubmodule := xyIdeal I
  is_homogeneous' := xyIdeal_isHomogeneous I

/-- The underlying ideal of `homogeneousIdeal I` is `xyIdeal I`. -/
theorem homogeneousIdeal_toIdeal : (homogeneousIdeal I).toIdeal = xyIdeal I := rfl

/-- The coordinate ring `R[x, y] / xyI`. -/
abbrev coordinateRing : Type u :=
  MvPolynomial (Fin 2) R ⧸ xyIdeal I

/-- The coordinate ring is the quotient by the homogeneous ideal `xyI`. -/
theorem coordinateRing_quot :
    coordinateRing I = (MvPolynomial (Fin 2) R ⧸ (homogeneousIdeal I).toIdeal) :=
  rfl

/-- The quotient grading on `R[x, y] / xyI` induced by the standard grading of `P¹_R`. -/
abbrev grading :
    ℕ → Submodule R (MvPolynomial (Fin 2) R ⧸ (homogeneousIdeal I).toIdeal) :=
  GradedAlgebra.Quotient.grading (ProjectiveSpace.grading R 1) (homogeneousIdeal I).toIdeal

/-- The quotient by `xyI` carries its canonical graded-algebra structure. -/
instance instGradedAlgebra : GradedAlgebra (grading I) :=
  GradedAlgebra.Quotient.gradedAlgebra (ProjectiveSpace.grading R 1)
    (homogeneousIdeal I).toIdeal (homogeneousIdeal I).isHomogeneous

/-- The projective scheme `X = Proj(R[x, y] / xyI)`. -/
abbrev scheme : Scheme :=
  Proj (grading I)

/-- The closed immersion `i : X ⟶ P¹_R` induced by the quotient `R[x, y] → R[x, y] / xyI`. -/
def closedImmersion : scheme I ⟶ ProjectiveSpace.scheme R 1 :=
  projQuotientMap (ProjectiveSpace.grading R 1) (homogeneousIdeal I)

/-- The quotient-induced morphism `X ⟶ P¹_R` is a closed immersion. -/
instance instIsClosedImmersion : IsClosedImmersion (closedImmersion I) :=
  projQuotientMap_isClosedImmersion (ProjectiveSpace.grading R 1) (homogeneousIdeal I)

/-- The structure morphism `X ⟶ Spec R`. -/
abbrev hom : scheme I ⟶ Spec (.of R) :=
  closedImmersion I ≫ ProjectiveSpace.toSpec R 1

/-- The structure morphism of `X` is the closed immersion into `P¹_R` followed by
the structure morphism of `P¹_R`. -/
theorem closedImmersion_comp :
    closedImmersion I ≫ ProjectiveSpace.toSpec R 1 = hom I := rfl

/-- The structure morphism `X ⟶ Spec R` is projective. -/
instance instProjective_hom : Projective (hom I) := sorry

/-- The pushforward `i_* 𝒪_X` as a module on `P¹_R`. -/
def pushforwardStructure : (ProjectiveSpace.scheme R 1).Modules :=
  (Scheme.Modules.pushforward (closedImmersion I)).obj
    (SheafOfModules.unit (scheme I).ringCatSheaf : (scheme I).Modules)

/-- The pushforward `i_* 𝒪_X` is of finite type. -/
instance instIsFiniteType_pushforwardStructure :
    (pushforwardStructure I).IsFiniteType := sorry

/-- The pushforward `i_* 𝒪_X` is quasi-coherent. -/
instance instIsQuasicoherent_pushforwardStructure :
    (pushforwardStructure I).IsQuasicoherent := sorry

/-- The `R`-submodule `M ⊆ R × R` of pairs `(a, b)` with `a - b ∈ I`. -/
def pairSubmodule : Submodule R (R × R) :=
  Submodule.comap (LinearMap.fst R R R - LinearMap.snd R R R) (I : Submodule R R)

/-- Membership in `pairSubmodule I` is the difference condition `a - b ∈ I`. -/
theorem mem_pairSubmodule_iff {p : R × R} :
    p ∈ pairSubmodule I ↔ p.1 - p.2 ∈ I := Iff.rfl

/-- The difference map `M → I`, sending `(a, b)` to `a - b`. -/
def difference : pairSubmodule I →ₗ[R] I :=
  ((LinearMap.fst R R R - LinearMap.snd R R R).domRestrict (pairSubmodule I)).codRestrict
    (I : Submodule R R) (fun p => p.property)

/-- The difference map evaluates to `a - b` on a pair `(a, b)`. -/
theorem difference_apply (p : pairSubmodule I) :
    (difference I p : R) = p.1.1 - p.1.2 := rfl

/-- The difference map `M → I` is surjective. -/
theorem difference_surjective : Function.Surjective (difference I) := sorry

/-- If `I` is not a finite `R`-module, then neither is `pairSubmodule I`. -/
theorem not_finite_pairSubmodule (hI : ¬ Module.Finite R I) :
    ¬ Module.Finite R (pairSubmodule I) := sorry

/-- The global functions on `Proj(R[x, y] / xyI)` are isomorphic as an `R`-module to
pairs whose difference belongs to `I`. -/
theorem globalSectionsAlg_isIsomorphic_pairSubmodule :
    CategoryTheory.IsIsomorphic
      (ModuleCat.of R (Scheme.Hom.globalSectionsAlg (hom I)))
      (ModuleCat.of R (pairSubmodule I)) := sorry

/-- The global sections of the pushforward of the structure sheaf to `P¹_R` are
isomorphic as an `R`-module to pairs whose difference belongs to `I`. -/
theorem globalSectionsMod_isIsomorphic_pairSubmodule :
    CategoryTheory.IsIsomorphic
      (Scheme.Hom.globalSectionsMod (ProjectiveSpace.toSpec R 1) (pushforwardStructure I))
      (ModuleCat.of R (pairSubmodule I)) := sorry

/-- Finiteness of `Γ(X, 𝒪_X)` is equivalent to finiteness of the pair module. -/
theorem finite_globalSectionsAlg_iff :
    Module.Finite R (Scheme.Hom.globalSectionsAlg (hom I)) ↔
      Module.Finite R (pairSubmodule I) := sorry

/-- Finiteness of `Γ(P¹_R, i_* 𝒪_X)` is equivalent to finiteness of the pair module. -/
theorem finite_globalSectionsMod_iff :
    Module.Finite R
        (Scheme.Hom.globalSectionsMod (ProjectiveSpace.toSpec R 1) (pushforwardStructure I)) ↔
      Module.Finite R (pairSubmodule I) := sorry

end AlgebraicGeometry.ProjectiveSpace.XyIdeal
