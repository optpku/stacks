    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    (K L : DerivedCategory C) [DerivedTensor.Right.Has (C := C)] :
    K ⟶ (MonoidalClosed.ihomOf H L).obj (DerivedTensor.Right.obj K L) :=
  (adjunctionOf H M L).unit.app K

/-- The explicit fixed-right derived tensor/internal-Hom unit is the unit component of its
adjunction owner. -/
@[simp, stacks 0A6B, stacks 0A8W "fixed-right derived tensor/internal-Hom unit specification"]
theorem unitOf_spec
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    (K L : DerivedCategory C) [DerivedTensor.Right.Has (C := C)] :
    unitOf H M K L = (adjunctionOf H M L).unit.app K := rfl

/-- The fixed-right derived tensor/internal-Hom unit is natural in its source object. -/
@[reassoc, stacks 0A6B, stacks 0A8W "fixed-right derived tensor/internal-Hom unit naturality"]
theorem unitOf_natural_left
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    (L : DerivedCategory C) [DerivedTensor.Right.Has (C := C)]
    {K₁ K₂ : DerivedCategory C} (f : K₁ ⟶ K₂) :
    f ≫ unitOf H M K₂ L =
      unitOf H M K₁ L ≫ (MonoidalClosed.ihomOf H L).map
        ((DerivedTensor.Right.functor L).map f) :=
  (adjunctionOf H M L).unit.naturality f

/-- The fixed-right derived tensor/internal-Hom unit is naturally compatible with changing its
right tensor factor. -/
@[stacks 0A6B, stacks 0A8W "fixed-right derived tensor/internal-Hom unit parameter naturality"]
theorem unitOf_natural_right
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    (K : DerivedCategory C) [DerivedTensor.Right.Has (C := C)]
    {L₁ L₂ : DerivedCategory C} (f : L₁ ⟶ L₂) :
    CommSq
      (unitOf H M K L₂)
      (unitOf H M K L₁)
      ((MonoidalClosed.preOf H f).app (DerivedTensor.Right.obj K L₂))
      ((MonoidalClosed.ihomOf H L₁).map ((tensorMapOf H M f).app K)) :=
