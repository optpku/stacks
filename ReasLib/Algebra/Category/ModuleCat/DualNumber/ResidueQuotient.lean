module

public import ReasLib.Algebra.Category.ModuleCat.DualNumber.Quotient
public import ReasLib.RingTheory.DualNumber.Residue

@[expose] public section

/-!
# The epsilon quotient as a residue-ring quotient

This bridge identifies the intrinsic `εM` submodule of a dual-number module with the action of
the residue ideal. It is separated from the foundational epsilon-action API so consumers of
square-zero modules do not need residue-ring infrastructure.
-/

universe u v

open CategoryTheory
open scoped DualNumber Pointwise

namespace ModuleCat.DualNumber

variable {R : Type u} [CommRing R]

/-- The submodule `εM` is the submodule generated by the action of the ideal `( ε )`. -/
@[stacks 05CS "epsilon ideal multiples"]
theorem epsSubmodule_eq_epsIdeal_smul_top (M : ModuleCat.{v} R[ε]) :
    epsSubmodule M = DualNumber.epsIdeal R • (⊤ : Submodule R[ε] M) := by
  rw [epsSubmodule_eq_smul_top, DualNumber.epsIdeal_eq_span,
    Submodule.ideal_span_singleton_smul]

namespace EpsQuotient

/-- Multiplication by `ε` and multiplication by the ideal `(ε)` define the same submodule. -/
theorem eps_smul_top_eq_epsIdeal_smul_top (M : ModuleCat.{v} R[ε]) :
    (ε : R[ε]) • (⊤ : Submodule R[ε] M) =
      DualNumber.epsIdeal R • (⊤ : Submodule R[ε] M) := by
  rw [DualNumber.epsIdeal_eq_span, Submodule.ideal_span_singleton_smul]

/-- The quotient of a dual-number module by the action of the residue ideal, retaining its
canonical dual-number module structure. -/
@[stacks 05CS "dual-number module modulo the residue ideal"]
abbrev idealQuotient (M : ModuleCat.{v} R[ε]) : ModuleCat.{v} R[ε] :=
  ModuleCat.of R[ε] (M ⧸ DualNumber.epsIdeal R • (⊤ : Submodule R[ε] M))

/-- The residue-ideal quotient after restriction from the dual numbers to the base ring. -/
@[stacks 05CS "restricted dual-number module modulo the residue ideal"]
noncomputable abbrev restrictedIdealQuotient
    (M : ModuleCat.{v} R[ε]) : ModuleCat.{v} R :=
  restrict (idealQuotient M)

/-- The intrinsic epsilon quotient agrees categorically with quotienting by the residue ideal. -/
@[stacks 05CS "epsilon quotient as a residue-ideal quotient"]
noncomputable def isoIdealQuotient (M : ModuleCat.{v} R[ε]) :
    epsQuotient M ≅ restrictedIdealQuotient M :=
  isoQuotSMulTop M ≪≫
    (restrictFunctor (R := R)).mapIso
      (Submodule.quotEquivOfEq _ _
        (eps_smul_top_eq_epsIdeal_smul_top M)).toModuleIso

/-- Linear-equivalence form of `isoIdealQuotient`. -/
noncomputable def equivIdealQuotient (M : ModuleCat.{v} R[ε]) :
    epsQuotient M ≃ₗ[R] restrictedIdealQuotient M :=
  (isoIdealQuotient M).toLinearEquiv

set_option backward.isDefEq.respectTransparency false in
/-- The residue-ideal quotient comparison preserves quotient representatives. -/
@[simp]
theorem equivIdealQuotient_mk (M : ModuleCat.{v} R[ε]) (x : restrict M) :
    equivIdealQuotient M (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk x := by
  change
    (Submodule.quotEquivOfEq
      ((ε : R[ε]) • (⊤ : Submodule R[ε] M))
      (DualNumber.epsIdeal R • (⊤ : Submodule R[ε] M))
      (eps_smul_top_eq_epsIdeal_smul_top M))
        (equivQuotSMulTop M (Submodule.Quotient.mk x)) =
      Submodule.Quotient.mk x
  rw [equivQuotSMulTop_mk, Submodule.quotEquivOfEq_mk]

/-- The inverse residue-ideal quotient comparison preserves quotient representatives. -/
@[simp]
theorem equivIdealQuotient_symm_mk (M : ModuleCat.{v} R[ε]) (x : restrict M) :
    (equivIdealQuotient M).symm (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk x := by
  apply (equivIdealQuotient M).injective
  simp
  rfl

end EpsQuotient

end ModuleCat.DualNumber
