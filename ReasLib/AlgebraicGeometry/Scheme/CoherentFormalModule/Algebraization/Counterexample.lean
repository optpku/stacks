noncomputable section

universe u

namespace AlgebraicGeometry.Scheme.CoherentFormalModules

namespace FormalLineBundleCounterexample

/-- The polynomial coefficient ring in the two affine coordinates. -/
abbrev CoefficientRing (k : Type u) [CommRing k] :=
  MvPolynomial (Fin 2) k

/-- The formal power-series ring `k[x, y][[t]]`. -/
abbrev PowerSeriesRing (k : Type u) [CommRing k] :=
  PowerSeries (CoefficientRing k)

/-- The first affine coordinate in `k[x, y][[t]]`. -/
def x (k : Type u) [CommRing k] : PowerSeriesRing k :=
  PowerSeries.C (MvPolynomial.X (0 : Fin 2))

/-- The second affine coordinate in `k[x, y][[t]]`. -/
def y (k : Type u) [CommRing k] : PowerSeriesRing k :=
  PowerSeries.C (MvPolynomial.X (1 : Fin 2))

/-- The formal parameter in `k[x, y][[t]]`. -/
def t (k : Type u) [CommRing k] : PowerSeriesRing k :=
  PowerSeries.X

/-- The ideal generated by the formal parameter. -/
def adicIdeal (k : Type u) [CommRing k] : Ideal (PowerSeriesRing k) :=
  Ideal.span ({t k} : Set (PowerSeriesRing k))

/-- The ideal generated by the two coordinates and the formal parameter. -/
def closedPointIdeal (k : Type u) [CommRing k] : Ideal (PowerSeriesRing k) :=
  Ideal.span ({x k, y k, t k} : Set (PowerSeriesRing k))

/-- The adic ideal is contained in the ideal of the removed closed point. -/
theorem adicIdeal_le_closedPointIdeal (k : Type u) [CommRing k] :
    adicIdeal k ≤ closedPointIdeal k := sorry

/-- The affine algebraization setup for the punctured formal spectrum. -/
def setup (k : Type u) [Field k] :
    AffineAlgebraizationSetup (PowerSeriesRing k) :=
  AffineAlgebraizationSetup.ofIdeals
    (adicIdeal k) (closedPointIdeal k) (adicIdeal_le_closedPointIdeal k)

/-- The ideal sheaf induced by the parameter ideal on the punctured spectrum. -/
abbrev idealSheaf (k : Type u) [Field k] : (setup k).U.toScheme.IdealSheafData :=
  (Scheme.idealSheafDataOfIdealOnSpec (adicIdeal k)).comap (setup k).U.ι

/-- The parameter-power quotient on the overlap of the two coordinate charts. -/
abbrev OverlapQuotient (k : Type u) [CommRing k] (n : ℕ) :=
  Localization.Away.PowerQuotient (x k * y k) (t k) n

/-- The finite truncation of `1 + t/(xy) + ∑ aᵢ tⁱ/(xy)^φ(i)` in the overlap quotient. -/
def transition (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) (n : ℕ) :
    OverlapQuotient k n :=
  let parameter := algebraMap (PowerSeriesRing k) (OverlapQuotient k n) (t k)
  let inverse := Ideal.Quotient.mk (Localization.Away.powerIdeal (x k * y k) (t k) n)
    (IsLocalization.Away.invSelf (R := PowerSeriesRing k)
      (S := Localization.Away (x k * y k)) (x k * y k))
  1 + parameter * inverse +
    ∑ index ∈ (Finset.range n).filter (fun index ↦ 2 ≤ index),
      algebraMap (PowerSeriesRing k) (OverlapQuotient k n) (PowerSeries.C (coefficients index)) *
        parameter ^ index * inverse ^ exponents index

/-- The finite geometric series giving the inverse of the truncated overlap transition. -/
def transitionInverse (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) (n : ℕ) :
    OverlapQuotient k n :=
  ∑ index ∈ Finset.range n, (1 - transition k coefficients exponents n) ^ index

/-- The transition and its finite geometric inverse multiply to one in either order. -/
theorem transitionUnit_laws (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) (n : ℕ) :
    transition k coefficients exponents n * transitionInverse k coefficients exponents n = 1 ∧
      transitionInverse k coefficients exponents n * transition k coefficients exponents n = 1 :=
  sorry

/-- The prescribed transition, bundled with its explicit geometric-series inverse. -/
def transitionUnit (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) (n : ℕ) :
    (OverlapQuotient k n)ˣ where
  val := transition k coefficients exponents n
  inv := transitionInverse k coefficients exponents n
  val_inv := (transitionUnit_laws k coefficients exponents n).1
  inv_val := (transitionUnit_laws k coefficients exponents n).2

/-- The prescribed transitions are compatible with every stage reduction. -/
theorem transition_reduction (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ)
    {n m : ℕ} (hnm : n ≤ m) :
    Localization.Away.PowerQuotient.reduction (x k * y k) (t k) hnm
        (transition k coefficients exponents m) = transition k coefficients exponents n := sorry

/-- The overlap difference of a pair is its second coordinate minus the transition times
its first coordinate, after both coordinates are localized to the overlap. -/
def gluingDifference (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) (n : ℕ) :
    (Localization.Away.PowerQuotient (x k) (t k) n ×
      Localization.Away.PowerQuotient (y k) (t k) n) →ₗ[PowerSeriesRing k] OverlapQuotient k n :=
  let first := LinearMap.fst (PowerSeriesRing k)
    (Localization.Away.PowerQuotient (x k) (t k) n)
    (Localization.Away.PowerQuotient (y k) (t k) n)
  let second := LinearMap.snd (PowerSeriesRing k)
    (Localization.Away.PowerQuotient (x k) (t k) n)
    (Localization.Away.PowerQuotient (y k) (t k) n)
  ((Localization.Away.PowerQuotient.map (dvd_mul_left (y k) (x k)) (t k) n).toLinearMap.comp
    second) -
    (LinearMap.mulLeft (PowerSeriesRing k) (transition k coefficients exponents n)).comp
      ((Localization.Away.PowerQuotient.map (dvd_mul_right (x k) (y k)) (t k) n).toLinearMap.comp
        first)

/-- The module of pairs satisfying the prescribed overlap transition. -/
def gluingKernel (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) (n : ℕ) :=
  LinearMap.ker (gluingDifference k coefficients exponents n)

/-- Overlap differences commute with coordinatewise successor reduction. -/
theorem gluingStep_comm (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) (n : ℕ)
    (pair : Localization.Away.PowerQuotient (x k) (t k) (n + 1) ×
      Localization.Away.PowerQuotient (y k) (t k) (n + 1)) :
    gluingDifference k coefficients exponents n
        (Localization.Away.PowerQuotient.reduction (x k) (t k) (Nat.le_succ n) pair.1,
          Localization.Away.PowerQuotient.reduction (y k) (t k) (Nat.le_succ n) pair.2) =
      Localization.Away.PowerQuotient.reduction (x k * y k) (t k) (Nat.le_succ n)
        (gluingDifference k coefficients exponents (n + 1) pair) := sorry

/-- Coordinatewise successor reduction preserves pairs satisfying the overlap transition. -/
theorem kernelStep_mem (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) (n : ℕ)
    (pair : gluingKernel k coefficients exponents (n + 1)) :
    (Localization.Away.PowerQuotient.reduction (x k) (t k) (Nat.le_succ n) pair.val.1,
      Localization.Away.PowerQuotient.reduction (y k) (t k) (Nat.le_succ n) pair.val.2) ∈
        gluingKernel k coefficients exponents n := sorry

/-- The successor map on compatible pairs is coordinatewise quotient reduction. -/
def kernelStep (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) (n : ℕ) :
    gluingKernel k coefficients exponents (n + 1) →ₗ[PowerSeriesRing k]
      gluingKernel k coefficients exponents n :=
  let first := LinearMap.fst (PowerSeriesRing k)
    (Localization.Away.PowerQuotient (x k) (t k) (n + 1))
    (Localization.Away.PowerQuotient (y k) (t k) (n + 1))
  let second := LinearMap.snd (PowerSeriesRing k)
    (Localization.Away.PowerQuotient (x k) (t k) (n + 1))
    (Localization.Away.PowerQuotient (y k) (t k) (n + 1))
  let productReduction :=
    ((Localization.Away.PowerQuotient.reduction (x k) (t k) (Nat.le_succ n)).toLinearMap.comp
      first).prod
      ((Localization.Away.PowerQuotient.reduction (y k) (t k) (Nat.le_succ n)).toLinearMap.comp
        second)
  (productReduction.domRestrict (gluingKernel k coefficients exponents (n + 1))).codRestrict
    (gluingKernel k coefficients exponents n) (kernelStep_mem k coefficients exponents n)

/-- The associated sheaf of compatible pairs, restricted to the punctured spectrum. -/
def gluingStage (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) (n : ℕ) :
    (setup k).U.toScheme.Modules :=
  (tilde (ModuleCat.of (PowerSeriesRing k) (gluingKernel k coefficients exponents n))).restrict
    (setup k).U.ι

/-- The compatible-pair sheaf is coherent on the punctured spectrum. -/
theorem gluingStage_isCoherent (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) (n : ℕ) :
    SheafOfModules.IsCoherent (gluingStage k coefficients exponents n) := sorry

/-- The coherent module at a specified truncation stage. -/
def coherentStage (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) (n : ℕ) :
    RingedSpace.Coh (setup k).U.toScheme.toRingedSpace :=
  ⟨gluingStage k coefficients exponents n, gluingStage_isCoherent k coefficients exponents n⟩

/-- The sheaf morphism induced by coordinatewise successor reduction of compatible pairs. -/
def gluingStep (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) (n : ℕ) :
    coherentStage k coefficients exponents (n + 1) ⟶ coherentStage k coefficients exponents n :=
  ObjectProperty.homMk ((Scheme.Modules.restrictFunctor (setup k).U.ι).map
    ((tilde.functor (CommRingCat.of (PowerSeriesRing k))).map
      (ModuleCat.ofHom (kernelStep k coefficients exponents n))))

/-- The inverse system of the constructed coherent stages and quotient reductions. -/
def gluingSystem (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) :
    SequentialInverseSystem (RingedSpace.Coh (setup k).U.toScheme.toRingedSpace) :=
  Functor.ofOpSequence (gluingStep k coefficients exponents)

/-- The constructed stages satisfy parameter-power annihilation and the successor quotient
condition of a coherent formal module. -/
theorem gluingSystem_mem (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) :
    Scheme.IsCoherentFormalModuleSystem (idealSheaf k)
      (gluingSystem k coefficients exponents) := sorry

/-- The coherent formal module determined by the explicit overlap transitions. -/
def formalModule (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) :
    CoherentFormalModules (setup k).U.toScheme (idealSheaf k) :=
  ⟨gluingSystem k coefficients exponents, gluingSystem_mem k coefficients exponents⟩

/-- The quotient structure module at stage `n` on the punctured spectrum. -/
def quotientUnit (k : Type u) [Field k] (n : ℕ) : (setup k).U.toScheme.Modules :=
  (tilde (ModuleCat.of (PowerSeriesRing k) (PowerSeriesRing k ⧸ adicIdeal k ^ n))).restrict
    (setup k).U.ι

/-- A formal module is stagewise invertible when every positive stage is locally isomorphic
to the quotient structure module. -/
def stagewiseInvertible (k : Type u) [Field k]
    (F : CoherentFormalModules (setup k).U.toScheme (idealSheaf k)) : Prop :=
  ∀ n : ℕ, 0 < n → ∀ point : (setup k).U.toScheme,
    ∃ neighborhood : (setup k).U.toScheme.Opens, point ∈ neighborhood ∧
      Nonempty (((Scheme.Modules.restrictFunctor neighborhood.ι).obj (F.obj.obj (op n)).obj) ≅
        ((Scheme.Modules.restrictFunctor neighborhood.ι).obj (quotientUnit k n)))

/-- The constructed stages have simultaneous coordinate-chart trivializations with
overlap orientation `s_y = u_n * s_x`, compatible with the constructed quotient reductions. -/
theorem formalModule_gluing (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) :
    let firstOpen := (setup k).U.ι ⁻¹ᵁ (PrimeSpectrum.basicOpen (x k))
    let secondOpen := (setup k).U.ι ⁻¹ᵁ (PrimeSpectrum.basicOpen (y k))
    let overlapOpen := firstOpen ⊓ secondOpen
    let firstRestriction := Scheme.Modules.restrictFunctor firstOpen.ι
    let secondRestriction := Scheme.Modules.restrictFunctor secondOpen.ι
    let overlapRestriction := Scheme.Modules.restrictFunctor overlapOpen.ι
    let firstOverlap := (setup k).U.toScheme.homOfLE
      (inf_le_left : overlapOpen ≤ firstOpen)
    let secondOverlap := (setup k).U.toScheme.homOfLE
      (inf_le_right : overlapOpen ≤ secondOpen)
    let firstComparison :=
      (Scheme.Modules.restrictFunctorCongr ((setup k).U.toScheme.homOfLE_ι
        (inf_le_left : overlapOpen ≤ firstOpen))).symm ≪≫
      Scheme.Modules.restrictFunctorComp firstOverlap firstOpen.ι
    let secondComparison :=
      (Scheme.Modules.restrictFunctorCongr ((setup k).U.toScheme.homOfLE_ι
        (inf_le_right : overlapOpen ≤ secondOpen))).symm ≪≫
      Scheme.Modules.restrictFunctorComp secondOverlap secondOpen.ι
    let overlapTilde := tilde.functor (CommRingCat.of (PowerSeriesRing k)) ⋙
      Scheme.Modules.restrictFunctor (setup k).U.ι ⋙ overlapRestriction
    let unitReduction := fun n : ℕ ↦
      (Scheme.Modules.restrictFunctor (setup k).U.ι).map
        ((tilde.functor (CommRingCat.of (PowerSeriesRing k))).map
          (ModuleCat.ofHom (Ideal.Quotient.factorₐ (PowerSeriesRing k)
            (Ideal.pow_le_pow_right (I := adicIdeal k) (Nat.le_succ n))).toLinearMap))
    ∃ (firstTrivialization : ∀ n,
        firstRestriction.obj (gluingStage k coefficients exponents n) ≅
          firstRestriction.obj (quotientUnit k n))
      (secondTrivialization : ∀ n,
        secondRestriction.obj (gluingStage k coefficients exponents n) ≅
          secondRestriction.obj (quotientUnit k n))
      (overlapIdentification : ∀ n,
        overlapRestriction.obj (quotientUnit k n) ≅
          overlapTilde.obj (ModuleCat.of (PowerSeriesRing k) (OverlapQuotient k n))),
      (∀ n,
        let firstOnOverlap := (firstComparison.app (gluingStage k coefficients exponents n)) ≪≫
          (Scheme.Modules.restrictFunctor firstOverlap).mapIso (firstTrivialization n) ≪≫
          (firstComparison.app (quotientUnit k n)).symm
        let secondOnOverlap := (secondComparison.app (gluingStage k coefficients exponents n)) ≪≫
          (Scheme.Modules.restrictFunctor secondOverlap).mapIso (secondTrivialization n) ≪≫
          (secondComparison.app (quotientUnit k n)).symm
        secondOnOverlap.hom ≫ (overlapIdentification n).hom =
          firstOnOverlap.hom ≫ (overlapIdentification n).hom ≫
            overlapTilde.map (ModuleCat.ofHom
              (LinearMap.mulLeft (PowerSeriesRing k)
                (transitionUnit k coefficients exponents n).val))) ∧
      (∀ n,
        firstRestriction.map (gluingStep k coefficients exponents n).hom ≫
            (firstTrivialization n).hom =
          (firstTrivialization (n + 1)).hom ≫ firstRestriction.map (unitReduction n)) ∧
      (∀ n,
        secondRestriction.map (gluingStep k coefficients exponents n).hom ≫
            (secondTrivialization n).hom =
          (secondTrivialization (n + 1)).hom ≫ secondRestriction.map (unitReduction n)) ∧
      (∀ n,
        overlapRestriction.map (unitReduction n) ≫ (overlapIdentification n).hom =
          (overlapIdentification (n + 1)).hom ≫
            overlapTilde.map (ModuleCat.ofHom
              (Localization.Away.PowerQuotient.reduction (x k * y k) (t k)
                (Nat.le_succ n)).toLinearMap)) := sorry

/-- Every constructed stage vanishes on the open where the formal parameter is invertible. -/
theorem gluingStage_zeroOnParameterOpen (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) (n : ℕ) :
    IsZero ((Scheme.Modules.restrictFunctor
      ((setup k).U.ι ⁻¹ᵁ (PrimeSpectrum.basicOpen (t k))).ι).obj
      (gluingStage k coefficients exponents n)) := sorry

/-- Every positive stage of the constructed formal module is invertible over its quotient
structure module. -/
theorem formalModule_stagewiseInvertible (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) :
    stagewiseInvertible k (formalModule k coefficients exponents) := sorry

/-- No coherent module on the punctured spectrum completes to the prescribed formal module. -/
theorem nonAlgebraizable (k : Type u) [Field k]
    (coefficients : ℕ → CoefficientRing k) (exponents : ℕ → ℕ) :
    ¬ (Scheme.CoherentCompletion.functor (idealSheaf k)).essImage
      (formalModule k coefficients exponents) := sorry

/-- Zero higher coefficients give nontrivial inverse-limit global sections, independently
of the prescribed denominator exponents. -/
theorem nontrivialLimit (k : Type u) [Field k] (exponents : ℕ → ℕ) :
    Nontrivial (sectionsLimit (setup k) (formalModule k (fun _ ↦ 0) exponents)) := sorry

/-- Unit higher coefficients and exponential denominator exponents give zero inverse-limit
global sections. -/
theorem subsingletonLimit_exponential (k : Type u) [Field k] :
    Subsingleton (sectionsLimit (setup k) (formalModule k (fun _ ↦ 1) (fun n ↦ 2 ^ n))) := sorry

/-- Unit higher coefficients and quadratic denominator exponents give zero inverse-limit
global sections. -/
theorem subsingletonLimit_quadratic (k : Type u) [Field k] :
    Subsingleton (sectionsLimit (setup k) (formalModule k (fun _ ↦ 1) (fun n ↦ n ^ 2))) := sorry

end FormalLineBundleCounterexample

end AlgebraicGeometry.Scheme.CoherentFormalModules
