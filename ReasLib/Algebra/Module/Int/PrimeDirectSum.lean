module

public import Mathlib.Algebra.Category.ModuleCat.Localization
public import Mathlib.Algebra.DirectSum.Module
public import Mathlib.Algebra.Homology.ShortComplex.ShortExact
public import Mathlib.Data.Nat.Prime.Defs
public import Mathlib.Data.Nat.Prime.Int
public import Mathlib.RingTheory.Ideal.Maximal
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.RingTheory.Localization.AsSubring
public import Mathlib.RingTheory.Localization.AtPrime.Basic

/-!
# The integer prime-localization coproduct sequence

The kernel sequence of the coproduct of the inclusions from the prime localizations
of `ℤ` into `ℚ` is short exact and nonsplit, but splits on a principal-open cover.
-/

@[expose] public section

universe u

open CategoryTheory
open scoped DirectSum

noncomputable section

namespace Int.PrimeDirectSum

/-- The principal ideal of `ℤ` generated by a natural prime number. -/
def natPrimeIdeal (p : Nat.Primes) : Ideal ℤ :=
  Ideal.span {((p : ℕ) : ℤ)}

/-- The principal ideal generated by a natural prime number is a prime ideal of `ℤ`. -/
instance instIsPrimeNatPrimeIdeal (p : Nat.Primes) : (natPrimeIdeal p).IsPrime :=
  Ideal.isPrime_span_singleton_of_prime (Nat.prime_iff_prime_int.mp p.property)

/-- The localization of `ℤ` at the complement of the ideal generated by `p`. -/
abbrev atPrime (p : Nat.Primes) :=
  Localization.AtPrime (natPrimeIdeal p)

/-- The canonical `ℤ`-linear inclusion of the localization at `p` into `ℚ`. -/
def atPrimeToRat (p : Nat.Primes) : atPrime p →ₗ[ℤ] ℚ :=
  (Localization.mapToFractionRing ℚ (natPrimeIdeal p).primeCompl (atPrime p)
    (Ideal.primeCompl_le_nonZeroDivisors (natPrimeIdeal p))).toLinearMap

/-- The direct sum of the localizations of `ℤ` at all natural prime numbers. -/
abbrev sum :=
  ⨁ p : Nat.Primes, atPrime p

/-- The map from the direct sum to `ℚ` induced by the canonical inclusions of the summands. -/
def toRat : sum →ₗ[ℤ] ℚ :=
  DirectSum.toModule ℤ Nat.Primes ℚ fun p ↦ atPrimeToRat p

/-- The kernel of the map from the direct sum of prime localizations to `ℚ`. -/
abbrev ker : Submodule ℤ sum :=
  LinearMap.ker toRat

/-- Every `ℤ`-linear map from `ℚ` to the localization of `ℤ` at a natural prime is zero. -/
theorem ratLinearMap_eq_zero (p : Nat.Primes) (f : ℚ →ₗ[ℤ] atPrime p) : f = 0 := sorry

/-- The short complex `ker ⟶ sum ⟶ ℚ` with kernel inclusion and coproduct map. -/
def shortComplex : ShortComplex (ModuleCat ℤ) :=
  ModuleCat.shortComplexOfCompEqZero ker.subtype toRat (LinearMap.comp_ker_subtype toRat)

/-- The kernel sequence of the coproduct map from prime localizations to `ℚ` is short exact. -/
theorem shortComplex_shortExact : shortComplex.ShortExact := sorry

/-- The kernel sequence of the coproduct map from prime localizations to `ℚ` does not split. -/
theorem shortComplex_not_splitting : ¬ Nonempty shortComplex.Splitting := sorry

/-- The kernel sequence of the coproduct map to `ℚ` splits after localization at any prime
ideal of `ℤ`. -/
theorem shortComplex_splitting_atPrime (q : Ideal ℤ) [q.IsPrime] :
    Nonempty ((shortComplex.map (ModuleCat.localizedModuleFunctor q.primeCompl)).Splitting) := sorry

/-- The kernel sequence of the coproduct map to `ℚ` splits on a principal-open cover of
`Spec ℤ`. -/
theorem shortComplex_splitting_awayCover :
    ∃ s : Set ℤ, Ideal.span s = ⊤ ∧
      ∀ f : s, Nonempty
        ((shortComplex.map (ModuleCat.localizedModuleFunctor (Submonoid.powers f.1))).Splitting) := sorry

/-- There exists a commutative ring with a short exact module sequence that does not split
globally but splits on a principal-open Zariski cover. -/
theorem exists_nonsplit_zariskiLocallySplit :
    ∃ (R : Type u) (_ : CommRing R) (S : ShortComplex (ModuleCat.{u} R)),
      S.ShortExact ∧ ¬ Nonempty S.Splitting ∧
        ∃ s : Set R, Ideal.span s = ⊤ ∧
          ∀ f : s, Nonempty
            ((S.map (ModuleCat.localizedModuleFunctor (Submonoid.powers f.1))).Splitting) := sorry

end Int.PrimeDirectSum
