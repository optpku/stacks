module

public import ReasLib.RingTheory.AdicCompletion.NaiveCotangent.Jacobian
public import ReasLib.RingTheory.AdicCompletion.TopologicallyFiniteType
public import Mathlib.RingTheory.Noetherian.Defs

/-!
# Algebraization of elementary completed Jacobian presentations

A topologically finite type algebra over a Noetherian pair admits a finite type
algebraization when a finite completed-polynomial presentation satisfies an
elementary Jacobian criterion.
-/

@[expose] public section

universe u

open PrimeSpectrum
open scoped PrimeSpectrum

namespace Algebra.NaiveCotangent.Adic
open Presentation

/-- A topologically finite type algebra over a Noetherian pair `(A, I)` with a
completed-polynomial presentation on finitely many variables is the completion
of a finite type `A`-algebra if there are selected relations and an element `b`
such that `V({b}) ⊆ V(I B)`, the selected Jacobian minor divides `b`, and
multiplication by a lift of `b` sends the presentation kernel into the ideal
generated by the selected relations plus the square of the kernel. -/
@[stacks 0GAW]
theorem exists_finiteTypeAlgEquiv_of_elementaryJacobian
    {A B : Type u} [CommRing A] [IsNoetherianRing A] [CommRing B] [Algebra A B]
    (I : Ideal A) [Algebra.TopologicallyFiniteType I B] {ι : Type u} [Fintype ι]
    (P : Presentation A B I ι) {m : ℕ} (b : B) (fs : Fin m → P.ker)
    (cols : Fin m ↪ ι) (hV : V({b}) ⊆ V((I.map (algebraMap A B) : Set B)))
    (hΔ : jacobianMinor P fs cols ∣ b) (hrel : relationCondition P b fs) :
    ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C)
      (_ : Algebra.FiniteType A C),
      Nonempty (AdicCompletion (I.map (algebraMap A C)) C ≃ₐ[A] B) :=
  sorry

end Algebra.NaiveCotangent.Adic
