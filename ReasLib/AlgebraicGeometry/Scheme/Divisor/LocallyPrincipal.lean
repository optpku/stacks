module

public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import ReasLib.AlgebraicGeometry.RingedSpace.Module.ClosedImmersion.Scheme

/-!
# Locally principal closed subschemes

This leaf owns the local-generator formulation of locally principal closed
subschemes of schemes.
-/

@[expose] public section

open CategoryTheory CategoryTheory.MonoidalCategory AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry

/-- A scheme morphism defines a locally principal closed subscheme when it is a closed
immersion and its ideal sheaf is locally generated by one section. -/
class IsLocallyPrincipalClosedSubscheme {S D : Scheme.{u}} (i : D ⟶ S) : Prop
    extends IsClosedImmersion i where
  /-- Near every point, the closed-immersion ideal sheaf is generated by one local section. -/
  idealSheaf_isGeneratedBy_one (x : S) :
    ∃ U : S.Opens, x ∈ U ∧
      ∃ s :
        (((RingedSpace.Hom.idealSheaf i.toShHom).over U :
          SheafOfModules (S.toRingedSpace.ringCatSheaf.over U)).sections),
        Epi
          ((((RingedSpace.Hom.idealSheaf i.toShHom).over U :
            SheafOfModules (S.toRingedSpace.ringCatSheaf.over U)).freeHomEquiv).symm
            (fun _ : PUnit ↦ s))

/-- Unfold local principality into the closed-immersion condition and the local one-generator
condition on its ideal sheaf. -/
theorem isLocallyPrincipalClosedSubscheme_iff {S D : Scheme.{u}} (i : D ⟶ S) :
    IsLocallyPrincipalClosedSubscheme i ↔
      IsClosedImmersion i ∧
        ∀ x : S, ∃ U : S.Opens, x ∈ U ∧
          ∃ s :
            (((RingedSpace.Hom.idealSheaf i.toShHom).over U :
              SheafOfModules (S.toRingedSpace.ringCatSheaf.over U)).sections),
            Epi
              ((((RingedSpace.Hom.idealSheaf i.toShHom).over U :
                SheafOfModules (S.toRingedSpace.ringCatSheaf.over U)).freeHomEquiv).symm
                (fun _ : PUnit ↦ s)) := sorry

end AlgebraicGeometry
