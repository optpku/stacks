module

public import ReasLib.AlgebraicGeometry.Scheme.RelativeProj.Map.ClosedImmersion
public import ReasLib.RingTheory.GradedAlgebra.GeneratedBy

/-!
# Relative projective-spectrum maps from degree-one-generated affine models

This file gives the affine-local degree-one-generation condition for relative
projective-spectrum maps and its consequence for integral-twist comparisons.
-/

@[expose] public section

open CategoryTheory
open AlgebraicGeometry.Scheme.Hom

noncomputable section

universe u

namespace AlgebraicGeometry

section

variable {S X Y : Scheme.{u}}
variable {pX : X ⟶ S} {pY : Y ⟶ S}
variable (P𝒜 : RelativeProjPresentation pX)
variable (Pℬ : RelativeProjPresentation pY)
variable (φ : P𝒜.algebra ⟶ Pℬ.algebra)

namespace RelativeProjMap

/-- A relative projective-spectrum map has degree-one-generated affine models if every affine
open of the base admits a compatible absolute model whose source algebra is generated by its
degree-one component over degree zero. -/
def HasDegreeOneGeneratedAffineModels
    (rφ : RelativeProjMap P𝒜 Pℬ φ) : Prop :=
  ∀ W : S.affineOpens,
    ∃ C : AffineChartCompatibility P𝒜 Pℬ φ rφ W,
      @GradedAlgebra.GeneratedBy ℕ inferInstance
        C.projModelX.ring C.projModelX.grade inferInstance C.projModelX.gradeSetLike
        C.projModelX.gradeAddSubgroupClass.toAddSubmonoidClass C.projModelX.grading
        C.projModelX.grading_inst.toGradedMonoid 1

/-- Having degree-one-generated affine models is equivalent to admitting a compatible,
degree-one-generated source model over every affine open of the base. -/
theorem hasDegreeOneGeneratedAffineModels_iff
    (rφ : RelativeProjMap P𝒜 Pℬ φ) :
    HasDegreeOneGeneratedAffineModels P𝒜 Pℬ φ rφ ↔
      ∀ W : S.affineOpens,
        ∃ C : AffineChartCompatibility P𝒜 Pℬ φ rφ W,
          @GradedAlgebra.GeneratedBy ℕ inferInstance
            C.projModelX.ring C.projModelX.grade inferInstance C.projModelX.gradeSetLike
            C.projModelX.gradeAddSubgroupClass.toAddSubmonoidClass C.projModelX.grading
            C.projModelX.grading_inst.toGradedMonoid 1 := sorry

namespace HasDegreeOneGeneratedAffineModels

/-- Degree-one-generated affine models in particular provide compatible affine models. -/
theorem affineCompatible
    {rφ : RelativeProjMap P𝒜 Pℬ φ}
    (hgenerated : HasDegreeOneGeneratedAffineModels P𝒜 Pℬ φ rφ) :
    ∀ W : S.affineOpens,
      Nonempty (AffineChartCompatibility P𝒜 Pℬ φ rφ W) := sorry

end HasDegreeOneGeneratedAffineModels

/-- Eventual epimorphy of the nonnegative graded pieces and degree-one generation of compatible
affine source models make every full-source integral-twist comparison an isomorphism. -/
theorem thetaOnTarget_isIso_of_degreeOneGenerated
    (rφ : RelativeProjMap P𝒜 Pℬ φ)
    (hgenerated : HasDegreeOneGeneratedAffineModels P𝒜 Pℬ φ rφ)
    (hφsurj : ∃ N : ℕ, ∀ d ≥ N, Epi (φ.hom (Int.ofNat d)))
    (n : ℤ) :
    let hTop : rφ.domain = ⊤ :=
      domain_eq_top_of_eventually_surjective P𝒜 Pℬ φ rφ
        (HasDegreeOneGeneratedAffineModels.affineCompatible P𝒜 Pℬ φ hgenerated) hφsurj
    let hι : domainTopInclusion P𝒜 Pℬ φ rφ hTop ≫ rφ.domain.ι = 𝟙 Y :=
      domainTopInclusion_comp_ι P𝒜 Pℬ φ rφ hTop
    IsIso (thetaOnTarget P𝒜 Pℬ φ rφ hTop hι n) := sorry

end RelativeProjMap

end

end AlgebraicGeometry
