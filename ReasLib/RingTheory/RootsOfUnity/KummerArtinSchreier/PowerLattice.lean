module

public import ReasLib.RingTheory.RootsOfUnity.KummerArtinSchreier

@[expose] public section

/-!
# Principal power lattices for Kummer--Artin--Schreier formulas

The congruences used with the scaled multiplicative law are most naturally membership statements
in the `B`-submodule generated by an integral power of a distinguished element.  This file keeps
that reusable linear-algebra layer independent of discrete valuations.

@stack 09F6
@stack 09F7
-/

namespace KummerArtinSchreier
namespace PowerLattice

universe u v

variable {B : Type u} [CommRing B]
variable {M : Type v} [Field M] [Algebra B M]

/-- The principal `B`-lattice in `M` generated by the `n`th integral power of `π`. -/
@[stacks 09F7 "principal integral-power lattice"]
def principal (M : Type v) [Field M] [Algebra B M] (π : B) (n : ℤ) : Submodule B M :=
  Submodule.span B ({(algebraMap B M π) ^ n} : Set M)

/-- Membership in a principal power lattice is the expected coefficient factorization. -/
@[stacks 09F7 "principal power-lattice membership"]
theorem mem_principal_iff {π : B} {n : ℤ} {x : M} :
    x ∈ principal M π n ↔
      ∃ b : B, x = (algebraMap B M π) ^ n * algebraMap B M b := sorry
-- Proof strategy: unfold `principal` and use the singleton-span membership characterization.
-- Translate scalar multiplication on `M` into multiplication by `algebraMap B M b`, commuting
-- the two factors in the forward direction.

/-- Products add the exponents of their principal power lattices. -/
@[stacks 09F7 "multiplication of principal power lattices"]
theorem mul_mem {π : B} {r s : ℤ} {x y : M}
    (hx : x ∈ principal M π r) (hy : y ∈ principal M π s) :
    x * y ∈ principal M π (r + s) := sorry
-- Proof strategy: unpack `hx` and `hy` with `mem_principal_iff`, multiply the two factorizations,
-- rewrite the generator powers with `zpow_add₀`, and use the product of the two coefficients as the
-- witness for `mem_principal_iff`.

/-- Replacing an element by an associated `e`th power shifts the lattice exponent by `p * e`. -/
@[stacks 09F7 "associated-power shift of a principal power lattice"]
theorem associated_pow_mul_mem
    {π w : B} {p e : ℕ} {r s : ℤ} {x y : M}
    (hw : Associated w (π ^ e))
    (hx : x ∈ principal M π r) (hy : y ∈ principal M π s) :
    (algebraMap B M w) ^ p * x * y ∈
      principal M π (r + s + (p : ℤ) * e) := sorry
-- Proof strategy: write `w` as a unit multiple of `π ^ e` using `hw`, map that relation to `M`,
-- and raise it to the `p`th power.  Unpack `hx` and `hy`, combine the unit power with their
-- coefficients, and normalize natural/integral powers to the exponent `r + s + p * e`.

/-- The nonlinear correction in the scaled multiplicative law lies in the predicted principal
power lattice. -/
@[stacks 09F7 "Equation 15.116.16.2: scaled-law power-lattice congruence"]
theorem mulLaw_sub_add_mem
    {π w : B} {p e n : ℕ} {x y : M}
    (hw : Associated w (π ^ e))
    (hx : x ∈ principal M π (-(n : ℤ)))
    (hy : y ∈ principal M π (-(n : ℤ))) :
    mulLaw ((algebraMap B M w) ^ p) x y - (x + y) ∈
      principal M π (-(2 * (n : ℤ)) + (p : ℤ) * e) := sorry
-- Proof strategy: unfold `mulLaw` and simplify the difference to
-- `(algebraMap B M w) ^ p * x * y`.  Apply `associated_pow_mul_mem hw hx hy` and normalize the
-- integer exponent `-n + -n + p * e`.

end PowerLattice
end KummerArtinSchreier
