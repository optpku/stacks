module

public import Mathlib.Logic.Relation
public import Mathlib.Topology.Order.UpperLowerSetTopology
public import ReasLib.Topology.Catenary
public import ReasLib.Topology.Sober.Finite
public import ReasLib.Topology.Specialization.Dimension
import Mathlib.Tactic.DeriveFintype

/-!
# Twisted two-flag Alexandrov space

The finite poset with generic points `eta`, `xi`, an intermediate point `a`, and closed
points `p`, `q`, equipped with the Alexandrov upper-set topology. Immediate specializations are
the reversed Hasse covers `eta ⤳ p`, `eta ⤳ a`, `a ⤳ q`, `xi ⤳ p`, and `xi ⤳ q`.
This space is finite, sober, and catenary, but admits no integer dimension function: any
such function would require both `δ p = δ q + 1` along `eta` and `δ p = δ q` along `xi`.
-/

@[expose] public section

open TopologicalSpace

namespace TwistedFlags

/-- Points of the twisted two-flag poset. -/
inductive Point where
  /-- The first generic point, covering `p` and `a`. -/
  | eta
  /-- The second generic point, covering `p` and `q`. -/
  | xi
  /-- The intermediate point on the longer flag through `eta`. -/
  | a
  /-- A closed point covered by both generic points. -/
  | p
  /-- The closed point covered by `a` and by `xi`. -/
  | q
deriving DecidableEq

/-- The finite enumeration of the points of the twisted two-flag poset. -/
instance instFintypePoint : Fintype Point := derive_fintype% Point

/-- The covering relation of the twisted two-flag poset. -/
inductive Cov : Point → Point → Prop where
  /-- `p` is covered by `eta`. -/
  | p_eta : Cov .p .eta
  /-- `a` is covered by `eta`. -/
  | a_eta : Cov .a .eta
  /-- `q` is covered by `a`. -/
  | q_a : Cov .q .a
  /-- `p` is covered by `xi`. -/
  | p_xi : Cov .p .xi
  /-- `q` is covered by `xi`. -/
  | q_xi : Cov .q .xi

/-- The partial order generated by the twisted two-flag covering relation. -/
instance instPartialOrder : PartialOrder Point where
  le := Relation.ReflTransGen Cov
  le_refl := fun _ => Relation.ReflTransGen.refl
  le_trans := fun _ _ _ h₁ h₂ => Relation.ReflTransGen.trans h₁ h₂
  le_antisymm := sorry

/-- The Alexandrov upper-set topology on the twisted two-flag poset. -/
instance instTopologicalSpace : TopologicalSpace Point :=
  Topology.upperSet Point

/-- The twisted two-flag space is Kolmogorov. -/
instance instT0Space : T0Space Point := sorry

/-- The order on the twisted two-flag poset is reflexivity, the five covers, and the
composite `q ≤ eta`. -/
theorem le_iff {x y : Point} :
    x ≤ y ↔
      x = y ∨ Cov x y ∨ (x = .q ∧ y = .eta) := sorry

/-- The twisted two-flag space is catenary. -/
instance instCatenarySpace : CatenarySpace Point := sorry

/-- The twisted two-flag space is sober, i.e. Kolmogorov and quasi-sober. -/
theorem sober : T0Space Point ∧ QuasiSober Point := sorry

/-- Immediate specializations are exactly the reversed Hasse covers `eta ⤳ p`,
`eta ⤳ a`, `a ⤳ q`, `xi ⤳ p`, and `xi ⤳ q`. -/
theorem isImmediateSpecialization_iff {x y : Point} :
    IsImmediateSpecialization x y ↔
      (x = .eta ∧ y = .p) ∨ (x = .eta ∧ y = .a) ∨ (x = .a ∧ y = .q) ∨
        (x = .xi ∧ y = .p) ∨ (x = .xi ∧ y = .q) := sorry

/-- Any dimension function would force both `δ p = δ q + 1` along `eta` and
`δ p = δ q` along `xi`. -/
theorem eq_add_one_of_isDimensionFunction {δ : Point → ℤ}
    (hδ : IsDimensionFunction δ) :
    δ .p = δ .q + 1 ∧ δ .p = δ .q := sorry

/-- The twisted two-flag space admits no integer-valued dimension function. -/
theorem not_exists_isDimensionFunction :
    ¬ ∃ δ : Point → ℤ, IsDimensionFunction δ := sorry

/-- On this space, `IsDimensionFunction` matches the interpolating-gap form of a
dimension function. -/
theorem isDimensionFunction_iff_interpolating (δ : Point → ℤ) :
    IsDimensionFunction δ ↔
      (∀ ⦃x y : Point⦄, x ⤳ y → x ≠ y → δ y < δ x) ∧
        ∀ ⦃x y : Point⦄, x ⤳ y → δ y + 2 ≤ δ x →
          ∃ z : Point, x ⤳ z ∧ z ⤳ y ∧ δ z < δ x ∧ δ y < δ z := sorry

end TwistedFlags
