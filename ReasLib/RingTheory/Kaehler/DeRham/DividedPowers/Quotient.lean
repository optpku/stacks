module

public import ReasLib.RingTheory.Kaehler.DeRham.DividedPowers
public import ReasLib.RingTheory.DividedPowers.Quotient
public import Mathlib.LinearAlgebra.TensorProduct.Basic

@[expose] public section

open scoped TensorProduct

universe u v

namespace KaehlerDifferential.DeRham

/-- Quotienting by a divided-power-stable ideal gives the quotient of the base-changed
differential module by the submodule generated by the differentials of its elements. -/
theorem dividedPowerDifferential_quotient
    {A : Type u} [CommRing A] {B : Type v} [CommRing B]
    (f : A →+* B) {J : Ideal B} (δ : DividedPowers J)
    (K : Ideal B) (hKsub : K ≤ J)
    (hK : DividedPowers.IsSubDPIdeal δ (K ⊓ J)) :
    Nonempty (
      dividedPowerDifferential ((Ideal.Quotient.mk K).comp f)
          (DividedPowers.Quotient.dividedPowers δ hK) ≃ₗ[B ⧸ K]
      (((B ⧸ K) ⊗[B] dividedPowerDifferential f δ) ⧸
        Submodule.span (B ⧸ K)
          {ω | ∃ k : B, k ∈ K ∧
            ω = (1 : B ⧸ K) ⊗ₜ[B] dividedPowerDifferentialDerivation f δ k})) := sorry

end KaehlerDifferential.DeRham
