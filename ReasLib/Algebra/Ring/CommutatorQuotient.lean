module

public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Algebra.Algebra.Defs
public import Mathlib.Algebra.Ring.Commute
public import Mathlib.GroupTheory.QuotientGroup.Defs

/-!
# Additive commutator quotient of a ring

The quotient of a ring by the additive subgroup generated by
ring commutators `⁅a, b⁆ = a * b - b * a` is an abelian group,
written `R♮`, and is not a ring.
-/

@[expose] public section

universe u v

namespace Ring

variable (R : Type u) [NonUnitalNonAssocRing R]

/-- The additive subgroup of a ring generated by commutators `⁅a, b⁆ = a * b - b * a`. -/
def commutatorAddSubgroup : AddSubgroup R :=
  AddSubgroup.closure {x | ∃ a b : R, x = ⁅a, b⁆}

/-- The quotient of a ring by the additive subgroup generated by ring commutators.
This is an abelian group, not a ring. -/
abbrev CommutatorQuotient : Type u :=
  R ⧸ commutatorAddSubgroup R

@[inherit_doc CommutatorQuotient]
scoped postfix:max "♮" => CommutatorQuotient

variable {R}

/-- Every ring commutator lies in the additive commutator subgroup. -/
theorem lie_mem_commutatorAddSubgroup (a b : R) :
    ⁅a, b⁆ ∈ commutatorAddSubgroup R := sorry

namespace CommutatorQuotient

/-- The canonical projection from a ring onto its additive commutator quotient. -/
abbrev mk : R →+ CommutatorQuotient R :=
  QuotientAddGroup.mk' (commutatorAddSubgroup R)

/-- The canonical projection sends `x` to its class in the additive commutator quotient. -/
theorem mk_apply (x : R) : mk x = QuotientAddGroup.mk x := sorry

/-- Ring commutators vanish in the additive commutator quotient. -/
theorem mk_lie (a b : R) : mk ⁅a, b⁆ = 0 := sorry

end CommutatorQuotient

end Ring

namespace Ring

variable {A : Type u} {Λ : Type v} [CommRing A] [Ring Λ] [Algebra A Λ]

/-- Scalar multiplication by an element of `A` preserves the additive commutator subgroup of `Λ`. -/
theorem smul_mem_commutatorAddSubgroup (a : A) {x : Λ}
    (hx : x ∈ commutatorAddSubgroup Λ) : a • x ∈ commutatorAddSubgroup Λ := sorry

namespace CommutatorQuotient

/-- The scalar multiplication on `Λ♮` induced by the `A`-action on `Λ`. -/
instance instSMul : SMul A (CommutatorQuotient Λ) where
  smul a := QuotientAddGroup.lift (commutatorAddSubgroup Λ)
    (mk.comp (DistribSMul.toAddMonoidHom Λ a)) (by
      intro x hx
      rw [AddMonoidHom.mem_ker]
      change mk (a • x) = 0
      exact (QuotientAddGroup.eq_zero_iff (a • x)).2
        (smul_mem_commutatorAddSubgroup a hx))

/-- Scalar multiplication on `Λ♮` is computed on representatives. -/
theorem smul_mk (a : A) (x : Λ) : a • mk x = mk (a • x) := sorry

/-- The `A`-module structure on the additive commutator quotient `Λ♮`. -/
instance instModule : Module A (CommutatorQuotient Λ) :=
  Function.Surjective.module A (QuotientAddGroup.mk' (commutatorAddSubgroup Λ))
    (QuotientAddGroup.mk'_surjective (commutatorAddSubgroup Λ)) fun a x => (smul_mk a x).symm

/-- The action of `A` on `Λ♮` is multiplication by the image of `algebraMap A Λ`. -/
theorem smul_mk_algebraMap (a : A) (x : Λ) :
    a • mk x = mk (algebraMap A Λ a * x) := sorry

variable (A) in
/-- The canonical `A`-linear projection from `Λ` to its additive commutator quotient. -/
def mkLinearMap : Λ →ₗ[A] CommutatorQuotient Λ where
  toFun := fun x ↦ mk x
  map_add' := mk.map_add
  map_smul' := fun a x ↦ (smul_mk a x).symm

variable (A) in
/-- The canonical `A`-linear projection sends each element to its quotient class. -/
theorem mkLinearMap_apply (x : Λ) : mkLinearMap A x = mk x := sorry

end CommutatorQuotient

end Ring
