module

public import stacks_project.Chap70.Lemma_70_19_1_BaseChange
public import stacks_project.Chap73.Lemma_73_9_3_FpqcCovering

/-!
# Stability of fpqc covering families of algebraic spaces

Fpqc covering families of algebraic spaces are stable under singleton
isomorphisms, dependent composition, and slice base change along an arbitrary
morphism.
-/

@[expose] public section

open CategoryTheory

universe u v w

namespace AlgebraicGeometry.AlgebraicSpace

/-- A singleton family generated by an isomorphism of algebraic spaces is an
fpqc covering. -/
theorem fpqcCovering_singleton_of_isIso {S : Scheme.{u}}
    {X X' : AlgebraicSpace S} (f : X' ⟶ X) [IsIso f] :
    FpqcCovering (fun _ : Unit ↦ Over.mk f) :=
  sorry

/-- Indexed composition of fpqc covering families of algebraic spaces is an
fpqc covering. -/
theorem fpqcCovering_comp {S : Scheme.{u}} {X : AlgebraicSpace S}
    {ι : Type v} {κ : ι → Type w} (family : ι → Over X)
    (refinement : (i : ι) → κ i → Over (family i).left)
    (hfamily : FpqcCovering family)
    (hrefinement : ∀ i, FpqcCovering (refinement i)) :
    FpqcCovering (fun p : Sigma κ ↦
      Over.mk ((refinement p.1 p.2).hom ≫ (family p.1).hom)) :=
  sorry

/-- Pulling an fpqc covering family of algebraic spaces back along a morphism
yields an fpqc covering. -/
theorem fpqcCovering_pullback {S : Scheme.{u}} {X X' : AlgebraicSpace S}
    {ι : Type v} (family : ι → Over X) (hfamily : FpqcCovering family)
    (f : X' ⟶ X) :
    FpqcCovering (fun i : ι ↦ (overPullback f).obj (family i)) :=
  sorry

end AlgebraicGeometry.AlgebraicSpace
