module

public import ReasLib.RingTheory.Ideal.Principal
public import ReasLib.RingTheory.LocalRing.DimensionOne
public import ReasLib.RingTheory.OrderOfVanishing.Power
import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Principal-power lengths in dimension one

The generic order-of-vanishing power API lives in
`ReasLib.RingTheory.OrderOfVanishing.Power`.  This leaf records the precise
one-dimensional local-ring surface in which the principal quotients have the
source interpretation.

@stack 0BWS
-/

universe u

open IsLocalRing

namespace IsLocalRing.DimensionOne

variable {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]

/-- Lemma 15.126.1 (1): if a maximal-ideal element avoids every minimal prime in a
one-dimensional Noetherian local ring, principal-power quotient lengths grow at most linearly. -/
@[stacks 0BWS "Lemma 15.126.1 (1), principal-power length upper bound"]
theorem principalPowerLength_le
    (hdim : ringKrullDim R = 1) (x : maximalIdeal R)
    (hx : ∀ p : minimalPrimes R, (x : R) ∉ p.1) (n : ℕ) :
    Module.length R (R ⧸ (principalIdeal (x : R)) ^ n) ≤
      n • Module.length R (R ⧸ principalIdeal (x : R)) := sorry
-- Proof strategy: rewrite the power of the principal ideal as the principal
-- ideal generated by `(x : R) ^ n`, identify both quotient lengths with
-- `Ring.ord`, and apply `Ring.ord_pow_le`.  The dimension and minimal-prime
-- hypotheses provide the finite-length interpretation of the two orders.

/-- Lemma 15.126.1 (2): under the same source setup, a nonzerodivisor has exactly linear
principal-power quotient lengths. -/
@[stacks 0BWS "Lemma 15.126.1 (2), principal-power length formula"]
theorem principalPowerLength_eq_of_mem_nonZeroDivisors
    (hdim : ringKrullDim R = 1) (x : maximalIdeal R)
    (hx : ∀ p : minimalPrimes R, (x : R) ∉ p.1)
    (hx_regular : (x : R) ∈ nonZeroDivisors R) (n : ℕ) :
    Module.length R (R ⧸ (principalIdeal (x : R)) ^ n) =
      n • Module.length R (R ⧸ principalIdeal (x : R)) := sorry
-- Proof strategy: perform the same principal-ideal and `Ring.ord` rewrites as
-- above, then use the exact nonzerodivisor formula `Ring.ord_pow`.

end IsLocalRing.DimensionOne
