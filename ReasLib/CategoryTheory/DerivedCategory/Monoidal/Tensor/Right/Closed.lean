    (T : DerivedTensor.Right.Monoidal.Model (C := C))
    (K L M : DerivedCategory C) [DerivedTensor.Right.Has (C := C)] :
    comparisonOf H T K L M =
      (DerivedTensor.Right.Monoidal.Model.objIsoTensor T
          ((MonoidalClosed.ihomOf H L).obj M) K).hom ≫
        MonoidalClosed.TensorRight.comparisonOf H K L M := rfl

/-- The derived tensor-to-iterated comparison is natural in the fixed tensor factor. -/
@[stacks 0A8U "derived tensor-to-iterated tensor naturality"]
theorem comparisonOf_natural_tensor
    (H : MonoidalClosed (DerivedCategory C))
    (T : DerivedTensor.Right.Monoidal.Model (C := C))
    {K₁ K₂ L M : DerivedCategory C} (fK : K₁ ⟶ K₂)
    [DerivedTensor.Right.Has (C := C)] :
