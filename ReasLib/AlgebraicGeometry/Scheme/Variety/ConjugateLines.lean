module

public import Mathlib.Algebra.Algebra.Rat
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.AlgebraicGeometry.Properties
public import Mathlib.LinearAlgebra.FiniteDimensional.Defs
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import ReasLib.AlgebraicGeometry.Scheme.FieldExtension.Basic
public import ReasLib.AlgebraicGeometry.Scheme.Variety.Product.Counterexample

/-!
# Crossing conjugate lines over `ℚ`

This file constructs the affine hypersurface
`Spec (ℚ[x, y] / (x ^ 2 + y ^ 2))` and its base change along the finite
extension `ratSqrtNegOne / ℚ`.
-/

@[expose] public section

noncomputable section

open CategoryTheory MvPolynomial

namespace AlgebraicGeometry.ConjugateLines

/-- The hypersurface polynomial `X 0 ^ 2 + X 1 ^ 2` in two variables over `ℚ`. -/
def equation : MvPolynomial (Fin 2) ℚ :=
  X 0 ^ 2 + X 1 ^ 2

/-- The principal ideal generated by `equation`. -/
def ideal : Ideal (MvPolynomial (Fin 2) ℚ) :=
  Ideal.span {equation}

/-- The coordinate ring `ℚ[x, y] / (x ^ 2 + y ^ 2)`. -/
abbrev CoordinateRing : Type :=
  MvPolynomial (Fin 2) ℚ ⧸ ideal

/-- The defining equation vanishes in `CoordinateRing`. -/
theorem mk_equation_eq_zero :
    Ideal.Quotient.mk ideal equation = 0 := sorry

/-- The affine scheme cut out by `x ^ 2 + y ^ 2` over `ℚ`. -/
def scheme : Scheme :=
  Spec (CommRingCat.of CoordinateRing)

/-- The structure morphism from `scheme` to `Spec ℚ`. -/
def toSpecRat : scheme ⟶ Spec (CommRingCat.of ℚ) :=
  Spec.map (CommRingCat.ofHom (algebraMap ℚ CoordinateRing))

/-- The linear factor `X 0 + i * X 1` over `ratSqrtNegOne`. -/
def plusLinear : MvPolynomial (Fin 2) ratSqrtNegOne :=
  X 0 + C (AdjoinRoot.root ratSqrtNegOnePolynomial) * X 1

/-- The conjugate linear factor `X 0 - i * X 1` over `ratSqrtNegOne`. -/
def minusLinear : MvPolynomial (Fin 2) ratSqrtNegOne :=
  X 0 - C (AdjoinRoot.root ratSqrtNegOnePolynomial) * X 1

/-- `X ^ 2 + 1` is irreducible over `ℚ`. -/
instance instIrreduciblePolynomial :
    Fact (Irreducible ratSqrtNegOnePolynomial) := sorry

/-- The base change of `equation` to `ratSqrtNegOne` splits into conjugate linear factors. -/
theorem map_equation_eq_mul :
    MvPolynomial.map (algebraMap ℚ ratSqrtNegOne) equation = plusLinear * minusLinear := sorry

/-- `ratSqrtNegOne` is a finite extension of `ℚ`. -/
instance instFiniteDimensionalExtension : FiniteDimensional ℚ ratSqrtNegOne := sorry

/-- The affine scheme `scheme` is irreducible. -/
instance instIrreducibleSpace : IrreducibleSpace scheme := sorry

/-- The fiber product of `scheme` with `Spec ratSqrtNegOne` over `Spec ℚ`. -/
def baseChange : Scheme :=
  FieldExtension.baseChange ℚ ratSqrtNegOne toSpecRat

/-- The finite base change `baseChange` is connected. -/
instance instConnectedSpaceBaseChange : ConnectedSpace baseChange := sorry

/-- The finite base change `baseChange` is reducible. -/
theorem not_irreducibleSpace_baseChange : ¬ IrreducibleSpace baseChange := sorry

/-- The scheme `scheme` is irreducible, while its base change is connected but not irreducible
`ratSqrtNegOne / ℚ`. -/
theorem conjugateLinesExample :
    IrreducibleSpace scheme ∧
      FiniteDimensional ℚ ratSqrtNegOne ∧
      ConnectedSpace baseChange ∧
      ¬ IrreducibleSpace baseChange := sorry

end AlgebraicGeometry.ConjugateLines
