namespace FieldExtension

/-- The rational function field in one variable has transcendence degree one over its base
field. -/
theorem ratFuncTrdegEqOne (k : Type u) [Field k] :
    Algebra.trdeg k (RatFunc k) = 1 := by
  let e : RatFunc k ≃ₐ[k] FractionRing (Polynomial k) := RatFunc.toFractionRingAlgEquiv k k
  -- Local instance justification (proof-local temporary data): the fraction field is algebraic over the polynomial ring when computing the tower's transcendence degree.
  letI : Algebra.IsAlgebraic (Polynomial k) (FractionRing (Polynomial k)) := by
    exact (IsFractionRing.comap_isAlgebraic_iff (A := Polynomial k)
      (K := FractionRing (Polynomial k)) (C := FractionRing (Polynomial k))).2 inferInstance
  have hfrac : Algebra.trdeg (Polynomial k) (FractionRing (Polynomial k)) = 0 := by
    simpa using
      (trdeg_eq_zero : Algebra.trdeg (Polynomial k) (FractionRing (Polynomial k)) = 0)
  have hpoly : Algebra.trdeg k (Polynomial k) = 1 := Polynomial.trdeg_of_isDomain
  have htrdegFrac : Algebra.trdeg k (FractionRing (Polynomial k)) = 1 := by
    have hsum := trdeg_add_eq k (Polynomial k) (A := FractionRing (Polynomial k))
    rw [hpoly, hfrac] at hsum
    simpa using hsum.symm
  simpa [htrdegFrac] using e.trdeg_eq

/-- Every finite extension of a one-variable rational function field has transcendence degree
one over the base field. -/
theorem trdegEqOneOfFiniteDimensionalOverRatFunc
    {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]
    [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K]
    [FiniteDimensional (RatFunc k) K] :
    Algebra.trdeg k K = 1 := by
  -- Local instance justification (proof-local temporary data): finite dimensionality makes the upper layer algebraic, so it contributes zero transcendence degree.
  letI : Algebra.IsAlgebraic (RatFunc k) K := Algebra.IsAlgebraic.of_finite (RatFunc k) K
  have htop : Algebra.trdeg (RatFunc k) K = 0 := by
    simpa using (trdeg_eq_zero : Algebra.trdeg (RatFunc k) K = 0)
  have hsum := lift_trdeg_add_eq k (RatFunc k) K
  rw [ratFuncTrdegEqOne k, htop] at hsum
  simpa using hsum.symm

/-- If a field is algebraic over the simple field generated by a transcendental element, then it
has transcendence degree one over the original base field. -/
theorem trdegEqOneOfTranscendentalIsAlgebraicOverAdjoinSimple
    {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]
    {t : K} (ht : Transcendental k t)
    (halg : Algebra.IsAlgebraic (↥k⟮t⟯) K) :
    Algebra.trdeg k K = 1 := by
  let x : ULift.{v} (Fin 1) → K := fun _ ↦ t
  have hx : AlgebraicIndependent k x := by
    rw [algebraicIndependent_singleton_iff (ULift.up 0)]
    simpa [x] using ht
  have hx_range : Set.range x = ({t} : Set K) := by
    ext z
    simp [x]
  have halgField : Algebra.IsAlgebraic (IntermediateField.adjoin k (Set.range x)) K := by
    rw [hx_range]
    simpa using halg
  have halg' : Algebra.IsAlgebraic (Algebra.adjoin k (Set.range x)) K := by
    exact IntermediateField.isAlgebraic_adjoin_iff_top.mp halgField
  -- Local instance justification (proof-local temporary data): this is the algebraicity witness required by the transcendence-basis constructor for the singleton family.
  letI : Algebra.IsAlgebraic (Algebra.adjoin k (Set.range x)) K := halg'
  have hbasis : IsTranscendenceBasis k x := by
    refine AlgebraicIndependent.isTranscendenceBasis_of_trdeg_le_of_finite
      (R := k) (A := K) (ι := ULift.{v} (Fin 1)) (x := x) hx ?_
    simpa [x] using (Algebra.IsAlgebraic.trdeg_le_cardinalMk k (Set.range x))
  have hcard := IsTranscendenceBasis.cardinalMk_eq_trdeg
    (R := k) (A := K) (ι := ULift.{v} (Fin 1)) (x := x) hbasis
  simpa using hcard.symm

/-- In a transcendence-degree-one field extension, every transcendental element generates a
simple subfield over which the ambient field is algebraic. -/
theorem isAlgebraicAdjoinSimpleOfTranscendentalOfTrdegEqOne
    {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]
    {t : K} (ht : Transcendental k t) (htrdeg : Algebra.trdeg k K = 1) :
    Algebra.IsAlgebraic (↥k⟮t⟯) K := by
  let x : Unit → K := fun _ ↦ t
  have hx_range : Set.range x = ({t} : Set K) := by
    ext z
    simp [x]
  have hx_ind : AlgebraicIndependent k x := by
    rw [algebraicIndependent_singleton_iff ()]
    exact ht
  have hx_basis : IsTranscendenceBasis k x := by
    refine hx_ind.isTranscendenceBasis_of_lift_trdeg_le_of_finite ?_
    rw [htrdeg]
    simp
  change Algebra.IsAlgebraic (IntermediateField.adjoin k ({t} : Set K)) K
  rw [← hx_range]
  exact hx_basis.isAlgebraic_field

/-- A field extension of transcendence degree one contains an element outside the image of its
base field. -/
theorem existsNotMemRangeAlgebraMapOfTrdegEqOne
    {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]
    (htrdeg : Algebra.trdeg k K = 1) :
    ∃ t : K, t ∉ Set.range (algebraMap k K) := by
  classical
  by_contra h
  have h_range : ∀ t : K, t ∈ Set.range (algebraMap k K) := by
    intro t
    by_contra ht
    exact h ⟨t, ht⟩
  have h_alg : Algebra.IsAlgebraic k K := by
    exact ⟨fun t ↦ by
      obtain ⟨c, hc⟩ := h_range t
      rw [← hc]
      exact isAlgebraic_algebraMap (A := K) c⟩
  have hzero : Algebra.trdeg k K = 0 := by
    -- Local instance justification (proof-local temporary data): the assumed surjectivity of the base map makes the whole extension algebraic.
    letI : Algebra.IsAlgebraic k K := h_alg
    simpa using (trdeg_eq_zero : Algebra.trdeg k K = 0)
  rw [htrdeg] at hzero
  exact one_ne_zero hzero

/-- The distinguished generator of a simple field extension generates that extension over the
base field. -/
theorem simpleExtensionGenAdjoinEqTop
    {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E] {t : E} :
    F⟮(gen F t : F⟮t⟯)⟯ = (⊤ : IntermediateField F F⟮t⟯) := by
  apply IntermediateField.lift_injective (F⟮t⟯)
  calc
    IntermediateField.lift F⟮(gen F t : F⟮t⟯)⟯ = F⟮t⟯ := by
      simp
    _ = IntermediateField.lift (⊤ : IntermediateField F F⟮t⟯) := by
      simp

/-- A simple-extension generator is integral over the subfield generated by any nonzero natural
power of that generator. -/
theorem simpleExtensionGenIsIntegralOverPow
    {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]
    {t : E} {n : ℕ} (hn : n ≠ 0) :
    IsIntegral (F⟮((gen F t : F⟮t⟯) ^ n)⟯) (gen F t : F⟮t⟯) := by
  let K := F⟮t⟯
  let g : K := gen F t
  let Kpow : IntermediateField F K := F⟮g ^ n⟯
  let gpow : Kpow := gen F (g ^ n)
  refine ⟨X ^ n - C gpow, Polynomial.monic_X_pow_sub_C gpow hn, ?_⟩
  simp [K, g, Kpow, gpow]

/-- A simple field extension is algebraic over the subfield generated by any nonzero natural
power of its distinguished generator. -/
theorem simpleExtensionIsAlgebraicOverGenPow
    {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]
    {t : E} {n : ℕ} (hn : n ≠ 0) :
    Algebra.IsAlgebraic (F⟮((gen F t : F⟮t⟯) ^ n)⟯) F⟮t⟯ := by
  let K := F⟮t⟯
  let g : K := gen F t
  let Kpow : IntermediateField F K := F⟮g ^ n⟯
  have hFg_top : F⟮g⟯ = (⊤ : IntermediateField F K) := by
    simpa [K, g] using (simpleExtensionGenAdjoinEqTop (F := F) (t := t))
  have hKpow_g_top : IntermediateField.adjoin Kpow ({g} : Set K) = ⊤ :=
    IntermediateField.adjoin_eq_top_of_adjoin_eq_top F hFg_top
  have htop : Algebra.IsAlgebraic Kpow (⊤ : IntermediateField Kpow K) := by
    rw [← hKpow_g_top]
    simpa [K, g, Kpow] using
      (IntermediateField.isAlgebraic_adjoin_simple
        (simpleExtensionGenIsIntegralOverPow (F := F) (t := t) hn))
  simpa [K, Kpow] using
    ((IntermediateField.topEquiv : (⊤ : IntermediateField Kpow K) ≃ₐ[Kpow] K).isAlgebraic)

/-- In a simple transcendental extension, every positive natural power of the distinguished
generator is a singleton transcendence basis. -/
theorem simpleExtensionGenPowIsTranscendenceBasis
    {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]
    {t : E} (ht : Transcendental F t) {n : ℕ} (hn : 0 < n) :
    IsTranscendenceBasis F (fun _ : Unit ↦ (gen F t : F⟮t⟯) ^ n) := by
  let K := F⟮t⟯
  let g : K := gen F t
  let y : Unit → K := fun _ ↦ g ^ n
  have hy_adjoin : IntermediateField.adjoin F (Set.range y) = F⟮g ^ n⟯ := by
    simp [y]
  have hg_trans : Transcendental F g := by
    rw [← transcendental_algebraMap_iff (FaithfulSMul.algebraMap_injective K E)]
    simpa [K, g] using ht
  have hy_ind : AlgebraicIndependent F y := by
    rw [algebraicIndependent_singleton_iff Unit.unit]
    simpa [y] using hg_trans.pow hn
  have hKy_alg_if : Algebra.IsAlgebraic (IntermediateField.adjoin F (Set.range y)) K := by
    rw [hy_adjoin]
    simpa [K, g] using
      (simpleExtensionIsAlgebraicOverGenPow (F := F) (t := t) (Nat.ne_of_gt hn))
  have hKy_alg : Algebra.IsAlgebraic (Algebra.adjoin F (Set.range y)) K :=
    IntermediateField.isAlgebraic_adjoin_iff_top.mp hKy_alg_if
  exact hy_ind.isTranscendenceBasis_iff_isAlgebraic.mpr hKy_alg

end FieldExtension
