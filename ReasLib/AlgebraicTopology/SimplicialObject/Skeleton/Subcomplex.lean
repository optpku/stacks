module

public import ReasLib.AlgebraicTopology.SimplicialObject.Skeleton.Dimension
public import ReasLib.AlgebraicTopology.SimplicialSet.Skeleton
public import ReasLib.AlgebraicTopology.SimplicialSet.Subcomplex.Range

/-!
@stack 018P

# The simplicial skeleton as a generated subcomplex

For simplicial sets, the counit of the skeleton/truncation adjunction is a monomorphism whose
range is the subcomplex generated in degrees at most the truncation bound. This supplies the
canonical isomorphism anticipated by the simplicial-set skeleton API.
-/

@[expose] public section

open CategoryTheory Opposite
open scoped Simplicial

noncomputable section

universe u

namespace SSet

namespace skeleton

/-- A simplicial map carries the subcomplex generated in degrees below `n` into the corresponding
generated subcomplex of its target. -/
@[stacks 018P "functoriality of the generated skeleton subcomplex"]
theorem map_range_le (n : ℕ) {U V : SSet.{u}} (f : U ⟶ V) :
    Subcomplex.range ((U.skeleton n).ι ≫ f) ≤ V.skeleton n := sorry

/-- The restriction of a simplicial map to the subcomplexes generated in degrees below `n`. -/
@[stacks 018P "map on generated skeleton subcomplexes"]
def map (n : ℕ) {U V : SSet.{u}} (f : U ⟶ V) :
    (U.skeleton n : SSet.{u}) ⟶ (V.skeleton n : SSet.{u}) :=
  Subcomplex.lift ((U.skeleton n).ι ≫ f) (map_range_le n f)

/-- Restricting a simplicial map and then including it into the target recovers its restriction
along the source inclusion. -/
@[reassoc, stacks 018P "generated skeleton map followed by inclusion"]
theorem map_comp_ι (n : ℕ) {U V : SSet.{u}} (f : U ⟶ V) :
    map n f ≫ (V.skeleton n).ι = (U.skeleton n).ι ≫ f := sorry

/-- Restriction to generated skeleton subcomplexes preserves identity morphisms. -/
@[stacks 018P "generated skeleton map identity law"]
theorem map_id (n : ℕ) (U : SSet.{u}) :
    map n (𝟙 U) = 𝟙 (U.skeleton n : SSet.{u}) := sorry

/-- Restriction to generated skeleton subcomplexes preserves composition. -/
@[stacks 018P "generated skeleton map composition law"]
theorem map_comp (n : ℕ) {U V W : SSet.{u}} (f : U ⟶ V) (g : V ⟶ W) :
    map n (f ≫ g) = map n f ≫ map n g := sorry

/-- The endofunctor sending a simplicial set to its subcomplex generated in degrees below `n`. -/
@[stacks 018P "generated skeleton subcomplex endofunctor"]
def functor (n : ℕ) : SSet.{u} ⥤ SSet.{u} where
  obj U := (U.skeleton n : SSet.{u})
  map f := skeleton.map n f
  map_id U := skeleton.map_id n U
  map_comp f g := skeleton.map_comp n f g

/-- The natural inclusion of the generated skeleton subcomplex into the ambient simplicial set. -/
@[stacks 018P "natural inclusion of generated skeleton subcomplexes"]
def ι (n : ℕ) : functor n ⟶ 𝟭 (SSet.{u}) where
  app U := (U.skeleton n).ι
  naturality := fun {_ _} f ↦ skeleton.map_comp_ι n f

namespace ι

/-- The component of the natural generated-skeleton inclusion is the subcomplex inclusion. -/
@[simp, stacks 018P "component of the generated skeleton inclusion"]
theorem app (n : ℕ) (U : SSet.{u}) :
    (ι n).app U = (U.skeleton n).ι := sorry

end ι

end skeleton

/-- The counit from the simplicial `n`-skeleton is a monomorphism of simplicial sets. -/
@[stacks 018P "the simplicial-set skeleton counit is a monomorphism"]
instance skAdj.counit.mono (n : ℕ) (U : SSet.{u}) :
    Mono ((skAdj n).counit.app U) := sorry

/-- The range of the skeleton counit is the subcomplex generated by simplices in degrees at most
`n`. -/
@[stacks 018P "range of the simplicial-set skeleton counit"]
theorem skAdj.counit.range (n : ℕ) (U : SSet.{u}) :
    Subcomplex.range ((skAdj n).counit.app U) = U.skeleton (n + 1) := sorry

/-- The canonical isomorphism from the simplicial `n`-skeleton to the range of its counit. -/
@[stacks 018P "the skeleton counit identifies its source with its range"]
noncomputable def skAdj.counit.rangeIso (n : ℕ) (U : SSet.{u}) :
    (sk n).obj U ≅ (Subcomplex.range ((skAdj n).counit.app U) : SSet) :=
  Subcomplex.toRange.iso ((skAdj n).counit.app U)

/-- The hom of the canonical range isomorphism followed by the range inclusion is the
skeleton counit. -/
@[reassoc, stacks 018P "canonical range comparison over the ambient simplicial set"]
theorem skAdj.counit.rangeIso.hom_comp_ι (n : ℕ) (U : SSet.{u}) :
    (skAdj.counit.rangeIso n U).hom ≫
      (Subcomplex.range ((skAdj n).counit.app U)).ι =
        (skAdj n).counit.app U := sorry

/-- The inverse range comparison followed by the skeleton counit is the range inclusion. -/
@[reassoc, stacks 018P "inverse range comparison over the ambient simplicial set"]
theorem skAdj.counit.rangeIso.inv_comp_counit (n : ℕ) (U : SSet.{u}) :
    (skAdj.counit.rangeIso n U).inv ≫ (skAdj n).counit.app U =
      (Subcomplex.range ((skAdj n).counit.app U)).ι := sorry

/-- The canonical isomorphism from the simplicial `n`-skeleton to the subcomplex of `U`
generated by simplices in degrees at most `n`, given an explicit range identification. -/
@[stacks 018P "skeleton comparison from an explicit range identification"]
noncomputable def skAdj.counit.isoOfRange (n : ℕ) (U : SSet.{u})
    (h : Subcomplex.range ((skAdj n).counit.app U) = U.skeleton (n + 1)) :
    (sk n).obj U ≅ (U.skeleton (n + 1) : SSet) :=
  skAdj.counit.rangeIso n U ≪≫ Subcomplex.eqToIso h

/-- The explicit-range skeleton comparison identifies the subcomplex inclusion with the counit. -/
@[reassoc, stacks 018P "explicit-range skeleton comparison over the ambient simplicial set"]
theorem skAdj.counit.isoOfRange.hom_comp_ι (n : ℕ) (U : SSet.{u})
    (h : Subcomplex.range ((skAdj n).counit.app U) = U.skeleton (n + 1)) :
    (skAdj.counit.isoOfRange n U h).hom ≫ (U.skeleton (n + 1)).ι =
      (skAdj n).counit.app U := sorry

/-- The inverse of the explicit-range comparison followed by the counit is the generated
subcomplex inclusion. -/
@[reassoc, stacks 018P "inverse explicit-range skeleton comparison"]
theorem skAdj.counit.isoOfRange.inv_comp_counit (n : ℕ) (U : SSet.{u})
    (h : Subcomplex.range ((skAdj n).counit.app U) = U.skeleton (n + 1)) :
    (skAdj.counit.isoOfRange n U h).inv ≫ (skAdj n).counit.app U =
      (U.skeleton (n + 1)).ι := sorry

/-- The explicit-range skeleton comparisons are natural once range identifications for the two
objects are supplied. -/
@[stacks 018P "naturality of explicit-range skeleton comparisons"]
theorem skAdj.counit.isoOfRange.naturality (n : ℕ) {U V : SSet.{u}} (f : U ⟶ V)
    (hU : Subcomplex.range ((skAdj n).counit.app U) = U.skeleton (n + 1))
    (hV : Subcomplex.range ((skAdj n).counit.app V) = V.skeleton (n + 1)) :
    (sk n).map f ≫ (skAdj.counit.isoOfRange n V hV).hom =
      (skAdj.counit.isoOfRange n U hU).hom ≫ skeleton.map (n + 1) f := sorry

/-- The inverse explicit-range skeleton comparisons satisfy the symmetric naturality formula. -/
@[stacks 018P "inverse naturality of explicit-range skeleton comparisons"]
theorem skAdj.counit.isoOfRange.inv_naturality (n : ℕ) {U V : SSet.{u}} (f : U ⟶ V)
    (hU : Subcomplex.range ((skAdj n).counit.app U) = U.skeleton (n + 1))
    (hV : Subcomplex.range ((skAdj n).counit.app V) = V.skeleton (n + 1)) :
    skeleton.map (n + 1) f ≫ (skAdj.counit.isoOfRange n V hV).inv =
      (skAdj.counit.isoOfRange n U hU).inv ≫ (sk n).map f := sorry

namespace skeleton

/-- The canonical objectwise comparison from the simplicial skeleton to the generated subcomplex.
The range equality is supplied by the canonical `skAdj.counit.range` theorem. -/
@[stacks 018P "canonical objectwise skeleton-generated comparison"]
noncomputable def isoApp (n : ℕ) (U : SSet.{u}) :
    (sk n).obj U ≅ (functor (n + 1)).obj U :=
  skAdj.counit.isoOfRange n U (skAdj.counit.range n U)

namespace isoApp

/-- The canonical objectwise skeleton-generated comparison is natural in the simplicial set. -/
@[stacks 018P "naturality of the canonical skeleton-generated comparison"]
theorem naturality (n : ℕ) {U V : SSet.{u}} (f : U ⟶ V) :
    (sk n).map f ≫ (isoApp n V).hom = (isoApp n U).hom ≫ skeleton.map (n + 1) f := sorry

/-- The canonical objectwise comparison followed by the generated inclusion is the skeleton
counit. -/
@[reassoc, stacks 018P "canonical skeleton comparison over the ambient object"]
theorem hom_comp_ι (n : ℕ) (U : SSet.{u}) :
    (isoApp n U).hom ≫ (U.skeleton (n + 1)).ι = (skAdj n).counit.app U := sorry

/-- The inverse canonical comparison followed by the skeleton counit is the generated inclusion. -/
@[reassoc, stacks 018P "inverse canonical skeleton comparison"]
theorem inv_comp_counit (n : ℕ) (U : SSet.{u}) :
    (isoApp n U).inv ≫ (skAdj n).counit.app U = (U.skeleton (n + 1)).ι := sorry

end isoApp

/-- The canonical natural isomorphism from Mathlib's simplicial skeleton to the generated-
subcomplex endofunctor. -/
@[stacks 018P "simplicial skeleton as the generated-subcomplex endofunctor"]
noncomputable def iso (n : ℕ) : sk n ≅ functor (n + 1) :=
  NatIso.ofComponents (fun U ↦ isoApp n U) (fun f ↦ isoApp.naturality n f)

namespace iso

/-- The forward component of the canonical natural skeleton comparison. -/
@[simp, stacks 018P "forward component of the canonical skeleton comparison"]
theorem hom_app (n : ℕ) (U : SSet.{u}) :
    (iso n).hom.app U = (isoApp n U).hom := sorry

/-- The inverse component of the canonical natural skeleton comparison. -/
@[simp, stacks 018P "inverse component of the canonical skeleton comparison"]
theorem inv_app (n : ℕ) (U : SSet.{u}) :
    (iso n).inv.app U = (isoApp n U).inv := sorry

/-- The canonical natural comparison followed by the generated inclusion is the skeleton counit. -/
@[reassoc, stacks 018P "natural skeleton comparison over the identity functor"]
theorem hom_ι (n : ℕ) :
    (iso n).hom ≫ skeleton.ι (n + 1) = (skAdj n).counit := sorry

/-- The inverse canonical natural comparison followed by the skeleton counit is the natural
generated-subcomplex inclusion. -/
@[reassoc, stacks 018P "inverse natural skeleton comparison over the identity functor"]
theorem inv_counit (n : ℕ) :
    (iso n).inv ≫ (skAdj n).counit = skeleton.ι (n + 1) := sorry

end iso

end skeleton

end SSet
