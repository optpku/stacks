module

public import Mathlib.Algebra.Field.Basic
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.Coordinate
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.HilbertPolynomial
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.Twist
public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.IdealClosure
public import ReasLib.AlgebraicGeometry.Scheme.Module.Coherent
public import ReasLib.RingTheory.GradedAlgebra.Quotient

/-!
# The standard coordinate line in projective space

The closed subscheme `V₊(X_2, …, X_n) ⊂ ProjectiveSpace.scheme k n` for `1 ≤ n`,
realized as `Proj` of the corresponding homogeneous quotient, together with the
pushforward of the restriction of a twisting sheaf along that line.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.ProjectiveSpace.StandardLine

/-- The homogeneous coordinates `X_i` for `2 ≤ i` cutting out the standard
coordinate line in `ProjectiveSpace.scheme k n`. When `n = 1` this set is empty. -/
def generators (k : Type u) [Field k] (n : ℕ) :
    Set (MvPolynomial (Fin (n + 1)) k) :=
  Set.image (coordinate n : Fin (n + 1) → MvPolynomial (Fin (n + 1)) k)
    {i : Fin (n + 1) | 2 ≤ (i : ℕ)}

/-- The ideal generated by `X_2, …, X_n` is homogeneous for the standard grading
on `k[X_0, …, X_n]`. -/
theorem spanIdeal_isHomogeneous (k : Type u) [Field k] (n : ℕ) (hn : 1 ≤ n) :
    (Ideal.span (generators k n)).IsHomogeneous (grading k n) := sorry

/-- The homogeneous ideal of the standard coordinate line
`V₊(X_2, …, X_n) ⊂ ProjectiveSpace.scheme k n`. -/
def ideal (k : Type u) [Field k] (n : ℕ) (hn : 1 ≤ n) :
    HomogeneousIdeal (grading k n) where
  toSubmodule := Ideal.span (generators k n)
  is_homogeneous' := spanIdeal_isHomogeneous k n hn

/-- The underlying ideal of `ideal k n hn` is the span of the coordinates `X_i`
for `2 ≤ i`. -/
theorem ideal_toIdeal (k : Type u) [Field k] (n : ℕ) (hn : 1 ≤ n) :
    (ideal k n hn).toIdeal = Ideal.span (generators k n) := sorry

/-- The quotient grading on `k[X_0, …, X_n] ⧸ (X_2, …, X_n)`. -/
abbrev quotientGrading (k : Type u) [Field k] (n : ℕ) (hn : 1 ≤ n) :
    ℕ → Submodule k (MvPolynomial (Fin (n + 1)) k ⧸ (ideal k n hn).toIdeal) :=
  GradedAlgebra.Quotient.grading (grading k n) (ideal k n hn).toIdeal

/-- The quotient by `ideal k n hn` carries its canonical graded-algebra structure. -/
noncomputable instance instGradedAlgebra (k : Type u) [Field k] (n : ℕ)
    (hn : 1 ≤ n) :
    GradedAlgebra (quotientGrading k n hn) :=
  GradedAlgebra.Quotient.gradedAlgebra (grading k n)
    (ideal k n hn).toIdeal (ideal k n hn).isHomogeneous

/-- The standard coordinate line in `ProjectiveSpace.scheme k n`, realized as
`Proj` of the homogeneous quotient by `X_2, …, X_n`. -/
abbrev scheme (k : Type u) [Field k] (n : ℕ) (hn : 1 ≤ n) : Scheme :=
  Proj (quotientGrading k n hn)

/-- The closed immersion of the standard coordinate line into
`ProjectiveSpace.scheme k n`. -/
def ι (k : Type u) [Field k] (n : ℕ) (hn : 1 ≤ n) :
    scheme k n hn ⟶ ProjectiveSpace.scheme k n :=
  projQuotientMap (grading k n) (ideal k n hn)

/-- The morphism `ι k n hn` is a closed immersion. -/
instance instIsClosedImmersion_ι (k : Type u) [Field k] (n : ℕ) (hn : 1 ≤ n) :
    IsClosedImmersion (ι k n hn) :=
  projQuotientMap_isClosedImmersion (grading k n) (ideal k n hn)

/-- The pushforward along `ι k n hn` of the pullback of `twistingSheaf k n d`. -/
def twistPushforward (k : Type u) [Field k] (n : ℕ) (hn : 1 ≤ n) (d : ℤ) :
    (ProjectiveSpace.scheme k n).Modules :=
  (Scheme.Modules.pushforward (ι k n hn)).obj
    ((Scheme.Modules.pullback (ι k n hn)).obj (twistingSheaf k n d))

/-- The sheaf `twistPushforward k n hn d` is coherent. -/
instance instIsCoherent_twistPushforward (k : Type u) [Field k] (n : ℕ)
    (hn : 1 ≤ n) (d : ℤ) :
    (twistPushforward k n hn d).IsCoherent := sorry

/-- The Hilbert polynomial of `twistPushforward k n hn d` is `fun t ↦ t + d + 1`. -/
theorem hilbertPolynomial_eq (k : Type u) [Field k] (n : ℕ) (hn : 1 ≤ n)
    (d : ℤ) :
    hilbertPolynomial k n (twistPushforward k n hn d) = fun t ↦ t + d + 1 :=
  sorry

/-- `Polynomial.X + Polynomial.C (d + 1 : ℚ)` is a Hilbert polynomial of
`twistPushforward k n hn d`. -/
theorem isHilbertPolynomial (k : Type u) [Field k] (n : ℕ) (hn : 1 ≤ n)
    (d : ℤ) :
    IsHilbertPolynomial k n (twistPushforward k n hn d)
      (Polynomial.X + Polynomial.C (d + 1 : ℚ)) := sorry

/-- For `1 ≤ n`, the pushforward
`twistPushforward k n hn (-102)` of the restriction of `twistingSheaf k n (-102)`
along the standard coordinate line in `ProjectiveSpace.scheme k n` is a coherent
sheaf whose Hilbert polynomial is `fun t ↦ t - 101`. -/
theorem hilbertPolynomial_twistPushforward_neg102
    (k : Type u) [Field k] (n : ℕ) (hn : 1 ≤ n) :
    hilbertPolynomial k n (twistPushforward k n hn (-102)) =
      fun t ↦ t - 101 := sorry

/-- The exhibited coherent sheaf has Hilbert polynomial
`Polynomial.X - Polynomial.C (101 : ℚ)`. -/
theorem isHilbertPolynomial_twistPushforward_neg102
    (k : Type u) [Field k] (n : ℕ) (hn : 1 ≤ n) :
    IsHilbertPolynomial k n (twistPushforward k n hn (-102))
      (Polynomial.X - Polynomial.C (101 : ℚ)) := sorry

end AlgebraicGeometry.ProjectiveSpace.StandardLine
