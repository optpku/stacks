module

public import ReasLib.Algebra.Category.ModuleCat.FiniteFree
public import Mathlib.CategoryTheory.ObjectProperty.Ind
public import Mathlib.RingTheory.Flat.Basic
import Mathlib.Tactic.CrossRefAttribute

/-!
# Lazard's theorem for bundled modules

This leaf identifies flat bundled modules with the ind-completion of the
finite-free object property.

@stack 058G
-/

@[expose] public section

open CategoryTheory

universe u

namespace CategoryTheory.ModuleCat

variable {R : Type u} [CommRing R]

/-- Theorem 10.81.4 (Lazard's theorem): a module is flat exactly when it is an
ind-object generated by finite-free modules. -/
@[stacks 058G]
theorem flat_iff_ind_finiteFree (M : ModuleCat.{u} R) :
    Module.Flat R M ↔ (finiteFree R).ind.{u} M := sorry

end CategoryTheory.ModuleCat
