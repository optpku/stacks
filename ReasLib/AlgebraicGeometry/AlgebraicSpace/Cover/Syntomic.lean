module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Morphism.Syntomic
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Precoverage

/-!
# Syntomic covering families of algebraic spaces

Syntomic covering families are jointly surjective families of syntomic morphisms,
expressed through the canonical morphism-property precoverage.
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u v w

namespace AlgebraicGeometry.AlgebraicSpace

variable {S : Scheme.{u}} {X : AlgebraicSpace S} {ι : Type v}

/-- The map on points induced by an indexed family of algebraic spaces over `X`. -/
def syntomicCoveringPointMap (family : ι → Over X) :
    (Σ i, Points (family i).left) → Points X :=
  fun p ↦ Points.map (family p.1).hom p.2

/-- The point map of an indexed family evaluates by the induced map of the corresponding
structure morphism. -/
@[simp] theorem syntomicCoveringPointMap_apply
    (family : ι → Over X) (p : Σ i, Points (family i).left) :
    syntomicCoveringPointMap family p = Points.map (family p.1).hom p.2 :=
  rfl

/-- A syntomic covering of `X` is an indexed family in the precoverage of jointly
surjective syntomic morphisms of algebraic spaces over `S`. -/
abbrev SyntomicCovering (family : ι → Over X) : Prop :=
  Presieve.ofArrows (fun i ↦ (family i).left) (fun i ↦ (family i).hom) ∈
    precoverage (fun {_ _} f ↦ Syntomic f) X

/-- The pointwise characterization of a syntomic covering: memberwise syntomicity and joint
surjectivity. -/
theorem syntomicCovering_iff (family : ι → Over X) :
    SyntomicCovering family ↔
      (∀ i, Syntomic (family i).hom) ∧
        Function.Surjective (syntomicCoveringPointMap family) :=
  sorry

namespace SyntomicCovering

/-- Every member of a syntomic covering is a syntomic morphism. -/
theorem syntomic {family : ι → Over X} (h : SyntomicCovering family) (i : ι) :
    Syntomic (family i).hom :=
  ((syntomicCovering_iff family).mp h).1 i

/-- The total point map of a syntomic covering is surjective. -/
theorem surjective_pointMap {family : ι → Over X} (h : SyntomicCovering family) :
    Function.Surjective (syntomicCoveringPointMap family) :=
  ((syntomicCovering_iff family).mp h).2

/-- A memberwise syntomic family with a surjective total point map is a syntomic covering. -/
def of (family : ι → Over X) (h_syntomic : ∀ i, Syntomic (family i).hom)
    (h_surj : Function.Surjective (syntomicCoveringPointMap family)) :
    SyntomicCovering family :=
  (syntomicCovering_iff family).mpr ⟨h_syntomic, h_surj⟩

/-- A syntomic covering consists of syntomic members whose total point map is surjective. -/
theorem spec {family : ι → Over X} (h : SyntomicCovering family) :
    (∀ i, Syntomic (family i).hom) ∧
      Function.Surjective (syntomicCoveringPointMap family) :=
  (syntomicCovering_iff family).mp h

/-- A syntomic covering is a memberwise syntomic family whose images of points cover `|X|`. -/
theorem covers_union (family : ι → Over X) :
    SyntomicCovering family ↔
      (∀ i, Syntomic (family i).hom) ∧
        (⋃ i, Set.range (Points.map (family i).hom)) = Set.univ :=
  ofArrows_mem_precoverage_iff (fun {_ _} f ↦ Syntomic f) (fun i ↦ (family i).hom)

/-- An unbundled memberwise syntomic family whose images of points cover `|X|`
defines a syntomic covering. -/
def ofFamily (Xs : ι → AlgebraicSpace S) (f : ∀ i, Xs i ⟶ X)
    (h_syntomic : ∀ i, Syntomic (f i))
    (h_covers : (⋃ i, Set.range (Points.map (f i))) = Set.univ) :
    SyntomicCovering (fun i ↦ Over.mk (f i)) :=
  (covers_union (fun i ↦ Over.mk (f i))).mpr ⟨h_syntomic, h_covers⟩

/-- Every point of `|X|` has a preimage under the total point map of a syntomic covering. -/
theorem exists_preimage {family : ι → Over X} (h : SyntomicCovering family) (x : Points X) :
    ∃ p, syntomicCoveringPointMap family p = x :=
  h.surjective_pointMap x

end SyntomicCovering

/-- A singleton family generated by an isomorphism of algebraic spaces is a
syntomic covering. -/
theorem syntomicCovering_singleton_of_isIso {S : Scheme.{u}}
    {X X' : AlgebraicSpace S} (f : X' ⟶ X) [IsIso f] :
    SyntomicCovering (fun _ : Unit ↦ Over.mk f) :=
  sorry

/-- Indexed composition of syntomic covering families of algebraic spaces is a
syntomic covering. -/
theorem syntomicCovering_comp {S : Scheme.{u}} {X : AlgebraicSpace S}
    {ι : Type v} {κ : ι → Type w} (family : ι → Over X)
    (refinement : (i : ι) → κ i → Over (family i).left)
    (hfamily : SyntomicCovering family)
    (hrefinement : ∀ i, SyntomicCovering (refinement i)) :
    SyntomicCovering (fun p : Sigma κ ↦
      Over.mk ((refinement p.1 p.2).hom ≫ (family p.1).hom)) :=
  sorry

/-- Pulling a syntomic covering family of algebraic spaces back along a morphism
yields a syntomic covering. -/
theorem syntomicCovering_pullback {S : Scheme.{u}} {X X' : AlgebraicSpace S}
    {ι : Type v} (family : ι → Over X) (hfamily : SyntomicCovering family)
    (g : X' ⟶ X) :
    SyntomicCovering (fun i ↦ Over.mk (pullback.fst g (family i).hom)) :=
  sorry

end AlgebraicGeometry.AlgebraicSpace
