module

public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Sequence.Koszul.Regularity
public import ReasLib.RingTheory.Sequence.QuasiRegular.Basic

/-!
# Regularity Implications for Quasi-Regular Sequences

This leaf contains the reusable implications from regular, Koszul-regular,
and `H1`-regular finite families to the associated-graded formulation of
quasi-regularity.

@stack 0667
-/

@[expose] public section

noncomputable section

universe u v

namespace RingTheory.Sequence

variable {R : Type u} [CommRing R]

namespace IsRegular

/-- Every regular sequence on a module is quasi-regular. -/
@[stacks 00LN "regular sequences are quasi-regular"]
theorem isQuasiRegular {M : Type v} [AddCommGroup M] [Module R M]
    {rs : List R} (hreg : IsRegular M rs) :
    IsQuasiRegular M rs := sorry

end IsRegular

section KoszulRegularity

variable {M : Type u} [AddCommGroup M] [Module R M]

namespace IsH1RegularOn

/-- An `H1`-regular finite family on a module is quasi-regular as the corresponding list. -/
@[stacks 062I "H1-regular sequences are quasi-regular"]
theorem isQuasiRegular {r : ℕ} {f : Fin r → R} (hH1 : IsH1RegularOn M f) :
    IsQuasiRegular M (List.ofFn f) := sorry

end IsH1RegularOn

namespace IsKoszulRegularOn

/-- A Koszul-regular finite family on a module is quasi-regular. -/
theorem isQuasiRegular {r : ℕ} {f : Fin r → R} (hKoszul : IsKoszulRegularOn M f) :
    IsQuasiRegular M (List.ofFn f) := sorry

end IsKoszulRegularOn

namespace IsKoszulRegularSequence

/-- A Koszul-regular finite family in a ring is quasi-regular. -/
theorem isQuasiRegular {r : ℕ} {f : Fin r → R}
    (hKoszul : IsKoszulRegularSequence f) :
    IsQuasiRegularSequence (List.ofFn f) := sorry

end IsKoszulRegularSequence

namespace IsQuasiRegularSequence

/-- A quasi-regular finite family followed by a family that is `H₁`-regular modulo the ideal
generated by the first one is quasi-regular. -/
@[stacks 0667 "adjoining an H1-regular quotient family to a quasi-regular family"]
theorem append_of_quotient_h1Regular {n m : ℕ} (f : Fin n → R) (g : Fin m → R)
    (hf : IsQuasiRegularSequence (List.ofFn f))
    (hg : IsH1RegularSequence
      (fun j ↦ Ideal.Quotient.mk (Ideal.span (Set.range f)) (g j))) :
    IsQuasiRegularSequence (List.ofFn f ++ List.ofFn g) := sorry

/-- Quasi-regularity of a finite family depends only on its length and the ideal it generates. -/
@[stacks 066A "quasi-regularity is invariant under a same-length change of generators"]
theorem of_span_eq {r : ℕ} (f g : Fin r → R)
    (hspan : Ideal.span (Set.range f) = Ideal.span (Set.range g))
    (hg : IsQuasiRegularSequence (List.ofFn g)) :
    IsQuasiRegularSequence (List.ofFn f) := sorry

/-- Same-length quasi-regularity is characterized by the generated ideal. -/
@[stacks 066A "same-length quasi-regularity iff by generated ideal"]
theorem iff_of_span_eq {r : ℕ} (f g : Fin r → R)
    (hspan : Ideal.span (Set.range f) = Ideal.span (Set.range g)) :
    IsQuasiRegularSequence (List.ofFn f) ↔ IsQuasiRegularSequence (List.ofFn g) := sorry

end IsQuasiRegularSequence

/-- An `H1`-regular list is quasi-regular. -/
@[stacks 061T "H1-regular sequences are quasi-regular"]
theorem isQuasiRegularSequence_of_isH1RegularSequence {rs : List R}
    (hH1 : IsH1RegularSequence rs.get) : IsQuasiRegularSequence rs := sorry

end KoszulRegularity

end RingTheory.Sequence
