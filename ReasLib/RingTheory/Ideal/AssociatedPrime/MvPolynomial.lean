module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import ReasLib.RingTheory.Ideal.AssociatedPrime.Module

@[expose] public section

universe u

open MvPolynomial

/-- In the polynomial ring in three variables over a field, the ideal generated by all
three variables is an exact associated prime of the quotient by the product of the ideals
generated by the first and second variables and by the first and third variables, and is
distinct from both factors. -/
@[stacks 0CRA]
theorem MvPolynomial.span_XYZ_mem_associatedPrimesOfModule_quotient_mul_span_XY_XZ
    (k : Type u) [Field k] :
    Ideal.span {(X 0 : MvPolynomial (Fin 3) k), X 1, X 2} ∈
      associatedPrimesOfModule (MvPolynomial (Fin 3) k)
          (MvPolynomial (Fin 3) k ⧸
            (Ideal.span {(X 0 : MvPolynomial (Fin 3) k), X 1} *
              Ideal.span {(X 0 : MvPolynomial (Fin 3) k), X 2})) \
        {Ideal.span {(X 0 : MvPolynomial (Fin 3) k), X 1},
          Ideal.span {(X 0 : MvPolynomial (Fin 3) k), X 2}} :=
  sorry
