module

public import ReasLib.RingTheory.Depth
public import Mathlib.RingTheory.Ideal.Quotient.Basic

@[expose] public section

open scoped ENat

namespace Ideal

/-- The depth of `ℤ` with respect to the ideal generated by `30` is `1`. -/
theorem depth_span_thirty_int :
    depth (span {(30 : ℤ)}) ℤ = 1 := sorry

/-- The depth of `ℤ ⧸ span {(300 : ℤ)}` with respect to the ideal generated by `30`
is `0`. -/
theorem depth_span_thirty_quotient_threeHundred :
    depth (span {(30 : ℤ)}) (ℤ ⧸ span {(300 : ℤ)}) = 0 := sorry

/-- The depth of `ℤ ⧸ span {(7 : ℤ)}` with respect to the ideal generated by `30`
is infinite. -/
theorem depth_span_thirty_quotient_seven :
    depth (span {(30 : ℤ)}) (ℤ ⧸ span {(7 : ℤ)}) = ⊤ := sorry

end Ideal
