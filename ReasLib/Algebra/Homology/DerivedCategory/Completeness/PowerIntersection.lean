module

public import ReasLib.Algebra.Homology.DerivedCategory.Completeness
import Mathlib.Tactic.CrossRefAttribute

/-!
# Nilpotence of the ideal-power intersection

Derived completeness of the ring with respect to an ideal generated by `r` elements forces the
intersection of all powers of that ideal to be nilpotent of exponent `2 ^ r`.

@stack 0G3I
-/

@[expose] public section

universe u

namespace Ideal

variable {A : Type u} [CommRing A]

/-- Lemma 15.94.11 (Stacks `0G3I`): if `A`, viewed as an `A`-module, is derived complete with
respect to an ideal `I` generated by `r` elements, then
`(⨅ n : ℕ, I ^ n) ^ (2 ^ r) = ⊥`. -/
@[stacks 0G3I "nilpotence of the ideal-power intersection"]
theorem powerIntersection_pow_two_pow_eq_bot_of_isDerivedComplete
    (I : Ideal A) (r : ℕ) (hgen : ∃ f : Fin r → A, Ideal.span (Set.range f) = I)
    (hA : (ModuleCat.of A A).IsDerivedCompleteWithRespectTo I) :
    (⨅ n : ℕ, I ^ n) ^ (2 ^ r) = ⊥ := sorry

end Ideal
