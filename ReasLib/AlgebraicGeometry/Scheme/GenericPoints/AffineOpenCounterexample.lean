module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Data.PNat.Basic
public import Mathlib.RingTheory.Ideal.MinimalPrime.Basic
public import ReasLib.AlgebraicGeometry.Scheme.GenericPoints.AffineOpen
public import ReasLib.AlgebraicGeometry.Scheme.Gluing.DoubleAlong

/-!
# Generic points without a common affine neighborhood

This file constructs a rational line arrangement and the scheme obtained by doubling its
spectrum away from a distinguished minimal prime.
-/

@[expose] public section

open TopologicalSpace
open scoped AlgebraicGeometry

noncomputable section

namespace AlgebraicGeometry.RationalLineArrangement

/-- The polynomial ring whose `none` coordinate is `x` and whose `some i` coordinate is `yᵢ`. -/
abbrev PolynomialRing := MvPolynomial (Option ℕ+) ℚ

/-- The ideal generated by `(x - i)yᵢ` for all positive integers `i`. -/
def relationIdeal : Ideal PolynomialRing :=
  Ideal.span (Set.range fun i : ℕ+ ↦
    (MvPolynomial.X (none : Option ℕ+) - MvPolynomial.C ((i : ℕ) : ℚ)) *
      MvPolynomial.X (some i))

/-- The coordinate ring `ℚ[x, y₁, y₂, …] / ((x - i)yᵢ)`. -/
abbrev CoordinateRing := PolynomialRing ⧸ relationIdeal

/-- The class of the coordinate `x` in the rational line arrangement. -/
def x : CoordinateRing :=
  Ideal.Quotient.mk relationIdeal (MvPolynomial.X (none : Option ℕ+))

/-- The class of the coordinate `yᵢ` in the rational line arrangement. -/
def y (i : ℕ+) : CoordinateRing :=
  Ideal.Quotient.mk relationIdeal (MvPolynomial.X (some i))

/-- In the coordinate ring, `(x - i)yᵢ` vanishes for every positive integer `i`. -/
theorem relation_zero (i : ℕ+) :
    (x - algebraMap ℚ CoordinateRing ((i : ℕ) : ℚ)) * y i = 0 := sorry

/-- The ideal generated by all coordinates `yᵢ`. -/
def axisIdeal : Ideal CoordinateRing :=
  Ideal.span (Set.range y)

/-- The ideal generated by all `yᵢ` is prime. -/
theorem axisIdeal_isPrime : axisIdeal.IsPrime := sorry

/-- The ideal generated by all `yᵢ` is a minimal prime of the coordinate ring. -/
theorem axisIdeal_mem_minimalPrimes :
    axisIdeal ∈ minimalPrimes CoordinateRing := sorry

/-- The point of the spectrum corresponding to the ideal generated by all `yᵢ`. -/
def axisPoint : PrimeSpectrum CoordinateRing :=
  ⟨axisIdeal, axisIdeal_isPrime⟩

/-- The prime ideal underlying `axisPoint` is `axisIdeal`. -/
theorem axisPoint_asIdeal : axisPoint.asIdeal = axisIdeal := sorry

/-- The affine spectrum of the rational line arrangement. -/
abbrev spectrum : Scheme :=
  Spec (CommRingCat.of CoordinateRing)

/-- The union of the basic opens `D(yᵢ)` in the rational line arrangement. -/
def puncturedOpen : spectrum.Opens :=
  ⨆ i : ℕ+, PrimeSpectrum.basicOpen (y i)

/-- The union of the opens `D(yᵢ)` is the complement of the vanishing locus of `axisIdeal`. -/
theorem puncturedOpen_coe :
    (puncturedOpen : Set spectrum) =
      (PrimeSpectrum.zeroLocus (axisIdeal : Set CoordinateRing))ᶜ := sorry

/-- The distinguished minimal-prime point does not belong to `puncturedOpen`. -/
theorem axisPoint_not_mem_puncturedOpen : axisPoint ∉ puncturedOpen := sorry

/-- Intersecting `puncturedOpen` with any open neighborhood of `axisPoint` gives a noncompact
open subset. -/
theorem puncturedOpen_inf_not_isCompact_of_mem (V : spectrum.Opens)
    (hV : axisPoint ∈ V) :
    ¬ IsCompact (((puncturedOpen ⊓ V : spectrum.Opens) : Set spectrum)) := sorry

namespace DoubleAlong

/-- The scheme obtained by gluing two copies of the spectrum along `puncturedOpen`. -/
abbrev scheme : Scheme :=
  Scheme.doubleAlong puncturedOpen

/-- The `i`-th copy of `axisPoint` in the doubled scheme. -/
def point (i : Fin 2) : scheme :=
  Scheme.DoubleAlong.point puncturedOpen i axisPoint

/-- The two copies of `axisPoint` in the doubled scheme are distinct. -/
theorem point_injective : Function.Injective point := sorry

/-- Each copy of `axisPoint` is a generic point of the doubled scheme. -/
theorem point_mem_genericPoints (i : Fin 2) :
    point i ∈ genericPoints scheme := sorry

/-- The two distinguished points embedded in the generic points of the doubled scheme. -/
def genericPointsEmbedding : Fin 2 ↪ genericPoints scheme where
  toFun i := ⟨point i, point_mem_genericPoints i⟩
  inj' i j hij := point_injective (congrArg Subtype.val hij)

/-- The underlying point of `genericPointsEmbedding i` is the `i`-th copy of `axisPoint`. -/
theorem genericPointsEmbedding_coe (i : Fin 2) :
    (genericPointsEmbedding i : scheme) = point i := sorry

/-- No affine open of the doubled scheme contains both distinguished generic points. -/
theorem not_exists_affineOpen_containing_genericPoints :
    ¬ ∃ U : scheme.affineOpens,
      ∀ i, (genericPointsEmbedding i : scheme) ∈ ((U : scheme.Opens) : Set scheme) := sorry

/-- The doubled rational line arrangement is not quasi-separated. -/
theorem not_quasiSeparated : ¬ QuasiSeparatedSpace scheme := sorry

/-- The doubled rational line arrangement is not quasi-separated, and its two distinguished
generic points have no common affine open neighborhood. -/
theorem counterexample :
    ¬ QuasiSeparatedSpace scheme ∧
      ¬ ∃ U : scheme.affineOpens,
        ∀ i, (genericPointsEmbedding i : scheme) ∈ ((U : scheme.Opens) : Set scheme) := sorry

end DoubleAlong
end AlgebraicGeometry.RationalLineArrangement
