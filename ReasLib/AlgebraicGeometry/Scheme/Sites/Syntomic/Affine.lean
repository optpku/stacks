module

public import ReasLib.AlgebraicGeometry.Scheme.Sites.AffineOver
public import ReasLib.AlgebraicGeometry.Scheme.Sites.Syntomic
public import Mathlib.AlgebraicGeometry.Sites.Small

/-!
# Affine slices of the syntomic site

This module specializes the topology-independent affine-over restriction API
to the syntomic topology.  Standard finite chart presentations remain in the
separate covering-family module.
-/

@[expose] public section

open CategoryTheory

noncomputable section

universe u v

namespace AlgebraicGeometry.Scheme

/-- The canonical syntomic Grothendieck topology on the category of schemes
over `S`. -/
abbrev syntomicOverTopology (S : Scheme.{u}) : GrothendieckTopology (Over S) :=
  S.overGrothendieckTopology (@Syntomic)

/-- The syntomic slice topology is the topology induced on `Over S` by the
syntomic morphism property. -/
theorem syntomicOverTopology_def (S : Scheme.{u}) :
    syntomicOverTopology S = S.overGrothendieckTopology (@Syntomic) := sorry

/-- The canonical syntomic precoverage on affine schemes over `S`, obtained by
restricting the syntomic slice topology. -/
abbrev bigAffineSyntomicPrecoverage (S : Scheme.{u}) : Precoverage S.AffineOver :=
  affineOverPrecoverage S (syntomicOverTopology S)

/-- A presieve is syntomically covering on the affine slice exactly when its
image is covering in the syntomic slice site. -/
@[simp]
theorem mem_bigAffineSyntomicPrecoverage_iff
    (S : Scheme.{u}) {U : S.AffineOver} {R : Presieve U} :
    R ∈ bigAffineSyntomicPrecoverage S U ↔
      R.map (AffineOver.forget S) ∈
        (syntomicOverTopology S).toPrecoverage (AffineOver.obj U) := sorry

/-- An indexed affine family is syntomically covering exactly when its
underlying family in `Over S` is covering in the syntomic slice. -/
@[simp]
theorem ofArrows_mem_bigAffineSyntomicPrecoverage_iff
    (S : Scheme.{u}) {U : S.AffineOver} {ι : Type v}
    (Y : ι → S.AffineOver) (π : ∀ i, Y i ⟶ U) :
    Presieve.ofArrows Y π ∈ bigAffineSyntomicPrecoverage S U ↔
      Presieve.ofArrows (fun i ↦ AffineOver.obj (Y i))
        (fun i ↦ AffineOver.hom (π i)) ∈
          (syntomicOverTopology S).toPrecoverage (AffineOver.obj U) := sorry

/-- The canonical syntomic Grothendieck topology on affine schemes over `S`. -/
abbrev bigAffineSyntomicTopology (S : Scheme.{u}) : GrothendieckTopology S.AffineOver :=
  affineOverTopology S (syntomicOverTopology S)

/-- The affine syntomic topology is generated by the restricted syntomic
precoverage. -/
theorem bigAffineSyntomicTopology_def (S : Scheme.{u}) :
    bigAffineSyntomicTopology S = (bigAffineSyntomicPrecoverage S).toGrothendieck := sorry

end AlgebraicGeometry.Scheme
