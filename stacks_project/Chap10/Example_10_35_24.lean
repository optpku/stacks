/-!
# Idempotent matrices and their rank components

@stack 00GG

The presentation data from the source is explicit below.  The statements then
record the rank classification, the corresponding irreducible components, and
the polynomial invariants used to separate those components.
-/

@[expose] public section

noncomputable section

namespace Algebra.Example_10_35_24

universe u

/-- The diagonal idempotent matrix with `r` initial entries equal to `1`. -/
def rankProjection {k : Type u} [Semiring k] (n : ℕ) (r : Fin (n + 1)) :
    Matrix (Fin n) (Fin n) k :=
  Matrix.diagonal fun i => if i.1 < r.1 then 1 else 0

/-- A standard rank projection is idempotent. -/
theorem rankProjection_isIdempotent {k : Type u} [Semiring k] (n : ℕ)
    (r : Fin (n + 1)) :
    IsIdempotentElem (rankProjection (k := k) n r) := sorry

/-- The `(i,j)` entry of the universal relation `T^2 - T`. -/
def relationEntry (k : Type u) [CommRing k] (n : ℕ) (ij : Fin n × Fin n) :
    MvPolynomial (Fin n × Fin n) k :=
  (∑ l : Fin n, MvPolynomial.X (ij.1, l) * MvPolynomial.X (l, ij.2)) -
    MvPolynomial.X ij

/-- The ideal generated by the entries of the universal relation `T^2 - T`. -/
def relationIdeal (k : Type u) [CommRing k] (n : ℕ) :
    Ideal (MvPolynomial (Fin n × Fin n) k) :=
  Ideal.span (Set.range (relationEntry k n))

/-- Example 10.35.24 (1): the coordinate ring of the idempotent-matrix locus is
`k[{t_ij}]/(T^2-T)`. -/
@[stacks 00GG "(1)"]
abbrev CoordinateRing (k : Type u) [CommRing k] (n : ℕ) : Type u :=
  MvPolynomial (Fin n × Fin n) k ⧸ relationIdeal k n

/-- The universal matrix over the idempotent-matrix coordinate ring. -/
def genericMatrix (k : Type u) [CommRing k] (n : ℕ) :
    Matrix (Fin n) (Fin n) (CoordinateRing k n) :=
  (Matrix.mvPolynomialX (Fin n) (Fin n) k).map
    (Ideal.Quotient.mk (relationIdeal k n))

/-- The universal matrix satisfies the defining idempotency relation. -/
theorem genericMatrix_isIdempotent {k : Type u} [CommRing k] (n : ℕ) :
    IsIdempotentElem (genericMatrix k n) := sorry

/-- The ideal imposing the characteristic polynomial of the rank-`r` projection. -/
def rankComponentIdeal (k : Type u) [CommRing k] (n : ℕ) (r : Fin (n + 1)) :
    Ideal (CoordinateRing k n) :=
  Ideal.span <| Set.range fun i : Fin n =>
    Ideal.Quotient.mk (relationIdeal k n)
      ((Matrix.mvPolynomialX (Fin n) (Fin n) k).charpoly.coeff i -
        MvPolynomial.C ((rankProjection (k := k) n r).charpoly.coeff i))

/-- The closed fixed-rank locus in the spectrum of the idempotent-matrix ring. -/
def rankComponent (k : Type u) [CommRing k] (n : ℕ) (r : Fin (n + 1)) :
    Set (PrimeSpectrum (CoordinateRing k n)) :=
  PrimeSpectrum.zeroLocus
    (rankComponentIdeal k n r : Set (CoordinateRing k n))

section

variable {k : Type u} [Field k]

/-- Example 10.35.24 (2): an idempotent matrix over a field is conjugate to a
standard diagonal projection; the orbit-disjointness statement below supplies
the uniqueness of its rank. -/
@[stacks 00GG "(2)"]
theorem isIdempotent_iff_exists_isConj_rankProjection {n : ℕ}
    {A : Matrix (Fin n) (Fin n) k} :
    IsIdempotentElem A ↔
      ∃ r : Fin (n + 1), IsConj (rankProjection (k := k) n r) A := sorry

/-- Example 10.35.24 (3): the rank-`r` orbit is the locus of idempotent
matrices having the characteristic polynomial of the rank-`r` projection. -/
@[stacks 00GG "(3)"]
theorem conjugatesOf_rankProjection_eq_fixedCharpoly (n : ℕ)
    (r : Fin (n + 1)) :
    conjugatesOf (rankProjection (k := k) n r) =
      {A : Matrix (Fin n) (Fin n) k |
        IsIdempotentElem A ∧
          A.charpoly = (rankProjection (k := k) n r).charpoly} := sorry

/-- Example 10.35.24 (4): the irreducible components of the idempotent-matrix
spectrum are precisely its fixed-rank loci. -/
@[stacks 00GG "(4)"]
theorem irreducibleComponents_eq_rankComponents (n : ℕ) :
    irreducibleComponents (PrimeSpectrum (CoordinateRing k n)) =
      Set.range (rankComponent k n) := sorry

/-- Example 10.35.24 (5): standard projections of different ranks have
disjoint conjugacy orbits. -/
@[stacks 00GG "(5)"]
theorem disjoint_conjugatesOf_rankProjection (n : ℕ) {r s : Fin (n + 1)}
    (hrs : r ≠ s) :
    Disjoint (conjugatesOf (rankProjection (k := k) n r))
      (conjugatesOf (rankProjection (k := k) n s)) := sorry

/-- Example 10.35.24 (6): in characteristic zero, matrix trace separates
different rank-projection orbits. -/
@[stacks 00GG "(6)"]
theorem trace_ne_of_isConj_rankProjection [CharZero k] {n : ℕ}
    {A B : Matrix (Fin n) (Fin n) k} {r s : Fin (n + 1)}
    (hA : IsConj (rankProjection (k := k) n r) A)
    (hB : IsConj (rankProjection (k := k) n s) B) (hrs : r ≠ s) :
    A.trace ≠ B.trace := sorry

/-- Example 10.35.24 (7): in characteristic three, `tr(∧^3 A)` is `1` on
the rank-three orbit of `3 × 3` idempotents and `0` on every other orbit. -/
@[stacks 00GG "(7)"]
theorem thirdExteriorPowerTrace_eq_ite [CharP k 3]
    {A : Matrix (Fin 3) (Fin 3) k} {r : Fin 4}
    (hA : IsConj (rankProjection (k := k) 3 r) A) :
    LinearMap.trace k _ (exteriorPower.map 3 A.toLin') =
      if r = (3 : Fin 4) then 1 else 0 := sorry

end

