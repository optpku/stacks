module

public import Mathlib.Data.Matrix.Mul
public import Mathlib.LinearAlgebra.Matrix.NonsingularInverse
public import Mathlib.RingTheory.Bezout
public import Mathlib.RingTheory.PrincipalIdealDomain
import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Elementary-divisor matrices

@stack 0ASR
@stack 0ASS

This leaf owns the concrete rectangular Smith diagonal and the elementary-divisor
domain predicate used by Chapter 15.  The matrix predicate is kept separate from
the ring class so it can be reused for individual matrices without installing a
ring-level instance.
-/

universe u

namespace Matrix

/-- Definition 15.125.5: the rectangular diagonal matrix with diagonal entries `d`. -/
@[stacks 0ASR "Definition 15.125.5, rectangular Smith diagonal"]
def smithNormalDiagonal [Zero R] {n m : ℕ} (d : Fin (Nat.min n m) → R) :
    Matrix (Fin n) (Fin m) R :=
  fun i j ↦ if hij : i.1 = j.1 ∧ i.1 < Nat.min n m then d ⟨i.1, hij.2⟩ else 0

/-- A matrix has elementary-divisor form when invertible row and column operations produce a
rectangular Smith diagonal whose entries form a divisibility chain. -/
@[stacks 0ASR "Definition 15.125.5, elementary-divisor matrix predicate"]
def HasElementaryDivisorDiagonal [CommRing R] {n m : ℕ}
    (A : Matrix (Fin n) (Fin m) R) : Prop :=
  ∃ U : (Matrix (Fin n) (Fin n) R)ˣ, ∃ V : (Matrix (Fin m) (Fin m) R)ˣ,
    ∃ d : Fin (Nat.min n m) → R,
      (((U : Matrix (Fin n) (Fin n) R) * A) *
          (V : Matrix (Fin m) (Fin m) R)) =
        smithNormalDiagonal d ∧
      List.IsChain (· ∣ ·) (List.ofFn d)

/-- A Smith diagonal with a divisibility chain already satisfies the elementary-divisor predicate. -/
@[stacks 0ASR "Definition 15.125.5, diagonal predicate constructor"]
theorem hasElementaryDivisorDiagonal_of_smithNormalDiagonal
    [CommRing R] {n m : ℕ} (d : Fin (Nat.min n m) → R)
    (hchain : List.IsChain (· ∣ ·) (List.ofFn d)) :
    (smithNormalDiagonal d : Matrix (Fin n) (Fin m) R).HasElementaryDivisorDiagonal := sorry
-- Proof strategy: use the identity units for both row and column operations,
-- retain `d` as the diagonal witness, and simplify matrix multiplication by
-- the identity; the remaining field is exactly `hchain`.

end Matrix

/-- Definition 15.125.5: the ring-level elementary-divisor property. -/
@[stacks 0ASR "Definition 15.125.5, elementary divisor domain"]
class IsElementaryDivisorDomain (R : Type u) [CommRing R] [IsDomain R] : Prop where
  /-- Every finite rectangular matrix over `R` has elementary-divisor form. -/
  hasElementaryDivisorDiagonal {n m : ℕ} (A : Matrix (Fin n) (Fin m) R) :
    A.HasElementaryDivisorDiagonal

section

variable {R : Type u} [CommRing R] [IsDomain R]
variable [h : IsElementaryDivisorDomain R]

include h

/-- Lemma 15.125.6 (tag `0ASS`): an elementary divisor domain is Bézout. -/
@[stacks 0ASS "Lemma 15.125.6, elementary divisor domains are Bezout"]
theorem isBezout_of_isElementaryDivisorDomain : IsBezout R := sorry
-- Proof strategy: apply elementary-divisor reduction to the `1 × 2` matrix
-- with row `(x, y)`.  Invertible row and column operations preserve the ideal
-- generated by its entries, while the resulting Smith diagonal generates a
-- principal ideal.  Invoke `IsBezout.iff_span_pair_isPrincipal`.

end

attribute [instance] isBezout_of_isElementaryDivisorDomain

section

variable {R : Type u} [CommRing R] [IsDomain R]
variable [h : IsPrincipalIdealRing R]

include h

/-- A principal ideal domain is an elementary divisor domain. -/
@[stacks 0ASR "Definition 15.125.5, principal ideal domain implication"]
theorem isElementaryDivisorDomain_of_isPrincipalIdealRing :
    IsElementaryDivisorDomain R := sorry
-- Proof strategy: first put an arbitrary rectangular matrix into diagonal
-- form using the range/kernel splitting available over a principal ideal
-- domain.  Repeated two-entry Bezout transformations refine the nonzero
-- diagonal block into a divisibility chain.  Compose the accumulated invertible
-- row and column matrices and package the resulting Smith diagonal witness.

end

attribute [instance] isElementaryDivisorDomain_of_isPrincipalIdealRing
