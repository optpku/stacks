module

public import ReasLib.AlgebraicTopology.DoldKan.DegenerateSubobject
public import Mathlib.Algebra.Category.Grp.Abelian
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Elementwise description of degenerate simplices

For simplicial additive commutative groups, this leaf exposes the generators and generated
subgroup underlying the categorical proper-epimorphism image. The categorical subobject remains
owned by `DegenerateSubobject`.

@stack 0FKI
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits
open Opposite
open AlgebraicTopology
open scoped Simplicial

noncomputable section

universe u

namespace AlgebraicTopology.DoldKan

variable (U : SimplicialObject AddCommGrpCat.{u})

namespace degenerateSimplex

/-- The degree-`n` simplices lying in the range of one proper-epimorphism structure map. -/
@[stacks 0FKI "proper-epimorphism generators of degenerate simplices"]
def generators (n : ℕ) : Set (U _⦋n⦌) :=
  ⋃ a : degenerateSubobject.Index (op ⦋n⦌),
    Set.range (U.map a.hom.op)

namespace generators

/-- Membership in the proper-epimorphism generating set, with the index and preimage exposed. -/
@[stacks 0FKI "membership in the proper-epimorphism generators"]
theorem mem_iff {n : ℕ} (x : U _⦋n⦌) :
    x ∈ generators U n ↔
      ∃ (a : degenerateSubobject.Index (op ⦋n⦌))
        (y : U.obj a.target), U.map a.hom.op y = x := sorry

/-- In positive degree, proper-epimorphism generators are exactly degeneracy-map images. -/
@[stacks 0FKI "proper-epimorphism generators are degeneracy images"]
theorem succ (n : ℕ) :
    generators U (n + 1) =
      ⋃ j : Fin (n + 1), Set.range (U.σ j) := sorry

end generators

/-- The additive subgroup generated by all proper-epimorphism images in degree `n`. -/
@[stacks 0FKI "subgroup of degenerate simplices"]
def span (n : ℕ) : AddSubgroup (U _⦋n⦌) :=
  AddSubgroup.closure (generators U n)

namespace span

/-- The generated subgroup is the underlying range of the canonical degenerate subobject. -/
@[stacks 0FKI "degenerate simplices as the range of the degenerate subobject"]
theorem coe_eq_range (n : ℕ) :
    (span U n : Set (U _⦋n⦌)) =
      Set.range (degenerateSubobject U n).arrow := sorry

/-- Elementwise membership in the generated subgroup is membership in the canonical degenerate
subobject. -/
@[stacks 0FKI "membership in the degenerate simplex span"]
theorem mem_iff {n : ℕ} (x : U _⦋n⦌) :
    x ∈ span U n ↔ x ∈ Set.range (degenerateSubobject U n).arrow := sorry

end span

end degenerateSimplex

end AlgebraicTopology.DoldKan
