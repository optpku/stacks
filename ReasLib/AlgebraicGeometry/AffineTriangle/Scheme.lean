module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.RingTheory.Ideal.Quotient.Basic

/-!
# The affine triangle `Spec (k[x, y] / (x * y * (x + y + 1)))`

This module defines the affine triangle and its structure morphism over a
field.
-/

@[expose] public section

noncomputable section

universe u

open AlgebraicGeometry CategoryTheory MvPolynomial

namespace AlgebraicGeometry.AffineTriangle

/-- The defining polynomial `X 0 * X 1 * (X 0 + X 1 + 1)` of the affine triangle. -/
def equation (k : Type u) [Field k] : MvPolynomial (Fin 2) k :=
  MvPolynomial.X 0 * MvPolynomial.X 1 * (MvPolynomial.X 0 + MvPolynomial.X 1 + 1)

/-- The principal ideal generated by the defining polynomial of the affine triangle. -/
def relationIdeal (k : Type u) [Field k] : Ideal (MvPolynomial (Fin 2) k) :=
  Ideal.span {equation k}

/-- The coordinate ring `k[x, y] ⧸ (X 0 * X 1 * (X 0 + X 1 + 1))`. -/
abbrev CoordinateRing (k : Type u) [Field k] : Type u :=
  MvPolynomial (Fin 2) k ⧸ relationIdeal k

/-- The affine triangle `Spec (k[x, y] ⧸ (X 0 * X 1 * (X 0 + X 1 + 1)))`. -/
abbrev scheme (k : Type u) [Field k] : Scheme.{u} :=
  Spec (CommRingCat.of (CoordinateRing k))

/-- The structure morphism of the affine triangle to `Spec k`. -/
def toBase (k : Type u) [Field k] :
    scheme k ⟶ Spec (CommRingCat.of k) :=
  Spec.map (CommRingCat.ofHom (algebraMap k (CoordinateRing k)))

end AlgebraicGeometry.AffineTriangle
