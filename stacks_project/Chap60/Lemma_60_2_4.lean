module

public import ReasLib.RingTheory.DividedPowers.Envelope.Presentation
import StacksCheckRecall

@[expose] public section

universe u v

/- Lemma 60.2.4 (1): the canonical divided-power polynomial presentation map is surjective and
sends each formal variable to the image of its chosen generator. -/
@[stacks 07HC] #check (DividedPowerEnvelope.presentationMap_surjective :
    ∀ {B : Type u} [CommRing B] {I J : Ideal B} (γ : DividedPowers I)
    (hIJ : Ideal.map (RingHom.id B) I ≤ J)
    (E : DividedPowerEnvelope I γ (RingHom.id B) J hIJ)
    (hE : DividedPowerEnvelope.IsUniversal γ (RingHom.id B) hIJ E)
    {T : Type v} (f : T → B) (hf : ∀ t, f t ∈ J)
    (hgen : J = I + Ideal.span (Set.range f)),
    Function.Surjective (DividedPowerEnvelope.presentationMap γ hIJ E f hf).toRingHom ∧
      ∀ t : T,
        DividedPowerEnvelope.presentationMap γ hIJ E f hf (DPPolynomial.X B t) = E.toD (f t))

/- Lemma 60.2.4 (2): the kernel of the presentation map is generated by the variable and
divided-power coefficient relations. -/
@[stacks 07HC] #check (DividedPowerEnvelope.presentationMap_kernel :
    ∀ {B : Type u} [CommRing B] {I J : Ideal B} (γ : DividedPowers I)
    (hIJ : Ideal.map (RingHom.id B) I ≤ J)
    (E : DividedPowerEnvelope I γ (RingHom.id B) J hIJ)
    (hE : DividedPowerEnvelope.IsUniversal γ (RingHom.id B) hIJ E)
    {T : Type v} (f : T → B) (hf : ∀ t, f t ∈ J)
    (hgen : J = I + Ideal.span (Set.range f)),
    RingHom.ker (DividedPowerEnvelope.presentationMap γ hIJ E f hf).toRingHom =
      Ideal.span (DividedPowerEnvelope.presentationRelations γ f))
