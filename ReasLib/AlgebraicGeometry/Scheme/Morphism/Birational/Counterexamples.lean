module

public import Mathlib.RingTheory.MvPolynomial.Ideal
public import ReasLib.AlgebraicGeometry.Scheme.Morphism.Birational.Localization

/-!
# Counterexamples for Birational Morphisms

This module gives an affine-line thickening and an odd-integer localization whose
birational morphisms do not become isomorphisms over any nonempty target open.
-/

@[expose] public section

open CategoryTheory
open scoped AlgebraicGeometry

universe u

namespace AlgebraicGeometry.BirationalCounterexample

noncomputable section

namespace AffineLineThickening

variable (k : Type u) [Field k]

/-- The variables consisting of one distinguished coordinate and one coordinate indexed by each
element of `k`. -/
abbrev Variables :=
  Unit ⊕ k

/-- The polynomial base ring in the distinguished coordinate. -/
abbrev BaseRing :=
  Polynomial k

/-- The multivariable polynomial ring containing the distinguished and indexed coordinates. -/
abbrev AmbientRing :=
  MvPolynomial (Variables k) k

/-- The distinguished coordinate in the ambient polynomial ring. -/
abbrev x : AmbientRing k :=
  MvPolynomial.X (Sum.inl ())

/-- The indexed coordinate `y_α` in the ambient polynomial ring. -/
abbrev y (a : k) : AmbientRing k :=
  MvPolynomial.X (Sum.inr a)

/-- The ideal generated by `(x - α)y_α` and `y_αy_β` for all `α, β : k`. -/
def relations : Ideal (AmbientRing k) :=
  Ideal.span
    ({f |
        (∃ a : k, f = (x k - MvPolynomial.C a) * y k a) ∨
          ∃ a b : k, f = y k a * y k b} : Set (AmbientRing k))

/-- The quotient of the ambient polynomial ring by the thickening relations. -/
abbrev ThickeningRing :=
  AmbientRing k ⧸ relations k

/-- The canonical map from the polynomial base ring to the thickening ring. -/
abbrev inclusion : BaseRing k →+* ThickeningRing k :=
  Polynomial.eval₂RingHom
    (algebraMap k (ThickeningRing k))
    (Ideal.Quotient.mk _ (x k))

/-- The map from the ambient polynomial ring to the base ring sending `x` to `X` and every
`y_α` to zero. -/
def retractionAux : AmbientRing k →+* BaseRing k :=
  MvPolynomial.eval₂Hom Polynomial.C
    (fun i ↦ Sum.elim (fun _ ↦ Polynomial.X) (fun _ ↦ 0) i)

/-- Every thickening relation belongs to the kernel of the auxiliary retraction. -/
theorem relations_le_ker_retractionAux :
    relations k ≤ RingHom.ker (retractionAux k) := by
  refine Ideal.span_le.2 ?_
  rintro z (⟨a, rfl⟩ | ⟨a, b, rfl⟩)
  · simp [retractionAux, x, y, RingHom.mem_ker]
  · simp [retractionAux, y, RingHom.mem_ker]

/-- The retraction from the thickening ring to the polynomial base ring. -/
abbrev retraction : ThickeningRing k →+* BaseRing k :=
  Ideal.Quotient.lift (relations k) (retractionAux k) (relations_le_ker_retractionAux k)

/-- The affine scheme of the polynomial base ring. -/
abbrev BaseScheme : Scheme :=
  Spec (CommRingCat.of (BaseRing k))

/-- The affine scheme of the thickening ring. -/
abbrev ThickeningScheme : Scheme :=
  Spec (CommRingCat.of (ThickeningRing k))

/-- The spectrum morphism from the thickening to the affine line. -/
abbrev toBase : ThickeningScheme k ⟶ BaseScheme k :=
  Spec.map (CommRingCat.ofHom (inclusion k))

/-- The spectrum morphism from the affine line to the thickening. -/
abbrev toThickening : BaseScheme k ⟶ ThickeningScheme k :=
  Spec.map (CommRingCat.ofHom (retraction k))

/-- The quotient retraction is a left inverse of the canonical inclusion. -/
theorem retraction_leftInverse :
    Function.LeftInverse (retraction k) (inclusion k) := sorry

/-- The canonical map from the polynomial base ring to the thickening ring is injective. -/
theorem inclusion_injective : Function.Injective (inclusion k) :=
  (retraction_leftInverse k).injective

/-- The morphism from the affine line to its thickening is birational. -/
instance instIsBirationalToThickening
    (k' : Type u) [Field k'] [Infinite k'] : IsBirational (toThickening k') := sorry

/-- The morphism from the thickening to the affine line is birational. -/
instance instIsBirationalToBase
    (k' : Type u) [Field k'] [Infinite k'] : IsBirational (toBase k') := sorry

/-- The morphism from the thickening to the affine line is not an isomorphism after restriction
to any nonempty open of the affine line. -/
theorem not_isIso_restrict_toBase
    (k' : Type u) [Field k'] [Infinite k']
    (U : (BaseScheme k').Opens) (hU : Nonempty U) :
    ¬ IsIso (toBase k' ∣_ U) := sorry

/-- The morphism from the affine line to its thickening is not an isomorphism after restriction
to any nonempty open of the thickening. -/
theorem not_isIso_restrict_toThickening
    (k' : Type u) [Field k'] [Infinite k']
    (U : (ThickeningScheme k').Opens) (hU : Nonempty U) :
    ¬ IsIso (toThickening k' ∣_ U) := sorry

end AffineLineThickening

namespace OddLocalization

/-- The submonoid of odd integers. -/
def submonoid : Submonoid ℤ where
  carrier := {z | Odd z}
  one_mem' := by
    simpa using odd_one
  mul_mem' := by
    intro a b ha hb
    exact Odd.mul ha hb

/-- Zero does not belong to the submonoid of odd integers. -/
theorem zero_not_mem : (0 : ℤ) ∉ submonoid := by
  simp [submonoid]

/-- The localization of the integers at the odd integers is not an isomorphism over any nonempty
open of the integer spectrum. -/
theorem not_isIso_restrict (U : (Spec (CommRingCat.of ℤ)).Opens) (hU : Nonempty U) :
    ¬ IsIso (LocalizationMorphism.hom ℤ submonoid ∣_ U) := sorry

end OddLocalization

end


end AlgebraicGeometry.BirationalCounterexample
