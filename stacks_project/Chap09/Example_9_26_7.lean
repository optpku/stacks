module

public import ReasLib.FieldTheory.Transcendence.OneVariable
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

open scoped IntermediateField
open IntermediateField.AdjoinSimple

universe u v

section

variable {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]

/-
Domain-style sampling for Example 9.26.7:
- primary domain: transcendence bases in simple transcendental field extensions;
- canonical owner: `FieldExtension.simpleExtensionGenPowIsTranscendenceBasis`;
- source-facing role: the textbook's two concrete powers `1` and `2`, illustrating that a
  purely transcendental presentation need not be unique.

The reusable owner is stated for every positive exponent. The source bridge retains the original
two singleton families rather than exposing the former square-specific proof helpers. -/

/-- Example 9.26.7 (Tag 09IA): if `t` is transcendental over `F`, then inside `F⟮t⟯` both the
singleton family generated by `t` and the singleton family generated by `t ^ 2` are transcendence
bases. This is the `n = 1` and `n = 2` specialization of the positive-power API. -/
@[stacks 09IA]
theorem simple_extension_singleton_and_square_are_transcendence_bases {t : E}
    (ht : Transcendental F t) :
    IsTranscendenceBasis F (fun _ : Unit ↦ gen F t) ∧
      IsTranscendenceBasis F (fun _ : Unit ↦ (gen F t) ^ 2) := by
  refine ⟨?_, ?_⟩
  · simpa using
      (FieldExtension.simpleExtensionGenPowIsTranscendenceBasis
        (F := F) (E := E) ht (n := 1) (by decide))
  · simpa using
      (FieldExtension.simpleExtensionGenPowIsTranscendenceBasis
        (F := F) (E := E) ht (n := 2) (by decide))

end
