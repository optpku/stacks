module

public import Mathlib.Algebra.Field.Basic
public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Algebra.MvPolynomial.Equiv
public import Mathlib.AlgebraicGeometry.AffineSpace
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.Morphisms.FinitePresentation
public import Mathlib.AlgebraicGeometry.Morphisms.Smooth
public import Mathlib.AlgebraicGeometry.Restrict
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Linear perturbation families in affine space

Explicit polynomials `gⱼ`, the closed subscheme they cut out, and the projection
onto the space of linear coefficients.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory MvPolynomial
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.LinearPerturbation

/-- The index type of the linear perturbation coefficients `aᵢⱼ`, for
`0 ≤ i ≤ n` and `1 ≤ j ≤ c`. -/
abbrev coeffIdx (n c : ℕ) : Type :=
  Fin (n + 1) × Fin c

/-- The linearly perturbed polynomial
`g f j = MvPolynomial.map C (f j) + C (X (0, j)) + ∑ i, C (X (i.succ, j)) * X i`
in `k[aᵢⱼ][x₁,…,xₙ]`. -/
def g {k : Type u} [Field k] {n c : ℕ} (f : Fin c → MvPolynomial (Fin n) k) (j : Fin c) :
    MvPolynomial (Fin n) (MvPolynomial (coeffIdx n c) k) :=
  MvPolynomial.map (C : k →+* MvPolynomial (coeffIdx n c) k) (f j) + C (X (0, j)) +
    ∑ i : Fin n, C (X (i.succ, j)) * X i

/-- Unfolding of `g` to the displayed linear perturbation formula. -/
theorem g_eq {k : Type u} [Field k] {n c : ℕ} (f : Fin c → MvPolynomial (Fin n) k)
    (j : Fin c) :
    g f j =
      MvPolynomial.map (C : k →+* MvPolynomial (coeffIdx n c) k) (f j) + C (X (0, j)) +
        ∑ i : Fin n, C (X (i.succ, j)) * X i :=
  sorry

/-- The ideal of equations of `Y`, generated by the perturbed polynomials `g f j`. -/
def relationIdeal {k : Type u} [Field k] {n c : ℕ} (f : Fin c → MvPolynomial (Fin n) k) :
    Ideal (MvPolynomial (Fin n) (MvPolynomial (coeffIdx n c) k)) :=
  Ideal.span (Set.range (g f))

/-- The relation ideal is the span of the range of `g f`. -/
theorem relationIdeal_eq_span {k : Type u} [Field k] {n c : ℕ}
    (f : Fin c → MvPolynomial (Fin n) k) :
    relationIdeal f = Ideal.span (Set.range (g f)) :=
  sorry

/-- The coordinate ring `k[aᵢⱼ][x₁,…,xₙ] ⧸ (g f 1,…,g f c)`. -/
abbrev CoordinateRing {k : Type u} [Field k] {n c : ℕ}
    (f : Fin c → MvPolynomial (Fin n) k) : Type u :=
  MvPolynomial (Fin n) (MvPolynomial (coeffIdx n c) k) ⧸ relationIdeal f

/-- Each perturbed equation `g f j` vanishes in the coordinate ring. -/
theorem mk_g {k : Type u} [Field k] {n c : ℕ} (f : Fin c → MvPolynomial (Fin n) k)
    (j : Fin c) :
    Ideal.Quotient.mk (relationIdeal f) (g f j) = (0 : CoordinateRing f) :=
  sorry

/-- The closed subscheme `Y` cut out by `g f 1,…,g f c`. -/
def scheme {k : Type u} [Field k] {n c : ℕ} (f : Fin c → MvPolynomial (Fin n) k) :
    Scheme.{u} :=
  Spec (CommRingCat.of (CoordinateRing f))

/-- The coefficient affine space `𝔸(ULift (coeffIdx n c); Spec k)`. -/
def coeffSpace (k : Type u) [Field k] (n c : ℕ) : Scheme.{u} :=
  𝔸(ULift.{u} (coeffIdx n c); Spec (CommRingCat.of.{u} k))

/-- The ambient affine space `𝔸(ULift (Fin n ⊕ coeffIdx n c); Spec k)`. -/
def totalSpace (k : Type u) [Field k] (n c : ℕ) : Scheme.{u} :=
  𝔸(ULift.{u} (Fin n ⊕ coeffIdx n c); Spec (CommRingCat.of.{u} k))

/-- Comparison `Spec k[aᵢⱼ] ≅ coeffSpace k n c` via `renameEquiv` and `AffineSpace.SpecIso`. -/
def coeffSpecIso (k : Type u) [Field k] (n c : ℕ) :
    Spec (CommRingCat.of (MvPolynomial (coeffIdx n c) k)) ≅ coeffSpace k n c :=
  Scheme.Spec.mapIso
      (renameEquiv k
        (Equiv.ulift : ULift.{u} (coeffIdx n c) ≃ coeffIdx n c)).toRingEquiv.toCommRingCatIso.op ≪≫
    (AffineSpace.SpecIso (ULift.{u} (coeffIdx n c)) (CommRingCat.of.{u} k)).symm

/-- Comparison `Spec k[xᵢ, aᵢⱼ] ≅ totalSpace k n c` via `renameEquiv` and `AffineSpace.SpecIso`. -/
def totalSpecIso (k : Type u) [Field k] (n c : ℕ) :
    Spec (CommRingCat.of (MvPolynomial (Fin n ⊕ coeffIdx n c) k)) ≅ totalSpace k n c :=
  Scheme.Spec.mapIso
      (renameEquiv k
        (Equiv.ulift :
          ULift.{u} (Fin n ⊕ coeffIdx n c) ≃ Fin n ⊕ coeffIdx n c)).toRingEquiv.toCommRingCatIso.op ≪≫
    (AffineSpace.SpecIso (ULift.{u} (Fin n ⊕ coeffIdx n c)) (CommRingCat.of.{u} k)).symm

/-- The closed immersion `ι : Y ⟶ 𝔸^{n+c(n+1)}_k`. -/
def ι {k : Type u} [Field k] {n c : ℕ} (f : Fin c → MvPolynomial (Fin n) k) :
    scheme f ⟶ totalSpace k n c :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (relationIdeal f))) ≫
    Spec.map (sumAlgEquiv k (Fin n) (coeffIdx n c)).toRingEquiv.toCommRingCatIso.hom ≫
    (totalSpecIso k n c).hom

/-- The morphism `ι f` is a closed immersion. -/
instance isClosedImmersion_ι {k : Type u} [Field k] {n c : ℕ}
    (f : Fin c → MvPolynomial (Fin n) k) : IsClosedImmersion (ι f) :=
  sorry

/-- The projection `π : Y ⟶ 𝔸^{c(n+1)}_k` onto the coefficient space. -/
def projection {k : Type u} [Field k] {n c : ℕ} (f : Fin c → MvPolynomial (Fin n) k) :
    scheme f ⟶ coeffSpace k n c :=
  Spec.map (CommRingCat.ofHom (algebraMap (MvPolynomial (coeffIdx n c) k) (CoordinateRing f))) ≫
    (coeffSpecIso k n c).hom

/-- `projection f` is `Spec.map` of the coefficient algebra map, transported along `coeffSpecIso`. -/
theorem projection_eq_Spec_map {k : Type u} [Field k] {n c : ℕ}
    (f : Fin c → MvPolynomial (Fin n) k) :
    projection f =
      Spec.map (CommRingCat.ofHom
          (algebraMap (MvPolynomial (coeffIdx n c) k) (CoordinateRing f))) ≫
        (coeffSpecIso k n c).hom :=
  sorry

/-- Composing `ι f` with reindex along `Sum.inr` recovers the coefficient projection. -/
theorem ι_comp_reindex {k : Type u} [Field k] {n c : ℕ}
    (f : Fin c → MvPolynomial (Fin n) k) :
    ι f ≫ AffineSpace.reindex (ULift.map Sum.inr) (Spec (CommRingCat.of.{u} k)) =
      projection f :=
  sorry

/-- The closed subscheme `Y` is affine. -/
instance instIsAffine_scheme {k : Type u} [Field k] {n c : ℕ}
    (f : Fin c → MvPolynomial (Fin n) k) : IsAffine (scheme f) :=
  sorry

/-- The coefficient projection is locally of finite presentation. -/
instance locallyOfFinitePresentation_projection {k : Type u} [Field k] {n c : ℕ}
    (f : Fin c → MvPolynomial (Fin n) k) : LocallyOfFinitePresentation (projection f) :=
  sorry

end AlgebraicGeometry.LinearPerturbation
