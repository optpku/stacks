module

public import ReasLib.AlgebraicTopology.SimplicialObject.Skeleton.Generated.Comparison
public import ReasLib.AlgebraicTopology.SimplicialObject.Skeleton.Counit.Abelian
public import Mathlib.CategoryTheory.Abelian.FunctorCategory
public import Mathlib.Tactic.CrossRefAttribute

/-!
@stack 018U

# Abelian skeleton-generated comparisons

In an abelian category, the image of the skeleton counit is bounded-degree generation. Once the
counit is monomorphic, the generic comparison constructors give canonical objectwise and natural
isomorphisms.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

noncomputable section

universe u v

namespace CategoryTheory.SimplicialObject.Skeleton

variable {A : Type u} [Category.{v} A] [Abelian A]

/-- Lemma 14.21.10 (018U), in image form: the image of the simplicial skeleton counit is the
subobject generated by simplices in degrees at most `n`. -/
@[stacks 018U "the image of the skeleton counit is bounded-degree generation"]
theorem counit.imageSubobject_eq_generated (n : ℕ) (U : SimplicialObject A) :
    imageSubobject ((skAdj n).counit.app U) = U.generated n := sorry

/-- Lemma 14.21.10 (018U), in monomorphic form: the subobject represented by the skeleton counit
is the subobject generated by simplices in degrees at most `n`. -/
@[stacks 018U "the skeleton counit represents bounded-degree generation"]
theorem counit.subobject_eq_generated (n : ℕ) (U : SimplicialObject A) :
    Subobject.mk ((skAdj n).counit.app U) = U.generated n := sorry

/-- The canonical isomorphism from the simplicial `n`-skeleton to the underlying object of the
subobject generated in degrees at most `n`. -/
@[stacks 018U "simplicial skeleton as the bounded-degree generated subobject"]
noncomputable def generated.subobjectIso (n : ℕ) (U : SimplicialObject A) :
    (sk n).obj U ≅ (U.generated n : SimplicialObject A) :=
  generated.comparison.subobjectIso n U (counit.subobject_eq_generated n U)

namespace generated.subobjectIso

/-- The generated-subobject comparison followed by its arrow is the skeleton counit. -/
@[reassoc, stacks 018U "generated-subobject comparison over the ambient simplicial object"]
theorem hom_arrow (n : ℕ) (U : SimplicialObject A) :
    (generated.subobjectIso n U).hom ≫ (U.generated n).arrow =
      (skAdj n).counit.app U := sorry

/-- The inverse generated-subobject comparison followed by the counit is the generated-subobject
arrow. -/
@[reassoc, stacks 018U "inverse generated-subobject comparison over the ambient object"]
theorem inv_counit (n : ℕ) (U : SimplicialObject A) :
    (generated.subobjectIso n U).inv ≫ (skAdj n).counit.app U =
      (U.generated n).arrow := sorry

end generated.subobjectIso

/-- The objectwise canonical comparison from the simplicial `n`-skeleton to the explicit
bounded-degree generated endofunctor. -/
@[stacks 018U "objectwise skeleton-generated comparison"]
noncomputable def generated.isoApp (n : ℕ) (U : SimplicialObject A) :
    (sk n).obj U ≅ SimplicialObject.generated.obj U n :=
  generated.comparison.isoApp n U (counit.subobject_eq_generated n U)

namespace generated.isoApp

/-- The objectwise skeleton-generated comparison is natural in the simplicial object. -/
@[stacks 018U "naturality of the objectwise skeleton-generated comparison"]
theorem naturality (n : ℕ) {U V : SimplicialObject A} (f : U ⟶ V) :
    (sk n).map f ≫ (generated.isoApp n V).hom =
      (generated.isoApp n U).hom ≫
        (SimplicialObject.generated.functor n).map f := sorry

/-- The objectwise skeleton-generated comparison followed by the generated inclusion is the
skeleton counit. -/
@[reassoc, stacks 018U "objectwise skeleton-generated comparison over the ambient object"]
theorem hom_inclusion (n : ℕ) (U : SimplicialObject A) :
    (generated.isoApp n U).hom ≫ SimplicialObject.generated.inclusion U n =
      (skAdj n).counit.app U := sorry

/-- The inverse objectwise comparison followed by the skeleton counit is the generated
inclusion. -/
@[reassoc, stacks 018U "inverse objectwise skeleton-generated comparison"]
theorem inv_counit (n : ℕ) (U : SimplicialObject A) :
    (generated.isoApp n U).inv ≫ (skAdj n).counit.app U =
      SimplicialObject.generated.inclusion U n := sorry

end generated.isoApp

/-- The canonical natural isomorphism from the simplicial `n`-skeleton to bounded-degree
generation. -/
@[stacks 018U "simplicial skeleton as the bounded-degree generated endofunctor"]
noncomputable def generated.iso (n : ℕ) :
    sk (C := A) n ≅ SimplicialObject.generated.functor (A := A) n :=
  generated.comparison.iso n (fun U ↦ counit.subobject_eq_generated n U)

namespace generated.iso

/-- The forward component of the skeleton-generated natural isomorphism is the objectwise
canonical comparison. -/
@[simp, stacks 018U "forward component of the skeleton-generated natural isomorphism"]
theorem hom_app (n : ℕ) (U : SimplicialObject A) :
    (generated.iso n).hom.app U = (generated.isoApp n U).hom := sorry

/-- The inverse component of the skeleton-generated natural isomorphism is the inverse objectwise
comparison. -/
@[simp, stacks 018U "inverse component of the skeleton-generated natural isomorphism"]
theorem inv_app (n : ℕ) (U : SimplicialObject A) :
    (generated.iso n).inv.app U = (generated.isoApp n U).inv := sorry

/-- The natural skeleton-generated comparison followed by the generated inclusion is the skeleton
counit. -/
@[reassoc, stacks 018U "natural skeleton-generated comparison over the identity functor"]
theorem hom_ι (n : ℕ) :
    (generated.iso (A := A) n).hom ≫
        SimplicialObject.generated.ι (A := A) n =
      (skAdj (C := A) n).counit := sorry

/-- The inverse natural skeleton-generated comparison followed by the counit is the generated
inclusion. -/
@[reassoc, stacks 018U "inverse natural skeleton-generated comparison over the identity functor"]
theorem inv_counit (n : ℕ) :
    (generated.iso (A := A) n).inv ≫ (skAdj (C := A) n).counit =
      SimplicialObject.generated.ι (A := A) n := sorry

end generated.iso

end CategoryTheory.SimplicialObject.Skeleton
