module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators
public import ReasLib.AlgebraicGeometry.RingedSpace.Module.Definition
import StacksCheckRecall

@[expose] public section

open AlgebraicGeometry

universe u

variable {X : RingedSpace.{u}} (F : X.Modules)

/- Definition 17.9.1 (01B5): a module sheaf on a ringed space is of finite type when it is
locally generated by finitely many sections.  The canonical owner is
`SheafOfModules.IsFiniteType`. -/
@[stacks 01B5]
#check (F.IsFiniteType : Prop)
