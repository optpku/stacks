module

public import Mathlib.RingTheory.DualNumber
public import Mathlib.Algebra.TrivSqZeroExt.Ideal
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# The residue algebra of the dual numbers

The ideal generated by `ε` is the kernel of the scalar-coefficient projection, and its quotient
is canonically the base ring.
-/

universe u

open scoped DualNumber

namespace DualNumber

variable (R : Type u)

section Semiring

variable [CommSemiring R]

/-- The square-zero ideal `(ε)` in the dual numbers. -/
@[stacks 05CS "the epsilon ideal"]
abbrev epsIdeal : Ideal R[ε] :=
  TrivSqZeroExt.kerIdeal R R

/-- The residue ideal is the principal ideal generated by `ε`. -/
@[stacks 05CS "the epsilon ideal"]
theorem epsIdeal_eq_span :
    epsIdeal R = Ideal.span ({ε} : Set R[ε]) := by
  ext x
  simp only [epsIdeal, TrivSqZeroExt.kerIdeal, RingHom.mem_ker,
    TrivSqZeroExt.fstHom_apply, fst_eq_zero_iff_eps_dvd,
    Ideal.mem_span_singleton]

end Semiring

section Ring

variable [CommRing R]

/-- The inclusion of base scalars is a right inverse to the residue projection. -/
theorem inl_rightInverse_fstHom :
    Function.RightInverse (TrivSqZeroExt.inl : R → R[ε])
      (TrivSqZeroExt.fstHom R R R) := fun _ => rfl

/-- The residue algebra of the dual numbers is canonically the base ring. -/
@[stacks 05CS "residue algebra of the dual numbers"]
def residueAlgEquiv :
    (R[ε] ⧸ epsIdeal R) ≃ₐ[R] R :=
  Ideal.quotientKerAlgEquivOfRightInverse (inl_rightInverse_fstHom R)

/-- The residue equivalence sends the class of a dual number to its scalar coefficient. -/
@[simp]
theorem residueAlgEquiv_mk (x : R[ε]) :
    residueAlgEquiv R (Ideal.Quotient.mk (epsIdeal R) x) = x.fst := rfl

end Ring

end DualNumber
