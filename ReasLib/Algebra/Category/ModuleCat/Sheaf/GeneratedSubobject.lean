module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Limits
public import Mathlib.CategoryTheory.Subobject.Lattice
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Grothendieck
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Subobject
import Mathlib.Tactic.CrossRefAttribute

/-!
# Subobjects generated by local sections

The generated subobject is the infimum of all module-sheaf subobjects containing the prescribed
local sections.  Containment is defined independently of any smallness assumptions; only the
infimum construction requires `LocallySmall` and `WellPowered`.
-/

@[expose] public section

open CategoryTheory Opposite

noncomputable section

universe u v w z t

namespace SheafOfModules.Subobject

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable {𝒪 : Sheaf J RingCat.{w}} {I : Type t}

/-- A subobject contains a family of local sections when each section belongs to its section
image over the specified site object. -/
def containsSections
    {ℱ : SheafOfModules.{z} 𝒪} (G : CategoryTheory.Subobject ℱ)
    (U : I → C) (s : ∀ i, ℱ.val.obj (op (U i))) : Prop :=
  ∀ i, s i ∈ sections G (op (U i))

/-- A subobject contains local sections exactly when every prescribed section lifts through its
inclusion. -/
theorem containsSections_iff
    {ℱ : SheafOfModules.{z} 𝒪} (G : CategoryTheory.Subobject ℱ)
    (U : I → C) (s : ∀ i, ℱ.val.obj (op (U i))) :
    containsSections G U s ↔
      ∀ i, ∃ a : (G : SheafOfModules.{z} 𝒪).val.obj (op (U i)),
        inclusionApp G (op (U i)) a = s i := sorry

section Generated

variable [LocallySmall (SheafOfModules.{z} 𝒪)]
variable [WellPowered (SheafOfModules.{z} 𝒪)]

/-- The subobject generated by a family of local sections. -/
@[stacks 01AQ "subobject generated by local sections"]
noncomputable def generatedBySections
    (ℱ : SheafOfModules.{z} 𝒪) (U : I → C) (s : ∀ i, ℱ.val.obj (op (U i))) :
    CategoryTheory.Subobject ℱ :=
  CategoryTheory.Subobject.sInf {G | containsSections G U s}

/-- The generated subobject is the least subobject containing the prescribed local sections. -/
theorem generatedBySections_isLeast
    (ℱ : SheafOfModules.{z} 𝒪) (U : I → C) (s : ∀ i, ℱ.val.obj (op (U i))) :
    IsLeast {G : CategoryTheory.Subobject ℱ | containsSections G U s}
      (generatedBySections ℱ U s) := sorry

/-- The subobject generated by local sections contains every prescribed section. -/
theorem generatedBySections_contains
    (ℱ : SheafOfModules.{z} 𝒪) (U : I → C) (s : ∀ i, ℱ.val.obj (op (U i))) :
    containsSections (generatedBySections ℱ U s) U s := sorry

/-- The subobject generated by local sections lies below every subobject containing them. -/
theorem generatedBySections_le
    (ℱ : SheafOfModules.{z} 𝒪) (U : I → C) (s : ∀ i, ℱ.val.obj (op (U i)))
    {G : CategoryTheory.Subobject ℱ} (hG : containsSections G U s) :
    generatedBySections ℱ U s ≤ G := sorry

/-- The subobject generated by local sections lies below `G` exactly when `G` contains every
prescribed section. This is the reusable `Submodule.span_le`-style universal property of
`generatedBySections`. -/
@[stacks 01AP "least-subobject criterion"]
theorem generatedBySections_le_iff
    (ℱ : SheafOfModules.{z} 𝒪) (U : I → C) (s : ∀ i, ℱ.val.obj (op (U i)))
    {G : CategoryTheory.Subobject ℱ} :
    generatedBySections ℱ U s ≤ G ↔ containsSections G U s := sorry

/-- There is a unique least subobject containing a prescribed family of local
sections. -/
@[stacks 01AP]
theorem existsUnique_generatedBySections
    (ℱ : SheafOfModules.{z} 𝒪) (U : I → C) (s : ∀ i, ℱ.val.obj (op (U i))) :
    ∃! G : CategoryTheory.Subobject ℱ,
      IsLeast {H : CategoryTheory.Subobject ℱ | containsSections H U s} G := sorry

end Generated

end SheafOfModules.Subobject
