module

public import Mathlib.Algebra.Polynomial.FieldDivision
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.RegularLocalRing.Defs

/-!
# Localization of a polynomial ring at the coordinate ideal

The principal ideal generated by the variable is prime, and localization there
is a regular local ring.
-/

@[expose] public section

universe u

namespace Polynomial

/-- The principal ideal generated by the variable in a polynomial ring over a field is prime. -/
instance spanX_isPrime (k : Type u) [Field k] :
    (Ideal.span {(X : k[X])}).IsPrime := sorry

/-- Localization of a polynomial ring over a field at the variable ideal is regular local. -/
instance localizationAtX_isRegularLocalRing (k : Type u) [Field k] :
    IsRegularLocalRing (Localization.AtPrime (Ideal.span {(X : k[X])})) :=
  IsRegularRing.isRegularLocalRing_localization (Ideal.span {(X : k[X])})

end Polynomial
