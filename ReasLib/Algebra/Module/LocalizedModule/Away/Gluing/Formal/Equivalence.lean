module

public import ReasLib.Algebra.Module.LocalizedModule.Away.Gluing.Formal.H0.Adjunction
import Mathlib.Tactic.CrossRefAttribute

/-!
# Formal gluing equivalence

For a finite principal-open family, a flat ring map that is an isomorphism
modulo the ideal generated by the family makes canonical formal gluing and
degree-zero sections quasi-inverse equivalences.  The functors, adjunction,
unit, and counit are the explicit owners from the formal-gluing API; only
their invertibility under the stated ring hypotheses is proof data.

@stack 05EP
@stack 05ER
-/

@[expose] public section

open CategoryTheory

universe u w

noncomputable section

namespace LocalizedModule.Away.FormalGluing

variable {R S : Type u} [CommRing R] [CommRing S]
variable {ι : Type w}

/-- Under flat quotient-preserving base change, every component of the unit
of the canonical formal-gluing adjunction is an isomorphism. -/
@[stacks 05ER "formal gluing adjunction unit isomorphism"]
theorem h0AdjunctionUnit_app_isIso_of_flat_of_quotientMap_bijective
    [Finite ι] (φ : R →+* S) (f : ι → R) (hflat : φ.Flat)
    (hquot :
      let I : Ideal R := Ideal.span (Set.range f)
      Function.Bijective
        (Ideal.quotientMap (Ideal.map φ I) φ Ideal.le_comap_map))
    (M : ModuleCat.{max u w} R) :
    IsIso ((h0Adjunction (φ := φ) (f := f)).unit.app M) := sorry

/-- Under flat quotient-preserving base change, every component of the
counit `Can(H⁰(X)) ⟶ X` is an isomorphism. -/
@[stacks 05ER "formal gluing adjunction counit isomorphism"]
theorem h0Counit_app_isIso_of_flat_of_quotientMap_bijective
    [Finite ι] (φ : R →+* S) (f : ι → R) (hflat : φ.Flat)
    (hquot :
      let I : Ideal R := Ideal.span (Set.range f)
      Function.Bijective
        (Ideal.quotientMap (Ideal.map φ I) φ Ideal.le_comap_map))
    (X : FormalGluing.{u, w, w} φ f) :
    IsIso ((h0Adjunction (φ := φ) (f := f)).counit.app X) := sorry

/-- Proposition 15.90.16 (05ER): canonical formal gluing and degree-zero
sections form an equivalence when the ring map is flat and induces an
isomorphism modulo the ideal generated by the finite family. -/
@[stacks 05ER "formal gluing equivalence across a flat quotient-preserving map"]
noncomputable def equivalence_of_flat_of_quotientMap_bijective
    [Finite ι] (φ : R →+* S) (f : ι → R) (hflat : φ.Flat)
    (hquot :
      let I : Ideal R := Ideal.span (Set.range f)
      Function.Bijective
        (Ideal.quotientMap (Ideal.map φ I) φ Ideal.le_comap_map)) :
    ModuleCat.{max u w} R ≌ FormalGluing.{u, w, w} φ f :=
  letI : ∀ M, IsIso ((h0Adjunction (φ := φ) (f := f)).unit.app M) :=
    fun M ↦
      h0AdjunctionUnit_app_isIso_of_flat_of_quotientMap_bijective
        φ f hflat hquot M
  letI : ∀ X, IsIso ((h0Adjunction (φ := φ) (f := f)).counit.app X) :=
    fun X ↦
      h0Counit_app_isIso_of_flat_of_quotientMap_bijective
        φ f hflat hquot X
  (h0Adjunction (φ := φ) (f := f)).toEquivalence

/-- The forward functor of the formal-gluing equivalence is the canonical
formal-gluing functor. -/
@[simp, stacks 05ER "formal gluing equivalence forward functor"]
theorem equivalence_of_flat_of_quotientMap_bijective_functor
    [Finite ι] (φ : R →+* S) (f : ι → R) (hflat : φ.Flat)
    (hquot :
      let I : Ideal R := Ideal.span (Set.range f)
      Function.Bijective
        (Ideal.quotientMap (Ideal.map φ I) φ Ideal.le_comap_map)) :
    (equivalence_of_flat_of_quotientMap_bijective
      φ f hflat hquot).functor = ofModuleFunctor φ f := sorry

/-- The inverse functor of the formal-gluing equivalence is degree-zero
sections. -/
@[simp, stacks 05ER "formal gluing equivalence inverse functor"]
theorem equivalence_of_flat_of_quotientMap_bijective_inverse
    [Finite ι] (φ : R →+* S) (f : ι → R) (hflat : φ.Flat)
    (hquot :
      let I : Ideal R := Ideal.span (Set.range f)
      Function.Bijective
        (Ideal.quotientMap (Ideal.map φ I) φ Ideal.le_comap_map)) :
    (equivalence_of_flat_of_quotientMap_bijective
      φ f hflat hquot).inverse = h0Functor (φ := φ) (f := f) := sorry

set_option maxRecDepth 2048 in
/-- The unit of the formal-gluing equivalence has the explicit degree-zero
unit as each forward component. -/
@[stacks 05ER "formal gluing equivalence unit component"]
theorem equivalence_of_flat_of_quotientMap_bijective_unitIso_hom_app
    [Finite ι] (φ : R →+* S) (f : ι → R) (hflat : φ.Flat)
    (hquot :
      let I : Ideal R := Ideal.span (Set.range f)
      Function.Bijective
        (Ideal.quotientMap (Ideal.map φ I) φ Ideal.le_comap_map))
    (M : ModuleCat.{max u w} R) :
    (equivalence_of_flat_of_quotientMap_bijective
      φ f hflat hquot).unitIso.hom.app M = h0UnitHom φ f M := sorry

/-- The counit of the formal-gluing equivalence has the explicit
`Can(H⁰(X)) ⟶ X` morphism as each forward component. -/
@[stacks 05ER "formal gluing equivalence counit component"]
theorem equivalence_of_flat_of_quotientMap_bijective_counitIso_hom_app
    [Finite ι] (φ : R →+* S) (f : ι → R) (hflat : φ.Flat)
    (hquot :
      let I : Ideal R := Ideal.span (Set.range f)
      Function.Bijective
        (Ideal.quotientMap (Ideal.map φ I) φ Ideal.le_comap_map))
    (X : FormalGluing.{u, w, w} φ f) :
    (equivalence_of_flat_of_quotientMap_bijective
      φ f hflat hquot).counitIso.hom.app X = h0CounitHom X := sorry

/-- The right quasi-inverse isomorphism `H⁰ ⋙ Can ≅ 𝟭` supplied by the
formal-gluing equivalence. -/
@[stacks 05ER "formal gluing degree-zero right quasi-inverse"]
noncomputable abbrev h0RightQuasiInverseIso_of_flat_of_quotientMap_bijective
    [Finite ι] (φ : R →+* S) (f : ι → R) (hflat : φ.Flat)
    (hquot :
      let I : Ideal R := Ideal.span (Set.range f)
      Function.Bijective
        (Ideal.quotientMap (Ideal.map φ I) φ Ideal.le_comap_map)) :
    h0Functor (φ := φ) (f := f) ⋙ ofModuleFunctor φ f ≅
      𝟭 (FormalGluing.{u, w, w} φ f) :=
  (equivalence_of_flat_of_quotientMap_bijective
    φ f hflat hquot).counitIso

/-- The canonical formal-gluing functor is an equivalence under the flat
quotient hypotheses. -/
@[stacks 05ER "canonical formal gluing functor is an equivalence"]
theorem ofModuleFunctor_isEquivalence_of_flat_of_quotientMap_bijective
    [Finite ι] (φ : R →+* S) (f : ι → R) (hflat : φ.Flat)
    (hquot :
      let I : Ideal R := Ideal.span (Set.range f)
      Function.Bijective
        (Ideal.quotientMap (Ideal.map φ I) φ Ideal.le_comap_map)) :
    Functor.IsEquivalence (ofModuleFunctor φ f) := sorry

/-- Degree-zero sections are an equivalence under the flat quotient
hypotheses. -/
@[stacks 05ER "formal gluing degree-zero functor is an equivalence"]
theorem h0Functor_isEquivalence_of_flat_of_quotientMap_bijective
    [Finite ι] (φ : R →+* S) (f : ι → R) (hflat : φ.Flat)
    (hquot :
      let I : Ideal R := Ideal.span (Set.range f)
      Function.Bijective
        (Ideal.quotientMap (Ideal.map φ I) φ Ideal.le_comap_map)) :
    Functor.IsEquivalence (h0Functor (φ := φ) (f := f)) := sorry

/-- Lemma 15.90.14 (1): for a flat map and a finite principal-open cover,
canonical formal gluing followed by degree-zero sections is naturally
isomorphic to the identity. -/
@[stacks 05EP "(1) degree-zero left quasi-inverse on a principal-open cover"]
theorem h0LeftQuasiInverse_of_flat_of_span_eq_top
    [Finite ι] (φ : R →+* S) (f : ι → R) (hflat : φ.Flat)
    (hspan : Ideal.span (Set.range f) = ⊤) :
    Nonempty
      (ofModuleFunctor.{u, w, w} φ f ⋙
          h0Functor.{u, w, w} (φ := φ) (f := f) ≅
        𝟭 (ModuleCat.{max u w} R)) := sorry

/-- Lemma 15.90.14 (2): for a flat map and a finite principal-open cover,
degree-zero sections followed by canonical formal gluing are naturally
isomorphic to the identity. -/
@[stacks 05EP "(2) formal-gluing right quasi-inverse on a principal-open cover"]
theorem h0RightQuasiInverse_of_flat_of_span_eq_top
    [Finite ι] (φ : R →+* S) (f : ι → R) (hflat : φ.Flat)
    (hspan : Ideal.span (Set.range f) = ⊤) :
    Nonempty
      (h0Functor.{u, w, w} (φ := φ) (f := f) ⋙
          ofModuleFunctor.{u, w, w} φ f ≅
        𝟭 (FormalGluing.{u, w, w} φ f)) := sorry

/-- Lemma 15.90.14 (3): canonical formal gluing along a flat finite
principal-open cover is an equivalence. -/
@[stacks 05EP "(3) formal gluing equivalence on a principal-open cover"]
theorem ofModuleFunctor_isEquivalence_of_flat_of_span_eq_top
    [Finite ι] (φ : R →+* S) (f : ι → R) (hflat : φ.Flat)
    (hspan : Ideal.span (Set.range f) = ⊤) :
    Functor.IsEquivalence (ofModuleFunctor.{u, w, w} φ f) := sorry

end LocalizedModule.Away.FormalGluing
