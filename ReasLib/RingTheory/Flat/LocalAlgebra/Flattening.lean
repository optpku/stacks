module

public import Mathlib.CategoryTheory.Subfunctor.Basic
public import ReasLib.Algebra.Category.CommAlgCat.Local
public import ReasLib.RingTheory.Flat.Locus.BaseChange

/-!
# The local-algebra flattening functor

This module defines the subterminal functor on local algebras that records the closed-point
flatness condition after tensor-product base change.
-/

@[expose] public section

open CategoryTheory PrimeSpectrum
open scoped TensorProduct

noncomputable section

universe u v w

namespace LocalAlgCat.Flattening

variable (A : Type u) (B : Type v) (M : Type w)
variable [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
variable [Algebra A B] [IsLocalHom (algebraMap A B)]
variable [AddCommGroup M] [Module B M]

-- Local instance justification (instance diamond): the target-side algebra structure on `B ⊗[A] T` competes with the left scalar path.
attribute [local instance] Algebra.TensorProduct.rightAlgebra

/-- The tensor-product base change of `B` along a local `A`-algebra `T`. -/
abbrev baseChangeRing (T : LocalAlgCat.{v} A) : Type v := B ⊗[A] T

/-- The base change of the `B`-module `M` to `B ⊗[A] T`. -/
abbrev baseChangeModule (T : LocalAlgCat.{v} A) : Type (max v w) :=
  baseChangeRing A B T ⊗[B] M

/-- The ideal of `B ⊗[A] T` generated by the maximal ideals of `T` and `B`. -/
def closedPointIdeal (T : LocalAlgCat.{v} A) : Ideal (baseChangeRing A B T) :=
  Ideal.map (algebraMap T (baseChangeRing A B T)) (IsLocalRing.maximalIdeal T) +
    Ideal.map (algebraMap B (baseChangeRing A B T)) (IsLocalRing.maximalIdeal B)

/-- The condition that the base-changed module is flat over `T` along the closed subset cut out
by the maximal ideals of `T` and `B`. -/
def IsFlatAtClosedPoint (T : LocalAlgCat.{v} A) : Prop :=
  zeroLocus (closedPointIdeal A B T : Set (baseChangeRing A B T)) ⊆
    Module.flatOverBaseLocus T (baseChangeRing A B T) (baseChangeModule A B M T)

namespace IsFlatAtClosedPoint

/-- Closed-point flatness is equivalent to flatness at every prime in the corresponding zero
locus. -/
theorem iff_primewise (T : LocalAlgCat.{v} A) :
    IsFlatAtClosedPoint A B M T ↔
      ∀ q : PrimeSpectrum (baseChangeRing A B T),
        q ∈ zeroLocus (closedPointIdeal A B T : Set (baseChangeRing A B T)) →
          Module.Flat T (LocalizedModule.AtPrime q.asIdeal (baseChangeModule A B M T)) := sorry

/-- Closed-point flatness is preserved by a local morphism of local `A`-algebras. -/
theorem map {T U : LocalAlgCat.{v} A} (g : T ⟶ U)
    (h : IsFlatAtClosedPoint A B M T) :
    IsFlatAtClosedPoint A B M U := sorry

end IsFlatAtClosedPoint

/-- The subfunctor of the terminal `PUnit` functor cut out by closed-point flatness. -/
def subfunctor :
    CategoryTheory.Subfunctor ((Functor.const (LocalAlgCat.{v} A)).obj (PUnit : Type u)) where
  obj T := fun _ ↦ IsFlatAtClosedPoint A B M T
  map g _ h := IsFlatAtClosedPoint.map A B M g h

/-- Membership in the flattening subfunctor is exactly closed-point flatness. -/
theorem mem_subfunctor_obj (T : LocalAlgCat.{v} A) (x : PUnit.{u + 1}) :
    x ∈ (subfunctor A B M).obj T ↔ IsFlatAtClosedPoint A B M T := sorry

/-- The subterminal Type-valued functor recording closed-point flatness after base change. -/
def functor : LocalAlgCat.{v} A ⥤ Type u :=
  (subfunctor A B M).toFunctor

/-- A fiber of the flattening functor is inhabited exactly when closed-point flatness holds. -/
theorem functor_obj_nonempty_iff (T : LocalAlgCat.{v} A) :
    Nonempty ((functor A B M).obj T) ↔ IsFlatAtClosedPoint A B M T := sorry

/-- A fiber of the flattening functor is empty exactly when closed-point flatness fails. -/
theorem functor_obj_isEmpty_iff (T : LocalAlgCat.{v} A) :
    IsEmpty ((functor A B M).obj T) ↔ ¬ IsFlatAtClosedPoint A B M T := sorry

/-- Every fiber of the flattening functor has at most one element. -/
instance functorObjSubsingleton (T : LocalAlgCat.{v} A) :
    Subsingleton ((functor A B M).obj T) := sorry

end LocalAlgCat.Flattening
