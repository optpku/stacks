module

public import Mathlib.Algebra.Polynomial.Bivariate
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Spectrum.Prime.Basic
import StacksCheckRecall

/-!
# The prime spectrum of a bivariate polynomial ring

@stack 00F0
-/

@[expose] public section

open Polynomial PrimeSpectrum
open scoped Polynomial.Bivariate

universe u

variable {k : Type u} [Field k]

/-- An ideal of `k[x, y]` is in irreducible principal form if it is generated by one
irreducible polynomial. -/
inductive IrreduciblePrincipalIdealForm (I : Ideal k[X][Y]) : Prop
  | mk
      (generator : k[X][Y])
      (irreducible_generator : Irreducible generator)
      (eq_span_singleton : I = Ideal.span ({generator} : Set k[X][Y])) :
      IrreduciblePrincipalIdealForm I

/-- An ideal of `k[x, y]` is in irreducible pair form if it is generated by `C p` and `f`,
where `p` is irreducible and the image of `f` modulo `(p)` is irreducible. -/
inductive IrreduciblePairIdealForm (I : Ideal k[X][Y]) : Prop
  | mk
      (polynomial_x : k[X])
      (irreducible_polynomial_x : Irreducible polynomial_x)
      (polynomial_y : k[X][Y])
      (irreducible_quotient_image :
        Irreducible
          (polynomial_y.map
            (Ideal.Quotient.mk
              (Ideal.span ({polynomial_x} : Set k[X])))))
      (eq_span_pair : I = Ideal.span ({C polynomial_x, polynomial_y} : Set k[X][Y])) :
      IrreduciblePairIdealForm I

namespace IrreduciblePrincipalIdealForm

/-- Ideals in irreducible principal form are prime. -/
theorem isPrime {I : Ideal k[X][Y]} (hI : IrreduciblePrincipalIdealForm I) : I.IsPrime := sorry

end IrreduciblePrincipalIdealForm

namespace IrreduciblePairIdealForm

/-- Ideals in irreducible pair form are prime. -/
theorem isPrime {I : Ideal k[X][Y]} (hI : IrreduciblePairIdealForm I) : I.IsPrime := sorry

end IrreduciblePairIdealForm

/-- **Example 10.27.3** ([Stacks tag 00F0](https://stacks.math.columbia.edu/tag/00F0)):
every point of `Spec(k[x, y])` is the zero ideal, an irreducible principal ideal, or an
irreducible pair ideal. -/
@[stacks 00F0]
theorem prime_spectrum_polynomial_polynomial_eq_bot_or_principal_or_pair
    (𝔭 : PrimeSpectrum k[X][Y]) :
    𝔭.asIdeal = ⊥ ∨
      IrreduciblePrincipalIdealForm 𝔭.asIdeal ∨
      IrreduciblePairIdealForm 𝔭.asIdeal := sorry

/-- Ideal-level reformulation of Example 10.27.3. -/
@[stacks 00F0 "ideal-level classification"]
theorem prime_ideal_polynomial_polynomial_eq_bot_or_principal_or_pair
    (I : Ideal k[X][Y]) :
    I.IsPrime ↔
      I = ⊥ ∨
        IrreduciblePrincipalIdealForm I ∨
        IrreduciblePairIdealForm I := sorry

@[stacks 00F0 "canonical point object"]
#check @PrimeSpectrum

@[stacks 00F0 "prime-ideal view"]
#check @Ideal.IsPrime
