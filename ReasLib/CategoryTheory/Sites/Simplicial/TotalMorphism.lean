module

public import Mathlib.CategoryTheory.Adjunction.Mates
public import ReasLib.CategoryTheory.Sites.Topos.Composition
public import ReasLib.CategoryTheory.Sites.Simplicial.Morphism
public import ReasLib.CategoryTheory.Sites.Simplicial.Stage

/-!
# Total topos morphisms of covariant simplicial sites

A morphism of simplicial sites `α : C' ⟶ C` in the covariant presentation induces a
continuous functor of total sites by applying `α` degreewise via `Grothendieck.map`,
and hence a morphism of topoi `h_total : Sh(C_total) ⟶ Sh(C'_total)`.
-/

@[expose] public section

universe u v w

open CategoryTheory CategoryTheory.Limits Opposite
open scoped CategoryTheory.MorphismOfTopoiIn

noncomputable section

namespace CategoryTheory.SimplicialSites

variable {C C' : SimplexCategory ⥤ Cat.{v, u}}
variable (J : ∀ n, Precoverage (C.obj n)) (J' : ∀ n, Precoverage (C'.obj n))
variable [∀ n, HasWeakSheafify (J n).toGrothendieck (Type w)]
variable [∀ n, HasWeakSheafify (J' n).toGrothendieck (Type w)]
variable [∀ (m n : SimplexCategory) (φ : m ⟶ n) (P : (C.obj m)ᵒᵖ ⥤ Type w),
    ((C.map φ).toFunctor).op.HasLeftKanExtension P]
variable [∀ (m n : SimplexCategory) (φ : m ⟶ n) (P : (C'.obj m)ᵒᵖ ⥤ Type w),
    ((C'.map φ).toFunctor).op.HasLeftKanExtension P]
variable [instC : IsMorphismDiagram C J] [instC' : IsMorphismDiagram C' J']
variable (α : C' ⟶ C)
variable [∀ n (P : (C'.obj n)ᵒᵖ ⥤ Type w), ((α.app n).toFunctor).op.HasLeftKanExtension P]
variable [hα : IsMorphism J J' α]
include instC instC' hα

namespace IsMorphism

/-- The functor `v_total : C'_total ⥤ C_total` obtained by applying the component functors
of `α` in each degree. -/
def totalFunctor : totalSite C' ⥤ totalSite C :=
  (Grothendieck.map (Functor.whiskerRight α Cat.opFunctor.{v, u})).op

/-- `totalFunctor` sends `ofObj C' n U` to `ofObj C n ((α.app n).toFunctor.obj U)`. -/
theorem totalFunctor_obj (n : SimplexCategory) (U : C'.obj n) :
    (totalFunctor α).obj (ofObj C' n U) =
      ofObj C n ((α.app n).toFunctor.obj U) :=
  sorry

/-- `v_total` intertwines the degree-`n` inclusions on morphisms. -/
theorem totalFunctor_map_ofStage {n : SimplexCategory} {X Y : C'.obj n} (f : X ⟶ Y) :
    (totalFunctor α).map ((ofStage C' n).map f) =
      (ofStage C n).map ((α.app n).toFunctor.map f) :=
  sorry

/-- The degree-`n` inclusion of `C'` followed by `v_total` is the component functor followed by
the degree-`n` inclusion of `C`. -/
def totalFunctor_comp_ofStage (n : SimplexCategory) :
    ofStage C' n ⋙ totalFunctor α ≅ (α.app n).toFunctor ⋙ ofStage C n :=
  NatIso.ofComponents (fun _ ↦ Iso.refl _) sorry

/-- `totalFunctor_comp_ofStage` is the identity on objects. -/
theorem totalFunctor_comp_ofStage_hom_app (n : SimplexCategory) (U : C'.obj n) :
    (totalFunctor_comp_ofStage α n).hom.app U = 𝟙 _ :=
  sorry

variable [HasWeakSheafify (topology C J) (Type w)]
variable [HasWeakSheafify (topology C' J') (Type w)]
variable [HasSheafify (topology C J) (Type w)]
variable [HasSheafify (topology C' J') (Type w)]
variable [∀ n, HasSheafify (J n).toGrothendieck (Type w)]
variable [∀ n, HasSheafify (J' n).toGrothendieck (Type w)]
variable [∀ n, ∀ P : (C.obj n)ᵒᵖ ⥤ Type w, (ofStage C n).op.HasLeftKanExtension P]
variable [∀ n, ∀ P : (C'.obj n)ᵒᵖ ⥤ Type w, (ofStage C' n).op.HasLeftKanExtension P]
variable [∀ n, ∀ P : (C.obj n)ᵒᵖ ⥤ Type w, (ofStage C n).op.HasPointwiseRightKanExtension P]
variable [∀ n, ∀ P : (C'.obj n)ᵒᵖ ⥤ Type w, (ofStage C' n).op.HasPointwiseRightKanExtension P]
variable [∀ P : (totalSite C')ᵒᵖ ⥤ Type w, ((totalFunctor α).op).HasLeftKanExtension P]

/-- `v_total` is continuous for the total topologies generated by coverings within each degree. -/
instance instTotalFunctorIsContinuous :
    ((totalFunctor α).IsContinuous (topology C' J') (topology C J)) :=
  sorry

/-- Inverse image along `v_total` preserves finite limits, so `h_total` is a morphism of topoi. -/
instance instTotalSheafPullbackPreservesFiniteLimits :
    PreservesFiniteLimits
      ((totalFunctor α).sheafPullback (Type w) (topology C' J') (topology C J)) :=
  sorry

/-- The morphism of topoi `h_total : Sh(C_total) ⟶ Sh(C'_total)` presented by
`totalFunctor`. -/
def total : MorphismOfTopoiIn (topology C' J') (topology C J) :=
  (totalFunctor α).morphismOfTopoiInOfContinuous (topology C' J') (topology C J)

/-- Inverse image of `total` is sheaf pullback along `v_total`. -/
theorem total_inverseImage :
    (total J J' α).inverseImage =
      (totalFunctor α).sheafPullback (Type w) (topology C' J') (topology C J) :=
  sorry

/-- Direct image of `total` is continuous sheaf pushforward along `v_total`. -/
theorem total_pushforward :
    (total J J' α).pushforward =
      (totalFunctor α).sheafPushforwardContinuous (Type w) (topology C' J') (topology C J) :=
  sorry

/-- The composite `ofStage C' n ⋙ v_total` is continuous. -/
instance instTotalFunctorCompOfStageIsContinuous (n : SimplexCategory) :
    (ofStage C' n ⋙ totalFunctor α).IsContinuous (J' n).toGrothendieck (topology C J) :=
  Functor.isContinuous_comp (ofStage C' n) (totalFunctor α)
    (J' n).toGrothendieck (topology C' J') (topology C J)

/-- The composite `v_n ⋙ ofStage C n` is continuous. -/
instance instComponentCompOfStageIsContinuous (n : SimplexCategory) :
    ((α.app n).toFunctor ⋙ ofStage C n).IsContinuous
      (J' n).toGrothendieck (topology C J) :=
  Functor.isContinuous_comp (α.app n).toFunctor (ofStage C n)
    (J' n).toGrothendieck (J n).toGrothendieck (topology C J)

/-- Continuous pushforward form of the mixed identity:
`h_total,* ⋙ stageRestrict' ≅ stageRestrict ⋙ h_n,*`. -/
def restrict_pushforward_stageRestrict (n : SimplexCategory) :
    (total J J' α).pushforward ⋙ stageRestrict C' J' (Type w) n ≅
      stageRestrict C J (Type w) n ⋙ (topos J J' α n).pushforward :=
  Functor.sheafPushforwardContinuousComp' (totalFunctor_comp_ofStage α n) (Type w)
      (J' n).toGrothendieck (topology C' J') (topology C J) ≪≫
    (Functor.sheafPushforwardContinuousComp ((α.app n).toFunctor) (ofStage C n) (Type w)
      (J' n).toGrothendieck (J n).toGrothendieck (topology C J)).symm

/-- The mixed identity `(g'_n)⁻¹ ∘ h_total,* ≅ h_n,* ∘ g_n⁻¹`, obtained by transporting
`restrict_pushforward_stageRestrict` along `g_n⁻¹ ≅ stageRestrict`. -/
def restrict_pushforward (n : SimplexCategory) :
    (total J J' α).pushforward ⋙ (ofStageMorphism C' J' n).inverseImage ≅
      (ofStageMorphism C J n).inverseImage ⋙ (topos J J' α n).pushforward :=
  Functor.isoWhiskerLeft ((total J J' α).pushforward)
      (ofStageMorphism_inverseImage_iso_stageRestrict C' J' n) ≪≫
    restrict_pushforward_stageRestrict J J' α n ≪≫
    Functor.isoWhiskerRight (ofStageMorphism_inverseImage_iso_stageRestrict C J n).symm
      (topos J J' α n).pushforward

/-- Mate of `restrict_pushforward_stageRestrict` along the adjunctions of `h_total` and `h_n`. -/
def inverseImage_comp_stageRestrict_mate (n : SimplexCategory) :
    stageRestrict C' J' (Type w) n ⋙ (topos J J' α n).inverseImage ⟶
      (total J J' α).inverseImage ⋙ stageRestrict C J (Type w) n :=
  (mateEquiv (total J J' α).adjunction (topos J J' α n).adjunction).symm
    (restrict_pushforward_stageRestrict J J' α n).hom

/-- The mate of the mixed identity along `h_total` and `h_n` is invertible. -/
instance inverseImage_comp_stageRestrict_mate_isIso (n : SimplexCategory) :
    IsIso (inverseImage_comp_stageRestrict_mate J J' α n) :=
  sorry

/-- Inverse-image form of the degree-`n` square after replacing `g_n⁻¹` by `stageRestrict`. -/
def inverseImage_comp_stageRestrict (n : SimplexCategory) :
    (total J J' α).inverseImage ⋙ stageRestrict C J (Type w) n ≅
      stageRestrict C' J' (Type w) n ⋙ (topos J J' α n).inverseImage :=
  (asIso (inverseImage_comp_stageRestrict_mate J J' α n)).symm

/-- Inverse images commute with the degree-`n` morphisms of topoi:
`g_n⁻¹ ∘ h_total⁻¹ ≅ h_n⁻¹ ∘ (g'_n)⁻¹`. -/
def inverseImage_comp (n : SimplexCategory) :
    (total J J' α).inverseImage ⋙ (ofStageMorphism C J n).inverseImage ≅
      (ofStageMorphism C' J' n).inverseImage ⋙ (topos J J' α n).inverseImage :=
  Functor.isoWhiskerLeft ((total J J' α).inverseImage)
      (ofStageMorphism_inverseImage_iso_stageRestrict C J n) ≪≫
    inverseImage_comp_stageRestrict J J' α n ≪≫
    Functor.isoWhiskerRight (ofStageMorphism_inverseImage_iso_stageRestrict C' J' n).symm
      (topos J J' α n).inverseImage

end IsMorphism

end CategoryTheory.SimplicialSites

