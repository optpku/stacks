module

public import Mathlib.Topology.Inseparable
public import Mathlib.RingTheory.Ideal.GoingDown
public import Mathlib.Algebra.MvPolynomial.Rename
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import Mathlib.FieldTheory.IsAlgClosed.Basic

@[expose] public section

noncomputable section

open PrimeSpectrum

universe u

namespace GoingUpDown.Parabola

/-- The ideal generated by `X 0 ^ 2 - X 1` and `X 2 ^ 2 - X 0` in a three-variable polynomial ring. -/
def parabolaIdeal (k : Type u) [Field k] : Ideal (MvPolynomial (Fin 3) k) :=
  Ideal.span
    {MvPolynomial.X 0 ^ 2 - MvPolynomial.X 1, MvPolynomial.X 2 ^ 2 - MvPolynomial.X 0}

/-- The quotient of the three-variable polynomial ring by `parabolaIdeal k`. -/
abbrev parabolaAdjoin (k : Type u) [Field k] : Type u :=
  MvPolynomial (Fin 3) k ⧸ parabolaIdeal k

/-- The `MvPolynomial (Fin 2) k`-algebra structure induced on `parabolaAdjoin k`. -/
instance algebra_parabolaAdjoin (k : Type u) [Field k] :
    Algebra (MvPolynomial (Fin 2) k) (parabolaAdjoin k) :=
  ((Ideal.Quotient.mk (parabolaIdeal k)).comp
    (MvPolynomial.rename Fin.castSucc).toRingHom).toAlgebra

/-- In `parabolaAdjoin k`, the square of the image of `X 0` equals the image of `X 1`. -/
theorem parabolaAdjoin_X0_sq (k : Type u) [Field k] :
    algebraMap (MvPolynomial (Fin 2) k) (parabolaAdjoin k) (MvPolynomial.X 0) ^ 2 =
      algebraMap (MvPolynomial (Fin 2) k) (parabolaAdjoin k) (MvPolynomial.X 1) :=
  sorry

/-- In `parabolaAdjoin k`, the square of the image of `X 2` equals the image of `X 0`. -/
theorem parabolaAdjoin_X2_sq (k : Type u) [Field k] :
    Ideal.Quotient.mk (parabolaIdeal k) (MvPolynomial.X 2) ^ 2 =
      Ideal.Quotient.mk (parabolaIdeal k) (MvPolynomial.X 0) :=
  sorry

/-- The algebra map sends `X i` to the class of `X i.castSucc` in `parabolaAdjoin k`. -/
theorem algebraMap_parabolaAdjoin_X (k : Type u) [Field k] (i : Fin 2) :
    algebraMap (MvPolynomial (Fin 2) k) (parabolaAdjoin k) (MvPolynomial.X i) =
      Ideal.Quotient.mk (parabolaIdeal k) (MvPolynomial.X i.castSucc) :=
  sorry

/-- The map on spectra induced by the parabola quotient over an algebraically closed field is specializing. -/
theorem specializingMap_comap_parabolaAdjoin {k : Type u} [Field k] [IsAlgClosed k] :
    SpecializingMap
      (comap (algebraMap (MvPolynomial (Fin 2) k) (parabolaAdjoin k))) :=
  sorry

/-- The parabola quotient over an algebraically closed field does not have going down. -/
theorem not_hasGoingDown_parabolaAdjoin {k : Type u} [Field k] [IsAlgClosed k] :
    ¬ Algebra.HasGoingDown (MvPolynomial (Fin 2) k) (parabolaAdjoin k) :=
  sorry

end GoingUpDown.Parabola
