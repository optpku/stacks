module

public import Mathlib.Algebra.DirectSum.Module
public import Mathlib.RingTheory.PowerSeries.Basic
public import Mathlib.Topology.Algebra.FilterBasis
public import Mathlib.Topology.Algebra.LinearTopology
public import Mathlib.Topology.Algebra.Nonarchimedean.AdicTopology
public import ReasLib.Topology.Algebra.LinearTopology

/-!
# A weighted power-series direct-sum topology

The weighted submodules on a direct sum of power-series modules give a concrete
linearly topologized module with pointwise, but not uniform, ideal absorption.
-/

@[expose] public section

noncomputable section

open scoped Pointwise

universe u

namespace IsLinearTopology.PowerSeriesDirectSum

variable (k : Type u) [Field k]

/-- The principal ideal generated by `X` in `k⟦X⟧`. -/
def xIdeal : Ideal (PowerSeries k) :=
  Ideal.span ({(PowerSeries.X : PowerSeries k)} : Set (PowerSeries k))

/-- The direct sum of countably many copies of `k⟦X⟧`. -/
abbrev Module := DirectSum ℕ fun _ : ℕ ↦ PowerSeries k

/-- The weighted coordinatewise submodule with exponent `n * m` in coordinate `n`. -/
def openSubmodule (m : ℕ) : Submodule (PowerSeries k) (Module k) :=
  ⨅ n : ℕ, Submodule.comap (DirectSum.component (PowerSeries k) ℕ
    (fun _ : ℕ ↦ PowerSeries k) n) (xIdeal k ^ (n * m))

/-- Membership in the weighted submodule is coordinatewise membership in the corresponding ideal
power. -/
theorem mem_openSubmodule {m : ℕ} {x : Module k} :
    x ∈ openSubmodule k m ↔ ∀ n, x n ∈ xIdeal k ^ (n * m) := sorry

/-- The weighted submodules admit a common refinement under intersections. -/
theorem basisInter (m n : ℕ) :
    ∃ p : ℕ, (openSubmodule k p : Set (Module k)) ⊆
      (openSubmodule k m : Set (Module k)) ∩ openSubmodule k n := sorry

/-- Every weighted submodule contains the zero vector. -/
theorem basisZero (m : ℕ) : (0 : Module k) ∈ openSubmodule k m := sorry

/-- The weighted submodules admit an additive refinement. -/
theorem basisAdd (m : ℕ) :
    ∃ n : ℕ, (openSubmodule k n : Set (Module k)) + (openSubmodule k n : Set (Module k)) ⊆
      (openSubmodule k m : Set (Module k)) := sorry

/-- The weighted submodules admit a refinement stable under negation. -/
theorem basisNeg (m : ℕ) :
    ∃ n : ℕ, (openSubmodule k n : Set (Module k)) ⊆
      (fun x : Module k ↦ -x) ⁻¹' (openSubmodule k m : Set (Module k)) := sorry

/-- The additive filter basis whose sets are the weighted submodules. -/
@[implicit_reducible]
def moduleAddGroupFilterBasis : AddGroupFilterBasis (Module k) :=
  addGroupFilterBasisOfComm
    (Set.range fun m : ℕ ↦ (openSubmodule k m : Set (Module k)))
    (Set.range_nonempty _)
    (fun U V hU hV ↦ by
      rcases hU with ⟨m, rfl⟩
      rcases hV with ⟨n, rfl⟩
      rcases basisInter (k := k) m n with ⟨p, hp⟩
      exact ⟨openSubmodule k p, ⟨p, rfl⟩, hp⟩)
    (fun U hU ↦ by
      rcases hU with ⟨m, rfl⟩
      exact basisZero (k := k) m)
    (fun U hU ↦ by
      rcases hU with ⟨m, rfl⟩
      rcases basisAdd (k := k) m with ⟨n, hn⟩
      exact ⟨openSubmodule k n, ⟨n, rfl⟩, hn⟩)
    (fun U hU ↦ by
      rcases hU with ⟨m, rfl⟩
      rcases basisNeg (k := k) m with ⟨n, hn⟩
      exact ⟨openSubmodule k n, ⟨n, rfl⟩, hn⟩)

/-- The topology generated by the weighted additive filter basis. -/
@[implicit_reducible]
def moduleTopologicalSpace : TopologicalSpace (Module k) :=
  (moduleAddGroupFilterBasis k).topology

/-- The canonical topology on the weighted power-series direct sum. -/
instance instTopologicalSpace : TopologicalSpace (Module k) :=
  moduleTopologicalSpace k

/-- The weighted filter basis gives the direct sum a topological additive-group structure. -/
instance instIsTopologicalAddGroup : IsTopologicalAddGroup (Module k) :=
  (moduleAddGroupFilterBasis k).isTopologicalAddGroup

/-- The weighted submodules form a neighbourhood basis at zero. -/
theorem hasBasis_openSubmodule :
    (nhds (0 : Module k)).HasBasis (fun _ : ℕ ↦ True) fun m ↦
      (openSubmodule k m : Set (Module k)) := sorry

/-- The weighted topology is linear over `k⟦X⟧`. -/
instance instIsLinearTopology : IsLinearTopology (PowerSeries k) (Module k) :=
  IsLinearTopology.mk_of_hasBasis (PowerSeries k) (hasBasis_openSubmodule k)

/-- The `X`-adic topology on `k⟦X⟧`, kept as an explicit competing topology. -/
@[implicit_reducible]
def ringTopologicalSpace : TopologicalSpace (PowerSeries k) :=
  (xIdeal k).adicTopology

/-- Every vector is pointwise absorbed by a sufficiently large power of `X`. -/
theorem exists_pow_smul_mem (x : Module k) (m : ℕ) :
    ∃ n : ℕ, ∀ r ∈ xIdeal k ^ n, r • x ∈ openSubmodule k m := sorry

/-- No power of `X` uniformly absorbs the whole module into a positive weighted submodule. -/
theorem not_exists_pow_smul_top {m : ℕ} (hm : 0 < m) :
    ¬ ∃ n : ℕ,
        xIdeal k ^ n • (⊤ : Submodule (PowerSeries k) (Module k)) ≤ openSubmodule k m := sorry

/-- Scalar multiplication is continuous for the weighted module topology and the `X`-adic ring
topology. -/
theorem continuousSMul {k : Type u} [Field k] [TopologicalSpace (PowerSeries k)]
    [IsTopologicalRing (PowerSeries k)] (h_adic : IsAdic (xIdeal k)) :
    Continuous fun p : PowerSeries k × Module k ↦ p.1 • p.2 := sorry

/-- Uniform absorption fails for every weighted index. -/
theorem not_forall_exists_pow_smul_top {k : Type u} [Field k] :
    ¬ ∀ m : ℕ, ∃ n : ℕ,
        xIdeal k ^ n • (⊤ : Submodule (PowerSeries k) (Module k)) ≤ openSubmodule k m := sorry

end IsLinearTopology.PowerSeriesDirectSum
