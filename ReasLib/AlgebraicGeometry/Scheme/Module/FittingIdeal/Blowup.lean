module

public import ReasLib.AlgebraicGeometry.RingedSpace.Module.LocallyFree
public import ReasLib.AlgebraicGeometry.Scheme.Blowup.Basic
public import ReasLib.AlgebraicGeometry.Scheme.Module.FittingIdeal.LocalGenerators
public import ReasLib.AlgebraicGeometry.Scheme.Module.FittingIdeal.Locus
public import ReasLib.AlgebraicGeometry.Scheme.StrictTransform
import ReasLib.RingTheory.ReesAlgebra.BlowupChart.StrictTransform

/-!
# Strict transforms under Fitting-ideal blowups

Blowing up the Fitting ideal sheaf of a finite-type quasicoherent module makes its strict
transform locally generated by the prescribed number of sections. When the original module
has the expected rank off the center, the strict transform is finite locally free of that rank.
-/

@[expose] public section

open CategoryTheory TopologicalSpace

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme.fittingIdealSheaf

/-- The strict transform of a finite-type quasicoherent module under the blowup of its `k`th
Fitting ideal is generated by `k` sections on a neighborhood of every point. -/
@[stacks 0CZP]
theorem strictTransformModule_exists_isGeneratedBy_on_neighborhood
    {S S' : Scheme.{u}} (b : S' ⟶ S) (ℱ : S.Modules) [ℱ.IsFiniteType] [ℱ.IsQuasicoherent]
    (k : ℕ) [IsBlowup b (Scheme.fittingIdealSheaf ℱ k)]
    (y : strictTransformAmbient b (𝟙 S)) :
    ∃ U : Opens (strictTransformAmbient b (𝟙 S)), y ∈ U ∧
      SheafOfModules.IsGeneratedBy
        ((strictTransformModule b ((Scheme.fittingIdealSheaf ℱ k).comap b) (𝟙 S) ℱ).over U) k :=
  sorry

/-- If a finite-type quasicoherent module is finite locally free of rank `k` away from its
`k`th Fitting closed subscheme, then its strict transform under the blowup of that subscheme is
finite locally free of rank `k`. -/
@[stacks 0CZQ, instance]
theorem strictTransformModule_isFiniteLocallyFreeOfRank
    {S S' : Scheme.{u}} (b : S' ⟶ S) (ℱ : S.Modules) [ℱ.IsFiniteType] [ℱ.IsQuasicoherent]
    (k : ℕ) [IsBlowup b (Scheme.fittingIdealSheaf ℱ k)]
    [SheafOfModules.IsFiniteLocallyFreeOfRank k
      ((Scheme.Modules.pullback (Scheme.fittingOpenComplement ℱ k).ι).obj ℱ)] :
    SheafOfModules.IsFiniteLocallyFreeOfRank k
      (strictTransformModule b ((Scheme.fittingIdealSheaf ℱ k).comap b) (𝟙 S) ℱ) := sorry

end AlgebraicGeometry.Scheme.fittingIdealSheaf
