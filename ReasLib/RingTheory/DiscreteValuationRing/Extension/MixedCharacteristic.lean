module

public import Mathlib.Algebra.CharP.MixedCharZero
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import ReasLib.RingTheory.DiscreteValuationRing.Extension.Ramification
import Mathlib.Tactic.CrossRefAttribute

/-!
# Mixed-characteristic discrete valuation rings

This leaf owns the canonical localized-integer map `ℤ_(p) → A` attached to a mixed-characteristic
DVR and defines its absolute ramification index through the standard DVR-extension invariant.

@stack 09EK
-/

@[expose] public section

open Ideal IsLocalRing IsExtensionOfDiscreteValuationRings

universe u

namespace IsLocalRing

/-- A local ring is canonically a localization of itself at the complement of its maximal
ideal. -/
@[stacks 09EK "self-localization at the maximal ideal"]
instance selfIsLocalizationPrimeCompl
    (A : Type u) [CommRing A] [IsLocalRing A] :
    IsLocalization (maximalIdeal A).primeCompl A := sorry
-- Proof strategy: apply `IsLocalization.self`; every element of
-- `(maximalIdeal A).primeCompl` is a unit by `IsLocalRing.notMem_maximalIdeal`.

end IsLocalRing

namespace DVR.MixedCharacteristic

/-- The principal prime ideal `(p)` of `ℤ`. -/
@[stacks 09EK "integer prime ideal"]
abbrev integerPrimeIdeal (p : ℕ) : Ideal ℤ := Ideal.span ({(p : ℤ)} : Set ℤ)

/-- Definition 15.114.3 (1) (current Stacks Definition 15.115.3): for a DVR, mixed characteristic
`(0, p)` is equivalent to characteristic zero on its fraction field and characteristic `p` on its
residue field. -/
@[stacks 09EK "mixed-characteristic criterion for a discrete valuation ring"]
theorem mixedCharZero_iff_fractionRing_charZero_and_residueField_charP
    (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (p : ℕ) [Fact p.Prime] :
    MixedCharZero A p ↔ CharZero (FractionRing A) ∧ CharP (ResidueField A) p := sorry
-- Proof strategy: in the forward direction, use `MixedCharZero.toCharZero` for the fraction field
-- and `MixedCharZero.reduce_to_maximal_ideal` to move the characteristic-`p` quotient to the unique
-- maximal ideal, hence to `ResidueField A`.  Conversely, pull `CharZero` back along
-- `algebraMap A (FractionRing A)` and use `maximalIdeal A` as the proper quotient witnessing
-- `MixedCharZero A p`.

/-- The principal ideal generated by an integer prime is prime. -/
@[stacks 09EK "primality of the integer prime ideal"]
instance integerPrimeIdealIsPrime (p : ℕ) [Fact p.Prime] :
    (integerPrimeIdeal p).IsPrime := sorry
-- Proof strategy: apply `Ideal.span_singleton_prime`; `Fact.out : p.Prime` gives both
-- `(p : ℤ) ≠ 0` and primality through `Int.prime_iff_natAbs_prime`.

/-- The localization `ℤ_(p)` is a discrete valuation ring. -/
@[stacks 09EK "discrete valuation structure on localized integers"]
instance integerPrimeLocalizationIsDVR (p : ℕ) [Fact p.Prime] :
    IsDiscreteValuationRing (Localization.AtPrime (integerPrimeIdeal p)) := sorry
-- Proof strategy: use
-- `IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain` for the Dedekind domain
-- `ℤ`; nonzeroness of `integerPrimeIdeal p` follows from `Fact.out : p.Prime`.

variable {A : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
variable (p : ℕ) [Fact p.Prime] [MixedCharZero A p]

/-- In mixed characteristic `(0, p)`, `(p)` is the contraction of the maximal ideal along
`ℤ → A`. -/
@[stacks 09EK "integer prime as the contraction of the maximal ideal"]
theorem integerPrimeIdeal_eq_comap_maximalIdeal :
    integerPrimeIdeal p = Ideal.comap (Int.castRingHom A) (maximalIdeal A) := sorry
-- Proof strategy: obtain `CharP (ResidueField A) p` from the mixed-characteristic criterion and
-- extensionalize on `z : ℤ`.  Membership in the comap is vanishing of `z` in the residue field;
-- `CharP.intCast_eq_zero_iff` identifies this with divisibility by `p`, which is membership in
-- `Ideal.span {(p : ℤ)}`.

/-- Definition 15.114.3 (2): the canonical map from `ℤ_(p)` to a mixed-characteristic DVR. -/
@[stacks 09EK "canonical map from the localized integers"]
noncomputable def integerPrimeLocalizationMap :
    Localization.AtPrime (integerPrimeIdeal p) →+* A :=
  (Localization.algEquiv (maximalIdeal A).primeCompl A).toRingHom.comp
    (Localization.localRingHom (integerPrimeIdeal p) (maximalIdeal A) (Int.castRingHom A)
      (integerPrimeIdeal_eq_comap_maximalIdeal p))

/-- The canonical `ℤ_(p)`-algebra structure on a mixed-characteristic DVR. -/
@[stacks 09EK "localized-integer algebra structure"]
noncomputable instance integerPrimeLocalizationAlgebra :
    Algebra (Localization.AtPrime (integerPrimeIdeal p)) A :=
  RingHom.toAlgebra (integerPrimeLocalizationMap p)

/-- Definition 15.114.3 (3): the canonical map `ℤ_(p) → A` is an extension of discrete valuation
rings. -/
@[stacks 09EK "mixed-characteristic extension of discrete valuation rings"]
noncomputable instance integerPrimeLocalizationIsExtension :
    IsExtensionOfDiscreteValuationRings (Localization.AtPrime (integerPrimeIdeal p)) A := sorry
-- Proof strategy: unfold the explicit composite `integerPrimeLocalizationMap`.  The localized map
-- is local by `Localization.isLocalHom_localRingHom`, and the terminal localization equivalence is
-- local because it reflects units.  For injectivity, compose injectivity of
-- `Localization.algEquiv` with `IsLocalization.map_injective_of_injective'`, using
-- `MixedCharZero.toCharZero` for injectivity of `Int.castRingHom A`.  These are exactly the two
-- fields of `IsExtensionOfDiscreteValuationRings`.

/-- Definition 15.114.3 (4) (current Stacks Definition 15.115.3): the absolute ramification index of a
mixed-characteristic DVR is the ramification index of `ℤ_(p) → A`. -/
@[stacks 09EK "absolute ramification index in mixed characteristic"]
noncomputable def absoluteRamificationIndex : ℕ :=
  ramificationIndex (Localization.AtPrime (integerPrimeIdeal p)) A

end DVR.MixedCharacteristic
