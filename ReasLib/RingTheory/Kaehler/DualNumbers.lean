module

public import Mathlib.Algebra.DualNumber
public import Mathlib.RingTheory.AdjoinRoot
public import Mathlib.RingTheory.Kaehler.Basic
public import ReasLib.RingTheory.FittingIdeal.Basic

/-!
# The dual-number line `k[ε][x] / (ε x)`

Coordinate ring of the family `k[ε] → k[ε][x] / (ε x)` and its relative
Kähler differential Fitting ideals.
-/

@[expose] public section

noncomputable section

open Polynomial
open scoped DualNumber FittingIdeal

universe u

namespace DualNumbersOmega

/-- The relation polynomial `ε X` in `(k[ε])[X]`. -/
def relation (k : Type u) [CommRing k] : Polynomial (k[ε]) :=
  C (ε : k[ε]) * X

/-- The coordinate ring `k[ε][x] / (ε x)`. -/
abbrev coordRing (k : Type u) [CommRing k] : Type u :=
  AdjoinRoot (relation k)

/-- The image of `ε` in `DualNumbersOmega.coordRing k`. -/
def eps (k : Type u) [CommRing k] : coordRing k :=
  algebraMap (k[ε]) (coordRing k) ε

/-- The class of the indeterminate `x` in `DualNumbersOmega.coordRing k`. -/
def x (k : Type u) [CommRing k] : coordRing k :=
  AdjoinRoot.root (relation k)

/-- The defining relation `ε x = 0` in `DualNumbersOmega.coordRing k`. -/
theorem eps_mul_x (k : Type u) [CommRing k] : eps k * x k = 0 := sorry

/-- The Fitting ideals of the relative Kähler differentials for the dual-number
line are generated by `ε` at index zero and are the unit ideal at every
positive index. -/
theorem fittingIdeal (k : Type u) [Field k] (n : ℕ) :
    Fit[coordRing k]_(n)(Ω[coordRing k⁄ k[ε]]) =
      if n = 0 then Ideal.span {eps k} else ⊤ := sorry

/-- The zeroth relative differential Fitting ideal of the dual-number line is
the ideal generated by `ε`. -/
theorem fittingIdeal_zero (k : Type u) [Field k] :
    Fit[coordRing k]_(0)(Ω[coordRing k⁄ k[ε]]) =
      Ideal.span {eps k} := sorry

/-- Every positive-index relative differential Fitting ideal of the dual-number
line is the unit ideal. -/
theorem fittingIdeal_of_pos (k : Type u) [Field k] {n : ℕ} (hn : 0 < n) :
    Fit[coordRing k]_(n)(Ω[coordRing k⁄ k[ε]]) = ⊤ := sorry

end DualNumbersOmega
