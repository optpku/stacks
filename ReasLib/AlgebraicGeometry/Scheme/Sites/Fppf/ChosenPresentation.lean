module

public import Mathlib.CategoryTheory.ObjectProperty.FullSubcategory
public import Mathlib.CategoryTheory.Sites.Over
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import ReasLib.AlgebraicGeometry.Scheme.Cover.StandardFppf
public import ReasLib.AlgebraicGeometry.Scheme.Sites.ChosenPresentation

/-!
# Fppf sites in a chosen big-site presentation

This module defines the slice and affine fppf sites represented by a chosen
small presentation, with the affine topology generated by finite standard
fppf covers which cover in the ambient slice.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.ObjectProperty

universe u v

namespace AlgebraicGeometry

/-- An explicit small presentation of a big fppf site. -/
abbrev ChosenBigFppfSite : Type (max (u + 1) (v + 1)) :=
  ChosenBigSite.{u, v} Scheme.fppfPrecoverage

namespace ChosenBigFppfSite

/-- The carrier of the big fppf site over an object in a chosen presentation
is its slice category. -/
abbrev bigSite (X : ChosenBigFppfSite.{u, v}) (S : X.carrier) :=
  Over S

/-- The big fppf topology over an object in a chosen presentation is the slice
topology induced by the chosen big-site topology. -/
def bigTopology (X : ChosenBigFppfSite.{u, v}) (S : X.carrier) :
    GrothendieckTopology (bigSite X S) :=
  (X.toGrothendieck).over S

/-- The source-scheme functor from a chosen big fppf slice. -/
def bigToScheme (X : ChosenBigFppfSite.{u, v}) (S : X.carrier) :
    bigSite X S ⥤ Scheme.{u} :=
  Over.forget S ⋙ X.toScheme

/-- The object property selecting affine represented source schemes in a
chosen big fppf slice. -/
def bigAffineObjects (X : ChosenBigFppfSite.{u, v}) (S : X.carrier) :
    ObjectProperty (bigSite X S) :=
  fun U ↦ IsAffine (X.toScheme.obj U.left)

/-- The big affine fppf carrier is the full subcategory of the chosen big slice
on objects with affine represented source. -/
abbrev bigAffineSite (X : ChosenBigFppfSite.{u, v}) (S : X.carrier) :=
  ObjectProperty.FullSubcategory (bigAffineObjects X S)

/-- The inclusion of the chosen big affine fppf carrier into the chosen big
slice. -/
def bigAffineInclusion (X : ChosenBigFppfSite.{u, v}) (S : X.carrier) :
    bigAffineSite X S ⥤ bigSite X S :=
  ObjectProperty.ι (bigAffineObjects X S)

/-- The source-scheme functor from the chosen big affine fppf carrier. -/
def bigAffineToScheme (X : ChosenBigFppfSite.{u, v}) (S : X.carrier) :
    bigAffineSite X S ⥤ Scheme.{u} :=
  bigAffineInclusion X S ⋙ bigToScheme X S

/-- A finite standard fppf cover of an object of the chosen big affine
carrier, using the affine proof stored in that object. -/
abbrev BigAffineStandardCover (X : ChosenBigFppfSite.{u, v})
    (S : X.carrier) (U : bigAffineSite X S) :=
  @StandardFppfCover ((bigAffineToScheme X S).obj U) U.property

/-- A presieve on the chosen big affine carrier is a standard covering when it
covers in the ambient big slice and its image in schemes generates the same
sieve as a finite standard fppf cover. -/
def bigAffineStandardCovering (X : ChosenBigFppfSite.{u, v})
    (S : X.carrier) {U : bigAffineSite X S} (R : Presieve U) : Prop :=
  R.map (bigAffineInclusion X S) ∈ (bigTopology X S).toPrecoverage U.obj ∧
    ∃ 𝒰 : BigAffineStandardCover X S U,
      Sieve.generate (R.map (bigAffineToScheme X S)) =
        Sieve.generate (Presieve.ofArrows
          (@StandardFppfCover.U _ U.property 𝒰)
          (@StandardFppfCover.map _ U.property 𝒰))

/-- The precoverage of ambient-covering finite standard fppf families on the
chosen big affine carrier. -/
def bigAffineStandardPrecoverage (X : ChosenBigFppfSite.{u, v})
    (S : X.carrier) : Precoverage (bigAffineSite X S) where
  coverings := fun _ ↦ { R | bigAffineStandardCovering X S R }

/-- Membership in the chosen big affine standard precoverage records both
ambient covering and equality of generated sieves with a finite standard fppf
cover. -/
theorem mem_bigAffineStandardPrecoverage_iff
    (X : ChosenBigFppfSite.{u, v}) (S : X.carrier)
    {U : bigAffineSite X S} {R : Presieve U} :
    R ∈ bigAffineStandardPrecoverage X S U ↔
      R.map (bigAffineInclusion X S) ∈ (bigTopology X S).toPrecoverage U.obj ∧
        ∃ 𝒰 : BigAffineStandardCover X S U,
          Sieve.generate (R.map (bigAffineToScheme X S)) =
            Sieve.generate (Presieve.ofArrows
              (@StandardFppfCover.U _ U.property 𝒰)
              (@StandardFppfCover.map _ U.property 𝒰)) := sorry

/-- The Grothendieck topology on the chosen big affine carrier generated by
ambient-covering finite standard fppf families. -/
def bigAffineTopology (X : ChosenBigFppfSite.{u, v}) (S : X.carrier) :
    GrothendieckTopology (bigAffineSite X S) :=
  (bigAffineStandardPrecoverage X S).toGrothendieck

/-- The chosen big affine fppf topology is generated by its standard fppf
precoverage. -/
theorem bigAffineTopology_def (X : ChosenBigFppfSite.{u, v}) (S : X.carrier) :
    bigAffineTopology X S =
      (bigAffineStandardPrecoverage X S).toGrothendieck := sorry

end ChosenBigFppfSite

end AlgebraicGeometry
