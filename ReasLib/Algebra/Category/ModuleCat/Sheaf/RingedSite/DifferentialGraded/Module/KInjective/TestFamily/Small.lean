module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.DifferentialGraded.Module.KInjective.TestFamily.Combined
public import Mathlib.CategoryTheory.MorphismProperty.IsSmall

/-!
# Smallness of K-injective test families

The explicit indexed families are set-sized at their own index universe.  This leaf exposes that
fact to `MorphismProperty` so small-object and lifting APIs can infer it without a local proof.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits
open scoped SheafOfModules.RingedSite.DifferentialGradedAlgebra
open scoped SheafOfModules.RingedSite.DifferentialGradedModule

noncomputable section

universe u v w

namespace SheafOfModules.RingedSite.DifferentialGradedModule.Module.KInjective

section Graded

variable {C : Type u} [Category.{v} C]
variable {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat)]
variable [HasWeakSheafify J AddCommGrpCat.{max u v}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{max u v}]
variable {𝒪 : Sheaf J CommRingCat.{max u v}}

namespace GradedInjectiveTestFamily

/-- The morphism property generated by a graded-injective test family is `w`-small. -/
instance isSmall_arrows {𝒜 : DGA(𝒪)}
    (T : GradedInjectiveTestFamily.{u, v, w} 𝒜) :
    MorphismProperty.IsSmall.{w} T.arrows := sorry

end GradedInjectiveTestFamily

end Graded

section Combined

variable {C : Type u} [Category.{v} C]
variable {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat)]
variable [HasWeakSheafify J AddCommGrpCat.{max u v}]
variable [HasSheafify J AddCommGrpCat.{max u v}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{max u v}]
variable {𝒪 : Sheaf J CommRingCat.{max u v}}

namespace TestFamily

/-- The morphism property generated by a combined test family is `w`-small. -/
instance isSmall_arrows {𝒜 : DGA(𝒪)}
    (T : TestFamily.{u, v, w} 𝒜) :
    MorphismProperty.IsSmall.{w} T.arrows := sorry

end TestFamily

end Combined

end SheafOfModules.RingedSite.DifferentialGradedModule.Module.KInjective
