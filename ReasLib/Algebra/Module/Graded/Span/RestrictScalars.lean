module

public import ReasLib.Algebra.Module.Graded.Span
public import Mathlib.Algebra.Module.Submodule.RestrictScalars
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Homogeneous spans after restricting scalars

This leaf records the scalar-tower argument that a span generated by homogeneous module elements
remains homogeneous after restricting scalars.  The scalar ring and the module grading are
independent of any polynomial presentation or chapter-specific quotient.
-/

@[expose] public section

open scoped DirectSum

noncomputable section

universe u u' v w x

namespace Submodule

variable {ιA : Type u} [DecidableEq ιA]
variable {ιM : Type u'} [DecidableEq ιM]
variable {R : Type v} [Semiring R]
variable {S : Type w} [Semiring S] [Module R S]
variable {M : Type x} [AddCommMonoid M] [Module R M] [Module S M]
variable [IsScalarTower R S M] [VAdd ιA ιM]

/-- Stacks `052N`: a homogeneous component of a scalar multiple of a homogeneous element remains in
the scalar span of the original set. -/
@[stacks 052N "homogeneous component of a scalar span element"]
theorem component_smul_mem_span
    (𝒜 : ιA → Submodule R S) (ℳ : ιM → Submodule R M)
    [DirectSum.Decomposition 𝒜] [DirectSum.Decomposition ℳ]
    [SetLike.GradedSMul 𝒜 ℳ]
    {t : Set M} {x : M}
    (hx_homogeneous : SetLike.IsHomogeneousElem ℳ x)
    (hx_span : x ∈ Submodule.span S t) (a : S) (j : ιM) :
    ((DirectSum.decompose ℳ (a • x) j : ℳ j) : M) ∈ Submodule.span S t := sorry

/-- Stacks `052N`: the span over `S` of homogeneous elements is homogeneous over `R` after
restricting scalars along the scalar tower `(R, S, M)`. -/
@[stacks 052N "homogeneous span under restricted scalars"]
theorem spanRestrictScalars_isHomogeneous
    (𝒜 : ιA → Submodule R S) (ℳ : ιM → Submodule R M)
    [DirectSum.Decomposition 𝒜] [DirectSum.Decomposition ℳ]
    [SetLike.GradedSMul 𝒜 ℳ]
    {t : Set M}
    (ht : ∀ x ∈ t, SetLike.IsHomogeneousElem ℳ x) :
    ((Submodule.span S t).restrictScalars R).IsHomogeneous ℳ := sorry

end Submodule

end
