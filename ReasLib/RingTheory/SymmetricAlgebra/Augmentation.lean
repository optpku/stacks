module

public import Mathlib.LinearAlgebra.SymmetricAlgebra.Basic
public import Mathlib.RingTheory.Ideal.Cotangent
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# The augmentation cotangent module of a symmetric algebra

The generators of a symmetric algebra lie in the augmentation ideal and hence
define a canonical map to the cotangent module of that ideal.
-/

@[expose] public section

noncomputable section

universe u v

namespace SymmetricAlgebra

variable (R : Type u) (M : Type v) [CommRing R] [AddCommGroup M] [Module R M]

/-- The augmentation ideal of a symmetric algebra. -/
def augmentationIdeal : Ideal (SymmetricAlgebra R M) :=
  RingHom.ker (algebraMapInv (R := R) (M := M)).toRingHom

/-- The symmetric-algebra augmentation is surjective. -/
theorem algebraMapInv_surjective :
    Function.Surjective (algebraMapInv (R := R) (M := M)) :=
  (algebraMap_leftInverse M).surjective

/-- Quotienting a symmetric algebra by its augmentation ideal recovers the base ring. -/
noncomputable def augmentationQuotientEquiv :
    SymmetricAlgebra R M ⧸ augmentationIdeal R M ≃+* R :=
  RingHom.quotientKerEquivOfSurjective (algebraMapInv_surjective R M)

/-- The augmentation quotient equivalence sends the class of an element to its augmentation. -/
@[simp]
theorem augmentationQuotientEquiv_mk (x : SymmetricAlgebra R M) :
    augmentationQuotientEquiv R M
        (Ideal.Quotient.mk (augmentationIdeal R M) x) =
      algebraMapInv x :=
  RingHom.quotientKerEquivOfSurjective_apply_mk
    (algebraMapInv_surjective R M) x

/-- A symmetric-algebra generator, regarded as an element of the augmentation ideal. -/
def toAugmentationIdeal : M →ₗ[R] augmentationIdeal R M :=
  { toFun := fun x ↦ ⟨ι R M x, algebraMapInv_ι x⟩
    map_add' := fun x y ↦ Subtype.ext ((ι R M).map_add x y)
    map_smul' := fun r x ↦ Subtype.ext ((ι R M).map_smul r x) }

/-- The canonical map from the generating module to the cotangent module of the
symmetric-algebra augmentation. -/
def toAugmentationCotangent : M →ₗ[R] (augmentationIdeal R M).Cotangent :=
  ((augmentationIdeal R M).toCotangent.restrictScalars R).comp
    (toAugmentationIdeal R M)

/-- The augmentation ideal is generated by the image of the symmetric-algebra generators. -/
theorem algebraMapInv_ker_eq_span_range_ι :
    augmentationIdeal R M = Ideal.span (Set.range (ι R M)) := sorry

/-- The augmentation cotangent map sends a generator to its class modulo the square of the
augmentation ideal. -/
theorem toAugmentationCotangent_apply (x : M) :
    toAugmentationCotangent R M x =
      (augmentationIdeal R M).toCotangent (toAugmentationIdeal R M x) := sorry

/-- The generating module is canonically identified with the cotangent module of the
symmetric-algebra augmentation. -/
theorem toAugmentationCotangent_bijective :
    Function.Bijective (toAugmentationCotangent R M) := sorry

end SymmetricAlgebra
