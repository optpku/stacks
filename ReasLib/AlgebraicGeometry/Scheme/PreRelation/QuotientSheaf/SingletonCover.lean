module

public import Mathlib.AlgebraicGeometry.Sites.Fpqc
public import ReasLib.AlgebraicGeometry.Scheme.PreRelation.QuotientSheaf.Representability

/-!
# Quotient sheaves represented along a single covering morphism

Let `q : U ⟶ M` equalize the source and target of a pre-relation `P` on `U`. If the singleton
sieve generated by `q` covers `M` and every pair of points of `U` with the same image in `M`
is related by `P`, then the quotient class of the identity of `U` descends along `q` to a
section of the quotient sheaf over `M`. By the Yoneda lemma this section is the inverse
comparison from the represented sheaf of `M` to the quotient sheaf. Together with the canonical
comparison `quotientSheafDesc` it gives an explicit isomorphism of sheaves.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme.PreRelation

/-- The singleton sieve of a flat, surjective morphism locally of finite presentation covers its
target in the fppf topology over the base. -/
theorem generate_singleton_mem_fppf_over {S : Scheme.{u}} {U M : Over S} (q : U ⟶ M)
    [Flat q.left] [Surjective q.left] [LocallyOfFinitePresentation q.left] :
    Sieve.generate (Presieve.singleton q) ∈ Scheme.fppfTopology.over S M := by
  have h : Sieve.generate (Presieve.singleton q) =
      Sieve.ofArrows (fun _ : PUnit.{1} ↦ U) (fun _ ↦ q) := by
    rw [Sieve.ofArrows, Presieve.ofArrows_pUnit]
  rw [h, GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows, Sieve.ofArrows,
    Presieve.ofArrows_pUnit]
  exact Precoverage.generate_mem_toGrothendieck q.left.singleton_mem_fppfPrecoverage

/-- Points with the same image under `q` have the same quotient class, provided they are
related by the pre-relation. The restrictions of the quotient class of `𝟙 U` along the two
projections of a fibre product over `q` therefore agree. -/
theorem quotientClass_compatible_of_pointRel {S : Scheme.{u}} {U M : Over S}
    (J : GrothendieckTopology (Over S)) (P : PreRelation U) (q : U ⟶ M)
    (h_kernel : ∀ {W : Over S} (a b : W ⟶ U), a ≫ q = b ≫ q → P.pointRel W a b)
    {W : Over S} (a b : W ⟶ U) (h : a ≫ q = b ≫ q) :
    (P.quotientSheaf J).obj.map a.op (P.quotientClass J (𝟙 U)) =
      (P.quotientSheaf J).obj.map b.op (P.quotientClass J (𝟙 U)) := by
  rw [quotientClass_map, quotientClass_map, Category.comp_id, Category.comp_id,
    quotientClass_def, quotientClass_def]
  exact congrArg _ (congrArg ULift.up (Quot.sound (h_kernel a b h)))

/-- The section of the quotient sheaf over `M` obtained by descending the quotient class of
`𝟙 U` along the covering morphism `q`. It is the unique amalgamation of the singleton family
given by that class. -/
def quotientSheafSectionOfCover {S : Scheme.{u}} {U M : Over S}
    (J : GrothendieckTopology (Over S)) (P : PreRelation U) (q : U ⟶ M)
    (h_cover : Sieve.generate (Presieve.singleton q) ∈ J M)
    (h_kernel : ∀ {W : Over S} (a b : W ⟶ U), a ≫ q = b ≫ q → P.pointRel W a b) :
    (P.quotientSheaf J).obj.obj (op M) :=
  (Presheaf.IsSheaf.amalgamateOfArrows (P.quotientSheaf J).property
      (fun _ : PUnit.{1} ↦ q)
      (by rwa [Sieve.ofArrows, Presieve.ofArrows_pUnit])
      (fun _ ↦ TypeCat.ofHom fun (_ : PUnit.{u + 2}) ↦ P.quotientClass J (𝟙 U))
      (fun _ _ _ a b h ↦ by
        ext
        exact quotientClass_compatible_of_pointRel J P q h_kernel a b h))
    PUnit.unit

/-- Restricting the descended section along `q` recovers the quotient class of `𝟙 U`. -/
theorem quotientSheafSectionOfCover_map {S : Scheme.{u}} {U M : Over S}
    (J : GrothendieckTopology (Over S)) (P : PreRelation U) (q : U ⟶ M)
    (h_cover : Sieve.generate (Presieve.singleton q) ∈ J M)
    (h_kernel : ∀ {W : Over S} (a b : W ⟶ U), a ≫ q = b ≫ q → P.pointRel W a b) :
    (P.quotientSheaf J).obj.map q.op (P.quotientSheafSectionOfCover J q h_cover h_kernel) =
      P.quotientClass J (𝟙 U) := sorry

/-- The inverse comparison from the represented sheaf of `M` to the quotient sheaf, classified
by the descended section `quotientSheafSectionOfCover`. -/
def quotientSheafInvOfCover {S : Scheme.{u}} {U M : Over S}
    (J : GrothendieckTopology (Over S)) [J.Subcanonical] (P : PreRelation U) (q : U ⟶ M)
    (h_cover : Sieve.generate (Presieve.singleton q) ∈ J M)
    (h_kernel : ∀ {W : Over S} (a b : W ⟶ U), a ≫ q = b ≫ q → P.pointRel W a b) :
    J.uliftYoneda.{u + 1}.obj M ⟶ P.quotientSheaf J :=
  J.uliftYonedaEquiv.symm (P.quotientSheafSectionOfCover J q h_cover h_kernel)

/-- Evaluating the inverse comparison at a point `m : T ⟶ M` restricts the descended section
along `m`. -/
theorem quotientSheafInvOfCover_app {S : Scheme.{u}} {U M T : Over S}
    (J : GrothendieckTopology (Over S)) [J.Subcanonical] (P : PreRelation U) (q : U ⟶ M)
    (h_cover : Sieve.generate (Presieve.singleton q) ∈ J M)
    (h_kernel : ∀ {W : Over S} (a b : W ⟶ U), a ≫ q = b ≫ q → P.pointRel W a b)
    (m : T ⟶ M) :
    (P.quotientSheafInvOfCover J q h_cover h_kernel).hom.app (op T) (ULift.up m) =
      (P.quotientSheaf J).obj.map m.op
        (P.quotientSheafSectionOfCover J q h_cover h_kernel) :=
  rfl

/-- The inverse comparison sends the represented point `x ≫ q` to the quotient class of `x`. -/
theorem quotientSheafInvOfCover_app_comp {S : Scheme.{u}} {U M T : Over S}
    (J : GrothendieckTopology (Over S)) [J.Subcanonical] (P : PreRelation U) (q : U ⟶ M)
    (h_cover : Sieve.generate (Presieve.singleton q) ∈ J M)
    (h_kernel : ∀ {W : Over S} (a b : W ⟶ U), a ≫ q = b ≫ q → P.pointRel W a b)
    (x : T ⟶ U) :
    (P.quotientSheafInvOfCover J q h_cover h_kernel).hom.app (op T) (ULift.up (x ≫ q)) =
      P.quotientClass J x := sorry

/-- The represented map of `q` followed by the inverse comparison is the quotient map. -/
theorem uliftYoneda_map_comp_quotientSheafInvOfCover {S : Scheme.{u}} {U M : Over S}
    (J : GrothendieckTopology (Over S)) [J.Subcanonical] (P : PreRelation U) (q : U ⟶ M)
    (h_cover : Sieve.generate (Presieve.singleton q) ∈ J M)
    (h_kernel : ∀ {W : Over S} (a b : W ⟶ U), a ≫ q = b ≫ q → P.pointRel W a b) :
    J.uliftYoneda.{u + 1}.map q ≫ P.quotientSheafInvOfCover J q h_cover h_kernel =
      P.quotientMap J := sorry

/-- The quotient sheaf is isomorphic to the represented sheaf of `M` when `q` covers `M` and
its fibre pairs are related by `P`. The forward map is the canonical comparison
`quotientSheafDesc`; the inverse is the descended comparison `quotientSheafInvOfCover`. -/
def quotientSheafIsoOfCover {S : Scheme.{u}} {U M : Over S}
    (J : GrothendieckTopology (Over S)) [J.Subcanonical] (P : PreRelation U) (q : U ⟶ M)
    (h_equalizes : P.t ≫ q = P.s ≫ q)
    (h_cover : Sieve.generate (Presieve.singleton q) ∈ J M)
    (h_kernel : ∀ {W : Over S} (a b : W ⟶ U), a ≫ q = b ≫ q → P.pointRel W a b) :
    P.quotientSheaf J ≅ J.uliftYoneda.{u + 1}.obj M where
  hom := P.quotientSheafDesc J q h_equalizes
  inv := P.quotientSheafInvOfCover J q h_cover h_kernel
  hom_inv_id := sorry
  inv_hom_id := sorry

/-- The forward map of `quotientSheafIsoOfCover` is the canonical comparison. -/
theorem quotientSheafIsoOfCover_hom {S : Scheme.{u}} {U M : Over S}
    (J : GrothendieckTopology (Over S)) [J.Subcanonical] (P : PreRelation U) (q : U ⟶ M)
    (h_equalizes : P.t ≫ q = P.s ≫ q)
    (h_cover : Sieve.generate (Presieve.singleton q) ∈ J M)
    (h_kernel : ∀ {W : Over S} (a b : W ⟶ U), a ≫ q = b ≫ q → P.pointRel W a b) :
    (P.quotientSheafIsoOfCover J q h_equalizes h_cover h_kernel).hom =
      P.quotientSheafDesc J q h_equalizes :=
  rfl

/-- The inverse map of `quotientSheafIsoOfCover` is the descended comparison. -/
theorem quotientSheafIsoOfCover_inv {S : Scheme.{u}} {U M : Over S}
    (J : GrothendieckTopology (Over S)) [J.Subcanonical] (P : PreRelation U) (q : U ⟶ M)
    (h_equalizes : P.t ≫ q = P.s ≫ q)
    (h_cover : Sieve.generate (Presieve.singleton q) ∈ J M)
    (h_kernel : ∀ {W : Over S} (a b : W ⟶ U), a ≫ q = b ≫ q → P.pointRel W a b) :
    (P.quotientSheafIsoOfCover J q h_equalizes h_cover h_kernel).inv =
      P.quotientSheafInvOfCover J q h_cover h_kernel :=
  rfl

end AlgebraicGeometry.Scheme.PreRelation
