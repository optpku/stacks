module

public import ReasLib.RingTheory.Kaehler.NoetherDifferent.LocalizedPresentation
import StacksCheckRecall

@[expose] public section

open scoped TensorProduct

universe u v

/- Lemma 49.12.2 (1): a quasi-finite algebra presented by `n` equations in the
localization of `A[x₁, …, xₙ]` away from `h` is syntomic, hence flat and a relative
local complete intersection over `A`. -/
@[stacks 0BWD "syntomic localized presentation"] #check
  (Algebra.LocalizedPresentation.syntomic :
    ∀ {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
      [Algebra.QuasiFinite A B] {n : ℕ} (hn : 1 ≤ n)
      (h : MvPolynomial (Fin n) A) (f : Fin n → MvPolynomial (Fin n) A)
      (q : Localization.Away h →ₐ[A] B) (h_q : Function.Surjective q)
      (h_ker_q : RingHom.ker q.toRingHom =
        Ideal.span (Set.range fun i ↦
          algebraMap (MvPolynomial (Fin n) A) (Localization.Away h) (f i))),
      (algebraMap A B).Syntomic)

/- Lemma 49.12.2 (2): the annihilator of the diagonal ideal of such a
quasi-finite localized complete-intersection presentation is free of rank one over `B`,
via the left `B`-action on `B ⊗[A] B`. -/
@[stacks 0BWD "diagonal annihilator rank-one"] #check
  (Algebra.LocalizedPresentation.annihilator_freeRankOne :
    ∀ {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
      [Algebra.QuasiFinite A B] {n : ℕ} (hn : 1 ≤ n)
      (h : MvPolynomial (Fin n) A) (f : Fin n → MvPolynomial (Fin n) A)
      (q : Localization.Away h →ₐ[A] B) (h_q : Function.Surjective q)
      (h_ker_q : RingHom.ker q.toRingHom =
        Ideal.span (Set.range fun i ↦
          algebraMap (MvPolynomial (Fin n) A) (Localization.Away h) (f i))),
      CategoryTheory.ModuleCat.freeRankOne B
        ((ModuleCat.restrictScalars
          (Algebra.TensorProduct.includeLeft : B →ₐ[A] B ⊗[A] B).toRingHom).obj
            (ModuleCat.of (B ⊗[A] B)
              (KaehlerDifferential.ideal A B).annihilator)))

/- Lemma 49.12.2 (3): the Noether different of such a quasi-finite localized
complete-intersection presentation is generated by the image of the Jacobian determinant
`det (fun i j ↦ MvPolynomial.pderiv j (f i))`. -/
@[stacks 0BWD "Jacobian Noether different"] #check
  (Algebra.LocalizedPresentation.noetherDifferent_eq_span_jacobianDet :
    ∀ {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
      [Algebra.QuasiFinite A B] {n : ℕ} (hn : 1 ≤ n)
      (h : MvPolynomial (Fin n) A) (f : Fin n → MvPolynomial (Fin n) A)
      (q : Localization.Away h →ₐ[A] B) (h_q : Function.Surjective q)
      (h_ker_q : RingHom.ker q.toRingHom =
        Ideal.span (Set.range fun i ↦
          algebraMap (MvPolynomial (Fin n) A) (Localization.Away h) (f i))),
      KaehlerDifferential.noetherDifferent A B =
        Ideal.span
          {q (algebraMap (MvPolynomial (Fin n) A) (Localization.Away h)
            (Matrix.det (fun i j ↦ MvPolynomial.pderiv j (f i))))})
