module

public import Mathlib.RingTheory.MvPolynomial.Ideal

@[expose] public section

noncomputable section

namespace UniversalPolynomialSystem

/-- Multi-indices in `n` variables whose total degree is at most `d`. -/
abbrev MultiIndex (n d : ℕ) :=
  {e : Fin n → Fin (d + 1) // (∑ i, (e i : ℕ)) ≤ d}

namespace MultiIndex

/-- The total-degree bound carried by a bounded multi-index. -/
theorem sum_le {n d : ℕ} (e : MultiIndex n d) :
    (∑ i, (e.1 i : ℕ)) ≤ d := sorry

/-- The finitely supported exponent vector underlying a bounded multi-index. -/
def toFinsupp {n d : ℕ} (e : MultiIndex n d) : Fin n →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm fun i ↦ e.1 i

/-- Evaluation of the exponent vector underlying a bounded multi-index. -/
theorem toFinsupp_apply {n d : ℕ} (e : MultiIndex n d) (i : Fin n) :
    toFinsupp e i = e.1 i := sorry

end MultiIndex

/-- The universal coefficient ring `ℤ[a_(i,E)]`. -/
abbrev CoefficientRing (n d : ℕ) :=
  MvPolynomial (Fin n × MultiIndex n d) ℤ

/-- The polynomial ring in the variables `x₁, ..., xₙ` over the universal coefficient ring. -/
abbrev PolynomialRing (n d : ℕ) := MvPolynomial (Fin n) (CoefficientRing n d)

/-- The universal polynomial `fᵢ = ∑ E, a_(i,E) x^E`. -/
def equation (n d : ℕ) (i : Fin n) : PolynomialRing n d :=
  ∑ E : MultiIndex n d,
    MvPolynomial.monomial E.toFinsupp
      (MvPolynomial.X (i, E) : CoefficientRing n d)

/-- The ideal generated by the universal equations `f₁, ..., fₙ`. -/
def relationIdeal (n d : ℕ) : Ideal (PolynomialRing n d) :=
  Ideal.span (Set.range (equation n d))

/-- The universal quotient algebra `A[x₁, ..., xₙ] / (f₁, ..., fₙ)`. -/
abbrev CoordinateRing (n d : ℕ) := PolynomialRing n d ⧸ relationIdeal n d

end UniversalPolynomialSystem
