module

public import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Basic
public import Mathlib.RingTheory.Ideal.Basic
import Mathlib.Tactic.CrossRefAttribute

/-!
# Ideals generated by rows and columns of invertible matrices

This file records the symmetric unimodularity API for rows and columns of an arbitrary invertible
matrix over a commutative ring.
-/

@[expose] public section

universe u v

namespace Matrix.GeneralLinearGroup

variable {R : Type u} [CommRing R] {ι : Type v} [Fintype ι] [DecidableEq ι]

/-- The ideal generated by a row of an invertible matrix. -/
@[stacks 01KX "row ideal of an invertible matrix"]
abbrev rowIdeal (M : Matrix.GeneralLinearGroup ι R) (i : ι) : Ideal R :=
  Ideal.span (Set.range fun j ↦ M i j)

/-- Every row of an invertible matrix generates the unit ideal. -/
@[stacks 01KX "rows of an invertible matrix are unimodular"]
theorem rowIdeal_eq_top (M : Matrix.GeneralLinearGroup ι R) (i : ι) :
    rowIdeal M i = ⊤ := sorry

/-- The ideal generated by a column of an invertible matrix. -/
@[stacks 01KX "column ideal of an invertible matrix"]
abbrev columnIdeal (M : Matrix.GeneralLinearGroup ι R) (j : ι) : Ideal R :=
  Ideal.span (Set.range fun i ↦ M i j)

/-- Every column of an invertible matrix generates the unit ideal. -/
@[stacks 01KX "columns of an invertible matrix are unimodular"]
theorem columnIdeal_eq_top (M : Matrix.GeneralLinearGroup ι R) (j : ι) :
    columnIdeal M j = ⊤ := sorry

end Matrix.GeneralLinearGroup
