import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum

/-!
# Standard-graded Fermat hypersurface rings

The homogeneous coordinate ring `k[x, y, z] ⧸ (x ^ d + y ^ d + z ^ d)` carries
the standard total-degree grading and its canonical extension to an integer grading.
For a nonzero defining form over a field, its Hilbert sequence is the difference
of the dimensions of two homogeneous pieces of the polynomial ring.
-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory MvPolynomial
open scoped BigOperators

namespace MvPolynomial.FermatHypersurface

/-- The homogeneous Fermat form `x ^ d + y ^ d + z ^ d` in three variables. -/
def equation (k : Type u) [CommRing k] (d : ℕ) : MvPolynomial (Fin 3) k :=
  X (0 : Fin 3) ^ d + X (1 : Fin 3) ^ d + X (2 : Fin 3) ^ d

/-- Unfolding of the Fermat form as a sum of d-th powers of the three variables. -/
theorem equation_spec (k : Type u) [CommRing k] (d : ℕ) :
    equation k d =
      X (0 : Fin 3) ^ d + X (1 : Fin 3) ^ d + X (2 : Fin 3) ^ d := rfl

/-- The Fermat form is homogeneous of degree `d` for the standard total-degree grading. -/
theorem equation_mem_grading (k : Type u) [CommRing k] (d : ℕ) :
    equation k d ∈ standardGrading (Fin 3) k d := by
  exact ((isHomogeneous_X_pow (0 : Fin 3) d).add
    (isHomogeneous_X_pow (1 : Fin 3) d)).add (isHomogeneous_X_pow (2 : Fin 3) d)

/-- A positive-degree Fermat form is a nonzero polynomial. -/
theorem equation_ne_zero (k : Type u) [Field k] {d : ℕ} (hd : 0 < d) :
    equation k d ≠ 0 := by
  intro h
  have he := congrArg (eval fun i : Fin 3 ↦ if i = 0 then (1 : k) else 0) h
  simpa [equation, ne_of_gt hd] using he

/-- The principal ideal generated by the Fermat form. -/
def ideal (k : Type u) [CommRing k] (d : ℕ) : Ideal (MvPolynomial (Fin 3) k) :=
  Ideal.span {equation k d}

/-- The Fermat ideal is the principal ideal generated by the Fermat form. -/
theorem ideal_eq_span (k : Type u) [CommRing k] (d : ℕ) :
    ideal k d = Ideal.span {equation k d} := rfl

/-- The coordinate ring `k[x, y, z] ⧸ (x ^ d + y ^ d + z ^ d)`. -/
abbrev CoordinateRing (k : Type u) [CommRing k] (d : ℕ) : Type u :=
  MvPolynomial (Fin 3) k ⧸ ideal k d

/-- The Fermat form vanishes in the coordinate ring. -/
theorem mk_equation (k : Type u) [CommRing k] (d : ℕ) :
    Ideal.Quotient.mk (ideal k d) (equation k d) = (0 : CoordinateRing k d) := by
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  exact Ideal.subset_span (Set.mem_singleton (equation k d))

/-- The quotient ℕ-grading on the Fermat coordinate ring induced by the standard grading. -/
abbrev grading (k : Type u) [CommRing k] (d : ℕ) :
    ℕ → Submodule k (CoordinateRing k d) :=
  GradedAlgebra.Quotient.grading (standardGrading (Fin 3) k) (ideal k d)

/-- The quotient class of a degree-`n` polynomial lies in the degree-`n` Fermat piece. -/
theorem mk_mem_grading (k : Type u) [CommRing k] (d n : ℕ)
    {f : MvPolynomial (Fin 3) k} (hf : f ∈ standardGrading (Fin 3) k n) :
    Ideal.Quotient.mk (ideal k d) f ∈ grading k d n := by
  exact GradedAlgebra.Quotient.mk_mem_grading (standardGrading (Fin 3) k) (ideal k d) hf

/-- The homogeneous principal quotient carries its canonical graded-algebra structure. -/
instance instGradedAlgebra (k : Type u) [CommRing k] (d : ℕ) :
    GradedAlgebra (grading k d) :=
  GradedAlgebra.Quotient.spanSingletonGradedAlgebra (standardGrading (Fin 3) k)
    ⟨d, equation_mem_grading k d⟩

/-- The integer grading of the Fermat coordinate ring, with negative pieces equal to `⊥`. -/
abbrev intGrading (k : Type u) [CommRing k] (d : ℕ) :
    ℤ → Submodule k (CoordinateRing k d) :=
  DirectSum.Decomposition.natToIntGrading (grading k d)

/-- In nonnegative degree, the integer Fermat grading agrees with the quotient ℕ-grading. -/
theorem intGrading_nat (k : Type u) [CommRing k] (d n : ℕ) :
    intGrading k d n = grading k d n := rfl

/-- In negative degree, the integer Fermat grading is the zero submodule. -/
theorem intGrading_neg (k : Type u) [CommRing k] (d : ℕ) {n : ℤ} (hn : n < 0) :
    intGrading k d n = ⊥ := by
  exact if_neg (not_le.mpr hn)

/-- Each integer degree piece of the Fermat coordinate ring is a finite module over the field. -/
instance instLocallyFinite (k : Type u) [Field k] (d : ℕ) :
    GradedModule.LocallyFinite (intGrading k d) := by
  constructor
  intro n
  by_cases hn : 0 ≤ n
  · change Module.Finite k (intGrading k d n)
    change Module.Finite k ↥(if 0 ≤ n then grading k d n.toNat else ⊥)
    rw [if_pos hn]
    exact Module.Finite.iff_fg.mpr
      ((homogeneousSubmodule_fg (Fin 3) k n.toNat).map
        (Ideal.Quotient.mkₐ k (ideal k d)).toLinearMap)
  · change Module.Finite k (intGrading k d n)
    rw [intGrading_neg k d (lt_of_not_ge hn)]
    infer_instance

/-- The closed-form Hilbert sequence of the standard-graded Fermat hypersurface of degree `d`. -/
def hilbertFunction (d : ℕ) : ℤ → ℤ :=
  fun n ↦
    (if 0 ≤ n then (Nat.multichoose 3 n.toNat : ℤ) else 0) -
      (if (d : ℤ) ≤ n then (Nat.multichoose 3 (n - d).toNat : ℤ) else 0)

/-- Unfolding of the closed-form Fermat Hilbert sequence. -/
theorem hilbertFunction_apply (d : ℕ) (n : ℤ) :
    hilbertFunction d n =
      (if 0 ≤ n then (Nat.multichoose 3 n.toNat : ℤ) else 0) -
        (if (d : ℤ) ≤ n then (Nat.multichoose 3 (n - d).toNat : ℤ) else 0) := rfl

/-- The closed-form Fermat Hilbert sequence vanishes in negative degree. -/
theorem hilbertFunction_neg (d : ℕ) {n : ℤ} (hn : n < 0) :
    hilbertFunction d n = 0 := by
  have hnd : ¬ (d : ℤ) ≤ n := not_le.mpr (hn.trans_le (Int.natCast_nonneg d))
  simp [hilbertFunction, not_le.mpr hn, hnd]

/-- In degrees strictly below `d`, the closed-form sequence is the unrestricted ternary
multichoose dimension. -/
theorem hilbertFunction_of_lt (d : ℕ) {n : ℤ} (hn0 : 0 ≤ n) (hnd : n < d) :
    hilbertFunction d n = Nat.multichoose 3 n.toNat := by
  simp [hilbertFunction, hn0, not_le.mpr hnd]

/-- In degrees at least `d`, the closed-form sequence is the difference of ternary
multichoose dimensions. -/
theorem hilbertFunction_of_ge (d : ℕ) {n : ℤ} (hnd : (d : ℤ) ≤ n) :
    hilbertFunction d n =
      (Nat.multichoose 3 n.toNat : ℤ) - Nat.multichoose 3 (n - d).toNat := by
  simp [hilbertFunction, hnd, (Int.natCast_nonneg d).trans hnd]

/-- Over a field, the Hilbert function of the standard-graded Fermat coordinate ring
equals the closed-form sequence whenever its defining equation is nonzero. -/
theorem hilbertFunction_eq (k : Type u) [Field k] (d : ℕ)
    (hf : equation k d ≠ 0) (n : ℤ) :
    GradedModule.hilbertFunction (ModuleCat.K0.finiteLength k) (intGrading k d) n =
      hilbertFunction d n := sorry

/-- Over a field, when the defining Fermat equation is zero, the Hilbert function of
the coordinate ring is the ternary multichoose dimension in nonnegative degrees and
zero in negative degrees. -/
theorem hilbertFunction_eq_of_equation_eq_zero (k : Type u) [Field k] (d : ℕ)
    (hf : equation k d = 0) (n : ℤ) :
    GradedModule.hilbertFunction (ModuleCat.K0.finiteLength k) (intGrading k d) n =
      if 0 ≤ n then (Nat.multichoose 3 n.toNat : ℤ) else 0 := sorry

private theorem twice_multichoose_three (m : ℕ) :
    2 * (Nat.multichoose 3 m : ℤ) = (m + 1) * (m + 2) := by
  induction m with
  | zero => norm_num
  | succ m ih =>
    rw [Nat.multichoose_succ_succ, Nat.multichoose_two]
    push_cast
    nlinarith [ih]

/-- Over a field, the standard-graded Fermat coordinate ring has a Hilbert polynomial
with respect to the finite-length Euler-Poincaré function. -/
theorem hasHilbertPolynomial (k : Type u) [Field k] (d : ℕ) :
    GradedModule.HasHilbertPolynomial (ModuleCat.K0.finiteLength k) (intGrading k d) := by
  by_cases hf : equation k d = 0
  · refine ⟨2, ⟨![1, 2, 1], ?_⟩⟩
    filter_upwards [Filter.eventually_ge_atTop (0 : ℤ)] with n hn
    rw [hilbertFunction_eq_of_equation_eq_zero k d hf n, if_pos hn]
    simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, Int.zsmul_eq_mul]
    change (Nat.multichoose 3 n.toNat : ℤ) =
      Ring.choose n 0 * 1 + (Ring.choose n 1 * 2 + (Ring.choose n 2 * 1 + 0))
    rw [Ring.choose_zero_right, Ring.choose_one_right]
    have hm := twice_multichoose_three n.toNat
    rw [Int.toNat_of_nonneg hn] at hm
    have hc := Ring.choose_smul_choose n (n := 2) (k := 1) (by decide)
    norm_num [Ring.choose_one_right, nsmul_eq_mul] at hc
    nlinarith [hm, hc]
  · refine ⟨1, ⟨![(Nat.multichoose 3 d : ℤ) - 1 - (d : ℤ) * d, (d : ℤ)], ?_⟩⟩
    filter_upwards [Filter.eventually_ge_atTop (d : ℤ)] with n hn
    rw [hilbertFunction_eq k d hf n, hilbertFunction_of_ge d hn]
    simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, Int.zsmul_eq_mul]
    change (Nat.multichoose 3 n.toNat : ℤ) - Nat.multichoose 3 (n - d).toNat =
      Ring.choose n 0 * ((Nat.multichoose 3 d : ℤ) - 1 - (d : ℤ) * d) +
        (Ring.choose n 1 * d + 0)
    rw [Ring.choose_zero_right, Ring.choose_one_right]
    have hm := twice_multichoose_three n.toNat
    have hs := twice_multichoose_three (n - d).toNat
    have hd := twice_multichoose_three d
    rw [Int.toNat_of_nonneg ((Int.natCast_nonneg d).trans hn)] at hm
    rw [Int.toNat_of_nonneg (sub_nonneg.mpr hn)] at hs
    nlinarith [hm, hs, hd]

end MvPolynomial.FermatHypersurface
