module

public import Mathlib.RingTheory.Ideal.Pure
public import Mathlib.RingTheory.Idempotents
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Ideal.Quotient.OneSub

/-!
# Idempotent ideals and split algebra maps

This leaf packages the canonical product decomposition attached to an algebra
retraction whose kernel is generated by an idempotent. The complementary
factor is the concrete quotient by the complementary idempotent, rather than
an existentially chosen algebra.
-/

@[expose] public section

universe u v w x

namespace Ideal

variable {B : Type v} [CommRing B]

/-- An ideal is generated by its idempotent elements.  This is the intrinsic ideal-side
formulation, independent of any spectrum or quotient presentation. -/
@[stacks 04PP "idempotent-generated ideal"]
def IsGeneratedByIdempotents (I : Ideal B) : Prop :=
  Ideal.span {e : B | IsIdempotentElem e ∧ e ∈ I} = I

/-- The span of a family of idempotents is generated by idempotents. -/
theorem isGeneratedByIdempotents_span {S : Set B}
    (hS : ∀ e ∈ S, IsIdempotentElem e) :
    (Ideal.span S : Ideal B).IsGeneratedByIdempotents := by
  rw [IsGeneratedByIdempotents]
  refine le_antisymm ?_ ?_
  · exact Ideal.span_le.2 fun e he ↦ he.2
  · exact Ideal.span_mono fun e he ↦ ⟨hS e he, Ideal.subset_span he⟩

/-- An idempotent-generated ideal is idempotent as an ideal. -/
theorem IsGeneratedByIdempotents.isIdempotentElem {I : Ideal B}
    (hI : I.IsGeneratedByIdempotents) : IsIdempotentElem I := by
  rw [IsGeneratedByIdempotents] at hI
  rw [IsIdempotentElem]
  refine le_antisymm (Ideal.mul_le_inf.trans inf_le_left) ?_
  rw [← hI]
  refine Ideal.span_le.2 fun e he ↦ ?_
  rw [← he.1.eq]
  exact Ideal.mul_mem_mul (Ideal.subset_span he) (Ideal.subset_span he)

/-- An idempotent-generated ideal is pure. -/
@[stacks 04PP "idempotent-generated ideals are pure"]
theorem IsGeneratedByIdempotents.pure {I : Ideal B}
    (hI : I.IsGeneratedByIdempotents) : I.Pure := sorry

/-- A pure finitely generated ideal is generated by an idempotent element. -/
@[stacks 00QR "pure finitely generated idempotent ideal"]
theorem exists_idempotent_generator_of_pure_fg
    (I : Ideal B) (h_pure : I.Pure) (h_fg : I.FG) :
    ∃ e : B, IsIdempotentElem e ∧ I = Ideal.span ({e} : Set B) := sorry

end Ideal

namespace AlgHom

variable {A : Type u} {B : Type v}
variable [CommSemiring A] [CommRing B] [Algebra A B]

/-- An algebra map with pure finitely generated kernel has an idempotent generator for that
kernel. -/
@[stacks 00QR "idempotent generator of a retraction kernel"]
theorem exists_idempotentKer_of_pure_fg
    (sigma : B →ₐ[A] A)
    (h_pure : (RingHom.ker sigma.toRingHom).Pure)
    (h_fg : (RingHom.ker sigma.toRingHom).FG) :
    ∃ e : B, IsIdempotentElem e ∧
      RingHom.ker sigma.toRingHom = Ideal.span ({e} : Set B) := sorry

end AlgHom

namespace AlgEquiv

variable {A : Type u} {B : Type v}
variable [CommRing A] [CommRing B] [Algebra A B]

/-- A retraction with idempotent-generated kernel canonically identifies its
source with the product of its target and the quotient by the complementary
idempotent. -/
@[stacks 00QR "idempotent-kernel product decomposition"]
noncomputable def prodQuotientOfIdempotentKer
    (sigma : B →ₐ[A] A)
    (h_sigma : Function.LeftInverse sigma (algebraMap A B))
    {e : B} (he : IsIdempotentElem e)
    (h_ker : RingHom.ker sigma.toRingHom = Ideal.span ({e} : Set B)) :
    B ≃ₐ[A] A × (B ⧸ Ideal.oneSubSpan e) := by
  let C : Type v := B ⧸ Ideal.oneSubSpan e
  let quotientEquiv : (B ⧸ Ideal.span ({e} : Set B)) ≃ₐ[A] A :=
    (Ideal.quotientEquivAlgOfEq (R₁ := A) h_ker.symm).trans <|
      Ideal.quotientKerAlgEquivOfRightInverse (f := sigma)
        (g := algebraMap A B) h_sigma
  let splitEquiv : B ≃ₐ[A] ((B ⧸ Ideal.span ({e} : Set B)) × C) :=
    AlgEquiv.prodQuotientOfIsIdempotentElem A he he.one_sub (by simp) (by
      rw [mul_sub, mul_one, he.eq, sub_self])
  exact splitEquiv.trans <|
    AlgEquiv.prodCongr quotientEquiv (AlgEquiv.refl : C ≃ₐ[A] C)

end AlgEquiv

namespace AlgEquiv.Prod

variable {R : Type u} {A : Type v} {B : Type w} {C : Type x}

section OneSub

variable [CommRing R] [CommRing A] [CommRing B] [Algebra R A] [Algebra R B]

/-- The concrete product decomposition obtained by identifying the quotient by `1 - e` with
the first factor. -/
@[stacks 0CAR "product decomposition from a complementary principal quotient"]
noncomputable def ofOneSubQuotientEquiv {e : A} (he : IsIdempotentElem e)
    (first : (A ⧸ Ideal.oneSubSpan e) ≃ₐ[R] B) :
    A ≃ₐ[R] B × (A ⧸ Ideal.span ({e} : Set A)) :=
  (AlgEquiv.prodQuotientOfIsIdempotentElem R he.one_sub he
    (sub_add_cancel (1 : A) e) he.one_sub_mul_self).trans <|
    AlgEquiv.prodCongr first
      (AlgEquiv.refl : (A ⧸ Ideal.span ({e} : Set A)) ≃ₐ[R] A ⧸ Ideal.span ({e} : Set A))

/-- The first coordinate of `ofOneSubQuotientEquiv` is the specified quotient equivalence. -/
@[simp]
theorem ofOneSubQuotientEquiv_apply_fst {e : A} (he : IsIdempotentElem e)
    (first : (A ⧸ Ideal.oneSubSpan e) ≃ₐ[R] B) (a : A) :
    RingHom.fst B (A ⧸ Ideal.span ({e} : Set A)) (ofOneSubQuotientEquiv he first a) =
      first (Ideal.Quotient.mk (Ideal.oneSubSpan e) a) := sorry

/-- A quotient equivalence by the complement of an idempotent yields a product decomposition
whose first projection is a prescribed algebra map. -/
@[stacks 0CAR "product split from a complementary quotient equivalence"]
theorem exists_ofOneSubQuotientEquiv (pi : A →ₐ[R] B) {e : A} (he : IsIdempotentElem e)
    (first : (A ⧸ Ideal.oneSubSpan e) ≃ₐ[R] B)
    (h_first : ∀ a : A, first (Ideal.Quotient.mk (Ideal.oneSubSpan e) a) = pi a) :
    ∃ (D : Type v) (_ : CommRing D) (_ : Algebra R D) (E : A ≃ₐ[R] B × D),
      ∀ a : A, RingHom.fst B D (E a) = pi a := sorry

end OneSub

section Fst

variable [CommSemiring R] [CommRing A] [CommRing B] [CommRing C]
variable [Algebra R A] [Algebra R B] [Algebra R C]

/-- The idempotent in the source corresponding to the first factor of a product algebra
equivalence. -/
def fstIdempotent (E : A ≃ₐ[R] B × C) : A :=
  E.symm (1, 0)

/-- The source-to-first-factor algebra homomorphism induced by a product algebra equivalence. -/
def fstAlgHom (E : A ≃ₐ[R] B × C) : A →ₐ[R] B :=
  (AlgHom.fst R B C).comp E.toAlgHom

/-- The first-factor idempotent transported through a product algebra equivalence is
idempotent. -/
theorem fstIdempotent_isIdempotent (E : A ≃ₐ[R] B × C) :
    IsIdempotentElem (fstIdempotent E) := sorry

/-- The kernel of the first-factor map is generated by the complement of the transported
first-factor idempotent. -/
theorem oneSubSpan_fstIdempotent_eq_ker (E : A ≃ₐ[R] B × C) :
    Ideal.oneSubSpan (fstIdempotent E) = RingHom.ker (fstAlgHom E).toRingHom := sorry

/-- The first-factor map of a product algebra equivalence is surjective. -/
theorem fstAlgHom_surjective (E : A ≃ₐ[R] B × C) :
    Function.Surjective (fstAlgHom E) := sorry

/-- The quotient equivalence induced by a product algebra equivalence once its canonical
kernel description and surjectivity have been supplied. -/
@[stacks 0CAR "first-factor complementary quotient equivalence"]
noncomputable def fstQuotientEquiv (E : A ≃ₐ[R] B × C)
    (h_ker : Ideal.oneSubSpan (fstIdempotent E) = RingHom.ker (fstAlgHom E).toRingHom)
    (h_surj : Function.Surjective (fstAlgHom E)) :
    (A ⧸ Ideal.oneSubSpan (fstIdempotent E)) ≃ₐ[R] B :=
  (Ideal.quotientEquivAlgOfEq R h_ker).trans
    (Ideal.quotientKerAlgEquivOfSurjective h_surj)

/-- `fstQuotientEquiv` evaluates a quotient representative by the first-factor map. -/
@[simp]
theorem fstQuotientEquiv_mk (E : A ≃ₐ[R] B × C)
    (h_ker : Ideal.oneSubSpan (fstIdempotent E) = RingHom.ker (fstAlgHom E).toRingHom)
    (h_surj : Function.Surjective (fstAlgHom E)) (a : A) :
    fstQuotientEquiv E h_ker h_surj
        (Ideal.Quotient.mk (Ideal.oneSubSpan (fstIdempotent E)) a) = fstAlgHom E a := sorry

/-- A product algebra equivalence whose first projection is a prescribed map identifies that
map with a quotient by the complement of a source idempotent. -/
@[stacks 0CAR "complementary quotient from a product split"]
theorem exists_oneSubQuotientEquiv_of_fst (E : A ≃ₐ[R] B × C) (pi : A →ₐ[R] B)
    (h_E : ∀ a : A, RingHom.fst B C (E a) = pi a) :
    ∃ e : A, IsIdempotentElem e ∧
      ∃ first : (A ⧸ Ideal.oneSubSpan e) ≃ₐ[R] B,
        ∀ a : A, first (Ideal.Quotient.mk (Ideal.oneSubSpan e) a) = pi a := sorry

end Fst

end AlgEquiv.Prod
