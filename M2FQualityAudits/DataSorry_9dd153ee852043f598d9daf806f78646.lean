module

import Lean

public import Mathlib.Algebra.Polynomial.AlgebraMap
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

noncomputable section

universe u

open Polynomial

namespace Polynomial

variable {A : Type u} [CommRing A]

/-- The ideal `(m, X)` of `A[X]`, generated by the image of `m` under `C` together with `X`. -/
def spanMapCX (m : Ideal A) : Ideal A[X] :=
  m.map C ⊔ Ideal.span {X}

/-- Unfolding `spanMapCX m` as the supremum of `m.map C` and `Ideal.span {X}`. -/
theorem spanMapCX_eq (m : Ideal A) :
    spanMapCX m = m.map C ⊔ Ideal.span {X} :=
  sorry

/-- Membership in the generators of `spanMapCX m`: the ideal is the smallest one containing
`m.map C` and `X`. -/
theorem spanMapCX_le_iff {m : Ideal A} {I : Ideal A[X]} :
    spanMapCX m ≤ I ↔ m.map C ≤ I ∧ X ∈ I :=
  sorry

/-- The ideal `(m, X - 1)` of `A[X]`, generated by the image of `m` under `C` together with
`X - C 1`. -/
def spanMapCXSubOne (m : Ideal A) : Ideal A[X] :=
  m.map C ⊔ Ideal.span {X - C 1}

/-- Unfolding `spanMapCXSubOne m` as the supremum of `m.map C` and `Ideal.span {X - C 1}`. -/
theorem spanMapCXSubOne_eq (m : Ideal A) :
    spanMapCXSubOne m = m.map C ⊔ Ideal.span {X - C 1} :=
  sorry

/-- Membership in the generators of `spanMapCXSubOne m`: the ideal is the smallest one containing
`m.map C` and `X - C 1`. -/
theorem spanMapCXSubOne_le_iff {m : Ideal A} {I : Ideal A[X]} :
    spanMapCXSubOne m ≤ I ↔ m.map C ≤ I ∧ X - C 1 ∈ I :=
  sorry

/-- If `m` is maximal in `A`, then `spanMapCX m` is maximal in `A[X]`. -/
instance spanMapCX.isMaximal (m : Ideal A) [m.IsMaximal] : (spanMapCX m).IsMaximal :=
  sorry

/-- If `m` is maximal in `A`, then `spanMapCXSubOne m` is maximal in `A[X]`. -/
instance spanMapCXSubOne.isMaximal (m : Ideal A) [m.IsMaximal] : (spanMapCXSubOne m).IsMaximal :=
  sorry

/-- The translation `algEquivAevalXAddC (-1)` sends `X` to `X - 1`, so it pulls
`spanMapCXSubOne m` back to `spanMapCX m`. -/
theorem spanMapCX_eq_comap_spanMapCXSubOne (m : Ideal A) :
    spanMapCX m = (spanMapCXSubOne m).comap (algEquivAevalXAddC (-1 : A)).toRingEquiv :=
  sorry

/-- Exercise 111.1.1: if `m` is a maximal ideal of a commutative ring `A`, then the
localizations of `A[X]` at `spanMapCX m` and at `spanMapCXSubOne m` are isomorphic as
rings. The comparison is the localization of the translation automorphism
`algEquivAevalXAddC (-1)`, which sends `X` to `X - 1`. -/
@[stacks 02CG]
noncomputable def localizationAtPrimeSpanMapCXEquiv (m : Ideal A) [m.IsMaximal] :
    Localization.AtPrime (spanMapCX m) ≃+* Localization.AtPrime (spanMapCXSubOne m) :=
  Localization.localRingEquiv (spanMapCX m) (spanMapCXSubOne m)
    (algEquivAevalXAddC (-1 : A)).toRingEquiv (spanMapCX_eq_comap_spanMapCXSubOne m)

/-- The comparison `localizationAtPrimeSpanMapCXEquiv m` intertwines `algebraMap` from `A[X]`
with the translation `algEquivAevalXAddC (-1)`. -/
theorem localizationAtPrimeSpanMapCXEquiv_algebraMap (m : Ideal A) [m.IsMaximal] (p : A[X]) :
    localizationAtPrimeSpanMapCXEquiv m
        (algebraMap A[X] (Localization.AtPrime (spanMapCX m)) p) =
      algebraMap A[X] (Localization.AtPrime (spanMapCXSubOne m))
        (algEquivAevalXAddC (-1 : A) p) :=
  sorry

end Polynomial


namespace M2FDataSorryAudit

open Lean Meta Elab Command

private def containsNonPropSorry (value : Expr) : MetaM Bool := do
  let found ← IO.mkRef false
  forEachExpr value fun expr => do
    unless ← found.get do
      let (head, args) := expr.getAppFnArgs
      if head == ``sorryAx && args.size >= 1 then
        unless ← isProp args[0]! do
          found.set true
  found.get

run_cmd do
  let env ← getEnv
  -- `env.constants` also contains imported declarations.  Current-module
  -- declarations are the ones without a `const2ModIdx` entry; restricting the
  -- scan to them is important for remote compilation because `mkModuleData`
  -- materializes and traverses the entire imported environment.  That made a
  -- tiny audit scratch file hit Leanfra's cancellation deadline on large repos.
  for (name, info) in env.constants do
    if (Environment.getModuleIdxFor? env name).isNone then
      if let some value := info.value? true then
        let (hasNonPropSorry, _) ← liftCoreM <| (containsNonPropSorry value).run
        if hasNonPropSorry then
          logInfo m!"M2F_NON_PROP_DATA_SORRY|{privateToUserName name}"

end M2FDataSorryAudit
