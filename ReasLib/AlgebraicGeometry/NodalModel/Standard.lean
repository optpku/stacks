module

public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.Algebra.MvPolynomial.Rename
public import Mathlib.RingTheory.Ideal.Quotient.Operations

@[expose] public section

open AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.NodalModel

/-- The polynomial base ring `ℤ[a]`, represented at the scheme universe `u`. -/
abbrev BaseRing := MvPolynomial (Fin 1) (ULift.{u} ℤ)

/-- The ideal generated by the nodal equation `u * v - a`. -/
def relationIdeal : Ideal (MvPolynomial (Fin 3) (ULift.{u} ℤ)) :=
  Ideal.span
    {((MvPolynomial.X (0 : Fin 3) * MvPolynomial.X (1 : Fin 3) -
        MvPolynomial.X (2 : Fin 3)) : MvPolynomial (Fin 3) (ULift.{u} ℤ))}

/-- The quotient ring `ℤ[u, v, a]/(u v - a)`. -/
abbrev Ring := MvPolynomial (Fin 3) (ULift.{u} ℤ) ⧸ relationIdeal

/-- The base scheme `Spec(ℤ[a])`. -/
abbrev base : Scheme.{u} := Spec (CommRingCat.of BaseRing)

/-- The standard nodal affine scheme `Spec(ℤ[u, v, a]/(u v - a))`. -/
abbrev model : Scheme.{u} := Spec (CommRingCat.of Ring)

/-- The base-algebra map sending `a` to the third polynomial variable. -/
def baseAlgHom : BaseRing →ₐ[ULift.{u} ℤ] Ring :=
  (Ideal.Quotient.mkₐ (ULift.{u} ℤ) relationIdeal).comp
    (MvPolynomial.rename (fun _ : Fin 1 ↦ (2 : Fin 3)))

/-- The canonical scheme morphism from the nodal model to its base. -/
def toBase : model ⟶ base :=
  Spec.map (CommRingCat.ofHom baseAlgHom.toRingHom)

/-- The base-algebra map sends the base variable to the quotient class of `a`. -/
theorem baseAlgHom_X :
    baseAlgHom (MvPolynomial.X (0 : Fin 1)) =
      Ideal.Quotient.mk relationIdeal (MvPolynomial.X (2 : Fin 3)) := sorry

end AlgebraicGeometry.NodalModel
