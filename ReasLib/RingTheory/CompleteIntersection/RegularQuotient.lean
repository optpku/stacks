module

public import Mathlib.Data.List.TFAE
public import Mathlib.RingTheory.Ideal.Cotangent
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.CompleteIntersection.Local
public import ReasLib.RingTheory.Ideal.Localization

@[expose] public section

/-!
# Quotients of Regular Local Rings

This leaf gives ideal-level complete-intersection criteria in a regular local ring and their
specialization to prime localizations of a regular ring.
-/

universe u

open IsLocalRing

namespace Ideal

variable {R : Type u} [CommRing R]

/-- The conormal module `I / I²` is generated by the codimension of `R / I` in `R`. -/
@[stacks 09Q1 "conormal codimension condition"]
def CotangentGeneratedByCodimension (I : Ideal R) : Prop :=
  ∃ c : ℕ, ringKrullDim (R ⧸ I) + c = ringKrullDim R ∧
    ∃ x : Fin c → I.Cotangent, Submodule.span (R ⧸ I) (Set.range x) = ⊤

/-- The codimension formulation of `CotangentGeneratedByCodimension`. -/
@[stacks 09Q1 "conormal codimension specification"]
theorem cotangentGeneratedByCodimension_iff (I : Ideal R) :
    I.CotangentGeneratedByCodimension ↔
      ∃ c : ℕ, ringKrullDim (R ⧸ I) + c = ringKrullDim R ∧
        ∃ x : Fin c → I.Cotangent, Submodule.span (R ⧸ I) (Set.range x) = ⊤ := sorry

namespace RegularQuotient

/-- In a regular local ring, a proper quotient is a complete-intersection local ring exactly when
the quotient ideal is generated by a regular sequence. -/
@[stacks 09Q1 "regular-local quotient criterion"]
theorem completeIntersection_iff_regularSequence
    [IsRegularLocalRing R] (I : Ideal R) (hI : I ≤ maximalIdeal R) :
    IsCompleteIntersectionLocalRing (R ⧸ I) ↔ I.IsGeneratedByRegularSequence := sorry

/-- In a regular local ring, a proper ideal is generated by a regular sequence exactly when its
conormal module is generated by the codimension. -/
@[stacks 09Q1 "regular-local conormal criterion"]
theorem regularSequence_iff_cotangent
    [IsRegularLocalRing R] (I : Ideal R) (hI : I ≤ maximalIdeal R) :
    I.IsGeneratedByRegularSequence ↔ I.CotangentGeneratedByCodimension := sorry

/-- In a regular local ring, a proper quotient is a complete intersection exactly when the
conormal module of its kernel is generated by the codimension. -/
@[stacks 09Q1 "regular-local complete-intersection conormal criterion"]
theorem completeIntersection_iff_cotangent
    [IsRegularLocalRing R] (I : Ideal R) (hI : I ≤ maximalIdeal R) :
    IsCompleteIntersectionLocalRing (R ⧸ I) ↔ I.CotangentGeneratedByCodimension := sorry

/-- The complete-intersection, regular-sequence, and conormal criteria for a proper quotient of a
regular local ring. -/
theorem criteria [IsRegularLocalRing R]
    (I : Ideal R) (hI : I ≤ maximalIdeal R) :
    List.TFAE
      [ IsCompleteIntersectionLocalRing (R ⧸ I)
      , I.IsGeneratedByRegularSequence
      , I.CotangentGeneratedByCodimension
      ] := sorry

end RegularQuotient

namespace AtPrime

variable [IsRegularRing R]

namespace RegularQuotient

/-- The extension to `R_p` of an ideal generated by a regular sequence contained in `p` is
generated by a regular sequence. -/
@[stacks 09Q0 "regular sequence after prime localization"]
theorem isGeneratedByRegularSequence
    (p : PrimeSpectrum R) (fs : List p.asIdeal)
    (hfs : RingTheory.Sequence.IsRegular R (fs.map p.asIdeal.subtype)) :
    (Ideal.ofList (fs.map p.asIdeal.subtype)).localizationAtPrime p
      |>.IsGeneratedByRegularSequence := sorry

/-- Lemma 23.8.2 (09Q0): the quotient of `R_p` by a regular sequence contained in `p` is a
complete-intersection local ring. -/
@[stacks 09Q0]
theorem isCompleteIntersection
    (p : PrimeSpectrum R) (fs : List p.asIdeal)
    (hfs : RingTheory.Sequence.IsRegular R (fs.map p.asIdeal.subtype)) :
    IsCompleteIntersectionLocalRing
      ((Ideal.ofList (fs.map p.asIdeal.subtype)).quotientAtPrime p) := sorry

/-- At a prime of a regular ring, the localized quotient is a complete-intersection local ring
exactly when the localized ideal is generated by a regular sequence. -/
@[stacks 09Q1 "prime-local regular-sequence criterion"]
theorem completeIntersection_iff_regularSequence
    (p : PrimeSpectrum R) (I : Ideal R) (hIp : I ≤ p.asIdeal) :
    IsCompleteIntersectionLocalRing (I.quotientAtPrime p) ↔
      (I.localizationAtPrime p).IsGeneratedByRegularSequence := sorry

/-- At a prime of a regular ring, the localized ideal is generated by a regular sequence exactly
when its cotangent module is generated by the local codimension. -/
@[stacks 09Q1 "prime-local conormal criterion"]
theorem regularSequence_iff_cotangent
    (p : PrimeSpectrum R) (I : Ideal R) (hIp : I ≤ p.asIdeal) :
    (I.localizationAtPrime p).IsGeneratedByRegularSequence ↔
      (I.localizationAtPrime p).CotangentGeneratedByCodimension := sorry

/-- At a prime of a regular ring, the localized quotient is a complete intersection exactly when
the localized cotangent module is generated by the local codimension. -/
@[stacks 09Q1 "prime-local complete-intersection conormal criterion"]
theorem completeIntersection_iff_cotangent
    (p : PrimeSpectrum R) (I : Ideal R) (hIp : I ≤ p.asIdeal) :
    IsCompleteIntersectionLocalRing (I.quotientAtPrime p) ↔
      (I.localizationAtPrime p).CotangentGeneratedByCodimension := sorry

/-- Lemma 23.8.3 (09Q1): if `I ⊆ p` in a regular ring, then for the quotient of `R_p` by
`I R_p`, the complete-intersection, regular-sequence, and conormal codimension criteria are
equivalent. -/
@[stacks 09Q1]
theorem criteria (p : PrimeSpectrum R) (I : Ideal R)
    (hIp : I ≤ p.asIdeal) :
    List.TFAE
      [ IsCompleteIntersectionLocalRing (I.quotientAtPrime p)
      , (I.localizationAtPrime p).IsGeneratedByRegularSequence
      , (I.localizationAtPrime p).CotangentGeneratedByCodimension
      ] := sorry

end RegularQuotient

end AtPrime

end Ideal
