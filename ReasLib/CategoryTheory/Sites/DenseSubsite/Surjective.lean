/-!
# Locally-surjective sites of a sheaf subcategory

For a full subcategory selected by an object property, this module constructs
the topology generated by locally-surjective coproduct maps and records the
resulting dense-subsite comparison with the original site.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits
open Opposite

noncomputable section

universe w u v

namespace CategoryTheory.ObjectProperty.SurjectiveSite

variable {C : Type u} [Category.{v} C]
variable {J : GrothendieckTopology C}
variable (P : ObjectProperty (Sheaf J (Type (max u v))))

/-- A presieve in the selected full subcategory is covering when it is presented by a small family
whose ambient coproduct map is locally surjective. -/
def covering {X : P.FullSubcategory} (R : Presieve X) : Prop :=
  ∃ (ι : Type (max u v)) (Y : ι → P.FullSubcategory) (π : ∀ i, Y i ⟶ X),
    R = Presieve.ofArrows Y π ∧
      Sheaf.IsLocallySurjective (Limits.Sigma.desc (fun i ↦ (π i).hom))

/-- The pretopology generated by locally-surjective coproduct presentations. -/
def pretopology [P.IsClosedUnderLimitsOfShape WalkingCospan] : Pretopology P.FullSubcategory where
  coverings _ R := covering P R
  has_isos {X Y} f := by
    refine ⟨PUnit.{max u v + 1}, (fun _ ↦ Y), (fun _ ↦ f), ?_, ?_⟩
    · exact (Presieve.ofArrows_pUnit (f := f)).symm
    · haveI : IsIso f.hom := inferInstanceAs (IsIso (P.ι.map f))
      apply (Sheaf.isLocallySurjective_iff_epi _).2
      constructor
      intro Z a b hab
      apply (cancel_epi f.hom).1
      have hh := congrArg (fun k ↦ Sigma.ι (fun _ : PUnit.{max u v + 1} ↦ Y.obj) PUnit.unit ≫ k) hab
      simpa only [Sigma.ι_desc_assoc] using hh
  pullbacks {X Y} f R hR := by
    obtain ⟨ι, Z, π, rfl, hπ⟩ := hR
    refine ⟨ι, (fun i ↦ pullback (π i) f), (fun i ↦ pullback.snd (π i) f), ?_, ?_⟩
    · exact (Presieve.ofArrows_pullback (f := f) Z π).symm
    · have hp (i : ι) : IsPullback (pullback.fst (π i) f).hom
          (pullback.snd (π i) f).hom (π i).hom f.hom :=
        (IsPullback.of_hasPullback (π i) f).map P.ι
      let e (i : ι) := (hp i).isoPullback
      have fac : Sigma.desc (fun i ↦ (pullback.snd (π i) f).hom) =
          Limits.Sigma.map (fun i ↦ (e i).hom) ≫
            Sigma.desc (fun i ↦ pullback.snd (π i).hom f.hom) := by
        apply Sigma.hom_ext
        intro i
        rw [Sigma.ι_desc, Sigma.ι_map_assoc, Sigma.ι_desc]
        exact (hp i).isoPullback_hom_snd.symm
      haveI := (Sheaf.isLocallySurjective_iff_epi _).1
        (Sheaf.LocalSurjectivity.sigmaDesc_pullbackSnd f.hom
          (fun i ↦ (Z i).obj) (fun i ↦ (π i).hom) hπ)
      apply (Sheaf.isLocallySurjective_iff_epi _).2
      rw [fac]
      infer_instance
  transitive {X} R T hR hT := by
    classical
    obtain ⟨ι, Z, π, rfl, hπ⟩ := hR
    have ht (i : ι) : covering P (T (π i) (Presieve.ofArrows.mk i)) :=
      hT (π i) (Presieve.ofArrows.mk i)
    unfold covering at ht
    choose κ W ρ hEq hρ using ht
    refine ⟨(Σ i, κ i), (fun ij ↦ W ij.1 ij.2),
      (fun ij ↦ ρ ij.1 ij.2 ≫ π ij.1), ?_, ?_⟩
    · apply le_antisymm
      · rintro V g ⟨Y, h, f, hf, hh, rfl⟩
        obtain ⟨i⟩ := hf
        rw [hEq i] at hh
        obtain ⟨j⟩ := hh
        exact Presieve.ofArrows.mk (Y := fun ij : Σ i, κ i ↦ W ij.1 ij.2)
          (f := fun ij ↦ ρ ij.1 ij.2 ≫ π ij.1) (⟨i, j⟩ : Σ i, κ i)
      · rintro _ _ ⟨ij⟩
        apply Presieve.bind_comp (π ij.1) (Presieve.ofArrows.mk ij.1)
        rw [hEq ij.1]
        exact Presieve.ofArrows.mk ij.2
    · haveI : Epi (Sigma.desc (fun i ↦ (π i).hom)) :=
        (Sheaf.isLocallySurjective_iff_epi _).1 hπ
      letI : ∀ i, Epi (Sigma.desc (fun j ↦ (ρ i j).hom)) :=
        fun i ↦ (Sheaf.isLocallySurjective_iff_epi _).1 (hρ i)
      apply (Sheaf.isLocallySurjective_iff_epi _).2
      constructor
      intro V a b hab
      apply (cancel_epi (Sigma.desc (fun i ↦ (π i).hom))).1
      apply Sigma.hom_ext
      intro i
      rw [Sigma.ι_desc_assoc, Sigma.ι_desc_assoc]
      apply (cancel_epi (Sigma.desc (fun j ↦ (ρ i j).hom))).1
      apply Sigma.hom_ext
      intro j
      rw [Sigma.ι_desc_assoc, Sigma.ι_desc_assoc]
      have hh := congrArg (fun k ↦
        Sigma.ι (fun ij : Σ i, κ i ↦ (W ij.1 ij.2).obj) ⟨i, j⟩ ≫ k) hab
      simpa only [Sigma.ι_desc_assoc, ObjectProperty.FullSubcategory.comp_hom,
        Category.assoc] using hh


/-- The Grothendieck topology generated by locally-surjective coproduct presentations. -/
abbrev topology [P.IsClosedUnderLimitsOfShape WalkingCospan] :
    GrothendieckTopology P.FullSubcategory :=
  (pretopology P).toGrothendieck

/-- The locally-surjective topology on the selected full subcategory is subcanonical. -/
instance topology_subcanonical [P.IsClosedUnderLimitsOfShape WalkingCospan] :
    (topology P).Subcanonical := sorry

section

variable [HasWeakSheafify J (Type (max u v))]
variable [P.IsClosedUnderLimitsOfShape WalkingCospan]
variable (hP : ∀ U : C, P (J.sheafifiedRepresentable U))

/-- The sheafified-representable functor lifted to the selected full subcategory. -/
noncomputable abbrev representableFunctor : C ⥤ P.FullSubcategory :=
  P.lift J.sheafifiedRepresentableFunctor hP

namespace RepresentableFunctor

include hP

omit [P.IsClosedUnderLimitsOfShape WalkingCospan] in
/-- The evaluations from sheafified representables form a locally-surjective covering of
any selected sheaf. This gives the actual covering family used by the comparison theorem. -/
theorem covering_representables (X : P.FullSubcategory) :
    covering P (Presieve.ofArrows
      (fun i : Σ U : C, J.sheafifiedRepresentable U ⟶ X.obj ↦
        (representableFunctor P hP).obj i.1)
      (fun i ↦ ObjectProperty.homMk i.2)) := by
  classical
  have homEquiv_comp {U : C} {F G : Sheaf J (Type (max u v))}
      (a : J.sheafifiedRepresentable U ⟶ F) (b : F ⟶ G) :
      J.sheafifiedRepresentableHomEquiv G U (a ≫ b) =
        b.hom.app (op U) (J.sheafifiedRepresentableHomEquiv F U a) := by
    change uliftYonedaEquiv
      ((sheafificationAdjunction J (Type (max u v))).homEquiv _ G (a ≫ b)) = _
    rw [Adjunction.homEquiv_naturality_right, uliftYonedaEquiv_comp]
    rfl
  let I := Σ U : C, J.sheafifiedRepresentable U ⟶ X.obj
  let Y : I → P.FullSubcategory := fun i ↦ (representableFunctor P hP).obj i.1
  let π : ∀ i, Y i ⟶ X := fun i ↦ ObjectProperty.homMk i.2
  refine ⟨I, Y, π, rfl, ?_⟩
  rw [Sheaf.LocalSurjectivity.sigmaDesc_iff_presheaf]
  apply Presheaf.isLocallySurjective_of_surjective
  intro U s
  let a : J.sheafifiedRepresentable U.unop ⟶ X.obj :=
    (J.sheafifiedRepresentableHomEquiv X.obj U.unop).symm s
  let t := J.sheafifiedRepresentableHomEquiv
    (J.sheafifiedRepresentable U.unop) U.unop (𝟙 _)
  refine ⟨(Sigma.ι (fun i : I ↦ (Y i).obj.obj) ⟨U.unop, a⟩).app U t, ?_⟩
  change (Sigma.desc (fun i : I ↦ (π i).hom.hom)).app U
    ((Sigma.ι (fun i : I ↦ (Y i).obj.obj) ⟨U.unop, a⟩).app U t) = s
  have hf := ConcreteCategory.congr_hom
    (NatTrans.congr_app (Sigma.ι_desc (fun i : I ↦ (π i).hom.hom) ⟨U.unop, a⟩) U) t
  change _ = s
  rw [← types_comp_apply]
  rw [NatTrans.comp_app] at hf
  rw [hf]
  change a.hom.app U t = s
  rw [← homEquiv_comp (𝟙 (J.sheafifiedRepresentable U.unop)) a, Category.id_comp]
  exact Equiv.apply_symm_apply _ s

omit hP [P.IsClosedUnderLimitsOfShape WalkingCospan] in
private theorem homEquiv_map {W V : C} (g : W ⟶ V) :
    J.sheafifiedRepresentableHomEquiv (J.sheafifiedRepresentable V) W
      (J.sheafifiedRepresentableMap g) =
    (toSheafify J (uliftYoneda.{max u v}.obj V)).app (op W) (ULift.up g) := by
  change uliftYonedaEquiv ((sheafificationAdjunction J (Type (max u v))).homEquiv _ _
    ((presheafToSheaf J (Type (max u v))).map (uliftYoneda.{max u v}.map g))) = _
  rw [Adjunction.homEquiv_unit]
  change ((toSheafify J (uliftYoneda.{max u v}.obj W) ≫
    sheafifyMap J (uliftYoneda.{max u v}.map g)).app (op W)) (ULift.up (𝟙 W)) = _
  have hn := congrArg (fun k : uliftYoneda.{max u v}.obj W ⟶
      sheafify J (uliftYoneda.{max u v}.obj V) ↦ k.app (op W) (ULift.up (𝟙 W)))
    (toSheafify_naturality J (uliftYoneda.{max u v}.map g))
  refine hn.symm.trans ?_
  change (toSheafify J (uliftYoneda.{max u v}.obj V)).app (op W)
    (ULift.up (𝟙 W ≫ g)) = _
  rw [Category.id_comp]

omit [P.IsClosedUnderLimitsOfShape WalkingCospan] in
private theorem sourceImageSieve_mem {U V : C}
    (c : (representableFunctor P hP).obj U ⟶ (representableFunctor P hP).obj V) :
    (representableFunctor P hP).imageSieve c ∈ J U := by
  let x := J.sheafifiedRepresentableHomEquiv (J.sheafifiedRepresentable V) U c.hom
  let η := toSheafify J (uliftYoneda.{max u v}.obj V)
  have hnat {W U : C} {F : Sheaf J (Type (max u v))} (g : W ⟶ U)
      (a : J.sheafifiedRepresentable U ⟶ F) :
      J.sheafifiedRepresentableHomEquiv F W (J.sheafifiedRepresentableMap g ≫ a) =
      F.obj.map g.op (J.sheafifiedRepresentableHomEquiv F U a) := by
    change uliftYonedaEquiv ((sheafificationAdjunction J (Type (max u v))).homEquiv _ _
      ((presheafToSheaf J (Type (max u v))).map (uliftYoneda.{max u v}.map g) ≫ a)) = _
    rw [Adjunction.homEquiv_naturality_left]
    exact (uliftYonedaEquiv_naturality _ g.op).symm
  apply J.superset_covering ?_ (Presheaf.imageSieve_mem J η x)
  intro W f hf
  obtain ⟨⟨g⟩, hg⟩ := hf
  refine ⟨g, ?_⟩
  apply ObjectProperty.hom_ext
  apply (J.sheafifiedRepresentableHomEquiv (J.sheafifiedRepresentable V) W).injective
  exact (homEquiv_map g).trans (hg.trans (hnat f c.hom).symm)



private theorem pushforward_mem {U : C} {S : Sieve U} (hS : S ∈ J U) :
    S.functorPushforward (representableFunctor P hP) ∈
      topology P ((representableFunctor P hP).obj U) := by
  let B : J.Cover U := ⟨S, hS⟩
  refine ⟨Presieve.ofArrows (fun I : B.Arrow ↦ (representableFunctor P hP).obj I.Y)
    (fun I ↦ (representableFunctor P hP).map I.f), ?_, ?_⟩
  · refine ⟨B.Arrow, _, _, rfl, ?_⟩
    exact GrothendieckTopology.sheafifiedRepresentableCoverMap_isLocallySurjective B
  · rintro W f ⟨I⟩
    exact ⟨I.Y, I.f, 𝟙 _, I.hf, by simp⟩

private theorem isCoverDense : (representableFunctor P hP).IsCoverDense (topology P) where
  is_cover X := by
    refine ⟨_, RepresentableFunctor.covering_representables P hP X, ?_⟩
    rintro Y f ⟨i⟩
    exact Presieve.in_coverByImage (representableFunctor P hP) (ObjectProperty.homMk i.2)


omit [P.IsClosedUnderLimitsOfShape WalkingCospan] in
private theorem sourceEqualizer_mem {U V : C} (f₁ f₂ : U ⟶ V)
    (h : (representableFunctor P hP).map f₁ = (representableFunctor P hP).map f₂) :
    Sieve.equalizer f₁ f₂ ∈ J U := by
  let η := toSheafify J (uliftYoneda.{max u v}.obj V)
  have he : η.app (op U) (ULift.up f₁) = η.app (op U) (ULift.up f₂) :=
    (homEquiv_map f₁).symm.trans
      ((congrArg (J.sheafifiedRepresentableHomEquiv (J.sheafifiedRepresentable V) U)
        (congrArg (fun k ↦ k.hom) h)).trans (homEquiv_map f₂))
  have hc := Presheaf.equalizerSieve_mem (D := Type (max u v))
    (FD := TypeCat.Fun) (CD := fun X ↦ X) J η (X := op U) (ULift.up f₁) (ULift.up f₂) he
  convert hc using 1
  ext W g
  change g ≫ f₁ = g ≫ f₂ ↔
    (ULift.up (g ≫ f₁) : ULift.{max u v} (W ⟶ V)) = ULift.up (g ≫ f₂)
  simp only [ULift.up_inj]

private theorem reflect_mem {U : C} {S : Sieve U}
    (hS : S.functorPushforward (representableFunctor P hP) ∈
      topology P ((representableFunctor P hP).obj U)) : S ∈ J U := by
  classical
  obtain ⟨R, hR, hRS⟩ := hS
  obtain ⟨ι, Y, π, rfl, hπ⟩ := hR
  let I := {i : Σ V : C, V ⟶ U // S i.2}
  let Z : I → C := fun i ↦ i.val.1
  let f : ∀ i : I, Z i ⟶ U := fun i ↦ i.val.2
  let q := Sigma.desc fun i : I ↦ J.sheafifiedRepresentableMap (f i)
  haveI : Epi (Sigma.desc (fun i ↦ (π i).hom)) :=
    (Sheaf.isLocallySurjective_iff_epi _).1 hπ
  have hq : Epi q := by
    constructor
    intro A a b hab
    apply (cancel_epi (Sigma.desc (fun i ↦ (π i).hom))).1
    apply Sigma.hom_ext
    intro i
    rw [Sigma.ι_desc_assoc, Sigma.ι_desc_assoc]
    obtain ⟨V, g, β, hg, hi⟩ := hRS _ _ (Presieve.ofArrows.mk i)
    have hh : J.sheafifiedRepresentableMap g ≫ a =
        J.sheafifiedRepresentableMap g ≫ b := by
      have ht := congrArg (fun k ↦ Sigma.ι
        (fun j : I ↦ J.sheafifiedRepresentable (Z j)) (⟨⟨V, g⟩, hg⟩ : I) ≫ k) hab
      simpa only [q, Sigma.ι_desc_assoc] using ht
    have hb : (π i).hom = β.hom ≫ J.sheafifiedRepresentableMap g :=
      congrArg (fun k ↦ k.hom) hi
    rw [hb]
    exact (Category.assoc β.hom _ a).trans
      ((congrArg (fun k ↦ β.hom ≫ k) hh).trans (Category.assoc β.hom _ b).symm)
  have hlocal : Sheaf.IsLocallySurjective q :=
    (Sheaf.isLocallySurjective_iff_epi _).2 hq
  have hc : Sieve.ofArrows Z f ∈ J U :=
    (J.ofArrows_mem_iff_isLocallySurjective_sigmaDesc_uliftYoneda_map f).2
      ((J.isLocallySurjective_sigmaDesc_sheafifiedRepresentableMap_iff Z f).1 hlocal)
  apply J.superset_covering ?_ hc
  rintro V g ⟨W, a, b, ⟨i⟩, rfl⟩
  exact S.downward_closed i.property a


/-- The representable functor gives a dense subsite presentation. -/
instance isDenseSubsite : (representableFunctor P hP).IsDenseSubsite J (topology P) where
  isCoverDense' := isCoverDense P hP
  isLocallyFull' := ⟨fun c ↦ pushforward_mem P hP (sourceImageSieve_mem P hP c)⟩
  isLocallyFaithful' := ⟨fun f₁ f₂ h ↦
    pushforward_mem P hP (sourceEqualizer_mem P hP f₁ f₂ h)⟩
  functorPushforward_mem_iff := ⟨reflect_mem P hP, pushforward_mem P hP⟩

/-- The representable functor is special cocontinuous for the locally-surjective topology. -/
theorem isSpecialCocontinuous : Functor.IsSpecialCocontinuous
    (representableFunctor P hP) J (topology P) := by
  let G := representableFunctor P hP
  letI : G.IsDenseSubsite J (topology P) := isDenseSubsite P hP
  letI := Functor.IsDenseSubsite.isCoverDense J (topology P) G
  letI := Functor.IsDenseSubsite.isLocallyFull J (topology P) G
  letI := Functor.IsDenseSubsite.isLocallyFaithful J (topology P) G
  exact
    { toIsContinuous := Functor.IsCoverDense.isContinuous J (topology P) G
        (Functor.IsDenseSubsite.coverPreserving J (topology P) G)
      toIsCocontinuous :=
        { cover_lift := fun hS ↦ Functor.IsDenseSubsite.functorPushforward_mem_iff.mp
            (Functor.IsCoverDense.functorPullback_pushforward_covering ⟨_, hS⟩) }
      sourceLocallyFaithful := fun a b h ↦ sourceEqualizer_mem P hP a b h
      sourceLocallyFull := fun c ↦ sourceImageSieve_mem P hP c
      toIsCoverDense := inferInstance }


/-- The cocontinuous sheaf pushforward associated to `representableFunctor`. -/
noncomputable abbrev cocontinuous :
    Sheaf J (Type (max u v)) ⥤ Sheaf (topology P) (Type (max u v)) :=
  letI := isSpecialCocontinuous P hP
  (representableFunctor P hP).sheafPushforwardCocontinuous
    (Type (max u v)) J (topology P)

/-- The continuous sheaf pushforward associated to `representableFunctor`. -/
noncomputable abbrev continuous :
    Sheaf (topology P) (Type (max u v)) ⥤ Sheaf J (Type (max u v)) :=
  letI := isSpecialCocontinuous P hP
  (representableFunctor P hP).sheafPushforwardContinuous
    (Type (max u v)) J (topology P)

/-- The sheaf adjunction associated to `representableFunctor`. -/
noncomputable abbrev adjunction : continuous P hP ⊣ cocontinuous P hP :=
  letI := isSpecialCocontinuous P hP
  (representableFunctor P hP).sheafAdjunctionCocontinuous
    (Type (max u v)) J (topology P)

/-- The continuous sheaf pushforward of the dense-subsite presentation is an equivalence. -/
noncomputable instance continuousIsEquivalence :
    (continuous P hP).IsEquivalence := by
  letI := isSpecialCocontinuous P hP
  infer_instance

/-- The equivalence induced by the continuous sheaf pushforward. -/
noncomputable abbrev continuousEquivalence :
    Sheaf (topology P) (Type (max u v)) ≌ Sheaf J (Type (max u v)) :=
  (continuous P hP).asEquivalence

/-- The objectwise equivalence underlying the inverse-image comparison for one representable
sheaf in the selected full subcategory. -/
noncomputable def yonedaComponentEquiv (ℱ : P.FullSubcategory) (U : Cᵒᵖ) :
    ((continuous P hP).obj ((topology P).yoneda.obj ℱ)).obj.obj U ≃
      (P.ι.obj ℱ).obj.obj U :=
  { toFun := fun α ↦
      (J.uliftSheafifiedRepresentableHomEquiv (P.ι.obj ℱ) U.unop) α.hom
    invFun := fun x ↦
      ObjectProperty.homMk
        ((J.uliftSheafifiedRepresentableHomEquiv (P.ι.obj ℱ) U.unop).symm x)
    left_inv := fun _ ↦ sorry
    right_inv := fun _ ↦ sorry }

/-- The presheaf-level inverse-image identification of a representable sheaf in the selected
full subcategory with its ambient sheaf. -/
noncomputable def yonedaUnderlyingIso (ℱ : P.FullSubcategory) :
    ((continuous P hP).obj ((topology P).yoneda.obj ℱ)).obj ≅ (P.ι.obj ℱ).obj :=
  NatIso.ofComponents
    (fun U ↦ Equiv.toIso (yonedaComponentEquiv P hP ℱ U))
    (fun {U V} f ↦ sorry)

/-- The inverse image of a representable sheaf on the selected subcategory is its ambient sheaf. -/
noncomputable def yonedaIso (ℱ : P.FullSubcategory) :
    (continuous P hP).obj ((topology P).yoneda.obj ℱ) ≅ P.ι.obj ℱ :=
  { hom := homMk (yonedaUnderlyingIso P hP ℱ).hom
    inv := homMk (yonedaUnderlyingIso P hP ℱ).inv
    hom_inv_id := sorry
    inv_hom_id := sorry }

/-- The cocontinuous direct image of a sheafified representable is the representable sheaf of
its image in the selected full subcategory. -/
noncomputable def sheafifiedRepresentableIso (U : C) :
    (cocontinuous P hP).obj (J.sheafifiedRepresentable U) ≅
      (topology P).yoneda.obj ((representableFunctor P hP).obj U) :=
  (Adjunction.rightAdjointUniq (adjunction P hP) (continuousEquivalence P hP).toAdjunction).app
      (J.sheafifiedRepresentable U) ≪≫
    (continuousEquivalence P hP).inverse.mapIso
      (yonedaIso P hP ((representableFunctor P hP).obj U)).symm ≪≫
    ((continuousEquivalence P hP).unitIso.app
      ((topology P).yoneda.obj ((representableFunctor P hP).obj U))).symm

omit hP

end RepresentableFunctor

end

end CategoryTheory.ObjectProperty.SurjectiveSite
