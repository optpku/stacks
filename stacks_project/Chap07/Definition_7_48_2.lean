module

public import ReasLib.CategoryTheory.Sites.PrecoverageSite
import StacksCheckRecall

@[expose] public section

open CategoryTheory

universe u v

variable {C : Type u} [Category.{v} C] (J : CategoryTheory.Precoverage C) [J.IsSite]
    (U : C) (S : CategoryTheory.Sieve U)

/- Definition 7.48.2: The topology associated to a site is the topology constructed
in Lemma 7.48.1. The membership characterization and the canonical topology
operation below identify this topology: a sieve covers exactly when it contains
the sieve generated by a selected covering presieve. -/
@[stacks 00ZD] #check (CategoryTheory.Precoverage.IsSite.mem_toGrothendieck_iff J (S := S) :
  S ∈ J.toGrothendieck U ↔ ∃ R ∈ J U, CategoryTheory.Sieve.generate R ≤ S)

#check (CategoryTheory.Precoverage.toGrothendieck J : CategoryTheory.GrothendieckTopology C)
