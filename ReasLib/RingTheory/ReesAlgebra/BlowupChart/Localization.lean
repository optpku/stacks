module

public import ReasLib.RingTheory.ReesAlgebra.BlowupChart

/-!
# Localization of affine blowup charts

The affine chart `R[I / a]` embeds in `Rₐ`, and localizing the chart at the
image of `a` recovers `Rₐ`.  This file exposes the denominator-clearing API
used repeatedly by affine blowup calculations.
-/

@[expose] public section

noncomputable section

open scoped AffineBlowupChart

universe u

namespace AffineBlowupChart

variable {R : Type u} [CommRing R]

/-- The distinguished parameter as a denominator in the localization away from itself. -/
@[stacks 07Z3 "affine blowup chart localization denominator"]
def denominator (I : Ideal R) (a : I) : Submonoid.powers a.1 :=
  ⟨a.1, Submonoid.mem_powers a.1⟩

/-- The localization denominator underlying the chart parameter is the parameter itself. -/
@[stacks 07Z3 "affine blowup chart localization denominator value", simp]
theorem coe_denominator (I : Ideal R) (a : I) :
    (denominator I a : R) = a.1 := sorry

/-- The comparison from an affine blowup chart to localization away from its parameter is
injective. -/
@[stacks 07Z3 "affine blowup chart localization comparison injective"]
theorem toLocalizationAway_injective (I : Ideal R) (a : I) :
    Function.Injective (AffineBlowupChart.toLocalizationAway I a) := sorry

/-- The chart-to-localization comparison detects zero. -/
@[stacks 07Z3 "affine blowup chart localization zero criterion", simp]
theorem toLocalizationAway_eq_zero_iff (I : Ideal R) (a : I)
    (x : affineBlowupChart I a) :
    AffineBlowupChart.toLocalizationAway I a x = 0 ↔ x = 0 := sorry

/-- Equality in a chart can be checked after passing to the ordinary localization. -/
@[stacks 07Z3 "affine blowup chart localization equality criterion"]
theorem eq_of_toLocalizationAway_eq
    (I : Ideal R) (a : I) {x y : affineBlowupChart I a}
    (hxy : AffineBlowupChart.toLocalizationAway I a x =
      AffineBlowupChart.toLocalizationAway I a y) :
    x = y := sorry

/-- The chart-to-localization comparison sends a basic fraction to the corresponding ordinary
localization fraction. -/
@[stacks 07Z3 "affine blowup chart basic fraction in localization", simp]
theorem toLocalizationAway_basicFraction (I : Ideal R) (a x : I) :
    AffineBlowupChart.toLocalizationAway I a
        (AffineBlowupChart.basicFraction I a x) =
      Localization.mk x.1 (denominator I a) := sorry

/-- The comparison sends a normalized power fraction to the corresponding ordinary localization
fraction. -/
@[stacks 07Z3 "affine blowup chart power fraction in localization", simp]
theorem toLocalizationAway_powerFraction
    (I : Ideal R) (a : I) (n : ℕ) (r : ↥(I ^ n)) :
    AffineBlowupChart.toLocalizationAway I a
        (AffineBlowupChart.powerFraction I a n r) =
      Localization.mk r.1
        (⟨a.1 ^ n, (Submonoid.mem_powers_iff _ _).mpr ⟨n, rfl⟩⟩ : Submonoid.powers a.1) := sorry

/-- Multiplying a basic affine-chart fraction by the chart parameter clears its denominator. -/
@[stacks 07Z3 "affine blowup chart basic fraction denominator clearing", simp]
theorem basicFraction_mul_parameter (I : Ideal R) (a x : I) :
    AffineBlowupChart.basicFraction I a x * AffineBlowupChart.algebraMap I a a.1 =
      AffineBlowupChart.algebraMap I a x.1 := sorry

/-- Multiplying a normalized power fraction by the matching power of the chart parameter clears
its denominator. -/
@[stacks 07Z3 "affine blowup chart power fraction denominator clearing", simp]
theorem powerFraction_mul_parameter
    (I : Ideal R) (a : I) (n : ℕ) (r : ↥(I ^ n)) :
    AffineBlowupChart.powerFraction I a n r *
        (AffineBlowupChart.algebraMap I a a.1) ^ n =
      AffineBlowupChart.algebraMap I a r.1 := sorry

/-- The distinguished parameter is a nonzerodivisor in its affine blowup chart. -/
@[stacks 07Z3 "affine blowup chart regular parameter"]
theorem parameter_isRegular (I : Ideal R) (a : I) :
    IsRegular (AffineBlowupChart.algebraMap I a a.1) := sorry

/-- Extending the center ideal to its affine blowup chart gives the principal ideal generated by
the distinguished parameter. -/
@[stacks 07Z3 "affine blowup chart extended center"]
theorem map_ideal_eq_span_parameter (I : Ideal R) (a : I) :
    Ideal.map (AffineBlowupChart.algebraMap I a) I =
      Ideal.span {AffineBlowupChart.algebraMap I a a.1} := sorry

/-- Localizing an affine blowup chart away from its distinguished parameter recovers the
ordinary localization of the base ring. -/
@[stacks 07Z3 "affine blowup chart localization"]
noncomputable instance instIsLocalizationAway (I : Ideal R) (a : I) :
    IsLocalization.Away (AffineBlowupChart.algebraMap I a a.1) (Localization.Away a.1) := sorry

end AffineBlowupChart


