module

public import ReasLib.AlgebraicGeometry.Scheme.IdealSubobject.Quasicoherent
import StacksCheckRecall

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry

/- Lemma 29.2.3 (1): an ideal subobject on a scheme is locally generated by sections if and
only if its module sheaf is quasi-coherent. -/
@[stacks 01QQ] #check
  (Scheme.IdealSubobject.isLocallyGeneratedBySections_iff_isQuasicoherent :
    ∀ {X : Scheme.{u}} (I : Scheme.IdealSubobject X),
      I.IsLocallyGeneratedBySections ↔ I.toModule.IsQuasicoherent)

/- Lemma 29.2.3 (2): a locally generated ideal subobject is the ideal represented by some
closed subscheme. -/
@[stacks 01QQ] #check
  (Scheme.IdealSubobject.exists_idealSheafData_of_isLocallyGeneratedBySections :
    ∀ {X : Scheme.{u}} (I : Scheme.IdealSubobject X),
      I.IsLocallyGeneratedBySections → ∃ J : X.IdealSheafData, J.toSubobject = I)

/- Lemma 29.2.3 (3): an ideal subobject identified with the kernel ideal of a closed immersion
is quasi-coherent. -/
@[stacks 01QQ] #check
  (Scheme.IdealSubobject.isQuasicoherent_of_eq_kernelIdealSubobject :
    ∀ {X Z : Scheme.{u}} (I : Scheme.IdealSubobject X) (i : Z ⟶ X)
      [IsClosedImmersion i], i.kernelIdealSubobject = I → I.toModule.IsQuasicoherent)

end AlgebraicGeometry
