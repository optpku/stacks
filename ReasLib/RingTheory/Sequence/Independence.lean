module

public import Mathlib.Data.Fin.Tuple.Basic
public import Mathlib.LinearAlgebra.LinearIndependent.Defs
public import Mathlib.RingTheory.Ideal.Cotangent
public import Mathlib.RingTheory.Length
public import Mathlib.RingTheory.LocalRing.MaximalIdeal.Defs
public import Mathlib.RingTheory.RingHom.Flat

public section

universe u

namespace RingTheory.Sequence

variable {A : Type u} [CommRing A]

/-- A finite family in a ring is independent when its canonical classes are linearly independent
over the quotient ring in the cotangent module of the ideal that it generates. -/
def IsIndependent {n : ℕ} (f : Fin n → A) : Prop :=
  let I := Ideal.span (Set.range f)
  LinearIndependent (A ⧸ I)
    (fun i ↦ I.toCotangent ⟨f i, Ideal.subset_span (Set.mem_range_self i)⟩)

/-- Independence of a finite family is equivalent to every coefficient of each vanishing
relation belonging to the ideal generated by the family. -/
theorem isIndependent_iff {n : ℕ} (f : Fin n → A) :
    IsIndependent f ↔ ∀ a : Fin n → A, (∑ i, a i * f i) = 0 →
      ∀ i, a i ∈ Ideal.span (Set.range f) := sorry

namespace IsIndependent

universe v

/-- A flat ring homomorphism sends an independent finite family to an independent finite family. -/
theorem map_of_flat {A : Type u} {B : Type v} [CommRing A] [CommRing B]
    {n : ℕ} {f : Fin n → A} : IsIndependent f → (φ : A →+* B) → RingHom.Flat φ →
      IsIndependent (fun i ↦ φ (f i)) := sorry

/-- Every coefficient of a vanishing relation on an independent family belongs to the ideal
generated by that family. -/
theorem coeff_mem {n : ℕ} {f : Fin n → A} (h : IsIndependent f)
    {a : Fin n → A} (ha : (∑ i, a i * f i) = 0) (i : Fin n) :
    a i ∈ Ideal.span (Set.range f) := sorry

/-- Replacing the final member `f * g` of an independent finite family by `f` preserves
independence. -/
theorem snoc_left_of_mul {n : ℕ} {fs : Fin n → A} {f g : A}
    (h : IsIndependent (Fin.snoc fs (f * g))) :
    IsIndependent (Fin.snoc fs f) := sorry

/-- For an independent finite family ending in `f * g`, finite length of the quotient by
its generated ideal makes that length the sum of the quotient lengths obtained by
replacing the final member with `f` and with `g`. -/
theorem length_quotient_snoc_mul {A : Type u} [CommRing A] {n : ℕ}
    {fs : Fin n → A} {f g : A}
    (h_independent : IsIndependent (Fin.snoc fs (f * g)))
    (h_finite : IsFiniteLength A (A ⧸ Ideal.span (Set.range (Fin.snoc fs (f * g))))) :
    Module.length A (A ⧸ Ideal.span (Set.range (Fin.snoc fs (f * g)))) =
      Module.length A (A ⧸ Ideal.span (Set.range (Fin.snoc fs f))) +
        Module.length A (A ⧸ Ideal.span (Set.range (Fin.snoc fs g))) := sorry

/-- The length of the quotient by positive powers of an independent generating family
of the maximal ideal is the product of the exponents. -/
theorem length_quotient_pow {A : Type u} [CommRing A] [IsLocalRing A] {n : ℕ}
    (x : Fin n → A) (e : Fin n → ℕ)
    (h_span : IsLocalRing.maximalIdeal A = Ideal.span (Set.range x))
    (h_pos : ∀ i, 0 < e i)
    (h_independent : IsIndependent (fun i ↦ x i ^ e i)) :
    Module.length A (A ⧸ Ideal.span (Set.range (fun i ↦ x i ^ e i))) =
      ∏ i, (e i : ℕ∞) := sorry

end IsIndependent

end RingTheory.Sequence
