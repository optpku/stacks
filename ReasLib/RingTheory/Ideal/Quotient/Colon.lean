module

public import ReasLib.LinearAlgebra.Quotient.ShortExact
public import Mathlib.RingTheory.Ideal.Colon
import Mathlib.Tactic.CrossRefAttribute

/-!
# The colon-ideal quotient sequence

For an ideal `I` and an element `a`, multiplication by `a` specializes the general quotient
sequence of a linear map to

`0 ⟶ A ⧸ (I : a) ⟶ A ⧸ I ⟶ A ⧸ (I, a) ⟶ 0`.

The `comap` and `range` bridges below connect the literal ideal presentation to
`LinearMap.QuotientSequence`.  The raw maps, representative formulas, ordinary exactness, and
categorical short exactness remain separately reusable.

@stack 0G1N
-/

@[expose] public section

open CategoryTheory

universe u

namespace Ideal

variable {A : Type u} [CommRing A]

/-- The colon ideal `(I : a)` is the preimage of `I` under multiplication by `a`. -/
@[stacks 0G1N "colon ideal as a linear preimage"]
theorem colon_span_singleton_eq_comap_mulRight (I : Ideal A) (a : A) :
    I.colon (Ideal.span {a}) = Submodule.comap (LinearMap.mulRight A a) I := sorry

/-- The range of multiplication by `a` is the principal ideal generated by `a`. -/
@[stacks 0G1N "principal ideal as a linear range"]
theorem range_mulRight_eq_span_singleton (a : A) :
    LinearMap.range (LinearMap.mulRight A a) = (Ideal.span {a} : Submodule A A) := sorry

namespace Quotient

/-- Multiplication by `a` from `A ⧸ (I : a)` to `A ⧸ I`. -/
@[stacks 0G1N "colon quotient multiplication"]
def colonMul (I : Ideal A) (a : A) :
    A ⧸ I.colon (Ideal.span {a}) →ₗ[A] A ⧸ I :=
  Submodule.mapQ (I.colon (Ideal.span {a})) I (LinearMap.mulRight A a)
    (fun _ hx => Ideal.mem_colon_span_singleton.mp hx)

/-- The quotient projection from `A ⧸ I` to `A ⧸ (I, a)`. -/
@[stacks 0G1N "colon sequence projection"]
def factorSupSpan (I : Ideal A) (a : A) :
    A ⧸ I →ₗ[A] A ⧸ (I ⊔ Ideal.span {a}) :=
  Submodule.factor (le_sup_left : I ≤ I ⊔ Ideal.span {a})

/-- On representatives, the first colon-sequence map is scalar multiplication by `a`. -/
@[simp, stacks 0G1N "colon quotient scalar formula"]
theorem colonMul_mk (I : Ideal A) (a x : A) :
    colonMul I a (Submodule.Quotient.mk x) =
      a • Submodule.Quotient.mk x := sorry

/-- The multiplication formula for the first colon-sequence map, written inside the ring. -/
@[stacks 0G1N "colon quotient multiplication formula"]
theorem colonMul_mk_eq_mul (I : Ideal A) (a x : A) :
    colonMul I a (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (x * a) := sorry

/-- The terminal projection in the colon sequence preserves representatives. -/
@[simp, stacks 0G1N "colon sequence projection formula"]
theorem factorSupSpan_mk (I : Ideal A) (a x : A) :
    factorSupSpan I a (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk x := sorry

/-- The first map in the colon sequence is injective.  This is the specialization of
`LinearMap.QuotientSequence.inclusion_injective` along
`Ideal.colon_span_singleton_eq_comap_mulRight`. -/
@[stacks 0G1N "colon quotient injectivity"]
theorem colonMul_injective (I : Ideal A) (a : A) :
    Function.Injective (colonMul I a) := sorry

/-- Multiplication by `a` followed by the quotient projection is exact.  The two ideal equalities
above transport `LinearMap.QuotientSequence.exact` to the literal colon sequence. -/
@[stacks 0G1N "colon quotient exactness"]
theorem exact_colonMul_factorSupSpan (I : Ideal A) (a : A) :
    Function.Exact (colonMul I a) (factorSupSpan I a) := sorry

/-- The terminal projection in the colon sequence is surjective.  This is the specialization of
`LinearMap.QuotientSequence.projection_surjective` along
`Ideal.range_mulRight_eq_span_singleton`. -/
@[stacks 0G1N "colon quotient surjectivity"]
theorem factorSupSpan_surjective (I : Ideal A) (a : A) :
    Function.Surjective (factorSupSpan I a) := sorry

/-- The two maps in the colon sequence compose to zero. -/
@[stacks 0G1N "colon quotient complex relation"]
theorem factorSupSpan_comp_colonMul (I : Ideal A) (a : A) :
    (factorSupSpan I a).comp (colonMul I a) = 0 := sorry

/-- The short complex `A ⧸ (I : a) ⟶ A ⧸ I ⟶ A ⧸ (I, a)`. -/
@[stacks 0G1N "colon quotient short complex"]
def colonShortComplex (I : Ideal A) (a : A) : ShortComplex (ModuleCat.{u} A) :=
  ModuleCat.shortComplexOfCompEqZero
    (colonMul I a) (factorSupSpan I a) (factorSupSpan_comp_colonMul I a)

/-- Example 10.28.7 (Tag 0G1N) (1): the colon-ideal quotient sequence is short exact. -/
@[stacks 0G1N "(1)"]
theorem colonShortComplex_shortExact (I : Ideal A) (a : A) :
    (colonShortComplex I a).ShortExact := sorry

end Quotient

end Ideal
