/-!
# Linear dependence locus of two generic vectors

The closed locus in `PrimeSpectrum (MvPolynomial (Fin 2 × Fin 3) R)` where the two
generic rows of the `2 × 3` matrix of coordinate polynomials become linearly
dependent in the residue field.
-/

@[expose] public section

universe u

noncomputable section

open MvPolynomial PrimeSpectrum

namespace MvPolynomial.TwoVectors

/-- The generic `2 × 3` matrix over `MvPolynomial (Fin 2 × Fin 3) R`, with entry
`(i, j)` equal to the coordinate polynomial `X (i, j)`. -/
def matrix (R : Type u) [CommRing R] :
    Matrix (Fin 2) (Fin 3) (MvPolynomial (Fin 2 × Fin 3) R) :=
  fun i j ↦ X (i, j)

/-- An entry of `matrix R` is the corresponding coordinate polynomial. -/
theorem matrix_apply (R : Type u) [CommRing R] (i : Fin 2) (j : Fin 3) :
    matrix R i j = X (i, j) := rfl

/-- The first generic vector `(a₁, a₂, a₃)`, recovered as row `0` of `matrix R`. -/
abbrev a (R : Type u) [CommRing R] : Fin 3 → MvPolynomial (Fin 2 × Fin 3) R :=
  matrix R 0

/-- The second generic vector `(b₁, b₂, b₃)`, recovered as row `1` of `matrix R`. -/
abbrev b (R : Type u) [CommRing R] : Fin 3 → MvPolynomial (Fin 2 × Fin 3) R :=
  matrix R 1

/-- A coordinate of `a R` is the corresponding variable in row `0`. -/
theorem a_apply (R : Type u) [CommRing R] (j : Fin 3) : a R j = X (0, j) := rfl

/-- A coordinate of `b R` is the corresponding variable in row `1`. -/
theorem b_apply (R : Type u) [CommRing R] (j : Fin 3) : b R j = X (1, j) := rfl

/-- The image of `matrix R` in the residue field of a prime, i.e. the pair of residue
vectors of `a R` and `b R` in `Fin 3 → p.asIdeal.ResidueField`. -/
def residueMatrix {R : Type u} [CommRing R]
    (p : PrimeSpectrum (MvPolynomial (Fin 2 × Fin 3) R)) :
    Matrix (Fin 2) (Fin 3) p.asIdeal.ResidueField :=
  (matrix R).map
    (algebraMap (MvPolynomial (Fin 2 × Fin 3) R) p.asIdeal.ResidueField)

/-- An entry of `residueMatrix p` is the residue of the corresponding matrix entry. -/
theorem residueMatrix_apply {R : Type u} [CommRing R]
    (p : PrimeSpectrum (MvPolynomial (Fin 2 × Fin 3) R)) (i : Fin 2) (j : Fin 3) :
    residueMatrix p i j =
      algebraMap (MvPolynomial (Fin 2 × Fin 3) R) p.asIdeal.ResidueField (matrix R i j) := rfl

/-- The locus of primes at which the residue images of `a R` and `b R` are linearly
dependent in `Fin 3 → p.asIdeal.ResidueField`. -/
def dependentLocus (R : Type u) [CommRing R] :
    Set (PrimeSpectrum (MvPolynomial (Fin 2 × Fin 3) R)) :=
  {p | ¬ LinearIndependent p.asIdeal.ResidueField (residueMatrix p)}

/-- Membership in `dependentLocus R` is linear dependence of the two residue rows. -/
theorem mem_dependentLocus_iff {R : Type u} [CommRing R]
    (p : PrimeSpectrum (MvPolynomial (Fin 2 × Fin 3) R)) :
    p ∈ dependentLocus R ↔
      ¬ LinearIndependent p.asIdeal.ResidueField (residueMatrix p) := Iff.rfl

/-- The 2-minors of `matrix R` are generated by the three `2 × 2` determinants
`a R 0 * b R 1 - a R 1 * b R 0`, `a R 0 * b R 2 - a R 2 * b R 0`, and
`a R 1 * b R 2 - a R 2 * b R 1`. -/
theorem minorIdeal_eq_span (R : Type u) [CommRing R] :
    Matrix.minorIdeal 2 (matrix R) =
      Ideal.span
        ({a R 0 * b R 1 - a R 1 * b R 0, a R 0 * b R 2 - a R 2 * b R 0,
            a R 1 * b R 2 - a R 2 * b R 1} :
          Set (MvPolynomial (Fin 2 × Fin 3) R)) := by
  classical
  let d₀₁ := a R 0 * b R 1 - a R 1 * b R 0
  let d₀₂ := a R 0 * b R 2 - a R 2 * b R 0
  let d₁₂ := a R 1 * b R 2 - a R 2 * b R 1
  let J : Ideal (MvPolynomial (Fin 2 × Fin 3) R) := Ideal.span ({d₀₁, d₀₂, d₁₂} : Set _)
  have hd₀₁ : d₀₁ ∈ J := Ideal.subset_span (by simp)
  have hd₀₂ : d₀₂ ∈ J := Ideal.subset_span (by simp)
  have hd₁₂ : d₁₂ ∈ J := Ideal.subset_span (by simp)
  have hdet : ∀ e : Fin 2 ↪ Fin 3,
      ((matrix R).submatrix (Function.Embedding.refl _) e).det ∈ J := by
    intro e
    rw [Matrix.det_fin_two]
    change a R (e 0) * b R (e 1) - a R (e 1) * b R (e 0) ∈ J
    generalize hx : e 0 = x
    generalize hy : e 1 = y
    have hxy : x ≠ y := by
      intro h
      have h01 : (0 : Fin 2) = 1 := e.injective (by
        calc
          e 0 = x := hx
          _ = y := h
          _ = e 1 := hy.symm)
      exact Fin.zero_ne_one h01
    fin_cases x <;> fin_cases y <;> simp_all
    · simpa only [hx, hy, d₀₁] using hd₀₁
    · simpa only [hx, hy, d₀₂] using hd₀₂
    · simpa only [hx, hy, d₀₁, neg_sub] using J.neg_mem hd₀₁
    · simpa only [hx, hy, d₁₂] using hd₁₂
    · simpa only [hx, hy, d₀₂, neg_sub] using J.neg_mem hd₀₂
    · simpa only [hx, hy, d₁₂, neg_sub] using J.neg_mem hd₁₂
  have h01 : d₀₁ ∈ Matrix.minorIdeal 2 (matrix R) := by
    let e : Fin 2 ↪ Fin 3 := ⟨![0, 1], by decide⟩
    have hmem : ((matrix R).submatrix (Function.Embedding.refl _) e).det ∈
        Matrix.minorIdeal 2 (matrix R) :=
      Ideal.subset_span ⟨(Function.Embedding.refl _, e), rfl⟩
    simpa [d₀₁, e, matrix, a, b, Matrix.det_fin_two] using hmem
  have h02 : d₀₂ ∈ Matrix.minorIdeal 2 (matrix R) := by
    let e : Fin 2 ↪ Fin 3 := ⟨![0, 2], by decide⟩
    have hmem : ((matrix R).submatrix (Function.Embedding.refl _) e).det ∈
        Matrix.minorIdeal 2 (matrix R) :=
      Ideal.subset_span ⟨(Function.Embedding.refl _, e), rfl⟩
    simpa [d₀₂, e, matrix, a, b, Matrix.det_fin_two] using hmem
  have h12 : d₁₂ ∈ Matrix.minorIdeal 2 (matrix R) := by
    let e : Fin 2 ↪ Fin 3 := ⟨![1, 2], by decide⟩
    have hmem : ((matrix R).submatrix (Function.Embedding.refl _) e).det ∈
        Matrix.minorIdeal 2 (matrix R) :=
      Ideal.subset_span ⟨(Function.Embedding.refl _, e), rfl⟩
    simpa [d₁₂, e, matrix, a, b, Matrix.det_fin_two] using hmem
  change Matrix.minorIdeal 2 (matrix R) = J
  apply le_antisymm
  · rw [Matrix.minorIdeal, Ideal.span_le]
    rintro _ ⟨⟨e₁, e₂⟩, rfl⟩
    let σ : Equiv.Perm (Fin 2) :=
      Equiv.ofBijective e₁ (Finite.injective_iff_bijective.mp e₁.injective)
    change (((matrix R).submatrix id e₂).submatrix σ id).det ∈ J
    rw [Matrix.det_permute]
    exact Ideal.mul_mem_left J _ (hdet e₂)
  · rw [Ideal.span_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl
    · exact h01
    · exact h02
    · exact h12

/-- Full row rank over a field is detected by a nonzero maximal minor. -/
private theorem linearIndependent_iff_exists_minor {K : Type*} [Field K] {m n : ℕ}
    (A : Matrix (Fin m) (Fin n) K) :
    LinearIndependent K A ↔ ∃ e : Fin m ↪ Fin n, (A.submatrix id e).det ≠ 0 := by
  classical
  constructor
  · intro hA
    obtain ⟨κ, a, ha, hspan, hli⟩ := exists_linearIndependent' K A.col
    letI : Finite κ := Finite.of_injective a ha
    letI : Fintype κ := Fintype.ofFinite κ
    have hcard : Fintype.card κ = m := by
      rw [← finrank_span_eq_card hli, hspan, ← A.rank_eq_finrank_span_cols]
      simpa using hA.rank_matrix
    let e : Fin m ↪ Fin n :=
      (Fintype.equivFinOfCardEq hcard).symm.toEmbedding.trans ⟨a, ha⟩
    refine ⟨e, ?_⟩
    have hcol : LinearIndependent K (A.submatrix id e).col := by
      change LinearIndependent K ((A.col ∘ a) ∘ (Fintype.equivFinOfCardEq hcard).symm)
      exact hli.comp _ (Equiv.injective _)
    exact ((Matrix.isUnit_iff_isUnit_det _).mp
      (Matrix.linearIndependent_cols_iff_isUnit.mp hcol)).ne_zero
  · rintro ⟨e, he⟩
    apply LinearIndependent.of_comp (LinearMap.funLeft K K e)
    exact Matrix.linearIndependent_rows_of_det_ne_zero he

/-- Linear dependence of the residue rows is cut out by the vanishing of the 2-minors
of `matrix R`. -/
theorem dependentLocus_eq_zeroLocus (R : Type u) [CommRing R] :
    dependentLocus R =
      zeroLocus
        (Matrix.minorIdeal 2 (matrix R) : Set (MvPolynomial (Fin 2 × Fin 3) R)) := by
  classical
  ext p
  change (¬ LinearIndependent p.asIdeal.ResidueField (residueMatrix p)) ↔
    Matrix.minorIdeal 2 (matrix R) ≤ p.asIdeal
  rw [Matrix.minorIdeal, Ideal.span_le]
  constructor
  · intro hdep x hx
    rcases hx with ⟨⟨e₁, e₂⟩, rfl⟩
    apply Ideal.algebraMap_residueField_eq_zero.mp
    rw [RingHom.map_det]
    change ((residueMatrix p).submatrix e₁ e₂).det = 0
    let σ : Equiv.Perm (Fin 2) :=
      Equiv.ofBijective e₁ (Finite.injective_iff_bijective.mp e₁.injective)
    have hbase : ((residueMatrix p).submatrix id e₂).det = 0 := by
      by_contra hne
      exact hdep ((linearIndependent_iff_exists_minor _).mpr ⟨e₂, hne⟩)
    change (((residueMatrix p).submatrix id e₂).submatrix σ id).det = 0
    rw [Matrix.det_permute, hbase, mul_zero]
  · intro hspan hLI
    obtain ⟨e, he⟩ := (linearIndependent_iff_exists_minor _).mp hLI
    have hmem : ((matrix R).submatrix (Function.Embedding.refl _) e).det ∈
        p.asIdeal := hspan ⟨(Function.Embedding.refl _, e), rfl⟩
    have hzero := Ideal.algebraMap_residueField_eq_zero.mpr hmem
    rw [RingHom.map_det] at hzero
    exact he hzero

/-- For every coefficient ring, `dependentLocus R` is Zariski closed. -/
theorem isClosed_dependentLocus (R : Type u) [CommRing R] :
    IsClosed (dependentLocus R) := by
  rw [dependentLocus_eq_zeroLocus]
  exact isClosed_zeroLocus _

/-- The topological Krull dimension of `dependentLocus R` equals the Krull dimension of
the quotient by the 2-minors of `matrix R`. -/
theorem topologicalKrullDim_dependentLocus_eq_ringKrullDim (R : Type u) [CommRing R] :
    topologicalKrullDim (dependentLocus R) =
      ringKrullDim (MvPolynomial (Fin 2 × Fin 3) R ⧸ Matrix.minorIdeal 2 (matrix R)) := by
  rw [dependentLocus_eq_zeroLocus]
  exact Ideal.topologicalKrullDim_zeroLocus_eq_ringKrullDim_quotient _

/-- The quotient by the 2-minors of `matrix ℤ` has Krull dimension `5`. -/
theorem ringKrullDim_quotient_minorIdeal_int :
    ringKrullDim (MvPolynomial (Fin 2 × Fin 3) ℤ ⧸ Matrix.minorIdeal 2 (matrix ℤ)) = 5 := sorry

/-- The quotient by the 2-minors of `matrix k` has Krull dimension `4`. -/
theorem ringKrullDim_quotient_minorIdeal_field {k : Type u} [Field k] :
    ringKrullDim (MvPolynomial (Fin 2 × Fin 3) k ⧸ Matrix.minorIdeal 2 (matrix k)) = 4 := sorry

/-- The residue-dependence locus of two generic three-coordinate vectors over `ℤ`
is Zariski closed. -/
theorem isClosed_dependentLocus_int : IsClosed (dependentLocus ℤ) :=
  isClosed_dependentLocus ℤ

/-- The residue-dependence locus of two generic three-coordinate vectors over `ℤ`
has topological Krull dimension `5`. -/
theorem topologicalKrullDim_dependentLocus :
    topologicalKrullDim (dependentLocus ℤ) = 5 := by
  rw [topologicalKrullDim_dependentLocus_eq_ringKrullDim]
  exact ringKrullDim_quotient_minorIdeal_int

/-- The residue-dependence locus of two generic three-coordinate vectors over a field
has topological Krull dimension `4`. -/
theorem topologicalKrullDim_dependentLocus_field {k : Type u} [Field k] :
    topologicalKrullDim (dependentLocus k) = 4 := by
  rw [topologicalKrullDim_dependentLocus_eq_ringKrullDim]
  exact ringKrullDim_quotient_minorIdeal_field

end MvPolynomial.TwoVectors
