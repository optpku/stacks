module

public import ReasLib.AlgebraicGeometry.QCohStack
public import ReasLib.AlgebraicGeometry.Scheme.Module.Quasicoherent.CardinalGeneration.Stack
public import ReasLib.CategoryTheory.Fibered.FullSubcategory.Stack
public import Mathlib.CategoryTheory.FiberedCategory.Fiber
public import Mathlib.CategoryTheory.ObjectProperty.Small

@[expose] public section

open CategoryTheory AlgebraicGeometry
open scoped Cardinal

noncomputable section

universe u

namespace AlgebraicGeometry.QCohStack.Cardinal

/-- Objects whose quasi-coherent sheaf is locally generated by at most `κ` sections. -/
def objectProperty (κ : Cardinal.{u}) (S : Scheme.{u}) :
    ObjectProperty (QCohStack.Obj S) :=
  fun x ↦ x.sheaf.obj.IsKappaGenerated κ

/-- Membership in the cardinal-generated cut is the underlying sheaf property. -/
theorem objectProperty_iff (κ : Cardinal.{u}) (S : Scheme.{u})
    (x : QCohStack.Obj S) :
    objectProperty κ S x ↔ x.sheaf.obj.IsKappaGenerated κ := sorry

/-- The projection from cardinal-generated quasi-coherent objects to the base site. -/
def p (κ : Cardinal.{u}) (S : Scheme.{u}) :
    (objectProperty κ S).FullSubcategory ⥤ Over S :=
  (objectProperty κ S).ι ⋙ QCohStack.p S

/-- Cardinal-bounded generation is stable under cartesian pullback. -/
theorem cartesianPullback (κ : Cardinal.{u}) (S : Scheme.{u}) :
    ObjectProperty.IsStableUnder.CartesianPullback (objectProperty κ S)
      (QCohStack.p S) := sorry

/-- Cardinal-bounded generation is fiberwise local for the fppf topology. -/
theorem isFiberwiseLocal (κ : Cardinal.{u}) (S : Scheme.{u})
    [(QCohStack.p S).IsFibered] :
    (objectProperty κ S).IsFiberwiseLocal (Scheme.fppfTopology.over S)
      (QCohStack.p S) := sorry

/-- The restricted cardinal-generated projection is an fppf stack. -/
@[stacks 04U7, instance]
instance instIsStackOnSite (κ : Cardinal.{u}) (S : Scheme.{u})
    [Fact (ℵ₀ ≤ κ)] :
    IsStack.OnSite (Scheme.fppfTopology.over S) (p κ S) := sorry

/-- Each fiber of the cardinal-generated projection is essentially small. -/
theorem fibers_essentiallySmall (κ : Cardinal.{u}) (S : Scheme.{u}) (U : Over S) :
    ObjectProperty.EssentiallySmall.{u} (⊤ : ObjectProperty ((p κ S).Fiber U)) := sorry

/-- A small full replacement of the cardinal-generated stack exists. -/
theorem exists_smallSubcategory (κ : Cardinal.{u}) (S : Scheme.{u})
    [Fact (ℵ₀ ≤ κ)] :
    ∃ P : ObjectProperty (objectProperty κ S).FullSubcategory,
      P.ι.EssSurj ∧
        IsStack.OnSite (Scheme.fppfTopology.over S) (P.ι ⋙ p κ S) ∧
        ∀ U : Over S, Small.{u} ((P.ι ⋙ p κ S).Fiber U) := sorry

end AlgebraicGeometry.QCohStack.Cardinal
