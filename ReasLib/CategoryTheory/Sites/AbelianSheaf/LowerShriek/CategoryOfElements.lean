module

public import ReasLib.CategoryTheory.Sites.Localization.CategoryOfElements
public import ReasLib.CategoryTheory.Sites.ConstantSheaf.Integer
public import ReasLib.CategoryTheory.Sites.Sheafification.FreeAbelian
public import Mathlib.CategoryTheory.Sites.Pullback
import Mathlib.Tactic.CrossRefAttribute

/-!
# Abelian lower shriek for a category-of-elements localization

The integral object on the localized site is modeled as the free abelian sheaf on its terminal
set-valued sheaf.  This is the formal model of the constant sheaf `ℤ` that interacts directly
with the free/forget adjunction.  Its lower shriek is identified by a reusable corepresentability
argument with the free abelian sheaf generated by the localizing sheaf.
-/

@[expose] public section

open CategoryTheory.Limits Opposite

noncomputable section

universe u v

namespace CategoryTheory.Functor.AbelianLowerShriek.AtSheaf

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable (F : Sheaf J (Type v))

/-- Restriction of additive sheaves to the category-of-elements localization at `F`. -/
noncomputable abbrev restriction :
    Sheaf J AddCommGrpCat.{v} ⥤
      Sheaf (localizationTopology F) AddCommGrpCat.{v} :=
  (localizationProjection F).sheafPushforwardContinuous
    AddCommGrpCat.{v} (localizationTopology F) J

/-- The integral additive sheaf on the category-of-elements localization, canonically modeled
as the free abelian sheaf on its terminal set-valued sheaf. -/
noncomputable abbrev integerSheaf
    [HasWeakSheafify (localizationTopology F) AddCommGrpCat.{v}] :
    Sheaf (localizationTopology F) AddCommGrpCat.{v} :=
  (localizationTopology F).freeAbelianSheaf
    (Sheaf.terminal (localizationTopology F) Limits.Types.isTerminalPUnit).obj

/-- The free-on-terminal model of the integral sheaf on the category-of-elements site is
canonically the constant sheaf with value `ULift ℤ`.  The comparison is assembled directly
from the constant terminal presheaf and the free abelian group on one generator, so it does not
require a separate set-valued sheafification hypothesis. -/
noncomputable def integerSheafIsoConstantInteger
    [HasWeakSheafify (localizationTopology F) AddCommGrpCat.{v}] :
    integerSheaf F ≅ constantIntegerSheaf (localizationTopology F) :=
  (presheafToSheaf (localizationTopology F) AddCommGrpCat.{v}).mapIso
      ((Functor.compConstIso F.obj.Elementsᵒᵖᵒᵖ AddCommGrpCat.free).symm.app PUnit) ≪≫
    (constantSheaf (localizationTopology F) AddCommGrpCat.{v}).mapIso
      freePUnitIsoInteger

section LowerShriek

variable [HasWeakSheafify J AddCommGrpCat.{v}]
variable [HasWeakSheafify (localizationTopology F) AddCommGrpCat.{v}]
variable [J.HasSheafCompose (forget AddCommGrpCat.{v})]
variable [(localizationTopology F).HasSheafCompose (forget AddCommGrpCat.{v})]
variable [(restriction F).IsRightAdjoint]

/-- Additive lower shriek from the category-of-elements localization. -/
noncomputable abbrev lowerShriek :
    Sheaf (localizationTopology F) AddCommGrpCat.{v} ⥤
      Sheaf J AddCommGrpCat.{v} :=
  (restriction F).leftAdjoint

/-- Additive lower shriek is left adjoint to restriction at `F`. -/
noncomputable def lowerShriekRestrictionAdj :
    lowerShriek F ⊣ restriction F :=
  Adjunction.ofIsRightAdjoint (restriction F)

/-- Forgetting coefficients commutes canonically with restriction to the category of elements. -/
noncomputable def restrictionForgetIso (A : Sheaf J AddCommGrpCat.{v}) :
    (sheafForget (localizationTopology F)).obj ((restriction F).obj A) ≅
      ((localizationProjection F).sheafPushforwardContinuous
        (Type v) (localizationTopology F) J).obj ((sheafForget J).obj A) :=
  Iso.refl _

/-- Morphisms from lower shriek of the localized integral sheaf identify with morphisms from
`F` to the underlying set-valued sheaf. -/
noncomputable def integerLowerShriekHomEquiv (A : Sheaf J AddCommGrpCat.{v}) :
    ((lowerShriek F).obj (integerSheaf F) ⟶ A) ≃
      (F ⟶ (sheafForget J).obj A) :=
  ((lowerShriekRestrictionAdj F).homEquiv (integerSheaf F) A).trans
    (((localizationTopology F).freeAbelianSheafCorepresentable
      (Sheaf.terminal (localizationTopology F) Limits.Types.isTerminalPUnit)).homEquiv.trans
        (((Iso.refl
          (Sheaf.terminal (localizationTopology F) Limits.Types.isTerminalPUnit)).homCongr
            (restrictionForgetIso F A)).trans
          (localizationTerminalHomEquiv F ((sheafForget J).obj A))))

/-- The lower-shriek Hom equivalence for the localized integral sheaf is natural in the target
additive sheaf. -/
theorem integerLowerShriekHomEquiv_naturality
    {A B : Sheaf J AddCommGrpCat.{v}} (g : A ⟶ B)
    (f : (lowerShriek F).obj (integerSheaf F) ⟶ A) :
    integerLowerShriekHomEquiv F B (f ≫ g) =
      integerLowerShriekHomEquiv F A f ≫ (sheafForget J).map g := sorry

/-- Lower shriek of the localized integral sheaf corepresents maps from the localizing sheaf
into underlying set-valued additive sheaves. -/
noncomputable def integerLowerShriekCorepresentable :
    (sheafForget J ⋙ coyoneda.obj (op F)).CorepresentableBy
      ((lowerShriek F).obj (integerSheaf F)) where
  homEquiv {A} := integerLowerShriekHomEquiv F A
  homEquiv_comp := integerLowerShriekHomEquiv_naturality F

/-- Remark 18.27.10 (0EYY), part (a), free-on-terminal model: lower shriek of the integral
sheaf on the category-of-elements localization is canonically the free abelian sheaf generated
by `F`. -/
@[stacks 0EYY "(a), free-on-terminal model"]
noncomputable def integerLowerShriekIsoFreeAbelian :
    (lowerShriek F).obj (integerSheaf F) ≅ J.freeAbelianSheaf F.obj :=
  Functor.CorepresentableBy.uniqueUpToIso
    (integerLowerShriekCorepresentable F)
    (J.freeAbelianSheafCorepresentable F)

/-- Remark 18.27.10 (0EYY), part (a): lower shriek of the constant integer sheaf on the
category-of-elements localization is canonically the free abelian sheaf generated by `F`. -/
@[stacks 0EYY "(a)"]
noncomputable def constantIntegerLowerShriekIsoFreeAbelian :
    (lowerShriek F).obj (constantIntegerSheaf (localizationTopology F)) ≅
      J.freeAbelianSheaf F.obj :=
  (lowerShriek F).mapIso (integerSheafIsoConstantInteger F).symm ≪≫
    integerLowerShriekIsoFreeAbelian F

/- The `sorryAx` in the following audits is confined to naturality/coherence and the
Prop-valued site conditions inherited by the explicit functors. -/

end LowerShriek

end CategoryTheory.Functor.AbelianLowerShriek.AtSheaf
