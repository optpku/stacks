module

public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Sequence.Koszul.Cohomology.First

@[expose] public section

/-!
# Annihilator of the degree-one Koszul cohomology model

@stack 05EF

The ideal generated by a finite family acts trivially on its degree-one Koszul cohomology with
arbitrary coefficients.
-/

noncomputable section

universe u

namespace KoszulComplex.Cohomology.H1

variable {R : Type u} [CommRing R] {n : ℕ}

/-- Lemma 15.90.7 (Tag `05EF`): the ideal generated by `f` annihilates the degree-one Koszul
cohomology object denoted `H₁(N, f)` in Stacks tag `05EE`. -/
@[stacks 05EF "the generated ideal annihilates degree-one Koszul cohomology"]
theorem span_le_annihilator (f : Fin n → R) (N : Type u) [AddCommGroup N] [Module R N] :
    Ideal.span (Set.range f) ≤ Module.annihilator R (obj f N) := sorry

end KoszulComplex.Cohomology.H1
