module

public import Mathlib.CategoryTheory.Sites.CoverLifting
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import ReasLib.CategoryTheory.Functor.RelativePullback
public import ReasLib.CategoryTheory.Sites.PrecoverageSite

/-!
# Cover lifting for selected precoverages

This file records the selected-cover pullback lifting condition on a functor
and its topology-level cocontinuity consequence.
-/

@[expose] public section

universe u₁ u₂ v₁ v₂

namespace CategoryTheory.Functor.Precoverage

variable {C : Type u₁} [Category.{v₁} C]
variable {D : Type u₂} [Category.{v₂} D]

/-- A functor has selected-cover lifts when each selected target covering admits
relative pullbacks along every map from an image object, and their source
projections form a selected source covering. -/
@[stacks 09W7]
class HasCoverLifts (u : C ⥤ D) (P : _root_.CategoryTheory.Precoverage C)
    (Q : _root_.CategoryTheory.Precoverage D) : Prop where
  /-- Lift a selected target cover along a map from an image object. -/
  exists_lift :
    ∀ ⦃V : D⦄ {I : Type (max u₂ v₂)} (W : I → D) (f : ∀ i, W i ⟶ V),
      Presieve.ofArrows W f ∈ Q V → ∀ ⦃U : C⦄ (g : u.obj U ⟶ V),
        ∃ (Z : I → C) (p : ∀ i, Z i ⟶ U) (q : ∀ i, u.obj (Z i) ⟶ W i),
          (∀ i, u.IsRelativePullback (p i) (q i) g (f i)) ∧
            Presieve.ofArrows Z p ∈ P U

namespace HasCoverLifts

/-- Selected-cover lifting is equivalent to relative universality for every
member of a target covering together with a selected covering of source projections. -/
theorem iff (u : C ⥤ D)
    (P : _root_.CategoryTheory.Precoverage C) (Q : _root_.CategoryTheory.Precoverage D) :
    HasCoverLifts u P Q ↔
      ∀ ⦃V : D⦄ {I : Type (max u₂ v₂)} (W : I → D) (f : ∀ i, W i ⟶ V),
        Presieve.ofArrows W f ∈ Q V → ∀ ⦃U : C⦄ (g : u.obj U ⟶ V),
          ∃ (Z : I → C) (p : ∀ i, Z i ⟶ U) (q : ∀ i, u.obj (Z i) ⟶ W i),
            (∀ i, u.IsRelativePullback (p i) (q i) g (f i)) ∧
              Presieve.ofArrows Z p ∈ P U := sorry

/-- The identity functor of a site admits selected-cover lifts. -/
instance id (P : _root_.CategoryTheory.Precoverage C) [P.IsSite] :
    HasCoverLifts (𝟭 C) P P := sorry

/-- Selected-cover lifts induce cocontinuity for the Grothendieck topologies
generated by the two selected precoverages. -/
theorem toCocontinuous {u : C ⥤ D}
    {P : _root_.CategoryTheory.Precoverage C} {Q : _root_.CategoryTheory.Precoverage D}
    (h : HasCoverLifts u P Q) :
    u.IsCocontinuous P.toGrothendieck Q.toGrothendieck := sorry

/-- A functor with selected-cover lifts is cocontinuous for the generated
Grothendieck topologies. -/
instance instIsCocontinuous {u : C ⥤ D}
    {P : _root_.CategoryTheory.Precoverage C} {Q : _root_.CategoryTheory.Precoverage D}
    [HasCoverLifts u P Q] :
    u.IsCocontinuous P.toGrothendieck Q.toGrothendieck :=
  toCocontinuous inferInstance

end HasCoverLifts

end CategoryTheory.Functor.Precoverage
