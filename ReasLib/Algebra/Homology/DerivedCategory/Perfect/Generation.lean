module

public import ReasLib.Algebra.Category.ModuleCat.FiniteProjective
public import ReasLib.Algebra.Homology.DerivedCategory.ModuleEmbedding
public import ReasLib.Algebra.Homology.DerivedCategory.Perfect.Subcategory
public import ReasLib.Algebra.Homology.DerivedCategory.Perfect.Triangulated
public import ReasLib.CategoryTheory.Pretriangulated.Generation.Generated
import Mathlib.Tactic.CrossRefAttribute

/-!
# Generation of the perfect derived category

@stack 0ATI

The degree-zero regular module generates the full perfect derived category as a saturated
triangulated subcategory and is its classical triangulated generator.
-/

@[expose] public section

noncomputable section

open CategoryTheory
open CategoryTheory.ObjectProperty

universe u

-- Local instance justification (search instability): the degree-zero embedding is formed in the
-- standard t-structure on the derived category of modules.
attribute [local instance] HasDerivedCategory.standard

namespace CategoryTheory

variable {R : Type u} [Ring R]

local notation "DMod" => DerivedCategory (ModuleCat R)
local notation "PerfectObj" => (DerivedCategory.IsPerfect : ObjectProperty DMod)

/-- A finite projective module placed in degree zero is a perfect derived object. -/
theorem finiteProjectiveModule_single_isPerfect
    (R : Type u) [Ring R] (M : ModuleCat.FiniteProjective R) :
    ((DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).obj M.obj).IsPerfect := sorry

/-- The degree-zero regular module `R[0]` is perfect. -/
@[stacks 0ATI "R[0] is perfect"]
theorem ring_single_isPerfect :
    DerivedCategory.IsPerfect ((ModuleCat.single0 (ModuleCat.of R R)) : DMod) := sorry

/-- The canonical degree-zero regular module in the perfect derived category. -/
@[stacks 0ATI "canonical perfect generator"]
abbrev ringSingleInPerfectDerived (R : Type u) [Ring R] : PerfectDerived R :=
  ⟨ModuleCat.single0 (ModuleCat.of R R), ring_single_isPerfect⟩

/-- Lemma 15.79.1 (1) (0ATI): perfect objects are exactly the saturated triangulated envelope
generated by `R[0]`. -/
@[stacks 0ATI "the perfect derived category is generated by R[0]"]
theorem perfectObjectProperty_eq_objectGeneratedProperty_ring_single :
    PerfectObj =
      ObjectProperty.Generated.property ((ModuleCat.single0 (ModuleCat.of R R)) : DMod) := sorry

/-- Lemma 15.79.1 (2) (0ATI): `R[0]` is a classical triangulated generator of the perfect
derived category. -/
@[stacks 0ATI "R[0] is a classical generator of perfect complexes"]
theorem ring_single_isClassicalGenerator_in_perfectDerivedCategory :
    ObjectProperty.IsClassicalTriangulatedGenerator
      (ObjectProperty.singleton (ringSingleInPerfectDerived R)) := sorry

end CategoryTheory
