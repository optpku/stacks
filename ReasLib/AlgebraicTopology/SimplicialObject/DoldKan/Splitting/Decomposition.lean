module

public import ReasLib.AlgebraicTopology.SimplicialObject.DoldKan.LowerFace
public import ReasLib.AlgebraicTopology.SimplicialObject.Splitting

/-!
# The lower-face Dold--Kan decomposition

This file owns the degreewise coproduct source, reversal reindexing, and inverse isomorphism for
the lower-face normalized Moore decomposition. The canonical splitting and its functorial map are
defined in `DoldKan/Splitting/LowerFace.lean`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite
open AlgebraicTopology
open scoped Simplicial

noncomputable section

universe u v

namespace CategoryTheory.SimplicialObject

variable {A : Type u} [Category.{v} A] [Abelian A]

/-- The family of lower-face normalized Moore summands indexed by epimorphisms out of `Δ`. -/
@[stacks 017U "lower-face splitting summands",
  stacks 017V "lower-face splitting summands"]
abbrev normalizedMoore.lowerFace.summand
    (U : SimplicialObject A) (Δ : SimplexCategoryᵒᵖ) : Splitting.IndexSet Δ → A :=
  Splitting.summand
    (fun n ↦ (normalizedMoore.lowerFace.subobject U n : A)) Δ

/-- The coproduct of all lower-face normalized Moore summands in simplicial degree `Δ`. -/
@[stacks 017U "lower-face splitting source",
  stacks 017V "lower-face splitting source"]
noncomputable abbrev normalizedMoore.lowerFace.source
    (U : SimplicialObject A) (Δ : SimplexCategoryᵒᵖ) : A :=
  ∐ normalizedMoore.lowerFace.summand U Δ

/-- The canonical cofan whose summands are the lower-face normalized Moore subobjects and whose
legs are generated by the corresponding degeneracy operators. -/
@[stacks 017U "lower-face splitting cofan", stacks 017V "lower-face splitting cofan"]
def normalizedMoore.lowerFace.cofan (U : SimplicialObject A) (Δ : SimplexCategoryᵒᵖ) :
    Cofan (normalizedMoore.lowerFace.summand U Δ) :=
  Splitting.cofan' (fun n ↦ (normalizedMoore.lowerFace.subobject U n : A)) U
    (fun n ↦ (normalizedMoore.lowerFace.subobject U n).arrow) Δ

/-- The canonical morphism from the finite coproduct of lower-face normalized Moore summands to
the simplices in degree `Δ`. -/
@[stacks 017U "lower-face splitting map", stacks 017V "lower-face splitting map"]
def normalizedMoore.lowerFace.decomposition (U : SimplicialObject A) (Δ : SimplexCategoryᵒᵖ) :
    normalizedMoore.lowerFace.source U Δ ⟶ U.obj Δ :=
  Sigma.desc (normalizedMoore.lowerFace.cofan U Δ).inj

namespace normalizedMoore.lowerFace.decomposition

/-- Reversal of the degeneracy indices packaged using the canonical coproduct reindexing
isomorphism. -/
@[stacks 017U "lower-face splitting reindexing isomorphism",
  stacks 017V "lower-face splitting reindexing isomorphism"]
noncomputable def reindexIso (U : SimplicialObject A) (Δ : SimplexCategoryᵒᵖ) :
    normalizedMoore.lowerFace.source U Δ ≅ normalizedMoore.lowerFace.source U Δ :=
  Sigma.reindex (Splitting.IndexSet.revEquiv (Δ := Δ))
    (normalizedMoore.lowerFace.summand U Δ)

/-- The coproduct automorphism which relabels every degeneracy summand by reversal of its
simplex epimorphism. -/
@[stacks 017U "lower-face splitting reindexing",
  stacks 017V "lower-face splitting reindexing"]
noncomputable def reindex (U : SimplicialObject A) (Δ : SimplexCategoryᵒᵖ) :
    normalizedMoore.lowerFace.source U Δ ⟶ normalizedMoore.lowerFace.source U Δ :=
  Sigma.desc fun B ↦
    Sigma.ι (normalizedMoore.lowerFace.summand U Δ) (Splitting.IndexSet.rev B)

/-- The explicit reversal map is the forward map of the canonical coproduct reindexing
isomorphism. -/
@[simp, stacks 017U "lower-face splitting reindexing comparison",
  stacks 017V "lower-face splitting reindexing comparison"]
theorem reindexIso_hom (U : SimplicialObject A) (Δ : SimplexCategoryᵒᵖ) :
    (reindexIso U Δ).hom = reindex U Δ := sorry

/-- The inverse of the lower-face coproduct reindexing isomorphism is the same reversal map. -/
@[simp, stacks 017U "lower-face splitting reindexing inverse comparison",
  stacks 017V "lower-face splitting reindexing inverse comparison"]
theorem reindexIso_inv (U : SimplicialObject A) (Δ : SimplexCategoryᵒᵖ) :
    (reindexIso U Δ).inv = reindex U Δ := sorry

/-- Reindexing the lower-face degeneracy summands by reversal twice is the identity. -/
@[stacks 017U "involutivity of lower-face splitting reindexing",
  stacks 017V "involutivity of lower-face splitting reindexing"]
theorem reindex_comp_self (U : SimplicialObject A) (Δ : SimplexCategoryᵒᵖ) :
    reindex U Δ ≫ reindex U Δ = 𝟙 _ := sorry

/-- The inverse lower-face decomposition map supplied by the unit of the lower-face Dold--Kan
equivalence, followed by the reversal reindexing of degeneracy summands. This owns the inverse
morphism as concrete equivalence data, independently of the inverse laws. -/
@[stacks 017U "lower-face splitting inverse", stacks 017V "lower-face splitting inverse"]
noncomputable def inv (U : SimplicialObject A) (Δ : SimplexCategoryᵒᵖ) :
    U.obj Δ ⟶ normalizedMoore.lowerFace.source U Δ :=
  ((Abelian.DoldKan.N.lowerFace.equivalence (A := A)).unitIso.hom.app U).app Δ ≫
    reindex U Δ

/-- After reversing its degeneracy labels, the lower-face coproduct decomposition is the inverse
component of the unit isomorphism for the lower-face Dold--Kan equivalence. -/
@[stacks 017U "lower-face splitting unit comparison",
  stacks 017V "lower-face splitting unit comparison"]
theorem reindex_comp_hom (U : SimplicialObject A) (Δ : SimplexCategoryᵒᵖ) :
    reindex U Δ ≫ normalizedMoore.lowerFace.decomposition U Δ =
      ((Abelian.DoldKan.N.lowerFace.equivalence (A := A)).unitIso.inv.app U).app Δ := sorry

/-- Composing the lower-face decomposition with its reconstruction inverse is the identity on
the coproduct of normalized summands. -/
@[stacks 017U "lower-face splitting hom-inverse law",
  stacks 017V "lower-face splitting hom-inverse law"]
theorem hom_inv_id (U : SimplicialObject A) (Δ : SimplexCategoryᵒᵖ) :
    normalizedMoore.lowerFace.decomposition U Δ ≫ inv U Δ = 𝟙 _ := sorry

/-- Composing the reconstruction inverse with the lower-face decomposition is the identity on
the simplices in degree `Δ`. -/
@[stacks 017U "lower-face splitting inverse-hom law",
  stacks 017V "lower-face splitting inverse-hom law"]
theorem inv_hom_id (U : SimplicialObject A) (Δ : SimplexCategoryᵒᵖ) :
    inv U Δ ≫ normalizedMoore.lowerFace.decomposition U Δ = 𝟙 _ := sorry

/-- The degreewise lower-face decomposition packaged as an isomorphism. -/
@[stacks 017U "lower-face splitting isomorphism",
  stacks 017V "lower-face splitting isomorphism"]
noncomputable def iso (U : SimplicialObject A) (Δ : SimplexCategoryᵒᵖ) :
    normalizedMoore.lowerFace.source U Δ ≅ U.obj Δ where
  hom := normalizedMoore.lowerFace.decomposition U Δ
  inv := inv U Δ
  hom_inv_id := hom_inv_id U Δ
  inv_hom_id := inv_hom_id U Δ

/-- The forward map of the lower-face splitting is the named decomposition map. -/
@[simp, stacks 017U "lower-face splitting forward map",
  stacks 017V "lower-face splitting forward map"]
theorem iso_hom (U : SimplicialObject A) (Δ : SimplexCategoryᵒᵖ) :
    (iso U Δ).hom = normalizedMoore.lowerFace.decomposition U Δ := sorry

/-- The inverse map of the lower-face splitting is the named reconstruction map. -/
@[simp, stacks 017U "lower-face splitting inverse map",
  stacks 017V "lower-face splitting inverse map"]
theorem iso_inv (U : SimplicialObject A) (Δ : SimplexCategoryᵒᵖ) :
    (iso U Δ).inv = inv U Δ := sorry

/-- The lower-face decomposition morphism is an isomorphism in every simplicial degree. -/
@[stacks 017U "lower-face splitting", stacks 017V "lower-face splitting"]
instance isIso (U : SimplicialObject A) (Δ : SimplexCategoryᵒᵖ) :
    IsIso (normalizedMoore.lowerFace.decomposition U Δ) := sorry

end normalizedMoore.lowerFace.decomposition

end CategoryTheory.SimplicialObject
