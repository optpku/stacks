module

public import Mathlib.RingTheory.LocalRing.ResidueField.Basic
public import Mathlib.RingTheory.Noetherian.Defs
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.Completion.LocalRing

@[expose] public section

/-!
# Coefficient Rings

A coefficient ring is a complete local subring of a complete local ring whose
residue-field map is bijective and whose maximal ideal is generated by the
ambient residue characteristic.

@stack 0326
@stack 032A
-/

universe u

open IsLocalRing

/-- Definition 10.160.4, tag `0326`: a coefficient ring in `R` is a complete
local subring inducing an isomorphism on residue fields and having maximal ideal
generated by the residue characteristic of `R`. -/
@[stacks 0326]
class IsCoefficientRing (R : Type u) [CommRing R] [IsCompleteLocalRing R]
    (Λ : Subring R) : Prop
    extends IsCompleteLocalRing Λ, IsLocalHom (Λ.subtype : Λ →+* R) where
  /-- The induced map on residue fields is bijective. -/
  residueField_bijective :
    Function.Bijective (ResidueField.map (Λ.subtype : Λ →+* R))
  /-- The maximal ideal is generated by the ambient residue characteristic. -/
  maximalIdeal_eq_span_residueChar :
    maximalIdeal Λ = Ideal.span ({(ringChar (ResidueField R) : Λ)} : Set Λ)

namespace IsCoefficientRing

/-- The defining completeness, locality, residue-field, and maximal-ideal conditions of a
coefficient ring. -/
@[stacks 0326 "coefficient ring specification"]
theorem spec {R : Type u} [CommRing R] [IsCompleteLocalRing R]
    (Λ : Subring R) [IsCoefficientRing R Λ] :
    IsCompleteLocalRing Λ ∧ IsLocalHom (Λ.subtype : Λ →+* R) ∧
      Function.Bijective (ResidueField.map (Λ.subtype : Λ →+* R)) ∧
        maximalIdeal Λ =
          Ideal.span ({(ringChar (ResidueField R) : Λ)} : Set Λ) := sorry

end IsCoefficientRing

/-- The maximal ideal of a coefficient ring is principal. -/
instance {R : Type u} [CommRing R] [IsCompleteLocalRing R]
    (Λ : Subring R) [IsCoefficientRing R Λ] : (maximalIdeal Λ).IsPrincipal := by
  classical
  rw [IsCoefficientRing.maximalIdeal_eq_span_residueChar]
  infer_instance

namespace IsCompleteLocalRing

/-- Theorem 10.160.8 (Cohen structure theorem): a complete local ring admits a coefficient
subring. -/
@[stacks 032A "(1), existence of a coefficient ring"]
theorem exists_coefficientSubring
    {R : Type u} [CommRing R] [IsCompleteLocalRing R] :
    ∃ Λ : Subring R, IsCoefficientRing R Λ := sorry

end IsCompleteLocalRing
