module

import StacksCheckRecall
import ReasLib.RingTheory.Ideal.HilbertSamuel.Annihilator
import ReasLib.RingTheory.Ideal.HilbertSamuel.Length
import ReasLib.RingTheory.Ideal.HilbertSamuel.Asymptotic
import ReasLib.RingTheory.Ideal.HilbertSamuel.Multiplicity

universe u v

/- Remark 43.15.6 (Trivial generalization) (1): finite colength of `I` on a
finite module over a Noetherian local ring has the five equivalent
characterizations stated in the source; the formal interface retains the
explicit properness guard `I + Module.annihilator R M ≠ ⊤` for edge cases. -/
@[stacks 0B00] #check
  (@Ideal.HilbertSamuel.finiteColength_tfae :
    ∀ {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
      [IsLocalRing R] [IsNoetherianRing R] [Module.Finite R M]
      (I : Ideal R), I + Module.annihilator R M ≠ ⊤ →
        List.TFAE
          [ (I + Module.annihilator R M).IsIdealOfDefinition
          , (I.map (Ideal.Quotient.mk (Module.annihilator R M))).radical =
              (IsLocalRing.maximalIdeal R).map
                (Ideal.Quotient.mk (Module.annihilator R M))
          , Module.support R (M ⧸ (I • ⊤ : Submodule R M)) ⊆
              {IsLocalRing.closedPoint R}
          , Module.supportDim R (M ⧸ (I • ⊤ : Submodule R M)) ≤ 0
          , Module.length R (M ⧸ (I • ⊤ : Submodule R M)) < ⊤ ])

/- Remark 43.15.6 (Trivial generalization) (2): adjoining the annihilator does
not change the submodule generated by any power of `I`. -/
@[stacks 0B00] #check
  (@Ideal.HilbertSamuel.pow_smul_top_add_annihilator :
    ∀ {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
      (I : Ideal R) (n : ℕ),
      (I ^ n • ⊤ : Submodule R M) =
        ((I + Module.annihilator R M) ^ n • ⊤ : Submodule R M))

/- Remark 43.15.6 (Trivial generalization) (3): after quotienting the scalar
ring by the annihilator, powers of the image ideal give the same submodules. -/
@[stacks 0B00] #check
  (@Ideal.HilbertSamuel.pow_smul_top_quotientAnnihilator :
    ∀ {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
      (I : Ideal R) (n : ℕ),
      let A := R ⧸ Module.annihilator R M
      -- Local instance justification (search instability): the canonical quotient-annihilator action is intentionally selected locally.
      letI : Module A M := Module.quotientAnnihilator
      -- Local instance justification (search instability): the scalar tower is tied to the selected quotient-annihilator action.
      letI : IsScalarTower R A M :=
        Module.IsTorsionBySet.isScalarTower (Module.isTorsionBySet_annihilator R M)
      Submodule.restrictScalars R
          ((I.map (Ideal.Quotient.mk (Module.annihilator R M))) ^ n • ⊤ :
            Submodule A M) =
        (I ^ n • ⊤ : Submodule R M))

/- Remark 43.15.6 (Trivial generalization) (4): adjoining the annihilator does
not change the Hilbert--Samuel `χ`-function. -/
@[stacks 0B00] #check
  (@Ideal.HilbertSamuel.chi_add_annihilator :
    ∀ {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
      (I : Ideal R) (n : ℕ),
      I.hilbertSamuelChi M n =
        (I + Module.annihilator R M).hilbertSamuelChi M n)

/- Remark 43.15.6 (Trivial generalization) (5): quotienting the scalar ring by
the annihilator does not change the Hilbert--Samuel `χ`-function. -/
@[stacks 0B00] #check
  (@Ideal.HilbertSamuel.chi_quotientAnnihilator :
    ∀ {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
      (I : Ideal R) (n : ℕ),
      let A := R ⧸ Module.annihilator R M
      -- Local instance justification (search instability): the canonical quotient-annihilator action is intentionally selected locally.
      letI : Module A M := Module.quotientAnnihilator
      I.hilbertSamuelChi M n =
        (I.map (Ideal.Quotient.mk (Module.annihilator R M))).hilbertSamuelChi M n)

/- Remark 43.15.6 (Trivial generalization) (6): the length of `M ⧸ I^n M`
is the sum of the lengths of its first `n` associated-graded pieces. -/
@[stacks 0B00] #check
  (@Ideal.HilbertSamuel.length_quotient_eq_sum :
    ∀ {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
      (I : Ideal R) (n : ℕ),
      Module.length R (M ⧸ (I ^ n • ⊤ : Submodule R M)) =
        ∑ p ∈ Finset.range n,
          Module.length R (Ideal.AssociatedGraded.piece I M p))

/- Remark 43.15.6 (Trivial generalization) (7): finite colength on `M` makes
the canonical Hilbert--Samuel polynomial represent the `χ`-function eventually. -/
@[stacks 0B00] #check
  (@Ideal.HilbertSamuel.chiPolynomial_spec_of_add_annihilator :
    ∀ {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
      [IsLocalRing R] [IsNoetherianRing R] [Module.Finite R M] (I : Ideal R),
      (I + Module.annihilator R M).IsIdealOfDefinition →
        (Ideal.HilbertSamuel.chiPolynomial I M).EventuallyEqNat
          (fun n ↦ ((I.hilbertSamuelChi M n).toNat : ℚ)))

/- Remark 43.15.6 (Trivial generalization) (8): the degree-`d` multiplicity is
the canonical coefficient invariant of the Hilbert–Samuel polynomial. -/
@[stacks 0B00] #check
  (@Ideal.HilbertSamuel.multiplicityInDegree :
    ∀ {R : Type u} [CommRing R] (I : Ideal R) (M : Type v)
      [AddCommGroup M] [Module R M] (d : ℕ), ℚ)

/- Remark 43.15.6 (Trivial generalization) (9): in every degree at least the
support dimension, the Hilbert--Samuel polynomial has the stated multiplicity
term and a remainder of strictly smaller degree. -/
@[stacks 0B00] #check
  (@Ideal.HilbertSamuel.chiPolynomial_eq_multiplicity_add_lowerDegree :
    ∀ {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
      {M : Type v} [AddCommGroup M] [Module R M] [Module.Finite R M]
      (I : Ideal R) (d : ℕ),
      (I + Module.annihilator R M).IsIdealOfDefinition →
      Module.supportDim R M ≤ d →
      ∃ Q : Polynomial ℚ,
        Q.degree < d ∧
          Ideal.HilbertSamuel.chiPolynomial I M =
            Polynomial.monomial d
              (Ideal.HilbertSamuel.multiplicityInDegree I M d / (d.factorial : ℚ)) + Q)
