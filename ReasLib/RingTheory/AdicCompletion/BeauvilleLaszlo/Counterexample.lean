module

public import Mathlib.RingTheory.MvPolynomial.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import ReasLib.Algebra.Module.LocalizedModule.Away.Gluing.BeauvilleLaszlo.Flat
public import ReasLib.RingTheory.Ideal.Principal

import Mathlib.Tactic.CrossRefAttribute

/-!
# Explicit Beauville-Laszlo completion counterexamples

The two quotient rings below are the concrete rings used by Example 15.91.9.  The polynomial
variables, relation families, quotient ideals, and distinguished elements are explicit data; the
noninjectivity, nonsurjectivity, non-glueing, and non-flatness assertions are separate Prop owners.

@stack 0BNU
-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory

/-- The variables `f, T₁, T₂, ...` in the two explicit counterexample presentations. -/
@[stacks 0BNU "counterexample variables"]
inductive BeauvilleLaszloCounterexampleVar
  | f
  | t (n : ℕ)
  deriving DecidableEq

section CounterexampleData

variable (k : Type u) [CommRing k]

/-- The polynomial variable `f` in the counterexample presentations. -/
@[stacks 0BNU "counterexample polynomial variable f"]
abbrev beauvilleLaszloCounterexample_fVar :
    MvPolynomial BeauvilleLaszloCounterexampleVar k :=
  MvPolynomial.X .f

/-- The polynomial variable `T_(n+1)` in the counterexample presentations. -/
@[stacks 0BNU "counterexample polynomial variables T"]
abbrev beauvilleLaszloCounterexample_tVar (n : ℕ) :
    MvPolynomial BeauvilleLaszloCounterexampleVar k :=
  MvPolynomial.X (.t n)

/-- The relation family `fT₁, fT₂ - T₁, fT₃ - T₂, ...` for the first quotient. -/
@[stacks 0BNU "first counterexample relations"]
def firstBeauvilleLaszloCounterexampleRelation :
    ℕ → MvPolynomial BeauvilleLaszloCounterexampleVar k
  | 0 =>
      beauvilleLaszloCounterexample_fVar k * beauvilleLaszloCounterexample_tVar k 0
  | n + 1 =>
      beauvilleLaszloCounterexample_fVar k * beauvilleLaszloCounterexample_tVar k (n + 1) -
        beauvilleLaszloCounterexample_tVar k n

/-- The ideal generated by the first counterexample relation family. -/
@[stacks 0BNU "first counterexample ideal"]
def firstBeauvilleLaszloCounterexampleIdeal :
    Ideal (MvPolynomial BeauvilleLaszloCounterexampleVar k) :=
  Ideal.span (Set.range (firstBeauvilleLaszloCounterexampleRelation k))

/-- The first quotient ring `k[f,T₁,T₂,...]/(fT₁,fT₂-T₁,...)`. -/
@[stacks 0BNU "first counterexample ring"]
abbrev firstBeauvilleLaszloCounterexampleRing :=
  MvPolynomial BeauvilleLaszloCounterexampleVar k ⧸
    firstBeauvilleLaszloCounterexampleIdeal k

/-- The distinguished element `f` in the first quotient ring. -/
@[stacks 0BNU "first counterexample distinguished element"]
abbrev firstBeauvilleLaszloCounterexample_f :
    firstBeauvilleLaszloCounterexampleRing k :=
  Ideal.Quotient.mk _ (beauvilleLaszloCounterexample_fVar k)

/-- The class of `T₁` in the first quotient ring. -/
@[stacks 0BNU "first counterexample torsion element"]
abbrev firstBeauvilleLaszloCounterexample_t1 :
    firstBeauvilleLaszloCounterexampleRing k :=
  Ideal.Quotient.mk _ (beauvilleLaszloCounterexample_tVar k 0)

/-- The relation family `fT₁, f²T₂, f³T₃, ...` for the second quotient. -/
@[stacks 0BNU "second counterexample relations"]
def secondBeauvilleLaszloCounterexampleRelation :
    ℕ → MvPolynomial BeauvilleLaszloCounterexampleVar k
  | n =>
      beauvilleLaszloCounterexample_fVar k ^ (n + 1) *
        beauvilleLaszloCounterexample_tVar k n

/-- The ideal generated by the second counterexample relation family. -/
@[stacks 0BNU "second counterexample ideal"]
def secondBeauvilleLaszloCounterexampleIdeal :
    Ideal (MvPolynomial BeauvilleLaszloCounterexampleVar k) :=
  Ideal.span (Set.range (secondBeauvilleLaszloCounterexampleRelation k))

/-- The second quotient ring `k[f,T₁,T₂,...]/(fT₁,f²T₂,...)`. -/
@[stacks 0BNU "second counterexample ring"]
abbrev secondBeauvilleLaszloCounterexampleRing :=
  MvPolynomial BeauvilleLaszloCounterexampleVar k ⧸
    secondBeauvilleLaszloCounterexampleIdeal k

/-- The distinguished element `f` in the second quotient ring. -/
@[stacks 0BNU "second counterexample distinguished element"]
abbrev secondBeauvilleLaszloCounterexample_f :
    secondBeauvilleLaszloCounterexampleRing k :=
  Ideal.Quotient.mk _ (beauvilleLaszloCounterexample_fVar k)

/-- The class of `T₁` in the second quotient ring. -/
@[stacks 0BNU "second counterexample torsion element"]
abbrev secondBeauvilleLaszloCounterexample_t1 :
    secondBeauvilleLaszloCounterexampleRing k :=
  Ideal.Quotient.mk _ (beauvilleLaszloCounterexample_tVar k 0)

end CounterexampleData

section

variable (k : Type u) [Field k]

/-- Example 15.91.9 (1): the first completion torsion comparison is not injective. -/
@[stacks 0BNU "first counterexample: torsion comparison is not injective"]
theorem firstBeauvilleLaszloCounterexample_fPowerTorsionToExtension_not_injective :
    ¬ Function.Injective
      (fPowerTorsionToExtension
        (algebraMap
          (firstBeauvilleLaszloCounterexampleRing k)
          (principalAdicCompletion (firstBeauvilleLaszloCounterexample_f k)))
        (firstBeauvilleLaszloCounterexample_f k)) := sorry

/-- Example 15.91.9 (2): the second completion torsion comparison is not surjective. -/
@[stacks 0BNU "second counterexample: torsion comparison is not surjective"]
theorem secondBeauvilleLaszloCounterexample_fPowerTorsionToExtension_not_surjective :
    ¬ Function.Surjective
      (fPowerTorsionToExtension
        (algebraMap
          (secondBeauvilleLaszloCounterexampleRing k)
          (principalAdicCompletion (secondBeauvilleLaszloCounterexample_f k)))
        (secondBeauvilleLaszloCounterexample_f k)) := sorry

/-- Example 15.91.9 (3): the first completion pair is not a Beauville-Laszlo glueing pair. -/
@[stacks 0BNU "first counterexample is not a glueing pair"]
theorem firstBeauvilleLaszloCounterexample_not_glueing_pair :
    ¬ IsBeauvilleLaszloGlueingPairAlong
        (algebraMap
          (firstBeauvilleLaszloCounterexampleRing k)
          (principalAdicCompletion (firstBeauvilleLaszloCounterexample_f k)))
        (firstBeauvilleLaszloCounterexample_f k) := sorry

/-- Example 15.91.9 (4): the second completion pair is not a Beauville-Laszlo glueing pair. -/
@[stacks 0BNU "second counterexample is not a glueing pair"]
theorem secondBeauvilleLaszloCounterexample_completion_not_glueing_pair :
    ¬ IsBeauvilleLaszloGlueingPairAlong
        (algebraMap
          (secondBeauvilleLaszloCounterexampleRing k)
          (principalAdicCompletion (secondBeauvilleLaszloCounterexample_f k)))
        (secondBeauvilleLaszloCounterexample_f k) := sorry

/-- Example 15.91.9 (5): the first principal-adic completion map is not flat. -/
@[stacks 0BNU, stacks 0BNP "first counterexample completion is not flat"]
theorem firstBeauvilleLaszloCounterexample_completion_not_flat :
    ¬ (algebraMap
        (firstBeauvilleLaszloCounterexampleRing k)
        (principalAdicCompletion (firstBeauvilleLaszloCounterexample_f k))).Flat := sorry

/-- Example 15.91.9 (6): the second principal-adic completion map is not flat. -/
@[stacks 0BNU "second counterexample completion is not flat"]
theorem secondBeauvilleLaszloCounterexample_completion_not_flat :
    ¬ (algebraMap
        (secondBeauvilleLaszloCounterexampleRing k)
        (principalAdicCompletion (secondBeauvilleLaszloCounterexample_f k))).Flat := sorry

end

end
