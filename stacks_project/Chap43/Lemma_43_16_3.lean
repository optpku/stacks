module

public import ReasLib.AlgebraicGeometry.Scheme.IdealSheafData.IntersectionMultiplicity.RegularSequence
public import stacks_project.Chap43.Lemma_43_14_3_IntersectionMultiplicity
import StacksCheckRecall

@[expose] public section

open CategoryTheory TopologicalSpace
open AlgebraicGeometry
open scoped AlgebraicGeometry

universe u

/- Lemma 43.16.3: at a component of a proper intersection, if the stalk ideal
of one subvariety is generated by a regular sequence of length `c`, then the
local intersection multiplicity is `c!` times the leading coefficient of the
eventual quotient-length polynomial, and this coefficient is positive. -/
@[stacks 0B04] #check
  (AlgebraicGeometry.Scheme.IdealSheafData.intersectionMultiplicity_regularSequence_spec :
    ∀ {k : Type u} [Field k] (X : SchemeOverField k) [Variety X]
      [Scheme.Regular X.left] (V W : X.left.IdealSheafData)
      [IsIntegral V.subscheme] [IsIntegral W.subscheme],
      V.IntersectsProperly W →
      ∀ (Z : irreducibleComponents (V ⊔ W).subscheme) (c : ℕ),
        let Y := X.left
        let ξ := genericPoints.ofComponent Z
        let x := (V ⊔ W).subschemeι ξ.1
        let R := Y.presheaf.stalk x
        let I := RingedSpace.idealSheafStalkIdeal
          (LocallyRingedSpace.closedImmersionIdealSubobject V.subschemeι.toLRSHom) x
        let J := RingedSpace.idealSheafStalkIdeal
          (LocallyRingedSpace.closedImmersionIdealSubobject W.subschemeι.toLRSHom) x
        let M := R ⧸ J
        ∀ (f : Fin c → R),
          RingTheory.Sequence.IsRegular R (List.ofFn f) →
          Ideal.span (Set.range f) = I →
          ∀ (P : Polynomial ℚ),
            P.EventuallyEqNat (fun t ↦
              ((Module.length R
                (M ⧸ (I ^ t • ⊤ : Submodule R M))).toNat : ℚ)) →
            (V.intersectionMultiplicity W ξ : ℚ) =
                (c.factorial : ℚ) * P.leadingCoeff ∧
              0 < P.leadingCoeff)
