module

public import ReasLib.CategoryTheory.Preadditive.CompactObject
public import ReasLib.CategoryTheory.Pretriangulated.CompactObject.Approximation
public import ReasLib.CategoryTheory.Pretriangulated.Generation.Stage
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Compact Factorizations Through Generating-Family Approximations

This leaf records the finite-subfamily factorization consequences of a
generating-family approximation.  The generated triangulated envelope is owned
by Mathlib; the positive-stage interface is owned by
`ObjectProperty.Generated.stage`.
-/

open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.ObjectProperty
open CategoryTheory.Pretriangulated

noncomputable section

universe w v u

namespace CategoryTheory

namespace IsGeneratingFamilyApproximation

section

variable {D : Type u} [Category.{v} D] [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D] [IsTriangulated D]
  [HasCoproducts.{max u v w} D]
variable {I : Type w} {E : I → D}

/-- A map from a compact object into a stage of a generating-family approximation factors through
the Mathlib triangulated envelope of a finite coproduct of members of the family. -/
@[stacks 09SP]
theorem compactFactorization
    {X : ℕ → D} {map : ∀ n : ℕ, X n ⟶ X (n + 1)} {Y : ℕ → D}
    {triangleHom : ∀ n : ℕ, Y n ⟶ X n}
    {triangleConnecting : ∀ n : ℕ, X (n + 1) ⟶ (Y n)⟦(1 : ℤ)⟧}
    (hR : IsGeneratingFamilyApproximation E X map Y triangleHom triangleConnecting)
    (hcompact : ∀ i : I, IsCompactObject (E i)) {C : D}
    (hC : IsCompactObject C) (n : ℕ) (f : C ⟶ X n) :
    ∃ (B : D) (J : Type (max u v w)) (_ : Finite J) (ι : J → I),
      (singleton (∐ fun j : J ↦ E (ι j))).triangEnvelope B ∧
        ∃ (g : C ⟶ B) (h : B ⟶ X n), g ≫ h = f := sorry

/-- A compact factorization through a generating-family approximation can be chosen in a positive
finite stage generated by a finite coproduct of members of the family. -/
@[stacks 09SP]
theorem compactFactorizationAtStage
    {X : ℕ → D} {map : ∀ n : ℕ, X n ⟶ X (n + 1)} {Y : ℕ → D}
    {triangleHom : ∀ n : ℕ, Y n ⟶ X n}
    {triangleConnecting : ∀ n : ℕ, X (n + 1) ⟶ (Y n)⟦(1 : ℤ)⟧}
    (hR : IsGeneratingFamilyApproximation E X map Y triangleHom triangleConnecting)
    (hcompact : ∀ i : I, IsCompactObject (E i)) {C : D}
    (hC : IsCompactObject C) (n : ℕ) (f : C ⟶ X n) :
    ∃ (B : D) (J : Type (max u v w)) (_ : Finite J) (ι : J → I) (m : ℕ+),
      Generated.stage (∐ fun j : J ↦ E (ι j)) m B ∧
        ∃ (g : C ⟶ B) (h : B ⟶ X n), g ≫ h = f := sorry

end

end IsGeneratingFamilyApproximation

end CategoryTheory
