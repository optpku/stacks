module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.DifferentialGraded.Module

/-!
# Action of unit sections in differential graded modules

A section of a DG module in one degree acts on every graded piece of the algebra.  This leaf
exposes the resulting degreewise morphism independently of mapping-cone constructions.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.MonoidalCategory
open scoped SheafOfModules.RingedSite.DifferentialGradedAlgebra
open scoped SheafOfModules.RingedSite.DifferentialGradedModule

noncomputable section

universe u v

namespace SheafOfModules.RingedSite.DifferentialGradedModule.UnitSection

section

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat)]
variable [HasWeakSheafify J AddCommGrpCat.{max u v}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{max u v}]
variable {𝒪 : Sheaf J CommRingCat.{max u v}}
variable {𝒜 : DGA(𝒪)} {ℳ N : Mod(𝒜, d)}

/-- The action map generated by a unit section `x : unitModule J 𝒪 ⟶ ℳ k`. -/
noncomputable def action {k : ℤ} (x : unitModule J 𝒪 ⟶ ℳ k) (m : ℤ) :
    𝒜.toComplex.X m ⟶ ℳ.toComplex.X (k + m) :=
  (λ_ (𝒜.toComplex.X m)).inv ≫
    (unitIsoTensorUnit.inv ▷ 𝒜.toComplex.X m) ≫
    (x ▷ 𝒜.toComplex.X m) ≫
    ℳ.smul k m

/-- Formula for the action map generated by a unit section. -/
theorem action_def {k : ℤ} (x : unitModule J 𝒪 ⟶ ℳ k) (m : ℤ) :
    action x m =
      (λ_ (𝒜.toComplex.X m)).inv ≫
        (unitIsoTensorUnit.inv ▷ 𝒜.toComplex.X m) ≫
        (x ▷ 𝒜.toComplex.X m) ≫
        ℳ.smul k m := sorry

/-- Acting by a unit section is natural under postcomposition by a DG-module morphism. -/
theorem action_comp {k : ℤ} (x : unitModule J 𝒪 ⟶ ℳ k)
    (f : ℳ ⟶ N) (m : ℤ) :
    action (x ≫ f.toCochainMap.f k) m =
      action x m ≫ f.toCochainMap.f (k + m) := sorry

end

end SheafOfModules.RingedSite.DifferentialGradedModule.UnitSection
