module

public import ReasLib.LinearAlgebra.Matrix.MinorIdeal.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import ReasLib.RingTheory.MvPowerSeries.Derivation

@[expose] public section

noncomputable section

universe u

namespace MvPowerSeries.Jacobian

/-- The determinantal ideal in a power-series quotient associated to a finite family of
relations and a choice of power-series coordinates. -/
noncomputable def minorIdeal {k : Type u} [Field k] {n m : ℕ}
    (I : Ideal (MvPowerSeries (Fin n) k))
    (e : MvPowerSeries (Fin n) k ≃ₐ[k] MvPowerSeries (Fin n) k)
    (f : Fin m → MvPowerSeries (Fin n) k) (r : ℕ) :
    Ideal (MvPowerSeries (Fin n) k ⧸ I) :=
  Matrix.minorIdeal r fun j i ↦
    Ideal.Quotient.mk I (e (MvPowerSeries.partialDeriv i (e.symm (f j))))

/-- In the standard coordinates, the Jacobian determinantal ideal is computed directly from
the formal partial derivatives of the chosen relations. -/
theorem minorIdeal_refl {k : Type u} [Field k] {n m : ℕ}
    (I : Ideal (MvPowerSeries (Fin n) k))
    (f : Fin m → MvPowerSeries (Fin n) k) (r : ℕ) :
    minorIdeal I (AlgEquiv.refl : MvPowerSeries (Fin n) k ≃ₐ[k]
      MvPowerSeries (Fin n) k) f r =
      Matrix.minorIdeal r fun j i ↦
        Ideal.Quotient.mk I (MvPowerSeries.partialDeriv i (f j)) := sorry

/-- For a quotient of a finite-variable formal power-series ring over a field, the ideal
generated by the `r × r` Jacobian minors is independent of both the finite generating
family of the defining ideal and the regular power-series coordinates. -/
theorem minorIdeal_independent {k : Type u} [Field k] {n m l : ℕ}
    (I : Ideal (MvPowerSeries (Fin n) k))
    (f : Fin m → MvPowerSeries (Fin n) k) (g : Fin l → MvPowerSeries (Fin n) k)
    (hf : Ideal.span (Set.range f) = I) (hg : Ideal.span (Set.range g) = I)
    (e e' : MvPowerSeries (Fin n) k ≃ₐ[k] MvPowerSeries (Fin n) k) (r : ℕ) :
    minorIdeal I e f r = minorIdeal I e' g r := sorry

end MvPowerSeries.Jacobian
