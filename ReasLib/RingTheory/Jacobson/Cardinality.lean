module

public import Mathlib.RingTheory.MvPolynomial
public import Mathlib.RingTheory.Algebraic.Integral
public import Mathlib.RingTheory.Jacobson.Ring
public import Mathlib.RingTheory.TensorProduct.Basic
public import ReasLib.RingTheory.LocalRing.ResidueField.MaximalIdeal
import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Cardinality criteria for Jacobson rings

This file records the residue-field algebraicity and Jacobson-ring consequences of the standard
cardinality argument, both for generated algebras and for scalar extensions.
-/

open Cardinal
open scoped TensorProduct

universe u v w

namespace Algebra.IsAlgebraic

/-- Residue fields at maximal ideals are algebraic when the algebra has a generating set smaller
than the base field. -/
@[stacks 00FU "(1), algebraic residue fields"]
theorem residueField_of_adjoin_eq_top_of_cardinalMk_lt
    {k : Type u} {S : Type w} [Field k] [CommRing S] [Algebra k S]
    (s : Set S) (hs : Algebra.adjoin k s = ⊤)
    (hcard : lift.{max u w} (#s) < lift.{max u w} (#k))
    (m : Ideal S) [m.IsMaximal] :
    Algebra.IsAlgebraic k m.ResidueField := sorry

/-- Maximal-ideal residue fields remain algebraic after a sufficiently large scalar extension. -/
@[stacks 046V "(1), algebraic residue fields after scalar extension"]
theorem residueField_tensorProduct_of_cardinalMk_lt
    {k : Type u} {S : Type v} {K : Type w}
    [Field k] [CommRing S] [Algebra k S] [Field K] [Algebra k K]
    (hcard : Cardinal.lift.{max w v, v} #S < Cardinal.lift.{max w v, w} #K)
    (m : Ideal (K ⊗[k] S)) [m.IsMaximal] :
    Algebra.IsAlgebraic K m.ResidueField := sorry

end Algebra.IsAlgebraic

namespace IsJacobsonRing

/-- An algebra generated by fewer elements than the cardinality of its base field is Jacobson. -/
@[stacks 00FU "(2), Jacobson ring"]
theorem of_adjoin_eq_top_of_cardinalMk_lt
    {k : Type u} {S : Type w} [Field k] [CommRing S] [Algebra k S]
    (s : Set S) (hs : Algebra.adjoin k s = ⊤)
    (hcard : lift.{max u w} (#s) < lift.{max u w} (#k)) :
    IsJacobsonRing S := sorry

/-- A sufficiently large scalar extension is Jacobson. -/
@[stacks 046V "(2), Jacobson scalar extension"]
theorem tensorProduct_of_cardinalMk_lt
    {k : Type u} {S : Type v} {K : Type w}
    [Field k] [CommRing S] [Algebra k S] [Field K] [Algebra k K]
    (hcard : Cardinal.lift.{max w v, v} #S < Cardinal.lift.{max w v, w} #K) :
    IsJacobsonRing (K ⊗[k] S) := sorry

end IsJacobsonRing
