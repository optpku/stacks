module

public import ReasLib.AlgebraicGeometry.ProjectiveSpace.ClosedSubscheme.SmoothPoint
import StacksCheckRecall

@[expose] public section

open CategoryTheory Set TopologicalSpace

universe u

namespace AlgebraicGeometry.ProjectiveSpace.ClosedSubscheme

/- Lemma 53.9.4: if a plane curve over an infinite field has a smooth point and
its homogeneous ideal is generated by `F`, then its smooth locus contains a closed
point whose residue field is a finite separable extension of degree at most
`F.totalDegree`. -/
@[stacks 0CCU] #check
  (AlgebraicGeometry.ProjectiveSpace.ClosedSubscheme.exists_smooth_closedPoint_finrank_le_totalDegree :
    ∀ (k : Type u) [Field k] [Infinite k]
      (Z : (AlgebraicGeometry.ProjectiveSpace.scheme k 2).IdealSheafData),
      (h_componentDim : ∀ C : irreducibleComponents Z.subscheme,
        topologicalKrullDim (C : Set Z.subscheme) = 1) →
      (h_noEmbeddedPoints : Z.subscheme.embeddedPoints = (∅ : Set Z.subscheme)) →
      (F : MvPolynomial (Fin 3) k) →
      (h_generator :
        AlgebraicGeometry.ProjectiveSpace.ClosedSubscheme.coordinateIdeal 2 Z =
          Ideal.span {F}) →
      (h_smooth : ∃ z' : Z.subscheme,
        (Z.subschemeι ≫ AlgebraicGeometry.ProjectiveSpace.toSpec k 2).SmoothAt z') →
      let X : AlgebraicGeometry.SchemeOverField k :=
        CategoryTheory.Over.mk (Z.subschemeι ≫ AlgebraicGeometry.ProjectiveSpace.toSpec k 2)
      ∃ z : X.left, z ∈ closedPoints X.left ∧ X.hom.SmoothAt z ∧
        FiniteDimensional k (X.left.residueField z) ∧
        Algebra.IsSeparable k (X.left.residueField z) ∧
        Module.finrank k (X.left.residueField z) ≤ F.totalDegree)

end AlgebraicGeometry.ProjectiveSpace.ClosedSubscheme
