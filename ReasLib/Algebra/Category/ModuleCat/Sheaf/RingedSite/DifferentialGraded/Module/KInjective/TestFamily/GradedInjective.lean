module

public import Mathlib.Algebra.Homology.ShortComplex.HomologicalComplex
public import Mathlib.CategoryTheory.Preadditive.Injective.LiftingProperties
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.DifferentialGraded.Limits
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.DifferentialGraded.Forget
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.DifferentialGraded.Module.Acyclic
public import ReasLib.CategoryTheory.Functor.Injective

/-!
# Test families for graded injectivity of differential graded modules

The family data consists of acyclic monomorphisms and detects injectivity only after forgetting
the differential.  Acyclicity is stated on the underlying cochain complex, so this layer does
not require the stronger homology-category infrastructure used by K-injectivity.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits
open scoped SheafOfModules.RingedSite.DifferentialGradedAlgebra
open scoped SheafOfModules.RingedSite.DifferentialGradedModule
open scoped ZeroObject

noncomputable section

universe u v w

namespace SheafOfModules.RingedSite.DifferentialGradedModule.Module.KInjective

section


variable {C : Type u} [Category.{v} C]
variable {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat)]
variable [HasWeakSheafify J AddCommGrpCat.{max u v}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{max u v}]
variable {𝒪 : Sheaf J CommRingCat.{max u v}}

/-- A set-indexed family of acyclic monomorphisms whose right lifting condition detects
injectivity after forgetting the differential. -/
@[stacks 0FSS]
structure GradedInjectiveTestFamily (𝒜 : DGA(𝒪)) where
  /-- The set-sized index type. -/
  index : Type w
  /-- The source DG module of each test map. -/
  source : index → Mod(𝒜, d)
  /-- The target DG module of each test map. -/
  target : index → Mod(𝒜, d)
  /-- The acyclic monomorphisms used for testing. -/
  ι : ∀ r, source r ⟶ target r
  /-- Every test map is a monomorphism. -/
  mono_ι (r : index) : Mono (ι r)
  /-- Every test source has acyclic underlying cochain complex. -/
  source_acyclic (r : index) : Module.acyclic 𝒜 (source r)
  /-- Every test target has acyclic underlying cochain complex. -/
  target_acyclic (r : index) : Module.acyclic 𝒜 (target r)
  /-- The right lifting property against the family detects exactly graded injectivity. -/
  detects (I : Mod(𝒜, d)) :
    (forgetToGraded 𝒜).IsInjectiveObj I ↔
      (MorphismProperty.ofHoms ι).rlp (0 : I ⟶ 0)

namespace GradedInjectiveTestFamily

/-- The morphism property generated by the arrows of a graded-injective test family. -/
def arrows {𝒜 : DGA(𝒪)} (T : GradedInjectiveTestFamily 𝒜) :
    MorphismProperty Mod(𝒜, d) :=
  MorphismProperty.ofHoms T.ι

/-- Every indexed test arrow belongs to the generated morphism property. -/
theorem ι_mem {𝒜 : DGA(𝒪)} (T : GradedInjectiveTestFamily 𝒜)
    (r : T.index) : T.arrows (T.ι r) := sorry

/-- Every arrow in a graded-injective test family is a monomorphism. -/
theorem arrows_le_monomorphisms {𝒜 : DGA(𝒪)}
    (T : GradedInjectiveTestFamily 𝒜) :
    T.arrows ≤ MorphismProperty.monomorphisms Mod(𝒜, d) := sorry

/-- Graded injectivity is the right lifting property against the generated test arrows. -/
theorem injective_iff_rlp {𝒜 : DGA(𝒪)} (T : GradedInjectiveTestFamily 𝒜)
    (I : Mod(𝒜, d)) :
    (forgetToGraded 𝒜).IsInjectiveObj I ↔
      T.arrows.rlp (0 : I ⟶ 0) := sorry

/-- Expanded lifting criterion for a graded-injective test family. -/
theorem injective_iff_lifts {𝒜 : DGA(𝒪)} (T : GradedInjectiveTestFamily 𝒜)
    (I : Mod(𝒜, d)) :
    (forgetToGraded 𝒜).IsInjectiveObj I ↔
      ∀ r (f : T.source r ⟶ I),
        ∃ g : T.target r ⟶ I, T.ι r ≫ g = f := sorry

/- A set-sized acyclic test family for graded injectivity exists for every sheaf of
   differential graded algebras. -/
/-- A graded-injective test family exists for every differential graded algebra sheaf. -/
@[stacks 0FSS "existence"]
theorem nonempty (𝒜 : DGA(𝒪)) :
    Nonempty (GradedInjectiveTestFamily.{u, v, max (u + 1) (v + 1)} 𝒜) := sorry

end GradedInjectiveTestFamily

end


end SheafOfModules.RingedSite.DifferentialGradedModule.Module.KInjective
