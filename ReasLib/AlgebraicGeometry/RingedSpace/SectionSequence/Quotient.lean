module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Free
public import ReasLib.AlgebraicGeometry.RingedSpace.Module.GlobalSections.Linear

/-!
# Quotients by initial families of global sections

A finite family of global sections of the structure sheaf determines, at each index, the quotient
by the subsheaf generated by the preceding sections.  The section at that index acts on the
quotient by multiplication.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits
open Opposite
open TopologicalSpace

noncomputable section

universe u

namespace AlgebraicGeometry.RingedSpace.SectionSequence

variable {X : RingedSpace.{u}} {r : ℕ}

/-- The family consisting of the sections strictly preceding a fixed index. -/
def initialSegment
    (f : Fin r → (SheafOfModules.unit X.ringCatSheaf : X.Modules).sections)
    (i : Fin r) : Fin i → (SheafOfModules.unit X.ringCatSheaf : X.Modules).sections :=
  fun j ↦ f ⟨j, j.isLt.trans i.isLt⟩

/-- The morphism from the finite free module sheaf classified by the sections preceding an
index. -/
private noncomputable def initialSegmentMap
    (f : Fin r → (SheafOfModules.unit X.ringCatSheaf : X.Modules).sections)
    (i : Fin r) :
    (SheafOfModules.free (R := X.ringCatSheaf) (ULift.{u} (Fin i)) : X.Modules) ⟶
      (SheafOfModules.unit X.ringCatSheaf : X.Modules) :=
  (SheafOfModules.unit X.ringCatSheaf : X.Modules).freeHomEquiv.symm
    (fun j : ULift.{u} (Fin i) ↦ initialSegment f i j.down)

/-- The structure module modulo the subsheaf generated by the sections preceding an index. -/
noncomputable def quotientByPrev
    (f : Fin r → (SheafOfModules.unit X.ringCatSheaf : X.Modules).sections)
    (i : Fin r) : X.Modules :=
  cokernel <|
    (SheafOfModules.unit X.ringCatSheaf : X.Modules).freeHomEquiv.symm
      (fun j : ULift.{u} (Fin i) ↦ initialSegment f i j.down)

/-- Multiplication by a section on the structure module modulo the subsheaf generated by all
preceding sections. -/
noncomputable def quotientMulByPrev
    (f : Fin r → (SheafOfModules.unit X.ringCatSheaf : X.Modules).sections)
    (i : Fin r) : quotientByPrev f i ⟶ quotientByPrev f i :=
  globalSectionMul ((f i).1 (op (⊤ : Opens X))) (quotientByPrev f i)

end AlgebraicGeometry.RingedSpace.SectionSequence
