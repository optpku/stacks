module

public import Mathlib.AlgebraicGeometry.FunctionField
public import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
public import Mathlib.Data.Int.Cast.Lemmas
public import Mathlib.Data.ZMod.Basic
public import Mathlib.GroupTheory.QuotientGroup.Defs
public import Mathlib.Topology.JacobsonSpace
public import ReasLib.AlgebraicGeometry.Scheme.Divisor.ClassGroup
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.AffineLineInvolution.Geometry

/-!
# Class group of the affine-line involution space

This module records the ramified principal-divisor map on `Div(𝔸¹_k)` induced by
the universal homeomorphism from the involution quotient
`X = 𝔸¹_k / {t ∼ -t | t ≠ 0}`, together with the resulting class group.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Limits
open AlgebraicGeometry.Scheme
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.AffineLineInvolution

/-- The principal ideal generated by the standard coordinate of `𝔸¹_k`. -/
def originIdeal (k : Type u) [Field k] : Ideal Γ((cover k).left, ⊤) :=
  Ideal.span {coord k}

/-- `originIdeal` is the principal ideal generated by the affine-line coordinate. -/
theorem originIdeal_eq_span (k : Type u) [Field k] :
    originIdeal k = Ideal.span {coord k} := sorry

/-- The ideal sheaf on `𝔸¹_k` cut out by the coordinate `t`. -/
def originIdealSheaf (k : Type u) [Field k] : (cover k).left.IdealSheafData :=
  IdealSheafData.ofIdealTop (originIdeal k)

/-- The closed subscheme cut out by the origin ideal is integral. -/
@[instance]
theorem isIntegral_originIdealSheaf_subscheme (k : Type u) [Field k] :
    AlgebraicGeometry.IsIntegral (originIdealSheaf k).subscheme := sorry

/-- The support of the origin ideal sheaf is irreducible. -/
theorem isIrreducible_originIdealSheaf_support (k : Type u) [Field k] :
    IsIrreducible ((originIdealSheaf k).support : Set (cover k).left) := sorry

/-- The support of the origin ideal sheaf has coheight one. -/
theorem coheight_originIdealSheaf_support (k : Type u) [Field k] :
    Order.coheight
      (⟨((originIdealSheaf k).support : Set (cover k).left),
          isIrreducible_originIdealSheaf_support k,
          (originIdealSheaf k).support.isClosed⟩ :
        TopologicalSpace.IrreducibleCloseds (cover k).left) = 1 := sorry

/-- The prime divisor of `𝔸¹_k` cut out by the origin, identified with the unique
closed point of `X` lying over `0`. -/
def originPrimeDivisor (k : Type u) [Field k] :
    AlgebraicGeometry.PrimeDivisor (cover k).left :=
  AlgebraicGeometry.PrimeDivisor.ofIdeal (cover k).left (originIdealSheaf k)
    (isIntegral_originIdealSheaf_subscheme k)
    (isIrreducible_originIdealSheaf_support k)
    (coheight_originIdealSheaf_support k)

/-- The ideal sheaf of the origin prime divisor is the coordinate ideal sheaf. -/
theorem originPrimeDivisor_ideal (k : Type u) [Field k] :
    (originPrimeDivisor k).ideal = originIdealSheaf k := sorry

/-- The generic point of the origin prime divisor is the image of the zero section
`originToCover : Spec k ⟶ 𝔸¹_k`. -/
theorem originPrimeDivisor_genericPoint_range_originToCover (k : Type u) [Field k] :
    Set.range (originToCover k).left.base = {(originPrimeDivisor k).genericPoint} :=
  sorry

/-- The origin prime divisor is a closed point of `𝔸¹_k`. -/
theorem originPrimeDivisor_genericPoint_mem_closedPoints (k : Type u) [Field k] :
    (originPrimeDivisor k).genericPoint ∈ closedPoints (cover k).left :=
  sorry

/-- On the affine line, prime divisors are exactly the closed points. -/
theorem closedPoint_iff_exists_primeDivisor (k : Type u) [Field k]
    (x : (cover k).left) :
    x ∈ closedPoints (cover k).left ↔
      ∃ Z : AlgebraicGeometry.PrimeDivisor (cover k).left, Z.genericPoint = x :=
  sorry

/-- The Weil divisor `[x]` of the unique closed point of `X` over `0`. -/
abbrev originWeilDivisor (k : Type u) [Field k] :
    AlgebraicGeometry.WeilDivisor (cover k).left :=
  WeilDivisor.single (originPrimeDivisor k)

/-- The origin Weil divisor has coefficient `1` along the origin prime divisor. -/
theorem originWeilDivisor_coeff_self (k : Type u) [Field k] :
    (originWeilDivisor k).coeff (originPrimeDivisor k) = 1 := sorry

/-- Coefficients of a Weil divisor after doubling the origin coefficient. -/
def doubleOriginCoeff (k : Type u) [Field k]
    (D : AlgebraicGeometry.WeilDivisor (cover k).left)
    (Z : AlgebraicGeometry.PrimeDivisor (cover k).left) : ℤ :=
  @ite ℤ (Z = originPrimeDivisor k)
    (Classical.propDecidable (Z = originPrimeDivisor k))
    (2 * D.coeff Z) (D.coeff Z)

/-- Doubling the origin coefficient preserves local finiteness. -/
theorem locallyFinite_doubleOriginCoeff (k : Type u) [Field k]
    (D : AlgebraicGeometry.WeilDivisor (cover k).left) :
    LocallyFinite fun Z : AlgebraicGeometry.PrimeDivisor (cover k).left ↦
      if doubleOriginCoeff k D Z = 0 then (∅ : Set (cover k).left)
      else (Z.support : Set (cover k).left) := sorry

/-- The ramification map on `Div(𝔸¹_k)` which doubles the coefficient of the origin. -/
def doubleOrigin (k : Type u) [Field k]
    (D : AlgebraicGeometry.WeilDivisor (cover k).left) :
    AlgebraicGeometry.WeilDivisor (cover k).left :=
  AlgebraicGeometry.WeilDivisor.ofCoeff (cover k).left (doubleOriginCoeff k D)
    (locallyFinite_doubleOriginCoeff k D)

/-- Coefficients of `doubleOrigin` recover `doubleOriginCoeff`. -/
theorem doubleOrigin_coeff (k : Type u) [Field k]
    (D : AlgebraicGeometry.WeilDivisor (cover k).left)
    (Z : AlgebraicGeometry.PrimeDivisor (cover k).left) :
    (doubleOrigin k D).coeff Z = doubleOriginCoeff k D Z := sorry

/-- At the origin, `doubleOrigin` doubles the coefficient. -/
theorem doubleOrigin_coeff_origin (k : Type u) [Field k]
    (D : AlgebraicGeometry.WeilDivisor (cover k).left) :
    (doubleOrigin k D).coeff (originPrimeDivisor k) =
      2 * D.coeff (originPrimeDivisor k) := sorry

/-- Away from the origin, `doubleOrigin` preserves coefficients. -/
theorem doubleOrigin_coeff_of_ne (k : Type u) [Field k]
    (D : AlgebraicGeometry.WeilDivisor (cover k).left)
    {Z : AlgebraicGeometry.PrimeDivisor (cover k).left}
    (hZ : Z ≠ originPrimeDivisor k) :
    (doubleOrigin k D).coeff Z = D.coeff Z := sorry

/-- Doubling the origin coefficient sends the zero divisor to zero. -/
theorem doubleOrigin_zero (k : Type u) [Field k] :
    doubleOrigin k 0 = 0 := sorry

/-- Doubling the origin coefficient preserves addition of divisors. -/
theorem doubleOrigin_add (k : Type u) [Field k]
    (D E : AlgebraicGeometry.WeilDivisor (cover k).left) :
    doubleOrigin k (D + E) = doubleOrigin k D + doubleOrigin k E := sorry

/-- The additive homomorphism which doubles the origin coefficient. -/
def doubleOriginHom (k : Type u) [Field k] :
    AlgebraicGeometry.WeilDivisor (cover k).left →+
      AlgebraicGeometry.WeilDivisor (cover k).left where
  toFun := doubleOrigin k
  map_zero' := doubleOrigin_zero k
  map_add' := doubleOrigin_add k

/-- The image of the affine-line coordinate in the function field is nonzero. -/
theorem coordinate_ne_zero (k : Type u) [Field k] :
    (cover k).left.germToFunctionField ⊤ (coord k) ≠ 0 := sorry

/-- The target affine-line coordinate as a function-field unit; its atlas pullback is induced
by the squaring morphism. -/
def coordinate (k : Type u) [Field k] : (cover k).left.functionFieldˣ :=
  Units.mk0 ((cover k).left.germToFunctionField ⊤ (coord k)) (coordinate_ne_zero k)

/-- The target-coordinate unit is the germ of the affine-line coordinate. -/
theorem coordinate_spec (k : Type u) [Field k] :
    (coordinate k).val = (cover k).left.germToFunctionField ⊤ (coord k) := sorry

/-- The principal divisor map of `X`, obtained by doubling the origin coefficient of the
principal divisor on `𝔸¹_k`. -/
def principalWeilDivisor (k : Type u) [Field k] (f : (cover k).left.functionFieldˣ) :
    AlgebraicGeometry.WeilDivisor (cover k).left :=
  doubleOrigin k (Scheme.principalWeilDivisor (cover k).left f)

/-- The coefficient of `principalWeilDivisor` at a prime divisor. -/
theorem principalWeilDivisor_coeff (k : Type u) [Field k]
    (f : (cover k).left.functionFieldˣ)
    (Z : AlgebraicGeometry.PrimeDivisor (cover k).left) :
    (principalWeilDivisor k f).coeff Z =
      doubleOriginCoeff k (Scheme.principalWeilDivisor (cover k).left f) Z :=
  sorry

/-- Every prime divisor on the target affine line has a prime divisor above it under squaring. -/
theorem primeDivisor_exists_above (k : Type u) [Field k] [NeZero (2 : k)]
    (W : AlgebraicGeometry.PrimeDivisor (cover k).left) :
    ∃ Z : AlgebraicGeometry.PrimeDivisor (cover k).left,
      (squareOver k).left Z.genericPoint = W.genericPoint := sorry

/-- The presented principal-divisor coefficient equals the order of its rational-function
pullback at every prime divisor of the étale atlas lying above the target divisor. -/
theorem principalWeilDivisor_atlas_coeff (k : Type u) [Field k] [NeZero (2 : k)]
    (f : (cover k).left.functionFieldˣ)
    (Z W : AlgebraicGeometry.PrimeDivisor (cover k).left)
    (hZW : (squareOver k).left Z.genericPoint = W.genericPoint) :
    (principalWeilDivisor k f).coeff W =
      (cover k).left.ord (squareFunctionFieldMap k (f : (cover k).left.functionField))
        Z.genericPoint := sorry

/-- The subgroup of principal Weil divisors on `X`, as the image of `Prin(𝔸¹_k)` under
doubling at the origin. -/
def principalDivisors (k : Type u) [Field k] :
    AddSubgroup (AlgebraicGeometry.WeilDivisor (cover k).left) :=
  AddSubgroup.map (doubleOriginHom k) (principalWeilDivisors (cover k).left)

/-- Membership in `principalDivisors` is the image of a principal divisor under `doubleOrigin`. -/
theorem mem_principalDivisors_iff (k : Type u) [Field k]
    (D : AlgebraicGeometry.WeilDivisor (cover k).left) :
    D ∈ principalDivisors k ↔
      ∃ E ∈ principalWeilDivisors (cover k).left, doubleOrigin k E = D :=
  sorry

/-- A divisor is principal precisely when its coefficients are the atlas orders of the
pullback of one rational-function unit on the target affine line. -/
theorem principalDivisors_atlas_iff (k : Type u) [Field k] [NeZero (2 : k)]
    (D : AlgebraicGeometry.WeilDivisor (cover k).left) :
    D ∈ principalDivisors k ↔
      ∃ f : (cover k).left.functionFieldˣ,
        ∀ Z W : AlgebraicGeometry.PrimeDivisor (cover k).left,
          (squareOver k).left Z.genericPoint = W.genericPoint →
            D.coeff W =
              (cover k).left.ord
                (squareFunctionFieldMap k (f : (cover k).left.functionField))
                Z.genericPoint := sorry

/-- The Weil divisor class group of the affine-line involution space. -/
abbrev classGroup (k : Type u) [Field k] : Type u :=
  AlgebraicGeometry.WeilDivisor (cover k).left ⧸ principalDivisors k

/-- The canonical quotient map from Weil divisors to the class group of `X`. -/
abbrev classGroupMk (k : Type u) [Field k] :
    AlgebraicGeometry.WeilDivisor (cover k).left →+ classGroup k :=
  QuotientAddGroup.mk' (principalDivisors k)

/-- The homomorphism recording the origin coefficient of a Weil divisor. -/
def originCoeffHom (k : Type u) [Field k] :
    AlgebraicGeometry.WeilDivisor (cover k).left →+ ℤ where
  toFun D := D.coeff (originPrimeDivisor k)
  map_zero' := WeilDivisor.coeff_zero (cover k).left (originPrimeDivisor k)
  map_add' D E := WeilDivisor.coeff_add (cover k).left D E (originPrimeDivisor k)

/-- The origin coefficient, reduced modulo `2`. -/
def originCoeffModTwoHom (k : Type u) [Field k] :
    AlgebraicGeometry.WeilDivisor (cover k).left →+ ZMod 2 :=
  (Int.castAddHom (ZMod 2)).comp (originCoeffHom k)

/-- Principal divisors of `X` lie in the kernel of the origin-coefficient map modulo `2`. -/
theorem originCoeffModTwoHom_ker (k : Type u) [Field k] :
    principalDivisors k ≤ (originCoeffModTwoHom k).ker := sorry

/-- The descended origin-coefficient map on the class group of `X`. -/
def classGroupHomZMod (k : Type u) [Field k] : classGroup k →+ ZMod 2 :=
  QuotientAddGroup.lift (principalDivisors k) (originCoeffModTwoHom k)
    (originCoeffModTwoHom_ker k)

/-- Every prime divisor away from the origin has zero class in the involution quotient. -/
theorem class_eq_zero_of_ne_origin (k : Type u) [Field k] [NeZero (2 : k)]
    {Z : AlgebraicGeometry.PrimeDivisor (cover k).left}
    (hZ : Z ≠ originPrimeDivisor k) :
    classGroupMk k (WeilDivisor.single Z) = 0 := sorry

/-- The principal divisor of the target coordinate is twice the origin divisor. -/
theorem principalWeilDivisor_coordinate (k : Type u) [Field k] [NeZero (2 : k)] :
    principalWeilDivisor k (coordinate k) = 2 • originWeilDivisor k := sorry

/-- Taking the representative multiple of the origin class inverts the class-to-residue map. -/
theorem classGroupHomZMod_leftInverse (k : Type u) [Field k] [NeZero (2 : k)] :
    Function.LeftInverse
      (fun n : ZMod 2 ↦ classGroupMk k (n.val • originWeilDivisor k))
      (classGroupHomZMod k) := sorry

/-- The origin coefficient modulo two recovers each residue from its origin-class representative. -/
theorem classGroupHomZMod_rightInverse (k : Type u) [Field k] [NeZero (2 : k)] :
    Function.RightInverse
      (fun n : ZMod 2 ↦ classGroupMk k (n.val • originWeilDivisor k))
      (classGroupHomZMod k) := sorry

/-- The identification `Cl(X) ≃ ℤ/2ℤ` sending the class of `[x]` to `1`. -/
def classGroupEquivZMod (k : Type u) [Field k] [NeZero (2 : k)] :
    classGroup k ≃+ ZMod 2 where
  toFun := classGroupHomZMod k
  invFun n := classGroupMk k (n.val • originWeilDivisor k)
  left_inv := classGroupHomZMod_leftInverse k
  right_inv := classGroupHomZMod_rightInverse k
  map_add' := (classGroupHomZMod k).map_add

/-- The class-group equivalence evaluates by the origin coefficient modulo `2`. -/
theorem classGroupEquivZMod_apply (k : Type u) [Field k] [NeZero (2 : k)]
    (D : AlgebraicGeometry.WeilDivisor (cover k).left) :
    classGroupEquivZMod k (classGroupMk k D) =
      originCoeffModTwoHom k D := sorry

/-- The class of the origin prime divisor is the generator `1` of `ℤ/2ℤ`. -/
theorem classGroupEquivZMod_origin (k : Type u) [Field k] [NeZero (2 : k)] :
    classGroupEquivZMod k (classGroupMk k (originWeilDivisor k)) = 1 := sorry

end AlgebraicGeometry.AlgebraicSpace.AffineLineInvolution
