module

public import ReasLib.AlgebraicGeometry.Scheme.Divisor.ComplexChart.Modification
public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.Rees.Blowup
public import ReasLib.RingTheory.ReesAlgebra.BlowupChart

/-!
# Chartwise graph modification from the given complex

For a divisor-complex chart, form the projective spectrum of the Rees algebra
of its actual product ideal. The chart scheme and its map are constructed data.
No global good-triple modification, eta localization, or localized Chern class
is selected here. Covering and gluing these charts remain separate obligations.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme.DivisorComplexChart

variable {Y : Scheme.{u}} {D : Y.IdealSheafData}
  {M : RingedSpace.ModuleDerived Y.toRingedSpace} (C : DivisorComplexChart D M)

/-- The center used by the producer is the actual product of the model's degreewise ideals. -/
theorem graphProductIdeal_eq : C.productIdeal = ∏ᶠ i : ℤ, C.ideal i := by
  rfl

/-- The presentation defining each factor uses the divisor equation and the actual model differential. -/
theorem graphPresentation_apply (i : ℤ) (x : C.model.X i) :
    CochainComplex.BerthelotOgus.Int.etaPresentationMap C.generator C.model i x =
      (C.generator • x, C.model.d i (i + 1) x) := by
  rfl

/-- The local graph modification is the actual Rees projective spectrum. -/
def graphScheme : Scheme.{u} :=
  Proj (ReesAlgebra.Grading.grade C.productIdeal)

/-- The structural map of the local graph modification to its affine chart. -/
def graphToChart : C.graphScheme ⟶ (C.U : Y.Opens).toScheme :=
  ReesProj.toSpec C.productIdeal ≫ C.U.2.isoSpec.inv

/-- The local graph modification maps to the original scheme through its chart. -/
def graphHom : C.graphScheme ⟶ Y :=
  C.graphToChart ≫ (C.U : Y.Opens).ι

/-- The graph map is the Rees projection followed by the canonical affine-chart map. -/
theorem graphHom_eq :
    C.graphHom = ReesProj.toSpec C.productIdeal ≫ C.U.2.fromSpec := by
  simp only [graphHom, graphToChart, IsAffineOpen.fromSpec, Category.assoc]
  rfl

/-- The original affine coordinate map recovers the Rees projection. -/
theorem graphToChart_isoSpec :
    C.graphToChart ≫ C.U.2.isoSpec.hom = ReesProj.toSpec C.productIdeal := by
  simp [graphToChart]

/-- The degree-one Rees generator attached to a member of the actual product ideal. -/
def graphGenerator (x : C.productIdeal) : reesAlgebra C.productIdeal :=
  ReesAlgebra.Grading.degreeOne C.productIdeal x

/-- The generator has precisely the polynomial coefficient supplied by the center element. -/
theorem graphGenerator_polynomial (x : C.productIdeal) :
    (C.graphGenerator x).1 = Polynomial.monomial 1 x.1 := by
  rfl

/-- The named degree-one element lies in the first Rees piece, by its explicit coefficient. -/
theorem graphGenerator_mem_grade (x : C.productIdeal) :
    C.graphGenerator x ∈ ReesAlgebra.Grading.grade C.productIdeal 1 := by
  refine ⟨⟨x.1, ?_⟩, ?_⟩
  · simpa only [pow_one] using x.2
  · apply Subtype.ext
    rfl

/-- The local Rees algebra is generated by the degree-one elements of the actual product ideal. -/
theorem graphRees_generated :
    Algebra.adjoin Γ(Y, C.U)
      (Submodule.map (Polynomial.monomial 1 : Γ(Y, C.U) →ₗ[Γ(Y, C.U)] Polynomial Γ(Y, C.U))
        C.productIdeal : Set (Polynomial Γ(Y, C.U))) = reesAlgebra C.productIdeal := by
  exact adjoin_monomial_eq_reesAlgebra C.productIdeal

/-- The homogeneous basic chart indexed by a product-ideal generator. -/
def graphAffineScheme (a : C.productIdeal) : Scheme.{u} :=
  Spec (.of (affineBlowupChart C.productIdeal a))

/-- The canonical open chart inclusion into the actual Rees projective spectrum. -/
def graphAffineInclusion (a : C.productIdeal) : C.graphAffineScheme a ⟶ C.graphScheme :=
  Proj.awayι (ReesAlgebra.Grading.grade C.productIdeal)
    (C.graphGenerator a) (C.graphGenerator_mem_grade a) Nat.zero_lt_one

/-- The affine graph chart lies over the coefficient scheme by the degree-zero ring map. -/
def graphAffineToZero (a : C.productIdeal) :
    C.graphAffineScheme a ⟶ Spec (.of (ReesAlgebra.Grading.grade C.productIdeal 0)) :=
  Spec.map (CommRingCat.ofHom
    (HomogeneousLocalization.fromZeroRingHom (ReesAlgebra.Grading.grade C.productIdeal)
      (Submonoid.powers (C.graphGenerator a))))

/-- The affine-chart inclusion commutes with the projective structural projection. -/
theorem graphAffineInclusion_toSpecZero (a : C.productIdeal) :
    C.graphAffineInclusion a ≫ Proj.toSpecZero (ReesAlgebra.Grading.grade C.productIdeal) =
      C.graphAffineToZero a := by
  exact Proj.awayι_toSpecZero _ _ _ _

/-- The affine graph chart map to the original scheme uses only specified structural maps. -/
def graphAffineHom (a : C.productIdeal) : C.graphAffineScheme a ⟶ Y :=
  C.graphAffineToZero a ≫ (ReesProj.degreeZeroSpecIso C.productIdeal).hom ≫ C.U.2.fromSpec

/-- The affine and projective maps to the original scheme form a commuting triangle. -/
theorem graphAffineInclusion_hom (a : C.productIdeal) :
    C.graphAffineInclusion a ≫ C.graphHom = C.graphAffineHom a := by
  rw [graphHom_eq]
  change C.graphAffineInclusion a ≫
    (Proj.toSpecZero (ReesAlgebra.Grading.grade C.productIdeal) ≫
      (ReesProj.degreeZeroSpecIso C.productIdeal).hom) ≫ C.U.2.fromSpec = _
  rw [← Category.assoc (C.graphAffineInclusion a),
    ← Category.assoc (C.graphAffineInclusion a), graphAffineInclusion_toSpecZero]
  rfl

/-- The affine-chart generator is the homogeneous fraction with the prescribed numerator. -/
def graphFraction (a x : C.productIdeal) : affineBlowupChart C.productIdeal a :=
  AffineBlowupChart.basicFraction C.productIdeal a x

/-- The affine graph fraction is constructed with numerator `x t` and denominator `a t`. -/
theorem graphFraction_eq (a x : C.productIdeal) :
    C.graphFraction a x =
      HomogeneousLocalization.Away.mk (ReesAlgebra.Grading.grade C.productIdeal)
        (ReesAlgebra.Grading.degreeOne_mem C.productIdeal a) 1
        (C.graphGenerator x) (ReesAlgebra.Grading.degreeOne_mem C.productIdeal x) := by
  rfl

variable {Y' : Scheme.{u}} {D' : Y'.IdealSheafData}
  {M' : RingedSpace.ModuleDerived Y'.toRingedSpace} (C' : DivisorComplexChart D' M')

/-- Mapping coefficients carries each power of the actual center into its target power. -/
theorem graphReesMap_mem (f : Γ(Y, C.U) →+* Γ(Y', C'.U))
    (h : C.productIdeal ≤ Ideal.comap f C'.productIdeal) (x : reesAlgebra C.productIdeal) :
    Polynomial.map f x.1 ∈ reesAlgebra C'.productIdeal := by
  intro n
  rw [Polynomial.coeff_map]
  have mapped : Ideal.map f (C.productIdeal ^ n) ≤ C'.productIdeal ^ n := by
    rw [Ideal.map_pow]
    exact pow_le_pow_left' (Ideal.map_le_iff_le_comap.mpr h) n
  exact mapped (Ideal.mem_map_of_mem f (x.2 n))

/-- The actual coefficient map between two chart Rees algebras; its only side condition
is containment of the specified center ideals. -/
def graphReesMap (f : Γ(Y, C.U) →+* Γ(Y', C'.U))
    (h : C.productIdeal ≤ Ideal.comap f C'.productIdeal) :
    reesAlgebra C.productIdeal →+* reesAlgebra C'.productIdeal :=
  RingHom.codRestrict
    ((Polynomial.mapRingHom f).comp (reesAlgebra C.productIdeal).toSubring.subtype)
    (reesAlgebra C'.productIdeal).toSubring (C.graphReesMap_mem C' f h)

/-- Rees transitions act by the original coordinate homomorphism on every coefficient. -/
theorem graphReesMap_coeff (f : Γ(Y, C.U) →+* Γ(Y', C'.U))
    (h : C.productIdeal ≤ Ideal.comap f C'.productIdeal) (x : reesAlgebra C.productIdeal) (n : ℕ) :
    ((C.graphReesMap C' f h x).1).coeff n = f (x.1.coeff n) := by
  exact Polynomial.coeff_map f n

/-- A Rees transition sends `x t` to the degree-one generator with coefficient `f x`. -/
theorem graphReesMap_generator (f : Γ(Y, C.U) →+* Γ(Y', C'.U))
    (h : C.productIdeal ≤ Ideal.comap f C'.productIdeal) (x : C.productIdeal) :
    C.graphReesMap C' f h (C.graphGenerator x) =
      C'.graphGenerator ⟨f x.1, h x.2⟩ := by
  apply Subtype.ext
  exact Polynomial.map_monomial f

/-- The coordinate identity induces the identity on the chart Rees algebra. -/
theorem graphReesMap_id :
    C.graphReesMap C (RingHom.id _) (by intro x hx; exact hx) = RingHom.id _ := by
  apply RingHom.ext
  intro x
  apply Subtype.ext
  exact Polynomial.map_id

variable {Y'' : Scheme.{u}} {D'' : Y''.IdealSheafData}
  {M'' : RingedSpace.ModuleDerived Y''.toRingedSpace} (C'' : DivisorComplexChart D'' M'')

/-- Coordinate changes compose on the nose on every Rees polynomial. -/
theorem graphReesMap_comp (f : Γ(Y, C.U) →+* Γ(Y', C'.U))
    (g : Γ(Y', C'.U) →+* Γ(Y'', C''.U))
    (hf : C.productIdeal ≤ Ideal.comap f C'.productIdeal)
    (hg : C'.productIdeal ≤ Ideal.comap g C''.productIdeal) :
    (C'.graphReesMap C'' g hg).comp (C.graphReesMap C' f hf) =
      C.graphReesMap C'' (g.comp f) (by intro x hx; exact hg (hf hx)) := by
  apply RingHom.ext
  intro x
  apply Subtype.ext
  exact Polynomial.map_map f g x.1

end AlgebraicGeometry.Scheme.DivisorComplexChart

namespace AlgebraicGeometry.Scheme

variable {X Y : Scheme.{u}} (E : RingedSpace.ModuleDerived X.toRingedSpace)
  (p : Y ⟶ X) (D : Y.IdealSheafData)

/-- All valid local coordinate charts of the pullback of the given original complex.
This index does not select a chart or assume that any chart is a result. -/
abbrev graphChartIndex :=
  DivisorComplexChart D ((RingedSpace.modulePullbackDerived p.toShHom).obj E)

/-- The local graph object over the original input `E`, at the specified coordinate chart. -/
def graphChartScheme (C : graphChartIndex E p D) : Scheme.{u} :=
  C.graphScheme

/-- The local graph morphism to the space bearing the divisor. -/
def graphChartHom (C : graphChartIndex E p D) : graphChartScheme E p D C ⟶ Y :=
  C.graphHom

/-- The local graph morphism to the original base of `E`. -/
def graphChartToOriginal (C : graphChartIndex E p D) : graphChartScheme E p D C ⟶ X :=
  graphChartHom E p D C ≫ p

/-- The map to the original base is the composite of the constructed modification map and `p`. -/
theorem graphChartToOriginal_eq (C : graphChartIndex E p D) :
    graphChartToOriginal E p D C = C.graphToChart ≫ (C.U : Y.Opens).ι ≫ p := by
  exact Category.assoc _ _ _

end AlgebraicGeometry.Scheme
