module

public import ReasLib.RingTheory.Extension.Presentation.Jacobian.Fin
public import ReasLib.RingTheory.Smooth.Standard.Presentation.Selected
import Mathlib.Tactic.CrossRefAttribute

/-!
# Initial-coordinate standard data in a finite presentation

This leaf retains the `Fin`-indexed initial-coordinate form used by the source
while bridging it to the embedding-indexed presentation API.
-/

@[expose] public section

open scoped BigOperators

universe u v

namespace Algebra.Presentation

variable {R : Type u} {A : Type v} [CommRing R] [CommRing A] [Algebra R A]
variable {n m c : ℕ}

/-- The ideal generated by the first `c` relations of a finite presentation. -/
@[stacks 07C9 "leading relation ideal"]
noncomputable def leadingRelationIdeal
    (P : Presentation R A (Fin n) (Fin m)) (hc : c ≤ m) : Ideal P.Ring :=
  P.relationIdeal (Set.range (Fin.castLEEmb hc))

/-- The source-facing tail condition for the first `c` selected relations. -/
@[stacks 07C9 "elementary-standard tail relation condition",
  stacks 07ES "strictly-standard tail relation condition"]
def tailRelationCondition
    (P : Presentation R A (Fin n) (Fin m)) (a : A) (hcₘ : c ≤ m) : Prop :=
  P.relationCondition a (Set.range (Fin.castLEEmb hcₘ))

/-- The initial-relation condition can be checked on the distinguished section
and only on the complementary tail of relations. -/
@[stacks 07C9 "tail relation condition on the distinguished section",
  stacks 07ES "strictly-standard tail condition on the distinguished section"]
theorem tailRelationCondition_iff_sigma
    (P : Presentation R A (Fin n) (Fin m)) (a : A) (hcₘ : c ≤ m) :
    P.tailRelationCondition a hcₘ ↔
      ∀ j : Fin (m - c),
        P.σ a * P.relation (Fin.natAdd_castLEEmb (Nat.sub_le m c) j) ∈
          P.leadingRelationIdeal hcₘ + P.ker ^ 2 := sorry

/-- The presentation-specific, initial-coordinate witness that `a` is
elementary standard. -/
@[stacks 07C7 "presentation-level elementary standard elements"]
def IsElementaryStandard
    (P : Presentation R A (Fin n) (Fin m)) (a : A) : Prop :=
  ∃ (c : ℕ) (hcₙ : c ≤ n) (hcₘ : c ≤ m) (a' : A),
    a = a' * algebraMap P.Ring A (P.leadingJacobianDet hcₙ hcₘ) ∧
      P.tailRelationCondition a hcₘ

/-- The presentation-specific, initial-coordinate witness that `a` is
strictly standard. -/
@[stacks 07C7 "presentation-level strictly standard elements"]
def IsStrictlyStandard
    (P : Presentation R A (Fin n) (Fin m)) (a : A) : Prop :=
  ∃ (c : ℕ) (hcₘ : c ≤ m) (aI : Set.powersetCard (Fin n) c → A),
    a = ∑ I : Set.powersetCard (Fin n) c,
        aI I * algebraMap P.Ring A
          (P.jacobianColumnMinor (Fin.castLEEmb hcₘ) I) ∧
      P.tailRelationCondition a hcₘ

/-- A source-facing elementary-standard witness yields generic fixed-minor
data in the same presentation. -/
theorem IsElementaryStandard.exists_isElementaryFor
    {P : Presentation R A (Fin n) (Fin m)} {a : A}
    (h : P.IsElementaryStandard a) :
    ∃ (c : ℕ) (hcₙ : c ≤ n) (hcₘ : c ≤ m),
      P.IsElementaryFor a (Fin.castLEEmb hcₙ) (Fin.castLEEmb hcₘ) := sorry

/-- A source-facing strictly-standard witness yields generic selected-row
strict data in the same presentation. -/
theorem IsStrictlyStandard.exists_isStrictlyFor
    {P : Presentation R A (Fin n) (Fin m)} {a : A}
    (h : P.IsStrictlyStandard a) :
    ∃ (c : ℕ) (hcₘ : c ≤ m),
      P.IsStrictlyFor a (Fin.castLEEmb hcₘ) := sorry

/-- Every presentation-level elementary-standard witness gives a strictly
standard witness in the same presentation. -/
@[stacks 07EZ "elementary standard implies strictly standard"]
theorem IsElementaryStandard.isStrictlyStandard
    {P : Presentation R A (Fin n) (Fin m)} {a : A}
    (h : P.IsElementaryStandard a) : P.IsStrictlyStandard a := sorry

end Algebra.Presentation
