module

public import ReasLib.CategoryTheory.Fibered.InheritedPrecoverage.Projection
public import ReasLib.CategoryTheory.Fibered.InheritedTopology
public import ReasLib.CategoryTheory.Sites.Topos.Cocontinuous
import Mathlib.Tactic.CrossRefAttribute

/-!
# Projection from an inherited topology

This file passes the precoverage-first projection API to generated Grothendieck topologies.
The general owner uses an arbitrary precoverage; the `Functor.inheritedTopology` namespace
records the canonical specialization to `J.toPrecoverage`.
-/

@[expose] public section

universe uC vC uS vS

namespace CategoryTheory

namespace Precoverage.StronglyCartesianLift.Projection

variable {C : Type uC} [Category.{vC} C]
variable {S : Type uS} [Category.{vS} S]

/-- A fibred projection is continuous from the topology generated by strongly-cartesian lifts
of `P` to the topology generated by `P`. -/
@[stacks 0CN0 "continuity of a strongly-cartesian inherited topology"]
instance isContinuous
    (P : Precoverage C) (p : S ⥤ C)
    [P.IsStableUnderBaseChange] [P.HasPullbacks] [p.IsFibered] :
    p.IsContinuous (P.stronglyCartesianTopology p) P.toGrothendieck := sorry

/-- A fibred projection is cocontinuous from the topology generated by strongly-cartesian
lifts of `P` to the topology generated by `P`. -/
@[stacks 0CN0 "cocontinuity of a strongly-cartesian inherited topology"]
instance isCocontinuous
    (P : Precoverage C) (p : S ⥤ C) [P.HasPullbacks] [p.IsFibered] :
    p.IsCocontinuous (P.stronglyCartesianTopology p) P.toGrothendieck := sorry

end Precoverage.StronglyCartesianLift.Projection

namespace Functor.inheritedTopology

variable {C : Type uC} [Category.{vC} C]
variable {S : Type uS} [Category.{vS} S]

/-- Lemma 8.10.4 (tag 0CN0), topology specialization: every fibred projection is continuous
from its inherited topology to the base topology. -/
@[stacks 0CN0]
instance isContinuous
    (p : S ⥤ C) (J : GrothendieckTopology C) [p.IsFibered] :
    p.IsContinuous (p.inheritedTopology J) J := sorry

/-- Lemma 8.10.4 (tag 0CN0), topology specialization: every fibred projection is
cocontinuous from its inherited topology to the base topology. -/
@[stacks 0CN0]
instance isCocontinuous
    (p : S ⥤ C) (J : GrothendieckTopology C) [p.IsFibered] :
    p.IsCocontinuous (p.inheritedTopology J) J := sorry

/-- A fibred projection sends covering sieves for its inherited topology to covering sieves in
the base.  The structure-valued statement exposes Mathlib's standard `cover_preserve` readout. -/
@[stacks 0CN0 "cover preservation by an inherited-topology projection"]
theorem coverPreserving
    (p : S ⥤ C) (J : GrothendieckTopology C) [p.IsFibered] :
    CoverPreserving (p.inheritedTopology J) J p := sorry

/-- The morphism of topoi induced by a fibred projection equipped with its inherited topology.

This is the projection specialization of the cocontinuous-site construction.  The coefficient
universe remains explicit because the pointwise right Kan extensions used by the direct image
depend on it. -/
@[stacks 08P8 "fibred projection morphism of topoi"]
noncomputable def morphismOfTopoi
    (p : S ⥤ C) (J : GrothendieckTopology C) [p.IsFibered]
    [HasSheafify (p.inheritedTopology J) (Type w)]
    [∀ F : Sᵒᵖ ⥤ Type w, p.op.HasPointwiseRightKanExtension F] :
    MorphismOfTopoiIn J (p.inheritedTopology J) :=
  p.morphismOfTopoiInOfCocontinuous (p.inheritedTopology J) J

end Functor.inheritedTopology

end CategoryTheory
