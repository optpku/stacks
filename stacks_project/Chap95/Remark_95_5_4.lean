module

public import ReasLib.AlgebraicGeometry.Scheme.Module.Quasicoherent.Pullback
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.CardinalGeneration
public import ReasLib.AlgebraicGeometry.Scheme.Module.Quasicoherent.CardinalGeneration.Small
public import ReasLib.AlgebraicGeometry.Scheme.Cover.Fpqc
public import Mathlib.CategoryTheory.Sites.Descent.IsStack
public import Mathlib.SetTheory.Cardinal.Defs

/-!
The fppf stack of quasi-coherent sheaves locally generated by at most `κ` sections,
for an infinite cardinal `κ`.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry
open scoped Cardinal CategoryTheory.Bicategory

noncomputable section

universe u v

namespace AlgebraicGeometry.Scheme.QCoh

/-- The fibrewise object property on `pseudofunctor` consisting of quasi-coherent
modules locally generated by at most `κ` sections. -/
def kappaGenerated (κ : Cardinal.{u}) : pseudofunctor.ObjectProperty where
  prop X := fun (F : QCoh X.as.unop) ↦ F.obj.IsKappaGenerated κ

/-- The fibrewise property `kappaGenerated κ` is `IsKappaGenerated κ` on the
underlying module sheaf. -/
theorem kappaGenerated_iff {κ : Cardinal.{u}} {X : LocallyDiscrete Scheme.{u}ᵒᵖ}
    {F : QCoh X.as.unop} :
    (kappaGenerated κ).prop X F ↔ F.obj.IsKappaGenerated κ := sorry

/-- Pullback of quasi-coherent modules along a scheme morphism preserves the bound of
being locally generated by at most `κ` sections. -/
theorem pullback_isKappaGenerated {X Y : Scheme.{u}} (f : X ⟶ Y) {κ : Cardinal.{u}}
    {F : Y.QCoh} (hF : F.obj.IsKappaGenerated κ) :
    ((pullback f).obj F).obj.IsKappaGenerated κ := sorry

/-- Quasi-coherent pullback preserves the fibrewise property of being locally generated
by at most `κ` sections. -/
instance instIsClosedUnderMapObj_kappaGenerated (κ : Cardinal.{u}) :
    (kappaGenerated κ).IsClosedUnderMapObj := sorry

/-- In each quasi-coherent fibre, being locally generated by at most `κ` sections is
closed under isomorphism. -/
instance instIsClosedUnderIsomorphisms_kappaGenerated (κ : Cardinal.{u}) :
    (kappaGenerated κ).IsClosedUnderIsomorphisms := sorry

/-- A quasi-coherent scheme module whose pullbacks along an fpqc covering family are
locally generated by at most `κ` sections is itself locally generated by at most `κ`
sections. -/
theorem of_fpqcCovering {X : Scheme.{u}} {ι : Type v} {κ : Cardinal.{u}}
    (F : X.Modules) [F.IsQuasicoherent]
    (family : ι → Over X) (hfamily : Scheme.FpqcCovering family)
    (hpullback : ∀ i, ((Modules.pullback (family i).hom).obj F).IsKappaGenerated κ) :
    F.IsKappaGenerated κ := sorry

/-- Remark 95.5.4: the fppf-stack discussion of finitely generated quasi-coherent
sheaves remains valid for quasi-coherent sheaves locally generated by at most `κ`
sections, for an infinite cardinal `κ` (e.g. `κ = ℵ₀`), including essential smallness
of the fibres. -/
@[stacks 04U7, instance]
instance instIsStack (κ : Cardinal.{u}) [hκ : Fact (ℵ₀ ≤ κ)] :
    (kappaGenerated κ).fullsubcategory.IsStack fppfTopology := sorry

/-- Source example: quasi-coherent sheaves locally generated by at most `ℵ₀`
sections form an fppf stack. -/
theorem isStack_aleph0 :
    (kappaGenerated ℵ₀).fullsubcategory.IsStack fppfTopology := sorry

end AlgebraicGeometry.Scheme.QCoh
