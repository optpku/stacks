module

public import Mathlib.Algebra.Category.ModuleCat.Adjunctions
public import Mathlib.CategoryTheory.Monoidal.FunctorCategory
public import Mathlib.CategoryTheory.Preadditive.Biproducts
public import Mathlib.CategoryTheory.Sites.CoverLifting
public import Mathlib.CategoryTheory.Sites.GlobalSections
public import Mathlib.CategoryTheory.Yoneda
public import Mathlib.LinearAlgebra.Span.Basic
public import Mathlib.LinearAlgebra.TensorProduct.Basic
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Points
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Etale.BaseChange
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Etale.Coproduct
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.EtaleSite.IntegerExtension

/-!
# Tensor and coproduct comparisons for constant-integer extension by zero

Pairing morphisms over the base gives the tensor comparison on free integer
presheaves. Clopen summand restrictions give the coproduct comparison by gluing.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry CategoryTheory.Limits
open CategoryTheory.MonoidalCategory Opposite
open scoped CategoryTheory

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

variable {S : Scheme.{u}}

/-- Morphisms over `X` from a scheme étale over `X` to an algebraic space `U`. -/
structure SliceHom {X U : AlgebraicSpace S} (f : U ⟶ X) (V : smallEtaleSite X) where
  /-- The underlying morphism of algebraic spaces. -/
  hom : ofOver V.left ⟶ U
  /-- The morphism lies over `X`. -/
  w : hom ≫ f = V.hom

namespace SliceHom

/-- Restriction of a morphism over `X` along a morphism of schemes étale over `X`. -/
def restrict {X U : AlgebraicSpace S} {f : U ⟶ X} {V W : smallEtaleSite X}
    (φ : SliceHom f V) (g : W ⟶ V) : SliceHom f W where
  hom := ofOverMap g.left ≫ φ.hom
  w := sorry

/-- The fibre-product pairing `Mor_X(V, U1) × Mor_X(V, U2) → Mor_X(V, U1 ×_X U2)`. -/
def pair {X U1 U2 : AlgebraicSpace S} {f1 : U1 ⟶ X} {f2 : U2 ⟶ X}
    [HasPullback f1 f2] {V : smallEtaleSite X}
    (φ1 : SliceHom f1 V) (φ2 : SliceHom f2 V) :
    SliceHom (pullback.fst f1 f2 ≫ f1) V where
  hom := pullback.lift φ1.hom φ2.hom (φ1.w.trans φ2.w.symm)
  w := sorry

/-- The underlying morphism of `SliceHom.restrict` is postcomposition on the source. -/
theorem restrict_hom {X U : AlgebraicSpace S} {f : U ⟶ X} {V W : smallEtaleSite X}
    (φ : SliceHom f V) (g : W ⟶ V) :
    (φ.restrict g).hom = ofOverMap g.left ≫ φ.hom :=
  rfl

/-- The underlying morphism of `SliceHom.pair` is the fibre-product lift. -/
theorem pair_hom {X U1 U2 : AlgebraicSpace S} {f1 : U1 ⟶ X} {f2 : U2 ⟶ X}
    [HasPullback f1 f2] {V : smallEtaleSite X}
    (φ1 : SliceHom f1 V) (φ2 : SliceHom f2 V) :
    (φ1.pair φ2).hom = pullback.lift φ1.hom φ2.hom (φ1.w.trans φ2.w.symm) :=
  rfl

/-- A `SliceHom` is a morphism over `X`. -/
theorem hom_comp {X U : AlgebraicSpace S} {f : U ⟶ X} {V : smallEtaleSite X}
    (φ : SliceHom f V) : φ.hom ≫ f = V.hom :=
  φ.w

end SliceHom

/-- The Hom-presheaf `V ↦ Mor_X(V, U)` on the small étale site of `X`. -/
def sliceHomPresheaf {X U : AlgebraicSpace S} (f : U ⟶ X) :
    (smallEtaleSite X)ᵒᵖ ⥤ Type (u + 1) where
  obj V := SliceHom f (unop V)
  map g := ↾(fun φ ↦ φ.restrict g.unop)
  map_id V := by
    apply ConcreteCategory.hom_ext
    intro φ
    cases φ
    congr 1
  map_comp g h := by
    apply ConcreteCategory.hom_ext
    intro φ
    cases φ
    congr 1

/-- The Hom-presheaf evaluates to `SliceHom`. -/
theorem sliceHomPresheaf_obj {X U : AlgebraicSpace S} (f : U ⟶ X) (V : (smallEtaleSite X)ᵒᵖ) :
    (sliceHomPresheaf f).obj V = SliceHom f (unop V) :=
  rfl

/-- Postcomposition with a coproduct inclusion, as a map of Hom-presheaves. -/
def sliceHomIncl {X U1 U2 : AlgebraicSpace S} (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    (i : Fin 2) :
    sliceHomPresheaf (finTwoHom f1 f2 i) ⟶
      sliceHomPresheaf (coproductDesc (finTwoHom f1 f2)) where
  app V := ↾fun (φ : SliceHom (finTwoHom f1 f2 i) (unop V)) ↦
    ({ hom := φ.hom ≫ coproductι (finTwo U1 U2) i,
       w := by rw [Category.assoc, coproductι_desc]; exact φ.w } :
      SliceHom (coproductDesc (finTwoHom f1 f2)) (unop V))
  naturality := sorry

/-- Objectwise free `integerModule`-module presheaf generated by a Hom-presheaf. -/
def integerExtensionPresheaf {X U : AlgebraicSpace S} (f : U ⟶ X) :
    (smallEtaleSite X)ᵒᵖ ⥤ IntegerModuleCat :=
  sliceHomPresheaf f ⋙ ModuleCat.free integerModule

/-- Objectwise free extension-by-zero is free abelianization of `sliceHomPresheaf`. -/
theorem integerExtensionPresheaf_eq {X U : AlgebraicSpace S} (f : U ⟶ X) :
    integerExtensionPresheaf f =
      sliceHomPresheaf f ⋙ ModuleCat.free integerModule :=
  rfl

/-- The sheaf `f_! underline(ℤ)` realized by the free Hom-presheaf formula
`V ↦ ⊕_{φ : Mor_X(V, U)} ℤ`. -/
noncomputable abbrev freeExtensionByZeroInteger {X U : AlgebraicSpace S} (f : U ⟶ X)
    [HasWeakSheafify (smallEtaleTopology X) IntegerModuleCat] :
    Sheaf (smallEtaleTopology X) IntegerModuleCat :=
  (presheafToSheaf (smallEtaleTopology X) IntegerModuleCat).obj
    (integerExtensionPresheaf f)

/-- `freeExtensionByZeroInteger f` is sheafification of `integerExtensionPresheaf f`. -/
theorem freeExtensionByZeroInteger_obj {X U : AlgebraicSpace S} (f : U ⟶ X)
    [HasWeakSheafify (smallEtaleTopology X) IntegerModuleCat] :
    freeExtensionByZeroInteger f =
      (presheafToSheaf (smallEtaleTopology X) IntegerModuleCat).obj
        (integerExtensionPresheaf f) :=
  rfl

/-- Presheaf-level tensor comparison, sending `1_φ1 ⊗ 1_φ2` to `1_{φ1 × φ2}`. -/
def tensorComparisonPresheaf {X U1 U2 : AlgebraicSpace S} (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [HasPullback f1 f2] :
    integerExtensionPresheaf f1 ⊗ integerExtensionPresheaf f2 ⟶
      integerExtensionPresheaf (pullback.fst f1 f2 ≫ f1) where
  app V :=
    Functor.LaxMonoidal.μ (ModuleCat.free integerModule)
        (SliceHom f1 (unop V)) (SliceHom f2 (unop V)) ≫
      (ModuleCat.free integerModule).map
        (↾fun (p : SliceHom f1 (unop V) × SliceHom f2 (unop V)) ↦ p.1.pair p.2)
  naturality := sorry

/-- The component of `tensorComparisonPresheaf` is the free-module monoidal comparison followed
by the Hom pairing. -/
theorem tensorComparisonPresheaf_app {X U1 U2 : AlgebraicSpace S} (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [HasPullback f1 f2] (V : (smallEtaleSite X)ᵒᵖ) :
    (tensorComparisonPresheaf f1 f2).app V =
      Functor.LaxMonoidal.μ (ModuleCat.free integerModule)
          (SliceHom f1 (unop V)) (SliceHom f2 (unop V)) ≫
        (ModuleCat.free integerModule).map
          (↾fun (p : SliceHom f1 (unop V) × SliceHom f2 (unop V)) ↦ p.1.pair p.2) :=
  rfl

/-- Presheaf-level inclusion of the `i`-th summand into the coproduct extension. -/
def coprodInclPresheaf {X U1 U2 : AlgebraicSpace S} (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    (i : Fin 2) :
    integerExtensionPresheaf (finTwoHom f1 f2 i) ⟶
      integerExtensionPresheaf (coproductDesc (finTwoHom f1 f2)) :=
  Functor.whiskerRight (sliceHomIncl f1 f2 i) (ModuleCat.free integerModule)

/-- `coprodInclPresheaf` is whiskering of `sliceHomIncl` by free abelianization. -/
theorem coprodInclPresheaf_eq {X U1 U2 : AlgebraicSpace S} (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    (i : Fin 2) :
    coprodInclPresheaf f1 f2 i =
      Functor.whiskerRight (sliceHomIncl f1 f2 i) (ModuleCat.free integerModule) :=
  rfl

/-- An étale morphism over `X` from a scheme étale over `X` to `U` is étale. -/
theorem etale_sliceHom {X U : AlgebraicSpace S} {f : U ⟶ X} [Etale f]
    {V : smallEtaleSite X} (φ : SliceHom f V) : Etale φ.hom :=
  sorry

/-- The object of `U_étale` corresponding to a morphism over `X` into `U`. -/
def sliceHomToSite {X U : AlgebraicSpace S} {f : U ⟶ X} [Etale f]
    {V : smallEtaleSite X} (φ : SliceHom f V) : smallEtaleSite U :=
  @smallEtaleSite.mk S U V.left φ.hom (etale_sliceHom φ)

/-- Postcomposition along `f` recovers the original object of `X_étale`. -/
noncomputable def sliceHomRestrictionIso {X U : AlgebraicSpace S} {f : U ⟶ X} [Etale f]
    {V : smallEtaleSite X} (φ : SliceHom f V) :
    (etaleRestriction f).obj (sliceHomToSite φ) ≅ V :=
  MorphismProperty.CostructuredArrow.isoMk (Iso.refl V.left) trivial trivial sorry

/-- The morphism over `X` associated to an object of `U_étale`. -/
def siteToSliceHom {X U : AlgebraicSpace S} {f : U ⟶ X} [Etale f]
    (W : smallEtaleSite U) : SliceHom f ((etaleRestriction f).obj W) :=
  ⟨W.hom, sorry⟩

/-- The module map `integerModule ⟶ M` sending `1` to a given element. -/
private def integerModuleToSpan {M : IntegerModuleCat} (x : M) :
    ModuleCat.of integerModule integerModule ⟶ M :=
  ModuleCat.ofHom (LinearMap.toSpanSingleton integerModule M x)

variable {X U : AlgebraicSpace S}

/-- Homomorphisms out of the free Hom-coproduct formula of `f_! underline(ℤ)`. -/
noncomputable def ExtensionByZeroInteger.sliceFromFree {X U : AlgebraicSpace S} (f : U ⟶ X)
    [HasWeakSheafify (smallEtaleTopology X) IntegerModuleCat]
    {A : Sheaf (smallEtaleTopology X) IntegerModuleCat}
    (φ : freeExtensionByZeroInteger f ⟶ A) :
    sliceHomPresheaf f ⟶ A.obj ⋙ forget IntegerModuleCat :=
  let sheafMap :=
    (sheafificationAdjunction (smallEtaleTopology X) IntegerModuleCat).homEquiv
      (integerExtensionPresheaf f) A φ
  ((ModuleCat.adj integerModule).whiskerRight (smallEtaleSite X)ᵒᵖ).homEquiv
    (sliceHomPresheaf f) A.obj sheafMap

/-- Reconstruction of a map out of the free Hom-coproduct sheaf from its values on generators. -/
noncomputable def ExtensionByZeroInteger.freeFromSlice {X U : AlgebraicSpace S} (f : U ⟶ X)
    [HasWeakSheafify (smallEtaleTopology X) IntegerModuleCat]
    {A : Sheaf (smallEtaleTopology X) IntegerModuleCat}
    (η : sliceHomPresheaf f ⟶ A.obj ⋙ forget IntegerModuleCat) :
    freeExtensionByZeroInteger f ⟶ A :=
  let pres : integerExtensionPresheaf f ⟶
      (sheafToPresheaf (smallEtaleTopology X) IntegerModuleCat).obj A :=
    ((ModuleCat.adj integerModule).whiskerRight (smallEtaleSite X)ᵒᵖ).homEquiv
      (sliceHomPresheaf f) A.obj |>.symm η
  (sheafificationAdjunction (smallEtaleTopology X) IntegerModuleCat).homEquiv
    (integerExtensionPresheaf f) A |>.symm pres

/-- Homomorphisms out of the canonical `f_! underline(ℤ)`, evaluated on Hom-generators. -/
noncomputable def ExtensionByZeroInteger.sliceFromCanonical {X U : AlgebraicSpace S} (f : U ⟶ X) [Etale f]
    [HasWeakSheafify (smallEtaleTopology X) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology U) IntegerModuleCat]
    {A : Sheaf (smallEtaleTopology X) IntegerModuleCat}
    (φ : (moduleExtensionByZero f).obj (constantIntegerModuleSheaf U) ⟶ A) :
    sliceHomPresheaf f ⟶ A.obj ⋙ forget IntegerModuleCat where
  app V :=
    TypeCat.ofHom fun (ψ : (sliceHomPresheaf f).obj V) ↦
      let W := sliceHomToSite (V := unop V) ψ
      let e := sliceHomRestrictionIso (V := unop V) ψ
      let η := (etaleExtensionByZero_adjunction f IntegerModuleCat).homEquiv
        (constantIntegerModuleSheaf U) A φ
      let pres := (sheafificationAdjunction (smallEtaleTopology U) IntegerModuleCat).homEquiv
        ((Functor.const (smallEtaleSite U)ᵒᵖ).obj (.of integerModule integerModule))
        ((etaleRestrictionSheaf f IntegerModuleCat).obj A) η
      ConcreteCategory.hom (pres.app (op W) ≫ A.obj.map e.inv.op) (1 : integerModule)
  naturality := sorry

/-- Reconstruction of a map out of canonical `f_! underline(ℤ)` from its values on Hom-generators. -/
noncomputable def ExtensionByZeroInteger.canonicalFromSlice {X U : AlgebraicSpace S} (f : U ⟶ X) [Etale f]
    [HasWeakSheafify (smallEtaleTopology X) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology U) IntegerModuleCat]
    {A : Sheaf (smallEtaleTopology X) IntegerModuleCat}
    (η : sliceHomPresheaf f ⟶ A.obj ⋙ forget IntegerModuleCat) :
    moduleExtensionByZeroInteger f ⟶ A :=
  let M := ModuleCat.of integerModule integerModule
  let pres :
      (etaleRestriction f).op ⋙ (Functor.const (smallEtaleSite X)ᵒᵖ).obj M ⟶
        (etaleRestriction f).op ⋙ A.obj :=
    { app W := private integerModuleToSpan
        (ConcreteCategory.hom
          (η.app ((etaleRestriction f).op.obj W))
          (siteToSliceHom (unop W)))
      naturality := sorry }
  let constP := (Functor.const (smallEtaleSite U)ᵒᵖ).obj M
  let restrA := (etaleRestrictionSheaf f IntegerModuleCat).obj A
  let pres' : constP ⟶ restrA.obj :=
    (Functor.constCompWhiskeringLeftIso (smallEtaleSite U)ᵒᵖ (etaleRestriction f).op).inv.app M ≫
      pres ≫
        (Functor.sheafPushforwardContinuousCompSheafToPresheafIso
            (etaleRestriction f) IntegerModuleCat
            (smallEtaleTopology U) (smallEtaleTopology X)).inv.app A
  let sheafMap :=
    (sheafificationAdjunction (smallEtaleTopology U) IntegerModuleCat).homEquiv
      constP restrA |>.symm pres'
  (etaleExtensionByZero_adjunction f IntegerModuleCat).homEquiv
    (constantIntegerModuleSheaf U) A |>.symm sheafMap

/-- The generator-evaluation and generator-reconstruction maps are mutually inverse. -/
private theorem ExtensionByZeroInteger.freeIso_laws {X U : AlgebraicSpace S} (f : U ⟶ X) [Etale f]
    [HasWeakSheafify (smallEtaleTopology X) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology U) IntegerModuleCat] :
    (freeFromSlice f (sliceFromCanonical f (𝟙 (moduleExtensionByZeroInteger f)))) ≫
        (canonicalFromSlice f (sliceFromFree f (𝟙 (freeExtensionByZeroInteger f)))) = 𝟙 _ ∧
      (canonicalFromSlice f (sliceFromFree f (𝟙 (freeExtensionByZeroInteger f)))) ≫
        (freeFromSlice f (sliceFromCanonical f (𝟙 (moduleExtensionByZeroInteger f)))) = 𝟙 _ :=
  sorry

/-- The sheafification of the free integer Hom-presheaf is canonically isomorphic
to étale extension by zero of the constant integer sheaf. -/
noncomputable def ExtensionByZeroInteger.freeIso {X U : AlgebraicSpace S} (f : U ⟶ X) [Etale f]
    [HasWeakSheafify (smallEtaleTopology X) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology U) IntegerModuleCat] :
    freeExtensionByZeroInteger f ≅ moduleExtensionByZeroInteger f where
  hom := freeFromSlice f (sliceFromCanonical f (𝟙 (moduleExtensionByZeroInteger f)))
  inv := canonicalFromSlice f (sliceFromFree f (𝟙 (freeExtensionByZeroInteger f)))
  hom_inv_id := by exact (freeIso_laws f).1
  inv_hom_id := by exact (freeIso_laws f).2

/-- `freeIso` identifies the Hom-coproduct formula with module extension by zero. -/
theorem ExtensionByZeroInteger.freeIso_hom {X U : AlgebraicSpace S} (f : U ⟶ X) [Etale f]
    [HasWeakSheafify (smallEtaleTopology X) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology U) IntegerModuleCat] :
    (freeIso f).hom = freeFromSlice f (sliceFromCanonical f (𝟙 (moduleExtensionByZeroInteger f))) :=
  rfl

variable {U1 U2 : AlgebraicSpace S}

/-- Presheaf-level tensor comparison, sheafified. -/
noncomputable def ExtensionByZeroInteger.tensorComparisonFree (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [HasPullback f1 f2]
    [HasWeakSheafify (smallEtaleTopology X) IntegerModuleCat]
    [MorphismProperty.IsMonoidal
      ((smallEtaleTopology X).W :
        MorphismProperty ((smallEtaleSite X)ᵒᵖ ⥤ IntegerModuleCat))] :
    freeExtensionByZeroInteger f1 ⊗ freeExtensionByZeroInteger f2 ⟶
      freeExtensionByZeroInteger (pullback.fst f1 f2 ≫ f1) :=
  (Functor.Monoidal.μIso
      (presheafToSheaf (smallEtaleTopology X) IntegerModuleCat)
      (integerExtensionPresheaf f1) (integerExtensionPresheaf f2)).hom ≫
    (presheafToSheaf (smallEtaleTopology X) IntegerModuleCat).map
      (tensorComparisonPresheaf f1 f2)

/-- Canonical comparison
`f1_! underline(ℤ) ⊗_ℤ f2_! underline(ℤ) ⟶ f12_! underline(ℤ)`
on extension by zero of the constant integer sheaf. -/
noncomputable def ExtensionByZeroInteger.tensorComparison (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [HasPullback f1 f2] [Etale f1] [Etale f2]
    [HasWeakSheafify (smallEtaleTopology X) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology U1) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology U2) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology (pullback f1 f2)) IntegerModuleCat]
    [MorphismProperty.IsMonoidal
      ((smallEtaleTopology X).W :
        MorphismProperty ((smallEtaleSite X)ᵒᵖ ⥤ IntegerModuleCat))] :
    moduleExtensionByZeroInteger f1 ⊗ moduleExtensionByZeroInteger f2 ⟶
      moduleExtensionByZeroInteger (pullback.fst f1 f2 ≫ f1) :=
  tensorHom (freeIso f1).inv (freeIso f2).inv ≫
    tensorComparisonFree f1 f2 ≫
    (freeIso (pullback.fst f1 f2 ≫ f1)).hom

/-- `tensorComparison` is the Hom-pairing of free integer presheaves, transported along
`freeIso`. -/
theorem ExtensionByZeroInteger.tensorComparison_eq (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [HasPullback f1 f2] [Etale f1] [Etale f2]
    [HasWeakSheafify (smallEtaleTopology X) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology U1) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology U2) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology (pullback f1 f2)) IntegerModuleCat]
    [MorphismProperty.IsMonoidal
      ((smallEtaleTopology X).W :
        MorphismProperty ((smallEtaleSite X)ᵒᵖ ⥤ IntegerModuleCat))] :
    tensorComparison f1 f2 =
      tensorHom (freeIso f1).inv (freeIso f2).inv ≫
        tensorComparisonFree f1 f2 ≫
        (freeIso (pullback.fst f1 f2 ≫ f1)).hom :=
  rfl

/-- Generator form of the tensor comparison: `1_φ1 ⊗ 1_φ2` maps to `1_{φ1 × φ2}`. -/
theorem ExtensionByZeroInteger.tensorComparison_tmul (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [HasPullback f1 f2] {V : smallEtaleSite X}
    (φ1 : SliceHom f1 V) (φ2 : SliceHom f2 V) :
    ((tensorComparisonPresheaf f1 f2).app (op V)).hom
        (ModuleCat.freeMk φ1 ⊗ₜ[integerModule] ModuleCat.freeMk φ2) =
      ModuleCat.freeMk (φ1.pair φ2) :=
  sorry

/-- Coproduct inclusions, sheafified. -/
noncomputable def ExtensionByZeroInteger.coprodInclSheaf (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [HasWeakSheafify (smallEtaleTopology X) IntegerModuleCat] (i : Fin 2) :
    freeExtensionByZeroInteger (finTwoHom f1 f2 i) ⟶
      freeExtensionByZeroInteger (coproductDesc (finTwoHom f1 f2)) :=
  (presheafToSheaf (smallEtaleTopology X) IntegerModuleCat).map
    (coprodInclPresheaf f1 f2 i)

/-- Inclusion copairing
`f1_! underline(ℤ) ⊕ f2_! underline(ℤ) ⟶ (f1 ⨿ f2)_! underline(ℤ)`,
the inverse of the coproduct comparison. -/
noncomputable def ExtensionByZeroInteger.coprodInclComparison (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [Etale f1] [Etale f2]
    [HasWeakSheafify (smallEtaleTopology X) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology U1) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology U2) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology (binaryCoproduct U1 U2)) IntegerModuleCat]
    [HasBinaryBiproducts (Sheaf (smallEtaleTopology X) IntegerModuleCat)] :
    moduleExtensionByZeroInteger f1 ⊞ moduleExtensionByZeroInteger f2 ⟶
      moduleExtensionByZeroInteger (coproductDesc (finTwoHom f1 f2)) :=
  biprod.desc
    ((freeIso f1).inv ≫
      coprodInclSheaf f1 f2 0 ≫
      (freeIso (coproductDesc (finTwoHom f1 f2))).hom)
    ((freeIso f2).inv ≫
      coprodInclSheaf f1 f2 1 ≫
      (freeIso (coproductDesc (finTwoHom f1 f2))).hom)

/-- The inclusion copairing is the copairing of the sheafified coproduct inclusions,
transported along `freeIso`. -/
theorem ExtensionByZeroInteger.coprodInclComparison_eq (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [Etale f1] [Etale f2]
    [HasWeakSheafify (smallEtaleTopology X) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology U1) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology U2) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology (binaryCoproduct U1 U2)) IntegerModuleCat]
    [HasBinaryBiproducts (Sheaf (smallEtaleTopology X) IntegerModuleCat)] :
    coprodInclComparison f1 f2 =
      biprod.desc
        ((freeIso f1).inv ≫
          coprodInclSheaf f1 f2 0 ≫
          (freeIso (coproductDesc (finTwoHom f1 f2))).hom)
        ((freeIso f2).inv ≫
          coprodInclSheaf f1 f2 1 ≫
          (freeIso (coproductDesc (finTwoHom f1 f2))).hom) :=
  rfl

/-- The left inclusion into the coproduct inclusion copairing. -/
theorem ExtensionByZeroInteger.coprodInclComparison_inl (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [Etale f1] [Etale f2]
    [HasWeakSheafify (smallEtaleTopology X) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology U1) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology U2) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology (binaryCoproduct U1 U2)) IntegerModuleCat]
    [HasBinaryBiproducts (Sheaf (smallEtaleTopology X) IntegerModuleCat)] :
    biprod.inl ≫ coprodInclComparison f1 f2 =
      (freeIso f1).inv ≫
        coprodInclSheaf f1 f2 0 ≫
        (freeIso (coproductDesc (finTwoHom f1 f2))).hom :=
  sorry

/-- The right inclusion into the coproduct inclusion copairing. -/
theorem ExtensionByZeroInteger.coprodInclComparison_inr (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [Etale f1] [Etale f2]
    [HasWeakSheafify (smallEtaleTopology X) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology U1) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology U2) IntegerModuleCat]
    [HasWeakSheafify (smallEtaleTopology (binaryCoproduct U1 U2)) IntegerModuleCat]
    [HasBinaryBiproducts (Sheaf (smallEtaleTopology X) IntegerModuleCat)] :
    biprod.inr ≫ coprodInclComparison f1 f2 =
      (freeIso f2).inv ≫
        coprodInclSheaf f1 f2 1 ≫
        (freeIso (coproductDesc (finTwoHom f1 f2))).hom :=
  sorry

/-- The clopen partition of `V` classified by a morphism into `U1 ⨿ U2`. -/
def SliceHom.coprodSection {X U1 U2 : AlgebraicSpace S}
    {f1 : U1 ⟶ X} {f2 : U2 ⟶ X} {V : smallEtaleSite X}
    (φ : SliceHom (coproductDesc (finTwoHom f1 f2)) V) :
    CoproductSection (finTwo U1 U2) V.left :=
  yonedaEquiv φ.hom

/-- The `i`-th clopen piece of a morphism into `U1 ⨿ U2`, as a scheme over `S`. -/
def SliceHom.coprodPieceOver {X U1 U2 : AlgebraicSpace S}
    {f1 : U1 ⟶ X} {f2 : U2 ⟶ X} {V : smallEtaleSite X}
    (φ : SliceHom (coproductDesc (finTwoHom f1 f2)) V) (i : Fin 2) : Over S :=
  Over.mk (((φ.coprodSection).piece (equivShrink.{u} (Fin 2) i)).ι ≫ V.left.hom)

/-- The open immersion of the `i`-th clopen piece into `V`, as a morphism over `S`. -/
def SliceHom.coprodPieceOverHom {X U1 U2 : AlgebraicSpace S}
    {f1 : U1 ⟶ X} {f2 : U2 ⟶ X} {V : smallEtaleSite X}
    (φ : SliceHom (coproductDesc (finTwoHom f1 f2)) V) (i : Fin 2) :
    φ.coprodPieceOver i ⟶ V.left :=
  Over.homMk ((φ.coprodSection).piece (equivShrink.{u} (Fin 2) i)).ι sorry

/-- The structure morphism of the `i`-th clopen piece over `X`. -/
def SliceHom.coprodPieceStructure {X U1 U2 : AlgebraicSpace S}
    {f1 : U1 ⟶ X} {f2 : U2 ⟶ X} {V : smallEtaleSite X}
    (φ : SliceHom (coproductDesc (finTwoHom f1 f2)) V) (i : Fin 2) :
    ofOver (φ.coprodPieceOver i) ⟶ X :=
  ofOverMap (φ.coprodPieceOverHom i) ≫ V.hom

/-- The `i`-th clopen piece of a morphism into `U1 ⨿ U2` is étale over `X`. -/
theorem SliceHom.etale_coprodPiece {X U1 U2 : AlgebraicSpace S}
    {f1 : U1 ⟶ X} {f2 : U2 ⟶ X} {V : smallEtaleSite X}
    (φ : SliceHom (coproductDesc (finTwoHom f1 f2)) V) (i : Fin 2) :
    Etale (φ.coprodPieceStructure i) :=
  sorry

/-- The `i`-th clopen piece, as an object of the small étale site of `X`. -/
def SliceHom.coprodPieceSite {X U1 U2 : AlgebraicSpace S}
    {f1 : U1 ⟶ X} {f2 : U2 ⟶ X} {V : smallEtaleSite X}
    (φ : SliceHom (coproductDesc (finTwoHom f1 f2)) V) (i : Fin 2) :
    smallEtaleSite X :=
  MorphismProperty.CostructuredArrow.mk ⊤ (φ.coprodPieceStructure i) (φ.etale_coprodPiece i)

/-- The covering arrow from the `i`-th clopen piece to `V` in `X_étale`. -/
def SliceHom.coprodPieceHom {X U1 U2 : AlgebraicSpace S}
    {f1 : U1 ⟶ X} {f2 : U2 ⟶ X} {V : smallEtaleSite X}
    (φ : SliceHom (coproductDesc (finTwoHom f1 f2)) V) (i : Fin 2) :
    φ.coprodPieceSite i ⟶ V :=
  MorphismProperty.CostructuredArrow.homMk (φ.coprodPieceOverHom i) trivial sorry

/-- The two clopen pieces of a morphism into `U1 ⨿ U2` cover `V` in `X_étale`. -/
theorem SliceHom.coprodPiece_cover {X U1 U2 : AlgebraicSpace S}
    {f1 : U1 ⟶ X} {f2 : U2 ⟶ X} {V : smallEtaleSite X}
    (φ : SliceHom (coproductDesc (finTwoHom f1 f2)) V) :
    Sieve.ofArrows (fun i ↦ φ.coprodPieceSite i) (fun i ↦ φ.coprodPieceHom i) ∈
      smallEtaleTopology X V :=
  sorry

/-- On the `i`-th clopen piece, a morphism into `U1 ⨿ U2` factors through `Ui`. -/
def SliceHom.coprodFactor {X U1 U2 : AlgebraicSpace S}
    {f1 : U1 ⟶ X} {f2 : U2 ⟶ X} {V : smallEtaleSite X}
    (φ : SliceHom (coproductDesc (finTwoHom f1 f2)) V) (i : Fin 2) :
    SliceHom (finTwoHom f1 f2 i) (φ.coprodPieceSite i) where
  hom :=
    yonedaEquiv.symm ((φ.coprodSection).summandSection (equivShrink.{u} (Fin 2) i)) ≫
      eqToHom (congrArg (finTwo U1 U2)
        (Equiv.symm_apply_apply (equivShrink.{u} (Fin 2)) i))
  w := sorry

/-- The sheaf section `1_{φ_i}` of `fi_! underline(ℤ)` over the `i`-th clopen piece. -/
private noncomputable def ExtensionByZeroInteger.coprodPieceGenerator
    (f1 : U1 ⟶ X) (f2 : U2 ⟶ X) {V : smallEtaleSite X}
    (φ : SliceHom (coproductDesc (finTwoHom f1 f2)) V) (i : Fin 2) :
    (freeExtensionByZeroInteger (finTwoHom f1 f2 i)).obj.obj (op (φ.coprodPieceSite i)) :=
  ConcreteCategory.hom
    (((sheafificationAdjunction (smallEtaleTopology X) IntegerModuleCat).unit.app
        (integerExtensionPresheaf (finTwoHom f1 f2 i))).app
      (op (φ.coprodPieceSite i)))
    (ModuleCat.freeMk (φ.coprodFactor i))

/-- The matching family for `1_φ` on the clopen cover: `1_{φ_i}` on the `i`-th piece and `0` on
the other summand, as a section of the sheaf biproduct. -/
private noncomputable def ExtensionByZeroInteger.coprodMatchingFamily
    (f1 : U1 ⟶ X) (f2 : U2 ⟶ X) {V : smallEtaleSite X}
    (φ : SliceHom (coproductDesc (finTwoHom f1 f2)) V) (i : Fin 2) :
    ModuleCat.of integerModule integerModule ⟶
      (freeExtensionByZeroInteger f1 ⊞ freeExtensionByZeroInteger f2).obj.obj
        (op (φ.coprodPieceSite i)) :=
  match i with
  | 0 =>
    integerModuleToSpan
      (ConcreteCategory.hom
        (((sheafToPresheaf (smallEtaleTopology X) IntegerModuleCat).map
            (biprod.inl :
              freeExtensionByZeroInteger f1 ⟶
                freeExtensionByZeroInteger f1 ⊞ freeExtensionByZeroInteger f2)).app
          (op (φ.coprodPieceSite 0)))
        (coprodPieceGenerator f1 f2 φ 0))
  | 1 =>
    integerModuleToSpan
      (ConcreteCategory.hom
        (((sheafToPresheaf (smallEtaleTopology X) IntegerModuleCat).map
            (biprod.inr :
              freeExtensionByZeroInteger f2 ⟶
                freeExtensionByZeroInteger f1 ⊞ freeExtensionByZeroInteger f2)).app
          (op (φ.coprodPieceSite 1)))
        (coprodPieceGenerator f1 f2 φ 1))

/-- The matching family of `1_φ` is compatible on overlaps of the clopen cover. -/
private theorem ExtensionByZeroInteger.coprodMatchingFamily_compatible
    (f1 : U1 ⟶ X) (f2 : U2 ⟶ X) {V : smallEtaleSite X}
    (φ : SliceHom (coproductDesc (finTwoHom f1 f2)) V) :
    ∀ ⦃W : smallEtaleSite X⦄ ⦃i j : Fin 2⦄
      (a : W ⟶ φ.coprodPieceSite i) (b : W ⟶ φ.coprodPieceSite j),
      a ≫ φ.coprodPieceHom i = b ≫ φ.coprodPieceHom j →
      coprodMatchingFamily f1 f2 φ i ≫
          (freeExtensionByZeroInteger f1 ⊞ freeExtensionByZeroInteger f2).obj.map a.op =
        coprodMatchingFamily f1 f2 φ j ≫
          (freeExtensionByZeroInteger f1 ⊞ freeExtensionByZeroInteger f2).obj.map b.op :=
  sorry

/-- The amalgamation of the clopen matching family of a Hom-generator in the sheaf biproduct. -/
private noncomputable def ExtensionByZeroInteger.coprodGeneratorHom
    (f1 : U1 ⟶ X) (f2 : U2 ⟶ X) {V : smallEtaleSite X}
    (φ : SliceHom (coproductDesc (finTwoHom f1 f2)) V) :
    ModuleCat.of integerModule integerModule ⟶
      (freeExtensionByZeroInteger f1 ⊞ freeExtensionByZeroInteger f2).obj.obj (op V) :=
  (freeExtensionByZeroInteger f1 ⊞ freeExtensionByZeroInteger f2).property.amalgamateOfArrows
    (fun i ↦ φ.coprodPieceHom i) (φ.coprodPiece_cover)
    (fun i ↦ coprodMatchingFamily f1 f2 φ i)
    (coprodMatchingFamily_compatible f1 f2 φ)

/-- Presheaf-level coproduct comparison, sending a Hom-generator `1_φ` to the glued family
that is `1_{φ_i}` on `V ×_{U1 ⨿ U2} Ui` and `0` on the other summand. -/
noncomputable def ExtensionByZeroInteger.coprodComparisonPresheaf (f1 : U1 ⟶ X) (f2 : U2 ⟶ X) :
    integerExtensionPresheaf (coproductDesc (finTwoHom f1 f2)) ⟶
      (sheafToPresheaf (smallEtaleTopology X) IntegerModuleCat).obj
        (freeExtensionByZeroInteger f1 ⊞ freeExtensionByZeroInteger f2) where
  app V := private
    ((ModuleCat.adj integerModule).homEquiv
        (SliceHom (coproductDesc (finTwoHom f1 f2)) (unop V))
        (((sheafToPresheaf (smallEtaleTopology X) IntegerModuleCat).obj
            (freeExtensionByZeroInteger f1 ⊞ freeExtensionByZeroInteger f2)).obj V)).symm
      (TypeCat.ofHom fun φ ↦
        ConcreteCategory.hom (coprodGeneratorHom f1 f2 φ) (1 : integerModule))
  naturality := sorry

/-- `coprodComparisonPresheaf` is free abelianization of the glued clopen matching families. -/
theorem ExtensionByZeroInteger.coprodComparisonPresheaf_app (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    (V : (smallEtaleSite X)ᵒᵖ) :
    (coprodComparisonPresheaf f1 f2).app V =
      ((ModuleCat.adj integerModule).homEquiv
          (SliceHom (coproductDesc (finTwoHom f1 f2)) (unop V))
          (((sheafToPresheaf (smallEtaleTopology X) IntegerModuleCat).obj
              (freeExtensionByZeroInteger f1 ⊞ freeExtensionByZeroInteger f2)).obj V)).symm
        (TypeCat.ofHom fun φ ↦
          let pieceGenerator (i : Fin 2) :
              (freeExtensionByZeroInteger (finTwoHom f1 f2 i)).obj.obj
                (op (φ.coprodPieceSite i)) :=
            ConcreteCategory.hom
              (((sheafificationAdjunction (smallEtaleTopology X) IntegerModuleCat).unit.app
                  (integerExtensionPresheaf (finTwoHom f1 f2 i))).app
                (op (φ.coprodPieceSite i)))
              (ModuleCat.freeMk (φ.coprodFactor i))
          let matchingFamily (i : Fin 2) :
              ModuleCat.of integerModule integerModule ⟶
                (freeExtensionByZeroInteger f1 ⊞ freeExtensionByZeroInteger f2).obj.obj
                  (op (φ.coprodPieceSite i)) :=
            match i with
            | 0 => ModuleCat.ofHom (LinearMap.toSpanSingleton integerModule _
                (ConcreteCategory.hom
                  (((sheafToPresheaf (smallEtaleTopology X) IntegerModuleCat).map
                      (biprod.inl : freeExtensionByZeroInteger f1 ⟶
                        freeExtensionByZeroInteger f1 ⊞ freeExtensionByZeroInteger f2)).app
                    (op (φ.coprodPieceSite 0)))
                  (pieceGenerator 0)))
            | 1 => ModuleCat.ofHom (LinearMap.toSpanSingleton integerModule _
                (ConcreteCategory.hom
                  (((sheafToPresheaf (smallEtaleTopology X) IntegerModuleCat).map
                      (biprod.inr : freeExtensionByZeroInteger f2 ⟶
                        freeExtensionByZeroInteger f1 ⊞ freeExtensionByZeroInteger f2)).app
                    (op (φ.coprodPieceSite 1)))
                  (pieceGenerator 1)))
          ConcreteCategory.hom
            ((freeExtensionByZeroInteger f1 ⊞ freeExtensionByZeroInteger f2).property.amalgamateOfArrows
              (fun i ↦ φ.coprodPieceHom i) φ.coprodPiece_cover matchingFamily
              (by exact coprodMatchingFamily_compatible f1 f2 φ))
            (1 : integerModule)) :=
  by rfl

/-- Sheafified coproduct comparison on the Hom-coproduct formula. -/
noncomputable def ExtensionByZeroInteger.coprodComparisonFree (f1 : U1 ⟶ X) (f2 : U2 ⟶ X) :
    freeExtensionByZeroInteger (coproductDesc (finTwoHom f1 f2)) ⟶
      freeExtensionByZeroInteger f1 ⊞ freeExtensionByZeroInteger f2 :=
  ((sheafificationAdjunction (smallEtaleTopology X) IntegerModuleCat).homEquiv
      (integerExtensionPresheaf (coproductDesc (finTwoHom f1 f2)))
      (freeExtensionByZeroInteger f1 ⊞ freeExtensionByZeroInteger f2)).symm
    (coprodComparisonPresheaf f1 f2)

/-- `coprodComparisonFree` is the adjunct of `coprodComparisonPresheaf`. -/
theorem ExtensionByZeroInteger.coprodComparisonFree_eq (f1 : U1 ⟶ X) (f2 : U2 ⟶ X) :
    coprodComparisonFree f1 f2 =
      ((sheafificationAdjunction (smallEtaleTopology X) IntegerModuleCat).homEquiv
          (integerExtensionPresheaf (coproductDesc (finTwoHom f1 f2)))
          (freeExtensionByZeroInteger f1 ⊞ freeExtensionByZeroInteger f2)).symm
        (coprodComparisonPresheaf f1 f2) :=
  rfl

/-- Canonical comparison
`(f1 ⨿ f2)_! underline(ℤ) ⟶ f1_! underline(ℤ) ⊕ f2_! underline(ℤ)`
obtained by gluing the clopen matching families of Hom-generators, then transporting along
`freeIso`. -/
noncomputable def ExtensionByZeroInteger.coprodComparison (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [Etale f1] [Etale f2] :
    moduleExtensionByZeroInteger (coproductDesc (finTwoHom f1 f2)) ⟶
      moduleExtensionByZeroInteger f1 ⊞ moduleExtensionByZeroInteger f2 :=
  (freeIso (coproductDesc (finTwoHom f1 f2))).inv ≫
    coprodComparisonFree f1 f2 ≫
    biprod.map (freeIso f1).hom (freeIso f2).hom

/-- `coprodComparison` is the glued clopen matching-family map, transported along `freeIso`. -/
theorem ExtensionByZeroInteger.coprodComparison_eq (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [Etale f1] [Etale f2] :
    coprodComparison f1 f2 =
      (freeIso (coproductDesc (finTwoHom f1 f2))).inv ≫
        coprodComparisonFree f1 f2 ≫
        biprod.map (freeIso f1).hom (freeIso f2).hom :=
  rfl

/-- `coprodComparison` and the inclusion copairing are inverse sheaf morphisms. -/
theorem ExtensionByZeroInteger.coprodComparison_spec (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [Etale f1] [Etale f2] :
    coprodComparison f1 f2 ≫ coprodInclComparison f1 f2 = 𝟙 _ ∧
      coprodInclComparison f1 f2 ≫ coprodComparison f1 f2 = 𝟙 _ :=
  sorry

/-- The left inclusion family is sent to `biprod.inl` by the coproduct comparison. -/
theorem ExtensionByZeroInteger.coprodComparison_inl (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [Etale f1] [Etale f2] :
    (freeIso f1).inv ≫ coprodInclSheaf f1 f2 0 ≫
        (freeIso (coproductDesc (finTwoHom f1 f2))).hom ≫
        coprodComparison f1 f2 =
      biprod.inl :=
  sorry

/-- The right inclusion family is sent to `biprod.inr` by the coproduct comparison. -/
theorem ExtensionByZeroInteger.coprodComparison_inr (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [Etale f1] [Etale f2] :
    (freeIso f2).inv ≫ coprodInclSheaf f1 f2 1 ≫
        (freeIso (coproductDesc (finTwoHom f1 f2))).hom ≫
        coprodComparison f1 f2 =
      biprod.inr :=
  sorry



/-- For étale morphisms `f1 : U1 ⟶ X` and `f2 : U2 ⟶ X` of algebraic
spaces over a scheme `S`, the Hom-pairing
`1_φ1 ⊗ 1_φ2 ↦ 1_{φ1 × φ2}` induces an isomorphism
`f1_! underline(ℤ) ⊗_ℤ f2_! underline(ℤ) ⟶ (pullback.fst f1 f2 ≫ f1)_! underline(ℤ)`. -/
instance ExtensionByZeroInteger.tensorComparison_isIso (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [HasPullback f1 f2] [Etale f1] [Etale f2] :
    IsIso (ExtensionByZeroInteger.tensorComparison f1 f2) :=
  sorry

/-- For étale morphisms `f1 : U1 ⟶ X` and `f2 : U2 ⟶ X` of algebraic
spaces over a scheme `S`, coproduct inclusions induce an isomorphism
`(f1 ⨿ f2)_! underline(ℤ) ⟶ f1_! underline(ℤ) ⊕ f2_! underline(ℤ)`. -/
instance ExtensionByZeroInteger.coprodComparison_isIso (f1 : U1 ⟶ X) (f2 : U2 ⟶ X)
    [Etale f1] [Etale f2] :
    IsIso (ExtensionByZeroInteger.coprodComparison f1 f2) :=
  sorry

end AlgebraicGeometry.AlgebraicSpace
