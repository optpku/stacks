module

public import Mathlib.RingTheory.LocalProperties.Exactness
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.TensorProduct.IsBaseChangePi
public import ReasLib.Algebra.Module.LocalizedModule.Away.Cech.Exact
public import ReasLib.Algebra.Module.LocalizedModule.Away.Iterated.Equiv
public import ReasLib.Algebra.Module.LocalizedModule.Units

/-!
# Principal-open localization glueing

The reusable maps, iterated-localization comparisons, and exactness criteria
are owned by `LocalizedModule.Away.Cech` and
`LocalizedModule.Away.Iterated`.  This source file retains the historical
Chapter 10 names used by later entries.

@stack 00EK
-/

@[expose] public section

open LinearMap LocalizedModule

universe u v w

noncomputable section

section Compatibility

variable {R : Type u} [CommSemiring R]
variable {ι : Type w}

local notation "Away" => LocalizedModule.Away

/-- The canonical map from `M` to the family of principal localizations
`M_(f_i)`.  The reusable owner is `LocalizedModule.Away.Cech.familyMap`. -/
noncomputable abbrev awayLocalizationFamilyMap
    (M : Type v) [AddCommGroup M] [Module R M] (f : ι → R) :
    M →ₗ[R] ∀ i : ι, Away (f i) M :=
  LinearMap.pi fun i ↦ mkLinearMap (.powers (f i)) M

/-- A divisor of the element inverted in an away localization acts by a unit
on the localized module. -/
theorem awayModuleEnd_isUnit_of_dvd
    (M : Type v) [AddCommGroup M] [Module R M] (x r : R) (h : r ∣ x) :
    IsUnit (algebraMap R (Module.End R (Away x M)) r) := sorry

/-- Every power of a divisor of the away element acts invertibly on the
localized module. -/
theorem awayModuleEnd_isUnit_of_power_of_dvd
    (M : Type v) [AddCommGroup M] [Module R M] (x r : R) (h : r ∣ x)
    (s : Submonoid.powers r) :
    IsUnit (algebraMap R (Module.End R (Away x M)) s) := sorry

/-- The source-facing pairwise compatibility map for a family of principal
localizations. -/
noncomputable def awayLocalizationCompatibilityMap
    (M : Type v) [AddCommGroup M] [Module R M] (f : ι → R) :
    (∀ i : ι, Away (f i) M) →ₗ[R]
      ∀ i : ι, ∀ j : ι, Away (f i * f j) M :=
  LinearMap.pi fun i ↦ LinearMap.pi fun j ↦
    (LocalizedModule.lift (.powers (f i))
      (mkLinearMap (.powers (f i * f j)) M)
      (awayModuleEnd_isUnit_of_power_of_dvd M (f i * f j) (f i)
        (dvd_mul_right _ _))).comp (LinearMap.proj i) -
    (LocalizedModule.lift (.powers (f j))
      (mkLinearMap (.powers (f i * f j)) M)
      (awayModuleEnd_isUnit_of_power_of_dvd M (f i * f j) (f j)
        (dvd_mul_left _ _))).comp (LinearMap.proj j)

/-- The historical family map is the canonical principal-open Cech family
map. -/
@[stacks 00EK "source-facing Cech family map bridge"]
theorem AwayLocalization.familyMap_eq
    (M : Type v) [AddCommGroup M] [Module R M] (f : ι → R) :
    awayLocalizationFamilyMap M f =
      LocalizedModule.Away.Cech.familyMap M f := sorry

/-- The historical pairwise map is the canonical principal-open Cech
compatibility map. -/
@[stacks 00EK "source-facing Cech compatibility map bridge"]
theorem AwayLocalization.compatibilityMap_eq
    (M : Type v) [AddCommGroup M] [Module R M] (f : ι → R) :
    awayLocalizationCompatibilityMap M f =
      LocalizedModule.Away.Cech.compatibilityMap M f := sorry

/-- The canonical two-step localization map `M → S⁻¹(S'⁻¹M)`. -/
noncomputable abbrev iteratedLocalizedModuleMkLinearMap
    (S S' : Submonoid R) (M : Type v) [AddCommGroup M] [Module R M] :
    M →ₗ[R] LocalizedModule S (LocalizedModule S' M) :=
  (LocalizedModule.mkLinearMap S (LocalizedModule S' M)).comp
    (LocalizedModule.mkLinearMap S' M)

/-- Localizing an invertible scalar endomorphism preserves its
invertibility. -/
theorem localizedModuleEnd_isUnit
    (S : Submonoid R) {N : Type v} [AddCommGroup N] [Module R N] {r : R}
    (h : IsUnit (algebraMap R (Module.End R N) r)) :
    IsUnit (algebraMap R (Module.End R (LocalizedModule S N)) r) := sorry

/-- The historical iterated map presents successive localization as
localization at the supremum of the denominator submonoids. -/
instance iteratedLocalizedModule_isLocalizedModule_sup
    (S S' : Submonoid R) (M : Type v) [AddCommGroup M] [Module R M] :
    IsLocalizedModule (S ⊔ S')
      (iteratedLocalizedModuleMkLinearMap S S' M) :=
  LocalizedModule.iteratedMk_isLocalizedModule S S' M

/-- Direct localization away from `a * b` is a localization at the supremum
of the submonoids generated by `a` and `b`. -/
instance mkLinearMap_isLocalizedModule_sup_away_mul
    (a b : R) (M : Type v) [AddCommGroup M] [Module R M] :
    IsLocalizedModule (Submonoid.powers a ⊔ Submonoid.powers b)
      (LocalizedModule.mkLinearMap (Submonoid.powers (a * b)) M) := sorry

/-- The symmetric supremum presentation of localization away from
`a * b`. -/
instance mkLinearMap_isLocalizedModule_sup_away_mul'
    (a b : R) (M : Type v) [AddCommGroup M] [Module R M] :
    IsLocalizedModule (Submonoid.powers b ⊔ Submonoid.powers a)
      (LocalizedModule.mkLinearMap (Submonoid.powers (a * b)) M) :=
  LocalizedModule.Away.Iterated.mulMk_isLocalizedModule a b M

/-- Reindex an away localization along an equality of its denominator. -/
noncomputable abbrev awayEqLinearEquiv
    (M : Type v) [AddCommGroup M] [Module R M] {a b : R} (h : a = b) :
    Away a M ≃ₗ[R] Away b M :=
  h.rec (LinearEquiv.refl R (Away a M))

/-- Denominator reindexing fixes canonical denominator-one elements. -/
theorem awayEqLinearEquiv_apply_mk_one
    (M : Type v) [AddCommGroup M] [Module R M] {a b : R} (h : a = b) (m : M) :
    awayEqLinearEquiv M h (LocalizedModule.mk m 1) =
      LocalizedModule.mk m 1 := sorry

/-- The collapse map is a left inverse to localization when every
denominator already acts invertibly. -/
theorem awayLocalizedByUnit_left_inv
    (r : R) (M : Type v) [AddCommGroup M] [Module R M]
    (h : ∀ x : Submonoid.powers r,
      IsUnit (algebraMap R (Module.End R M) x)) :
    (LocalizedModule.lift (Submonoid.powers r) (.id : M →ₗ[R] M) h).comp
      (LocalizedModule.mkLinearMap (Submonoid.powers r) M) = .id := sorry

/-- The canonical localization map is a left inverse to the collapse map
when every denominator already acts invertibly. -/
theorem awayLocalizedByUnit_right_inv
    (r : R) (M : Type v) [AddCommGroup M] [Module R M]
    (h : ∀ x : Submonoid.powers r,
      IsUnit (algebraMap R (Module.End R M) x)) :
    (LocalizedModule.mkLinearMap (Submonoid.powers r) M).comp
      (LocalizedModule.lift (Submonoid.powers r) (.id : M →ₗ[R] M) h) = .id := sorry

/-- If every power of `r` acts invertibly on `M`, then localization away
from `r` is canonically equivalent to `M`. -/
noncomputable abbrev awayLocalizedByUnitEquiv
    (r : R) (M : Type v) [AddCommGroup M] [Module R M]
    (h : ∀ x : Submonoid.powers r,
      IsUnit (algebraMap R (Module.End R M) x)) :
    Away r M ≃ₗ[R] M :=
  LinearEquiv.ofLinear
    (LocalizedModule.lift (Submonoid.powers r) (.id : M →ₗ[R] M) h)
    (LocalizedModule.mkLinearMap (Submonoid.powers r) M)
    (awayLocalizedByUnit_left_inv r M h)
    (awayLocalizedByUnit_right_inv r M h)

/-- Successive localization first away from `a` and then away from `b`
agrees with direct localization away from `a * b`. -/
noncomputable abbrev awayMulLinearEquiv
    (a b : R) (M : Type v) [AddCommGroup M] [Module R M] :
    Away b (Away a M) ≃ₗ[R] Away (a * b) M :=
  IsLocalizedModule.linearEquiv (Submonoid.powers b ⊔ Submonoid.powers a)
    (iteratedLocalizedModuleMkLinearMap
      (Submonoid.powers b) (Submonoid.powers a) M)
    (LocalizedModule.mkLinearMap (Submonoid.powers (a * b)) M)

end Compatibility

section Exactness

variable {R : Type u} [CommSemiring R]
variable {ι : Type w} [Finite ι]

omit [Finite ι] in
/-- If one distinguished denominator already acts invertibly on `M`, then
the associated principal-open Cech sequence is exact. -/
theorem away_localization_glueing_exact_of_isUnit
    (M : Type v) [AddCommGroup M] [Module R M] (f : ι → R) (i₀ : ι)
    (hunit : ∀ x : Submonoid.powers (f i₀),
      IsUnit (algebraMap R (Module.End R M) x)) :
    Function.Injective (awayLocalizationFamilyMap M f) ∧
      Function.Exact (awayLocalizationFamilyMap M f)
        (awayLocalizationCompatibilityMap M f) := sorry

/-- Lemma 10.24.1: if the finite family `f : ι → R` generates the unit
ideal, then the sequence
`0 → M → ∏ i, M_(f i) → ∏ i j, M_(f i * f j)` is exact.  The maps are the
canonical localization family map and the difference of the two restriction
maps on each pairwise overlap. -/
@[stacks 00EK]
theorem away_localization_glueing_exact
    (M : Type v) [AddCommGroup M] [Module R M] (f : ι → R)
    (hf : Ideal.span (Set.range f) = ⊤) :
    Function.Injective (awayLocalizationFamilyMap M f) ∧
      Function.Exact (awayLocalizationFamilyMap M f)
        (awayLocalizationCompatibilityMap M f) := sorry

end Exactness

/- Canonical owner recalls. -/
#check @LocalizedModule.Away.Cech.familyMap
#check @LocalizedModule.Away.Cech.compatibilityMap
#check @LocalizedModule.Away.Cech.familyMap_exact_of_isUnit
#check @LocalizedModule.Away.Cech.familyMap_injective_of_isUnit
#check @LocalizedModule.Away.Cech.familyMap_exact
#check @LocalizedModule.Away.Cech.familyMap_injective
#check @LocalizedModule.iteratedMkLinearMap
#check @LocalizedModule.iteratedMk_isLocalizedModule
#check @LocalizedModule.Away.Iterated.baseMulEquiv
#check @LocalizedModule.Away.Iterated.denominatorEquiv
#check @LocalizedModule.Away.idLinearEquiv

#print axioms awayLocalizationCompatibilityMap
#print axioms iteratedLocalizedModuleMkLinearMap
#print axioms awayEqLinearEquiv
#print axioms awayLocalizedByUnitEquiv
#print axioms awayMulLinearEquiv
