module

public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# The local ring of the double line

This file defines the coordinate ring of the plane curve `x ^ 2 = 0`, its
origin ideal, and the localization at that ideal.
-/

@[expose] public section

noncomputable section

universe u

open MvPolynomial

namespace MvPolynomial.DoubleLine

variable (k : Type u) [Field k]

/-- The ideal generated by the square of the first coordinate variable. -/
def relationIdeal : Ideal (MvPolynomial (Fin 2) k) :=
  Ideal.span {X 0 ^ 2}

/-- The defining ideal is the principal ideal generated by the square of `X 0`. -/
theorem relationIdeal_eq_span :
    relationIdeal k = Ideal.span {X 0 ^ 2} := rfl

/-- The coordinate ring of the plane curve `x ^ 2 = 0`. -/
abbrev CoordinateRing : Type u :=
  MvPolynomial (Fin 2) k ⧸ relationIdeal k

/-- The class of the first coordinate variable in the coordinate ring. -/
def coordX : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (X 0)

/-- The class of the second coordinate variable in the coordinate ring. -/
def coordY : CoordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (X 1)

/-- The first coordinate is square-zero in the coordinate ring. -/
theorem coordX_pow_two : coordX k ^ 2 = 0 := by
  rw [coordX, ← map_pow, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span (by simp)

/-- The ideal of the origin in the coordinate ring. -/
def originIdeal : Ideal (CoordinateRing k) :=
  Ideal.span {coordX k, coordY k}

/-- The origin ideal is generated by the two coordinate classes. -/
theorem originIdeal_eq_span :
    originIdeal k = Ideal.span {coordX k, coordY k} := rfl

/-- The first coordinate class belongs to the origin ideal. -/
theorem coordX_mem_originIdeal : coordX k ∈ originIdeal k := by
  exact Ideal.subset_span (by simp)

/-- The second coordinate class belongs to the origin ideal. -/
theorem coordY_mem_originIdeal : coordY k ∈ originIdeal k := by
  exact Ideal.subset_span (by simp)

/-- The origin ideal is the image of the ideal generated by the polynomial variables. -/
theorem originIdeal_eq_map :
    originIdeal k =
      Ideal.map (Ideal.Quotient.mk (relationIdeal k)) (idealOfVars (Fin 2) k) := by
  have hvars : Set.range (X : Fin 2 → MvPolynomial (Fin 2) k) = {X 0, X 1} := by
    ext p
    simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · rintro ⟨i, rfl⟩
      fin_cases i <;> simp
    · rintro (rfl | rfl)
      · exact ⟨0, rfl⟩
      · exact ⟨1, rfl⟩
  simp [idealOfVars, hvars, Ideal.map_span, Set.image_insert_eq, originIdeal,
    coordX, coordY]

/-- The origin ideal is maximal in the coordinate ring. -/
private theorem ker_constantCoeff_eq_idealOfVars :
    RingHom.ker (constantCoeff : MvPolynomial (Fin 2) k →+* k) =
      idealOfVars (Fin 2) k := by
  let I := idealOfVars (Fin 2) k
  have hX (i : Fin 2) : Ideal.Quotient.mk I (X i) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
  have hcomp : ((Ideal.Quotient.mk I).comp C).comp constantCoeff =
      Ideal.Quotient.mk I := by
    ext r
    · simp
    · simp [hX]
  apply le_antisymm
  · intro p hp
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    rw [← hcomp, RingHom.comp_apply, show constantCoeff p = 0 from hp, map_zero]
  · rw [idealOfVars, Ideal.span_le, Set.range_subset_iff]
    intro i
    simp [RingHom.mem_ker]

instance originIdeal_isMaximal : (originIdeal k).IsMaximal := by
  haveI hmax : (idealOfVars (Fin 2) k).IsMaximal := by
    rw [← ker_constantCoeff_eq_idealOfVars]
    exact RingHom.ker_isMaximal_of_surjective constantCoeff (fun r ↦ ⟨C r, by simp⟩)
  have hrel : relationIdeal k ≤ idealOfVars (Fin 2) k := by
    rw [relationIdeal, Ideal.span_le]
    rintro p (rfl)
    exact Ideal.pow_mem_of_mem (idealOfVars (Fin 2) k)
      (Ideal.subset_span ⟨0, rfl⟩) 2 (by decide)
  rw [originIdeal_eq_map]
  apply Ideal.IsMaximal.map_of_surjective_of_ker_le Ideal.Quotient.mk_surjective
  simpa using hrel

/-- The localization of the coordinate ring at its origin ideal. -/
abbrev LocalRing : Type u :=
  Localization.AtPrime (originIdeal k)

/-- The image of the second coordinate in the local ring. -/
def yParam : LocalRing k :=
  algebraMap (CoordinateRing k) (LocalRing k) (coordY k)

/-- The parameter is the localization image of the second coordinate class. -/
theorem yParam_eq :
    yParam k = algebraMap (CoordinateRing k) (LocalRing k) (coordY k) := rfl

/-- The exhibited parameter belongs to the maximal ideal of the local ring. -/
theorem yParam_mem_maximalIdeal :
    yParam k ∈ IsLocalRing.maximalIdeal (LocalRing k) := by
  rw [yParam]
  exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (LocalRing k)
    (originIdeal k) (coordY k)).mpr (coordY_mem_originIdeal k)

private theorem mul_X_one_mem_relationIdeal_iff (p : MvPolynomial (Fin 2) k) :
    p * X 1 ∈ relationIdeal k ↔ p ∈ relationIdeal k := by
  rw [relationIdeal, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
  constructor
  · intro hp
    apply Prime.pow_dvd_of_dvd_mul_right (X_prime (i := (0 : Fin 2))) 2
    · intro h
      exact (show (0 : Fin 2) ≠ 1 by decide) (X_dvd_X.mp h)
    · exact hp
  · intro hp
    exact dvd_mul_of_dvd_left hp (X 1)

private theorem coordY_mem_nonZeroDivisors :
    coordY k ∈ nonZeroDivisors (CoordinateRing k) := by
  rw [mem_nonZeroDivisors_iff_right]
  intro a ha
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  change Ideal.Quotient.mk (relationIdeal k) p *
    Ideal.Quotient.mk (relationIdeal k) (X 1) = 0 at ha
  rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem,
    mul_X_one_mem_relationIdeal_iff] at ha
  exact Ideal.Quotient.eq_zero_iff_mem.mpr ha

/-- The exhibited parameter is a nonzerodivisor of the local ring. -/
theorem yParam_mem_nonZeroDivisors :
    yParam k ∈ nonZeroDivisors (LocalRing k) := by
  exact IsLocalization.nonZeroDivisors_le_comap (S := LocalRing k)
    (originIdeal k).primeCompl (coordY_mem_nonZeroDivisors k)

/-- The exhibited parameter belongs to the maximal ideal and is a nonzerodivisor. -/
theorem yParam_spec :
    yParam k ∈ IsLocalRing.maximalIdeal (LocalRing k) ∧
      yParam k ∈ nonZeroDivisors (LocalRing k) := by
  exact ⟨yParam_mem_maximalIdeal k, yParam_mem_nonZeroDivisors k⟩

end MvPolynomial.DoubleLine
