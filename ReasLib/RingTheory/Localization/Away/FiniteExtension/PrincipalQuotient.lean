module

public import Mathlib.RingTheory.Finiteness.Basic
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.Algebra.Ring.NonZeroDivisors
public import Mathlib.Algebra.Category.Ring.Basic
public import Mathlib.CategoryTheory.CommSq
public import ReasLib.RingTheory.Ideal.Principal
public import ReasLib.RingTheory.Localization.Away.Equiv
import Mathlib.Tactic.CrossRefAttribute

/-!
# Finite extensions from principal-power quotient data

This file owns the eventual principal-quotient lifting theorem and its functorial two-row form.

@stack 0GLT
@stack 0GLU
-/

@[expose] public section

open scoped nonZeroDivisors
open CategoryTheory CommRingCat

universe u

namespace CategoryTheory.CommSq

/-- A commuting square of algebra maps gives the expected pointwise equality on scalars. -/
@[stacks 0GLU "commuting algebra-map square, pointwise form"]
theorem map_algebraMap_eq
    {R S R' S' : Type u} [CommRing R] [CommRing S] [CommRing R'] [CommRing S']
    [Algebra R S] [Algebra R' S']
    (sigma : S →+* S') (tau : R →+* R')
    (hsq :
      CommSq
        (ofHom (algebraMap R S))
        (ofHom tau)
        (ofHom sigma)
        (ofHom (algebraMap R' S')))
    (x : R) :
    sigma (algebraMap R S x) = algebraMap R' S' (tau x) := sorry
-- Proof strategy: apply the morphism equality `hsq.w` to `x` and simplify the four
-- `CommRingCat.ofHom` coercions.  The two composites are exactly the displayed algebra-map
-- expressions.

end CategoryTheory.CommSq

namespace Localization.Away

/-- Lemma 15.117.3: a finite injective extension that becomes an isomorphism away from a
nonzerodivisor admits compatible finite lifts of all sufficiently deep principal-power quotient
isomorphisms. -/
@[stacks 0GLT "Lemma 15.117.3"]
theorem exists_finiteExtension_quotientIso
    {A' A : Type u} [CommRing A'] [CommRing A] [Algebra A' A] [Module.Finite A' A]
    (f : A')
    (hinj : Function.Injective (algebraMap A' A))
    (hf : algebraMap A' A f ∈ nonZeroDivisors A)
    (hAway : Function.Bijective (Localization.awayMapₐ (Algebra.ofId A' A) f)) :
    ∃ n0 : ℕ+, ∀ ⦃n : ℕ+⦄, n0 ≤ n →
      ∀ {B' : Type u} [CommRing B']
        (g : B') (_hg : g ∈ nonZeroDivisors B')
        (phi' : A' ⧸ principalPowerIdeal f n ≃+* B' ⧸ principalPowerIdeal g n)
        (_hgen : phi' (Ideal.Quotient.mk _ f) = Ideal.Quotient.mk _ g),
          ∃ (B : Type u) (_ : CommRing B) (_ : Algebra B' B)
            (_ : Function.Injective (algebraMap B' B)) (_ : Module.Finite B' B)
            (phi : A ⧸ principalIdeal (algebraMap A' A f) ≃+*
              B ⧸ principalIdeal (algebraMap B' B g)),
            CommSq
              (ofHom <|
                principalPowerIdealReductionMap (algebraMap A' A) f
                  (Nat.succ_le_of_lt n.2))
              (ofHom phi'.toRingHom)
              (ofHom phi.toRingHom)
              (ofHom <|
                principalPowerIdealReductionMap (algebraMap B' B) g
                  (Nat.succ_le_of_lt n.2)) := sorry
-- Proof strategy: use the away-isomorphism to clear denominators uniformly for a finite set of
-- `A'`-module generators and multiplication relations of `A`, obtaining an exponent `t`; take
-- `n0` at least `2 * t`.  Transfer the cleared numerator relations through `phi'` and define `B`
-- as the finite `B'`-subalgebra generated by their fixed-denominator representatives.  The
-- nonzerodivisor hypotheses give injectivity of `B' → B` and identify localization away from `g`
-- with the transferred generic algebra.  Reducing the presentation modulo `f` and `g` constructs
-- `phi`; the generator equation and the principal-power reduction maps give the required
-- `CommSq`.

/-- Remark 15.117.4: the finite principal-quotient lifts can be chosen compatibly for a
commutative square of finite injective extensions and a compatible square of deep quotient
isomorphisms. -/
@[stacks 0GLU "Remark 15.117.4"]
theorem exists_functorial_finiteExtension_quotientIso
    {A1' A2' A1 A2 B1' B2' : Type u}
    [CommRing A1'] [CommRing A2'] [CommRing A1] [CommRing A2]
    [CommRing B1'] [CommRing B2']
    [Algebra A1' A1] [Algebra A2' A2]
    [Module.Finite A1' A1] [Module.Finite A2' A2]
    (alpha' : A1' →+* A2') (alpha : A1 →+* A2)
    (sqA :
      CommSq
        (ofHom (algebraMap A1' A1))
        (ofHom alpha')
        (ofHom alpha)
        (ofHom (algebraMap A2' A2)))
    (f : A1')
    (hA1_injective : Function.Injective (algebraMap A1' A1))
    (hA2_injective : Function.Injective (algebraMap A2' A2))
    (hf1 : algebraMap A1' A1 f ∈ nonZeroDivisors A1)
    (hf2 : algebraMap A2' A2 (alpha' f) ∈ nonZeroDivisors A2)
    (hAway1 : Function.Bijective (Localization.awayMapₐ (Algebra.ofId A1' A1) f))
    (hAway2 : Function.Bijective (Localization.awayMapₐ (Algebra.ofId A2' A2) (alpha' f))) :
    ∃ n0 : ℕ+, ∀ {n : ℕ+}, n0 ≤ n →
      ∀ (beta' : B1' →+* B2') (g : B1')
        (hg1 : g ∈ nonZeroDivisors B1') (hg2 : beta' g ∈ nonZeroDivisors B2')
        (phi1' : A1' ⧸ principalPowerIdeal f n ≃+* B1' ⧸ principalPowerIdeal g n)
        (phi2' : A2' ⧸ principalPowerIdeal (alpha' f) n ≃+*
          B2' ⧸ principalPowerIdeal (beta' g) n)
        (hgen : phi1' (Ideal.Quotient.mk _ f) = Ideal.Quotient.mk _ g)
        (hsquare :
          CommSq
            (ofHom <| principalPowerIdealQuotientMap alpha' f rfl n)
            (ofHom phi1'.toRingHom)
            (ofHom phi2'.toRingHom)
            (ofHom <| principalPowerIdealQuotientMap beta' g rfl n)),
        ∃ (C1 : Type u) (_ : CommRing C1) (_ : Algebra B1' C1)
          (_ : Function.Injective (algebraMap B1' C1)) (_ : Module.Finite B1' C1)
          (phi1 : A1 ⧸ principalIdeal (algebraMap A1' A1 f) ≃+*
            C1 ⧸ principalIdeal (algebraMap B1' C1 g)),
          CommSq
            (ofHom <|
              principalPowerIdealReductionMap (algebraMap A1' A1) f
                (Nat.succ_le_of_lt n.2))
            (ofHom phi1'.toRingHom)
            (ofHom phi1.toRingHom)
            (ofHom <|
              principalPowerIdealReductionMap (algebraMap B1' C1) g
                (Nat.succ_le_of_lt n.2)) ∧
          ∃ (C2 : Type u) (_ : CommRing C2) (_ : Algebra B2' C2)
            (_ : Function.Injective (algebraMap B2' C2)) (_ : Module.Finite B2' C2)
            (phi2 : A2 ⧸ principalIdeal (algebraMap A2' A2 (alpha' f)) ≃+*
              C2 ⧸ principalIdeal (algebraMap B2' C2 (beta' g)))
            (beta : C1 →+* C2)
            (sqBeta :
              CommSq
                (ofHom (algebraMap B1' C1))
                (ofHom beta')
                (ofHom beta)
                (ofHom (algebraMap B2' C2))),
            CommSq
              (ofHom <|
                principalPowerIdealReductionMap (algebraMap A2' A2) (alpha' f)
                  (Nat.succ_le_of_lt n.2))
              (ofHom phi2'.toRingHom)
              (ofHom phi2.toRingHom)
              (ofHom <|
                principalPowerIdealReductionMap (algebraMap B2' C2) (beta' g)
                  (Nat.succ_le_of_lt n.2)) ∧
            CommSq
              (ofHom <|
                principalIdealQuotientMap alpha (algebraMap A1' A1 f)
                  (CommSq.map_algebraMap_eq alpha alpha' sqA f))
              (ofHom phi1.toRingHom)
              (ofHom phi2.toRingHom)
              (ofHom <|
                principalIdealQuotientMap beta (algebraMap B1' C1 g)
                  (CommSq.map_algebraMap_eq beta beta' sqBeta g)) := sorry
-- Proof strategy: choose one exponent bounding the denominator-clearing data for both finite
-- rows and for the maps `alpha'` and `alpha`.  Run `exists_finiteExtension_quotientIso`
-- simultaneously on the two presentations, transporting every chosen numerator through
-- `hsquare`; `sqA` and `CommSq.map_algebraMap_eq` identify the two images of the distinguished
-- generators.  The compatible numerator maps induce `beta : C1 →+* C2` and its algebra-map
-- square.  The two one-row quotient squares follow from the construction, and evaluating the
-- compatible lifted presentation modulo the principal ideals proves the final functorial square.

end Localization.Away
