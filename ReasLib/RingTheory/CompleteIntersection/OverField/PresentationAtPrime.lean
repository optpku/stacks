module

public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.CompleteIntersection.OverField.AtPrime
public import ReasLib.RingTheory.Ideal.Cotangent.RegularSequence
public import ReasLib.RingTheory.RingHom.Local.AtPrime
public import ReasLib.RingTheory.Sequence.Regularity

@[expose] public section

/-!
# Polynomial Presentations at a Prime

@stack 00SC
@stack 00SG

This leaf owns the local data and presentation criteria attached to a
surjective polynomial presentation at a target prime.
-/

noncomputable section

open RingTheory

universe u v

namespace Algebra.PolynomialPresentationAtPrime

variable {k : Type u} [Field k]
variable {S : Type v} [CommRing S] [Algebra k S]
variable {n c : ℕ}

/-- The prime of a polynomial presentation lying over `q`. -/
@[stacks 00SC "source prime of a polynomial presentation"]
abbrev prime (pi : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) :
    PrimeSpectrum (MvPolynomial (Fin n) k) :=
  PrimeSpectrum.comap pi.toRingHom q

/-- The localization of the polynomial source at the prime lying over `q`. -/
@[stacks 00SC "local source ring of a polynomial presentation"]
abbrev localRing (pi : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) : Type u :=
  pi.toRingHom.sourceLocalRingAt q

/-- The extension of the presentation kernel to its local source ring. -/
@[stacks 00SC "localized kernel of a polynomial presentation"]
abbrev localizedKernelIdeal (pi : MvPolynomial (Fin n) k →ₐ[k] S)
    (q : PrimeSpectrum S) : Ideal (localRing pi q) :=
  pi.toRingHom.localKernelIdealAt q

/-- The quotient of the local source by the localized presentation kernel. -/
@[stacks 00SC "local quotient of a polynomial presentation"]
abbrev localQuotientRing (pi : MvPolynomial (Fin n) k →ₐ[k] S)
    (q : PrimeSpectrum S) : Type u :=
  pi.toRingHom.localQuotientAt q

/-- The conormal module of the localized presentation kernel. -/
@[stacks 00SC "localized conormal module of a polynomial presentation"]
abbrev localizedConormalModule (pi : MvPolynomial (Fin n) k →ₐ[k] S)
    (q : PrimeSpectrum S) : Type u :=
  (localizedKernelIdeal pi q).Cotangent

/-- The localized presentation kernel can be generated by `c` elements. -/
@[stacks 00SC "localized kernel generated by a fixed number of elements"]
abbrev kernelGeneratedBy (pi : MvPolynomial (Fin n) k →ₐ[k] S)
    (q : PrimeSpectrum S) (c : ℕ) : Prop :=
  ∃ xs : Fin c → localRing pi q,
    Ideal.span (Set.range xs) = localizedKernelIdeal pi q

/-- The localized conormal module can be generated by `c` elements. -/
@[stacks 00SC "localized conormal module generated by a fixed number of elements"]
abbrev conormalGeneratedBy (pi : MvPolynomial (Fin n) k →ₐ[k] S)
    (q : PrimeSpectrum S) (c : ℕ) : Prop :=
  ∃ xs : Fin c → localizedConormalModule pi q,
    Submodule.span (localQuotientRing pi q) (Set.range xs) = ⊤

/-- The localized conormal module is free of rank `c`. -/
@[stacks 00SC "localized conormal module free of a fixed rank"]
abbrev conormalFree (pi : MvPolynomial (Fin n) k →ₐ[k] S)
    (q : PrimeSpectrum S) (c : ℕ) : Prop :=
  Nonempty (Module.Basis (Fin c) (localQuotientRing pi q) (localizedConormalModule pi q))

/-- A `Fin c`-indexed regular sequence generates the localized presentation kernel. -/
@[stacks 00SG "regular-sequence polynomial presentation at a prime"]
abbrev kernelGeneratedByRegularSequence
    (pi : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) (c : ℕ) : Prop :=
  ∃ xs : Fin c → localRing pi q,
    Sequence.IsRegular (localRing pi q) (List.ofFn xs) ∧
      Ideal.span (Set.range xs) = localizedKernelIdeal pi q

/-- Lemma 10.135.4 (00SC): the five presentation-theoretic characterizations of a global
complete-intersection neighbourhood of `q`. -/
@[stacks 00SC "presentation criteria at a prime"]
theorem tfae (pi : MvPolynomial (Fin n) k →ₐ[k] S) (hpi : Function.Surjective pi)
    (q : PrimeSpectrum S) (hc : (prime pi q).asIdeal.height - q.asIdeal.height = c) :
    List.TFAE
      [ IsGlobalCompleteIntersection.nearPrime k q
      , kernelGeneratedBy pi q c
      , conormalGeneratedBy pi q c
      , conormalFree pi q c
      , (localizedKernelIdeal pi q).IsGeneratedByRegularSequence
      ] := sorry

/-- Lemma 10.135.4, terminal assertion: chosen kernel elements whose cotangent classes generate
the conormal module form a regular sequence at the expected height defect. -/
@[stacks 00SC "cotangent generators form a regular sequence"]
theorem cotangentGeneratorsFormRegularSequence
    (pi : MvPolynomial (Fin n) k →ₐ[k] S) (hpi : Function.Surjective pi)
    (q : PrimeSpectrum S) (hc : (prime pi q).asIdeal.height - q.asIdeal.height = c)
    (xs : Fin c → localizedKernelIdeal pi q)
    (hxs : Submodule.span (localQuotientRing pi q)
      (Set.range fun i ↦ (localizedKernelIdeal pi q).toCotangent (xs i)) = ⊤) :
    Sequence.IsRegular (localRing pi q) (List.ofFn fun i ↦ (xs i : localRing pi q)) := sorry

end Algebra.PolynomialPresentationAtPrime

namespace Algebra.IsCompleteIntersectionOver

variable {k : Type u} [Field k]
variable {S : Type v} [CommRing S] [Algebra k S] [Algebra.FiniteType k S]

/-- Lemma 10.135.8 (00SG): complete intersection at `q`, local and global complete-intersection
neighbourhoods of `q`, and the regular-sequence criterion for every surjective polynomial
presentation are equivalent. -/
@[stacks 00SG "complete-intersection criteria at a prime"]
theorem atPrime_tfae (q : PrimeSpectrum S) :
    List.TFAE
      [ IsCompleteIntersectionOver k (Localization.AtPrime q.asIdeal)
      , IsLocalCompleteIntersection.nearPrime k q
      , IsGlobalCompleteIntersection.nearPrime k q
      , (∀ {n : ℕ} (pi : MvPolynomial (Fin n) k →ₐ[k] S) (_ : Function.Surjective pi),
          PolynomialPresentationAtPrime.kernelGeneratedByRegularSequence pi q
            (ENat.toNat
              ((PolynomialPresentationAtPrime.prime pi q).asIdeal.height - q.asIdeal.height)))
      ] := sorry

end Algebra.IsCompleteIntersectionOver
