module

public import Mathlib.Algebra.Homology.ShortComplex.ModuleCat
public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
public import Mathlib.RingTheory.Localization.Away.Basic
import StacksCheckRecall

@[expose] public section

/-!
# Lemma 10.36.24

@stack 052J

The short exact sequence associated to the two subalgebras generated by `x / y` and `y / x` in
the common localization `R_(xy)`.
-/

universe u

open CategoryTheory
open scoped nonZeroDivisors

namespace Localization.AwayPair

variable {R : Type u} [CommRing R]

/-- The common localization `R_(xy)` used to compare `R[x / y]` and `R[y / x]`. -/
abbrev Common (x y : R) := Localization.Away (x * y)

/-- The element `x / y` in `R_(xy)`, represented by `x² / (xy)`. -/
noncomputable def xDivY (x y : R) : Common x y :=
  IsLocalization.mk' (Common x y) (x * x)
    (⟨x * y, Submonoid.mem_powers (x * y)⟩ : Submonoid.powers (x * y))

/-- The element `y / x` in `R_(xy)`, represented by `y² / (xy)`. -/
noncomputable def yDivX (x y : R) : Common x y :=
  IsLocalization.mk' (Common x y) (y * y)
    (⟨x * y, Submonoid.mem_powers (x * y)⟩ : Submonoid.powers (x * y))

/-- The `R`-subalgebra `R[x / y]` of `R_(xy)`. -/
noncomputable abbrev left (x y : R) : Subalgebra R (Common x y) :=
  Algebra.adjoin R ({xDivY x y} : Set (Common x y))

/-- The `R`-subalgebra `R[y / x]` of `R_(xy)`. -/
noncomputable abbrev right (x y : R) : Subalgebra R (Common x y) :=
  Algebra.adjoin R ({yDivX x y} : Set (Common x y))

/-- The `R`-subalgebra `R[x / y, y / x]` of `R_(xy)`. -/
noncomputable abbrev target (x y : R) : Subalgebra R (Common x y) :=
  left x y ⊔ right x y

/-- The map `R → R[x / y] ⊕ R[y / x]` given by `r ↦ (-r, r)`. -/
noncomputable abbrev negDiagonal (x y : R) :
    R →ₗ[R] left x y × right x y :=
  (-Algebra.linearMap R (left x y)).prod (Algebra.linearMap R (right x y))

/-- The map `R[x / y] ⊕ R[y / x] → R[x / y, y / x]` given by addition. -/
noncomputable abbrev sum (x y : R) :
    left x y × right x y →ₗ[R] target x y :=
  LinearMap.coprod (Subalgebra.inclusion le_sup_left).toLinearMap
    (Subalgebra.inclusion le_sup_right).toLinearMap

/-- The negative diagonal has image contained in the kernel of the sum map. -/
theorem range_negDiagonal_le_ker_sum (x y : R) :
    LinearMap.range (negDiagonal x y) ≤ LinearMap.ker (sum x y) := sorry

/-- The short complex
`0 → R → R[x / y] ⊕ R[y / x] → R[x / y, y / x] → 0`. -/
noncomputable def shortComplex (x y : R) : ShortComplex (ModuleCat R) :=
  ShortComplex.moduleCatMkOfKerLERange
    (ModuleCat.ofHom (negDiagonal x y)) (ModuleCat.ofHom (sum x y))
    (range_negDiagonal_le_ker_sum x y)

/-- Lemma 10.36.24: if `x` and `y` are nonzerodivisors and `R` is integrally closed in
`R_x` or `R_y`, then
`0 → R → R[x / y] ⊕ R[y / x] → R[x / y, y / x] → 0`
is a short exact sequence of `R`-modules. -/
@[stacks 052J]
theorem shortExact_of_isIntegrallyClosedIn (x y : R) (hx : x ∈ R⁰) (hy : y ∈ R⁰)
    (hclosed : IsIntegrallyClosedIn R (Localization.Away x) ∨
      IsIntegrallyClosedIn R (Localization.Away y)) :
    (shortComplex x y).ShortExact := sorry

#print axioms xDivY
#print axioms yDivX
#print axioms negDiagonal
#print axioms sum
#print axioms shortComplex

end Localization.AwayPair
