module

public import Mathlib.CategoryTheory.Functor.OfSequence
public import Mathlib.Topology.Category.TopCat.Limits.Basic
public import Mathlib.Topology.Order

/-!
# A sequential inverse system of quasi-compact spaces with non-quasi-compact limit

On the carrier `ℕ`, the stage topology `T_n` is generated by the singletons `{k}` for
`k ≤ n` together with the tail `Ioi n`. Identity maps give a functor `ℕᵒᵖ ⥤ TopCat`,
and discrete `ℕ` is a limiting cone whose cone point is not quasi-compact.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite Set TopologicalSpace

namespace TopCat.Counterexample.NatQuasiCompact

/-- The prescribed basis of `T_n`: singletons `{k}` for `k ≤ n`, together with the tail
`Ioi n`. -/
def stageBasis (n : ℕ) : Set (Set ℕ) :=
  {s | (∃ k ≤ n, s = {k}) ∨ s = Ioi n}

/-- The unique topology on `ℕ` generated by `stageBasis n`. -/
@[implicit_reducible]
def stageTopology (n : ℕ) : TopologicalSpace ℕ :=
  generateFrom (stageBasis n)

/-- The bundled stage space `X_n = (ℕ, T_n)`. -/
def stageSpace (n : ℕ) : TopCat.{0} :=
  @TopCat.of ℕ (stageTopology n)

/-- The identity function `ℕ → ℕ` is continuous from `T_{n+1}` to `T_n`. -/
theorem stageTransition_continuous (n : ℕ) :
    @Continuous ℕ ℕ (stageTopology (n + 1)) (stageTopology n) id := sorry

/-- The identity bonding map `X_{n+1} ⟶ X_n`. -/
def stageTransition (n : ℕ) : stageSpace (n + 1) ⟶ stageSpace n :=
  @TopCat.ofHom ℕ ℕ (stageTopology (n + 1)) (stageTopology n) <|
    @ContinuousMap.mk ℕ ℕ (stageTopology (n + 1)) (stageTopology n) id
      (stageTransition_continuous n)

/-- The inverse system `(X_n, id)` as a functor `ℕᵒᵖ ⥤ TopCat`. -/
def system : ℕᵒᵖ ⥤ TopCat.{0} :=
  Functor.ofOpSequence stageTransition

/-- Each stage space `X_n` is quasi-compact. -/
instance compactSpace_stageSpace (n : ℕ) : CompactSpace (stageSpace n) := sorry

/-- Each prescribed singleton `{k}` with `k ≤ n` is open in `T_n`. -/
theorem isOpen_singleton (n k : ℕ) (hk : k ≤ n) :
    @IsOpen ℕ (stageTopology n) {k} := sorry

/-- The tail `Ioi n` is open in `T_n`. -/
theorem isOpen_Ioi (n : ℕ) : @IsOpen ℕ (stageTopology n) (Ioi n) := sorry

/-- The identity projection from discrete `ℕ` to the stage `X_n`. -/
def discreteProjection (n : ℕ) : TopCat.discrete.obj ℕ ⟶ stageSpace n :=
  @TopCat.ofHom ℕ ℕ ⊥ (stageTopology n) <|
    @ContinuousMap.mk ℕ ℕ ⊥ (stageTopology n) id continuous_bot

/-- Successor naturality of the discrete identity projections. -/
theorem discreteProjection_naturality (n : ℕ) :
    ((Functor.const ℕᵒᵖ).obj (TopCat.discrete.obj ℕ)).map
          (homOfLE (n.le_add_right 1)).op ≫
        discreteProjection n =
      discreteProjection (n + 1) ≫ system.map (homOfLE (n.le_add_right 1)).op :=
  sorry

/-- Discrete `ℕ` with identity projections, as a cone on `system`. -/
def discreteCone : Cone system where
  pt := TopCat.discrete.obj ℕ
  π := NatTrans.ofOpSequence discreteProjection discreteProjection_naturality

/-- Continuity of the common underlying cone map into discrete `ℕ`. -/
theorem isLimit_discreteCone_lift_continuous (s : Cone system) :
    @Continuous s.pt ℕ _ ⊥ (s.π.app (op 0)) := sorry

/-- The universal map from a test cone to discrete `ℕ`, given by the common
underlying set-map of the cone legs. -/
def isLimit_discreteCone_lift (s : Cone system) : s.pt ⟶ discreteCone.pt :=
  @TopCat.ofHom s.pt ℕ _ ⊥ <|
    @ContinuousMap.mk s.pt ℕ _ ⊥ (s.π.app (op 0))
      (isLimit_discreteCone_lift_continuous s)

/-- Discrete `ℕ` with identity projections is a limiting cone for `system`. -/
def isLimit_discreteCone : IsLimit discreteCone where
  lift := isLimit_discreteCone_lift
  fac := fun _ _ ↦ sorry
  uniq := fun _ _ _ ↦ sorry

/-- The inverse limit of `system` is not quasi-compact. -/
theorem not_compactSpace_limit : ¬ CompactSpace (limit system : TopCat.{0}) := sorry

end TopCat.Counterexample.NatQuasiCompact
