module

public import Mathlib.AlgebraicGeometry.Morphisms.Smooth
public import Mathlib.AlgebraicGeometry.Sites.Etale
public import Mathlib.CategoryTheory.MorphismProperty.OverAdjunction
public import Mathlib.CategoryTheory.Sites.Continuous
public import Mathlib.CategoryTheory.Sites.Pullback

/-!
# The lisse-étale site of a scheme

The lisse-étale site of a scheme `X` is the category of schemes smooth over `X`,
equipped with the étale topology. Base change along a scheme morphism is
continuous for these sites.
-/

@[expose] public section

open CategoryTheory
open AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme

/-- The lisse-étale site of `X` is the category of schemes smooth over `X`. -/
abbrev lisseEtaleSite (X : Scheme.{u}) :=
  MorphismProperty.Over @Smooth ⊤ X

/-- Constructor for an object of the lisse-étale site of `X` from a smooth morphism. -/
abbrev lisseEtaleSite.mk {Y X : Scheme.{u}} (f : Y ⟶ X) [Smooth f] : lisseEtaleSite X :=
  MorphismProperty.Over.mk ⊤ f inferInstance

/-- The forgetful functor from the lisse-étale site of `X` to schemes over `X`. -/
abbrev lisseEtaleForget (X : Scheme.{u}) : lisseEtaleSite X ⥤ Over X :=
  MorphismProperty.Over.forget @Smooth ⊤ X

/-- The lisse-étale topology on schemes smooth over `X`, generated by étale coverings. -/
abbrev lisseEtaleTopology (X : Scheme.{u}) : GrothendieckTopology (lisseEtaleSite X) :=
  X.smallGrothendieckTopology (P := @Etale)

/-- Base change along `f : T ⟶ S` on lisse-étale sites, sending `V / S` to `V ×_S T`. -/
noncomputable abbrev lisseEtalePullback {S T : Scheme.{u}} (f : T ⟶ S) :
  lisseEtaleSite S ⥤ lisseEtaleSite T :=
  MorphismProperty.Over.pullback @Smooth ⊤ f

/-- Base change along a scheme morphism is continuous for the lisse-étale topologies. -/
instance lisseEtalePullback_isContinuous {S T : Scheme.{u}} (f : T ⟶ S) :
    Functor.IsContinuous (lisseEtalePullback f) (lisseEtaleTopology S)
      (lisseEtaleTopology T) := sorry

/-- There are schemes `S` and `T` and a morphism `f : T ⟶ S` whose induced pullback
on lisse-étale sheaves of types does not preserve finite limits. -/
theorem exists_lisseEtaleSheafPullback_not_preservesFiniteLimits :
    ∃ (S T : Scheme.{u}) (f : T ⟶ S),
      ¬ CategoryTheory.Limits.PreservesFiniteLimits
        ((lisseEtalePullback f).sheafPullback (Type (u + 1))
          (lisseEtaleTopology S) (lisseEtaleTopology T)) := sorry

end AlgebraicGeometry.Scheme
