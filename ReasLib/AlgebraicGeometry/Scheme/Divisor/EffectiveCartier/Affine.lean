module

public import ReasLib.AlgebraicGeometry.Scheme.Divisor.EffectiveCartier

@[expose] public section

open AlgebraicGeometry
open CategoryTheory
open scoped AlgebraicGeometry nonZeroDivisors

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {S : Scheme.{u}}

/-- An ideal-sheaf datum has an affine-local nonzerodivisor generator when, near every point
of its support, its ideal is generated by one nonzerodivisor on an affine open. -/
def AffineLocalNonZeroDivisorGenerator (D : S.IdealSheafData) : Prop :=
  ∀ x : S, x ∈ D.support →
    ∃ U : S.affineOpens, x ∈ (U : S.Opens) ∧
      ∃ f : Γ(S, U),
        f ∈ nonZeroDivisors (Γ(S, U)) ∧
          D.ideal U = Ideal.span ({f} : Set (Γ(S, U)))

/-- The affine-local nonzerodivisor-generator predicate unfolds to the existence of an affine
neighborhood and a regular principal generator at every point of the support. -/
theorem affineLocalNonZeroDivisorGenerator_iff (D : S.IdealSheafData) :
    AffineLocalNonZeroDivisorGenerator D ↔
      ∀ x : S, x ∈ D.support →
        ∃ U : S.affineOpens, x ∈ (U : S.Opens) ∧
          ∃ f : Γ(S, U),
            f ∈ nonZeroDivisors (Γ(S, U)) ∧
              D.ideal U = Ideal.span ({f} : Set (Γ(S, U))) :=
  Iff.rfl

/-- An ideal-sheaf datum defines an effective Cartier divisor exactly when its ideal has an
affine-local nonzerodivisor generator near every point of its support. -/
theorem isEffectiveCartierDivisor_iff_affineLocalNonZeroDivisorGenerator
    (D : S.IdealSheafData) :
    AlgebraicGeometry.IsEffectiveCartierDivisor D.subschemeι ↔
      AffineLocalNonZeroDivisorGenerator D := sorry

/-- An affine-local nonzerodivisor generator makes the corresponding closed subscheme an
effective Cartier divisor. -/
theorem isEffectiveCartierDivisor_of_affineLocal_nonZeroDivisorGenerator
    (D : S.IdealSheafData)
    (hlocal : AffineLocalNonZeroDivisorGenerator D) :
    AlgebraicGeometry.IsEffectiveCartierDivisor D.subschemeι :=
  (isEffectiveCartierDivisor_iff_affineLocalNonZeroDivisorGenerator D).2 hlocal

/-- Every effective Cartier divisor presented by ideal-sheaf data has affine-local
nonzerodivisor generators. -/
theorem affineLocalNonZeroDivisorGenerator_of_isEffectiveCartierDivisor
    (D : S.IdealSheafData) (hD : AlgebraicGeometry.IsEffectiveCartierDivisor D.subschemeι) :
    AffineLocalNonZeroDivisorGenerator D :=
  (isEffectiveCartierDivisor_iff_affineLocalNonZeroDivisorGenerator D).1 hD

/-- Near every point in the support of an effective Cartier divisor, its ideal is generated on
an affine open by a nonzerodivisor. -/
theorem exists_affineOpen_nonZeroDivisor_generator
    (D : S.IdealSheafData)
    (hD : AlgebraicGeometry.IsEffectiveCartierDivisor D.subschemeι) {x : S} (hx : x ∈ D.support) :
    ∃ U : S.affineOpens, x ∈ (U : S.Opens) ∧
      ∃ f : Γ(S, U),
        f ∈ nonZeroDivisors (Γ(S, U)) ∧
          D.ideal U = Ideal.span ({f} : Set (Γ(S, U))) := by
  have hlocal := affineLocalNonZeroDivisorGenerator_of_isEffectiveCartierDivisor D hD
  exact hlocal x hx

end AlgebraicGeometry.Scheme.IdealSheafData
