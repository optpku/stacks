module

public import stacks_project.Chap52.Lemma_52_6_7
public import stacks_project.Chap52.«52_7_0_1_Completion»
import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

open CategoryTheory
open RingedSite
open RingedSite.ToposHom
open SheafOfModules.RingedSite

noncomputable section

universe uC vC uD vD w

open RingedSite.Hom.ModuleDerived

namespace RingedSite.ToposHom.modulePushforwardDerived

variable {C : Type uC} [Category.{vC} C]
variable {D : Type uD} [Category.{vD} D]
variable {JC : GrothendieckTopology C} {JD : GrothendieckTopology D}
variable [JC.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
variable [JD.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
variable {O : Sheaf JC CommRingCat.{w}} {O' : Sheaf JD CommRingCat.{w}}
variable [UnivLE.{max uC vC, w}] [UnivLE.{max uD vD, w}]
variable [∀ X : C, HasWeakSheafify (JC.over X) AddCommGrpCat.{w}]
variable [∀ X : C, (JC.over X).WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- Lemma 52.6.19: for a finite-type ideal `I` and the ideal `I'` generated by the image of
`f^sharp (f⁻¹ I)`, derived pushforward carries a derived completion map along `I'` to one
along `I`. -/
@[stacks 0A0G]
theorem map_isDerivedCompletion
    (f : ToposHom (ofCommRingSheaf JD O') (ofCommRingSheaf JC O))
    [f.HasModulePushforwardDerived]
    (I : Subobject (unitModule JC O)) (I' : Subobject (unitModule JD O'))
    [(I : ringedSiteModuleCategory JC O).IsFiniteType]
    (hI' : IsLeast
      { J' : Subobject (unitModule JD O') | mapsIdeal.{uC, vC, uD, vD, w} f I J' } I')
    {K Khat : RingedSite.Hom.ModuleDerived.{w} (ofCommRingSheaf JD O')}
    (η : K ⟶ Khat)
    (hη : IsDerivedCompletion.{uD, vD, w, w} I' η) :
    IsDerivedCompletion.{uC, vC, w, w} I
      ((RingedSite.ToposHom.modulePushforwardDerived f).map η) := sorry

end RingedSite.ToposHom.modulePushforwardDerived
