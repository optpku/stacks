module

public import ReasLib.CategoryTheory.Sites.Point.Reindexing.Fiber
public import ReasLib.CategoryTheory.Sites.Point.Reindexing.OrderEmbedding.Basic

/-!
# Fiber maps for order-embedding reindexing

This module specializes neutral inverse-system fiber reindexing to functors
induced by order embeddings, including canonical-universe conveniences.
-/

@[expose] public section

open CategoryTheory Opposite

universe u v q w₀ w₁ w₂

noncomputable section

namespace CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered.Reindexing.OrderEmbedding

variable {C : Type u} [Category.{v} C]
variable {ι : Type w₀} [Preorder ι]
variable {ι' : Type w₁} [Preorder ι']
variable {S : ιᵒᵖ ⥤ C}

section ExplicitUniverse

variable [LocallySmall.{q} C]
variable [InitiallySmall.{q} ιᵒᵖ] [InitiallySmall.{q} ι'ᵒᵖ]

/-- The inverse-system fiber map induced by an order-embedding reindexing. -/
noncomputable abbrev fiber
    (j : ι ↪o ι') (T : ι'ᵒᵖ ⥤ C) (e : S ≅ (j.toOrderHom.toFunctor).op ⋙ T) :
    ofIsCofiltered.fiber.{q} S ⟶ ofIsCofiltered.fiber.{q} T :=
  Reindexing.fiber j.toOrderHom.toFunctor T e

namespace fiber

namespace app

/-- The order-embedding fiber map takes each canonical source generator to the corresponding
target generator. -/
@[simp]
theorem fiberMk
    (j : ι ↪o ι') (T : ι'ᵒᵖ ⥤ C) (e : S ≅ (j.toOrderHom.toFunctor).op ⋙ T)
    {U : ιᵒᵖ} {W : C} (f : S.obj U ⟶ W) :
    (OrderEmbedding.fiber j T e).app W (ofIsCofiltered.fiberMk.{q} f) =
      ofIsCofiltered.fiberMk.{q} (p := T) (e.inv.app U ≫ f) := sorry

end app

/-- The identity order-embedding reindexing induces the identity map on inverse-system fibers. -/
@[simp]
theorem id (S : ιᵒᵖ ⥤ C) :
    OrderEmbedding.fiber (OrderEmbedding.id ι) S (idIso S) =
      𝟙 (ofIsCofiltered.fiber.{q} S) := sorry

section Composition

variable {ι'' : Type w₂} [Preorder ι'']
variable [InitiallySmall.{q} ι''ᵒᵖ]
variable {T : ι'ᵒᵖ ⥤ C} {U : ι''ᵒᵖ ⥤ C}

/-- Fiber maps of successive order-embedding reindexings compose canonically. -/
@[simp]
theorem comp
    (j : ι ↪o ι') (k : ι' ↪o ι'')
    (e : S ≅ (j.toOrderHom.toFunctor).op ⋙ T)
    (e' : T ≅ (k.toOrderHom.toFunctor).op ⋙ U) :
    OrderEmbedding.fiber (j.comp k) U (compIso j k e e') =
      OrderEmbedding.fiber j T e ≫ OrderEmbedding.fiber k U e' := sorry

end Composition

end fiber

end ExplicitUniverse

section CanonicalUniverse

variable [LocallySmall.{max u v w₀ w₁} C]
variable [InitiallySmall.{max u v w₀ w₁} ιᵒᵖ]
  [InitiallySmall.{max u v w₀ w₁} ι'ᵒᵖ]

/-- The order-embedding fiber map in the canonical universe generated by the ambient category and
the two index preorders. This is the ergonomic interface when no separate fiber universe is
mathematically significant; use `fiber` to prescribe one explicitly. -/
noncomputable abbrev fiberMax
    (j : ι ↪o ι') (T : ι'ᵒᵖ ⥤ C) (e : S ≅ (j.toOrderHom.toFunctor).op ⋙ T) :
    ofIsCofiltered.fiber.{max u v w₀ w₁} S ⟶
      ofIsCofiltered.fiber.{max u v w₀ w₁} T :=
  fiber.{u, v, max u v w₀ w₁, w₀, w₁} j T e

namespace fiberMax

namespace app

/-- The canonical-universe order-embedding map transports canonical inverse-system fiber
generators along the supplied restriction isomorphism. -/
@[simp]
theorem fiberMk
    (j : ι ↪o ι') (T : ι'ᵒᵖ ⥤ C) (e : S ≅ (j.toOrderHom.toFunctor).op ⋙ T)
    {U : ιᵒᵖ} {W : C} (f : S.obj U ⟶ W) :
    (fiberMax j T e).app W (ofIsCofiltered.fiberMk.{max u v w₀ w₁} f) =
      ofIsCofiltered.fiberMk.{max u v w₀ w₁} (p := T) (e.inv.app U ≫ f) := sorry

end app

end fiberMax

end CanonicalUniverse

section CanonicalUniverseComposition

variable {ι : Type w₀} [Preorder ι]
variable {ι' : Type w₀} [Preorder ι']
variable {S : ιᵒᵖ ⥤ C}
variable [LocallySmall.{max u v w₀} C]
variable [InitiallySmall.{max u v w₀} ιᵒᵖ]
  [InitiallySmall.{max u v w₀} ι'ᵒᵖ]

namespace fiberMax

/-- Identity reindexing acts as the identity through the canonical-universe order-embedding
interface. This same-index-universe form is composable for ordinary directed inverse systems. -/
@[simp]
theorem id (S : ιᵒᵖ ⥤ C) :
    fiberMax (OrderEmbedding.id ι) S (idIso S) =
      𝟙 (ofIsCofiltered.fiber.{max u v w₀} S) := sorry

section Composition

variable {ι'' : Type w₀} [Preorder ι'']
variable [InitiallySmall.{max u v w₀} ι''ᵒᵖ]
variable {T : ι'ᵒᵖ ⥤ C} {U : ι''ᵒᵖ ⥤ C}

/-- Canonical-universe maps of successive same-universe order-embedding reindexings compose.
For genuinely different index universes, use `fiber` at one explicit common fiber universe. -/
@[simp]
theorem comp
    (j : ι ↪o ι') (k : ι' ↪o ι'')
    (e : S ≅ (j.toOrderHom.toFunctor).op ⋙ T)
    (e' : T ≅ (k.toOrderHom.toFunctor).op ⋙ U) :
    fiberMax (j.comp k) U (compIso j k e e') =
      fiberMax j T e ≫ fiberMax k U e' := sorry

end Composition

end fiberMax

end CanonicalUniverseComposition

end CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered.Reindexing.OrderEmbedding
