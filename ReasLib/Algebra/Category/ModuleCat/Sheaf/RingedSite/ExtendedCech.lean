module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.Restriction
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.ChangeOfRings
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.Flat
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.Ideal.Quotient
public import ReasLib.Algebra.Category.Ring.Sheaf.Localization
public import ReasLib.AlgebraicTopology.Cech.OrderedIndex
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Free
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.PullbackFree
public import Mathlib.Algebra.Homology.Augment
public import Mathlib.Algebra.Homology.QuasiIso

/-!
# Extended Čech complexes on a ringed site

This file constructs the extended alternating Čech complex of a finite family of global
sections of a sheaf of commutative rings.  It also constructs the canonical comparison after a
change of structure sheaf, with the target complex regarded as a complex of source modules by
restriction of scalars.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open scoped BigOperators

noncomputable section

universe u

namespace SheafOfModules.RingedSite.ExtendedCech

variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})]
variable [J.HasSheafCompose (forget₂ RingCat.{u} AddCommGrpCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable [HasWeakSheafify J CommRingCat.{u}]
variable [J.WEqualsLocallyBijective CommRingCat.{u}]
variable {O O' : Sheaf J CommRingCat.{u}} {r : ℕ}

/-- The arrow from the finite free module sheaf classified by a family of global sections.
Its bundled source keeps the universe lift used by the free construction internal. -/
noncomputable def familyMap
    (f : Fin r → (unitModule J O).sections) :
    Arrow (ringedSiteModuleCategory J O) :=
  Arrow.mk ((unitModule J O).freeHomEquiv.symm
    (fun i : ULift.{u} (Fin r) ↦ f i.down))

/-- The inclusion of the `i`th free generator into the source of `familyMap f`. -/
noncomputable def familyGenerator
    (f : Fin r → (unitModule J O).sections) (i : Fin r) :
    unitModule J O ⟶ (familyMap f).left :=
  ιFree (ULift.up i)

/-- Composing the `i`th free generator with `familyMap f` recovers the section `f i`. -/
theorem familyGenerator_comp (f : Fin r → (unitModule J O).sections) (i : Fin r) :
    familyGenerator f i ≫ (familyMap f).hom =
      (unitModule J O).unitHomEquiv.symm (f i) := sorry

/-- The ideal sheaf generated by a finite family of global sections. -/
noncomputable def generatedIdeal
    (f : Fin r → (unitModule J O).sections) : Subobject (unitModule J O) :=
  imageSubobject (familyMap f).hom

/-- The generated ideal is the image of the map from the finite free module sheaf classified
by the given family of global sections. -/
theorem generatedIdeal_eq_image
    (f : Fin r → (unitModule J O).sections) :
    generatedIdeal f = imageSubobject (familyMap f).hom := sorry

/-- The value of a global structure-module section, regarded in the corresponding local
section ring. -/
def sectionValue (s : (unitModule J O).sections) (U : Cᵒᵖ) : O.obj.obj U :=
  s.val U

/-- `sectionValue` is evaluation of the underlying compatible family. -/
theorem sectionValue_eq (s : (unitModule J O).sections) (U : Cᵒᵖ) :
    sectionValue s U = s.val U := sorry

/-- The compatible family of powers of a global section on all objects of the site. -/
def principalSubmonoid (s : (unitModule J O).sections) :
    Presheaf.SubmonoidPresheaf O.obj :=
  Presheaf.SubmonoidPresheaf.mk
    (fun U ↦ Submonoid.powers (sectionValue s U)) (by sorry)

/-- A local section belongs to `principalSubmonoid s` exactly when it is a power of the
restriction of `s`. -/
theorem mem_principalSubmonoid_iff (s : (unitModule J O).sections)
    (U : Cᵒᵖ) (x : O.obj.obj U) :
    x ∈ (principalSubmonoid s).obj U ↔ ∃ n : ℕ, sectionValue s U ^ n = x := sorry

/-- The sheaf of rings obtained by inverting a global section. -/
noncomputable def principalLocalization (s : (unitModule J O).sections) :
    Sheaf J CommRingCat.{u} :=
  (principalSubmonoid s).localizationSheaf

/-- The principal localization is the canonical localization sheaf of the powers of `s`. -/
theorem principalLocalization_eq (s : (unitModule J O).sections) :
    principalLocalization s = (principalSubmonoid s).localizationSheaf := sorry

/-- The principal localization, regarded as a module over the original structure sheaf. -/
noncomputable def principalModule (s : (unitModule J O).sections) :
    ringedSiteModuleCategory J O :=
  (restrictionAlong (principalSubmonoid s).toLocalizationSheaf).obj
    (unitModule J (principalLocalization s))

/-- The underlying module of a principal localization is restriction of its structure module
along the canonical localization map. -/
theorem principalModule_eq (s : (unitModule J O).sections) :
    principalModule s =
      (restrictionAlong (principalSubmonoid s).toLocalizationSheaf).obj
        (unitModule J (principalLocalization s)) := sorry

/-- The canonical module map from the structure sheaf to a principal localization. -/
noncomputable def principalMap (s : (unitModule J O).sections) :
    unitModule J O ⟶ principalModule s :=
  SheafOfModules.unitToPushforwardObjUnit
    (ChangeOfRings.homOverId
      (ringSheafMap (principalSubmonoid s).toLocalizationSheaf))

/-- The principal localization map is the module map induced by the canonical ring-sheaf
localization map. -/
theorem principalMap_eq (s : (unitModule J O).sections) :
    principalMap s =
      SheafOfModules.unitToPushforwardObjUnit
        (ChangeOfRings.homOverId
          (ringSheafMap (principalSubmonoid s).toLocalizationSheaf)) := sorry

/-- Multiplication of a finite ordered tuple of global sections is compatible with restriction. -/
theorem familyProduct_naturality (f : Fin r → (unitModule J O).sections) {p : ℕ}
    (σ : OrderedCechIndex (Fin r) p) (U V : Cᵒᵖ) (g : U ⟶ V) :
    (unitModule J O).val.map g
        (∏ j, sectionValue (f (σ j)) U : O.obj.obj U) =
      (∏ j, sectionValue (f (σ j)) V : O.obj.obj V) := sorry

/-- The product of the sections selected by a strictly increasing Čech tuple. -/
def familyProduct (f : Fin r → (unitModule J O).sections) {p : ℕ}
    (σ : OrderedCechIndex (Fin r) p) : (unitModule J O).sections :=
  PresheafOfModules.sectionsMk
    (fun U ↦ (∏ j, sectionValue (f (σ j)) U : O.obj.obj U))
    (fun {U V} g ↦ familyProduct_naturality f σ U V g)

/-- The value of a tuple product is the product of the values of its entries. -/
theorem familyProduct_apply (f : Fin r → (unitModule J O).sections) {p : ℕ}
    (σ : OrderedCechIndex (Fin r) p) (U : Cᵒᵖ) :
    (familyProduct f σ).val U =
      (∏ j, sectionValue (f (σ j)) U : O.obj.obj U) := sorry

/-- The localization at a tuple product receives the localization at a deleted tuple product. -/
theorem faceLocalization_inverts (f : Fin r → (unitModule J O).sections) (p : ℕ)
    (σ : OrderedCechIndex (Fin r) (p + 1)) (j : Fin (p + 2)) :
    (principalSubmonoid (familyProduct f (σ.delete j))).Inverts
      (principalSubmonoid (familyProduct f σ)).toLocalizationSheaf := sorry

/-- Restriction from the localization at a deleted tuple product to the localization at the
full tuple product. -/
noncomputable def principalLocalizationFaceMap
    (f : Fin r → (unitModule J O).sections) (p : ℕ)
    (σ : OrderedCechIndex (Fin r) (p + 1)) (j : Fin (p + 2)) :
    principalLocalization (familyProduct f (σ.delete j)) ⟶
      principalLocalization (familyProduct f σ) :=
  Presheaf.SubmonoidPresheaf.LocalizationSheaf.lift
    (principalSubmonoid (familyProduct f (σ.delete j)))
    (principalSubmonoid (familyProduct f σ)).toLocalizationSheaf
    (faceLocalization_inverts f p σ j)

/-- The localization restriction map factors the canonical map from the structure sheaf. -/
theorem principalLocalizationFaceMap_comm
    (f : Fin r → (unitModule J O).sections) (p : ℕ)
    (σ : OrderedCechIndex (Fin r) (p + 1)) (j : Fin (p + 2)) :
    (principalSubmonoid (familyProduct f (σ.delete j))).toLocalizationSheaf ≫
        principalLocalizationFaceMap f p σ j =
      (principalSubmonoid (familyProduct f σ)).toLocalizationSheaf := sorry

/-- The corresponding restriction between principal-localization module sheaves. -/
noncomputable def principalModuleFaceMap
    (f : Fin r → (unitModule J O).sections) (p : ℕ)
    (σ : OrderedCechIndex (Fin r) (p + 1)) (j : Fin (p + 2)) :
    principalModule (familyProduct f (σ.delete j)) ⟶
      principalModule (familyProduct f σ) :=
  (restrictionAlong
      (principalSubmonoid (familyProduct f (σ.delete j))).toLocalizationSheaf).map
      (SheafOfModules.unitToPushforwardObjUnit
        (ChangeOfRings.homOverId (ringSheafMap (principalLocalizationFaceMap f p σ j)))) ≫
    (SheafOfModules.Restriction.compComponentIso'
      (ringSheafMap
        (principalSubmonoid (familyProduct f (σ.delete j))).toLocalizationSheaf)
      (ringSheafMap (principalLocalizationFaceMap f p σ j))
      (ringSheafMap (principalSubmonoid (familyProduct f σ)).toLocalizationSheaf)
      (congrArg ringSheafMap (principalLocalizationFaceMap_comm f p σ j)).symm
      (unitModule J (principalLocalization (familyProduct f σ)))).hom

/-- Degree `p` of the positive alternating Čech complex is the finite product over strictly
increasing `(p + 1)`-tuples of the localization at the corresponding product of sections. -/
noncomputable def term (f : Fin r → (unitModule J O).sections) (p : ℕ) :
    ringedSiteModuleCategory J O :=
  ∏ᶜ fun σ : OrderedCechIndex (Fin r) p ↦ principalModule (familyProduct f σ)

/-- A Čech term is the stated product of principal-localization modules. -/
theorem term_def (f : Fin r → (unitModule J O).sections) (p : ℕ) :
    term f p =
      ∏ᶜ fun σ : OrderedCechIndex (Fin r) p ↦ principalModule (familyProduct f σ) := sorry

/-- The coface deleting position `j`, followed by localization to the full tuple product. -/
noncomputable def coface (f : Fin r → (unitModule J O).sections)
    (p : ℕ) (j : Fin (p + 2)) : term f p ⟶ term f (p + 1) :=
  Pi.lift fun σ : OrderedCechIndex (Fin r) (p + 1) ↦
    Pi.π (fun τ : OrderedCechIndex (Fin r) p ↦
      principalModule (familyProduct f τ)) (σ.delete j) ≫
        principalModuleFaceMap f p σ j

/-- The alternating differential is the signed sum of the localization cofaces. -/
noncomputable def differential (f : Fin r → (unitModule J O).sections) (p : ℕ) :
    term f p ⟶ term f (p + 1) :=
  ∑ j : Fin (p + 2), (-1 : ℤ) ^ (j : ℕ) • coface f p j

/-- Consecutive explicit alternating localization differentials compose to zero. -/
theorem differential_comp (f : Fin r → (unitModule J O).sections) (p : ℕ) :
    differential f p ≫ differential f (p + 1) = 0 := sorry

/-- The canonical map from the structure module to the product of one-section localizations. -/
noncomputable def augmentationMap (f : Fin r → (unitModule J O).sections) :
    unitModule J O ⟶ term f 0 :=
  Pi.lift fun σ : OrderedCechIndex (Fin r) 0 ↦ principalMap (familyProduct f σ)

/-- The augmentation is killed by the first alternating differential. -/
theorem augmentationMap_comp_differential
    (f : Fin r → (unitModule J O).sections) :
    augmentationMap f ≫ differential f 0 = 0 := sorry

/-- The objects of the extended alternating Čech complex, with the structure module in degree
zero and the `(n + 1)`-fold localization product in degree `n + 1`. -/
noncomputable def extendedTerm (f : Fin r → (unitModule J O).sections) :
    ℕ → ringedSiteModuleCategory J O
  | 0 => unitModule J O
  | p + 1 => term f p

/-- The differentials of the extended alternating Čech complex. -/
noncomputable def extendedDifferential (f : Fin r → (unitModule J O).sections) :
    (n : ℕ) → extendedTerm f n ⟶ extendedTerm f (n + 1)
  | 0 => augmentationMap f
  | p + 1 => differential f p

/-- Consecutive differentials in the extended alternating Čech complex compose to zero. -/
theorem extendedDifferential_comp
    (f : Fin r → (unitModule J O).sections) (n : ℕ) :
    extendedDifferential f n ≫ extendedDifferential f (n + 1) = 0 := sorry

/-- The explicit extended alternating Čech complex of a finite ordered family of sections. -/
noncomputable def complex (f : Fin r → (unitModule J O).sections) :
    CochainComplex (ringedSiteModuleCategory J O) ℕ :=
  CochainComplex.of (extendedTerm f) (extendedDifferential f)
    (extendedDifferential_comp f)

/-- Degree zero of the extended Čech complex is the structure module. -/
theorem complex_X_zero (f : Fin r → (unitModule J O).sections) :
    (complex f).X 0 = unitModule J O := sorry

/-- Degree `p + 1` is the product over strictly increasing `(p + 1)`-tuples. -/
theorem complex_X_succ (f : Fin r → (unitModule J O).sections) (p : ℕ) :
    (complex f).X (p + 1) = term f p := sorry

/-- The image of a global section is compatible with restriction maps. -/
theorem imageSection_naturality (alpha : O ⟶ O')
    (s : (unitModule J O).sections) (U V : Cᵒᵖ) (g : U ⟶ V) :
    (unitModule J O').val.map g (alpha.hom.app U (sectionValue s U)) =
      alpha.hom.app V (sectionValue s V) := sorry

/-- The image of one global section under a morphism of structure sheaves. -/
def imageSection (alpha : O ⟶ O') (s : (unitModule J O).sections) :
    (unitModule J O').sections :=
  PresheafOfModules.sectionsMk (fun U ↦ alpha.hom.app U (sectionValue s U))
    (fun {U V} g ↦ imageSection_naturality alpha s U V g)

/-- The image section is obtained by applying the sheaf morphism objectwise. -/
theorem imageSection_apply (alpha : O ⟶ O')
    (s : (unitModule J O).sections) (U : Cᵒᵖ) :
    (imageSection alpha s).val U = alpha.hom.app U (sectionValue s U) := sorry

/-- The image of a finite family of global sections under a morphism of structure sheaves. -/
def imageFamily (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) :
    Fin r → (unitModule J O').sections :=
  fun i ↦ imageSection alpha (f i)

/-- The `i`th image-family section is obtained by applying `alpha` objectwise. -/
theorem imageFamily_apply (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) (i : Fin r) (U : Cᵒᵖ) :
    (imageFamily alpha f i).val U = alpha.hom.app U (sectionValue (f i) U) := sorry

/-- Applying `alpha` to a tuple product equals the tuple product of the image family. -/
theorem imageSection_familyProduct (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) {p : ℕ}
    (σ : OrderedCechIndex (Fin r) p) :
    imageSection alpha (familyProduct f σ) = familyProduct (imageFamily alpha f) σ := sorry

/-- The target principal localization receives the source localization map after applying
`alpha`. -/
theorem imageLocalization_inverts (alpha : O ⟶ O')
    (s : (unitModule J O).sections) :
    (principalSubmonoid s).Inverts
      (alpha ≫ (principalSubmonoid (imageSection alpha s)).toLocalizationSheaf) := sorry

/-- The canonical morphism between principal localization sheaves induced by `alpha`. -/
noncomputable def principalLocalizationMap (alpha : O ⟶ O')
    (s : (unitModule J O).sections) :
    principalLocalization s ⟶ principalLocalization (imageSection alpha s) :=
  Presheaf.SubmonoidPresheaf.LocalizationSheaf.lift (principalSubmonoid s)
    (alpha ≫ (principalSubmonoid (imageSection alpha s)).toLocalizationSheaf)
    (imageLocalization_inverts alpha s)

/-- The localization comparison factors the morphism of structure sheaves. -/
theorem localizationMap_comm (alpha : O ⟶ O')
    (s : (unitModule J O).sections) :
    (principalSubmonoid s).toLocalizationSheaf ≫ principalLocalizationMap alpha s =
      alpha ≫ (principalSubmonoid (imageSection alpha s)).toLocalizationSheaf := sorry

/-- The corresponding square of underlying ring-sheaf maps commutes. -/
theorem localizationRingMap_comm (alpha : O ⟶ O')
    (s : (unitModule J O).sections) :
    ringSheafMap (principalSubmonoid s).toLocalizationSheaf ≫
        ringSheafMap (principalLocalizationMap alpha s) =
      ringSheafMap alpha ≫
        ringSheafMap (principalSubmonoid (imageSection alpha s)).toLocalizationSheaf := sorry

/-- A target principal localization, restricted directly to a module over the source sheaf. -/
noncomputable def restrictedPrincipalModule (alpha : O ⟶ O')
    (s : (unitModule J O').sections) : ringedSiteModuleCategory J O :=
  (restrictionAlong (alpha ≫ (principalSubmonoid s).toLocalizationSheaf)).obj
    (unitModule J (principalLocalization s))

/-- The restricted target localization uses the composite coefficient morphism. -/
theorem restrictedPrincipalModule_eq (alpha : O ⟶ O')
    (s : (unitModule J O').sections) :
    restrictedPrincipalModule alpha s =
      (restrictionAlong (alpha ≫ (principalSubmonoid s).toLocalizationSheaf)).obj
        (unitModule J (principalLocalization s)) := sorry

/-- The source-to-target comparison between corresponding principal-localization modules. -/
noncomputable def principalModuleMap (alpha : O ⟶ O')
    (s : (unitModule J O).sections) :
    principalModule s ⟶ restrictedPrincipalModule alpha (imageSection alpha s) :=
  (restrictionAlong (principalSubmonoid s).toLocalizationSheaf).map
      (SheafOfModules.unitToPushforwardObjUnit
        (ChangeOfRings.homOverId (ringSheafMap (principalLocalizationMap alpha s)))) ≫
    (SheafOfModules.Restriction.compComponentIso'
      (ringSheafMap (principalSubmonoid s).toLocalizationSheaf)
      (ringSheafMap (principalLocalizationMap alpha s))
      (ringSheafMap alpha ≫
        ringSheafMap (principalSubmonoid (imageSection alpha s)).toLocalizationSheaf)
      (localizationRingMap_comm alpha s).symm
      (unitModule J (principalLocalization (imageSection alpha s)))).hom

/-- The comparison for a tuple product lands in the localization at the product of its images. -/
noncomputable def principalModuleTupleMap (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) {p : ℕ}
    (σ : OrderedCechIndex (Fin r) p) :
    principalModule (familyProduct f σ) ⟶
      restrictedPrincipalModule alpha (familyProduct (imageFamily alpha f) σ) :=
  principalModuleMap alpha (familyProduct f σ) ≫
    eqToHom (congrArg (restrictedPrincipalModule alpha)
      (imageSection_familyProduct alpha f σ))

/-- The target structure module restricted along `alpha`. -/
noncomputable def targetUnit (alpha : O ⟶ O') : ringedSiteModuleCategory J O :=
  (restrictionAlong alpha).obj (unitModule J O')

/-- The target unit module is restriction of the target structure module along `alpha`. -/
theorem targetUnit_eq (alpha : O ⟶ O') :
    targetUnit alpha = (restrictionAlong alpha).obj (unitModule J O') := sorry

/-- The structure-sheaf morphism as a map to the restricted target structure module. -/
noncomputable def unitMap (alpha : O ⟶ O') : unitModule J O ⟶ targetUnit alpha :=
  SheafOfModules.unitToPushforwardObjUnit
    (ChangeOfRings.homOverId (ringSheafMap alpha))

/-- The unit comparison is the module map induced by `alpha`. -/
theorem unitMap_eq (alpha : O ⟶ O') :
    unitMap alpha = SheafOfModules.unitToPushforwardObjUnit
      (ChangeOfRings.homOverId (ringSheafMap alpha)) := sorry

/-- Restriction of the target localization map along `alpha`. -/
noncomputable def restrictedPrincipalModuleFaceMap (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O').sections) (p : ℕ)
    (σ : OrderedCechIndex (Fin r) (p + 1)) (j : Fin (p + 2)) :
    restrictedPrincipalModule alpha (familyProduct f (σ.delete j)) ⟶
      restrictedPrincipalModule alpha (familyProduct f σ) :=
  (SheafOfModules.Restriction.compIso
      (ringSheafMap alpha)
      (ringSheafMap
        (principalSubmonoid (familyProduct f (σ.delete j))).toLocalizationSheaf)).inv.app
      (unitModule J (principalLocalization (familyProduct f (σ.delete j)))) ≫
    (restrictionAlong alpha).map (principalModuleFaceMap f p σ j) ≫
    (SheafOfModules.Restriction.compIso
      (ringSheafMap alpha)
      (ringSheafMap (principalSubmonoid (familyProduct f σ)).toLocalizationSheaf)).hom.app
      (unitModule J (principalLocalization (familyProduct f σ)))

/-- Degree `p` of the target complex is the product of the localizations at the tuple products
of `imageFamily alpha f`, restricted along `alpha`. -/
noncomputable def targetTerm (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) (p : ℕ) :
    ringedSiteModuleCategory J O :=
  ∏ᶜ fun σ : OrderedCechIndex (Fin r) p ↦
    restrictedPrincipalModule alpha (familyProduct (imageFamily alpha f) σ)

/-- The target coface is the product of the restricted localization maps after deleting `j`. -/
noncomputable def targetCoface (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) (p : ℕ) (j : Fin (p + 2)) :
    targetTerm alpha f p ⟶ targetTerm alpha f (p + 1) :=
  Pi.lift fun σ : OrderedCechIndex (Fin r) (p + 1) ↦
    Pi.π (fun τ : OrderedCechIndex (Fin r) p ↦
      restrictedPrincipalModule alpha (familyProduct (imageFamily alpha f) τ))
        (σ.delete j) ≫
      restrictedPrincipalModuleFaceMap alpha (imageFamily alpha f) p σ j

/-- The target alternating differential after restriction of scalars. -/
noncomputable def targetDifferential (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) (p : ℕ) :
    targetTerm alpha f p ⟶ targetTerm alpha f (p + 1) :=
  ∑ j : Fin (p + 2), (-1 : ℤ) ^ (j : ℕ) • targetCoface alpha f p j

/-- Consecutive target alternating differentials compose to zero. -/
theorem targetDifferential_comp (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) (p : ℕ) :
    targetDifferential alpha f p ≫ targetDifferential alpha f (p + 1) = 0 := sorry

/-- The target augmentation is the product of the localized structure maps, restricted along
`alpha`. -/
noncomputable def targetAugmentationMap (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) :
    targetUnit alpha ⟶ targetTerm alpha f 0 :=
  Pi.lift fun σ : OrderedCechIndex (Fin r) 0 ↦
    (restrictionAlong alpha).map (principalMap (familyProduct (imageFamily alpha f) σ)) ≫
      (SheafOfModules.Restriction.compIso
        (ringSheafMap alpha)
        (ringSheafMap
          (principalSubmonoid
            (familyProduct (imageFamily alpha f) σ)).toLocalizationSheaf)).hom.app
        (unitModule J (principalLocalization (familyProduct (imageFamily alpha f) σ)))

/-- The target augmentation is killed by its first alternating differential. -/
theorem targetAugmentationMap_comp_differential (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) :
    targetAugmentationMap alpha f ≫ targetDifferential alpha f 0 = 0 := sorry

/-- Objects of the restricted target extended Čech complex. -/
noncomputable def targetExtendedTerm (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) :
    ℕ → ringedSiteModuleCategory J O
  | 0 => targetUnit alpha
  | p + 1 => targetTerm alpha f p

/-- Differentials of the restricted target extended Čech complex. -/
noncomputable def targetExtendedDifferential (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) :
    (n : ℕ) → targetExtendedTerm alpha f n ⟶ targetExtendedTerm alpha f (n + 1)
  | 0 => targetAugmentationMap alpha f
  | p + 1 => targetDifferential alpha f p

/-- Consecutive differentials in the restricted target extended complex compose to zero. -/
theorem targetExtendedDifferential_comp (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) (n : ℕ) :
    targetExtendedDifferential alpha f n ≫
      targetExtendedDifferential alpha f (n + 1) = 0 := sorry

/-- The explicit target Čech complex of `imageFamily alpha f`, restricted along `alpha`. -/
noncomputable def targetComplex (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) :
    CochainComplex (ringedSiteModuleCategory J O) ℕ :=
  CochainComplex.of (targetExtendedTerm alpha f) (targetExtendedDifferential alpha f)
    (targetExtendedDifferential_comp alpha f)

/-- Degree zero of the target complex is the restricted target structure module. -/
theorem targetComplex_X_zero (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) :
    (targetComplex alpha f).X 0 = targetUnit alpha := sorry

/-- Degree `p + 1` of the target complex is the restricted product of localizations at the
strictly increasing tuple products of `imageFamily alpha f`. -/
theorem targetComplex_X_succ (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) (p : ℕ) :
    (targetComplex alpha f).X (p + 1) = targetTerm alpha f p := sorry

/-- The comparison on positive degree `p + 1`, defined componentwise by the localization
universal property. -/
noncomputable def termMap (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) (p : ℕ) :
    term f p ⟶ targetTerm alpha f p :=
  Pi.lift fun σ : OrderedCechIndex (Fin r) p ↦
    Pi.π (fun τ : OrderedCechIndex (Fin r) p ↦
      principalModule (familyProduct f τ)) σ ≫
        principalModuleTupleMap alpha f σ

/-- The degreewise components of the canonical map of extended alternating Čech complexes. -/
noncomputable def mapComponent (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) :
    (n : ℕ) → (complex f).X n ⟶ (targetComplex alpha f).X n
  | 0 => unitMap alpha
  | p + 1 => termMap alpha f p

/-- The degreewise comparison maps commute with the explicit alternating differentials. -/
theorem mapComponent_comm (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) (i j : ℕ)
    (hij : (ComplexShape.up ℕ).Rel i j) :
    mapComponent alpha f i ≫ (targetComplex alpha f).d i j =
      (complex f).d i j ≫ mapComponent alpha f j := sorry

/-- The canonical map from the explicit source Čech complex to the restricted target complex. -/
noncomputable def map (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) :
    complex f ⟶ targetComplex alpha f :=
  HomologicalComplex.Hom.mk (mapComponent alpha f) (mapComponent_comm alpha f)

/-- The degree `n` component is the explicitly constructed localization comparison. -/
theorem map_f (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) (n : ℕ) :
    (map alpha f).f n = mapComponent alpha f n := sorry

/-- In degree zero, the canonical comparison is induced by `alpha`. -/
theorem map_f_zero (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) :
    (map alpha f).f 0 = unitMap alpha := sorry

/-- In degree `p + 1`, the comparison is the product of the maps supplied by the localization
universal property for each strictly increasing tuple. -/
theorem map_f_succ (alpha : O ⟶ O')
    (f : Fin r → (unitModule J O).sections) (p : ℕ) :
    (map alpha f).f (p + 1) = termMap alpha f p := sorry

/-- A flat morphism of sheaves of commutative rings that induces an isomorphism on the
quotients by a finite family of global sections induces a quasi-isomorphism from the extended
alternating Čech complex to the corresponding complex restricted along the morphism. -/
theorem map_quasiIso (alpha : O ⟶ O')
    (h_flat : IsFlatHom alpha)
    (f : Fin r → (unitModule J O).sections)
    [IsIso (IdealSheaf.TargetQuotient.ringMap alpha (generatedIdeal f))] :
    QuasiIso (map alpha f) := sorry

end SheafOfModules.RingedSite.ExtendedCech
