module

public import Mathlib.Algebra.Regular.SMul
public import Mathlib.RingTheory.DiscreteValuationRing.TFAE
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Principal Regular Maximal Ideals

This leaf supplies the local-ring bridge from a regular generator of the
maximal ideal to a domain, and then reuses Mathlib's DVR TFAE for the
domain-known principal-maximal-ideal step.
-/

universe u

namespace IsLocalRing

/-- Tag 00PD, principal-maximal-ideal direction: a Noetherian local domain
whose maximal ideal is generated by a nonzero element is a discrete valuation
ring. -/
@[stacks 00PD]
theorem isDiscreteValuationRing_of_principalMaximalIdeal
    {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R] [IsDomain R]
    {x : R} (hx : x ≠ 0)
    (hmaximal : maximalIdeal R = Ideal.span ({x} : Set R)) :
    IsDiscreteValuationRing R := sorry

end IsLocalRing

namespace IsSMulRegular

/-- In a Noetherian local ring, a regular generator of the maximal ideal
forces the ring to be a domain. -/
theorem isDomain_of_principalMaximalIdeal
    {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    {x : R} (hregular : IsSMulRegular R x)
    (hmaximal : IsLocalRing.maximalIdeal R = Ideal.span ({x} : Set R)) :
    IsDomain R := sorry

/-- A Noetherian local ring whose maximal ideal has a regular generator admits
both its canonical domain structure and its discrete valuation ring structure.
The structures are existentially packaged so this result does not create a
noncanonical global instance. -/
theorem exists_isDiscreteValuationRing_of_principalMaximalIdeal
    {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    {x : R} (hregular : IsSMulRegular R x)
    (hmaximal : IsLocalRing.maximalIdeal R = Ideal.span ({x} : Set R)) :
    ∃ (_ : IsDomain R), IsDiscreteValuationRing R := sorry

end IsSMulRegular
