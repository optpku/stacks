module

public import ReasLib.RingTheory.MvPowerSeries.Derivation
public import ReasLib.RingTheory.Extension.Cotangent.ExtOne
public import Mathlib.LinearAlgebra.FiniteDimensional.Defs
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.MvPowerSeries.Inverse

@[expose] public section

universe u

open IsLocalRing
open RingHom.SquareZeroExtension

namespace MvPowerSeries.Hypersurface

/-- The derivations of a formal power-series hypersurface defined by a nonzero element
of the square of the maximal ideal form a finite-dimensional vector space exactly when
there is one variable. -/
theorem finiteDimensional_derivation_iff {k : Type u} [Field k] {n : ℕ}
    (f : MvPowerSeries (Fin n) k) (hf_ne : f ≠ 0)
    (hf_sq : f ∈ maximalIdeal (MvPowerSeries (Fin n) k) ^ 2) :
    let P := MvPowerSeries (Fin n) k ⧸ Ideal.span {f}
    FiniteDimensional k (Derivation k P P) ↔ n = 1 := sorry

/-- The first naive-cotangent extension space of a formal power-series hypersurface
defined by a nonzero element of the square of the maximal ideal is finite-dimensional
if the radical of the ideal generated by the defining series and its formal partial
derivatives is the maximal ideal. -/
theorem finiteDimensional_extOneNaiveCotangent {k : Type u} [Field k] {n : ℕ}
    (f : MvPowerSeries (Fin n) k) (hf_ne : f ≠ 0)
    (hf_sq : f ∈ maximalIdeal (MvPowerSeries (Fin n) k) ^ 2)
    (hjac :
      Ideal.radical
          (Ideal.span ({f} ∪ Set.range fun i : Fin n ↦ MvPowerSeries.partialDeriv i f)) =
        maximalIdeal (MvPowerSeries (Fin n) k)) :
    let P := MvPowerSeries (Fin n) k ⧸ Ideal.span {f}
    FiniteDimensional k (extOneNaiveCotangent k P P) := sorry

end MvPowerSeries.Hypersurface
