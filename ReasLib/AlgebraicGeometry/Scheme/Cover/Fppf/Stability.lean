module

public import Mathlib.AlgebraicGeometry.Sites.Fpqc

/-!
# Stability of fppf covering families

This module provides the canonical isomorphism-covering instance for the fppf
precoverage and its concrete stability under pullback of indexed families.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits

universe u v w

namespace AlgebraicGeometry.Scheme

/-- Singleton presieves generated by isomorphisms cover for the fppf precoverage. -/
instance instFppfPrecoverageHasIsos : fppfPrecoverage.HasIsos := sorry

/-- Pulling an fppf covering family back along a scheme morphism is fppf-covering. -/
theorem fppfCovering_pullback {T T' : Scheme.{u}} {ι : Type v}
    {Tᵢ : ι → Scheme.{u}} (f : (i : ι) → Tᵢ i ⟶ T)
    (hf : Presieve.ofArrows Tᵢ f ∈ fppfPrecoverage.coverings T)
    (g : T' ⟶ T) :
    Presieve.ofArrows (fun i ↦ pullback g (f i))
      (fun i ↦ pullback.fst g (f i)) ∈ fppfPrecoverage.coverings T' := sorry

end AlgebraicGeometry.Scheme
