module

public import Mathlib.Algebra.Algebra.Prod
public import Mathlib.RingTheory.Idempotents
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic
public import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.Tactic.CrossRefAttribute

/-!
# Quotient decompositions of integral closures

This leaf owns the canonical comparison from the reduction of an integral closure to the
corresponding reduction of the ambient algebra.  It also records the product decomposition and
localization consequence of Zariski's Main Theorem used in Lemma 15.11.5.

@stack 09XH
-/

@[expose] public section

noncomputable section

universe u v w w'

namespace integralClosure

section QuotientMap

variable {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]

/-- Local instance justification (defeq pin): use the canonical quotient algebra structure on the
reduction of the integral closure while constructing its comparison map. -/
local instance integralClosureQuotientAlgebra (I : Ideal A) :
    Algebra (A ⧸ I)
      (integralClosure A B ⧸ Ideal.map (algebraMap A (integralClosure A B)) I) :=
  Ideal.Quotient.algebraQuotientOfLEComap Ideal.le_comap_map

/-- Local instance justification (defeq pin): use the matching canonical quotient algebra
structure on the ambient reduction. -/
local instance ambientQuotientAlgebra (I : Ideal A) :
    Algebra (A ⧸ I) (B ⧸ Ideal.map (algebraMap A B) I) :=
  Ideal.Quotient.algebraQuotientOfLEComap Ideal.le_comap_map

/-- Local instance justification (defeq pin): identify the composite scalar action on the
integral-closure quotient with its canonical quotient action. -/
local instance integralClosureQuotientScalarTower (I : Ideal A) :
    IsScalarTower A (A ⧸ I)
      (integralClosure A B ⧸ Ideal.map (algebraMap A (integralClosure A B)) I) :=
  IsScalarTower.of_algebraMap_eq' rfl

/-- Local instance justification (defeq pin): identify the matching composite scalar action on
the ambient quotient. -/
local instance ambientQuotientScalarTower (I : Ideal A) :
    IsScalarTower A (A ⧸ I) (B ⧸ Ideal.map (algebraMap A B) I) :=
  IsScalarTower.of_algebraMap_eq' rfl

/-- The ideal generated by `I` in `integralClosure A B` maps into the ideal generated by `I`
in `B`. -/
@[stacks 09XH "integral-closure quotient comparison"]
theorem idealMap_le_comap (I : Ideal A) :
    Ideal.map (algebraMap A (integralClosure A B)) I ≤
      Ideal.comap (integralClosure A B).val.toRingHom
        (Ideal.map (algebraMap A B) I) := sorry

/-- The canonical `(A ⧸ I)`-algebra map from the reduction of `integralClosure A B` to the
reduction of `B`. -/
@[stacks 09XH "integral-closure quotient map"]
noncomputable def quotientMap (I : Ideal A) :
    (integralClosure A B ⧸ Ideal.map (algebraMap A (integralClosure A B)) I) →ₐ[A ⧸ I]
      (B ⧸ Ideal.map (algebraMap A B) I) :=
  AlgHom.extendScalarsOfSurjective (Ideal.Quotient.mkₐ_surjective A I) <|
    Ideal.quotientMapₐ (Ideal.map (algebraMap A B) I) (integralClosure A B).val
      (by
        rw [Ideal.map_le_iff_le_comap]
        intro x hx
        simpa using Ideal.mem_map_of_mem (algebraMap A B) hx)

/-- The integral-closure quotient map sends the class of `x` to its class in the ambient
quotient. -/
@[simp, stacks 09XH "integral-closure quotient map on representatives"]
theorem quotientMap_mk (I : Ideal A) (x : integralClosure A B) :
    quotientMap (B := B) I
        (Ideal.Quotient.mk (Ideal.map (algebraMap A (integralClosure A B)) I) x) =
      Ideal.Quotient.mk (Ideal.map (algebraMap A B) I) ((integralClosure A B).val x) := sorry

end QuotientMap

end integralClosure

section ProductDecomposition

variable {A : Type u} {B : Type v} {C₁ : Type w} {C₂ : Type w'}
variable [CommRing A] [CommRing B] [CommRing C₁] [CommRing C₂] [Algebra A B]
variable (I : Ideal A) [Algebra (A ⧸ I) C₁] [Algebra (A ⧸ I) C₂]

local notation "Abar" => A ⧸ I
local notation "B'" => integralClosure A B
local notation "IB" => Ideal.map (algebraMap A B) I
local notation "IB'" => Ideal.map (algebraMap A B') I
local notation "Q" => B' ⧸ IB'

/-- Local instance justification (defeq pin): fix the canonical `(A ⧸ I)`-algebra structure on
the ambient quotient appearing in the given product decomposition. -/
local instance productAmbientQuotientAlgebra : Algebra Abar (B ⧸ IB) :=
  Ideal.Quotient.algebraQuotientOfLEComap Ideal.le_comap_map

/-- Local instance justification (defeq pin): fix the matching canonical `(A ⧸ I)`-algebra
structure on the integral-closure quotient. -/
local instance productIntegralClosureQuotientAlgebra : Algebra Abar Q :=
  Ideal.Quotient.algebraQuotientOfLEComap Ideal.le_comap_map

/-- Lemma 15.11.5 (09XH): if `A → B` is of finite type, `B ⧸ I B` decomposes as
`C₁ × C₂`, and `C₁` is finite over `A ⧸ I`, then the reduction of `integralClosure A B`
admits a compatible product decomposition.  An element selecting the first factor makes the
canonical away map from the integral closure to `B` bijective. -/
@[stacks 09XH "integral-closure quotient decomposition and localization"]
theorem exists_integralClosure_product_decomposition_mod_ideal_with_localization
    [Algebra.FiniteType A B] [Module.Finite Abar C₁]
    (hprod : (B ⧸ IB) ≃ₐ[Abar] (C₁ × C₂)) :
    ∃ (e : Q) (he : IsIdempotentElem e)
      (productDecomposition :
        Q ≃ₐ[Abar] (C₁ × (Q ⧸ Ideal.span ({1 - e} : Set Q))))
      (toSecondFactor : (Q ⧸ Ideal.span ({1 - e} : Set Q)) →ₐ[Abar] C₂) (g : B'),
        hprod.toAlgHom.comp (integralClosure.quotientMap I) =
            (AlgHom.prodMap (AlgHom.id Abar C₁) toSecondFactor).comp
              productDecomposition.toAlgHom ∧
          productDecomposition (Ideal.Quotient.mk IB' g) = (1, 0) ∧
          Function.Bijective (Localization.awayMapₐ (integralClosure A B).val g) := sorry

end ProductDecomposition
