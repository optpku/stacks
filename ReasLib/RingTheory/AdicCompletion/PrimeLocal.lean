module
public import Mathlib.RingTheory.AdicCompletion.Basic
public import ReasLib.RingTheory.Localization.AtPrime.Int

@[expose] public section
universe u
namespace IsAdicComplete
variable (p : ℕ) [Fact p.Prime] (A : Type u) [CommRing A]
variable [IsAdicComplete (Ideal.span {(p : A)}) A]

/-- Integers outside the prime ideal generated by p become units in a p-adically complete ring. -/
theorem isUnit_intCast_of_not_mem_prime (z : ℤ)
    (hz : z ∉ Ideal.span ({(p : ℤ)} : Set ℤ)) : IsUnit (z : A) := sorry

/-- The canonical map from the prime-local integers to a p-adically complete ring. -/
noncomputable def primeLocalMap :
    Localization.AtPrime (Ideal.span ({(p : ℤ)} : Set ℤ)) →+* A :=
  IsLocalization.lift (g := Int.castRingHom A) (M := (Ideal.span ({(p : ℤ)} : Set ℤ)).primeCompl)
    (fun z ↦ isUnit_intCast_of_not_mem_prime p A z.1 z.2)

/-- The prime-local map preserves the specified integer casts. -/
theorem primeLocalMap_intCast (z : ℤ) : primeLocalMap p A z = (z : A) := sorry

/-- P-adic completeness determines the canonical prime-local scalar structure. -/
noncomputable instance primeLocalAlgebra :
    Algebra (Localization.AtPrime (Ideal.span ({(p : ℤ)} : Set ℤ))) A :=
  (primeLocalMap p A).toAlgebra

end IsAdicComplete
