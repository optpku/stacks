module

public import Mathlib.RingTheory.Length
public import ReasLib.RingTheory.RegularLocalRing.Parameters
import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Completing and perturbing systems of parameters

This leaf owns two related operations in a Noetherian local ring: completing
a distinguished element to a system of parameters, and preserving that system
under sufficiently high-order perturbations of its head.

@stack 0BWU
@stack 0BWV
@stack 0BWY
-/

universe u

open IsLocalRing

namespace IsLocalRing.IsSystemOfParameters

variable {R : Type u} [CommRing R] [IsLocalRing R]

/-- The ideal generated by a parameter tail together with a ring-valued perturbation of its
head.  Keeping `h : R` matches the mathematical perturbation before it is repackaged as an
element of the maximal ideal. -/
@[stacks 0BWV "perturbed parameter ideal", stacks 0BWY "perturbed parameter ideal"]
def perturbedParameterIdeal {d : ℕ}
    (f : maximalIdeal R) (y : Fin d → maximalIdeal R) (h : R) : Ideal R :=
  Ideal.span (Set.range (Fin.cons ((f : R) + h) (fun i ↦ (y i : R))))

/-- High-order perturbations of the head leave the generated parameter ideal unchanged. -/
@[stacks 0BWV "head perturbation stability", stacks 0BWY "head perturbation stability"]
def StableUnderHeadPerturbation {d : ℕ}
    (f : maximalIdeal R) (y : Fin d → maximalIdeal R) (N : ℕ+) : Prop :=
  ∀ h : R, h ∈ maximalIdeal R ^ (N : ℕ) →
    perturbedParameterIdeal f y h = parameterIdeal (Fin.cons f y)

/-- The defining ideal equality for stability under high-order head perturbations. -/
@[stacks 0BWV "head perturbation stability specification",
  stacks 0BWY "head perturbation stability specification"]
theorem stableUnderHeadPerturbation_iff {d : ℕ}
    (f : maximalIdeal R) (y : Fin d → maximalIdeal R) (N : ℕ+) :
    StableUnderHeadPerturbation f y N ↔
      ∀ h : R, h ∈ maximalIdeal R ^ (N : ℕ) →
        perturbedParameterIdeal f y h = parameterIdeal (Fin.cons f y) := sorry
-- Proof strategy: unfold `StableUnderHeadPerturbation`; the right-hand side is
-- its defining predicate.

/-- A perturbation belonging to a positive power of the maximal ideal keeps the perturbed head
inside the maximal ideal. -/
@[stacks 0BWV "perturbed parameter head", stacks 0BWY "perturbed parameter head"]
theorem headPerturbation_mem
    (f : maximalIdeal R) {N : ℕ+} (h : R)
    (hh : h ∈ maximalIdeal R ^ (N : ℕ)) :
    (f : R) + h ∈ maximalIdeal R := sorry
-- Proof strategy: positivity of `N` gives
-- `maximalIdeal R ^ (N : ℕ) ≤ maximalIdeal R`; combine `hh` with `f.property`
-- and closure of the maximal ideal under addition.

/-- The maximal-ideal element represented by the perturbed head `f + h`. -/
@[stacks 0BWV "perturbed parameter head", stacks 0BWY "perturbed parameter head"]
def headPerturbation
    (f : maximalIdeal R) {N : ℕ+} (h : R)
    (hh : h ∈ maximalIdeal R ^ (N : ℕ)) : maximalIdeal R :=
  ⟨(f : R) + h, headPerturbation_mem f h hh⟩

/-- The perturbed head has the prescribed underlying ring element. -/
@[simp, stacks 0BWV "perturbed parameter head coercion",
  stacks 0BWY "perturbed parameter head coercion"]
theorem headPerturbation_coe
    (f : maximalIdeal R) {N : ℕ+} (h : R)
    (hh : h ∈ maximalIdeal R ^ (N : ℕ)) :
    (headPerturbation f h hh : R) = (f : R) + h := sorry
-- Proof strategy: unfold `headPerturbation`; this is the coercion of the
-- explicit subtype constructor.

/-- The ring-valued perturbed parameter ideal agrees with the bundled maximal-ideal family. -/
@[stacks 0BWV "perturbed parameter ideal comparison",
  stacks 0BWY "perturbed parameter ideal comparison"]
theorem parameterIdeal_headPerturbation {d : ℕ}
    (f : maximalIdeal R) (y : Fin d → maximalIdeal R) {N : ℕ+}
    (h : R) (hh : h ∈ maximalIdeal R ^ (N : ℕ)) :
    parameterIdeal (Fin.cons (headPerturbation f h hh) y) =
      perturbedParameterIdeal f y h := sorry
-- Proof strategy: unfold both parameter ideals, rewrite
-- `headPerturbation_coe`, and identify the two `Fin.cons` ranges.

namespace StableUnderHeadPerturbation

/-- Stability at order `N` implies stability at every higher perturbation order. -/
@[stacks 0BWV "monotonicity of head perturbation stability",
  stacks 0BWY "monotonicity of head perturbation stability"]
theorem mono {d : ℕ}
    {f : maximalIdeal R} {y : Fin d → maximalIdeal R} {N N' : ℕ+}
    (hstable : StableUnderHeadPerturbation f y N) (hNN' : N ≤ N') :
    StableUnderHeadPerturbation f y N' := sorry
-- Proof strategy: powers of the maximal ideal reverse the exponent order, so
-- a perturbation in `maximalIdeal R ^ (N' : ℕ)` also lies in the `N`th power;
-- apply `hstable`.

/-- A stable perturbation of a system of parameters is again a system of parameters. -/
@[stacks 0BWV "system of parameters after perturbation",
  stacks 0BWY "system of parameters after perturbation"]
theorem isSystemOfParameters {d : ℕ}
    {f : maximalIdeal R} {y : Fin d → maximalIdeal R} {N : ℕ+}
    (hstable : StableUnderHeadPerturbation f y N)
    (hsop : IsSystemOfParameters (Fin.cons f y))
    {h : R} (hh : h ∈ maximalIdeal R ^ (N : ℕ)) :
    IsSystemOfParameters (Fin.cons (headPerturbation f h hh) y) := sorry
-- Proof strategy: combine `hstable h hh` with
-- `parameterIdeal_headPerturbation`, then rewrite the ideal-of-definition
-- clause of `hsop` along the resulting parameter-ideal equality.

/-- Stable head perturbation preserves the length of the parameter quotient. -/
@[stacks 0BWV "parameter quotient length after perturbation",
  stacks 0BWY "parameter quotient length after perturbation"]
theorem length_eq {d : ℕ}
    {f : maximalIdeal R} {y : Fin d → maximalIdeal R} {N : ℕ+}
    (hstable : StableUnderHeadPerturbation f y N)
    {h : R} (hh : h ∈ maximalIdeal R ^ (N : ℕ)) :
    Module.length R (R ⧸ parameterIdeal (Fin.cons f y)) =
      Module.length R
        (R ⧸ parameterIdeal (Fin.cons (headPerturbation f h hh) y)) := sorry
-- Proof strategy: derive equality of the two parameter ideals from stability
-- and `parameterIdeal_headPerturbation`, use `Submodule.quotEquivOfEq`, and
-- transport module length across the resulting linear equivalence.

end StableUnderHeadPerturbation

variable [IsNoetherianRing R]

/-- A maximal-ideal element avoiding every minimal prime can be completed to a
system of parameters whose tail lies in any prescribed maximal-ideal power. -/
@[stacks 0BWU "completion to parameters in a maximal-ideal power"]
theorem exists_cons_mem_maximalIdeal_pow
    {d k : ℕ} (hdim : ringKrullDim R = d.succ) (f : maximalIdeal R)
    (hmin : ∀ p : minimalPrimes R, (f : R) ∉ p.1) :
    ∃ y : Fin d → maximalIdeal R,
      IsSystemOfParameters (Fin.cons f y) ∧
        ∀ j, (y j : R) ∈ maximalIdeal R ^ k := sorry
-- Proof strategy: quotient by the principal ideal generated by `f`; minimal
-- prime avoidance lowers the dimension by one.  Choose a length-`d` system of
-- parameters in that quotient, lift it to `maximalIdeal R`, and replace the
-- lifts by suitable `k`th powers.  The powered tail lies in the requested
-- maximal-ideal power and has the same generated radical after adjoining `f`.

/-- Lemma 15.126.3: in dimension `d + 1 > 1`, a maximal-ideal element avoiding every minimal
prime extends to a system of parameters with tail in any prescribed maximal-ideal power. -/
@[stacks 0BWU "Lemma 15.126.3, completion to parameters in a maximal-ideal power"]
theorem exists_cons_mem_maximalIdeal_pow_of_pos
    {d k : ℕ} (hdim : ringKrullDim R = d.succ) (hd : 0 < d)
    (f : maximalIdeal R) (hmin : ∀ p : minimalPrimes R, (f : R) ∉ p.1) :
    ∃ y : Fin d → maximalIdeal R,
      IsSystemOfParameters (Fin.cons f y) ∧
        ∀ j, (y j : R) ∈ maximalIdeal R ^ k := sorry
-- Proof strategy: apply `exists_cons_mem_maximalIdeal_pow`; `hd` records the
-- positive-tail source specialization but does not change the construction.

/-- Lemma 15.126.9: a maximal-ideal element avoiding every minimal prime extends to a system of
parameters stable, with unchanged quotient length, under sufficiently high-order perturbations. -/
@[stacks 0BWY "Lemma 15.126.9, stable parameter completion"]
theorem exists_cons_stable
    {d : ℕ} (hdim : ringKrullDim R = d.succ) (f : maximalIdeal R)
    (hmin : ∀ p : minimalPrimes R, (f : R) ∉ p.1) :
    ∃ (y : Fin d → maximalIdeal R) (N : ℕ+),
      IsSystemOfParameters (Fin.cons f y) ∧
        StableUnderHeadPerturbation f y N := sorry
-- Proof strategy: first choose a parameter tail with entries in the maximal
-- ideal.  Since its full parameter ideal is an ideal of definition, choose a
-- maximal-ideal power contained in it.  Strengthen the exponent once and use
-- the head-tail decomposition together with the local unit criterion to show
-- that every sufficiently deep perturbation generates the same ideal.

/-- Lemma 15.126.4, clauses (a)-(b): in dimension two, a maximal-ideal element avoiding every
minimal prime has a one-element parameter tail stable under sufficiently high-order
perturbations. -/
@[stacks 0BWV "Lemma 15.126.4, clauses (a)-(b)"]
theorem exists_cons_singleton_stable
    (hdim : ringKrullDim R = 2) (f : maximalIdeal R)
    (hmin : ∀ p : minimalPrimes R, (f : R) ∉ p.1) :
    ∃ (g : maximalIdeal R) (N : ℕ+),
      IsSystemOfParameters (Fin.cons f ![g]) ∧
        StableUnderHeadPerturbation f ![g] N := sorry
-- Proof strategy: specialize `exists_cons_stable` to `d = 1`, take `g = y 0`,
-- and identify the unique `Fin 1` family `y` with `![g]`.

end IsLocalRing.IsSystemOfParameters
