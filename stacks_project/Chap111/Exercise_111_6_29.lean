module

public import ReasLib.RingTheory.Spectrum.Prime.Polynomial
import StacksCheckRecall

@[expose] public section

open Polynomial

/- Exercise 111.6.29 (1): the prime ideals of `k[X]` for a field `k` are `⊥` and the
principal ideals generated by irreducible polynomials. This is `Polynomial.isPrime_iff`. -/
@[stacks 02DI]
#check (Polynomial.isPrime_iff :
  ∀ {k : Type*} [Field k] {P : Ideal k[X]},
    P.IsPrime ↔ P = ⊥ ∨ ∃ p : k[X], Irreducible p ∧ P = Ideal.span {p})

/- Exercise 111.6.29 (2): when `k` is algebraically closed, the prime ideals of `k[X]` are
`⊥` and the principal ideals `Ideal.span {X - C a}` for `a : k`. This is
`Polynomial.isPrime_iff_of_isAlgClosed`. -/
@[stacks 02DI]
#check (Polynomial.isPrime_iff_of_isAlgClosed :
  ∀ {k : Type*} [Field k] [IsAlgClosed k] {P : Ideal k[X]},
    P.IsPrime ↔ P = ⊥ ∨ ∃ a : k, P = Ideal.span {X - C a})

/- Exercise 111.6.29 (3): specializations on `PrimeSpectrum k[X]`. A point specializes only
to itself, except that the generic point `⊥` specializes to every point. This is
`Polynomial.specializes_iff`. -/
@[stacks 02DI]
#check (Polynomial.specializes_iff :
  ∀ {k : Type*} [Field k] {x y : PrimeSpectrum k[X]},
    x ⤳ y ↔ x = y ∨ x = (⊥ : PrimeSpectrum k[X]))

/- Exercise 111.6.29 (4): the Zariski topology on `PrimeSpectrum k[X]`. A closed set is
either the whole space or a finite set of closed points. This is `Polynomial.isClosed_iff`. -/
@[stacks 02DI]
#check (Polynomial.isClosed_iff :
  ∀ {k : Type*} [Field k] {s : Set (PrimeSpectrum k[X])},
    IsClosed s ↔ s = Set.univ ∨ s.Finite ∧ s ⊆ closedPoints (PrimeSpectrum k[X]))

/- Exercise 111.6.29 (5): over an algebraically closed field, a Zariski-closed subset of
`PrimeSpectrum k[X]` is the whole space or the image of a finite set of scalars under
`Polynomial.closedPoint`. -/
@[stacks 02DI]
#check (Polynomial.isClosed_iff_of_isAlgClosed :
  ∀ {k : Type*} [Field k] [IsAlgClosed k] {s : Set (PrimeSpectrum k[X])},
    IsClosed s ↔ s = Set.univ ∨ ∃ t : Finset k, s = Polynomial.closedPoint '' (t : Set k))

/- Companion: the closed point of `PrimeSpectrum k[X]` at a scalar `a : k`. -/
#check (Polynomial.closedPoint : ∀ {k : Type*} [Field k], k → PrimeSpectrum k[X])
