module

public import Mathlib.AlgebraicGeometry.Sites.Etale

/-!
# Stability of étale covering families

Étale covering families of schemes are stable under singleton isomorphisms,
indexed composition, and base change.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits

universe u v w

namespace AlgebraicGeometry.Scheme

/-- A singleton family generated by an isomorphism is an étale covering. -/
theorem etaleCovering_singleton_of_isIso {T T' : Scheme.{u}}
    (f : T' ⟶ T) [IsIso f] :
    Presieve.ofArrows (fun _ : Unit ↦ T') (fun _ : Unit ↦ f) ∈
      etalePrecoverage.coverings T := sorry

/-- Indexed composition of étale covering families is an étale covering. -/
theorem etaleCovering_comp {T : Scheme.{u}} {ι : Type v} {κ : ι → Type w}
    {Tᵢ : ι → Scheme.{u}} (f : (i : ι) → Tᵢ i ⟶ T)
    (hf : Presieve.ofArrows Tᵢ f ∈ etalePrecoverage.coverings T)
    {Tᵢⱼ : (i : ι) → κ i → Scheme.{u}}
    (g : (i : ι) → (j : κ i) → Tᵢⱼ i j ⟶ Tᵢ i)
    (hg : ∀ i, Presieve.ofArrows (Tᵢⱼ i) (g i) ∈ etalePrecoverage.coverings (Tᵢ i)) :
    Presieve.ofArrows (fun ij : Sigma κ ↦ Tᵢⱼ ij.1 ij.2)
      (fun ij : Sigma κ ↦ g ij.1 ij.2 ≫ f ij.1) ∈ etalePrecoverage.coverings T := sorry

/-- Pullback of an étale covering family along a scheme morphism is an étale covering. -/
theorem etaleCovering_pullback {T T' : Scheme.{u}} {ι : Type v}
    {Tᵢ : ι → Scheme.{u}} (f : (i : ι) → Tᵢ i ⟶ T)
    (hf : Presieve.ofArrows Tᵢ f ∈ etalePrecoverage.coverings T)
    (g : T' ⟶ T) :
    Presieve.ofArrows (fun i ↦ pullback g (f i))
      (fun i ↦ pullback.fst g (f i)) ∈ etalePrecoverage.coverings T' := sorry

end AlgebraicGeometry.Scheme
