module

public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.Basic
public import ReasLib.RingTheory.MvPolynomial.StandardGrading
public import Mathlib.AlgebraicGeometry.Restrict
public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Submodule

/-!
# Affine opens as projective spectra

An open subscheme of an affine spectrum is the projective spectrum of a naturally generated
graded subalgebra of a polynomial ring. This file records the construction, its degree-zero
identification, and the resulting canonical comparison morphism.
-/

@[expose] public section

open CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.AffineOpenProj

variable {A : Type u} [CommRing A]

/-- The polynomial generators `f T ^ i` whose principal open is contained in a given open of
`Spec(A)`. -/
def generatorSet (U : (Spec (.of A)).Opens) : Set (MvPolynomial Unit A) :=
  { p | ∃ (f : A) (i : ℕ), PrimeSpectrum.basicOpen f ≤ U ∧
      p = MvPolynomial.C f * MvPolynomial.X () ^ i }

/-- The `A`-subalgebra of `A[T]` generated by all `f T ^ i` for which `D(f)` is contained in
the given open. -/
def subalgebra (U : (Spec (.of A)).Opens) : Subalgebra A (MvPolynomial Unit A) :=
  Algebra.adjoin A (generatorSet U)

/-- The grading inherited by the generated subalgebra from the standard grading of `A[T]`. -/
def grading (U : (Spec (.of A)).Opens) (n : ℕ) : Submodule A (subalgebra U) :=
  Submodule.comap
    ((Subalgebra.toSubmodule (subalgebra U)).subtype)
    (MvPolynomial.standardGrading Unit A n)

/-- The inherited grading is multiplicative. -/
instance instGradedMonoid (U : (Spec (.of A)).Opens) :
    SetLike.GradedMonoid (grading U) where
  one_mem := by
    change (1 : MvPolynomial Unit A) ∈ MvPolynomial.standardGrading Unit A 0
    simpa using SetLike.one_mem_graded (MvPolynomial.standardGrading Unit A)
  mul_mem := by
    intro i j gi gj hi hj
    change ((gi : MvPolynomial Unit A) * gj : MvPolynomial Unit A) ∈
      MvPolynomial.standardGrading Unit A (i + j)
    exact SetLike.mul_mem_graded hi hj

/-- The generated subalgebra is homogeneous for the standard grading of `A[T]`. -/
theorem subalgebra_isHomogeneous (U : (Spec (.of A)).Opens) :
    (Subalgebra.toSubmodule (subalgebra U)).IsHomogeneous
      (MvPolynomial.standardGrading Unit A) := sorry

/-- The homogeneous components of an element of the generated subalgebra, regarded as an
element of the direct sum of its inherited graded pieces. -/
noncomputable def decomposition (U : (Spec (.of A)).Opens) (x : subalgebra U) :
    DirectSum ℕ (fun n ↦ grading U n) := by
  classical
  refine DFinsupp.mk
    (DirectSum.decompose (MvPolynomial.standardGrading Unit A) (x : MvPolynomial Unit A)).support
    fun n ↦ ?_
  refine ⟨⟨((DirectSum.decompose (MvPolynomial.standardGrading Unit A)
    (x : MvPolynomial Unit A) n.1 : MvPolynomial.standardGrading Unit A n.1) :
      MvPolynomial Unit A), ?_⟩, ?_⟩
  · exact subalgebra_isHomogeneous U n.1 x.2
  · exact (DirectSum.decompose (MvPolynomial.standardGrading Unit A)
      (x : MvPolynomial Unit A) n.1).2

/-- Taking homogeneous components preserves addition. -/
theorem decomposition_add (U : (Spec (.of A)).Opens) (x y : subalgebra U) :
    decomposition U (x + y) = decomposition U x + decomposition U y := sorry

/-- Taking homogeneous components preserves scalar multiplication. -/
theorem decomposition_smul (U : (Spec (.of A)).Opens) (a : A) (x : subalgebra U) :
    decomposition U (a • x) = a • decomposition U x := sorry

/-- The homogeneous decomposition sends one to one. -/
theorem decomposition_one (U : (Spec (.of A)).Opens) :
    decomposition U 1 = 1 := sorry

/-- Taking homogeneous components preserves multiplication. -/
theorem decomposition_mul (U : (Spec (.of A)).Opens) (x y : subalgebra U) :
    decomposition U (x * y) = decomposition U x * decomposition U y := sorry

/-- The inherited homogeneous decomposition as an algebra homomorphism. -/
noncomputable def decompose (U : (Spec (.of A)).Opens) :
    subalgebra U →ₐ[A] DirectSum ℕ (fun n ↦ grading U n) :=
  AlgHom.ofLinearMap
    { toFun := decomposition U
      map_add' := decomposition_add U
      map_smul' := decomposition_smul U }
    (decomposition_one U)
    (decomposition_mul U)

/-- Recombining the inherited homogeneous decomposition recovers the original element. -/
theorem coeAlgHom_comp_decompose (U : (Spec (.of A)).Opens) :
    (DirectSum.coeAlgHom (fun n ↦ grading U n)).comp (decompose U) =
      AlgHom.id A (subalgebra U) := sorry

/-- The inherited decomposition of a homogeneous element is concentrated in its given degree. -/
theorem decompose_coe (U : (Spec (.of A)).Opens) (n : ℕ) (x : grading U n) :
    decompose U (x : subalgebra U) = DirectSum.of (fun m ↦ grading U m) n x := sorry

/-- The generated subalgebra carries the canonical graded-algebra structure induced from
`A[T]`. -/
noncomputable instance instGradedAlgebra (U : (Spec (.of A)).Opens) :
    GradedAlgebra (grading U) :=
  GradedAlgebra.ofAlgHom (grading U) (decompose U)
    (coeAlgHom_comp_decompose U) (decompose_coe U)

/-- Scalars belong to the degree-zero piece of the inherited grading. -/
theorem algebraMap_mem_degreeZero (U : (Spec (.of A)).Opens) (a : A) :
    algebraMap A (subalgebra U) a ∈ grading U 0 := sorry

/-- The canonical embedding of the coefficient ring in the degree-zero piece. -/
noncomputable def degreeZeroC (U : (Spec (.of A)).Opens) (a : A) : grading U 0 :=
  ⟨algebraMap A (subalgebra U) a, algebraMap_mem_degreeZero U a⟩

/-- Constant coefficient followed by the degree-zero scalar embedding recovers every
degree-zero element. -/
theorem degreeZero_leftInverse (U : (Spec (.of A)).Opens) :
    Function.LeftInverse (degreeZeroC U)
      (fun p : grading U 0 ↦ MvPolynomial.constantCoeff p.1.1) := sorry

/-- The degree-zero piece of the generated subalgebra is canonically equivalent to the
coefficient ring. -/
noncomputable def degreeZeroRingEquiv (U : (Spec (.of A)).Opens) : grading U 0 ≃+* A where
  toFun p := MvPolynomial.constantCoeff p.1.1
  invFun := degreeZeroC U
  left_inv := degreeZero_leftInverse U
  right_inv := fun a ↦ MvPolynomial.constantCoeff_C Unit a
  map_mul' p q :=
    map_mul (MvPolynomial.constantCoeff : MvPolynomial Unit A →+* A) p.1.1 q.1.1
  map_add' p q :=
    map_add (MvPolynomial.constantCoeff : MvPolynomial Unit A →+* A) p.1.1 q.1.1

/-- The canonical ring homomorphism from the coefficient ring to the degree-zero piece. -/
noncomputable def degreeZeroAlgebraMap (U : (Spec (.of A)).Opens) : A →+* grading U 0 :=
  (degreeZeroRingEquiv U).symm.toRingHom

/-- The inverse of the degree-zero equivalence is the canonical scalar embedding. -/
theorem degreeZeroRingEquiv_symm_apply (U : (Spec (.of A)).Opens) (a : A) :
    (degreeZeroRingEquiv U).symm a = degreeZeroAlgebraMap U a := rfl

/-- The canonical morphism from the projective spectrum to the affine spectrum, transported
along the degree-zero equivalence. -/
noncomputable def toSpec (U : (Spec (.of A)).Opens) :
    Proj (grading U) ⟶ Spec (.of A) :=
  Proj.toSpecZero (grading U) ≫
    (Scheme.Spec.mapIso ((degreeZeroRingEquiv U).toCommRingCatIso.op)).symm.hom

/-- The canonical morphism to `Spec(A)` has inverse image equal to the given open. -/
theorem toSpec_preimage_eq_top (U : (Spec (.of A)).Opens) :
    toSpec U ⁻¹ᵁ U = ⊤ := sorry

/-- The canonical morphism from the projective spectrum to the supplied open subscheme. -/
noncomputable def toOpen (U : (Spec (.of A)).Opens) :
    Proj (grading U) ⟶ U.toScheme :=
  (Scheme.topIso _).inv ≫
    ((Proj (grading U)).isoOfEq ((toSpec_preimage_eq_top U).symm)).hom ≫
    (toSpec U ∣_ U)

/-- The canonical comparison from the projective spectrum to the supplied open subscheme is an
isomorphism. -/
instance instIsIsoToOpen (U : (Spec (.of A)).Opens) : IsIso (toOpen U) := sorry

/-- Composing the canonical comparison with the open immersion recovers the canonical morphism
to the affine spectrum. -/
theorem toOpen_comp_ι (U : (Spec (.of A)).Opens) :
    toOpen U ≫ U.ι =
      Proj.toSpecZero (grading U) ≫
        (Scheme.Spec.mapIso ((degreeZeroRingEquiv U).toCommRingCatIso.op)).symm.hom := sorry

end AlgebraicGeometry.AffineOpenProj
