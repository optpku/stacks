@[reassoc, stacks 064M "explicit closed generated fixed-right mate naturality"]
theorem functorOf_map_homEquiv_naturality
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    [DerivedTensor.Right.Has (C := C)] {E₁ E₂ : DerivedCategory C}
    (f : E₁ ⟶ E₂) {K N : DerivedCategory C}
    (g : (DerivedTensor.Right.functor E₂).obj K ⟶ N) :
    (adjunctionOf H M E₁).homEquiv K N (((functorOf H M).map f).app K ≫ g) =
      (adjunctionOf H M E₂).homEquiv K N g ≫
        (MonoidalClosed.preOf H f).app N :=
  MonoidalClosed.leftAdjointMapOf_homEquiv_naturality
    H (fun E ↦ adjunctionOf H M E) f g

/-- Stacks 064M: the inverse-transpose form of naturality for the explicit-owner generated
right-factor map. -/
@[reassoc, stacks 064M "explicit closed generated fixed-right inverse mate naturality"]
theorem functorOf_map_homEquiv_symm
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    [DerivedTensor.Right.Has (C := C)] {E₁ E₂ : DerivedCategory C}
    (f : E₁ ⟶ E₂) {K N : DerivedCategory C}
    (g : K ⟶ (MonoidalClosed.ihomOf H E₂).obj N) :
    ((functorOf H M).map f).app K ≫ ((adjunctionOf H M E₂).homEquiv K N).symm g =
      ((adjunctionOf H M E₁).homEquiv K N).symm
        (g ≫ (MonoidalClosed.preOf H f).app N) :=
  MonoidalClosed.leftAdjointMapOf_homEquiv_symm
    H (fun E ↦ adjunctionOf H M E) f g

/-- Stacks 064M: the component of the explicit-owner generated parametrized adjunction is the
chosen pointwise fixed-right derived adjunction. -/
