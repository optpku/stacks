/-!
# Perfect weak generators of supported derived categories

On a quasi-compact quasi-separated algebraic space, the derived category of
quasi-coherent complexes supported on a closed subset with quasi-compact
complement is generated by a single perfect object.
-/

@[expose] public section

open AlgebraicGeometry AlgebraicGeometry.AlgebraicSpace CategoryTheory TopologicalSpace

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.DerivedQCoh.SupportedOn

/-- Derived quasi-coherent modules supported on a subset are stable under shifts. -/
instance instIsStableUnderShift {S : Scheme.{u}} (X : AlgebraicSpace S)
    (T : Set (Points X)) :
    (quasiCoherentSupportedOn X T).IsStableUnderShift ℤ := sorry

/-- If `X` is quasi-compact and quasi-separated and `T` has quasi-compact complement,
then `D_QCoh,T(𝒪_X)` has a perfect weak generator. -/
theorem exists_isPerfect_isWeakGenerator {S : Scheme.{u}} {X : AlgebraicSpace S}
    [IsQuasiCompact X] [IsAbsolutelyQuasiSeparated X] (T : Closeds (Points X))
    (hT : QuasiCompact (OpenSubspace.ofOpensι T.compl)) :
    ∃ P : SupportedOn X (T : Set (Points X)),
      ModuleDerived.IsPerfect P.obj ∧ IsWeakGenerator P := sorry

end AlgebraicGeometry.AlgebraicSpace.DerivedQCoh.SupportedOn
