module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
public import Mathlib.LinearAlgebra.Determinant
public import ReasLib.AlgebraicGeometry.Scheme.Module.Cech.PrincipalOpen.LocalCohomology

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace SheafOfModules.ClosedSubset

noncomputable section

universe u

namespace ModuleCech.LocalCohomology

variable {X : Scheme.{u}}

/-- Equality of the ideal sheaves generated by two finite families identifies their common
zero loci. -/
theorem zeroLocus_eq_of_idealSheaf_eq {c : ℕ}
    (f g : Fin c → Γ(X, ⊤))
    (hcut : Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g)) =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range f))) :
    ModuleCech.ofSectionsZeroLocus g = ModuleCech.ofSectionsZeroLocus f := sorry

/-- Multiplication by a global section after restriction to the common zero locus. -/
noncomputable def pullbackSectionMul {c : ℕ} (f : Fin c → Γ(X, ⊤))
    (r : Γ(X, ⊤)) (ℱ : X.Modules) :
    (pullbackFunctor f).obj ℱ ⟶ (pullbackFunctor f).obj ℱ :=
  (SheafOfModules.ClosedSubset.pullback X.toRingedSpace.ringCatSheaf
    (ModuleCech.ofSectionsZeroLocus f)).map
      (RingedSpace.globalSectionMul r ((Scheme.Modules.toRingedSpace X).obj ℱ))

/-- Restricted multiplication by a global section is natural in the module sheaf. -/
theorem pullbackSectionMul_naturality {c : ℕ} (f : Fin c → Γ(X, ⊤))
    (r : Γ(X, ⊤)) {ℱ G : X.Modules} (φ : ℱ ⟶ G) :
    (pullbackFunctor f).map φ ≫ pullbackSectionMul f r G =
      pullbackSectionMul f r ℱ ≫ (pullbackFunctor f).map φ := sorry

/-- Transport the class map for `g` to the equal zero locus indexed by `f`. -/
noncomputable def transportClassMapApp {c : ℕ} (f g : Fin c → Γ(X, ⊤))
    (hzero : ModuleCech.ofSectionsZeroLocus g = ModuleCech.ofSectionsZeroLocus f)
    (ℱ : X.Modules) :
    (pullbackFunctor f).obj ℱ ⟶ (cohomologyFunctor f).obj ℱ :=
  cast
    (congrArg
      (fun Z : Closeds X ↦
        (SheafOfModules.ClosedSubset.pullback X.toRingedSpace.ringCatSheaf Z).obj
            ((Scheme.Modules.toRingedSpace X).obj ℱ) ⟶
          (DerivedCategory.homologyFunctor
              (SheafOfModules.ClosedSubset.Modules X.toRingedSpace.ringCatSheaf Z)
              (c : ℤ)).obj
            ((Derived.sectionsWithSupport X.toRingedSpace.ringCatSheaf Z).obj
              ((ModuleCech.moduleToDerived X).obj ℱ)))
      hzero)
    ((classMap g).app ℱ)

/-- Transport along reflexivity leaves a class-map component unchanged. -/
theorem transportClassMapApp_self {c : ℕ} (f : Fin c → Γ(X, ⊤))
    (ℱ : X.Modules) :
    transportClassMapApp f f rfl ℱ = (classMap f).app ℱ := sorry

/-- Replacing a finite family of generators by `Matrix.mulVec A f`, without changing its
scheme-theoretic zero subscheme, multiplies the canonical top local-cohomology class map by
`Matrix.det A`. -/
theorem classMap_mulVec {c : ℕ} (f : Fin c → Γ(X, ⊤))
    (A : Matrix (Fin c) (Fin c) Γ(X, ⊤)) (ℱ : X.Modules) [ℱ.IsQuasicoherent]
    (hcut : Scheme.IdealSheafData.ofIdealTop
        (Ideal.span (Set.range (Matrix.mulVec A f))) =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range f))) :
    (classMap f).app ℱ =
      pullbackSectionMul f (Matrix.det A) ℱ ≫
        transportClassMapApp f (Matrix.mulVec A f)
          (zeroLocus_eq_of_idealSheaf_eq f (Matrix.mulVec A f) hcut) ℱ := sorry

end ModuleCech.LocalCohomology

end
