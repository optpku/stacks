module

public import ReasLib.RingTheory.Ideal.LocallyNilpotent
public import Mathlib.Algebra.RingQuot
public import Mathlib.RingTheory.MvPolynomial.Ideal
import StacksCheckRecall

/-!
# Example 10.32.2

@stack 0EGG
-/

@[expose] public section

open MvPolynomial

universe u

noncomputable section

variable (k : Type u) [CommSemiring k]

/-- The ideal of `k[X_n | n in N+]` generated by the powers `X_n^n`.  Positive natural
indices give the source example without the vacuous zeroth generator. -/
def variablePowerIdeal : Ideal (MvPolynomial ℕ+ k) :=
  Ideal.span (Set.range fun n : ℕ+ ↦ X n ^ (n : ℕ))

/-- The quotient by `variablePowerIdeal k`, modeled by `RingQuot` so the construction remains
available over commutative semirings. -/
abbrev variablePowerQuotient :=
  RingQuot (fun f g : MvPolynomial ℕ+ k ↦ f ∈ variablePowerIdeal k ∧ g = 0)

/-- The canonical map to `variablePowerQuotient k`. -/
def variablePowerQuotientMk :
    MvPolynomial ℕ+ k →+* variablePowerQuotient k :=
  RingQuot.mkRingHom
    (fun f g : MvPolynomial ℕ+ k ↦ f ∈ variablePowerIdeal k ∧ g = 0)

/-- The ideal generated by the variable classes in `variablePowerQuotient k`. -/
def quotientVariableIdeal : Ideal (variablePowerQuotient k) :=
  Ideal.map (variablePowerQuotientMk k) (idealOfVars ℕ+ k)

variable [Nontrivial k]

/-- Example 10.32.2 (0EGG), generator clause: every variable class is nilpotent. -/
@[stacks 0EGG "nilpotent variable classes"]
theorem quotient_variable_generator_isNilpotent (i : ℕ+) :
    IsNilpotent
      (variablePowerQuotientMk k (X i : MvPolynomial ℕ+ k)) := sorry

/-- Example 10.32.2 (0EGG), nonnilpotence witness: the class of `X_(n+1)^n` is nonzero. -/
@[stacks 0EGG "surviving powers"]
theorem succ_variable_pow_class_ne_zero (n : ℕ) :
    variablePowerQuotientMk k
      ((X (Nat.succPNat n) : MvPolynomial ℕ+ k) ^ n) ≠ 0 := sorry

/-- Example 10.32.2 (0EGG): the variable ideal in the quotient is locally nilpotent but not
nilpotent. -/
@[stacks 0EGG]
theorem quotient_variable_ideal_locally_nilpotent_not_nilpotent :
    (quotientVariableIdeal k).IsLocallyNilpotent ∧
      ¬ IsNilpotent (quotientVariableIdeal k) := sorry

@[stacks 0EGG "locally nilpotent ideal predicate"]
#check @Ideal.IsLocallyNilpotent

@[stacks 0EGG "elementwise locally nilpotent criterion"]
#check @Ideal.isLocallyNilpotent_iff
