module

public import Mathlib.CategoryTheory.Adjunction.Parametrized
public import Mathlib.CategoryTheory.Adjunction.Mates
import Mathlib.Tactic.CrossRefAttribute

/-!
# Generating parametrized adjunctions from pointwise left adjoints

Given a bifunctor `G : C₁ᵒᵖ ⥤ C₃ ⥤ C₂` and a chosen left adjoint to every functor
`G.obj (op X)`, the parameter maps of `G` have canonical left mates.  These mates assemble the
chosen left adjoints into a functor and produce Mathlib's native `ParametrizedAdjunction`.

The generated functor is a named owner: this file does not identify it with an independently
chosen functor having the same object assignment.  That distinction lets downstream derived
constructions obtain honest parameter coherence without hiding pointwise comparison data in a
local instance.
@stack 0E1U
-/

@[expose] public section

noncomputable section

universe v₁ v₂ v₃ u₁ u₂ u₃

namespace CategoryTheory.ParametrizedAdjunction

open Opposite

variable {C₁ : Type u₁} {C₂ : Type u₂} {C₃ : Type u₃}
variable [Category.{v₁} C₁] [Category.{v₂} C₂] [Category.{v₃} C₃]

/-- The left mate of a parameter morphism of a right-adjoint bifunctor. -/
@[stacks 0E1U "left mate of a parametrized right adjoint"]
noncomputable def leftAdjointMap
    (G : C₁ᵒᵖ ⥤ C₃ ⥤ C₂) {T : C₁ → C₂ ⥤ C₃}
    (adj : ∀ X, T X ⊣ G.obj (op X)) {X Y : C₁} (f : X ⟶ Y) :
    T X ⟶ T Y :=
  (conjugateEquiv (adj Y) (adj X)).symm (G.map f.op)

/-- The arbitrary-map transpose formula for the generated left-adjoint parameter map.  This is
the coherence required by `ParametrizedAdjunction.mk'`. -/
@[reassoc, stacks 0E1U "left mate parameter naturality"]
theorem leftAdjointMap_homEquiv_naturality
    (G : C₁ᵒᵖ ⥤ C₃ ⥤ C₂) {T : C₁ → C₂ ⥤ C₃}
    (adj : ∀ X, T X ⊣ G.obj (op X)) {X Y : C₁} (f : X ⟶ Y)
    {A : C₂} {B : C₃} (g : (T Y).obj A ⟶ B) :
    (adj X).homEquiv A B ((leftAdjointMap G adj f).app A ≫ g) =
      (adj Y).homEquiv A B g ≫ (G.map f.op).app B := by
  simp only [Adjunction.homEquiv_unit, Functor.map_comp, Category.assoc, leftAdjointMap]
  have h :
      (adj X).unit.app A ≫
          (G.obj (op X)).map
            (((conjugateEquiv (adj Y) (adj X)).symm (G.map f.op)).app A) =
        (adj Y).unit.app A ≫ (G.map f.op).app ((T Y).obj A) := by
    simpa only [Functor.id_obj, Functor.comp_obj] using
      (unit_conjugateEquiv_symm (adj Y) (adj X) (G.map f.op) A).symm
  erw [← Category.assoc, h, Category.assoc, ← (G.map f.op).naturality g]
  rfl

/-- The inverse-transpose form of naturality for the generated left-adjoint parameter map. -/
@[reassoc, stacks 0E1U "left mate inverse transpose"]
theorem leftAdjointMap_homEquiv_symm
    (G : C₁ᵒᵖ ⥤ C₃ ⥤ C₂) {T : C₁ → C₂ ⥤ C₃}
    (adj : ∀ X, T X ⊣ G.obj (op X)) {X Y : C₁} (f : X ⟶ Y)
    {A : C₂} {B : C₃} (g : A ⟶ (G.obj (op Y)).obj B) :
    (leftAdjointMap G adj f).app A ≫ ((adj Y).homEquiv A B).symm g =
      ((adj X).homEquiv A B).symm (g ≫ (G.map f.op).app B) := by
  apply ((adj X).homEquiv A B).injective
  rw [leftAdjointMap_homEquiv_naturality]
  simp

/-- The left mate of an identity parameter morphism is the identity. -/
@[simp, stacks 0E1U "left mate identity"]
theorem leftAdjointMap_id
    (G : C₁ᵒᵖ ⥤ C₃ ⥤ C₂) {T : C₁ → C₂ ⥤ C₃}
    (adj : ∀ X, T X ⊣ G.obj (op X)) (X : C₁) :
    leftAdjointMap G adj (𝟙 X) = 𝟙 _ := by
  simp [leftAdjointMap]

/-- Left mates compose in the same order as their parameter morphisms. -/
@[reassoc, stacks 0E1U "left mate composition"]
theorem leftAdjointMap_comp
    (G : C₁ᵒᵖ ⥤ C₃ ⥤ C₂) {T : C₁ → C₂ ⥤ C₃}
    (adj : ∀ X, T X ⊣ G.obj (op X)) {X Y Z : C₁}
    (f : X ⟶ Y) (g : Y ⟶ Z) :
    leftAdjointMap G adj (f ≫ g) =
      leftAdjointMap G adj f ≫ leftAdjointMap G adj g := by
  rw [leftAdjointMap, leftAdjointMap, leftAdjointMap, op_comp, G.map_comp]
  exact (conjugateEquiv_symm_comp (adj Z) (adj Y) (adj X)
    (G.map g.op) (G.map f.op)).symm

/-- The functor generated from a family of pointwise left adjoints to `G`. -/
@[stacks 0E1U "functor generated by pointwise left adjoints"]
noncomputable def leftAdjointFunctor
    (G : C₁ᵒᵖ ⥤ C₃ ⥤ C₂) {T : C₁ → C₂ ⥤ C₃}
    (adj : ∀ X, T X ⊣ G.obj (op X)) : C₁ ⥤ C₂ ⥤ C₃ where
  obj := T
  map f := leftAdjointMap G adj f
  map_id := fun X => leftAdjointMap_id G adj X
  map_comp := fun f g => leftAdjointMap_comp G adj f g

/-- The generated left-adjoint functor has the chosen pointwise functor as its object value. -/
@[simp, stacks 0E1U "generated left-adjoint functor object"]
theorem leftAdjointFunctor_obj
    (G : C₁ᵒᵖ ⥤ C₃ ⥤ C₂) {T : C₁ → C₂ ⥤ C₃}
    (adj : ∀ X, T X ⊣ G.obj (op X)) (X : C₁) :
    (leftAdjointFunctor G adj).obj X = T X := rfl

/-- The parameter map of the generated functor is the canonical left mate. -/
@[simp, stacks 0E1U "generated left-adjoint functor map"]
theorem leftAdjointFunctor_map
    (G : C₁ᵒᵖ ⥤ C₃ ⥤ C₂) {T : C₁ → C₂ ⥤ C₃}
    (adj : ∀ X, T X ⊣ G.obj (op X)) {X Y : C₁} (f : X ⟶ Y) :
    (leftAdjointFunctor G adj).map f = leftAdjointMap G adj f := rfl

/-- The parametrized adjunction generated from a family of pointwise left adjoints to `G`. -/
@[stacks 0E1U "parametrized adjunction generated by pointwise left adjoints"]
noncomputable def ofPointwiseLeftAdjoints
    (G : C₁ᵒᵖ ⥤ C₃ ⥤ C₂) {T : C₁ → C₂ ⥤ C₃}
    (adj : ∀ X, T X ⊣ G.obj (op X)) :
    leftAdjointFunctor G adj ⊣₂ G :=
  ParametrizedAdjunction.mk'
    (fun X => adj X)
    (fun {_ _} f {_ _} g => leftAdjointMap_homEquiv_naturality G adj f g)

/-- The pointwise adjunction of `ofPointwiseLeftAdjoints` is the chosen adjunction. -/
@[simp, stacks 0E1U "generated parametrized adjunction component"]
theorem ofPointwiseLeftAdjoints_adj
    (G : C₁ᵒᵖ ⥤ C₃ ⥤ C₂) {T : C₁ → C₂ ⥤ C₃}
    (adj : ∀ X, T X ⊣ G.obj (op X)) (X : C₁) :
    (ofPointwiseLeftAdjoints G adj).adj X = adj X := rfl

/-- A generated left-adjoint parameter map is an isomorphism when its parameter map is. -/
@[stacks 0E1U "left mate preserves isomorphisms"]
instance isIso_leftAdjointMap
    (G : C₁ᵒᵖ ⥤ C₃ ⥤ C₂) {T : C₁ → C₂ ⥤ C₃}
    (adj : ∀ X, T X ⊣ G.obj (op X)) {X Y : C₁} (f : X ⟶ Y) [IsIso f] :
    IsIso (leftAdjointMap G adj f) := by
  dsimp [leftAdjointMap]
  infer_instance

/-- Generated left mates of an isomorphism and its inverse compose to the identity. -/
@[stacks 0E1U "left mate isomorphism hom-inv law"]
theorem leftAdjointMapIso_hom_inv_id
    (G : C₁ᵒᵖ ⥤ C₃ ⥤ C₂) {T : C₁ → C₂ ⥤ C₃}
    (adj : ∀ X, T X ⊣ G.obj (op X)) {X Y : C₁} (e : X ≅ Y) :
    leftAdjointMap G adj e.hom ≫ leftAdjointMap G adj e.inv = 𝟙 _ := by
  rw [← leftAdjointMap_comp, e.hom_inv_id, leftAdjointMap_id]

/-- Generated left mates of an inverse and its isomorphism compose to the identity. -/
@[stacks 0E1U "left mate isomorphism inv-hom law"]
theorem leftAdjointMapIso_inv_hom_id
    (G : C₁ᵒᵖ ⥤ C₃ ⥤ C₂) {T : C₁ → C₂ ⥤ C₃}
    (adj : ∀ X, T X ⊣ G.obj (op X)) {X Y : C₁} (e : X ≅ Y) :
    leftAdjointMap G adj e.inv ≫ leftAdjointMap G adj e.hom = 𝟙 _ := by
  rw [← leftAdjointMap_comp, e.inv_hom_id, leftAdjointMap_id]

/-- The generated left-adjoint map of an isomorphism, packaged as a natural isomorphism. -/
@[stacks 0E1U "left mate isomorphism"]
noncomputable def leftAdjointMapIso
    (G : C₁ᵒᵖ ⥤ C₃ ⥤ C₂) {T : C₁ → C₂ ⥤ C₃}
    (adj : ∀ X, T X ⊣ G.obj (op X)) {X Y : C₁} (e : X ≅ Y) :
    T X ≅ T Y :=
  (leftAdjointFunctor G adj).mapIso e

/-- The forward map of `leftAdjointMapIso` is the generated left mate. -/
@[simp, stacks 0E1U "left mate isomorphism forward map"]
theorem leftAdjointMapIso_hom
    (G : C₁ᵒᵖ ⥤ C₃ ⥤ C₂) {T : C₁ → C₂ ⥤ C₃}
    (adj : ∀ X, T X ⊣ G.obj (op X)) {X Y : C₁} (e : X ≅ Y) :
    (leftAdjointMapIso G adj e).hom = leftAdjointMap G adj e.hom := rfl

/-- The inverse map of `leftAdjointMapIso` is the generated mate of the inverse. -/
@[simp, stacks 0E1U "left mate isomorphism inverse map"]
theorem leftAdjointMapIso_inv
    (G : C₁ᵒᵖ ⥤ C₃ ⥤ C₂) {T : C₁ → C₂ ⥤ C₃}
    (adj : ∀ X, T X ⊣ G.obj (op X)) {X Y : C₁} (e : X ≅ Y) :
    (leftAdjointMapIso G adj e).inv = leftAdjointMap G adj e.inv := rfl

end CategoryTheory.ParametrizedAdjunction
