module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Algebra.Polynomial.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import ReasLib.RingTheory.Ideal.AssociatedPrime.Module
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

noncomputable section

universe u

section

open MvPolynomial

/-- Over a field, the associated primes of the quotient of the two-variable polynomial
ring by `x * y * (x + y)` are the principal ideals generated by `x`, `y`, and `x + y`. -/
@[stacks 0CR8]
theorem MvPolynomial.associatedPrimesOfModule_quotient_span_XY_X_add_Y
    (k : Type u) [Field k] :
    associatedPrimesOfModule (MvPolynomial (Fin 2) k)
        (MvPolynomial (Fin 2) k ⧸
          Ideal.span {(X 0 * X 1 * (X 0 + X 1) : MvPolynomial (Fin 2) k)}) =
      {Ideal.span {X 0}, Ideal.span {X 1}, Ideal.span {X 0 + X 1}} :=
  sorry

end

section

open Polynomial

/-- The associated primes of the quotient of the integer polynomial ring by `300 * X + 75`
are the principal ideals generated by `3`, `5`, and `4 * X + 1`. -/
@[stacks 0CR8]
theorem Polynomial.associatedPrimesOfModule_quotient_span_300X_add_75 :
    associatedPrimesOfModule (Polynomial ℤ)
        (Polynomial ℤ ⧸ Ideal.span {(300 * X + 75 : Polynomial ℤ)}) =
      {Ideal.span {(3 : Polynomial ℤ)}, Ideal.span {(5 : Polynomial ℤ)},
        Ideal.span {4 * X + 1}} :=
  sorry

end

section

open MvPolynomial

/-- Over a field, the associated primes of the quotient of the three-variable polynomial
ring by `(x ^ 3, x ^ 2 * y, x * z)` are `(x)`, `(x, z)`, and `(x, y, z)`. -/
@[stacks 0CR8]
theorem MvPolynomial.associatedPrimesOfModule_quotient_span_X_pow_3_X_pow_2_Y_XZ
    (k : Type u) [Field k] :
    associatedPrimesOfModule (MvPolynomial (Fin 3) k)
        (MvPolynomial (Fin 3) k ⧸
          Ideal.span
            {(X 0 ^ 3 : MvPolynomial (Fin 3) k), X 0 ^ 2 * X 1, X 0 * X 2}) =
      {Ideal.span {X 0}, Ideal.span {X 0, X 2}, Ideal.span {X 0, X 1, X 2}} :=
  sorry

end
