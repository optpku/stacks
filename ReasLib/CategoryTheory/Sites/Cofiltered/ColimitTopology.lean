module

public import Mathlib.CategoryTheory.Sites.Sheafification
public import ReasLib.CategoryTheory.Sites.Cofiltered.ColimitCategory
public import ReasLib.CategoryTheory.Sites.MorphismOfSites

/-!
# Colimit topologies on cofiltered site diagrams

This layer equips `CofilteredSiteDiagram.ColimitCategory` with the precoverage
generated by the selected stage covers.  It is separate from the quotient
category construction so categorical colimits can be reused without a choice
of site structure.
-/

@[expose] public section

noncomputable section

open CategoryTheory
open CategoryTheory.Limits
open Opposite

universe uI uC vC

namespace CategoryTheory

namespace CofilteredSiteDiagram

variable (S : CofilteredSiteDiagram.{uI, uC, vC})

/-- The image of a selected stage presieve on a colimit object, transported along a chosen
presentation of that object. -/
def stageCover {x : S.ColimitCategory} (i : S.I) (X : S.stage i)
    (hX : S.ιObj i X = x) (R : Presieve X) : Presieve x :=
  hX ▸ R.map (S.stageCoconeFunctor i)

/-- At the canonical stage presentation, `stageCover` is the ordinary mapped presieve. -/
theorem stageCover_rfl_eq_map (i : S.I) (X : S.stage i) (R : Presieve X) :
    S.stageCover i X rfl R = R.map (S.stageCoconeFunctor i) := sorry

/-- Membership in a transported stage cover is membership in its mapped presieve after
transporting the target back to the selected stage. -/
theorem stageCover_apply_iff {x : S.ColimitCategory} (i : S.I) (X : S.stage i)
    (hX : S.ιObj i X = x) (R : Presieve X) {Z : S.ColimitCategory} (t : Z ⟶ x) :
    S.stageCover i X hX R t ↔
      (R.map (S.stageCoconeFunctor i)) (t ≫ eqToHom hX.symm) := sorry

/-- Lemma 7.18.2 (09YL): the selected precoverage on the explicit colimit category generated
by images of selected stage covers. -/
@[stacks 09YL]
def colimitSite : Precoverage S.ColimitCategory where
  coverings x := {T | ∃ (i : S.I) (X : S.stage i) (hX : S.ιObj i X = x) (R : Presieve X),
    R ∈ S.stageCov i X ∧ S.stageCover i X hX R = T}

/-- A selected cover maps to a selected cover of the colimit site. -/
theorem map_mem_colimitSite (i : S.I) {X : S.stage i} {R : Presieve X}
    (hR : R ∈ S.stageCov i X) :
    R.map (S.stageCoconeFunctor i) ∈ S.colimitSite (S.ιObj i X) := sorry

/-- Every selected stage cover is contained in the pullback of the selected colimit coverage. -/
theorem stageCov_le_comap (i : S.I) :
    S.stageCov i ≤ S.colimitSite.comap (S.stageCoconeFunctor i) := sorry

/-- Lemma 7.18.2 (09YL): the Grothendieck topology generated by the selected colimit
precoverage. -/
@[stacks 09YL]
def colimitTopology : GrothendieckTopology S.ColimitCategory :=
  S.colimitSite.toGrothendieck

/-- Each stage cocone functor preserves covers for the generated colimit topology. -/
theorem colimitTopology_coverPreserving (i : S.I) :
    CoverPreserving (S.stageTopology i) S.colimitTopology (S.stageCoconeFunctor i) := sorry

/-- Lemma 7.18.2 (09YL): `colimitTopology` is the least topology making every stage cocone
functor cover-preserving. -/
@[stacks 09YL]
theorem colimitTopology_isLeast :
    IsLeast
      {Jc : GrothendieckTopology S.ColimitCategory |
        ∀ i : S.I, CoverPreserving (S.stageTopology i) Jc (S.stageCoconeFunctor i)}
      S.colimitTopology := sorry

section SiteAxioms

/-- Lemma 7.18.2 (09YL): the selected colimit coverage contains singleton isomorphisms. -/
@[stacks 09YL]
instance colimitSite_hasIsos : S.colimitSite.HasIsos := sorry

/-- Lemma 7.18.2 (09YL): the selected colimit coverage is stable under arrowwise refinement. -/
@[stacks 09YL]
instance colimitSite_isStableUnderBind : S.colimitSite.IsStableUnderBind := sorry

/-- Lemma 7.18.2 (09YL): a stage cocone functor preserves pullbacks of arrows in a selected
stage cover. -/
@[stacks 09YL]
theorem stageCoconeFunctor_preservesPullback
    (i : S.I) {V : S.stage i} {R : Presieve V} (hR : R ∈ S.stageCov i V)
    {Y : S.stage i} {g : Y ⟶ V} (hg : R g) {T : S.stage i} (f : T ⟶ V)
    [HasPullback f g] :
    PreservesLimit (cospan f g) (S.stageCoconeFunctor i) := sorry

/-- Lemma 7.18.2 (09YL): members of selected colimit covers admit pullbacks. -/
@[stacks 09YL]
instance colimitSite_hasPullbacks : S.colimitSite.HasPullbacks := sorry

/-- Lemma 7.18.2 (09YL): pullbacks of selected colimit covers admit selected factoring
refinements. -/
@[stacks 09YL]
instance colimitSite_hasFactoringPullbacks : S.colimitSite.HasFactoringPullbacks := sorry

end SiteAxioms

section Continuity

/-- Lemma 7.18.2 (09YL): each stage cocone functor is continuous for the selected
precoverages. -/
@[stacks 09YL]
instance stageCoconeContinuous (i : S.I) :
    Functor.Precoverage.IsContinuous
      (S.stageCoconeFunctor i) (S.stageCov i) S.colimitSite := sorry

/-- Each stage cocone functor is continuous for the generated Grothendieck topologies. -/
instance stageCoconeFunctor_isContinuous (i : S.I) :
    Functor.IsContinuous (S.stageCoconeFunctor i) (S.stageTopology i) S.colimitTopology := sorry

end Continuity

end CofilteredSiteDiagram

end CategoryTheory
