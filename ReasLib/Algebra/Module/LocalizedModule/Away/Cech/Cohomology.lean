module

public import Mathlib.RingTheory.Support
public import Mathlib.Algebra.Category.ModuleCat.Abelian
public import Mathlib.Algebra.Homology.ShortComplex.HomologicalComplex
public import ReasLib.Algebra.Module.LocalizedModule.Away.Cech.Alternating
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Cohomology of extended alternating Cech complexes

The cohomology of the extended alternating Cech complex is bounded by the length of the finite
family, is power-torsion for every member of that family, and is supported on their common zero
locus.  These statements use the canonical complex owned by
`LocalizedModule.Away.Cech.Alternating`.
-/

@[expose] public section

noncomputable section

universe u v

open CategoryTheory CategoryTheory.Limits

namespace LocalizedModule.Away.Cech.Alternating.Cohomology

variable {R : Type u} [CommRing R]
variable {M : Type (max u v)} [AddCommGroup M] [Module R M]
variable {r : ℕ}

/-- The extended alternating Cech cohomology vanishes above the length of the finite family. -/
@[stacks 0G6K "Lemma 15.29.5 (1)"]
theorem isZero_of_gt {f : Fin r → R} {q : ℕ} (hq : r < q) :
    IsZero ((Alternating.extended f M).homology q) := sorry

/-- Every extended alternating Cech cohomology class is annihilated by a positive power of each
member of the finite family. -/
@[stacks 0G6K "Lemma 15.29.5 (2)"]
theorem exists_pow_smul_eq_zero {f : Fin r → R} (q : ℕ) (i : Fin r)
    (x : (Alternating.extended f M).homology q) :
    ∃ n : ℕ, 1 ≤ n ∧ f i ^ n • x = 0 := sorry

/-- The support of every extended alternating Cech cohomology module is contained in the common
zero locus of the family. -/
@[stacks 0G6K "Lemma 15.29.5 (3)"]
theorem support_subset_zeroLocus {f : Fin r → R} (q : ℕ) :
    Module.support R ((Alternating.extended f M).homology q) ⊆
      PrimeSpectrum.zeroLocus (Ideal.span (Set.range f)) := sorry

/-- If an element of the ideal generated by the family acts invertibly on the coefficient module,
then every extended alternating Cech cohomology module vanishes. -/
@[stacks 0G6K "Lemma 15.29.5 (4)"]
theorem isZero_of_exists_isUnit_span {f : Fin r → R} (q : ℕ)
    (hunit : ∃ a ∈ Ideal.span (Set.range f),
      IsUnit (algebraMap R (Module.End R M) a)) :
    IsZero ((Alternating.extended f M).homology q) := sorry

/-- The extended alternating Cech complex for a finite family generating the unit ideal has zero
cohomology in every degree. -/
theorem isZero_of_span_eq_top (f : Fin r → R)
    (hf : Ideal.span (Set.range f) = ⊤) (q : ℕ) :
    IsZero ((Alternating.extended f M).homology q) := sorry

end LocalizedModule.Away.Cech.Alternating.Cohomology
