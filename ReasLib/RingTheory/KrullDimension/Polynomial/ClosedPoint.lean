module

public import Mathlib.RingTheory.RegularLocalRing.Polynomial
public import ReasLib.RingTheory.KrullDimension.Polynomial
import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Closed points of affine space

@stack 00OP

This leaf collects the finite-generator, local-dimension, and regular-local
interfaces for closed points of finite-dimensional affine space over a field.
-/

universe u

namespace MvPolynomial

/-- Lemma 10.114.1 (1), tag 00OP: a maximal ideal in a polynomial algebra in
`n` variables over a field is generated by `n` elements. -/
@[stacks 00OP "(1), generators of a closed-point ideal"]
theorem exists_fin_generators_maximalIdeal
    {k : Type u} [Field k] {n : ℕ}
    (m : MaximalSpectrum (MvPolynomial (Fin n) k)) :
    ∃ x : Fin n → MvPolynomial (Fin n) k,
      Ideal.span (Set.range x) = m.asIdeal := sorry

end MvPolynomial
