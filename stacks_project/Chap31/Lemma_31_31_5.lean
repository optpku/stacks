module

import ReasLib.AlgebraicGeometry.Scheme.RelativeProj.ClosedSubscheme.Support
import StacksCheckRecall

open CategoryTheory CategoryTheory.Limits
open SheafOfModules.RingedSite

noncomputable section

universe u

/- Lemma 31.31.5: let `S` be a quasi-compact and quasi-separated scheme, let `𝒜` be a
quasi-coherent graded `𝒪_S`-algebra, and let `p : X ⟶ S` be a quasi-compact relative projective
spectrum of `𝒜`. If a finitely presented closed immersion `i : Z ⟶ X` avoids a quasi-compact
open `U` of `S` and every nonnegative graded piece of `𝒜` is finite type, then `Z` is presented
by a quotient generated by a finite-type quasi-coherent subobject in one positive degree, and the
support of the corresponding degree quotient is disjoint from `U`. -/
@[stacks 0803] #check
  (AlgebraicGeometry.Scheme.RelativeProjTwist.Presentation.existsQuotientByFiniteTypeDegreeSubobject_support_disjoint :
    ∀ {S X Z : AlgebraicGeometry.Scheme.{u}} {p : X ⟶ S}
      [CompactSpace S] [QuasiSeparatedSpace S]
      (𝒜 : GradedAlgebraSheaf.{u, u} S.sheaf) [𝒜.IsCommutative]
      (hqc : 𝒜.IsQuasicoherent)
      (A σ : S.affineOpens → Type u)
      [∀ U, CommRing (A U)] [∀ U, SetLike (σ U) (A U)]
      [∀ U, AddSubgroupClass (σ U) (A U)]
      (sectionGrading : ∀ U : S.affineOpens, ℕ → σ U)
      [∀ U, GradedRing (sectionGrading U)]
      (P : ∀ U : S.affineOpens, AlgebraicGeometry.ProjTwistPresentation (sectionGrading U))
      (model : ∀ (U : S.affineOpens) (d : ℕ),
        (𝒜 (Int.ofNat d)).val.obj (Opposite.op (U : S.Opens)) ≃+ sectionGrading U d)
      (hModel : ∀ U : S.affineOpens,
        AlgebraicGeometry.AffineOpenSectionProj.IsAffineOpenSectionModel
          (sectionGrading U) 𝒜 U (model U))
      (presentation : AlgebraicGeometry.Scheme.RelativeProjTwist.Presentation
        𝒜 A σ sectionGrading P (fun U d ↦ (model U d).toEquiv) p)
      (i : Z ⟶ X) [AlgebraicGeometry.IsClosedImmersion i]
      [AlgebraicGeometry.QuasiCompact p]
      [AlgebraicGeometry.Scheme.Hom.FinitePresentation i]
      (hfinite : ∀ n : ℕ, (𝒜 (Int.ofNat n)).IsFiniteType)
      (U : S.Opens) (hU : IsCompact (U : Set S))
      (hdisjoint : Disjoint (U : Set S) (Set.range (i ≫ p).base)),
      ∃ (d : ℕ) (F : Subobject (𝒜 (Int.ofNat d)))
        (Q : AlgebraicGeometry.Scheme.RelativeProjTwist.Presentation.ClosedSubschemeQuotient
          presentation hqc hModel i),
        0 < d ∧
          F ∈ AlgebraicGeometry.Scheme.Modules.finiteTypeQuasiCoherentSubobjects
            (𝒜 (Int.ofNat d)) ∧
            Q.IsQuotientByDegreeSubobject d F ∧
              Disjoint
                (AlgebraicGeometry.RingedSpace.moduleSupport (cokernel F.arrow))
                (U : Set S))
