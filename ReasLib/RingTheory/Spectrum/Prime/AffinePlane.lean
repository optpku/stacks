module

public import Mathlib.Algebra.Polynomial.AlgebraMap
public import Mathlib.Data.Fin.VecNotation
public import Mathlib.RingTheory.Nullstellensatz
public import Mathlib.RingTheory.Spectrum.Prime.Topology
public import Mathlib.Topology.JacobsonSpace

@[expose] public section

universe u

noncomputable section

open PrimeSpectrum

namespace MvPolynomial.AffinePlane

/-- The vanishing ideal of a point in the affine plane is generated by the two coordinate
differences from that point. -/
theorem pointIdeal_eq_span {k : Type u} [Field k] (x : Fin 2 → k) :
    vanishingIdeal k {x} =
      Ideal.span {X 0 - C (x 0), X 1 - C (x 1)} := sorry

/-- Evaluation at affine-plane points is injective as a map from coordinate vectors to spectrum
points over a field. -/
theorem pointToPoint_injective {k : Type u} [Field k] :
    Function.Injective
      (fun x : Fin 2 → k ↦ (pointToPoint x : PrimeSpectrum (MvPolynomial (Fin 2) k))) :=
    sorry

/-- A prime of the affine plane lying over the zero ideal of the first-coordinate polynomial ring
is either the generic point or a prime generated by an irreducible polynomial. -/
theorem comap_eq_bot {k : Type u} [Field k] [IsAlgClosed k]
    {p : PrimeSpectrum (MvPolynomial (Fin 2) k)}
    (hp :
      (PrimeSpectrum.comap
        (Polynomial.aeval (R := k) (MvPolynomial.X (0 : Fin 2))).toRingHom p).asIdeal = ⊥) :
    p.asIdeal = ⊥ ∨
      ∃ f : MvPolynomial (Fin 2) k, Irreducible f ∧ p.asIdeal = Ideal.span {f} := sorry

/-- A prime in the fiber over the first-coordinate point `a` is either the vertical line at `a`
or a closed point with first coordinate `a`. -/
theorem comap_eq_span {k : Type u} [Field k] [IsAlgClosed k]
    {p : PrimeSpectrum (MvPolynomial (Fin 2) k)} {a : k}
    (hp :
      (PrimeSpectrum.comap
        (Polynomial.aeval (R := k) (MvPolynomial.X (0 : Fin 2))).toRingHom p).asIdeal =
        Ideal.span {Polynomial.X - Polynomial.C a}) :
    p.asIdeal = Ideal.span {X 0 - C a} ∨ ∃ b : k, p = pointToPoint ![a, b] := sorry

/-- Every prime ideal of the affine plane over an algebraically closed field is zero, generated by
an irreducible polynomial, or the vanishing ideal of a rational point. -/
theorem prime_eq_bot_or_span_or_point {k : Type u} [Field k] [IsAlgClosed k]
    (p : PrimeSpectrum (MvPolynomial (Fin 2) k)) :
    p.asIdeal = ⊥ ∨
      (∃ f : MvPolynomial (Fin 2) k, Irreducible f ∧ p.asIdeal = Ideal.span {f}) ∨
        ∃ x : Fin 2 → k, p = pointToPoint x := sorry

/-- An ideal of the affine plane over an algebraically closed field is prime exactly in the three
cases given by the affine-plane prime classification. -/
theorem isPrime_iff {k : Type u} [Field k] [IsAlgClosed k]
    (I : Ideal (MvPolynomial (Fin 2) k)) :
    I.IsPrime ↔
      I = ⊥ ∨
        (∃ f : MvPolynomial (Fin 2) k, Irreducible f ∧ I = Ideal.span {f}) ∨
          ∃ x : Fin 2 → k, I = vanishingIdeal k {x} := sorry

/-- The closed points of the affine plane spectrum are exactly the points associated to rational
coordinate vectors. -/
theorem mem_closedPoints_iff {k : Type u} [Field k] [IsAlgClosed k]
    {p : PrimeSpectrum (MvPolynomial (Fin 2) k)} :
    p ∈ closedPoints (PrimeSpectrum (MvPolynomial (Fin 2) k)) ↔
      ∃ x : Fin 2 → k, p = pointToPoint x := sorry

end MvPolynomial.AffinePlane
