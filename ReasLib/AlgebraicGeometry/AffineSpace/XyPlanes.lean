module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Data.Complex.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import ReasLib.RingTheory.Ideal.PrimeContainment

@[expose] public section

noncomputable section

namespace MvPolynomial.XyPlanes

/-- The ideal generated by `X 0 * X 1` in the polynomial ring `ℂ[x, y, z]`. -/
def relationIdeal : Ideal (MvPolynomial (Fin 3) ℂ) :=
  Ideal.span {X 0 * X 1}

/-- The coordinate ring `ℂ[x, y, z] ⧸ (x * y)` of the union of two coordinate planes. -/
abbrev CoordinateRing :=
  MvPolynomial (Fin 3) ℂ ⧸ relationIdeal

/-- The class of the coordinate `x` in `ℂ[x, y, z] ⧸ (x * y)`. -/
def coordX : CoordinateRing :=
  Ideal.Quotient.mk relationIdeal (X 0)

/-- The class of the coordinate `y` in `ℂ[x, y, z] ⧸ (x * y)`. -/
def coordY : CoordinateRing :=
  Ideal.Quotient.mk relationIdeal (X 1)

/-- The class of the coordinate `z` in `ℂ[x, y, z] ⧸ (x * y)`. -/
def coordZ : CoordinateRing :=
  Ideal.Quotient.mk relationIdeal (X 2)

/-- The ideal `(x, y - 1, z - 5)` of the point `(0, 1, 5)` in `CoordinateRing`. -/
def pointIdeal015 : Ideal CoordinateRing :=
  Ideal.span {coordX, coordY - 1, coordZ - 5}

/-- The ideal `(x - 1, y, z - 7)` of the point `(1, 0, 7)` in `CoordinateRing`. -/
def pointIdeal107 : Ideal CoordinateRing :=
  Ideal.span {coordX - 1, coordY, coordZ - 7}

/-- No prime ideal of `ℂ[x, y, z] ⧸ (x * y)` is contained in both the ideal
`(x, y - 1, z - 5)` and the ideal `(x - 1, y, z - 7)`. -/
theorem not_exists_prime_le_pointIdeals :
    ¬ ∃ p : Ideal CoordinateRing, p.IsPrime ∧ p ≤ pointIdeal015 ∧ p ≤ pointIdeal107 := sorry

end MvPolynomial.XyPlanes
