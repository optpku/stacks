module

public import Mathlib.Algebra.MvPolynomial.Degrees
public import Mathlib.Algebra.Prime.Defs
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import ReasLib.AlgebraicGeometry.Scheme.OverField
public import ReasLib.AlgebraicGeometry.Scheme.Variety

/-!
# Affine hypersurfaces over a field

The spectrum of a multivariate polynomial ring modulo a principal ideal carries
its canonical structure morphism over the coefficient field. For a nonconstant
polynomial, this affine hypersurface is a variety exactly when the polynomial
is irreducible.
-/

@[expose] public section

noncomputable section

universe u

open AlgebraicGeometry CategoryTheory MvPolynomial

namespace AlgebraicGeometry.AffineHypersurface

/-- The principal relation ideal generated by `f`. -/
def relationIdeal {k : Type u} [Field k] {n : ℕ} (f : MvPolynomial (Fin n) k) :
    Ideal (MvPolynomial (Fin n) k) :=
  Ideal.span {f}

/-- The relation ideal is the principal ideal generated by `f`. -/
theorem relationIdeal_eq_span {k : Type u} [Field k] {n : ℕ}
    (f : MvPolynomial (Fin n) k) :
    relationIdeal f = Ideal.span {f} := sorry

/-- The coordinate ring `k[x_1, …, x_n] ⧸ (f)`. -/
abbrev CoordinateRing {k : Type u} [Field k] {n : ℕ} (f : MvPolynomial (Fin n) k) :
    Type u :=
  MvPolynomial (Fin n) k ⧸ relationIdeal f

/-- The affine scheme `Spec (k[x_1, …, x_n] ⧸ (f))`. -/
def scheme {k : Type u} [Field k] {n : ℕ} (f : MvPolynomial (Fin n) k) : Scheme.{u} :=
  Spec (CommRingCat.of (CoordinateRing f))

/-- The affine hypersurface is the spectrum of its coordinate ring. -/
theorem scheme_eq {k : Type u} [Field k] {n : ℕ} (f : MvPolynomial (Fin n) k) :
    scheme f = Spec (CommRingCat.of (CoordinateRing f)) := sorry

/-- The structure morphism to `Spec k` induced by `algebraMap k (CoordinateRing f)`. -/
def toBase {k : Type u} [Field k] {n : ℕ} (f : MvPolynomial (Fin n) k) :
    scheme f ⟶ Spec (CommRingCat.of k) :=
  Spec.map (CommRingCat.ofHom (algebraMap k (CoordinateRing f)))

/-- The structure morphism is `Spec.map` of the coefficient algebra map. -/
theorem toBase_eq {k : Type u} [Field k] {n : ℕ} (f : MvPolynomial (Fin n) k) :
    toBase f = Spec.map (CommRingCat.ofHom (algebraMap k (CoordinateRing f))) := sorry

/-- The affine hypersurface as a scheme over the field `k`. -/
def over {k : Type u} [Field k] {n : ℕ} (f : MvPolynomial (Fin n) k) : SchemeOverField k :=
  Over.mk (toBase f)

/-- The underlying scheme of `over f` is `scheme f`. -/
theorem over_left_eq_scheme {k : Type u} [Field k] {n : ℕ} (f : MvPolynomial (Fin n) k) :
    (over f).left = scheme f := sorry

/-- For a nonconstant polynomial `f`, the coordinate ring is a domain iff `f` is
irreducible. -/
theorem isDomain_coordinateRing_iff {k : Type u} [Field k] {n : ℕ}
    {f : MvPolynomial (Fin n) k} (hf : f.totalDegree ≠ 0) :
    IsDomain (CoordinateRing f) ↔ Irreducible f := sorry

/-- For a nonconstant polynomial `f` over a field `k`, the affine hypersurface
`Spec (k[x_1, …, x_n] ⧸ (f))` is a variety over `k` if and only if `f` is
irreducible. -/
@[stacks 0H8T]
theorem variety_iff_irreducible {k : Type u} [Field k] {n : ℕ}
    {f : MvPolynomial (Fin n) k} (hf : f.totalDegree ≠ 0) :
    Variety (over f) ↔ Irreducible f := sorry

/-- For a nonconstant polynomial `f`, the affine hypersurface is a variety over `k`
if and only if `f` is prime. -/
theorem variety_iff_prime {k : Type u} [Field k] {n : ℕ}
    {f : MvPolynomial (Fin n) k} (hf : f.totalDegree ≠ 0) :
    Variety (over f) ↔ Prime f := sorry

end AlgebraicGeometry.AffineHypersurface
