module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.Tensor.Properties
import StacksCheckRecall

/-!
# Lemma 18.26.3

Tensor closure for the standard local properties is owned by the generic ringed-site module
API.  In particular, proof-only choices of covers and iterated slice comparisons do not occur in
the public statements.
-/

@[expose] public section

open CategoryTheory
open SheafOfModules.RingedSite
open scoped SheafOfModules.RingedSite

noncomputable section

universe u v w

namespace SheafOfModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
variable [HasWeakSheafify J AddCommGrpCat.{w}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
variable {O : Sheaf J CommRingCat.{w}}
variable [∀ U : C, HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
variable [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
variable [∀ U : C, ∀ V : Over U,
  HasWeakSheafify ((J.over U).over V) AddCommGrpCat.{w}]
variable [∀ U : C, ∀ V : Over U,
  ((J.over U).over V).WEqualsLocallyBijective AddCommGrpCat.{w}]
variable (F G : RingedSite.ringedSiteModuleCategory.{u, v, w, w} J O)

/- Lemma 18.26.3 (1) (03L6): locally free module sheaves are closed under tensor product. -/
@[stacks 03L6 "(1)"]
#check fun [F.IsLocallyFree] [G.IsLocallyFree] ↦
  (IsLocallyFree.tensor F G : (F ⊗ G).IsLocallyFree)

/- Lemma 18.26.3 (2) (03L6): finite locally free module sheaves are closed under tensor
product. -/
@[stacks 03L6 "(2)"]
#check fun [IsFiniteLocallyFree F] [IsFiniteLocallyFree G] ↦
  (IsFiniteLocallyFree.tensor F G : IsFiniteLocallyFree (F ⊗ G))

/- Lemma 18.26.3 (3) (03L6): module sheaves locally generated by sections are closed under
tensor product. -/
@[stacks 03L6 "(3)"]
#check fun [IsLocallyGeneratedBySections F] [IsLocallyGeneratedBySections G] ↦
  (IsLocallyGeneratedBySections.tensor F G :
    IsLocallyGeneratedBySections (F ⊗ G))

/- Lemma 18.26.3 (4) (03L6): finite-type module sheaves are closed under tensor product. -/
@[stacks 03L6 "(4)"]
#check fun [F.IsFiniteType] [G.IsFiniteType] ↦
  (IsFiniteType.tensor F G : (F ⊗ G).IsFiniteType)

/- Lemma 18.26.3 (5) (03L6): quasicoherent module sheaves are closed under tensor product. -/
@[stacks 03L6 "(5)"]
#check fun [F.IsQuasicoherent] [G.IsQuasicoherent] ↦
  (IsQuasicoherent.tensor F G : (F ⊗ G).IsQuasicoherent)

/- Lemma 18.26.3 (6) (03L6): finitely presented module sheaves are closed under tensor
product. -/
@[stacks 03L6 "(6)"]
#check fun [F.IsFinitePresentation] [G.IsFinitePresentation] ↦
  (IsFinitePresentation.tensor F G : (F ⊗ G).IsFinitePresentation)

/- Lemma 18.26.3 (7) (03L6): the tensor product of a finitely presented module sheaf and a
coherent module sheaf is coherent. -/
@[stacks 03L6 "(7)"]
#check fun [F.IsFinitePresentation] [IsCoherent G] ↦
  (IsCoherent.tensor_of_finitePresentation_left F G :
    IsCoherent (F ⊗ G))

/- Lemma 18.26.3 (8) (03L6): coherent module sheaves are closed under tensor product. -/
@[stacks 03L6 "(8)"]
#check fun [IsCoherent F] [IsCoherent G] ↦
  (IsCoherent.tensor F G : IsCoherent (F ⊗ G))

end SheafOfModules
