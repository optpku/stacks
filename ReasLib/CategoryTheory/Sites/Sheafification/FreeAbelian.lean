module

public import ReasLib.CategoryTheory.Functor.FreeAbelian
public import Mathlib.CategoryTheory.Sites.Adjunction
public import Mathlib.CategoryTheory.Sites.ConstantSheaf
public import Mathlib.CategoryTheory.Sites.PreservesSheafification
public import Mathlib.CategoryTheory.Sites.Sheafification
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Free abelian sheaves

This module owns the construction which sends a set-valued presheaf on a site to the sheafification
of its objectwise free abelian presheaf.  It also records the canonical comparison with applying
the free-abelian sheaf functor after set-valued sheafification.
-/

@[expose] public section

open CategoryTheory Opposite

noncomputable section

universe w v u

namespace CategoryTheory.GrothendieckTopology

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)

/-- The functor sending a set-valued presheaf to its free abelian sheaf. -/
@[stacks 03AA "functor"]
abbrev freeAbelianSheafFunctor [HasWeakSheafify J AddCommGrpCat.{w}] :
    (Cᵒᵖ ⥤ Type w) ⥤ Sheaf J AddCommGrpCat.{w} :=
  FreeAbelianPresheaf.functor ⋙ presheafToSheaf J AddCommGrpCat.{w}

/-- The free abelian sheaf generated by a set-valued presheaf. -/
@[stacks 03AA]
abbrev freeAbelianSheaf [HasWeakSheafify J AddCommGrpCat.{w}] (G : Cᵒᵖ ⥤ Type w) :
    Sheaf J AddCommGrpCat.{w} :=
  (J.freeAbelianSheafFunctor).obj G

/-- The morphism of free abelian sheaves induced by a morphism of set-valued presheaves. -/
abbrev freeAbelianSheafMap [HasWeakSheafify J AddCommGrpCat.{w}]
    {G H : Cᵒᵖ ⥤ Type w} (f : G ⟶ H) :
    J.freeAbelianSheaf G ⟶ J.freeAbelianSheaf H :=
  (J.freeAbelianSheafFunctor).map f

/-- Under preservation of sheafification by the free abelian group functor, sheafifying first and
then freely abelianizing is canonically isomorphic to freely abelianizing first and then
sheafifying. -/
@[stacks 03AC]
noncomputable def freeAbelianSheafComparison [HasWeakSheafify J (Type w)]
    [HasWeakSheafify J AddCommGrpCat.{w}]
    [J.PreservesSheafification AddCommGrpCat.free] :
    presheafToSheaf J (Type w) ⋙ Sheaf.composeAndSheafify J AddCommGrpCat.free ≅
      J.freeAbelianSheafFunctor :=
  presheafToSheafCompComposeAndSheafifyIso J AddCommGrpCat.free

/-- The component of `freeAbelianSheafComparison` at a set-valued presheaf. -/
@[stacks 03AC "component"]
abbrev freeAbelianSheafComparisonIso [HasWeakSheafify J (Type w)]
    [HasWeakSheafify J AddCommGrpCat.{w}]
    [J.PreservesSheafification AddCommGrpCat.free] (G : Cᵒᵖ ⥤ Type w) :
    (Sheaf.composeAndSheafify J AddCommGrpCat.free).obj ((presheafToSheaf J (Type w)).obj G) ≅
      J.freeAbelianSheaf G :=
  (J.freeAbelianSheafComparison).app G

/-- The composite of free abelianization and sheafification corepresents morphisms from a
set-valued sheaf into the underlying set-valued sheaf of an additive sheaf. -/
noncomputable def freeAbelianSheafOfSheafCorepresentable
    [HasWeakSheafify J AddCommGrpCat.{w}] (F : Sheaf J (Type w)) :
    (sheafForget J ⋙ coyoneda.obj (op F)).CorepresentableBy
      ((Sheaf.composeAndSheafify J AddCommGrpCat.free).obj F) where
  homEquiv {A} := (Sheaf.adjunction J AddCommGrpCat.adj).homEquiv F A
  homEquiv_comp := sorry

/-- The free abelian sheaf on the underlying presheaf of a sheaf corepresents
morphisms from that sheaf into the underlying set-valued sheaf of an additive sheaf. -/
noncomputable def freeAbelianSheafCorepresentable
    [HasWeakSheafify J AddCommGrpCat.{w}] (F : Sheaf J (Type w)) :
    (sheafForget J ⋙ coyoneda.obj (op F)).CorepresentableBy
      (J.freeAbelianSheaf F.obj) where
  homEquiv {A} :=
    ((sheafificationAdjunction J AddCommGrpCat.{w}).homEquiv
      (FreeAbelianPresheaf.obj F.obj) A).trans
        (((AddCommGrpCat.adj.whiskerRight Cᵒᵖ).homEquiv F.obj A.obj).trans
          (Sheaf.homEquiv (X := F) (Y := (sheafForget J).obj A)).symm)
  homEquiv_comp := sorry

/-- Freely abelianizing a set-valued sheaf and then sheafifying agrees canonically with the
free abelian sheaf on its underlying presheaf. -/
noncomputable def freeAbelianSheafOfSheafIso
    [HasWeakSheafify J AddCommGrpCat.{w}] (F : Sheaf J (Type w)) :
    (Sheaf.composeAndSheafify J AddCommGrpCat.free).obj F ≅
      J.freeAbelianSheaf F.obj :=
  Functor.CorepresentableBy.uniqueUpToIso
    (J.freeAbelianSheafOfSheafCorepresentable F)
    (J.freeAbelianSheafCorepresentable F)

/-- Freely abelianizing a constant set-valued sheaf gives the constant additive sheaf on the
free abelian group.  This is the constant-object specialization of compatibility with
sheafification, packaged independently of any chosen terminal object. -/
@[stacks 03AC "constant sheaf"]
noncomputable def freeAbelianConstantSheafIso
    [HasWeakSheafify J (Type w)] [HasWeakSheafify J AddCommGrpCat.{w}]
    [J.PreservesSheafification AddCommGrpCat.free] (X : Type w) :
    (Sheaf.composeAndSheafify J AddCommGrpCat.free).obj
        ((constantSheaf J (Type w)).obj X) ≅
      (constantSheaf J AddCommGrpCat.{w}).obj (AddCommGrpCat.free.obj X) :=
  J.freeAbelianSheafComparisonIso ((Functor.const Cᵒᵖ).obj X) ≪≫
    (presheafToSheaf J AddCommGrpCat.{w}).mapIso
      ((Functor.compConstIso Cᵒᵖ AddCommGrpCat.free).symm.app X)

end CategoryTheory.GrothendieckTopology

namespace CategoryTheory.Sheaf.composeAndSheafify

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}

/-- Freely abelianizing a set-valued sheaf and sheafifying preserves monomorphisms. -/
@[stacks 03AB "mono preservation"]
instance free_preservesMonomorphisms [HasSheafify J AddCommGrpCat.{w}] :
    (Sheaf.composeAndSheafify J AddCommGrpCat.free).PreservesMonomorphisms := sorry

end CategoryTheory.Sheaf.composeAndSheafify
