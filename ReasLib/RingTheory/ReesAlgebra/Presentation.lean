module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.ReesAlgebra.Grading.Structure

/-!
# Relation presentations of Rees algebras

For a family of elements of an ideal, this leaf records the canonical polynomial
map to the Rees algebra and the quotient by the universal pair relations.  The
relations and the induced map are valid for every family; injectivity is kept
out of this generic layer because it is a linear-type property, not a formal
consequence of generation.
-/

@[expose] public section

noncomputable section

universe u v

open MvPolynomial

namespace ReesAlgebra.Presentation

variable {R : Type u} [CommRing R]
variable {ι : Type v}

/-! ## The generic relation presentation -/

/-- The pair relation `x i X j - x j X i` for a family in an ideal. -/
@[stacks 0G8Q "Rees presentation pair relation"]
def relation {I : Ideal R} (x : ι → I) (i j : ι) : MvPolynomial ι R :=
  C (x i : R) * X j - C (x j : R) * X i

/-- The ideal generated by all pair relations of a family. -/
@[stacks 0G8Q "Rees presentation relation ideal"]
def relationIdeal {I : Ideal R} (x : ι → I) : Ideal (MvPolynomial ι R) :=
  Ideal.span (Set.range fun ij : ι × ι ↦ relation x ij.1 ij.2)

/-- The polynomial quotient by the pair relations. -/
@[stacks 0G8Q "Rees presentation quotient"]
abbrev Quotient {I : Ideal R} (x : ι → I) :=
  MvPolynomial ι R ⧸ relationIdeal x

/-- Evaluation of the presentation variables at degree-one Rees elements. -/
@[stacks 0G8Q "Rees presentation evaluation map"]
noncomputable def toRees {I : Ideal R} (x : ι → I) :
    MvPolynomial ι R →ₐ[R] reesAlgebra I :=
  MvPolynomial.aeval (fun i ↦ ReesAlgebra.Grading.degreeOne I (x i))

/-- Each pair relation vanishes under Rees evaluation. -/
@[stacks 0G8Q "Rees presentation relation vanishing"]
theorem relation_toRees {I : Ideal R} (x : ι → I) (i j : ι) :
    toRees x (relation x i j) = 0 := sorry

/-- The relation ideal is contained in the evaluation kernel. -/
@[stacks 0G8Q "Rees presentation relation kernel inclusion"]
theorem relationIdeal_le_ker {I : Ideal R} (x : ι → I) :
    relationIdeal x ≤ RingHom.ker (toRees x).toRingHom := sorry

/-- The quotient map induced by Rees evaluation. -/
@[stacks 0G8Q "Rees presentation quotient map"]
noncomputable def map {I : Ideal R} (x : ι → I) :
    Quotient x →ₐ[R] reesAlgebra I :=
  Ideal.Quotient.liftₐ (relationIdeal x) (toRees x)
    (fun p hp ↦ RingHom.mem_ker.mp (relationIdeal_le_ker x hp))

/-- Evaluation of a quotient representative. -/
@[stacks 0G8Q "Rees presentation quotient representative", simp]
theorem map_mk {I : Ideal R} (x : ι → I) (p : MvPolynomial ι R) :
    map x (Ideal.Quotient.mk (relationIdeal x) p) = toRees x p := sorry

/-- The generic Rees presentation map preserves base scalars. -/
@[stacks 0G8Q "Rees presentation scalar map", simp]
theorem map_algebraMap {I : Ideal R} (x : ι → I) (r : R) :
    map x (algebraMap R (Quotient x) r) = algebraMap R (reesAlgebra I) r := sorry

/-- Evaluation of a quotient variable. -/
@[stacks 0G8Q "Rees presentation quotient variable", simp]
theorem map_X {I : Ideal R} (x : ι → I) (i : ι) :
    map x (Ideal.Quotient.mk (relationIdeal x) (X i)) =
      ReesAlgebra.Grading.degreeOne I (x i) := sorry

/-- Generation of the ideal by the selected family implies surjectivity. -/
@[stacks 0G8Q "Rees presentation map surjective"]
theorem map_surjective {I : Ideal R} (x : ι → I)
    (hI : I ≤ Ideal.span (Set.range fun i : ι ↦ (x i : R))) :
    Function.Surjective (map x) := sorry

end ReesAlgebra.Presentation
