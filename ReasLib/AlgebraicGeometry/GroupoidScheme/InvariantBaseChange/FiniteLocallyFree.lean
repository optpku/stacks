module

public import Mathlib.RingTheory.RingHom.Flat
public import ReasLib.AlgebraicGeometry.GroupoidScheme.AffineIntegral
public import ReasLib.AlgebraicGeometry.GroupoidScheme.InvariantBaseChange.Presentation
public import ReasLib.RingTheory.Ideal.LocallyNilpotent
public import ReasLib.RingTheory.RingHom.ShiftPower

/-!
# Invariant base change for finite locally free groupoid schemes

This module records shifted-power generation, kernel nilpotence, and flat base-change results
for the canonical map into the invariant ring.
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry.GroupoidScheme

namespace InvariantBaseChange

/-- Every invariant function after coefficient base change satisfies a positive shifted-power
polynomial equation over the new coefficient ring. -/
theorem shiftPower {S : Scheme.{u}} (G : GroupoidScheme S)
    {A B C' : Type u} [CommRing A] [CommRing B] [CommRing C'] [Algebra A B]
    (target : A →+* B) (eU : Spec (CommRingCat.of A) ≅ G.U.left)
    (eR : Spec (CommRingCat.of B) ≅ G.R.left)
    (h_source : eR.hom ≫ G.s.left =
      Spec.map (CommRingCat.ofHom (algebraMap A B)) ≫ eU.hom)
    (h_target : eR.hom ≫ G.t.left = Spec.map (CommRingCat.ofHom target) ≫ eU.hom)
    [IsFiniteLocallyFree G.s.left] [IsFiniteLocallyFree G.t.left]
    (γ : target.eqLocus (algebraMap A B) →+* C') :
    -- Local instance justification (defeq pin): use the source-induced equalizer action on `B` determined by `target`.
    letI : Algebra (target.eqLocus (algebraMap A B)) B :=
      ((algebraMap A B).comp (target.eqLocus (algebraMap A B)).subtype).toAlgebra
    -- Local instance justification (defeq pin): use the coefficient action selected by the explicit map `γ` in this tensor statement.
    letI : Algebra (target.eqLocus (algebraMap A B)) C' := γ.toAlgebra
    ∀ f : RingHom.EqLocusBaseChange.invariantRing target (algebraMap A B) γ,
      f ∈ RingHom.ShiftPower.generators
        (RingHom.EqLocusBaseChange.toInvariant target (algebraMap A B) γ) := sorry

/-- The canonical invariant-ring map is generated by elements admitting shifted-power
equations. -/
theorem isGenerated {S : Scheme.{u}} (G : GroupoidScheme S)
    {A B C' : Type u} [CommRing A] [CommRing B] [CommRing C'] [Algebra A B]
    (target : A →+* B) (eU : Spec (CommRingCat.of A) ≅ G.U.left)
    (eR : Spec (CommRingCat.of B) ≅ G.R.left)
    (h_source : eR.hom ≫ G.s.left =
      Spec.map (CommRingCat.ofHom (algebraMap A B)) ≫ eU.hom)
    (h_target : eR.hom ≫ G.t.left = Spec.map (CommRingCat.ofHom target) ≫ eU.hom)
    [IsFiniteLocallyFree G.s.left] [IsFiniteLocallyFree G.t.left]
    (γ : target.eqLocus (algebraMap A B) →+* C') :
    -- Local instance justification (defeq pin): use the source-induced equalizer action on `B` determined by `target`.
    letI : Algebra (target.eqLocus (algebraMap A B)) B :=
      ((algebraMap A B).comp (target.eqLocus (algebraMap A B)).subtype).toAlgebra
    -- Local instance justification (defeq pin): use the coefficient action selected by the explicit map `γ` in this tensor statement.
    letI : Algebra (target.eqLocus (algebraMap A B)) C' := γ.toAlgebra
    RingHom.ShiftPower.IsGenerated
      (RingHom.EqLocusBaseChange.toInvariant target (algebraMap A B) γ) := sorry

/-- Every element of the kernel of the canonical invariant-ring map has a positive power equal
to zero. -/
theorem kernel_nilpotent {S : Scheme.{u}} (G : GroupoidScheme S)
    {A B C' : Type u} [CommRing A] [CommRing B] [CommRing C'] [Algebra A B]
    (target : A →+* B) (eU : Spec (CommRingCat.of A) ≅ G.U.left)
    (eR : Spec (CommRingCat.of B) ≅ G.R.left)
    (h_source : eR.hom ≫ G.s.left =
      Spec.map (CommRingCat.ofHom (algebraMap A B)) ≫ eU.hom)
    (h_target : eR.hom ≫ G.t.left = Spec.map (CommRingCat.ofHom target) ≫ eU.hom)
    [IsFiniteLocallyFree G.s.left] [IsFiniteLocallyFree G.t.left]
    (γ : target.eqLocus (algebraMap A B) →+* C') :
    -- Local instance justification (defeq pin): use the source-induced equalizer action on `B` determined by `target`.
    letI : Algebra (target.eqLocus (algebraMap A B)) B :=
      ((algebraMap A B).comp (target.eqLocus (algebraMap A B)).subtype).toAlgebra
    -- Local instance justification (defeq pin): use the coefficient action selected by the explicit map `γ` in this tensor statement.
    letI : Algebra (target.eqLocus (algebraMap A B)) C' := γ.toAlgebra
    ∀ f : C', RingHom.EqLocusBaseChange.toInvariant target (algebraMap A B) γ f = 0 →
      ∃ n : ℕ, 0 < n ∧ f ^ n = 0 := sorry

/-- The kernel of the canonical invariant-ring map is locally nilpotent. -/
theorem ker_isLocallyNilpotent
    {S : Scheme.{u}} (G : GroupoidScheme S)
    {A B C' : Type u} [CommRing A] [CommRing B] [CommRing C'] [Algebra A B]
    (target : A →+* B) (eU : Spec (CommRingCat.of A) ≅ G.U.left)
    (eR : Spec (CommRingCat.of B) ≅ G.R.left)
    (h_source : eR.hom ≫ G.s.left =
      Spec.map (CommRingCat.ofHom (algebraMap A B)) ≫ eU.hom)
    (h_target : eR.hom ≫ G.t.left = Spec.map (CommRingCat.ofHom target) ≫ eU.hom)
    [IsFiniteLocallyFree G.s.left] [IsFiniteLocallyFree G.t.left]
    (γ : target.eqLocus (algebraMap A B) →+* C') :
    -- Local instance justification (defeq pin): use the source-induced equalizer action on `B` determined by `target`.
    letI : Algebra (target.eqLocus (algebraMap A B)) B :=
      ((algebraMap A B).comp (target.eqLocus (algebraMap A B)).subtype).toAlgebra
    -- Local instance justification (defeq pin): use the coefficient action selected by the explicit map `γ` in this tensor statement.
    letI : Algebra (target.eqLocus (algebraMap A B)) C' := γ.toAlgebra
    (RingHom.ker (RingHom.EqLocusBaseChange.toInvariant
      target (algebraMap A B) γ)).IsLocallyNilpotent := sorry

/-- A flat extension of the invariant coefficient ring makes the canonical map to the new
invariant ring bijective. -/
theorem bijective_of_flat
    {S : Scheme.{u}} (G : GroupoidScheme S)
    {A B C' : Type u} [CommRing A] [CommRing B] [CommRing C'] [Algebra A B]
    (target : A →+* B) (eU : Spec (CommRingCat.of A) ≅ G.U.left)
    (eR : Spec (CommRingCat.of B) ≅ G.R.left)
    (h_source : eR.hom ≫ G.s.left =
      Spec.map (CommRingCat.ofHom (algebraMap A B)) ≫ eU.hom)
    (h_target : eR.hom ≫ G.t.left = Spec.map (CommRingCat.ofHom target) ≫ eU.hom)
    [IsFiniteLocallyFree G.s.left] [IsFiniteLocallyFree G.t.left]
    (γ : target.eqLocus (algebraMap A B) →+* C') (hγ : γ.Flat) :
    -- Local instance justification (defeq pin): use the source-induced equalizer action on `B` determined by `target`.
    letI : Algebra (target.eqLocus (algebraMap A B)) B :=
      ((algebraMap A B).comp (target.eqLocus (algebraMap A B)).subtype).toAlgebra
    -- Local instance justification (defeq pin): use the coefficient action selected by the explicit map `γ` in this tensor statement.
    letI : Algebra (target.eqLocus (algebraMap A B)) C' := γ.toAlgebra
    Function.Bijective
      (RingHom.EqLocusBaseChange.toInvariant target (algebraMap A B) γ) := sorry

end InvariantBaseChange

end AlgebraicGeometry.GroupoidScheme
