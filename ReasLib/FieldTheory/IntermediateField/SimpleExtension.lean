module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
public import Mathlib.FieldTheory.RatFunc.AsPolynomial
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

universe u v

open scoped IntermediateField
open IntermediateField

namespace FieldExtension

/-- A field generated by a specified element is isomorphic either to a rational function field
or to the quotient by an irreducible polynomial, according as its generator is transcendental or
algebraic. -/
theorem algEquivRatFuncOrAdjoinRootOfAdjoinEqTop
    {k : Type u} {F : Type v} [Field k] [Field F] [Algebra k F]
    (α : F) (htop : k⟮α⟯ = ⊤) :
    Nonempty (RatFunc k ≃ₐ[k] F) ∨
      ∃ P : Polynomial k, Irreducible P ∧ Nonempty (AdjoinRoot P ≃ₐ[k] F) := by
  have eTop : k⟮α⟯ ≃ₐ[k] F := (equivOfEq htop).trans topEquiv
  by_cases halg : IsAlgebraic k α
  · refine Or.inr ?_
    refine ⟨minpoly k α, minpoly.irreducible halg.isIntegral, ?_⟩
    exact ⟨(adjoinRootEquivAdjoin k halg.isIntegral).trans eTop⟩
  · refine Or.inl ?_
    exact ⟨(RatFunc.algEquivOfTranscendental α halg).trans eTop⟩

/-- Lemma 9.6.8 (Classification of simple extensions): a field extension generated by one
element is isomorphic either to `RatFunc k` or to `AdjoinRoot P` for an irreducible polynomial
`P : k[X]`. -/
theorem simpleExtensionIsomorphicToRatFuncOrAdjoinRoot
    {k : Type u} {F : Type v} [Field k] [Field F] [Algebra k F]
    (hgen : ∃ α : F, k⟮α⟯ = ⊤) :
    Nonempty (RatFunc k ≃ₐ[k] F) ∨
      ∃ P : Polynomial k, Irreducible P ∧ Nonempty (AdjoinRoot P ≃ₐ[k] F) := by
  obtain ⟨α, htop⟩ := hgen
  exact algEquivRatFuncOrAdjoinRootOfAdjoinEqTop α htop

/-- In a field extension of prime degree, every element outside the base intermediate field
generates the whole extension. -/
theorem adjoinSimpleEqTopOfNotMemBotOfFinrankPrime
    {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]
    (hprime : Nat.Prime (Module.finrank F E)) {x : E}
    (hx : x ∉ (⊥ : IntermediateField F E)) :
    F⟮x⟯ = ⊤ := by
  have hsimple : IsSimpleOrder (IntermediateField F E) :=
    IntermediateField.isSimpleOrder_of_finrank_prime F E hprime
  rcases hsimple.eq_bot_or_eq_top F⟮x⟯ with hx_bot | hx_top
  · exact (hx <| (IntermediateField.adjoin_simple_eq_bot_iff).1 hx_bot).elim
  · exact hx_top

/-- A field extension of prime degree has a primitive generator outside its base intermediate
field. -/
theorem existsPrimitiveGeneratorOfFinrankPrime
    {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]
    (hprime : Nat.Prime (Module.finrank F E)) :
    ∃ x : E, x ∉ (⊥ : IntermediateField F E) ∧ F⟮x⟯ = ⊤ := by
  have hbot_ne_top : (⊥ : IntermediateField F E) ≠ ⊤ := by
    intro hbot_top
    have hfinrank_one : Module.finrank F E = 1 :=
      (IntermediateField.bot_eq_top_iff_finrank_eq_one (F := F) (E := E)).1 hbot_top
    exact hprime.ne_one hfinrank_one
  obtain ⟨x, hx_not_bot⟩ : ∃ x : E, x ∉ (⊥ : IntermediateField F E) := by
    by_contra hx_exists
    push Not at hx_exists
    apply hbot_ne_top
    apply top_unique
    intro x hx
    exact hx_exists x
  exact ⟨x, hx_not_bot,
    adjoinSimpleEqTopOfNotMemBotOfFinrankPrime hprime hx_not_bot⟩

end FieldExtension
