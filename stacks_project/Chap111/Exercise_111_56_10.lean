module

import StacksCheckRecall
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.BasicOpen
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.PlaneCurve.Complement

/-!
# Exercise 111.56.10

The complement of a plane curve `D = V₊(F) ⊂ P²_k` is the basic open `D₊(F)`, and the
`k`-algebra of functions on that open is generated by at most `Nat.choose (d + 2) 2`
elements. Its canonical algebra model is the degree-zero homogeneous localization:
fractions `g/F^r` with `g` homogeneous of degree `r*d`. The fractions of degree-`d`
monomials by `F` generate this algebra and give the stated upper bound.
-/

@[expose] public section

open AlgebraicGeometry
open AlgebraicGeometry.ProjectiveSpace
open scoped AlgebraicGeometry

noncomputable section

universe u

/- Exercise 111.56.10: the complement of the plane curve is the defining basic open,
and its section algebra has at most the number of degree-`d` monomials as generators. -/
@[stacks 09U5]
#check (AlgebraicGeometry.ProjectiveSpace.PlaneCurve.complement_sections :
  ∀ {k : Type u} [Field k] [IsAlgClosed k] (d : ℕ) (F : MvPolynomial (Fin 3) k)
    (hF : F ∈ grading k 2 d) (hirr : Irreducible F),
    ((basicOpen (R := k) 2 F : Set (scheme k 2)) =
      (ProjectiveSpectrum.zeroLocus (grading k 2)
        ({F} : Set (MvPolynomial (Fin 3) k)))ᶜ) ∧
    ∃ s : Finset (Scheme.Hom.sectionsAlgOverSpec (toSpec k 2) (basicOpen 2 F)),
      s.card ≤ Nat.choose (d + 2) 2 ∧
        Algebra.adjoin k
          (s : Set (Scheme.Hom.sectionsAlgOverSpec (toSpec k 2) (basicOpen 2 F))) = ⊤)

variable {k : Type u} [Field k] [IsAlgClosed k] (d : ℕ)
  (F : MvPolynomial (Fin 3) k) (hF : F ∈ grading k 2 d) (hirr : Irreducible F)

#check (AlgebraicGeometry.ProjectiveSpace.basicOpenSectionsAlgEquiv 2 d F hF
    (AlgebraicGeometry.ProjectiveSpace.PlaneCurve.zero_lt_degree_of_irreducible d F hF hirr) :
  HomogeneousLocalization.Away (grading k 2) F ≃ₐ[k]
    Scheme.Hom.sectionsAlgOverSpec (toSpec k 2) (basicOpen 2 F))

#check (ProjectiveSpectrum.basicOpen_eq_zeroLocus_compl (grading k 2) F :
  (basicOpen (R := k) 2 F : Set (scheme k 2)) =
    (ProjectiveSpectrum.zeroLocus (grading k 2) ({F} : Set (MvPolynomial (Fin 3) k)))ᶜ)
