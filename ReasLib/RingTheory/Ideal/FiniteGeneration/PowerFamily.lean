module

public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Ideals generated by powers of families

This file provides the canonical owner for the ideal generated by powers of an arbitrary family.
It also provides `Fin`-indexed specializations and the ordered-prefix API for finite families.
-/

universe u v w

namespace Ideal

variable {R : Type u} [Semiring R]

/-- The ideal generated by the `e`-th powers of an arbitrary family. -/
@[stacks 07F8 "power span of a family"]
def powerSpan {ι : Type v} (π : ι → R) (e : ℕ) : Ideal R :=
  Ideal.span (Set.range fun i ↦ π i ^ e)

/-- Taking the `e`-th powers of an entrywise `c`-th power family is the same
as taking the `(e * c)`-th powers of the original family. -/
@[stacks 07FE "power span of a powered family", simp]
theorem powerSpan_pow {ι : Type v} (π : ι → R) (e c : ℕ) :
    powerSpan (fun i ↦ π i ^ c) e = powerSpan π (e * c) := sorry

/-- Increasing the common exponent decreases the ideal generated by a family of powers. -/
@[stacks 0GZ4 "antitonicity of power spans"]
theorem powerSpan_anti {ι : Type v} (π : ι → R) :
    Antitone (powerSpan π) := sorry

/-- The ideal generated by the `e`-th powers of a `Fin`-indexed family. -/
@[stacks 07F8 "finite power span"]
def finPowerSpan {r : ℕ} (π : Fin r → R) (e : ℕ) : Ideal R :=
  powerSpan π e

/-- The `Fin`-indexed power span is the corresponding arbitrary-family power span. -/
@[simp]
theorem finPowerSpan_eq_powerSpan {r : ℕ} (π : Fin r → R) (e : ℕ) :
    finPowerSpan π e = powerSpan π e := sorry

/-- The ideal generated by the `e`-th powers of the entries of `π` whose
indices are strictly smaller than `n`. The definition is meaningful for every
`n`, so callers do not carry a proof that `n ≤ r` as part of the datum. -/
@[stacks 07F8 "prefix power ideal"]
def finPrefixPowerSpan {r : ℕ} (π : Fin r → R) (e n : ℕ) : Ideal R :=
  Ideal.span ((fun i : Fin r ↦ π i ^ e) '' {i | i.1 < n})

/-- Taking the `e`-th powers of an entrywise `c`-th power family is the same
as taking the `(e * c)`-th powers of the original family. -/
@[stacks 07FE "finite power span of a powered family", simp]
theorem finPowerSpan_pow {r : ℕ} (π : Fin r → R) (e c : ℕ) :
    finPowerSpan (fun i ↦ π i ^ c) e = finPowerSpan π (e * c) := sorry

/-- Increasing the common exponent decreases the ideal generated by a finite family of powers. -/
@[stacks 0GZ4 "antitonicity of finite power spans"]
theorem finPowerSpan_anti {r : ℕ} (π : Fin r → R) :
    Antitone (finPowerSpan π) := sorry

section Quotient

variable {A : Type u} [CommRing A]

/-- For `n ≤ m`, the canonical map from the quotient by the `m`th powers of a family to the
quotient by its `n`th powers. -/
@[stacks 0GZ4 "transition between power quotients"]
def powerQuotientMap {ι : Type v} (π : ι → A) {n m : ℕ} (h : n ≤ m) :
    A ⧸ powerSpan π m →ₐ[A] A ⧸ powerSpan π n :=
  Ideal.Quotient.factorₐ A (powerSpan_anti π h)

/-- A power-quotient transition sends a residue class to the residue class of the same
representative. -/
@[simp]
theorem powerQuotientMap_mk {ι : Type v} (π : ι → A) {n m : ℕ}
    (h : n ≤ m) (x : A) :
    powerQuotientMap π h (Ideal.Quotient.mk (powerSpan π m) x) =
      Ideal.Quotient.mk (powerSpan π n) x := sorry

/-- The power-quotient transition at a fixed exponent is the identity. -/
@[simp]
theorem powerQuotientMap_refl {ι : Type v} (π : ι → A) (n : ℕ) :
    powerQuotientMap π (le_refl n) = AlgHom.id A (A ⧸ powerSpan π n) := sorry

/-- Power-quotient transitions compose according to transitivity of exponent bounds. -/
@[simp]
theorem powerQuotientMap_comp {ι : Type v} (π : ι → A) {n m l : ℕ}
    (h_nm : n ≤ m) (h_ml : m ≤ l) :
    (powerQuotientMap π h_nm).comp (powerQuotientMap π h_ml) =
      powerQuotientMap π (h_nm.trans h_ml) := sorry

/-- For `n ≤ m`, the canonical map from the quotient by the `m`th powers to the quotient by
the `n`th powers. -/
@[stacks 0GZ4 "transition between finite power quotients"]
def finPowerQuotientMap {r : ℕ} (π : Fin r → A) {n m : ℕ} (h : n ≤ m) :
    A ⧸ finPowerSpan π m →ₐ[A] A ⧸ finPowerSpan π n :=
  powerQuotientMap π h

/-- The finite-family quotient transition is the arbitrary-family transition specialized to
`Fin r`. -/
@[simp]
theorem finPowerQuotientMap_eq_powerQuotientMap {r : ℕ} (π : Fin r → A)
    {n m : ℕ} (h : n ≤ m) :
    finPowerQuotientMap π h = powerQuotientMap π h := sorry

/-- A finite-power quotient transition sends a residue class to the residue class of the same
representative. -/
@[simp]
theorem finPowerQuotientMap_mk {r : ℕ} (π : Fin r → A) {n m : ℕ}
    (h : n ≤ m) (x : A) :
    finPowerQuotientMap π h (Ideal.Quotient.mk (finPowerSpan π m) x) =
      Ideal.Quotient.mk (finPowerSpan π n) x := sorry

/-- The finite-power quotient transition at a fixed exponent is the identity. -/
@[simp]
theorem finPowerQuotientMap_refl {r : ℕ} (π : Fin r → A) (n : ℕ) :
    finPowerQuotientMap π (le_refl n) = AlgHom.id A (A ⧸ finPowerSpan π n) := sorry

/-- Finite-power quotient transitions compose according to transitivity of exponent bounds. -/
@[simp]
theorem finPowerQuotientMap_comp {r : ℕ} (π : Fin r → A) {n m l : ℕ}
    (h_nm : n ≤ m) (h_ml : m ≤ l) :
    (finPowerQuotientMap π h_nm).comp (finPowerQuotientMap π h_ml) =
      finPowerQuotientMap π (h_nm.trans h_ml) := sorry

end Quotient

/-- Prefix power spans commute with entrywise powers, with the exponents
multiplied. -/
@[stacks 07FE "prefix power span of a powered family", simp]
theorem finPrefixPowerSpan_pow {r : ℕ} (π : Fin r → R) (e c n : ℕ) :
    finPrefixPowerSpan (fun i ↦ π i ^ c) e n =
      finPrefixPowerSpan π (e * c) n := sorry

/-- A bounded prefix-power ideal agrees with the span of the corresponding
`Fin n`-indexed range. -/
theorem finPrefixPowerSpan_eq_span_range {r : ℕ} (π : Fin r → R)
    (e n : ℕ) (hn : n ≤ r) :
    finPrefixPowerSpan π e n =
      Ideal.span (Set.range fun i : Fin n ↦ π (Fin.castLE hn i) ^ e) := sorry

/-- The empty prefix generates the zero ideal. -/
@[simp]
theorem finPrefixPowerSpan_zero {r : ℕ} (π : Fin r → R) (e : ℕ) :
    finPrefixPowerSpan π e 0 = ⊥ := sorry

/-- Enlarging a prefix can only enlarge its power ideal. -/
theorem finPrefixPowerSpan_mono {r : ℕ} (π : Fin r → R) (e : ℕ)
    {m n : ℕ} (hmn : m ≤ n) :
    finPrefixPowerSpan π e m ≤ finPrefixPowerSpan π e n := sorry

/-- Adding the next entry to a bounded prefix adjoins its `e`-th power. -/
theorem finPrefixPowerSpan_succ {r : ℕ} (π : Fin r → R) (e n : ℕ)
    (hn : n < r) :
    finPrefixPowerSpan π e (n + 1) =
      finPrefixPowerSpan π e n ⊔ Ideal.span ({π ⟨n, hn⟩ ^ e} : Set R) := sorry

/-- Taking the full prefix gives the ideal generated by all powers in the
family. -/
@[simp]
theorem finPrefixPowerSpan_full {r : ℕ} (π : Fin r → R) (e : ℕ) :
    finPrefixPowerSpan π e r = finPowerSpan π e := sorry

/-- Every powered entry belonging to a prefix lies in its prefix-power ideal. -/
theorem pow_mem_finPrefixPowerSpan {r : ℕ} (π : Fin r → R) (e n : ℕ)
    {i : Fin r} (hi : i.1 < n) :
    π i ^ e ∈ finPrefixPowerSpan π e n := sorry

/-- Ring homomorphisms carry a family power span to the power span of the mapped family. -/
theorem map_powerSpan {S : Type w} [Semiring S] (f : R →+* S)
    {ι : Type v} (π : ι → R) (e : ℕ) :
    Ideal.map f (powerSpan π e) = powerSpan (fun i ↦ f (π i)) e := sorry

/-- Ring homomorphisms carry a finite-family power ideal to the corresponding
power ideal of the mapped family. -/
theorem map_finPowerSpan {S : Type w} [Semiring S] (f : R →+* S)
    {r : ℕ} (π : Fin r → R) (e : ℕ) :
    Ideal.map f (finPowerSpan π e) = finPowerSpan (fun i ↦ f (π i)) e := sorry

/-- The extension of a positive power span is contained in a target ideal whenever every mapped
generator is contained in that ideal. -/
theorem map_powerSpan_le_of_pos {S : Type w} [Semiring S] (f : R →+* S)
    {ι : Type v} (π : ι → R) (e : ℕ) (he : 0 < e) (J : Ideal S)
    (hπ : ∀ i, f (π i) ∈ J) :
    Ideal.map f (powerSpan π e) ≤ J := sorry

/-- The extension of a positive-power ideal generated by a finite family is
contained in a target ideal whenever every mapped generator is contained in
that ideal. -/
theorem map_finPowerSpan_le_of_pos {S : Type w} [Semiring S] (f : R →+* S)
    {r : ℕ} (π : Fin r → R) (e : ℕ) (he : 0 < e) (J : Ideal S)
    (hπ : ∀ i, f (π i) ∈ J) :
    Ideal.map f (finPowerSpan π e) ≤ J := sorry

/-- The extension of a power span with a positive exponent is contained in a target ideal whenever
every mapped generator belongs to that ideal. -/
theorem map_powerSpan_le {S : Type w} [Semiring S] (f : R →+* S)
    {ι : Type v} (π : ι → R) (e : ℕ+) (J : Ideal S)
    (hπ : ∀ i, f (π i) ∈ J) :
    Ideal.map f (powerSpan π e) ≤ J := sorry

/-- The extension of a power ideal with a positive exponent is contained in
a target ideal whenever every mapped generator belongs to that ideal. -/
theorem map_finPowerSpan_le {S : Type w} [Semiring S] (f : R →+* S)
    {r : ℕ} (π : Fin r → R) (e : ℕ+) (J : Ideal S)
    (hπ : ∀ i, f (π i) ∈ J) :
    Ideal.map f (finPowerSpan π e) ≤ J := sorry

/-- Ring homomorphisms carry a prefix-power ideal to the corresponding
prefix-power ideal of the mapped family. -/
theorem map_finPrefixPowerSpan {S : Type v} [Semiring S] (f : R →+* S)
    {r : ℕ} (π : Fin r → R) (e n : ℕ) :
    Ideal.map f (finPrefixPowerSpan π e n) =
      finPrefixPowerSpan (fun i ↦ f (π i)) e n := sorry

/-- Updating an entry at or after the cutoff does not change the earlier
prefix-power ideal. -/
theorem finPrefixPowerSpan_update_of_le {r : ℕ} (π : Fin r → R)
    (e n : ℕ) {i : Fin r} (hni : n ≤ i.1) (x : R) :
    finPrefixPowerSpan (Function.update π i x) e n =
      finPrefixPowerSpan π e n := sorry

/-- If a family lies in an ideal and the exponent is positive, then its power span lies in that
ideal. -/
theorem powerSpan_le_of_forall_mem {ι : Type v} (π : ι → R)
    (e : ℕ) (he : 0 < e) (I : Ideal R) (hπ : ∀ i, π i ∈ I) :
    powerSpan π e ≤ I := sorry

/-- If a finite family lies in an ideal and the exponent is positive, then its
power ideal lies in that ideal. -/
theorem finPowerSpan_le_of_forall_mem {r : ℕ} (π : Fin r → R)
    (e : ℕ) (he : 0 < e) (I : Ideal R) (hπ : ∀ i, π i ∈ I) :
    finPowerSpan π e ≤ I := sorry

end Ideal
