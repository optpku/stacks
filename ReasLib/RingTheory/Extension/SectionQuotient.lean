module

public import ReasLib.RingTheory.Extension.Infinitesimal
public import ReasLib.RingTheory.Extension.Quotient
public import Mathlib.RingTheory.Extension.Cotangent.Basic
import Mathlib.Tactic.CrossRefAttribute

/-!
# Quotients generated by sections of an extension's cotangent complex

A map from the cotangent space back to the cotangent module determines
elements of the square-zero kernel of the infinitesimal extension. This file
packages those elements without choosing a presentation of the extension.

@stack 04EB
-/

@[expose] public section

noncomputable section

universe u v w

namespace Algebra.Extension.SectionQuotient

variable {R : Type u} {S : Type v}
variable [CommRing R] [CommRing S] [Algebra R S]

/-- Transport a map into an extension's cotangent module back to the
cotangent ideal of its infinitesimal extension. The subtype records the
kernel invariant, while restriction of scalars preserves the natural
`P.Ring`-linear structure. -/
@[stacks 04EB "cotangent-section generator"]
noncomputable def generator (P : Extension.{w} R S)
    (l : P.CotangentSpace →ₗ[S] P.Cotangent) :
    P.CotangentSpace →ₗ[P.Ring] P.ker.cotangentIdeal :=
  (Ideal.cotangentEquivIdeal P.ker).toLinearMap.comp <|
    P.cotangentEquivCotangentKer.toLinearMap.comp (l.restrictScalars P.Ring)

/-- Evaluation of a transported cotangent-section generator. -/
@[simp, stacks 04EB "cotangent-section generator evaluation"]
theorem generator_apply (P : Extension.{w} R S)
    (l : P.CotangentSpace →ₗ[S] P.Cotangent) (x : P.CotangentSpace) :
    generator P l x =
      Ideal.cotangentEquivIdeal P.ker (P.cotangentEquivCotangentKer (l x)) :=
  rfl

-- Local instance justification (instance diamond): the quotient action of
-- `P.Ring` on `P.infinitesimal.Ring` is canonical here, but globally it can
-- compete with the base-algebra action when the two source types coincide.
attribute [local instance] Algebra.Extension.Infinitesimal.algebra

set_option backward.isDefEq.respectTransparency false in
/-- A transported cotangent-section generator, included into the
infinitesimal extension ring as a linear map. -/
@[stacks 04EB "cotangent-section generator in the infinitesimal ring"]
noncomputable def generatorToInfinitesimal (P : Extension.{w} R S)
    (l : P.CotangentSpace →ₗ[S] P.Cotangent) :
    P.CotangentSpace →ₗ[P.Ring] P.infinitesimal.Ring :=
  (Algebra.Extension.Infinitesimal.cotangentIdealSubtype P).comp (generator P l)

set_option backward.isDefEq.respectTransparency false in
/-- Evaluation of the cotangent-section generator in the infinitesimal ring. -/
@[simp, stacks 04EB "cotangent-section generator in the infinitesimal ring"]
theorem generatorToInfinitesimal_apply (P : Extension.{w} R S)
    (l : P.CotangentSpace →ₗ[S] P.Cotangent) (x : P.CotangentSpace) :
    generatorToInfinitesimal P l x =
      Algebra.Extension.Infinitesimal.cotangentIdealSubtype P (generator P l x) :=
  rfl

/-- The ideal in the infinitesimal extension generated by a transported
cotangent-section image. -/
@[stacks 04EB "cotangent-section image ideal"]
noncomputable def ideal (P : Extension.{w} R S)
    (l : P.CotangentSpace →ₗ[S] P.Cotangent) : Ideal P.infinitesimal.Ring :=
  Ideal.span <| Set.range (generatorToInfinitesimal P l)

/-- Every transported section generator belongs to its generated ideal. -/
@[stacks 04EB "cotangent-section generator membership"]
theorem generator_mem (P : Extension.{w} R S)
    (l : P.CotangentSpace →ₗ[S] P.Cotangent) (x : P.CotangentSpace) :
    generatorToInfinitesimal P l x ∈ ideal P l :=
  Ideal.subset_span ⟨x, rfl⟩

set_option backward.isDefEq.respectTransparency false in
/-- The ideal generated by a transported cotangent-section image lies in the
kernel of the infinitesimal extension. -/
@[stacks 04EB "cotangent-section ideal lies in the infinitesimal kernel"]
theorem ideal_le_ker (P : Extension.{w} R S)
    (l : P.CotangentSpace →ₗ[S] P.Cotangent) :
    ideal P l ≤ P.infinitesimal.ker := by
  refine Ideal.span_le.mpr ?_
  rintro _ ⟨x, rfl⟩
  rw [Extension.ker_infinitesimal]
  exact (generator P l x).property

/-- The map to the target induced from the infinitesimal extension after
quotienting by the cotangent-section image ideal. -/
@[stacks 04EB "cotangent-section quotient map"]
noncomputable def toAlgHom (P : Extension.{w} R S)
    (l : P.CotangentSpace →ₗ[S] P.Cotangent) :
    P.infinitesimal.Ring ⧸ ideal P l →ₐ[R] S :=
  Algebra.Extension.Quotient.toAlgHom P.infinitesimal (ideal P l) (ideal_le_ker P l)

/-- The cotangent-section quotient map is surjective. -/
@[stacks 04EB "cotangent-section quotient map is surjective"]
theorem toAlgHom_surjective (P : Extension.{w} R S)
    (l : P.CotangentSpace →ₗ[S] P.Cotangent) :
    Function.Surjective (toAlgHom P l) :=
  Algebra.Extension.Quotient.toAlgHom_surjective
    P.infinitesimal (ideal P l) (ideal_le_ker P l)

/-- The extension obtained from the infinitesimal extension by killing a
cotangent-section image ideal. -/
@[stacks 04EB "cotangent-section quotient extension"]
noncomputable def extension (P : Extension.{w} R S)
    (l : P.CotangentSpace →ₗ[S] P.Cotangent) : Extension R S :=
  Algebra.Extension.Quotient.extension P.infinitesimal (ideal P l) (ideal_le_ker P l)

/-- The chosen section of a cotangent-section quotient is the image of the
section of the infinitesimal extension. -/
@[simp, stacks 04EB "cotangent-section quotient extension section"]
theorem extension_σ (P : Extension.{w} R S)
    (l : P.CotangentSpace →ₗ[S] P.Cotangent) (s : S) :
    (extension P l).σ s = Ideal.Quotient.mk (ideal P l) (P.infinitesimal.σ s) :=
  Algebra.Extension.Quotient.extension_σ
    P.infinitesimal (ideal P l) (ideal_le_ker P l) s

/-- The structure map of the cotangent-section quotient extension is its
induced quotient map. -/
@[simp, stacks 04EB "cotangent-section quotient extension structure map"]
theorem extension_toAlgHom (P : Extension.{w} R S)
    (l : P.CotangentSpace →ₗ[S] P.Cotangent) :
    IsScalarTower.toAlgHom R (extension P l).Ring S = toAlgHom P l :=
  Algebra.Extension.Quotient.extension_toAlgHom
    P.infinitesimal (ideal P l) (ideal_le_ker P l)

/-- The kernel of the cotangent-section quotient extension is the image of
the infinitesimal kernel. -/
@[simp, stacks 04EB "kernel of a cotangent-section quotient extension"]
theorem extension_ker (P : Extension.{w} R S)
    (l : P.CotangentSpace →ₗ[S] P.Cotangent) :
    (extension P l).ker =
      P.infinitesimal.ker.map (Ideal.Quotient.mk (ideal P l)) :=
  Algebra.Extension.Quotient.extension_ker
    P.infinitesimal (ideal P l) (ideal_le_ker P l)

/-- A cotangent-section quotient extension has square-zero kernel. -/
@[stacks 04EB "square-zero cotangent-section quotient extension"]
theorem extension_square_zero (P : Extension.{w} R S)
    (l : P.CotangentSpace →ₗ[S] P.Cotangent) :
    (extension P l).ker ^ 2 = ⊥ :=
  Algebra.Extension.Quotient.extension_square_zero
    P.infinitesimal (ideal P l) (ideal_le_ker P l) P.infinitesimal_ker_sq_eq_bot

end Algebra.Extension.SectionQuotient
