module

public import ReasLib.RingTheory.ReesAlgebra.BlowupChart.Tor
import StacksCheckRecall

@[expose] public section

open CategoryTheory
open scoped AffineBlowupChart ModuleTor

universe u

/- Lemma 51.21.2: if the ideal `I` of a Noetherian ring `A` is generated by the
positive-length family `a`, then one positive power of `I` annihilates
`Tor⁽i⁾[A](A[I / a₁], M)` for every `A`-module `M` and every `i ≥ t`. -/
@[stacks 0G9Y]
#check (AffineBlowupChart.exists_pow_le_annihilator_tor :
  ∀ {A : Type u} [CommRing A] [IsNoetherianRing A]
    (I : Ideal A) (t : ℕ) (ht : 0 < t) (a : Fin t → I)
    (ha : I = Ideal.span (Set.range fun j ↦ (a j : A))),
    ∃ c : ℕ, 0 < c ∧ ∀ (M : Type u) [AddCommGroup M] [Module A M] (i : ℕ),
      t ≤ i →
        I ^ c ≤ Module.annihilator A Tor⁽i⁾[A](A[I / (a ⟨0, ht⟩)], M))
