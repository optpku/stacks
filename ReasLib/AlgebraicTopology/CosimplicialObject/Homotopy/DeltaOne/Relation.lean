module

public import ReasLib.AlgebraicTopology.CosimplicialObject.Homotopy.DeltaOne.Functoriality
public import ReasLib.CategoryTheory.HomRel.Functor
public import Mathlib.CategoryTheory.Quotient
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Product-free cosimplicial homotopy relations

This file owns the directed relation generated by componentwise `Δ[1]`-homotopies, its
equivalence closure, and the corresponding congruence on the hom-sets of cosimplicial objects.
The relation owner is shared by structured equivalences and quotient-category constructions.
-/

@[expose] public section

universe u v u' v'

namespace CategoryTheory.CosimplicialObject

variable {C : Type u} [Category.{v} C]
variable {D : Type u'} [Category.{v'} D]
variable {U V : CosimplicialObject C} {a b : U ⟶ V}

namespace DeltaOneHomotopy

/-- The one-step relation used to generate the product-free homotopy equivalence relation. -/
@[stacks 0FKJ "directed product-free cosimplicial homotopy"]
def directed {X Y : CosimplicialObject C} (f g : X ⟶ Y) : Prop :=
  Nonempty (DeltaOneHomotopy f g)

end DeltaOneHomotopy

namespace DeltaOneHomotopy.directed

/-- A concrete product-free homotopy supplies a directed product-free homotopy step. -/
@[stacks 0FKJ "concrete product-free homotopy gives a directed step"]
theorem of_homotopy (h : DeltaOneHomotopy a b) :
    DeltaOneHomotopy.directed a b := sorry

/-- Equality of cosimplicial morphisms supplies a directed product-free homotopy step. -/
@[stacks 0FKJ "equality gives a directed product-free homotopy"]
theorem of_eq (h : a = b) : DeltaOneHomotopy.directed a b := sorry

/-- Directed product-free homotopy is reflexive. -/
@[refl, stacks 0FKJ "reflexivity of directed product-free homotopy"]
theorem refl (a : U ⟶ V) : DeltaOneHomotopy.directed a a := sorry

/-- Precomposition preserves directed product-free homotopy. -/
@[stacks 0FKJ "precomposition preserves directed product-free homotopy"]
theorem precomp {T : CosimplicialObject C}
    (h : DeltaOneHomotopy.directed a b) (p : T ⟶ U) :
    DeltaOneHomotopy.directed (p ≫ a) (p ≫ b) := sorry

/-- Postcomposition preserves directed product-free homotopy. -/
@[stacks 0FKJ "postcomposition preserves directed product-free homotopy"]
theorem postcomp {W : CosimplicialObject C}
    (h : DeltaOneHomotopy.directed a b) (p : V ⟶ W) :
    DeltaOneHomotopy.directed (a ≫ p) (b ≫ p) := sorry

/-- Simultaneous precomposition and postcomposition preserve directed product-free homotopy. -/
theorem precomp_postcomp {T W : CosimplicialObject C}
    (h : DeltaOneHomotopy.directed a b) (p : T ⟶ U) (q : V ⟶ W) :
    DeltaOneHomotopy.directed (p ≫ a ≫ q) (p ≫ b ≫ q) := sorry

/-- Conjugation along an isomorphism preserves directed product-free homotopy. -/
theorem conjugate {T : CosimplicialObject C} {a b : U ⟶ U}
    (h : DeltaOneHomotopy.directed a b) (e : T ≅ U) :
    DeltaOneHomotopy.directed (e.hom ≫ a ≫ e.inv) (e.hom ≫ b ≫ e.inv) := sorry

/-- Applying a functor degreewise preserves directed product-free homotopy. -/
@[stacks 019Y "functors preserve directed product-free homotopy"]
theorem whiskerRight (h : DeltaOneHomotopy.directed a b) (F : C ⥤ D) :
    DeltaOneHomotopy.directed
      (Functor.whiskerRight a F) (Functor.whiskerRight b F) := sorry

end DeltaOneHomotopy.directed

/-- Two morphisms are product-free `Δ[1]`-homotopic when they are connected by a finite zigzag of
directed product-free homotopies. -/
@[stacks 0FKJ "product-free cosimplicial homotopy relation"]
def DeltaOneHomotopic (a b : U ⟶ V) : Prop :=
  Relation.EqvGen DeltaOneHomotopy.directed a b

/-- Product-free `Δ[1]`-homotopy is reflexive. -/
@[refl, stacks 0FKJ "reflexivity of product-free cosimplicial homotopy"]
lemma DeltaOneHomotopic.refl (a : U ⟶ V) : DeltaOneHomotopic a a := sorry

/-- Product-free `Δ[1]`-homotopy is symmetric. -/
@[symm, stacks 0FKJ "symmetry of product-free cosimplicial homotopy"]
lemma DeltaOneHomotopic.symm {a b : U ⟶ V} (h : DeltaOneHomotopic a b) :
    DeltaOneHomotopic b a := sorry

/-- Product-free `Δ[1]`-homotopy is transitive. -/
@[trans, stacks 0FKJ "transitivity of product-free cosimplicial homotopy"]
lemma DeltaOneHomotopic.trans {a b c : U ⟶ V}
    (hab : DeltaOneHomotopic a b) (hbc : DeltaOneHomotopic b c) :
    DeltaOneHomotopic a c := sorry

/-- A concrete product-free homotopy gives its associated zigzag relation. -/
@[stacks 0FKJ "concrete homotopy belongs to the product-free relation"]
theorem DeltaOneHomotopic.of_homotopy (h : DeltaOneHomotopy a b) :
    DeltaOneHomotopic a b := sorry

/-- A directed product-free homotopy step belongs to its generated zigzag relation. -/
@[stacks 0FKJ "directed step belongs to the product-free relation"]
theorem DeltaOneHomotopic.of_directed (h : DeltaOneHomotopy.directed a b) :
    DeltaOneHomotopic a b := sorry

/-- Equal cosimplicial morphisms belong to the product-free zigzag homotopy relation. -/
@[stacks 0FKJ "equality belongs to the product-free relation"]
theorem DeltaOneHomotopic.of_eq (h : a = b) : DeltaOneHomotopic a b := sorry

/-- A function on morphisms that carries directed product-free homotopies to zigzags preserves
the induced `DeltaOneHomotopic` relation. -/
@[stacks 0FKJ "mapping the product-free cosimplicial homotopy relation"]
theorem DeltaOneHomotopic.map
    (h : DeltaOneHomotopic a b)
    {E : Type u'} [Category.{v'} E]
    {U' V' : CosimplicialObject E}
    (F : (U ⟶ V) → (U' ⟶ V'))
    (hF : ∀ {x y : U ⟶ V},
      DeltaOneHomotopy.directed x y → DeltaOneHomotopic (F x) (F y)) :
    DeltaOneHomotopic (F a) (F b) := sorry

/-- Precomposition preserves product-free `Δ[1]`-homotopy. -/
@[stacks 0FKJ "precomposition preserves product-free cosimplicial homotopy"]
theorem DeltaOneHomotopic.precomp
    {T : CosimplicialObject C} (h : DeltaOneHomotopic a b) (p : T ⟶ U) :
    DeltaOneHomotopic (p ≫ a) (p ≫ b) := sorry

/-- Postcomposition preserves product-free `Δ[1]`-homotopy. -/
@[stacks 0FKJ "postcomposition preserves product-free cosimplicial homotopy"]
theorem DeltaOneHomotopic.postcomp
    {W : CosimplicialObject C} (h : DeltaOneHomotopic a b) (p : V ⟶ W) :
    DeltaOneHomotopic (a ≫ p) (b ≫ p) := sorry

/-- Simultaneous precomposition and postcomposition preserve product-free `Δ[1]`-homotopy. -/
theorem DeltaOneHomotopic.precomp_postcomp
    {T W : CosimplicialObject C} (h : DeltaOneHomotopic a b)
    (p : T ⟶ U) (q : V ⟶ W) :
    DeltaOneHomotopic (p ≫ a ≫ q) (p ≫ b ≫ q) := sorry

/-- Conjugation along an isomorphism preserves product-free `Δ[1]`-homotopy. -/
theorem DeltaOneHomotopic.conjugate
    {T : CosimplicialObject C} {a b : U ⟶ U}
    (h : DeltaOneHomotopic a b) (e : T ≅ U) :
    DeltaOneHomotopic (e.hom ≫ a ≫ e.inv) (e.hom ≫ b ≫ e.inv) := sorry

/-- Functors preserve the zigzag relation generated by product-free `Δ[1]`-homotopies. -/
@[stacks 0FKJ "functors preserve product-free cosimplicial homotopy"]
theorem DeltaOneHomotopic.whiskerRight (h : DeltaOneHomotopic a b) (F : C ⥤ D) :
    DeltaOneHomotopic (Functor.whiskerRight a F) (Functor.whiskerRight b F) := sorry

/-- The canonical hom-set relation on cosimplicial objects given by product-free
`Δ[1]`-homotopy. -/
@[stacks 0FKJ "canonical cosimplicial homotopy relation"]
def homotopyRel (C : Type u) [Category.{v} C] : HomRel (CosimplicialObject C) :=
  fun _ _ ↦ DeltaOneHomotopic

/-- Membership in the canonical product-free cosimplicial homotopy relation. -/
@[simp, stacks 0FKJ "membership in the canonical cosimplicial homotopy relation"]
theorem homotopyRel_iff {C : Type u} [Category.{v} C]
    {X Y : CosimplicialObject C} (f g : X ⟶ Y) :
    homotopyRel C f g ↔ DeltaOneHomotopic f g := sorry

/-- The explicit `Δ[1]` presentation name for the canonical cosimplicial homotopy relation. -/
@[deprecated homotopyRel (since := "2026-08-06")]
abbrev deltaOneHomotopyRel (C : Type u) [Category.{v} C] :
    HomRel (CosimplicialObject C) :=
  homotopyRel C

/-- Membership in the explicit `Δ[1]` presentation of the relation. -/
@[deprecated homotopyRel_iff (since := "2026-08-06")]
theorem deltaOneHomotopyRel_iff {C : Type u} [Category.{v} C]
    {X Y : CosimplicialObject C} (f g : X ⟶ Y) :
    deltaOneHomotopyRel C f g ↔ DeltaOneHomotopic f g := sorry

namespace homotopyRel

namespace whiskeringRight

/-- Degreewise application of a functor preserves product-free `Δ[1]`-homotopy. -/
@[stacks 0FKJ "functors map the product-free cosimplicial homotopy relation"]
instance isMappedBy {C : Type u} [Category.{v} C]
    {D : Type u'} [Category.{v'} D] (F : C ⥤ D) :
    HomRel.IsMappedBy (homotopyRel C)
      ((Functor.whiskeringRight SimplexCategory C D).obj F) (homotopyRel D) := sorry

end whiskeringRight

/-- Product-free `Δ[1]`-homotopy is compatible with composition. -/
@[stacks 0FKJ "product-free cosimplicial homotopy is a congruence"]
instance congruence (C : Type u) [Category.{v} C] :
    Congruence (homotopyRel C) := sorry

end homotopyRel

end CategoryTheory.CosimplicialObject
