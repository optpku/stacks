module

public import ReasLib.Algebra.Homology.CochainComplex.InjectiveResolution.Map
public import ReasLib.CategoryTheory.ObjectProperty.Orthogonal.Localization
import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Homotopy Comparison of Injective Resolutions

This leaf is independent of a choice of derived category. It packages the universal comparison
property of bounded-below injective resolutions over arbitrary morphisms in the homotopy
category, together with its identity, composition, and strict-map compatibility API.
-/

open CategoryTheory
open ComplexShape

universe v u

namespace CochainComplex.InjectiveResolution

variable {𝒜 : Type u} [Category.{v} 𝒜] [Abelian 𝒜]

/-- A morphism between injective models lies over `u` when the induced square with the two
resolution comparisons commutes in the homotopy category. -/
@[stacks 013Y "homotopy map of injective resolutions"]
abbrev IsHomotopyMap {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L)
    (a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex) : Prop :=
  CommSq ((HomotopyCategory.quotient 𝒜 (up ℤ)).map I.ι) u a
    ((HomotopyCategory.quotient 𝒜 (up ℤ)).map J.ι)

/-- A homotopy comparison between resolutions of the same complex is a homotopy map lying over
the identity of that complex. -/
@[stacks 013Y]
abbrev IsHomotopyComparison {K : CochainComplex 𝒜 ℤ} (I J : InjectiveResolution K)
    (a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex) : Prop :=
  I.IsHomotopyMap J (𝟙 _) a

namespace IsHomotopyMap

/-- The `CommSq` model of `IsHomotopyMap` unfolds to the expected comparison equation. -/
@[simp]
theorem iff {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L)
    (a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex) :
    I.IsHomotopyMap J u a ↔
      (HomotopyCategory.quotient 𝒜 (up ℤ)).map I.ι ≫ a =
        u ≫ (HomotopyCategory.quotient 𝒜 (up ℤ)).map J.ι := by
  exact ⟨fun h ↦ h.w, fun h ↦ ⟨h⟩⟩

/-- The identity of an injective model lies over the identity of its base complex. -/
theorem id {K : CochainComplex 𝒜 ℤ} (I : InjectiveResolution K) :
    I.IsHomotopyMap I (𝟙 _) (𝟙 _) := by
  exact ⟨by simp⟩

/-- Compatible homotopy maps are closed under composition. -/
theorem comp {K L M : CochainComplex 𝒜 ℤ}
    {I : InjectiveResolution K} {J : InjectiveResolution L}
    {H : InjectiveResolution M}
    {u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L}
    {v : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj M}
    {a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex}
    {b : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj H.complex}
    (ha : I.IsHomotopyMap J u a) (hb : J.IsHomotopyMap H v b) :
    I.IsHomotopyMap H (u ≫ v) (a ≫ b) := by
  refine ⟨?_⟩
  calc
    (HomotopyCategory.quotient 𝒜 (up ℤ)).map I.ι ≫ (a ≫ b) =
        (u ≫ (HomotopyCategory.quotient 𝒜 (up ℤ)).map J.ι) ≫ b := by
          rw [← Category.assoc, ha.w]
    _ = (u ≫ v) ≫ (HomotopyCategory.quotient 𝒜 (up ℤ)).map H.ι := by
      rw [Category.assoc, hb.w, ← Category.assoc]

end IsHomotopyMap

/-- The homotopy-category image of an injective-resolution comparison belongs to the
triangulated localization system generated by acyclic complexes. -/
theorem ι_mem_trW {K : CochainComplex 𝒜 ℤ} (I : InjectiveResolution K) :
    (HomotopyCategory.subcategoryAcyclic 𝒜).trW
      ((HomotopyCategory.quotient 𝒜 (up ℤ)).map I.ι) := by
  exact Eq.mp
    (congrArg
      (fun W : CategoryTheory.MorphismProperty (HomotopyCategory 𝒜 (up ℤ)) ↦
        W ((HomotopyCategory.quotient 𝒜 (up ℤ)).map I.ι))
      (HomotopyCategory.quasiIso_eq_trW_subcategoryAcyclic 𝒜))
    ((HomotopyCategory.quotient_map_mem_quasiIso_iff I.ι).2 I.hw)

/-- The homotopy-category object of an injective resolution is right orthogonal to acyclic
complexes. -/
theorem complex_rightOrthogonal {K : CochainComplex 𝒜 ℤ} (I : InjectiveResolution K) :
    (HomotopyCategory.subcategoryAcyclic 𝒜).rightOrthogonal
      ((HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex) := by
  exact @CochainComplex.IsKInjective.rightOrthogonal 𝒜 _ _ I.complex
    (@CochainComplex.isKInjective_of_injective 𝒜 _ _ I.complex
      (Classical.choose I.model.obj.property)
      (Classical.choose_spec I.model.obj.property)
      (fun n ↦ I.model.property n))

/-- Precomposition with the quasi-isomorphism of an injective resolution is
bijective on homotopy-category morphisms into any injective resolution. -/
theorem comparison_bijective {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L) :
    Function.Bijective
      (fun a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
          (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex ↦
        (HomotopyCategory.quotient 𝒜 (up ℤ)).map I.ι ≫ a) := by
  have hJ : (HomotopyCategory.subcategoryAcyclic 𝒜).trW.isLocal
      ((HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex) :=
    Eq.mpr
      (congrArg
        (fun P : CategoryTheory.ObjectProperty (HomotopyCategory 𝒜 (up ℤ)) ↦
          P ((HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex))
        (CategoryTheory.ObjectProperty.isLocal_trW
          (HomotopyCategory.subcategoryAcyclic 𝒜)))
      J.complex_rightOrthogonal
  exact hJ _ I.ι_mem_trW

/-- Precomposition with an injective-resolution comparison, bundled as the canonical additive
Hom equivalence in the homotopy category. -/
@[stacks 013Y "additive injective-resolution homotopy lifting equivalence"]
noncomputable def comparisonAddEquiv {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L) :
    ((HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
        (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex) ≃+
      ((HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
        (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex) :=
  CategoryTheory.ObjectProperty.rightOrthogonal.homAddEquiv
    (P := HomotopyCategory.subcategoryAcyclic 𝒜)
    (Eq.mp
      (congrArg
        (fun W : CategoryTheory.MorphismProperty (HomotopyCategory 𝒜 (up ℤ)) ↦
          W ((HomotopyCategory.quotient 𝒜 (up ℤ)).map I.ι))
        (HomotopyCategory.quasiIso_eq_trW_subcategoryAcyclic 𝒜))
      ((HomotopyCategory.quotient_map_mem_quasiIso_iff I.ι).2 I.hw))
    (@CochainComplex.IsKInjective.rightOrthogonal 𝒜 _ _ J.complex
      (@CochainComplex.isKInjective_of_injective 𝒜 _ _ J.complex
        (Classical.choose J.model.obj.property)
        (Classical.choose_spec J.model.obj.property)
        (fun n ↦ J.model.property n)))

/-- Precomposition with an injective-resolution comparison, bundled as the canonical
hom-set equivalence in the homotopy category. -/
@[stacks 013Y "injective-resolution homotopy lifting equivalence"]
noncomputable def comparisonEquiv {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L) :
    ((HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
        (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex) ≃
      ((HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
        (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex) :=
  CategoryTheory.ObjectProperty.rightOrthogonal.homEquiv
    (P := HomotopyCategory.subcategoryAcyclic 𝒜)
    (Eq.mp
      (congrArg
        (fun W : CategoryTheory.MorphismProperty (HomotopyCategory 𝒜 (up ℤ)) ↦
          W ((HomotopyCategory.quotient 𝒜 (up ℤ)).map I.ι))
        (HomotopyCategory.quasiIso_eq_trW_subcategoryAcyclic 𝒜))
      ((HomotopyCategory.quotient_map_mem_quasiIso_iff I.ι).2 I.hw))
    (@CochainComplex.IsKInjective.rightOrthogonal 𝒜 _ _ J.complex
      (@CochainComplex.isKInjective_of_injective 𝒜 _ _ J.complex
        (Classical.choose J.model.obj.property)
        (Classical.choose_spec J.model.obj.property)
        (fun n ↦ J.model.property n)))

/-- Evaluating the additive injective-resolution Hom equivalence is precomposition by the
resolution comparison. -/
@[simp]
theorem comparisonAddEquiv_apply {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex) :
    comparisonAddEquiv I J a =
      (HomotopyCategory.quotient 𝒜 (up ℤ)).map I.ι ≫ a := by
  rfl

/-- Evaluating the injective-resolution Hom equivalence is precomposition by the resolution
comparison. -/
@[simp]
theorem comparisonEquiv_apply {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex) :
    comparisonEquiv I J a =
      (HomotopyCategory.quotient 𝒜 (up ℤ)).map I.ι ≫ a := by
  rfl

/-- The canonical extension of an arbitrary homotopy-category morphism across an injective
resolution comparison. -/
@[stacks 013Y "canonical extension across an injective resolution"]
noncomputable def homotopyExtension {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (g : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex) :
    (HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex :=
  (comparisonEquiv I J).symm g

/-- The inverse additive comparison equivalence computes the canonical homotopy extension. -/
@[simp]
theorem comparisonAddEquiv_symm_apply {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (g : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex) :
    (comparisonAddEquiv I J).symm g = I.homotopyExtension J g := by
  rfl

/-- The inverse comparison equivalence computes the canonical homotopy extension. -/
@[simp]
theorem comparisonEquiv_symm_apply {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (g : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex) :
    (comparisonEquiv I J).symm g = I.homotopyExtension J g := by
  rfl

/-- A canonical homotopy extension restricts to the morphism being extended. -/
@[reassoc]
theorem homotopyExtension_fac {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (g : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex) :
    (HomotopyCategory.quotient 𝒜 (up ℤ)).map I.ι ≫
        I.homotopyExtension J g = g := by
  exact (comparisonEquiv I J).apply_symm_apply g

/-- A morphism with the prescribed restriction is the canonical homotopy extension. -/
theorem homotopyExtension_unique {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (g : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex)
    {a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex}
    (ha : (HomotopyCategory.quotient 𝒜 (up ℤ)).map I.ι ≫ a = g) :
    a = I.homotopyExtension J g := by
  apply (comparison_bijective I J).injective
  exact ha.trans (homotopyExtension_fac I J g).symm

/-- The canonical homotopy extension is characterized by its restriction. -/
@[simp]
theorem homotopyExtension_eq_iff {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (g : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex)
    (a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex) :
    I.homotopyExtension J g = a ↔
      (HomotopyCategory.quotient 𝒜 (up ℤ)).map I.ι ≫ a = g := by
  constructor
  · intro h
    rw [← h]
    exact homotopyExtension_fac I J g
  · intro h
    exact (homotopyExtension_unique I J g h).symm

/-- Canonical injective-resolution extensions are natural in the right-hand resolution.

Postcomposing the morphism being extended agrees with first extending into the intermediate
injective model and then postcomposing there. -/
@[stacks 013Y "postcomposition naturality of injective extensions"]
theorem homotopyExtension_comp {K L M : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (H : InjectiveResolution M)
    (g : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex)
    (k : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj H.complex) :
    I.homotopyExtension H (g ≫ k) = I.homotopyExtension J g ≫ k := by
  symm
  apply homotopyExtension_unique I H (g ≫ k)
  rw [← Category.assoc, homotopyExtension_fac]

/-- The canonical homotopy-category map between injective resolutions lying over `u`. -/
@[stacks 013Y "canonical homotopy map of injective resolutions"]
noncomputable def homotopyMap {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L) :
    (HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex :=
  I.homotopyExtension J
    (u ≫ (HomotopyCategory.quotient 𝒜 (up ℤ)).map J.ι)

/-- The canonical homotopy map satisfies its comparison square. -/
@[reassoc]
theorem homotopyMap_fac {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L) :
    (HomotopyCategory.quotient 𝒜 (up ℤ)).map I.ι ≫ I.homotopyMap J u =
      u ≫ (HomotopyCategory.quotient 𝒜 (up ℤ)).map J.ι := by
  exact homotopyExtension_fac I J _

/-- The canonical injective-resolution homotopy map is compatible with its base morphism. -/
theorem homotopyMap_isHomotopyMap {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L) :
    I.IsHomotopyMap J u (I.homotopyMap J u) := by
  exact ⟨homotopyMap_fac I J u⟩

/-- A homotopy-category map between injective resolutions is determined by the base morphism
over which it lies. -/
theorem homotopyMap_unique {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L)
    {a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex}
    (ha : I.IsHomotopyMap J u a) : a = I.homotopyMap J u := by
  exact homotopyExtension_unique I J _ ha.w

/-- A morphism between injective models lies over `u` exactly when it is the canonical
homotopy map over `u`. -/
@[simp]
theorem isHomotopyMap_iff {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L)
    (a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex) :
    I.IsHomotopyMap J u a ↔ a = I.homotopyMap J u := by
  constructor
  · intro ha
    exact homotopyMap_unique I J u ha
  · intro ha
    subst a
    exact homotopyMap_isHomotopyMap I J u

/-- The canonical map over an identity is the identity of the injective model. -/
@[simp]
theorem homotopyMap_id {K : CochainComplex 𝒜 ℤ} (I : InjectiveResolution K) :
    I.homotopyMap I (𝟙 _) = 𝟙 _ := by
  exact (homotopyMap_unique I I (𝟙 _) (IsHomotopyMap.id I)).symm

/-- Canonical homotopy maps respect composition of base morphisms. -/
@[simp ←]
theorem homotopyMap_comp {K L M : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (H : InjectiveResolution M)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L)
    (v : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj M) :
    I.homotopyMap H (u ≫ v) = I.homotopyMap J u ≫ J.homotopyMap H v := by
  exact (homotopyMap_unique I H (u ≫ v)
    ((homotopyMap_isHomotopyMap I J u).comp
      (homotopyMap_isHomotopyMap J H v))).symm

/-- A strict map of injective resolutions represents the canonical homotopy map over its base
cochain map. -/
theorem homotopyMap_eq_map {K L : CochainComplex 𝒜 ℤ} {f : K ⟶ L}
    {I : InjectiveResolution K} {J : InjectiveResolution L}
    (m : Map f I J) :
    I.homotopyMap J ((HomotopyCategory.quotient 𝒜 (up ℤ)).map f) =
      (HomotopyCategory.quotient 𝒜 (up ℤ)).map m.hom := by
  symm
  apply homotopyMap_unique I J _
  refine ⟨?_⟩
  have hm : I.ι ≫ m.hom = f ≫ J.ι :=
    CategoryTheory.LocalizerMorphism.RightResolution.Map.comparison_naturality m
  rw [← Functor.map_comp, hm, Functor.map_comp]

/-- A strict map of injective resolutions is a compatible homotopy map after passing to the
homotopy category. -/
theorem Map.isHomotopyMap {K L : CochainComplex 𝒜 ℤ} {f : K ⟶ L}
    {I : InjectiveResolution K} {J : InjectiveResolution L} (m : Map f I J) :
    I.IsHomotopyMap J ((HomotopyCategory.quotient 𝒜 (up ℤ)).map f)
      ((HomotopyCategory.quotient 𝒜 (up ℤ)).map m.hom) := by
  rw [← homotopyMap_eq_map m]
  exact homotopyMap_isHomotopyMap I J _

/-- A strict injective-resolution map computes the canonical homotopy map after reidentifying
the base morphism. -/
theorem homotopyMap_eq_map_of_eq {K L : CochainComplex 𝒜 ℤ} {f : K ⟶ L}
    {I : InjectiveResolution K} {J : InjectiveResolution L}
    {u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L}
    (m : Map f I J) (hu : (HomotopyCategory.quotient 𝒜 (up ℤ)).map f = u) :
    I.homotopyMap J u = (HomotopyCategory.quotient 𝒜 (up ℤ)).map m.hom := by
  rw [← hu]
  exact homotopyMap_eq_map m

/-- Canonical homotopy maps simplify when the left factor is represented by a strict
injective-resolution map. -/
@[simp ←]
theorem homotopyMap_map_comp {K L M : CochainComplex 𝒜 ℤ} {f : K ⟶ L}
    {I : InjectiveResolution K} {J : InjectiveResolution L}
    (H : InjectiveResolution M) (m : Map f I J)
    (v : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj M) :
    I.homotopyMap H ((HomotopyCategory.quotient 𝒜 (up ℤ)).map f ≫ v) =
      (HomotopyCategory.quotient 𝒜 (up ℤ)).map m.hom ≫ J.homotopyMap H v := by
  rw [homotopyMap_comp, homotopyMap_eq_map m]

/-- Canonical homotopy maps simplify when the right factor is represented by a strict
injective-resolution map. -/
@[simp ←]
theorem homotopyMap_comp_map {K L M : CochainComplex 𝒜 ℤ} {g : L ⟶ M}
    (I : InjectiveResolution K) {J : InjectiveResolution L}
    {H : InjectiveResolution M}
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L)
    (n : Map g J H) :
    I.homotopyMap H (u ≫ (HomotopyCategory.quotient 𝒜 (up ℤ)).map g) =
      I.homotopyMap J u ≫ (HomotopyCategory.quotient 𝒜 (up ℤ)).map n.hom := by
  rw [homotopyMap_comp, homotopyMap_eq_map n]

/-- Every base morphism admits a unique compatible map between chosen injective resolutions in
the homotopy category. -/
@[stacks 013Y]
theorem existsUnique_homotopyMap {K L : CochainComplex 𝒜 ℤ}
    (I : InjectiveResolution K) (J : InjectiveResolution L)
    (u : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj K ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj L) :
    ∃! a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
        (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex,
      I.IsHomotopyMap J u a := by
  exact ⟨I.homotopyMap J u, homotopyMap_isHomotopyMap I J u,
    fun _ ha ↦ homotopyMap_unique I J u ha⟩

/-- A homotopy comparison between two injective resolutions is an isomorphism. -/
theorem isIso_of_isHomotopyComparison {K : CochainComplex 𝒜 ℤ}
    (I J : InjectiveResolution K)
    {a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
      (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex}
    (ha : I.IsHomotopyComparison J a) : IsIso a := by
  have ha' : a = I.homotopyMap J (𝟙 _) := homotopyMap_unique I J (𝟙 _) ha
  subst a
  refine ⟨⟨J.homotopyMap I (𝟙 _), ?_, ?_⟩⟩
  · show I.homotopyMap J (𝟙 _) ≫ J.homotopyMap I (𝟙 _) = 𝟙 _
    rw [← homotopyMap_comp, Category.id_comp, homotopyMap_id]
  · show J.homotopyMap I (𝟙 _) ≫ I.homotopyMap J (𝟙 _) = 𝟙 _
    rw [← homotopyMap_comp, Category.id_comp, homotopyMap_id]

/-- Stacks 013Y: two bounded-below injective resolutions of the same cochain
complex admit a unique compatible comparison in the homotopy category. -/
@[stacks 013Y]
theorem existsUnique_homotopyComparison {K : CochainComplex 𝒜 ℤ}
    (I J : InjectiveResolution K) :
    ∃! a : (HomotopyCategory.quotient 𝒜 (up ℤ)).obj I.complex ⟶
        (HomotopyCategory.quotient 𝒜 (up ℤ)).obj J.complex,
      I.IsHomotopyComparison J a := by
  exact existsUnique_homotopyMap I J (𝟙 _)

end CochainComplex.InjectiveResolution


