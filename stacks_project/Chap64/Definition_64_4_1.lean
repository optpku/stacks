module

public import ReasLib.LinearAlgebra.Trace.CommutatorQuotient
import StacksCheckRecall

universe u v

variable (R : Type u) [Ring R] (n : Type v) [Fintype n] [DecidableEq n]

/- Definition 64.4.1: after fixing a ring Λ of left modules, typically finite of
cardinality prime to p, Λ♮ is the quotient of Λ by the additive subgroup
generated by commutators ab - ba. The trace of an endomorphism a of Λ^⊕m is
the sum of the diagonal entries of a matrix representing it; since the modules
are left modules, matrices act on the right by a(v) = v ᵥ* A. This defines an
additive map Tr : End_Λ(Λ^⊕m) → Λ♮, formalized as LinearMap.traceNatural on
the standard free left module n → Λ, with Matrix.traceNatural the underlying
diagonal-sum map on matrices. -/
@[stacks 03T0] #check
  (LinearMap.traceNatural : Module.End R (n → R) →+ Ring.CommutatorQuotient R)

#check (Matrix.traceNatural n R : Matrix n n R →+ Ring.CommutatorQuotient R)
