module

public import ReasLib.AlgebraicGeometry.Scheme.Sites.AffineOver.Pretopology
public import ReasLib.AlgebraicGeometry.Scheme.Sites.Smooth.Basic
public import Mathlib.AlgebraicGeometry.Sites.Small

/-!
# Affine slices of the smooth site

This module owns the canonical smooth topology on `Over S` and its affine
restriction.  The stronger presentation generated by finite standard smooth
charts lives separately, since it is not definitionally the same topology.
-/

@[expose] public section

open CategoryTheory

noncomputable section

universe u v

namespace AlgebraicGeometry.Scheme

/-- The canonical smooth Grothendieck topology on schemes over `S`. -/
abbrev smoothOverTopology (S : Scheme.{u}) : GrothendieckTopology (Over S) :=
  S.overGrothendieckTopology @Smooth

/-- The smooth slice topology is induced by the smooth morphism property. -/
theorem smoothOverTopology_def (S : Scheme.{u}) :
    smoothOverTopology S = S.overGrothendieckTopology @Smooth := sorry

/-- The canonical smooth precoverage on affine schemes over `S`, obtained by
restricting the smooth slice topology. -/
abbrev bigAffineSmoothPrecoverage (S : Scheme.{u}) : Precoverage S.AffineOver :=
  affineOverPrecoverage S (smoothOverTopology S)

/-- A presieve is smooth-covering on the affine slice exactly when its image
is covering in the smooth slice site. -/
@[simp]
theorem mem_bigAffineSmoothPrecoverage_iff
    (S : Scheme.{u}) {U : S.AffineOver} {R : Presieve U} :
    R ∈ bigAffineSmoothPrecoverage S U ↔
      R.map (AffineOver.forget S) ∈ (smoothOverTopology S).toPrecoverage U.obj := sorry

/-- An indexed affine family is smooth-covering exactly when its underlying
family in `Over S` is covering in the smooth slice. -/
@[simp]
theorem ofArrows_mem_bigAffineSmoothPrecoverage_iff
    (S : Scheme.{u}) {U : S.AffineOver} {ι : Type v}
    (Y : ι → S.AffineOver) (π : ∀ i, Y i ⟶ U) :
    Presieve.ofArrows Y π ∈ bigAffineSmoothPrecoverage S U ↔
      Presieve.ofArrows (fun i ↦ (Y i).obj) (fun i ↦ AffineOver.hom (π i)) ∈
        (smoothOverTopology S).toPrecoverage U.obj := sorry

/-- The canonical smooth Grothendieck topology on affine schemes over `S`. -/
abbrev bigAffineSmoothTopology (S : Scheme.{u}) : GrothendieckTopology S.AffineOver :=
  affineOverTopology S (smoothOverTopology S)

/-- The affine smooth topology is generated by the restricted smooth
precoverage. -/
theorem bigAffineSmoothTopology_def (S : Scheme.{u}) :
    bigAffineSmoothTopology S = (bigAffineSmoothPrecoverage S).toGrothendieck := sorry

/-- The canonical smooth pretopology on affine schemes over `S`, obtained by
promoting the restricted smooth precoverage. -/
abbrev bigAffineSmoothPretopology (S : Scheme.{u}) : Pretopology S.AffineOver :=
  affineOverPretopology S (smoothOverTopology S)

/-- The precoverage underlying the canonical affine smooth pretopology is the
restricted smooth precoverage. -/
theorem bigAffineSmoothPretopology_toPrecoverage (S : Scheme.{u}) :
    (bigAffineSmoothPretopology S).toPrecoverage = bigAffineSmoothPrecoverage S := sorry

end AlgebraicGeometry.Scheme
