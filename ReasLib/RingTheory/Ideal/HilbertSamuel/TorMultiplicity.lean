module

public import ReasLib.Algebra.Category.ModuleCat.Tor.Independence
public import ReasLib.RingTheory.Ideal.HilbertSamuel.Annihilator
public import ReasLib.RingTheory.Ideal.HilbertSamuel.KoszulMultiplicity

@[expose] public section

open CategoryTheory
open scoped BigOperators

noncomputable section

universe u

namespace Ideal.HilbertSamuel

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
variable {M : Type u} [AddCommGroup M] [Module R M] [Module.Finite R M]

/-- If an ideal is generated by a regular sequence of length `r` and the quotient of a
finite module by the ideal has zero-dimensional support, then its degree-`r`
Hilbert--Samuel multiplicity is the alternating sum of the lengths of the corresponding
Tor modules. -/
theorem multiplicityInDegree_eq_torLengthSum_of_regularSequence (r : ℕ)
    (I : Ideal R) (f : Fin r → R) (hgen : Ideal.span (Set.range f) = I)
    (hreg : RingTheory.Sequence.IsRegular R (List.ofFn f))
    (hdim : Module.supportDim R (M ⧸ (I • ⊤ : Submodule R M)) = 0) :
    multiplicityInDegree I M r =
      ((∑ᶠ i : ℕ, (Int.negOnePow i : ℤ) *
        ((Module.length R
          (ModuleCat.Tor.obj i (ModuleCat.of R (R ⧸ I)) (ModuleCat.of R M))).toNat : ℤ) : ℤ) :
        ℚ) := sorry

end Ideal.HilbertSamuel
