module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Algebra.Polynomial.Basic
public import Mathlib.Data.Fin.VecNotation
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Spectrum.Prime.RingHom

/-!
# Affine-plane origin chart local homomorphism

The chart `k[x, y] → k[x, z]` sending `x ↦ x` and `y ↦ x * z`, localized at
`(x, y)` and `(x)`, is an injective local homomorphism of local rings whose
induced map on prime spectra is not surjective.
-/

@[expose] public section

noncomputable section

open MvPolynomial

universe u

namespace PlaneOriginChart

/-- The polynomial chart `k[x, y] →+* k[x, z]` sending `X 0 ↦ X 0` and `X 1 ↦ X 0 * X 1`. -/
def chartHom (k : Type u) [CommRing k] : MvPolynomial (Fin 2) k →+* MvPolynomial (Fin 2) k :=
  (aeval ![X 0, X 0 * X 1]).toRingHom

/-- The polynomial chart sends the first variable to itself. -/
theorem chartHom_X_zero (k : Type u) [CommRing k] : chartHom k (X 0) = X 0 := sorry

/-- The polynomial chart sends the second variable to the product of the two variables. -/
theorem chartHom_X_one (k : Type u) [CommRing k] : chartHom k (X 1) = X 0 * X 1 := sorry

/-- The polynomial chart is injective over every commutative coefficient ring. -/
theorem chartHom_injective (k : Type u) [CommRing k] : Function.Injective (chartHom k) := sorry

/-- Evaluation `k[x, z] →+* k[t]` sending `X 0 ↦ 0` and `X 1 ↦ Polynomial.X`. -/
def evalVanishX (k : Type u) [CommRing k] : MvPolynomial (Fin 2) k →+* Polynomial k :=
  (aeval ![(0 : Polynomial k), Polynomial.X]).toRingHom

/-- The ideal obtained as the kernel of evaluation setting the first variable to zero. -/
abbrev targetPrime (k : Type u) [CommRing k] : Ideal (MvPolynomial (Fin 2) k) :=
  RingHom.ker (evalVanishX k)

/-- Over a field, the kernel of evaluation into the polynomial ring is prime. -/
instance instIsPrime_targetPrime (k : Type u) [Field k] : (targetPrime k).IsPrime :=
  RingHom.ker_isPrime (evalVanishX k)

/-- The kernel of evaluation setting the first variable to zero is generated by that variable. -/
theorem targetPrime_eq_span_X (k : Type u) [CommRing k] :
    targetPrime k = Ideal.span {X 0} := sorry

/-- The contraction of the target ideal along the polynomial chart. -/
abbrev sourcePrime (k : Type u) [CommRing k] : Ideal (MvPolynomial (Fin 2) k) :=
  Ideal.comap (chartHom k) (targetPrime k)

/-- The contracted ideal is the origin ideal generated by both variables. -/
theorem sourcePrime_eq_idealOfVars (k : Type u) [CommRing k] :
    sourcePrime k = idealOfVars (Fin 2) k := sorry

/-- The local ring of the affine plane at the origin, obtained by localizing at the contracted prime. -/
abbrev sourceLocalRing (k : Type u) [Field k] :=
  Localization.AtPrime (sourcePrime k)

/-- The local ring of the chart at the prime generated by the first variable. -/
abbrev targetLocalRing (k : Type u) [Field k] :=
  Localization.AtPrime (targetPrime k)

/-- The induced local homomorphism between the localizations of the polynomial chart. -/
def hom (k : Type u) [Field k] : sourceLocalRing k →+* targetLocalRing k :=
  Localization.localRingHom (sourcePrime k) (targetPrime k) (chartHom k) rfl

/-- The homomorphism induced by the polynomial chart is a local homomorphism of local rings. -/
instance instIsLocalHom_hom (k : Type u) [Field k] : IsLocalHom (hom k) :=
  Localization.isLocalHom_localRingHom (sourcePrime k) (targetPrime k) (chartHom k) rfl

/-- The local homomorphism induced by the polynomial chart is injective over every field. -/
theorem hom_injective (k : Type u) [Field k] :
    Function.Injective (hom k) := sorry

/-- The prime-spectrum map induced by the localized polynomial chart is not surjective. -/
theorem hom_comap_not_surjective (k : Type u) [Field k] :
    ¬ Function.Surjective (PrimeSpectrum.comap (hom k)) := sorry

end PlaneOriginChart
