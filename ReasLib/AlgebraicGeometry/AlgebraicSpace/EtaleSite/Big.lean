module

public import Mathlib.CategoryTheory.Sites.Over
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.EtalePrecoverage

/-! # Big étale topologies on algebraic spaces -/

@[expose] public section

open CategoryTheory AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

/-- The big étale Grothendieck topology on algebraic spaces over `S`. -/
abbrev etaleTopology {S : Scheme.{u}} : GrothendieckTopology (AlgebraicSpace S) :=
  etalePrecoverage.toGrothendieck

/-- `etaleTopology` is generated by the étale precoverage. -/
theorem etaleTopology_def {S : Scheme.{u}} :
    (etaleTopology : GrothendieckTopology (AlgebraicSpace S)) =
      etalePrecoverage.toGrothendieck := rfl

/-- The localized big étale topology on `Over X`, i.e. `(Spaces/X)_étale`. -/
abbrev overEtaleTopology {S : Scheme.{u}} (X : AlgebraicSpace S) :
    GrothendieckTopology (Over X) :=
  etaleTopology.over X

/-- `overEtaleTopology X` is the localization of `etaleTopology` at `X`. -/
theorem overEtaleTopology_def {S : Scheme.{u}} (X : AlgebraicSpace S) :
    overEtaleTopology X = etaleTopology.over X := rfl

end AlgebraicGeometry.AlgebraicSpace
