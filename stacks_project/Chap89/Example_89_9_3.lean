/-!
# A modification of an excellent surface singularity that is not a scheme

The affine cubic-quartic surface `x ^ 3 + y ^ 3 + z ^ 3 + x ^ 4 + y ^ 4 + z ^ 4 = 0`
in `A^3_ℂ` has a unique singular point at the origin. Localizing its coordinate
ring there yields an excellent 2-dimensional Noetherian local ring `A` whose
spectrum admits a modification of algebraic spaces that is not a scheme.
-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory AlgebraicGeometry MvPolynomial

namespace AlgebraicGeometry.CubicQuarticSurface

/-- The cubic-quartic polynomial `X 0 ^ 3 + X 1 ^ 3 + X 2 ^ 3 + X 0 ^ 4 + X 1 ^ 4 + X 2 ^ 4`
in `ℂ[x, y, z]`. -/
def equation : MvPolynomial (Fin 3) ℂ :=
  X 0 ^ 3 + X 1 ^ 3 + X 2 ^ 3 + X 0 ^ 4 + X 1 ^ 4 + X 2 ^ 4

/-- The principal ideal generated by `equation`. -/
def ideal : Ideal (MvPolynomial (Fin 3) ℂ) :=
  Ideal.span {equation}

/-- The generator of `ideal` lies in that ideal. -/
theorem equation_mem_ideal : equation ∈ ideal := sorry

/-- The affine coordinate ring `ℂ[x, y, z] ⧸ (x ^ 3 + y ^ 3 + z ^ 3 + x ^ 4 + y ^ 4 + z ^ 4)`. -/
abbrev CoordinateRing : Type :=
  MvPolynomial (Fin 3) ℂ ⧸ ideal

/-- The class of the coordinate `x` in `CoordinateRing`. -/
def x : CoordinateRing :=
  Ideal.Quotient.mk ideal (X 0)

/-- The class of the coordinate `y` in `CoordinateRing`. -/
def y : CoordinateRing :=
  Ideal.Quotient.mk ideal (X 1)

/-- The class of the coordinate `z` in `CoordinateRing`. -/
def z : CoordinateRing :=
  Ideal.Quotient.mk ideal (X 2)

/-- The cubic-quartic relation vanishes in `CoordinateRing`. -/
theorem mk_equation : Ideal.Quotient.mk ideal equation = 0 := sorry

/-- The coordinate equation `x ^ 3 + y ^ 3 + z ^ 3 + x ^ 4 + y ^ 4 + z ^ 4 = 0`
in `CoordinateRing`. -/
theorem x_pow_add_y_pow_add_z_pow :
    x ^ 3 + y ^ 3 + z ^ 3 + x ^ 4 + y ^ 4 + z ^ 4 = 0 := sorry

/-- The origin ideal `(x, y, z)` of the unique singular point `(0, 0, 0)`. -/
def originIdeal : Ideal CoordinateRing :=
  Ideal.span {x, y, z}

/-- The origin ideal is a maximal ideal. -/
instance instIsMaximal_originIdeal : originIdeal.IsMaximal := sorry

/-- The local ring `A = O_{X,(0,0,0)}` of the cubic-quartic surface at the origin. -/
abbrev localRing : Type :=
  Localization.AtPrime originIdeal

/-- `localRing` is excellent. -/
instance instIsExcellentRing_localRing : IsExcellentRing localRing := sorry

/-- `localRing` is a domain. -/
instance instIsDomain_localRing : IsDomain localRing := sorry

/-- The algebraic space `specSpace localRing` is integral. -/
instance instIsIntegral_specSpace_localRing :
    AlgebraicSpace.IsIntegral (AlgebraicSpace.specSpace localRing) := sorry

/-- `localRing` has Krull dimension `2`. -/
theorem localRing_ringKrullDim : ringKrullDim localRing = 2 := sorry

/-- `localRing` is an excellent 2-dimensional Noetherian local ring. -/
theorem localRing_spec :
    IsExcellentRing localRing ∧ IsNoetherianRing localRing ∧ IsLocalRing localRing ∧
      ringKrullDim localRing = 2 := sorry

end AlgebraicGeometry.CubicQuarticSurface

namespace AlgebraicGeometry.AlgebraicSpace

/-- Example 89.9.3 There exists an excellent 2-dimensional Noetherian local ring `A`
and a modification `X ⟶ specSpace A` of algebraic spaces which is not a scheme.
A witness for `A` is `CubicQuarticSurface.localRing`, the localization of
`ℂ[x, y, z] ⧸ (x ^ 3 + y ^ 3 + z ^ 3 + x ^ 4 + y ^ 4 + z ^ 4)` at the origin. -/
@[stacks 0AEB]
theorem exists_modification_not_scheme :
    ∃ (A : Type u) (_ : CommRing A) (_ : IsNoetherianRing A) (_ : IsLocalRing A)
      (_ : IsExcellentRing A),
      ringKrullDim A = 2 ∧
        ∃ (X : AlgebraicSpace (Spec (.of A))) (f : X ⟶ specSpace A)
          (_ : IsIntegral X) (_ : IsIntegral (specSpace A)),
          IsModification f ∧ ¬ IsScheme X := sorry

/-- The cubic-quartic local ring admits a modification of its spectrum that is not a
scheme. -/
theorem exists_modification_not_scheme_localRing :
    ∃ (X : AlgebraicSpace (Spec (.of CubicQuarticSurface.localRing)))
      (f : X ⟶ specSpace CubicQuarticSurface.localRing)
      (_ : IsIntegral X) (_ : IsIntegral (specSpace CubicQuarticSurface.localRing)),
      IsModification f ∧ ¬ IsScheme X := sorry

end AlgebraicGeometry.AlgebraicSpace
