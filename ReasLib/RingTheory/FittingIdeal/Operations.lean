module

public import Mathlib.Data.Finset.NatAntidiagonal
public import ReasLib.RingTheory.FittingIdeal.BaseChange
public import ReasLib.RingTheory.FittingIdeal.FinitePresentation
public import ReasLib.RingTheory.FittingIdeal.Quotient
public import ReasLib.RingTheory.FittingIdeal.Support
import Mathlib.Tactic.CrossRefAttribute

/-!
# Basic operations on intrinsic Fitting ideals

This leaf records generation, direct-sum, quotient, and functorial properties of Fitting ideals.
The intrinsic ideal remains owned by `FittingIdeal.Basic`.

@stack 07ZA
-/

@[expose] public section

open scoped FittingIdeal

universe u v w

namespace FittingIdeal

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M] [Module.Finite R M]

/-- If a finite module is generated by `n` elements, then its `n`th Fitting ideal is the unit
ideal. -/
@[stacks 07ZA "(1), generator bound gives the unit Fitting ideal"]
theorem eq_top_of_surjective (n : ℕ)
    (h : ∃ π : (Fin n → R) →ₗ[R] M, Function.Surjective π) :
    Fit[R]_(n)(M) = ⊤ := sorry

variable {M' : Type w} [AddCommGroup M'] [Module R M'] [Module.Finite R M']

/-- The zeroth Fitting ideal of a direct sum is the product of the two zeroth Fitting ideals. -/
@[stacks 07ZA "(2), zeroth Fitting ideal of a direct sum"]
theorem directSum_zero :
    Fit[R]_(0)(M × M') = Fit[R]_(0)(M) * Fit[R]_(0)(M') := sorry

/-- The `l`th Fitting ideal of a direct sum is the antidiagonal sum of products of the Fitting
ideals of the two summands. -/
@[stacks 07ZA "(3), Fitting ideal of a direct sum"]
theorem directSum (l : ℕ) :
    Fit[R]_(l)(M × M') =
      Finset.sum (Finset.HasAntidiagonal.antidiagonal (A := ℕ) l) fun p ↦
        Fit[R]_(p.1)(M) * Fit[R]_(p.2)(M') := sorry

/-- A surjection of finite modules makes every source Fitting ideal a subideal of the
corresponding target Fitting ideal. -/
@[stacks 07ZA "(6), Fitting ideals under a module surjection"]
theorem mono_of_surjective (f : M →ₗ[R] M') (hf : Function.Surjective f) (k : ℕ) :
    Fit[R]_(k)(M) ≤ Fit[R]_(k)(M') := sorry

/-- The zeroth Fitting ideal is contained in the annihilator. -/
@[stacks 07ZA "(7), zeroth Fitting ideal lies in the annihilator"]
theorem zero_le_annihilator :
    Fit[R]_(0)(M) ≤ Module.annihilator R M := sorry

/-- Fitting ideals form an increasing family in their natural-number index. -/
@[stacks 07ZD "monotonicity of Fitting ideals"]
theorem monotone {k l : ℕ} (hkl : k ≤ l) :
    Fit[R]_(k)(M) ≤ Fit[R]_(l)(M) := sorry

end FittingIdeal
