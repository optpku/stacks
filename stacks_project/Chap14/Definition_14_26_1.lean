module

public import ReasLib.AlgebraicTopology.SimplicialObject.Copower.DeltaOne.Homotopy
import StacksCheckRecall

@[expose] public section

/-!
@stack 019K

# Source-facing bridge for Definition 14.26.1

Definition 14.26.1 defines a homotopy by a map out of the simplicial cylinder and then takes the
zigzag closure of that directed relation. The source-facing cylinder data and its equivalence with
mathlib's canonical combinatorial homotopy are owned by
`SimplicialObject.copower.deltaOne.Homotopy`.
-/

open CategoryTheory CategoryTheory.Limits
open scoped Simplicial

universe v u

variable {C : Type u} [Category.{v} C] [HasFiniteCoproducts C]
variable {U V : SimplicialObject C}
variable (a b : U ⟶ V)

variable (H : SimplicialObject.copower.deltaOne.Homotopy a b)

/- Definition 14.26.1 (1): a directed homotopy is a morphism from the `Δ[1]`-copower
cylinder. -/
@[stacks 019K "Definition 14.26.1 (1): cylinder morphism"]
#check (H.hom : SimplicialObject.copower (Δ[1] : SSet.{0}) U ⟶ V)

/- Definition 14.26.1 (1): restriction to the zero endpoint is `a`. -/
@[stacks 019K "Definition 14.26.1 (1): zero endpoint"]
#check (H.zero :
  SimplicialObject.copower.deltaOne.endpointZero U ≫ H.hom = a)

/- Definition 14.26.1 (1): restriction to the one endpoint is `b`. -/
@[stacks 019K "Definition 14.26.1 (1): one endpoint"]
#check (H.one :
  SimplicialObject.copower.deltaOne.endpointOne U ≫ H.hom = b)

/- The cylinder presentation is equivalent to mathlib's reusable combinatorial owner. -/
@[stacks 019K "Definition 14.26.1 (1): canonical bridge"]
#check (SimplicialObject.copower.deltaOne.Homotopy.equiv (a := a) (b := b) :
  SimplicialObject.copower.deltaOne.Homotopy a b ≃
    SimplicialObject.Homotopy a b)

/- Definition 14.26.1 (2): the finite zigzag relation generated by cylinder homotopies agrees
with the canonical reusable homotopy relation. -/
@[stacks 019K "Definition 14.26.1 (2)"]
#check (SimplicialObject.copower.deltaOne.Homotopy.homotopic_iff
    (a := a) (b := b) :
  Relation.EqvGen
      (fun f g : U ⟶ V ↦
        Nonempty (SimplicialObject.copower.deltaOne.Homotopy f g)) a b ↔
    SimplicialObject.Homotopic a b)
