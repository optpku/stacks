module

public import ReasLib.CategoryTheory.Pretriangulated.Extension.Functor
public import ReasLib.CategoryTheory.Pretriangulated.Generation.Stage

/-!
# Functoriality of Positive Generated Stages

This file transports positive object-generated stages along exact triangulated functors. The
comparison is deliberately one-sided: an exact functor sends objects built in a fixed stage into
the corresponding target stage, without asserting essential surjectivity onto that stage.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.Pretriangulated

universe v₁ v₂ u₁ u₂

namespace CategoryTheory.ObjectProperty

section

variable {C : Type u₁} [Category.{v₁} C] [HasZeroObject C] [Preadditive C] [HasShift C ℤ]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
variable {D : Type u₂} [Category.{v₂} D] [HasZeroObject D] [Preadditive D] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
variable (F : C ⥤ D) [F.CommShift ℤ] [Functor.IsTriangulated F]

namespace Generated.Stage

/-- An exact triangulated functor sends the positive stage generated by `E` into the same
positive stage generated by `F.obj E`. -/
@[stacks 0FX9 "exact-functor transport of positive generated stages"]
theorem map_le (E : C) (n : ℕ+) :
    (Generated.stage E n).map F ≤ Generated.stage (F.obj E) n := sorry

/-- An exact triangulated functor sends an object in a positive generated stage to an object in
the corresponding stage generated by the image of the generator. -/
@[stacks 0FX9 "objectwise exact-functor transport of positive generated stages"]
theorem map_obj_mem {E X : C} {n : ℕ+} (hX : Generated.stage E n X) :
    Generated.stage (F.obj E) n (F.obj X) := sorry

end Generated.Stage

end

end CategoryTheory.ObjectProperty
