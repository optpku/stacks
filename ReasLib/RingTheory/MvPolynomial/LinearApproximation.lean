module

public import Mathlib.Algebra.BigOperators.Group.Finset.Basic
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.RingTheory.Ideal.Operations

/-!
# First-order expansion of polynomial evaluation
-/

@[expose] public section

noncomputable section

universe u

namespace Algebra.NaiveCotangent.Adic

variable {A C ι : Type u} [CommRing A] [CommRing C] [Algebra A C]

/-- First-order Taylor expansion of ordinary multivariate polynomial evaluation,
with remainder in the square of the ideal generated by the increment. -/
theorem aeval_add_mem_sq [Fintype ι] (v δ : ι → C) (p : MvPolynomial ι A) :
    MvPolynomial.aeval (fun i ↦ v i + δ i) p - MvPolynomial.aeval v p -
        ∑ i, MvPolynomial.aeval v (MvPolynomial.pderiv i p) * δ i ∈
      (Ideal.span (Set.range δ)) ^ 2 :=
  sorry

end Algebra.NaiveCotangent.Adic
