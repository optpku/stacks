module

public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.CompleteIntersection.Basic
public import stacks_project.Chap88.Definition_88_18_1_Ring
public import stacks_project.Chap88.Lemma_88_14_10_Instances
public import stacks_project.Chap88.Lemma_88_15_1_FlatAway
public import stacks_project.Chap88.Lemma_88_15_8_RigFlat
public import stacks_project.Chap88.Remark_88_11_2_Presentation

/-!
# Rig-smooth arrows of Noetherian adic rings are rig-flat
-/

@[expose] public section

universe u

open Algebra.NaiveCotangent.Restricted
open RingHom

namespace RingHom.RigSmooth

variable {A B : Type u}
variable [CommRing A] [TopologicalSpace A] [TopologicalRing.IsAdicRing A] [IsNoetherianRing A]
variable [CommRing B] [TopologicalSpace B] [TopologicalRing.IsAdicRing B] [IsNoetherianRing B]

/-- Lemma 88.17.6 (1): A rig-smooth arrow of `WAdm^Noeth` is rig-flat. -/
@[stacks 0GH1]
instance toRigFlat {φ : A →+* B} [RigSmooth φ] : RingHom.RigFlat φ :=
  sorry

/-- Lemma 88.17.6 (2): For a rig-smooth arrow `φ : A →+* B` of `WAdm^Noeth`
and any presentation `B = RestrictedPowerSeries (Fin n) A ⧸ J` given by a
surjective homomorphism `f` commuting with `φ`, if `q` is a prime containing
`J` and containing no ideal of definition, then the extension of `J` to
`Localization.AtPrime q` is generated by a regular sequence. -/
@[stacks 0GH1]
theorem ker_localizationAtPrime_isGeneratedByRegularSequence
    {φ : A →+* B} [RigSmooth φ] {n : ℕ}
    (f : RestrictedPowerSeries (Fin n) A →+* B) (hf : Function.Surjective f)
    (hcomm : f.comp (algebraMap A (RestrictedPowerSeries (Fin n) A)) = φ)
    (q : Ideal (RestrictedPowerSeries (Fin n) A)) [q.IsPrime]
    (hJq : RingHom.ker f ≤ q) (hq : q.ContainsNoIdealOfDefinition) :
    ((RingHom.ker f).map
        (algebraMap (RestrictedPowerSeries (Fin n) A)
          (Localization.AtPrime q))).IsGeneratedByRegularSequence :=
  sorry

/-- In the presence of an `A`-algebra structure on `B` whose structure map is
rig-smooth, the kernel of a finite restricted-power-series presentation remains
generated by a regular sequence after localizing at any prime that contains the
kernel and contains no ideal of definition. -/
theorem presentation_ker_localizationAtPrime_isGeneratedByRegularSequence
    [Algebra A B] [RigSmooth (algebraMap A B)] {ι : Type u} [Fintype ι]
    (P : Presentation A B ι) (q : Ideal (RestrictedPowerSeries ι A)) [q.IsPrime]
    (hJq : P.ker ≤ q) (hq : q.ContainsNoIdealOfDefinition) :
    (P.ker.map
        (algebraMap (RestrictedPowerSeries ι A)
          (Localization.AtPrime q))).IsGeneratedByRegularSequence :=
  sorry

/-- Unpacking of `ker_localizationAtPrime_isGeneratedByRegularSequence`: the
extended kernel is spanned by some regular list in the prime localization. -/
theorem ker_localizationAtPrime_isGeneratedByRegularSequence_spec
    {φ : A →+* B} [RigSmooth φ] {n : ℕ}
    (f : RestrictedPowerSeries (Fin n) A →+* B) (hf : Function.Surjective f)
    (hcomm : f.comp (algebraMap A (RestrictedPowerSeries (Fin n) A)) = φ)
    (q : Ideal (RestrictedPowerSeries (Fin n) A)) [q.IsPrime]
    (hJq : RingHom.ker f ≤ q) (hq : q.ContainsNoIdealOfDefinition) :
    ∃ fs : List (Localization.AtPrime q),
      RingTheory.Sequence.IsRegular (Localization.AtPrime q) fs ∧
        Ideal.ofList fs =
          (RingHom.ker f).map
            (algebraMap (RestrictedPowerSeries (Fin n) A)
              (Localization.AtPrime q)) :=
  sorry

end RingHom.RigSmooth
