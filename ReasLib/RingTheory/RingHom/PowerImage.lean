/-!
# Power-image generation

This leaf isolates the reusable part of generation hypotheses of the form
"the powers with exponents in `E` come from the source".  Chapter-specific
arguments should use this owner instead of introducing a new predicate for
each finite list of exponents.

@stack 07FI
@stack 0EUH
-/

@[expose] public section

universe u v

namespace RingHom

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S]

/-- A target ring is generated by the image of a ring homomorphism together with a chosen set of
elements. This ring-theoretic formulation does not require an ambient `Algebra` instance. -/
def IsGeneratedBy (f : R →+* S) (s : Set S) : Prop :=
  Subring.closure ((f.range : Set S) ∪ s) = ⊤

/-- The subalgebra generated by `s` for the canonical algebra structure induced by `f`.

This owner keeps the algebra-instance choice internal, so generation APIs can be stated for an
arbitrary ring homomorphism without exposing a `letI` in their conclusions. -/
def adjoin (f : R →+* S) (s : Set S) :
    @Subalgebra R S _ _ f.toAlgebra :=
  @Algebra.adjoin R S _ _ f.toAlgebra s

/-- The instance-free generation predicate agrees with the canonical algebra-adjoin formulation. -/
theorem isGenerated_iff_adjoin_top (f : R →+* S) (s : Set S) :
    f.IsGeneratedBy s ↔ f.adjoin s = ⊤ := sorry

/-- The chosen generators lie in the canonical adjoin. -/
theorem subset_adjoin (f : R →+* S) (s : Set S) :
    s ⊆ f.adjoin s := sorry

/-- The ring-hom image lies in every canonical adjoin. -/
theorem range_subset_adjoin (f : R →+* S) (s : Set S) :
    (f.range : Set S) ⊆ f.adjoin s := sorry

namespace PowerImage

/-- A fixed positive power of a target element lies in the range of a ring
homomorphism. -/
@[stacks 07FI "positive power in a ring-map range"]
def InRange (f : R →+* S) (x : S) (e : ℕ+) : Prop :=
  x ^ (e : ℕ) ∈ f.range

/-- Every positive power of an element already in the range remains in the
range. -/
theorem inRange_map (f : R →+* S) (r : R) (e : ℕ+) :
    InRange f (f r) e := sorry

/-- Positive-power range membership is preserved by postcomposition. -/
theorem InRange.comp
    {T : Type*} [CommRing T] {f : R →+* S} {g : S →+* T}
    {x : S} {e : ℕ+} (hx : InRange f x e) :
    InRange (g.comp f) (g x) e := sorry

/-- Elements whose powers with exponents in `E` lie in the image of `f`. -/
def generators (f : R →+* S) (E : Set ℕ) : Set S :=
  {x : S | ∀ n ∈ E, x ^ n ∈ f.range}

/-- Membership in the power-image generator set, in its pointwise form. -/
theorem mem_generators_iff (f : R →+* S) (E : Set ℕ) {x : S} :
    x ∈ generators f E ↔ ∀ n ∈ E, x ^ n ∈ f.range := sorry

/-- The target is generated by the `E`-power-image generators. -/
abbrev IsGenerated (f : R →+* S) (E : Set ℕ) : Prop :=
  IsGeneratedBy f (generators f E)

namespace Pair

/-- Elements whose two selected powers lie in the image of `f`. -/
abbrev generators (f : R →+* S) (m n : ℕ) : Set S :=
  PowerImage.generators f ({m, n} : Set ℕ)

/-- Membership in the two-power image generator set. -/
theorem mem_generators_iff (f : R →+* S) (m n : ℕ) {x : S} :
    x ∈ generators f m n ↔ x ^ m ∈ f.range ∧ x ^ n ∈ f.range := sorry

/-- The target is generated by elements satisfying a two-power image condition. -/
abbrev IsGenerated (f : R →+* S) (m n : ℕ) : Prop :=
  PowerImage.IsGenerated f ({m, n} : Set ℕ)

/-- The two-power generator set does not depend on the order of its exponents. -/
theorem generators_comm (f : R →+* S) (m n : ℕ) :
    generators f m n = generators f n m := sorry

/-- The two-power generation predicate is symmetric in its exponents. -/
theorem isGenerated_comm (f : R →+* S) (m n : ℕ) :
    IsGenerated f m n ↔ IsGenerated f n m := sorry

end Pair

namespace SquareCube

/-- The square/cube generation condition as a source-readable specialization. -/
@[stacks 0EUH]
abbrev IsGenerated (f : R →+* S) : Prop :=
  Pair.IsGenerated f 2 3

/-- The square/cube generator set, exposed separately for source-facing statements. -/
abbrev generators (f : R →+* S) : Set S :=
  Pair.generators f 2 3

/-- Pointwise form of the square/cube generator condition. -/
theorem mem_generators_iff (f : R →+* S) {x : S} :
    x ∈ generators f ↔ x ^ 2 ∈ f.range ∧ x ^ 3 ∈ f.range := sorry

end SquareCube

namespace Field

/-- Two coprime positive powers in the source image force a field element into that image. -/
theorem mem_range_of_coprime_powers
    {K : Type*} {L : Type*} [Field K] [Field L] [Algebra K L] {a : L}
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n) (hcop : Nat.Coprime m n)
    (hmrange : a ^ m ∈ Set.range (algebraMap K L))
    (hnrange : a ^ n ∈ Set.range (algebraMap K L)) :
    a ∈ Set.range (algebraMap K L) := sorry

/-- Two coprime positive powers in a field-homomorphism image force the element into its
canonical field range. -/
theorem mem_fieldRange_of_coprime_powers
    {K : Type*} {L : Type*} [Field K] [Field L] (φ : K →+* L) {a : L}
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n) (hcop : Nat.Coprime m n)
    (hmrange : a ^ m ∈ φ.range) (hnrange : a ^ n ∈ φ.range) :
    a ∈ φ.fieldRange := sorry

/-- Two coprime positive powers determine a field element. -/
theorem eq_of_coprime_powers
    {K : Type*} [Field K] {a b : K} {m n : ℕ}
    (hm : 0 < m) (hn : 0 < n) (hcop : Nat.Coprime m n)
    (hmEq : a ^ m = b ^ m) (hnEq : a ^ n = b ^ n) :
    a = b := sorry

end Field

end PowerImage

end RingHom
