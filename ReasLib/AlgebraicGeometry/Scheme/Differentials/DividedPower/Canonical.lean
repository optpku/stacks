module

public import ReasLib.AlgebraicGeometry.Scheme.Differentials.DividedPower
public import Mathlib.Algebra.Category.ModuleCat.Presheaf.Submodule
public import Mathlib.Algebra.Category.ModuleCat.Presheaf.Sheafification

/-!
# Canonical divided-power relative differentials

The differential relations on affine sections generate a subpresheaf of ordinary relative
differentials. Sheafifying its inclusion and taking the cokernel gives the canonical
divided-power differential module.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite TopologicalSpace
open scoped AlgebraicGeometry RelativeDerivation

universe u

noncomputable section

namespace DividedPowerScheme.RelativeDifferentials

variable (T : DividedPowerScheme.{u}) (S : Scheme.{u}) (f : T.scheme ⟶ S)

/-- The subpresheaf generated by restrictions of the positive divided-power differential
relations on affine opens. -/
def relationPresheaf : PresheafOfModules.Submodule (Ω[f.toShHom]).val where
  obj U := Submodule.span (T.scheme.ringCatSheaf.obj.obj U)
    {ω | ∃ (W : T.scheme.affineOpens) (h : U.unop ≤ W.1) (n : ℕ+)
      (x : Γ(T.scheme, W.1)), x ∈ T.ideal.ideal W ∧
        ω = (Ω[f.toShHom]).val.map (homOfLE h).op
          (((d[f.toShHom]).app (op W.1)).d ((T.dividedPowers W).dpow n x) -
            (T.dividedPowers W).dpow ((n : ℕ) - 1) x •
              ((d[f.toShHom]).app (op W.1)).d x)}
  map := by sorry

/-- The module sheaf obtained by sheafifying the divided-power relation subpresheaf. -/
def relationModule : T.scheme.Modules :=
  (PresheafOfModules.sheafification (𝟙 T.scheme.ringCatSheaf.obj)).obj
    (relationPresheaf T S f).toPresheafOfModules

/-- The canonical morphism from the sheaf of divided-power relations to ordinary
relative differentials. -/
def relationInclusion : relationModule T S f ⟶ Ω[f.toShHom] :=
  (PresheafOfModules.sheafification (𝟙 T.scheme.ringCatSheaf.obj)).map
      (relationPresheaf T S f).ι ≫
    (PresheafOfModules.sheafificationAdjunction (𝟙 T.scheme.ringCatSheaf.obj)).counit.app
      Ω[f.toShHom]

/-- The quotient of ordinary relative differentials by the sheaf of divided-power relations. -/
def canonicalModule : T.scheme.Modules := cokernel (relationInclusion T S f)

/-- The quotient morphism from ordinary differentials to canonical divided-power differentials. -/
def canonicalQuotient : Ω[f.toShHom] ⟶ canonicalModule T S f :=
  cokernel.π (relationInclusion T S f)

/-- The derivation induced by the canonical quotient satisfies the divided-power relations. -/
theorem canonical_quotient_isDividedPower : IsDividedPower T S f
    ((d[f.toShHom]).postcomp (canonicalQuotient T S f).val) := sorry

/-- Every divided-power relative derivation factors uniquely through the canonical quotient. -/
theorem canonical_universal (M : T.scheme.Modules) (D : Derivation T S f M) :
    ∃! q : canonicalModule T S f ⟶ M,
      (d[f.toShHom]).postcomp ((canonicalQuotient T S f) ≫ q).val =
        D.toDerivation := sorry

/-- The canonical divided-power relative differential module, constructed from its relation
quotient and universal derivation. -/
def canonical : DividedPowerScheme.RelativeDifferentials T S f where
  module := canonicalModule T S f
  quotient := canonicalQuotient T S f
  quotient_isDividedPower := canonical_quotient_isDividedPower T S f
  universal := canonical_universal T S f

/-- The universal divided-power relative derivation into the canonical relation quotient. -/
def canonicalDerivation : Derivation T S f (canonical T S f).module where
  toDerivation := (d[f.toShHom]).postcomp (canonicalQuotient T S f).val
  isDividedPower := canonical_quotient_isDividedPower T S f

end DividedPowerScheme.RelativeDifferentials
