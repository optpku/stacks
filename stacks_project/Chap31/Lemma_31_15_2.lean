module

import StacksCheckRecall
public import ReasLib.AlgebraicGeometry.Scheme.Divisor.StalkCriterion

universe u

/- Lemma 31.15.2 (1): if the defining stalk ideal of a closed subscheme of a locally
Noetherian scheme is principal at every point of the subscheme, then the closed subscheme is
locally principal. -/
@[stacks 0AG8]
#check
  (AlgebraicGeometry.Scheme.IdealSheafData.isLocallyPrincipal_of_stalks_principal :
    ∀ {X : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsLocallyNoetherian X]
        (D : X.IdealSheafData),
      (∀ x : X, x ∈ D.support →
        (AlgebraicGeometry.RingedSpace.idealSheafStalkIdeal D.toSubobject x).IsPrincipal) →
      AlgebraicGeometry.IsLocallyPrincipalClosedSubscheme D.subschemeι)

/- Lemma 31.15.2 (2): if the defining stalk ideal of a closed subscheme of a locally
Noetherian scheme is generated by a nonzerodivisor at every point of the subscheme, then the
closed subscheme is an effective Cartier divisor. -/
@[stacks 0AG8]
#check
  (AlgebraicGeometry.Scheme.IdealSheafData.isEffectiveCartierDivisor_of_stalks_generatedByNonZeroDivisor :
    ∀ {X : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsLocallyNoetherian X]
        (D : X.IdealSheafData),
      (∀ x : X, x ∈ D.support →
        ∃ f : X.presheaf.stalk x,
          f ∈ nonZeroDivisors (X.presheaf.stalk x) ∧
            AlgebraicGeometry.RingedSpace.idealSheafStalkIdeal D.toSubobject x =
              Ideal.span ({f} : Set (X.presheaf.stalk x))) →
      AlgebraicGeometry.IsEffectiveCartierDivisor D.subschemeι)
