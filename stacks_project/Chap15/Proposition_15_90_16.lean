module

public import ReasLib.Algebra.Module.LocalizedModule.Away.Gluing.Formal.Equivalence
import StacksCheckRecall

/-!
@stack 05ER

# Proposition 15.90.16

Canonical formal gluing and degree-zero sections are quasi-inverse when the
ring map is flat and is an isomorphism modulo the ideal generated by the
finite principal-open family.
-/

@[expose] public section

open CategoryTheory

universe u

noncomputable section

namespace LocalizedModule.Away.FormalGluing

variable {R S : Type u} [CommRing R] [CommRing S]
variable (φ : R →+* S) {t : ℕ} (f : Fin t → R)
variable (hflat : φ.Flat)
variable (hquot :
  let I : Ideal R := Ideal.span (Set.range f)
  Function.Bijective
    (Ideal.quotientMap (Ideal.map φ I) φ Ideal.le_comap_map))

/- Proposition 15.90.16 (05ER): `Can` and `H⁰` are the forward and inverse
functors of the displayed equivalence.  The two following natural
isomorphisms record both quasi-inverse composites. -/
@[stacks 05ER "Proposition 15.90.16"]
#check (equivalence_of_flat_of_quotientMap_bijective
    φ f hflat hquot :
  ModuleCat.{u} R ≌ FormalGluing.{u, 0, 0} φ f)

#check (h0LeftQuasiInverseIso_of_flat_of_quotientMap_bijective
    φ f hflat hquot :
  ofModuleFunctor φ f ⋙ h0Functor (φ := φ) (f := f) ≅
    𝟭 (ModuleCat.{u} R))

#check (h0RightQuasiInverseIso_of_flat_of_quotientMap_bijective
    φ f hflat hquot :
  h0Functor (φ := φ) (f := f) ⋙ ofModuleFunctor φ f ≅
    𝟭 (FormalGluing.{u, 0, 0} φ f))

#check (ofModuleFunctor_isEquivalence_of_flat_of_quotientMap_bijective
    φ f hflat hquot :
  Functor.IsEquivalence (ofModuleFunctor φ f))

#check (h0Functor_isEquivalence_of_flat_of_quotientMap_bijective
    φ f hflat hquot :
  Functor.IsEquivalence (h0Functor (φ := φ) (f := f)))

end LocalizedModule.Away.FormalGluing
