module

public import Mathlib.FieldTheory.Separable
public import ReasLib.AlgebraicGeometry.FormalDeformation.CompleteLocal.Cotangent
public import ReasLib.AlgebraicGeometry.FormalDeformation.CompleteLocal.Derivation
public import ReasLib.RingTheory.LocalRing.Length.ResidueImage

/-!
# Relative cotangent spaces and residue-valued derivations

The relative cotangent space of a residue-identified complete local algebra is
the quotient `m_S / (ker(Λ → k) S + m_S²)`. Residue-valued base-linear derivations
pair with this quotient, and the pairing identifies derivations with its linear
dual when the residue extension is separable.
-/

@[expose] public section

open IsLocalRing

universe u

variable {Λ k : Type u} [CommRing Λ] [IsNoetherianRing Λ] [Field k] [Algebra Λ k]
  [Module.Finite Λ k]

noncomputable section

namespace CompleteLocalAlgCat

/-- The cotangent space is a vector space over the identified residue field. -/
instance instModule_cotangentSpace (S : CompleteLocalAlgCat Λ k) :
    Module k (CotangentSpace S.carrier) :=
  Module.compHom (CotangentSpace S.carrier) S.residueFieldIso.symm.toRingHom

/-- The residue-field span of the image of the extended kernel of the base residue map
in the cotangent space. -/
def relativeCotangentSpan (S : CompleteLocalAlgCat Λ k) :
    Submodule k (CotangentSpace S.carrier) :=
  Submodule.span k
    (S.maximalIdeal.toCotangent ''
      { x : S.maximalIdeal |
        (x : S.carrier) ∈ (RingHom.ker (algebraMap Λ k)).map (algebraMap Λ S.carrier) })

/-- The relative cotangent span is generated by the image of the extended kernel
of the base residue map. -/
theorem relativeCotangentSpan_spec (S : CompleteLocalAlgCat Λ k) :
    relativeCotangentSpan S =
      Submodule.span k
        (S.maximalIdeal.toCotangent ''
          { x : S.maximalIdeal |
            (x : S.carrier) ∈ (RingHom.ker (algebraMap Λ k)).map (algebraMap Λ S.carrier) }) :=
  rfl

/-- Membership in the relative cotangent span is membership in the span of the
image of the extended kernel of the base residue map. -/
theorem mem_relativeCotangentSpan {S : CompleteLocalAlgCat Λ k}
    {x : CotangentSpace S.carrier} :
    x ∈ relativeCotangentSpan S ↔
      x ∈ Submodule.span k
        (S.maximalIdeal.toCotangent ''
          { y : S.maximalIdeal |
            (y : S.carrier) ∈ (RingHom.ker (algebraMap Λ k)).map (algebraMap Λ S.carrier) }) :=
  Iff.rfl

/-- The relative cotangent quotient `m_S / (ker(Λ → k) S + m_S²)` over the
identified residue field. -/
abbrev relativeCotangentSpace (S : CompleteLocalAlgCat Λ k) : Type u :=
  CotangentSpace S.carrier ⧸ relativeCotangentSpan S

namespace RelativeCotangentSpace

/-- The relative cotangent class of an element of the maximal ideal. -/
def mk (S : CompleteLocalAlgCat Λ k) (x : S.maximalIdeal) :
    relativeCotangentSpace S :=
  Submodule.Quotient.mk (S.maximalIdeal.toCotangent x)

/-- A maximal-ideal element has zero relative cotangent class exactly when it
belongs to the sum of the extended base kernel and the maximal-ideal square. -/
theorem mk_eq_zero_iff (S : CompleteLocalAlgCat Λ k) (x : S.maximalIdeal) :
    mk S x = 0 ↔ (x : S.carrier) ∈ relativeDenom S := sorry

end RelativeCotangentSpace

/-- Restriction of a base-linear residue-valued derivation to the maximal ideal. -/
def derivationOnMaximalIdeal (S : CompleteLocalAlgCat Λ k)
    (D : Derivation Λ S.carrier k) :
    S.maximalIdeal →ₗ[Λ] k :=
  D.toLinearMap.comp (S.maximalIdeal.subtype.restrictScalars Λ)

/-- Restriction to the maximal ideal evaluates as the underlying derivation. -/
theorem derivationOnMaximalIdeal_apply (S : CompleteLocalAlgCat Λ k)
    (D : Derivation Λ S.carrier k) (x : S.maximalIdeal) :
    derivationOnMaximalIdeal S D x = D (x : S.carrier) :=
  rfl

/-- A residue-valued derivation vanishes on products of maximal-ideal elements. -/
theorem derivationOnMaximalIdeal_mul (S : CompleteLocalAlgCat Λ k)
    (D : Derivation Λ S.carrier k) (x y : S.maximalIdeal) :
    derivationOnMaximalIdeal S D (x * y) = 0 := sorry

/-- The base-linear cotangent form induced by a residue-valued derivation. -/
def derivationOnCotangent (S : CompleteLocalAlgCat Λ k)
    (D : Derivation Λ S.carrier k) :
    CotangentSpace S.carrier →ₗ[Λ] k :=
  Ideal.Cotangent.lift (derivationOnMaximalIdeal S D)
    (derivationOnMaximalIdeal_mul S D)

/-- The induced cotangent form respects scalars from the identified residue field. -/
theorem derivationOnCotangent_smul (S : CompleteLocalAlgCat Λ k)
    (D : Derivation Λ S.carrier k) (scalar : k) (x : CotangentSpace S.carrier) :
    derivationOnCotangent S D (scalar • x) = scalar • derivationOnCotangent S D x := sorry

/-- The residue-field-linear cotangent form induced by a base-linear derivation. -/
def derivationToCotangentDual (S : CompleteLocalAlgCat Λ k)
    (D : Derivation Λ S.carrier k) :
    CotangentSpace S.carrier →ₗ[k] k where
  toFun := derivationOnCotangent S D
  map_add' := (derivationOnCotangent S D).map_add
  map_smul' := derivationOnCotangent_smul S D

/-- The induced cotangent form evaluates as the derivation on maximal-ideal representatives. -/
theorem derivationToCotangentDual_apply (S : CompleteLocalAlgCat Λ k)
    (D : Derivation Λ S.carrier k) (x : S.maximalIdeal) :
    derivationToCotangentDual S D (S.maximalIdeal.toCotangent x) =
      D (x : S.carrier) := sorry

/-- The span of the extended base kernel is annihilated by every base-linear
residue-valued derivation's cotangent form. -/
theorem relativeCotangentSpan_le_ker_derivationToCotangentDual
    (S : CompleteLocalAlgCat Λ k) (D : Derivation Λ S.carrier k) :
    relativeCotangentSpan S ≤ LinearMap.ker (derivationToCotangentDual S D) := sorry

/-- The relative cotangent linear form induced by a base-linear residue-valued derivation. -/
def relativeCotangentLinearForm (S : CompleteLocalAlgCat Λ k)
    (D : Derivation Λ S.carrier k) :
    relativeCotangentSpace S →ₗ[k] k :=
  (relativeCotangentSpan S).liftQ (derivationToCotangentDual S D)
    (relativeCotangentSpan_le_ker_derivationToCotangentDual S D)

/-- The induced relative cotangent form is additive in the derivation. -/
theorem relativeCotangentLinearForm_add (S : CompleteLocalAlgCat Λ k)
    (D E : Derivation Λ S.carrier k) :
    relativeCotangentLinearForm S (D + E) =
      relativeCotangentLinearForm S D + relativeCotangentLinearForm S E := sorry

/-- The induced relative cotangent form respects residue-field scalars in the derivation. -/
theorem relativeCotangentLinearForm_smul (S : CompleteLocalAlgCat Λ k)
    (scalar : k) (D : Derivation Λ S.carrier k) :
    relativeCotangentLinearForm S (scalar • D) =
      scalar • relativeCotangentLinearForm S D := sorry

/-- The canonical linear pairing of base-linear residue-valued derivations with
the relative cotangent quotient. -/
def derivationToRelativeCotangentDual (S : CompleteLocalAlgCat Λ k) :
    Derivation Λ S.carrier k →ₗ[k] (relativeCotangentSpace S →ₗ[k] k) where
  toFun := relativeCotangentLinearForm S
  map_add' := relativeCotangentLinearForm_add S
  map_smul' := relativeCotangentLinearForm_smul S

/-- The relative cotangent pairing evaluates as the derivation on maximal-ideal representatives. -/
theorem derivationToRelativeCotangentDual_apply (S : CompleteLocalAlgCat Λ k)
    (D : Derivation Λ S.carrier k) (x : S.maximalIdeal) :
    derivationToRelativeCotangentDual S D (RelativeCotangentSpace.mk S x) =
      D (x : S.carrier) := sorry

/-- For a separable residue extension, base-linear residue-valued derivations
identify bijectively with the linear dual of the relative cotangent quotient. -/
theorem bijective_derivationToRelativeCotangentDual (S : CompleteLocalAlgCat Λ k)
    [Algebra.IsSeparable (Algebra.residueImage Λ k) k] :
    Function.Bijective (derivationToRelativeCotangentDual S) := sorry

/-- In the classical case, the identified residue field is separable over the
image field of the base residue map. -/
instance instIsSeparable_residueImage_of_isClassical
    [ArtinianLocalAlgCat.IsClassical Λ k] :
    Algebra.IsSeparable (Algebra.residueImage Λ k) k := sorry

end CompleteLocalAlgCat

end
