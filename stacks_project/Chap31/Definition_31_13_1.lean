module

import StacksCheckRecall

public import ReasLib.AlgebraicGeometry.Scheme.Divisor.EffectiveCartier

@[expose] public section

open CategoryTheory AlgebraicGeometry

noncomputable section

universe u

/- Definition 31.13.1 (1): A locally principal closed subscheme has an ideal sheaf that is
locally generated by one section. -/
@[stacks 01WR] #check
  (AlgebraicGeometry.IsLocallyPrincipalClosedSubscheme :
    {S D : Scheme.{u}} → (D ⟶ S) → Prop)

#check
  (AlgebraicGeometry.isLocallyPrincipalClosedSubscheme_iff :
    ∀ {S D : Scheme.{u}} (i : D ⟶ S),
      AlgebraicGeometry.IsLocallyPrincipalClosedSubscheme i ↔
        AlgebraicGeometry.IsClosedImmersion i ∧
          ∀ x : S, ∃ U : S.Opens, x ∈ U ∧
            ∃ s :
              (((RingedSpace.Hom.idealSheaf i.toShHom).over U :
                SheafOfModules (S.toRingedSpace.ringCatSheaf.over U)).sections),
              Epi
                ((((RingedSpace.Hom.idealSheaf i.toShHom).over U :
                  SheafOfModules (S.toRingedSpace.ringCatSheaf.over U)).freeHomEquiv).symm
                  (fun _ : PUnit ↦ s)))

/- Definition 31.13.1 (2): An effective Cartier divisor is a closed subscheme whose ideal
sheaf is invertible as a module over the structure sheaf. -/
@[stacks 01WR] #check
  (AlgebraicGeometry.IsEffectiveCartierDivisor :
    {S D : Scheme.{u}} → (D ⟶ S) → Prop)

#check
  (AlgebraicGeometry.isEffectiveCartierDivisor_iff :
    ∀ {S D : Scheme.{u}} (i : D ⟶ S),
      AlgebraicGeometry.IsEffectiveCartierDivisor i ↔
        AlgebraicGeometry.IsClosedImmersion i ∧
          Scheme.Modules.Invertible
            (RingedSpace.Hom.idealSheaf i.toShHom))
