module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.RelativeProj.FiniteType
public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.QuasiCompact.Finiteness
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.QuasiCompact.Locality

/-!
# Quasi-compactness of relative projective spectra of algebraic spaces

Affine-étale section models express finite type over degree zero, generation by a finite
degree-one module, and a chartwise finite positive submodule condition with locally nilpotent
quotient. Each condition makes the canonical relative projective-spectrum morphism
quasi-compact.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.AlgebraicSpace Opposite
open SheafOfModules.RingedSite

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace.RelativeProj

variable {S : Scheme.{u}} {X : AlgebraicSpace S}

/-- A graded `𝒪_X`-algebra is generated by `𝒜_1` as an `𝒜_0`-algebra with `𝒜_1` of finite type
as an `𝒜_0`-module when every affine étale chart admits a one-and-mul-preserving `Type u` model
whose ambient graded ring is generated by a finite degree-one module. -/
def GeneratedByDegreeOneFinite
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)) : Prop :=
  ∀ U : affineEtaleSite X,
    ∃ (A : Type u) (hA : CommRing A) (grading : ℕ → Submodule ℤ A)
      (hgraded : GradedAlgebra grading)
      (model : ∀ d : ℕ,
        (𝒜.obj (Int.ofNat d)).val.obj (op U.obj) ≃+ ULift.{u + 1} (grading d)),
      @IsEtaleSectionModel S X 𝒜 U.obj A hA grading hgraded model ∧
        @AlgebraicGeometry.Proj.GeneratedByDegreeOneFinite A (Submodule ℤ A) hA
          inferInstance inferInstance grading hgraded

/-- Generation by a finite degree-one module is the affine-étale existence of a
one-and-mul-preserving `Type u` model with `Proj.GeneratedByDegreeOneFinite`. -/
theorem generatedByDegreeOneFinite_iff
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)) :
    GeneratedByDegreeOneFinite 𝒜 ↔
      ∀ U : affineEtaleSite X,
        ∃ (A : Type u) (hA : CommRing A) (grading : ℕ → Submodule ℤ A)
          (hgraded : GradedAlgebra grading)
          (model : ∀ d : ℕ,
            (𝒜.obj (Int.ofNat d)).val.obj (op U.obj) ≃+ ULift.{u + 1} (grading d)),
          @IsEtaleSectionModel S X 𝒜 U.obj A hA grading hgraded model ∧
            @AlgebraicGeometry.Proj.GeneratedByDegreeOneFinite A (Submodule ℤ A) hA
              inferInstance inferInstance grading hgraded :=
  Iff.rfl

/-- Generation by a finite degree-one module implies generation by the degree-one piece. -/
theorem GeneratedByDegreeOneFinite.toGeneratedByDegreeOne
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)) :
    GeneratedByDegreeOneFinite 𝒜 → GeneratedByDegreeOne 𝒜 :=
  sorry

/-- On every affine étale chart, a graded `𝒪_X`-algebra has a one-and-mul-preserving
`Type u` section model with a finite degree-zero submodule in the positive part whose
quotient ideal is locally nilpotent. This is a chartwise condition. -/
def FinitePositiveSubmoduleLocallyNilpotentQuotient
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)) : Prop :=
  ∀ U : affineEtaleSite X,
    ∃ (A : Type u) (hA : CommRing A) (grading : ℕ → Submodule ℤ A)
      (hgraded : GradedAlgebra grading)
      (model : ∀ d : ℕ,
        (𝒜.obj (Int.ofNat d)).val.obj (op U.obj) ≃+ ULift.{u + 1} (grading d)),
      @IsEtaleSectionModel S X 𝒜 U.obj A hA grading hgraded model ∧
        @AlgebraicGeometry.Proj.FinitePositiveSubmoduleLocallyNilpotentQuotient A
          (Submodule ℤ A) hA inferInstance inferInstance grading hgraded

/-- The finite-positive-submodule condition is the affine-étale existence of a
one-and-mul-preserving `Type u` model with
`Proj.FinitePositiveSubmoduleLocallyNilpotentQuotient`. -/
theorem finitePositiveSubmoduleLocallyNilpotentQuotient_iff
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)) :
    FinitePositiveSubmoduleLocallyNilpotentQuotient 𝒜 ↔
      ∀ U : affineEtaleSite X,
        ∃ (A : Type u) (hA : CommRing A) (grading : ℕ → Submodule ℤ A)
          (hgraded : GradedAlgebra grading)
          (model : ∀ d : ℕ,
            (𝒜.obj (Int.ofNat d)).val.obj (op U.obj) ≃+ ULift.{u + 1} (grading d)),
          @IsEtaleSectionModel S X 𝒜 U.obj A hA grading hgraded model ∧
            @AlgebraicGeometry.Proj.FinitePositiveSubmoduleLocallyNilpotentQuotient A
              (Submodule ℤ A) hA inferInstance inferInstance grading hgraded :=
  Iff.rfl

/-- The quasi-compactness finiteness condition is the global disjunction of finite type over
`𝒜_0`, generation by a finite degree-one module, and the chartwise finite positive submodule
condition with locally nilpotent quotient. -/
def QuasiCompactFiniteness
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)) : Prop :=
  FiniteTypeAsDegreeZeroAlgebra 𝒜 ∨
    GeneratedByDegreeOneFinite 𝒜 ∨
      FinitePositiveSubmoduleLocallyNilpotentQuotient 𝒜

/-- Quasi-compactness finiteness is exactly the disjunction of the three étale-local
finiteness alternatives. -/
theorem quasiCompactFiniteness_iff
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X)) :
    QuasiCompactFiniteness 𝒜 ↔
      FiniteTypeAsDegreeZeroAlgebra 𝒜 ∨
        GeneratedByDegreeOneFinite 𝒜 ∨
          FinitePositiveSubmoduleLocallyNilpotentQuotient 𝒜 :=
  Iff.rfl


/-- A morphism étale-locally presented by the canonical scheme `Proj` of a quasicoherent
commutative graded algebra is quasi-compact if the algebra is finite type over degree zero,
is generated by a finite degree-one module, or satisfies the chartwise finite positive
submodule condition with locally nilpotent quotient. -/
@[stacks 084F]
theorem quasiCompact_of_finiteness
    {S : Scheme.{u}} {X : AlgebraicSpace S}
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X))
    [𝒜.IsCommutative] (hqc : 𝒜.IsQuasicoherent)
    {P : AlgebraicSpace S} (π : P ⟶ X)
    (hπ : IsEtaleLocallyProj 𝒜 π) :
    QuasiCompactFiniteness 𝒜 → QuasiCompact π := sorry

/-- Finite type of `𝒜` as an `𝒜_0`-algebra makes an étale-local scheme relative `Proj`
morphism quasi-compact. -/
theorem quasiCompact_of_finiteTypeAsDegreeZeroAlgebra
    {S : Scheme.{u}} {X : AlgebraicSpace S}
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X))
    [𝒜.IsCommutative] (hqc : 𝒜.IsQuasicoherent)
    {P : AlgebraicSpace S} (π : P ⟶ X)
    (hπ : IsEtaleLocallyProj 𝒜 π) :
    FiniteTypeAsDegreeZeroAlgebra 𝒜 → QuasiCompact π := sorry

/-- Generation of `𝒜` by a finite type `𝒜_0`-module `𝒜_1` makes an étale-local scheme relative
`Proj` morphism quasi-compact. -/
theorem quasiCompact_of_generatedByDegreeOneFinite
    {S : Scheme.{u}} {X : AlgebraicSpace S}
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X))
    [𝒜.IsCommutative] (hqc : 𝒜.IsQuasicoherent)
    {P : AlgebraicSpace S} (π : P ⟶ X)
    (hπ : IsEtaleLocallyProj 𝒜 π) :
    GeneratedByDegreeOneFinite 𝒜 → QuasiCompact π := sorry

/-- The chartwise existence of finite positive submodules with locally nilpotent quotient
makes an étale-local scheme relative `Proj` morphism quasi-compact. -/
theorem quasiCompact_of_finitePositiveSubmoduleLocallyNilpotentQuotient
    {S : Scheme.{u}} {X : AlgebraicSpace S}
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X))
    [𝒜.IsCommutative] (hqc : 𝒜.IsQuasicoherent)
    {P : AlgebraicSpace S} (π : P ⟶ X)
    (hπ : IsEtaleLocallyProj 𝒜 π) :
    FinitePositiveSubmoduleLocallyNilpotentQuotient 𝒜 → QuasiCompact π := sorry

/-- Every affine-étale base change of an étale-local scheme relative `Proj` morphism is
quasi-compact under any of the three finiteness alternatives. -/
theorem quasiCompact_etaleBaseChange
    {S : Scheme.{u}} {X : AlgebraicSpace S}
    (𝒜 : GradedAlgebraSheaf.{u + 1, u} (commStructureSheafLift X))
    [𝒜.IsCommutative] (hqc : 𝒜.IsQuasicoherent)
    {P : AlgebraicSpace S} (π : P ⟶ X)
    (hπ : IsEtaleLocallyProj 𝒜 π) (U : affineEtaleSite X) :
    QuasiCompactFiniteness 𝒜 → QuasiCompact (etaleBaseChangeSnd π U.obj) := sorry

end AlgebraicGeometry.AlgebraicSpace.RelativeProj
