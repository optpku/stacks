module

public import ReasLib.Algebra.Module.LocalizedModule.Away.Cech.FormalGluing
public import Mathlib.RingTheory.RingHom.Flat
import Mathlib.Tactic.CrossRefAttribute

/-!
# Exactness of the Formal-Gluing Cech Complex

The flatness and quotient hypotheses of formal gluing make the explicit module complex exact.

@stack 05EK
-/

@[expose] public section

open CategoryTheory

universe u

namespace LocalizedModule.Away.Cech.FormalGluing

variable {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]

/-- Lemma 15.90.9 (05EK): if `R → S` is flat and induces an isomorphism modulo the ideal
generated by `f`, then the formal-gluing Cech complex of every `R`-module is exact, including
injectivity at its left end. -/
@[stacks 05EK "Lemma 15.90.9"]
theorem complex_exact_of_flat_of_quotientMap_bijective
    {t : ℕ} (M : ModuleCat R) (f : Fin t → R)
    (hflat : (algebraMap R S).Flat)
    (hquot :
      let I : Ideal R := Ideal.span (Set.range f)
      Function.Bijective
        (Ideal.quotientMap (Ideal.map (algebraMap R S) I)
          (algebraMap R S) Ideal.le_comap_map)) :
    (complex S f M).Exact ∧ Mono (complex S f M).f := sorry

end LocalizedModule.Away.Cech.FormalGluing
