module

public import Mathlib.CategoryTheory.Sites.Over
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import stacks_project.Chap67.Definition_67_40_1_Proper
public import stacks_project.Chap67.Definition_67_5_2_Surjective
public import stacks_project.Chap73.Definition_73_4_1_Precoverage

/-!
# The big ph site of algebraic spaces

The ph topology on algebraic spaces over a scheme `S` is the join of the étale
topology and the topology generated by jointly surjective proper morphisms.
The big ph site of an algebraic space `X` is the slice localization of this
topology at `X`.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry

noncomputable section

universe u v

namespace AlgebraicGeometry.AlgebraicSpace

/-- The morphism property of proper surjective morphisms of algebraic spaces
over `S`. -/
def properSurjectiveMorphismProperty (S : Scheme.{u}) :
    MorphismProperty (AlgebraicSpace S) :=
  fun {X Y : AlgebraicSpace S} (f : X ⟶ Y) ↦ Proper f ∧ Surjective f

/-- A morphism satisfies `properSurjectiveMorphismProperty` if and only if it is
proper and surjective. -/
theorem properSurjectiveMorphismProperty_iff {S : Scheme.{u}}
    {X Y : AlgebraicSpace S} (f : X ⟶ Y) :
    properSurjectiveMorphismProperty S f ↔ Proper f ∧ Surjective f :=
  sorry

/-- The precoverage of jointly surjective proper morphisms of algebraic spaces
over `S`. -/
def properSurjectivePrecoverage (S : Scheme.{u}) :
    Precoverage (AlgebraicSpace S) :=
  precoverage (properSurjectiveMorphismProperty S)

/-- An indexed family belongs to `properSurjectivePrecoverage` if and only if
each morphism is proper and surjective and the images of the induced maps on
points cover the target. -/
theorem ofArrows_mem_properSurjectivePrecoverage_iff {S : Scheme.{u}}
    {X : AlgebraicSpace S} {ι : Type v} {Xᵢ : ι → AlgebraicSpace S}
    (f : ∀ i, Xᵢ i ⟶ X) :
    Presieve.ofArrows Xᵢ f ∈ properSurjectivePrecoverage S X ↔
      (∀ i, Proper (f i) ∧ Surjective (f i)) ∧
        (⋃ i, Set.range (Points.map (f i))) = Set.univ :=
  sorry

/-- The ph topology on algebraic spaces over `S`, generated by étale coverings
and jointly surjective proper morphisms. -/
def phTopology (S : Scheme.{u}) : GrothendieckTopology (AlgebraicSpace S) :=
  etalePrecoverage.toGrothendieck ⊔ (properSurjectivePrecoverage S).toGrothendieck

/-- The ph topology is the join of the étale and proper-surjective topologies. -/
theorem phTopology_eq (S : Scheme.{u}) :
    phTopology S =
      etalePrecoverage.toGrothendieck ⊔
        (properSurjectivePrecoverage S).toGrothendieck :=
  sorry

/-- The big ph site `(Spaces / X)_ph` is the localization of `phTopology` at `X`. -/
abbrev bigPhSite {S : Scheme.{u}} (X : AlgebraicSpace S) :
    GrothendieckTopology (Over X) :=
  (phTopology S).over X

/-- The big ph site of `X` is the slice topology of `phTopology` at `X`. -/
theorem bigPhSite_eq {S : Scheme.{u}} (X : AlgebraicSpace S) :
    bigPhSite X = (phTopology S).over X :=
  sorry

end AlgebraicGeometry.AlgebraicSpace
