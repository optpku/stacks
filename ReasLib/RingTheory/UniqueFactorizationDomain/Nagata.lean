module

public import Mathlib.RingTheory.Localization.Ideal
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.UniqueFactorizationDomain.Factorization

/-!
# Nagata's criterion for unique factorization

This leaf owns the localization-facing factorization bridges used by Nagata's
criterion.  The multiplicative set is represented directly by the canonical
containment
`S ≤ Submonoid.closure {p : A | Prime p}`; no chapter-specific predicate or
localization wrapper is introduced.

The source-facing Stacks item is the final criterion
`UniqueFactorizationMonoid.iff_localization_of_primeGenerated`.  The two
preceding declarations are small proposition-level bridges for consumers that
need to move irreducibility or primality across the same localization.
-/

@[expose] public section

universe u

namespace UniqueFactorizationMonoid

namespace Localization

variable {A : Type u} [CommSemiring A] [IsDomain A] {S : Submonoid A}

/-- Tag `0AFU`: an irreducible element either stays irreducible after
localizing at a submonoid generated by prime elements, or becomes a unit. -/
@[stacks 0AFU "irreducibility after a prime-generated localization"]
theorem irreducible_or_isUnit_of_irreducible
    (hS : S ≤ Submonoid.closure {p : A | Prime p}) {x : A}
    (hx : Irreducible x) :
    Irreducible (algebraMap A (Localization S) x) ∨
      IsUnit (algebraMap A (Localization S) x) := sorry

/-- Tag `0AFU`: for an irreducible element, primality is equivalent to
primality of its localized image or invertibility of that image. -/
@[stacks 0AFU "primality across a prime-generated localization"]
theorem prime_iff_prime_or_isUnit_of_irreducible
    (hS : S ≤ Submonoid.closure {p : A | Prime p}) {x : A}
    (hx : Irreducible x) :
    Prime x ↔
      Prime (algebraMap A (Localization S) x) ∨
        IsUnit (algebraMap A (Localization S) x) := sorry

end Localization

variable {A : Type u} [CommSemiring A] [IsDomain A] {S : Submonoid A}

/-- Lemma 10.120.7 (Tag `0AFU`): if `S` is contained in the submonoid
generated by prime elements, then `A` is factorial exactly when every nonzero
nonunit of `A` has an irreducible factorization and `Localization S` is
factorial. -/
@[stacks 0AFU "Nagata criterion for factoriality"]
theorem iff_localization_of_primeGenerated
    (hS : S ≤ Submonoid.closure {p : A | Prime p}) :
    UniqueFactorizationMonoid A ↔
      UniqueFactorizationMonoid.HasIrreducibleFactorizations A ∧
        UniqueFactorizationMonoid (Localization S) := sorry

end UniqueFactorizationMonoid
