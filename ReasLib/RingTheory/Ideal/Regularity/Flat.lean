module

public import Mathlib.Data.List.TFAE
public import Mathlib.RingTheory.RingHom.Flat
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.CompleteIntersection.Basic
public import ReasLib.RingTheory.RingHom.Quotient
public import ReasLib.RingTheory.RingHom.Fiber.Map
public import ReasLib.RingTheory.RingHom.TorDimension

/-!
# Regular-sequence quotients of flat local maps

This file packages the regular-sequence criterion for quotients of a flat local
map at the `RingHom` level. The source and target rings may live in different
universes.
-/

@[expose] public section

open IsLocalRing

universe u v

namespace RingHom.RegularSequenceQuotient

/-- Eventual vanishing of the Tor groups of `S / J` with the residue field of
the source, viewed over `R / I`. The inequality witnessing that the residue
field is an `R / I`-module is kept internal to the proposition. -/
@[stacks 09PX "residue-field Tor condition"]
def ResidueTorEventuallyIsZero {R : Type u} {S : Type v}
    [CommRing R] [CommRing S] [IsLocalRing R]
    (f : R →+* S) (I : Ideal R) (J : Ideal S) (hIJ : I.map f ≤ J) : Prop :=
  ∃ hI : I ≤ maximalIdeal R,
    CategoryTheory.ModuleCat.Tor.EventuallyIsZero
      (f.quotientByIdeals I J hIJ).uliftMax.targetModule
      ((Ideal.Quotient.factor hI).ulift.{max u v, max u v}).targetModule

/-- The residue-field Tor condition can be used through any chosen proof that
`I` lies in the maximal ideal; its truth is independent of that proof. -/
@[stacks 09PX "residue-field Tor condition specification"]
theorem residueTorEventuallyIsZero_iff {R : Type u} {S : Type v}
    [CommRing R] [CommRing S] [IsLocalRing R]
    (f : R →+* S) (I : Ideal R) (J : Ideal S) (hIJ : I.map f ≤ J)
    (hI : I ≤ maximalIdeal R) :
    ResidueTorEventuallyIsZero f I J hIJ ↔
      CategoryTheory.ModuleCat.Tor.EventuallyIsZero
        (f.quotientByIdeals I J hIJ).uliftMax.targetModule
        ((Ideal.Quotient.factor hI).ulift.{max u v, max u v}).targetModule := sorry

/-- For a flat local map with regular closed fiber, finite Tor dimension of a
regular-sequence quotient is equivalent to eventual residue-field Tor
vanishing. -/
@[stacks 09PX "finite Tor iff residue Tor"]
theorem finiteTor_iff_residueTor {R : Type u} {S : Type v}
    [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S]
    [IsNoetherianRing R] [IsNoetherianRing S]
    (f : R →+* S) [IsLocalHom f] (hflat : f.Flat)
    (I : Ideal R) (J : Ideal S) (hIJ : I.map f ≤ J)
    (hclosed : IsRegularLocalRing (f.Fiber (maximalIdeal R))) :
    (J.IsGeneratedByRegularSequence ∧
        (f.quotientByIdeals I J hIJ).HasFiniteTorDimension) ↔
      (J.IsGeneratedByRegularSequence ∧
        ResidueTorEventuallyIsZero f I J hIJ) := sorry

/-- For a flat local map with regular closed fiber, finite Tor dimension of a
regular-sequence quotient is equivalent to regular-sequence generation of the
source ideal and the relative quotient ideal. -/
@[stacks 09PX "finite Tor iff source and relative regularity"]
theorem finiteTor_iff_sourceRelative {R : Type u} {S : Type v}
    [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S]
    [IsNoetherianRing R] [IsNoetherianRing S]
    (f : R →+* S) [IsLocalHom f] (hflat : f.Flat)
    (I : Ideal R) (J : Ideal S) (hIJ : I.map f ≤ J)
    (hclosed : IsRegularLocalRing (f.Fiber (maximalIdeal R))) :
    (J.IsGeneratedByRegularSequence ∧
        (f.quotientByIdeals I J hIJ).HasFiniteTorDimension) ↔
      (I.IsGeneratedByRegularSequence ∧
        (J.map (Ideal.Quotient.mk (I.map f))).IsGeneratedByRegularSequence) := sorry

/-- For a flat local map with regular closed fiber, eventual residue-field Tor
vanishing for a regular-sequence quotient is equivalent to regular-sequence
generation of the source ideal and the relative quotient ideal. -/
@[stacks 09PX "residue Tor iff source and relative regularity"]
theorem residueTor_iff_sourceRelative {R : Type u} {S : Type v}
    [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S]
    [IsNoetherianRing R] [IsNoetherianRing S]
    (f : R →+* S) [IsLocalHom f] (hflat : f.Flat)
    (I : Ideal R) (J : Ideal S) (hIJ : I.map f ≤ J)
    (hclosed : IsRegularLocalRing (f.Fiber (maximalIdeal R))) :
    (J.IsGeneratedByRegularSequence ∧
        ResidueTorEventuallyIsZero f I J hIJ) ↔
      (I.IsGeneratedByRegularSequence ∧
        (J.map (Ideal.Quotient.mk (I.map f))).IsGeneratedByRegularSequence) := sorry

/-- Lemma 23.7.6: let `f : R →+* S` be a flat local map of Noetherian local
rings, let `I ⊆ R` and `J ⊆ S` satisfy `I.map f ≤ J`, and suppose that the
closed fiber `f.Fiber (maximalIdeal R)` is regular. Then the following are
equivalent: `J` is generated by a regular sequence and `S / J` has finite Tor
dimension over `R / I`; `J` is generated by a regular sequence and its Tor with
the residue field of `R` eventually vanishes; and both `I` and the image of `J`
in `S / I.map f` are generated by regular sequences. -/
@[stacks 09PX]
theorem tfae_of_flat_of_regularClosedFiber {R : Type u} {S : Type v}
    [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S]
    [IsNoetherianRing R] [IsNoetherianRing S]
    (f : R →+* S) [IsLocalHom f] (hflat : f.Flat)
    (I : Ideal R) (J : Ideal S) (hIJ : I.map f ≤ J)
    (hclosed : IsRegularLocalRing (f.Fiber (maximalIdeal R))) :
    List.TFAE
      [ J.IsGeneratedByRegularSequence ∧
          (f.quotientByIdeals I J hIJ).HasFiniteTorDimension
      , J.IsGeneratedByRegularSequence ∧
          ResidueTorEventuallyIsZero f I J hIJ
      , I.IsGeneratedByRegularSequence ∧
          (J.map (Ideal.Quotient.mk (I.map f))).IsGeneratedByRegularSequence
      ] := sorry

end RingHom.RegularSequenceQuotient
