module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
public import ReasLib.Algebra.Homology.DerivedCategory.FittingIdeal
public import ReasLib.AlgebraicGeometry.RingedSpace.Module.Derived.PseudoCoherent
public import ReasLib.AlgebraicGeometry.RingedSpace.Module.Derived.PseudoCoherent.Pullback
public import ReasLib.AlgebraicGeometry.RingedSpace.Module.Derived.Sections
public import ReasLib.AlgebraicGeometry.Scheme.IdealSheafData.FiniteType

@[expose] public section

open AlgebraicGeometry CategoryTheory

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme.ModuleDerived

variable {X : Scheme.{u}}

/-- The fitting ideal sheaf of a derived `𝒪_X`-module, defined from the fitting ideals of its
derived sections on affine opens. -/
def fittingIdealSheaf
    (E : RingedSpace.ModuleDerived X.toRingedSpace) (p k : ℤ) : X.IdealSheafData :=
  Scheme.IdealSheafData.ofIdeals fun U ↦
    DerivedCategory.fittingIdeal
      ((RingedSpace.moduleDerivedSectionsAtOpen X.toRingedSpace U).obj E) p k

/-- On an affine open, the fitting ideal sheaf is computed by every finite-free presentation of
the derived sections. -/
theorem fittingIdealSheaf_ideal
    (E : RingedSpace.ModuleDerived X.toRingedSpace)
    (hE : RingedSpace.ModuleDerived.IsPseudoCoherent E)
    (p k : ℤ) (U : X.affineOpens)
    (P : DerivedCategory.FittingPresentation
      ((RingedSpace.moduleDerivedSectionsAtOpen X.toRingedSpace U).obj E)) :
    (fittingIdealSheaf E p k).ideal U = P.ideal p k := sorry

/-- The fitting ideal sheaf of a pseudo-coherent derived module is of finite type. -/
theorem fittingIdealSheaf_isFiniteType
    (E : RingedSpace.ModuleDerived X.toRingedSpace)
    (hE : RingedSpace.ModuleDerived.IsPseudoCoherent E) (p k : ℤ) :
    (fittingIdealSheaf E p k).IsFiniteType := sorry

/-- Derived fitting ideal sheaves commute with pullback of pseudo-coherent derived modules. -/
theorem fittingIdealSheaf_pullback {Y : Scheme.{u}} (f : Y ⟶ X)
    (E : RingedSpace.ModuleDerived X.toRingedSpace)
    (hE : RingedSpace.ModuleDerived.IsPseudoCoherent E) (p k : ℤ) :
    (fittingIdealSheaf E p k).comap f =
      fittingIdealSheaf ((RingedSpace.modulePullbackDerived f.toLRSHom.toShHom).obj E) p k := sorry

/-- For a pseudo-coherent derived module, the fitting ideal sheaf is of finite type and its
ideal on every affine open is generated by minors of the coordinate differential of any
bounded-above finite-free presentation, with the minor size corrected by the alternating tail
rank. -/
theorem fittingIdealSheaf_spec {X : Scheme.{u}}
    (E : RingedSpace.ModuleDerived X.toRingedSpace)
    (hE : RingedSpace.ModuleDerived.IsPseudoCoherent E) (p k : ℤ) :
    (fittingIdealSheaf E p k).IsFiniteType ∧
      ∀ (U : X.affineOpens)
        (P : DerivedCategory.FittingPresentation
          ((RingedSpace.moduleDerivedSectionsAtOpen X.toRingedSpace U).obj E)),
        (fittingIdealSheaf E p k).ideal U =
          Matrix.minorIdeal (Int.toNat (-k + P.alternatingTailRank p)) (P.matrix p) := sorry

end AlgebraicGeometry.Scheme.ModuleDerived
