module

public import ReasLib.AlgebraicGeometry.Scheme.Sites.AffineOver
public import Mathlib.CategoryTheory.Sites.Pretopology

/-!
# Pretopologies on affine scheme slices

This module upgrades the restriction of an arbitrary Grothendieck topology on
`Over S` to a pretopology on its affine full subcategory.  The required
isomorphism, composition, and pullback stability are inherited by
`Precoverage.comap` from the ambient topology.
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry.Scheme

/-- The pretopology on affine schemes over `S` obtained by restricting a
Grothendieck topology on `Over S`. -/
noncomputable abbrev affineOverPretopology (S : Scheme.{u}) (J : GrothendieckTopology (Over S)) :
    Pretopology S.AffineOver :=
  (affineOverPrecoverage S J).toPretopology

/-- The precoverage underlying the restricted affine pretopology is the
restricted affine precoverage itself. -/
theorem affineOverPretopology_toPrecoverage (S : Scheme.{u})
    (J : GrothendieckTopology (Over S)) :
    (affineOverPretopology S J).toPrecoverage = affineOverPrecoverage S J := sorry

/-- The Grothendieck topology generated by the restricted affine pretopology
is the topology generated by its restricted affine precoverage. -/
theorem affineOverPretopology_toGrothendieck (S : Scheme.{u})
    (J : GrothendieckTopology (Over S)) :
    (affineOverPretopology S J).toGrothendieck =
      (affineOverPrecoverage S J).toGrothendieck := sorry

end AlgebraicGeometry.Scheme
