module

public import Mathlib.Algebra.Module.LocalizedModule.Away
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.Algebra.Module.End.Units

/-!
# Units on Principal Localized Modules

This leaf specializes the general module-endomorphism unit lemma to canonical
principal localizations of modules.

@stack 051T
-/

@[expose] public section

universe u v

namespace LocalizedModule.Away

variable {R : Type u} [CommSemiring R]
variable {M : Type v} [AddCommMonoid M] [Module R M]

/-- Tag `051T`: every divisor of the distinguished element acts invertibly on
the canonical principal localization of a module. -/
@[stacks 051T "canonical principal localized module-endomorphism unit"]
theorem isUnit_algebraMap_of_dvd
    (x : R) {r : R} (h : r ∣ x) :
    IsUnit (algebraMap R (Module.End R (LocalizedModule.Away x M)) r) := sorry

/-- Tag `051T`: every element of the submonoid generated by a divisor of the
distinguished element acts invertibly on the canonical principal localization
of a module. -/
@[stacks 051T "powers on canonical principal localized module"]
theorem isUnit_algebraMap_of_mem_powers_of_dvd
    (x : R) {r : R} (h : r ∣ x) (s : Submonoid.powers r) :
    IsUnit (algebraMap R (Module.End R (LocalizedModule.Away x M)) s) := sorry

end LocalizedModule.Away
