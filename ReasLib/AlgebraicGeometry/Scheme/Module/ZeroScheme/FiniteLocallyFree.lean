module

public import ReasLib.AlgebraicGeometry.Scheme.IdealSubobject
public import ReasLib.AlgebraicGeometry.Scheme.Module.FittingIdeal.BaseChange
public import ReasLib.AlgebraicGeometry.Scheme.Module.FiniteLocallyFree.Rank
public import ReasLib.AlgebraicGeometry.Scheme.Module.Sections
public import ReasLib.AlgebraicGeometry.Scheme.Module.ZeroScheme

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open CategoryTheory.MonoidalCategory CategoryTheory.MonoidalClosed
open AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}}

/-- Evaluation against a section, viewed as a morphism from the internal-Hom dual to the
structure module. -/
noncomputable def sectionDualHom (E : X.Modules) (s : E.sections) :
    (ihom E).obj (SheafOfModules.unit X.ringCatSheaf : X.Modules) ⟶
      (SheafOfModules.unit X.ringCatSheaf : X.Modules) :=
  (((ρ_ ((ihom E).obj (SheafOfModules.unit X.ringCatSheaf : X.Modules))).symm) ≪≫
      ((Iso.refl ((ihom E).obj (SheafOfModules.unit X.ringCatSheaf : X.Modules)) ⊗ᵢ
        SheafOfModules.RingedSite.unitIsoTensorUnit
          (J := Opens.grothendieckTopology X.toTopCat) (𝒪 := X.𝒪)).symm)).hom ≫
    tensorHom
      (𝟙 ((ihom E).obj (SheafOfModules.unit X.ringCatSheaf : X.Modules)))
      (E.unitHomEquiv.symm s) ≫
    (β_ ((ihom E).obj (SheafOfModules.unit X.ringCatSheaf : X.Modules)) E).hom ≫
    (ihom.ev E).app (SheafOfModules.unit X.ringCatSheaf : X.Modules)

/-- The dual-section map is the canonical tensor-evaluation composite. -/
theorem sectionDualHom_def (E : X.Modules) (s : E.sections) :
    sectionDualHom E s =
      (((ρ_ ((ihom E).obj (SheafOfModules.unit X.ringCatSheaf : X.Modules))).symm) ≪≫
        ((Iso.refl ((ihom E).obj (SheafOfModules.unit X.ringCatSheaf : X.Modules)) ⊗ᵢ
          SheafOfModules.RingedSite.unitIsoTensorUnit
            (J := Opens.grothendieckTopology X.toTopCat) (𝒪 := X.𝒪)).symm)).hom ≫
      tensorHom
        (𝟙 ((ihom E).obj (SheafOfModules.unit X.ringCatSheaf : X.Modules)))
        (E.unitHomEquiv.symm s) ≫
      (β_ ((ihom E).obj (SheafOfModules.unit X.ringCatSheaf : X.Modules)) E).hom ≫
      (ihom.ev E).app (SheafOfModules.unit X.ringCatSheaf : X.Modules) := sorry

/-- The ideal sheaf of the zero scheme of a section of a constant-rank finite locally free
module, defined by the preceding Fitting ideal of the section cokernel. -/
noncomputable def sectionZeroIdeal (E : X.Modules) (r : ℕ)
    [E.IsFiniteLocallyFreeOfRank r] (s : E.sections) : X.IdealSheafData :=
  Scheme.precedingFittingIdealSheaf (cokernel (E.unitHomEquiv.symm s)) r

/-- The section-zero ideal is the preceding Fitting ideal of the section cokernel. -/
theorem sectionZeroIdeal_def (E : X.Modules) (r : ℕ)
    [E.IsFiniteLocallyFreeOfRank r] (s : E.sections) :
    sectionZeroIdeal E r s =
      Scheme.precedingFittingIdealSheaf (cokernel (E.unitHomEquiv.symm s)) r := sorry

/-- The ideal subobject underlying the section-zero ideal is generated by evaluation against
the section. -/
theorem sectionZeroIdeal_toSubobject (E : X.Modules) (r : ℕ)
    [E.IsFiniteLocallyFreeOfRank r] (s : E.sections) :
    (sectionZeroIdeal E r s).toSubobject =
      (imageSubobject (sectionDualHom E s) : X.IdealSubobject) := sorry

/-- Formation of the section-zero ideal commutes with pullback. -/
theorem sectionZeroIdeal_pullback {Y : Scheme.{u}} (g : Y ⟶ X)
    (E : X.Modules) (r : ℕ) [E.IsFiniteLocallyFreeOfRank r] (s : E.sections) :
    (sectionZeroIdeal E r s).comap g =
      sectionZeroIdeal ((pullback g).obj E) r (sectionsPullback g E s) := sorry

end AlgebraicGeometry.Scheme.Modules
