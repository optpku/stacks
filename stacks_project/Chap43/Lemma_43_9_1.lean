module

public import ReasLib.AlgebraicGeometry.ChowGroup.Principal
import StacksCheckRecall

@[expose] public section

open CategoryTheory Set

noncomputable section

universe u

namespace AlgebraicGeometry.SchemeOverField

/- Lemma 43.9.1 (1): a principal cycle coming from a nonzero rational function on a
dimension-`k + 1` subvariety of a variety is rationally equivalent to zero. -/
@[stacks 0AZI]
#check
  (AlgebraicGeometry.SchemeOverField.principal_isRationallyTrivial :
    ∀ {K : Type u} [Field K]
      (X : SchemeOverField K) [Variety X] (k : ℤ) (x : X.left)
      (hx : X.hom.relativeDimensionFunction (fun _ : Spec (CommRingCat.of K) ↦ 0) x = k + 1)
      (f : (Scheme.PointClosure.scheme x).functionFieldˣ),
      @RationalEquivalence.IsRationallyTrivial X.left
        (LocallyOfFiniteType.isLocallyNoetherian X.hom)
        (X.hom.relativeDimensionFunction (fun _ : Spec (CommRingCat.of K) ↦ 0)) inferInstance k
        (@RationalEquivalence.principal X.left
          (LocallyOfFiniteType.isLocallyNoetherian X.hom)
          (X.hom.relativeDimensionFunction (fun _ : Spec (CommRingCat.of K) ↦ 0)) inferInstance
          k x hx f))

/- Lemma 43.9.1 (2): the subgroup of cycles rationally equivalent to zero on a variety is
generated by principal cycles from subvarieties of dimension `k + 1`. -/
@[stacks 0AZI]
#check
  (AlgebraicGeometry.SchemeOverField.boundaries_eq_closure_principalCycles :
    ∀ {K : Type u} [Field K] (X : SchemeOverField K) [Variety X] (k : ℤ),
      @RationalEquivalence.boundaries X.left
        (LocallyOfFiniteType.isLocallyNoetherian X.hom)
        (X.hom.relativeDimensionFunction (fun _ : Spec (CommRingCat.of K) ↦ 0)) inferInstance k =
        AddSubgroup.closure
          (@RationalEquivalence.principalCycles X.left
            (LocallyOfFiniteType.isLocallyNoetherian X.hom)
            (X.hom.relativeDimensionFunction (fun _ : Spec (CommRingCat.of K) ↦ 0)) inferInstance
            k))

end AlgebraicGeometry.SchemeOverField
