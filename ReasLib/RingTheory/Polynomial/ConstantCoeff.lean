module

public import Mathlib.RingTheory.AdjoinRoot
public import Mathlib.RingTheory.Polynomial.Ideal
public import Mathlib.RingTheory.Ideal.Maps
import Mathlib.Tactic.CrossRefAttribute

/-!
# Constant-coefficient kernels

This leaf records the ideal-theoretic kernel of constant-coefficient evaluation.
The formula is independent of a particular quotient or plane-curve presentation;
the `AdjoinRoot` statement below is only its standard quotient specialization.

The construction is used as shared support for Example 10.140.8 (`@stack 00TY`),
but the declarations themselves are neutral library facts.

@stack 00TY
-/

@[expose] public section

universe u v

namespace Polynomial

variable {B : Type u} [CommSemiring B]

/-- The inverse image of an ideal under constant-coefficient evaluation is generated
by its constant polynomials and the polynomial variable. -/
theorem comap_constantCoeff (I : Ideal B) :
    I.comap (Polynomial.constantCoeff : Polynomial B →+* B) =
      I.map (Polynomial.C : B →+* Polynomial B) ⊔
        Ideal.span ({Polynomial.X} : Set (Polynomial B)) := by
  apply le_antisymm
  · intro p hp
    change p.coeff 0 ∈ I at hp
    have hC : Polynomial.C (p.coeff 0) ∈
        I.map (Polynomial.C : B →+* Polynomial B) :=
      Ideal.mem_map_of_mem _ hp
    have hX : Polynomial.X * p.divX ∈
        Ideal.span ({Polynomial.X} : Set (Polynomial B)) :=
      Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_singleton _))
    rw [← Polynomial.X_mul_divX_add p]
    exact (Ideal.add_mem _ (Ideal.mem_sup_right hX) (Ideal.mem_sup_left hC))
  · refine sup_le ?_ ?_
    · rw [Ideal.map_le_iff_le_comap]
      intro b hb
      change Polynomial.constantCoeff (Polynomial.C b) ∈ I
      simpa using hb
    · rw [Ideal.span_le]
      intro p hp
      rw [Set.mem_singleton_iff.mp hp]
      change Polynomial.constantCoeff Polynomial.X ∈ I
      simp

/-- The kernel of a map after constant-coefficient evaluation is the sum of the
mapped kernel and the ideal generated by the polynomial variable. -/
theorem ker_comp_constantCoeff {C : Type v} [CommSemiring C] (f : B →+* C) :
    RingHom.ker (f.comp (Polynomial.constantCoeff : Polynomial B →+* B)) =
      (RingHom.ker f).map (Polynomial.C : B →+* Polynomial B) ⊔
        Ideal.span ({Polynomial.X} : Set (Polynomial B)) := by
  rw [← RingHom.comap_ker, Polynomial.comap_constantCoeff]

end Polynomial

namespace AdjoinRoot

variable {K : Type u}

/-- The kernel of `AdjoinRoot.mk g` after constant-coefficient evaluation. -/
theorem ker_mk_comp_constantCoeff [CommRing K] (g : Polynomial K) :
    RingHom.ker ((AdjoinRoot.mk g).comp
      (Polynomial.constantCoeff : Polynomial (Polynomial K) →+* Polynomial K)) =
      Ideal.span ({Polynomial.C g, Polynomial.X} : Set (Polynomial (Polynomial K))) := by
  rw [Polynomial.ker_comp_constantCoeff]
  have hker : RingHom.ker (AdjoinRoot.mk g) =
      Ideal.span ({g} : Set (Polynomial K)) := Ideal.mk_ker
  rw [hker, Ideal.map_span, Set.image_singleton, ← Ideal.span_insert]

section Field

variable [Field K]

/-- If `g` is irreducible over a field, then the ideal `(C g, X)` of
`K[X][X]` is maximal.  Its quotient is the field `AdjoinRoot g`. -/
theorem span_C_X_isMaximal (g : Polynomial K) (hg : Irreducible g) :
    (Ideal.span ({Polynomial.C g, Polynomial.X} :
      Set (Polynomial (Polynomial K)))).IsMaximal := by
  rw [← ker_mk_comp_constantCoeff g]
  letI : Fact (Irreducible g) := ⟨hg⟩
  apply RingHom.ker_isMaximal_of_surjective
  exact AdjoinRoot.mk_surjective.comp fun f ↦
    ⟨Polynomial.C f, by simp⟩

end Field

end AdjoinRoot
