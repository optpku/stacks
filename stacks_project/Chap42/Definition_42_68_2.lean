module

public import ReasLib.Algebra.Module.FiniteLength.Determinant
import StacksCheckRecall

universe u v

/-
Definition 42.68.2. The determinant of a finite-length module over a local ring is the
residue-field module generated by admissible symbols, modulo the zero-entry, unit-change,
and adjacent-swap relations.
-/
@[stacks 02P6] #check
  (@Module.FiniteLengthDeterminant :
    (R : Type u) → (M : Type v) → [CommRing R] → [IsLocalRing R] →
      [AddCommGroup M] → [Module R M] → IsFiniteLength R M →
        Type (max (max v u) u v))
