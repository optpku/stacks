module

public import Mathlib.Algebra.Module.SpanRank
public import Mathlib.AlgebraicGeometry.Morphisms.SmoothFiber
public import Mathlib.Data.List.TFAE
public import Mathlib.RingTheory.Extension.Presentation.Submersive
public import ReasLib.AlgebraicGeometry.Scheme.GlobalSections
public import ReasLib.AlgebraicGeometry.Scheme.Morphism.Smooth.AtPoint
public import ReasLib.AlgebraicGeometry.Scheme.Morphism.Smooth.Differentials

/-!
# Local criteria for smooth morphisms

This module gives pointwise criteria for smoothness in terms of flatness of the stalk map,
generators of relative differentials, standard-smooth affine charts, and Jacobian presentations.
-/

@[expose] public section

open scoped AlgebraicGeometry TensorProduct

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme.Hom

/-- The stalk of relative differentials at a point can be generated by at most the local
dimension of the fibre through that point. -/
def differentialsStalkGeneratedByFiberDimension
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Prop :=
  (⊤ : Submodule (X.presheaf.stalk x)
      (RingedSpace.stalkModuleCat (Ω[f.toShHom]) x)).FG ∧
    ((⊤ : Submodule (X.presheaf.stalk x)
        (RingedSpace.stalkModuleCat (Ω[f.toShHom]) x)).spanFinrank : WithBot ℕ∞) ≤
      f.fiberDimensionAt x

/-- The relative cotangent space at a point can be generated by at most the local dimension of
the fibre through that point. This cotangent space is canonically identified with the
corresponding cotangent space formed from the fibre differentials. -/
def cotangentSpaceGeneratedByFiberDimension
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Prop :=
  (⊤ : Submodule (IsLocalRing.ResidueField (X.presheaf.stalk x))
      (IsLocalRing.ResidueField (X.presheaf.stalk x) ⊗[X.presheaf.stalk x]
        (RingedSpace.stalkModuleCat (Ω[f.toShHom]) x))).FG ∧
    ((⊤ : Submodule (IsLocalRing.ResidueField (X.presheaf.stalk x))
        (IsLocalRing.ResidueField (X.presheaf.stalk x) ⊗[X.presheaf.stalk x]
          (RingedSpace.stalkModuleCat (Ω[f.toShHom]) x))).spanFinrank : WithBot ℕ∞) ≤
      f.fiberDimensionAt x

/-- The stalk map is flat and the fibre is smooth at the point induced by the source point. -/
def flatStalkMapAndSmoothFiberAt
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Prop :=
  (f.stalkMap x).hom.Flat ∧
    (f.fiberToSpecResidueField (f x)).SmoothAt (f.asFiber x)

/-- The stalk map is flat and the relative-differential stalk satisfies the fibre-dimension
generator bound. -/
def flatStalkMapAndDifferentialsGeneratedAt
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Prop :=
  (f.stalkMap x).hom.Flat ∧ differentialsStalkGeneratedByFiberDimension f x

/-- The stalk map is flat and the relative cotangent space satisfies the fibre-dimension
generator bound. -/
def flatStalkMapAndCotangentSpaceGeneratedAt
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Prop :=
  (f.stalkMap x).hom.Flat ∧ cotangentSpaceGeneratedByFiberDimension f x

/-- There are compatible affine neighbourhoods of a point and its image on which the restricted
morphism is standard smooth. -/
def existsAffineOpenStandardSmoothAt
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Prop :=
  ∃ U : X.affineOpens, x ∈ (U : X.Opens) ∧
    ∃ V : S.affineOpens,
      ∃ e : (U : X.Opens) ≤ f ⁻¹ᵁ (V : S.Opens),
        StandardSmooth (f.resLE V U e)

/-- There are compatible affine neighbourhoods carrying a finite presentation whose selected
square Jacobian determinant avoids the prime corresponding to the given point. -/
def existsAffineOpenJacobianPresentationAt
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Prop :=
  ∃ U : X.affineOpens, ∃ hxU : x ∈ (U : X.Opens),
    ∃ V : S.affineOpens,
      ∃ e : (U : X.Opens) ≤ f ⁻¹ᵁ (V : S.Opens),
        ∃ n c : ℕ,
          ∃ P : Algebra.PreSubmersivePresentation
              Γ(S, (V : S.Opens))
              (f.sectionsAlg (V : S.Opens) (U : X.Opens) e) (Fin n) (Fin c),
            P.jacobian ∉ (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal

/-- For a locally finitely presented morphism, smoothness at a point is equivalent to flatness
of the stalk map together with smoothness of the fibre, either of two generator bounds for
relative differentials, the existence of a standard-smooth affine chart, and the existence of
an affine Jacobian presentation whose selected determinant avoids the point prime. -/
theorem smoothAt_tfae_flat_stalkMap_smoothFiber_differentials_standardSmooth
    {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFinitePresentation f] (x : X) :
    List.TFAE
      [ f.SmoothAt x
      , flatStalkMapAndSmoothFiberAt f x
      , flatStalkMapAndDifferentialsGeneratedAt f x
      , flatStalkMapAndCotangentSpaceGeneratedAt f x
      , existsAffineOpenStandardSmoothAt f x
      , existsAffineOpenJacobianPresentationAt f x
      ] := sorry

end AlgebraicGeometry.Scheme.Hom
