module

public import ReasLib.RingTheory.RingHom.PowerGeneration.Spectrum
import StacksCheckRecall

/-!
# Prime-power generation and universal homeomorphisms

@stack 0BRA
-/

@[expose] public section

/- Lemma 10.46.7: suppose that a ring map `f : R →+* S` has locally nilpotent kernel and
that `S` is generated by elements whose suitable positive prime powers and scalar multiples lie
in the image of `f`. Then the induced map on spectra is a homeomorphism, the residue-field maps
satisfy the canonical purely inseparable criterion, and both hypotheses persist after arbitrary
base change. -/

@[stacks 0BRA "residue-field criterion"]
#check @RingHom.PowerGeneration.Spectrum.residueField_criterion

@[stacks 0BRA "purely inseparable residue fields"]
#check @RingHom.PowerGeneration.Spectrum.residueField_isPurelyInseparable

@[stacks 0BRA "homeomorphism on spectra"]
#check @RingHom.PowerGeneration.Spectrum.isHomeomorph_comap

@[stacks 0BRA "base-changed generation"]
#check @RingHom.PowerGeneration.BaseChange.isGenerated

@[stacks 0BRA "base-changed locally nilpotent kernel"]
#check @RingHom.PowerGeneration.Spectrum.BaseChange.ker_isLocallyNilpotent

@[stacks 0BRA "base-changed homeomorphism on spectra"]
#check @RingHom.PowerGeneration.Spectrum.BaseChange.isHomeomorph_comap
