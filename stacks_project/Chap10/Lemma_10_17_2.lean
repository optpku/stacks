module

public import ReasLib.AlgebraicGeometry.PrimeSpectrum.Notation
public import ReasLib.RingTheory.Spectrum.Prime.BasicOpen
public import Mathlib.RingTheory.Ideal.Maximal
public import Mathlib.RingTheory.Ideal.MinimalPrime.Basic
public import Mathlib.RingTheory.Ideal.Operations
import StacksCheckRecall

@[expose] public section

/-!
# Lemma 10.17.2

@stack 00E0

The standard spectrum identities are recalled directly from their canonical owners.  The few
textbook clauses that specialize a stronger owner or package an implication remain as thin
source-facing statements.
-/

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open PrimeSpectrum
open scoped PrimeSpectrum

section

variable {R : Type u} [CommRing R]

/- Lemma 10.17.2 (1): the prime spectrum of `R` is empty if and only if `R` is the zero ring. -/
@[stacks 00E0 "(1)"]
#check @isEmpty_iff_subsingleton

section Nontrivial

variable [Nontrivial R]

/- Lemma 10.17.2 (2): every nonzero ring admits a maximal ideal. -/
@[stacks 00E0 "(2)"]
#check @Ideal.exists_maximal

/- Lemma 10.17.2 (3): every nonzero ring admits a minimal prime ideal. This is
the bottom-ideal specialization of the canonical proper-ideal result. -/
@[stacks 00E0 "(3)"]
#check @Ideal.nonempty_minimalPrimes

end Nontrivial

/- Lemma 10.17.2 (4): if `I ⊆ p` and `p` is prime, then there exists a prime `q` with
`I ⊆ q ⊆ p` such that `q` is minimal over `I`. -/
@[stacks 00E0 "(4)"]
#check @Ideal.exists_minimalPrimes_le

/- Lemma 10.17.2 (5): the zero locus of the ideal generated by `T` equals the zero locus of the
subset `T`. -/
@[stacks 00E0 "(5)"]
#check @zeroLocus_span

/- Lemma 10.17.2 (6): the zero locus of an ideal depends only on its radical. -/
@[stacks 00E0 "(6)"]
#check @zeroLocus_radical

/- Lemma 10.17.2 (7): the radical of `I` is the intersection of all prime ideals containing `I`.
-/
@[stacks 00E0 "(7)"]
#check @Ideal.radical_eq_sInf

/- Lemma 10.17.2 (8): the zero locus of an ideal is empty exactly when the ideal is the unit
ideal. -/
@[stacks 00E0 "(8)"]
#check @zeroLocus_empty_iff_eq_top

/- Lemma 10.17.2 (9): the union of the zero loci of `I` and `J` is the zero locus of `I ∩ J`.
Equivalently, `zeroLocus (I ⊓ J) = zeroLocus I ∪ zeroLocus J`. -/
@[stacks 00E0 "(9)"]
#check @zeroLocus_inf

/- Lemma 10.17.2 (10): for a family of ideals `(I a)`, the intersection of their zero loci equals
the zero locus of the union of the underlying subsets. -/
@[stacks 00E0 "(10)"]
#check @zeroLocus_iUnion

/- Lemma 10.17.2 (11): `D(f)` is the complement of `V(f)` in `Spec R`. -/
@[stacks 00E0 "(11)"]
#check @basicOpen_eq_zeroLocus_compl

/- Lemma 10.17.2 (12): `D(f)` is empty if and only if `f` is nilpotent. -/
@[stacks 00E0 "(12)"]
#check @basicOpen_eq_bot_iff

/- Lemma 10.17.2 (13): multiplying `f` by a unit does not change `D(f)`. -/
@[stacks 00E0 "(13)"]
#check @PrimeSpectrum.basicOpen_unit_mul

/- Lemma 10.17.2 (14): if `p` does not lie in `V(I)`, there is some `f ∈ I`
such that `D(f)` contains `p` and is disjoint from `V(I)`. -/
@[stacks 00E0 "(14)"]
#check @PrimeSpectrum.exists_basicOpen_disjoint_zeroLocus_of_not_mem

/- Lemma 10.17.2 (15): `D(fg)` is the intersection of `D(f)` and `D(g)`. Equivalently,
`basicOpen (f * g) = basicOpen f ⊓ basicOpen g`. -/
@[stacks 00E0 "(15)"]
#check @basicOpen_mul

/- Lemma 10.17.2 (16): the union of the basic opens `D(f i)` is the
complement of the zero locus of the family `{f i}`. -/
@[stacks 00E0 "(16)"]
#check @PrimeSpectrum.iUnion_basicOpen_eq_compl_zeroLocus_range

/- Lemma 10.17.2 (17): if `D(f)` is all of `Spec R`, then `f` is a unit. -/
@[stacks 00E0 "(17)"]
#check @PrimeSpectrum.basicOpen_eq_top_iff

end
