module

public import ReasLib.AlgebraicGeometry.RingedSpace.Module.Derived.Cohomology.InverseSystem
public import ReasLib.AlgebraicGeometry.RingedSpace.Module.GlobalSections.Linear
public import ReasLib.CategoryTheory.InverseSystem.Sequential.PrincipalTorsion
public import ReasLib.RingTheory.Ideal.Principal
public import ReasLib.RingTheory.Topology.Adic.InverseLimit
import Mathlib.Tactic.CrossRefAttribute

/-!
# Adic limits of cohomology towers

The cohomology tower of a principal torsion inverse system has ideal-power projection kernels.
This packages the cohomological input independently of a chapter and delegates the resulting
topology comparison to the generic `SequentialInverseSystem.HasAdicKernels` API.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite
open CategoryTheory.SequentialInverseSystem
open scoped PrincipalIdeal

noncomputable section

universe u

namespace AlgebraicGeometry.RingedSpace.ModuleCohomology

/-- Lemma 20.36.2 (1) (0EHA): for a principal torsion tower, the `c`th power of the
principal ideal generated by `f`, applied to the inverse limit of degree-`p` cohomology, is the
kernel of projection to stage `c`. -/
@[stacks 0EHA "kernel description"]
theorem pow_eq_limitKernel
    {X : RingedSpace.{u}} (F : SequentialInverseSystem X.Modules)
    (f : globalSectionsRing X) (hF : PrincipalTorsion.IsPresented f F)
    (p c : ℕ) (hc : 1 ≤ c) :
    (((f) : Ideal (globalSectionsRing X)) ^ c) •
        (⊤ : Submodule (globalSectionsRing X)
          (limit (moduleCohomologyTower F p) :
            ModuleCat.{u} (globalSectionsRing X))) =
      Functor.limitKernel (moduleCohomologyTower F p) (op c) := sorry

/-- The projection-kernel computation packages a principal torsion cohomology tower as an adic
inverse limit. -/
@[stacks 0EHA "adic cohomology inverse limit"]
theorem hasAdicKernels
    {X : RingedSpace.{u}} (F : SequentialInverseSystem X.Modules)
    (f : globalSectionsRing X) (hF : PrincipalTorsion.IsPresented f F) (p : ℕ) :
    (moduleCohomologyTower F p).HasAdicKernels
      ((f) : Ideal (globalSectionsRing X)) := sorry

/-- Lemma 20.36.2 (2) (0EHA): for a principal torsion tower, the limit topology on
degree-`p` cohomology is the adic topology for the principal ideal generated by `f`. -/
@[stacks 0EHA "adic limit topology"]
theorem limitTopology_eq_adic
    {X : RingedSpace.{u}} (F : SequentialInverseSystem X.Modules)
    (f : globalSectionsRing X) (hF : PrincipalTorsion.IsPresented f F) (p : ℕ) :
    Functor.limitTopology (moduleCohomologyTower F p) =
      Ideal.adicModuleTopology ((f) : Ideal (globalSectionsRing X))
        (limit (moduleCohomologyTower F p) :
          ModuleCat.{u} (globalSectionsRing X)) := sorry

end AlgebraicGeometry.RingedSpace.ModuleCohomology
