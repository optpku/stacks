module

public import ReasLib.CategoryTheory.Sites.Topos.Composition
public import ReasLib.CategoryTheory.Sites.Grothendieck.Fiberwise

/-!
# Topos morphisms of a fiberwise simplicial site

A simplicial object of sites whose structure maps are cocontinuous and have
property `P` (`HasCoverLifts`) induces morphisms of topoi
`f_φ : Sh(C_n) ⟶ Sh(C_m)` along `u_φ : C_n ⥤ C_m`. The total site carries the
Grothendieck topology generated by the identity-degree fiber precoverage.
-/

@[expose] public section

universe u v w

open CategoryTheory CategoryTheory.Limits Opposite

namespace CategoryTheory.Grothendieck

/-- Opposite structure maps of a simplicial diagram compose as functors of stage categories. -/
def map_comp_toFunctor (F : SimplicialObject Cat.{v, u}) {l m n : SimplexCategory}
    (ψ : l ⟶ m) (φ : m ⟶ n) :
    (F.map φ.op).toFunctor ⋙ (F.map ψ.op).toFunctor ≅ (F.map (ψ ≫ φ).op).toFunctor :=
  Cat.Hom.toNatIso (eqToIso (F.map_comp φ.op ψ.op)).symm

/-- The Grothendieck topology on the total category of a fiberwise simplicial site,
generated by identity-degree fiber covering families. -/
def topology (F : SimplicialObject Cat.{v, u}) (J : ∀ n, Precoverage (F.obj n)) :
    GrothendieckTopology (Grothendieck F) :=
  (precoverage F J).toGrothendieck

/-- Stage inclusions are continuous and cocontinuous, and simplex structure maps
are cocontinuous for the generated Grothendieck topologies. -/
class HasSheafTransitions (F : SimplicialObject Cat.{v, u})
    (J : ∀ n, Precoverage (F.obj n)) : Prop where
  /-- Stage inclusions induce restriction of sheaves. -/
  component_continuous : ∀ n : SimplexCategory,
    (ι F (op n)).IsContinuous (J (op n)).toGrothendieck (topology F J)
  /-- Stage inclusions also induce cocontinuous sheaf pullback. -/
  component_cocontinuous : ∀ n : SimplexCategory,
    (ι F (op n)).IsCocontinuous (J (op n)).toGrothendieck (topology F J)
  /-- Diagram maps induce inverse images by cocontinuity. -/
  structure_cocontinuous : ∀ {m n : SimplexCategory} (φ : m ⟶ n),
    (F.map φ.op).toFunctor.IsCocontinuous
      (J (op n)).toGrothendieck (J (op m)).toGrothendieck

attribute [instance] HasSheafTransitions.structure_cocontinuous

/-- A diagram of selected-cover sites with property P has the continuity
facts needed for its sheaf comparisons. -/
instance (priority := 100) IsFiberwiseSite.hasSheafTransitions
    (F : SimplicialObject Cat.{v, u}) (J : ∀ n, Precoverage (F.obj n))
    [IsFiberwiseSite F J] : HasSheafTransitions F J :=
  sorry

section

variable (F : SimplicialObject Cat.{v, u}) (J : ∀ n, Precoverage (F.obj n))
variable [h_fiberwise : IsFiberwiseSite F J]
include h_fiberwise

variable [∀ n, HasSheafify (J n).toGrothendieck (Type w)]
variable [∀ (m n : SimplexCategory) (φ : m ⟶ n)
    (P : (F.obj (op n))ᵒᵖ ⥤ Type w),
    ((F.map φ.op).toFunctor).op.HasPointwiseRightKanExtension P]

/-- The morphism of topoi `f_φ : Sh(F.obj (op n)) ⟶ Sh(F.obj (op m))` attached to a
simplex operator `φ : m ⟶ n`, presented by the cocontinuous functor
`u_φ = (F.map φ.op).toFunctor : F.obj (op n) ⥤ F.obj (op m)`. -/
noncomputable def toposMap {m n : SimplexCategory} (φ : m ⟶ n) :
    MorphismOfTopoiIn (J (op m)).toGrothendieck (J (op n)).toGrothendieck :=
  (F.map φ.op).toFunctor.morphismOfTopoiInOfCocontinuous
    (J (op n)).toGrothendieck (J (op m)).toGrothendieck

/-- Inverse images of `f_φ` compose as `Sh(C_l) ⥤ Sh(C_m) ⥤ Sh(C_n)`,
canonically isomorphic to the inverse image of `f_{ψ ≫ φ}` by left-adjoint uniqueness
along cocontinuous pushforward composition. -/
noncomputable def toposMap_inverseImage_comp {l m n : SimplexCategory} (ψ : l ⟶ m) (φ : m ⟶ n) :
    (toposMap F J ψ).inverseImage ⋙ (toposMap F J φ).inverseImage ≅
      (toposMap F J (ψ ≫ φ)).inverseImage :=
  Adjunction.leftAdjointUniq
    ((Adjunction.comp
        ((F.map ψ.op).toFunctor.sheafPullbackCocontinuousAdjunction
          (J (op m)).toGrothendieck (J (op l)).toGrothendieck)
        ((F.map φ.op).toFunctor.sheafPullbackCocontinuousAdjunction
          (J (op n)).toGrothendieck (J (op m)).toGrothendieck)).ofNatIsoRight
      (Functor.sheafPushforwardCocontinuousComp'
        (J (op n)).toGrothendieck (J (op m)).toGrothendieck (J (op l)).toGrothendieck
        (F.map φ.op).toFunctor (F.map ψ.op).toFunctor (map_comp_toFunctor F ψ φ)))
    ((F.map (ψ ≫ φ).op).toFunctor.sheafPullbackCocontinuousAdjunction
      (J (op n)).toGrothendieck (J (op l)).toGrothendieck)

/-- Direct images of `f_φ` compose as `Sh(C_n) ⥤ Sh(C_m) ⥤ Sh(C_l)`,
canonically isomorphic to the direct image of `f_{ψ ≫ φ}` by cocontinuous pushforward
composition. -/
noncomputable def toposMap_pushforward_comp {l m n : SimplexCategory} (ψ : l ⟶ m) (φ : m ⟶ n) :
    (toposMap F J φ).pushforward ⋙ (toposMap F J ψ).pushforward ≅
      (toposMap F J (ψ ≫ φ)).pushforward :=
  Functor.sheafPushforwardCocontinuousComp'
    (J (op n)).toGrothendieck (J (op m)).toGrothendieck (J (op l)).toGrothendieck
    (F.map φ.op).toFunctor (F.map ψ.op).toFunctor (map_comp_toFunctor F ψ φ)

end

end CategoryTheory.Grothendieck
