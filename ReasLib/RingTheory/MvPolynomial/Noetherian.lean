module

public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Noetherian.Defs
import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.Tactic.CrossRefAttribute

/-!
# Noetherian multivariate polynomial rings

For a nontrivial coefficient ring, the ideal generated by all variables detects whether the
variable type is finite. This gives the expected Noetherianity obstruction for infinitely many
variables and a complete criterion over a commutative ring.

@stack 01BX
-/

@[expose] public section

universe u v

namespace MvPolynomial

/-- Over a nontrivial semiring, the ideal generated by all variables is finitely generated
exactly when the variable type is finite. -/
@[stacks 01BX "finite generation of the variable ideal"]
theorem idealOfVars_fg_iff_finite
    {σ : Type u} {R : Type v} [CommSemiring R] [Nontrivial R] :
    (idealOfVars σ R).FG ↔ Finite σ := sorry

/-- A polynomial semiring in infinitely many variables over a nontrivial coefficient semiring is
not Noetherian. -/
@[stacks 01BX "infinitely many variables are not Noetherian"]
theorem not_isNoetherianRing_of_infinite
    {σ : Type u} {R : Type v} [CommSemiring R] [Nontrivial R] [Infinite σ] :
    ¬ IsNoetherianRing (MvPolynomial σ R) := sorry

/-- Over a nontrivial commutative ring, a multivariate polynomial ring is Noetherian exactly when
the coefficient ring is Noetherian and the variable type is finite. -/
@[stacks 01BX "Noetherianity criterion"]
theorem isNoetherianRing_iff
    {σ : Type u} {R : Type v} [CommRing R] [Nontrivial R] :
    IsNoetherianRing (MvPolynomial σ R) ↔ IsNoetherianRing R ∧ Finite σ := sorry

end MvPolynomial
