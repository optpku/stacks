/-!
# Minimal primes of a strict henselian tensor neighbourhood

This leaf owns the reusable interface for the closed-point neighbourhood of
`A ⊗[k] B`.  The closed-point ideal and the two structural maps are concrete
data; the minimal-prime comparison is exposed as a proposition-valued theorem.
The chapter entry only recalls the final bijection.

@stack 06DU
-/

@[expose] public section

open scoped TensorProduct
open IsLocalRing

universe u v w x

namespace IsStrictHenselizationOf.TensorProduct

variable {k : Type u} {A : Type v} {B : Type w} {C : Type x}
variable [Field k]
variable [CommRing A] [CommRing B]
variable [Algebra k A] [Algebra k B]

section Local

variable [IsLocalRing A] [IsLocalRing B]

/- The closed-point ideal itself does not need residue-field identifications. -/
/--
The ideal generated by the two closed points in `A ⊗[k] B`.
-/
@[stacks 06DU "closed-point ideal in a tensor product"]
def closedPointIdeal : Ideal (A ⊗[k] B) :=
  Ideal.map (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom
      (IsLocalRing.maximalIdeal A) ⊔
    Ideal.map (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom
      (IsLocalRing.maximalIdeal B)

/-- The residue map of a local `k`-algebra, transported to the chosen residue-field model `k`. -/
@[stacks 06DU "residue map to the common field"]
noncomputable def residueAlgHom
    (hκ : ResidueField A ≃ₐ[k] k) : A →ₐ[k] k :=
  hκ.toAlgHom.comp (IsScalarTower.toAlgHom k A (ResidueField A))

/--
The closed-point ideal is prime when both residue fields are identified
with the common base field.
-/
@[stacks 06DU "closed-point ideal is prime"]
theorem closedPointIdeal_isPrime
    (hκA : ResidueField A ≃ₐ[k] k)
    (hκB : ResidueField B ≃ₐ[k] k) :
    (closedPointIdeal (k := k) (A := A) (B := B)).IsPrime := sorry
-- Proof strategy: identify `closedPointIdeal` with the ideal of
-- `Algebra.TensorProduct.LocalTarget.tensorPrime` using the two residue maps, then use the
-- prime-spectrum proof carried by that point.

/--
The prime of `A ⊗[k] B` cut out by the two closed points.
-/
@[stacks 06DU "closed point of the tensor product"]
noncomputable def closedPoint
    (hκA : ResidueField A ≃ₐ[k] k)
    (hκB : ResidueField B ≃ₐ[k] k) :
    PrimeSpectrum (A ⊗[k] B) :=
  Algebra.TensorProduct.LocalTarget.tensorPrime
    (residueAlgHom (A := A) hκA) (residueAlgHom (A := B) hκB)

/-- The local-target construction and the ideal presentation describe the same closed point. -/
@[simp, stacks 06DU "closed point ideal presentation"]
theorem closedPoint_asIdeal_eq
    (hκA : ResidueField A ≃ₐ[k] k)
    (hκB : ResidueField B ≃ₐ[k] k) :
    (closedPoint hκA hκB).asIdeal = closedPointIdeal (k := k) (A := A) (B := B) := sorry
-- Proof strategy: expand `closedPoint`, rewrite with
-- `Algebra.TensorProduct.LocalTarget.tensorPrime_asIdeal`, and compute the two residue-map
-- kernels as the maximal ideals of `A` and `B`.

/--
The canonical local ring obtained by localizing the tensor product at its
closed point.
-/
@[stacks 06DU "closed-point tensor localization"]
noncomputable abbrev localization
    (hκA : ResidueField A ≃ₐ[k] k)
    (hκB : ResidueField B ≃ₐ[k] k) : Type (max v w) :=
  Localization.AtPrime (closedPoint hκA hκB).asIdeal

end Local

section Comparison

variable [StrictHenselianLocalRing A] [StrictHenselianLocalRing B]
variable (hκA : ResidueField A ≃ₐ[k] k)
variable (hκB : ResidueField B ≃ₐ[k] k)
variable [CommRing C]
variable [Algebra (localization hκA hκB) C]
variable [IsStrictHenselizationOf (localization hκA hκB) C]

/--
The canonical map from the tensor product into a chosen strict henselization
of the closed-point localization.
-/
@[stacks 06DU "tensor structural map"]
noncomputable def tensorMap : A ⊗[k] B →+* C :=
  Localization.AtPrime.LocalTarget.sourceMapRingHom
    (q := (closedPoint hκA hκB).asIdeal)

/--
The structural map from the left tensor factor into a chosen strict
henselization of the closed-point localization.
-/
@[stacks 06DU "left structural map"]
noncomputable def leftMap : A →+* C :=
  (tensorMap hκA hκB).comp
    (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom

/--
The structural map from the right tensor factor into a chosen strict
henselization of the closed-point localization.
-/
@[stacks 06DU "right structural map"]
noncomputable def rightMap : B →+* C :=
  (tensorMap hκA hκB).comp
    (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom

/--
The left structural map sends a minimal prime of `C` to a minimal prime
of `A`.
-/
@[stacks 06DU "left minimal-prime contraction"]
theorem left_mem_minimalPrimes (r : minimalPrimes C) :
    Ideal.comap (leftMap hκA hκB) r.1 ∈ minimalPrimes A := sorry
-- Proof strategy: prove the left structural map is flat by composing tensor extension,
-- localization, and strict-henselization flatness, then apply
-- `RingHom.Flat.comap_mem_minimalPrimes`.

/--
The right structural map sends a minimal prime of `C` to a minimal prime
of `B`.
-/
@[stacks 06DU "right minimal-prime contraction"]
theorem right_mem_minimalPrimes (r : minimalPrimes C) :
    Ideal.comap (rightMap hκA hκB) r.1 ∈ minimalPrimes B := sorry
-- Proof strategy: use the symmetric flatness argument for the right tensor factor and apply
-- `RingHom.Flat.comap_mem_minimalPrimes`.

/--
A minimal prime of the chosen strict henselization contracts to a pair of
minimal primes in the two tensor factors.
-/
@[stacks 06DU "minimal-prime contraction pair"]
noncomputable def minimalPrimePair
    (r : minimalPrimes C) : minimalPrimes A × minimalPrimes B :=
  (⟨Ideal.comap (leftMap hκA hκB) r.1,
      left_mem_minimalPrimes hκA hκB r⟩,
    ⟨Ideal.comap (rightMap hκA hκB) r.1,
      right_mem_minimalPrimes hκA hκB r⟩)

/--
The ideal of the strict henselization attached to a pair of minimal
primes.  It is the supremum of the two extended ideals.
-/
@[stacks 06DU "pair ideal of minimal primes"]
noncomputable def pairIdeal
    (p : minimalPrimes A) (q : minimalPrimes B) : Ideal C :=
  Ideal.map (leftMap hκA hκB) p.1 ⊔ Ideal.map (rightMap hκA hκB) q.1

end Comparison

section API

variable [StrictHenselianLocalRing A] [StrictHenselianLocalRing B]
variable (hκA : ResidueField A ≃ₐ[k] k)
variable (hκB : ResidueField B ≃ₐ[k] k)
variable [CommRing C]
variable [Algebra (localization hκA hκB) C]
variable [IsStrictHenselizationOf (localization hκA hκB) C]

/-- The pair ideal is below a minimal prime exactly when its contraction pair is `(p, q)`. -/
@[stacks 06DU "pair ideal containment"]
theorem pairIdeal_le_iff_pair_eq
    {r : minimalPrimes C} {p : minimalPrimes A} {q : minimalPrimes B}
    : pairIdeal hκA hκB p q ≤ r.1 ↔
        minimalPrimePair hκA hκB r = (p, q) := sorry
-- Proof strategy: split the supremum inequality, rewrite each mapped-ideal inequality with
-- `Ideal.map_le_iff_le_comap`, and use minimality to turn inclusions between minimal primes
-- into equalities; the converse follows from the two contraction equalities.

/-- For every pair of minimal primes, exactly one minimal prime of `C` lies over the pair ideal. -/
@[stacks 06DU "unique minimal prime over a pair"]
theorem existsUnique_minimalPrime_over_pair
    (p : minimalPrimes A) (q : minimalPrimes B) :
    ∃! r : minimalPrimes C, pairIdeal hκA hκB p q ≤ r.1 := sorry
-- Proof strategy: pass to the tensor product of the two domain quotients, use
-- `PrimeSpectrum.unique_minimalPrime_tensorProduct`, and transport the unique minimal prime
-- through the closed-point localization and strict henselization.

/-- Lemma 15.108.4: contraction along the two structural maps gives a bijection between minimal
primes of `C` and pairs of minimal primes of `A` and `B`. -/
@[stacks 06DU "Lemma 15.108.4"]
theorem bijective_minimalPrimes :
    Function.Bijective
      (fun r : minimalPrimes C ↦ minimalPrimePair hκA hκB r) := sorry
-- Proof strategy: use `existsUnique_minimalPrime_over_pair` for every target pair and
-- `pairIdeal_le_iff_pair_eq` to identify its unique witness with the corresponding fiber.

end API

end IsStrictHenselizationOf.TensorProduct
