module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Algebra.MvPolynomial.Rename
public import Mathlib.RingTheory.Ideal.MinimalPrime.Basic
public import Mathlib.RingTheory.KrullDimension.Basic
public import Mathlib.RingTheory.Spectrum.Prime.Topology
public import Mathlib.Topology.KrullDimension
public import Mathlib.Tactic.FinCases
public import ReasLib.RingTheory.Ideal.Quotient.PrimeSpectrum
public import ReasLib.RingTheory.KrullDimension.Polynomial

@[expose] public section

universe u

noncomputable section

open MvPolynomial PrimeSpectrum

namespace MvPolynomial.StarIdeal

/-- The ideal generated by the three products of `X 0` with `X 1`, `X 2`, and `X 3`. -/
def relationIdeal (k : Type u) [CommRing k] : Ideal (MvPolynomial (Fin 4) k) :=
  Ideal.span {MvPolynomial.X (0 : Fin 4) * MvPolynomial.X 1,
    MvPolynomial.X 0 * MvPolynomial.X 2, MvPolynomial.X 0 * MvPolynomial.X 3}

/-- The principal ideal generated by `X 0`. -/
def hyperplanePrime (k : Type u) [CommRing k] : Ideal (MvPolynomial (Fin 4) k) :=
  Ideal.span {MvPolynomial.X (0 : Fin 4)}

/-- The ideal generated by `X 1`, `X 2`, and `X 3`. -/
def axisPrime (k : Type u) [CommRing k] : Ideal (MvPolynomial (Fin 4) k) :=
  Ideal.span {MvPolynomial.X (1 : Fin 4), MvPolynomial.X 2, MvPolynomial.X 3}

/-- Set `X 0` to zero, with inverse induced by renaming along `Fin.succ`. -/
private def hyperplaneQuotientEquiv (k : Type u) [CommRing k] :
    (MvPolynomial (Fin 4) k ⧸ hyperplanePrime k) ≃+* MvPolynomial (Fin 3) k := by
  let f : MvPolynomial (Fin 4) k →+* MvPolynomial (Fin 3) k :=
    eval₂Hom C (Fin.cases 0 X)
  have hf : hyperplanePrime k ≤ RingHom.ker f := by
    simp [hyperplanePrime, Ideal.span_le, RingHom.mem_ker, f]
  let g := Ideal.Quotient.lift (hyperplanePrime k) f (fun p hp ↦ hf hp)
  let h := (Ideal.Quotient.mk (hyperplanePrime k)).comp (rename Fin.succ).toRingHom
  refine RingEquiv.ofRingHom g h ?_ ?_
  · apply MvPolynomial.ringHom_ext
    · intro r
      simp [g, h, f]
    · intro i
      simp [g, h, f]
  · apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      simp [g, h, f]
    · intro i
      refine Fin.cases ?_ (fun j ↦ ?_) i
      · have hx : Ideal.Quotient.mk (hyperplanePrime k) (X 0) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
        simp [g, h, f, hx]
      · simp [g, h, f]

/-- Set the last three variables to zero, with inverse sending the remaining variable to `X 0`. -/
private def axisQuotientEquiv (k : Type u) [CommRing k] :
    (MvPolynomial (Fin 4) k ⧸ axisPrime k) ≃+* MvPolynomial (Fin 1) k := by
  let f : MvPolynomial (Fin 4) k →+* MvPolynomial (Fin 1) k :=
    eval₂Hom C (Fin.cases (X 0) (fun _ ↦ 0))
  have hf : axisPrime k ≤ RingHom.ker f := by
    simp [axisPrime, Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff,
      RingHom.mem_ker, f]
    exact ⟨rfl, rfl, rfl⟩
  let g := Ideal.Quotient.lift (axisPrime k) f (fun p hp ↦ hf hp)
  let h := (Ideal.Quotient.mk (axisPrime k)).comp
    (rename (fun _ : Fin 1 ↦ (0 : Fin 4))).toRingHom
  refine RingEquiv.ofRingHom g h ?_ ?_
  · apply MvPolynomial.ringHom_ext
    · intro r
      simp [g, h, f]
    · intro i
      have hi : i = 0 := Subsingleton.elim _ _
      simp [g, h, f, hi]
  · apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      simp [g, h, f]
    · intro i
      refine Fin.cases ?_ (fun j ↦ ?_) i
      · simp [g, h, f]
      · have hx : Ideal.Quotient.mk (axisPrime k) (X j.succ) = 0 := by
          apply Ideal.Quotient.eq_zero_iff_mem.mpr
          apply Ideal.subset_span
          fin_cases j <;> simp
        simp [g, h, f, hx]

/-- The principal ideal generated by `X 0` is prime over a field. -/
instance hyperplanePrime.instIsPrime (k : Type u) [Field k] :
    (hyperplanePrime k).IsPrime := by
  apply (Ideal.Quotient.isDomain_iff_prime _).mp
  exact (hyperplaneQuotientEquiv k).toMulEquiv.isDomain _

/-- The ideal generated by `X 1`, `X 2`, and `X 3` is prime over a field. -/
instance axisPrime.instIsPrime (k : Type u) [Field k] : (axisPrime k).IsPrime := by
  apply (Ideal.Quotient.isDomain_iff_prime _).mp
  exact (axisQuotientEquiv k).toMulEquiv.isDomain _

private theorem X_zero_not_mem_axisPrime (k : Type u) [Field k] :
    (X (0 : Fin 4) : MvPolynomial (Fin 4) k) ∉ axisPrime k := by
  let f : MvPolynomial (Fin 4) k →+* k :=
    eval₂Hom (RingHom.id k) (Fin.cases 1 (fun _ ↦ 0))
  have hf : axisPrime k ≤ RingHom.ker f := by
    simp [axisPrime, Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff,
      RingHom.mem_ker, f]
    exact ⟨rfl, rfl, rfl⟩
  intro hx
  have := hf hx
  simpa [RingHom.mem_ker, f] using this

private theorem hyperplanePrime_not_le_axisPrime (k : Type u) [Field k] :
    ¬ hyperplanePrime k ≤ axisPrime k := by
  intro h
  exact X_zero_not_mem_axisPrime k (h (Ideal.subset_span (by simp)))

private theorem axisPrime_not_le_hyperplanePrime (k : Type u) [Field k] :
    ¬ axisPrime k ≤ hyperplanePrime k := by
  let f : MvPolynomial (Fin 4) k →+* k :=
    eval₂Hom (RingHom.id k) (fun i ↦ if i = 1 then 1 else 0)
  have hf : hyperplanePrime k ≤ RingHom.ker f := by
    simp [hyperplanePrime, Ideal.span_le, RingHom.mem_ker, f]
  intro h
  have hx : (X (1 : Fin 4) : MvPolynomial (Fin 4) k) ∈ axisPrime k :=
    Ideal.subset_span (by simp)
  have := hf (h hx)
  simpa [RingHom.mem_ker, f] using this

/-- The relation ideal factors as the product of the hyperplane and axis ideals. -/
theorem relationIdeal_eq_mul (k : Type u) [CommRing k] :
    relationIdeal k = hyperplanePrime k * axisPrime k := by
  simp only [relationIdeal, hyperplanePrime, axisPrime, Ideal.span_insert,
    Ideal.mul_sup, Ideal.span_singleton_mul_span_singleton]

/-- Over a field, the relation ideal is the intersection of the two prime component ideals. -/
theorem relationIdeal_eq_inf (k : Type u) [Field k] :
    relationIdeal k = hyperplanePrime k ⊓ axisPrime k := by
  rw [relationIdeal_eq_mul]
  refine le_antisymm Ideal.mul_le_inf ?_
  intro p hp
  obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hp.1
  exact Ideal.mul_mem_mul (Ideal.subset_span (by simp))
    (((inferInstance : (axisPrime k).IsPrime).mem_or_mem hp.2).resolve_left
      (X_zero_not_mem_axisPrime k))

/-- The minimal primes of the relation ideal are exactly the hyperplane and axis ideals. -/
theorem relationIdeal_minimalPrimes (k : Type u) [Field k] :
    (relationIdeal k).minimalPrimes = {hyperplanePrime k, axisPrime k} := by
  have hH : relationIdeal k ≤ hyperplanePrime k := by
    rw [relationIdeal_eq_mul]
    exact Ideal.mul_le_right
  have hA : relationIdeal k ≤ axisPrime k := by
    rw [relationIdeal_eq_mul]
    exact Ideal.mul_le_left
  ext p
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · intro hp
    have hprod : hyperplanePrime k * axisPrime k ≤ p :=
      (relationIdeal_eq_mul k) ▸ hp.le
    rcases hp.isPrime.mul_le.mp hprod with hHp | hAp
    · exact Or.inl (le_antisymm (hp.2 ⟨inferInstance, hH⟩ hHp) hHp)
    · exact Or.inr (le_antisymm (hp.2 ⟨inferInstance, hA⟩ hAp) hAp)
  · rintro (rfl | rfl)
    · refine ⟨⟨inferInstance, hH⟩, ?_⟩
      intro q hq hqH
      have hprod : hyperplanePrime k * axisPrime k ≤ q :=
        (relationIdeal_eq_mul k) ▸ hq.2
      rcases hq.1.mul_le.mp hprod with hHq | hAq
      · exact hHq
      · exact (axisPrime_not_le_hyperplanePrime k (hAq.trans hqH)).elim
    · refine ⟨⟨inferInstance, hA⟩, ?_⟩
      intro q hq hqA
      have hprod : hyperplanePrime k * axisPrime k ≤ q :=
        (relationIdeal_eq_mul k) ▸ hq.2
      rcases hq.1.mul_le.mp hprod with hHq | hAq
      · exact (hyperplanePrime_not_le_axisPrime k (hHq.trans hqA)).elim
      · exact hAq

/-- The hyperplane ideal is a minimal prime of the relation ideal. -/
theorem hyperplanePrime_mem_minimalPrimes (k : Type u) [Field k] :
    hyperplanePrime k ∈ (relationIdeal k).minimalPrimes := by
  rw [relationIdeal_minimalPrimes]
  exact Set.mem_insert _ _

/-- The axis ideal is a minimal prime of the relation ideal. -/
theorem axisPrime_mem_minimalPrimes (k : Type u) [Field k] :
    axisPrime k ∈ (relationIdeal k).minimalPrimes := by
  rw [relationIdeal_minimalPrimes]
  simp

/-- The zero locus of the relation ideal is the union of the two component zero loci. -/
theorem relationIdeal_zeroLocus_eq_union (k : Type u) [Field k] :
    zeroLocus (relationIdeal k : Set (MvPolynomial (Fin 4) k)) =
      zeroLocus (hyperplanePrime k : Set (MvPolynomial (Fin 4) k)) ∪
        zeroLocus (axisPrime k : Set (MvPolynomial (Fin 4) k)) := by
  rw [relationIdeal_eq_mul, zeroLocus_mul]

/-- The quotient by the hyperplane ideal has Krull dimension `3`. -/
theorem ringKrullDim_quotient_hyperplanePrime (k : Type u) [Field k] :
    ringKrullDim (MvPolynomial (Fin 4) k ⧸ hyperplanePrime k) = 3 := by
  rw [ringKrullDim_eq_of_ringEquiv (hyperplaneQuotientEquiv k),
    MvPolynomial.ringKrullDim_of_isNoetherianRing]
  simp [Nat.card_eq_fintype_card]

/-- The quotient by the axis ideal has Krull dimension `1`. -/
theorem ringKrullDim_quotient_axisPrime (k : Type u) [Field k] :
    ringKrullDim (MvPolynomial (Fin 4) k ⧸ axisPrime k) = 1 := by
  rw [ringKrullDim_eq_of_ringEquiv (axisQuotientEquiv k),
    MvPolynomial.ringKrullDim_of_isNoetherianRing]
  simp [Nat.card_eq_fintype_card]

/-- The irreducible components of the relation ideal's zero locus are the hyperplane and axis zero loci. -/
theorem relationIdeal_irreducibleComponents (k : Type u) [Field k] :
    {Z : Set (PrimeSpectrum (MvPolynomial (Fin 4) k)) |
        Maximal (fun W ↦ W ⊆ zeroLocus (relationIdeal k : Set (MvPolynomial (Fin 4) k)) ∧
          IsClosed W ∧ IsIrreducible W) Z} =
      {zeroLocus (hyperplanePrime k : Set (MvPolynomial (Fin 4) k)),
        zeroLocus (axisPrime k : Set (MvPolynomial (Fin 4) k))} := by
  rw [relationIdeal_zeroLocus_eq_union]
  have hH : IsIrreducible (zeroLocus (hyperplanePrime k : Set (MvPolynomial (Fin 4) k))) :=
    (isIrreducible_zeroLocus_iff_of_radical _
      (inferInstance : (hyperplanePrime k).IsPrime).isRadical).mpr inferInstance
  have hA : IsIrreducible (zeroLocus (axisPrime k : Set (MvPolynomial (Fin 4) k))) :=
    (isIrreducible_zeroLocus_iff_of_radical _
      (inferInstance : (axisPrime k).IsPrime).isRadical).mpr inferInstance
  have hHA : ¬ zeroLocus (hyperplanePrime k : Set (MvPolynomial (Fin 4) k)) ⊆
      zeroLocus (axisPrime k : Set (MvPolynomial (Fin 4) k)) := by
    rw [zeroLocus_subset_zeroLocus_iff,
      (inferInstance : (hyperplanePrime k).IsPrime).radical]
    exact axisPrime_not_le_hyperplanePrime k
  have hAH : ¬ zeroLocus (axisPrime k : Set (MvPolynomial (Fin 4) k)) ⊆
      zeroLocus (hyperplanePrime k : Set (MvPolynomial (Fin 4) k)) := by
    rw [zeroLocus_subset_zeroLocus_iff,
      (inferInstance : (axisPrime k).IsPrime).radical]
    exact hyperplanePrime_not_le_axisPrime k
  have hmax {A B : Set (PrimeSpectrum (MvPolynomial (Fin 4) k))}
      (hAc : IsClosed A) (hBc : IsClosed B) (hAi : IsIrreducible A) (hAB : ¬ A ⊆ B) :
      Maximal (fun W ↦ W ⊆ A ∪ B ∧ IsClosed W ∧ IsIrreducible W) A := by
    refine ⟨⟨Set.subset_union_left, hAc, hAi⟩, ?_⟩
    intro W hW hAW
    rcases isPreirreducible_iff_isClosed_union_isClosed.mp hW.2.2.2 A B hAc hBc hW.1
      with hWA | hWB
    · exact hWA
    · exact (hAB (hAW.trans hWB)).elim
  ext Z
  simp only [Set.mem_setOf_eq, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · intro hZ
    rcases isPreirreducible_iff_isClosed_union_isClosed.mp hZ.1.2.2.2 _ _
      (isClosed_zeroLocus _) (isClosed_zeroLocus _) hZ.1.1 with hZH | hZA
    · exact Or.inl (hZ.eq_of_le ⟨Set.subset_union_left, isClosed_zeroLocus _, hH⟩ hZH)
    · exact Or.inr (hZ.eq_of_le ⟨Set.subset_union_right, isClosed_zeroLocus _, hA⟩ hZA)
  · rintro (rfl | rfl)
    · exact hmax (isClosed_zeroLocus _) (isClosed_zeroLocus _) hH hHA
    · simpa only [Set.union_comm] using
        hmax (isClosed_zeroLocus _) (isClosed_zeroLocus _) hA hAH

/-- The hyperplane component has topological Krull dimension `3`. -/
theorem topologicalKrullDim_zeroLocus_hyperplanePrime (k : Type u) [Field k] :
    topologicalKrullDim (zeroLocus (hyperplanePrime k : Set (MvPolynomial (Fin 4) k))) = 3 :=
  (Ideal.topologicalKrullDim_zeroLocus_eq_ringKrullDim_quotient _).trans
    (ringKrullDim_quotient_hyperplanePrime k)

/-- The axis component has topological Krull dimension `1`. -/
theorem topologicalKrullDim_zeroLocus_axisPrime (k : Type u) [Field k] :
    topologicalKrullDim (zeroLocus (axisPrime k : Set (MvPolynomial (Fin 4) k))) = 1 :=
  (Ideal.topologicalKrullDim_zeroLocus_eq_ringKrullDim_quotient _).trans
    (ringKrullDim_quotient_axisPrime k)

end MvPolynomial.StarIdeal
