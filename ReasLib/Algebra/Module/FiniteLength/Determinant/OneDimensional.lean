module

public import ReasLib.Algebra.Module.FiniteLength.Determinant.ExteriorPower

/-!
# One-dimensional finite-length determinants

The determinant-symbol quotient of a finite-length module over a commutative local ring is
one-dimensional over the residue field and is generated by each spanning admissible symbol.
-/

@[expose] public section

noncomputable section

universe u v

namespace Module.FiniteLengthDeterminant

variable (R : Type u) (M : Type v) [CommRing R] [IsLocalRing R]
variable [AddCommGroup M] [Module R M]

/-- The determinant space of a finite-length module over a local ring has dimension one over
the residue field. -/
theorem finrank_eq_one_of_isFiniteLength (hM : IsFiniteLength R M) :
    Module.finrank (IsLocalRing.ResidueField R)
      (Module.FiniteLengthDeterminant R M hM) = 1 := sorry

/-- Every admissible symbol whose entries span a finite-length module generates its determinant
space over the residue field. -/
theorem span_symbol_eq_top (hM : IsFiniteLength R M) (e : Symbol R M hM)
    (hspan : Submodule.span R (Set.range e.1) = ⊤) :
    Submodule.span (IsLocalRing.ResidueField R) {symbol R M hM e} = ⊤ := sorry

end Module.FiniteLengthDeterminant
