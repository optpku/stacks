module

public import ReasLib.RingTheory.DividedPowers.Envelope.Quotient
import StacksCheckRecall

@[expose] public section

universe u

open DividedPowers

/- Lemma 60.2.3: a divided-power envelope over a surjective `A`-algebra map is the quotient of
the envelope over the source by the ideal generated by positive divided powers of kernel elements. -/
@[stacks 07HB] #check
  (DividedPowerEnvelope.quotientOfSurjective :
    ∀ {A B' B : Type u} [CommRing A] [CommRing B'] [CommRing B]
      [Algebra A B'] [Algebra A B]
      (I : Ideal A) (γ : DividedPowers I)
      (φ : B' →ₐ[A] B) (hφ : Function.Surjective φ)
      (J : Ideal B) (hIJ : Ideal.map (algebraMap A B) I ≤ J)
      (K : Ideal B') (hK : K = RingHom.ker φ.toRingHom)
      (J' : Ideal B') (hJ' : J' = Ideal.comap φ.toRingHom J)
      (hIJ' : Ideal.map (algebraMap A B') I ≤ J')
      (E' : DividedPowerEnvelope I γ (algebraMap A B') J' hIJ')
      (hE' : DividedPowerEnvelope.IsUniversal γ (algebraMap A B') hIJ' E')
      (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ)
      (hE : DividedPowerEnvelope.IsUniversal γ (algebraMap A B) hIJ E),
      ∃ hsub : IsSubDPIdeal E'.D.dividedPowers
          (DividedPowerEnvelope.kernelIdeal hIJ' E' K ⊓ E'.D.ideal),
        Nonempty (E.D ≅
          DividedPowerRing.of (E'.D ⧸ DividedPowerEnvelope.kernelIdeal hIJ' E' K)
            (Ideal.map
              (Ideal.Quotient.mk (DividedPowerEnvelope.kernelIdeal hIJ' E' K)) E'.D.ideal)
            (DividedPowers.Quotient.dividedPowers E'.D.dividedPowers hsub)))
