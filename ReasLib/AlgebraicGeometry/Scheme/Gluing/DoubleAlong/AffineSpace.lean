module

public import ReasLib.AlgebraicGeometry.Scheme.Gluing.DoubleAlong.PuncturedAffineSpace
public import Mathlib.Topology.Sets.Closeds
import Mathlib.Tactic.CrossRefAttribute

/-!
# Finite-dimensional affine space with doubled origin

The finite-dimensional scheme layer uses the canonical same-universe relative affine-space owner;
the finite index is lifted to the base-ring universe at this specialization boundary.
The index-polymorphic construction remains available through `PuncturedAffineSpace` itself.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.DoubledOrigin

section CommRing

variable (k : Type u) [CommRing k] (n : ℕ)

/-- The coordinate ring of affine `n`-space. -/
@[stacks 01JD "doubled-origin coordinate ring"]
abbrev coordinateRing : Type u :=
  PuncturedAffineSpace.coordinateRing (ULift.{u} (Fin n)) k

/-- Affine `n`-space over `k`. -/
@[stacks 01JD "doubled-origin affine space"]
abbrev affineSpace : Scheme.{u} :=
  PuncturedAffineSpace.affineSpace (ULift.{u} (Fin n)) k

/-- The `i`-th polynomial coordinate on affine `n`-space. -/
@[stacks 01JD "doubled-origin coordinate"]
abbrev coordinate (i : Fin n) : coordinateRing k n :=
  PuncturedAffineSpace.coordinate (ULift.{u} (Fin n)) k (ULift.up i)

/-- Evaluation of polynomial coordinates at the zero section as a `k`-algebra homomorphism. -/
@[stacks 01JD "doubled-origin origin algebra map"]
abbrev evalAtOriginAlgHom : coordinateRing k n →ₐ[k] k :=
  PuncturedAffineSpace.evalAtOriginAlgHom (ULift.{u} (Fin n)) k

/-- The ring-hom view of evaluation at the zero section. -/
@[stacks 01JD "doubled-origin origin evaluation"]
abbrev evalAtOrigin : coordinateRing k n →+* k :=
  (evalAtOriginAlgHom k n).toRingHom

/-- The ideal generated by the coordinates, defining the zero section. -/
@[stacks 01JD "doubled-origin origin ideal"]
abbrev originIdeal : Ideal (coordinateRing k n) :=
  PuncturedAffineSpace.originIdeal (ULift.{u} (Fin n)) k

/-- The zero-section ideal is generated by the coordinate functions. -/
@[stacks 01JD "doubled-origin ideal generators"]
theorem originIdeal_eq_span :
    originIdeal k n = Ideal.span (Set.range (coordinate k n)) := sorry

/-- The punctured open complement of the zero section. -/
@[stacks 01JD "punctured affine open"]
abbrev puncturedOpen : (affineSpace k n).Opens :=
  PuncturedAffineSpace.puncturedOpen (ULift.{u} (Fin n)) k

/-- Affine `n`-space with its origin doubled. -/
@[stacks 01JD "affine space with doubled origin"]
noncomputable abbrev scheme : Scheme.{u} :=
  PuncturedAffineSpace.DoubleAlong.scheme (ULift.{u} (Fin n)) k

/-- The open immersion of the `i`-th affine-space copy into the doubled-origin scheme. -/
@[stacks 01JD "doubled-origin chart map"]
noncomputable abbrev chartMap (i : Fin 2) : affineSpace k n ⟶ scheme k n :=
  PuncturedAffineSpace.DoubleAlong.chartMap (ULift.{u} (Fin n)) k i

/-- One of the two canonical affine charts. -/
@[stacks 01JD "doubled-origin affine chart"]
abbrev chart (i : Fin 2) : (scheme k n).Opens :=
  PuncturedAffineSpace.DoubleAlong.chart (ULift.{u} (Fin n)) k i

/-- The canonical identification of a doubled-origin chart with affine `n`-space. -/
@[stacks 01JD "doubled-origin chart isomorphism"]
noncomputable abbrev chartIso (i : Fin 2) :
    (chart k n i).toScheme ≅ affineSpace k n :=
  PuncturedAffineSpace.DoubleAlong.chartIso (ULift.{u} (Fin n)) k i

/-- The two canonical charts cover the doubled-origin scheme. -/
@[stacks 01JD "doubled-origin chart cover"]
theorem chart_cover : chart k n 0 ⊔ chart k n 1 = ⊤ := sorry

/-- Every canonical chart is affine. -/
@[stacks 01JD "doubled-origin affine charts"]
theorem chart_isAffineOpen (i : Fin 2) : IsAffineOpen (chart k n i) := sorry

/-- The punctured affine space mapped into the doubled-origin scheme through the first chart. -/
@[stacks 01JD "doubled-origin overlap map"]
noncomputable abbrev overlapMap : (puncturedOpen k n).toScheme ⟶ scheme k n :=
  PuncturedAffineSpace.DoubleAlong.overlapMap (ULift.{u} (Fin n)) k

/-- The punctured affine space has image equal to the intersection of the two canonical charts. -/
@[simp, stacks 01JD "doubled-origin overlap range"]
theorem overlapMap_opensRange :
    (overlapMap k n).opensRange = chart k n 0 ⊓ chart k n 1 := sorry

/-- The canonical fold from affine space with doubled origin to affine space. -/
@[stacks 01JD "fold morphism"]
noncomputable abbrev fold : scheme k n ⟶ affineSpace k n :=
  PuncturedAffineSpace.DoubleAlong.fold (ULift.{u} (Fin n)) k

/-- The restriction of the fold from a canonical chart to ordinary affine `n`-space. -/
@[stacks 01JD "doubled-origin chart comparison"]
noncomputable abbrev chartComparison (i : Fin 2) :
    (chart k n i).toScheme ⟶ affineSpace k n :=
  (chartIso k n i).hom

/-- The fold restricts to the identity on each affine-space chart. -/
@[reassoc (attr := simp), stacks 01JD "fold on doubled-origin charts"]
theorem chartMap_fold (i : Fin 2) : chartMap k n i ≫ fold k n = 𝟙 _ := sorry

/-- The structure morphism of affine space with doubled origin. -/
@[stacks 01JD "doubled-origin structure morphism"]
noncomputable abbrev toBase : scheme k n ⟶ Spec (CommRingCat.of k) :=
  PuncturedAffineSpace.DoubleAlong.toBase (ULift.{u} (Fin n)) k

/-- The canonical map from the polynomial coordinate ring to global sections of affine space
with doubled origin. -/
@[stacks 01JD "doubled-origin global-sections comparison"]
  noncomputable abbrev globalSectionsComparison :
    CommRingCat.of (coordinateRing k n) ⟶
      Scheme.Γ.obj (Opposite.op (scheme k n)) :=
  PuncturedAffineSpace.DoubleAlong.globalSectionsComparison (ULift.{u} (Fin n)) k

namespace globalSectionsComparison

/-- In positive dimension, the fold identifies the coordinate ring with global sections of
affine space with doubled origin. -/
@[stacks 01JD "global sections of affine space with doubled origin"]
theorem isIso (hn : 1 ≤ n) :
    IsIso (globalSectionsComparison k n) := sorry

end globalSectionsComparison

end CommRing

section Field

variable (k : Type u) [Field k] (n : ℕ)

/-- The ordinary origin of affine `n`-space. -/
@[stacks 01JD "ordinary affine origin"]
noncomputable abbrev affineOrigin : affineSpace k n :=
  PuncturedAffineSpace.origin (ULift.{u} (Fin n)) k

/-- The punctured affine open is the complement of the ordinary origin. -/
@[stacks 01JD "doubled-origin puncture complement"]
theorem coe_puncturedOpen_eq_compl_affineOrigin :
    (puncturedOpen k n : Set (affineSpace k n)) =
      ({affineOrigin k n} : Set (affineSpace k n))ᶜ := sorry

/-- The origin in the `i`-th canonical affine chart. -/
@[stacks 01JD "the two origins"]
noncomputable abbrev origin (i : Fin 2) : scheme k n :=
  PuncturedAffineSpace.DoubleAlong.origin (ULift.{u} (Fin n)) k i

/-- Each copy of the origin lies in its canonical chart. -/
@[stacks 01JD "doubled-origin membership"]
theorem origin_mem_chart (i : Fin 2) : origin k n i ∈ chart k n i := sorry

/-- The two origins in the doubled-origin scheme are distinct. -/
@[stacks 01JD "doubled-origin distinct points"]
theorem origin_ne : origin k n 0 ≠ origin k n 1 := sorry

/-- Folding either copy of the origin recovers the ordinary origin. -/
@[simp, stacks 01JD "doubled-origin fold"]
theorem fold_origin (i : Fin 2) :
    (fold k n).base (origin k n i) = affineOrigin k n := sorry

/-- The two origins have the same image under the fold. -/
@[stacks 01JD "images of the doubled origins"]
theorem origin_images_eq :
    (fold k n).base (origin k n 0) = (fold k n).base (origin k n 1) := sorry

/-- Positive-dimensional affine space with doubled origin is not affine. -/
@[stacks 01JD "not affine"]
theorem not_isAffine (hn : 1 ≤ n) : ¬ IsAffine (scheme k n) := sorry

/-- In the doubled affine plane, the intersection of the two affine charts is not affine. -/
@[stacks 01IU, stacks 01JD "nonaffine chart intersection"]
theorem chart_inf_not_isAffineOpen :
    ¬ IsAffineOpen (chart k 2 0 ⊓ chart k 2 1) := sorry

/-- In every dimension greater than one, the intersection of the two canonical affine charts is
not affine. This is the `Fin n` bridge from the generic nontrivial-coordinate API. -/
@[stacks 01JD "nonaffine chart intersection in dimension greater than one"]
theorem chart_inf_not_isAffineOpen_of_one_lt (hn : 1 < n) :
    ¬ IsAffineOpen (chart k n 0 ⊓ chart k n 1) := sorry

/-- For dimension greater than one, there are infinitely many irreducible closed subsets other
than the two singleton origins. -/
@[stacks 01JD "infinitely many irreducible closed subsets"]
theorem infinite_irreducibleClosedSubsets (hn : 1 < n) :
    Set.Infinite
      {Z : TopologicalSpace.IrreducibleCloseds (scheme k n) |
        (Z : Set (scheme k n)) ≠ ({origin k n 0} : Set (scheme k n)) ∧
          (Z : Set (scheme k n)) ≠ ({origin k n 1} : Set (scheme k n))} := sorry

/-- Apart from the two singleton origins, an irreducible closed subset contains one origin if
and only if it contains the other. -/
@[stacks 01JD "irreducible closed subsets"]
theorem origin_mem_irreducibleClosed_iff
    (hn : 1 < n) (Z : TopologicalSpace.IrreducibleCloseds (scheme k n))
    (hZ_ne_zero : (Z : Set (scheme k n)) ≠ ({origin k n 0} : Set (scheme k n)))
    (hZ_ne_one : (Z : Set (scheme k n)) ≠ ({origin k n 1} : Set (scheme k n))) :
    origin k n 0 ∈ Z ↔ origin k n 1 ∈ Z := sorry

/-- A closed irreducible subset other than either singleton origin contains one origin if and
only if it contains the other. -/
@[stacks 01JD "irreducible closed subsets raw-set bridge"]
theorem origin_mem_irreducibleClosedSet_iff
    (hn : 1 < n) {T : Set (scheme k n)} (hT_closed : IsClosed T)
    (hT_irreducible : IsIrreducible T)
    (hT_ne_zero : T ≠ ({origin k n 0} : Set (scheme k n)))
    (hT_ne_one : T ≠ ({origin k n 1} : Set (scheme k n))) :
    origin k n 0 ∈ T ↔ origin k n 1 ∈ T := sorry

end Field

end AlgebraicGeometry.DoubledOrigin
