module

public import Mathlib.Algebra.Field.Basic
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.Proper
public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.IdealClosure
public import ReasLib.AlgebraicGeometry.Scheme.OverField
public import ReasLib.AlgebraicGeometry.Scheme.Morphism.Projective.Basic

/-!
# Type (2, 11) complete-intersection curves in standard P^3

This module owns the explicit homogeneous generators `X 0 * X 3 - X 1 * X 2` and
`X 0 ^ 11 + X 1 ^ 11 + X 2 ^ 11 + X 3 ^ 11`, the associated `Proj` curve, its
closed immersion into `ProjectiveSpace.scheme k 3`, and the structure morphism
to `Spec k`.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory

noncomputable section

universe u

namespace AlgebraicGeometry.ProjectiveSpace.CompleteIntersection211

/-- The Segre quadric `MvPolynomial.X 0 * MvPolynomial.X 3 - MvPolynomial.X 1 * MvPolynomial.X 2`
in `k[X_0, X_1, X_2, X_3]`. -/
def segreQuadric (k : Type u) [Field k] : MvPolynomial (Fin (3 + 1)) k :=
  MvPolynomial.X 0 * MvPolynomial.X 3 - MvPolynomial.X 1 * MvPolynomial.X 2

/-- The degree-11 Fermat form
`MvPolynomial.X 0 ^ 11 + MvPolynomial.X 1 ^ 11 + MvPolynomial.X 2 ^ 11 + MvPolynomial.X 3 ^ 11`. -/
def fermatEleven (k : Type u) [Field k] : MvPolynomial (Fin (3 + 1)) k :=
  MvPolynomial.X 0 ^ 11 + MvPolynomial.X 1 ^ 11 + MvPolynomial.X 2 ^ 11 +
    MvPolynomial.X 3 ^ 11

/-- The Segre quadric is homogeneous of degree 2 for the standard grading on
`k[X_0, X_1, X_2, X_3]`. -/
theorem segreQuadric_mem_grading (k : Type u) [Field k] :
    segreQuadric k ∈ ProjectiveSpace.grading k 3 2 := sorry

/-- The Fermat form is homogeneous of degree 11 for the standard grading on
`k[X_0, X_1, X_2, X_3]`. -/
theorem fermatEleven_mem_grading (k : Type u) [Field k] :
    fermatEleven k ∈ ProjectiveSpace.grading k 3 11 := sorry

/-- The ideal generated by the Segre quadric and the degree-11 Fermat form is
homogeneous for the standard grading on `k[X_0, X_1, X_2, X_3]`. -/
theorem homogeneousIdeal_isHomogeneous (k : Type u) [Field k] :
    (Ideal.span {segreQuadric k, fermatEleven k}).IsHomogeneous
      (ProjectiveSpace.grading k 3) := sorry

/-- The homogeneous ideal `(segreQuadric, fermatEleven)` cutting out a type (2, 11)
complete intersection in `ProjectiveSpace.scheme k 3`. -/
def homogeneousIdeal (k : Type u) [Field k] :
    HomogeneousIdeal (ProjectiveSpace.grading k 3) where
  toSubmodule := Ideal.span {segreQuadric k, fermatEleven k}
  is_homogeneous' := homogeneousIdeal_isHomogeneous k

/-- The underlying ideal of `homogeneousIdeal k` is generated by the Segre quadric
and the degree-11 Fermat form. -/
theorem homogeneousIdeal_toIdeal (k : Type u) [Field k] :
    (homogeneousIdeal k).toIdeal = Ideal.span {segreQuadric k, fermatEleven k} :=
  sorry

/-- The quotient grading on `k[X_0, X_1, X_2, X_3] ⧸ (segreQuadric, fermatEleven)`. -/
abbrev quotientGrading (k : Type u) [Field k] :
    ℕ → Submodule k
      (MvPolynomial (Fin (3 + 1)) k ⧸ (homogeneousIdeal k).toIdeal) :=
  GradedAlgebra.Quotient.grading (ProjectiveSpace.grading k 3)
    (homogeneousIdeal k).toIdeal

/-- The quotient by `homogeneousIdeal k` carries its canonical graded-algebra
structure. -/
noncomputable instance instGradedAlgebra (k : Type u) [Field k] :
    GradedAlgebra (quotientGrading k) :=
  GradedAlgebra.Quotient.gradedAlgebra (ProjectiveSpace.grading k 3)
    (homogeneousIdeal k).toIdeal (homogeneousIdeal k).isHomogeneous

/-- The `Proj` model of the type (2, 11) complete-intersection curve
`X = Proj(k[X_0, X_1, X_2, X_3] ⧸ (segreQuadric, fermatEleven))`. -/
abbrev scheme (k : Type u) [Field k] : Scheme :=
  Proj (quotientGrading k)

/-- The closed immersion `i : X ⟶ P^3_k` induced by the homogeneous quotient
`k[X_0, X_1, X_2, X_3] ⧸ (segreQuadric, fermatEleven)`. -/
def closedImmersion (k : Type u) [Field k] :
    scheme k ⟶ ProjectiveSpace.scheme k 3 :=
  projQuotientMap (ProjectiveSpace.grading k 3) (homogeneousIdeal k)

/-- The morphism `closedImmersion k` is the projective-spectrum map of the
homogeneous quotient by `homogeneousIdeal k`. -/
theorem closedImmersion_def (k : Type u) [Field k] :
    closedImmersion k =
      projQuotientMap (ProjectiveSpace.grading k 3) (homogeneousIdeal k) :=
  sorry

/-- The morphism `closedImmersion k` is a closed immersion. -/
instance instIsClosedImmersion (k : Type u) [Field k] :
    IsClosedImmersion (closedImmersion k) :=
  projQuotientMap_isClosedImmersion (ProjectiveSpace.grading k 3)
    (homogeneousIdeal k)

/-- The structure morphism `X ⟶ Spec k` of the type (2, 11) complete-intersection
curve. -/
abbrev hom (k : Type u) [Field k] : scheme k ⟶ Spec (.of k) :=
  closedImmersion k ≫ ProjectiveSpace.toSpec k 3

/-- The structure morphism is the closed immersion into `P^3_k` followed by
`ProjectiveSpace.toSpec k 3`. -/
theorem hom_def (k : Type u) [Field k] :
    hom k = closedImmersion k ≫ ProjectiveSpace.toSpec k 3 := sorry

/-- The type (2, 11) complete-intersection curve, bundled as a scheme over `k`. -/
abbrev schemeOver (k : Type u) [Field k] : SchemeOverField k :=
  Over.mk (hom k)

/-- The structure morphism of the type (2, 11) complete-intersection curve is
proper. -/
instance instIsProper_hom (k : Type u) [Field k] : IsProper (hom k) := sorry

/-- The structure morphism of the explicit type (2, 11) complete intersection is
projective over its field of definition. -/
instance instProjective_hom (k : Type u) [Field k] : Projective (hom k) := sorry

/-- The explicit type (2, 11) complete-intersection curve has topological Krull
dimension one. -/
theorem topologicalKrullDim_eq_one (k : Type u) [Field k] :
    topologicalKrullDim (scheme k) = 1 := sorry

end AlgebraicGeometry.ProjectiveSpace.CompleteIntersection211
