module

public import ReasLib.CategoryTheory.DerivedCategory.Monoidal.Tensor.Right.Monoidal
public import ReasLib.CategoryTheory.Monoidal.Closed.Functoriality
public import ReasLib.CategoryTheory.Monoidal.RightInternalHom.BraidedClosed
import Mathlib.Tactic.CrossRefAttribute

/-!
# Internal-Hom adjunctions for fixed-right derived tensoring

The ambient closed structure supplies an adjunction for `tensorLeft E`.  This leaf transports it
through the braiding and an explicit ambient-to-derived fixed-right comparison.  The general
entry consumes a `Right.Monoidal.Model` family; the `Strong` namespace gives the special case
where the source comparison is generated by a strong monoidal localization.

@stack 0BYN
@stack 0A65
@stack 0A67
@stack 0A8J
@stack 0A6B
@stack 0A8W
-/

@[expose] public section

open CategoryTheory CategoryTheory.MonoidalCategory ComplexShape

noncomputable section

universe w v u

namespace CategoryTheory.DerivedCategory.DerivedTensor.Right.Closed

variable {C : Type u} [Category.{v} C] [Abelian C] [HasDerivedCategory.{w} C]
variable [MonoidalCategory C] [MonoidalPreadditive C]
variable [∀ K L : CochainComplex C ℤ,
  HomologicalComplex.HasMapBifunctor K L (curriedTensor C) (up ℤ)]
variable [MonoidalCategory (DerivedCategory C)]

namespace Parametrized

/-- Stacks 064M: transport a bundled right internal-Hom owner to canonical fixed-right derivation
through an explicit ambient model family.  Parameter maps between the transported left adjoints
are generated canonically as mates below. -/
@[stacks 064M "fixed-right derived adjunction from a parametrized owner"]
noncomputable def adjunction
    (H : RightInternalHom (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    (E : DerivedCategory C) [DerivedTensor.Right.Has (C := C)] :
    DerivedTensor.Right.functor E ⊣ H.hom.obj (Opposite.op E) :=
  (H.adj₂.adj E).ofNatIsoLeft
    (DerivedTensor.Right.Monoidal.Model.functorIsoTensorRight M E).symm

/-- Stacks 064M: the fixed-right derived Hom equivalence supplied by bundled internal-Hom and
explicit tensor-model owners. -/
@[stacks 064M "fixed-right derived Hom equivalence from a parametrized owner"]
noncomputable abbrev homEquiv
    (H : RightInternalHom (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    (E K N : DerivedCategory C) [DerivedTensor.Right.Has (C := C)] :
    ((DerivedTensor.Right.functor E).obj K ⟶ N) ≃
      (K ⟶ (H.hom.obj (Opposite.op E)).obj N) :=
  (adjunction H M E).homEquiv K N

/-- Stacks 064M: the inverse fixed-right derived Hom equivalence supplied by bundled
internal-Hom and explicit tensor-model owners. -/
@[stacks 064M "fixed-right derived uncurrying equivalence from a parametrized owner"]
noncomputable abbrev uncurryEquiv
    (H : RightInternalHom (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    (E K N : DerivedCategory C) [DerivedTensor.Right.Has (C := C)] :
    (K ⟶ (H.hom.obj (Opposite.op E)).obj N) ≃
      ((DerivedTensor.Right.functor E).obj K ⟶ N) :=
  (homEquiv H M E K N).symm

namespace Generated

/-!
The model family above is pointwise in the right factor.  Its pointwise adjunctions nevertheless
determine canonical parameter maps by taking left mates of the maps of `H.hom`.  The following
owner records exactly that generated functoriality.  It is intentionally not identified with an
independently chosen derived tensor bifunctor.
-/

/-- Stacks 064M: the two-variable functor generated from the fixed-right derived tensor functors
and their pointwise adjunctions to a chosen right internal Hom.  Its maps in the right factor are
the canonical left mates of the parameter maps of `H.hom`. -/
@[stacks 064M "generated two-variable fixed-right derived tensor"]
noncomputable abbrev functor
    (H : RightInternalHom (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    [DerivedTensor.Right.Has (C := C)] :
    DerivedCategory C ⥤ DerivedCategory C ⥤ DerivedCategory C :=
  ParametrizedAdjunction.leftAdjointFunctor H.hom
    (fun E => Parametrized.adjunction H M E)

/-- Stacks 064M: the generated bifunctor specializes at `E` to the canonical fixed-right total
derived tensor functor. -/
@[simp, stacks 064M "generated fixed-right derived tensor specialization"]
theorem functor_obj
    (H : RightInternalHom (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    [DerivedTensor.Right.Has (C := C)] (E : DerivedCategory C) :
    (functor H M).obj E = DerivedTensor.Right.functor E := rfl

/-- Stacks 064M: maps in the right factor of the generated derived tensor functor are the
canonical left mates of the parameter maps of the chosen right internal Hom. -/
@[simp, stacks 064M "generated fixed-right derived tensor parameter map"]
theorem functor_map
    (H : RightInternalHom (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    [DerivedTensor.Right.Has (C := C)] {E₁ E₂ : DerivedCategory C}
    (f : E₁ ⟶ E₂) :
    (functor H M).map f =
      ParametrizedAdjunction.leftAdjointMap H.hom
        (fun E => Parametrized.adjunction H M E) f := rfl

/- The following two forms keep the mate calculus at the derived right-tensor level, so a
downstream statement need not reconstruct the generic `T` family by hand. -/

/-- Stacks 064M: the generated right-factor map satisfies the Hom-equivalence naturality for the
pointwise fixed-right derived adjunctions. -/
@[reassoc, stacks 064M "generated fixed-right mate naturality"]
theorem functor_map_homEquiv_naturality
    (H : RightInternalHom (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    [DerivedTensor.Right.Has (C := C)] {E₁ E₂ : DerivedCategory C}
    (f : E₁ ⟶ E₂) {K N : DerivedCategory C}
    (g : (DerivedTensor.Right.functor E₂).obj K ⟶ N) :
    (Parametrized.adjunction H M E₁).homEquiv K N
        (((functor H M).map f).app K ≫ g) =
      (Parametrized.adjunction H M E₂).homEquiv K N g ≫
        (H.hom.map f.op).app N :=
  ParametrizedAdjunction.leftAdjointMap_homEquiv_naturality
    H.hom (fun E ↦ Parametrized.adjunction H M E) f g

/-- Stacks 064M: the inverse transpose form of naturality for a generated right-factor map. -/
@[reassoc, stacks 064M "generated fixed-right inverse mate naturality"]
theorem functor_map_homEquiv_symm
    (H : RightInternalHom (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    [DerivedTensor.Right.Has (C := C)] {E₁ E₂ : DerivedCategory C}
    (f : E₁ ⟶ E₂) {K N : DerivedCategory C}
    (g : K ⟶ (H.hom.obj (Opposite.op E₂)).obj N) :
    ((functor H M).map f).app K ≫
        ((Parametrized.adjunction H M E₂).homEquiv K N).symm g =
      ((Parametrized.adjunction H M E₁).homEquiv K N).symm
        (g ≫ (H.hom.map f.op).app N) :=
  ParametrizedAdjunction.leftAdjointMap_homEquiv_symm
    H.hom (fun E ↦ Parametrized.adjunction H M E) f g

/-- Stacks 064M: the genuine parametrized adjunction generated from the pointwise fixed-right
derived tensor adjunctions.  Its left functor is `functor H M`, including the mate-defined maps
in the right factor. -/
@[stacks 064M "generated parametrized fixed-right derived tensor adjunction"]
noncomputable abbrev adj₂
    (H : RightInternalHom (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    [DerivedTensor.Right.Has (C := C)] :
    functor H M ⊣₂ H.hom :=
  ParametrizedAdjunction.ofPointwiseLeftAdjoints H.hom
    (fun E => Parametrized.adjunction H M E)

/-- Stacks 064M: the component at `E` of the generated parametrized adjunction is the original
pointwise fixed-right derived tensor adjunction. -/
@[simp, stacks 064M "generated parametrized fixed-right adjunction component"]
theorem adj₂_adj
    (H : RightInternalHom (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    [DerivedTensor.Right.Has (C := C)] (E : DerivedCategory C) :
    (adj₂ H M).adj E = Parametrized.adjunction H M E := rfl

end Generated

namespace Counit

/-- Stacks 064M: transport a bundled right internal-Hom owner to fixed-right derivation from an
explicit counit and its universal-property law. -/
@[stacks 064M "fixed-right derived adjunction from parametrized and counit data"]
noncomputable def adjunction
    (H : RightInternalHom (DerivedCategory C)) (E : DerivedCategory C)
    (ε : DerivedTensor.Right.localization (C := C) ⋙ MonoidalCategory.tensorRight E ⟶
      DerivedTensor.Right.sourceFunctor E)
    (h : (MonoidalCategory.tensorRight E).IsLeftDerivedFunctor ε
      (DerivedTensor.Right.qis (C := C)))
    [DerivedTensor.Right.Has (C := C)] :
    DerivedTensor.Right.functor E ⊣ H.hom.obj (Opposite.op E) :=
  (H.adj₂.adj E).ofNatIsoLeft
    (DerivedTensor.Right.Monoidal.functorIsoTensorRightOf E ε h).symm

/-- Stacks 064M: the fixed-right Hom equivalence supplied by bundled internal-Hom and explicit
counit owners. -/
@[stacks 064M "fixed-right derived Hom equivalence from parametrized and counit data"]
noncomputable abbrev homEquiv
    (H : RightInternalHom (DerivedCategory C)) (E K N : DerivedCategory C)
    (ε : DerivedTensor.Right.localization (C := C) ⋙ MonoidalCategory.tensorRight E ⟶
      DerivedTensor.Right.sourceFunctor E)
    (h : (MonoidalCategory.tensorRight E).IsLeftDerivedFunctor ε
      (DerivedTensor.Right.qis (C := C)))
    [DerivedTensor.Right.Has (C := C)] :
    ((DerivedTensor.Right.functor E).obj K ⟶ N) ≃
      (K ⟶ (H.hom.obj (Opposite.op E)).obj N) :=
  (adjunction H E ε h).homEquiv K N

/-- Stacks 064M: the inverse fixed-right Hom equivalence supplied by bundled internal-Hom and
explicit counit owners. -/
@[stacks 064M "fixed-right derived uncurrying equivalence from parametrized and counit data"]
noncomputable abbrev uncurryEquiv
    (H : RightInternalHom (DerivedCategory C)) (E K N : DerivedCategory C)
    (ε : DerivedTensor.Right.localization (C := C) ⋙ MonoidalCategory.tensorRight E ⟶
      DerivedTensor.Right.sourceFunctor E)
    (h : (MonoidalCategory.tensorRight E).IsLeftDerivedFunctor ε
      (DerivedTensor.Right.qis (C := C)))
    [DerivedTensor.Right.Has (C := C)] :
    (K ⟶ (H.hom.obj (Opposite.op E)).obj N) ≃
      ((DerivedTensor.Right.functor E).obj K ⟶ N) :=
  (homEquiv H E K N ε h).symm

end Counit

end Parametrized

variable [BraidedCategory (DerivedCategory C)]

/-- Stacks 0A8J: source-order composition of derived internal-Hom objects with an explicit ambient
fixed-right model.  The model comparison transports the canonical derived tensor source to the
ambient tensor before applying generic braided closed composition. -/
@[stacks 0A8J "derived internal-Hom composition from an explicit tensor model"]
noncomputable def compOf
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    (K L N : DerivedCategory C) [DerivedTensor.Right.Has (C := C)] :
    DerivedTensor.Right.obj
        ((MonoidalClosed.ihomOf H L).obj N)
        ((MonoidalClosed.ihomOf H K).obj L) ⟶
      (MonoidalClosed.ihomOf H K).obj N :=
  (DerivedTensor.Right.Monoidal.Model.objIsoTensor M
      ((MonoidalClosed.ihomOf H L).obj N)
      ((MonoidalClosed.ihomOf H K).obj L)).hom ≫
    MonoidalClosed.Source.compOf H K L N

/-- Stacks 0A8J: specification of the explicit derived internal-Hom composition. -/
@[stacks 0A8J "derived internal-Hom composition specification"]
theorem compOf_spec
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    (K L N : DerivedCategory C) [DerivedTensor.Right.Has (C := C)] :
    compOf H M K L N =
      (DerivedTensor.Right.Monoidal.Model.objIsoTensor M
        ((MonoidalClosed.ihomOf H L).obj N)
        ((MonoidalClosed.ihomOf H K).obj L)).hom ≫
        MonoidalClosed.Source.compOf H K L N := rfl

namespace TensorInternalHom

/-- Stacks 0BYN: the tensor/internal-Hom comparison for canonical fixed-right derived tensoring.
The explicit model transports the generic braided closed comparison between `⊗ᴸ` and the
ambient tensor, so no proof-local monoidal or closed instance is hidden in the construction. -/
@[stacks 0BYN "derived tensor/internal-Hom comparison from explicit owners"]
noncomputable def comparisonOf
    (H : MonoidalClosed (DerivedCategory C))
    (T : DerivedTensor.Right.Monoidal.Model (C := C))
    (K L E : DerivedCategory C) [DerivedTensor.Right.Has (C := C)] :
    DerivedTensor.Right.obj K ((MonoidalClosed.ihomOf H E).obj L) ⟶
      (MonoidalClosed.ihomOf H E).obj (DerivedTensor.Right.obj K L) :=
  (DerivedTensor.Right.Monoidal.Model.objIsoTensor T K
      ((MonoidalClosed.ihomOf H E).obj L)).hom ≫
    MonoidalClosed.TensorInternalHom.comparisonOf H K L E ≫
    (MonoidalClosed.ihomOf H E).map
      (DerivedTensor.Right.Monoidal.Model.objIsoTensor T K L).inv

/-- The canonical derived tensor/internal-Hom comparison is the ambient comparison transported
along the two objectwise tensor-model isomorphisms. -/
@[stacks 0BYN "derived tensor/internal-Hom comparison specification"]
theorem comparisonOf_spec
    (H : MonoidalClosed (DerivedCategory C))
    (T : DerivedTensor.Right.Monoidal.Model (C := C))
    (K L E : DerivedCategory C) [DerivedTensor.Right.Has (C := C)] :
    comparisonOf H T K L E =
      (DerivedTensor.Right.Monoidal.Model.objIsoTensor T K
        ((MonoidalClosed.ihomOf H E).obj L)).hom ≫
        MonoidalClosed.TensorInternalHom.comparisonOf H K L E ≫
        (MonoidalClosed.ihomOf H E).map
          (DerivedTensor.Right.Monoidal.Model.objIsoTensor T K L).inv := rfl

/-- The canonical derived tensor/internal-Hom comparison is natural in its tensor factor. -/
@[stacks 0BYN "derived tensor/internal-Hom tensor naturality"]
theorem comparisonOf_natural_tensor
    (H : MonoidalClosed (DerivedCategory C))
    (T : DerivedTensor.Right.Monoidal.Model (C := C))
    {K₁ K₂ L E : DerivedCategory C} (fK : K₁ ⟶ K₂)
    [DerivedTensor.Right.Has (C := C)] :
    CommSq
      ((DerivedTensor.Right.functor ((MonoidalClosed.ihomOf H E).obj L)).map fK)
      (comparisonOf H T K₁ L E)
      (comparisonOf H T K₂ L E)
      ((MonoidalClosed.ihomOf H E).map ((DerivedTensor.Right.functor L).map fK)) := by
  refine ⟨?_⟩
  dsimp only [comparisonOf]
  simp only [Category.assoc]
  rw [T.objIsoTensor_naturality_assoc ((H.ihomOf E).obj L) fK]
  rw [cancel_epi]
  rw [(MonoidalClosed.TensorInternalHom.comparisonOf_natural_tensor H fK).w_assoc]
  simp only [← Functor.map_comp]
  rw [T.objIsoTensor_inv_naturality L fK]

end TensorInternalHom

/-- The explicit derived internal-Hom composition is covariantly natural in its target. -/
@[stacks 0A8J "derived internal-Hom composition target naturality"]
theorem compOf_natural_target
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    (K L : DerivedCategory C) [DerivedTensor.Right.Has (C := C)]
    {N₁ N₂ : DerivedCategory C} (f : N₁ ⟶ N₂) :
    CommSq
      ((DerivedTensor.Right.functor ((MonoidalClosed.ihomOf H K).obj L)).map
        ((MonoidalClosed.ihomOf H L).map f))
      (compOf H M K L N₁)
      (compOf H M K L N₂)
      ((MonoidalClosed.ihomOf H K).map f) := by
  refine ⟨?_⟩
  dsimp only [compOf]
  simp only [Category.assoc]
  rw [M.objIsoTensor_naturality_assoc ((H.ihomOf K).obj L)
    ((H.ihomOf L).map f)]
  rw [cancel_epi]
  conv_rhs => rw [← Category.assoc]
  exact (MonoidalClosed.Source.compOf_natural_target H K L f).w

/-- Equality form of target naturality for explicit derived internal-Hom composition. -/
@[reassoc, stacks 0A8J "derived internal-Hom composition target naturality equation"]
theorem compOf_natural_target_assoc
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    (K L : DerivedCategory C) [DerivedTensor.Right.Has (C := C)]
    {N₁ N₂ : DerivedCategory C} (f : N₁ ⟶ N₂) :
    (DerivedTensor.Right.functor ((MonoidalClosed.ihomOf H K).obj L)).map
          ((MonoidalClosed.ihomOf H L).map f) ≫
        compOf H M K L N₂ =
      compOf H M K L N₁ ≫ (MonoidalClosed.ihomOf H K).map f :=
  (compOf_natural_target H M K L f).w

namespace Generated

/-!
This namespace is the closed-monoidal spelling of `Parametrized.Generated`.  The explicit owner
argument keeps the construction instance-free; the later `functor`/`adj₂` abbreviations are only
the ambient-instance convenience layer.
-/

/-- Stacks 064M: generate a coherent fixed-right derived tensor bifunctor from an explicit
monoidal-closed owner and an explicit family of right-derived tensor models.  The maps in the
right factor are generated by left mates of the pointwise adjunctions; this owner is not definitionally
identified with any independently chosen `DerivedTensor.Bifunctor`. -/
@[stacks 064M "explicit closed generated fixed-right derived tensor"]
noncomputable abbrev functorOf
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    [DerivedTensor.Right.Has (C := C)] :
    DerivedCategory C ⥤ DerivedCategory C ⥤ DerivedCategory C :=
  Parametrized.Generated.functor (RightInternalHom.ofBraidedClosedOf H) M

/-- Stacks 064M: the coherent parametrized adjunction generated from explicit closed and tensor
model owners. -/
@[stacks 064M "explicit closed generated fixed-right adjunction"]
noncomputable abbrev adj₂Of
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    [DerivedTensor.Right.Has (C := C)] :
    functorOf H M ⊣₂ MonoidalClosed.internalHomOf H :=
  Parametrized.Generated.adj₂ (RightInternalHom.ofBraidedClosedOf H) M

end Generated

/-- Stacks 064M: the ambient fixed-right tensor adjunction selected by an explicit closed owner.
This is the instance-free entry for downstream developments that carry their closed structure as
ordinary data. -/
@[stacks 064M "ambient fixed-right adjunction from a closed owner"]
noncomputable def ambientAdjunctionOf
    (H : MonoidalClosed (DerivedCategory C)) (E : DerivedCategory C) :
    MonoidalCategory.tensorRight E ⊣ MonoidalClosed.ihomOf H E :=
  (MonoidalClosed.adjunctionOf H E).ofNatIsoLeft
    (BraidedCategory.tensorLeftIsoTensorRight E)

/-- Stacks 064M: the ambient fixed-right Hom equivalence selected by an explicit closed owner. -/
@[stacks 064M "ambient fixed-right Hom equivalence from a closed owner"]
noncomputable abbrev ambientHomEquivOf
    (H : MonoidalClosed (DerivedCategory C)) (E K N : DerivedCategory C) :
    ((MonoidalCategory.tensorRight E).obj K ⟶ N) ≃
      (K ⟶ (MonoidalClosed.ihomOf H E).obj N) :=
  (ambientAdjunctionOf H E).homEquiv K N

/-- Stacks 064M: the inverse ambient fixed-right Hom equivalence selected by an explicit closed
owner. -/
@[stacks 064M "ambient fixed-right uncurrying equivalence from a closed owner"]
noncomputable abbrev ambientUncurryEquivOf
    (H : MonoidalClosed (DerivedCategory C)) (E K N : DerivedCategory C) :
    (K ⟶ (MonoidalClosed.ihomOf H E).obj N) ≃
      ((MonoidalCategory.tensorRight E).obj K ⟶ N) :=
  (ambientHomEquivOf H E K N).symm

/-- Stacks 064M: transport an explicit closed owner to canonical fixed-right derivation through
an ambient model family. -/
@[stacks 064M "fixed-right derived adjunction from explicit owners"]
noncomputable def adjunctionOf
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    (E : DerivedCategory C) [DerivedTensor.Right.Has (C := C)] :
    DerivedTensor.Right.functor E ⊣ MonoidalClosed.ihomOf H E :=
  Parametrized.adjunction (RightInternalHom.ofBraidedClosedOf H) M E

/-- A map of right factors induces a natural transformation between canonical fixed-right derived
tensor functors by taking the left mate for the selected adjunction family.  This does not assert
equality with the parameter map of an independently chosen derived tensor bifunctor. -/
@[stacks 064M "fixed-right derived tensor parameter map from explicit owners"]
noncomputable abbrev tensorMapOf
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    {E₁ E₂ : DerivedCategory C} (f : E₁ ⟶ E₂)
    [DerivedTensor.Right.Has (C := C)] :
    DerivedTensor.Right.functor E₁ ⟶ DerivedTensor.Right.functor E₂ :=
  MonoidalClosed.leftAdjointMapOf H (fun E => adjunctionOf H M E) f

/-- The generated fixed-right derived tensor parameter map of an identity is the identity natural
transformation. -/
@[simp, stacks 064M "fixed-right derived tensor identity parameter map"]
theorem tensorMapOf_id
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    (E : DerivedCategory C) [DerivedTensor.Right.Has (C := C)] :
    tensorMapOf H M (𝟙 E) = 𝟙 (DerivedTensor.Right.functor E) :=
  MonoidalClosed.leftAdjointMapOf_id H (fun E ↦ adjunctionOf H M E) E

/-- Generated fixed-right derived tensor parameter maps preserve composition. -/
@[reassoc, stacks 064M "fixed-right derived tensor parameter map composition"]
theorem tensorMapOf_comp
    (H : MonoidalClosed (DerivedCategory C))
    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    {E₁ E₂ E₃ : DerivedCategory C} (f : E₁ ⟶ E₂) (g : E₂ ⟶ E₃)
    [DerivedTensor.Right.Has (C := C)] :
    tensorMapOf H M (f ≫ g) = tensorMapOf H M f ≫ tensorMapOf H M g :=
  MonoidalClosed.leftAdjointMapOf_comp H (fun E ↦ adjunctionOf H M E) f g

/-- Stacks 064M: the mate-generated parameter map is the ambient right-tensor map transported
through the pointwise model comparisons.  This is a theorem of the transported adjunctions, not
an additional coherence input on the model family. -/
@[reassoc, stacks 064M "fixed-right derived tensor parameter map comparison"]
theorem tensorMapOf_objIsoTensor
    (H : MonoidalClosed (DerivedCategory C))
    (T : DerivedTensor.Right.Monoidal.Model (C := C))
    [DerivedTensor.Right.Has (C := C)]
    {E₁ E₂ : DerivedCategory C} (f : E₁ ⟶ E₂) (K : DerivedCategory C) :
    (tensorMapOf H T f).app K ≫
          (DerivedTensor.Right.Monoidal.Model.objIsoTensor T K E₂).hom =
        (DerivedTensor.Right.Monoidal.Model.objIsoTensor T K E₁).hom ≫
          (𝟙 K ⊗ₘ f) := by
  apply ((adjunctionOf H T E₁).homEquiv K (K ⊗ E₂)).injective
  rw [MonoidalClosed.leftAdjointMapOf_homEquiv_naturality H
    (fun E ↦ adjunctionOf H T E) f (T.objIsoTensor K E₂).hom]
  have htransport (E N : DerivedCategory C) (g : K ⊗ E ⟶ N) :
      (adjunctionOf H T E).homEquiv K N ((T.objIsoTensor K E).hom ≫ g) =
        (ambientAdjunctionOf H E).homEquiv K N g := by
    change ((((RightInternalHom.ofBraidedClosedOf H).adj₂.adj E).ofNatIsoLeft
        (T.functorIsoTensorRight E).symm).homEquiv K N)
        ((T.objIsoTensor K E).hom ≫ g) = _
    rw [Adjunction.homEquiv_ofNatIsoLeft_apply]
    change (((RightInternalHom.ofBraidedClosedOf H).adj₂.adj E).homEquiv K N)
        ((T.functorIsoTensorRight E).inv.app K ≫
          (T.functorIsoTensorRight E).hom.app K ≫ g) = _
    rw [Iso.inv_hom_id_app_assoc]
    rw [RightInternalHom.ofBraidedClosedOf_adj]
    rfl
  have htransportId (E : DerivedCategory C) :
      (adjunctionOf H T E).homEquiv K (K ⊗ E) (T.objIsoTensor K E).hom =
        (ambientAdjunctionOf H E).homEquiv K (K ⊗ E) (𝟙 (K ⊗ E)) := by
    simpa using htransport E (K ⊗ E) (𝟙 (K ⊗ E))
  rw [htransportId E₂]
  rw [htransport E₁ (K ⊗ E₂) (𝟙 K ⊗ₘ f)]
  simpa only [ambientAdjunctionOf, Category.comp_id,
    MonoidalCategory.id_tensorHom] using
    (MonoidalClosed.adjunctionOf_right_homEquiv_naturality_one
      H f (𝟙 (K ⊗ E₂))).symm

/-- Inverse form of `tensorMapOf_objIsoTensor`: ambient right-tensor functoriality followed by the
inverse model comparison is the inverse source comparison followed by the generated mate. -/
@[reassoc, stacks 064M "inverse fixed-right derived tensor parameter map comparison"]
theorem tensorMapOf_objIsoTensor_inv
    (H : MonoidalClosed (DerivedCategory C))
    (T : DerivedTensor.Right.Monoidal.Model (C := C))
    [DerivedTensor.Right.Has (C := C)]
    {E₁ E₂ : DerivedCategory C} (f : E₁ ⟶ E₂) (K : DerivedCategory C) :
