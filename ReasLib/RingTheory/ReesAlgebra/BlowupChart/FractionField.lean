module

public import ReasLib.RingTheory.ReesAlgebra.BlowupChart.Localization
public import ReasLib.RingTheory.Ideal.FiniteGeneration.Family
public import Mathlib.Algebra.Algebra.Subalgebra.Basic
public import Mathlib.RingTheory.Localization.AsSubring
public import Mathlib.RingTheory.Localization.FractionRing

/-!
# Fraction-ring realizations of affine blowup charts

For a commutative domain `R`, a nonzero chart parameter gives a canonical map from `R[I / a]` to
any chosen fraction ring `K`.  The map is explicit and is not registered as a global `Algebra`
instance: downstream developments should use the named map, avoiding competing instance
constructions for the same chart.  Field-specific division formulas are kept in a later section.
-/

@[expose] public section

noncomputable section

open scoped AffineBlowupChart

universe u v

namespace AffineBlowupChart

variable {R : Type u} [CommRing R] [NoZeroDivisors R]
variable {K : Type v}

section CommRing

variable [CommRing K] [Algebra R K] [IsFractionRing R K]

/-- The canonical map from a nonzero affine blowup chart to the chosen fraction ring. -/
@[stacks 052M "affine blowup chart fraction-field map"]
noncomputable def toFractionRing
    (I : Ideal R) (a : NonzeroParameter I) : R[I / a] →+* K :=
  (Localization.mapToFractionRing K (Submonoid.powers (a : R))
      (Localization.Away (a : R))
      (powers_le_nonZeroDivisors_of_noZeroDivisors a.2)).toRingHom.comp
    (toLocalizationAway I a)

/-- The canonical fraction-ring realization of a nonzero affine chart is injective. -/
@[stacks 052M "affine blowup chart fraction-field injectivity"]
theorem toFractionRing_injective
    (I : Ideal R) (a : NonzeroParameter I) :
    Function.Injective (toFractionRing (K := K) I a) := sorry

/-- The fraction-ring map agrees with the scalar map from the base ring. -/
@[stacks 052M "affine blowup chart fraction-field scalar map", simp]
theorem toFractionRing_algebraMap
    (I : Ideal R) (a : NonzeroParameter I) (r : R) :
    toFractionRing (K := K) I a (AffineBlowupChart.algebraMap I a r) =
      algebraMap R K r := sorry

/-- The fraction-ring map can be used as an `R`-algebra homomorphism when scalar compatibility is
needed explicitly.  The RingHom owner remains available through `.toRingHom`. -/
@[stacks 052M "affine blowup chart fraction-field algebra map"]
noncomputable def toFractionRingAlgHom
    (I : Ideal R) (a : NonzeroParameter I) : R[I / a] →ₐ[R] K :=
  { toFractionRing (K := K) I a with
    commutes' := fun r => toFractionRing_algebraMap (K := K) I a r }

/-- The affine blowup chart viewed as the `R`-subalgebra of its chosen fraction ring, generated by
its canonical fraction-ring map. -/
@[stacks 052M "affine blowup chart fraction-field subalgebra"]
noncomputable def fractionSubalgebra
    (I : Ideal R) (a : NonzeroParameter I) : Subalgebra R K :=
  (toFractionRingAlgHom (K := K) I a).range

/-- The canonical map from an affine blowup chart onto its fraction subalgebra.  This is the
range restriction of `toFractionRingAlgHom`. -/
@[stacks 052M "affine blowup chart fraction-subalgebra range restriction"]
noncomputable def toFractionSubalgebra
    (I : Ideal R) (a : NonzeroParameter I) :
    R[I / a] →ₐ[R] fractionSubalgebra (K := K) I a :=
  (toFractionRingAlgHom (K := K) I a).rangeRestrict

/-- The canonical map from an affine blowup chart onto its fraction subalgebra is injective. -/
@[stacks 052M "affine blowup chart fraction-subalgebra injectivity"]
theorem toFractionSubalgebra_injective
    (I : Ideal R) (a : NonzeroParameter I) :
    Function.Injective (toFractionSubalgebra (K := K) I a) := sorry

/-- The affine blowup chart is canonically equivalent, as an `R`-algebra, to its fraction
subalgebra. -/
@[stacks 052M "affine blowup chart fraction-subalgebra equivalence"]
noncomputable def fractionSubalgebraEquiv
    (I : Ideal R) (a : NonzeroParameter I) :
    R[I / a] ≃ₐ[R] fractionSubalgebra (K := K) I a :=
  AlgEquiv.ofBijective (toFractionSubalgebra (K := K) I a)
    ⟨toFractionSubalgebra_injective (K := K) I a, AlgHom.rangeRestrict_surjective _⟩

/-- The affine blowup chart viewed as the underlying subring of its canonical fraction
subalgebra. -/
@[stacks 052M "affine blowup chart fraction-field subring"]
noncomputable def fractionSubring
    (I : Ideal R) (a : NonzeroParameter I) : Subring K :=
  (fractionSubalgebra (K := K) I a).toSubring

/-- Membership in the underlying fraction subring is witnessed by an element of the affine
blowup chart mapping to the given fraction-ring element. -/
@[stacks 052M "affine blowup chart fraction-field subring membership"]
theorem mem_fractionSubring_iff
    (I : Ideal R) (a : NonzeroParameter I) (x : K) :
    x ∈ fractionSubring (K := K) I a ↔
      ∃ y : affineBlowupChart I a, toFractionRing (K := K) I a y = x := sorry

end CommRing

section Field

variable [Field K] [Algebra R K] [IsFractionRing R K]

/-- The image of a basic chart fraction in the fraction field is the ordinary fraction `x / a`. -/
@[stacks 052M "affine blowup chart fraction-field basic fraction", simp]
theorem toFractionRing_basicFraction
    (I : Ideal R) (a : NonzeroParameter I) (x : I) :
    toFractionRing (K := K) I a (AffineBlowupChart.basicFraction I a x) =
      algebraMap R K (x : R) / algebraMap R K (a : R) := sorry

/-- The image of a normalized power fraction in the fraction field is `r / a^n`. -/
@[stacks 052M "affine blowup chart fraction-field power fraction", simp]
theorem toFractionRing_powerFraction
    (I : Ideal R) (a : NonzeroParameter I) (n : ℕ) (r : ↥(I ^ n)) :
    toFractionRing (K := K) I a (AffineBlowupChart.powerFraction I a n r) =
      algebraMap R K r.1 / (algebraMap R K a.1) ^ n := sorry

namespace FractionSubalgebra

/-- A basic affine-chart fraction belongs to the canonical fraction subalgebra. -/
@[stacks 052M "fraction subalgebra basic fraction membership"]
theorem mem_basicFraction
    (I : Ideal R) (a : NonzeroParameter I) (x : I) :
    algebraMap R K (x : R) / algebraMap R K (a : R) ∈
      fractionSubalgebra (K := K) I a := sorry

/-- A normalized power fraction belongs to the canonical fraction subalgebra. -/
@[stacks 052M "fraction subalgebra power fraction membership"]
theorem mem_powerFraction
    (I : Ideal R) (a : NonzeroParameter I) (n : ℕ) (r : ↥(I ^ n)) :
    algebraMap R K r.1 / (algebraMap R K a.1) ^ n ∈
      fractionSubalgebra (K := K) I a := sorry

/-- A subalgebra contains the canonical affine-chart fraction subalgebra exactly when it contains
every basic fraction with denominator the chart parameter.  The scalar condition is implicit in the
`Subalgebra R K` structure. -/
@[stacks 052M "fraction subalgebra universal property"]
theorem le_iff {I : Ideal R} (a : NonzeroParameter I) (B : Subalgebra R K) :
    fractionSubalgebra (K := K) I a ≤ B ↔
      ∀ x : I, algebraMap R K (x : R) / algebraMap R K (a : R) ∈ B := sorry

/-- A subalgebra containing the denominator-`a` fractions of a finite generating family for `I`
contains the canonical fraction-ring realization of `R[I / a]`. -/
@[stacks 052M "fraction subalgebra containment from generators"]
theorem le_of_generators
    (I : Ideal R) (a : NonzeroParameter I)
    (G : I.FiniteGeneratingFamily) (B : Subalgebra R K)
    (hG : ∀ i : G.Index,
      algebraMap R K (G.generator i) / algebraMap R K (a : R) ∈ B) :
    fractionSubalgebra (K := K) I a ≤ B := sorry

end FractionSubalgebra

namespace FractionSubring

/-- The underlying subring satisfies the same universal property as the canonical fraction
subalgebra, for ring-level consumers. -/
@[stacks 052M "fraction subring universal property"]
theorem le_iff {I : Ideal R} (a : NonzeroParameter I) (B : Subring K) :
    fractionSubring (K := K) I a ≤ B ↔
      (algebraMap R K).range ≤ B ∧
        ∀ x : I, algebraMap R K (x : R) / algebraMap R K (a : R) ∈ B := sorry

/-- A basic affine-chart fraction belongs to its canonical fraction subring. -/
@[stacks 052M "fraction subring basic fraction membership"]
theorem mem_basicFraction
    (I : Ideal R) (a : NonzeroParameter I) (x : I) :
    algebraMap R K (x : R) / algebraMap R K (a : R) ∈
      fractionSubring (K := K) I a := sorry

/-- A normalized power fraction belongs to its canonical fraction subring. -/
@[stacks 052M "fraction subring power fraction membership"]
theorem mem_powerFraction
    (I : Ideal R) (a : NonzeroParameter I) (n : ℕ) (r : ↥(I ^ n)) :
    algebraMap R K r.1 / (algebraMap R K a.1) ^ n ∈
      fractionSubring (K := K) I a := sorry

/-- The image of the base ring is contained in every affine-chart fraction subring. -/
@[stacks 052M "fraction subring contains base ring"]
theorem algebraMap_range_le
    (I : Ideal R) (a : NonzeroParameter I) :
    (algebraMap R K).range ≤ fractionSubring (K := K) I a := sorry

/-- A subring containing the base ring and the denominator-`a` fractions of a finite generating
family for `I` contains the canonical fraction-field realization of `R[I / a]`. -/
@[stacks 052M "fraction-field chart containment from generators"]
theorem le_of_generators
    (I : Ideal R) (a : NonzeroParameter I)
    (G : I.FiniteGeneratingFamily) (B : Subring K)
    (hR : (algebraMap R K).range ≤ B)
    (hG : ∀ i : G.Index,
      algebraMap R K (G.generator i) / algebraMap R K (a : R) ∈ B) :
    fractionSubring (K := K) I a ≤ B := sorry

end FractionSubring

end Field

end AffineBlowupChart



end
