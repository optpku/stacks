module

import StacksCheckRecall
public import ReasLib.RingTheory.Smooth.SingularLocus.Standard

@[expose] public section

/- Lemma 16.2.5 (Elkik) (1): the singular ideal is the radical generated by
strictly standard elements. -/
@[stacks 07CA "Elkik"]
#check @Algebra.SingularIdeal.eq_radical_span_strictlyStandard

/- Lemma 16.2.5 (Elkik) (2): the same singular ideal is the radical generated
by elementary standard elements. -/
@[stacks 07CA "Elkik"]
#check @Algebra.SingularIdeal.eq_radical_span_elementaryStandard
