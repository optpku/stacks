module

public import ReasLib.AlgebraicGeometry.Scheme.Divisor.Prime
public import ReasLib.AlgebraicGeometry.Scheme.Divisor.Weil
public import ReasLib.AlgebraicGeometry.Scheme.IdealSheafData.Spec
public import stacks_project.Chap111.Exercise_111_49_7_AffineQuadricCone

/-!
# The ruling Weil divisor `[x = 0, z = 0]` on the affine quadric cone

This leaf packages the prime divisor cut out by `(x, z)` on the affine
quadric cone, and the Weil divisor with coefficient `1` along that ruling.
-/

@[expose] public section

noncomputable section

universe u

open AlgebraicGeometry CategoryTheory

namespace AlgebraicGeometry.AffineQuadricCone

/-- The ruling ideal `(x, z)` in the coordinate ring of the affine quadric cone. -/
def rulingIdeal (k : Type u) [Field k] : Ideal (CoordinateRing k) :=
  Ideal.span {xBar k, zBar k}

/-- The ruling ideal is the ideal generated by the classes of `x` and `z`. -/
theorem rulingIdeal_eq_span (k : Type u) [Field k] :
    rulingIdeal k = Ideal.span {xBar k, zBar k} := sorry

/-- The ideal sheaf on the affine quadric cone associated to the ruling ideal `(x, z)`. -/
def rulingIdealSheaf (k : Type u) [Field k] : (scheme k).IdealSheafData :=
  Scheme.idealSheafDataOfIdealOnSpec (rulingIdeal k)

/-- The closed subscheme cut out by the ruling ideal is integral. -/
theorem isIntegral_rulingIdealSheaf_subscheme (k : Type u) [Field k] :
    IsIntegral (rulingIdealSheaf k).subscheme := sorry

/-- The support of the ruling ideal sheaf is irreducible. -/
theorem isIrreducible_rulingIdealSheaf_support (k : Type u) [Field k] :
    IsIrreducible ((rulingIdealSheaf k).support : Set (scheme k)) := sorry

/-- The support of the ruling ideal sheaf has coheight one. -/
theorem coheight_rulingIdealSheaf_support (k : Type u) [Field k] :
    Order.coheight
      (⟨((rulingIdealSheaf k).support : Set (scheme k)),
          isIrreducible_rulingIdealSheaf_support k,
          (rulingIdealSheaf k).support.isClosed⟩ :
        TopologicalSpace.IrreducibleCloseds (scheme k)) = 1 := sorry

/-- The prime divisor `D = [x = 0, z = 0]` on the affine quadric cone. -/
def rulingPrimeDivisor (k : Type u) [Field k] : PrimeDivisor (scheme k) :=
  PrimeDivisor.ofIdeal (scheme k) (rulingIdealSheaf k)
    (isIntegral_rulingIdealSheaf_subscheme k) (isIrreducible_rulingIdealSheaf_support k)
    (coheight_rulingIdealSheaf_support k)

/-- The ideal sheaf of the ruling prime divisor is the ruling ideal sheaf. -/
theorem rulingPrimeDivisor_ideal (k : Type u) [Field k] :
    (rulingPrimeDivisor k).ideal = rulingIdealSheaf k := sorry

/-- The coefficient function with value `1` on the ruling prime divisor and `0` elsewhere. -/
def rulingWeilDivisorCoeff (k : Type u) [Field k] (Z : PrimeDivisor (scheme k)) : ℤ :=
  @ite ℤ (Z = rulingPrimeDivisor k)
    (Classical.propDecidable (Z = rulingPrimeDivisor k)) 1 0

/-- The characteristic function of the ruling prime divisor is locally finite. -/
theorem locallyFinite_rulingWeilDivisor (k : Type u) [Field k] :
    LocallyFinite fun Z : PrimeDivisor (scheme k) ↦
      if rulingWeilDivisorCoeff k Z = 0 then (∅ : Set (scheme k))
      else (Z.support : Set (scheme k)) := sorry

/-- The Weil divisor with coefficient `1` along the ruling `[x = 0, z = 0]`. -/
def rulingWeilDivisor (k : Type u) [Field k] : WeilDivisor (scheme k) :=
  WeilDivisor.ofCoeff (scheme k) (rulingWeilDivisorCoeff k) (locallyFinite_rulingWeilDivisor k)

/-- Coefficients of the ruling Weil divisor are given by `rulingWeilDivisorCoeff`. -/
theorem rulingWeilDivisor_coeff (k : Type u) [Field k] (Z : PrimeDivisor (scheme k)) :
    (rulingWeilDivisor k).coeff Z = rulingWeilDivisorCoeff k Z := sorry

/-- The ruling Weil divisor has coefficient `1` along its own prime divisor. -/
theorem rulingWeilDivisor_coeff_self (k : Type u) [Field k] :
    (rulingWeilDivisor k).coeff (rulingPrimeDivisor k) = 1 := sorry

end AlgebraicGeometry.AffineQuadricCone
