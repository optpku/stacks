module

public import Mathlib.LinearAlgebra.Span.Defs
public import Mathlib.RingTheory.Ideal.Operations
public import ReasLib.RingTheory.RingHom.SmallExtension
public import stacks_project.Chap90.Definition_90_7_3_ArtinianLocal

/-!
# Small extensions in the base category

A morphism in `ArtinianLocalAlgCat Λ k` is a small extension when it is
surjective and its kernel is a nonzero principal ideal annihilated by the
source maximal ideal.
-/

@[expose] public section

open CategoryTheory IsLocalRing

universe u

variable {Λ k : Type u} [CommRing Λ] [IsNoetherianRing Λ] [Field k] [Algebra Λ k]
  [Module.Finite Λ k]

namespace ArtinianLocalAlgCat

/-- A morphism `f : B ⟶ A` is a small extension if it is surjective and
`RingHom.ker f.hom.toRingHom` is a nonzero principal ideal annihilated by
`maximalIdeal B.carrier`. -/
class IsSmallExtension {B A : ArtinianLocalAlgCat Λ k} (f : B ⟶ A) : Prop where
  /-- A small extension is surjective. -/
  surjective : Function.Surjective f.hom
  /-- The kernel of a small extension is a principal ideal. -/
  ker_isPrincipal : (RingHom.ker f.hom.toRingHom).IsPrincipal
  /-- The kernel of a small extension is nonzero. -/
  ker_ne_bot : RingHom.ker f.hom.toRingHom ≠ ⊥
  /-- The kernel of a small extension is annihilated by the source maximal ideal. -/
  ker_annihilated :
    maximalIdeal B.carrier * RingHom.ker f.hom.toRingHom = ⊥

namespace IsSmallExtension

variable {B A : ArtinianLocalAlgCat Λ k}

/-- A morphism whose underlying ring homomorphism is a small extension is a small
extension in `ArtinianLocalAlgCat`. -/
instance instOfRingHom (f : B ⟶ A) [f.hom.toRingHom.IsSmallExtension] :
    IsSmallExtension f := sorry

/-- The defining conditions of a small extension. -/
theorem spec (f : B ⟶ A) [IsSmallExtension f] :
    Function.Surjective f.hom ∧
      (RingHom.ker f.hom.toRingHom).IsPrincipal ∧
      RingHom.ker f.hom.toRingHom ≠ ⊥ ∧
      maximalIdeal B.carrier * RingHom.ker f.hom.toRingHom = ⊥ := sorry

/-- The underlying ring homomorphism of a small extension is a small extension. -/
theorem toRingHom_isSmallExtension (f : B ⟶ A) [IsSmallExtension f] :
    f.hom.toRingHom.IsSmallExtension := sorry

/-- Small extensions in `ArtinianLocalAlgCat` are exactly those whose underlying ring
homomorphisms are small extensions. -/
theorem iff_ringHom (f : B ⟶ A) :
    IsSmallExtension f ↔ f.hom.toRingHom.IsSmallExtension := sorry

/-- The kernel of a small extension is generated by a nonzero element annihilated by
the source maximal ideal. -/
theorem exists_generator (f : B ⟶ A) [IsSmallExtension f] :
    ∃ x : B.carrier, x ≠ 0 ∧
      RingHom.ker f.hom.toRingHom = Ideal.span {x} ∧
      ∀ m ∈ maximalIdeal B.carrier, m * x = 0 := sorry

end IsSmallExtension

end ArtinianLocalAlgCat
