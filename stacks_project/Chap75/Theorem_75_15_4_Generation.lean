/-!
# Perfect weak generators of derived quasi-coherent categories

On a quasi-compact quasi-separated algebraic space, the derived category of
modules with quasi-coherent cohomology is generated by a single perfect object.
-/

@[expose] public section

open AlgebraicGeometry AlgebraicGeometry.AlgebraicSpace CategoryTheory

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

namespace DerivedQCoh

/-- If `X` is a quasi-compact and quasi-separated algebraic space over a scheme `S`,
then `D_QCoh(𝒪_X)` has a perfect weak generator. -/
theorem exists_isPerfect_isWeakGenerator {S : Scheme.{u}} {X : AlgebraicSpace S}
    [IsQuasiCompact X] [IsAbsolutelyQuasiSeparated X] :
    ∃ P : DerivedQCoh X, ModuleDerived.IsPerfect P.obj ∧ IsWeakGenerator P := sorry

end DerivedQCoh

end AlgebraicGeometry.AlgebraicSpace
