module

public import Mathlib.RingTheory.Kaehler.Basic
import Mathlib.Tactic.CrossRefAttribute

/-!
# Kaehler differentials in a surjective square

@stack 00RR

This leaf records the kernel of the map on Kaehler differentials induced by a surjective
commutative square.  Mathlib already owns the corresponding surjectivity theorem; the new API
isolates the missing kernel description and its elementwise consequences.
-/

@[expose] public section

universe u v w z

open IsScalarTower (toAlgHom)

namespace KaehlerDifferential

variable {R : Type u} {R' : Type v} {S : Type w} {S' : Type z}
  [CommRing R] [CommRing R'] [CommRing S] [CommRing S']
  [Algebra R S] [Algebra R R'] [Algebra R S'] [Algebra R' S'] [Algebra S S']
  [IsScalarTower R S S'] [IsScalarTower R R' S']

/-- A differential lies in the kernel of the square map when its image comes from the new base
ring.  This implication does not require the map `S → S'` to be surjective. -/
@[stacks 00RR "differentials of pullback elements"]
theorem D_mem_ker_map_of_map_mem_range {a : S}
    (ha : algebraMap S S' a ∈ (toAlgHom R R' S').range) :
    D R S a ∈ LinearMap.ker (map R R' S S') := sorry

/-- Differentials of elements in the kernel of `S → S'` lie in the kernel of the induced map on
Kaehler differentials.  This is the source-facing specialization of the pullback-element API. -/
@[stacks 00RR "differentials of kernel elements"]
theorem D_mem_ker_map_of_mem_ker {i : S}
    (hi : i ∈ RingHom.ker (algebraMap S S')) :
    D R S i ∈ LinearMap.ker (map R R' S S') := sorry

/-- Lemma 10.131.6 (2): for a surjective commutative square, the kernel of the induced map on
Kaehler differentials is generated by the differentials of elements whose image comes from the
new base ring. -/
@[stacks 00RR "(2), kernel description"]
theorem ker_map_eq_span_of_surjective
    (h : Function.Surjective (algebraMap S S')) :
    LinearMap.ker (map R R' S S') =
      Submodule.span S
        (Set.range fun a :
          Subalgebra.comap (toAlgHom R S S') (toAlgHom R R' S').range ↦ D R S a.1) := sorry

end KaehlerDifferential
