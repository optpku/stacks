module

public import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# Evaluation of the Ideal of Variables

This leaf records how the ideal generated by all multivariate variables behaves under polynomial
evaluation.  It keeps the generic span computation out of source-specific presentation proofs.
-/

@[expose] public section

universe u v w

namespace MvPolynomial

variable {A : Type u} {S : Type v} {σ : Type w}
variable [CommSemiring A] [CommSemiring S]

/-- Evaluating all polynomial variables maps their defining ideal onto the ideal generated by the
chosen target elements. -/
theorem map_idealOfVars_eval₂Hom (ι : A →+* S) (x : σ → S) :
    Ideal.map (eval₂Hom ι x) (idealOfVars σ A) = Ideal.span (Set.range x) := sorry

end MvPolynomial
