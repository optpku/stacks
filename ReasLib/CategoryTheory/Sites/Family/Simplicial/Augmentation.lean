module

public import ReasLib.CategoryTheory.Sites.Topos.Cocontinuous
public import ReasLib.CategoryTheory.Sites.Topos.Composition
public import ReasLib.CategoryTheory.Sites.Family.Simplicial
public import ReasLib.CategoryTheory.Sites.Family.Topos
public import ReasLib.CategoryTheory.Sites.Localization.SemiRepresentable
public import ReasLib.CategoryTheory.Sites.Simplicial.Augmentation

/-!
# Localization functors of a simplicial semi-representable object

The obvious forgetful functor `j_total` on `(C / K)_total` is assembled from the
stage localizations `forget (K.obj n)`. The augmentation presenting functors
`u_n = j_0 ∘ u_φ` and `U ↦ u_n(U)` are compared to `j_n` and `j_total` by the
relocalization-forgetful isomorphism `overMap_forget`.
-/

@[expose] public section

universe w v u

open CategoryTheory CategoryTheory.Limits Opposite
open CategoryTheory.GrothendieckTopology.SemiRepresentableLocalization
open scoped Simplicial

noncomputable section

namespace CategoryTheory.SemiRepresentableFamily

variable {C : Type u} [Category.{v} C]
variable (J : GrothendieckTopology C)
variable (K : SimplicialObject (FormalCoproduct.{w} C))

/-- The Grothendieck topology on `(C / K)_total` generated by identity-degree stage
covers. -/
abbrev overSiteTotalTopology :
    GrothendieckTopology (Grothendieck (overSiteDiagram K)) :=
  Grothendieck.topology (overSiteDiagram K) (overSitePrecoverage J K)

/-- The total-site topology is generated by `Grothendieck.precoverage` of the stage
precoverages. -/
theorem overSiteTotalTopology_eq_toGrothendieck :
    overSiteTotalTopology J K =
      (Grothendieck.precoverage (overSiteDiagram K) (overSitePrecoverage J K)).toGrothendieck :=
  rfl

/-- The total localization arrow assigned to an identity is an identity. -/
theorem totalForget_map_id (X : Grothendieck (overSiteDiagram K)) :
    (overMap_forget (K.map (Grothendieck.Hom.base (𝟙 X)))).inv.app X.fiber ≫
        (forget (K.obj X.base)).map (Grothendieck.Hom.fiber (𝟙 X)) =
      𝟙 ((forget (K.obj X.base)).obj X.fiber) :=
  sorry

/-- The total localization arrow assignment preserves composition. -/
theorem totalForget_map_comp {X Y Z : Grothendieck (overSiteDiagram K)}
    (f : X ⟶ Y) (g : Y ⟶ Z) :
    (overMap_forget (K.map (f ≫ g).base)).inv.app X.fiber ≫
        (forget (K.obj Z.base)).map (f ≫ g).fiber =
      ((overMap_forget (K.map f.base)).inv.app X.fiber ≫
        (forget (K.obj Y.base)).map f.fiber) ≫
      ((overMap_forget (K.map g.base)).inv.app Y.fiber ≫
        (forget (K.obj Z.base)).map g.fiber) :=
  sorry

/-- The localization functor `j_total : (C / K)_total ⥤ C`, sending a degree-`n` object
to its image under `forget (K.obj n)`. -/
def totalForget : Grothendieck (overSiteDiagram K) ⥤ C where
  obj X := (forget (K.obj X.base)).obj X.fiber
  map {X Y} f :=
    (overMap_forget (K.map f.base)).inv.app X.fiber ≫
      (forget (K.obj Y.base)).map f.fiber
  map_id := totalForget_map_id K
  map_comp := totalForget_map_comp K

/-- On a degree-`n` object `U`, `totalForget` is localization at `K_n`. -/
theorem totalForget_obj (n : SimplexCategoryᵒᵖ) (U : OverSite (K.obj n)) :
    (totalForget K).obj ⟨n, U⟩ = (forget (K.obj n)).obj U :=
  rfl

/-- The common composite `u_n = j_0 ∘ u_φ` along the constant operator `⦋0⦌ ⟶ n`. -/
def stageForget (n : SimplexCategory) : OverSite (K.obj (op n)) ⥤ C :=
  overMap (K.map (SimplexCategory.const ⦋0⦌ n 0).op) ⋙ forget (K.obj (op ⦋0⦌))

/-- The stage composite `u_n` is isomorphic to localization at `K_n`. -/
def stageForget_iso_forget (n : SimplexCategory) :
    stageForget K n ≅ forget (K.obj (op n)) :=
  overMap_forget (K.map (SimplexCategory.const ⦋0⦌ n 0).op)

/-- The total augmentation arrow assigned to an identity is an identity. -/
theorem augmentationTotalForget_map_id (X : Grothendieck (overSiteDiagram K)) :
    (stageForget_iso_forget K X.base.unop).hom.app X.fiber ≫
        (totalForget K).map (𝟙 X) ≫
        (stageForget_iso_forget K X.base.unop).inv.app X.fiber =
      𝟙 ((stageForget K X.base.unop).obj X.fiber) :=
  sorry

/-- The total augmentation arrow assignment preserves composition. -/
theorem augmentationTotalForget_map_comp {X Y Z : Grothendieck (overSiteDiagram K)}
    (f : X ⟶ Y) (g : Y ⟶ Z) :
    (stageForget_iso_forget K X.base.unop).hom.app X.fiber ≫
        (totalForget K).map (f ≫ g) ≫
        (stageForget_iso_forget K Z.base.unop).inv.app Z.fiber =
      ((stageForget_iso_forget K X.base.unop).hom.app X.fiber ≫
        (totalForget K).map f ≫
        (stageForget_iso_forget K Y.base.unop).inv.app Y.fiber) ≫
      ((stageForget_iso_forget K Y.base.unop).hom.app Y.fiber ≫
        (totalForget K).map g ≫
        (stageForget_iso_forget K Z.base.unop).inv.app Z.fiber) :=
  sorry

/-- The augmentation presenting functor sends a degree-`n` object `U` to `u_n(U)`. -/
def augmentationTotalForget : Grothendieck (overSiteDiagram K) ⥤ C where
  obj X := (stageForget K X.base.unop).obj X.fiber
  map {X Y} f :=
    (stageForget_iso_forget K X.base.unop).hom.app X.fiber ≫
      (totalForget K).map f ≫
      (stageForget_iso_forget K Y.base.unop).inv.app Y.fiber
  map_id := augmentationTotalForget_map_id K
  map_comp := augmentationTotalForget_map_comp K

/-- On a degree-`n` object `U`, `augmentationTotalForget` is `u_n(U)`. -/
theorem augmentationTotalForget_obj (n : SimplexCategory) (U : OverSite (K.obj (op n))) :
    (augmentationTotalForget K).obj ⟨op n, U⟩ = (stageForget K n).obj U :=
  rfl

/-- The stage localization comparison is natural on the total category. -/
theorem augmentationTotalForget_iso_totalForget_naturality
    {X Y : Grothendieck (overSiteDiagram K)} (f : X ⟶ Y) :
    (augmentationTotalForget K).map f ≫
        (stageForget_iso_forget K Y.base.unop).hom.app Y.fiber =
      (stageForget_iso_forget K X.base.unop).hom.app X.fiber ≫
        (totalForget K).map f :=
  sorry

/-- `augmentationTotalForget` is isomorphic to `totalForget` via `overMap_forget` on each
fiber. -/
def augmentationTotalForget_iso_totalForget :
    augmentationTotalForget K ≅ totalForget K :=
  NatIso.ofComponents
    (fun X ↦ (stageForget_iso_forget K X.base.unop).app X.fiber)
    (fun f ↦ augmentationTotalForget_iso_totalForget_naturality K f)

/-- The localization `j_total` is continuous for the total topology. -/
instance totalForget_isContinuous :
    (totalForget K).IsContinuous (overSiteTotalTopology J K) J :=
  sorry

/-- The localization `j_total` is cocontinuous for the total topology. -/
instance totalForget_isCocontinuous :
    (totalForget K).IsCocontinuous (overSiteTotalTopology J K) J :=
  sorry

/-- The stage composite `u_n` is continuous. -/
instance stageForget_isContinuous (n : SimplexCategory) :
    (stageForget K n).IsContinuous (overTopology J (K.obj (op n))) J :=
  sorry

/-- The stage composite `u_n` is cocontinuous. -/
instance stageForget_isCocontinuous (n : SimplexCategory) :
    (stageForget K n).IsCocontinuous (overTopology J (K.obj (op n))) J :=
  sorry

/-- The total augmentation presenting functor is continuous. -/
instance augmentationTotalForget_isContinuous :
    (augmentationTotalForget K).IsContinuous (overSiteTotalTopology J K) J :=
  sorry

/-- The total augmentation presenting functor is cocontinuous. -/
instance augmentationTotalForget_isCocontinuous :
    (augmentationTotalForget K).IsCocontinuous (overSiteTotalTopology J K) J :=
  sorry

/-- Forgetting after relocalization gives the same composite for any two
zero-simplex operators. -/
theorem forget_comp_overMap_eq {n : SimplexCategory} (φ ψ : ⦋0⦌ ⟶ n) :
    overMap (K.map φ.op) ⋙ forget (K.obj (op ⦋0⦌)) =
      overMap (K.map ψ.op) ⋙ forget (K.obj (op ⦋0⦌)) :=
  sorry

/-- Degree-zero localization is an augmentation for the selected localization covers. -/
instance forget_isAugmentation (P : Precoverage C) [P.IsSite] :
    Grothendieck.IsAugmentation (overSiteDiagram K) (overSiteSelectedPrecoverage P K) P
      (forget (K.obj (op ⦋0⦌))) where
  isCocontinuous := by
    have h_lifts := forget_hasCoverLifts P (K.obj (op ⦋0⦌))
    sorry
  map_eq φ ψ := forget_comp_overMap_eq K φ ψ

/-- The stage localization composite is the stage functor of the degree-zero augmentation. -/
theorem stageForget_eq_stageFunctor (n : SimplexCategory) :
    stageForget K n = Grothendieck.IsAugmentation.stageFunctor (overSiteDiagram K)
      (forget (K.obj (op ⦋0⦌))) n :=
  rfl

section StageTopos

variable [∀ n : SimplexCategoryᵒᵖ, HasSheafify (overTopology J (K.obj n)) (Type (max w u v))]
variable [∀ (n : SimplexCategory) (P : (OverSite (K.obj (op n)))ᵒᵖ ⥤ Type (max w u v)),
  (stageForget K n).op.HasPointwiseRightKanExtension P]

/-- The morphism of topoi `a_n : Sh(C / K_n) ⟶ Sh(C)` presented by the common composite
`u_n`. -/
def stageTopos (n : SimplexCategory) :
    MorphismOfTopoiIn J (overTopology J (K.obj (op n))) :=
  (stageForget K n).morphismOfTopoiInOfCocontinuous (overTopology J (K.obj (op n))) J

/-- Inverse image of `stageTopos` is cocontinuous sheaf pullback along `u_n`. -/
theorem stageTopos_inverseImage (n : SimplexCategory) :
    (stageTopos J K n).inverseImage =
      (stageForget K n).sheafPullbackCocontinuous (Type (max w u v))
        (overTopology J (K.obj (op n))) J :=
  rfl

/-- Direct image of `stageTopos` is cocontinuous sheaf pushforward along `u_n`. -/
theorem stageTopos_pushforward (n : SimplexCategory) :
    (stageTopos J K n).pushforward =
      (stageForget K n).sheafPushforwardCocontinuous (Type (max w u v))
        (overTopology J (K.obj (op n))) J :=
  rfl

variable [∀ (n : SimplexCategoryᵒᵖ) (P : (OverSite (K.obj n))ᵒᵖ ⥤ Type (max w u v)),
  (forget (K.obj n)).op.HasPointwiseRightKanExtension P]

/-- The stage augmentation and localization have canonically isomorphic direct images. -/
def stageTopos_iso_localizationMorphism (n : SimplexCategory) :
    (stageTopos J K n).pushforward ≅
      (localizationMorphism J (K.obj (op n))).pushforward :=
  Functor.sheafPushforwardCocontinuousIso
    (overTopology J (K.obj (op n))) J (stageForget K n) (stageForget_iso_forget K n)

/-- The stage inverse-image comparison is the mate of the direct-image comparison
under the displayed geometric adjunctions. -/
def stageTopos_inverseImage_iso_localizationMorphism (n : SimplexCategory) :
    (stageTopos J K n).inverseImage ≅
      (localizationMorphism J (K.obj (op n))).inverseImage :=
  Adjunction.leftAdjointUniq
    ((stageTopos J K n).adjunction.ofNatIsoRight (stageTopos_iso_localizationMorphism J K n))
    (localizationMorphism J (K.obj (op n))).adjunction

end StageTopos

section TotalTopos

variable [HasSheafify (overSiteTotalTopology J K) (Type (max w u v))]

section

variable [∀ P : (Grothendieck (overSiteDiagram K))ᵒᵖ ⥤ Type (max w u v),
  (augmentationTotalForget K).op.HasPointwiseRightKanExtension P]

/-- The morphism of topoi `a : Sh((C / K)_total) ⟶ Sh(C)` presented by
`augmentationTotalForget`. -/
def totalTopos : MorphismOfTopoiIn J (overSiteTotalTopology J K) :=
  (augmentationTotalForget K).morphismOfTopoiInOfCocontinuous (overSiteTotalTopology J K) J

/-- Inverse image of `totalTopos` is cocontinuous sheaf pullback along
`augmentationTotalForget`. -/
theorem totalTopos_inverseImage :
    (totalTopos J K).inverseImage =
      (augmentationTotalForget K).sheafPullbackCocontinuous (Type (max w u v))
        (overSiteTotalTopology J K) J :=
  rfl

/-- Direct image of `totalTopos` is cocontinuous sheaf pushforward along
`augmentationTotalForget`. -/
theorem totalTopos_pushforward :
    (totalTopos J K).pushforward =
      (augmentationTotalForget K).sheafPushforwardCocontinuous (Type (max w u v))
        (overSiteTotalTopology J K) J :=
  rfl

end

variable [∀ P : (Grothendieck (overSiteDiagram K))ᵒᵖ ⥤ Type (max w u v),
  (totalForget K).op.HasPointwiseRightKanExtension P]

/-- The morphism of topoi associated to the continuous and cocontinuous functor
`j_total`. -/
def totalLocalization : MorphismOfTopoiIn J (overSiteTotalTopology J K) :=
  (totalForget K).morphismOfTopoiInOfCocontinuous (overSiteTotalTopology J K) J

/-- Inverse image of `totalLocalization` is cocontinuous sheaf pullback along
`j_total`. -/
theorem totalLocalization_inverseImage :
    (totalLocalization J K).inverseImage =
      (totalForget K).sheafPullbackCocontinuous (Type (max w u v))
        (overSiteTotalTopology J K) J :=
  rfl

/-- Direct image of `totalLocalization` is cocontinuous sheaf pushforward along
`j_total`. -/
theorem totalLocalization_pushforward :
    (totalLocalization J K).pushforward =
      (totalForget K).sheafPushforwardCocontinuous (Type (max w u v))
        (overSiteTotalTopology J K) J :=
  rfl

variable [∀ P : (Grothendieck (overSiteDiagram K))ᵒᵖ ⥤ Type (max w u v),
  (augmentationTotalForget K).op.HasPointwiseRightKanExtension P]

/-- The total augmentation and localization have canonically isomorphic direct images. -/
def totalTopos_iso_totalLocalization :
    (totalTopos J K).pushforward ≅ (totalLocalization J K).pushforward :=
  Functor.sheafPushforwardCocontinuousIso
    (overSiteTotalTopology J K) J (augmentationTotalForget K)
    (augmentationTotalForget_iso_totalForget K)

/-- The total inverse-image comparison is the mate of the direct-image comparison
under the displayed geometric adjunctions. -/
def totalTopos_inverseImage_iso_totalLocalization :
    (totalTopos J K).inverseImage ≅ (totalLocalization J K).inverseImage :=
  Adjunction.leftAdjointUniq
    ((totalTopos J K).adjunction.ofNatIsoRight (totalTopos_iso_totalLocalization J K))
    (totalLocalization J K).adjunction

end TotalTopos

end CategoryTheory.SemiRepresentableFamily
