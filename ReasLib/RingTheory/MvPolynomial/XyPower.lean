module

public import Mathlib.Algebra.Algebra.Equiv
public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Data.Fin.VecNotation
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Noetherian.Defs
public import Mathlib.RingTheory.Spectrum.Prime.Topology

/-!
# The monomial subalgebra generated by `x y^i`

The subalgebra generated by these monomials has an explicit localization comparison
away from `x`. Over a field, its unique prime containing `x` is not finitely generated.
-/

@[expose] public section

universe u

noncomputable section

namespace MvPolynomial.XyPower

/-- The monomials `x y^i` in the polynomial ring in two variables. -/
def monomials (k : Type u) [CommRing k] : Set (MvPolynomial (Fin 2) k) :=
  Set.range fun i : ℕ ↦ MvPolynomial.X 0 * MvPolynomial.X 1 ^ i

/-- The `k`-subalgebra generated by `x y^i` for all natural numbers `i`. -/
def adjoin (k : Type u) [CommRing k] : Subalgebra k (MvPolynomial (Fin 2) k) :=
  Algebra.adjoin k (monomials k)

/-- The monomial `x y^i` as an element of the generated subalgebra. -/
def gen (k : Type u) [CommRing k] (i : ℕ) : adjoin k :=
  ⟨MvPolynomial.X 0 * MvPolynomial.X 1 ^ i, Algebra.subset_adjoin (Set.mem_range_self i)⟩

/-- The distinguished generator `x = x y^0` in the generated subalgebra. -/
def X (k : Type u) [CommRing k] : adjoin k :=
  gen k 0

/-- The ideal spanned by the generators `x y^i` in the generated subalgebra. -/
def ideal (k : Type u) [CommRing k] : Ideal (adjoin k) :=
  Ideal.span (Set.range (gen k))

/-- A polynomial belongs to the generating set exactly when it is some `x y^i`. -/
theorem mem_monomials {k : Type u} [CommRing k] {f : MvPolynomial (Fin 2) k} :
    f ∈ monomials k ↔ ∃ i : ℕ, f = MvPolynomial.X 0 * MvPolynomial.X 1 ^ i := sorry

/-- The underlying polynomial of the internal generator is `x y^i`. -/
theorem gen_val (k : Type u) [CommRing k] (i : ℕ) :
    (gen k i : MvPolynomial (Fin 2) k) = MvPolynomial.X 0 * MvPolynomial.X 1 ^ i := sorry

/-- The underlying polynomial of the distinguished generator is `x`. -/
theorem X_eq (k : Type u) [CommRing k] :
    (X k : MvPolynomial (Fin 2) k) = MvPolynomial.X 0 := sorry

/-- The distinguished generator lies in the ideal spanned by all generators. -/
theorem X_mem_ideal (k : Type u) [CommRing k] : X k ∈ ideal k := sorry

/-- Localization of the polynomial ring away from `x` also localizes away from
the image of the distinguished subalgebra generator. -/
instance instIsLocalizationAway_valX {k : Type u} [CommRing k] :
    IsLocalization.Away (algebraMap (adjoin k) (MvPolynomial (Fin 2) k) (X k))
      (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 2) k)) := sorry

/-- The algebra homomorphism between localizations away from `x` induced by
the inclusion of the monomial subalgebra into the polynomial ring. -/
def awayTo (k : Type u) [CommRing k] :
    Localization.Away (X k) →ₐ[k]
      Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 2) k) where
  toRingHom :=
    IsLocalization.Away.map (Localization.Away (X k))
      (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 2) k))
      (algebraMap (adjoin k) (MvPolynomial (Fin 2) k)) (X k)
  commutes' := sorry

/-- The coordinate assignment `x ↦ x`, `y ↦ (x y) * x⁻¹` in the localized
monomial subalgebra. -/
def awayFromVals (k : Type u) [CommRing k] :
    Fin 2 → Localization.Away (X k) :=
  ![algebraMap (adjoin k) (Localization.Away (X k)) (X k),
    algebraMap (adjoin k) (Localization.Away (X k)) (gen k 1) *
      IsLocalization.Away.invSelf (X k)]

/-- Polynomial evaluation at `x` and `(x y) * x⁻¹` in the localized monomial subalgebra. -/
def awayFromBase (k : Type u) [CommRing k] :
    MvPolynomial (Fin 2) k →ₐ[k] Localization.Away (X k) :=
  MvPolynomial.aeval (awayFromVals k)

/-- The algebra homomorphism from the localized polynomial ring to the localized
monomial subalgebra sending `x ↦ x` and `y ↦ (x y) * x⁻¹`. -/
def awayFrom (k : Type u) [CommRing k] :
    Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 2) k) →ₐ[k]
      Localization.Away (X k) where
  toRingHom :=
    Localization.awayLift (awayFromBase k) (MvPolynomial.X 0)
      (Eq.mp (congrArg IsUnit (MvPolynomial.aeval_X (awayFromVals k) (0 : Fin 2)).symm)
        (IsLocalization.Away.algebraMap_isUnit (X k) :
          IsUnit (algebraMap (adjoin k) (Localization.Away (X k)) (X k))))
  commutes' := sorry

/-- Evaluation followed by inclusion is the identity on the localized polynomial ring. -/
theorem awayTo_comp_awayFrom (k : Type u) [CommRing k] :
    (awayTo k).comp (awayFrom k) = AlgHom.id k _ := sorry

/-- Inclusion followed by evaluation is the identity on the localized monomial subalgebra. -/
theorem awayFrom_comp_awayTo (k : Type u) [CommRing k] :
    (awayFrom k).comp (awayTo k) = AlgHom.id k _ := sorry

/-- The monomial subalgebra localized away from `x` is algebra equivalent to
the polynomial ring in two variables localized away from `x`. -/
def awayEquiv (k : Type u) [CommRing k] :
    Localization.Away (X k) ≃ₐ[k]
      Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 2) k) :=
  AlgEquiv.ofAlgHom (awayTo k) (awayFrom k)
    (awayTo_comp_awayFrom k) (awayFrom_comp_awayTo k)

/-- The forward comparison sends the image of the distinguished generator
to the image of the polynomial `x`. -/
theorem awayTo_algebraMap (k : Type u) [CommRing k] :
    awayTo k (algebraMap (adjoin k) (Localization.Away (X k)) (X k)) =
      algebraMap (MvPolynomial (Fin 2) k)
        (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 2) k))
        (MvPolynomial.X 0) := sorry

/-- The localization equivalence sends the image of the distinguished generator
to the image of the polynomial `x`. -/
theorem awayEquiv_apply (k : Type u) [CommRing k] :
    awayEquiv k (algebraMap (adjoin k) (Localization.Away (X k)) (X k)) =
      algebraMap (MvPolynomial (Fin 2) k)
        (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 2) k))
        (MvPolynomial.X 0) := sorry

/-- A prime ideal containing `x` contains every generator `x y^i`. -/
theorem gen_mem_of_X_mem {k : Type u} [CommRing k] {p : Ideal (adjoin k)} [p.IsPrime]
    (hx : X k ∈ p) (i : ℕ) : gen k i ∈ p := sorry

/-- Over a field, the ideal spanned by all monomial generators is prime. -/
instance instIsPrime_ideal {k : Type u} [Field k] : (ideal k).IsPrime := sorry

/-- Over a field, the unique prime ideal containing `x` is the ideal spanned
by all monomial generators. -/
theorem prime_containing_X_eq {k : Type u} [Field k] {p : Ideal (adjoin k)} [p.IsPrime] :
    X k ∈ p ↔ p = ideal k := sorry

/-- Over a field, the ideal spanned by all monomial generators is not finitely generated. -/
theorem not_fg_ideal {k : Type u} [Field k] : ¬ (ideal k).FG := sorry

/-- Over a field, the monomial subalgebra generated by `x y^i` is not a Noetherian ring. -/
theorem not_isNoetherianRing {k : Type u} [Field k] :
    ¬ IsNoetherianRing (adjoin k) := sorry

/-- Primes of the localization away from `x` correspond bijectively to primes
of the monomial subalgebra not containing `x`. -/
theorem primeSpectrum_comap_away_bijOn {k : Type u} [Field k] :
    Set.BijOn (PrimeSpectrum.comap (algebraMap (adjoin k) (Localization.Away (X k))))
      Set.univ (PrimeSpectrum.basicOpen (X k)) := sorry

end MvPolynomial.XyPower
