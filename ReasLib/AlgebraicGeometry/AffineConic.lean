module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Algebra.Polynomial.Basic
public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.Data.Complex.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations

@[expose] public section

noncomputable section

open AlgebraicGeometry CategoryTheory

namespace AlgebraicGeometry.AffineConicOverLine

/-- The polynomial ring `Polynomial ℂ`, corresponding to the coordinate ring of
`S = Spec(ℂ[t])`. -/
abbrev BaseRing : Type :=
  Polynomial ℂ

/-- The affine line `S = Spec(Polynomial ℂ)`. -/
abbrev base : Scheme :=
  Spec (CommRingCat.of BaseRing)

/-- The hypersurface polynomial `A + B * x ^ 2 + C * y ^ 2` in
`MvPolynomial (Fin 2) (Polynomial ℂ)`, with `MvPolynomial.X 0` corresponding to
`x` and `MvPolynomial.X 1` corresponding to `y`. -/
def equation (A B C : Polynomial ℂ) : MvPolynomial (Fin 2) (Polynomial ℂ) :=
  MvPolynomial.C A + MvPolynomial.C B * MvPolynomial.X 0 ^ 2 +
    MvPolynomial.C C * MvPolynomial.X 1 ^ 2

/-- Unfolding of `equation` as the displayed polynomial
`A + B * x ^ 2 + C * y ^ 2`. -/
theorem equation_spec (A B C : Polynomial ℂ) :
    equation A B C =
      MvPolynomial.C A + MvPolynomial.C B * MvPolynomial.X 0 ^ 2 +
        MvPolynomial.C C * MvPolynomial.X 1 ^ 2 :=
  sorry

/-- The principal ideal generated by `equation A B C`. -/
def equationIdeal (A B C : Polynomial ℂ) :
    Ideal (MvPolynomial (Fin 2) (Polynomial ℂ)) :=
  Ideal.span {equation A B C}

/-- `equationIdeal A B C` is the principal ideal generated by `equation A B C`. -/
theorem equationIdeal_span (A B C : Polynomial ℂ) :
    equationIdeal A B C = Ideal.span {equation A B C} :=
  sorry

/-- The coordinate ring of the affine hypersurface
`total A B C`, namely the quotient of `MvPolynomial (Fin 2) (Polynomial ℂ)` by
`equationIdeal A B C`. -/
abbrev coordinateRing (A B C : Polynomial ℂ) : Type :=
  MvPolynomial (Fin 2) (Polynomial ℂ) ⧸ equationIdeal A B C

/-- The affine hypersurface `X = Spec (CommRingCat.of (coordinateRing A B C))`. -/
abbrev total (A B C : Polynomial ℂ) : Scheme :=
  Spec (CommRingCat.of (coordinateRing A B C))

/-- The structure map `Polynomial ℂ →+* coordinateRing A B C` obtained by
inserting coefficients via `MvPolynomial.C` and then quotienting by
`equationIdeal A B C`. -/
def structureRingHom (A B C : Polynomial ℂ) :
    Polynomial ℂ →+* coordinateRing A B C :=
  (Ideal.Quotient.mk (equationIdeal A B C)).comp MvPolynomial.C

/-- The morphism `π : X ⟶ S` induced by `structureRingHom A B C`. -/
def toBase (A B C : Polynomial ℂ) : total A B C ⟶ base :=
  Spec.map (CommRingCat.ofHom (structureRingHom A B C))

/-- `toBase A B C` is the spectrum of `structureRingHom A B C`. -/
theorem toBase_spec (A B C : Polynomial ℂ) :
    toBase A B C = Spec.map (CommRingCat.ofHom (structureRingHom A B C)) :=
  sorry

/-- If `A`, `B`, and `C` are nonzero polynomials in `Polynomial ℂ`, the morphism
`toBase A B C : total A B C ⟶ base` admits a section over some nonempty open
`U ⊆ base`. -/
theorem exists_rational_section (A B C : Polynomial ℂ)
    (hA : A ≠ 0) (hB : B ≠ 0) (hC : C ≠ 0) :
    ∃ U : base.Opens, Nonempty U ∧
      ∃ σ : U.toScheme ⟶ total A B C, σ ≫ toBase A B C = U.ι :=
  sorry

end AlgebraicGeometry.AffineConicOverLine
