    (M : DerivedTensor.Right.Monoidal.Model (C := C))
    (K : DerivedCategory C) {L₁ L₂ : DerivedCategory C} (g : L₁ ⟶ L₂)
    (N : DerivedCategory C) [DerivedTensor.Right.Has (C := C)] :
    CommSq
      ((DerivedTensor.Right.functor ((MonoidalClosed.ihomOf H K).obj L₁)).map
        ((MonoidalClosed.preOf H g).app N))
      ((tensorMapOf H M ((MonoidalClosed.ihomOf H K).map g)).app
        ((MonoidalClosed.ihomOf H L₂).obj N))
      (compOf H M K L₁ N)
      (compOf H M K L₂ N) := by
  refine ⟨?_⟩
  dsimp only [compOf]
  rw [M.objIsoTensor_naturality_assoc ((H.ihomOf K).obj L₁) ((H.preOf g).app N)]
  rw [tensorMapOf_objIsoTensor_assoc H M ((H.ihomOf K).map g) ((H.ihomOf L₂).obj N)]
  rw [cancel_epi]
