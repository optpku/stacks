module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.RingTheory.Ideal.Maps

@[expose] public section

universe u v

namespace MvPolynomial

variable {R : Type u} [CommRing R]

/-- The contraction of an ideal `m` of `R` along `constantCoeff`. -/
noncomputable def spanMapCX (σ : Type v) (m : Ideal R) : Ideal (MvPolynomial σ R) :=
  m.comap (constantCoeff : MvPolynomial σ R →+* R)

/-- A multivariate polynomial belongs to `spanMapCX σ m` exactly when its constant coefficient
belongs to `m`. -/
theorem mem_spanMapCX {σ : Type v} {m : Ideal R} {p : MvPolynomial σ R} :
    p ∈ spanMapCX σ m ↔ constantCoeff p ∈ m :=
  Iff.rfl

/-- The origin ideal is generated by the image of `m` under `C` and all variables. -/
theorem spanMapCX_eq_mapC_sup_rangeX (σ : Type v) (m : Ideal R) :
    spanMapCX σ m = m.map C ⊔ Ideal.span (Set.range (X : σ → MvPolynomial σ R)) :=
  sorry

/-- An ideal contains `spanMapCX σ m` exactly when it contains the coefficient generators and all
variables. -/
theorem spanMapCX_le_iff {σ : Type v} {m : Ideal R} {I : Ideal (MvPolynomial σ R)} :
    spanMapCX σ m ≤ I ↔ m.map C ≤ I ∧ ∀ i, X i ∈ I :=
  sorry

/-- The origin ideal is maximal whenever the coefficient ideal is maximal. -/
instance spanMapCX.isMaximal {σ : Type v} (m : Ideal R) [m.IsMaximal] :
    (spanMapCX σ m).IsMaximal :=
  Ideal.comap_isMaximal_of_surjective (constantCoeff : MvPolynomial σ R →+* R)
    (fun r ↦ ⟨C r, constantCoeff_C σ r⟩)

end MvPolynomial
