module

public import ReasLib.AlgebraicGeometry.Scheme.Morphism.UniversalHomeomorphism.Seminormalization.Affine

/-!
# Localization of affine seminormalizations

This module records compatibility of maximal seminormalization subalgebras with localization.
-/

@[expose] public section

universe u

namespace AlgebraicGeometry.UniversalHomeomorphism

variable {A B Aₛ Bₛ : Type u} [CommRing A] [CommRing B] [CommRing Aₛ] [CommRing Bₛ]
variable [Algebra A B] {S : Submonoid A} [Algebra A Aₛ] [IsLocalization S Aₛ]
variable [Algebra B Bₛ] [IsLocalization (Algebra.algebraMapSubmonoid B S) Bₛ]
variable [Algebra Aₛ Bₛ]
variable [Algebra A Bₛ] [IsScalarTower A B Bₛ] [IsScalarTower A Aₛ Bₛ]

/-- Maximal seminormalization subalgebras of a dominant affine ring map commute with
localization: the localized subalgebra is generated by the image of the original subalgebra. -/
theorem maximalSeminormalizationSubalgebra_localization_eq
    (hAB : IsDominant (Spec.map (CommRingCat.ofHom (algebraMap A B))))
    (B' : Subalgebra A B) (hB' : IsMaximalSeminormalizationSubalgebra B')
    (Bₛ' : Subalgebra Aₛ Bₛ) (hBₛ' : IsMaximalSeminormalizationSubalgebra Bₛ') :
    Algebra.adjoin Aₛ ((algebraMap B Bₛ) '' (B' : Set B)) = Bₛ' := sorry

end AlgebraicGeometry.UniversalHomeomorphism
