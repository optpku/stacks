module

public import Mathlib.Algebra.DirectSum.Decomposition
public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Submodule
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Homogeneous spans of graded modules

This leaf owns the statement that a submodule generated by homogeneous elements is homogeneous.
That construction genuinely uses the scalar grading and the graded scalar action.  The
finite-generation consequences that only use a module decomposition live in `Span.Finite`.
-/

@[expose] public section

noncomputable section

universe uιA uιM uA uM uσA uσ

namespace Submodule

variable {ιA : Type uιA} {ιM : Type uιM} [VAdd ιA ιM]
variable {A : Type uA} [Semiring A] {σA : Type uσA} [SetLike σA A]
variable [AddSubmonoidClass σA A]
variable {M : Type uM} [AddCommMonoid M] [Module A M]
variable {σ : Type uσ} [SetLike σ M] [AddSubmonoidClass σ M]

/-- The span of homogeneous module elements is homogeneous for a compatible internally graded
scalar action. -/
@[stacks 052N "span of homogeneous module elements"]
theorem homogeneous_span
    (𝒜 : ιA → σA) (ℳ : ιM → σ)
    [DecidableEq ιA] [DecidableEq ιM]
    [DirectSum.Decomposition 𝒜] [DirectSum.Decomposition ℳ]
    [SetLike.GradedSMul 𝒜 ℳ]
    {t : Set M} (ht : ∀ x ∈ t, SetLike.IsHomogeneousElem ℳ x) :
    (Submodule.span A t).IsHomogeneous ℳ := sorry

/-- The top submodule is homogeneous for every direct-sum decomposition. -/
@[stacks 052N "homogeneous top submodule"]
theorem IsHomogeneous.top
    (ℳ : ιM → σ) [DecidableEq ιM] [DirectSum.Decomposition ℳ] :
    (⊤ : Submodule A M).IsHomogeneous ℳ := sorry

end Submodule

end
