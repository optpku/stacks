module

public import Mathlib.AlgebraicGeometry.Sites.Fpqc

/-!
# The fpqc pretopology on schemes

This module names the pretopology generated by flat, quasi-compact,
jointly-surjective covering families of schemes.
-/

@[expose] public section

universe u

namespace AlgebraicGeometry.Scheme

/-- The fpqc pretopology on schemes generated by the canonical fpqc precoverage. -/
def fpqcPretopology : CategoryTheory.Pretopology Scheme.{u} :=
  fpqcPrecoverage.toPretopology

end AlgebraicGeometry.Scheme
