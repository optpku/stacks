module

public import ReasLib.AlgebraicGeometry.RingedSpace.DeRham.PuncturedLineBundle.Geometry
public import ReasLib.Algebra.Category.ModuleCat.Sheaf.GeneratedSubobject

@[expose] public section

open CategoryTheory Opposite AlgebraicGeometry
open scoped BigOperators

noncomputable section

universe u

namespace AlgebraicGeometry.RingedSpace.DeRham.PuncturedLineBundle

variable {S X : Scheme.{u}} (f : X ⟶ S) (ℒ : X.Modules)
variable [Scheme.Modules.Invertible ℒ]
variable (P : Scheme.RelativeSpectrumOver (Scheme.SymmetricAlgebra.qcAlgebra ℒ))
variable [Scheme.IsRelativeSpectrumOver P]

/-- Pullback of a coefficient, with its actual inverse-image open made explicit. -/
def coefficientPullback {Y : Scheme.{u}} (q : Y ⟶ X) (U : X.Opens)
    (a : X.presheaf.obj (op U)) : Y.presheaf.obj (op (q ⁻¹ᵁ U)) :=
  q.c.app (op U) a

/-- Homogeneous polynomial functions: sums of products of exactly `n` linear functions
with coefficients pulled back from the base. -/
def totalFunctionWeight (U : X.Opens) (n : ℕ) :
    AddSubgroup (P.scheme.presheaf.obj (op (P.π ⁻¹ᵁ U))) :=
  AddSubgroup.closure {b | ∃ (a : X.presheaf.obj (op U))
    (s : Fin n → ℒ.val.obj (op U)),
    b = coefficientPullback P.π U a * ∏ i, totalTautological ℒ P U (s i)}

/-- Homogeneous Laurent functions on the punctured bundle. Denominators are powers
of invertible *tautological linear functions*, never arbitrary units of unspecified weight.
Taking sections over all base opens below sheaf-locally generates every homogeneous form. -/
def puncturedFunctionWeight (U : X.Opens) (n : ℤ) :
    AddSubgroup ((puncturedOpen ℒ P).toScheme.presheaf.obj
      (op (puncturedProjection ℒ P ⁻¹ᵁ U))) :=
  AddSubgroup.closure {b | ∃ (l k : ℕ) (a : X.presheaf.obj (op U))
    (s : Fin l → ℒ.val.obj (op U)) (t : ℒ.val.obj (op U))
    (v : Units ((puncturedOpen ℒ P).toScheme.presheaf.obj
      (op (puncturedProjection ℒ P ⁻¹ᵁ U)))),
    (l : ℤ) - k = n ∧ v.val = puncturedTautological ℒ P U t ∧
    b = coefficientPullback (puncturedProjection ℒ P) U a *
      (∏ i, puncturedTautological ℒ P U (s i)) * (v⁻¹).val ^ k}

omit [Scheme.IsRelativeSpectrumOver P] in
/-- Every explicit polynomial monomial has the prescribed weight. -/
theorem totalFunctionWeight_monomial (U : X.Opens) (n : ℕ)
    (a : X.presheaf.obj (op U)) (s : Fin n → ℒ.val.obj (op U)) :
    coefficientPullback P.π U a * (∏ i, totalTautological ℒ P U (s i)) ∈
      totalFunctionWeight ℒ P U n :=
  AddSubgroup.subset_closure ⟨a, s, rfl⟩

omit [Scheme.IsRelativeSpectrumOver P] in
/-- Pulled-back coefficients have weight zero without any assertion about comparison maps. -/
theorem totalFunctionWeight_coefficient (U : X.Opens) (a : X.presheaf.obj (op U)) :
    coefficientPullback P.π U a ∈ totalFunctionWeight ℒ P U 0 := by
  simpa only [Fin.prod_univ_zero, mul_one] using
    totalFunctionWeight_monomial ℒ P U 0 a (fun i => Fin.elim0 i)

/-- A Laurent monomial has weight numerator-degree minus denominator-degree only when
its denominator is certified to be an actual tautological linear function. -/
theorem puncturedFunctionWeight_monomial (U : X.Opens) (l k : ℕ)
    (a : X.presheaf.obj (op U)) (s : Fin l → ℒ.val.obj (op U))
    (t : ℒ.val.obj (op U))
    (v : Units ((puncturedOpen ℒ P).toScheme.presheaf.obj
      (op (puncturedProjection ℒ P ⁻¹ᵁ U))))
    (hv : v.val = puncturedTautological ℒ P U t) :
    coefficientPullback (puncturedProjection ℒ P) U a *
      (∏ i, puncturedTautological ℒ P U (s i)) * (v⁻¹).val ^ k ∈
        puncturedFunctionWeight ℒ P U ((l : ℤ) - k) :=
  AddSubgroup.subset_closure ⟨l, k, a, s, t, v, rfl, hv, rfl⟩

/-- All local basic forms with homogeneous factors whose weights sum to `n`.
The functions are data; the degree certificates do not choose any form or map. -/
def HomogeneousGenerator {Y : Scheme.{u}} (q : Y ⟶ X)
    (W : ∀ U : X.Opens, ℤ → Set (Y.presheaf.obj (op (q ⁻¹ᵁ U))))
    (p : ℕ) (n : ℤ) :=
  Σ U : X.Opens, {b : Fin (p + 1) → Y.presheaf.obj (op (q ⁻¹ᵁ U)) //
    ∃ d : Fin (p + 1) → ℤ, (∀ i, b i ∈ W U (d i)) ∧ ∑ i, d i = n}

/-- The actual differential form `b₀ db₁ ∧ ⋯ ∧ dbₚ` attached to homogeneous functions. -/
def homogeneousGeneratorSection {Y : Scheme.{u}} (q : Y ⟶ X)
    (W : ∀ U : X.Opens, ℤ → Set (Y.presheaf.obj (op (q ⁻¹ᵁ U))))
    (p : ℕ) (n : ℤ) (g : HomogeneousGenerator q W p n) :
    ((Scheme.Modules.pushforward q).obj
      (RingedSpace.DeRham.form (q ≫ f).toShHom p)).val.obj (op g.1) :=
  SheafOfModules.RingedSite.DeRham.basicForm
    (RingedSpace.DeRham.structureMap (q ≫ f).toShHom) p (op (q ⁻¹ᵁ g.1))
    (g.2.val 0) (fun i => g.2.val i.succ)

/-- The canonical subobject generated by actual homogeneous local differential forms. -/
def homogeneousPiece {Y : Scheme.{u}} (q : Y ⟶ X)
    (W : ∀ U : X.Opens, ℤ → Set (Y.presheaf.obj (op (q ⁻¹ᵁ U))))
    (p : ℕ) (n : ℤ) : Subobject ((Scheme.Modules.pushforward q).obj
      (RingedSpace.DeRham.form (q ≫ f).toShHom p)) :=
  SheafOfModules.Subobject.generatedBySections _
    (fun g : HomogeneousGenerator q W p n => g.1)
    (homogeneousGeneratorSection f q W p n)

/-- Total-space function weights viewed with integer indices; negative weights vanish. -/
def totalFunctionWeightInt (U : X.Opens) (n : ℤ) :
    Set (P.scheme.presheaf.obj (op (P.π ⁻¹ᵁ U))) :=
  if 0 ≤ n then totalFunctionWeight ℒ P U n.toNat else {0}

/-- Canonical homogeneous punctured forms, with no caller-supplied grading. -/
def puncturedPiece (p : ℕ) (n : ℤ) : Subobject (puncturedAmbientForm f ℒ P p).obj :=
  homogeneousPiece f (puncturedProjection ℒ P)
    (fun U n => puncturedFunctionWeight ℒ P U n) p n

/-- Canonical homogeneous total-space forms. -/
def totalPiece (p n : ℕ) : Subobject (totalAmbientForm f ℒ P p).obj :=
  homogeneousPiece f P.π (totalFunctionWeightInt ℒ P) p n

/-- Homogeneous polynomial forms are quasi-coherent, as checked in a line trivialization. -/
theorem totalPiece_isQuasicoherent (p n : ℕ) :
    (totalPiece f ℒ P p n : X.Modules).IsQuasicoherent := sorry

/-- Homogeneous Laurent forms are quasi-coherent, as checked in a line trivialization. -/
theorem puncturedPiece_isQuasicoherent (p : ℕ) (n : ℤ) :
    (puncturedPiece f ℒ P p n : X.Modules).IsQuasicoherent := sorry

/-- The weight-`n` punctured module with its quasi-coherence certificate. -/
def puncturedForm (p : ℕ) (n : ℤ) : Scheme.QCoh X :=
  ⟨puncturedPiece f ℒ P p n, puncturedPiece_isQuasicoherent f ℒ P p n⟩

/-- The weight-`n` total-space module with its quasi-coherence certificate. -/
def totalForm (p n : ℕ) : Scheme.QCoh X :=
  ⟨totalPiece f ℒ P p n, totalPiece_isQuasicoherent f ℒ P p n⟩

end AlgebraicGeometry.RingedSpace.DeRham.PuncturedLineBundle
