module

public import Mathlib.Algebra.MvPolynomial.Monad
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import ReasLib.RingTheory.Ideal.AssociatedPrime.Weak
public import Mathlib.Tactic.CrossRefAttribute

/-!
# A counterexample for weakly associated primes under restriction of scalars

@stack 05C5

The source and target below encode the explicit counterexample from Remark
10.66.10.  The ring map is named data rather than a hidden local algebra
instance, and the mathematical properties of the example are exposed as
atomic statements.
-/

@[expose] public section

universe u

noncomputable section

namespace PairwiseZeroProduct

/-- The source polynomial ring `k[x₁, x₂, …]` of the counterexample. -/
abbrev Source (k : Type u) [CommRing k] := MvPolynomial ℕ k

/-- The ideal generated by the relations `xᵢ yᵢ` in the two-family polynomial ring. -/
def relationIdeal (k : Type u) [CommRing k] :
    Ideal (MvPolynomial (Sum ℕ ℕ) k) :=
  Ideal.span (Set.range fun i : ℕ ↦
    MvPolynomial.X (Sum.inl i) * MvPolynomial.X (Sum.inr i))

/-- The target ring `k[x₁, x₂, …, y₁, y₂, …] / (xᵢ yᵢ)`. -/
abbrev Target (k : Type u) [CommRing k] :=
  MvPolynomial (Sum ℕ ℕ) k ⧸ relationIdeal k

/-- The counterexample map sends each source variable `xᵢ` to the class of the left variable
`xᵢ` in the target quotient. -/
def map (k : Type u) [CommRing k] : Source k →ₐ[k] Target k :=
  (Ideal.Quotient.mkₐ k (relationIdeal k)).comp
    (MvPolynomial.rename (Sum.inl : ℕ → Sum ℕ ℕ))

/-- The explicit counterexample map supplies the scalar action of `Source k` on `Target k`. -/
noncomputable instance sourceAlgebra (k : Type u) [CommRing k] :
    Algebra (Source k) (Target k) :=
  (map k).toRingHom.toAlgebra

/-- The map sends `X i` to the quotient class of the left variable indexed by `i`. -/
@[simp]
theorem map_X (k : Type u) [CommRing k] (i : ℕ) :
    map k (MvPolynomial.X i) =
      Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X (Sum.inl i)) := sorry

/-- The ideal `q = ∑ xᵢ S` in the target ring. -/
def targetXIdeal (k : Type u) [CommRing k] : Ideal (Target k) :=
  Ideal.span (Set.range fun i : ℕ ↦ map k (MvPolynomial.X i))

/-- The infinitely generated ideal `(x₁, x₂, …)` in the source ring. -/
def sourceXIdeal (k : Type u) [CommRing k] : Ideal (Source k) :=
  Ideal.span (Set.range fun i : ℕ ↦ (MvPolynomial.X i : Source k))

/-- Remark 10.66.10 (1): `q = ∑ xᵢ S` is a minimal prime of the target ring. -/
@[stacks 05C5 "(1)"]
theorem targetXIdeal_mem_minimalPrimes (k : Type u) [Field k] :
    targetXIdeal k ∈ (⊥ : Ideal (Target k)).minimalPrimes := sorry

/-- Remark 10.66.10 (2): `q` is weakly associated to the target as a module over itself. -/
@[stacks 05C5 "(2)"]
theorem targetXIdeal_mem_weaklyAssociatedPrimes (k : Type u) [Field k] :
    targetXIdeal k ∈ weaklyAssociatedPrimes (Target k) (Target k) := sorry

/-- Remark 10.66.10 (3): the contraction of `q` is `(x₁, x₂, …)`. -/
@[stacks 05C5 "(3)"]
theorem comap_targetXIdeal (k : Type u) [Field k] :
    Ideal.comap (map k).toRingHom (targetXIdeal k) = sourceXIdeal k := sorry

/-- Remark 10.66.10 (4): the annihilator over the source of every nonzero target element is
finitely generated. -/
@[stacks 05C5 "(4)"]
theorem torsionOf_fg_of_ne_zero (k : Type u) [Field k]
    (s : Target k) (hs : s ≠ 0) :
    (Ideal.torsionOf (Source k) (Target k) s).FG := sorry

/-- Remark 10.66.10 (5): the contracted infinite-variable ideal is not weakly associated to the
target viewed as a source module. -/
@[stacks 05C5 "(5)"]
theorem sourceXIdeal_not_mem_weaklyAssociatedPrimes (k : Type u) [Field k] :
    sourceXIdeal k ∉ weaklyAssociatedPrimes (Source k) (Target k) := sorry

/-- Remark 10.66.10 (6): contraction of weakly associated primes along a ring map need not land
in the weakly associated primes after restriction of scalars. -/
@[stacks 05C5 "(6)"]
theorem not_comap_image_subset_weaklyAssociatedPrimes (k : Type u) [Field k] :
    ¬ Ideal.comap (map k).toRingHom '' weaklyAssociatedPrimes (Target k) (Target k) ⊆
      weaklyAssociatedPrimes (Source k) (Target k) := sorry

end PairwiseZeroProduct

#check @PairwiseZeroProduct.map
#check @PairwiseZeroProduct.not_comap_image_subset_weaklyAssociatedPrimes

#print axioms PairwiseZeroProduct.relationIdeal
#print axioms PairwiseZeroProduct.map
#print axioms PairwiseZeroProduct.targetXIdeal
