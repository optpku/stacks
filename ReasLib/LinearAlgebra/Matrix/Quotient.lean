module

public import ReasLib.LinearAlgebra.Matrix.ScalarInverse
public import Mathlib.Algebra.Exact.Basic
public import Mathlib.LinearAlgebra.Matrix.ToLin
public import Mathlib.RingTheory.Ideal.Quotient.Basic

@[expose] public section

noncomputable section

universe u

namespace Matrix

variable {R : Type u} [CommRing R] {n : ℕ}

/-- The endomorphism of the free quotient module induced by reducing a matrix
along the principal ideal generated by `f`. -/
def toLinQuotient (A : Matrix (Fin n) (Fin n) R) (f : R) :
    (Fin n → R ⧸ Ideal.span {f}) →ₗ[R ⧸ Ideal.span {f}]
      (Fin n → R ⧸ Ideal.span {f}) :=
  toLin' ((Ideal.Quotient.mk (Ideal.span {f})).mapMatrix A)

/-- The reduced linear map acts by multiplication by the reduced matrix. -/
theorem toLinQuotient_apply (A : Matrix (Fin n) (Fin n) R) (f : R)
    (v : Fin n → R ⧸ Ideal.span {f}) :
    toLinQuotient A f v = (Ideal.Quotient.mk (Ideal.span {f})).mapMatrix A *ᵥ v := sorry

/-- Reduction of matrices carries multiplication to composition of the induced
linear maps. -/
theorem toLinQuotient_comp (A B : Matrix (Fin n) (Fin n) R) (f : R) :
    (toLinQuotient A f).comp (toLinQuotient B f) = toLinQuotient (A * B) f := sorry

/-- The consecutive reduced maps induced by a matrix factorization are exact. -/
theorem exact_toLinQuotient (A B : Matrix (Fin n) (Fin n) R) {f : R}
    (hAB : A * B = f • 1) (hf : f ∈ nonZeroDivisors R) :
    Function.Exact (toLinQuotient B f) (toLinQuotient A f) := sorry

/-- The swapped consecutive reduced maps induced by a matrix factorization are
exact. -/
theorem exact_toLinQuotient_swap (A B : Matrix (Fin n) (Fin n) R) {f : R}
    (hAB : A * B = f • 1) (hf : f ∈ nonZeroDivisors R) :
    Function.Exact (toLinQuotient A f) (toLinQuotient B f) := sorry

end Matrix
