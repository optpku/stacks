module

public import ReasLib.AlgebraicGeometry.Scheme.Cover.AffineFamily
public import ReasLib.AlgebraicGeometry.Scheme.Sites.ChosenPresentation.Affine
public import ReasLib.AlgebraicGeometry.Scheme.Sites.H.ChosenPresentation
public import ReasLib.CategoryTheory.Sites.PrecoverageStability

/-!
# Affine sites in chosen big h-site slices

This module defines standard affine h-covering families, their pretopology,
and the topology they generate on the affine full subcategory of a chosen big
h-site slice.
-/

@[expose] public section

open CategoryTheory

universe u v

namespace AlgebraicGeometry.ChosenBigHSite

/-- A presieve on the affine full subcategory is standard h covering when it
covers in the big h slice and is represented by a finite affine h family. -/
def bigAffineStandardCovering (X : ChosenBigHSite.{u, v})
    (S : X.carrier) {U : ChosenBigSite.affineSite X S} (R : Presieve U) : Prop :=
  R.map (ChosenBigSite.affineInclusion X S) ∈
      (bigTopology X S).toPrecoverage U.obj ∧
    ∃ family : AffineFamilyOver ((ChosenBigSite.affineToScheme X S).obj U),
      Scheme.HCovering (fun i : Fin family.n ↦ Over.mk (family.map i)) ∧
        Sieve.generate (R.map (ChosenBigSite.affineToScheme X S)) =
          Sieve.generate (Presieve.ofArrows family.U family.map)

/-- The standard h-covering predicate consists of ambient covering together
with a finite affine h-family presentation. -/
theorem bigAffineStandardCovering_iff (X : ChosenBigHSite.{u, v})
    (S : X.carrier) {U : ChosenBigSite.affineSite X S} {R : Presieve U} :
    bigAffineStandardCovering X S R ↔
      R.map (ChosenBigSite.affineInclusion X S) ∈
          (bigTopology X S).toPrecoverage U.obj ∧
        ∃ family : AffineFamilyOver ((ChosenBigSite.affineToScheme X S).obj U),
          Scheme.HCovering (fun i : Fin family.n ↦ Over.mk (family.map i)) ∧
            Sieve.generate (R.map (ChosenBigSite.affineToScheme X S)) =
              Sieve.generate (Presieve.ofArrows family.U family.map) := sorry

/-- The precoverage of ambient-covering standard h families on the affine
full subcategory of a chosen big h-site slice. -/
def bigAffineStandardPrecoverage (X : ChosenBigHSite.{u, v})
    (S : X.carrier) : Precoverage (ChosenBigSite.affineSite X S) where
  coverings := fun _ ↦ {R | bigAffineStandardCovering X S R}

/-- Membership in the big affine standard h precoverage is exactly the
standard h-covering predicate. -/
theorem mem_bigAffineStandardPrecoverage_iff
    (X : ChosenBigHSite.{u, v}) (S : X.carrier)
    {U : ChosenBigSite.affineSite X S} {R : Presieve U} :
    R ∈ bigAffineStandardPrecoverage X S U ↔
      bigAffineStandardCovering X S R := sorry

/-- The big affine h topology is generated by ambient-covering standard h
families on the affine full subcategory. -/
def bigAffineTopology (X : ChosenBigHSite.{u, v}) (S : X.carrier) :
    GrothendieckTopology (ChosenBigSite.affineSite X S) :=
  (bigAffineStandardPrecoverage X S).toGrothendieck

/-- The big affine h topology is generated by its standard h precoverage. -/
theorem bigAffineTopology_def (X : ChosenBigHSite.{u, v}) (S : X.carrier) :
    bigAffineTopology X S =
      (bigAffineStandardPrecoverage X S).toGrothendieck := sorry

/-- Singleton isomorphisms are standard affine h-covering families. -/
theorem bigAffineStandardPrecoverageHasIsos
    (X : ChosenBigHSite.{u, v}) (S : X.carrier) :
    (bigAffineStandardPrecoverage X S).HasIsos := sorry

/-- Standard affine h-covering families are stable under dependent composition. -/
theorem bigAffineStandardPrecoverageIsStableUnderBind
    (X : ChosenBigHSite.{u, v}) (S : X.carrier) :
    (bigAffineStandardPrecoverage X S).IsStableUnderBind := sorry

/-- Standard affine h-covering families are stable under pullback arrows. -/
theorem bigAffineStandardPrecoverageIsStableUnderPullbackArrows
    (X : ChosenBigHSite.{u, v}) (S : X.carrier) :
    (bigAffineStandardPrecoverage X S).IsStableUnderPullbackArrows := sorry

/-- The pretopology of standard h-covering families between affine objects over
`S` in the chosen big h-site presentation `X`. -/
def bigAffinePretopology (X : ChosenBigHSite.{u, v}) (S : X.carrier) :
    @Pretopology (ChosenBigSite.affineSite X S) _
      (ChosenBigSite.affineSiteHasPullbacks X S) :=
  @Pretopology.mk (ChosenBigSite.affineSite X S) _
    (ChosenBigSite.affineSiteHasPullbacks X S)
    (bigAffineStandardPrecoverage X S)
    (fun _ _ f _ ↦
      (bigAffineStandardPrecoverageHasIsos X S).mem_coverings_of_isIso f)
    (fun _ _ f R hR ↦
      @Precoverage.IsStableUnderPullbackArrows.pullbackArrows_mem
        _ _ _ (bigAffineStandardPrecoverageIsStableUnderPullbackArrows X S)
        _ _ f R
        { hasPullback := fun _ ↦
            (ChosenBigSite.affineSiteHasPullbacks X S).has_limit _ }
        hR)
    (fun _ _ T hR hT ↦
      (bigAffineStandardPrecoverageIsStableUnderBind X S).bind_mem hR T hT)

/-- The selected coverings of the affine h pretopology are exactly the
standard affine h-covering families. -/
theorem bigAffinePretopology_toPrecoverage
    (X : ChosenBigHSite.{u, v}) (S : X.carrier) :
    @Pretopology.toPrecoverage _ _ (ChosenBigSite.affineSiteHasPullbacks X S)
        (bigAffinePretopology X S) =
      bigAffineStandardPrecoverage X S := sorry

/-- The topology generated by the affine h pretopology is the big affine h
topology. -/
theorem bigAffinePretopology_toGrothendieck
    (X : ChosenBigHSite.{u, v}) (S : X.carrier) :
    @Pretopology.toGrothendieck _ _ (ChosenBigSite.affineSiteHasPullbacks X S)
        (bigAffinePretopology X S) = bigAffineTopology X S := sorry

end AlgebraicGeometry.ChosenBigHSite
