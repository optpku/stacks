module

public import Mathlib.Algebra.Category.Grp.Adjunctions
public import Mathlib.Algebra.Category.Grp.Colimits
public import Mathlib.CategoryTheory.Adjunction.Whiskering
public import Mathlib.CategoryTheory.Limits.FunctorCategory.EpiMono
public import Mathlib.CategoryTheory.Limits.Preserves.FunctorCategory
public import Mathlib.CategoryTheory.Limits.Preserves.Shapes.Products
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Free abelian presheaves

This leaf owns objectwise free abelianization for type-valued functors.  The presheaf API is kept
here, before representability and Grothendieck topologies enter, so sheafification can consume it
without becoming the owner of the underlying presheaf construction.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

noncomputable section

universe u v w w'

namespace CategoryTheory

variable {C : Type u} [Category.{v} C]

namespace FreeAbelianPresheaf

/-- The functor sending type-valued presheaves to their objectwise free abelian presheaves. -/
@[stacks 03A7 "functor"]
abbrev functor :
    (Cᵒᵖ ⥤ Type w) ⥤ Cᵒᵖ ⥤ AddCommGrpCat.{w} :=
  (Functor.whiskeringRight Cᵒᵖ (Type w) AddCommGrpCat.{w}).obj AddCommGrpCat.free

/-- The objectwise free abelian presheaf generated by `G`, with induced restriction maps. -/
@[stacks 03A7 "object"]
abbrev obj (G : Cᵒᵖ ⥤ Type w) : Cᵒᵖ ⥤ AddCommGrpCat.{w} :=
  functor.obj G

/-- Objectwise free abelianization applied to a morphism of type-valued presheaves. -/
abbrev map {G H : Cᵒᵖ ⥤ Type w} (f : G ⟶ H) : obj G ⟶ obj H :=
  functor.map f

/-- The free abelian presheaf evaluates objectwise as a free abelian group. -/
theorem obj_obj (G : Cᵒᵖ ⥤ Type w) (U : Cᵒᵖ) :
    (obj G).obj U = AddCommGrpCat.of (FreeAbelianGroup (G.obj U)) := sorry

/-- Morphisms from a free abelian presheaf correspond to morphisms from its generators to
the underlying type-valued presheaf. -/
@[stacks 03A8 "free-forgetful adjunction"]
noncomputable def homEquiv
    (G : Cᵒᵖ ⥤ Type w) (A : Cᵒᵖ ⥤ AddCommGrpCat.{w}) :
    (obj G ⟶ A) ≃ (G ⟶ A ⋙ forget AddCommGrpCat.{w}) :=
  (AddCommGrpCat.adj.whiskerRight Cᵒᵖ).homEquiv G A

/-- Objectwise free abelianization carries coproducts of type-valued presheaves to
coproducts of abelian presheaves. -/
@[stacks 03A9]
noncomputable abbrev coproductIso
    {I : Type w'} (G : I → Cᵒᵖ ⥤ Type (max u v w')) :
    obj (∐ G) ≅ ∐ fun i ↦ obj (G i) :=
  PreservesCoproduct.iso functor G

end FreeAbelianPresheaf

end CategoryTheory
