module

public import Mathlib.RingTheory.Extension.Presentation.Basic
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.Regular.RegularSequence
public import Mathlib.RingTheory.Spectrum.Prime.RingHom
public import ReasLib.RingTheory.RingHom.Local.Surjective

@[expose] public section

/-!
# Prime-Local Data of an Algebra Presentation

This leaf owns the source prime, source local ring, and localized relation data
of a fixed algebra presentation. These objects do not require a complete
intersection hypothesis.

@stack 00SC
-/

universe u v w t

noncomputable section

namespace Algebra.Presentation

variable {R : Type u} {S : Type v} {ι : Type w} {σ : Type t}
variable [CommRing R] [CommRing S] [Algebra R S]

/-- The contraction to the presentation ring of a prime of the target algebra. -/
noncomputable def sourcePrime (P : Presentation R S ι σ) (q : PrimeSpectrum S) :
    PrimeSpectrum P.Ring :=
  PrimeSpectrum.comap (algebraMap P.Ring S) q

/-- The local presentation ring at the contraction of a target prime. -/
abbrev sourceLocalRingAt (P : Presentation R S ι σ) (q : PrimeSpectrum S) : Type _ :=
  (algebraMap P.Ring S).sourceLocalRingAt q

/-- The homomorphism from the local presentation ring to the local target ring. -/
abbrev localRingHomAt (P : Presentation R S ι σ) (q : PrimeSpectrum S) :
    P.sourceLocalRingAt q →+* Localization.AtPrime q.asIdeal :=
  (algebraMap P.Ring S).localRingHomAt q

/-- The localized kernel ideal of a presentation at a target prime. -/
abbrev localKernelIdealAt (P : Presentation R S ι σ) (q : PrimeSpectrum S) :
    Ideal (P.sourceLocalRingAt q) :=
  (algebraMap P.Ring S).localKernelIdealAt q

/-- The canonical quotient of the local presentation ring by its localized kernel. -/
abbrev localQuotientAt (P : Presentation R S ι σ) (q : PrimeSpectrum S) : Type _ :=
  (algebraMap P.Ring S).localQuotientAt q

/-- The canonical quotient of the local presentation ring identifies with the target local ring. -/
abbrev localQuotientAt.ringEquiv (P : Presentation R S ι σ) (q : PrimeSpectrum S) :
    P.localQuotientAt q ≃+* Localization.AtPrime q.asIdeal :=
  RingHom.localQuotientAt.ringEquiv
    (algebraMap P.Ring S) P.algebraMap_surjective q

/-- A single presentation relation after localization at the source prime of a
target prime. -/
noncomputable def relationAtPrime (P : Presentation R S ι σ) (q : PrimeSpectrum S) (i : σ) :
    P.sourceLocalRingAt q :=
  algebraMap P.Ring (P.sourceLocalRingAt q) (P.relation i)

/-- The ideal generated by all displayed relations after localization at a target prime. -/
noncomputable def relationIdealAtPrime (P : Presentation R S ι σ) (q : PrimeSpectrum S) :
    Ideal (P.sourceLocalRingAt q) :=
  Ideal.span (Set.range (P.relationAtPrime q))

/-- The localized displayed relations generate exactly the localized kernel ideal. -/
@[stacks 00SC "localized presentation relations generate the localized kernel"]
theorem relationIdealAtPrime.eq_localKernel (P : Presentation R S ι σ)
    (q : PrimeSpectrum S) :
    P.relationIdealAtPrime q = P.localKernelIdealAt q := sorry

section OrderedRelations

variable {c : ℕ}

/-- The canonically ordered relation list of a finite presentation after
localization at the source prime of a target prime. -/
noncomputable def relationsAtPrime (P : Presentation R S ι (Fin c)) (q : PrimeSpectrum S) :
    List (P.sourceLocalRingAt q) :=
  List.ofFn (P.relationAtPrime q)

/-- The finite localized relation list generates the localized kernel ideal. -/
@[stacks 00SC "localized finite presentation relations generate the localized kernel"]
theorem relationsAtPrime.ofList_eq_localKernel (P : Presentation R S ι (Fin c))
    (q : PrimeSpectrum S) :
    Ideal.ofList (P.relationsAtPrime q) = P.localKernelIdealAt q := sorry

/-- The ideal generated by the initial segment through `i` of the localized
ordered relation list. -/
noncomputable def relationsAtPrime.prefixIdeal (P : Presentation R S ι (Fin c))
    (q : PrimeSpectrum S) (i : Fin c) : Ideal (P.sourceLocalRingAt q) :=
  Ideal.span {x | x ∈ (P.relationsAtPrime q).take i.1.succ}

end OrderedRelations

end Algebra.Presentation
