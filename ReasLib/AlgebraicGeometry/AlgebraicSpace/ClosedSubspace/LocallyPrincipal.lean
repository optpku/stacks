module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Subspace
public import ReasLib.AlgebraicGeometry.AlgebraicSpace.Divisor.LocallyPrincipal

/-!
# Locally principal bundled closed subspaces

A bundled closed subspace is locally principal exactly when the ideal sheaf of its
inclusion on the small étale site is locally generated by one section.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

namespace ClosedSubspace

/-- A closed subspace is locally principal exactly when the ideal sheaf of its inclusion
is locally generated by one section. -/
theorem isLocallyPrincipalClosedSubspace_iff {S : Scheme.{u}} {X : AlgebraicSpace S}
    (Z : ClosedSubspace X) :
    IsLocallyPrincipal Z.ι ↔
      SheafOfModules.IsLocallyGeneratedBy (Hom.idealSheaf Z.ι) 1 :=
  sorry

end ClosedSubspace

end AlgebraicGeometry.AlgebraicSpace
