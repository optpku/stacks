module

public import Mathlib.Topology.Algebra.Nonarchimedean.AdicTopology

/-!
# I-adic topology on modules

`Module.IsAdic I M` means the topology on an `R`-module `M` equals the `I`-adic
topology `I.adicModuleTopology M`. This is the module-level analogue of `IsAdic`.
-/

@[expose] public section

universe u v

open scoped Topology

namespace Module

variable {R : Type u} [CommRing R]

/-- The topology on an `R`-module is `I`-adic when it equals `I.adicModuleTopology`. -/
def IsAdic (I : Ideal R) (M : Type v)
    [AddCommGroup M] [Module R M] [H : TopologicalSpace M] : Prop :=
  H = I.adicModuleTopology M

/-- A topological additive group is `I`-adic if and only if the submodules `I ^ n • ⊤`
are open and form a neighbourhood basis of `0`. -/
theorem isAdic_iff (I : Ideal R) (M : Type v)
    [AddCommGroup M] [Module R M] [TopologicalSpace M] [IsTopologicalAddGroup M] :
    IsAdic I M ↔
      (∀ n : ℕ, IsOpen ((I ^ n • ⊤ : Submodule R M) : Set M)) ∧
        ∀ s ∈ 𝓝 (0 : M), ∃ n : ℕ, ((I ^ n • ⊤ : Submodule R M) : Set M) ⊆ s :=
  sorry

namespace IsAdic

variable {I : Ideal R} {M : Type v}
variable [AddCommGroup M] [Module R M] [TopologicalSpace M]

/-- Neighbourhoods of `0` in an `I`-adic module are generated by the powers `I ^ n • ⊤`. -/
theorem hasBasis_nhds_zero (h : IsAdic I M) :
    (𝓝 (0 : M)).HasBasis (fun _ : ℕ ↦ True)
      (fun n ↦ ((I ^ n • ⊤ : Submodule R M) : Set M)) :=
  sorry

/-- Each power `I ^ n • ⊤` is open in an `I`-adic module. -/
theorem isOpen_pow_smul (h : IsAdic I M) (n : ℕ) :
    IsOpen ((I ^ n • ⊤ : Submodule R M) : Set M) :=
  sorry

end IsAdic

/-- The topology `I.adicModuleTopology` on an `R`-module is `I`-adic. -/
theorem isAdic_adicModuleTopology (I : Ideal R) (M : Type v)
    [AddCommGroup M] [Module R M] :
    @IsAdic R _ I M _ _ (I.adicModuleTopology M) :=
  sorry

/-- On the ring as a module over itself, `Module.IsAdic` agrees with `IsAdic`. -/
theorem isAdic_self [TopologicalSpace R] (I : Ideal R) :
    IsAdic I R ↔ _root_.IsAdic I :=
  sorry

end Module
