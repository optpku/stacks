module

public import ReasLib.CategoryTheory.Sites.Point.Refinement.Saturation.Refinement.Category
public import Mathlib.CategoryTheory.Functor.OfSequence

/-!
# Sequential towers of finite-cover refinement stages

This leaf owns the natural-number recursion of unseparated refinement stages
and the comparison maps generated by its successor refinements.
-/

@[expose] public section

open CategoryTheory Limits

universe u v q r r'

noncomputable section

namespace CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered
namespace OrderedRefinement
namespace Saturation
namespace RefinementStage

variable {C : Type u} [Category.{v} C]
variable {ι : Type r} [Preorder ι]
variable {J : GrothendieckTopology C}
variable {S : ιᵒᵖ ⥤ C}
variable [LocallySmall.{q} C]
variable [EssentiallySmall.{q} ιᵒᵖ]
variable [HasColimitsOfShape (EssentiallySmallFiber.fiber S).Elementsᵒᵖ (Type q)]

/-- A sequential tower of unseparated finite-cover refinement stages. Successive stages
share one target-index universe; heterogeneous target refinements belong in `Target.Diagram`. -/
structure Tower where
  /-- The refinement stage at each natural-number level. -/
  stage : ℕ → RefinementStage.{u, v, q, r, r'} S
  /-- The compatible refinement from a stage to its successor. -/
  step : ∀ n : ℕ, stage n ⟶ stage (n + 1)
  /-- Every successor refinement realizes requests already present at its source target. -/
  realizes : ∀ n : ℕ, (step n).realizesAll (J := J)

namespace Tower

/-- Refinement-stage towers are determined by their stages and successor maps. -/
@[ext]
theorem ext {T U : Tower.{u, v, q, r, r'} (J := J) (S := S)}
    (hstage : T.stage = U.stage) (hstep : HEq T.step U.step) :
    T = U := sorry

/-- The universe-lifted natural-number index used for the diagram of an unseparated tower. -/
abbrev Index : Type r' := ULift.{r'} ℕ

/-- The natural-number diagram generated by the successor refinements of an unseparated tower. -/
noncomputable def natDiagram (T : Tower.{u, v, q, r, r'} (J := J) (S := S)) :
    ℕ ⥤ RefinementStage.{u, v, q, r, r'} S :=
  Functor.ofSequence T.step

/-- Read the map between any two ordered levels from the canonical natural-number diagram. -/
noncomputable def hom (T : Tower.{u, v, q, r, r'} (J := J) (S := S))
    {n m : ℕ} (hnm : n ≤ m) : T.stage n ⟶ T.stage m :=
  T.natDiagram.map (homOfLE hnm)

namespace natDiagram

/-- The object at `n` of the natural-number diagram is the `n`th refinement stage. -/
@[simp]
theorem obj (T : Tower.{u, v, q, r, r'} (J := J) (S := S)) (n : ℕ) :
    T.natDiagram.obj n = T.stage n := sorry

/-- The successor map in the natural-number diagram is the specified tower refinement. -/
@[simp]
theorem mapSucc (T : Tower.{u, v, q, r, r'} (J := J) (S := S)) (n : ℕ) :
    T.natDiagram.map (homOfLE (Nat.le_succ n)) = T.step n := sorry

/-- An arbitrary map of the natural-number diagram is the corresponding tower refinement. -/
@[simp]
theorem map (T : Tower.{u, v, q, r, r'} (J := J) (S := S))
    {n m : ℕ} (hnm : n ≤ m) :
    T.natDiagram.map (homOfLE hnm) = T.hom hnm := sorry

end natDiagram

namespace hom

/-- The derived refinement from a tower stage to itself is the identity. -/
@[simp]
theorem refl (T : Tower.{u, v, q, r, r'} (J := J) (S := S)) (n : ℕ) :
    T.hom (le_rfl : n ≤ n) = 𝟙 (T.stage n) := sorry

/-- The comparison to the next level is the specified tower refinement. -/
@[simp]
theorem step (T : Tower.{u, v, q, r, r'} (J := J) (S := S)) (n : ℕ) :
    T.hom (Nat.le_succ n) = T.step n := sorry

/-- Extending a derived refinement by one successor composes with that successor refinement. -/
@[simp]
theorem succ (T : Tower.{u, v, q, r, r'} (J := J) (S := S))
    {n m : ℕ} (hnm : n ≤ m) :
    T.hom (Nat.le_succ_of_le hnm) = T.hom hnm ≫ T.step m := sorry

/-- Derived refinements of an unseparated tower compose along chains. -/
theorem comp (T : Tower.{u, v, q, r, r'} (J := J) (S := S))
    {n m p : ℕ} (hnm : n ≤ m) (hmp : m ≤ p) :
    T.hom (le_trans hnm hmp) = T.hom hnm ≫ T.hom hmp := sorry

end hom

end Tower
end RefinementStage
end Saturation
end OrderedRefinement
end CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered
