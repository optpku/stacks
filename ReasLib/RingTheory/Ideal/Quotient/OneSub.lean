module

public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Quotients by complementary principal ideals

This leaf packages the quotient algebra maps attached to the principal ideal
generated by `1 - e`.  No idempotency hypothesis is needed for these maps;
idempotency belongs to later splitting arguments.
-/

universe u v w

namespace Ideal

variable {A : Type u} [CommRing A]

/-- The principal ideal generated by the complement of an element. -/
@[stacks 0CAR "complementary principal ideal"]
abbrev oneSubSpan (e : A) : Ideal A :=
  Ideal.span ({1 - e} : Set A)

/-- A ring homomorphism maps a complementary principal ideal to the complementary principal ideal
of the image element. -/
@[simp]
theorem map_oneSubSpan {B : Type v} [CommRing B] (f : A →+* B) (e : A) :
    Ideal.map f (Ideal.oneSubSpan e) = Ideal.oneSubSpan (f e) := sorry

end Ideal

namespace RingHom

variable {A : Type u} {B : Type v} [CommRing A] [CommRing B]

/-- The complementary principal ideal of an element lies in the contraction of the complementary
principal ideal of its image. -/
theorem oneSubSpan_le_comap (f : A →+* B) (e : A) :
    Ideal.oneSubSpan e ≤ Ideal.comap f (Ideal.oneSubSpan (f e)) := sorry

/-- A ring homomorphism that sends `e` to `1` kills the complementary principal ideal of `e`. -/
theorem oneSubSpan_le_ker (f : A →+* B) (e : A) (he : f e = 1) :
    Ideal.oneSubSpan e ≤ RingHom.ker f := sorry

end RingHom

namespace Ideal.Quotient

variable {K : Type u} {A : Type v} {B : Type w}
variable [CommSemiring K] [CommRing A] [CommRing B]
variable [Algebra K A] [Algebra K B]

/-- The algebra map obtained by quotienting a ring by the complement of an element sent to `1`. -/
@[stacks 0CAR "lift from a complementary principal quotient"]
def liftOneSub (e : A) (f : A →ₐ[K] B) (he : f e = 1) :
    A ⧸ Ideal.oneSubSpan e →ₐ[K] B :=
  Ideal.Quotient.liftₐ (Ideal.oneSubSpan e) f (RingHom.oneSubSpan_le_ker f.toRingHom e he)

/-- `liftOneSub` evaluates a quotient representative by applying its defining algebra map. -/
@[simp]
theorem liftOneSub_mk (e : A) (f : A →ₐ[K] B) (he : f e = 1) (a : A) :
    liftOneSub e f he (Ideal.Quotient.mk (Ideal.oneSubSpan e) a) = f a := sorry

/-- The class of `e` is `1` in the quotient by the complementary principal ideal. -/
@[stacks 0CAR "distinguished class in a complementary principal quotient", simp]
theorem mk_oneSub_eq_one (e : A) :
    Ideal.Quotient.mk (Ideal.oneSubSpan e) e = 1 := sorry

end Ideal.Quotient

namespace AlgHom

variable {K : Type u} {A : Type v} {B : Type w}
variable [CommSemiring K] [CommRing A] [CommRing B]
variable [Algebra K A] [Algebra K B]

/-- The map on quotient algebras induced by an algebra homomorphism and the complementary
principal ideals of an element and its image. -/
@[stacks 0CAR "map of complementary principal quotients"]
def quotientMapOneSub (f : A →ₐ[K] B) (e : A) :
    A ⧸ Ideal.oneSubSpan e →ₐ[K] B ⧸ Ideal.oneSubSpan (f e) :=
  Ideal.quotientMapₐ (Ideal.oneSubSpan (f e)) f
    (RingHom.oneSubSpan_le_comap f.toRingHom e)

/-- `quotientMapOneSub` sends a quotient representative to the representative of its image. -/
@[simp]
theorem quotientMapOneSub_mk (f : A →ₐ[K] B) (e a : A) :
    quotientMapOneSub f e (Ideal.Quotient.mk (Ideal.oneSubSpan e) a) =
      Ideal.Quotient.mk (Ideal.oneSubSpan (f e)) (f a) := sorry

/-- Clearing a power of a unit class produces a preimage under the map of complementary
principal quotients. -/
@[stacks 07NC "denominator clearing in a complementary principal quotient"]
theorem quotientMapOneSub_exists_preimage_of_pow_mul
    (f : A →ₐ[K] B) (e : A) {r a : A} {b : B} (n : ℕ)
    (h_unit : IsUnit (Ideal.Quotient.mk (Ideal.oneSubSpan e) r))
    (h_eq : f a = (f r) ^ n * b) :
    ∃ x : A ⧸ Ideal.oneSubSpan e,
      quotientMapOneSub f e x =
        Ideal.Quotient.mk (Ideal.oneSubSpan (f e)) b := sorry

/-- A retraction onto a complementary principal quotient sends the image of its distinguished
element to `1`. -/
@[stacks 07NC "retraction of a complementary principal quotient"]
theorem image_eq_one_of_comp_eq_mkOneSub
    (f : A →ₐ[K] B) (e : A)
    (g : B →ₐ[K] A ⧸ Ideal.oneSubSpan e)
    (h_comp :
      g.comp f =
        (Ideal.Quotient.mkₐ K (Ideal.oneSubSpan e) : A →ₐ[K] A ⧸ Ideal.oneSubSpan e)) :
    g (f e) = 1 := sorry

/-- A retraction onto a complementary principal quotient makes the induced quotient map
injective. -/
@[stacks 07NC "injectivity of a complementary principal quotient map"]
theorem quotientMapOneSub_injective_of_comp_eq_mk
    (f : A →ₐ[K] B) (e : A)
    (g : B →ₐ[K] A ⧸ Ideal.oneSubSpan e)
    (h_comp :
      g.comp f =
        (Ideal.Quotient.mkₐ K (Ideal.oneSubSpan e) : A →ₐ[K] A ⧸ Ideal.oneSubSpan e)) :
    Function.Injective (quotientMapOneSub f e) := sorry

end AlgHom

namespace Ideal.Quotient

variable {K : Type u} {A : Type v} {B : Type w}
variable [CommSemiring K] [CommRing A] [CommRing B]
variable [Algebra K A] [Algebra K B]

/-- Lifting out of the target complementary quotient after mapping a source quotient evaluates
on representatives by the composite algebra homomorphism. -/
@[stacks 07NC "composition through complementary principal quotients", simp]
theorem liftOneSub_quotientMapOneSub_mk
    {C : Type*} [CommRing C] [Algebra K C]
    (f : A →ₐ[K] B) (e : A) (g : B →ₐ[K] C) (h_g : g (f e) = 1) (a : A) :
    liftOneSub (f e) g h_g
        (AlgHom.quotientMapOneSub f e (Ideal.Quotient.mk (Ideal.oneSubSpan e) a)) =
      g (f a) := sorry

/-- A map whose composite with an algebra homomorphism is the complementary quotient map
provides a left inverse to the induced map of complementary quotients. -/
@[stacks 07NC "left inverse of a complementary principal quotient map"]
theorem liftOneSub_comp_quotientMapOneSub
    (f : A →ₐ[K] B) (e : A)
    (g : B →ₐ[K] A ⧸ Ideal.oneSubSpan e) (h_g : g (f e) = 1)
    (h_comp :
      g.comp f =
        (Ideal.Quotient.mkₐ K (Ideal.oneSubSpan e) : A →ₐ[K] A ⧸ Ideal.oneSubSpan e)) :
    (liftOneSub (f e) g h_g).comp (AlgHom.quotientMapOneSub f e) =
      AlgHom.id K (A ⧸ Ideal.oneSubSpan e) := sorry

end Ideal.Quotient
