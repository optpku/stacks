module

public import Mathlib.Algebra.Category.ModuleCat.Presheaf.Monoidal
public import ReasLib.Algebra.Category.ModuleCat.Presheaf.ExteriorPower
public import stacks_project.Chap60.Lemma_60_16_1
public import stacks_project.Chap60.Lemma_60_16_1_AdicCompletion
public import stacks_project.Chap60.Lemma_60_19_2_Omega

@[expose] public section

open CategoryTheory Opposite
open PresheafOfModules
open scoped Simplicial

noncomputable section

universe u

variable {A : Type u} [CommRing A]
variable (p : ℕ) [Fact (Nat.Prime p)]
variable [Algebra (Localization.AtPrime (Ideal.span ({(p : ℤ)} : Set ℤ))) A]
variable (I : Ideal A) (γ : DividedPowers I)
variable {C : Type u} [CommRing C] [Algebra A C]
variable {ι : Type u} (π : MvPolynomial ι A →ₐ[A] C)
variable (hπ : Function.Surjective π)
variable (hIC : Ideal.map (algebraMap A C) I = (⊥ : Ideal C))
variable (hpnil : IsNilpotent (p : C))
variable (J : (n : ℕ) → Ideal (tensorPowerCarrier A ι n))
variable (hJ : ∀ n, J n = RingHom.ker (tensorPowerAlgHom π n).toRingHom)
variable (hIJ : ∀ n, Ideal.map (algebraMap A (tensorPowerCarrier A ι n)) I ≤ J n)
variable (E : (n : ℕ) →
    DividedPowerEnvelope I γ (algebraMap A (tensorPowerCarrier A ι n)) (J n) (hIJ n))
variable (hE : ∀ n,
    DividedPowerEnvelope.IsUniversal γ
      (algebraMap A (tensorPowerCarrier A ι n)) (hIJ n) (E n))
variable (γbar : (n : ℕ) →
    DividedPowers
      (crystallineDnIdeal p I γ π hπ n hIC hpnil (J n) (hJ n) (hIJ n) (E n) (hE n)))
variable (i : ℕ)

/-- Structure maps of `D(*)` send the principal ideal generated by `p` into the
corresponding ideal in the target degree. -/
theorem crystallinePAdicIdeal_map_mem {n m : SimplexCategory} (σ : n ⟶ m)
    {x : (crystallineDStar p I γ π hπ hIC hpnil J hJ hIJ E hE).obj n}
    (hx : x ∈ Ideal.span {(p : (crystallineDStar p I γ π hπ hIC hpnil J hJ hIJ E hE).obj n)}) :
    ((crystallineDStar p I γ π hπ hIC hpnil J hJ hIJ E hE).map σ).hom x ∈
      Ideal.span {(p : (crystallineDStar p I γ π hπ hIC hpnil J hJ hIJ E hE).obj m)} :=
  sorry

/-- The compatible family of principal ideals `(p) ⊂ D(n)`. -/
def crystallinePAdicIdeal :
    CosimplicialIdeal (crystallineDStar p I γ π hπ hIC hpnil J hJ hIJ E hE) :=
  CosimplicialIdeal.ofFamily
    (fun n ↦ Ideal.span {(p : (crystallineDStar p I γ π hπ hIC hpnil J hJ hIJ E hE).obj n)})
    (fun {_ _} _ {_} _ ↦ sorry)

/-- The degree-`n` object of the `p`-adic cosimplicial ideal is the span of `p` in `D(n)`. -/
theorem crystallinePAdicIdeal_obj (n : SimplexCategory) :
    (crystallinePAdicIdeal p I γ π hπ hIC hpnil J hJ hIJ E hE).obj n =
      Ideal.span {(p : (crystallineDStar p I γ π hπ hIC hpnil J hJ hIJ E hE).obj n)} :=
  sorry

/-- Uncompleted exterior powers `∧^i Ω_{D(*)}`. -/
def crystallineOmegaExteriorDStar :
    PresheafOfModules.{u}
      (moduleRingPresheaf (crystallineDStar p I γ π hπ hIC hpnil J hJ hIJ E hE)) :=
  ExteriorPower.presheaf
    (cosimplicialCommRing (crystallineDStar p I γ π hπ hIC hpnil J hJ hIJ E hE))
    (crystallineOmegaDStar p I γ π hπ hIC hpnil J hJ hIJ E hE γbar) i

/-- The degree-`n` object of `Ω^i_{D(*)}` as a module over `D(n)`: the `p`-adic
completion of `∧^i Ω_{D(n)}`. -/
def crystallineOmegaPowerModuleCat (n : ℕ) :
    ModuleCat.{u}
      (crystallineDn p I γ π hπ n hIC hpnil (J n) (hJ n) (hIJ n) (E n) (hE n)) :=
  ModuleCat.of
    (crystallineDn p I γ π hπ n hIC hpnil (J n) (hJ n) (hIJ n) (E n) (hE n))
    (AdicCompletion
      (Ideal.span {(p :
          crystallineDn p I γ π hπ n hIC hpnil (J n) (hJ n) (hIJ n) (E n) (hE n))})
      ((crystallineOmegaModuleCat p I γ π hπ hIC hpnil J hJ hIJ E hE γbar n).exteriorPower i))

/-- Linear comparison of completed exterior powers after restriction of scalars. -/
def crystallineOmegaPowerHom {n m : SimplexCategory} (σ : n ⟶ m) :
    crystallineOmegaPowerModuleCat p I γ π hπ hIC hpnil J hJ hIJ E hE γbar i n.len ⟶
      (ModuleCat.restrictScalars
          (crystallineDnHom p I γ π hπ hIC hpnil J hJ hIJ E hE σ)).obj
        (crystallineOmegaPowerModuleCat p I γ π hπ hIC hpnil J hJ hIJ E hE γbar i m.len) :=
  let φ := crystallineDnHom p I γ π hπ hIC hpnil J hJ hIJ E hE σ
  let Ωn := crystallineOmegaModuleCat p I γ π hπ hIC hpnil J hJ hIJ E hE γbar n.len
  let Ωm := crystallineOmegaModuleCat p I γ π hπ hIC hpnil J hJ hIJ E hE γbar m.len
  let Dm :=
    crystallineDn p I γ π hπ m.len hIC hpnil (J m.len) (hJ m.len) (hIJ m.len)
      (E m.len) (hE m.len)
  ModuleCat.ofHom
    (Y :=
      (ModuleCat.restrictScalars φ).obj
        (crystallineOmegaPowerModuleCat p I γ π hπ hIC hpnil J hJ hIJ E hE γbar i m.len))
    { toFun := fun ω ↦
        ⟨fun k ↦
          (AdicCompletion.of (Ideal.span {(p : Dm)}) (Ωm.exteriorPower i)
              ((ModuleCat.exteriorPower.mapRestrictScalars φ
                  (crystallineOmegaHom p I γ π hπ hIC hpnil J hJ hIJ E hE γbar σ) i).hom
                (Quotient.out (ω.val k)))).val k,
          sorry⟩
      map_add' := sorry
      map_smul' := sorry }

/-- The `D(*)`-cosimplicial module with stages `Ω^i_{D(n)}`, the `p`-adic
completion of `∧^i Ω_{D(n)}`. -/
def crystallineOmegaPowerDStar :
    PresheafOfModules.{u}
      (moduleRingPresheaf (crystallineDStar p I γ π hπ hIC hpnil J hJ hIJ E hE)) where
  obj X :=
    crystallineOmegaPowerModuleCat p I γ π hπ hIC hpnil J hJ hIJ E hE γbar i (unop (unop X)).len
  map {X Y} f :=
    crystallineOmegaPowerHom p I γ π hπ hIC hpnil J hJ hIJ E hE γbar i f.unop.unop
  map_id := sorry
  map_comp := sorry

/-- The degree-`n` object of `Ω^i_{D(*)}` is the `p`-adic completion of `∧^i Ω_{D(n)}`. -/
theorem crystallineOmegaPowerDStar_obj (n : ℕ) :
    (crystallineOmegaPowerDStar p I γ π hπ hIC hpnil J hJ hIJ E hE γbar i).obj
        (op (op (SimplexCategory.mk n))) =
      crystallineOmegaPowerModuleCat p I γ π hπ hIC hpnil J hJ hIJ E hE γbar i n :=
  rfl

variable (M : PresheafOfModules.{u}
    (moduleRingPresheaf (crystallineDStar p I γ π hπ hIC hpnil J hJ hIJ E hE)))

/-- The `D(*)`-cosimplicial module with stages `M_n ⊗^∧_{D(n)} Ω^i_{D(n)}`,
obtained as the objectwise `p`-adic completion of `M_* ⊗ Ω^i_{D(*)}`. -/
def crystallineOmegaPowerTensor :
    CosimplicialObject Ab :=
  adicCompletion
    (crystallinePAdicIdeal p I γ π hπ hIC hpnil J hJ hIJ E hE)
    (Monoidal.tensorObj M
      (crystallineOmegaPowerDStar p I γ π hπ hIC hpnil J hJ hIJ E hE γbar i))

/-- The degree-`n` object of `M_* ⊗^∧ Ω^i_{D(*)}` is the `p`-adic completion of
`M_n ⊗_{D(n)} Ω^i_{D(n)}`. -/
theorem crystallineOmegaPowerTensor_obj (n : ℕ) :
    (crystallineOmegaPowerTensor p I γ π hπ hIC hpnil J hJ hIJ E hE γbar i M).obj
        (SimplexCategory.mk n) =
      AddCommGrpCat.of
        (adicCompletionObj
          (crystallinePAdicIdeal p I γ π hπ hIC hpnil J hJ hIJ E hE)
          (Monoidal.tensorObj M
            (crystallineOmegaPowerDStar p I γ π hπ hIC hpnil J hJ hIJ E hE γbar i))
          (SimplexCategory.mk n)) :=
  rfl
