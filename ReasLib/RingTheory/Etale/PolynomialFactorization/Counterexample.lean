module

public import ReasLib.RingTheory.Etale.PolynomialFactorization
import Mathlib.Algebra.Polynomial.Degree.SmallDegree
import Mathlib.RingTheory.Polynomial.Nilpotent
import Mathlib.RingTheory.Smooth.Flat
import Mathlib.Tactic.CrossRefAttribute

/-!
# A counterexample to etale polynomial-factorization lifting

The factor `2 * X^2 + 2 * X + 1` over `ℤ / 4ℤ` is coprime to itself and squares to one, but its
leading coefficient is not a unit.  It therefore supplies the counterexample showing that the
unit-leading-coefficient hypothesis in the etale factorization theorem is necessary.

@stack 07M2
-/

@[expose] public section

open Polynomial

universe u

namespace Algebra.EtaleFactorization.ModFour

/-- The ideal `4ℤ` used in the factorization counterexample. -/
@[stacks 07M2 "counterexample ideal"]
def ideal : Ideal ℤ :=
  Ideal.span ({(4 : ℤ)} : Set ℤ)

/-- The polynomial `2 * X^2 + 2 * X + 1` over `ℤ / 4ℤ`. -/
@[stacks 07M2 "counterexample reduced factor"]
noncomputable def factor : (ℤ ⧸ ideal)[X] :=
  2 * X ^ 2 + 2 * X + 1

/-- The class of `2` is nonzero modulo `4`. -/
@[stacks 07M2 "two is nonzero modulo four"]
theorem two_ne_zero : ((2 : ℤ) : ℤ ⧸ ideal) ≠ 0 := by
  intro h
  have hmem : (2 : ℤ) ∈ ideal := Ideal.Quotient.eq_zero_iff_mem.mp h
  norm_num [ideal, Ideal.mem_span_singleton] at hmem

/-- The quotient `ℤ / 4ℤ` is nontrivial. -/
@[stacks 07M2 "the quotient modulo four is nontrivial"]
theorem quotient_nontrivial : Nontrivial (ℤ ⧸ ideal) := by
  exact ⟨⟨((2 : ℤ) : ℤ ⧸ ideal), 0, two_ne_zero⟩⟩

/-- Base change sends the counterexample ideal to the principal ideal generated by `4`. -/
@[stacks 07M2 "base change of the counterexample ideal"]
theorem map_ideal (A : Type u) [CommRing A] [Algebra ℤ A] :
    Ideal.map (algebraMap ℤ A) ideal = Ideal.span ({(4 : A)} : Set A) := by
  rw [ideal, Ideal.map_span, Set.image_singleton]
  congr 1
  simp

/-- In an etale `ℤ`-algebra with nontrivial reduction modulo `4`, an element reducing to `2` is
not nilpotent. -/
@[stacks 07M2 "etale rigidity of the class of two modulo four"]
theorem not_isNilpotent_of_eq_two
    (A : Type u) [CommRing A] [Algebra ℤ A] [Algebra.Etale ℤ A]
    [Nontrivial (A ⧸ Ideal.map (algebraMap ℤ A) ideal)]
    {x : A}
    (hx : Ideal.Quotient.mk (Ideal.map (algebraMap ℤ A) ideal) x =
      Ideal.Quotient.mk (Ideal.map (algebraMap ℤ A) ideal) (((2 : ℤ) : A))) :
    ¬ IsNilpotent x := by
  intro hnil
  have hmem : x - (2 : A) ∈ Ideal.span ({(4 : A)} : Set A) := by
    rw [← map_ideal A]
    exact Ideal.Quotient.eq.mp (by simpa only [Int.cast_ofNat] using hx)
  obtain ⟨y, hy⟩ := Ideal.mem_span_singleton.mp hmem
  have hxy : x = 2 * (1 + 2 * y) := by
    calc
      x = (x - 2) + 2 := by ring
      _ = 2 * (1 + 2 * y) := by rw [hy]; ring
  have hnil' : IsNilpotent (1 + 2 * y) := by
    obtain ⟨n, hn⟩ := hnil
    have hreg : IsSMulRegular ℤ ((2 : ℤ) ^ n) := by
      intro a b hab
      apply mul_left_cancel₀ (pow_ne_zero n (by norm_num : (2 : ℤ) ≠ 0))
      simpa only [smul_eq_mul] using hab
    refine ⟨n, hreg.of_flat (S := A) ?_⟩
    simpa only [smul_eq_mul, map_pow, map_ofNat, mul_zero, hxy, mul_pow] using hn
  have hu2 : IsUnit (2 : A) := by
    apply isUnit_of_mul_isUnit_left (y := y)
    convert hnil'.isUnit_sub_one using 1
    ring
  have hu4 : IsUnit (4 : A) := by
    convert hu2.pow 2 using 1
    norm_num
  have h4zero : Ideal.Quotient.mk (Ideal.map (algebraMap ℤ A) ideal) (4 : A) = 0 := by
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    rw [map_ideal A]
    exact Ideal.subset_span (Set.mem_singleton 4)
  exact (hu4.map (Ideal.Quotient.mk _)).ne_zero h4zero

/-- The reduced counterexample factor squares to one. -/
@[stacks 07M2 "the reduced factor squares to one"]
theorem factor_sq : factor ^ 2 = 1 := by
  have h4 : (4 : ℤ ⧸ ideal) = 0 := by
    change Ideal.Quotient.mk ideal 4 = 0
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton 4))
  have h4poly : (4 : (ℤ ⧸ ideal)[X]) = 0 := by
    simpa only [C_ofNat, C_0] using congrArg (C : ℤ ⧸ ideal → (ℤ ⧸ ideal)[X]) h4
  calc
    factor ^ 2 = 4 * (X ^ 4 + 2 * X ^ 3 + 2 * X ^ 2 + X) + 1 := by
      unfold factor
      ring
    _ = 1 := by rw [h4poly, zero_mul, zero_add]

/-- The reduced counterexample factor is coprime to itself. -/
@[stacks 07M2 "self-coprimeness of the reduced factor"]
theorem factor_isCoprime : IsCoprime factor factor := by
  refine ⟨factor, 0, ?_⟩
  simpa [pow_two] using factor_sq

/-- The leading coefficient of the reduced counterexample factor is not a unit. -/
@[stacks 07M2 "the reduced leading coefficient is not a unit"]
theorem factor_leadingCoeff_not_isUnit : ¬ IsUnit factor.leadingCoeff := by
  letI := quotient_nontrivial
  have hlc : factor.leadingCoeff = 2 := by
    simpa only [factor, C_ofNat, C_1] using
      (leadingCoeff_quadratic (b := (2 : ℤ ⧸ ideal)) (c := 1)
        (by simpa using two_ne_zero : (2 : ℤ ⧸ ideal) ≠ 0))
  rw [hlc]
  have hnil : IsNilpotent (2 : ℤ ⧸ ideal) := by
    refine ⟨2, ?_⟩
    change Ideal.Quotient.mk ideal 4 = 0
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton 4))
  exact hnil.not_isUnit

/-- Example 15.9.7: the factorization of `1` by two copies of `factor` has no etale lift that
preserves the quotient modulo `4`. -/
@[stacks 07M2 "failure of etale factorization lifting without a unit leading coefficient"]
theorem no_etale_factorization_lift :
    ¬ ∃ (A' : Type u) (_ : CommRing A') (_ : Algebra ℤ A') (_ : Algebra.Etale ℤ A')
        (quotientAlgEquiv :
          (ℤ ⧸ ideal) ≃ₐ[ℤ ⧸ ideal]
            (A' ⧸ Ideal.map (algebraMap ℤ A') ideal))
        (g' h' : A'[X]),
        (1 : ℤ[X]).map (algebraMap ℤ A') = g' * h' ∧
          factor.map quotientAlgEquiv.toRingHom =
            g'.map (Ideal.Quotient.mk (Ideal.map (algebraMap ℤ A') ideal)) ∧
          factor.map quotientAlgEquiv.toRingHom =
            h'.map (Ideal.Quotient.mk (Ideal.map (algebraMap ℤ A') ideal)) := by
  rintro ⟨A', _, _, _, e, g', h', hprod, hg, _⟩
  letI : Nontrivial (A' ⧸ Ideal.map (algebraMap ℤ A') ideal) :=
    ⟨⟨e (((2 : ℤ) : ℤ ⧸ ideal)), e 0, fun h => two_ne_zero (e.injective h)⟩⟩
  have hgunit : IsUnit g' :=
    .of_mul_eq_one h' (by simpa only [Polynomial.map_one] using hprod.symm)
  have hcoeff : factor.coeff 1 = 2 := by
    simp [factor, ← C_ofNat, coeff_X_pow, coeff_one]
  have hx : Ideal.Quotient.mk (Ideal.map (algebraMap ℤ A') ideal) (g'.coeff 1) =
      Ideal.Quotient.mk (Ideal.map (algebraMap ℤ A') ideal) (((2 : ℤ) : A')) := by
    have hc := congrArg (fun p => p.coeff 1) hg
    simp only [coeff_map, hcoeff] at hc
    simpa only [map_ofNat, Int.cast_ofNat] using hc.symm
  exact not_isNilpotent_of_eq_two A' hx
    ((coeff_isUnit_isNilpotent_of_isUnit hgunit).2 1 one_ne_zero)

end Algebra.EtaleFactorization.ModFour
