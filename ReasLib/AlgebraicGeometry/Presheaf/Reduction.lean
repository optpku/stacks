module

public import ReasLib.AlgebraicGeometry.AlgebraicSpace.FunctorOfPoints
public import ReasLib.AlgebraicGeometry.Scheme.RepresentableProperty
public import Mathlib.AlgebraicGeometry.Properties
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.CategoryTheory.Sites.Subsheaf

@[expose] public section

open CategoryTheory Opposite
open AlgebraicGeometry.AlgebraicSpace (IsAlgebraicSpace)

universe u

namespace AlgebraicGeometry.SpacePresheaf

variable {S : Scheme.{u}}

/-- A presheaf has a reduced étale atlas if it admits an étale, étale-locally
surjective morphism from a reduced scheme over the base. -/
def HasReducedEtaleAtlas (F : (Over S)ᵒᵖ ⥤ Type u) : Prop :=
  ∃ (U : Over S) (atlas : yoneda.obj U ⟶ F),
    IsReduced U.left ∧ Scheme.representableMorphismProperty S (@Etale) atlas ∧
      Presheaf.IsLocallySurjective (Scheme.etaleTopology.over S) atlas

/-- The subpresheaf generated by the images of all morphisms from reduced
schemes over the base. -/
noncomputable def reducedGenerators (F : (Over S)ᵒᵖ ⥤ Type u) : Subfunctor F :=
  ⨆ (U : Over S) (_ : IsReduced U.left) (morphism : yoneda.obj U ⟶ F),
    Subfunctor.range morphism

/-- The reduced subsheaf is the fppf sheafification of the subpresheaf
generated by reduced schemes. -/
noncomputable def reduction (F : (Over S)ᵒᵖ ⥤ Type u) : Subfunctor F :=
  (reducedGenerators F).sheafify (Scheme.fppfTopology.over S)

/-- The reduced subfunctor of an fppf sheaf is an fppf sheaf. -/
theorem reduction_isSheaf (F : (Over S)ᵒᵖ ⥤ Type u)
    (hF : Presheaf.IsSheaf (Scheme.fppfTopology.over S) F) :
    Presheaf.IsSheaf (Scheme.fppfTopology.over S) (reduction F).toFunctor := sorry

/-- Every morphism from a reduced algebraic space to an algebraic space
factors uniquely through its reduced subsheaf. -/
theorem reduction_universal (F : (Over S)ᵒᵖ ⥤ Type u) [IsAlgebraicSpace F]
    {G : (Over S)ᵒᵖ ⥤ Type u} [IsAlgebraicSpace G]
    (hReduced : HasReducedEtaleAtlas G) (morphism : G ⟶ F) :
    ∃! factor : G ⟶ (reduction F).toFunctor, factor ≫ (reduction F).ι = morphism := sorry

/-- The reduced subsheaf of an algebraic space is an algebraic space. -/
theorem reduction_isAlgebraicSpace (F : (Over S)ᵒᵖ ⥤ Type u)
    [IsAlgebraicSpace F] : IsAlgebraicSpace (reduction F).toFunctor := sorry

/-- The reduced subsheaf of an algebraic space admits a reduced étale atlas. -/
theorem reduction_hasReducedEtaleAtlas (F : (Over S)ᵒᵖ ⥤ Type u)
    [IsAlgebraicSpace F] : HasReducedEtaleAtlas (reduction F).toFunctor := sorry

/-- The inclusion of the reduced subsheaf of an algebraic space is a
representable surjective closed immersion. -/
theorem reductionι_isThickening (F : (Over S)ᵒᵖ ⥤ Type u)
    [IsAlgebraicSpace F] :
    Scheme.representableMorphismProperty S (@IsClosedImmersion ⊓ @Surjective)
      (reduction F).ι := sorry

end AlgebraicGeometry.SpacePresheaf
