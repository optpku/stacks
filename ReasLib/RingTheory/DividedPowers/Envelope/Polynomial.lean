module

public import Mathlib.RingTheory.MvPolynomial.Basic
public import ReasLib.RingTheory.DividedPowers.Polynomial
public import ReasLib.RingTheory.DividedPowers.Envelope.Universal
@[expose] public section

open CategoryTheory
open DividedPowers

universe u

namespace DividedPowerEnvelope

/-- The ideal in `MvPolynomial ι B` generated by the image of `J` and all variables. -/
noncomputable def polynomialIdeal {B : Type u} [CommRing B] (J : Ideal B) (ι : Type u) :
    Ideal (MvPolynomial ι B) :=
  Ideal.map (algebraMap B (MvPolynomial ι B)) J +
    Ideal.span (Set.range MvPolynomial.X)

/-- The polynomial-envelope ideal is the sum of the extended base ideal and the variable ideal. -/
theorem polynomialIdeal_def {B : Type u} [CommRing B] (J : Ideal B) (ι : Type u) :
    polynomialIdeal J ι =
      Ideal.map (algebraMap B (MvPolynomial ι B)) J +
        Ideal.span (Set.range MvPolynomial.X) := sorry

/-- The image of the base divided-power ideal lies in the polynomial-envelope ideal. -/
theorem map_le_polynomialIdeal
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J) (ι : Type u) :
    Ideal.map (algebraMap A (MvPolynomial ι B)) I ≤ polynomialIdeal J ι := by
  rw [IsScalarTower.algebraMap_eq A B (MvPolynomial ι B), ← Ideal.map_map]
  exact (Ideal.map_mono hIJ).trans le_sup_left

/-- Adjoin divided-power polynomial variables to the carrier of an envelope. -/
noncomputable def adjoinVariables
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ) (ι : Type u) :
    DividedPowerRing.{u} :=
  DividedPowerRing.of (DPPolynomial E.D ι)
    (DPPolynomial.ideal E.D ι E.D.ideal)
    (DPPolynomial.dividedPowers E.D.dividedPowers)

/-- The distinguished ideal after adjoining variables is the canonical extended ideal. -/
theorem adjoinVariables_ideal
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ) (ι : Type u) :
    (adjoinVariables hIJ E ι).ideal = DPPolynomial.ideal E.D ι E.D.ideal := sorry

/-- The divided powers after adjoining variables are the canonical polynomial divided powers. -/
theorem adjoinVariables_dividedPowers
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ) (ι : Type u) :
    (adjoinVariables hIJ E ι).dividedPowers =
      DPPolynomial.dividedPowers E.D.dividedPowers := sorry

/-- Evaluate ordinary polynomial coefficients through `E.toD` and variables as divided-power
variables. -/
noncomputable def polynomialMap
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ) (ι : Type u) :
    MvPolynomial ι B →+* DPPolynomial E.D ι :=
  MvPolynomial.eval₂Hom
    ((algebraMap E.D (DPPolynomial E.D ι)).comp E.toD) (DPPolynomial.X E.D)

/-- The polynomial evaluation map sends a constant to the corresponding envelope coefficient. -/
theorem polynomialMap_C
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ)
    (ι : Type u) (b : B) :
    polynomialMap hIJ E ι (MvPolynomial.C b) =
      algebraMap E.D (DPPolynomial E.D ι) (E.toD b) := sorry

/-- The polynomial evaluation map sends each ordinary variable to its divided-power variable. -/
theorem polynomialMap_X
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ)
    (ι : Type u) (i : ι) :
    polynomialMap hIJ E ι (MvPolynomial.X i) = DPPolynomial.X E.D i := sorry

/-- The polynomial evaluation map is compatible with the divided powers on the base ideal. -/
theorem polynomialMap_isDPMorphism
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ) (ι : Type u) :
    IsDPMorphism γ (adjoinVariables hIJ E ι).dividedPowers
      ((polynomialMap hIJ E ι).comp (algebraMap A (MvPolynomial ι B))) := by
  have hcomp : (polynomialMap hIJ E ι).comp (algebraMap A (MvPolynomial ι B)) =
      (algebraMap E.D (DPPolynomial E.D ι)).comp E.base.toRingHom := by
    rw [E.base_toD]
    ext a
    simp [polynomialMap, IsScalarTower.algebraMap_eq A B (MvPolynomial ι B)]
  rw [hcomp]
  exact (DPPolynomial.dividedPowers_algebraMap_isDPMorphism E.D.dividedPowers).comp _
    E.base.isDPMorphism

/-- The polynomial evaluation map sends the polynomial-envelope ideal into the canonical
divided-power polynomial ideal. -/
theorem map_polynomialIdeal_le
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ) (ι : Type u) :
    Ideal.map (polynomialMap hIJ E ι) (polynomialIdeal J ι) ≤
      (adjoinVariables hIJ E ι).ideal := by
  change Ideal.map (polynomialMap hIJ E ι)
    (Ideal.map (algebraMap B (MvPolynomial ι B)) J ⊔ Ideal.span (Set.range MvPolynomial.X)) ≤
      DPPolynomial.ideal E.D ι E.D.ideal
  rw [Ideal.map_sup, sup_le_iff, Ideal.map_map]
  constructor
  · have hcomp : (polynomialMap hIJ E ι).comp (algebraMap B (MvPolynomial ι B)) =
        (algebraMap E.D (DPPolynomial E.D ι)).comp E.toD := by
      ext b
      simp [polynomialMap]
    rw [hcomp, ← Ideal.map_map]
    exact (Ideal.map_mono E.ideal_map).trans le_sup_left
  · rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    change polynomialMap hIJ E ι (MvPolynomial.X i) ∈ DPPolynomial.ideal E.D ι E.D.ideal
    simp only [polynomialMap, MvPolynomial.eval₂Hom_X']
    apply (show DPPolynomial.positiveIdeal E.D ι ≤
      DPPolynomial.ideal E.D ι E.D.ideal from le_sup_right)
    change DividedPowerAlgebra.dp E.D 1 (Finsupp.single i 1) ∈ DPPolynomial.positiveIdeal E.D ι
    exact Ideal.subset_span ⟨(i, ⟨1, Nat.zero_lt_one⟩), rfl⟩

/-- The coefficient map into a polynomial envelope is compatible with the divided powers on the
base ideal. -/
theorem coefficientMap_isDPMorphism
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι)) :
    IsDPMorphism γ Epoly.D.dividedPowers
      ((Epoly.toD.comp (MvPolynomial.C : B →+* MvPolynomial ι B)).comp
        (algebraMap A B)) := by
  have hcomp :
      (Epoly.toD.comp (MvPolynomial.C : B →+* MvPolynomial ι B)).comp
        (algebraMap A B) = Epoly.base.toRingHom := by
    rw [Epoly.base_toD, RingHom.comp_assoc]
    rfl
  rw [hcomp]
  exact Epoly.base.isDPMorphism

/-- The coefficient map into a polynomial envelope sends `J` into its distinguished ideal. -/
theorem map_coefficientIdeal_le
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι)) :
    Ideal.map (Epoly.toD.comp (MvPolynomial.C : B →+* MvPolynomial ι B)) J ≤
      Epoly.D.ideal := by
  rw [← Ideal.map_map]
  exact (Ideal.map_mono (show Ideal.map (MvPolynomial.C : B →+* MvPolynomial ι B) J ≤
    polynomialIdeal J ι from le_sup_left)).trans Epoly.ideal_map

/-- The morphism from a base envelope to a polynomial envelope induced by constants. -/
noncomputable def baseToPolynomial
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ)
    (hE : IsUniversal γ (algebraMap A B) hIJ E) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι)) :
    E.D ⟶ Epoly.D :=
  (hE (Epoly.toD.comp (MvPolynomial.C : B →+* MvPolynomial ι B))
    (coefficientMap_isDPMorphism hIJ ι Epoly)
    (map_coefficientIdeal_le hIJ ι Epoly)).choose

/-- The base comparison restricts to the coefficient map on `B`. -/
theorem baseToPolynomial_spec
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ)
    (hE : IsUniversal γ (algebraMap A B) hIJ E) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι)) :
    (baseToPolynomial hIJ E hE ι Epoly).toRingHom.comp E.toD =
      Epoly.toD.comp (MvPolynomial.C : B →+* MvPolynomial ι B) := by
  exact (hE (Epoly.toD.comp (MvPolynomial.C : B →+* MvPolynomial ι B))
    (coefficientMap_isDPMorphism hIJ ι Epoly)
    (map_coefficientIdeal_le hIJ ι Epoly)).choose_spec.1

/-- A divided-power morphism from a universal base envelope to a polynomial envelope is uniquely
determined by its composite with the envelope map. -/
theorem baseToPolynomial_unique
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ)
    (hE : IsUniversal γ (algebraMap A B) hIJ E) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι))
    (ψ : E.D ⟶ Epoly.D)
    (hψ : ψ.toRingHom.comp E.toD =
      Epoly.toD.comp (MvPolynomial.C : B →+* MvPolynomial ι B)) :
    ψ = baseToPolynomial hIJ E hE ι Epoly := by
  exact (hE (Epoly.toD.comp (MvPolynomial.C : B →+* MvPolynomial ι B))
    (coefficientMap_isDPMorphism hIJ ι Epoly)
    (map_coefficientIdeal_le hIJ ι Epoly)).choose_spec.2 ψ hψ

/-- The morphism from a universal polynomial envelope to the divided-power polynomial extension
of the base envelope. -/
noncomputable def toAdjoinVariables
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι))
    (hEpoly : IsUniversal γ (algebraMap A (MvPolynomial ι B))
      (map_le_polynomialIdeal hIJ ι) Epoly) :
    Epoly.D ⟶ adjoinVariables hIJ E ι :=
  (hEpoly (T := adjoinVariables hIJ E ι) (polynomialMap hIJ E ι)
    (polynomialMap_isDPMorphism hIJ E ι)
    (map_polynomialIdeal_le hIJ E ι)).choose

/-- The forward comparison restricts to the polynomial evaluation map. -/
theorem toAdjoinVariables_spec
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι))
    (hEpoly : IsUniversal γ (algebraMap A (MvPolynomial ι B))
      (map_le_polynomialIdeal hIJ ι) Epoly) :
    (toAdjoinVariables hIJ E ι Epoly hEpoly).toRingHom.comp Epoly.toD =
      polynomialMap hIJ E ι := by
  exact (hEpoly (T := adjoinVariables hIJ E ι) (polynomialMap hIJ E ι)
    (polynomialMap_isDPMorphism hIJ E ι)
    (map_polynomialIdeal_le hIJ E ι)).choose_spec.1

/-- A divided-power morphism from a universal polynomial envelope to the polynomial extension is
uniquely determined by its composite with the polynomial presentation map. -/
theorem toAdjoinVariables_unique
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι))
    (hEpoly : IsUniversal γ (algebraMap A (MvPolynomial ι B))
      (map_le_polynomialIdeal hIJ ι) Epoly)
    (ψ : Epoly.D ⟶ adjoinVariables hIJ E ι)
    (hψ : ψ.toRingHom.comp Epoly.toD = polynomialMap hIJ E ι) :
    ψ = toAdjoinVariables hIJ E ι Epoly hEpoly := by
  exact (hEpoly (T := adjoinVariables hIJ E ι) (polynomialMap hIJ E ι)
    (polynomialMap_isDPMorphism hIJ E ι)
    (map_polynomialIdeal_le hIJ E ι)).choose_spec.2 ψ hψ

/-- Every polynomial variable maps into the distinguished ideal of a polynomial envelope. -/
theorem variable_mem_polynomialEnvelope
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι)) (i : ι) :
    Epoly.toD (MvPolynomial.X i) ∈ Epoly.D.ideal := sorry

/-- The divided-power polynomial lift from the base comparison, with variables sent to their
images in the polynomial envelope. -/
noncomputable def fromAdjoinVariables
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ)
    (hE : IsUniversal γ (algebraMap A B) hIJ E) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι)) :
    adjoinVariables hIJ E ι ⟶ Epoly.D :=
  DPPolynomial.dpLift (baseToPolynomial hIJ E hE ι Epoly)
    (fun i ↦ ⟨Epoly.toD (MvPolynomial.X i),
      variable_mem_polynomialEnvelope hIJ ι Epoly i⟩)

/-- The reverse comparison restricts to the base-envelope comparison on coefficients. -/
theorem fromAdjoinVariables_base
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ)
    (hE : IsUniversal γ (algebraMap A B) hIJ E) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι)) :
    (fromAdjoinVariables hIJ E hE ι Epoly).toRingHom.comp
        (algebraMap E.D (DPPolynomial E.D ι)) =
      (baseToPolynomial hIJ E hE ι Epoly).toRingHom := sorry

/-- The reverse comparison sends a divided-power variable to the corresponding ordinary
polynomial variable in the envelope. -/
theorem fromAdjoinVariables_X
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ)
    (hE : IsUniversal γ (algebraMap A B) hIJ E) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι)) (i : ι) :
    fromAdjoinVariables hIJ E hE ι Epoly (DPPolynomial.X E.D i) =
      Epoly.toD (MvPolynomial.X i) := sorry

/-- The forward and reverse comparisons compose to the identity on the polynomial envelope. -/
theorem toAdjoinVariables_comp_fromAdjoinVariables
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ)
    (hE : IsUniversal γ (algebraMap A B) hIJ E) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι))
    (hEpoly : IsUniversal γ (algebraMap A (MvPolynomial ι B))
      (map_le_polynomialIdeal hIJ ι) Epoly) :
    toAdjoinVariables hIJ E ι Epoly hEpoly ≫ fromAdjoinVariables hIJ E hE ι Epoly =
      𝟙 Epoly.D := sorry

/-- The reverse and forward comparisons compose to the identity on the polynomial extension. -/
theorem fromAdjoinVariables_comp_toAdjoinVariables
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ)
    (hE : IsUniversal γ (algebraMap A B) hIJ E) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι))
    (hEpoly : IsUniversal γ (algebraMap A (MvPolynomial ι B))
      (map_le_polynomialIdeal hIJ ι) Epoly) :
    fromAdjoinVariables hIJ E hE ι Epoly ≫ toAdjoinVariables hIJ E ι Epoly hEpoly =
      𝟙 (adjoinVariables hIJ E ι) := sorry

/-- The canonical isomorphism between a universal polynomial envelope and the divided-power
polynomial extension of a universal base envelope. -/
noncomputable def polynomialExtensionIso
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ)
    (hE : IsUniversal γ (algebraMap A B) hIJ E) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι))
    (hEpoly : IsUniversal γ (algebraMap A (MvPolynomial ι B))
      (map_le_polynomialIdeal hIJ ι) Epoly) :
    Epoly.D ≅ adjoinVariables hIJ E ι where
  hom := toAdjoinVariables hIJ E ι Epoly hEpoly
  inv := fromAdjoinVariables hIJ E hE ι Epoly
  hom_inv_id := toAdjoinVariables_comp_fromAdjoinVariables hIJ E hE ι Epoly hEpoly
  inv_hom_id := fromAdjoinVariables_comp_toAdjoinVariables hIJ E hE ι Epoly hEpoly

/-- The isomorphism's forward map restricts to polynomial evaluation on the presented ring. -/
theorem polynomialExtensionIso_hom_comp_toD
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ)
    (hE : IsUniversal γ (algebraMap A B) hIJ E) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι))
    (hEpoly : IsUniversal γ (algebraMap A (MvPolynomial ι B))
      (map_le_polynomialIdeal hIJ ι) Epoly) :
    (polynomialExtensionIso hIJ E hE ι Epoly hEpoly).hom.toRingHom.comp Epoly.toD =
      polynomialMap hIJ E ι := sorry

/-- The isomorphism's forward map sends constant polynomials to the corresponding coefficients. -/
theorem polynomialExtensionIso_hom_C
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ)
    (hE : IsUniversal γ (algebraMap A B) hIJ E) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι))
    (hEpoly : IsUniversal γ (algebraMap A (MvPolynomial ι B))
      (map_le_polynomialIdeal hIJ ι) Epoly) (b : B) :
    (polynomialExtensionIso hIJ E hE ι Epoly hEpoly).hom
        (Epoly.toD (MvPolynomial.C b)) =
      algebraMap E.D (DPPolynomial E.D ι) (E.toD b) := sorry

/-- The isomorphism's forward map sends ordinary polynomial variables to divided-power
variables. -/
theorem polynomialExtensionIso_hom_X
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ)
    (hE : IsUniversal γ (algebraMap A B) hIJ E) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι))
    (hEpoly : IsUniversal γ (algebraMap A (MvPolynomial ι B))
      (map_le_polynomialIdeal hIJ ι) Epoly) (i : ι) :
    (polynomialExtensionIso hIJ E hE ι Epoly hEpoly).hom
        (Epoly.toD (MvPolynomial.X i)) = DPPolynomial.X E.D i := sorry

/-- The isomorphism's inverse sends each divided-power variable back to the corresponding
ordinary polynomial variable in the envelope. -/
theorem polynomialExtensionIso_inv_X
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B}
    (hIJ : Ideal.map (algebraMap A B) I ≤ J)
    (E : DividedPowerEnvelope I γ (algebraMap A B) J hIJ)
    (hE : IsUniversal γ (algebraMap A B) hIJ E) (ι : Type u)
    (Epoly : DividedPowerEnvelope I γ (algebraMap A (MvPolynomial ι B))
      (polynomialIdeal J ι) (map_le_polynomialIdeal hIJ ι))
    (hEpoly : IsUniversal γ (algebraMap A (MvPolynomial ι B))
      (map_le_polynomialIdeal hIJ ι) Epoly) (i : ι) :
    (polynomialExtensionIso hIJ E hE ι Epoly hEpoly).inv (DPPolynomial.X E.D i) =
      Epoly.toD (MvPolynomial.X i) := sorry

end DividedPowerEnvelope
