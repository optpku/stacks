module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Data.Complex.Basic
public import Mathlib.RingTheory.Localization.Away.Basic
public import ReasLib.AlgebraicGeometry.Scheme.MeromorphicFunction.Affine

/-!
# The complex line with square-zero fibers

This file constructs a thickening of the complex affine line having one square-zero direction
supported at each complex point, and records its meromorphic-function behavior.
-/

@[expose] public section

open CategoryTheory
open scoped nonZeroDivisors

noncomputable section

namespace AlgebraicGeometry.ComplexLineWithSquareZeroFibers

/-- The variables consist of one coordinate `x` and one fiber variable `y α` for each `α : ℂ`. -/
inductive Variable
  | x
  | y : ℂ → Variable
  deriving DecidableEq

/-- The multivariable polynomial ring over `ℂ` on the coordinate and fiber variables. -/
abbrev PolynomialRing := MvPolynomial Variable ℂ

/-- The relation `(x - α) * y α` supported over the point `α`. -/
def xMinusScalarMulYRelation (α : ℂ) : PolynomialRing :=
  (MvPolynomial.X Variable.x - MvPolynomial.C α) * MvPolynomial.X (Variable.y α)

/-- The relation making the product of any two fiber variables vanish. -/
def yMulYRelation (α β : ℂ) : PolynomialRing :=
  MvPolynomial.X (Variable.y α) * MvPolynomial.X (Variable.y β)

/-- The set of the point-support and pairwise square-zero relations. -/
def relations : Set PolynomialRing :=
  Set.range xMinusScalarMulYRelation ∪
    Set.range (fun p : ℂ × ℂ ↦ yMulYRelation p.1 p.2)

/-- The ideal generated by the point-support and pairwise square-zero relations. -/
def relationIdeal : Ideal PolynomialRing := Ideal.span relations

/-- The coordinate ring of the complex line with a square-zero direction at every complex point. -/
abbrev CoordinateRing := PolynomialRing ⧸ relationIdeal

/-- The class of the affine-line coordinate in the quotient coordinate ring. -/
def x : CoordinateRing :=
  Ideal.Quotient.mk relationIdeal (MvPolynomial.X Variable.x)

/-- The class of the square-zero fiber coordinate supported at `α`. -/
def y (α : ℂ) : CoordinateRing :=
  Ideal.Quotient.mk relationIdeal (MvPolynomial.X (Variable.y α))

/-- The affine spectrum of the coordinate ring. -/
abbrev spectrum : Scheme :=
  Scheme.Spec.obj (Opposite.op <| CommRingCat.of CoordinateRing)

/-- The polynomial-plus-finitely-supported-fiber expression in the quotient coordinate ring. -/
def normalForm : Polynomial ℂ × (ℂ →₀ ℂ) → CoordinateRing := fun data ↦
  Polynomial.eval₂ (algebraMap ℂ CoordinateRing) x data.1 +
    data.2.sum fun α c ↦ algebraMap ℂ CoordinateRing c * y α

/-- Every element of the coordinate ring has a unique polynomial-plus-finitely-supported-fiber
expression. -/
theorem normalForm_bijective : Function.Bijective normalForm := sorry

/-- Every non-zero-divisor in every principal localization of the coordinate ring is a unit. -/
theorem isUnit_of_mem_nonZeroDivisors_localizationAway
    (f : CoordinateRing) (z : Localization.Away f)
    (hz : z ∈ nonZeroDivisors (Localization.Away f)) : IsUnit z := sorry

/-- The canonical map from the structure sheaf of the affine spectrum to its
meromorphic-function sheaf is an isomorphism. -/
noncomputable instance toMeromorphicFunctionSheafHom_isIso :
    IsIso (spectrum.toLocallyRingedSpace.toMeromorphicFunctionSheafHom) := sorry

end AlgebraicGeometry.ComplexLineWithSquareZeroFibers
