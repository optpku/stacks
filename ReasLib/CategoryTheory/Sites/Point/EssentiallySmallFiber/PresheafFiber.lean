module

public import ReasLib.CategoryTheory.Functor.PresheafFiber
public import ReasLib.CategoryTheory.Sites.Point.EssentiallySmallFiber.Basic

/-!
# Presheaf fibers of essentially-small inverse systems

This module provides raw presheaf fibers and canonical germ maps while keeping
smallness and cofiltered-colimit bridges internal when possible.
-/

@[expose] public section

open CategoryTheory Limits Opposite

universe u v q w₀ v₀

noncomputable section

namespace CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered

variable {C : Type u} [Category.{v} C]

namespace EssentiallySmallFiber

variable {I : Type w₀} [Category.{v₀} I]
variable {S : Iᵒᵖ ⥤ C}
variable [LocallySmall.{q} C] [EssentiallySmall.{q} Iᵒᵖ]

/-- The raw presheaf fiber associated to an essentially-small inverse system.
The required colimits are stated explicitly, which is the minimal assumption
for the construction and also covers large fiber universes. -/
noncomputable abbrev presheafFiber (S : Iᵒᵖ ⥤ C)
    [HasColimitsOfShape (fiber S).Elementsᵒᵖ (Type q)] :
    (Cᵒᵖ ⥤ Type q) ⥤ Type q :=
  (fiber S).presheafFiber

/-- The canonical map from a section to the presheaf fiber of an essentially-small inverse
system.  This is the generator-level companion to `presheafFiber`; it is kept with the fiber
owner so users do not need a stagewise-presentation import merely to form a germ. -/
noncomputable abbrev toPresheafFiber
    (S : Iᵒᵖ ⥤ C) (X : C) (x : (fiber S).obj X)
    (F : Cᵒᵖ ⥤ Type q)
    [HasColimitsOfShape (fiber S).Elementsᵒᵖ (Type q)] :
    F.obj (op X) ⟶ (presheafFiber S).obj F :=
  (fiber S).toPresheafFiber X x F

section CanonicalUniverse

variable [LocallySmall.{max u v w₀ v₀} C]
variable [EssentiallySmall.{max u v w₀ v₀} Iᵒᵖ]

/-- The raw presheaf fiber of an essentially-small inverse system in the canonical universe
generated by the ambient category and its indexing category.  This is the default interface when
no separate fiber universe is mathematically significant; use `presheafFiber` to prescribe one
explicitly. -/
noncomputable abbrev presheafFiberMax (S : Iᵒᵖ ⥤ C)
    [HasColimitsOfShape
      (fiber.{u, v, max u v w₀ v₀, w₀, v₀} S).Elementsᵒᵖ
      (Type (max u v w₀ v₀))] :
    (Cᵒᵖ ⥤ Type (max u v w₀ v₀)) ⥤ Type (max u v w₀ v₀) :=
  presheafFiber.{u, v, max u v w₀ v₀, w₀, v₀} S

/-- The canonical-universe presheaf fiber of an essentially-small cofiltered
inverse system. This convenience owner derives the element-category colimits
internally; use `presheafFiberMax` for a general index. -/
noncomputable abbrev Cofiltered.presheafFiberMax (S : Iᵒᵖ ⥤ C)
    [IsCofiltered Iᵒᵖ] :
    (Cᵒᵖ ⥤ Type (max u v w₀ v₀)) ⥤ Type (max u v w₀ v₀) :=
  letI : InitiallySmall.{max u v w₀ v₀} Iᵒᵖ :=
    initiallySmall_of_essentiallySmall Iᵒᵖ
  letI : HasColimitsOfShape
      (fiber.{u, v, max u v w₀ v₀, w₀, v₀} S).Elementsᵒᵖ
      (Type (max u v w₀ v₀)) :=
    hasColimitsOfShape_of_finallySmall _ _
  EssentiallySmallFiber.presheafFiberMax S

end CanonicalUniverse

variable [IsCofiltered Iᵒᵖ]

namespace Cofiltered

/-- The raw presheaf fiber of an essentially-small cofiltered inverse system.
This convenience owner derives the element-category colimits internally. -/
noncomputable abbrev presheafFiber (S : Iᵒᵖ ⥤ C) :
    (Cᵒᵖ ⥤ Type q) ⥤ Type q :=
  letI : InitiallySmall.{q} Iᵒᵖ := initiallySmall_of_essentiallySmall Iᵒᵖ
  letI : HasColimitsOfShape (fiber S).Elementsᵒᵖ (Type q) :=
    hasColimitsOfShape_of_finallySmall _ _
  EssentiallySmallFiber.presheafFiber S

/-- The canonical germ map for an essentially-small cofiltered inverse system.  The smallness
and colimit bridges remain internal to this lower owner, so downstream users only supply the
mathematical data `S`, `x`, and `F`. -/
noncomputable abbrev toPresheafFiber
    (S : Iᵒᵖ ⥤ C) (X : C) (x : (fiber S).obj X)
    (F : Cᵒᵖ ⥤ Type q) :
    F.obj (op X) ⟶ (presheafFiber S).obj F :=
  letI : InitiallySmall.{q} Iᵒᵖ := initiallySmall_of_essentiallySmall Iᵒᵖ
  letI : HasColimitsOfShape (fiber S).Elementsᵒᵖ (Type q) :=
    hasColimitsOfShape_of_finallySmall _ _
  EssentiallySmallFiber.toPresheafFiber S X x F

end Cofiltered

end EssentiallySmallFiber

end CategoryTheory.GrothendieckTopology.Point.ofIsCofiltered
