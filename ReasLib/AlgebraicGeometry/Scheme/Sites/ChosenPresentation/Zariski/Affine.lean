module

public import ReasLib.AlgebraicGeometry.Scheme.Sites.ChosenPresentation.Zariski
public import ReasLib.AlgebraicGeometry.Scheme.StandardZariskiCover

/-!
# Affine Zariski sites in a chosen presentation

This module defines the affine full subcategories of chosen big and small
Zariski sites and the topologies generated by finite standard Zariski covers
which are covering in the corresponding ambient site.
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.ObjectProperty

universe u v

namespace AlgebraicGeometry.ChosenBigZariskiSite

/-- The object property selecting affine represented source schemes in a
chosen big Zariski slice. -/
def bigAffineObjects (X : ChosenBigZariskiSite.{u, v}) (S : X.carrier) :
    ObjectProperty (bigSite X S) :=
  fun U ↦ IsAffine (X.toScheme.obj U.left)

/-- The big affine Zariski carrier is the full subcategory of the chosen big
slice on objects with affine represented source. -/
abbrev bigAffineSite (X : ChosenBigZariskiSite.{u, v}) (S : X.carrier) :=
  ObjectProperty.FullSubcategory (bigAffineObjects X S)

/-- The inclusion of the chosen big affine Zariski carrier into the chosen
big slice. -/
def bigAffineInclusion (X : ChosenBigZariskiSite.{u, v}) (S : X.carrier) :
    bigAffineSite X S ⥤ bigSite X S :=
  ObjectProperty.ι (bigAffineObjects X S)

/-- The source-scheme functor from the chosen big affine Zariski carrier. -/
def bigAffineToScheme (X : ChosenBigZariskiSite.{u, v}) (S : X.carrier) :
    bigAffineSite X S ⥤ Scheme.{u} :=
  bigAffineInclusion X S ⋙ bigToScheme X S

/-- Every object of the chosen big affine Zariski carrier has affine
represented source scheme. -/
theorem bigAffineSite_obj_isAffine (X : ChosenBigZariskiSite.{u, v})
    (S : X.carrier) (U : bigAffineSite X S) :
    IsAffine (X.toScheme.obj U.obj.left) := sorry

/-- The object property selecting affine represented source schemes in the
chosen small Zariski site. -/
def smallAffineObjects (X : ChosenBigZariskiSite.{u, v}) (S : X.carrier) :
    ObjectProperty (smallSite X S) :=
  fun U ↦ IsAffine (X.toScheme.obj U.obj.left)

/-- The small affine Zariski carrier is the full subcategory of the chosen
small site on objects with affine represented source. -/
abbrev smallAffineSite (X : ChosenBigZariskiSite.{u, v}) (S : X.carrier) :=
  ObjectProperty.FullSubcategory (smallAffineObjects X S)

/-- The inclusion of the chosen small affine Zariski carrier into the chosen
small site. -/
def smallAffineInclusion (X : ChosenBigZariskiSite.{u, v}) (S : X.carrier) :
    smallAffineSite X S ⥤ smallSite X S :=
  ObjectProperty.ι (smallAffineObjects X S)

/-- The source-scheme functor from the chosen small affine Zariski carrier. -/
def smallAffineToScheme (X : ChosenBigZariskiSite.{u, v}) (S : X.carrier) :
    smallAffineSite X S ⥤ Scheme.{u} :=
  smallAffineInclusion X S ⋙ smallToScheme X S

/-- Every object of the chosen small affine Zariski carrier has affine
represented source scheme. -/
theorem smallAffineSite_obj_isAffine (X : ChosenBigZariskiSite.{u, v})
    (S : X.carrier) (U : smallAffineSite X S) :
    IsAffine (X.toScheme.obj U.obj.obj.left) := sorry

/-- A presieve on the chosen big affine carrier is a standard covering when
it covers in the ambient big slice and its image in schemes generates the
same sieve as a finite standard Zariski cover. -/
def bigAffineStandardCovering (X : ChosenBigZariskiSite.{u, v})
    (S : X.carrier) {U : bigAffineSite X S} (R : Presieve U) : Prop :=
  R.map (bigAffineInclusion X S) ∈ (bigTopology X S).toPrecoverage U.obj ∧
    ∃ 𝒰 : ((bigAffineToScheme X S).obj U).StandardZariskiCover.{u, u},
      Sieve.generate (R.map (bigAffineToScheme X S)) =
        Sieve.generate (Presieve.ofArrows 𝒰.X 𝒰.f)

/-- The precoverage of ambient-covering finite standard families on the
chosen big affine Zariski carrier. -/
def bigAffineStandardPrecoverage (X : ChosenBigZariskiSite.{u, v})
    (S : X.carrier) : Precoverage (bigAffineSite X S) where
  coverings := fun _ ↦ { R | bigAffineStandardCovering X S R }

/-- Membership in the chosen big affine standard precoverage records both
ambient covering and equality of generated sieves with a finite standard
Zariski cover. -/
theorem mem_bigAffineStandardPrecoverage_iff
    (X : ChosenBigZariskiSite.{u, v}) (S : X.carrier)
    {U : bigAffineSite X S} {R : Presieve U} :
    R ∈ bigAffineStandardPrecoverage X S U ↔
      R.map (bigAffineInclusion X S) ∈ (bigTopology X S).toPrecoverage U.obj ∧
        ∃ 𝒰 : ((bigAffineToScheme X S).obj U).StandardZariskiCover.{u, u},
          Sieve.generate (R.map (bigAffineToScheme X S)) =
            Sieve.generate (Presieve.ofArrows 𝒰.X 𝒰.f) := sorry

/-- The Grothendieck topology on the chosen big affine carrier generated by
ambient-covering finite standard Zariski families. -/
def bigAffineTopology (X : ChosenBigZariskiSite.{u, v}) (S : X.carrier) :
    GrothendieckTopology (bigAffineSite X S) :=
  (bigAffineStandardPrecoverage X S).toGrothendieck

/-- A presieve on the chosen small affine carrier is a standard covering when
it covers in the ambient small site and its image in schemes generates the
same sieve as a finite standard Zariski cover. -/
def smallAffineStandardCovering (X : ChosenBigZariskiSite.{u, v})
    (S : X.carrier) {U : smallAffineSite X S} (R : Presieve U) : Prop :=
  R.map (smallAffineInclusion X S) ∈ (smallTopology X S).toPrecoverage U.obj ∧
    ∃ 𝒰 : ((smallAffineToScheme X S).obj U).StandardZariskiCover.{u, u},
      Sieve.generate (R.map (smallAffineToScheme X S)) =
        Sieve.generate (Presieve.ofArrows 𝒰.X 𝒰.f)

/-- The precoverage of ambient-covering finite standard families on the
chosen small affine Zariski carrier. -/
def smallAffineStandardPrecoverage (X : ChosenBigZariskiSite.{u, v})
    (S : X.carrier) : Precoverage (smallAffineSite X S) where
  coverings := fun _ ↦ { R | smallAffineStandardCovering X S R }

/-- Membership in the chosen small affine standard precoverage records both
ambient covering and equality of generated sieves with a finite standard
Zariski cover. -/
theorem mem_smallAffineStandardPrecoverage_iff
    (X : ChosenBigZariskiSite.{u, v}) (S : X.carrier)
    {U : smallAffineSite X S} {R : Presieve U} :
    R ∈ smallAffineStandardPrecoverage X S U ↔
      R.map (smallAffineInclusion X S) ∈ (smallTopology X S).toPrecoverage U.obj ∧
        ∃ 𝒰 : ((smallAffineToScheme X S).obj U).StandardZariskiCover.{u, u},
          Sieve.generate (R.map (smallAffineToScheme X S)) =
            Sieve.generate (Presieve.ofArrows 𝒰.X 𝒰.f) := sorry

/-- The Grothendieck topology on the chosen small affine carrier generated by
ambient-covering finite standard Zariski families. -/
def smallAffineTopology (X : ChosenBigZariskiSite.{u, v}) (S : X.carrier) :
    GrothendieckTopology (smallAffineSite X S) :=
  (smallAffineStandardPrecoverage X S).toGrothendieck

end AlgebraicGeometry.ChosenBigZariskiSite
