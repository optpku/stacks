module

public import ReasLib.Topology.Compactness.Alexander
import StacksCheckRecall

@[expose] public section

/- The finite-refinement conversion is independent of topology and is the small reusable bridge
between the source formulation and Mathlib's finite-subcover form. -/
#check @Set.Finite.exists_finite_subcover_of_refinement

/- Lemma 5.12.15 (Alexander subbase theorem): a topology generated by a subbasis is
quasi-compact when every subbasis cover has a finite refining cover. -/
@[stacks 08ZP "Alexander subbase theorem"]
#check @compactSpace_generateFrom_of_finite_refinement
