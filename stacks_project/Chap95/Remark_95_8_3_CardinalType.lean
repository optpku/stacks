/-!
# Size cuts on algebraic spaces

Cardinal bounds on affine étale covers and on generators of ring extensions,
together with the resulting full subcategories of algebraic spaces over schemes
and their stacks over `(Sch/S)_fppf`.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry MorphismProperty

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

/-- An algebraic space is covered by at most `κ` affine schemes étale over it. -/
def CoveredByCardinalAffines {S : Scheme.{u}} (X : AlgebraicSpace S)
    (κ : Cardinal.{u}) : Prop :=
  ∃ 𝒰 : AffineEtaleCover.{u, u} X, Cardinal.mk 𝒰.I ≤ κ

/-- An affine étale cover of index cardinality at most `κ` witnesses
`CoveredByCardinalAffines`. -/
theorem coveredByCardinalAffines_iff {S : Scheme.{u}} (X : AlgebraicSpace S)
    (κ : Cardinal.{u}) :
    CoveredByCardinalAffines X κ ↔
      ∃ 𝒰 : AffineEtaleCover.{u, u} X, Cardinal.mk 𝒰.I ≤ κ :=
  sorry

/-- An affine algebraic space has a finite `AffineEtaleCover` after refining
each chart into an affine open of `S`, hence is covered by at most `κ` affines
whenever `ℵ₀ ≤ κ`. -/
theorem coveredByCardinalAffines_of_isAffine {S : Scheme.{u}}
    {X : AlgebraicSpace S} {κ : Cardinal.{u}} [IsAffine X]
    (hκ : Cardinal.aleph0 ≤ κ) :
    CoveredByCardinalAffines X κ :=
  sorry

/-- An algebraic space is covered by countably many affine schemes étale over
it. -/
def CoveredByCountablyManyAffines {S : Scheme.{u}} (X : AlgebraicSpace S) :
    Prop :=
  ∃ 𝒰 : AffineEtaleCover.{u, u} X, Countable 𝒰.I

/-- A countable affine étale cover witnesses
`CoveredByCountablyManyAffines`. -/
theorem coveredByCountablyManyAffines_iff {S : Scheme.{u}}
    (X : AlgebraicSpace S) :
    CoveredByCountablyManyAffines X ↔
      ∃ 𝒰 : AffineEtaleCover.{u, u} X, Countable 𝒰.I :=
  sorry

/-- An affine algebraic space is covered by countably many affines. -/
theorem coveredByCountablyManyAffines_of_isAffine {S : Scheme.{u}}
    {X : AlgebraicSpace S} [IsAffine X] : CoveredByCountablyManyAffines X :=
  sorry

/-- An affine étale cover of cardinality at most `ℵ₀` is a countable affine
étale cover. -/
theorem coveredByCountablyManyAffines_of_cardinal {S : Scheme.{u}}
    {X : AlgebraicSpace S} {κ : Cardinal.{u}}
    (h : CoveredByCardinalAffines X κ) (hκ : κ ≤ Cardinal.aleph0) :
    CoveredByCountablyManyAffines X :=
  sorry

/-- An `A`-algebra `B` is generated by a subset of cardinality at most `κ`. -/
def GeneratorsBounded (κ : Cardinal.{u}) (A B : Type u) [CommRing A]
    [CommRing B] [Algebra A B] : Prop :=
  ∃ s : Set B, Cardinal.mk s ≤ κ ∧ Algebra.adjoin A s = ⊤

/-- `GeneratorsBounded` is the existence of a generating set of size `≤ κ`. -/
theorem generatorsBounded_iff (κ : Cardinal.{u}) (A B : Type u) [CommRing A]
    [CommRing B] [Algebra A B] :
    GeneratorsBounded κ A B ↔
      ∃ s : Set B, Cardinal.mk s ≤ κ ∧ Algebra.adjoin A s = ⊤ :=
  sorry

/-- A ring homomorphism has generating set of cardinality at most `κ`. -/
def generatorsBounded_hom (κ : Cardinal.{u}) {A B : Type u} [CommRing A]
    [CommRing B] (f : A →+* B) : Prop :=
  @GeneratorsBounded κ A B _ _ f.toAlgebra

/-- Finite type algebras are generated by countably many elements. -/
theorem generatorsBounded_of_finiteType (A B : Type u) [CommRing A]
    [CommRing B] [Algebra A B] [Algebra.FiniteType A B] :
    GeneratorsBounded Cardinal.aleph0 A B :=
  sorry

/-- The object of `Over S` obtained by restricting `U` to an open of `U.left`. -/
def openOver {S : Scheme.{u}} (U : Over S) (W : U.left.Opens) : Over S :=
  Over.mk (W.ι ≫ U.hom)

/-- The structure morphism of `openOver U W` is the restriction of `U` to `W`. -/
theorem openOver_hom {S : Scheme.{u}} (U : Over S) (W : U.left.Opens) :
    (openOver U W).hom = W.ι ≫ U.hom :=
  sorry

/-- The open immersion `openOver U W ⟶ U` in `Over S`. -/
def openOverι {S : Scheme.{u}} (U : Over S) (W : U.left.Opens) :
    openOver U W ⟶ U :=
  Over.homMk W.ι

/-- The left component of `openOverι U W` is the open immersion of `W`. -/
theorem openOverι_left {S : Scheme.{u}} (U : Over S) (W : U.left.Opens) :
    (openOverι U W).left = W.ι :=
  sorry

/-- The inverse image in `X` of an open of `U` along `f : X ⟶ ofOver U`. -/
def inverseImageAlongOpen {S : Scheme.{u}} {X : AlgebraicSpace S} {U : Over S}
    (f : X ⟶ ofOver U) (W : U.left.Opens) : AlgebraicSpace S :=
  pullbackAlongScheme f ((ofOverFunctor S).map (openOverι U W))

/-- `inverseImageAlongOpen` is the fibre product of `f` with the open of `U`. -/
theorem inverseImageAlongOpen_eq {S : Scheme.{u}} {X : AlgebraicSpace S}
    {U : Over S} (f : X ⟶ ofOver U) (W : U.left.Opens) :
    inverseImageAlongOpen f W =
      pullbackAlongScheme f ((ofOverFunctor S).map (openOverι U W)) :=
  sorry

/-- A morphism `X ⟶ ofOver U` is locally of finite type with countable affine
étale inverse images of affine opens of `U`. -/
class CountablyAffineLocallyOfFiniteType {S : Scheme.{u}}
    {X : AlgebraicSpace S} {U : Over S} (f : X ⟶ ofOver U) : Prop
    extends LocallyOfFiniteType f where
  /-- The inverse image of every affine open of `U` has a countable affine
  étale cover. -/
  of_affineOpen {W : U.left.Opens} (hW : IsAffineOpen W) :
    CoveredByCountablyManyAffines (inverseImageAlongOpen f W)

namespace CountablyAffineLocallyOfFiniteType

/-- The two defining conditions of `CountablyAffineLocallyOfFiniteType`. -/
theorem iff {S : Scheme.{u}} {X : AlgebraicSpace S} {U : Over S}
    (f : X ⟶ ofOver U) :
    CountablyAffineLocallyOfFiniteType f ↔
      LocallyOfFiniteType f ∧
        ∀ {W : U.left.Opens}, IsAffineOpen W →
          CoveredByCountablyManyAffines (inverseImageAlongOpen f W) :=
  sorry

/-- A locally finite type morphism with countable affine inverse images of
affine opens is `CountablyAffineLocallyOfFiniteType`. -/
theorem spec {S : Scheme.{u}} {X : AlgebraicSpace S} {U : Over S}
    (f : X ⟶ ofOver U) [LocallyOfFiniteType f]
    (h : ∀ {W : U.left.Opens}, IsAffineOpen W →
      CoveredByCountablyManyAffines (inverseImageAlongOpen f W)) :
    CountablyAffineLocallyOfFiniteType f :=
  sorry

/-- Inverse images of affine opens along a countable locally finite type
morphism have countable affine covers. -/
theorem spec_of_affineOpen {S : Scheme.{u}} {X : AlgebraicSpace S}
    {U : Over S} (f : X ⟶ ofOver U) [CountablyAffineLocallyOfFiniteType f]
    {W : U.left.Opens} (hW : IsAffineOpen W) :
    CoveredByCountablyManyAffines (inverseImageAlongOpen f W) :=
  sorry

/-- The identity of `ofOver U` is locally of finite type with countable affine
inverse images. -/
instance id {S : Scheme.{u}} {U : Over S} :
    CountablyAffineLocallyOfFiniteType (𝟙 (ofOver U)) :=
  sorry

/-- A finite type morphism `X ⟶ ofOver U` satisfies the countable affine
locally finite type cut. -/
instance of_finiteType {S : Scheme.{u}} {X : AlgebraicSpace S} {U : Over S}
    (f : X ⟶ ofOver U) [FiniteType f] :
    CountablyAffineLocallyOfFiniteType f :=
  sorry

end CountablyAffineLocallyOfFiniteType

/-- A morphism of algebraic spaces is of `κ`-type when étale scheme squares have
ring extensions generated by at most `κ` elements and inverse images of affine
schemes have an affine étale atlas of cardinality at most `κ`. -/
class OfCardinalType (κ : Cardinal.{u}) {S : Scheme.{u}}
    {X Y : AlgebraicSpace S} (f : X ⟶ Y) : Prop where
  /-- Étale scheme squares have `κ`-bounded generation on affine opens. -/
  of_etale {U V : Over S} (a : yoneda.obj U ⟶ X.functorOfPoints)
      (b : yoneda.obj V ⟶ Y.functorOfPoints) (h : U ⟶ V)
      (ha : (over (@AlgebraicGeometry.Etale)).presheaf a)
      (hb : (over (@AlgebraicGeometry.Etale)).presheaf b)
      (w : a ≫ f = yoneda.map h ≫ b) {W : V.left.Opens}
      (hW : IsAffineOpen W) {Z : U.left.Opens} (hZ : IsAffineOpen Z)
      (e : Z ≤ h.left ⁻¹ᵁ W) :
    generatorsBounded_hom κ (h.left.appLE W Z e).hom
  /-- Inverse images of affine schemes have an affine étale atlas of
  cardinality at most `κ`. -/
  of_affine {Z : Over S} [AlgebraicGeometry.IsAffine Z.left]
      (g : ofOver Z ⟶ Y) :
    CoveredByCardinalAffines (pullbackAlongScheme f g) κ

namespace OfCardinalType

/-- The two defining conditions of `OfCardinalType`. -/
theorem iff {κ : Cardinal.{u}} {S : Scheme.{u}} {X Y : AlgebraicSpace S}
    (f : X ⟶ Y) :
    OfCardinalType κ f ↔
      (∀ {U V : Over S} (a : yoneda.obj U ⟶ X.functorOfPoints)
          (b : yoneda.obj V ⟶ Y.functorOfPoints) (h : U ⟶ V),
          (over (@AlgebraicGeometry.Etale)).presheaf a →
            (over (@AlgebraicGeometry.Etale)).presheaf b →
              a ≫ f = yoneda.map h ≫ b →
                ∀ {W : V.left.Opens}, IsAffineOpen W →
                  ∀ {Z : U.left.Opens}, IsAffineOpen Z →
                    ∀ (e : Z ≤ h.left ⁻¹ᵁ W),
                      generatorsBounded_hom κ (h.left.appLE W Z e).hom) ∧
        ∀ {Z : Over S} [AlgebraicGeometry.IsAffine Z.left]
          (g : ofOver Z ⟶ Y),
          CoveredByCardinalAffines (pullbackAlongScheme f g) κ :=
  sorry

/-- The generator-bound field of a morphism of `κ`-type. -/
theorem spec_of_etale {κ : Cardinal.{u}} {S : Scheme.{u}}
    {X Y : AlgebraicSpace S} (f : X ⟶ Y) [OfCardinalType κ f]
    {U V : Over S} (a : yoneda.obj U ⟶ X.functorOfPoints)
    (b : yoneda.obj V ⟶ Y.functorOfPoints) (h : U ⟶ V)
    (ha : (over (@AlgebraicGeometry.Etale)).presheaf a)
    (hb : (over (@AlgebraicGeometry.Etale)).presheaf b)
    (w : a ≫ f = yoneda.map h ≫ b) {W : V.left.Opens} (hW : IsAffineOpen W)
    {Z : U.left.Opens} (hZ : IsAffineOpen Z) (e : Z ≤ h.left ⁻¹ᵁ W) :
    generatorsBounded_hom κ (h.left.appLE W Z e).hom :=
  sorry

/-- The affine-cover field of a morphism of `κ`-type. -/
theorem spec_of_affine {κ : Cardinal.{u}} {S : Scheme.{u}}
    {X Y : AlgebraicSpace S} (f : X ⟶ Y) [OfCardinalType κ f] {Z : Over S}
    [AlgebraicGeometry.IsAffine Z.left] (g : ofOver Z ⟶ Y) :
    CoveredByCardinalAffines (pullbackAlongScheme f g) κ :=
  sorry

/-- The identity morphism is of `κ`-type whenever `ℵ₀ ≤ κ`. -/
instance id {κ : Cardinal.{u}} {S : Scheme.{u}} {X : AlgebraicSpace S}
    [hκ : Fact (Cardinal.aleph0 ≤ κ)] : OfCardinalType κ (𝟙 X) :=
  sorry

end OfCardinalType

/-- The category of algebraic spaces `X` equipped with a morphism to a scheme
over `S`. -/
abbrev spaces (S : Scheme.{u}) :=
  Comma (𝟭 (AlgebraicSpace S)) (ofOverFunctor S)

namespace spaces

/-- The projection sending an object `X / U` to the scheme `U` over `S`. -/
abbrev forget (S : Scheme.{u}) : spaces S ⥤ Over S :=
  Comma.snd (𝟭 (AlgebraicSpace S)) (ofOverFunctor S)

/-- The projection of `spaces S` evaluates to the underlying scheme over `S`. -/
theorem forget_obj (S : Scheme.{u}) (P : spaces S) :
    (forget S).obj P = P.right :=
  sorry

end spaces

namespace CountablyAffineLocallyOfFiniteType

/-- Objects `X / U` of `spaces S` that are locally of finite type with
countable affine inverse images of affine opens. -/
def objectProperty (S : Scheme.{u}) : ObjectProperty (spaces S) :=
  fun P ↦ CountablyAffineLocallyOfFiniteType P.hom

/-- Membership in the countable locally finite type cut is the morphism
property on `P.hom`. -/
theorem objectProperty_iff (S : Scheme.{u}) (P : spaces S) :
    objectProperty S P ↔ CountablyAffineLocallyOfFiniteType P.hom :=
  sorry

/-- The forgetful functor from countable locally finite type algebraic spaces
over schemes over `S`. -/
def forget (S : Scheme.{u}) : (objectProperty S).FullSubcategory ⥤ Over S :=
  (objectProperty S).ι ⋙ spaces.forget S

/-- The forgetful functor is a stack over `(Sch/S)_fppf`. -/
instance forget_isStackOnSite (S : Scheme.{u}) :
    IsStack.OnSite (Scheme.fppfTopology.over S) (forget S) :=
  sorry

/-- The stack of countable locally finite type algebraic spaces over
`(Sch/S)_fppf`. -/
def stack (S : Scheme.{u}) : StackOver (Scheme.fppfTopology.over S) :=
  StackOver.ofProjection (Scheme.fppfTopology.over S) (forget S)

/-- The projection of the countable locally finite type stack is `forget`. -/
theorem stack_p (S : Scheme.{u}) : (stack S).p = forget S := sorry

end CountablyAffineLocallyOfFiniteType

namespace OfCardinalType

/-- Objects `X / U` of `spaces S` whose structure morphism is of `κ`-type. -/
def objectProperty (κ : Cardinal.{u}) (S : Scheme.{u}) :
    ObjectProperty (spaces S) :=
  fun P ↦ OfCardinalType κ P.hom

/-- Membership in the `κ`-type cut is the morphism property on `P.hom`. -/
theorem objectProperty_iff (κ : Cardinal.{u}) (S : Scheme.{u})
    (P : spaces S) :
    objectProperty κ S P ↔ OfCardinalType κ P.hom :=
  sorry

/-- The forgetful functor from algebraic spaces of `κ`-type over schemes
over `S`. -/
def forget (κ : Cardinal.{u}) (S : Scheme.{u}) :
    (objectProperty κ S).FullSubcategory ⥤ Over S :=
  (objectProperty κ S).ι ⋙ spaces.forget S

/-- The forgetful functor of `κ`-type spaces is a stack over `(Sch/S)_fppf`. -/
instance forget_isStackOnSite (κ : Cardinal.{u}) (S : Scheme.{u}) :
    IsStack.OnSite (Scheme.fppfTopology.over S) (forget κ S) :=
  sorry

/-- The stack `Spaces_κ` of morphisms of `κ`-type over `(Sch/S)_fppf`. -/
def stack (κ : Cardinal.{u}) (S : Scheme.{u}) :
    StackOver (Scheme.fppfTopology.over S) :=
  StackOver.ofProjection (Scheme.fppfTopology.over S) (forget κ S)

/-- The projection of `Spaces_κ` is the `κ`-type forgetful functor. -/
theorem stack_p (κ : Cardinal.{u}) (S : Scheme.{u}) :
    (stack κ S).p = forget κ S :=
  sorry

end OfCardinalType

end AlgebraicGeometry.AlgebraicSpace
