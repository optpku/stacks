module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
public import Mathlib.FieldTheory.PurelyInseparable.Basic
public import ReasLib.RingTheory.RingHom.PowerGeneration
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Prime-power generation of field extensions

@stack 0BR9

The ring-level power-generation condition is expressed with a subring closure.
For a field extension, the literal mathematical statement is generation as an
intermediate field.  This leaf makes that distinction explicit and provides
the bridge to the ring-level condition when every generator is algebraic.
-/

@[expose] public section

universe u v

namespace FieldExtension

namespace PowerGeneration

variable {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]

/-- The field extension `K/k` is generated by elements whose positive prime powers and
corresponding scalar multiples lie in the image of `k`. -/
def IsGenerated (p : ℕ) : Prop :=
  IntermediateField.adjoin k (RingHom.PowerGeneration.generators (algebraMap k K) p) = ⊤

/-- Field generation by prime-power/scalar-image elements agrees with the ring-level generation
predicate for the structure map. -/
theorem isGenerated_iff_ringHom {p : ℕ} :
    IsGenerated (k := k) (K := K) p ↔
      RingHom.PowerGeneration.IsGenerated (algebraMap k K) p := sorry

/-- Lemma 10.46.6 (Tag 0BR9): a field extension generated by prime-power/scalar-image elements
is trivial or is purely inseparable in characteristic `p`, and conversely. -/
@[stacks 0BR9]
theorem iff_surjective_or_charP_isPurelyInseparable
    {p : ℕ} [Fact p.Prime] :
    IsGenerated (k := k) (K := K) p ↔
      Function.Surjective (algebraMap k K) ∨
        ringChar k = p ∧ IsPurelyInseparable k K := sorry

end PowerGeneration

end FieldExtension
