module

public import ReasLib.AlgebraicGeometry.Scheme.Divisor.StalkCriterion
public import ReasLib.RingTheory.RegularLocalRing.Parameters

/-!
# Strict normal crossings divisors

This module records the stalkwise parameter description of a strict normal crossings divisor.
-/

@[expose] public section

open AlgebraicGeometry

universe u

namespace AlgebraicGeometry

/-- An effective Cartier divisor has strict normal crossings when every ambient stalk on its
support is regular and its stalk ideal is generated by a nonempty initial product from a regular
system of parameters. -/
class IsStrictNormalCrossingsDivisor {X : Scheme.{u}} [IsLocallyNoetherian X]
    (D : X.IdealSheafData) : Prop extends IsEffectiveCartierDivisor D.subschemeι where
  /-- The ambient local ring is regular at every point of the divisor. -/
  isRegularLocalRing (p : X) (hp : p ∈ D.support) :
    IsRegularLocalRing (X.presheaf.stalk p)
  /-- At every point of the divisor, its stalk ideal is generated by an initial product from a
  regular system of parameters. -/
  existsParameters (p : X) (hp : p ∈ D.support) :
    ∃ (d r : ℕ) (hrd : r ≤ d), 1 ≤ r ∧
      ∃ x : Fin d → IsLocalRing.maximalIdeal (X.presheaf.stalk p),
        IsLocalRing.IsRegularSystemOfParameters x ∧
          RingedSpace.idealSheafStalkIdeal D.toSubobject p =
            Ideal.span
              ({∏ i : Fin r, (x (Fin.castLE hrd i) : X.presheaf.stalk p)} :
                Set (X.presheaf.stalk p))

/-- A strict normal crossings divisor is canonically an effective Cartier divisor. -/
instance instIsEffectiveCartierDivisorOfIsStrictNormalCrossingsDivisor
    {X : Scheme.{u}} [IsLocallyNoetherian X] (D : X.IdealSheafData)
    [hD : IsStrictNormalCrossingsDivisor D] :
    IsEffectiveCartierDivisor D.subschemeι :=
  hD.toIsEffectiveCartierDivisor

/-- The effective-Cartier, regular-stalk, and local parameter-product conditions of a strict
normal crossings divisor hold simultaneously. -/
theorem IsStrictNormalCrossingsDivisor.spec {X : Scheme.{u}} [IsLocallyNoetherian X]
    (D : X.IdealSheafData) [IsStrictNormalCrossingsDivisor D] :
    IsEffectiveCartierDivisor D.subschemeι ∧
      ∀ p : X, p ∈ D.support →
        IsRegularLocalRing (X.presheaf.stalk p) ∧
          ∃ (d r : ℕ) (hrd : r ≤ d), 1 ≤ r ∧
            ∃ x : Fin d → IsLocalRing.maximalIdeal (X.presheaf.stalk p),
              IsLocalRing.IsRegularSystemOfParameters x ∧
                RingedSpace.idealSheafStalkIdeal D.toSubobject p =
                  Ideal.span
                    ({∏ i : Fin r, (x (Fin.castLE hrd i) : X.presheaf.stalk p)} :
                      Set (X.presheaf.stalk p)) := sorry

/-- A divisor has strict normal crossings exactly when it satisfies the effective-Cartier,
regular-stalk, and local parameter-product conditions. -/
theorem isStrictNormalCrossingsDivisor_iff {X : Scheme.{u}} [IsLocallyNoetherian X]
    (D : X.IdealSheafData) :
    IsStrictNormalCrossingsDivisor D ↔
      IsEffectiveCartierDivisor D.subschemeι ∧
        ∀ p : X, p ∈ D.support →
          IsRegularLocalRing (X.presheaf.stalk p) ∧
            ∃ (d r : ℕ) (hrd : r ≤ d), 1 ≤ r ∧
              ∃ x : Fin d → IsLocalRing.maximalIdeal (X.presheaf.stalk p),
                IsLocalRing.IsRegularSystemOfParameters x ∧
                  RingedSpace.idealSheafStalkIdeal D.toSubobject p =
                    Ideal.span
                      ({∏ i : Fin r, (x (Fin.castLE hrd i) : X.presheaf.stalk p)} :
                        Set (X.presheaf.stalk p)) := sorry

end AlgebraicGeometry
