module

public import Mathlib.Algebra.Quotient
public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Algebra.Polynomial.AlgebraMap
public import Mathlib.Algebra.Ring.NonZeroDivisors
public import Mathlib.RingTheory.Flat.Basic
public import ReasLib.AlgebraicGeometry.RingedSpace.Module.GlobalSections.Linear
public import ReasLib.AlgebraicGeometry.RingedSpace.Module.RegularSection
public import ReasLib.AlgebraicGeometry.Scheme.Divisor.EffectiveCartier.Relative
public import ReasLib.AlgebraicGeometry.Scheme.Module.ZeroScheme

/-!
# A nonflat ambient scheme with a relative effective Cartier divisor

This file constructs an affine scheme over a polynomial ring whose distinguished principal
divisor is relatively effective Cartier even though the ambient structural morphism is not flat.
-/

@[expose] public section

universe u

open CategoryTheory
open scoped nonZeroDivisors
open MvPolynomial

noncomputable section

namespace AlgebraicGeometry.RelativeEffectiveCartierCounterexample

/-- The variables consist of one distinguished generator `x` and a sequence of generators
`y n`. -/
inductive Variable
  | x
  | y : ℕ → Variable
  deriving DecidableEq

section

variable (k : Type u) [Field k]

/-- The polynomial base ring `k[t]`. -/
abbrev Base := Polynomial k

/-- The multivariable polynomial algebra over `k[t]` on `x` and the variables `y n`. -/
abbrev Presentation := MvPolynomial Variable (Base k)

/-- The ideal generated by the relations `x * y (n + 1) = y n` and `t * y n = 0`. -/
def relations : Ideal (Presentation k) :=
  Ideal.span
      (Set.range fun n : ℕ ↦
        (X Variable.x) * (X (Variable.y (n + 1))) - X (Variable.y n)) +
    Ideal.span
      (Set.range fun n : ℕ ↦
        (Polynomial.X : Base k) • X (Variable.y n))

/-- The quotient of the polynomial presentation by its defining relation ideal. -/
abbrev Algebra := Presentation k ⧸ relations k

/-- The image of the distinguished polynomial generator `x` in the quotient algebra. -/
def x : Algebra k :=
  Ideal.Quotient.mk (relations k) (X Variable.x)

/-- The principal ideal generated by the distinguished element `x`. -/
def xIdeal : Ideal (Algebra k) :=
  Ideal.span ({x k} : Set (Algebra k))

/-- The quotient of the constructed algebra by the principal ideal generated by `x`. -/
abbrev Quotient := (Algebra k) ⧸ (xIdeal k : Ideal (Algebra k))

/-- The principal ideal generated by `x` is two-sided. -/
instance (priority := low) xIdealIsTwoSided : (xIdeal k).IsTwoSided :=
  ⟨fun b ha ↦ mul_comm b _ ▸ (xIdeal k).smul_mem b ha⟩

/-- The canonical commutative-ring structure on the quotient by the principal ideal generated
by `x`. -/
instance (priority := low) quotientCommRing : CommRing (Quotient k) :=
  @Ideal.Quotient.commRing (Algebra k)
    (@Ideal.Quotient.commRing (Presentation k) inferInstance (relations k)) (xIdeal k)

/-- The canonical `k[t]`-algebra structure on the quotient by the principal ideal generated
by `x`. -/
instance (priority := low) quotientAlgebra : _root_.Algebra (Base k) (Quotient k) :=
  Ideal.Quotient.algebra (R₁ := Base k) (A := Algebra k) (I := xIdeal k)

/-- The affine scheme associated to the polynomial base ring `k[t]`. -/
def baseScheme := Spec (CommRingCat.of (Base k))

/-- The affine scheme associated to the constructed quotient algebra. -/
def scheme := Spec (CommRingCat.of (Algebra k))

/-- The affine structural morphism induced by the algebra map from `k[t]`. -/
def morphism : scheme k ⟶ baseScheme k :=
  Spec.map (CommRingCat.ofHom (algebraMap (Base k) (Algebra k)))

/-- The global section of the structure sheaf corresponding to the distinguished element `x`. -/
def xGlobalSection : Γ(scheme k, ⊤) :=
  (Scheme.ΓSpecIso (CommRingCat.of (Algebra k))).inv.hom (x k)

/-- The section of the structure module corresponding to the distinguished element `x`. -/
def xSection :
    (SheafOfModules.unit (scheme k).ringCatSheaf : (scheme k).Modules).sections :=
  (SheafOfModules.unit (scheme k).ringCatSheaf : (scheme k).Modules).unitHomEquiv
    (RingedSpace.globalSectionMul (X := (scheme k).toRingedSpace) (xGlobalSection k)
      (SheafOfModules.unit (scheme k).ringCatSheaf : (scheme k).Modules))

/-- The ideal-sheaf datum cut out by the distinguished section `x`. -/
def divisor : (scheme k).IdealSheafData :=
  Scheme.zeroIdealSheaf
    (SheafOfModules.unit (scheme k).ringCatSheaf : (scheme k).Modules) (xSection k)

/-- The evaluation map that fixes `k[t]` and sends every polynomial variable to zero. -/
def presentationToBase : Presentation k →ₐ[Base k] Base k :=
  MvPolynomial.aeval fun _ ↦ (0 : Base k)

/-- The evaluation map to the base ring sends every polynomial variable to zero. -/
@[simp] theorem presentationToBase_X (v : Variable) :
    presentationToBase k (X v) = 0 := by
  simp [presentationToBase]

/-- The defining relation ideal is contained in the kernel of evaluation at zero. -/
theorem relations_le_ker :
    relations k ≤ RingHom.ker (presentationToBase k).toRingHom := by
  refine sup_le ?_ ?_
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨n, rfl⟩
    change presentationToBase k
        ((X Variable.x) * X (Variable.y (n + 1)) - X (Variable.y n)) = 0
    simp [presentationToBase]
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨n, rfl⟩
    change presentationToBase k
        ((Polynomial.X : Base k) • X (Variable.y n)) = 0
    simp [presentationToBase]

/-- The quotient algebra maps to the base ring by killing `x` and every `y n`. -/
def toBase : Algebra k →ₐ[Base k] Base k :=
  Ideal.Quotient.liftₐ (R₁ := Base k) (A := Presentation k) (B := Base k)
    (I := relations k) (presentationToBase k)
    fun _ hf ↦ RingHom.mem_ker.mp (relations_le_ker k hf)

/-- The map from the quotient algebra to the base ring is induced by evaluation at zero. -/
@[simp] theorem toBase_mk (f : Presentation k) :
    toBase k (Ideal.Quotient.mk (relations k) f) = presentationToBase k f :=
  rfl

/-- The map from the quotient algebra to the base ring sends `x` to zero. -/
@[simp] theorem toBase_x : toBase k (x k) = 0 := by
  change presentationToBase k (X Variable.x) = 0
  simp

/-- The principal ideal generated by `x` lies in the kernel of the map to the base ring. -/
theorem xIdeal_le_ker :
    xIdeal k ≤ RingHom.ker (toBase k).toRingHom := by
  refine Ideal.span_le.2 ?_
  intro b hb
  rcases Set.mem_singleton_iff.mp hb with rfl
  change toBase k (x k) = 0
  simpa using toBase_x k

/-- The quotient by `x` maps to the base ring through the map that kills `x` and every `y n`. -/
def quotientToBase : Quotient k →ₐ[Base k] Base k :=
  Ideal.Quotient.liftₐ (R₁ := Base k) (A := Algebra k) (B := Base k)
    (I := xIdeal k) (toBase k)
    fun _ hb ↦ RingHom.mem_ker.mp (xIdeal_le_ker k hb)

/-- The comparison map from the quotient by `x` is induced by the map from the original
algebra. -/
@[simp] theorem quotientToBase_mk (b : Algebra k) :
    quotientToBase k (Ideal.Quotient.mk (xIdeal k) b) = toBase k b :=
  rfl

/-- The constructed algebra is not flat over the polynomial base ring. -/
theorem notFlat : ¬ Module.Flat (Base k) (Algebra k) := sorry

/-- The comparison map from the quotient by `x` to the base ring is bijective. -/
theorem quotientToBase_bijective : Function.Bijective (quotientToBase k) := sorry

/-- The comparison morphism from the quotient by `x` to the base ring is an isomorphism. -/
instance quotientToBase_isIso :
    IsIso (CommRingCat.ofHom (quotientToBase k).toRingHom) :=
  (CategoryTheory.ConcreteCategory.isIso_iff_bijective _).2
    (quotientToBase_bijective k)

/-- The comparison map from the quotient by `x` to the base ring is injective. -/
theorem quotientToBase_injective : Function.Injective (quotientToBase k) :=
  (quotientToBase_bijective k).1

/-- The comparison map from the quotient by `x` to the base ring is surjective. -/
theorem quotientToBase_surjective : Function.Surjective (quotientToBase k) :=
  (quotientToBase_bijective k).2

/-- The quotient by the principal ideal generated by `x` is flat over the base ring. -/
instance quotient_flat : Module.Flat (Base k) (Quotient k) := sorry

/-- The distinguished element `x` is a nonzerodivisor in the constructed algebra. -/
theorem x_mem_nonZeroDivisors : x k ∈ nonZeroDivisors (Algebra k) := sorry

/-- The structure-sheaf section associated to `x` is regular. -/
instance xSection_isRegular :
    RingedSpace.IsRegularSection
      (SheafOfModules.unit (scheme k).ringCatSheaf : (scheme k).Modules) (xSection k) := sorry

/-- The ideal-sheaf datum cut out by `x` is relatively effective Cartier over the affine
structural morphism. -/
instance isRelativeEffectiveCartierDivisor :
    IsRelativeEffectiveCartierDivisor (morphism k) (divisor k) := sorry

/-- No open neighborhood of the support of the divisor has flat restricted structural
morphism. -/
theorem not_exists_flat_openContaining_support :
    ¬ ∃ U : (scheme k).Opens,
      ((divisor k).support : Set (scheme k)) ⊆ (U : Set (scheme k)) ∧
        Flat (U.ι ≫ morphism k) := sorry

/-- The distinguished divisor is relatively effective Cartier, but no open neighborhood of its
support has flat restricted structural morphism. -/
theorem spec :
    IsRelativeEffectiveCartierDivisor (morphism k) (divisor k) ∧
      ¬ ∃ U : (scheme k).Opens,
        ((divisor k).support : Set (scheme k)) ⊆ (U : Set (scheme k)) ∧
          Flat (U.ι ≫ morphism k) :=
  ⟨inferInstance, not_exists_flat_openContaining_support k⟩

/-- The affine structural morphism of the constructed algebra is not flat. -/
theorem morphism_notFlat : ¬ Flat (morphism k) := sorry

end

end AlgebraicGeometry.RelativeEffectiveCartierCounterexample
