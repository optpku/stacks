module

public import Mathlib.Algebra.Field.Defs
public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.SetTheory.Cardinal.Aleph
public import ReasLib.AlgebraicGeometry.FormalSpectrum.CountablyIndexedCompletion

/-!
# Gabber's ω₁-algebra as a non-adic* countably indexed completion

Let `ω₁` be the first uncountable ordinal and let `k` be a field. Gabber's
`k`-algebra is generated by `x_α` for `α : ω₁` and `y_{αβ}` for `α < β`,
subject to `x_α = y_{αβ} x_β`. The closed subset `T = V(x_α)` is countably
indexed by `J n = (x_α^(n+1))`, but is not cut out by countably many
functions, and the formal completion along `T` is not adic*.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry
open AlgebraicGeometry.FormalAlgebraicSpace
open TopologicalSpace

noncomputable section

universe u

namespace AlgebraicGeometry.AffineFormalAlgebraicSpace

namespace counterexample

/-- The first uncountable ordinal `ω₁` as a type. -/
abbrev Omega1 : Type u := (Ordinal.omega (1 : Ordinal.{u})).ToType

/-- Pairs `α < β` in `ω₁`, indexing the generators `y_{αβ}`. -/
abbrev PairIndex : Type u := {p : Omega1.{u} × Omega1.{u} // p.1 < p.2}

/-- Variable index of Gabber's `ω₁`-algebra: generators `x_α` and `y_{αβ}`
for `α < β`. -/
abbrev Index : Type u := Omega1.{u} ⊕ PairIndex.{u}

/-- The ideal of relations `x_α - y_{αβ} x_β` for `α < β` in
`MvPolynomial Index k`. -/
def relationIdeal (k : Type u) [Field k] : Ideal (MvPolynomial Index k) :=
  Ideal.span
    (Set.range fun p : PairIndex ↦
      MvPolynomial.X (Sum.inl p.1.1 : Index) -
        MvPolynomial.X (Sum.inr p : Index) *
          MvPolynomial.X (Sum.inl p.1.2 : Index))

/-- `relationIdeal k` is spanned by `X (inl α) - X (inr ⟨α, β⟩) * X (inl β)`
for `α < β`. -/
theorem relationIdeal_eq (k : Type u) [Field k] :
    relationIdeal k =
      Ideal.span
        (Set.range fun p : PairIndex ↦
          MvPolynomial.X (Sum.inl p.1.1 : Index) -
            MvPolynomial.X (Sum.inr p : Index) *
              MvPolynomial.X (Sum.inl p.1.2 : Index)) :=
  rfl

/-- Gabber's `k`-algebra: `k[{x_α, y_{αβ}}]` modulo `x_α = y_{αβ} x_β`. -/
abbrev ring (k : Type u) [Field k] : Type u :=
  MvPolynomial Index k ⧸ relationIdeal k

/-- The image of the generator `x_α` in Gabber's algebra. -/
def x (k : Type u) [Field k] (α : Omega1) : ring k :=
  Ideal.Quotient.mk (relationIdeal k)
    (MvPolynomial.X (Sum.inl (α : Omega1) : Index))

/-- `x k α` is the class of the variable `X (inl α)`. -/
theorem x_eq (k : Type u) [Field k] (α : Omega1) :
    x k α =
      Ideal.Quotient.mk (relationIdeal k)
        (MvPolynomial.X (Sum.inl (α : Omega1) : Index)) :=
  rfl

/-- The image of the generator `y_{αβ}` in Gabber's algebra, for `α < β`. -/
def y (k : Type u) [Field k] {α β : Omega1} (h : α < β) : ring k :=
  Ideal.Quotient.mk (relationIdeal k)
    (MvPolynomial.X (Sum.inr (⟨(α, β), h⟩ : PairIndex) : Index))

/-- `y k h` is the class of the variable `X (inr ⟨α, β⟩)`. -/
theorem y_eq (k : Type u) [Field k] {α β : Omega1} (h : α < β) :
    y k h =
      Ideal.Quotient.mk (relationIdeal k)
        (MvPolynomial.X (Sum.inr (⟨(α, β), h⟩ : PairIndex) : Index)) :=
  rfl

/-- The defining relations of Gabber's algebra: `x_α = y_{αβ} x_β` for
`α < β`. -/
theorem relation (k : Type u) [Field k] {α β : Omega1} (h : α < β) :
    x k α = y k h * x k β :=
  sorry

/-- The closed subset `T = V(x_α)` of `Spec (ring k)`. -/
def zeroLocus (k : Type u) [Field k] : Closeds (Spec (.of (ring k))) :=
  zeroLocusCloseds (Ideal.span (Set.range (x k)))

/-- `zeroLocus k` is the zero locus of the ideal generated by all `x_α`. -/
theorem zeroLocus_eq (k : Type u) [Field k] :
    zeroLocus k = zeroLocusCloseds (Ideal.span (Set.range (x k))) :=
  rfl

/-- The nested stage ideals `J n = (x_α^(n+1))` used to index the completion
along `zeroLocus k`. -/
def stageIdeal (k : Type u) [Field k] (n : ℕ) : Ideal (ring k) :=
  Ideal.span (Set.range fun α : Omega1 ↦ x k α ^ (n + 1))

/-- `stageIdeal k n` is spanned by the powers `x_α^(n+1)`. -/
theorem stageIdeal_eq (k : Type u) [Field k] (n : ℕ) :
    stageIdeal k n = Ideal.span (Set.range fun α : Omega1 ↦ x k α ^ (n + 1)) :=
  rfl

/-- The structure morphism `Spec (ring k) ⟶ Spec k`. -/
def structureHom (k : Type u) [Field k] :
    Spec (.of (ring k)) ⟶ Spec (.of k) :=
  Spec.map (CommRingCat.ofHom (algebraMap k (ring k)))

/-- `structureHom k` is `Spec` of the structure map `k → ring k`. -/
theorem structureHom_eq (k : Type u) [Field k] :
    structureHom k =
      Spec.map (CommRingCat.ofHom (algebraMap k (ring k))) :=
  rfl

end counterexample

/-- Gabber's zero locus `V(x_α)` is countably indexed by the nested ideals
`J n = (x_α^(n+1))`. -/
theorem gabber_isCountablyIndexedAlong (k : Type u) [Field k] :
    IsCountablyIndexedAlong (counterexample.zeroLocus k) :=
  sorry

/-- The completion of Gabber's algebra along `V(x_α)` is countably indexed. -/
instance gabber_isCountablyIndexedAffine (k : Type u) [Field k] :
    IsCountablyIndexedAffine
      (affineCompletionAlong (counterexample.structureHom k)
        (counterexample.zeroLocus k)) :=
  (isCountablyIndexedAffine_completionAlong_iff (counterexample.structureHom k)
    (counterexample.zeroLocus k)).2 (gabber_isCountablyIndexedAlong k)

/-- Gabber's zero locus `V(x_α)` cannot be cut out by countably many
functions in the Gabber algebra. -/
theorem not_cutOutByCountable_gabber (k : Type u) [Field k] :
    ¬ cutOutByCountable (counterexample.zeroLocus k) :=
  sorry

/-- The completion of Gabber's `ω₁`-indexed algebra along `V(x_α)` is not
adic*. -/
theorem gabber_not_isAdicStarAffine (k : Type u) [Field k] :
    ¬ IsAdicStarAffine
        (affineCompletionAlong (counterexample.structureHom k)
          (counterexample.zeroLocus k)) :=
  sorry

end AlgebraicGeometry.AffineFormalAlgebraicSpace
