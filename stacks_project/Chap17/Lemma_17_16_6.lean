module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.Tensor.Properties
import StacksCheckRecall

/-!
# Lemma 17.16.6

Tensor-closure on a ringed space is the opens-site specialization of the canonical ringed-site
API.  The reusable owners are stated for arbitrary sites, so this chapter entry only records the
seven exact source clauses.
-/

@[expose] public section

namespace SheafOfModules

/- Lemma 17.16.6 (1) (01CE): tensor products of module sheaves locally generated by sections are
locally generated by sections. -/
@[stacks 01CE "(1)"]
#check @IsLocallyGeneratedBySections.tensor

/- Lemma 17.16.6 (2) (01CE): tensor products of finite-type module sheaves are of finite type. -/
@[stacks 01CE "(2)"]
#check @IsFiniteType.tensor

/- Lemma 17.16.6 (3) (01CE): tensor products of quasicoherent module sheaves are
quasicoherent. -/
@[stacks 01CE "(3)"]
#check @IsQuasicoherent.tensor

/- Lemma 17.16.6 (4) (01CE): tensor products of finitely presented module sheaves are finitely
presented. -/
@[stacks 01CE "(4)"]
#check @IsFinitePresentation.tensor

/- Lemma 17.16.6 (5) (01CE): tensoring a finitely presented module sheaf with a coherent module
sheaf gives a coherent module sheaf. -/
@[stacks 01CE "(5)"]
#check @IsCoherent.tensor_of_finitePresentation_left

/- Symmetric companion: a coherent left factor and a finitely presented right factor also yield a
coherent tensor product. -/
#check @IsCoherent.tensor_of_finitePresentation_right

/- Lemma 17.16.6 (6) (01CE): tensor products of coherent module sheaves are coherent. -/
@[stacks 01CE "(6)"]
#check @IsCoherent.tensor

/- Lemma 17.16.6 (7) (01CE): tensor products of locally free module sheaves are locally free. -/
@[stacks 01CE "(7)"]
#check @IsLocallyFree.tensor

end SheafOfModules
