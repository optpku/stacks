module

public import Mathlib.Tactic.CrossRefAttribute
public import stacks_project.Chap71.Lemma_71_5_4_FittingIdeal

/-!
# Lemma 71.5.4

A finite-type quasi-coherent module on an algebraic space is generated by `r`
sections on an étale neighbourhood of a point if and only if the stalk of its
`r`th Fitting ideal sheaf is the unit ideal.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.AlgebraicSpace
open AlgebraicGeometry.AlgebraicSpace.Modules

noncomputable section

universe u

namespace AlgebraicGeometry.AlgebraicSpace

namespace fittingIdealSheaf

/-- Lemma 71.5.4: Let `S` be a scheme. Let `X` be an algebraic space over `S`.
Let `F` be a finite type, quasi-coherent `𝒪_X`-module. Let `x ∈ |X|`. Then `F`
can be generated by `r` elements in an étale neighbourhood of `x` if and only
if `fittingIdealStalkIdeal F r xbar = ⊤` in `𝒪_{X, x̄}` for every geometric
point `xbar` lying over `x`. -/
@[stacks 0CZ7]
theorem exists_etale_isGeneratedBy_iff_stalk_eq_top
    {S : Scheme.{u}} {X : AlgebraicSpace S} (F : X.Modules)
    [F.IsFiniteType] [F.IsQuasicoherent] (x : Points X) (r : ℕ) :
    existsEtaleGeneratedBy F x r ↔
      ∀ xbar : GeometricPoint X, xbar.liesOver x →
        fittingIdealStalkIdeal F r xbar = ⊤ :=
  sorry

end fittingIdealSheaf

end AlgebraicGeometry.AlgebraicSpace
