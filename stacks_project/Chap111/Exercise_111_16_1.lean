module

public import ReasLib.FieldTheory.RatFunc.Dimension
public import ReasLib.Algebra.Algebra.Spectrum.Countable
public import ReasLib.RingTheory.Jacobson.Complex
public import ReasLib.RingTheory.Nullstellensatz.Complex
import StacksCheckRecall

@[expose] public section

universe u v

open MvPolynomial
open scoped Cardinal RatFunc

/- Exercise 111.16.1 (1): the rational function field `ℂ⟮X⟯` has uncountable Hamel dimension
over `ℂ`. -/
@[stacks 02DO] #check
  (RatFunc.aleph0_lt_rank_complex : ℵ₀ < Module.rank ℂ ℂ⟮X⟯)

/- Exercise 111.16.1 (2): every linear operator on a nontrivial complex vector space of finite
or countable Hamel dimension has nonempty spectrum. -/
@[stacks 02DO] #check
  (Module.End.spectrum_nonempty_of_rank_le_aleph0 :
    ∀ {V : Type u} [AddCommGroup V] [Module ℂ V] [Nontrivial V]
      (T : Module.End ℂ V), Module.rank ℂ V ≤ ℵ₀ → (spectrum ℂ T).Nonempty)

/- Exercise 111.16.1 (3): if a finitely generated `ℂ`-algebra `R` is a field, then
`algebraMap ℂ R` is bijective. -/
@[stacks 02DO] #check
  (Algebra.FiniteType.algebraMap_bijective_complex_of_isField :
    ∀ (R : Type v) [Field R] [Algebra ℂ R] [Algebra.FiniteType ℂ R],
      Function.Bijective (algebraMap ℂ R))

/- Exercise 111.16.1 (4): every maximal ideal of `MvPolynomial (Fin n) ℂ` is generated by
`X i - C (α i)` for some `α : Fin n → ℂ`. -/
@[stacks 02DO] #check
  (MvPolynomial.eq_span_X_sub_C_of_isMaximal :
    ∀ {n : ℕ} (m : Ideal (MvPolynomial (Fin n) ℂ)) [m.IsMaximal],
      ∃ α : Fin n → ℂ, m = Ideal.span (Set.range fun i ↦ X i - C (α i)))
