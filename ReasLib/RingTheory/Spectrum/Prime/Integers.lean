module

public import Mathlib.RingTheory.Ideal.NatInt
public import Mathlib.RingTheory.Spectrum.Prime.Topology
public import Mathlib.Topology.JacobsonSpace

public section

namespace PrimeSpectrum

/-- Every point of the prime spectrum of the integers is the generic point or is
represented by the ideal generated by a prime natural number. -/
theorem eq_bot_or_span_natPrime (x : PrimeSpectrum ℤ) :
    x = ⊥ ∨ ∃ p : ℕ, Nat.Prime p ∧ x.asIdeal = Ideal.span {(p : ℤ)} := sorry

/-- The closed subsets of the prime spectrum of the integers are the whole
space and the finite subsets of closed points. -/
theorem isClosed_int_iff {s : Set (PrimeSpectrum ℤ)} :
    IsClosed s ↔ s = Set.univ ∨ s.Finite ∧ s ⊆ closedPoints (PrimeSpectrum ℤ) := sorry

end PrimeSpectrum
