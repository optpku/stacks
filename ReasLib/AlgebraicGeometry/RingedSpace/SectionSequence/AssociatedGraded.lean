module

public import Mathlib.Algebra.MvPolynomial.Basic
public import ReasLib.AlgebraicGeometry.RingedSpace.SectionSequence.Regularity
public import ReasLib.RingTheory.Ideal.AssociatedGraded.Basic

/-!
# Associated graded maps of finite families of sections

This module constructs the polynomial-to-associated-graded map determined by
the germs of a finite family of sections on a ringed space.
-/

@[expose] public section

noncomputable section

universe u

open Opposite TopologicalSpace

namespace AlgebraicGeometry.RingedSpace.SectionSequence

variable {X : RingedSpace.{u}} {U : Opens X} {r : ℕ}

/-- The ideal in a stalk generated by the germs of a finite family of sections. -/
def germIdeal (f : Fin r → X.presheaf.obj (op U)) (x : X) (hx : x ∈ U) :
    Ideal (X.presheaf.stalk x) :=
  Ideal.span (Set.range (germFamily f x hx))

/-- A germ of a section, regarded as an element of the ideal generated by all the germs. -/
def germGenerator (f : Fin r → X.presheaf.obj (op U)) (x : X) (hx : x ∈ U)
    (i : Fin r) : germIdeal f x hx :=
  ⟨germFamily f x hx i, Ideal.subset_span (Set.mem_range_self i)⟩

/-- The polynomial map to the associated graded ring that sends each variable to the
degree-one class of the corresponding germ. -/
noncomputable def stalkAssociatedGradedMap
    (f : Fin r → X.presheaf.obj (op U)) (x : X) (hx : x ∈ U) :
    MvPolynomial (Fin r) (X.presheaf.stalk x ⧸ germIdeal f x hx)
      →ₐ[X.presheaf.stalk x ⧸ germIdeal f x hx]
      Ideal.AssociatedGraded.ring (germIdeal f x hx) :=
  MvPolynomial.aeval fun i ↦ Ideal.AssociatedGraded.degreeOne (germGenerator f x hx i)

/-- The stalkwise associated-graded map sends a variable to the degree-one class of the
corresponding germ. -/
@[simp]
theorem stalkAssociatedGradedMap_X
    (f : Fin r → X.presheaf.obj (op U)) (x : X) (hx : x ∈ U) (i : Fin r) :
    stalkAssociatedGradedMap f x hx (MvPolynomial.X i) =
      Ideal.AssociatedGraded.degreeOne (germGenerator f x hx i) := sorry

end AlgebraicGeometry.RingedSpace.SectionSequence
