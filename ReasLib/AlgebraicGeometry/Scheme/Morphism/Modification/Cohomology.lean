/-- For modifications of a normal surface over a two-dimensional normal local base,
the degree-one structure-sheaf cohomology fits into a short exact sequence with the
global sections of the first higher direct image. -/
theorem structureSheafH1_shortExact
    (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [_root_.IsNormalRing A]
    (h_dimension : ringKrullDim A = 2) {X' X : Scheme.{u}}
    (f' : X' ⟶ Spec (.of A)) (f : X ⟶ Spec (.of A))
    [IsModification f'] [IsModification f] (g : X' ⟶ X)
    (sq : CommSq g f' f (𝟙 (Spec (.of A)))) (hX : X.isNormal) :
    ∃ (i : Scheme.Hom.cohomology f (SheafOfModules.unit X.ringCatSheaf) 1 ⟶
        Scheme.Hom.cohomology f' (SheafOfModules.unit X'.ringCatSheaf) 1)
      (p : Scheme.Hom.cohomology f' (SheafOfModules.unit X'.ringCatSheaf) 1 ⟶
        Scheme.Hom.cohomology f
          (RingedSpace.Hom.higherDirectImageModule g.toShHom
            (SheafOfModules.unit X'.ringCatSheaf) 1) 0)
      (zero : i ≫ p = 0),
      (ShortComplex.mk i p zero).ShortExact := sorry

/-- For modifications of a normal surface over a two-dimensional normal local base,
the support of the first higher direct image of the source structure sheaf has
topological Krull dimension zero. -/
theorem higherDirectImageOne_structureSheaf_supportDimension_eq_zero
    (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [_root_.IsNormalRing A]
    (h_dimension : ringKrullDim A = 2) {X' X : Scheme.{u}}
    (f' : X' ⟶ Spec (.of A)) (f : X ⟶ Spec (.of A))
    [IsModification f'] [IsModification f] (g : X' ⟶ X)
    (sq : CommSq g f' f (𝟙 (Spec (.of A)))) (hX : X.isNormal) :
    topologicalKrullDim
      (Scheme.Modules.moduleSupport
        (RingedSpace.Hom.higherDirectImageModule g.toShHom
          (SheafOfModules.unit X'.ringCatSheaf) 1)) = 0 := sorry

/-- For modifications of a normal surface over a two-dimensional normal local base,
the first higher direct image of the source structure sheaf is generated by global
sections. -/
theorem higherDirectImageOne_structureSheaf_isGloballyGenerated
    (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [_root_.IsNormalRing A]
    (h_dimension : ringKrullDim A = 2) {X' X : Scheme.{u}}
    (f' : X' ⟶ Spec (.of A)) (f : X ⟶ Spec (.of A))
    [IsModification f'] [IsModification f] (g : X' ⟶ X)
    (sq : CommSq g f' f (𝟙 (Spec (.of A)))) (hX : X.isNormal) :
    SheafOfModules.IsGloballyGenerated
      (RingedSpace.Hom.higherDirectImageModule g.toShHom
        (SheafOfModules.unit X'.ringCatSheaf) 1) := sorry

/-- For a normal modification over a two-dimensional normal Nagata local base,
morphisms from the residue field shifted by `-1` to the derived pushforward of the
structure sheaf form a subsingleton, with the pushforward viewed in the derived
category of base modules via affine global sections. -/
theorem homResidueFieldShift_negOne_subsingleton
    (A : Type u) [CommRing A] [IsLocalRing A] [NagataRing A] [_root_.IsNormalRing A]
    (h_dimension : ringKrullDim A = 2) {X : Scheme.{u}}
    (f : X ⟶ Spec (.of A)) [IsModification f] (r : ℕ)
    (C : Fin r ≃ irreducibleComponents (f.fiber (IsLocalRing.closedPoint A)))
    (hX : X.isNormal) :
    Subsingleton
      ((ModuleCat.single0 (ModuleCat.of A (IsLocalRing.ResidueField A)))⟦(-1 : ℤ)⟧ ⟶
        (Scheme.DerivedQCoh.affineGlobalSections (CommRingCat.of A)).obj
          ((Scheme.DerivedQCoh.pushforwardCohomologyIn f).obj
            (Scheme.DerivedQCoh.structureSheaf X))) := sorry

/-- For a normal surface modification over a two-dimensional normal Nagata local base,
the degree-one global structure-sheaf cohomology restricts monomorphically to the
inverse image of the punctured spectrum. -/
theorem structureSheafH1_globalRestriction_mono
    (A : Type u) [CommRing A] [IsLocalRing A] [NagataRing A] [_root_.IsNormalRing A]
    (h_dimension : ringKrullDim A = 2) {X : Scheme.{u}}
    (f : X ⟶ Spec (.of A)) [IsModification f] (r : ℕ)
    (C : Fin r ≃ irreducibleComponents (f.fiber (IsLocalRing.closedPoint A)))
    (hX : X.isNormal) :
    Mono (globalRestriction
      ((SheafOfModules.toSheaf X.ringCatSheaf).obj
        (SheafOfModules.unit X.ringCatSheaf)) 1
      (f ⁻¹ᵁ PuncturedSpectrum.puncturedOpen A)) := sorry

end AlgebraicGeometry.IsModification
