module

public import Mathlib.Algebra.Algebra.Tower
public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.HasPullback
public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.AdicCompletion.LocalRing
public import Mathlib.RingTheory.AdicCompletion.RingHom
public import Mathlib.RingTheory.TensorProduct.Maps
public import ReasLib.RingTheory.AdicCompletion.Noetherian
public import ReasLib.AlgebraicGeometry.FormalDeformation.CompleteLocal.ResidueMap

/-!
# Completed pushout tensor in `CompleteLocalAlgCat`

The pushout of a span `R ⟶ S1`, `R ⟶ S2` in `Ĉ_Λ` is the adic completion of
`S1.carrier ⊗[R.carrier] S2.carrier` at the ideal generated by the two extended maximal
ideals, with residue field identified with `k`.
-/

@[expose] public section

open CategoryTheory IsLocalRing Algebra.TensorProduct
open CategoryTheory.Limits (PushoutCocone HasColimit HasPushouts span IsColimit
  hasPushouts_of_hasColimit_span)
open scoped TensorProduct

universe u

variable {Λ k : Type u} [CommRing Λ] [IsNoetherianRing Λ] [Field k] [Algebra Λ k]
  [Module.Finite Λ k]

namespace CompleteLocalAlgCat

noncomputable section

/-- The `R`-algebra structure on `S` induced by a morphism in `CompleteLocalAlgCat`. -/
@[reducible] def algebraOfHom {R S : CompleteLocalAlgCat Λ k} (f : R ⟶ S) :
    Algebra R.carrier S.carrier :=
  f.hom.toRingHom.toAlgebra

/-- `algebraOfHom` is the algebra structure of the underlying ring homomorphism. -/
theorem algebraOfHom_eq {R S : CompleteLocalAlgCat Λ k} (f : R ⟶ S) :
    algebraOfHom f = f.hom.toRingHom.toAlgebra := rfl

/-- Residue identification of `R` as an `R`-algebra structure on `k`. -/
@[reducible] def algebraOfResidueFieldHom (R : CompleteLocalAlgCat Λ k) : Algebra R.carrier k :=
  (residueFieldHom R).toRingHom.toAlgebra

/-- `algebraOfResidueFieldHom` is the algebra structure of `residueFieldHom`. -/
theorem algebraOfResidueFieldHom_eq (R : CompleteLocalAlgCat Λ k) :
    algebraOfResidueFieldHom R = (residueFieldHom R).toRingHom.toAlgebra := rfl

/-- Uncompleted pushout carrier `C = S1.carrier ⊗[R.carrier] S2.carrier`. -/
@[reducible] def pushoutTensor {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    Type u :=
  -- Local instance justification (noncanonical choice): Algebra of S1 over R.carrier is that of f, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom f
  -- Local instance justification (noncanonical choice): Algebra of S2 over R.carrier is that of g, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom g
  S1.carrier ⊗[R.carrier] S2.carrier

/-- The uncompleted pushout tensor is a commutative ring. -/
instance instCommRing_pushoutTensor {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) : CommRing (pushoutTensor f g) :=
  -- Local instance justification (noncanonical choice): Algebra of S1 over R.carrier is that of f, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom f
  -- Local instance justification (noncanonical choice): Algebra of S2 over R.carrier is that of g, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom g
  inferInstanceAs (CommRing (S1.carrier ⊗[R.carrier] S2.carrier))

/-- Scalars induced by a complete local algebra morphism commute with base scalars. -/
theorem pushoutScalarComm {R S : CompleteLocalAlgCat Λ k} (f : R ⟶ S) :
    -- Local instance justification (noncanonical choice): The R-algebra action on S is induced by the specified morphism f.
    letI := algebraOfHom f
    SMulCommClass R.carrier Λ S.carrier := sorry

/-- The uncompleted pushout tensor is a `Λ`-algebra via the left factor. -/
instance instAlgebra_pushoutTensor {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) : Algebra Λ (pushoutTensor f g) :=
  -- Local instance justification (noncanonical choice): Algebra of S1 over R.carrier is that of f, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom f
  -- Local instance justification (noncanonical choice): Algebra of S2 over R.carrier is that of g, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom g
  -- Local instance justification (noncanonical choice): SMulCommClass of R.carrier and Λ on S1.carrier is induced by algebraOfHom f, not a unique ambient structure.
  letI : SMulCommClass R.carrier Λ S1.carrier := pushoutScalarComm f
  inferInstanceAs (Algebra Λ (S1.carrier ⊗[R.carrier] S2.carrier))

/-- Canonical ring homomorphism `S1.carrier →+* pushoutTensor f g`, `x ↦ x ⊗ₜ 1`. -/
def pushoutIncludeLeftRingHom {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) : S1.carrier →+* pushoutTensor f g :=
  -- Local instance justification (noncanonical choice): Algebra of S1 over R.carrier is that of f, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom f
  -- Local instance justification (noncanonical choice): Algebra of S2 over R.carrier is that of g, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom g
  includeLeftRingHom

/-- Canonical ring homomorphism `S2.carrier →+* pushoutTensor f g`, `y ↦ 1 ⊗ₜ y`. -/
def pushoutIncludeRightRingHom {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) : S2.carrier →+* pushoutTensor f g :=
  -- Local instance justification (noncanonical choice): Algebra of S1 over R.carrier is that of f, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom f
  -- Local instance justification (noncanonical choice): Algebra of S2 over R.carrier is that of g, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom g
  includeRight.toRingHom

/-- Canonical `Λ`-algebra map `S1.carrier →ₐ[Λ] pushoutTensor f g`. -/
def pushoutIncludeLeft {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    S1.carrier →ₐ[Λ] pushoutTensor f g :=
  -- Local instance justification (noncanonical choice): Algebra of S1 over R.carrier is that of f, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom f
  -- Local instance justification (noncanonical choice): Algebra of S2 over R.carrier is that of g, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom g
  -- Local instance justification (noncanonical choice): SMulCommClass of R.carrier and Λ on S1.carrier is induced by algebraOfHom f, not a unique ambient structure.
  letI : SMulCommClass R.carrier Λ S1.carrier := pushoutScalarComm f
  includeLeft

/-- The right tensor inclusion preserves the base algebra map. -/
theorem pushoutIncludeRight_commutes {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) (scalar : Λ) :
    pushoutIncludeRightRingHom f g (algebraMap Λ S2.carrier scalar) =
      algebraMap Λ (pushoutTensor f g) scalar := sorry

/-- Canonical `Λ`-algebra map `S2.carrier →ₐ[Λ] pushoutTensor f g`. -/
def pushoutIncludeRight {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    S2.carrier →ₐ[Λ] pushoutTensor f g :=
  { pushoutIncludeRightRingHom f g with commutes' := pushoutIncludeRight_commutes f g }

/-- The underlying ring homomorphism of `pushoutIncludeLeft` is `pushoutIncludeLeftRingHom`. -/
theorem pushoutIncludeLeft_toRingHom {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    (pushoutIncludeLeft f g).toRingHom = pushoutIncludeLeftRingHom f g := rfl

/-- The underlying ring homomorphism of `pushoutIncludeRight` is `pushoutIncludeRightRingHom`. -/
theorem pushoutIncludeRight_toRingHom {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    (pushoutIncludeRight f g).toRingHom = pushoutIncludeRightRingHom f g := rfl

/-- The distinguished ideal `m = m_S1 ⊗ S2 + S1 ⊗ m_S2` of the uncompleted pushout tensor. -/
def pushoutAdicIdeal {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    Ideal (pushoutTensor f g) :=
  S1.maximalIdeal.map (pushoutIncludeLeftRingHom f g) +
    S2.maximalIdeal.map (pushoutIncludeRightRingHom f g)

/-- `pushoutAdicIdeal` is the sum of the extended maximal ideals of the two factors. -/
theorem pushoutAdicIdeal_eq {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    pushoutAdicIdeal f g =
      S1.maximalIdeal.map (pushoutIncludeLeftRingHom f g) +
        S2.maximalIdeal.map (pushoutIncludeRightRingHom f g) := rfl

/-- The left span map intertwines the canonical residue maps. -/
theorem pushoutResidueLeft_commutes {R S1 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (scalar : R.carrier) :
    residueFieldHom S1 (f.hom scalar) = residueFieldHom R scalar := sorry

/-- The right span map intertwines the canonical residue maps. -/
theorem pushoutResidueRight_commutes {R S2 : CompleteLocalAlgCat Λ k}
    (g : R ⟶ S2) (scalar : R.carrier) :
    residueFieldHom S2 (g.hom scalar) = residueFieldHom R scalar := sorry

/-- The tensor product of the residue maps preserves the base algebra map. -/
theorem pushoutResidueBase_commutes {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    -- Local instance justification (noncanonical choice): The R-algebra action on S1 is induced by f.
    letI := algebraOfHom f
    -- Local instance justification (noncanonical choice): The R-algebra action on S2 is induced by g.
    letI := algebraOfHom g
    -- Local instance justification (noncanonical choice): The R-algebra action on k is the specified residue map of R.
    letI := algebraOfResidueFieldHom R
    let left : S1.carrier →ₐ[R.carrier] k :=
      { (residueFieldHom S1).toRingHom with commutes' := pushoutResidueLeft_commutes f }
    let right : S2.carrier →ₐ[R.carrier] k :=
      { (residueFieldHom S2).toRingHom with commutes' := pushoutResidueRight_commutes g }
    ∀ scalar : Λ, (productMap left right).toRingHom
      (algebraMap Λ (pushoutTensor f g) scalar) = algebraMap Λ k scalar := sorry

/-- The canonical `Λ`-algebra map `C →ₐ[Λ] k` induced by the two residue identifications. -/
def pushoutResidueFieldHom {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    pushoutTensor f g →ₐ[Λ] k :=
  -- Local instance justification (noncanonical choice): Algebra of S1 over R.carrier is that of f, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom f
  -- Local instance justification (noncanonical choice): Algebra of S2 over R.carrier is that of g, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom g
  -- Local instance justification (noncanonical choice): Algebra of k over R.carrier is that of residueFieldHom, not a unique ambient Algebra on the carriers.
  letI := algebraOfResidueFieldHom R
  let left : S1.carrier →ₐ[R.carrier] k :=
    { (residueFieldHom S1).toRingHom with commutes' := pushoutResidueLeft_commutes f }
  let right : S2.carrier →ₐ[R.carrier] k :=
    { (residueFieldHom S2).toRingHom with commutes' := pushoutResidueRight_commutes g }
  { (productMap left right).toRingHom with commutes' := pushoutResidueBase_commutes f g }

/-- `pushoutResidueFieldHom` recovers the first residue map on the left inclusion. -/
theorem pushoutResidueFieldHom_comp_includeLeft {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    (pushoutResidueFieldHom f g).toRingHom.comp (pushoutIncludeLeftRingHom f g) =
      (residueFieldHom S1).toRingHom := sorry

/-- `pushoutResidueFieldHom` recovers the second residue map on the right inclusion. -/
theorem pushoutResidueFieldHom_comp_includeRight {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    (pushoutResidueFieldHom f g).toRingHom.comp (pushoutIncludeRightRingHom f g) =
      (residueFieldHom S2).toRingHom := sorry

/-- A right inverse obtained by lifting the given residue class in `S1` and including it
in the tensor. `Quotient.out` selects a representative of this existing quotient class. -/
theorem pushoutResidueFieldHom_rightInverse {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    Function.RightInverse
      (fun x : k ↦ pushoutIncludeLeftRingHom f g (Quotient.out (S1.residueFieldIso.symm x)))
      (pushoutResidueFieldHom f g) := by
  intro x
  change residueFieldHom S1 (Quotient.out (S1.residueFieldIso.symm x)) *
    residueFieldHom S2 1 = x
  change S1.residueFieldIso
      (Ideal.Quotient.mk S1.maximalIdeal (Quotient.out (S1.residueFieldIso.symm x))) *
    residueFieldHom S2 1 = x
  simp only [Ideal.Quotient.mk_out, AlgEquiv.apply_symm_apply, map_one, mul_one]

/-- The canonical map `C → k` is surjective. -/
theorem pushoutResidueFieldHom_surjective {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) : Function.Surjective (pushoutResidueFieldHom f g) :=
  (pushoutResidueFieldHom_rightInverse f g).surjective

/-- The source ideal `m` is the kernel of the canonical map to `k`. -/
theorem pushoutAdicIdeal_eq_ker {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    pushoutAdicIdeal f g = RingHom.ker (pushoutResidueFieldHom f g).toRingHom := sorry

/-- The source ideal `m` is maximal. -/
theorem pushoutAdicIdeal_isMaximal {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) : (pushoutAdicIdeal f g).IsMaximal := sorry

/-- The source ideal `m` is maximal. -/
instance inst_pushoutAdicIdeal_isMaximal {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) : (pushoutAdicIdeal f g).IsMaximal :=
  pushoutAdicIdeal_isMaximal f g

/-- The source ideal `m` is finitely generated. -/
theorem pushoutAdicIdeal_fg {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    (pushoutAdicIdeal f g).FG := sorry

/-- The completed pushout tensor is a local ring. -/
instance inst_pushoutAdicCompletion_isLocalRing {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    IsLocalRing (AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g)) := sorry

/-- The completion of the tensor at the sum of the extended maximal ideals is Noetherian. -/
instance inst_pushoutAdicCompletion_isNoetherianRing {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    IsNoetherianRing (AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g)) := sorry

/-- The completed pushout tensor is a complete local ring. -/
instance inst_pushoutAdicCompletion_isCompleteLocalRing {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    IsCompleteLocalRing (AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g)) := sorry

/-- Scalar tower for the algebra map from the uncompleted tensor into its adic completion. -/
instance inst_pushoutAdicCompletion_isScalarTower {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    IsScalarTower Λ (pushoutTensor f g)
      (AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g)) := sorry

/-- The maximal ideal of the completed pushout tensor is the extension of `pushoutAdicIdeal`. -/
theorem pushoutAdicCompletion_maximalIdeal_eq {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    IsLocalRing.maximalIdeal (AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g)) =
      (pushoutAdicIdeal f g).map
        (algebraMap (pushoutTensor f g)
          (AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g))) := sorry

/-- Residue identification of the completed pushout tensor with `k`. -/
def pushoutAdicCompletionResidueFieldIso {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    ResidueField (AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g)) ≃ₐ[Λ] k :=
  (Ideal.quotientEquivAlgOfEq Λ (pushoutAdicCompletion_maximalIdeal_eq f g)).trans
    (((AdicCompletion.quotientExtensionEquiv (pushoutAdicIdeal f g)
          (pushoutAdicIdeal_fg f g)).restrictScalars Λ).trans
      ((Ideal.quotientEquivAlgOfEq Λ (pushoutAdicIdeal_eq_ker f g)).trans
        (Ideal.quotientKerAlgEquivOfRightInverse (pushoutResidueFieldHom_rightInverse f g))))

/-- The `m`-adic completion of `S1.carrier ⊗[R.carrier] S2.carrier`, as an object of `Ĉ_Λ`. -/
def pushoutAdicCompletion {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    CompleteLocalAlgCat Λ k :=
  of (AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g))
    (pushoutAdicCompletionResidueFieldIso f g)

/-- The carrier of the completed pushout tensor is the indicated adic completion. -/
theorem pushoutAdicCompletion_carrier {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    (pushoutAdicCompletion f g).carrier =
      AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g) := rfl

/-- The bundled residue identification of the completed pushout is the constructed equivalence. -/
theorem pushoutAdicCompletion_residueFieldIso {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    (pushoutAdicCompletion f g).residueFieldIso =
      pushoutAdicCompletionResidueFieldIso f g := rfl

/-- The left inclusion into the completed tensor is local. -/
theorem pushoutInl_isLocalHom {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    IsLocalHom ((IsScalarTower.toAlgHom Λ (pushoutTensor f g)
          (AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g))).comp
      (pushoutIncludeLeft f g)) := sorry

/-- The left inclusion into the completed tensor preserves the residue identification. -/
theorem pushoutInl_residue_compat {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    residueCompat (A := S1) (B := pushoutAdicCompletion f g)
      ((IsScalarTower.toAlgHom Λ (pushoutTensor f g)
          (AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g))).comp
      (pushoutIncludeLeft f g))
      (pushoutInl_isLocalHom f g) = residueIsoHom S1 := sorry

/-- Pushout inclusion of the first factor into the completed tensor. -/
def pushoutInl {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    Hom S1 (pushoutAdicCompletion f g) :=
  Hom.of
    ((IsScalarTower.toAlgHom Λ (pushoutTensor f g)
          (AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g))).comp
      (pushoutIncludeLeft f g))
    (pushoutInl_isLocalHom f g) (pushoutInl_residue_compat f g)

/-- The right inclusion into the completed tensor is local. -/
theorem pushoutInr_isLocalHom {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    IsLocalHom ((IsScalarTower.toAlgHom Λ (pushoutTensor f g)
          (AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g))).comp
      (pushoutIncludeRight f g)) := sorry

/-- The right inclusion into the completed tensor preserves the residue identification. -/
theorem pushoutInr_residue_compat {R S1 S2 : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) :
    residueCompat (A := S2) (B := pushoutAdicCompletion f g)
      ((IsScalarTower.toAlgHom Λ (pushoutTensor f g)
          (AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g))).comp
      (pushoutIncludeRight f g))
      (pushoutInr_isLocalHom f g) = residueIsoHom S2 := sorry

/-- Pushout inclusion of the second factor into the completed tensor. -/
def pushoutInr {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    Hom S2 (pushoutAdicCompletion f g) :=
  Hom.of
    ((IsScalarTower.toAlgHom Λ (pushoutTensor f g)
          (AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g))).comp
      (pushoutIncludeRight f g))
    (pushoutInr_isLocalHom f g) (pushoutInr_residue_compat f g)

/-- The underlying algebra map of the left pushout leg is `pushoutIncludeLeft` then completion. -/
theorem pushoutInl_hom {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    (pushoutInl f g).hom =
      (IsScalarTower.toAlgHom Λ (pushoutTensor f g)
            (AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g))).comp
        (pushoutIncludeLeft f g) := rfl

/-- The underlying algebra map of the right pushout leg is `pushoutIncludeRight` then completion. -/
theorem pushoutInr_hom {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    (pushoutInr f g).hom =
      (IsScalarTower.toAlgHom Λ (pushoutTensor f g)
            (AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g))).comp
        (pushoutIncludeRight f g) := rfl

/-- The two pushout legs coequalize the span. -/
theorem pushout_condition {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    f ≫ pushoutInl f g = g ≫ pushoutInr f g := sorry

/-- The tensor map of a commuting pair of morphisms preserves base scalars. -/
theorem pushoutLift_commutes {R S1 S2 T : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) (h1 : S1 ⟶ T) (h2 : S2 ⟶ T)
    (hcomm : f ≫ h1 = g ≫ h2) :
  -- Local instance justification (noncanonical choice): Algebra of S1 over R.carrier is that of f, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom f
  -- Local instance justification (noncanonical choice): Algebra of S2 over R.carrier is that of g, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom g
  -- Local instance justification (noncanonical choice): Algebra of T over R.carrier is that of f ≫ h1, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom (f ≫ h1)
  let left : S1.carrier →ₐ[R.carrier] T.carrier :=
    { h1.hom.toRingHom with commutes' := fun _ ↦ rfl }
  let right : S2.carrier →ₐ[R.carrier] T.carrier :=
    { h2.hom.toRingHom with
      commutes' := fun r ↦ congrArg (fun φ : R ⟶ T => φ.hom r) hcomm.symm }
  ∀ scalar : Λ, (productMap left right).toRingHom
    (algebraMap Λ (pushoutTensor f g) scalar) = algebraMap Λ T.carrier scalar := sorry


/-- The uncompleted mediating map `C →ₐ[Λ] T.carrier` induced by a commuting square. -/
def pushoutLift {R S1 S2 T : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2)
    (h1 : S1 ⟶ T) (h2 : S2 ⟶ T) (hcomm : f ≫ h1 = g ≫ h2) :
    pushoutTensor f g →ₐ[Λ] T.carrier :=
  -- Local instance justification (noncanonical choice): Algebra of S1 over R.carrier is that of f, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom f
  -- Local instance justification (noncanonical choice): Algebra of S2 over R.carrier is that of g, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom g
  -- Local instance justification (noncanonical choice): Algebra of T over R.carrier is that of f ≫ h1, not a unique ambient Algebra on the carriers.
  letI := algebraOfHom (f ≫ h1)
  let left : S1.carrier →ₐ[R.carrier] T.carrier :=
    { h1.hom.toRingHom with commutes' := fun _ ↦ rfl }
  let right : S2.carrier →ₐ[R.carrier] T.carrier :=
    { h2.hom.toRingHom with
      commutes' := fun r ↦ congrArg (fun φ : R ⟶ T => φ.hom r) hcomm.symm }
  { (productMap left right).toRingHom with commutes' := pushoutLift_commutes f g h1 h2 hcomm }

/-- `pushoutLift` recovers the first factor map on the left inclusion. -/
theorem pushoutLift_comp_includeLeft {R S1 S2 T : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) (h1 : S1 ⟶ T) (h2 : S2 ⟶ T)
    (hcomm : f ≫ h1 = g ≫ h2) :
    (pushoutLift f g h1 h2 hcomm).toRingHom.comp (pushoutIncludeLeftRingHom f g) =
      h1.hom.toRingHom := sorry

/-- `pushoutLift` recovers the second factor map on the right inclusion. -/
theorem pushoutLift_comp_includeRight {R S1 S2 T : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) (h1 : S1 ⟶ T) (h2 : S2 ⟶ T)
    (hcomm : f ≫ h1 = g ≫ h2) :
    (pushoutLift f g h1 h2 hcomm).toRingHom.comp (pushoutIncludeRightRingHom f g) =
      h2.hom.toRingHom := sorry

/-- Powers of `pushoutAdicIdeal` land in powers of the target maximal ideal. -/
theorem pushoutLift_pow_eq_zero {R S1 S2 T : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) (h1 : S1 ⟶ T) (h2 : S2 ⟶ T)
    (hcomm : f ≫ h1 = g ≫ h2) (n : ℕ) :
    ∀ a, a ∈ pushoutAdicIdeal f g ^ n →
      ((Ideal.Quotient.mkₐ Λ (T.maximalIdeal ^ n)).comp
          (pushoutLift f g h1 h2 hcomm)) a = 0 := sorry

/-- The uncompleted mediating map on finite adic quotients. -/
def pushoutLiftQuot {R S1 S2 T : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2)
    (h1 : S1 ⟶ T) (h2 : S2 ⟶ T) (hcomm : f ≫ h1 = g ≫ h2) (n : ℕ) :
    pushoutTensor f g ⧸ pushoutAdicIdeal f g ^ n →ₐ[Λ] T.carrier ⧸ T.maximalIdeal ^ n :=
  Ideal.Quotient.liftₐ (pushoutAdicIdeal f g ^ n)
    ((Ideal.Quotient.mkₐ Λ (T.maximalIdeal ^ n)).comp
      (pushoutLift f g h1 h2 hcomm))
    (pushoutLift_pow_eq_zero f g h1 h2 hcomm n)

/-- `pushoutLiftQuot` evaluates on residue classes by the uncompleted mediating map. -/
theorem pushoutLiftQuot_mk {R S1 S2 T : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2)
    (h1 : S1 ⟶ T) (h2 : S2 ⟶ T) (hcomm : f ≫ h1 = g ≫ h2) (n : ℕ)
    (a : pushoutTensor f g) :
    pushoutLiftQuot f g h1 h2 hcomm n (Ideal.Quotient.mk (pushoutAdicIdeal f g ^ n) a) =
      Ideal.Quotient.mk (T.maximalIdeal ^ n)
        (pushoutLift f g h1 h2 hcomm a) := rfl

/-- Compatible family of maps from the completed pushout tensor to finite quotients of the target. -/
def pushoutDescHomFamily {R S1 S2 T : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2)
    (h1 : S1 ⟶ T) (h2 : S2 ⟶ T) (hcomm : f ≫ h1 = g ≫ h2) (n : ℕ) :
    AdicCompletion (pushoutAdicIdeal f g) (pushoutTensor f g) →ₐ[Λ]
      T.carrier ⧸ T.maximalIdeal ^ n :=
  (pushoutLiftQuot f g h1 h2 hcomm n).comp
    ((AdicCompletion.evalₐ (pushoutAdicIdeal f g) n).restrictScalars Λ)

/-- The family `pushoutDescHomFamily` is compatible with the inverse system of quotients. -/
theorem pushoutDescHom_compat {R S1 S2 T : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) (h1 : S1 ⟶ T) (h2 : S2 ⟶ T)
    (hcomm : f ≫ h1 = g ≫ h2) :
    ∀ {m n : ℕ} (hle : m ≤ n),
      (Ideal.Quotient.factorₐ Λ (Ideal.pow_le_pow_right hle)).comp
          (pushoutDescHomFamily f g h1 h2 hcomm n) =
        pushoutDescHomFamily f g h1 h2 hcomm m := sorry

/-- Underlying algebra map of the pushout mediating morphism. -/
def pushoutDescHom {R S1 S2 T : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2)
    (h1 : S1 ⟶ T) (h2 : S2 ⟶ T) (hcomm : f ≫ h1 = g ≫ h2) :
    (pushoutAdicCompletion f g).carrier →ₐ[Λ] T.carrier :=
  IsAdicComplete.liftAlgHom T.maximalIdeal
    (pushoutDescHomFamily f g h1 h2 hcomm) (pushoutDescHom_compat f g h1 h2 hcomm)

/-- `pushoutDescHom` is the mediating algebra map out of the completed pushout tensor. -/
theorem pushoutDescHom_comp_eval {R S1 S2 T : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) (h1 : S1 ⟶ T) (h2 : S2 ⟶ T)
    (hcomm : f ≫ h1 = g ≫ h2) (n : ℕ) :
    (Ideal.Quotient.mkₐ Λ (T.maximalIdeal ^ n)).comp
        (pushoutDescHom f g h1 h2 hcomm) =
      pushoutDescHomFamily f g h1 h2 hcomm n := sorry

/-- The mediating algebra map from the completed tensor is local. -/
theorem pushoutDesc_isLocalHom {R S1 S2 T : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) (h1 : S1 ⟶ T) (h2 : S2 ⟶ T)
    (hcomm : f ≫ h1 = g ≫ h2) :
    IsLocalHom (pushoutDescHom f g h1 h2 hcomm) := sorry

/-- The mediating algebra map preserves the chosen residue identifications. -/
theorem pushoutDesc_residue_compat {R S1 S2 T : CompleteLocalAlgCat Λ k}
    (f : R ⟶ S1) (g : R ⟶ S2) (h1 : S1 ⟶ T) (h2 : S2 ⟶ T)
    (hcomm : f ≫ h1 = g ≫ h2) :
    residueCompat (pushoutDescHom f g h1 h2 hcomm)
      (pushoutDesc_isLocalHom f g h1 h2 hcomm) =
      residueIsoHom (pushoutAdicCompletion f g) := sorry

/-- Mediating morphism of a pushout in `CompleteLocalAlgCat`. -/
def pushoutDesc {R S1 S2 T : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2)
    (h1 : S1 ⟶ T) (h2 : S2 ⟶ T) (hcomm : f ≫ h1 = g ≫ h2) :
    pushoutAdicCompletion f g ⟶ T :=
  Hom.of (pushoutDescHom f g h1 h2 hcomm)
    (pushoutDesc_isLocalHom f g h1 h2 hcomm) (pushoutDesc_residue_compat f g h1 h2 hcomm)

/-- The underlying algebra map of `pushoutDesc` is `pushoutDescHom`. -/
theorem pushoutDesc_hom {R S1 S2 T : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2)
    (h1 : S1 ⟶ T) (h2 : S2 ⟶ T) (hcomm : f ≫ h1 = g ≫ h2) :
    (pushoutDesc f g h1 h2 hcomm).hom = pushoutDescHom f g h1 h2 hcomm := rfl

/-- The explicit pushout cocone on the completed tensor. -/
def pushoutCocone {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    PushoutCocone f g :=
  PushoutCocone.mk (pushoutInl f g) (pushoutInr f g) (pushout_condition f g)

/-- The vertex of the completed-tensor cocone is the completed pushout tensor. -/
theorem pushoutCocone_pt {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    (pushoutCocone f g).pt = pushoutAdicCompletion f g := rfl

/-- The left leg of the completed-tensor cocone is the left inclusion. -/
theorem pushoutCocone_inl {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    (pushoutCocone f g).inl = pushoutInl f g := rfl

/-- The right leg of the completed-tensor cocone is the right inclusion. -/
theorem pushoutCocone_inr {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    (pushoutCocone f g).inr = pushoutInr f g := rfl

/-- The left inclusion followed by `pushoutDesc` recovers the first factor map. -/
theorem pushoutDesc_comp_inl {R S1 S2 T : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2)
    (h1 : S1 ⟶ T) (h2 : S2 ⟶ T) (hcomm : f ≫ h1 = g ≫ h2) :
    pushoutInl f g ≫ pushoutDesc f g h1 h2 hcomm = h1 := sorry

/-- The right inclusion followed by `pushoutDesc` recovers the second factor map. -/
theorem pushoutDesc_comp_inr {R S1 S2 T : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2)
    (h1 : S1 ⟶ T) (h2 : S2 ⟶ T) (hcomm : f ≫ h1 = g ≫ h2) :
    pushoutInr f g ≫ pushoutDesc f g h1 h2 hcomm = h2 := sorry

/-- A morphism out of the completed pushout tensor is uniquely determined by the two factor maps. -/
theorem pushoutDesc_uniq {R S1 S2 T : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2)
    (h1 : S1 ⟶ T) (h2 : S2 ⟶ T) (hcomm : f ≫ h1 = g ≫ h2)
    (m : pushoutAdicCompletion f g ⟶ T)
    (hf : pushoutInl f g ≫ m = h1) (hg : pushoutInr f g ≫ m = h2) :
    m = pushoutDesc f g h1 h2 hcomm := sorry

/-- The completed-tensor cocone is a colimit cocone. -/
def pushoutCoconeIsColimit {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    IsColimit (pushoutCocone f g) :=
  PushoutCocone.IsColimit.mk (pushout_condition f g)
    (fun s ↦ pushoutDesc f g s.inl s.inr s.condition)
    (fun s ↦ pushoutDesc_comp_inl f g s.inl s.inr s.condition)
    (fun s ↦ pushoutDesc_comp_inr f g s.inl s.inr s.condition)
    (fun s m h₁ h₂ ↦ pushoutDesc_uniq f g s.inl s.inr s.condition m h₁ h₂)

/-- Every span in `CompleteLocalAlgCat Λ k` admits a colimit. -/
instance hasColimit_span {R S1 S2 : CompleteLocalAlgCat Λ k} (f : R ⟶ S1) (g : R ⟶ S2) :
    HasColimit (span f g) :=
  HasColimit.mk ⟨pushoutCocone f g, pushoutCoconeIsColimit f g⟩

/-- The category of complete Noetherian local algebras with a fixed residue field admits pushouts. -/
instance hasPushouts : HasPushouts (CompleteLocalAlgCat Λ k) :=
  hasPushouts_of_hasColimit_span (CompleteLocalAlgCat Λ k)

end

end CompleteLocalAlgCat
