namespace RingedSite.Hom.ModuleDerived.CechCompletion

variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})]
variable [J.HasSheafCompose (forget₂ RingCat.{u} AddCommGrpCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable [HasWeakSheafify J CommRingCat.{u}]
variable [J.WEqualsLocallyBijective CommRingCat.{u}]
variable {O : Sheaf J CommRingCat.{u}}

/-- The product-valued sheaf internal-Hom functor from a fixed cochain complex, followed
by passage to the derived category. -/
noncomputable def sheafHomComplexFunctor
    (sourceComplex : CochainComplex (ringedSiteModuleCategory J O) ℤ) :
    CochainComplex (ringedSiteModuleCategory J O) ℤ ⥤ RingedSiteDerived J O :=
  let tensorExists : ∀ first second : GradedObject ℤ (ringedSiteModuleCategory J O),
      GradedObject.HasTensor first second :=
    fun _ _ _ ↦ Limits.HasColimitsOfShape.has_colimit _
  let goodLeft : ∀ first second third : GradedObject ℤ (ringedSiteModuleCategory J O),
      GradedObject.HasGoodTensor₁₂Tensor first second third :=
    fun _ _ _ _ _ ↦ Limits.PreservesColimitsOfShape.preservesColimit
  let goodRight : ∀ first second third : GradedObject ℤ (ringedSiteModuleCategory J O),
      GradedObject.HasGoodTensorTensor₂₃ first second third :=
    fun _ _ _ _ _ ↦ Limits.PreservesColimitsOfShape.preservesColimit
  let tensorExt : ∀ first second third fourth : GradedObject ℤ (ringedSiteModuleCategory J O),
      GradedObject.HasTensor₄ObjExt first second third fourth :=
    fun _ _ _ _ _ _ ↦ Limits.PreservesColimitsOfShape.preservesColimit
  (@CochainComplex.InternalHom.functor (ringedSiteModuleCategory J O)
    inferInstance inferInstance inferInstance inferInstance inferInstance
    inferInstance inferInstance tensorExists goodLeft goodRight tensorExt
    (fun _ ↦ Limits.PreservesColimitsOfShape.preservesColimit)
    (fun _ ↦ Limits.PreservesColimitsOfShape.preservesColimit) sourceComplex) ⋙ DerivedCategory.Q

/-- For an ideal sheaf generated by finitely many global sections, a derived-completion
reflector exists whose ambient reflection is the right derived functor of sheaf internal Hom
from the extended alternating Čech complex. Its unit is universal among maps to derived-complete
objects, and the derived-functor comparison is invertible on K-injective complexes. -/
theorem existsDerivedCompletion {r : ℕ} (I : Subobject (unitModule J O))
    (f : Fin r → (unitModule J O).sections) (hgen : generatedIdeal f = I) :
    ∃ R : ObjectProperty.Reflector (derivedCompleteObjectProperty.{u, u, u, u} I),
      ∃ alpha : sheafHomComplexFunctor
          ((ExtendedCech.complex f).extend ComplexShape.embeddingUpNat) ⟶
            DerivedCategory.Q ⋙ R.reflection,
        R.reflection.IsRightDerivedFunctor alpha
            (HomologicalComplex.quasiIso (ringedSiteModuleCategory J O) (ComplexShape.up ℤ)) ∧
          (∀ K : RingedSiteDerived J O, IsDerivedCompletion.{u, u, u, u} I (R.unit.app K)) ∧
          (∀ (X : CochainComplex (ringedSiteModuleCategory J O) ℤ) [X.IsKInjective],
            IsIso (alpha.app X)) := sorry

end RingedSite.Hom.ModuleDerived.CechCompletion
