module

public import Mathlib.RingTheory.QuasiFinite.Basic
public import Mathlib.Algebra.Category.ModuleCat.ChangeOfRings
public import ReasLib.Algebra.Category.ModuleCat.FiniteFree.RankOne
public import ReasLib.RingTheory.RingHom.Syntomic.LocalCompleteIntersection
public import ReasLib.RingTheory.Algebra.TensorProduct.Multiplication.Koszul
public import ReasLib.RingTheory.Kaehler.NoetherDifferent

@[expose] public section

open scoped TensorProduct

universe u v

namespace Algebra.LocalizedPresentation

variable {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
  [Algebra.QuasiFinite A B]

/-- A quasi-finite algebra with a localized polynomial presentation by as many
relations as variables is syntomic over its base ring. -/
@[stacks 0BWD]
theorem syntomic {n : ℕ} (hn : 1 ≤ n) (h : MvPolynomial (Fin n) A)
    (f : Fin n → MvPolynomial (Fin n) A) (q : Localization.Away h →ₐ[A] B)
    (h_q : Function.Surjective q)
    (h_ker_q : RingHom.ker q.toRingHom =
      Ideal.span (Set.range fun i ↦
        algebraMap (MvPolynomial (Fin n) A) (Localization.Away h) (f i))) :
    (algebraMap A B).Syntomic := sorry

/-- The annihilator of the diagonal ideal in a quasi-finite localized
polynomial complete-intersection presentation is free of rank one over the target. -/
@[stacks 0BWD]
theorem annihilator_freeRankOne {n : ℕ} (hn : 1 ≤ n)
    (h : MvPolynomial (Fin n) A) (f : Fin n → MvPolynomial (Fin n) A)
    (q : Localization.Away h →ₐ[A] B) (h_q : Function.Surjective q)
    (h_ker_q : RingHom.ker q.toRingHom =
      Ideal.span (Set.range fun i ↦
        algebraMap (MvPolynomial (Fin n) A) (Localization.Away h) (f i))) :
    CategoryTheory.ModuleCat.freeRankOne B
      ((ModuleCat.restrictScalars
        (Algebra.TensorProduct.includeLeft : B →ₐ[A] B ⊗[A] B).toRingHom).obj
          (ModuleCat.of (B ⊗[A] B)
            (KaehlerDifferential.ideal A B).annihilator)) := sorry

/-- The Noether different of a quasi-finite localized polynomial
complete-intersection presentation is generated by the image of its Jacobian determinant. -/
@[stacks 0BWD]
theorem noetherDifferent_eq_span_jacobianDet {n : ℕ} (hn : 1 ≤ n)
    (h : MvPolynomial (Fin n) A) (f : Fin n → MvPolynomial (Fin n) A)
    (q : Localization.Away h →ₐ[A] B) (h_q : Function.Surjective q)
    (h_ker_q : RingHom.ker q.toRingHom =
      Ideal.span (Set.range fun i ↦
        algebraMap (MvPolynomial (Fin n) A) (Localization.Away h) (f i))) :
    KaehlerDifferential.noetherDifferent A B =
      Ideal.span
        {q (algebraMap (MvPolynomial (Fin n) A) (Localization.Away h)
          (Matrix.det (fun i j ↦ MvPolynomial.pderiv j (f i))))} := sorry

end Algebra.LocalizedPresentation
