module

public import Mathlib.AlgebraicTopology.SimplicialObject.Basic
public import Mathlib.CategoryTheory.Comma.Over.Pullback
public import ReasLib.CategoryTheory.Sites.Over.Precoverage
public import ReasLib.CategoryTheory.Sites.Over.Adjunction
public import ReasLib.CategoryTheory.Sites.Precoverage.Continuous
public import ReasLib.CategoryTheory.Sites.Grothendieck.Fiberwise
public import ReasLib.CategoryTheory.Sites.Grothendieck.SimplicialTopos

/-! # Simplicial slice sites and their total category -/

set_option backward.privateInPublic true

@[expose] public section

universe u v

open CategoryTheory CategoryTheory.Limits Opposite

noncomputable section

namespace CategoryTheory.SimplicialObject

variable {C : Type u} [Category.{v} C]

/-- The simplicial object of slice categories `n ↦ Over (U.obj n)`, with structure maps
`Over.map (U.map φ)`. -/
abbrev sliceDiagram (U : SimplicialObject C) : SimplicialObject Cat.{v, max u v} :=
  U ⋙ Over.mapFunctor C

/-- The stage category of `sliceDiagram U` at `n` is `Over (U.obj n)`. -/
theorem sliceDiagram_obj (U : SimplicialObject C) (n : SimplexCategoryᵒᵖ) :
    (sliceDiagram U).obj n = Cat.of (Over (U.obj n)) :=
  rfl

/-- Structure maps of `sliceDiagram U` are postcomposition `Over.map (U.map φ)`. -/
theorem sliceDiagram_map (U : SimplicialObject C) {n m : SimplexCategoryᵒᵖ} (φ : n ⟶ m) :
    (sliceDiagram U).map φ = (Over.map (U.map φ)).toCatHom :=
  rfl

variable (J : GrothendieckTopology C)

/-- The stage precoverage on `Over (U.obj n)` induced by `J`. -/
def slicePrecoverage (U : SimplicialObject C) (n : SimplexCategoryᵒᵖ) :
    Precoverage ((sliceDiagram U).obj n) :=
  (J.over (U.obj n)).toPrecoverage

/-- A presieve covers in `slicePrecoverage J U n` iff the generated sieve covers for
`J.over (U.obj n)`. -/
theorem mem_slicePrecoverage_iff (U : SimplicialObject C) {n : SimplexCategoryᵒᵖ}
    {V : Over (U.obj n)} {R : Presieve V} :
    R ∈ slicePrecoverage J U n V ↔ Sieve.generate R ∈ J.over (U.obj n) V :=
  Iff.rfl

/-- Base change along a structure map `U.map φ` is continuous for the slice
precoverages. -/
theorem sliceStructurePullback_isContinuous (U : SimplicialObject C) [HasPullbacks C]
    {n m : SimplexCategoryᵒᵖ} (φ : n ⟶ m) :
    Functor.Precoverage.IsContinuous (Over.pullback (U.map φ))
      (slicePrecoverage J U m) (slicePrecoverage J U n) :=
  Functor.Precoverage.IsContinuous.ofGrothendieck _ _ _

/-- Structure maps of the slice sites compose up to the canonical `Over.pullbackComp`
isomorphism, rather than as a strict functor `SimplexCategory ⥤ Cat`. -/
noncomputable def sliceStructurePullback_compIso (U : SimplicialObject C) [HasPullbacks C]
    {n m k : SimplexCategoryᵒᵖ} (φ : n ⟶ m) (ψ : m ⟶ k) :
    Over.pullback (U.map (φ ≫ ψ)) ≅
      Over.pullback (U.map ψ) ⋙ Over.pullback (U.map φ) :=
  conjugateIsoEquiv
      (Over.mapPullbackAdj (U.map (φ ≫ ψ)))
      (Over.mapPullbackAdj (U.map φ ≫ U.map ψ))
      (Over.mapCongr (U.map φ ≫ U.map ψ) (U.map (φ ≫ ψ)) (U.map_comp φ ψ).symm) ≪≫
    Over.pullbackComp (U.map φ) (U.map ψ)

/-- `sliceStructurePullback_compIso` is the `Over.pullbackComp` comparison of the two
composites. -/
theorem sliceStructurePullback_compIso_eq (U : SimplicialObject C) [HasPullbacks C]
    {n m k : SimplexCategoryᵒᵖ} (φ : n ⟶ m) (ψ : m ⟶ k) :
    sliceStructurePullback_compIso U φ ψ =
      conjugateIsoEquiv
          (Over.mapPullbackAdj (U.map (φ ≫ ψ)))
          (Over.mapPullbackAdj (U.map φ ≫ U.map ψ))
          (Over.mapCongr (U.map φ ≫ U.map ψ) (U.map (φ ≫ ψ)) (U.map_comp φ ψ).symm) ≪≫
        Over.pullbackComp (U.map φ) (U.map ψ) :=
  rfl

/-- If `C` has fibre products, then `n ↦ C / U_n` is a simplicial object of sites: each
stage is a site and each `Over.map (U.map φ)` has property `P`. -/
instance sliceDiagram_isFiberwiseSite (U : SimplicialObject C) [HasPullbacks C] :
    Grothendieck.IsFiberwiseSite (sliceDiagram U) (slicePrecoverage J U) :=
  { isSite := fun n ↦ J.over_toPrecoverage_isSite (U.obj n)
    hasCoverLifts := fun φ ↦ J.overMap_hasCoverLifts (U.map φ) }


/-- The total category `(C / U)_total`: objects are pairs `(n, V / U_n)`. -/
abbrev sliceTotalSite (U : SimplicialObject C) :=
  Grothendieck (sliceDiagram U)

/-- `sliceTotalSite U` is the Grothendieck construction of `sliceDiagram U`. -/
theorem sliceTotalSite_def (U : SimplicialObject C) :
    sliceTotalSite U = Grothendieck (sliceDiagram U) :=
  rfl

/-- Identity-degree fiber precoverage on `(C / U)_total`. -/
abbrev sliceTotalPrecoverage (J : GrothendieckTopology C) (U : SimplicialObject C) :
    Precoverage (sliceTotalSite U) :=
  Grothendieck.precoverage (sliceDiagram U) (slicePrecoverage J U)

/-- The Grothendieck topology on `(C / U)_total` generated by identity-degree stage
covers. -/
abbrev sliceTotalTopology (J : GrothendieckTopology C) (U : SimplicialObject C) :
    GrothendieckTopology (sliceTotalSite U) :=
  Grothendieck.topology (sliceDiagram U) (slicePrecoverage J U)

/-- The total-site topology is generated by `sliceTotalPrecoverage`. -/
theorem sliceTotalTopology_eq_toGrothendieck (J : GrothendieckTopology C)
    (U : SimplicialObject C) :
    sliceTotalTopology J U = (sliceTotalPrecoverage J U).toGrothendieck :=
  rfl

/-- The adjunction coordinates of total arrows and their explicit inverses are mutually inverse. -/
private theorem sliceTotalHom_pullbackEquiv_laws (U : SimplicialObject C) [HasPullbacks C]
    {X Y : sliceTotalSite U} :
    Function.LeftInverse
      (fun p : Σ φ : Y.base.unop ⟶ X.base.unop,
          X.fiber ⟶ (Over.pullback (U.map φ.op)).obj Y.fiber ↦
        ({ base := p.1.op,
           fiber := ((Over.mapPullbackAdj (U.map p.1.op)).homEquiv X.fiber Y.fiber).symm p.2 } : X ⟶ Y))
      (fun f : X ⟶ Y ↦
        ⟨f.base.unop, (Over.mapPullbackAdj (U.map f.base)).homEquiv X.fiber Y.fiber f.fiber⟩) ∧
    Function.RightInverse
      (fun p : Σ φ : Y.base.unop ⟶ X.base.unop,
          X.fiber ⟶ (Over.pullback (U.map φ.op)).obj Y.fiber ↦
        ({ base := p.1.op,
           fiber := ((Over.mapPullbackAdj (U.map p.1.op)).homEquiv X.fiber Y.fiber).symm p.2 } : X ⟶ Y))
      (fun f : X ⟶ Y ↦
        ⟨f.base.unop, (Over.mapPullbackAdj (U.map f.base)).homEquiv X.fiber Y.fiber f.fiber⟩) := by
  sorry

/-- Total arrows correspond to a simplex operator and an arrow into the associated pullback. -/
def sliceTotalHom_pullbackEquiv (U : SimplicialObject C) [HasPullbacks C]
    {X Y : sliceTotalSite U} :
    (X ⟶ Y) ≃
      Σ φ : Y.base.unop ⟶ X.base.unop,
        X.fiber ⟶ (Over.pullback (U.map φ.op)).obj Y.fiber where
  toFun f :=
    ⟨f.base.unop, (Over.mapPullbackAdj (U.map f.base)).homEquiv X.fiber Y.fiber f.fiber⟩
  invFun p :=
    ({ base := p.1.op,
       fiber := ((Over.mapPullbackAdj (U.map p.1.op)).homEquiv X.fiber Y.fiber).symm p.2 } : X ⟶ Y)
  left_inv := (sliceTotalHom_pullbackEquiv_laws U).1
  right_inv := (sliceTotalHom_pullbackEquiv_laws U).2

/-- The pullback coordinates of a composite are the composite of the coordinates,
transported by the canonical pullback composition isomorphism. -/
theorem sliceTotalHom_pullbackEquiv_comp (U : SimplicialObject C) [HasPullbacks C]
    {X Y Z : sliceTotalSite U} (f : X ⟶ Y) (g : Y ⟶ Z) :
    (Over.mapPullbackAdj (U.map (f.base ≫ g.base))).homEquiv X.fiber Z.fiber (f ≫ g).fiber =
      (sliceTotalHom_pullbackEquiv U f).2 ≫
        (Over.pullback (U.map f.base)).map (sliceTotalHom_pullbackEquiv U g).2 ≫
        (sliceStructurePullback_compIso U f.base g.base).inv.app Z.fiber := by
  sorry

/-- `sliceTotalHom_pullbackEquiv` unpacks a total morphism as its simplex operator and
the adjunct pullback-hom. -/
theorem sliceTotalHom_pullbackEquiv_apply (U : SimplicialObject C) [HasPullbacks C]
    {X Y : sliceTotalSite U} (f : X ⟶ Y) :
    sliceTotalHom_pullbackEquiv U f =
      ⟨f.base.unop, (Over.mapPullbackAdj (U.map f.base)).homEquiv X.fiber Y.fiber f.fiber⟩ :=
  rfl

/-- The inverse of `sliceTotalHom_pullbackEquiv` rebuilds the Grothendieck morphism from a
simplex operator and a pullback-hom. -/
theorem sliceTotalHom_pullbackEquiv_symm_apply (U : SimplicialObject C) [HasPullbacks C]
    {X Y : sliceTotalSite U} (φ : Y.base.unop ⟶ X.base.unop)
    (g : X.fiber ⟶ (Over.pullback (U.map φ.op)).obj Y.fiber) :
    (sliceTotalHom_pullbackEquiv U).symm ⟨φ, g⟩ =
      ({ base := φ.op,
         fiber := ((Over.mapPullbackAdj (U.map φ.op)).homEquiv X.fiber Y.fiber).symm g } : X ⟶ Y) :=
  rfl

/-- An identity-degree family covers in `(C / U)_total` iff the underlying family covers in
`J.over U_n`. -/
theorem ofStage_mem_sliceTotalPrecoverage_iff (J : GrothendieckTopology C)
    (U : SimplicialObject C) {X : sliceTotalSite U} {I : Type (max u v)}
    (V : I → Over (U.obj X.base)) (p : ∀ i, V i ⟶ X.fiber) :
    Grothendieck.ofFiber (sliceDiagram U) X V p ∈ sliceTotalPrecoverage J U X ↔
      Presieve.ofArrows V p ∈ slicePrecoverage J U X.base X.fiber :=
  Grothendieck.ofFiber_mem_iff (sliceDiagram U) (slicePrecoverage J U) V p

/-- The pullback description of total arrows is bijective and preserves the stage covering families. -/
theorem sliceTotal_reproduces (J : GrothendieckTopology C) (U : SimplicialObject C)
    [HasPullbacks C] {X Y : sliceTotalSite U}
    {I : Type (max u v)} (V : I → Over (U.obj X.base)) (p : ∀ i, V i ⟶ X.fiber) :
    Function.Bijective
        (sliceTotalHom_pullbackEquiv U :
          (X ⟶ Y) → Σ φ : Y.base.unop ⟶ X.base.unop,
            X.fiber ⟶ (Over.pullback (U.map φ.op)).obj Y.fiber) ∧
      (Grothendieck.ofFiber (sliceDiagram U) X V p ∈ sliceTotalPrecoverage J U X ↔
        Presieve.ofArrows V p ∈ slicePrecoverage J U X.base X.fiber) :=
  ⟨(sliceTotalHom_pullbackEquiv U).bijective,
    ofStage_mem_sliceTotalPrecoverage_iff J U V p⟩

end CategoryTheory.SimplicialObject
