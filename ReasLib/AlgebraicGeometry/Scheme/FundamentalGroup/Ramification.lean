module

public import Mathlib.Algebra.Algebra.Tower
public import Mathlib.FieldTheory.Galois.Profinite
public import ReasLib.AlgebraicGeometry.Scheme.FunctionField.Inertia
public import ReasLib.AlgebraicGeometry.Scheme.FundamentalGroup.UnramifiedExtension
public import ReasLib.RingTheory.Henselian.StrictHenselization

@[expose] public section

open AlgebraicGeometry
open AlgebraicGeometry.Scheme.FunctionFieldExtension
open InfiniteGalois

universe u

namespace AlgebraicGeometry.Scheme.Ramification

variable (X : Scheme.{u}) [IsIntegral X]

/-- The smallest closed normal subgroup of the absolute Galois group of the function
field containing the inertia subgroup at every point of the separable normalization. -/
noncomputable def inertiaClosure :
    Subgroup Gal(SeparableClosure X.functionField / X.functionField) :=
  (Subgroup.normalClosure
      (⋃ y : (map X (SeparableClosure X.functionField)).normalization,
        (inertia X (SeparableClosure X.functionField) y : Set _))).topologicalClosure

/-- The smallest closed normal subgroup generated by the Galois subgroups fixing fraction
fields of strict henselizations of stalks, over all embeddings compatible with the
canonical stalk-to-function-field map. -/
noncomputable def strictHenselClosure :
    Subgroup Gal(SeparableClosure X.functionField / X.functionField) :=
  (Subgroup.normalClosure
      {σ |
        ∃ (x : X) (Ash : Type u) (_ : CommRing Ash)
          (_ : Algebra (X.presheaf.stalk x) Ash)
          (_ : IsStrictHenselizationOf (X.presheaf.stalk x) Ash) (_ : IsDomain Ash)
          (_ : Algebra X.functionField (FractionRing Ash))
          (_ : Algebra (FractionRing Ash) (SeparableClosure X.functionField))
          (_ : IsScalarTower X.functionField (FractionRing Ash)
            (SeparableClosure X.functionField)),
          (∀ stalkElement : X.presheaf.stalk x,
            algebraMap X.functionField (FractionRing Ash)
                (algebraMap (X.presheaf.stalk x) X.functionField stalkElement) =
              algebraMap Ash (FractionRing Ash)
                (algebraMap (X.presheaf.stalk x) Ash stalkElement)) ∧
          σ ∈ Set.range fun τ :
              Gal(SeparableClosure X.functionField / FractionRing Ash) =>
              AlgEquiv.restrictScalars X.functionField τ}).topologicalClosure

/-- The closed subgroup generated by all inertia subgroups is normal. -/
instance normal_inertiaClosure : (inertiaClosure X).Normal := sorry

/-- Each inertia subgroup is contained in the closed normal subgroup generated by inertia. -/
theorem inertia_le_inertiaClosure
    (y : (map X (SeparableClosure X.functionField)).normalization) :
    inertia X (SeparableClosure X.functionField) y ≤ inertiaClosure X := sorry

/-- The closed subgroup generated by compatible strict-henselization Galois subgroups is
normal. -/
instance normal_strictHenselClosure : (strictHenselClosure X).Normal := sorry

/-- Restriction of the Galois group over a compatible strict-henselization fraction field
has image contained in the closed normal subgroup generated by these Galois subgroups. -/
theorem range_restrictScalars_le_strictHenselClosure
    (x : X) (Ash : Type u) [CommRing Ash]
    [Algebra (X.presheaf.stalk x) Ash]
    [IsStrictHenselizationOf (X.presheaf.stalk x) Ash] [IsDomain Ash]
    [Algebra X.functionField (FractionRing Ash)]
    [Algebra (FractionRing Ash) (SeparableClosure X.functionField)]
    [IsScalarTower X.functionField (FractionRing Ash)
      (SeparableClosure X.functionField)]
    (h_compatible : ∀ stalkElement : X.presheaf.stalk x,
      algebraMap X.functionField (FractionRing Ash)
          (algebraMap (X.presheaf.stalk x) X.functionField stalkElement) =
        algebraMap Ash (FractionRing Ash)
          (algebraMap (X.presheaf.stalk x) Ash stalkElement)) :
    MonoidHom.range
        (AlgEquiv.restrictScalarsHom X.functionField :
          Gal(SeparableClosure X.functionField / FractionRing Ash) →*
            Gal(SeparableClosure X.functionField / X.functionField)) ≤
      strictHenselClosure X := sorry

/-- For a normal integral scheme, the kernel of restriction to the maximal unramified
extension is the closed normal subgroup generated by all inertia subgroups. -/
theorem ker_restrict_eq_inertiaClosure (hX : X.isNormal) :
    (AlgEquiv.restrictNormalHom (maximalUnramifiedExtension X hX) :
      Gal(SeparableClosure X.functionField / X.functionField) →*
        Gal(maximalUnramifiedExtension X hX / X.functionField)).ker =
      inertiaClosure X := sorry

/-- For a normal integral scheme, the kernel of restriction to the maximal unramified
extension is the closed normal subgroup generated by the compatible strict-henselization
Galois subgroups at all points. -/
theorem ker_restrict_eq_strictHenselClosure (hX : X.isNormal) :
    (AlgEquiv.restrictNormalHom (maximalUnramifiedExtension X hX) :
      Gal(SeparableClosure X.functionField / X.functionField) →*
        Gal(maximalUnramifiedExtension X hX / X.functionField)).ker =
      strictHenselClosure X := sorry

end AlgebraicGeometry.Scheme.Ramification
