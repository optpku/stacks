module

public import Mathlib.AlgebraicGeometry.Modules.Tilde
public import Mathlib.CategoryTheory.Functor.OfSequence
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import ReasLib.AlgebraicGeometry.Scheme.CoherentFormalModule.Completion.ProperSupport
public import ReasLib.AlgebraicGeometry.NonseparatedAlgebraization.Scheme

/-!
# The coherent formal module on the non-separated algebraization example

The inverse system `(F_n)` is the pushforward of `tilde(A[x] / (x, t^n))` along the first
chart, equivalently `A_n[x]/(x)` on the first chart and `0` on the second.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
open AlgebraicGeometry.Scheme
open AlgebraicGeometry.Scheme.Modules

noncomputable section

universe u

namespace AlgebraicGeometry.NonseparatedAlgebraization

/-- The ideal sheaf `I 𝒪_X` generated by `t` on `scheme k`. -/
def idealSheaf (k : Type u) [Field k] : (scheme k).IdealSheafData :=
  (idealSheafDataOfIdealOnSpec (adicIdeal k)).comap (toSpec k)

/-- The ideal `(x, t^n)` in `A[x]`, presenting the chartwise module `A_n[x]/(x)`. -/
def chartStageIdeal (k : Type u) [Field k] (n : ℕ) :
    Ideal (Polynomial (PowerSeries k)) :=
  Ideal.span {Polynomial.X} ⊔ (adicIdeal k ^ n).map Polynomial.C

/-- The `A[x]`-module `A[x] / (x, t^n)`. -/
def chartStageModule (k : Type u) [Field k] (n : ℕ) :
    ModuleCat (CommRingCat.of (Polynomial (PowerSeries k))) :=
  ModuleCat.of _ (Polynomial (PowerSeries k) ⧸ chartStageIdeal k n)

/-- The quasi-coherent sheaf on `Spec(A[x])` associated to `A[x] / (x, t^n)`. -/
def chartStage (k : Type u) [Field k] (n : ℕ) : (affineLine k).Modules :=
  (tilde.functor (CommRingCat.of (Polynomial (PowerSeries k)))).obj
    (chartStageModule k n)

/-- The sheaf on `scheme k` obtained by pushing `chartStage k n` forward along the first chart. -/
def stage (k : Type u) [Field k] (n : ℕ) : (scheme k).Modules :=
  (pushforward (DoubleAlong.chartMap (puncturedOpen k) 0)).obj (chartStage k n)

/-- Restriction of `stage k n` to the first chart recovers `chartStage k n`. -/
def stageRestrictChartZeroIso (k : Type u) [Field k] (n : ℕ) :
    (Scheme.Modules.restrictFunctor (DoubleAlong.chartMap (puncturedOpen k) 0)).obj
      (stage k n) ≅ chartStage k n :=
  (Scheme.Modules.restrictFunctorAdjCounitIso
    (DoubleAlong.chartMap (puncturedOpen k) 0)).app (chartStage k n)

/-- Restriction of `stage k n` to the second chart vanishes. -/
theorem isZero_stage_restrict_chartMap_one (k : Type u) [Field k] (n : ℕ) :
    IsZero ((Scheme.Modules.restrictFunctor (DoubleAlong.chartMap (puncturedOpen k) 1)).obj
      (stage k n)) := sorry

/-- The sheaf `stage k n` is coherent. -/
theorem isCoherent_stage (k : Type u) [Field k] (n : ℕ) :
    SheafOfModules.IsCoherent (stage k n) := sorry

/-- The coherent module at truncation stage `n` on `scheme k`. -/
def coherentStage (k : Type u) [Field k] (n : ℕ) :
    RingedSpace.Coh (scheme k).toRingedSpace :=
  ⟨stage k n, isCoherent_stage k n⟩

/-- The `A[x]`-linear successor map `A[x]/(x, t^{n+1}) → A[x]/(x, t^n)`. -/
def chartStageFactor (k : Type u) [Field k] (n : ℕ) :
    Polynomial (PowerSeries k) ⧸ chartStageIdeal k (n + 1) →ₗ[Polynomial (PowerSeries k)]
      Polynomial (PowerSeries k) ⧸ chartStageIdeal k n :=
  (Ideal.Quotient.factorₐ (Polynomial (PowerSeries k))
    (sup_le_sup le_rfl
      (Ideal.map_mono (Ideal.pow_le_pow_right (Nat.le_succ n))))).toLinearMap

/-- The sheaf morphism on `Spec(A[x])` induced by the successor quotient. -/
def chartStageHom (k : Type u) [Field k] (n : ℕ) :
    chartStage k (n + 1) ⟶ chartStage k n :=
  (tilde.functor (CommRingCat.of (Polynomial (PowerSeries k)))).map
    (ModuleCat.ofHom (chartStageFactor k n))

/-- The sheaf morphism on `scheme k` induced by the successor quotient. -/
def stageHomModules (k : Type u) [Field k] (n : ℕ) :
    stage k (n + 1) ⟶ stage k n :=
  (pushforward (DoubleAlong.chartMap (puncturedOpen k) 0)).map (chartStageHom k n)

/-- The coherent successor morphism `F_{n+1} ⟶ F_n`. -/
def stageHom (k : Type u) [Field k] (n : ℕ) :
    coherentStage k (n + 1) ⟶ coherentStage k n :=
  ObjectProperty.homMk (stageHomModules k n)

/-- The inverse system `(F_n)` of coherent sheaves on `scheme k`. -/
def formalSystem (k : Type u) [Field k] :
    SequentialInverseSystem (RingedSpace.Coh (scheme k).toRingedSpace) :=
  Functor.ofOpSequence (stageHom k)

/-- The inverse system of quotient sheaves is a coherent formal module along `idealSheaf k`. -/
theorem isCoherentFormalModuleSystem_formalSystem (k : Type u) [Field k] :
    IsCoherentFormalModuleSystem (idealSheaf k) (formalSystem k) := sorry

/-- The coherent formal module determined by `(F_n)`. -/
def coherentFormal (k : Type u) [Field k] :
    CoherentFormalModules (scheme k) (idealSheaf k) :=
  ⟨formalSystem k, isCoherentFormalModuleSystem_formalSystem k⟩

/-- The first stage of `coherentFormal k` has support proper over `Spec(A)`. -/
theorem hasProperSupport_stage_one (k : Type u) [Field k] :
    HasProperSupportOver (toSpec k)
      (coherentFormalModuleStage (coherentFormal k) 1).obj := sorry

/-- The object of `Coh_{support proper over A}(X, I)` determined by `(F_n)`. -/
def formalModule (k : Type u) [Field k] :
    CoherentFormalProperSupportOver (toSpec k) (idealSheaf k) :=
  ⟨coherentFormal k, hasProperSupport_stage_one k⟩

/-- The formal module of first-chart quotients does not lie in the essential image of
proper-support completion. -/
theorem not_mem_essImage (k : Type u) [Field k] :
    ¬ (coherentProperSupportCompletionFunctor :
          CoherentProperSupportOver (toSpec k) ⥤
            CoherentFormalProperSupportOver (toSpec k) (idealSheaf k)).essImage
        (formalModule k) := sorry

/-- Proper-support coherent completion on the doubled power-series affine line is not an
equivalence. -/
theorem not_isEquivalence_coherentProperSupportCompletionFunctor {k : Type u} [Field k] :
    ¬ (coherentProperSupportCompletionFunctor :
        CoherentProperSupportOver (toSpec k) ⥤
          CoherentFormalProperSupportOver (toSpec k) (idealSheaf k)).IsEquivalence := sorry

end AlgebraicGeometry.NonseparatedAlgebraization
