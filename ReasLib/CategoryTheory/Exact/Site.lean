module

public import Mathlib.CategoryTheory.Sites.Coverage
public import Mathlib.CategoryTheory.Sites.Pretopology
public import ReasLib.CategoryTheory.Exact.Structure

@[expose] public section

/-!
# The Admissible-Epimorphism Site of an Exact Structure

The primitive site owner is a coverage: the exact-structure axioms provide precisely the
pullbacks needed for singleton admissible-epimorphism covers.  A pretopology is supplied as a
separate view when the ambient category has all pullbacks.
-/

open CategoryTheory Limits

universe u v

namespace CategoryTheory.ExactStructure

variable {A : Type u} [Category.{v} A] [Preadditive A] [HasFiniteProducts A]

/-- The deterministic family of singleton presieves generated by admissible epimorphisms. -/
def singletonAdmissibleEpiCoverings (E : ExactStructure A) (X : A) :
    Set (Presieve X) :=
  {S | ∃ (Y : A) (p : Y ⟶ X), E.AdmissibleEpi p ∧ S = Presieve.singleton p}

/-- Pulling back a singleton admissible-epimorphism cover admits another such cover which factors
through the original one. -/
theorem singletonAdmissibleEpiCoverings_pullback (E : ExactStructure A) :
    ∀ ⦃X Y : A⦄ (f : Y ⟶ X) (S : Presieve X)
      (_ : S ∈ singletonAdmissibleEpiCoverings E X),
      ∃ (T : Presieve Y), T ∈ singletonAdmissibleEpiCoverings E Y ∧
        T.FactorsThruAlong S f := by
  rintro X Y f S ⟨Z, p, hp, rfl⟩
  obtain ⟨h, hp'⟩ := E.pullback_admissibleEpi p f hp
  letI := h
  refine ⟨Presieve.singleton (pullback.snd p f), ⟨_, _, hp', rfl⟩, ?_⟩
  intro W g hg
  cases hg
  exact ⟨Z, pullback.fst p f, p, Presieve.singleton_self p, pullback.condition⟩

/-- The coverage whose covering presieves are singleton admissible epimorphisms. -/
@[stacks 05SF "singleton admissible-epimorphism coverage"]
def singletonAdmissibleEpiCoverage (E : ExactStructure A) : Coverage A where
  coverings := singletonAdmissibleEpiCoverings E
  pullback := singletonAdmissibleEpiCoverings_pullback E

/-- Membership in the singleton admissible-epimorphism coverage. -/
theorem mem_singletonAdmissibleEpiCoverage_iff (E : ExactStructure A) {X : A}
    {S : Presieve X} :
    S ∈ singletonAdmissibleEpiCoverage E X ↔
      ∃ (Y : A) (p : Y ⟶ X), E.AdmissibleEpi p ∧ S = Presieve.singleton p := Iff.rfl

/-- The Grothendieck topology generated by singleton admissible epimorphisms. -/
@[stacks 05SF "admissible-epimorphism topology"]
abbrev topology (E : ExactStructure A) : GrothendieckTopology A :=
  (singletonAdmissibleEpiCoverage E).toGrothendieck

section Pretopology

variable [HasPullbacks A]

/-- Isomorphisms belong to the singleton admissible-epimorphism coverings. -/
theorem singletonAdmissibleEpiPretopology_hasIsos (E : ExactStructure A) :
    ∀ ⦃X Y : A⦄ (f : Y ⟶ X) [IsIso f],
      Presieve.singleton f ∈ singletonAdmissibleEpiCoverage E X := by
  intro X Y f _
  refine ⟨Y, f, ?_, rfl⟩
  obtain ⟨K, i, w, hi⟩ := E.id_admissibleEpi Y
  have hi0 : i = 0 := by simpa using w
  refine ⟨K, i, by simp [hi0], ?_⟩
  exact E.ofIso (ShortComplex.isoMk (S₁ := ShortComplex.mk i (𝟙 Y) w)
    (Iso.refl K) (Iso.refl Y) (asIso f) (by simp) (by simp)) hi

/-- Singleton admissible-epimorphism coverings are stable under the chosen pullback presieve. -/
theorem singletonAdmissibleEpiPretopology_pullbacks (E : ExactStructure A) :
    ∀ ⦃X Y : A⦄ (f : Y ⟶ X) (S : Presieve X),
      S ∈ singletonAdmissibleEpiCoverage E X →
        Presieve.pullbackArrows f S ∈ singletonAdmissibleEpiCoverage E Y := by
  rintro X Y f S ⟨Z, p, hp, rfl⟩
  obtain ⟨h, hp'⟩ := E.pullback_admissibleEpi p f hp
  exact ⟨pullback p f, pullback.snd p f, hp', Presieve.pullback_singleton f p⟩

/-- Singleton admissible-epimorphism coverings satisfy the pretopology transitivity axiom. -/
theorem singletonAdmissibleEpiPretopology_transitive (E : ExactStructure A) :
    ∀ ⦃X : A⦄ (S : Presieve X)
      (Ti : ∀ ⦃Y : A⦄ (f : Y ⟶ X), S f → Presieve Y),
      S ∈ singletonAdmissibleEpiCoverage E X →
        (∀ ⦃Y : A⦄ (f : Y ⟶ X) (H : S f),
          Ti f H ∈ singletonAdmissibleEpiCoverage E Y) →
        S.bind Ti ∈ singletonAdmissibleEpiCoverage E X := by
  rintro X S Ti ⟨Y, p, hp, rfl⟩ hTi
  obtain ⟨Z, q, hq, hT⟩ := hTi p (Presieve.singleton_self p)
  refine ⟨Z, q ≫ p, E.comp_admissibleEpi hq hp, ?_⟩
  funext W
  ext g
  constructor
  · rintro ⟨V, q', p', hp', hq', rfl⟩
    cases hp'
    rw [hT] at hq'
    cases hq'
    exact Presieve.singleton_self _
  · rintro ⟨⟩
    apply Presieve.bind_comp p (Presieve.singleton_self p)
    rw [hT]
    exact Presieve.singleton_self q

/-- With global pullbacks, singleton admissible epimorphisms form a pretopology. -/
@[stacks 05SF "singleton admissible-epimorphism pretopology"]
def singletonAdmissibleEpiPretopology (E : ExactStructure A) : Pretopology A where
  coverings := singletonAdmissibleEpiCoverage E
  has_isos := singletonAdmissibleEpiPretopology_hasIsos E
  pullbacks := singletonAdmissibleEpiPretopology_pullbacks E
  transitive := singletonAdmissibleEpiPretopology_transitive E

/-- Membership in the singleton admissible-epimorphism pretopology. -/
theorem mem_singletonAdmissibleEpiPretopology_iff (E : ExactStructure A) {X : A}
    {S : Presieve X} :
    S ∈ singletonAdmissibleEpiPretopology E X ↔
      ∃ (Y : A) (p : Y ⟶ X), E.AdmissibleEpi p ∧ S = Presieve.singleton p := Iff.rfl

/-- The pretopology and coverage views generate the same Grothendieck topology. -/
theorem singletonAdmissibleEpiPretopology_toGrothendieck (E : ExactStructure A) :
    (singletonAdmissibleEpiPretopology E).toGrothendieck = E.topology := by
  have h : (singletonAdmissibleEpiPretopology E).toCoverage =
      singletonAdmissibleEpiCoverage E := Coverage.ext rfl
  rw [← Pretopology.toGrothendieck_toCoverage, h]

end Pretopology

end CategoryTheory.ExactStructure
