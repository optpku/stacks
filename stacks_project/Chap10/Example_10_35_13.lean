module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.FieldTheory.RatFunc.Basic
public import ReasLib.RingTheory.LocalRing.ResidueField.MaximalIdeal
import StacksCheckRecall

/-!
# A countable Jacobson-ring counterexample

@stack 02CB
-/

@[expose] public section

open MvPolynomial

universe u

noncomputable section

variable (k : Type u) [Field k]

-- Local declaration justification (source-local notation): these aliases spell the explicit
-- polynomial presentation used throughout Example 10.35.13 and keep its three concrete data
-- declarations readable; they do not select any typeclass instances.
local notation "NonzeroPoly" => {f : Polynomial k // f ≠ 0}
local notation "Vars" => Option NonzeroPoly
local notation "Rcount" => MvPolynomial Vars k
local notation "xVar" => (X (none : Vars) : Rcount)

/-- The relations `f(x) x_f - 1`, indexed by the nonzero polynomials in `k[x]`. -/
def countableFieldCounterexampleRelations : Set Rcount :=
  Set.range fun f : NonzeroPoly ↦
    ((Polynomial.aeval xVar f.1 : Rcount) * X (some f) - 1 : Rcount)

/-- The ideal generated by the relations `f(x) x_f - 1`. -/
def countableFieldCounterexampleIdeal : Ideal Rcount :=
  Ideal.span (countableFieldCounterexampleRelations k)

/-- The explicit quotient ring from Example 10.35.13. -/
abbrev countableFieldCounterexampleRing : Type u :=
  Rcount ⧸ countableFieldCounterexampleIdeal k

/-- **Example 10.35.13** ([Stacks tag 02CB](https://stacks.math.columbia.edu/tag/02CB)):
for a countable field, the countable relation set above yields a quotient with a maximal-ideal
residue field isomorphic to `k(x)` and hence transcendental over `k`. -/
@[stacks 02CB]
theorem exists_maximal_ideal_with_ratFunc_residueField_over_countable_field [Countable k] :
    (countableFieldCounterexampleRelations k).Countable ∧
      ∃ m : MaximalSpectrum (countableFieldCounterexampleRing k),
        ∃ _ : RatFunc k ≃ₐ[k] m.asIdeal.ResidueField,
          ¬ Algebra.IsAlgebraic k m.asIdeal.ResidueField := sorry

@[stacks 02CB "maximal-spectrum point"]
#check @MaximalSpectrum

@[stacks 02CB "residue-field owner"]
#check @Ideal.ResidueField
