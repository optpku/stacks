module

public import Mathlib.Tactic.CrossRefAttribute
public import ReasLib.RingTheory.CompleteIntersection.Basic
public import ReasLib.RingTheory.Ideal.KoszulRegular

@[expose] public section

/-!
# Zariski-Local Regularity Conditions on Ideals

@stack 07CV

The predicates in this leaf express that an ideal is locally generated by
regular, Koszul-regular, or `H_1`-regular finite sequences on principal opens.
-/

universe u

open RingTheory.Sequence

namespace Ideal

variable {R : Type u} [CommRing R]

/-- Definition 15.32.1 (1), tag `07CV`: an ideal is regular when
near every prime that contains it, it becomes generated by a regular sequence on a principal open.
-/
@[stacks 07CV "Definition 15.32.1 (1), regular ideals"]
def IsRegularIdeal (I : Ideal R) : Prop :=
  ∀ p : Ideal R, p.IsPrime → I ≤ p →
    ∃ g : R, g ∉ p ∧
      (Ideal.map (algebraMap R (Localization.Away g)) I).IsGeneratedByRegularSequence

/-- The principal-open finite-family criterion for a regular ideal. -/
theorem isRegularIdeal_iff (I : Ideal R) :
    I.IsRegularIdeal ↔
      ∀ p : Ideal R, p.IsPrime → I ≤ p →
        ∃ g : R, g ∉ p ∧ ∃ r : ℕ, ∃ f : Fin r → Localization.Away g,
          IsRegular (Localization.Away g) (List.ofFn f) ∧
            Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f) := sorry

/-- Definition 15.32.1 (3), tag `07CV`: an ideal is `H_1`-regular
when near every prime that contains it, it becomes generated by a finite `H_1`-regular sequence on
a principal open. -/
@[stacks 07CV "Definition 15.32.1 (3), H1-regular ideals"]
def IsH1RegularIdeal (I : Ideal R) : Prop :=
  IsGeneratedByFiniteAwaySequence I (fun _ {_} f ↦ IsH1RegularSequence f)

/-- The principal-open finite-family criterion for an `H_1`-regular ideal. -/
theorem isH1RegularIdeal_iff (I : Ideal R) :
    I.IsH1RegularIdeal ↔
      ∀ p : Ideal R, p.IsPrime → I ≤ p →
        ∃ g : R, g ∉ p ∧ ∃ r : ℕ, ∃ f : Fin r → Localization.Away g,
          IsH1RegularSequence f ∧
            Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f) := sorry

namespace IsRegularIdeal

/-- A regular ideal is Koszul-regular. -/
theorem isKoszulRegular {I : Ideal R} (hI : I.IsRegularIdeal) :
    I.IsKoszulRegularIdeal := sorry

/-- A regular ideal is finitely generated. -/
theorem fg {I : Ideal R} (hI : I.IsRegularIdeal) : I.FG := sorry

end IsRegularIdeal

namespace IsKoszulRegularIdeal

/-- A Koszul-regular ideal is `H_1`-regular. -/
theorem isH1Regular {I : Ideal R} (hI : I.IsKoszulRegularIdeal) : I.IsH1RegularIdeal := sorry

end IsKoszulRegularIdeal

namespace IsH1RegularIdeal

/-- An `H_1`-regular ideal is finitely generated. -/
theorem fg {I : Ideal R} (hI : I.IsH1RegularIdeal) : I.FG := sorry

end IsH1RegularIdeal

end Ideal
