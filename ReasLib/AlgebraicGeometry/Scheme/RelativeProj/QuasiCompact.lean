module

public import ReasLib.AlgebraicGeometry.ProjectiveSpectrum.QuasiCompact.Finiteness
public import ReasLib.AlgebraicGeometry.Scheme.RelativeProj.Presentation

/-!
# Quasi-compact relative projective spectra

This file formulates affine-chart finiteness conditions for a relative projective-spectrum
presentation and derives quasi-compactness of its structural morphism.
-/

@[expose] public section

open AlgebraicGeometry
open CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme.Hom

variable {S X : Scheme.{u}} {p : X ⟶ S}

namespace AbsoluteProjModel

/-- The inclusion of the degree-zero component of an affine graded model into its ambient ring. -/
def degreeZeroToRing (D : AbsoluteProjModel) : D.degreeZeroRing ⟶ D.ring :=
  @CommRingCat.ofHom D.degreeZeroRing D.ring D.degreeZeroRing.commRing D.ring.commRing
    { toFun := fun x ↦ x.1
      map_one' := rfl
      map_mul' := fun _ _ ↦ rfl
      map_zero' := rfl
      map_add' := fun _ _ ↦ rfl }

/-- An affine graded model is of finite type over its degree-zero component when the canonical
inclusion of degree zero into the ambient ring is a finite-type ring homomorphism. -/
def FiniteTypeAsDegreeZeroAlgebra (D : AbsoluteProjModel) : Prop :=
  D.degreeZeroToRing.hom.FiniteType

/-- An affine graded model is generated by a finite degree-one module when its grading has the
corresponding projective-spectrum finiteness property. -/
def GeneratedByDegreeOneFinite (D : AbsoluteProjModel) : Prop :=
  @AlgebraicGeometry.Proj.GeneratedByDegreeOneFinite
    D.ring D.grade D.ring.commRing D.gradeSetLike D.gradeAddSubgroupClass
      D.grading D.grading_inst

/-- An affine graded model has a finite positive submodule with locally nilpotent quotient when
its grading has the corresponding projective-spectrum finiteness property. -/
def FinitePositiveSubmoduleLocallyNilpotentQuotient (D : AbsoluteProjModel) : Prop :=
  @AlgebraicGeometry.Proj.FinitePositiveSubmoduleLocallyNilpotentQuotient
    D.ring D.grade D.ring.commRing D.gradeSetLike D.gradeAddSubgroupClass
      D.grading D.grading_inst

end AbsoluteProjModel

namespace RelativeProjPresentation

/-- A relative projective-spectrum presentation is affine-locally of finite type over degree
zero when every one of its canonical affine graded models has that property. -/
def FiniteTypeAsDegreeZeroAlgebra (P : RelativeProjPresentation p) : Prop :=
  ∀ s : S, (P.affineChart s).affineAlgebra.FiniteTypeAsDegreeZeroAlgebra

/-- A relative projective-spectrum presentation is generated by finite degree-one modules when
every one of its canonical affine graded models has that property. -/
def GeneratedByDegreeOneFinite (P : RelativeProjPresentation p) : Prop :=
  ∀ s : S, (P.affineChart s).affineAlgebra.GeneratedByDegreeOneFinite

/-- A relative projective-spectrum presentation has finite positive submodules with locally
nilpotent quotients when every one of its canonical affine graded models has that property. -/
def FinitePositiveSubmoduleLocallyNilpotentQuotient
    (P : RelativeProjPresentation p) : Prop :=
  ∀ s : S,
    (P.affineChart s).affineAlgebra.FinitePositiveSubmoduleLocallyNilpotentQuotient

/-- The quasi-compactness finiteness condition on a relative projective-spectrum presentation is
the choice of one of the three global affine-chart finiteness alternatives. -/
def QuasiCompactFiniteness (P : RelativeProjPresentation p) : Prop :=
  P.FiniteTypeAsDegreeZeroAlgebra ∨
    P.GeneratedByDegreeOneFinite ∨
      P.FinitePositiveSubmoduleLocallyNilpotentQuotient

/-- The quasi-compactness finiteness condition is exactly the disjunction of finite type over
degree zero, finite degree-one generation, and a finite positive submodule with locally
nilpotent quotient. -/
theorem quasiCompactFiniteness_iff (P : RelativeProjPresentation p) :
    P.QuasiCompactFiniteness ↔
      P.FiniteTypeAsDegreeZeroAlgebra ∨
        P.GeneratedByDegreeOneFinite ∨
          P.FinitePositiveSubmoduleLocallyNilpotentQuotient :=
  Iff.rfl

/-- A relative projective-spectrum morphism is quasi-compact when the projective spectrum in
every canonical affine chart is compact. -/
theorem quasiCompact_of_isCompact_affineCharts (P : RelativeProjPresentation p)
    (h : ∀ s : S,
      IsCompact (Set.univ : Set (P.affineChart s).affineAlgebra.proj)) :
    QuasiCompact p := sorry

namespace FiniteTypeAsDegreeZeroAlgebra

/-- Affine-local finite type over degree zero makes a relative projective-spectrum morphism
quasi-compact. -/
theorem quasiCompact {P : RelativeProjPresentation p}
    (h : P.FiniteTypeAsDegreeZeroAlgebra) :
    QuasiCompact p := sorry

end FiniteTypeAsDegreeZeroAlgebra

namespace GeneratedByDegreeOneFinite

/-- Affine-local generation by finite degree-one modules makes a relative projective-spectrum
morphism quasi-compact. -/
theorem quasiCompact {P : RelativeProjPresentation p}
    (h : P.GeneratedByDegreeOneFinite) :
    QuasiCompact p := sorry

end GeneratedByDegreeOneFinite

namespace FinitePositiveSubmoduleLocallyNilpotentQuotient

/-- Affine-local finite positive submodules with locally nilpotent quotients make a relative
projective-spectrum morphism quasi-compact. -/
theorem quasiCompact {P : RelativeProjPresentation p}
    (h : P.FinitePositiveSubmoduleLocallyNilpotentQuotient) :
    QuasiCompact p := sorry

end FinitePositiveSubmoduleLocallyNilpotentQuotient

/-- Any of the three global finiteness alternatives on a relative projective-spectrum
presentation makes its structural morphism quasi-compact. -/
theorem quasiCompact_of_finiteness (P : RelativeProjPresentation p)
    (h : P.QuasiCompactFiniteness) :
    QuasiCompact p := sorry

end RelativeProjPresentation

end AlgebraicGeometry.Scheme.Hom
