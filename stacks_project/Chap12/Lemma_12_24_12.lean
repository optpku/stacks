module

public import ReasLib.CategoryTheory.Filtration.Complex.EulerCharacteristic
import StacksCheckRecall

@[expose] public section

open CategoryTheory

/- Lemma 12.24.12 (1) [0BDW]: the nonzero bidegrees on a page are represented by the canonical
page-support predicate. -/
@[stacks 0BDW]
#check CohomologicalSpectralSequence.Page.Support.nonzero
@[stacks 0BDW]
#check CohomologicalSpectralSequence.Page.Support.IsSupport

/- Lemma 12.24.12 (2) [0BDW]: finite term filtrations and a finite page imply finite cohomology
support. -/
@[stacks 0BDW]
#check FilteredComplex.Cohomology.Support.finite_of_page

/- Lemma 12.24.12 (3) [0BDW]: both alternating sums live canonically in the Grothendieck group of
the weak Serre closure generated by the selected page. -/
@[stacks 0BDW]
#check CohomologicalSpectralSequence.Page.WeakSerre.closure
@[stacks 0BDW]
#check CohomologicalSpectralSequence.Page.Euler.characteristic
@[stacks 0BDW]
#check FilteredComplex.Cohomology.Euler.characteristic

/- Lemma 12.24.12 (4) [0BDW]: the page and cohomology Euler characteristics agree on finite
supports. -/
@[stacks 0BDW]
#check FilteredComplex.Cohomology.Euler.exists_support_eq_page
