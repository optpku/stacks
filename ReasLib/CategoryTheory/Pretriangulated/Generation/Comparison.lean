module

public import ReasLib.CategoryTheory.Pretriangulated.Generation.Generated
public import ReasLib.CategoryTheory.Pretriangulated.Generation.Orthogonal
public import Mathlib.Tactic.CrossRefAttribute

@[expose] public section

/-!
# Comparing Triangulated Generator Notions

Mathlib owns the canonical triangulated-envelope and classical/strong-generator
predicates. This leaf provides the reusable comparisons with weak generation
and the orthogonality criterion used to pass between the two presentations.
-/

open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.ObjectProperty
open CategoryTheory.Pretriangulated

universe v u

namespace CategoryTheory

namespace ObjectProperty

section

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ n : ℤ, Functor.Additive (shiftFunctor C n)] [Pretriangulated C] [IsTriangulated C]

namespace triangEnvelope

/-- Membership in the right orthogonal of the triangulated envelope of `P` can be tested on
all shifts of the original objects satisfying `P`. -/
@[stacks 09SK "right-orthogonal criterion for a triangulated envelope"]
theorem rightOrthogonal_iff (P : ObjectProperty C) (K : C) :
    P.triangEnvelope.rightOrthogonal K ↔
      ∀ ⦃E : C⦄, P E → ∀ (i : ℤ) (f : E ⟶ K⟦i⟧), f = 0 := sorry

/-- Membership in the left orthogonal of the triangulated envelope of `P` can be tested on
all shifts of the original objects satisfying `P`. -/
@[stacks 09SK "left-orthogonal criterion for a triangulated envelope"]
theorem leftOrthogonal_iff (P : ObjectProperty C) (K : C) :
    P.triangEnvelope.leftOrthogonal K ↔
      ∀ ⦃E : C⦄, P E → ∀ (i : ℤ) (f : K ⟶ E⟦i⟧), f = 0 := sorry

end triangEnvelope

namespace Generated.Property

/-- Stacks 09SK: an object lies in the right orthogonal of the triangulated envelope generated
by `E` exactly when all maps `E ⟶ K⟦i⟧` vanish. -/
@[stacks 09SK]
theorem rightOrthogonal_iff (E K : C) :
    (Generated.property E).rightOrthogonal K ↔
      ∀ (i : ℤ) (f : E ⟶ K⟦i⟧), f = 0 := sorry

/-- The left-dual criterion for the triangulated envelope generated by one object. -/
@[stacks 09SK "left-dual orthogonal criterion"]
theorem leftOrthogonal_iff (E K : C) :
    (Generated.property E).leftOrthogonal K ↔
      ∀ (i : ℤ) (f : K ⟶ E⟦i⟧), f = 0 := sorry

end Generated.Property

end

section

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ n : ℤ, Functor.Additive (shiftFunctor C n)] [Pretriangulated C]

namespace IsClassicalTriangulatedGenerator

/-- A classical generator places every object in a positive finite stage of its object-generated
triangulated envelope. -/
theorem exists_stage_mem {E E' : C}
    (hE : (singleton E).IsClassicalTriangulatedGenerator) :
    ∃ m : ℕ+, Generated.stage E m E' := sorry

/-- A classical triangulated generator is a weak generator. -/
@[stacks 09SL]
theorem isWeak {E : C} (hE : (singleton E).IsClassicalTriangulatedGenerator) :
    IsWeakGenerator E := sorry

end IsClassicalTriangulatedGenerator

namespace Generated.Stage

/-- Membership of `E'` in a positive stage generated by `E` bounds the first stage generated by
`E'` by that same stage. -/
theorem one_le_of_mem {E E' : C} {m : ℕ+}
    (hEm : Generated.stage E m E') :
    Generated.stage E' 1 ≤ Generated.stage E m := sorry

end Generated.Stage

end

section

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ n : ℤ, Functor.Additive (shiftFunctor C n)] [Pretriangulated C] [IsTriangulated C]

namespace Generated.Stage

/-- A first-stage bound propagates through all positive stages, with multiplicative stage
indices. -/
theorem le_mul {E E' : C} {m : ℕ+}
    (h1 : Generated.stage E' 1 ≤ Generated.stage E m) :
    ∀ k : ℕ+, Generated.stage E' k ≤ Generated.stage E (k * m) := sorry

end Generated.Stage

namespace IsClassicalTriangulatedGenerator

/-- In a triangulated category that has a strong generator, every classical generator is a
strong generator. -/
@[stacks 0FXA]
theorem isStrong {E : C} (hE : (singleton E).IsClassicalTriangulatedGenerator)
    (hC : ∃ E' : C, (singleton E').IsStrongTriangulatedGenerator) :
    (singleton E).IsStrongTriangulatedGenerator := sorry

end IsClassicalTriangulatedGenerator

end

end ObjectProperty

end CategoryTheory
