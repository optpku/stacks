module

public import Mathlib.Topology.Compactness.Compact
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Alexander Subbasis Theorems

Finite-refinement variants of Mathlib's Alexander subbasis theorem.
-/

@[expose] public section

universe u

open Set TopologicalSpace

namespace Set.Finite

/-- A finite cover refining a cover by `P` yields a finite subcover by members of `P`.

The target `s` is arbitrary, so this is also useful outside Alexander-style
arguments. -/
@[stacks 08ZP "finite refinements yield finite subcovers"]
theorem exists_finite_subcover_of_refinement {X : Type u} {s : Set X} {P Q : Set (Set X)}
    (hQ : Q.Finite) (hQcover : s ⊆ ⋃₀ Q)
    (hQrefines : ∀ V ∈ Q, ∃ U ∈ P, V ⊆ U) :
    ∃ R ⊆ P, R.Finite ∧ s ⊆ ⋃₀ R := sorry

end Set.Finite

/-- Lemma 5.12.15 (Alexander subbase theorem): a topology generated by `B` is compact if every
cover by elements of `B` admits a finite refining cover. -/
@[stacks 08ZP "Alexander subbase theorem"]
theorem compactSpace_generateFrom_of_finite_refinement {X : Type u} [t : TopologicalSpace X]
    {B : Set (Set X)} (hB : t = generateFrom B)
    (hfinite :
      ∀ P ⊆ B, ⋃₀ P = (univ : Set X) →
        ∃ Q : Set (Set X), Q.Finite ∧ ⋃₀ Q = (univ : Set X) ∧
          ∀ V ∈ Q, ∃ U ∈ P, V ⊆ U) :
    CompactSpace X := sorry
