module

public import ReasLib.RingTheory.DualNumberPair
public import Mathlib.Algebra.Field.ZMod
public import Mathlib.RingTheory.Ideal.Operations

@[expose] public section

noncomputable section

open DualNumberPair
open scoped DualNumberPair

namespace DualNumberPair

/-- The ideals of `DualNumberPair (ZMod 2)` are exactly the six ideals generated by
the zero ideal, the two square-zero directions, their sum, both directions, and one. -/
theorem ideals_eq :
    (Set.univ : Set (Ideal (DualNumberPair (ZMod 2)))) =
      {⊥, Ideal.span {(ε₁ : DualNumberPair (ZMod 2))}, Ideal.span {ε₂},
        Ideal.span {ε₁ + ε₂}, Ideal.span {ε₁, ε₂}, ⊤} :=
  sorry

/-- Every ideal of `DualNumberPair (ZMod 2)` is one of the six listed ideals. -/
theorem eq_bot_or_span_or_top (I : Ideal (DualNumberPair (ZMod 2))) :
    I = ⊥ ∨ I = Ideal.span {ε₁} ∨ I = Ideal.span {ε₂} ∨
      I = Ideal.span {ε₁ + ε₂} ∨ I = Ideal.span {ε₁, ε₂} ∨ I = ⊤ :=
  sorry

/-- The six displayed ideals of `DualNumberPair (ZMod 2)` are pairwise distinct. -/
theorem ideals_nodup :
    List.Nodup
      [⊥, Ideal.span {(ε₁ : DualNumberPair (ZMod 2))}, Ideal.span {ε₂},
        Ideal.span {ε₁ + ε₂}, Ideal.span {ε₁, ε₂}, ⊤] :=
  sorry

end DualNumberPair
