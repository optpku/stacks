module

public import Mathlib.AlgebraicTopology.DoldKan.Normalized
public import Mathlib.AlgebraicTopology.SimplicialObject.Split
public import Mathlib.CategoryTheory.Limits.Shapes.FiniteProducts
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Degenerate subobjects of simplicial objects

This leaf owns the degreewise subobject generated by the degeneracy maps of a
simplicial object. It deliberately stops before choosing the induced chain
complex; that construction belongs in `DegenerateComplex`.

@stack 019A
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.Subobject
open AlgebraicTopology
open scoped Simplicial

noncomputable section

universe v u

namespace AlgebraicTopology.DoldKan

variable {C : Type u} [Category.{v} C]

section Degreewise

variable [HasZeroObject C] [HasBinaryCoproducts C] [HasImages C]

/-- The degree-`n` degenerate subobject of `U _⦋n⦌`, generated by the images of all degeneracy
maps into that degree. -/
@[stacks 019A "degreewise degenerate subobject",
  stacks 0FKI "degreewise degenerate subobject"]
def degenerateSubobject (U : SimplicialObject C) (n : ℕ) : Subobject (U _⦋n⦌) :=
  match n with
  | 0 => ⊥
  | n + 1 => Finset.univ.sup fun i : Fin (n + 1) ↦ imageSubobject (U.σ i)

/-- In degree zero, the degenerate subobject is bottom. -/
@[simp, stacks 019A "degree-zero degenerate subobject",
  stacks 0FKI "degree-zero degenerate subobject"]
theorem degenerateSubobject.zero (U : SimplicialObject C) :
    degenerateSubobject U 0 = ⊥ := sorry

/-- In positive degree, the degenerate subobject is the finite supremum of the images of the
degeneracy maps. -/
@[simp, stacks 019A "positive-degree degenerate subobject",
  stacks 0FKI "positive-degree degenerate subobject"]
theorem degenerateSubobject.add_one (U : SimplicialObject C) (n : ℕ) :
    degenerateSubobject U (n + 1) =
      Finset.univ.sup (fun i : Fin (n + 1) ↦ imageSubobject (U.σ i)) := sorry

end Degreewise

namespace degenerateSubobject

/-- Proper epimorphisms out of a simplex `Δ`, represented by the canonical splitting index. -/
@[stacks 0FKI "proper-epimorphism summand index"]
def Index (Δ : SimplexCategoryᵒᵖ) :=
  {a : SimplicialObject.Splitting.IndexSet Δ //
    a.1.unop.len < Δ.unop.len}

/-- The object of lower-dimensional simplices selected by a proper-epimorphism index. -/
@[stacks 0FKI "proper-epimorphism summand"]
def summand (U : SimplicialObject C) (Δ : SimplexCategoryᵒᵖ)
    (a : Index Δ) : C :=
  U.obj a.1.1

namespace Index

/-- Proper-epimorphism summand indices form a finite type. -/
@[stacks 0FKI "finiteness of the proper-epimorphism summand index"]
instance fintype (Δ : SimplexCategoryᵒᵖ) : Fintype (Index Δ) :=
  inferInstanceAs (Fintype
    { a : SimplicialObject.Splitting.IndexSet Δ // a.1.unop.len < Δ.unop.len })

/-- The lower-dimensional target selected by a proper-epimorphism index. -/
@[stacks 0FKI "target of a proper-epimorphism summand"]
abbrev target {Δ : SimplexCategoryᵒᵖ} (a : Index Δ) : SimplexCategoryᵒᵖ := a.1.1

/-- The epimorphism selected by a proper-epimorphism index. -/
@[stacks 0FKI "map of a proper-epimorphism summand"]
abbrev hom {Δ : SimplexCategoryᵒᵖ} (a : Index Δ) : Δ.unop ⟶ a.target.unop := a.1.e

/-- The target of a proper epimorphism has degree strictly below that of its source. -/
@[stacks 0FKI "degree bound for a proper-epimorphism summand"]
theorem degree_lt {Δ : SimplexCategoryᵒᵖ} (a : Index Δ) :
    a.target.unop.len < Δ.unop.len := sorry

end Index

section Coproduct

variable [HasFiniteCoproducts C]

/-- The coproduct of the lower-dimensional terms indexed by proper epimorphisms out of `Δ`. -/
@[stacks 0FKI "proper-epimorphism source coproduct"]
noncomputable def source (U : SimplicialObject C) (Δ : SimplexCategoryᵒᵖ) : C :=
  ∐ summand U Δ

/-- The canonical map from the proper-epimorphism coproduct to `U.obj Δ`. -/
@[stacks 0FKI "proper-epimorphism coproduct map"]
noncomputable def desc (U : SimplicialObject C) (Δ : SimplexCategoryᵒᵖ) :
    source U Δ ⟶ U.obj Δ :=
  Limits.Sigma.desc fun a : Index Δ ↦ U.map a.hom.op

/-- On a coproduct summand, `desc` is the simplicial structure map represented by its
proper epimorphism. -/
@[reassoc (attr := simp), stacks 0FKI "proper-epimorphism coproduct map on a summand"]
theorem desc.ι (U : SimplicialObject C) (Δ : SimplexCategoryᵒᵖ) (a : Index Δ) :
    Limits.Sigma.ι (summand U Δ) a ≫ desc U Δ = U.map a.hom.op := sorry

namespace source

/-- The map between proper-epimorphism source coproducts induced by a simplicial morphism. -/
@[stacks 0FKI "proper-epimorphism source map"]
noncomputable def map {U V : SimplicialObject C} (f : U ⟶ V)
    (Δ : SimplexCategoryᵒᵖ) : source U Δ ⟶ source V Δ :=
  Limits.Sigma.map fun a : Index Δ ↦ f.app a.target

/-- The proper-epimorphism source construction as a functor in the simplicial object. -/
@[stacks 0FKI "proper-epimorphism source functor"]
noncomputable abbrev functor (Δ : SimplexCategoryᵒᵖ) : SimplicialObject C ⥤ C :=
  Functor.pi' (fun a : Index Δ ↦ (evaluation _ _).obj a.target) ⋙
    Limits.Sigma.functor (Index Δ)

/-- The source functor evaluates to the proper-epimorphism coproduct. -/
@[simp, stacks 0FKI "proper-epimorphism source functor object formula"]
theorem functor.obj (U : SimplicialObject C) (Δ : SimplexCategoryᵒᵖ) :
    (source.functor (C := C) Δ).obj U = source U Δ := sorry

/-- The source functor maps a simplicial morphism by its lower-dimensional components. -/
@[simp, stacks 0FKI "proper-epimorphism source functor map formula"]
theorem functor.map {U V : SimplicialObject C} (f : U ⟶ V)
    (Δ : SimplexCategoryᵒᵖ) :
    (source.functor (C := C) Δ).map f = source.map f Δ := sorry

end source

/-- The proper-epimorphism coproduct map is natural in the simplicial object. -/
@[stacks 0FKI "proper-epimorphism coproduct naturality"]
theorem desc.naturality {U V : SimplicialObject C} (f : U ⟶ V)
    (Δ : SimplexCategoryᵒᵖ) :
    source.map f Δ ≫ desc V Δ = desc U Δ ≫ f.app Δ := sorry

namespace desc

/-- The proper-epimorphism coproduct maps as a natural transformation to evaluation at `Δ`. -/
@[stacks 0FKI "proper-epimorphism coproduct natural transformation"]
noncomputable def natTrans (Δ : SimplexCategoryᵒᵖ) :
    source.functor (C := C) Δ ⟶ (evaluation _ _).obj Δ where
  app U := desc U Δ
  naturality _ _ f := desc.naturality f Δ

/-- The component of `desc.natTrans Δ` is the canonical proper-epimorphism coproduct map. -/
@[simp, stacks 0FKI "proper-epimorphism coproduct natural transformation component"]
theorem natTrans.app (U : SimplicialObject C) (Δ : SimplexCategoryᵒᵖ) :
    (natTrans (C := C) Δ).app U = desc U Δ := sorry

end desc

end Coproduct

section Image

variable [HasFiniteCoproducts C] [HasImages C]

/-- The categorical image of the canonical map from all proper-epimorphism summands. -/
@[stacks 0FKI "proper-epimorphism image subobject"]
noncomputable def image (U : SimplicialObject C) (Δ : SimplexCategoryᵒᵖ) :
    Subobject (U.obj Δ) :=
  Limits.imageSubobject (desc U Δ)

namespace image

/-- The canonical proper-epimorphism coproduct map factors through its image subobject. -/
@[stacks 0FKI "proper-epimorphism image factorization"]
theorem factors (U : SimplicialObject C) (Δ : SimplexCategoryᵒᵖ) :
    (image U Δ).Factors (desc U Δ) := sorry

/-- The map from the proper-epimorphism coproduct to its image subobject. -/
@[stacks 0FKI "proper-epimorphism image factor"]
noncomputable def factor (U : SimplicialObject C) (Δ : SimplexCategoryᵒᵖ) :
    source U Δ ⟶ (image U Δ : C) :=
  Limits.factorThruImageSubobject (desc U Δ)

/-- The image factor followed by the image inclusion is the canonical coproduct map. -/
@[reassoc (attr := simp), stacks 0FKI "proper-epimorphism image factor arrow"]
theorem factor_arrow (U : SimplicialObject C) (Δ : SimplexCategoryᵒᵖ) :
    factor U Δ ≫ (image U Δ).arrow = desc U Δ := sorry

end image

/-- The degenerate subobject is the image of the coproduct of all lower-dimensional terms indexed
by proper epimorphisms. -/
@[stacks 0FKI "degenerate subobject as a proper-epimorphism coproduct image"]
theorem eq_image [HasZeroObject C] (U : SimplicialObject C) (n : ℕ) :
    degenerateSubobject U n = image U (Opposite.op ⦋n⦌) := sorry

end Image

end degenerateSubobject

end AlgebraicTopology.DoldKan
