module

public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import ReasLib.CategoryTheory.Fibered.InheritedPrecoverage.Basic
import Mathlib.Tactic.CrossRefAttribute

/-!
# Inherited topology of a functor

For a precoverage `P` on `C` and a functor `p : S ⥤ C`, the topology generated by strongly
cartesian lifts of `P`-covering families is defined without choosing a cleavage or bundling `p`
into a fibred-category owner.  Keeping `P` explicit records the chosen covering families and
avoids replacing coverwise pullback hypotheses by pullbacks of every morphism.  The version for
a Grothendieck topology is a specialization through `J.toPrecoverage`.

## Main declaration

* `Precoverage.stronglyCartesianTopology` -- the topology generated from an arbitrary
  precoverage.
* `Functor.inheritedTopology` -- its specialization to `J.toPrecoverage`.
-/

@[expose] public section

universe uC vC uS vS

namespace CategoryTheory

namespace Precoverage

variable {C : Type uC} [Category.{vC} C]
variable {S : Type uS} [Category.{vS} S]

/-- The Grothendieck topology generated by strongly cartesian lifts along `p` of the covering
families in `P`.  This is the precoverage-level owner of inherited topologies. -/
@[stacks 06NV "inherited topology generated by a precoverage"]
def stronglyCartesianTopology (P : Precoverage C) (p : S ⥤ C) :
    GrothendieckTopology S :=
  (P.stronglyCartesianLift p).toGrothendieck

end Precoverage

namespace Functor

variable {C : Type uC} [Category.{vC} C]
variable {S : Type uS} [Category.{vS} S]

/-- The transparent specialization of
`Precoverage.stronglyCartesianTopology` to the canonical precoverage of `J`. -/
@[stacks 06NV]
abbrev inheritedTopology (p : S ⥤ C) (J : GrothendieckTopology C) :
    GrothendieckTopology S :=
  J.toPrecoverage.stronglyCartesianTopology p

end Functor

end CategoryTheory
