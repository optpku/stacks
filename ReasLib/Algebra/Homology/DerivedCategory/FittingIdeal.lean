module

public import Mathlib.Data.Int.Range
public import Mathlib.LinearAlgebra.Matrix.ToLin
public import ReasLib.Algebra.Homology.DerivedCategory.PseudoCoherent.Model
public import ReasLib.LinearAlgebra.Matrix.MinorIdeal.Basic

@[expose] public section

open CategoryTheory

noncomputable section

namespace CategoryTheory.DerivedCategory

/-- A bounded-above finite-free coordinate presentation of an object of `D(R)`. -/
structure FittingPresentation.{u} {R : Type u} [CommRing R]
    (E : DerivedCategory (ModuleCat R)) where
  /-- The bounded-above cochain complex representing the derived object. -/
  model : CochainComplex (ModuleCat R) ℤ
  /-- A degree above which the model vanishes. -/
  upperBound : ℤ
  /-- The model vanishes strictly above `upperBound`. -/
  vanishesAbove : ∀ i : ℤ, upperBound < i → Limits.IsZero (model.X i)
  /-- The ranks of the chosen finite-free coordinates. -/
  rank : ℤ → ℕ
  /-- Chosen coordinates on every term of the model. -/
  termIso : ∀ i : ℤ, model.X i ≅ ModuleCat.of R (Fin (rank i) → R)
  /-- The comparison identifying the model with the derived object. -/
  represents : DerivedCategory.Q.obj model ≅ E

universe u

variable {R : Type u} [CommRing R]

namespace FittingPresentation

/-- Build a fitting presentation from a bounded-above model and explicit finite-free
coordinates. -/
def ofModel {E : DerivedCategory (ModuleCat R)}
    (model : CochainComplex (ModuleCat R) ℤ) (upperBound : ℤ)
    (vanishesAbove : ∀ i : ℤ, upperBound < i → Limits.IsZero (model.X i))
    (rank : ℤ → ℕ)
    (termIso : ∀ i : ℤ, model.X i ≅ ModuleCat.of R (Fin (rank i) → R))
    (represents : DerivedCategory.Q.obj model ≅ E) : FittingPresentation E :=
  { model, upperBound, vanishesAbove, rank, termIso, represents }

/-- The model of a presentation built by `ofModel` is the supplied cochain complex. -/
theorem ofModel_model {E : DerivedCategory (ModuleCat R)}
    (model : CochainComplex (ModuleCat R) ℤ) (upperBound : ℤ)
    (vanishesAbove : ∀ i : ℤ, upperBound < i → Limits.IsZero (model.X i))
    (rank : ℤ → ℕ)
    (termIso : ∀ i : ℤ, model.X i ≅ ModuleCat.of R (Fin (rank i) → R))
    (represents : DerivedCategory.Q.obj model ≅ E) :
    (ofModel model upperBound vanishesAbove rank termIso represents).model = model := rfl

/-- The alternating sum of the displayed ranks from degree `p + 1` through the upper bound. -/
def alternatingTailRank {E : DerivedCategory (ModuleCat R)}
    (P : FittingPresentation E) (p : ℤ) : ℤ :=
  ((Int.range (p + 1) (P.upperBound + 1)).map fun j ↦
    (-1 : ℤ) ^ Int.toNat (j - (p + 1)) * (P.rank j : ℤ)).sum

/-- The defining finite alternating sum for `alternatingTailRank`. -/
theorem alternatingTailRank_def {E : DerivedCategory (ModuleCat R)}
    (P : FittingPresentation E) (p : ℤ) :
    P.alternatingTailRank p =
      ((Int.range (p + 1) (P.upperBound + 1)).map fun j ↦
        (-1 : ℤ) ^ Int.toNat (j - (p + 1)) * (P.rank j : ℤ)).sum := rfl

/-- The minor size `Int.toNat (-k + P.alternatingTailRank p)`, with the alternating tail
computed from the ranks `P.rank (p + 1)`, `P.rank (p + 2)`, and so on. -/
def minorSize {E : DerivedCategory (ModuleCat R)}
    (P : FittingPresentation E) (p k : ℤ) : ℕ :=
  Int.toNat (-k + P.alternatingTailRank p)

/-- The minor size is the natural truncation of the corrected alternating rank. -/
theorem minorSize_def {E : DerivedCategory (ModuleCat R)}
    (P : FittingPresentation E) (p k : ℤ) :
    P.minorSize p k = Int.toNat (-k + P.alternatingTailRank p) := rfl

/-- The matrix of the degree-`p` differential in the chosen finite-free coordinates. -/
def matrix {E : DerivedCategory (ModuleCat R)}
    (P : FittingPresentation E) (p : ℤ) :
    Matrix (Fin (P.rank (p + 1))) (Fin (P.rank p)) R :=
  LinearMap.toMatrix' <|
    ((P.termIso p).inv ≫ P.model.d p (p + 1) ≫ (P.termIso (p + 1)).hom).hom

/-- `matrix` is the coordinate matrix of the displayed differential. -/
theorem matrix_def {E : DerivedCategory (ModuleCat R)}
    (P : FittingPresentation E) (p : ℤ) :
    P.matrix p = LinearMap.toMatrix'
      (((P.termIso p).inv ≫ P.model.d p (p + 1) ≫ (P.termIso (p + 1)).hom).hom) := rfl

/-- The determinantal ideal attached to a finite-free presentation in degrees `p` and `p + 1`. -/
def ideal {E : DerivedCategory (ModuleCat R)}
    (P : FittingPresentation E) (p k : ℤ) : Ideal R :=
  Matrix.minorIdeal (P.minorSize p k) (P.matrix p)

/-- A presentation ideal is generated by the prescribed minors of its differential matrix. -/
theorem ideal_def {E : DerivedCategory (ModuleCat R)}
    (P : FittingPresentation E) (p k : ℤ) :
    P.ideal p k = Matrix.minorIdeal (P.minorSize p k) (P.matrix p) := rfl

/-- A nonpositive corrected rank gives the unit ideal, in accordance with the empty-minor
convention. -/
theorem ideal_eq_top_of_nonpos {E : DerivedCategory (ModuleCat R)}
    (P : FittingPresentation E) (p k : ℤ)
    (h : -k + P.alternatingTailRank p ≤ 0) : P.ideal p k = ⊤ := by
  rw [ideal, minorSize, Int.toNat_eq_zero.mpr h, Matrix.minorIdeal]
  rw [Ideal.eq_top_iff_one]
  apply Ideal.subset_span
  refine ⟨⟨⟨fun i ↦ Fin.elim0 i, fun i ↦ Fin.elim0 i⟩,
    ⟨fun i ↦ Fin.elim0 i, fun i ↦ Fin.elim0 i⟩⟩, ?_⟩
  simp

/-- If the requested minor size exceeds the minimum of the two adjacent ranks
(equivalently, exceeds at least one adjacent rank), the presentation ideal is zero. -/
theorem ideal_eq_bot_of_minRank_lt {E : DerivedCategory (ModuleCat R)}
    (P : FittingPresentation E) (p k : ℤ)
    (h : min (P.rank p) (P.rank (p + 1)) < P.minorSize p k) :
    P.ideal p k = ⊥ := by
  rw [ideal, Matrix.minorIdeal, Ideal.span_eq_bot]
  rintro _ ⟨q, rfl⟩
  have h' : P.rank p < P.minorSize p k ∨
      P.rank (p + 1) < P.minorSize p k := by omega
  rcases h' with h' | h'
  · have hle : P.minorSize p k ≤ P.rank p :=
      Fin.nonempty_embedding_iff.mp ⟨q.2⟩
    exact False.elim ((Nat.not_lt_of_ge hle) h')
  · have hle : P.minorSize p k ≤ P.rank (p + 1) :=
      Fin.nonempty_embedding_iff.mp ⟨q.1⟩
    exact False.elim ((Nat.not_lt_of_ge hle) h')

/-- Pseudo-coherence supplies at least one bounded-above finite-free coordinate presentation. -/
theorem nonempty_of_isPseudoCoherent {E : DerivedCategory (ModuleCat R)}
    (hE : E.IsPseudoCoherent) : Nonempty (FittingPresentation E) := by
  obtain ⟨model, ⟨upperBound, hupper⟩, hfree, α, hα⟩ := hE
  let represents : DerivedCategory.Q.obj model ≅ E := asIso α
  -- Recover the finite-free structures directly from the model's hypothesis.
  letI : model.IsTermwiseFiniteFree := hfree
  letI (i : ℤ) : Module.Free R (model.X i) :=
    (HomologicalComplex.IsTermwiseFiniteFree.out (K := model) i).1
  letI (i : ℤ) : Module.Finite R (model.X i) :=
    (HomologicalComplex.IsTermwiseFiniteFree.out (K := model) i).2
  let rank : ℤ → ℕ := fun i =>
    Fintype.card (Module.Free.ChooseBasisIndex R (model.X i))
  let termIso : ∀ i : ℤ, model.X i ≅ ModuleCat.of R (Fin (rank i) → R) := fun i =>
    ((Module.Free.chooseBasis R (model.X i)).reindex
      (Fintype.equivFin _)).equivFun.toModuleIso
  refine ⟨{ model := model
            upperBound := upperBound
            vanishesAbove := ?_
            rank := rank
            termIso := termIso
            represents := represents }⟩
  intro i hi
  letI : model.IsStrictlyLE upperBound := hupper
  exact model.isZero_of_isStrictlyLE upperBound i hi

end FittingPresentation

/-- The canonical fitting ideal of a derived module, obtained as the infimum of the ideals
computed from all bounded-above finite-free coordinate presentations. -/
def fittingIdeal (E : DerivedCategory (ModuleCat R)) (p k : ℤ) : Ideal R :=
  sInf (Set.range fun P : FittingPresentation E ↦ P.ideal p k)

/-- The derived fitting ideal is the infimum of all presentation-level determinantal ideals. -/
theorem fittingIdeal_def (E : DerivedCategory (ModuleCat R)) (p k : ℤ) :
    fittingIdeal E p k = sInf (Set.range fun P : FittingPresentation E ↦ P.ideal p k) := rfl

/-- Every bounded-above finite-free presentation computes the canonical derived fitting ideal. -/
theorem fittingIdeal_eq_presentation {E : DerivedCategory (ModuleCat R)}
    (P : FittingPresentation E) (p k : ℤ) :
    fittingIdeal E p k = P.ideal p k := sorry

end CategoryTheory.DerivedCategory
