module

public import Mathlib.RingTheory.PolynomialAlgebra
public import Mathlib.RingTheory.TensorProduct.Quotient
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Tensor Base Change of Polynomial Quotients

This leaf packages the canonical comparison between scalar extension of a
one-variable polynomial quotient and the quotient by the coefficientwise
extended ideal.  It is independent of local-ring or residue-field data, so
specialized fiber statements can import it directly.
-/

@[expose] public section

universe u v

open scoped TensorProduct

namespace Polynomial

/-- Coefficient extension identifies the ideal induced from a polynomial ideal on the tensor
product with the direct image of that ideal in the polynomial ring over the new coefficients. -/
@[stacks 00P4 "polynomial-quotient tensor-base-change support"]
theorem tensorQuotientIdeal_map_eq
    {R : Type u} {K : Type v} [CommRing R] [CommRing K] [Algebra R K]
    (I : Ideal R[X]) :
    I.map (Polynomial.mapRingHom (algebraMap R K)) =
      Ideal.map
        ((polyEquivTensor' R K).symm : K ⊗[R] R[X] ≃ₐ[K] K[X]).toRingHom
        (I.map (Algebra.TensorProduct.includeRight : R[X] →ₐ[R] K ⊗[R] R[X])) := sorry

/-- Base changing the quotient of `R[X]` by `I` to `K` is the quotient of `K[X]` by the
coefficientwise extension of `I`. -/
@[stacks 00P4 "polynomial-quotient tensor-base-change support"]
noncomputable def tensorQuotientAlgEquiv
    {R : Type u} {K : Type v} [CommRing R] [CommRing K] [Algebra R K]
    (I : Ideal R[X]) :
    K ⊗[R] (R[X] ⧸ I) ≃ₐ[K] K[X] ⧸ I.map (Polynomial.mapRingHom (algebraMap R K)) :=
  (Algebra.TensorProduct.tensorQuotientEquiv (R := R) K R[X] K I).trans
    (Ideal.quotientEquivAlg
      (Ideal.map
        (Algebra.TensorProduct.includeRight : R[X] →ₐ[R] K ⊗[R] R[X]) I)
      (I.map (Polynomial.mapRingHom (algebraMap R K)))
      ((polyEquivTensor' R K).symm : K ⊗[R] R[X] ≃ₐ[K] K[X])
      (tensorQuotientIdeal_map_eq (R := R) (K := K) I))

/-- The coefficientwise extension of a principal polynomial ideal is generated by the
coefficientwise extension of its generator. -/
@[stacks 00P4 "polynomial-quotient tensor-base-change support"]
theorem tensorQuotientSpan_ideal_eq
    {R : Type u} {K : Type v} [CommRing R] [CommRing K] [Algebra R K]
    (g : R[X]) :
    (Ideal.span ({g} : Set R[X])).map (Polynomial.mapRingHom (algebraMap R K)) =
      Ideal.span ({g.map (algebraMap R K)} : Set K[X]) := sorry

/-- Base changing the quotient by the principal ideal `(g)` gives the quotient by the
coefficientwise extension of `g`. -/
@[stacks 00P4 "polynomial-quotient tensor-base-change support"]
noncomputable def tensorQuotientSpanAlgEquiv
    {R : Type u} {K : Type v} [CommRing R] [CommRing K] [Algebra R K]
    (g : R[X]) :
    K ⊗[R] (R[X] ⧸ Ideal.span ({g} : Set R[X])) ≃ₐ[K]
      K[X] ⧸ Ideal.span ({g.map (algebraMap R K)} : Set K[X]) :=
  (tensorQuotientAlgEquiv (R := R) (K := K) (Ideal.span ({g} : Set R[X]))).trans
    (Ideal.quotientEquivAlgOfEq K (tensorQuotientSpan_ideal_eq (R := R) (K := K) g))

/-- `tensorQuotientAlgEquiv` sends the pure tensor of `a` with the class of `f` to the class of
the coefficientwise extension of `f`, scaled by `a`. -/
@[simp]
theorem tensorQuotientAlgEquiv_apply_tmul_mk
    {R : Type u} {K : Type v} [CommRing R] [CommRing K] [Algebra R K]
    (I : Ideal R[X]) (a : K) (f : R[X]) :
    tensorQuotientAlgEquiv (R := R) (K := K) I
        (a ⊗ₜ[R] Ideal.Quotient.mk I f) =
      Ideal.Quotient.mk (I.map (Polynomial.mapRingHom (algebraMap R K)))
        (a • f.map (algebraMap R K)) := sorry

/-- `tensorQuotientSpanAlgEquiv` computes on pure tensors of quotient polynomial classes. -/
@[simp]
theorem tensorQuotientSpanAlgEquiv_apply_tmul_mk
    {R : Type u} {K : Type v} [CommRing R] [CommRing K] [Algebra R K]
    (g : R[X]) (a : K) (f : R[X]) :
    tensorQuotientSpanAlgEquiv (R := R) (K := K) g
        (a ⊗ₜ[R] Ideal.Quotient.mk (Ideal.span ({g} : Set R[X])) f) =
      Ideal.Quotient.mk (Ideal.span ({g.map (algebraMap R K)} : Set K[X]))
        (a • f.map (algebraMap R K)) := sorry

/-- The polynomial-quotient base-change equivalence sends the canonical tensor of the class of
`X` to the class of `X`. -/
@[stacks 00P4 "polynomial-quotient tensor-base-change support", simp]
theorem tensorQuotientSpanAlgEquiv_apply_tmul_mk_X
    {R : Type u} {K : Type v} [CommRing R] [CommRing K] [Algebra R K]
    (g : R[X]) :
    tensorQuotientSpanAlgEquiv (R := R) (K := K) g
        (1 ⊗ₜ[R] Ideal.Quotient.mk (Ideal.span ({g} : Set R[X])) Polynomial.X) =
      Ideal.Quotient.mk (Ideal.span ({g.map (algebraMap R K)} : Set K[X])) Polynomial.X := sorry

/-- The inverse principal-ideal comparison sends the class of a coefficientwise extended
polynomial back to the corresponding tensor-side quotient class. -/
@[simp]
theorem tensorQuotientSpanAlgEquiv_symm_apply_mk_map
    {R : Type u} {K : Type v} [CommRing R] [CommRing K] [Algebra R K]
    (g f : R[X]) :
    (tensorQuotientSpanAlgEquiv (R := R) (K := K) g).symm
        (Ideal.Quotient.mk (Ideal.span ({g.map (algebraMap R K)} : Set K[X]))
          (f.map (algebraMap R K))) =
      1 ⊗ₜ[R] Ideal.Quotient.mk (Ideal.span ({g} : Set R[X])) f := sorry

/-- The inverse polynomial-quotient base-change equivalence sends the class of `X` to the
canonical tensor of the class of `X`. -/
@[stacks 00P4 "polynomial-quotient tensor-base-change support", simp]
theorem tensorQuotientSpanAlgEquiv_symm_apply_mk_X
    {R : Type u} {K : Type v} [CommRing R] [CommRing K] [Algebra R K]
    (g : R[X]) :
    (tensorQuotientSpanAlgEquiv (R := R) (K := K) g).symm
        (Ideal.Quotient.mk (Ideal.span ({g.map (algebraMap R K)} : Set K[X])) Polynomial.X) =
      1 ⊗ₜ[R] Ideal.Quotient.mk (Ideal.span ({g} : Set R[X])) Polynomial.X := sorry

end Polynomial
