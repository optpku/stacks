module

public import Mathlib.Tactic.CrossRefAttribute
public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.Ideal.Quotient.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Principal ideals and their quotient maps

This module provides the small amount of reusable API built on the canonical mathlib expression
`Ideal.span {f}`: principal powers, principal-adic completions, and functorial maps between the
corresponding quotient rings.

-/

@[expose] public section

universe u v

section

variable {R : Type u} [CommRing R]

/-- The principal ideal `(f)`, written through the canonical owner `Ideal.span {f}`. -/
abbrev principalIdeal (f : R) : Ideal R :=
  Ideal.span ({f} : Set R)

/- Textbook notation for the principal ideal `(f)`, attached to `principalIdeal`. -/
scoped[PrincipalIdeal] notation:max "(" f:max ")" => principalIdeal f

open scoped PrincipalIdeal

/-- The principal ideal `(f)` is finitely generated. -/
theorem principalIdeal_fg (f : R) : ((f) : Ideal R).FG := sorry

/-- A principal ideal is contained in an ideal exactly when its generator belongs to that
ideal. -/
theorem principalIdeal_le_iff_mem {f : R} {I : Ideal R} :
    principalIdeal f ≤ I ↔ f ∈ I := sorry

namespace Ideal

/-- The image of an ideal is contained in a principal ideal exactly when every image of an
element of the ideal is divisible by the principal generator. -/
@[stacks 052Q "ideal image containment in a principal ideal"]
theorem map_le_span_singleton_iff
    {S : Type v} [CommRing S] (f : R →+* S) (I : Ideal R) (s : S) :
    Ideal.map f I ≤ Ideal.span {s} ↔ ∀ x, x ∈ I → s ∣ f x := sorry

end Ideal

/-- The principal ideal `(f^n)`. -/
abbrev principalPowerIdeal (f : R) (n : ℕ) : Ideal R :=
  ((f) : Ideal R) ^ n

/-- The `(f)`-adic completion of a commutative ring. -/
abbrev principalAdicCompletion (f : R) :=
  AdicCompletion ((f) : Ideal R) R

/-- A ring homomorphism sending `x` to `y` maps `(x)` into `(y)`. -/
theorem principalIdeal_le_comap_of_map_eq
    {S : Type v} [CommRing S] (σ : R →+* S) {x : R} {y : S} (hxy : σ x = y) :
    ((x) : Ideal R) ≤ Ideal.comap σ ((y) : Ideal S) := by
  rw [principalIdeal, Ideal.span_le]
  intro z hz
  change σ z ∈ ((y) : Ideal S)
  rcases Set.mem_singleton_iff.mp hz with rfl
  rw [hxy, principalIdeal]
  exact Ideal.subset_span (by simp)

/-- The quotient map induced by a ring homomorphism between principal quotients. -/
abbrev principalIdealQuotientMap
    {S : Type v} [CommRing S] (σ : R →+* S) (x : R) {y : S} (hxy : σ x = y) :
    R ⧸ ((x) : Ideal R) →+* S ⧸ ((y) : Ideal S) :=
  Ideal.quotientMap _ σ (principalIdeal_le_comap_of_map_eq σ hxy)

/-- A ring homomorphism sending `x` to `y` maps `(x)^n` into `(y)^n`. -/
theorem principalPowerIdeal_le_comap_of_map_eq
    {S : Type v} [CommRing S] (σ : R →+* S) {x : R} {y : S} (hxy : σ x = y) (n : ℕ) :
    principalPowerIdeal x n ≤ Ideal.comap σ (principalPowerIdeal y n) := by
  have hpow : σ (x ^ n) = y ^ n := by
    simpa [hxy] using map_pow σ x n
  simpa [principalPowerIdeal, principalIdeal, Ideal.span_singleton_pow, hpow] using
    principalIdeal_le_comap_of_map_eq σ hpow

/-- For `n ≥ 1`, the principal ideal `(x)^n` maps into the principal ideal generated by the image
of `x`. -/
theorem principalPowerIdeal_le_comap_principalIdeal
    {S : Type v} [CommRing S] (σ : R →+* S) (x : R) {n : ℕ} (hn : 1 ≤ n) :
    principalPowerIdeal x n ≤ Ideal.comap σ (principalIdeal (σ x)) := by
  refine (principalPowerIdeal_le_comap_of_map_eq σ rfl n).trans ?_
  refine Ideal.comap_mono ?_
  have hn' : n ≠ 0 := Nat.pos_iff_ne_zero.mp (Nat.succ_le_iff.mp hn)
  simpa [principalPowerIdeal, principalIdeal, Ideal.span_singleton_pow] using
    (Ideal.pow_le_self (I := principalIdeal (σ x)) hn')

/-- The quotient map induced by a ring homomorphism between principal-power quotients. -/
abbrev principalPowerIdealQuotientMap
    {S : Type v} [CommRing S] (σ : R →+* S) (x : R) {y : S} (hxy : σ x = y) (n : ℕ) :
    R ⧸ principalPowerIdeal x n →+* S ⧸ principalPowerIdeal y n :=
  Ideal.quotientMap _ σ (principalPowerIdeal_le_comap_of_map_eq σ hxy n)

/-- The quotient map from modulo `(x)^n` to modulo `((σ x))^n`. -/
abbrev principalPowerIdealImageQuotientMap
    {S : Type v} [CommRing S] (σ : R →+* S) (x : R) (n : ℕ) :
    R ⧸ principalPowerIdeal x n →+* S ⧸ principalPowerIdeal (σ x) n :=
  principalPowerIdealQuotientMap σ x rfl n

/-- For `n ≥ 1`, the quotient map from modulo `(x)^n` to modulo `(σ x)`. -/
abbrev principalPowerIdealReductionMap
    {S : Type v} [CommRing S] (σ : R →+* S) (x : R) {n : ℕ} (hn : 1 ≤ n) :
    R ⧸ principalPowerIdeal x n →+* S ⧸ principalIdeal (σ x) :=
  Ideal.quotientMap _ σ (principalPowerIdeal_le_comap_principalIdeal σ x hn)


section Prime

variable {R : Type u} [CommSemiring R]

namespace Ideal

/-- If every prime ideal is principal, then every ideal is principal. The hypothesis is explicit
so callers need not install a
temporary `IsPrincipalIdealRing` instance. -/
@[stacks 05KH "all ideals are principal when all prime ideals are principal"]
theorem isPrincipal_of_prime
    (I : Ideal R) (hprime : ∀ P : Ideal R, P.IsPrime → P.IsPrincipal) : I.IsPrincipal := sorry

end Ideal

end Prime


end
