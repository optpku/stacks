module

public import ReasLib.Algebra.Category.ModuleCat.Sheaf.RingedSite.Ideal.Quotient
public import ReasLib.AlgebraicGeometry.LocallyRingedSpace.IdealSubobject.Definition
public import ReasLib.AlgebraicGeometry.LocallyRingedSpace.SupportedQuotient
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Quotient-support spaces defined by ideal sheaves

This is the concrete data owner for the quotient-support space attached to an arbitrary ideal
subobject. The closed-immersion leaf proves that it is the associated closed subspace when the
ideal is locally generated by sections.
-/

@[expose] public section

open CategoryTheory
open AlgebraicGeometry
open SheafOfModules.RingedSite

noncomputable section

universe u

namespace AlgebraicGeometry.LocallyRingedSpace.IdealQuotient

/-- The quotient structure sheaf `𝒪_X / I`. -/
@[stacks 01HN "ideal quotient sheaf"]
abbrev sheaf {X : LocallyRingedSpace.{u}} (I : LocallyRingedSpace.IdealSubobject X) :
    TopCat.Sheaf CommRingCat.{u} X.toTopCat :=
  IdealSheaf.Quotient.sheaf.{u, u, u} I

/-- The canonical quotient projection `𝒪_X ⟶ 𝒪_X / I`. -/
@[stacks 01HN "ideal quotient projection"]
noncomputable abbrev projection
    {X : LocallyRingedSpace.{u}} (I : LocallyRingedSpace.IdealSubobject X) :
    X.𝒪 ⟶ sheaf I :=
  IdealSheaf.Quotient.projection.{u, u, u} I

/-- The canonical locally surjective quotient presentation defined by an ideal subobject. -/
@[stacks 01HN "ideal quotient presentation"]
noncomputable def presentation
    {X : LocallyRingedSpace.{u}} (I : LocallyRingedSpace.IdealSubobject X) :
    SupportedQuotient.Presentation X where
  sheaf := sheaf I
  projection := projection I
  locallySurjective :=
    IdealSheaf.Quotient.projection_isLocallySurjective.{u, u, u} I

/-- The sheaf in the ideal quotient presentation is the quotient sheaf. -/
@[simp, stacks 01HN "ideal quotient presentation sheaf"]
theorem presentation_sheaf
    {X : LocallyRingedSpace.{u}} (I : LocallyRingedSpace.IdealSubobject X) :
    (presentation I).sheaf = sheaf I := sorry

/-- The projection in the ideal quotient presentation is the quotient projection. -/
@[simp, stacks 01HN "ideal quotient presentation projection"]
theorem presentation_projection
    {X : LocallyRingedSpace.{u}} (I : LocallyRingedSpace.IdealSubobject X) :
    (presentation I).projection = projection I := sorry

/-- The quotient-support locally ringed space attached to an ideal subobject. -/
@[stacks 01HN "quotient space"]
noncomputable def space
    {X : LocallyRingedSpace.{u}} (I : LocallyRingedSpace.IdealSubobject X) :
    LocallyRingedSpace.{u} :=
  SupportedQuotient.space (presentation I)

/-- The canonical quotient-support morphism attached to `I`. -/
@[stacks 01HN "quotient inclusion"]
noncomputable def ι
    {X : LocallyRingedSpace.{u}} (I : LocallyRingedSpace.IdealSubobject X) :
    space I ⟶ X :=
  SupportedQuotient.ι (presentation I)

/-- Forgetting the local-ring condition identifies the ideal-quotient inclusion with its
supported-quotient presheafed-space morphism. -/
@[simp, stacks 01HN "ideal quotient inclusion underlying morphism"]
theorem ι_toHom
    {X : LocallyRingedSpace.{u}} (I : LocallyRingedSpace.IdealSubobject X) :
    (ι I).toHom = SupportedQuotient.toHom (presentation I) := sorry

/-- The underlying map of the ideal-quotient inclusion is the inclusion of the quotient
sheaf's support. -/
@[simp, stacks 01HN "ideal quotient inclusion underlying map"]
theorem ι_base
    {X : LocallyRingedSpace.{u}} (I : LocallyRingedSpace.IdealSubobject X) :
    (ι I).base = SupportedQuotient.inclusion (presentation I) := sorry

/-- The range of the ideal-quotient inclusion is the support of its quotient sheaf. -/
@[stacks 01HN "ideal quotient inclusion range"]
theorem range_ι_base
    {X : LocallyRingedSpace.{u}} (I : LocallyRingedSpace.IdealSubobject X) :
    Set.range (ι I).base = SupportedQuotient.support (presentation I) := sorry

end AlgebraicGeometry.LocallyRingedSpace.IdealQuotient
