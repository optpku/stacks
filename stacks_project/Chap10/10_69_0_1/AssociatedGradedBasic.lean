module

public import ReasLib.RingTheory.Sequence.QuasiRegular.Internal
public import Mathlib.RingTheory.Regular.RegularSequence
public import Mathlib.Data.Finsupp.Weight

@[expose] public section

-- Declarations for this item will be appended below by the statement pipeline.

open Polynomial
open scoped BigOperators TensorProduct Pointwise

universe u v

noncomputable section

namespace RingTheory.Sequence

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]

/-!
The canonical associated-graded model is owned by `ReasLib.RingTheory.Sequence.QuasiRegular.Internal`.
Only the short source-coordinate names below remain here; the internal quotient carrier and its
comparison maps are used directly through `QuasiRegular.internal*`.
-/

/-- Stacks `061P`: source-compatible spelling of the ideal generated by `rs`. -/
@[stacks 061P "source ideal generated by a finite sequence"]
abbrev quasiRegularIdeal (rs : List R) : Ideal R :=
  Ideal.ofList rs

/-- Stacks `061P`: source spelling of the canonical monomial degree. -/
@[stacks 061P "source monomial degree bridge"]
abbrev quasiRegularTotalDegree {rs : List R} (e : Fin rs.length →₀ ℕ) : ℕ :=
  QuasiRegular.monomialDegree e

/-- Stacks `061P`: source spelling of the canonical filtration stage. -/
@[stacks 061P "source associated-graded stage bridge"]
abbrev quasiRegularStage (rs : List R) (M : Type v) [AddCommGroup M] [Module R M]
    (n : ℕ) : Submodule R M :=
  Ideal.AssociatedGraded.stage (quasiRegularIdeal rs) M n

/-- Stacks `061P`: source spelling of the canonical stage denominator. -/
@[stacks 061P "source associated-graded denominator bridge"]
abbrev quasiRegularDenominator (rs : List R) (M : Type v) [AddCommGroup M] [Module R M]
    (n : ℕ) : Submodule R (quasiRegularStage rs M n) :=
  ((quasiRegularIdeal rs) • ⊤ : Submodule R (quasiRegularStage rs M n))

/-- Helper for 10.69.0.1: every module element lies in the zeroth filtration stage. -/
@[stacks 061P "zeroth associated-graded stage membership"]
theorem quasiRegularStage_zero_mem
    (rs : List R) (m : M) :
    m ∈ quasiRegularStage rs M 0 := sorry
end RingTheory.Sequence

#check @RingTheory.Sequence.quasiRegularIdeal
#check @RingTheory.Sequence.quasiRegularTotalDegree
#check @RingTheory.Sequence.quasiRegularStage
#check @RingTheory.Sequence.quasiRegularDenominator
#check @RingTheory.Sequence.QuasiRegular.internalPiece
#check @RingTheory.Sequence.QuasiRegular.internal
#check @RingTheory.Sequence.QuasiRegular.internalPieceEquiv
#check @RingTheory.Sequence.QuasiRegular.internalAddEquiv

end
