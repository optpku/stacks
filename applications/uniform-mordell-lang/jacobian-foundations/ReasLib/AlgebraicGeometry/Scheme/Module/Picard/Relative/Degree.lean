module

public import Mathlib.CategoryTheory.Sites.Subsheaf
public import ReasLib.AlgebraicGeometry.Scheme.Module.Derived.Pushforward.FiberEulerCharacteristic
public import ReasLib.AlgebraicGeometry.Scheme.Module.Picard.Relative

/-!
# Euler-degree loci before representability

The relative Euler difference and its base-change-stable loci are defined for
an arbitrary scheme over an arbitrary base. The degree subfunctor is the
locally generated image in the concrete fppf Picard sheaf. This file makes no
additivity, identity-component, numerical-triviality, or representability claim.

Curve hypotheses and geometric properties belong to `Relative.Components`;
the Euler characteristic remains owned by the derived-cohomology interface.
The stable condition tests every further base change, as required until the
proper-curve base-change theorem is proved.
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open scoped MonoidalCategory

universe u

namespace AlgebraicGeometry.RelativePicard

/-- The relative degree of a Picard class on `T ⊗ X`, computed fibrewise as the Euler
characteristic relative to the structure sheaf. -/
noncomputable def relativeDegree {S : Scheme.{u}} (X : Over S)
    (T : (Over S)ᵒᵖ) (x : (presheaf X).obj T) : T.unop.left → ℤ :=
  fun t ↦
    Scheme.Modules.relativeEulerChar
        (pullback.fst T.unop.hom X.hom) (Scheme.PicardGroup.repr x) t -
      Scheme.Modules.relativeEulerChar
        (pullback.fst T.unop.hom X.hom)
          (SheafOfModules.unit (T.unop ⊗ X).left.ringCatSheaf : (T.unop ⊗ X).left.Modules) t

/-- Relative degree is the difference between the fibre Euler characteristic of a
representative and that of the structure sheaf. -/
theorem relativeDegree_apply {S : Scheme.{u}} (X : Over S)
    (T : (Over S)ᵒᵖ) (x : (presheaf X).obj T) (t : T.unop.left) :
    relativeDegree X T x t =
      Scheme.Modules.relativeEulerChar
        (pullback.fst T.unop.hom X.hom) (Scheme.PicardGroup.repr x) t -
      Scheme.Modules.relativeEulerChar
        (pullback.fst T.unop.hom X.hom)
          (SheafOfModules.unit (T.unop ⊗ X).left.ringCatSheaf :
            (T.unop ⊗ X).left.Modules) t := rfl

/-- Classes whose pullback to every test scheme has constant relative degree `d`.
The base-change condition makes this a subfunctor for arbitrary `X`; on a
proper curve it agrees with the usual fiber-degree condition. -/
def degreePresheaf {S : Scheme.{u}} (X : Over S) (d : ℤ) : Subfunctor (presheaf X) where
  obj T := {x | ∀ (T' : (Over S)ᵒᵖ) (f : T ⟶ T'),
    relativeDegree X T' ((presheaf X).map f x) = fun _ ↦ d}
  map := by
    intro T T' f x hx T'' g
    simpa only [Functor.map_comp, CategoryTheory.comp_apply] using hx T'' (f ≫ g)

/-- Membership includes all further base changes, rather than silently assuming
base-change invariance of Euler characteristics for arbitrary schemes. -/
theorem mem_degreePresheaf {S : Scheme.{u}} (X : Over S) (d : ℤ)
    (T : (Over S)ᵒᵖ) (x : (presheaf X).obj T) :
    x ∈ (degreePresheaf X d).obj T ↔
      ∀ (T' : (Over S)ᵒᵖ) (f : T ⟶ T'),
        relativeDegree X T' ((presheaf X).map f x) = fun _ ↦ d := Iff.rfl

/-- The degree-`d` subfunctor of the relative Picard functor, obtained by taking the
locally generated image of the constant-degree Picard presheaf. -/
noncomputable def degreeSubfunctor {S : Scheme.{u}} (X : Over S) (d : ℤ) :
    Subfunctor (functor X).obj :=
  ((degreePresheaf X d).image
      (GrothendieckTopology.toSheafify (Scheme.fppfTopology.over S) (presheaf X))).sheafify
    (Scheme.fppfTopology.over S)

/-- A section belongs to the degree component exactly when it is locally generated by
constant-degree Picard-presheaf classes. -/
theorem mem_degreeSubfunctor {S : Scheme.{u}} (X : Over S) (d : ℤ)
    (T : (Over S)ᵒᵖ) (x : (functor X).obj.obj T) :
    x ∈ (degreeSubfunctor X d).obj T ↔
      (((degreePresheaf X d).image
        (GrothendieckTopology.toSheafify (Scheme.fppfTopology.over S)
          (presheaf X))).sieveOfSection x ∈
          (Scheme.fppfTopology.over S) T.unop) := Iff.rfl

end AlgebraicGeometry.RelativePicard
