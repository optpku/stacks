module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Algebra.Polynomial.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Kaehler.Basic
public import ReasLib.RingTheory.FittingIdeal.Basic

/-!
# The node family `k[x, y, t] / (x y - t ^ n)`

Coordinate ring of the family `k[t] → k[x, y, t] / (x y - t ^ n)` and its
relative Kähler differential Fitting ideals.
-/

@[expose] public section

noncomputable section

open MvPolynomial
open scoped FittingIdeal

universe u

namespace NodeFamily

/-- The coordinate `x` as the first indeterminate of `(Polynomial k)[x, y]`. -/
abbrev x (k : Type u) [CommRing k] : MvPolynomial (Fin 2) (Polynomial k) :=
  X 0

/-- The coordinate `y` as the second indeterminate of `(Polynomial k)[x, y]`. -/
abbrev y (k : Type u) [CommRing k] : MvPolynomial (Fin 2) (Polynomial k) :=
  X 1

/-- The indeterminate `t` in `Polynomial k`. -/
abbrev t (k : Type u) [CommRing k] : Polynomial k :=
  Polynomial.X

/-- The hypersurface polynomial `x y - t ^ n`. -/
def relation (k : Type u) [CommRing k] (n : ℕ) :
    MvPolynomial (Fin 2) (Polynomial k) :=
  x k * y k - C (t k ^ n)

/-- The principal ideal generated by `x y - t ^ n`. -/
def relationIdeal (k : Type u) [CommRing k] (n : ℕ) :
    Ideal (MvPolynomial (Fin 2) (Polynomial k)) :=
  Ideal.span {relation k n}

/-- The coordinate ring `k[x, y, t] / (x y - t ^ n)`. -/
abbrev coordRing (k : Type u) [CommRing k] (n : ℕ) : Type u :=
  MvPolynomial (Fin 2) (Polynomial k) ⧸ relationIdeal k n

/-- The defining equation vanishes in `NodeFamily.coordRing k n`. -/
theorem mk_relation (k : Type u) [CommRing k] (n : ℕ) :
    Ideal.Quotient.mk (relationIdeal k n) (relation k n) = 0 := sorry

/-- The relative differential Fitting ideals of the node family are zero at
index zero, generated by `x` and `y` at index one, and trivial thereafter. -/
theorem fittingIdeal (k : Type u) [Field k] (m n : ℕ) :
    Fit[coordRing k m]_(n)(Ω[coordRing k m⁄ Polynomial k]) =
      if n = 0 then ⊥
      else if n = 1 then
        (Ideal.span {x k, y k}).map
          (Ideal.Quotient.mk (relationIdeal k m))
      else ⊤ := sorry

/-- The zeroth relative differential Fitting ideal of the node family is zero. -/
theorem fittingIdeal_zero (k : Type u) [Field k] (m : ℕ) :
    Fit[coordRing k m]_(0)(Ω[coordRing k m⁄ Polynomial k]) = ⊥ := sorry

/-- The first relative differential Fitting ideal of the node family is the
image of the ideal generated by `x` and `y`. -/
theorem fittingIdeal_one (k : Type u) [Field k] (m : ℕ) :
    Fit[coordRing k m]_(1)(Ω[coordRing k m⁄ Polynomial k]) =
      (Ideal.span {x k, y k}).map (Ideal.Quotient.mk (relationIdeal k m)) := sorry

/-- Every relative differential Fitting ideal of the node family at index at
least two is the unit ideal. -/
theorem fittingIdeal_of_two_le (k : Type u) [Field k] (m : ℕ) {n : ℕ}
    (hn : 2 ≤ n) :
    Fit[coordRing k m]_(n)(Ω[coordRing k m⁄ Polynomial k]) = ⊤ := sorry

end NodeFamily
