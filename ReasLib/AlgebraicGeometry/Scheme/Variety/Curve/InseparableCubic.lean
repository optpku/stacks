@[expose] public section

open CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.InseparableCubic

variable {k : Type u} [Field k]

/-- The homogeneous cubic `T₁²T₀ - T₂³ + aT₀³`. -/
abbrev equation (a : k) : MvPolynomial (Fin 3) k :=
  MvPolynomial.X (1 : Fin 3) ^ 2 * MvPolynomial.X (0 : Fin 3) -
    MvPolynomial.X (2 : Fin 3) ^ 3 +
      MvPolynomial.C a * MvPolynomial.X (0 : Fin 3) ^ 3

/-- The cubic equation is homogeneous of degree three. -/
theorem equation_mem_grading_three (a : k) :
    equation a ∈ ProjectiveSpace.grading k 2 3 := by
  exact ((MvPolynomial.isHomogeneous_X_pow (1 : Fin 3) 2).mul
    (MvPolynomial.isHomogeneous_X k (0 : Fin 3))).sub
      (MvPolynomial.isHomogeneous_X_pow (2 : Fin 3) 3) |>.add
        (MvPolynomial.isHomogeneous_C_mul_X_pow a (0 : Fin 3) 3)

/-- The principal ideal generated by the cubic equation. -/
def ideal (a : k) : Ideal (MvPolynomial (Fin 3) k) := Ideal.span {equation a}

/-- The homogeneous coordinate ring of the cubic. -/
abbrev coordinateRing (a : k) := MvPolynomial (Fin 3) k ⧸ ideal a

/-- The quotient grading on the homogeneous coordinate ring. -/
abbrev grading (a : k) : ℕ → Submodule k (coordinateRing a) :=
  GradedAlgebra.Quotient.grading (ProjectiveSpace.grading k 2) (ideal a)

/-- The homogeneous principal quotient carries its canonical graded-ring structure. -/
instance grading_gradedRing (a : k) : GradedRing (grading a) :=
  GradedAlgebra.Quotient.spanSingletonGradedAlgebra (ProjectiveSpace.grading k 2)
    ⟨3, equation_mem_grading_three a⟩

/-- The graded quotient map from the plane coordinate ring. -/
def quotientGradedHom (a : k) : ProjectiveSpace.grading k 2 →+*ᵍ grading a where
  toRingHom := Ideal.Quotient.mk (ideal a)
  map_mem := GradedAlgebra.Quotient.mk_mem_grading (ProjectiveSpace.grading k 2) (ideal a)

/-- The coordinate homomorphism sending the line variables to the classes of `T₀` and `T₁`. -/
def projectionRingHom (a : k) : MvPolynomial (Fin 2) k →+* coordinateRing a :=
  (Ideal.Quotient.mk (ideal a)).comp
    (MvPolynomial.rename (fun index : Fin 2 ↦ index.castSucc)).toRingHom

/-- The coordinate homomorphism of the projection preserves each homogeneous degree. -/
theorem projectionRingHom_mem_grading (a : k) {degree : ℕ}
    {polynomial : MvPolynomial (Fin 2) k}
    (h : polynomial ∈ ProjectiveSpace.grading k 1 degree) :
    projectionRingHom a polynomial ∈ grading a degree := by
  exact GradedAlgebra.Quotient.mk_mem_grading (ProjectiveSpace.grading k 2) (ideal a)
    (MvPolynomial.IsHomogeneous.rename_isHomogeneous h)

/-- The graded coordinate homomorphism defining the projection to the projective line. -/
def projectionGradedHom (a : k) : ProjectiveSpace.grading k 1 →+*ᵍ grading a where
  toRingHom := projectionRingHom a
  map_mem := projectionRingHom_mem_grading a

/-- The projective cubic defined by the homogeneous principal quotient. -/
abbrev scheme (a : k) : Scheme := Proj (grading a)

/-- The graded quotient map induces a projective-spectrum map on the whole cubic. -/
theorem embeddingDomain_eq_top (a : k) :
    projMapDomain (quotientGradedHom a) = ⊤ := by
  classical
  apply top_unique
  intro x _
  by_contra hx
  apply x.not_irrelevant_le
  rw [HomogeneousIdeal.irrelevant_le]
  intro degree hdegree element helement
  obtain ⟨polynomial, hpolynomial, rfl⟩ := helement
  by_contra hmem
  exact hx ((basicOpen_le_projMapDomain (quotientGradedHom a) hdegree hpolynomial)
    hmem)

/-- The coordinates `T₀` and `T₁` have no common zero on the cubic. -/
theorem projectionDomain_eq_top (a : k) :
    projMapDomain (projectionGradedHom a) = ⊤ := by
  classical
  apply top_unique
  intro x _
  by_contra hx
  let J := x.asHomogeneousIdeal.toIdeal
  have h01 (index : Fin 2) :
      Ideal.Quotient.mk (ideal a) (MvPolynomial.X index.castSucc) ∈ J := by
    by_contra hmem
    apply hx
    apply basicOpen_le_projMapDomain (projectionGradedHom a) Nat.zero_lt_one
      (MvPolynomial.isHomogeneous_X k index)
    simpa [projectionGradedHom, projectionRingHom, J] using hmem
  have hequation : Ideal.Quotient.mk (ideal a) (equation a) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
  have hcube :
      Ideal.Quotient.mk (ideal a) (MvPolynomial.X (2 : Fin 3)) ^ 3 ∈ J := by
    have heq : Ideal.Quotient.mk (ideal a) (MvPolynomial.X (2 : Fin 3)) ^ 3 =
        Ideal.Quotient.mk (ideal a) (MvPolynomial.X (1 : Fin 3)) ^ 2 *
          Ideal.Quotient.mk (ideal a) (MvPolynomial.X (0 : Fin 3)) +
        Ideal.Quotient.mk (ideal a) (MvPolynomial.C a) *
          Ideal.Quotient.mk (ideal a) (MvPolynomial.X (0 : Fin 3)) ^ 3 := by
      exact (sub_eq_zero.mp (by
        simpa only [equation, map_add, map_sub, map_mul, map_pow,
          sub_add_eq_add_sub] using hequation)).symm
    rw [heq]
    exact J.add_mem (J.mul_mem_left _ (h01 0))
      (J.mul_mem_left _ (J.pow_mem_of_mem (h01 0) 3 (by decide)))
  have hX (index : Fin 3) :
      Ideal.Quotient.mk (ideal a) (MvPolynomial.X index) ∈ J := by
    fin_cases index
    · exact h01 0
    · exact h01 1
    · exact x.isPrime.mem_of_pow_mem 3 hcube
  have hpolynomial (polynomial : MvPolynomial (Fin 3) k) :
      Ideal.Quotient.mk (ideal a) polynomial -
        Ideal.Quotient.mk (ideal a) (MvPolynomial.C (MvPolynomial.constantCoeff polynomial))
          ∈ J := by
    induction polynomial using MvPolynomial.induction_on with
    | C coefficient => simp
    | add p q hp hq =>
      simpa only [map_add, add_sub_add_comm] using J.add_mem hp hq
    | mul_X p index hp =>
      simpa using J.mul_mem_left (Ideal.Quotient.mk (ideal a) p) (hX index)
  apply x.not_irrelevant_le
  rw [HomogeneousIdeal.irrelevant_le]
  intro degree hdegree element helement
  obtain ⟨polynomial, hhomogeneous, rfl⟩ := helement
  have hconstant : MvPolynomial.constantCoeff polynomial = 0 :=
    MvPolynomial.IsHomogeneous.coeff_eq_zero hhomogeneous (by
      simpa using Nat.ne_of_lt hdegree)
  simpa [hconstant, J] using hpolynomial polynomial

/-- The canonical morphism of the cubic into the standard projective plane. -/
def iota (a : k) : scheme a ⟶ ProjectiveSpace.scheme k 2 :=
  (scheme a).topIso.inv ≫ ((scheme a).isoOfEq (embeddingDomain_eq_top a)).inv ≫
    projMapMap (quotientGradedHom a)

/-- The structure morphism of the cubic to the spectrum of its coefficient field. -/
def toSpec (a : k) : scheme a ⟶ Spec (CommRingCat.of k) :=
  iota a ≫ ProjectiveSpace.toSpec k 2

/-- The cubic bundled as a scheme over its coefficient field. -/
abbrev schemeOver (a : k) : SchemeOverField k := Over.mk (toSpec a)

/-- The canonical projection with homogeneous coordinate formula `(T₀ : T₁)`. -/
def xProjection (a : k) : (schemeOver a).left ⟶ (ProjectiveSpace.schemeOver k 1).left :=
  (scheme a).topIso.inv ≫ ((scheme a).isoOfEq (projectionDomain_eq_top a)).inv ≫
    projMapMap (projectionGradedHom a)

/-- The inverse image on the cubic of a standard projective-plane coordinate chart. -/
def chart (a : k) (index : Fin 3) : (scheme a).Opens :=
  iota a ⁻¹ᵁ ProjectiveSpace.coordinateBasicOpen (R := k) 2 index

/-- The section `T_{index+1}/T₀` on the zeroth chart of the cubic. -/
def chartCoordinate (a : k) (index : Fin 2) : Γ(scheme a, chart a 0) :=
  ((iota a).app (ProjectiveSpace.coordinateBasicOpen (R := k) 2 0)).hom
    ((ProjectiveSpace.coordinateBasicOpenIsoAway (R := k) 2 0).hom
      (ProjectiveSpace.coordinateRatio (R := k) 2 0 (Equiv.refl (Fin 2)) index))

/-- Dehomogenizing the cubic at `T₀` gives `x² - y³ + a`. -/
theorem equation_dehomogenizeAt_zero (a : k) :
    ProjectiveSpace.dehomogenizeAt 2 0 (Equiv.refl (Fin 2)) (equation a) =
      MvPolynomial.X (0 : Fin 2) ^ 2 - MvPolynomial.X (1 : Fin 2) ^ 3 +
        MvPolynomial.C a := by
  have hcoordinate (index : Fin 2) :
      (finSuccAboveEquiv (0 : Fin 3)).symm
        ⟨(0 : Fin 3).succAbove index, Fin.succAbove_ne _ _⟩ = index :=
    (finSuccAboveEquiv (0 : Fin 3)).symm_apply_apply index
  have h1 : (finSuccAboveEquiv (0 : Fin 3)).symm ⟨1, by decide⟩ = (0 : Fin 2) :=
    hcoordinate 0
  have h2 : (finSuccAboveEquiv (0 : Fin 3)).symm ⟨2, by decide⟩ = (1 : Fin 2) :=
    hcoordinate 1
  simp [equation, ProjectiveSpace.dehomogenizeAt, h1, h2]

/-- The cubic embeds as a closed subscheme of the standard projective plane. -/
instance instClosedImmersion [CharP k 3] (a : k)
    [Fact (a ∉ Set.range (fun element : k ↦ element ^ 3))] :
    IsClosedImmersion (iota a) := by
  exact projQuotientMap_isClosedImmersion (ProjectiveSpace.grading k 2)
    ⟨ideal a, GradedAlgebra.Quotient.spanSingleton_isHomogeneous
      (ProjectiveSpace.grading k 2) ⟨3, equation_mem_grading_three a⟩⟩

/-- The characteristic-three cubic associated to a noncube is an integral curve. -/
instance instCurve [CharP k 3] (a : k)
    [Fact (a ∉ Set.range (fun element : k ↦ element ^ 3))] :
    Curve (schemeOver a) := sorry

/-- The chart containing `(0 : 1 : 0)` is smooth over the coefficient field. -/
instance instSmoothInfinityChart [CharP k 3] (a : k)
    [Fact (a ∉ Set.range (fun element : k ↦ element ^ 3))] :
    Smooth ((chart a 1).ι ≫ toSpec a) := sorry

/-- The characteristic-three cubic associated to a noncube is regular. -/
instance instRegular [CharP k 3] (a : k)
    [Fact (a ∉ Set.range (fun element : k ↦ element ^ 3))] :
    Scheme.Regular (scheme a) := sorry

/-- The structure morphism of the cubic is proper. -/
instance instProper [CharP k 3] (a : k)
    [Fact (a ∉ Set.range (fun element : k ↦ element ^ 3))] :
    IsProper (toSpec a) := by
  letI : IsScalarTower k (ProjectiveSpace.grading k 2 0) (MvPolynomial (Fin 3) k) :=
    IsScalarTower.of_algebraMap_eq' rfl
  letI : Algebra.FiniteType (ProjectiveSpace.grading k 2 0) (MvPolynomial (Fin 3) k) :=
    Algebra.FiniteType.of_restrictScalars_finiteType k (ProjectiveSpace.grading k 2 0)
      (MvPolynomial (Fin 3) k)
  have hproper : IsProper (ProjectiveSpace.toSpec k 2) :=
    MorphismProperty.IsStableUnderComposition.comp_mem
      (Proj.toSpecZero (ProjectiveSpace.grading k 2))
      (ProjectiveSpace.degreeZeroSpecIso k 2).hom inferInstance inferInstance
  exact MorphismProperty.IsStableUnderComposition.comp_mem
    (iota a) (ProjectiveSpace.toSpec k 2) inferInstance hproper

/-- The global functions on the cubic are exactly the coefficient field. -/
theorem globalSectionsMap_bijective [CharP k 3] (a : k)
    [Fact (a ∉ Set.range (fun element : k ↦ element ^ 3))] :
    Function.Bijective (Scheme.Hom.globalSectionsMap (toSpec a)) := sorry

/-- The regular characteristic-three cubic associated to a noncube has genus one. -/
theorem genus_eq_one [CharP k 3] (a : k)
    [Fact (a ∉ Set.range (fun element : k ↦ element ^ 3))] :
    @SchemeOverField.genus k _ (schemeOver a) (instProper a)
      (topologicalKrullDim_eq_one (schemeOver a)) (globalSectionsMap_bijective a) = 1 := sorry

/-- The projection to the projective line is a morphism over the coefficient field. -/
theorem xProjection_toSpec [CharP k 3] (a : k)
    [Fact (a ∉ Set.range (fun element : k ↦ element ^ 3))] :
    xProjection a ≫ ProjectiveSpace.toSpec k 1 = toSpec a := sorry

/-- The inverse image of the zeroth projective-line chart is the zeroth cubic chart. -/
theorem xProjection_preimage_chart [CharP k 3] (a : k)
    [Fact (a ∉ Set.range (fun element : k ↦ element ^ 3))] :
    xProjection a ⁻¹ᵁ
      (ProjectiveSpace.coordinateBasicOpen (R := k) 1 0 : (ProjectiveSpace.scheme k 1).Opens) =
      chart a 0 := by
  have hpreimage {n : ℕ}
      (ψ : ProjectiveSpace.grading k n →+*ᵍ grading a)
      (hψ : projMapDomain ψ = ⊤) (index : Fin (n + 1)) :
      ((scheme a).topIso.inv ≫ ((scheme a).isoOfEq hψ).inv ≫ projMapMap ψ) ⁻¹ᵁ
        (ProjectiveSpace.coordinateBasicOpen (R := k) n index :
          (ProjectiveSpace.scheme k n).Opens) =
        Proj.basicOpen (grading a) (ψ (MvPolynomial.X index)) := by
    let e := (scheme a).isoOfEq hψ ≪≫ (scheme a).topIso
    change (e.inv ≫ projMapMap ψ) ⁻¹ᵁ _ = _
    rw [Scheme.Hom.comp_preimage, Scheme.Hom.inv_preimage]
    have he : e.hom = (projMapDomain ψ).ι := by simp [e]
    simpa only [he] using projMapMap_preimage_basicOpen ψ Nat.zero_lt_one
      (MvPolynomial.isHomogeneous_X k index)
  calc
    xProjection a ⁻¹ᵁ
        (ProjectiveSpace.coordinateBasicOpen (R := k) 1 0 :
          (ProjectiveSpace.scheme k 1).Opens) =
        Proj.basicOpen (grading a) ((projectionGradedHom a) (MvPolynomial.X 0)) :=
      hpreimage (projectionGradedHom a) (projectionDomain_eq_top a) 0
    _ = Proj.basicOpen (grading a) ((quotientGradedHom a) (MvPolynomial.X 0)) := by
      congr 1
      simp [projectionGradedHom, projectionRingHom, quotientGradedHom]
    _ = chart a 0 :=
      (hpreimage (quotientGradedHom a) (embeddingDomain_eq_top a) 0).symm

/-- The projection pulls the affine-line coordinate back to the section `T₁/T₀`. -/
theorem xProjection_coordinate [CharP k 3] (a : k)
    [Fact (a ∉ Set.range (fun element : k ↦ element ^ 3))] :
    ((xProjection a).appLE
      (ProjectiveSpace.coordinateBasicOpen (R := k) 1 0 : (ProjectiveSpace.scheme k 1).Opens)
      (chart a 0) (xProjection_preimage_chart a).ge).hom
        ((ProjectiveSpace.coordinateBasicOpenIsoAway (R := k) 1 0).hom
          (ProjectiveSpace.coordinateRatio (R := k) 1 0 (Equiv.refl (Fin 1)) 0)) =
      chartCoordinate a 0 := sorry

/-- The canonical projection of the cubic to the projective line is dominant. -/
instance instDominant [CharP k 3] (a : k)
    [Fact (a ∉ Set.range (fun element : k ↦ element ^ 3))] :
    IsDominant (xProjection a) := sorry

/-- The function-field extension induced by the projection has degree three. -/
theorem xProjection_degree_eq_three [CharP k 3] (a : k)
    [Fact (a ∉ Set.range (fun element : k ↦ element ^ 3))] :
    (xProjection a).inducedFunctionFieldDegree = 3 := sorry

/-- The function-field extension induced by the projection is purely inseparable. -/
theorem xProjection_isPurelyInseparable [CharP k 3] (a : k)
    [Fact (a ∉ Set.range (fun element : k ↦ element ^ 3))] :
    ((xProjection a).functionFieldMap
      (xProjection a).map_genericPoint_eq_of_isDominant).IsPurelyInseparable := sorry

end AlgebraicGeometry.InseparableCubic
