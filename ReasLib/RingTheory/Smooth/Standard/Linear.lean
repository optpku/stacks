module

public import Mathlib.RingTheory.Smooth.StandardSmooth
import Mathlib.Tactic.CrossRefAttribute

/-!
# Linear standard-smooth presentations

This leaf owns the universal linear presentation which realizes a finite
family as polynomial generators.  Its quotient equivalence is evaluation at
that family; the section needed by the internal naive presentation is derived
from this equivalence rather than chosen by `Function.surjInv`.

@stack 07EY
-/

@[expose] public section

open MvPolynomial

noncomputable section

universe v w

namespace Algebra

namespace LinearPresentation

variable {A : Type v} [CommRing A]
variable {ι : Type w}

/-- The linear polynomial relation forcing `X i` to have value `β i`. -/
@[stacks 07EY "linear standard-smooth presentation"]
def relation (β : ι → A) (i : ι) : MvPolynomial ι A :=
  X i - C (β i)

/-- The ideal generated by the linear relations `X i - C (β i)`. -/
@[stacks 07EY "linear standard-smooth presentation"]
def ideal (β : ι → A) : Ideal (MvPolynomial ι A) :=
  Ideal.span (Set.range (relation β))

/-- Constants are a right inverse to evaluation at `β`. -/
theorem aeval_C_rightInverse (β : ι → A) :
    Function.RightInverse (C : A → MvPolynomial ι A) (aeval β) := by
  intro a
  simp

/-- Every polynomial differs from its evaluation at `β` by an element of the
linear-relation ideal. -/
theorem sub_C_aeval_mem_ideal (β : ι → A) (f : MvPolynomial ι A) :
    f - C (aeval β f) ∈ ideal β := by
  induction f using MvPolynomial.induction_on with
  | C a => simp
  | add f g hf hg =>
      simpa only [map_add, add_sub_add_comm] using (ideal β).add_mem hf hg
  | mul_X f i hf =>
      have hi : relation β i ∈ ideal β := Ideal.subset_span (Set.mem_range_self i)
      have h := (ideal β).add_mem ((ideal β).mul_mem_right (X i) hf)
        ((ideal β).mul_mem_left (C (aeval β f)) hi)
      simpa only [relation, mul_sub, sub_mul, sub_add_sub_cancel, map_mul, aeval_X]
        using h

/-- The ideal generated by the linear relations is exactly the kernel of
evaluation at `β`. -/
theorem ideal_eq_ker_aeval (β : ι → A) :
    ideal β = RingHom.ker (aeval β) := by
  apply le_antisymm
  · show ideal β ≤ RingHom.ker (aeval β)
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    change aeval β (relation β i) = 0
    simp [relation]
  · change RingHom.ker (aeval β) ≤ ideal β
    intro f hf
    change aeval β f = 0 at hf
    simpa [hf] using sub_C_aeval_mem_ideal β f

/-- Evaluation gives the canonical equivalence from the linear-relation
quotient to `A`. -/
@[stacks 07EY "linear standard-smooth presentation"]
def quotientEquiv (β : ι → A) :
    (MvPolynomial ι A ⧸ ideal β) ≃ₐ[A] A :=
  (Ideal.quotientEquivAlgOfEq A (ideal_eq_ker_aeval β)).trans
    (Ideal.quotientKerAlgEquivOfRightInverse
      (f := (aeval β : MvPolynomial ι A →ₐ[A] A))
      (g := (C : A → MvPolynomial ι A))
      (aeval_C_rightInverse β))

/-- The canonical polynomial representative obtained by evaluating a quotient
class and embedding the result as a constant polynomial. -/
@[stacks 07EY "linear relation quotient representative"]
def representative (β : ι → A) :
    MvPolynomial ι A ⧸ ideal β → MvPolynomial ι A :=
  fun x ↦ C (quotientEquiv β x)

/-- The canonical representative is a right inverse to the quotient map. -/
@[stacks 07EY "linear relation quotient representative specification"]
theorem representative_spec (β : ι → A) (x : MvPolynomial ι A ⧸ ideal β) :
    Ideal.Quotient.mk (ideal β) (representative β x) = x := by
  apply (quotientEquiv β).injective
  exact (quotientEquiv β).commutes (quotientEquiv β x)

/-- The quotient-to-`A` equivalence sends the class of `X i` to `β i`. -/
@[simp] theorem quotientEquiv_mk_X (β : ι → A) (i : ι) :
    quotientEquiv β (Ideal.Quotient.mk (ideal β) (X i)) = β i := by
  change aeval β (X i) = β i
  exact aeval_X β i

/-- The quotient-to-`A` equivalence sends constant classes to those constants. -/
@[simp] theorem quotientEquiv_mk_C (β : ι → A) (a : A) :
    quotientEquiv β (Ideal.Quotient.mk (ideal β) (C a)) = a := by
  exact (quotientEquiv β).commutes a

/-- Evaluation through the quotient equivalence is direct polynomial
evaluation at `β`. -/
theorem quotientEquiv_mk_eq_aeval (β : ι → A) (p : MvPolynomial ι A) :
    quotientEquiv β (Ideal.Quotient.mk (ideal β) p) = aeval β p := by
  rfl

section Finite

variable [Finite ι]

-- Local instance justification (noncanonical choice): the internal `Finset.univ`
-- construction needs an enumeration, while the public presentation is independent
-- of which finite enumeration is selected.
attribute [local instance] Fintype.ofFinite

/-- The naive presentation by the linear relations has unit Jacobian. -/
@[stacks 07EY "linear naive presentation Jacobian"]
theorem naive_jacobian_isUnit (β : ι → A)
    (s : MvPolynomial ι A ⧸ ideal β → MvPolynomial ι A)
    (hs : ∀ x, Ideal.Quotient.mk (ideal β) (s x) = x) :
    IsUnit
      ((PreSubmersivePresentation.naive
          (R := A) (σ := ι) (ι := ι) (v := relation β)
          (fun i ↦ i) Function.injective_id s hs).jacobian) := by
  classical
  let P := PreSubmersivePresentation.naive
    (R := A) (σ := ι) (ι := ι) (v := relation β)
    (fun i ↦ i) Function.injective_id s hs
  have hP : P.jacobiMatrix = 1 := by
    ext i j : 1
    simp [P, relation, pderiv_X, Matrix.one_apply, Pi.single_apply, eq_comm]
  change IsUnit P.jacobian
  rw [P.jacobian_eq_jacobiMatrix_det, hP, Matrix.det_one, map_one]
  exact isUnit_one

/-- The internal quotient presentation by the linear relations is
submersive. -/
@[stacks 07EY "linear naive submersive presentation"]
def naiveSubmersive (β : ι → A) :
    SubmersivePresentation A (MvPolynomial ι A ⧸ ideal β) ι ι :=
  { toPreSubmersivePresentation :=
      PreSubmersivePresentation.naive
        (R := A) (σ := ι) (ι := ι) (v := relation β)
        (fun i ↦ i) Function.injective_id (representative β) (representative_spec β)
    jacobian_isUnit :=
      naive_jacobian_isUnit β (representative β) (representative_spec β) }

/-- The canonical linear submersive presentation of `A` has prescribed
generator values `β`. -/
@[stacks 07EY "linear standard-smooth presentation"]
def submersive (β : ι → A) : SubmersivePresentation A A ι ι :=
  (naiveSubmersive β).ofAlgEquiv (quotientEquiv β)

/-- The distinguished-variable map of the linear submersive presentation is
the identity. -/
@[simp] theorem submersive_map (β : ι → A) :
    (submersive β).map = (fun i ↦ i) := by
  rfl

/-- The distinguished generators of the linear submersive presentation
evaluate to `β`. -/
@[simp] theorem submersive_val (β : ι → A) (i : ι) :
    (submersive β).val i = β i := by
  exact quotientEquiv_mk_X β i

end Finite

end LinearPresentation

end Algebra
