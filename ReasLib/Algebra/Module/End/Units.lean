module

public import Mathlib.Algebra.Algebra.Tower
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Units Acting on Modules

This leaf records the general scalar-extension fact that a base-ring element
which is invertible after extension of scalars acts by an invertible
base-linear endomorphism on every compatible module.

@stack 051T
-/

@[expose] public section

universe u v w

namespace Module.End

variable {R : Type u} [CommSemiring R]
variable {A : Type v} [Semiring A] [Algebra R A]
variable {M : Type w} [AddCommMonoid M] [Module R M] [Module A M]
  [IsScalarTower R A M]

/-- Tag `051T`: if a scalar from `R` becomes a unit in `A`, then its action on
every compatible `A`-module is an invertible `R`-linear endomorphism. -/
@[stacks 051T "unit scalar module-endomorphism action"]
theorem isUnit_algebraMap_of_isUnit {r : R}
    (hr : IsUnit (algebraMap R A r)) :
    IsUnit (algebraMap R (Module.End R M) r) := sorry

/-- Tag `051T`: if a scalar from `R` becomes a unit in `A`, then every element
of the submonoid generated by that scalar acts invertibly on every compatible
`A`-module. -/
@[stacks 051T "powers of unit scalar module-endomorphism action"]
theorem isUnit_algebraMap_of_mem_powers {r : R}
    (hr : IsUnit (algebraMap R A r)) (s : Submonoid.powers r) :
    IsUnit (algebraMap R (Module.End R M) s) := sorry

end Module.End
