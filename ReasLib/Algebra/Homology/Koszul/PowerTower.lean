module

public import ReasLib.Algebra.Homology.DerivedCategory.ModuleCat
public import ReasLib.RingTheory.Sequence.Koszul.Power
public import ReasLib.RingTheory.Ideal.FiniteGeneration.PowerFamily
public import ReasLib.CategoryTheory.InverseSystem.Sequential
public import Mathlib.Algebra.Homology.Embedding.StupidTrunc
public import Mathlib.Algebra.Homology.HomotopyCategory.Shift
import Mathlib.Tactic.CrossRefAttribute

/-!
# Powered Koszul towers and their ideal complexes

For a finite family `f : ι → R`, the powered Koszul tower has stage `n` equal to the
Koszul complex on `f i ^ (n + 1)`.  Its associated ideal complex is
`σ≤-1 Kₙ[-1]`: first take the stupid truncation in degrees at most `-1`, then shift by
`-1`.  These constructions are functorial in the powered transition maps, so they form
sequential inverse systems before and after localization to `D(R)`.

@stack 0BKC
-/

@[expose] public section

open CategoryTheory
open Opposite

noncomputable section

universe u v

namespace KoszulComplex.PowerTower

variable {R : Type u} [CommRing R]
variable {ι : Type v} [Finite ι]

/-- The powered Koszul chain complex, extended to an integer-graded cochain complex. -/
@[stacks 0BKC "powered Koszul cochain stage"]
abbrev cochainStage (f : ι → R) (n : ℕ) : CochainComplex (ModuleCat R) ℤ :=
  (KoszulComplex.powerComplex f n).extend ComplexShape.embeddingDownNat

/-- The adjacent transition between powered Koszul cochain stages. -/
@[stacks 0BKC "powered Koszul cochain transition"]
abbrev cochainStep (f : ι → R) (n : ℕ) :
    cochainStage f (n + 1) ⟶ cochainStage f n :=
  (ComplexShape.embeddingDownNat.extendFunctor (ModuleCat R)).map
    (KoszulComplex.powerStep f n)

/-- The powered Koszul cochain complexes and their adjacent transition maps form a
sequential inverse system. -/
@[stacks 0BKC "powered Koszul cochain inverse system"]
abbrev cochainSystem (f : ι → R) :
    SequentialInverseSystem (CochainComplex (ModuleCat R) ℤ) :=
  Functor.ofOpSequence (cochainStep f)

/-- The derived object represented by the `n`th powered Koszul cochain stage. -/
@[stacks 0BKC "derived powered Koszul stage"]
abbrev derivedStage (f : ι → R) (n : ℕ) : DerivedCategory (ModuleCat R) :=
  DerivedCategory.Q.obj (cochainStage f n)

/-- The derived transition between adjacent powered Koszul stages. -/
@[stacks 0BKC "derived powered Koszul transition"]
abbrev derivedStep (f : ι → R) (n : ℕ) :
    derivedStage f (n + 1) ⟶ derivedStage f n :=
  DerivedCategory.Q.map (cochainStep f n)

/-- The sequential inverse system of powered Koszul stages in `D(R)`. -/
@[stacks 0BKC "derived powered Koszul inverse system"]
abbrev derivedSystem (f : ι → R) :
    SequentialInverseSystem (DerivedCategory (ModuleCat R)) :=
  cochainSystem f ⋙ DerivedCategory.Q

/-- The quotient by the ideal generated by the `(n+1)`st powers of the Koszul family. -/
@[stacks 0BKC "powered Koszul quotient stage"]
abbrev quotientStage (f : ι → R) (n : ℕ) : ModuleCat R :=
  ModuleCat.of R (R ⧸ Ideal.powerSpan f (n + 1))

/-- The canonical transition between adjacent powered-family quotient stages. -/
@[stacks 0BKC "powered Koszul quotient transition"]
abbrev quotientStep (f : ι → R) (n : ℕ) :
    quotientStage f (n + 1) ⟶ quotientStage f n :=
  ModuleCat.ofHom
    (Ideal.powerQuotientMap f (Nat.le_succ (n + 1))).toLinearMap

/-- The inverse system of quotients by the successive powered-family ideals. -/
@[stacks 0BKC "powered Koszul quotient inverse system"]
abbrev quotientSystem (f : ι → R) : SequentialInverseSystem (ModuleCat R) :=
  Functor.ofOpSequence (quotientStep f)

omit [Finite ι] in
/-- The degree-zero homology inverse system of the powered Koszul tower. -/
@[stacks 0BKC "degree-zero homology of the powered Koszul inverse system"]
abbrev homologyZeroSystem {κ : Type u} [Finite κ] (f : κ → R) :
    SequentialInverseSystem (ModuleCat R) :=
  KoszulComplex.powerSystem f ⋙
    HomologicalComplex.homologyFunctor (ModuleCat R) (ComplexShape.down ℕ) 0

omit [Finite ι] in
/-- The degree-zero homology inverse system of the cochain model of the powered Koszul tower. -/
@[stacks 0BKC "degree-zero cohomology of the powered Koszul cochain inverse system"]
abbrev cochainHomologyZeroSystem {κ : Type u} [Finite κ] (f : κ → R) :
    SequentialInverseSystem (ModuleCat R) :=
  cochainSystem f ⋙
    HomologicalComplex.homologyFunctor (ModuleCat R) (ComplexShape.up ℤ) 0

omit [Finite ι] in
/-- The degree-zero term of a powered Koszul complex maps canonically to the quotient by its
powered-family ideal. -/
@[stacks 0BKC "degree-zero powered Koszul quotient map"]
abbrev zeroQuotientMap {κ : Type u} [Finite κ] (f : κ → R) (n : ℕ) :
    (KoszulComplex.powerComplex f n).X 0 ⟶ quotientStage f n :=
  (ModuleCat.exteriorPower.iso₀ (ModuleCat.of R (κ → R))).hom ≫
    ModuleCat.ofHom
      ((Ideal.Quotient.mkₐ R (Ideal.powerSpan f (n + 1))).toLinearMap)

omit [Finite ι] in
/-- The first powered Koszul differential is killed by the degree-zero quotient map. -/
@[stacks 0BKC "powered Koszul differential and quotient"]
theorem firstDifferential_zeroQuotientMap
    {κ : Type u} [Finite κ] (f : κ → R) (n : ℕ) :
    (KoszulComplex.powerComplex f n).d 1 0 ≫ zeroQuotientMap f n = 0 := sorry

omit [Finite ι] in
/-- In a nonnegatively graded chain complex, degree one precedes degree zero. -/
theorem chainPrev_zero : (ComplexShape.down ℕ).prev 0 = 1 := sorry

omit [Finite ι] in
/-- The degree-zero quotient map descended to zeroth opcycles. -/
@[stacks 0BKC "powered Koszul opcycles quotient map"]
abbrev opcyclesToQuotient {κ : Type u} [Finite κ] (f : κ → R) (n : ℕ) :
    (KoszulComplex.powerComplex f n).opcycles 0 ⟶ quotientStage f n :=
  (KoszulComplex.powerComplex f n).descOpcycles
    (zeroQuotientMap f n) 1 chainPrev_zero
    (firstDifferential_zeroQuotientMap f n)

omit [Finite ι] in
/-- The canonical comparison from zeroth powered Koszul homology to the powered-family
quotient. -/
@[stacks 0BKC "powered Koszul zeroth-homology comparison"]
abbrev homologyZeroToQuotient {κ : Type u} [Finite κ] (f : κ → R) (n : ℕ) :
    (KoszulComplex.powerComplex f n).homology 0 ⟶ quotientStage f n :=
  (ChainComplex.isoHomologyι₀ (KoszulComplex.powerComplex f n)).hom ≫
    opcyclesToQuotient f n

omit [Finite ι] in
/-- The zeroth-homology comparisons commute with adjacent powered Koszul transitions. -/
@[stacks 0BKC "naturality of powered Koszul zeroth-homology comparisons"]
theorem homologyZeroToQuotient_naturality
    {κ : Type u} [Finite κ] (f : κ → R) (n : ℕ) :
    (homologyZeroSystem f).map (homOfLE (Nat.le_succ n)).op ≫
        homologyZeroToQuotient f n =
      homologyZeroToQuotient f (n + 1) ≫
        (quotientSystem f).map (homOfLE (Nat.le_succ n)).op := sorry

omit [Finite ι] in
/-- The canonical natural comparison from the zeroth homology tower to the powered-family
quotient tower. -/
@[stacks 0BKC "powered Koszul zeroth-homology comparison morphism"]
noncomputable def homologyZeroComparison
    {κ : Type u} [Finite κ] (f : κ → R) :
    homologyZeroSystem f ⟶ quotientSystem f :=
  NatTrans.ofOpSequence (homologyZeroToQuotient f)
    (homologyZeroToQuotient_naturality f)

omit [Finite ι] in
/-- The component of the zeroth-homology comparison is the explicit quotient map. -/
@[simp, stacks 0BKC "powered Koszul zeroth-homology comparison component"]
theorem homologyZeroComparison_app
    {κ : Type u} [Finite κ] (f : κ → R) (n : ℕ) :
    (homologyZeroComparison f).app (op n) = homologyZeroToQuotient f n := sorry

omit [Finite ι] in
/-- The canonical comparison identifies zeroth homology of the powered Koszul tower with the
inverse system of quotients by the powered-family ideals. -/
@[stacks 0BKC "powered Koszul degree-zero comparison"]
theorem homologyZeroComparison_isIso
    {κ : Type u} [Finite κ] (f : κ → R) :
    IsIso (homologyZeroComparison f) := sorry

omit [Finite ι] in
/-- Extending a powered Koszul chain complex to its integer-graded cochain model preserves
degree-zero homology throughout the inverse system. -/
@[stacks 0BKC "chain-cochain degree-zero comparison"]
theorem cochainHomologyZeroSystem_isIsomorphic_homologyZeroSystem
    {κ : Type u} [Finite κ] (f : κ → R) :
    IsIsomorphic (cochainHomologyZeroSystem f) (homologyZeroSystem f) := sorry

omit [Finite ι] in
/-- Degree-zero cohomology of the powered Koszul cochain inverse system is the inverse
system of quotients by the powered-family ideals. -/
@[stacks 0BKC "powered Koszul cochain degree-zero comparison"]
theorem cochainHomologyZeroSystem_isIsomorphic_quotientSystem
    {κ : Type u} [Finite κ] (f : κ → R) :
    IsIsomorphic (cochainHomologyZeroSystem f) (quotientSystem f) := sorry

/-- The powered-family quotient stage placed in cohomological degree zero. -/
@[stacks 0BKC "derived powered Koszul quotient stage"]
abbrev derivedQuotientStage (f : ι → R) (n : ℕ) :
    DerivedCategory (ModuleCat R) :=
  (DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).obj (quotientStage f n)

/-- The derived transition between adjacent powered-family quotient stages. -/
@[stacks 0BKC "derived powered Koszul quotient transition"]
abbrev derivedQuotientStep (f : ι → R) (n : ℕ) :
    derivedQuotientStage f (n + 1) ⟶ derivedQuotientStage f n :=
  (DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).map (quotientStep f n)

/-- The derived inverse system of powered-family quotient stages. -/
@[stacks 0BKC "derived powered Koszul quotient inverse system"]
abbrev derivedQuotientSystem (f : ι → R) :
    SequentialInverseSystem (DerivedCategory (ModuleCat R)) :=
  quotientSystem f ⋙ DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)

/-- The degree-zero source complex for the unit maps into the powered Koszul stages. -/
@[stacks 0BKC "powered Koszul unit source"]
abbrev unitSource : CochainComplex (ModuleCat R) ℤ :=
  (ComplexShape.embeddingDownNat.extendFunctor (ModuleCat R)).obj
    ((ChainComplex.single₀ (ModuleCat R)).obj (ModuleCat.of R R))

/-- The constant inverse system on the degree-zero base-ring complex. -/
@[stacks 0BKC "powered Koszul unit source system"]
abbrev unitSourceSystem :
    SequentialInverseSystem (CochainComplex (ModuleCat R) ℤ) :=
  Functor.ofOpSequence (X := fun _ : ℕ ↦ unitSource (R := R))
    (fun _ : ℕ ↦ 𝟙 (unitSource (R := R)))

/-- The unit map from the base ring in degree zero to the `n`th powered Koszul chain stage. -/
@[stacks 0BKC "powered Koszul unit at a chain stage"]
abbrev chainUnitComponent {κ : Type u} [Finite κ] (f : κ → R) (n : ℕ) :
    (ChainComplex.single₀ (ModuleCat R)).obj (ModuleCat.of R R) ⟶
      KoszulComplex.powerComplex f n :=
  (ChainComplex.fromSingle₀Equiv
    (KoszulComplex.powerComplex f n) (ModuleCat.of R R)).symm
      (ModuleCat.exteriorPower.iso₀ (ModuleCat.of R (κ → R))).inv

/-- The unit map from the base ring in degree zero to the `n`th powered Koszul cochain stage. -/
@[stacks 0BKC "powered Koszul unit component"]
abbrev unitComponent {κ : Type u} [Finite κ] (f : κ → R) (n : ℕ) :
    unitSource ⟶ cochainStage f n :=
  (ComplexShape.embeddingDownNat.extendFunctor (ModuleCat R)).map
    (chainUnitComponent f n)

omit [Finite ι] in
/-- The powered Koszul transition maps preserve the unit from the base ring. -/
@[stacks 0BKC "naturality of powered Koszul units"]
theorem unitComponent_naturality {κ : Type u} [Finite κ] (f : κ → R) (n : ℕ) :
    𝟙 unitSource ≫ unitComponent f n =
      unitComponent f (n + 1) ≫ cochainStep f n := sorry

omit [Finite ι] in
/-- The unit components satisfy the successor equation in the form consumed by
`NatTrans.ofOpSequence`. -/
theorem unit_naturality {κ : Type u} [Finite κ] (f : κ → R) (n : ℕ) :
    unitSourceSystem.map (homOfLE (Nat.le_succ n)).op ≫ unitComponent f n =
      unitComponent f (n + 1) ≫
        (cochainSystem f).map (homOfLE (Nat.le_succ n)).op := sorry

/-- The unit maps from `R` into the powered Koszul cochain complexes form a morphism from
the constant unit-source system to the powered Koszul inverse system. -/
@[stacks 0BKC "unit of the powered Koszul inverse system"]
noncomputable def unit {κ : Type u} [Finite κ] (f : κ → R) :
    unitSourceSystem ⟶ cochainSystem f :=
  NatTrans.ofOpSequence (unitComponent f) (unit_naturality f)

omit [Finite ι] in
/-- The component of the powered Koszul unit is its explicit stage map. -/
@[simp, stacks 0BKC "powered Koszul unit component formula"]
theorem unit_app {κ : Type u} [Finite κ] (f : κ → R) (n : ℕ) :
    (unit f).app (op n) = unitComponent f n := sorry

namespace Fin

variable {r : ℕ}

/-- The degree-zero homology inverse system for a finite tuple over a ring in an arbitrary
universe. -/
@[stacks 0BKC "finite-tuple powered Koszul degree-zero homology system"]
abbrev homologyZeroSystem (f : Fin r → R) :
    SequentialInverseSystem (ModuleCat R) :=
  KoszulComplex.powerSystem f ⋙
    HomologicalComplex.homologyFunctor (ModuleCat R) (ComplexShape.down ℕ) 0

/-- The degree-zero homology inverse system of the finite-tuple powered Koszul cochain model. -/
@[stacks 0BKC "finite-tuple powered Koszul degree-zero cohomology system"]
abbrev cochainHomologyZeroSystem (f : Fin r → R) :
    SequentialInverseSystem (ModuleCat R) :=
  cochainSystem f ⋙
    HomologicalComplex.homologyFunctor (ModuleCat R) (ComplexShape.up ℤ) 0

/-- The degree-zero term of a finite-tuple powered Koszul complex maps canonically to the
quotient by its powered-family ideal. -/
@[stacks 0BKC "finite-tuple powered Koszul quotient map"]
abbrev zeroQuotientMap (f : Fin r → R) (n : ℕ) :
    (KoszulComplex.powerComplex f n).X 0 ⟶ quotientStage f n :=
  (ModuleCat.exteriorPower.iso₀ (ModuleCat.of R (Fin r → R))).hom ≫
    ModuleCat.ofHom
      ((Ideal.Quotient.mkₐ R (Ideal.powerSpan f (n + 1))).toLinearMap)

/-- The first finite-tuple powered Koszul differential is killed by the degree-zero quotient
map. -/
@[stacks 0BKC "finite-tuple powered Koszul differential and quotient"]
theorem firstDifferential_zeroQuotientMap (f : Fin r → R) (n : ℕ) :
    (KoszulComplex.powerComplex f n).d 1 0 ≫ zeroQuotientMap f n = 0 := sorry

/-- The finite-tuple degree-zero quotient map descended to zeroth opcycles. -/
@[stacks 0BKC "finite-tuple powered Koszul opcycles quotient map"]
abbrev opcyclesToQuotient (f : Fin r → R) (n : ℕ) :
    (KoszulComplex.powerComplex f n).opcycles 0 ⟶ quotientStage f n :=
  (KoszulComplex.powerComplex f n).descOpcycles
    (zeroQuotientMap f n) 1 chainPrev_zero
    (firstDifferential_zeroQuotientMap f n)

/-- The canonical comparison from zeroth finite-tuple powered Koszul homology to the
powered-family quotient. -/
@[stacks 0BKC "finite-tuple powered Koszul zeroth-homology comparison"]
abbrev homologyZeroToQuotient (f : Fin r → R) (n : ℕ) :
    (KoszulComplex.powerComplex f n).homology 0 ⟶ quotientStage f n :=
  (ChainComplex.isoHomologyι₀ (KoszulComplex.powerComplex f n)).hom ≫
    opcyclesToQuotient f n

/-- The finite-tuple zeroth-homology comparisons commute with adjacent powered Koszul
transitions. -/
@[stacks 0BKC "naturality of finite-tuple powered Koszul zeroth-homology comparisons"]
theorem homologyZeroToQuotient_naturality (f : Fin r → R) (n : ℕ) :
    (homologyZeroSystem f).map (homOfLE (Nat.le_succ n)).op ≫
        homologyZeroToQuotient f n =
      homologyZeroToQuotient f (n + 1) ≫
        (quotientSystem f).map (homOfLE (Nat.le_succ n)).op := sorry

/-- The natural comparison from finite-tuple powered Koszul zeroth homology to the
powered-family quotient tower. -/
@[stacks 0BKC "finite-tuple powered Koszul zeroth-homology comparison morphism"]
noncomputable def homologyZeroComparison (f : Fin r → R) :
    homologyZeroSystem f ⟶ quotientSystem f :=
  NatTrans.ofOpSequence (homologyZeroToQuotient f)
    (homologyZeroToQuotient_naturality f)

/-- The component of the finite-tuple zeroth-homology comparison is the explicit quotient
map. -/
@[simp, stacks 0BKC "finite-tuple powered Koszul comparison component"]
theorem homologyZeroComparison_app (f : Fin r → R) (n : ℕ) :
    (homologyZeroComparison f).app (op n) = homologyZeroToQuotient f n := sorry

/-- The finite-tuple zeroth-homology comparison is an isomorphism of inverse systems. -/
@[stacks 0BKC "finite-tuple powered Koszul degree-zero comparison"]
theorem homologyZeroComparison_isIso (f : Fin r → R) :
    IsIso (homologyZeroComparison f) := sorry

/-- Degree-zero cohomology of the finite-tuple powered Koszul cochain tower is the
powered-family quotient tower. -/
@[stacks 0BKC "finite-tuple powered Koszul cochain degree-zero comparison"]
theorem cochainHomologyZeroSystem_isIsomorphic_quotientSystem (f : Fin r → R) :
    IsIsomorphic (cochainHomologyZeroSystem f) (quotientSystem f) := sorry

/-- The unit map from the base ring in degree zero to a finite-tuple powered Koszul chain
stage. -/
@[stacks 0BKC "finite-tuple powered Koszul chain unit"]
abbrev chainUnitComponent (f : Fin r → R) (n : ℕ) :
    (ChainComplex.single₀ (ModuleCat R)).obj (ModuleCat.of R R) ⟶
      KoszulComplex.powerComplex f n :=
  (ChainComplex.fromSingle₀Equiv
    (KoszulComplex.powerComplex f n) (ModuleCat.of R R)).symm
      (ModuleCat.exteriorPower.iso₀ (ModuleCat.of R (Fin r → R))).inv

/-- The unit map from the base ring in degree zero to a finite-tuple powered Koszul cochain
stage. -/
@[stacks 0BKC "finite-tuple powered Koszul unit component"]
abbrev unitComponent (f : Fin r → R) (n : ℕ) :
    unitSource ⟶ cochainStage f n :=
  (ComplexShape.embeddingDownNat.extendFunctor (ModuleCat R)).map
    (chainUnitComponent f n)

/-- The finite-tuple powered Koszul transitions preserve the unit from the base ring. -/
@[stacks 0BKC "naturality of finite-tuple powered Koszul units"]
theorem unitComponent_naturality (f : Fin r → R) (n : ℕ) :
    𝟙 unitSource ≫ unitComponent f n =
      unitComponent f (n + 1) ≫ cochainStep f n := sorry

/-- The finite-tuple unit components satisfy the successor equation consumed by
`NatTrans.ofOpSequence`. -/
theorem unit_naturality (f : Fin r → R) (n : ℕ) :
    unitSourceSystem.map (homOfLE (Nat.le_succ n)).op ≫ unitComponent f n =
      unitComponent f (n + 1) ≫
        (cochainSystem f).map (homOfLE (Nat.le_succ n)).op := sorry

/-- The finite-tuple unit maps into the powered Koszul cochain stages define a morphism of
inverse systems. -/
@[stacks 0BKC "finite-tuple unit of the powered Koszul inverse system"]
noncomputable def unit (f : Fin r → R) :
    unitSourceSystem ⟶ cochainSystem f :=
  NatTrans.ofOpSequence (unitComponent f) (unit_naturality f)

/-- The component of the finite-tuple powered Koszul unit is its explicit stage map. -/
@[simp, stacks 0BKC "finite-tuple powered Koszul unit component formula"]
theorem unit_app (f : Fin r → R) (n : ℕ) :
    (unit f).app (op n) = unitComponent f n := sorry

end Fin

/-- The ideal complex `σ≤-1 Kₙ[-1]` attached to the `n`th powered Koszul stage. -/
@[stacks 0G3J "ideal complex of a powered Koszul stage"]
abbrev idealStage (f : ι → R) (n : ℕ) : CochainComplex (ModuleCat R) ℤ :=
  (shiftFunctor (CochainComplex (ModuleCat R) ℤ) (-1 : ℤ)).obj
    ((cochainStage f n).stupidTrunc (ComplexShape.embeddingUpIntLE (-1)))

/-- The adjacent transition `σ≤-1 Kₙ₊₁[-1] ⟶ σ≤-1 Kₙ[-1]`. -/
@[stacks 0G3J "transition between powered Koszul ideal complexes"]
abbrev idealStep (f : ι → R) (n : ℕ) :
    idealStage f (n + 1) ⟶ idealStage f n :=
  (shiftFunctor (CochainComplex (ModuleCat R) ℤ) (-1 : ℤ)).map
    (HomologicalComplex.stupidTruncMap
      (cochainStep f n) (ComplexShape.embeddingUpIntLE (-1)))

/-- The sequential inverse system `(σ≤-1 Kₙ[-1])ₙ` of powered Koszul ideal complexes. -/
@[stacks 0G3J "powered Koszul ideal-complex inverse system"]
abbrev idealSystem (f : ι → R) :
    SequentialInverseSystem (CochainComplex (ModuleCat R) ℤ) :=
  Functor.ofOpSequence (idealStep f)

/-- The derived object represented by the `n`th powered Koszul ideal complex. -/
@[stacks 0G3J "derived powered Koszul ideal-complex stage"]
abbrev derivedIdealStage (f : ι → R) (n : ℕ) :
    DerivedCategory (ModuleCat R) :=
  DerivedCategory.Q.obj (idealStage f n)

/-- The derived transition between adjacent powered Koszul ideal-complex stages. -/
@[stacks 0G3J "derived powered Koszul ideal-complex transition"]
abbrev derivedIdealStep (f : ι → R) (n : ℕ) :
    derivedIdealStage f (n + 1) ⟶ derivedIdealStage f n :=
  DerivedCategory.Q.map (idealStep f n)

/-- The derived sequential system `(Q(σ≤-1 Kₙ[-1]))ₙ`. -/
@[stacks 0G3J "derived powered Koszul ideal-complex inverse system"]
abbrev derivedIdealSystem (f : ι → R) :
    SequentialInverseSystem (DerivedCategory (ModuleCat R)) :=
  Functor.ofOpSequence (derivedIdealStep f)

/-- The object formula for the powered Koszul cochain system. -/
@[simp, stacks 0BKC "powered Koszul cochain system object"]
theorem cochainSystem_obj (f : ι → R) (n : ℕ) :
    (cochainSystem f).obj (op n) = cochainStage f n := sorry

/-- The successor-map formula for the powered Koszul cochain system. -/
@[simp, stacks 0BKC "powered Koszul cochain system transition"]
theorem cochainSystem_stepMap (f : ι → R) (n : ℕ) :
    (cochainSystem f).stepMap n = cochainStep f n := sorry

/-- The object formula for the derived powered Koszul system. -/
@[simp, stacks 0BKC "derived powered Koszul system object"]
theorem derivedSystem_obj (f : ι → R) (n : ℕ) :
    (derivedSystem f).obj (op n) = derivedStage f n := sorry

/-- The successor-map formula for the derived powered Koszul system. -/
@[simp, stacks 0BKC "derived powered Koszul system transition"]
theorem derivedSystem_stepMap (f : ι → R) (n : ℕ) :
    (derivedSystem f).stepMap n = derivedStep f n := sorry

omit [Finite ι] in
/-- The object formula for the powered-family quotient system. -/
@[simp, stacks 0BKC "powered Koszul quotient system object"]
theorem quotientSystem_obj (f : ι → R) (n : ℕ) :
    (quotientSystem f).obj (op n) = quotientStage f n := sorry

omit [Finite ι] in
/-- The successor-map formula for the powered-family quotient system. -/
@[simp, stacks 0BKC "powered Koszul quotient system transition"]
theorem quotientSystem_stepMap (f : ι → R) (n : ℕ) :
    (quotientSystem f).stepMap n = quotientStep f n := sorry

omit [Finite ι] in
/-- The object formula for the derived powered-family quotient system. -/
@[simp, stacks 0BKC "derived powered Koszul quotient system object"]
theorem derivedQuotientSystem_obj (f : ι → R) (n : ℕ) :
    (derivedQuotientSystem f).obj (op n) = derivedQuotientStage f n := sorry

omit [Finite ι] in
/-- The successor-map formula for the derived powered-family quotient system. -/
@[simp, stacks 0BKC "derived powered Koszul quotient system transition"]
theorem derivedQuotientSystem_stepMap (f : ι → R) (n : ℕ) :
    (derivedQuotientSystem f).stepMap n = derivedQuotientStep f n := sorry

/-- The object formula for the powered Koszul ideal-complex system. -/
@[simp, stacks 0G3J "powered Koszul ideal-complex system object"]
theorem idealSystem_obj (f : ι → R) (n : ℕ) :
    (idealSystem f).obj (op n) = idealStage f n := sorry

/-- The successor-map formula for the powered Koszul ideal-complex system. -/
@[simp, stacks 0G3J "powered Koszul ideal-complex system transition"]
theorem idealSystem_stepMap (f : ι → R) (n : ℕ) :
    (idealSystem f).stepMap n = idealStep f n := sorry

/-- The object formula for the derived powered Koszul ideal-complex system. -/
@[simp, stacks 0G3J "derived powered Koszul ideal-complex system object"]
theorem derivedIdealSystem_obj (f : ι → R) (n : ℕ) :
    (derivedIdealSystem f).obj (op n) = derivedIdealStage f n := sorry

/-- The successor-map formula for the derived powered Koszul ideal-complex system. -/
@[simp, stacks 0G3J "derived powered Koszul ideal-complex system transition"]
theorem derivedIdealSystem_stepMap (f : ι → R) (n : ℕ) :
    (derivedIdealSystem f).stepMap n = derivedIdealStep f n := sorry

end KoszulComplex.PowerTower
