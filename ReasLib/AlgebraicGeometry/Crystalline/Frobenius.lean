module

public import ReasLib.AlgebraicGeometry.Crystalline.Base
public import ReasLib.RingTheory.DividedPowers.Category
public import ReasLib.AlgebraicGeometry.DividedPowers.Affine

@[expose] public section

open CategoryTheory AlgebraicGeometry

universe u

namespace AlgebraicGeometry.Scheme.Crystalline

/-- An affine prime-local crystalline base with a chosen divided-power endomorphism
lifting the `p`-power map modulo the ideal generated by `p`. -/
structure FrobeniusBase (p : ℕ) [Fact p.Prime] (A : DividedPowerRing.{u}) :
    Type (u + 1) where
  /-- The prime-local relative crystalline base. -/
  toBase : Base p
  /-- The ambient scheme is the spectrum of the presenting ring. -/
  scheme_eq : toBase.scheme = Spec (CommRingCat.of A)
  /-- The stored ideal sheaf is the affine ideal associated to the presenting ring. -/
  ideal_heq : HEq toBase.ideal (DividedPowers.affineIdeal (I := A.ideal))
  /-- The stored divided powers are the affine divided powers of the presenting ring. -/
  dividedPowers_heq : HEq toBase.dividedPowers (DividedPowers.affine A.dividedPowers)
  /-- The prime belongs to the distinguished divided-power ideal. -/
  prime_mem : (p : A) ∈ A.ideal
  /-- The chosen divided-power endomorphism of the presenting ring. -/
  sigma : A ⟶ A
  /-- The endomorphism agrees with the `p`-power map modulo the ideal generated by `p`. -/
  sigma_mod : ∀ x : A, sigma x - x ^ p ∈ Ideal.span ({(p : A)} : Set A)

/-- Construct an affine crystalline Frobenius base from its presentation and
chosen divided-power endomorphism. -/
def FrobeniusBase.of (p : ℕ) [Fact p.Prime] (A : DividedPowerRing.{u})
    (toBase : Base p) (scheme_eq : toBase.scheme = Spec (CommRingCat.of A))
    (ideal_heq : HEq toBase.ideal (DividedPowers.affineIdeal (I := A.ideal)))
    (dividedPowers_heq : HEq toBase.dividedPowers (DividedPowers.affine A.dividedPowers))
    (prime_mem : (p : A) ∈ A.ideal) (sigma : A ⟶ A)
    (sigma_mod : ∀ x : A, sigma x - x ^ p ∈ Ideal.span ({(p : A)} : Set A)) :
    FrobeniusBase p A where
  toBase := toBase
  scheme_eq := scheme_eq
  ideal_heq := ideal_heq
  dividedPowers_heq := dividedPowers_heq
  prime_mem := prime_mem
  sigma := sigma
  sigma_mod := sigma_mod

/-- The ideal and divided powers of an affine crystalline Frobenius base agree
with the affine constructions from its presenting divided-power ring. -/
theorem FrobeniusBase.presentation_spec {p : ℕ} [Fact p.Prime]
    {A : DividedPowerRing.{u}} (B : FrobeniusBase p A) :
    HEq B.toBase.ideal (DividedPowers.affineIdeal (I := A.ideal)) ∧
      HEq B.toBase.dividedPowers (DividedPowers.affine A.dividedPowers) := sorry

/-- The prime belongs to the presenting ideal, and the chosen divided-power
endomorphism lifts the `p`-power map modulo the ideal generated by `p`. -/
theorem FrobeniusBase.frobenius_spec {p : ℕ} [Fact p.Prime]
    {A : DividedPowerRing.{u}} (B : FrobeniusBase p A) :
    (p : A) ∈ A.ideal ∧
      ∀ x : A, B.sigma x - x ^ p ∈ Ideal.span ({(p : A)} : Set A) := sorry

end AlgebraicGeometry.Scheme.Crystalline
