module

public import ReasLib.FieldTheory.ArtinSchreier

@[expose] public section

open scoped IntermediateField

universe u v

namespace FieldExtension

variable {K : Type u} {L : Type v} [Field K] [Field L] [Algebra K L]
variable {p : ℕ} [Fact p.Prime] [CharP K p] [IsGalois K L]

/-- Lemma 9.25.1 (Tag 09DY): if `Gal(L/K)` is isomorphic to
`Multiplicative (ZMod p)`, then `L` is generated by an element `z` with
`z ^ p - z` in the base field. -/
@[stacks 09DY]
theorem existsArtinSchreierGeneratorOfGaloisGroupEquivZMod
    (hGal : Nonempty (Gal(L/K) ≃* Multiplicative (ZMod p))) :
    ∃ z : L, K⟮z⟯ = ⊤ ∧ z ^ p - z ∈ (⊥ : IntermediateField K L) := by
  let e : Gal(L/K) ≃* Multiplicative (ZMod p) := hGal.some
  -- Local instance justification (noncanonical choice): the supplied group equivalence selects
  -- a cyclicity witness only for this source-facing reformulation.
  letI : IsCyclic (Gal(L/K)) := (MulEquiv.isCyclic e).2 inferInstance
  -- Local instance justification (proof-local temporary data): finiteness is transported across
  -- the selected equivalence only to derive the finite-dimensional extension instance below.
  letI : Finite (Gal(L/K)) := Finite.of_equiv (Multiplicative (ZMod p)) e.symm.toEquiv
  -- Local instance justification (proof-local temporary data): Galois finiteness supplies the
  -- dimension hypothesis required by the shared cyclic Artin-Schreier theorem.
  letI : FiniteDimensional K L := IsGalois.finiteDimensional_of_finite (F := K) (E := L)
  have hcard : Nat.card (Gal(L/K)) = p := by
    calc
      Nat.card (Gal(L/K)) = Nat.card (Multiplicative (ZMod p)) := Nat.card_congr e.toEquiv
      _ = Nat.card (ZMod p) := by simpa using Nat.card_congr Multiplicative.toAdd
      _ = p := Nat.card_zmod p
  have hfin : Module.finrank K L = p := by
    rw [← IsGalois.card_aut_eq_finrank (F := K) (E := L), hcard]
  exact existsArtinSchreierGeneratorOfIsCyclic (K := K) (L := L) (p := p) hfin

end FieldExtension
