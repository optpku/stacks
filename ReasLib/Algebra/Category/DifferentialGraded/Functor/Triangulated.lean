module

public import ReasLib.Algebra.Category.DifferentialGraded.AdmissibleCone.Pretriangulated
public import ReasLib.Algebra.Category.DifferentialGraded.Functor.Homotopy
public import Mathlib.CategoryTheory.Triangulated.Functor
public import Mathlib.Tactic.CrossRefAttribute

/-!
# Triangulated functors induced by differential graded functors

A differential graded functor compatible with shifts induces a triangulated functor on homotopy
categories.  This leaf keeps the triangulated dependency above the basic DG-functor construction.
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated

universe u v w

namespace DifferentialGradedCategory.DgFunctor

variable {R : Type u} [CommRing R]
variable {A : Type v} {B : Type w}
variable [DifferentialGradedCategory R A] [DifferentialGradedCategory R B]
variable [HasShift (Comp R A) ℤ] [HasShift (Comp R B) ℤ]
variable [HasShift (K R A) ℤ] [HasShift (K R B) ℤ]
variable [((Comp.inKFunctor : Comp R A ⥤ K R A)).CommShift ℤ]
variable [((Comp.inKFunctor : Comp R B ⥤ K R B)).CommShift ℤ]
variable [HasZeroObject (K R A)] [HasZeroObject (K R B)]
variable [∀ n : ℤ, (shiftFunctor (K R A) n).Additive]
variable [∀ n : ℤ, (shiftFunctor (K R B) n).Additive]

/-- A DG functor maps two admissible-cone systems when it sends every source cone triangle to
a triangle represented by the target cone system. -/
@[stacks 0FQF "DG functors preserving admissible cone systems"]
def MapsCones (F : DgFunctor R A B) [F.mapK.CommShift ℤ]
    {BA : CompBoundaryAssignment R A} {BB : CompBoundaryAssignment R B}
    (CA : BA.AdmissibleCones) (CB : BB.AdmissibleCones) : Prop :=
  ∀ {x y : Comp R A} (f : x ⟶ y),
    F.mapK.mapTriangle.obj (CA.cone f).triangleInK ∈ CB.distinguishedTrianglesInK

/-- The proposition that `F.mapK` is triangulated for the pretriangulations generated by the
supplied admissible-cone systems.  The explicit pretriangulation data stays behind this named
interface so callers do not depend on Mathlib's implementation-level instance arguments. -/
@[stacks 0FQF "triangulated functor relative to admissible cone systems"]
def IsTriangulatedFor (F : DgFunctor R A B) [F.mapK.CommShift ℤ]
    {BA : CompBoundaryAssignment R A} {BB : CompBoundaryAssignment R B}
    (CA : BA.AdmissibleCones) (CB : BB.AdmissibleCones) : Prop :=
  @Functor.IsTriangulated (K R A) (K R B) _ _ _ _ F.mapK
    (inferInstance : F.mapK.CommShift ℤ) _ _ _ _ _ _
    CA.pretriangulated CB.pretriangulated

namespace IsTriangulatedFor

/-- A functor triangulated for two cone-generated pretriangulations maps every distinguished
source triangle to a distinguished target triangle. -/
@[stacks 0FQF "image of a distinguished triangle under a cone-relative triangulated functor"]
theorem map_distinguished (F : DgFunctor R A B) [F.mapK.CommShift ℤ]
    {BA : CompBoundaryAssignment R A} {BB : CompBoundaryAssignment R B}
    (CA : BA.AdmissibleCones) (CB : BB.AdmissibleCones)
    (hF : F.IsTriangulatedFor CA CB) (T : Triangle (K R A))
    (hT : T ∈ CA.distinguishedTrianglesInK) :
    F.mapK.mapTriangle.obj T ∈ CB.distinguishedTrianglesInK := sorry

end IsTriangulatedFor

/-- Lemma 22.27.17 (0FQF): a shift-compatible DG functor that maps admissible-cone systems
presenting the source and target triangulations induces a triangulated functor on homotopy
categories. -/
@[stacks 0FQF]
theorem mapK_isTriangulated (F : DgFunctor R A B) [F.mapK.CommShift ℤ]
    {BA : CompBoundaryAssignment R A} {BB : CompBoundaryAssignment R B}
    [PA : Pretriangulated (K R A)] [PB : Pretriangulated (K R B)]
    (CA : BA.AdmissibleCones) (CB : BB.AdmissibleCones)
    (hA : CA.Presents PA) (hB : CB.Presents PB) (hF : F.MapsCones CA CB) :
    F.mapK.IsTriangulated := sorry

/-- A cone-preserving DG functor is triangulated for the pretriangulations canonically generated by
the two supplied admissible-cone systems.  This bridge hides the two presentation proofs from
construction-facing callers while retaining the general `mapK_isTriangulated` criterion. -/
@[stacks 0FQF "triangulated functor for cone-generated pretriangulations"]
theorem mapK_isTriangulated_of_coneSystems (F : DgFunctor R A B) [F.mapK.CommShift ℤ]
    {BA : CompBoundaryAssignment R A} {BB : CompBoundaryAssignment R B}
    (CA : BA.AdmissibleCones) (CB : BB.AdmissibleCones)
    (hF : F.MapsCones CA CB) :
    IsTriangulatedFor F CA CB := sorry

end DifferentialGradedCategory.DgFunctor
