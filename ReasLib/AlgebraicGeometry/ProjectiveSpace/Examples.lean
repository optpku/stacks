module

public import Mathlib.Algebra.Algebra.Rat
public import Mathlib.AlgebraicGeometry.Properties
public import ReasLib.AlgebraicGeometry.ProjectiveSpace.Basic
public import ReasLib.RingTheory.GradedAlgebra.Quotient

/-!
# Examples of projective spectra

The standard grading on `ℤ[T]` has affine nonempty projective spectrum.
The homogeneous Fermat cubic coordinate ring over `ℚ` has integral nonempty
projective spectrum that is not a projective space over any commutative ring.
-/

@[expose] public section

noncomputable section

open CategoryTheory MvPolynomial

namespace AlgebraicGeometry

/-- Projective `0`-space over `ℤ` is affine. -/
instance instIsAffineProjectiveSpaceZero : IsAffine (ProjectiveSpace.scheme ℤ 0) := sorry

/-- The projective spectrum of the standard graded ring `ℤ[T]` is affine and nonempty. -/
theorem projectiveSpace_zero_isAffine_nonempty :
    IsAffine (Proj (ProjectiveSpace.grading ℤ 0)) ∧
      Nonempty (Proj (ProjectiveSpace.grading ℤ 0)) := sorry

namespace FermatCubic

/-- The homogeneous Fermat cubic `X ^ 3 + Y ^ 3 + Z ^ 3` in three variables over `ℚ`. -/
def equation : MvPolynomial (Fin 3) ℚ :=
  X (0 : Fin 3) ^ 3 + X (1 : Fin 3) ^ 3 + X (2 : Fin 3) ^ 3

/-- The principal ideal generated by the Fermat cubic. -/
def ideal : Ideal (MvPolynomial (Fin 3) ℚ) :=
  Ideal.span {equation}

/-- The homogeneous coordinate ring of the Fermat cubic. -/
abbrev CoordinateRing : Type :=
  MvPolynomial (Fin 3) ℚ ⧸ ideal

/-- The quotient grading on the Fermat cubic coordinate ring. -/
abbrev grading : ℕ → Submodule ℚ CoordinateRing :=
  GradedAlgebra.Quotient.grading (ProjectiveSpace.grading ℚ 2) ideal

/-- The Fermat cubic is homogeneous of degree three. -/
theorem equation_mem_grading_three :
    equation ∈ ProjectiveSpace.grading ℚ 2 3 := sorry

/-- The homogeneous principal quotient carries its canonical graded-ring structure. -/
instance instGradedRing : GradedRing grading :=
  GradedAlgebra.Quotient.spanSingletonGradedAlgebra (ProjectiveSpace.grading ℚ 2)
    ⟨3, equation_mem_grading_three⟩

/-- The projective Fermat cubic `Proj` of its homogeneous coordinate ring. -/
abbrev scheme : Scheme :=
  Proj grading

/-- The Fermat cubic is an integral scheme, hence nonempty. -/
instance instIsIntegralScheme : IsIntegral scheme := sorry

/-- The Fermat cubic is not isomorphic to `ProjectiveSpace.scheme A n` for any ring `A`. -/
theorem not_iso_projectiveSpace (A : Type) [CommRing A] (n : ℕ) :
    IsEmpty (scheme ≅ ProjectiveSpace.scheme A n) := sorry

/-- The Fermat cubic is integral and nonempty, but not a projective space over any ring. -/
theorem spec :
    IsIntegral scheme ∧
      ∀ (A : Type) [CommRing A] (n : ℕ), IsEmpty (scheme ≅ ProjectiveSpace.scheme A n) := sorry

end FermatCubic

end AlgebraicGeometry
