module

import StacksCheckRecall
public import ReasLib.RingTheory.Algebra.TensorProduct.Multiplication.Koszul

@[expose] public section

open scoped TensorProduct

universe u v w

/- Lemma 49.12.1: let `q : P →ₐ[A] B` present `B` as the quotient of `P` by the
ideal generated by the Koszul-regular family `f`.  Suppose `B` is flat over `A`, and a
Koszul-regular family `g` generates the kernel of the multiplication map
`P ⊗[A] B →ₐ[A] B`.  If the rows of `gij` express each `f i ⊗ₜ[A] 1` in terms of
`g`, then the annihilator of the kernel of `B ⊗[A] B →+* B` is generated by the image
of `Matrix.det gij`. -/
@[stacks 0BWC]
#check (Algebra.tensorSquareMultiplication_ker_annihilator_eq_span_det :
  ∀ {A : Type u} {P : Type v} {B : Type w}
    [CommRing A] [CommRing P] [CommRing B] [Algebra A P] [Algebra A B]
    [Module.Flat A B] {n : ℕ} (q : P →ₐ[A] B) (f : Fin n → P)
    (h_q : Function.Surjective q)
    (h_ker_q : RingHom.ker q.toRingHom = Ideal.span (Set.range f))
    (h_f : RingTheory.Sequence.IsKoszulRegularSequence f)
    (g : Fin n → P ⊗[A] B)
    (h_g : RingTheory.Sequence.IsKoszulRegularSequence g)
    (gij : Matrix (Fin n) (Fin n) (P ⊗[A] B))
    (h_g_span : Ideal.span (Set.range g) =
      RingHom.ker
        (Algebra.TensorProduct.productLeftAlgHom q (AlgHom.id A B)).toRingHom)
    (h_coeff : ∀ i,
      (Algebra.TensorProduct.includeLeft : P →ₐ[A] P ⊗[A] B) (f i) =
        ∑ j, gij i j * g j),
    (RingHom.ker (Algebra.tensorSquareMultiplication A B)).annihilator =
      Ideal.span
        {(Algebra.TensorProduct.map q (AlgHom.id A B)) (Matrix.det gij)})
